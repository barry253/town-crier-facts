  "facts": [
    {
      "id": 1,
      "text": "McNary began as Cluff Cienega, named for Mormon bishop Benjamin Cluff who harvested hay there in 1879–80.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/McNary%2C_Arizona",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town’s entire operations and hundreds of employees were moved by rail, with houses and buildings shipped on railroad cars to the new site.",
      "sourceSentenceIds": [
        11
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://foresthistory.org/mcnary-arizona-a-town-on-the-move/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "McNary sits at 7,316 feet, making it the second highest community in Arizona after Alpine.",
      "sourceSentenceIds": [
        25
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/McNary%2C_Arizona",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The climate brings about 65 inches of snow annually, ranking McNary among Arizona’s coldest spots.",
