  "facts": [
    {
      "id": 1,
      "text": "Merit was named after Judge William Wallace Meritt, whose 1870s visit and speech impressed locals enough to christen the town in his honor.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Merit%2C_Texas"
    },
    {
      "id": 2,
      "text": "Alexander Murchison arrived from Georgia in 1871 and organized a Methodist church that became the community’s first gathering place.",
      "sourceSentenceIds": [
        25,
        26
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Merit%2C_Texas"
    },
    {
      "id": 3,
      "text": "The town received its first post office in 1884, marking its official entry onto the map.",
      "sourceSentenceIds": [
        27
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Merit%2C_Texas"
    },
    {
      "id": 4,
      "text": "Two years later, the Gulf, Colorado and Santa Fe Railway reached Merit in 1886, turning the settlement into a key shipping point for local farmers.",
      "sourceSentenceIds": [
        8,
        19
      ],
      "sourceLabels": [
        "Web source 1",
        "Web source 2"
      ],
      "source": "https://www.tshaonline.org/handbook/entries/merit-tx"
    },
    {
      "id": 5,
      "text": "By the early 1890s, Merit housed a steam cotton gin, a gristmill, about 20 other businesses, and 300 residents.",
      "sourceSentenceIds": [
        29
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Merit%2C_Texas"
    },
    {
      "id": 6,
      "text": "In 1945 the town still had roughly 300 residents and six businesses, reflecting its steady small‑town character.",
      "sourceSentenceIds": [
        30
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Merit%2C_Texas"
    }
  ]
