  "facts": [
    {
      "id": 1,
      "text": "Milan was founded in 1956 by Salvador Milan, who subdivided land into lots instead of farming, naming the village after himself.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.theroute-66.com/milan.html",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Before becoming a town, Milan was a community centered on sheep ranching and belonged to the estate of Silvestre Mirabal, inherited by his daughter Veneranda and Salvador Milan.",
      "sourceSentenceIds": [
        18
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.theroute-66.com/milan.html",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Route 66 runs along Milan’s eastern edge, linking the town to the historic highway that shaped travel across the Southwest.",
      "sourceSentenceIds": [
        26
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Milan%2C_New_Mexico",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The privately run Cibola County Correctional Center, which houses over 1,000 federal prisoners, is located in Milan and is a major employer.",
      "sourceSentenceIds": [
        23
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Milan%2C_New_Mexico",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Milan sits along historic Indigenous and Spanish trade routes that shaped early travel and commerce in the region.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.thisisgrantsmilan.com/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Milan’s history is intertwined with the development of railroads and highways, as highlighted on the local website that traces the town’s evolution from Indigenous pathways to Route 66.",
