      "id": 1,
      "text": "Timonium takes its name from the Timonium Mansion, built by Archibald Buchanan and Sarah Brooke Lee Buchanan in the late 18th century.",
      "sourceSentenceIds": [
        11
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/Timonium,_Maryland",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The Northern Central Railway’s extension turned the area into one of the first planned railroad suburbs, linking Timonium to Baltimore.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/Timonium,_Maryland",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "During World War II, the original Timonium Estate was repurposed for national defense, causing the annual fair to pause from 1943 to 1945.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/Timonium,_Maryland",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The Maryland State Fair returns each year near Labor Day on the former Timonium Race Course grounds, a site also shared with Pimlico and Laurel Park.",
      "sourceSentenceIds": [
        22
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Timonium%2C_Maryland",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Timonium’s layout blends historic plantation roots with modern suburban planning, a balance highlighted by its planned enclave character.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/Timonium,_Maryland",
      "category": "other",
      "quality": "poor"
    },
