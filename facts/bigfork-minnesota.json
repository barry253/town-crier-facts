  "facts": [
    {
      "id": 1,
      "text": "Bigfork began when Damase \"Uncle Tom\" Neveaux built a log cabin on the Big Fork River in 1887, starting a logging settlement.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Bigfork%2C_Minnesota"
    },
    {
      "id": 2,
      "text": "The village hall, erected in 1936 with WPA funds, earned a spot on the National Register of Historic Places.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Bigfork%2C_Minnesota"
    },
    {
      "id": 3,
      "text": "In 1906, a Minneapolis and Rainy River Railway stop opened, and by 1907 Bigfork was officially incorporated as a village.",
      "sourceSentenceIds": [
        4,
        7
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Bigfork%2C_Minnesota"
    },
    {
      "id": 4,
      "text": "The community joined five neighboring towns to form the \"Edge of the Wilderness,\" branding the region as a gateway to pristine nature.",
      "sourceSentenceIds": [
        3,
        22
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.cityofbigfork.com/"
    },
    {
      "id": 5,
      "text": "Neveaux remained a squatter until 1900, when the land opened for settlement, marking the formal start of Bigfork's development.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Bigfork%2C_Minnesota"
    },
    {
      "id": 6,
      "text": "Bigfork's heart lies in lake country, where tourism fuels the local economy and showcases the area's natural beauty.",
      "sourceSentenceIds": [
        23
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.cityofbigfork.com/"
    }
  ]
