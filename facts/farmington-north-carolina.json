      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The Hunter Mercantile Building, built in 1911 by William Hunter, remains a historic downtown landmark in Farmington.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://farmingtonnm.org/plan-your-trip/blog/farmington-is-125-years-young-thriving",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "William and Clara Hunter donated the land that became Hunter Plaza Park in 1902, insisting it always serve as a public park.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://farmingtonnm.org/plan-your-trip/blog/farmington-is-125-years-young-thriving",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "East Main Street’s first three blocks jog because a historic feud shifted the north side grid, leaving a permanent misalignment.",
      "sourceSentenceIds": [
        25,
        26,
        27
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://farmingtonnm.org/plan-your-trip/blog/farmington-is-125-years-young-thriving",
