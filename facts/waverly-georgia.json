  "facts": [
    {
      "id": 1,
      "text": "Waverly’s name comes from Sir Walter Scott’s 1814 novel Waverley, a nod to the romantic literature that captivated Southern settlers.",
      "sourceSentenceIds": [
        1,
        15
      ],
      "sourceLabels": [
        "Web source 1",
        "Wikipedia"
      ],
      "source": "https://grokipedia.com/page/waverly_georgia",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town’s post office opened on July 3, 1894, marking the first formal recognition of the community’s identity.",
      "sourceSentenceIds": [
        9,
        14
      ],
      "sourceLabels": [
        "Web source 1",
        "Wikipedia"
      ],
      "source": "https://grokipedia.com/page/waverly_georgia",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Camden County, where Waverly sits, was one of Georgia’s original eight counties, formed on February 5, 1777, from colonial parishes.",
      "sourceSentenceIds": [
        2,
        8
      ],
      "sourceLabels": [
        "Web source 1",
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/waverly_georgia",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The Brunswick and Western Railroad, completed in the 1880s, linked Waverly’s inland area to the port of Brunswick, boosting lumber and agricultural trade.",
      "sourceSentenceIds": [
        10,
        11
      ],
      "sourceLabels": [
        "Web source 1",
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/waverly_georgia",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Waverly lies 14 miles south of Brunswick, bordered by the Little Satilla River to the west and surrounded by low‑lying coastal plain farmland and forest.",
      "sourceSentenceIds": [
        18,
        19
      ],
      "sourceLabels": [
        "Web source 1",
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/waverly_georgia",
      "category": "other",
      "quality": "poor",
      "qualityReason": "location_description"
    },
    {
      "id": 6,
      "text": "The region’s climate averages 68°F year‑round, with July highs near 91°F and January lows around 42°F, while about 50 inches of rain fall annually, often from summer thunderstorms and tropical storms.",
