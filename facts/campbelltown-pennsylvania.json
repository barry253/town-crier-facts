  "facts": [
    {
      "id": 1,
      "text": "Campbelltown was founded in 1759 by Scotch‑Irish farmer John Campbell and became a trolley stop between Philadelphia and Harrisburg.",
      "sourceSentenceIds": [
        1,
        22,
        24
      ],
      "sourceLabels": [
        "Web source 1",
        "Wikipedia"
      ],
      "source": "https://visitlebanonvalley.com/campbelltown/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The village was originally called “Campbell’s Town” and was laid out under a ground‑rent system that shaped its early layout.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Campbelltown%2C_Pennsylvania",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "In 1811 a post office opened, with Philip Wolfersberger as its first postmaster, marking the town’s growing permanence.",
      "sourceSentenceIds": [
        28
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Campbelltown%2C_Pennsylvania",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Campbelltown sits at the crossroads of U.S. 322 and PA‑117, where a restored arched‑roof dairy barn now frames a farmers’ market.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://campbelltownvillagesquare.com/",
      "category": "transport",
      "quality": "poor",
      "qualityReason": "route_only"
    },
    {
      "id": 5,
      "text": "The community’s heritage trail invites visitors to walk through over 250 years of history, from early Scotch‑Irish settlers to modern family values.",
      "sourceSentenceIds": [
        5,
        7,
        6
      ],
      "sourceLabels": [
        "Web source 1",
        "Web source 2"
      ],
      "source": "https://visitlebanonvalley.com/campbelltown/",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The town’s name honors its founder, John Campbell, whose 352‑acre tract was patented in 1759 and later divided among his sons in 1809.",
