  "facts": [
    {
      "id": 1,
      "text": "Green Hills began as a 1930s farming community that blossomed after World War II into one of Nashville’s most sought‑after neighborhoods.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/Green_Hills,_Nashville,_Tennessee",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Early homes in Green Hills were brick‑veneer ranch houses set on spacious lots.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Green_Hills%2C_Nashville%2C_Tennessee",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The Mall at Green Hills opened as a strip mall in the early 1950s and later became one of Nashville’s first large enclosed shopping centers.",
      "sourceSentenceIds": [
        12,
        13
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Green_Hills%2C_Nashville%2C_Tennessee",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Green Hills Market was one of Nashville’s first true supermarkets, while the Green Hills Theater was an early cinema that has since closed.",
      "sourceSentenceIds": [
        16,
        17
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Green_Hills%2C_Nashville%2C_Tennessee",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The Bluebird Café, a renowned live‑music venue, sits on Hillsboro Pike in Green Hills.",
      "sourceSentenceIds": [
        15
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Green_Hills%2C_Nashville%2C_Tennessee",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "After modest growth in the 1930s, Green Hills saw a boom post‑WWII, and today many large lots have been subdivided into higher‑density homes.",
      "sourceSentenceIds": [
        18,
        21
      ],
      "sourceLabels": [
