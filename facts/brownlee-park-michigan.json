  "facts": [
    {
      "id": 1,
      "text": "Brownlee Park sits just east of Battle Creek, forming part of the larger Battle Creek Metropolitan Statistical Area.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Brownlee_Park%2C_Michigan"
    },
    {
      "id": 2,
      "text": "The CDP embraces both Brownlee Park and the neighboring Greenfield Park, covering a mix of residential and historic sites.",
      "sourceSentenceIds": [
        10,
        11
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Brownlee_Park%2C_Michigan"
    },
    {
      "id": 3,
      "text": "A mile of crushed gravel in Brownlee Park is part of the North Country Trail, which also links to the Calhoun County Trailway.",
      "sourceSentenceIds": [
        25,
        26
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Brownlee_Park%2C_Michigan"
    },
    {
      "id": 4,
      "text": "The historic iron‑smelting village that once thrived here now hosts over 20 preserved buildings, offering a glimpse into 19th‑century industry.",
      "sourceSentenceIds": [
        3,
        6
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://everafterinthewoods.com/this-little-michigan-park-carries-a-huge-piece-of-history/"
    },
    {
      "id": 5,
      "text": "Back in its heyday, the town boasted a hotel, company office, machine shop, homes, a coronet band, a baseball team, and even a horse‑racing track.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://everafterinthewoods.com/this-little-michigan-park-carries-a-huge-piece-of-history/"
    },
    {
      "id": 6,
      "text": "From mid‑May to mid‑October, visitors can tour the historic townsite by themselves or with a guide, and lantern‑lit evenings add a unique atmosphere.",
      "sourceSentenceIds": [
