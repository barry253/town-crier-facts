  "facts": [
    {
      "id": 1,
      "text": "Opolis was founded in 1868 on the Missouri‑Kansas line and was originally called State Line because it sat directly on the state border.",
      "sourceSentenceIds": [
        1,
        7
      ],
      "sourceLabels": [
        "Web source 1",
        "Wikipedia"
      ],
      "source": "https://grokipedia.com/page/opolis_kansas",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The Joplin & Girard Railroad ran through Opolis in 1876, sparking rapid growth that later drew the Frisco line in 1882.",
      "sourceSentenceIds": [
        14,
        11
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/opolis_kansas",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Maggie Grebe Memorial Park preserves a segment of the 19th‑century Old Military Road that once linked eastern Kansas forts.",
      "sourceSentenceIds": [
        24
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/opolis_kansas",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Opolis’s first post office opened in December 1868, later called Stevenstown, Steventown, and Olopolis during its early years.",
      "sourceSentenceIds": [
        26,
        9
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Opolis%2C_Kansas",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "In 2019, Opolis celebrated its 150th anniversary with a public event at 207 Center Street, showcasing historic photographs and mining history.",
      "sourceSentenceIds": [
        16
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/opolis_kansas",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Opolis sits at 932 feet (284 meters) above sea level, giving it a modest hilltop view of the surrounding farmland.",
      "sourceSentenceIds": [
