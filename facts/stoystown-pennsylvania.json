  "facts": [
    {
      "id": 1,
      "text": "Stoystown was founded in 1774 by Daniel Stoy, one of the first settlers west of the Allegheny Mountains.",
      "sourceSentenceIds": [
        1,
        20,
        25
      ],
      "sourceLabels": [
        "Web source 1",
        "Wikipedia"
      ],
      "source": "https://www.stoystownfire.com/history.php"
    },
    {
      "id": 2,
      "text": "The town’s name evolved from Stoyestown to Stoystown when the founder added an “e” because he didn’t know how to spell it.",
      "sourceSentenceIds": [
        8,
        9
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.stoystownfire.com/history.php"
    },
    {
      "id": 3,
      "text": "A 19th‑century log home is being rebuilt by the Stoyestown Area Historical Society near the community building.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.stoystownfire.com/history.php"
    },
    {
      "id": 4,
      "text": "Stoystown once had a passenger train stop at Kantner station, but the service ended two decades later.",
      "sourceSentenceIds": [
        14
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.stoystownfire.com/history.php"
    },
    {
      "id": 5,
      "text": "The Stony Creek Encampment, a small supply depot on Forbes Road during the French & Indian War, lies just north of U.S. Route 30 near Stoystown.",
      "sourceSentenceIds": [
        18,
        19
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Stoystown%2C_Pennsylvania"
    },
    {
      "id": 6,
      "text": "Stoystown sits south‑southeast of Johnstown and northeast of Somerset, within the Johnstown Metropolitan Statistical Area.",
