  "facts": [
    {
      "id": 1,
      "text": "Cherry Hill Farmhouse opens its historic doors for free public tours every Saturday from April to October, 10 a.m. to noon.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://cherryhillfallschurch.org/events/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Visitors can grind corn in the Barn’s period machines, a hands‑on activity that brings 19th‑century farming to life.",
      "sourceSentenceIds": [
        4,
        19
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://cherryhillfallschurch.org/events/",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The Friends of Cherry Hill host seasonal teas, including Valentine’s and Mother’s Day, where guests enjoy early‑afternoon refreshments in the historic farmhouse.",
      "sourceSentenceIds": [
        12,
        13
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://cherryhillfallschurch.org/events/",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Private tours of Cherry Hill Farmhouse are available year‑round, costing $5 per person and offering a deeper dive into mid‑19th‑century rural Virginia life.",
      "sourceSentenceIds": [
        16,
        17
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://cherryhillfallschurch.org/events/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Two Girl Scout programs at Cherry Hill let scouts play Victorian‑era parlor games, write with quill pens, and earn badges in a historic setting.",
      "sourceSentenceIds": [
        22,
        23,
        26
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://cherryhillfallschurch.org/events/",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "From June to August, the City of Falls Church runs week‑long summer history camps at Cherry Hill, letting children experience 19th‑century Virginia firsthand.",
      "sourceSentenceIds": [
        30
      ],
      "sourceLabels": [
        "Web source 1"
      ],
