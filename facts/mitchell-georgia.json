    },
    {
      "id": 2,
      "text": "The town of Mitchell sprang to life on January 1, 1896, when the Augusta Southern Railroad made it a rail hub.",
      "sourceSentenceIds": [
        4,
        10
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://mitchellgeorgia.com/about",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Mitchell County was carved from Baker County on December 21, 1857, becoming Georgia’s 123rd county.",
      "sourceSentenceIds": [
        16
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Mitchell_County%2C_Georgia",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The county’s landscape lies mainly in the Lower Flint River sub‑basin of the Apalachicola‑Chattahoochee‑Flint River Basin.",
