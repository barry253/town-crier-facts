  "facts": [
    {
      "id": 1,
      "text": "Manistee sits on an isthmus between Manistee Lake and Lake Michigan, with the Manistee River bisecting the city as it flows west to the latter.",
      "sourceSentenceIds": [
        24
      ],
      "sourceLabels": [
