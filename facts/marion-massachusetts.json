      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The Marion Natural History Museum, founded in 1872, celebrated its 150th anniversary in 2022 with exhibits on local ecology and biodiversity.",
      "sourceSentenceIds": [
