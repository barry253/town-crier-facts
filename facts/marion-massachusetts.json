      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Marion’s historic Bird Island Light has watched countless maritime incidents over the years, standing guard on the coast.",
      "sourceSentenceIds": [
        10,
        25,
        27
      ],
      "sourceLabels": [
        "Web source 2"
      ],
