      "id": 1,
      "text": "Woxall was originally called Kroppestettel, meaning Crowtown in Pennsylvania Dutch.",
      "sourceSentenceIds": [
        8,
        10
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
