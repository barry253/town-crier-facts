    {
      "id": 1,
      "text": "Woxall was originally called Kroppestettel, meaning Crowtown in Pennsylvania Dutch.",
      "sourceSentenceIds": [
        8,
        10
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Woxall%2C_Pennsylvania",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "By 1877 Woxall had a post office, general store, cigar factory and 19 homes.",
      "sourceSentenceIds": [
        9,
        11
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Woxall%2C_Pennsylvania",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The village kept the name Mechanicsville until 1888 when a new post office required a different name, leading to the misread Woxall.",
      "sourceSentenceIds": [
        26,
        27,
        28,
        29
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Woxall%2C_Pennsylvania",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Woxall sits on the eastern side of Perkiomen Creek, which flows south into the Schuylkill River.",
      "sourceSentenceIds": [
        24
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Woxall%2C_Pennsylvania",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Upper Salford Township, where most of Woxall lies, was founded in 1727 as part of the original Salford Township.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://uppersalfordtownship.com/early-history/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "A 300‑year‑old Christopher Dock White Oak once stood in Woxall; after a storm it was replanted to honor the historic landmark.",
      "sourceSentenceIds": [
