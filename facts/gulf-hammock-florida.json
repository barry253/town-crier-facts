  "facts": [
    {
      "id": 1,
      "text": "Gulf Hammock grew around a crate factory started by Gunn in 1910, later owned by Edwin Wiley Grove and the Dowling brothers in 1926.",
      "sourceSentenceIds": [
        7,
        8
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Gulf_Hammock%2C_Florida",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town became a company town where the Grove-Dowling Lumber Company owned houses, churches, a hospital, and a Ford dealership.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Gulf_Hammock%2C_Florida",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "In 1913 the Atlantic Coast Line Railroad opened a line through the area, prompting Gulf Hammock to relocate closer to the tracks.",
      "sourceSentenceIds": [
        13,
        25
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Gulf_Hammock%2C_Florida",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The community’s name comes from the nearby Gulf Hammock wetlands, a large swampy area that inspired the town’s identity.",
      "sourceSentenceIds": [
        3,
        27
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Gulf_Hammock%2C_Florida",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Today, Gulf Hammock preserves its industrial past with rusting machinery and historic markers, while serving as a wildlife sanctuary.",
      "sourceSentenceIds": [
