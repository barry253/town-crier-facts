  "facts": [
    {
      "id": 1,
      "text": "Champion, Nebraska, was named after a local pioneer known as Champion S., whose influence helped establish the town.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Champion%2C_Nebraska"
    },
    {
      "id": 2,
      "text": "Champion hosts the Champion Mill State Historical Park, a preserved 19th‑century gristmill that still operates as a museum.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.nebraskatravelerguide.com/activity/champion-mill-state-historical-park-recreation-area/"
    },
    {
      "id": 3,
      "text": "The town sits in the valley of Frenchman Creek, a tributary of the Republican River, about seven miles southwest of Imperial.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Champion%2C_Nebraska"
    },
    {
      "id": 4,
      "text": "Champion’s post office opened in 1887, marking the town’s first official federal presence.",
      "sourceSentenceIds": [
        11
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://roadsidethoughts.com/ne/champion-xx-chase-profile.htm"
    },
    {
      "id": 5,
      "text": "At 3,270 feet above sea level, Champion enjoys a higher elevation than many surrounding Nebraska communities.",
