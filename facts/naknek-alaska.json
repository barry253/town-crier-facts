  "facts": [
    {
      "id": 1,
      "text": "Russian explorers first recorded the village as 'Naugiek' in 1821, later spelling it 'Naugvik' and finally 'Naknek' by 1852.",
      "sourceSentenceIds": [
        7,
        8
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Naknek%2C_Alaska"
    },
    {
      "id": 2,
      "text": "Naknek sits on the north bank of the Naknek River, just before the river empties into the Kvichak Bay arm of Bristol Bay.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Naknek%2C_Alaska"
    },
    {
      "id": 3,
      "text": "The Naknek Native Village Council is the federally recognized governing body of the Naknek Tribe, overseeing community affairs.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.nnvctribe.com/"
    },
    {
      "id": 4,
      "text": "The community’s history centers on the salmon runs that flow through Bristol Bay, sustaining local culture and economy.",
      "sourceSentenceIds": [
        23
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.nnvctribe.com/"
    },
    {
      "id": 5,
      "text": "Naknek’s post office opened in 1907, marking the town’s growing presence in the early 20th century.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Naknek%2C_Alaska"
    },
    {
