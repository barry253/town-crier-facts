      "id": 1,
      "text": "The Breckenridge‑Wheeler Area Historical Society runs a museum in the former 1884 Breckenridge train depot.",
      "sourceSentenceIds": [
        29
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://museumsdatabase.com/museums/view/15803",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The society was founded in 1987 to preserve and promote the history of the Breckenridge and Wheeler areas.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://museumsdatabase.com/museums/view/15803",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Museum displays include artifacts, photographs, and documents that chronicle the township’s farming, railroad, and industrial heritage.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://museumsdatabase.com/museums/view/15803",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "A library operated by the society houses books, newspapers, and genealogy materials about local history.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://museumsdatabase.com/museums/view/15803",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Wheeler Township contains the Village of Breckenridge, a key community within its borders.",
