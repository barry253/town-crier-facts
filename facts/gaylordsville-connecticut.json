  "facts": [
    {
      "id": 1,
      "text": "Gaylordsville takes its name from William Gaylord, a 17th‑century settler who arrived in Massachusetts in 1630 before moving to Connecticut.",
      "sourceSentenceIds": [
        16,
        18,
        21
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Gaylordsville%2C_Connecticut",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "William Gaylord was a surveyor who mapped the Housatonic Valley, laying out a road that later became Route 7.",
      "sourceSentenceIds": [
        23,
        25,
        26
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Gaylordsville%2C_Connecticut",
      "category": "people",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The town’s early tavern keeper, William Gaylord, also served as a deacon in the Puritan church, signing land grants and juries.",
      "sourceSentenceIds": [
        17,
        22
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Gaylordsville%2C_Connecticut",
      "category": "people",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The Gaylordsville Historical Society, led by President Marjorie Madera, promotes youth involvement in preserving local history.",
      "sourceSentenceIds": [
        5,
        6
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.gaylordsvillehistoricalsociety.org/",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The society offers a $500 scholarship in memory of Allen S., encouraging students to study local history.",
      "sourceSentenceIds": [
        13
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.gaylordsvillehistoricalsociety.org/",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "A log cabin built by William Gaylord west of the Housatonic River stood for three years while he cleared land and built a frame house in 1728.",
