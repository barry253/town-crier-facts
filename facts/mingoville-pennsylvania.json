  "facts": [
    {
      "id": 1,
      "text": "Mingoville sits in the Nittany Valley, a lowland bordered by Nittany Mountain to the southeast and Sand Ridge to the northwest.",
      "sourceSentenceIds": [
        18
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/mingoville_pennsylvania",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town’s name likely comes from “Mingo,” the Lenape word for western Iroquoian groups, or from Chief Logan, a 18th‑century Mingo leader.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/mingoville_pennsylvania",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Mingoville lies along Pennsylvania Route 64, about 3 miles southwest of Hublersburg and 2 miles northeast of Zion.",
      "sourceSentenceIds": [
        14,
        20
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Mingoville%2C_Pennsylvania",
      "category": "other",
      "quality": "poor",
      "qualityReason": "location_description"
    },
    {
      "id": 4,
      "text": "The area was first settled by Scots‑Irish and German pioneers in the 1780s, drawn to the valley’s fertile limestone soils.",
      "sourceSentenceIds": [
        27
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/mingoville_pennsylvania",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Winters in Mingoville bring roughly 30 inches of snow, thanks to orographic lift from westerly winds hitting the valley’s ridges.",
      "sourceSentenceIds": [
        22
