  "facts": [
    {
      "id": 1,
      "text": "Culver City was incorporated on September 20, 1917, and named after its founder, Harry Culver.",
      "sourceSentenceIds": [
        7,
        11
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Culver_City%2C_California",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The first film studio in Culver City was built by Thomas Ince in 1918 for The Triangle Motion Picture Company.",
      "sourceSentenceIds": [
        28
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Culver_City%2C_California",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Hal Roach built his studios in Culver City in 1919, and MGM took over the Triangle complex in 1924.",
      "sourceSentenceIds": [
        29
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Culver_City%2C_California",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Sony Pictures Studios, originally MGM Studios, occupies the former Metro‑Goldwyn‑Mayer lot that moved into Culver City in the 1920s.",
      "sourceSentenceIds": [
        13
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Culver_City%2C_California",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Culver City Bus, founded March 4, 1928, is the second oldest municipal bus line in California and the oldest public transit system still operating in Los Angeles County.",
      "sourceSentenceIds": [
        15
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Culver_City%2C_California",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The Tongva (Gabrielino) Indians originally inhabited the area that later became Culver City, before Spanish explorers divided it into land grants like Rancho La Ballona.",
