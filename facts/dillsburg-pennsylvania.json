      "id": 1,
      "text": "Dillsburg takes its name from Matthew Dill, an Irish immigrant who settled here in 1740.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Dillsburg%2C_Pennsylvania",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town’s oldest landmark, Dill’s Tavern, dates back to the 1750s, with the current building built between 1794 and 1819.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Dillsburg%2C_Pennsylvania",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Nestled in the foothills of the Blue Ridge Mountains, Dillsburg enjoys a scenic backdrop that locals call home.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://dillsburg.com/",
      "category": "other",
      "quality": "poor",
      "qualityReason": "editorial_filler"
    },
    {
      "id": 4,
      "text": "Every month, Dillsburg hosts candlelit First Fridays, complete with hearth‑cooked dinners and craft beverage tastings.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.yorkpa.org/plan-your-trip/about-york-county/towns-of-york-county/dillsburg/",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Local orchards offer pick‑your‑own strawberries, raspberries, blueberries, blackberries, sunflowers, apples, and pumpkins.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.yorkpa.org/plan-your-trip/about-york-county/towns-of-york-county/dillsburg/",
