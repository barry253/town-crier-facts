  "facts": [
    {
      "id": 1,
      "text": "Klein takes its name from Mike Klein, a Bohemian immigrant who arrived in Montana in 1879 to work for the Montana Cattle Company.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.mtmemory.org/nodes/view/128794"
    },
    {
      "id": 2,
      "text": "In 1909, Milwaukee Road employees uncovered coal on Klein’s property, sparking a mining boom that would shape the town.",
      "sourceSentenceIds": [
        29
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.mtmemory.org/nodes/view/128794"
    },
    {
      "id": 3,
      "text": "The Milwaukee Road built a transcontinental line through the Musselshell Valley, just north of the Bull Mountains’ coal deposits.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://montanahistoriclandscape.com/tag/klein-montana/"
    },
    {
      "id": 4,
      "text": "When the railroad switched to diesel, coal demand fell and Klein was largely abandoned, leaving only a few residents.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.mtmemory.org/nodes/view/128794"
    },
    {
      "id": 5,
      "text": "Klein’s ‘new’ UMW cemetery sits in the Bull Mountains’ bluffs, marking the town’s historic coal‑mining past.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://montanahistoriclandscape.com/tag/klein-montana/"
    },
    {
      "id": 6,
      "text": "The community sits at 3,300 feet above sea level, a typical elevation for Montana’s western plains.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.mtmemory.org/nodes/view/128794"
    }
  ]
