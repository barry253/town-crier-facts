  "facts": [
    {
      "id": 1,
      "text": "Register was named after Franklin Pierce Register, who moved there in 1894 and became the town’s postmaster.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.bullochhistory.com/marker-register"
    },
    {
      "id": 2,
      "text": "The town grew from a small turpentine community into a thriving agricultural hub by the early 1900s.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.bullochhistory.com/marker-register"
    },
    {
      "id": 3,
      "text": "In 1904, Register School consolidated several rural schools, marking a regional educational milestone.",
      "sourceSentenceIds": [
        18
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.bullochhistory.com/marker-register"
    },
    {
      "id": 4,
      "text": "The railroad’s decline in the 1950s led residents to incorporate Register as a city in 1982.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.bullochhistory.com/marker-register"
    },
    {
      "id": 5,
      "text": "Register’s historic Mill Creek Schoolhouse now houses City Hall, preserving a 19th‑century building.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.bullochhistory.com/marker-register"
    },
    {
      "id": 6,
      "text": "Four to six passenger trains and three freight trains passed through Register daily, fueling its early economy.",
