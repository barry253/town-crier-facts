  "facts": [
    {
      "id": 1,
      "text": "Shingle Creek Crossing, once Brookdale Center, was the Twin Cities' third enclosed mall, debuting in 1962 with Sears and JCPenney.",
      "sourceSentenceIds": [
        14,
        15,
        16
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Shingle_Creek_Crossing"
    },
    {
      "id": 2,
      "text": "Phase two added Dayton's in 1966 and Donaldson's in 1967, expanding the mall’s anchor lineup.",
      "sourceSentenceIds": [
        16,
        17,
        18
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Shingle_Creek_Crossing"
    },
    {
      "id": 3,
      "text": "In 2001, Mervyn's occupied the former Carson's spot, the only major renovation before the mall closed in 2010.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Shingle_Creek_Crossing"
    },
    {
      "id": 4,
      "text": "Shingle Creek’s streets and borders map Minneapolis’s expansion, telling a vivid story of the city’s urban rise.",
      "sourceSentenceIds": [
        8,
        9
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://shinglecreekmpls.org/discover-shingle-creek/"
    },
    {
      "id": 5,
      "text": "The park and neighborhood both take their name from the creek that runs through the area.",
