  "facts": [
    {
      "id": 1,
      "text": "Chiswick’s historic St Nicholas church, designed by Norman Shaw, dates back to the 19th‑century parish foundation and still hosts community events.",
      "sourceSentenceIds": [
        21
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.chiswickw4.com/info/conhistory.htm",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The 1902 Voysey House in Barley Mow Passage was Charles Voysey’s only industrial building and is now a celebrated Arts and Crafts landmark.",
      "sourceSentenceIds": [
        14,
        17
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Chiswick",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "During World War II, Chiswick endured a V2 rocket attack that killed three people, a tragedy commemorated by a local memorial.",
      "sourceSentenceIds": [
        28,
        21
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.chiswickw4.com/info/conhistory.htm",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Chiswick’s boathouse on Hartington Road houses the University of London Boat Club and several college rowing teams, a hub for London’s rowing scene.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Chiswick",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The former Griffin brewery, founded in 1701 by Thomas Mawson, once supplied ales to the Thames‑side community and is a reminder of Chiswick’s brewing heritage.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://brentfordandchiswicklhs.org.uk/search-discover/chiswick-history-homepage/gill-cleggs-brief-history-of-chiswick/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Chiswick’s Turnham Green was the site of a 1642 battle where 36,000 soldiers clashed, making it one of Britain’s largest engagements of the Civil War.",
