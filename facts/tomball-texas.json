  "facts": [
    {
      "id": 1,
      "text": "Tomball was renamed in 1907 from Peck to honor Thomas Henry Ball, the congressman who steered the railroad through the town.",
      "sourceSentenceIds": [
        2,
        10
      ],
      "sourceLabels": [
        "Web source 1",
        "Wikipedia"
      ],
      "source": "https://tomballtx.gov/113/History-of-Tomball",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The historic downtown depot that sparked the renaming still stands, and the town’s name literally means “Tom Ball.”.",
      "sourceSentenceIds": [
        2,
        4
      ],
      "sourceLabels": [
        "Web source 1",
        "Web source 2"
      ],
      "source": "https://tomballtx.gov/113/History-of-Tomball",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Tomball’s German roots show up in its early architecture, and the town still celebrates that heritage in its annual festivals.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.tourtexas.com/destinations/Tomball",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The Tomball Museum Center houses a collection of 19th‑century homes, churches, and buildings that let visitors step back into the town’s pioneer days.",
