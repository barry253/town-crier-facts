  "facts": [
    {
      "id": 1,
      "text": "Iliff, Colorado, takes its name from John Wesley Iliff, the famed cattle king who owned a ranch near the town site.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Iliff%2C_Colorado",
      "category": "people",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "By the late 1870s, Iliff controlled about 35,000 cattle and 15,558 acres, supplying beef to Union Pacific crews and army posts.",
      "sourceSentenceIds": [
        5,
        15
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Iliff%2C_Colorado",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The Union Pacific Railroad finished its line between LaSalle and Julesburg in 1881, turning Iliff into a key cattle shipping hub.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Iliff%2C_Colorado",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The town was officially platted in 1887, the same year Logan County was carved from Weld County.",
      "sourceSentenceIds": [
        21
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Iliff%2C_Colorado",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Iliff sits on the fertile banks of the South Platte River, a river that has long been a cornerstone of the community.",
      "sourceSentenceIds": [
        17,
        18
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Iliff%2C_Colorado",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Residents of Iliff survived a devastating 1949 blizzard and a 1965 South Platte flood, showcasing the town’s resilience.",
      "sourceSentenceIds": [
        16,
