  "facts": [
    {
      "id": 1,
      "text": "Agawam’s name originates from a Native American village on the Connecticut River, meaning “unloading place” or “fish‑curing place.”.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Agawam%2C_Massachusetts",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "In 1636 William Pynchon purchased land from the Agawam tribe, setting the stage for the founding of Springfield, Chicopee, and Agawam.",
      "sourceSentenceIds": [
        28
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Agawam%2C_Massachusetts",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The Agawam Historical Association preserves the town’s past, operating the Agawam Historical and Fire House Museum and the Thomas Smith House.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Agawam%2C_Massachusetts",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Agawam’s public library began in 1891, and Minerva Porter Davis donated a building in 1924 that still houses the Agawam Center Library.",
      "sourceSentenceIds": [
        15,
        17,
        19
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Agawam%2C_Massachusetts",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Six Flags New England, once called Riverside Park, sits in Agawam and was once one of the largest amusement parks in the United States.",
      "sourceSentenceIds": [
        25
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Agawam%2C_Massachusetts",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "In 1953 WWLP, an NBC affiliate, opened studios on Provin Mountain in Feeding Hills, making Agawam a regional broadcast hub.",
