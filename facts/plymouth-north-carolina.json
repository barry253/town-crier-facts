  "facts": [
    {
      "id": 1,
      "text": "Plymouth hosts the Port O'Plymouth History Museum in a 1923 train depot, housing a nationally recognized Civil War belt-buckle collection.",
      "sourceSentenceIds": [
        1,
        6
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 2"
      ],
      "source": "https://en.wikipedia.org/wiki/Plymouth%2C_North_Carolina"
    },
    {
      "id": 2,
      "text": "The town was the site of the Battle of Plymouth, North Carolina’s second‑largest Civil War battle and its last Confederate victory.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Plymouth%2C_North_Carolina"
    },
    {
      "id": 3,
      "text": "The CSS Albemarle, the most successful ironclad of the war, sank in Plymouth’s harbor on Oct 27, 1864, and its bell is on display.",
      "sourceSentenceIds": [
        10,
        19
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 2"
      ],
      "source": "https://en.wikipedia.org/wiki/Plymouth%2C_North_Carolina"
    },
    {
      "id": 4,
      "text": "Plymouth’s downtown features the historic Roanoke River Maritime Museum and a replica of the 1865‑1885 Roanoke River Lighthouse.",
      "sourceSentenceIds": [
        15
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.ourstate.com/harbor-towns-downtown-plymouth-nc/"
    },
    {
      "id": 5,
      "text": "Every June, Plymouth hosts the National Black Bear Festival, drawing about 30,000 visitors to celebrate local bear heritage.",
      "sourceSentenceIds": [
        14
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.ourstate.com/harbor-towns-downtown-plymouth-nc/"
    },
    {
      "id": 6,
      "text": "The town sits on the Roanoke River, roughly seven miles upriver from its mouth into Albemarle Sound, giving it strategic river access.",
