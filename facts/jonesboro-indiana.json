  "facts": [
    {
      "id": 1,
      "text": "Jonesboro was founded in 1837 by pioneer Obadiah Jones and named after him.",
      "sourceSentenceIds": [
        1,
        3
      ],
      "sourceLabels": [
        "Web source 1",
        "Wikipedia"
      ],
      "source": "https://www.grantcounty.com/news/from-pioneer-roots-to-a-connected-future-spotlight-on-jonesboro",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The first log cabin built by Obadiah Jones in 1834 still stands in Jonesboro Park, restored by the historical society.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.grantcounty.com/news/from-pioneer-roots-to-a-connected-future-spotlight-on-jonesboro",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Historic Main Street hosts the Jonesboro Historical Museum, open weekends, showcasing hundreds of artifacts of the city’s past.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.grantcounty.com/news/from-pioneer-roots-to-a-connected-future-spotlight-on-jonesboro",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The city celebrates its heritage with events like the Old Settlers’ Day Festival at Jonesboro Park, where pioneer crafts, food, and music revive the 19th century.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.grantcounty.com/news/from-pioneer-roots-to-a-connected-future-spotlight-on-jonesboro",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Jonesboro is located along the Mississinewa River opposite Gas City, a key river crossing in Grant County.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Jonesboro%2C_Indiana",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The city features a fresh downtown greenspace and community hub that replaced an old bank building, thanks to a partnership with Radiant Health’s Hands of Hope.",
