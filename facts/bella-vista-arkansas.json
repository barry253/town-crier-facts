  "facts": [
    {
      "id": 1,
      "text": "Bella Vista began as a 1909 summer resort envisioned by a Bentonville minister, featuring golf, tennis, and inexpensive cabin lots.",
      "sourceSentenceIds": [
        14
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Bella_Vista%2C_Arkansas",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "In 1915, Lake Bella Vista was created by damming Little Sugar Creek, adding a waterway that now borders the town.",
      "sourceSentenceIds": [
        15
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Bella_Vista%2C_Arkansas",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The Linebarger Brothers Realty Company bought the resort in 1916, adding the Sunset Hotel and Wonderland Cave nightclub to attract city dwellers.",
      "sourceSentenceIds": [
        16
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Bella_Vista%2C_Arkansas",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The Bella Vista Property Owners Association, formed in 1965 as the Country Club, has governed the village’s amenities and water services ever since.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.bellavistamuseum.org/bellavistamuseumbella-vista-history",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The Bella Vista Historical Museum, opened in 1985, preserves early cabins like the Blackwell-Paisley and Hagler-Cole, all on the National Register.",
      "sourceSentenceIds": [
        7,
        4
      ],
      "sourceLabels": [
        "Web source 2",
        "Wikipedia"
      ],
      "source": "https://www.bellavistamuseum.org/bellavistamuseumbella-vista-history",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Bella Vista became a retirement community in 1965 and only incorporated as a city after a 2006 vote by its property owners.",
      "sourceSentenceIds": [
        18
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
