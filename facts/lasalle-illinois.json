      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The Hegeler-Carus Mansion in La Salle is a National Historic Landmark and is one of the city's most treasured historic sites.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/La_Salle%2C_Illinois",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Named after French explorer René-Robert Cavelier, sieur de La Salle, who built a fort nearby in 1682.",
      "sourceSentenceIds": [
        28
      ],
      "sourceLabels": [
        "Web source 2"
      ],
