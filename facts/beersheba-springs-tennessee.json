  "facts": [
    {
      "id": 1,
      "text": "Beersheba Springs got its name when Beersheba Porter Cain discovered a chalybeate spring there in 1833.",
      "sourceSentenceIds": [
        20
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Beersheba_Springs%2C_Tennessee",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "In 1854, retired slave trader Colonel John Armfield bought the land and built a luxury hotel, cabins, and a wooden observatory for guests.",
      "sourceSentenceIds": [
        18,
        27,
        30
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Beersheba_Springs%2C_Tennessee",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Armfield’s resort featured laundry facilities, ice houses, billiard rooms, and bowling alleys, making it a full‑service getaway for the era.",
      "sourceSentenceIds": [
        28
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Beersheba_Springs%2C_Tennessee",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "French chefs and New Orleans bands were hired to entertain visitors, giving the resort a cosmopolitan flair uncommon in rural Tennessee.",
      "sourceSentenceIds": [
        29,
        10
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 2"
      ],
      "source": "https://en.wikipedia.org/wiki/Beersheba_Springs%2C_Tennessee",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The town’s mineral waters were believed to have health‑giving properties, attracting wealthy guests from Nashville and beyond.",
      "sourceSentenceIds": [
        23,
        19
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Beersheba_Springs%2C_Tennessee",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "In 1980, the historic resort area was listed on the National Register of Historic Places, preserving its 19th‑century character.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
