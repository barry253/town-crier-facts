  "facts": [
    {
      "id": 1,
      "text": "Founded in 1833 by Julius Warren after a failed gristmill, the town was named for its pioneer founder.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Warrenville%2C_Illinois",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "After an early railroad rejection, the Chicago Aurora and Elgin line arrived in 1902 and served Warrenville until the late 1950s.",
      "sourceSentenceIds": [
        6,
        7
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Warrenville%2C_Illinois",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The Greek‑Revival Albright Building, once an art studio, now houses the Warrenville Historical Museum & Art Gallery opened in 1984.",
      "sourceSentenceIds": [
        11,
        14
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.warrenvillehistorical.org/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Since 1980, the Warrenville Historical Society has preserved local heritage, running the museum and a free mobile walking tour.",
      "sourceSentenceIds": [
        10,
        15
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.warrenvillehistorical.org/",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Julius Warren built the town’s first inn and tavern in 1838; the structure still stands and was renovated in 2002.",
      "sourceSentenceIds": [
        26,
        27
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Warrenville%2C_Illinois",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Julius operated a stagecoach line on a plank road that linked Warrenville with Naperville and Winfield.",
      "sourceSentenceIds": [
        28
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Warrenville%2C_Illinois",
