  "facts": [
    {
      "id": 1,
      "text": "Sardis City began as the town of Fenton, with its first store opening in the early 1880s and official founding dated to 1882.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://encyclopediaofalabama.org/article/sardis-city/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town incorporated in May 1963 under the name Sardis and later adopted the name Sardis City during the 1980s.",
      "sourceSentenceIds": [
        1,
        11
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Sardis_City%2C_Alabama",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Perched 1,080 feet above sea level, Sardis City sits atop the plateau of Sand Mountain.",
      "sourceSentenceIds": [
        16
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Sardis_City%2C_Alabama",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Water from Sardis City flows east into Short Creek, a north‑flowing tributary that feeds the Tennessee River.",
      "sourceSentenceIds": [
        17
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Sardis_City%2C_Alabama",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The Tennessee Valley Divide skirts just west of Sardis City, marking a watershed boundary.",
      "sourceSentenceIds": [
        18
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Sardis_City%2C_Alabama",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Sardis City lies in northern Etowah County, with a small northern section spilling into Marshall County.",
