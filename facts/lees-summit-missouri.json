  "facts": [
    {
      "id": 1,
      "text": "Founded as Strother in 1865 by William B. Howard, the town was renamed Lee’s Summit in 1868 after a brief period of dual names.",
      "sourceSentenceIds": [
        1,
        2,
        4,
        7
      ],
