  "facts": [
    {
      "id": 1,
      "text": "Perryville was first called Perry, named after Captain K.W. Manning, and later expanded to Perryville.",
      "sourceSentenceIds": [
        1,
        13
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Perryville%2C_Alaska",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "After the 1912 Novarupta eruption, Alutiiq survivors founded Perryville as a refuge.",
      "sourceSentenceIds": [
        6,
        9,
        24
      ],
      "sourceLabels": [
        "Web source 1",
        "Wikipedia"
      ],
      "source": "https://grokipedia.com/page/perryville_alaska",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Perryville sits on the south shore of the Alaska Peninsula at the mouth of the Kametolook River, facing the Chiachi Islands.",
      "sourceSentenceIds": [
        15,
        16
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Perryville%2C_Alaska",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Perryville experiences a maritime climate with 127 inches of annual precipitation, 58 inches of snow, temperatures ranging 21°F to 60°F, and frequent high winds, fog, and cyclonic storms.",
      "sourceSentenceIds": [
        26
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/perryville_alaska",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Perryville is only reachable by air through a state-owned gravel airstrip or by sea via cargo barges, with no road connections to other communities.",
      "sourceSentenceIds": [
        27
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/perryville_alaska",
      "category": "transport",
      "quality": "poor",
      "qualityReason": "vague"
    },
    {
      "id": 6,
      "text": "The community maintains a subsistence-based lifestyle centered on maritime hunting, fishing, and gathering.",
