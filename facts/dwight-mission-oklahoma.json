  "facts": [
    {
      "id": 1,
      "text": "Dwight Mission was the first American mission to Native Americans established west of the Mississippi River.",
      "sourceSentenceIds": [
        13
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://blogoklahoma.us/places/county/sequoyah/dwight-mission-130/"
    },
    {
      "id": 2,
      "text": "Dwight Mission was named after Timothy Dwight, the President of Yale University and a member of the American Board of Commissioners for Foreign Missions.",
      "sourceSentenceIds": [
        5,
        6
      ],
      "sourceLabels": [
        "Web source 1",
        "Wikipedia"
      ],
      "source": "https://www.okhistory.org/publications/enc/entry?entry=DW001"
    },
    {
      "id": 3,
      "text": "The mission was reestablished on Sallisaw Creek in May 1829 after the Western Cherokees were forced to move into Indian Territory.",
      "sourceSentenceIds": [
        7,
        21,
        22
      ],
      "sourceLabels": [
        "Web source 1",
        "Wikipedia"
      ],
      "source": "https://www.okhistory.org/publications/enc/entry?entry=DW001"
    },
    {
      "id": 4,
      "text": "At its peak, Dwight Mission consisted of twenty-one houses, a large dining hall, a barn, and several outbuildings.",
      "sourceSentenceIds": [
        25
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Dwight_Mission%2C_Oklahoma"
    },
    {
      "id": 5,
      "text": "Dwight Mission was listed in the National Register of Historic Places in 1973.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.okhistory.org/publications/enc/entry?entry=DW001"
    },
    {
      "id": 6,
      "text": "Dwight Mission currently serves as the home of the Dwight Mission Presbyterian Camp and Retreat Center.",
      "sourceSentenceIds": [
        19,
        27
      ],
