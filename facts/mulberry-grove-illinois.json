      "quality": "good"
    },
    {
      "id": 4,
      "text": "A landowner brokered a deal with the Vandalia Railroad, securing a station that helped shape Mulberry Grove’s development.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
