  "facts": [
    {
      "id": 1,
      "text": "Founded in 1887, Dunnellon predates Florida’s first phosphate discovery by two years.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Dunnellon%2C_Florida",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The city takes its name from John Dunn, an early railroad worker who helped bring trains to the area.",
      "sourceSentenceIds": [
        4,
        5
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Dunnellon%2C_Florida",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Dunnellon earned the nickname “Boomtown” during Florida’s first phosphate mining boom that lasted into the early 1910s.",
      "sourceSentenceIds": [
        13
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Dunnellon%2C_Florida",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The Rainbow River, once called Blue Run, meets the Withlacoochee River in Dunnellon, sending water toward the Gulf.",
      "sourceSentenceIds": [
        22
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Dunnellon%2C_Florida",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "A former phosphate pit now known as the Blue Cove subdivision sits quietly on the outskirts of Dunnellon.",
