  "facts": [
    {
      "id": 1,
      "text": "Knife River takes its name from the Ojibwe term Mokomani Zibi, meaning 'Knife River,' a nod to the sharp stones along its banks.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/knife_river_minnesota",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The Alger‑Smith Lumber Company built a 100‑mile logging railroad in 1898 that connected Knife River to the Duluth & Iron Range Railway.",
      "sourceSentenceIds": [
        13
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/knife_river_minnesota",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Knife River grew into a key port in the late 1800s, shipping timber and fish from inland areas to Lake Superior.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/knife_river_minnesota",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The 23‑mile Knife River empties directly into Lake Superior, forming a natural harbor amid rocky beaches popular for agate hunting.",
