      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town's name means 'watering place' and reflects its role as a freshwater stop for ships in the Mona Passage.",
      "sourceSentenceIds": [
        27
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Aguada%2C_Puerto_Rico",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Christopher Columbus first landed in Puerto Rico at Aguada Bay on November 19, 1493, planting a cross on the shore.",
      "sourceSentenceIds": [
        11,
        20
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 2"
      ],
      "source": "https://en.wikipedia.org/wiki/Aguada%2C_Puerto_Rico",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Aguada hosts the annual Festival de las Máscaras, a colorful parade that blends Taíno, African, and Spanish mask traditions.",
      "sourceSentenceIds": [
        10,
        9
      ],
      "sourceLabels": [
        "Web source 2",
        "Web source 1"
      ],
      "source": "https://www.trawellino.com/destinations/puerto-rico/aguada_aguada",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The historic Puente de Coloso, built in 1928, spans the Culebrinas River and is 85 feet long.",
