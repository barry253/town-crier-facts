  "facts": [
    {
      "id": 1,
      "text": "In 1843 the Long Island Rail Road built a station in Yaphank, turning the mill town into a commercial hub overnight.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Yaphank%2C_New_York"
    },
    {
      "id": 2,
      "text": "In 1846 Millville became Yaphank, a name from the Native word Yamphanke meaning “bank of a river.”.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Yaphank%2C_New_York"
    },
    {
      "id": 3,
      "text": "Yaphank hosted Camp Siegfried in the 1930s, a pro‑Nazi summer camp that drew up to a thousand visitors each week from New York City.",
      "sourceSentenceIds": [
        18
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Yaphank%2C_New_York"
    },
    {
      "id": 4,
      "text": "The Carmans River, which runs through Yaphank, powered the town’s first mills in 1739, marking the hamlet’s founding.",
      "sourceSentenceIds": [
        21
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Yaphank%2C_New_York"
    },
    {
      "id": 5,
      "text": "In 1977 Parr Meadows, a quarter‑horse racing track, operated briefly in Yaphank before closing.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Yaphank%2C_New_York"
    },
    {
