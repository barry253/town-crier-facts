  "facts": [
    {
      "id": 1,
      "text": "Baggs originated as a ranching outpost in the late nineteenth century along the Little Snake River.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/baggs_wyoming"
    },
    {
      "id": 2,
      "text": "George Baggs provided the town's name in recognition of his pioneering role in settling the area and promoting cattle ranching.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/baggs_wyoming"
    },
    {
      "id": 3,
      "text": "The Sierra Madre Mountain Range rises to the east of Baggs, while the expansive Red Desert extends westward.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/baggs_wyoming"
    },
    {
      "id": 4,
      "text": "The Bank Club Bar in Baggs is a historic building that originally served as a bank before being converted into a bar.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.wyomingcarboncounty.com/index.php/places-to-visit/baggs"
    },
    {
      "id": 5,
      "text": "Baggs is home to the Outlaw Stop, which serves as a branch of the Little Snake River Museum.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Baggs%2C_Wyoming"
    },
    {
      "id": 6,
      "text": "A severe winter during 1886 and 1887 caused a significant cattle die-off, leading to a rapid increase in sheep ranching.",
