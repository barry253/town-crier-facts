  "facts": [
    {
      "id": 1,
      "text": "Echo was originally called Empire, but the name was changed in 1874 to avoid duplication with another Minnesota township.",
      "sourceSentenceIds": [
        1,
        3
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://echomn.com/history"
    },
    {
      "id": 2,
      "text": "Echo’s steady growth was fueled by its position on a railroad line.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://echomn.com/history"
    },
    {
      "id": 3,
      "text": "Over the years Echo added sidewalks, lighting, a jail, a cemetery, a park, and a village band that played weekly through the late 1960s.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://echomn.com/history"
    },
    {
      "id": 4,
      "text": "Echo’s early economy featured dray and livery services, lumberyards, hardware and produce stores, funeral homes, restaurants, and saloons.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://echomn.com/history"
    },
    {
      "id": 5,
      "text": "Echo was officially incorporated as a city in 1892, marking its transition from a rural township to an organized municipality.",
      "sourceSentenceIds": [
