  "facts": [
    {
      "id": 1,
      "text": "Stewarts Point and Fisherman Bay have a long history with the indigenous Pomo people, Kashia Band of Pomo Indians, who have lived there for millennia.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Stewarts_Point%2C_California",
      "category": "people",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "In 2015 the Kashia Band regained ownership of part of their ancestral land at Stewarts Point, marking a significant step toward preserving their heritage.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.sonomacountynavigator.com/towns/unearthing-rich-history-stewarts-point-ca-hidden-gem-along-californias-highway-1/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The community was named after the Stewart family, the first settlers who moved there in 1856.",
      "sourceSentenceIds": [
        3,
        16
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Stewarts_Point%2C_California",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Stewarts Point was originally part of the German Rancho and was purchased by William Bihler in 1852.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Stewarts_Point%2C_California",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Nestled between towering redwoods and the vast Pacific Ocean, Stewarts Point is a living testament to California's rich history.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.sonomacountynavigator.com/towns/unearthing-rich-history-stewarts-point-ca-hidden-gem-along-californias-highway-1/",
