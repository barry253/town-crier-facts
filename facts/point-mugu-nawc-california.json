  "facts": [
    {
      "id": 1,
      "text": "In the 1980s, Point Mugu was the primary air station supporting President Reagan’s travel to his California home.",
      "sourceSentenceIds": [
        18
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.pointmuguhousing.com/history",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "In early 2013, the Navy proposed housing four MQ‑C4 Triton unmanned aerial vehicles at Point Mugu, adding about 700 personnel and expanding facilities.",
      "sourceSentenceIds": [
        19
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.pointmuguhousing.com/history",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The airfield opened June 1, 1945, and was named Armitage Field after Lt. John Armitage, who was killed testing a Tiny Tim rocket in 1944.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Naval_Air_Weapons_Station_China_Lake",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Between November 7‑9, 2018, NAWS served as the filming location for the fictional Darkstar aircraft in the opening scene of Top Gun: Maverick.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Naval_Air_Weapons_Station_China_Lake",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Point Mugu lies in the Western Mojave Desert, about 150 miles north of Los Angeles.",
      "sourceSentenceIds": [
        20
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Naval_Air_Weapons_Station_China_Lake",
      "category": "other",
      "quality": "poor",
      "qualityReason": "location_description"
    },
    {
      "id": 6,
      "text": "The installation covers more than 1,100,000 acres—larger than Rhode Island—and is the Navy’s largest single landholding for weapons research.",
