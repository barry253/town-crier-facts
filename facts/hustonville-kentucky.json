  "facts": [
    {
      "id": 1,
      "text": "Hustonville was originally called Farmington, then Hanging Fork after a post office in 1818, and finally renamed Hustonville in 1837.",
      "sourceSentenceIds": [
        1,
        28
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Hustonville%2C_Kentucky",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "In the mid‑19th century, Hustonville hosted Christian College, a notable institution of the era.",
      "sourceSentenceIds": [
        11
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Hustonville%2C_Kentucky",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The city lies near the headwaters of Hanging Fork Creek, a tributary of the Dix River.",
      "sourceSentenceIds": [
        16
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Hustonville%2C_Kentucky",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Hustonville was formally incorporated by the state assembly in 1850, cementing its status as a city.",
      "sourceSentenceIds": [
        10,
        27
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Hustonville%2C_Kentucky",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The community was once known as The Crossroads, reflecting its position on trails linking the Kentucky and Green rivers with the Falls of the Ohio.",
