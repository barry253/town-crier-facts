  "facts": [
    {
      "id": 1,
      "text": "Hatfield was founded in 1660 on land granted to General Daniel Dennison and Governor William Bradford.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Hatfield%2C_Massachusetts",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town’s historical society runs two museums: the Farm Museum, which showcases agricultural tools, and the Historical Museum, which covers everything else.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://hatfieldhistory.weebly.com/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The Historical Museum sits on the second floor of Dickinson Memorial Hall at 39 Main St., overlooking the town’s library.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://pioneervalleyhistorynetwork.org/locations/hatfield-historical-society-museum/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "A current exhibit, “Revolution Happened Here: Hatfield on the Home‑front in 1776,” highlights the town’s role in the American Revolution.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://hatfieldhistory.weebly.com/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Hatfield’s tobacco barn, home to the agricultural collection, is undergoing structural work to preserve its historic frame.",
      "sourceSentenceIds": [
        18
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://hatfieldhistory.weebly.com/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The town’s founding families include the Hastings, whose descendants produced several physicians, and the Dickinsons, whose diary informs early women’s history scholarship.",
      "sourceSentenceIds": [
        11,
        13
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Hatfield%2C_Massachusetts",
