  "facts": [
    {
      "id": 1,
      "text": "Founded in 1896 by German brothers Frederick and William Niedringhaus, Granite City began as a company town for graniteware kitchen‑utensil production.",
      "sourceSentenceIds": [
        1,
        8,
        10
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Granite_City%2C_Illinois"
    },
    {
      "id": 2,
      "text": "Granite City’s name reflects its graniteware factory origins, not the stone itself.",
      "sourceSentenceIds": [
        30
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://granitegod.com/whats-in-granite-city/"
    },
    {
      "id": 3,
      "text": "During both World Wars, Granite City became a key steel supplier, fueling the nation’s war effort.",
