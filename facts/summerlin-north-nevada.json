  "facts": [
    {
      "id": 1,
      "text": "Summerlin North takes its name from Howard Hughes’ paternal grandmother, Jean Amelia Summerlin, honoring the legacy of the billionaire’s land holdings.",
      "sourceSentenceIds": [
        3,
        7
      ],
      "sourceLabels": [
        "Web source 1",
        "Web source 2"
      ],
      "source": "https://www.reviewjournal.com/local/summerlin/what-is-the-real-history-of-summerlin-developer-unveils-archives-2910371/",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Howard Hughes bought 30,000 acres of desert in 1952 for just $3 per acre, dreaming of industrial relocation that never materialized.",
      "sourceSentenceIds": [
        14,
        16
      ],
      "sourceLabels": [
        "Web source 2",
        "Wikipedia"
      ],
      "source": "https://grokipedia.com/page/Summerlin,_Nevada",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "In 1990, the first residential area, park, and school opened in Summerlin, marking the start of the master‑planned community’s growth.",
      "sourceSentenceIds": [
        27
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Summerlin%2C_Nevada",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "A 5,000‑acre trade with the Bureau of Land Management cleared environmentally sensitive land, allowing development to begin in the early 1990s.",
      "sourceSentenceIds": [
        25
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Summerlin%2C_Nevada",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "By 2025, Summerlin West will add new villages like Kestrel and Grand Park, expanding housing, parks, and infrastructure for future residents.",
