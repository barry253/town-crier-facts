      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Buffalo Gap Historic Village surrounds the courthouse with authentic frontier buildings from 1875‑1925, not a replica.",
      "sourceSentenceIds": [
        13
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.buffalogaphistoricvillage.org/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The Santa Fe Railroad reached Buffalo Gap in 1895, after the town was bypassed by earlier rail lines.",
      "sourceSentenceIds": [
        17,
        9
      ],
      "sourceLabels": [
        "Web source 2",
        "Wikipedia"
