  "facts": [
    {
      "id": 1,
      "text": "Cosme Velho’s winding streets, famous among artists and tourists, sit atop Santa Teresa hill.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Santa_Teresa%2C_Rio_de_Janeiro",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The historic tram that once rode mule‑drawn cars now glides electric cars, a relic of 19th‑century Rio.",
      "sourceSentenceIds": [
        24,
        25,
        26
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Santa_Teresa%2C_Rio_de_Janeiro",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "After a 2011 accident, the tram line was modernized and reopened in 2015, restoring its 6‑km route in 2019.",
      "sourceSentenceIds": [
        27,
        28,
        29
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Santa_Teresa%2C_Rio_de_Janeiro",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The Museu da Chácara do Céu, once a private villa, now displays works by Matisse, Portinari, and Di Cavalcanti.",
      "sourceSentenceIds": [
        15
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Santa_Teresa%2C_Rio_de_Janeiro",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The neighborhood’s origins trace back to the 1750s when the Santa Teresa Convent was built on Desterro hill.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Santa_Teresa%2C_Rio_de_Janeiro",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Residents once organized demonstrations to preserve the tram, convincing the government to fund its revival.",
