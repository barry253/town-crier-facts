  "facts": [
    {
      "id": 1,
      "text": "East Calhoun’s lake was originally called Bde Maka Ska by the Dakota, meaning “White Earth Lake.”.",
      "sourceSentenceIds": [
        4,
        16,
        19
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://daytripper28.com/the-ultimate-guide-to-bde-maka-ska-lake-calhoun/"
    },
    {
      "id": 2,
      "text": "In 1835, Dakota village leaders requested funds from Taliaferro for winter crop storage, noting many children had come with officers from Fort Snelling.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Bde_Maka_Ska"
    },
    {
      "id": 3,
      "text": "The lake’s name changed to Lake Calhoun after John C. Calhoun, a U.S. senator, before the 2018 restoration of its original name.",
      "sourceSentenceIds": [
        3,
        5,
        24
      ],
      "sourceLabels": [
        "Web source 2",
        "Wikipedia"
      ],
      "source": "https://daytripper28.com/the-ultimate-guide-to-bde-maka-ska-lake-calhoun/"
    },
    {
      "id": 4,
      "text": "Bde Maka Ska sits at the heart of Minneapolis’s Chain of Lakes, the largest lake in the city with a 401‑acre surface area.",
      "sourceSentenceIds": [
        24,
        26
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Bde_Maka_Ska"
    },
    {
      "id": 5,
      "text": "Glacial activity 10,000 to 12,000 years ago carved the valley that later became Bde Maka Ska, a kettle lake formed by retreating ice.",
      "sourceSentenceIds": [
        27,
        29
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Bde_Maka_Ska"
    },
    {
      "id": 6,
      "text": "A plaque on the lake’s east side commemorates a mission station where Samuel and Gideon Pond created the first Dakota alphabet at Cloudman’s Village.",
