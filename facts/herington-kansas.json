  "facts": [
    {
      "id": 1,
      "text": "Herington was named after its founder, Monroe Davis Herington, who donated land and resources to establish the town in the late 19th century.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Herington%2C_Kansas",
      "category": "people",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Herington successfully got the Chicago, Kansas and Nebraska Railway to build through the town, turning it into a rail hub.",
      "sourceSentenceIds": [
        13
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.cityofherington.com/1196/Herington-History",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The Herington Public Library is a Carnegie library, a legacy of early 20th‑century philanthropy that still serves residents today.",
      "sourceSentenceIds": [
        15
