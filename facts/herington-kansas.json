      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Herington%2C_Kansas",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Just a mile south of Herington stands a Kansas Historical Marker honoring Dwight David Eisenhower, the 34th U.S. president.",
