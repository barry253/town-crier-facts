  "facts": [
    {
      "id": 1,
      "text": "Womens Bay sits on Kodiak Island’s eastern coast, an area long inhabited by the Alutiiq people.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/womens_bay_alaska",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Russian explorers established the first permanent settlement in Womens Bay during the 18th‑century colonization of Alaska.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/womens_bay_alaska",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "After World War II, the Navy built runways, hangars, and harbor facilities that now support the Coast Guard’s largest installation.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/womens_bay_alaska",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "In 1947 the Coast Guard took control of the base, and by 1972 the Navy fully transferred it to the Coast Guard.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/womens_bay_alaska",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Womens Bay’s climate is subarctic maritime, keeping temperatures mild while frequent fog and persistent rain shape daily life.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/womens_bay_alaska",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The community balances residential life with a federal installation, preserving historic WWII‑era structures that form part of a National Historic Landmark district.",
      "sourceSentenceIds": [
        4
