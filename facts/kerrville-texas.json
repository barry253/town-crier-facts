  "facts": [
    {
      "id": 1,
      "text": "Kerrville was named after James Kerr, a Texas Revolution major who settled on the Guadalupe River in the mid‑1800s.",
      "sourceSentenceIds": [
        3,
        7
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Kerrville%2C_Texas"
    },
    {
      "id": 2,
      "text": "In 1857, German miller Christian Dietert and millwright Balthasar Lich built a large grist and saw mill on a bluff, becoming the largest operation west of New Braunfels.",
      "sourceSentenceIds": [
        4,
        29
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Kerrville%2C_Texas"
    },
    {
      "id": 3,
      "text": "Stroll through Kerrville’s historic downtown to find artisan gifts and savor handcrafted meals.",
      "sourceSentenceIds": [
        14
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://kerrvillecrafted.com/"
    },
    {
      "id": 4,
      "text": "Kerrville hosts Texas’ Official State Arts & Crafts Fair, the Folk Festival, and the Renaissance Festival.",
      "sourceSentenceIds": [
        21
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Kerrville%2C_Texas"
    },
    {
      "id": 5,
      "text": "The Museum of Western Art, founded in 1983, showcases living artists focused on American West themes.",
      "sourceSentenceIds": [
        17
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Kerrville%2C_Texas"
    },
    {
      "id": 6,
      "text": "In 2026, Kerrville celebrates 250 years of American independence with events like Bird Walk & Talk and the Iconic Film Series.",
