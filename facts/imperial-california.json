      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Imperial’s early settlers built the valley’s first printing press, drugstore, school, and Chamber of Commerce, setting a rapid development pace.",
      "sourceSentenceIds": [
        20,
        21,
        3,
        8
      ],
