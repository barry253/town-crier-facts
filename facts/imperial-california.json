      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The city first opened a post office in 1901 and incorporated July 12, 1904, becoming the valley’s first incorporated city.",
      "sourceSentenceIds": [
        17,
        18,
        22
      ],
      "sourceLabels": [
        "Wikipedia"
