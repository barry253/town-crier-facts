  "facts": [
    {
      "id": 1,
      "text": "Livingston grew from a 1962 new town built on former shale oil sites, once the world's first oil boom area.",
      "sourceSentenceIds": [
        25
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Livingston%2C_West_Lothian",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town’s name comes from the village of Livingston that merged into the new town along the River Almond.",
      "sourceSentenceIds": [
        14
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Livingston%2C_West_Lothian",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Livingston hosts the Museum of the Scottish Shale Oil Industry, founded in 1990 to preserve the region’s oil shale heritage.",
      "sourceSentenceIds": [
        30
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Livingston%2C_West_Lothian",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The Almondvale Centre, formerly Almondvale Shopping Centre, spans over 90,000 square metres of retail space and is the largest shopping centre in the town.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Livingston%2C_West_Lothian",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Livingston produced Olympic swimmer Craig Benson, born and educated there, and darts champion Peter “Snakebite” Wright, both world‑class athletes.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Livingston%2C_West_Lothian",
      "category": "people",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The town’s industrial heart, Houston Industrial Estate, still houses major employers like Mitsubishi Electric, producing 150,000 air‑conditioning units annually.",
      "sourceSentenceIds": [
