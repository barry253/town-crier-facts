  "facts": [
    {
      "id": 1,
      "text": "The name Rib Mountain comes from the Ojibwe, who used the mountain as a vantage point to navigate the Wisconsin wilderness.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://discoverwisconsin.com/exploring-rib-mountain-the-history-village-adventures/"
    },
    {
      "id": 2,
      "text": "Rib Mountain is recognized as one of the oldest geological formations on earth, having formed about one and a half billion years ago.",
      "sourceSentenceIds": [
        11,
        14
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Rib_Mountain"
    },
    {
      "id": 3,
      "text": "Quartzite from Rib Mountain became a key element in the creation of sandpaper starting in 1893.",
      "sourceSentenceIds": [
        17
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://discoverwisconsin.com/exploring-rib-mountain-the-history-village-adventures/"
    },
    {
      "id": 4,
      "text": "Legends once circulated that Rib Mountain might hold gold, though many attempts to find it have failed.",
      "sourceSentenceIds": [
        18
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://discoverwisconsin.com/exploring-rib-mountain-the-history-village-adventures/"
    },
    {
      "id": 5,
      "text": "The Civilian Conservation Corps created the first paths and picnic areas at Rib Mountain in 1935.",
      "sourceSentenceIds": [
        21
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://discoverwisconsin.com/exploring-rib-mountain-the-history-village-adventures/"
    },
    {
      "id": 6,
      "text": "Rib Mountain features the Dynamite and Quarry trails, which are named after the area's historical mining features.",
