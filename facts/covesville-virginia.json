  "facts": [
    {
      "id": 1,
      "text": "Covesville first appeared as a village in 1828 along the Charlottesville‑to‑Lynchburg stagecoach road, later boosted by a railroad.",
      "sourceSentenceIds": [
        3,
        4,
        14
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.dhr.virginia.gov/historic-registers/002-5038/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town’s boom began in 1866 when a commercial apple orchard planted Albemarle Pippin apples turned Covesville into Virginia’s leading apple producer by 1995.",
      "sourceSentenceIds": [
        16,
        17,
        26
      ],
      "sourceLabels": [
        "Web source 1",
        "Web source 2"
      ],
      "source": "https://www.dhr.virginia.gov/historic-registers/002-5038/",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Covesville Historic District, listed on the National Register in 2005, showcases high‑style homes that reflect the village’s agricultural prosperity.",
      "sourceSentenceIds": [
        8,
        18,
        25
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Covesville%2C_Virginia",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Cove Presbyterian Church, built in the 19th century, is one of three individual National Register listings in the community.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Covesville%2C_Virginia",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The village’s name honors early settlers from the Shenandoah Valley, mainly Scotch‑Irish and German immigrants who arrived in the 1740s.",
      "sourceSentenceIds": [
        14,
        24
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.dhr.virginia.gov/historic-registers/002-5038/",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "In 1974, the historic church hosted a benefit led by Little Rev. Michael Dandridge to purchase a communion table, an event remembered by locals.",
