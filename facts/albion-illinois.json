  "facts": [
    {
      "id": 1,
      "text": "Albion was named after an ancient poetic reference to Great Britain, reflecting its founders’ English heritage.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Albion%2C_Illinois"
    },
    {
      "id": 2,
      "text": "The town began in 1817 as a Quaker utopia called “Morris Birkbeck’s English Prairie,” founded by Morris Birkbeck and George Flower.",
      "sourceSentenceIds": [
        20,
        28
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Albion%2C_Illinois"
    },
    {
      "id": 3,
      "text": "Albion became the county seat of Edwards County in 1821, moving the seat from Palmyra to this new town.",
      "sourceSentenceIds": [
        22
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Albion%2C_Illinois"
    },
    {
      "id": 4,
      "text": "The Edwards County Historical Museum, located at 118 S 7th Street, hosts the historic walking tour that guides visitors through Albion’s past.",
      "sourceSentenceIds": [
        11,
        6
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://albionareachamber.org/historic-walking-tour-1"
    },
    {
      "id": 5,
      "text": "The Albion City Hall on 27 West Elm Street serves as the town’s main administrative hub for permits and community services.",
