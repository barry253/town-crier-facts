  "facts": [
    {
      "id": 1,
      "text": "Lime Ridge earned its name from the limestone deposits that were first mined in the early 1800s.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Lime_Ridge%2C_Pennsylvania"
    },
    {
      "id": 2,
      "text": "In 1778, soldiers built Fort Jenkins on Lime Ridge’s hills, a defensive post that guarded the Susquehanna River.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Lime_Ridge%2C_Pennsylvania"
    },
    {
      "id": 3,
      "text": "The limestone quarried in Lime Ridge supplied bricks for Wilkes-Barre’s historic homes and was also smelted for industrial use.",
      "sourceSentenceIds": [
        11
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Lime_Ridge%2C_Pennsylvania"
    },
    {
      "id": 4,
      "text": "Nestled at 41°01′40″N 76°20′51″W, Lime Ridge sits in southern South Centre Township, Columbia County.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Lime_Ridge%2C_Pennsylvania"
    },
    {
      "id": 5,
      "text": "Lime Ridge borders the Susquehanna River to the south, U.S. Route 11 to the north, I‑80 to the east, and Almedia to the west.",
      "sourceSentenceIds": [
        13,
        14
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Lime_Ridge%2C_Pennsylvania"
    },
