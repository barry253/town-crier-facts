    },
    {
      "id": 2,
      "text": "The village was named after Henry Gratiot, a French-American trader, lead miner, and Indian Agent.",
      "sourceSentenceIds": [
        3,
        6,
        13
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 2"
      ],
      "source": "https://en.wikipedia.org/wiki/Gratiot%2C_Wisconsin"
    },
    {
      "id": 3,
      "text": "Henry Gratiot and his brother Jean Pierre arrived in October 1825 to pursue lead mining opportunities in the region.",
      "sourceSentenceIds": [
        11
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/gratiot_wisconsin"
    },
    {
      "id": 4,
      "text": "Fortunatus Berry opened the community's first post office in July 1834.",
      "sourceSentenceIds": [
        17
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Gratiot%2C_Wisconsin"
    },
    {
      "id": 5,
      "text": "The Gratiot Depot once served as a vital rail junction for the Milwaukee Road and is now a preserved landmark.",
      "sourceSentenceIds": [
