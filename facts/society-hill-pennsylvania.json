  "facts": [
    {
      "id": 1,
      "text": "Society Hill takes its name from the 17th‑century Free Society of Traders, a group of English investors granted land by William Penn.",
      "sourceSentenceIds": [
        5,
        10
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Society_Hill",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "In the 1950s, Philadelphia launched one of the first urban renewal programs to preserve historic buildings, turning Society Hill into a national model for preservation.",
      "sourceSentenceIds": [
        13,
        15,
        22,
        23
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Society_Hill",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Society Hill’s colonial architecture earned it a 2008 designation by the American Planning Association as a great American neighborhood and example of sustainable urban living.",
      "sourceSentenceIds": [
        14
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Society_Hill",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The neighborhood stretches from Walnut to Lombard Streets and from Front to 8th Street, encompassing the historic Dock Ward.",
      "sourceSentenceIds": [
        1,
        9
      ],
      "sourceLabels": [
        "Web source 2",
        "Web source 1"
      ],
      "source": "https://www.ushistory.org/tour//society-hill.htm",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Many figures who shaped early American history, including Continental Congress delegates and Declaration of Independence signers, once called Society Hill home.",
      "sourceSentenceIds": [
        25
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://philadelphia.wiki/a/Society_Hill",
      "category": "people",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Walkable greenways link Society Hill’s historic homes to northern neighborhoods, featuring public art that highlights the area’s heritage.",
      "sourceSentenceIds": [
