  "facts": [
    {
      "id": 1,
      "text": "Santana originated from the Sant’Ana Farm owned by the Society of Jesus, first mentioned in 1560 by Father José de Anchieta.",
      "sourceSentenceIds": [
        7,
        22
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Santana_(district_of_S%C3%A3o_Paulo)"
    },
    {
      "id": 2,
      "text": "The farm’s lands were divided into sesmarias at the beginning of the 19th century, laying the groundwork for the district’s layout.",
      "sourceSentenceIds": [
        8,
        23
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Santana_(district_of_S%C3%A3o_Paulo)"
    },
    {
      "id": 3,
      "text": "In the early 1940s, the construction of the Ponte das Bandeiras linked Santana to downtown São Paulo, replacing the older Ponte Grande.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.encontrasantana.com.br/santana/historia-de-santana.shtml"
    },
    {
      "id": 4,
      "text": "The Ponte das Bandeiras area later hosted sports clubs like Clube de Regatas Tietê and Clube Espéria, the latter founded in 1899 and still active.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.encontrasantana.com.br/santana/historia-de-santana.shtml"
    },
    {
      "id": 5,
      "text": "Santana’s metro presence began in the 1970s with the first station, and today Line 1 (Blue) serves four stations, including Santana itself.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Santana_(district_of_S%C3%A3o_Paulo)"
    },
    {
      "id": 6,
      "text": "The district’s name comes from Santa Ana, a fusion of Portuguese and local linguistic traditions recorded since its founding.",
      "sourceSentenceIds": [
        30
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://guiasantana.com.br/site/pagina/index/ref/historiaecultura"
    }
  ]
