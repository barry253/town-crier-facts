  "facts": [
    {
      "id": 1,
      "text": "Keller sprang up as a stop on the Texas and Pacific Railway in the early 1850s, turning the area into a bustling trade center.",
      "sourceSentenceIds": [
        7,
        23
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.cityofkeller.com/about-us/history",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Before modern utilities, Keller’s residents collected rainwater in cisterns and drew from a public well on Vine Street.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.cityofkeller.com/about-us/history",
      "category": "other",
      "quality": "poor",
      "qualityReason": "vague"
    },
    {
      "id": 3,
      "text": "The Keller History Museum, a relocated historic house on Bates Street, reopened in 2010 as a community hub for local heritage.",
      "sourceSentenceIds": [
        1,
        2
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://kellerhistorymuseum.com/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Visitors to the museum can touch and explore artifacts that bring Keller’s past to life in a hands‑on way.",
      "sourceSentenceIds": [
        13
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://kellerhistorymuseum.com/",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "In 2010, Texas Harvest Pie Company opened a bakery‑café in a historic Keller house on Main Street, blending tradition with flavor.",
