  "facts": [
    {
      "id": 1,
      "text": "Basin City was laid out in the 1950s on land owned by dry‑land farmer Loen Bailie.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Basin_City%2C_Washington",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town sprang up to support farmers who gained irrigation through the Columbia Basin Project.",
      "sourceSentenceIds": [
        11
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Basin_City%2C_Washington",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Early settlers were mostly young Idaho and southwestern Oregon farmers and WWII veterans who bought federal land.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Basin_City%2C_Washington",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Sugar beets, alfalfa, corn, asparagus, wheat and barley were the first crops planted in the new basin.",
      "sourceSentenceIds": [
        13
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Basin_City%2C_Washington",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Today Basin City is a major supplier of Washington apples, with many orchards planted in the fertile basin.",
      "sourceSentenceIds": [
        15
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Basin_City%2C_Washington",
      "category": "other",
      "quality": "poor",
      "qualityReason": "location_description"
    },
    {
      "id": 6,
      "text": "Basin Hill rises about 300 feet from the town and is visible from the Columbia River, while Rattlesnake Mountain looms 25 miles southwest.",
      "sourceSentenceIds": [
