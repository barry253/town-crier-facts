  "facts": [
    {
      "id": 1,
      "text": "Capon Bridge takes its name from the bridge over the Cacapon River, which means river of medicine water in Shawnee.",
      "sourceSentenceIds": [
        1,
        3
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 2"
      ],
      "source": "https://en.wikipedia.org/wiki/Capon_Bridge%2C_West_Virginia"
    },
    {
      "id": 2,
      "text": "A young George Washington once commanded Fort Edwards, a small outpost established in the Capon Bridge area during the French and Indian War.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://townofcaponbridge.wv.gov/caponbridgehistory"
    },
    {
      "id": 3,
      "text": "Capon Bridge was originally known as Glencoe before being incorporated by the Hampshire County Circuit Court in 1902.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Capon_Bridge%2C_West_Virginia"
    },
    {
      "id": 4,
      "text": "The Capon Bridge on US Route 50 is listed in the National Register of Historic Places for its contribution to West Virginia history.",
      "sourceSentenceIds": [
        5,
        6,
        9,
        10
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 2"
      ],
      "source": "https://en.wikipedia.org/wiki/Capon_Bridge%2C_West_Virginia"
    },
    {
      "id": 5,
      "text": "Capon Bridge is nestled in the Cacapon River valley on the eastern side of Hampshire County, West Virginia.",
      "sourceSentenceIds": [
        12
      ],
