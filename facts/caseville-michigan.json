      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town’s historic heart sits on Main Street, where the old Bailey School—built in 1887—now houses the Caseville Historical Society.",
      "sourceSentenceIds": [
        6,
        7
      ],
      "sourceLabels": [
        "Web source 2"
      ],
