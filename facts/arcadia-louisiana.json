  "facts": [
    {
      "id": 1,
      "text": "Arcadia began as a settlement in the 1820s, named for its hilly terrain, and became a town by 1903.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/Arcadia,_Louisiana",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Arcadia's growth surged in 1884 when the town moved to sit beside the Vicksburg, Shreveport & Pacific Railroad, turning it into a timber and agriculture hub.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/Arcadia,_Louisiana",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Every month, bluegrass musicians perform traditional regional songs at Arcadia's depot platform, which also hosts meetings and craft shows.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.achp.gov/preserve-america/community/arcadia-louisiana",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Arcadia sits at the highest elevation of any incorporated Louisiana town.",
