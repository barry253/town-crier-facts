  "facts": [
    {
      "id": 1,
      "text": "Santa Ysabel was founded as a sub-mission to Mission San Diego de Alcalá on September 20, 1818, serving travelers between San Diego and Sonora.",
      "sourceSentenceIds": [
        2,
        30
      ],
      "sourceLabels": [
        "Web source 2",
        "Wikipedia"
      ],
      "source": "https://grokipedia.com/page/santa_ysabel_california",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town’s name honors Saint Elizabeth of Hungary, reflecting its Spanish mission heritage.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/santa_ysabel_california",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The preserved 19‑century General Store and the Asistencia chapel are the town’s most visible historic landmarks.",
      "sourceSentenceIds": [
        1,
        3
      ],
      "sourceLabels": [
        "Web source 1",
        "Web source 2"
      ],
      "source": "https://santaysabel.org/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Santa Ysabel sits at the crossroads of Highway 78 and Highway 79, a historic travel junction in San Diego County.",
      "sourceSentenceIds": [
        20
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://santaysabel.org/",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The valley has been home to the Iipay Nation of Kumeyaay people for thousands of years, long before Spanish arrival.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 2"
      ],
