    {
      "id": 1,
      "text": "Founded in 1893 and officially incorporated on March 4, 1905, Cornelius grew from a modest settlement into a thriving town.",
      "sourceSentenceIds": [
        2,
        4
      ],
      "sourceLabels": [
        "Web source 1",
        "Wikipedia"
