  "facts": [
    {
      "id": 1,
      "text": "Needham was platted in 1866 by Noah Needham, who laid out the town’s original streets and lots.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Needham%2C_Indiana",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The first post office opened the same year the town was founded, operating as Needhams Station until 1882 when it was renamed Needham.",
      "sourceSentenceIds": [
        1,
        2,
        12
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Needham%2C_Indiana",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Needham Township, covering 35.03 square miles, was established in 1881 and includes the town of Needham and parts of Franklin City.",
      "sourceSentenceIds": [
        15,
        16,
        17
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.in.gov/townships/fun/townships/needham/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The Interstate 65 Gateway, built within Needham Township, has attracted hotels, restaurants, and warehouses like Energizer Batteries over the last decade.",
      "sourceSentenceIds": [
        18
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.in.gov/townships/fun/townships/needham/",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Most of the township’s land remains agricultural, home to family farms that have operated for multiple generations.",
      "sourceSentenceIds": [
        19
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.in.gov/townships/fun/townships/needham/",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Law enforcement in Needham is split between Franklin City police within city limits and the Johnson County Sheriff’s Department in the unincorporated areas.",
      "sourceSentenceIds": [
        21
      ],
