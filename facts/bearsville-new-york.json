      ],
      "source": "https://bearsvillecenter.com/pages/bearsville-history",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Bearsville Studios became a recording hub in the 1960s and 1970s, attracting many famous artists.",
      "sourceSentenceIds": [
        3
