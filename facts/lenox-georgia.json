  "facts": [
    {
      "id": 1,
      "text": "Lenox was platted in 1888 when the railroad reached the town, marking its birth as a rail stop.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Lenox%2C_Georgia"
    },
    {
      "id": 2,
      "text": "The town’s name comes from a local story about a lean ox that once grazed the area.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Lenox%2C_Georgia"
    },
    {
      "id": 3,
      "text": "Lenox is home to the Lean-Ox Festival, the oldest festival in Cook County, held every third weekend of November.",
      "sourceSentenceIds": [
        11,
        12
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Lenox%2C_Georgia"
    },
    {
      "id": 4,
      "text": "In 1901 the Georgia General Assembly incorporated Lenox, giving it official town status.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Lenox%2C_Georgia"
    },
    {
      "id": 5,
      "text": "The city’s core values emphasize small-town character, growth, and preservation of its historical and natural heritage.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://cityoflenox.municipalimpact.com/"
    },
    {
      "id": 6,
      "text": "Lenox is located at 31°16′N 83°28′W, about 13 miles south of Tifton and 10 miles north of Adel, the county seat.",
