      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The community once served as the brief county seat of Baldwin County in 1806 before the county split into Jasper and others.",
      "sourceSentenceIds": [
        15
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Hillsboro%2C_Georgia",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Hillsboro hosted a 1867 train depot and the Hillsboro United Methodist Church founded in 1808, marking early transportation and religious life.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 1"
      ],
