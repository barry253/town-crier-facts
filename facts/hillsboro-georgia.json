  "facts": [
    {
      "id": 1,
      "text": "Hillsboro was founded around 1795 and named after pioneer settlers John and Isaac Hill, originally spelled Hillsborough.",
      "sourceSentenceIds": [
        1,
        13
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Hillsboro%2C_Georgia",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The community once served as the brief county seat of Baldwin County in 1806 before the county split into Jasper and others.",
      "sourceSentenceIds": [
        15
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Hillsboro%2C_Georgia",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Hillsboro hosted a 1867 train depot and the Hillsboro United Methodist Church founded in 1808, marking early transportation and religious life.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/hillsboro_georgia",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Benjamin Harvey Hill, a U.S. and Confederate senator, was born in Hillsboro on September 14, 1823, at the local Hillsborough Academy.",
      "sourceSentenceIds": [
        23,
        16
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/hillsboro_georgia",
      "category": "people",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "During Sherman's March to the Sea in 1864, Hillsboro suffered damage and was sacked twice, first by Union troops and later by Stoneman’s cavalry.",
