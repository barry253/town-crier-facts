    {
      "id": 1,
      "text": "Kiryat Shmona was founded in 1950 as an immigrant transit camp on the site of former Arab village Khalasah.",
      "sourceSentenceIds": [
        4,
        8
      ],
      "sourceLabels": [
        "Web source 1",
