  "facts": [
    {
      "id": 1,
      "text": "Prairie du Rocher was founded in 1722 by French colonists, originally to supply Fort de Chartres and New Orleans with wheat and corn.",
      "sourceSentenceIds": [
        3,
        14,
        6
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 2"
      ],
      "source": "https://en.wikipedia.org/wiki/Prairie_du_Rocher%2C_Illinois",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The village’s name means “The Rock Prairie” in French, reflecting the bluffs that flank the east side of the Mississippi River.",
      "sourceSentenceIds": [
        15,
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Prairie_du_Rocher%2C_Illinois",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "In 1718 Pierre Dugué de Boisbriand built the first Fort de Chartres, just four miles west, making Prairie du Rocher a key agricultural hub for the French colony.",
      "sourceSentenceIds": [
        19,
        16,
        23
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Prairie_du_Rocher%2C_Illinois",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The town’s original layout featured long, narrow lots that extended back from the riverfront through a common, a typical French colonial design.",
      "sourceSentenceIds": [
        30
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Prairie_du_Rocher%2C_Illinois",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Prairie du Rocher’s historic Creole House, built in 1800, now serves as a museum that showcases early French‑American life.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://aboutstlouis.com/local/historic/prairie-du-rocher-il-62277",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Genealogists find Prairie du Rocher rich in family histories, with early residents including the Langlois, Blais, and Frawley families among many others.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Web source 1"
      ],
