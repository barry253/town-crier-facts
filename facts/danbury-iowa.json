  "facts": [
    {
      "id": 1,
      "text": "Dan Thomas founded Danbury in 1864, starting as a trading post called Listonville before the town grew into a settlement.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/danbury_iowa",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town’s name blends founder Daniel Thomas’s first name with Woodbury County, honoring both the pioneer and the county.",
      "sourceSentenceIds": [
        15
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Danbury%2C_Iowa",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "When the Chicago and North Western Railroad arrived in 1877, Danbury secured a depot, sparking rapid growth and commerce.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/danbury_iowa",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Every fall, Danbury hosts Corn Days, a harvest festival that celebrates the town’s agricultural roots with food, music, and parades.",
      "sourceSentenceIds": [
        13
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Danbury%2C_Iowa",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "In 1929 Danbury built a $75,000 school featuring a gymnasium-auditorium, and a public library opened in 1940, funded by local women.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/danbury_iowa",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The town celebrated its 100th anniversary in 1965 with parades, reunions, and a commemorative publication that documented its history.",
      "sourceSentenceIds": [
        7
