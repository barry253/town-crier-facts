  "facts": [
    {
      "id": 1,
      "text": "Euharlee’s name comes from Cherokee, meaning “she laughs as she runs,” a nod to the rhythmic flow of Euharlee Creek.",
      "sourceSentenceIds": [
        22
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Euharlee%2C_Georgia",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town boasts Georgia’s oldest remaining covered bridge, listed on the National Register and part of the Georgia Covered Bridge Trail.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://euharlee.com/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Just south of Euharlee, the towering cooling towers of Georgia Power’s Plant Bowen mark the state’s second‑largest coal‑fired power plant.",
      "sourceSentenceIds": [
        20
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Euharlee%2C_Georgia",
      "category": "other",
      "quality": "poor",
      "qualityReason": "vague"
    },
    {
      "id": 4,
      "text": "At the heart of downtown sits the Euharlee Welcome Center & History Museum, where visitors explore Cherokee roots to modern life through photos, videos, and quizzes.",
      "sourceSentenceIds": [
        1,
        3,
        6,
        8
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Euharlee%2C_Georgia",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Euharlee was officially incorporated on September 16, 1870, after settlers first called the area Burge’s Mill in the 1840s.",
