  "facts": [
    {
      "id": 1,
      "text": "Gadsden, Arizona takes its name from James Gadsden, the South Carolina senator who pushed for a southern railroad route.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Gadsden_Purchase"
    },
    {
      "id": 2,
      "text": "The town sits on land that was part of the 1853 Gadsden Purchase, which added southern Arizona to the United States.",
      "sourceSentenceIds": [
        5,
        8
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Gadsden_Purchase"
    },
    {
      "id": 3,
      "text": "The Gadsden Purchase allowed the Southern Pacific to build the Sunset Route, a flatter, cheaper transcontinental line that reached Phoenix.",
      "sourceSentenceIds": [
        13,
        14
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Gadsden_Purchase"
    },
    {
      "id": 4,
      "text": "Historically, the Tohono O'odham Nation once controlled the vast area that now includes Gadsden, stretching from Sonora to the Gulf of California.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.tonation-nsn.gov/history-culture/"
    },
    {
      "id": 5,
      "text": "In 2023, Gadsden County launched a revamped tourism website to attract more visitors and businesses to the region.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.wtxl.com/quincy/gadsden-county-aims-to-attract-more-visitors-and-businesses-with-a-revamped-tourism-website"
    },
    {
      "id": 6,
      "text": "The original Southern Pacific line in Arizona ran through Gadsden before being rerouted north of the Gila River to serve Phoenix.",
