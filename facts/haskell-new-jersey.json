  "facts": [
    {
      "id": 1,
      "text": "Haskell was named after Jonathan Haskell, president of the Laflin & Rand Powder Company.",
      "sourceSentenceIds": [
        1,
        3
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 2"
      ],
      "source": "https://en.wikipedia.org/wiki/Haskell%2C_New_Jersey",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The community began in 1898 as a company town for Laflin & Rand’s smokeless powder mill.",
      "sourceSentenceIds": [
        6,
        27
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 2"
      ],
      "source": "https://en.wikipedia.org/wiki/Haskell%2C_New_Jersey",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The Haskell powder mill produced the W.A..30‑caliber smokeless powder used in U.S. Army rifles until 1908.",
      "sourceSentenceIds": [
        7,
        8,
        28,
        29
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 2"
      ],
      "source": "https://en.wikipedia.org/wiki/Haskell%2C_New_Jersey",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Between 1898 and 1917 the plant suffered six major explosions, the largest occurring in October 1911.",
      "sourceSentenceIds": [
        18,
        16
      ],
      "sourceLabels": [
        "Web source 1",
        "Web source 1"
      ],
      "source": "https://wanaquelibrary.org/haskells-explosive-past/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "DuPont bought Laflin & Rand in 1902, keeping the Haskell mill running through both World Wars.",
      "sourceSentenceIds": [
        9,
        17
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Haskell%2C_New_Jersey",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The powder mill closed in 1926, ending Haskell’s era as a smokeless‑powder hub.",
      "sourceSentenceIds": [
