      "id": 1,
      "text": "Haskell was named after Jonathan Haskell, president of the Laflin & Rand Powder Company.",
      "sourceSentenceIds": [
        1,
        3
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 2"
      ],
