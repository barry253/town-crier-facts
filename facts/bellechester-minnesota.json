  "facts": [
    {
      "id": 1,
      "text": "Bellechester was laid out in 1877, its name drawn from French 'belle' meaning beautiful, reflecting its location in Chester Township.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Bellechester%2C_Minnesota"
    },
    {
      "id": 2,
      "text": "A post office opened on the Wabasha County side of Bellechester in 1879, marking the town’s early communication hub.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Bellechester%2C_Minnesota"
    },
    {
      "id": 3,
      "text": "Bellechester once served as a railway shipping point for pottery clay, linking local artisans to regional markets.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Bellechester%2C_Minnesota"
    },
    {
      "id": 4,
      "text": "The town’s core values emphasize guided growth and the preservation of its historical, cultural, and natural heritage.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://bellechestermn.com/"
    },
    {
      "id": 5,
      "text": "Most of Bellechester lies in Goodhue County, with a small portion extending into neighboring Wabasha County.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Bellechester%2C_Minnesota"
    },
    {
      "id": 6,
      "text": "County 2 Boulevard, County 16 Boulevard, and Wabasha County Road 7 form the main thoroughfares that weave through Bellechester.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Bellechester%2C_Minnesota"
    }
