      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The New Braintree Historical Society runs a 1939 grade‑school museum that opens to the public the first Sunday of each month.",
      "sourceSentenceIds": [
        5,
        6
      ],
      "sourceLabels": [
