      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Since 1992, the Massachusetts State Police Academy has trained officers on the former Seventh‑day Adventist Pioneer Valley Academy campus in New Braintree.",
      "sourceSentenceIds": [
        17,
        21
      ],
      "sourceLabels": [
        "Wikipedia"
