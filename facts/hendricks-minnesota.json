  "facts": [
    {
      "id": 1,
      "text": "Hendricks was named after Thomas A. Hendricks, the 21st Vice President elected with Grover Cleveland in 1884.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/hendricks_minnesota",
      "category": "people",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Hendricks was officially incorporated as a village on October 22, 1900, following a successful election.",
      "sourceSentenceIds": [
        14
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/hendricks_minnesota",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The community of Hendricks itself emerged as a direct result of railroad development.",
      "sourceSentenceIds": [
        13
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/hendricks_minnesota",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Lincoln County Historical Society Museum is housed in a six‑building complex near the shores of Lake Hendricks.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://mndigital.org/about/contributing-organizations/lincoln-county-historical-society",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The Hendricks Pioneer newspaper was founded in 1900, providing a vital channel for local news and commerce.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/hendricks_minnesota",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Established by Norwegian settlers on October 26, 1874, Singsaas Lutheran Church, over 135 years old, is on the National Register of Historic Places.",
