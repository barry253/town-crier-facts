  "facts": [
    {
      "id": 1,
      "text": "Colmar Manor’s name blends Columbia’s “Col” with Maryland’s “Mar,” a nod to its proximity to the Nation’s Capital.",
      "sourceSentenceIds": [
        11
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.colmarmanor.org/community/history.php",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "When Colmar Manor first opened its streets, they honored President Woodrow Wilson and his cabinet, a common practice of the era.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.colmarmanor.org/community/history.php",
      "category": "people",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Residents pushed for municipal powers in 1924, leading to Colmar Manor’s official incorporation the following year.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.colmarmanor.org/community/history.php",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Dueling Creek, once a secluded spot for over 50 duels, hosted the famous 1820 clash between Stephen Decatur and James Barron.",
      "sourceSentenceIds": [
        19,
        21
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.colmarmanor.org/community/history.php",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "On August 24, 1814, the Battle of Bladensburg unfolded near Colmar Manor, a pivotal moment in the War of 1812.",
      "sourceSentenceIds": [
        23
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Colmar_Manor%2C_Maryland",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Today, the hillside of Fort Lincoln Cemetery still shelters the remnants of the Civil War fort that once guarded Washington’s northern flank.",
      "sourceSentenceIds": [
        25
