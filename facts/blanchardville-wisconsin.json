  "facts": [
    {
      "id": 1,
      "text": "Blanchardville was originally settled in the early 1840s by members of the Church of Jesus Christ of Latter Day Saints and named Zarahemla.",
      "sourceSentenceIds": [
        1,
        3
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Blanchardville%2C_Wisconsin"
    },
    {
      "id": 2,
      "text": "Alvin Blanchard platted the village in 1857 after purchasing a mill on the Pecatonica River from the original Mormon settlers.",
      "sourceSentenceIds": [
        16,
        17
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Blanchardville%2C_Wisconsin"
    },
    {
      "id": 3,
      "text": "Blanchardville is located on the East Branch Pecatonica River and sits within both Lafayette and Iowa counties.",
      "sourceSentenceIds": [
        11,
        22
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Blanchardville%2C_Wisconsin"
    },
    {
      "id": 4,
      "text": "The arrival of the Illinois Central Railroad in 1888 turned the community of Blanchardville into a thriving trade center.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.blanchardville.com/history"
    },
    {
      "id": 5,
      "text": "Dairy farming flourished early in the town's history, with 30 cheese factories operating within five miles of Blanchardville by 1907.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.blanchardville.com/history"
    },
    {
      "id": 6,
      "text": "Norwegians are the most prominent ethnic group in Blanchardville, as the village lies between two large historic Norwegian settlements.",
