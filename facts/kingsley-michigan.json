  "facts": [
    {
      "id": 1,
      "text": "Kingsley began as a railroad stop when Judson Kingsley built a station on the Grand Rapids and Indiana line in the 1870s.",
      "sourceSentenceIds": [
        2,
        3
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Kingsley%2C_Michigan",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "In 1876 the village was officially platted as Kingsley Station, later shortened to Kingsley, marking its first formal name.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Kingsley%2C_Michigan",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The 1893 merger of Kingsley and the neighboring settlement of Paradise created the modern village of Kingsley within Paradise Township.",
      "sourceSentenceIds": [
        18
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Kingsley%2C_Michigan",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Brownson Memorial Park, a community gathering spot, features a splash pad, band shell, and a new playground funded by a half‑million‑dollar grant.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Kingsley%2C_Michigan",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The Kingsley Branch Library houses the Kingsley Area History Collection, preserving images, documents, and oral histories from the late 18th through the 19th centuries.",
      "sourceSentenceIds": [
        1,
        12
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://localhistory.tadl.org/collections/show/20",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Every June, the village hosts the Adams Fly Festival, celebrating fly fishing and featuring the original Adams Fly crafted by Len Halladay.",
