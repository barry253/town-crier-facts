  "facts": [
    {
      "id": 1,
      "text": "Dune Acres was platted in 1923 as a lakeside resort village, drawing vacationers to the southern shore of Lake Michigan.",
      "sourceSentenceIds": [
        13
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Dune_Acres%2C_Indiana",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town sits in the dune land of the south shore, where residents helped preserve parts of the Indiana Dunes.",
      "sourceSentenceIds": [
        11,
        12
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Dune_Acres%2C_Indiana",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "A former South Shore Line station on Mineral Springs Road served Dune Acres until 1994, when NICTD consolidated Porter County stops.",
      "sourceSentenceIds": [
        6,
        7
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Dune_Acres%2C_Indiana",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Today, the community relies on the nearby Dune Park station, with V‑Line’s Orange Line stopping Friday through Sunday.",
      "sourceSentenceIds": [
        8,
        9
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Dune_Acres%2C_Indiana",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The Dune Acres Clubhouse earned a spot on the National Register of Historic Places in 2007, highlighting its architectural heritage.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Dune_Acres%2C_Indiana",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Positioned northeast of Gary and west of Michigan City, Dune Acres offers quick access to both natural landmarks and urban centers.",
