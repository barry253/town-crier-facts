  "facts": [
    {
      "id": 1,
      "text": "Dracut was first settled by Europeans in 1653, shortly after the nearby town of Chelmsford was incorporated in 1655.",
      "sourceSentenceIds": [
        24
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Dracut%2C_Massachusetts",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town’s name comes from the Pennacook word Augumtoocooke, meaning “land of the great river.”.",
      "sourceSentenceIds": [
        21
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Dracut%2C_Massachusetts",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "In 1665, Bess, daughter of Sachem Passaconaway, sold the land that became Dracut to Captain John Evered for tobacco and duffill.",
      "sourceSentenceIds": [
        25
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Dracut%2C_Massachusetts",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The Coburn/Cutter House, nearly 300 years old, still stands and hosts seasonal craft fairs and community events.",
      "sourceSentenceIds": [
        14
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://revolutionaryvalley.org/cities-and-towns/dracut-massachusetts/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Dracut’s historic homes dot the town, reflecting its colonial heritage and early settlement patterns.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Dracut%2C_Massachusetts",
      "category": "history",
      "quality": "good"
    },
