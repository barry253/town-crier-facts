  "facts": [
    {
      "id": 1,
      "text": "Elsah was founded in 1853 by James Semple, who offered free lots to builders using stone from his quarry.",
      "sourceSentenceIds": [
        14
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Elsah%2C_Illinois",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The village’s name comes from Ailsa Craig, the last Scottish outcrop seen by settlers heading to America.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Elsah%2C_Illinois",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Principia College, a National Historic Landmark designed by Bernard Maybeck, sits on Elsah’s grounds and was a catalyst for the village’s revival in the 1930s.",
      "sourceSentenceIds": [
        2,
        6
      ],
      "sourceLabels": [
        "Web source 2",
        "Wikipedia"
      ],
      "source": "https://www.enjoyillinois.com/explore/listing/village-of-elsah/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Elsah’s historic commercial district on LaSalle Street preserves mostly pre‑1861 stone buildings, including four original taverns that still stand.",
      "sourceSentenceIds": [
        29
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Elsah%2C_Illinois",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "In 1973, the entire village was listed on the National Register of Historic Places, and the Principia College Historic District followed in 1993.",
      "sourceSentenceIds": [
        7,
        8
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Elsah%2C_Illinois",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The Great Flood of 1993 caused significant damage to many village structures, yet the community rebuilt and now offers a peaceful, picturesque escape.",
      "sourceSentenceIds": [
        28,
        10
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Elsah%2C_Illinois",
