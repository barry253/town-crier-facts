  "facts": [
    {
      "id": 1,
      "text": "Ste. Marie, Illinois sits on the Embarras River in Jasper County, a spot once chosen by French settlers for its proximity to Vincennes.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Ste._Marie%2C_Illinois",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Two Illinois communities share the name Sainte Marie—one in Jasper County and another in Cook County—highlighting the name’s regional popularity.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://roadsidethoughts.com/il/sainte-marie-xx-jasper-profile.htm",
      "category": "other",
      "quality": "poor",
      "qualityReason": "other"
    },
    {
      "id": 3,
      "text": "In 1837, five French brothers and relatives founded the village, signing a contract to acquire land and build a new community in eastern Illinois.",
      "sourceSentenceIds": [
        20,
        21
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Ste._Marie%2C_Illinois",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Joseph Picquet, a 19‑year‑old French explorer, was sent to the United States in 1835 to scout land for his family’s future colony.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Ste._Marie%2C_Illinois",
      "category": "people",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Father Stephen Theodore Badin, the first Catholic priest ordained in the United States, blessed the new settlers’ work and celebrated Mass in their honor.",
      "sourceSentenceIds": [
        28
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Ste._Marie%2C_Illinois",
