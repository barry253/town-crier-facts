  "facts": [
    {
      "id": 1,
      "text": "Barrows laid out Galatia in 1885, and Weber renamed it after his hometown of Galatia, Illinois.",
      "sourceSentenceIds": [
        5,
        6
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Galatia%2C_Kansas",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The Santa Fe Railroad arrived in 1916, extending its line to Galatia by 1919 and turning the town into a regional trade hub.",
      "sourceSentenceIds": [
        17,
        18
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://unitedstatesghosttowns.com/galatia-kansas-ghost-town/",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "At its 1921 peak, Galatia housed 202 residents and boasted three grain elevators, a bank, and several stores.",
      "sourceSentenceIds": [
        14
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://unitedstatesghosttowns.com/galatia-kansas-ghost-town/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "From 1889 to 1966, Galatia’s post office served as a key mail distribution center for surrounding farms.",
      "sourceSentenceIds": [
        19
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://unitedstatesghosttowns.com/galatia-kansas-ghost-town/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Today, only a few historic sites survive, including Fairview Cemetery, an old Lutheran church, and an active farmer’s co‑op.",
      "sourceSentenceIds": [
        16
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://unitedstatesghosttowns.com/galatia-kansas-ghost-town/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The first building erected in Galatia was a historic United Brethren church.",
