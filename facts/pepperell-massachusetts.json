  "facts": [
    {
      "id": 1,
      "text": "Pepperell was founded in 1753 and named for Sir William Pepperrell, the colonial soldier who captured Louisbourg.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://town.pepperell.ma.us/131/History-of-the-Town"
    },
    {
      "id": 2,
      "text": "Pepperell sits where the Nissitissit River meets the Nashua River.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Pepperell%2C_Massachusetts"
    },
    {
      "id": 3,
      "text": "Paper mills began in 1835 and shoe factories followed in the 1830s, with the Leighton Shoe factory opening in 1868 and driving Pepperell’s growth until after World War II.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://town.pepperell.ma.us/884/Pepperell-History"
    },
    {
      "id": 4,
      "text": "The Worcester & Nashua Railroad arrived in 1848, running along the Nashua River and spurring Pepperell’s expansion in 1857.",
      "sourceSentenceIds": [
        9,
        17
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Pepperell%2C_Massachusetts"
    },
    {
      "id": 5,
      "text": "The Pepperell Center Historic District, listed on the National Register, surrounds the town hall, a covered bridge, and the 1901 Lawrence Library.",
