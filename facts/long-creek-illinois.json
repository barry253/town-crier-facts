      "quality": "good"
    },
    {
      "id": 2,
      "text": "In 1828, a band of Kickapoo from Oklahoma camped along the creek, trapping and fishing before settlers arrived.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
