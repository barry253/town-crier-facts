  "facts": [
    {
      "id": 1,
      "text": "Unionville was first settled in 1854 by Horace C. Marvin and Andrew Marshall, who cleared land and built the first log house and general store.",
      "sourceSentenceIds": [
        26,
        27,
        28
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://thumbwind.com/2025/05/11/unionville-michigan-in-1910/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The village’s first post office opened in 1857 under the name “Akron” before becoming Unionville’s post office during the Civil War, with Marvin as postmaster.",
      "sourceSentenceIds": [
        29
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://thumbwind.com/2025/05/11/unionville-michigan-in-1910/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "In 1881 the Saginaw, Tuscola & Huron Railroad reached Unionville, giving the village a depot and connecting it to broader markets.",
      "sourceSentenceIds": [
        6,
        7
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://thumbwind.com/2025/05/11/unionville-michigan-in-1910/",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Unionville was officially incorporated as a village on April 1, 1879, solidifying its local governance.",
      "sourceSentenceIds": [
        30
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://thumbwind.com/2025/05/11/unionville-michigan-in-1910/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Unionville sits in Tuscola County, part of Michigan’s Thumb region, which is a subregion of the Flint/Tri-Cities area.",
