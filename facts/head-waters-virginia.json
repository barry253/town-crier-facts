  "facts": [
    {
      "id": 1,
      "text": "Head Waters earned its name from the headwaters of the Cowpasture River to the south and the South Fork South Branch Potomac River to the north.",
      "sourceSentenceIds": [
        22,
        30
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/head_waters_virginia",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Settled in the mid‑1700s, Head Waters grew around Scotch‑Irish, English, and German pioneers who established farms, mills, and livestock operations amid rugged Appalachia.",
      "sourceSentenceIds": [
        23
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/head_waters_virginia",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The community sits precisely on the Eastern Continental Divide, separating waters that flow into the James River system from those draining into the Potomac.",
      "sourceSentenceIds": [
        21
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/head_waters_virginia",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Early surveys in the 1740s granted tracts along the Bullpasture and Cowpasture rivers to families such as the Bodkins, Millers, and Wilsons, who cleared woodlands for homesteads.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/head_waters_virginia",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Before European colonization, Native Americans, especially the Shawnee, used the Head Waters area as a hunting ground and transit route across the Potomac watershed.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/head_waters_virginia",
