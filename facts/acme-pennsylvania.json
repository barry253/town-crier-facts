      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "In the late 19th century, Acme became a key Pennsylvania Railroad stop, hauling coal and steel from the Ligonier Valley.",
      "sourceSentenceIds": [
        19
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.trawellino.com/destinations/united-states/pennsylvania_acme",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The town once had a bustling mining community of about 2,800 residents before coal ran out, leading to its semi‑abandoned status.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://unitedstatesghosttowns.com/acme-pennsylvania-ghost-town/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Underground fires burning at 900°F have made the terrain unstable and released toxic gases, contaminating nearby waters.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://unitedstatesghosttowns.com/acme-pennsylvania-ghost-town/",
      "category": "nature",
      "quality": "good"
    },
