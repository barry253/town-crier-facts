  "facts": [
    {
      "id": 1,
      "text": "Gunpowder Town, the first English settlement on the Gunpowder River, failed because its location proved unsuitable for a thriving community.",
      "sourceSentenceIds": [
        22,
        23,
        24,
        25
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Joppatowne%2C_Maryland",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The original settlement sat between the Big and Little Gunpowder Rivers at a spot known as Sim's Point, now northwest of present‑day Joppatowne.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Joppatowne%2C_Maryland",
      "category": "other",
      "quality": "poor",
      "qualityReason": "location_description"
    },
    {
      "id": 3,
      "text": "Gunpowder Town predated colonial Joppa by several decades, yet its precise site remains unknown because the river mouths were farther inland then.",
      "sourceSentenceIds": [
        22,
        24,
        27
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Joppatowne%2C_Maryland",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "During the Civil War, Confederate cavalry led by Gilmor attacked the railroad bridge over the Gunpowder River, capturing trains and burning one before retreating.",
      "sourceSentenceIds": [
        10,
        11
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Joppatowne%2C_Maryland",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The Old Joppa Site, once a bustling seaport, earned a place on the National Register of Historic Places in 1979 as an archaeological treasure.",
      "sourceSentenceIds": [
        7
      ],
