      ],
      "source": "https://en.wikipedia.org/wiki/Little_York%2C_Hunterdon_County%2C_New_Jersey",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The Alexandria Presbyterian Church Chapel, erected in 1844, stands on the frame of a 1795 church.",
