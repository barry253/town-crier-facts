  "facts": [
    {
      "id": 1,
      "text": "Tabacalera’s Monument to the Revolution, finished in the 1930s, crowns the neighborhood’s central plaza and offers sweeping city views.",
      "sourceSentenceIds": [
        13
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/colonia_tabacalera",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The former Palacio del Conde de Buenavista now houses the National Museum of San Carlos, a neoclassical gem that once served as a royal palace.",
      "sourceSentenceIds": [
        12,
        5
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/colonia_tabacalera",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "In 1901, Tabacalera hosted the scandalous Baile de los 41, a masked ball that exposed social tensions and sparked reforms in Porfirian society.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/colonia_tabacalera",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The neighborhood blends late‑19th‑century neoclassical mansions with Art Deco landmarks like the National Lottery Building, once Mexico City’s tallest structure.",
      "sourceSentenceIds": [
        12,
        4
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/colonia_tabacalera",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Tabacalera’s streets were designed during the Porfiriato to emulate European urban grids, featuring axial symmetry that still guides modern traffic flow.",
      "sourceSentenceIds": [
        15,
        16
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/colonia_tabacalera",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The Mexico City Metrobús Line 1, the city’s first BRT line, runs right through Tabacalera, connecting the historic center to southern districts.",
      "sourceSentenceIds": [
