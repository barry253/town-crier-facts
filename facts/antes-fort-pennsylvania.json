  "facts": [
    {
      "id": 1,
      "text": "Fort Antes was built in about 1777 on a plateau overlooking Antes Creek, overlooking the West Branch Susquehanna River.",
      "sourceSentenceIds": [
        17
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.legendsofamerica.com/pa-fortantes/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Colonel John Henry Antes, a German‑American millwright who arrived in 1772, commissioned the fort and served as a lieutenant colonel of the Fourth Battalion militia.",
      "sourceSentenceIds": [
        16,
        20,
        21
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.legendsofamerica.com/pa-fortantes/",
      "category": "people",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The stockade surrounding Fort Antes stood 10 to 12 feet high, notched at the top for musketry, and enclosed roughly a quarter of an acre.",
      "sourceSentenceIds": [
        24,
        25
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.legendsofamerica.com/pa-fortantes/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "During the winter of 1777‑78, frequent Indian inroads made the fort a refuge for settlers, who relied on its vigilant watch and scouting parties.",
      "sourceSentenceIds": [
        27,
        26
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.legendsofamerica.com/pa-fortantes/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "In early summer 1778, news of Native American warriors—possibly joined by Loyalists—headed toward the valley, prompting the “Big Runaway” evacuation ordered by Colonel Hunter.",
      "sourceSentenceIds": [
        28,
        5
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.legendsofamerica.com/pa-fortantes/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "A commemorative boulder marks the site today, and annual reenactments celebrate the fort’s legacy of frontier resilience.",
      "sourceSentenceIds": [
        9,
        7
      ],
      "sourceLabels": [
        "Web source 2",
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/fort_antes",
      "category": "culture",
      "quality": "good"
    }
  ],
