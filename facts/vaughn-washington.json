  "facts": [
    {
      "id": 1,
      "text": "Vaughn was named after William D. Vaughn, the first settler on the bay, who arrived around 1851.",
      "sourceSentenceIds": [
        12,
        17,
        2
      ],
      "sourceLabels": [
        "Wikipedia",
