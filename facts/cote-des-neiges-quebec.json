  "facts": [
    {
      "id": 1,
      "text": "Côte-des-Neiges was founded as a village in 1862 and annexed by Montreal in 1908 and 1910.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/C%C3%B4te-des-Neiges",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The neighborhood sits on the western slope of Mount Royal, near the confluence of Côte-des-Neiges Road and Queen Mary Road.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/C%C3%B4te-des-Neiges",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "James Swail, a landowner and farmer, began residential subdivisions in the 1860s, and a street bears his name beside Jean-Brillant park.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.mtl.org/en/experience/welcome-cote-neiges",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The Université de Montréal’s main campus, along with HÉC Montréal and Polytechnique Montréal, occupies a large portion of Côte-des-Neiges.",
      "sourceSentenceIds": [
        26
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/C%C3%B4te-des-Neiges",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Côte-des-Neiges hosts one of Montreal’s most multilingual communities, with French and English spoken equally alongside many other languages.",
      "sourceSentenceIds": [
        23,
        24
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/C%C3%B4te-des-Neiges",
      "category": "people",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The Montreal Holocaust Museum, located across the street from the neighborhood, offers a powerful historical perspective.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
