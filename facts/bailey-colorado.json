  "facts": [
    {
      "id": 1,
      "text": "Bailey’s origins trace back to 1864 when William Bailey built a ranch and stage station that later gave the town its name.",
      "sourceSentenceIds": [
        13,
        14
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Bailey%2C_Colorado",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The Denver & South Park Railroad arrived in 1878, the same year Bailey opened its post office, linking the community to regional trade.",
      "sourceSentenceIds": [
        4,
        10
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 2"
      ],
      "source": "https://en.wikipedia.org/wiki/Bailey%2C_Colorado",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The historic McGraw-Bailey Country Store, built in 1906, stands as a Park County Historic Landmark and reflects Blanche McGraw’s influence on local culture.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.parkcountyco.gov/386/Bailey-Area",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "In 2006, the quirky Coney Island Hot Dog Stand—a building shaped like a giant hot dog—was relocated from Aspen Park to Bailey, adding a playful landmark.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Bailey%2C_Colorado",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The Glen Isle Resort, once a 160‑acre lodge, now occupies a National Register site and remains a centerpiece for overnight stays in Bailey.",
      "sourceSentenceIds": [
        11,
        12,
        27
      ],
      "sourceLabels": [
        "Web source 2",
        "Wikipedia"
      ],
      "source": "https://www.uncovercolorado.com/towns/bailey/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Bailey hosts an annual summer street festival called Bailey Day, featuring bands, vendors, and family activities that bring the community together.",
