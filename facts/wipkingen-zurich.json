  "facts": [
    {
      "id": 1,
      "text": "Wipkingen was an independent village before joining Zurich in the late 19th century, yet it still feels like a quiet, village‑style neighborhood.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://perfectitinerary.io/switzerland/zurich/neighborhoods/wipkingen",
      "category": "other",
      "quality": "poor",
      "qualityReason": "editorial_filler"
    },
    {
      "id": 2,
      "text": "Zürich Wipkingen railway station opened on 2 October 1932, long after the Zürich–Winterthur line began service in 1856.",
      "sourceSentenceIds": [
        11
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Z%C3%BCrich_Wipkingen_railway_station",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "At the station’s northern end the Wipkingen Tunnel begins, connecting the line directly to Zürich Oerlikon.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Z%C3%BCrich_Wipkingen_railway_station",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Between 1908 and 1968, tram line 4 linked Escher‑Wyss Platz with Röschlibachplatz, running close to the Wipkingen station.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Z%C3%BCrich_Wipkingen_railway_station",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "In 2024 the station was refurbished, replacing its island platform with two side platforms to improve passenger flow.",
      "sourceSentenceIds": [
        15,
        23
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Z%C3%BCrich_Wipkingen_railway_station",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Röschibachplatz, a recently upgraded zone, offers a pleasant contrast to the traffic‑heavy streets that have long defined Wipkingen.",
