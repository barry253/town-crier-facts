  "facts": [
    {
      "id": 1,
      "text": "Hillsboro Village began to take shape in 1920 when two groceries and a pharmacy opened alongside the trolley line that ran down Hillsboro Road.",
      "sourceSentenceIds": [
        18
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Hillsboro_Village",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The Belcourt Theater, a restored arthouse cinema opened in 1925, draws film lovers and pancake crowds at the nearby Pancake Pantry.",
      "sourceSentenceIds": [
        6,
        7,
        8
      ],
      "sourceLabels": [
        "Web source 1",
        "Web source 2"
      ],
      "source": "https://williamclendening.com/hillsboro-village/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Dragon Park features an iconic dragon sculpture that families love, making it a local landmark.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://williamclendening.com/hillsboro-village/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The Acklen Estate, founded by Joseph and Adelicia Acklen, originally included the Belmont Mansion built in 1853, a zoo, and a greenhouse.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Hillsboro_Village",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The neighborhood's heart hosts the Acklen Avenue Post Office, famous for its wall of autographed photos of country music stars.",
      "sourceSentenceIds": [
