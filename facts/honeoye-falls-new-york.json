      "id": 1,
      "text": "Zebulon Norton founded Honeoye Falls in 1791, buying 1,820 acres for just 12½ cents an acre.",
      "sourceSentenceIds": [
        3,
        6
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
