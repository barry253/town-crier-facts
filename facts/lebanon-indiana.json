      "category": "transport",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The Cragun House, built in 1893 for Nathaniel Cragun, is a Victorian gem listed on the National Register of Historic Places.",
      "sourceSentenceIds": [
