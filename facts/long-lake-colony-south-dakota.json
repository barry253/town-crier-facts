  "facts": [
    {
      "id": 1,
      "text": "Long Lake Colony was established in 1967 as a daughter colony from the Pearl Creek Hutterite Colony near Iroquois, South Dakota.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/long_lake_colony_south_dakota"
    },
    {
      "id": 2,
      "text": "Members of Long Lake Colony follow a communal lifestyle where all property and land are owned collectively by the entire community.",
      "sourceSentenceIds": [
        20
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/long_lake_colony_south_dakota"
    },
    {
      "id": 3,
      "text": "Long Lake Colony operates as a communal agricultural settlement following the traditions of the Schmiedeleut Group 2 branch of Hutterites.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/long_lake_colony_south_dakota"
    },
    {
      "id": 4,
      "text": "The colony sustains itself through diversified agriculture, focusing on dairy production, poultry farming, and grain crops like corn and wheat.",
      "sourceSentenceIds": [
        25
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/long_lake_colony_south_dakota"
    },
    {
      "id": 5,
      "text": "Long Lake Colony is positioned within the Drift Prairie section of the James River Valley in north-central South Dakota.",
      "sourceSentenceIds": [
        13,
        14
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/long_lake_colony_south_dakota"
    },
    {
      "id": 6,
      "text": "Long Lake Colony maintains its own elementary school that blends basic academics with vocational training and religious instruction.",
      "sourceSentenceIds": [
        11
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/long_lake_colony_south_dakota"
