  "facts": [
    {
      "id": 1,
      "text": "Cementon was renamed after a large Whitehall Portland Cement Works quarry and mill established 1900-01.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Cementon%2C_Pennsylvania",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Originally called Siegfried's Ferry, it sits directly across Lehigh River from Siegfried, one of three villages that merged into Northampton in 1902.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Cementon%2C_Pennsylvania",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Located along the Lehigh River, Cementon historically powered regional industrial growth with cement production in the late 19th and early 20th centuries.",
      "sourceSentenceIds": [
        13
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.trawellino.com/destinations/united-states/pennsylvania_cementon",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Pennsylvania Route 329 cuts through Cementon, linking east to Northampton and west to Neffs.",
      "sourceSentenceIds": [
        19
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Cementon%2C_Pennsylvania",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The town lies in Whitehall Township, just 7 miles north of Allentown, Pennsylvania.",
      "sourceSentenceIds": [
        16
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Cementon%2C_Pennsylvania",
      "category": "other",
      "quality": "poor",
      "qualityReason": "location_description"
    },
    {
