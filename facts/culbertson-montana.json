  "facts": [
    {
      "id": 1,
      "text": "Culbertson takes its name from Major Alexander Culbertson, the former head of the American Fur Company's Fort Union, located 23 miles east.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Culbertson%2C_Montana",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The 1909 homestead laws opened up larger acreages, drawing a wave of dryland farmers into the Culbertson area.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Culbertson%2C_Montana",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Culbertson’s railroad link turned the town into the regional hub for agricultural trade.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Culbertson%2C_Montana",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Fort Union Trading Post National Historic Site, a reconstructed fur‑trade fort, sits just 25 miles east of Culbertson.",
      "sourceSentenceIds": [
        13
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://roamingmontana.com/culbertson/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The Culbertson Museum chronicles Roosevelt County’s homestead era, agricultural growth, and fur‑trade legacy.",
      "sourceSentenceIds": [
        20
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://roamingmontana.com/culbertson/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Terry Falcon, a former NFL player for the New England Patriots and New York Giants, grew up in Culbertson.",
