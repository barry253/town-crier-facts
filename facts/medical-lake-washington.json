  "facts": [
    {
      "id": 1,
      "text": "Medical Lake earned its name from the Spokane people, who believed the lake’s mud and water had curative powers.",
      "sourceSentenceIds": [
        21,
        22
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Medical_Lake%2C_Washington",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The city was officially incorporated in 1890, just a year after the state built Eastern State Hospital on its shores.",
      "sourceSentenceIds": [
        20,
        26
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Medical_Lake%2C_Washington",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Eastern State Hospital’s construction in 1891 sparked a boom that brought bathhouses, hotels, and a salt‑and‑soap industry to the town.",
      "sourceSentenceIds": [
        26,
        23,
        25
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Medical_Lake%2C_Washington",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Fairchild Air Force Base, a major employer, sits beside the lake and has shaped Medical Lake’s modern economy.",
      "sourceSentenceIds": [
        19
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Medical_Lake%2C_Washington",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "During the 1920s the lake’s popularity waned, but the town survived on the hospital, the base, and a lingering salt industry.",
      "sourceSentenceIds": [
        27,
        23
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Medical_Lake%2C_Washington",
