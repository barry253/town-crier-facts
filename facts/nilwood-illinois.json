  "facts": [
    {
      "id": 1,
      "text": "Nilwood’s name means “no wood,” coined by train engineers because the area lacked trees.",
      "sourceSentenceIds": [
        2,
        5
      ],
      "sourceLabels": [
        "Web source 1",
        "Web source 2"
      ],
      "source": "https://macoupin.illinoisgenweb.org/history/nilwood.html",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The Chicago and Alton Railroad, later GM&O, reached Nilwood in 1852, making it a key station on the line to St. Louis.",
      "sourceSentenceIds": [
        3,
        8,
        18
      ],
      "sourceLabels": [
        "Web source 1",
        "Web source 1",
        "Web source 2"
      ],
      "source": "https://macoupin.illinoisgenweb.org/history/nilwood.html",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Nilwood once hosted a Union Fuel Company coal mine, abandoned in 1927 after the steeple and boiler room were left standing.",
      "sourceSentenceIds": [
        14,
        15
      ],
      "sourceLabels": [
        "Web source 1",
        "Web source 1"
      ],
      "source": "https://macoupin.illinoisgenweb.org/history/nilwood.html",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Historic Route 66 ran through Nilwood from 1926 to 1930, and the town’s stretch is listed on the National Register of Historic Places.",
      "sourceSentenceIds": [
        1,
        16
      ],
      "sourceLabels": [
        "Web source 2",
        "Web source 2"
      ],
      "source": "https://www.theroute-66.com/nilwood.html",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "In the early 1900s Nilwood boasted more than five gasoline stations, a bank, a grain elevator, and a high school, reflecting its boom with cars.",
      "sourceSentenceIds": [
        22
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://macoupin.illinoisgenweb.org/history/nilwood.html",
      "category": "economy",
      "quality": "poor",
      "qualityReason": "editorial_filler"
    },
    {
      "id": 6,
      "text": "Nilwood sits in Macoupin County, drained by Shearles Branch that feeds Macoupin Creek, a tributary of the Illinois River.",
      "sourceSentenceIds": [
        26
