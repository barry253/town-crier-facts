  "facts": [
    {
      "id": 1,
      "text": "Tate City was founded as a mining and logging community in a scenic valley along the upper Tallulah River.",
      "sourceSentenceIds": [
        2,
        13
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Tate_City%2C_Georgia"
    },
    {
      "id": 2,
      "text": "Tate City takes its name from a local businessperson who played a prominent role in the early lumber industry.",
      "sourceSentenceIds": [
        12,
        28
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 2"
      ],
      "source": "https://en.wikipedia.org/wiki/Tate_City%2C_Georgia"
    },
    {
      "id": 3,
      "text": "Corundum mining once drew over one thousand residents to Tate City to harvest abrasive minerals and rubies from the mountains.",
      "sourceSentenceIds": [
        29
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/tate_city_georgia"
    },
    {
      "id": 4,
      "text": "The Morse Brothers Lumber Company once operated a narrow-gauge railroad in Tate City to enable industrial-scale clear-cutting of virgin forests.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/tate_city_georgia"
    },
    {
      "id": 5,
      "text": "Tate City is known for its remote character and was the last community in Georgia to receive electricity in the early 1970s.",
      "sourceSentenceIds": [
        21,
        23
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/tate_city_georgia"
    },
    {
      "id": 6,
      "text": "The Tallulah River flowing through Tate City is home to some of the best trout fishing in the state.",
      "sourceSentenceIds": [
        16
      ],
