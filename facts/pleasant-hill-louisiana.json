      "quality": "good"
    },
    {
      "id": 2,
      "text": "The Battle of Pleasant Hill on April 9, 1864 saw Union forces repel a fierce Confederate assault.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/pleasant_hill_sabine_parish_louisiana",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "After cotton prosperity, Pleasant Hill shifted eastward in 1882 to align with the Texas and Pacific Railroad.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/pleasant_hill_sabine_parish_louisiana",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Pleasant Hill enjoys a humid subtropical climate, with hot summers, mild winters, and average July highs near 92°F.",
      "sourceSentenceIds": [
        16
      ],
      "sourceLabels": [
        "Web source 1"
      ],
