  "facts": [
    {
      "id": 1,
      "text": "Burkeville began as Burke's Junction, a mid‑19th‑century railroad crossroads where the Richmond & Danville and Southside lines met.",
      "sourceSentenceIds": [
        3,
        13
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/burkeville_virginia",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town’s name traces back to a local tavern owned by a man named Burke or to early landowner Samuel Burke, a detail still debated today.",
      "sourceSentenceIds": [
        2,
        5,
        21
      ],
      "sourceLabels": [
        "Web source 2",
        "Wikipedia"
      ],
      "source": "https://grokipedia.com/page/burkeville_virginia",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "In 1877, Burkeville was formally incorporated by an act of the Virginia General Assembly, cementing its status as an official town.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/burkeville_virginia",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Burkeville hosts three National Register sites—Burke's Tavern, Hyde Park, and Inverness—highlighting its rich 19th‑century heritage.",
      "sourceSentenceIds": [
        9
      ],
