  "facts": [
    {
      "id": 1,
      "text": "Lewiston was platted in 1886 when the Chicago, Rock Island & Pacific Railroad reached the spot, sparking its rapid growth.",
      "sourceSentenceIds": [
        5,
        22
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Lewiston%2C_Nebraska"
    },
    {
      "id": 2,
      "text": "The first businesses in Lewiston were a hardware store and a blacksmith shop, establishing the town’s early economy.",
      "sourceSentenceIds": [
        23
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://pawneecountynebraska.com/project/lewiston-ne/"
    },
    {
      "id": 3,
      "text": "Soon after, a Baptist church and a Methodist church were built, reflecting the community’s growing spiritual life.",
      "sourceSentenceIds": [
        24
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://pawneecountynebraska.com/project/lewiston-ne/"
    },
    {
      "id": 4,
      "text": "Lewiston’s school, first opened in 1903 for grades one through ten, burned in 1967 but reopened a year later.",
      "sourceSentenceIds": [
        25,
        27
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://pawneecountynebraska.com/project/lewiston-ne/"
    },
    {
      "id": 5,
      "text": "At its peak in 1930, Lewiston’s population reached 168 residents, a high point for the small village.",
      "sourceSentenceIds": [
        30
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://pawneecountynebraska.com/project/lewiston-ne/"
    },
    {
      "id": 6,
      "text": "Lewiston is one of two Nebraska communities named Lewiston; the other lies in Gage County.",
