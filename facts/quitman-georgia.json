  "facts": [
    {
      "id": 1,
      "text": "Quitman became the county seat of newly formed Brooks County in 1858, was incorporated as a town in 1859, and grew into a city by 1904.",
      "sourceSentenceIds": [
        22,
        28,
        29
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Quitman%2C_Georgia",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town’s name honors John A. Pierpont, a local figure whose legacy lives on in Quitman’s streets and history.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Quitman%2C_Georgia",
      "category": "people",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Quitman’s historic district earned a spot on the National Register of Historic Places, preserving its 19th‑century architecture.",
      "sourceSentenceIds": [
        23
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Quitman%2C_Georgia",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The Quitman Brooks County Museum, housed in a downtown historic building, showcases clothing, furniture, photographs, and documents from the 19th and 20th centuries.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://museumsdatabase.com/museums/view/7826",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "James Pierpont, the composer of “Jingle Bells,” called Quitman home, adding a musical note to the town’s heritage.",
      "sourceSentenceIds": [
        20
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Quitman%2C_Georgia",
      "category": "people",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Every October, the museum hosts the Annual Brooks County History Fair, and in December it opens its doors for a festive Christmas Open House.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 1"
      ],
