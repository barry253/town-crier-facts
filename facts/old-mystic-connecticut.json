  "facts": [
    {
      "id": 1,
      "text": "Mystic, Connecticut, was originally a village located in Pequot Plantation at the head of the Mystic River.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://oldmystichistory.org/copy-2/"
    },
    {
      "id": 2,
      "text": "Connecticut colonists and Massachusetts Bay once made conflicting claims about governmental authority over the land in Old Mystic.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://oldmystichistory.org/copy-2/"
    },
    {
      "id": 3,
      "text": "Narragansett and Mohegan allies attacked a Pequot settlement in Mystic during the conflict known as the Pequot War.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://oldmystichistory.org/copy-2/"
    },
    {
      "id": 4,
      "text": "Connecticut colonists signed the Treaty of Hartford on September 21, 1638, officially ending the Pequot War.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://oldmystichistory.org/copy-2/"
    },
    {
      "id": 5,
      "text": "Robert Burrows was authorized to operate a ferry across the Mystic River by the year 1650.",
      "sourceSentenceIds": [
        25
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://oldmystichistory.org/copy-2/"
    },
    {
      "id": 6,
      "text": "The Old Mystic History Center is located in the historic 1856 Mystic Bank building on Route 27.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://oldmystichistory.org/"
    }
  ]
