  "facts": [
    {
      "id": 1,
      "text": "Otsego was founded in the fall of 1831 by the Samuel Foster family from Vermont, who called the area Pine Creek at first.",
      "sourceSentenceIds": [
        22
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Otsego%2C_Michigan",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town’s name comes from Otsego Lake in New York, a word of Iroquoian origin likely meaning “place of the great water.”.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Otsego%2C_Michigan",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "In the 1870s visitors flocked to Otsego to soak in the mineral springs at the Otsego Mineral Springs Bath House, a regional draw until 1887.",
      "sourceSentenceIds": [
        29
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Otsego%2C_Michigan",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "George Bardeen’s paper mill operation in the 1880s drained the town’s mineral springs, ending the bath house’s popularity.",
      "sourceSentenceIds": [
        29
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Otsego%2C_Michigan",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The Otsego Area Historical Society opened its new museum building on September 24, 2004, showcasing a photographic history and student art.",
