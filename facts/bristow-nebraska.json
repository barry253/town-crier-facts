  "facts": [
    {
      "id": 1,
      "text": "Bristow was named for Benjamin Helm Bristow, the U.S. Secretary of the Treasury under President Ulysses S. Grant.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/bristow_nebraska",
      "category": "people",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The Chicago and North Western Railroad reached Bristow in 1902, prompting the town’s platting and the building of a depot, stockyards, and a gravel pit.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/bristow_nebraska",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Trinity Lutheran Church, founded in 1920, and the United Methodist Church, built in 1907, are two historic churches that anchor Bristow’s community.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/bristow_nebraska",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Ponca Creek has flooded Bristow twice, in 1891 and 1905, but modern dams now reduce the risk.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/bristow_nebraska",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Homesteaders began settling the Bristow area in the late 1880s, attracted by the fertile Sandhills.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/bristow_nebraska",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Bristow hosted a town band from 1910 to 1920 and fielded competitive baseball teams starting in 1912.",
      "sourceSentenceIds": [
        12
