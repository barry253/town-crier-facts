      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The borough lies north of Tioga and Hammond Lakes along the Tioga River, a tributary that shapes the local landscape.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Tioga%2C_Pennsylvania",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Tioga is encircled by Tioga Township, creating a tight‑knit community feel within the county.",
