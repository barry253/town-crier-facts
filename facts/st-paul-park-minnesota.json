  "facts": [
    {
      "id": 1,
      "text": "Paul Park was founded on the banks of the Mississippi River in 1887 and became incorporated in 1909.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://stpaulpark.org/community/explore_st_paul_park/history_of_st_paul_park/index.php",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town’s private railroad tracks once hosted twelve thriving manufactories, including the Dewey Harvester Works and a terra‑cotta factory.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://stpaulpark.org/community/explore_st_paul_park/history_of_st_paul_park/how_we_began.php",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "With so many factories, Paul Park once faced a shortage of local workers.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://stpaulpark.org/community/explore_st_paul_park/history_of_st_paul_park/how_we_began.php",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The town once boasted a large, well‑kept hotel that served travelers along the Mississippi.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://stpaulpark.org/community/explore_st_paul_park/history_of_st_paul_park/how_we_began.php",
      "category": "landmark",
      "quality": "good"
    },
    {
