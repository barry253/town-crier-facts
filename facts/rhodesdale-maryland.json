    {
      "id": 3,
      "text": "Dorchester County, home to Rhodesdale, was founded in 1669 and named after Edward Sackville, 4th Earl of Dorset.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/rhodesdale_maryland",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Early settlers farmed tobacco and grain on lowlands; the 1673 Rehoboth patent granted 2,350 acres to Captain John Lee.",
      "sourceSentenceIds": [
        24,
        25
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/rhodesdale_maryland",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Rhodesdale experiences a humid subtropical climate, with hot humid summers and mild winters softened by Chesapeake Bay breezes.",
      "sourceSentenceIds": [
        12
