  "facts": [
    {
      "id": 1,
      "text": "Oakville was named Live Oak County seat in 1858 and kept that title until the early 1900s when the railroad was diverted to George West.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.southtexasnews.com/the_progress/news/oakville-texas-history-comes-back-to-life/article_e3b37766-f187-11ec-b92a-a7f9f6c84b55.html"
    },
    {
      "id": 2,
      "text": "After the Civil War, Oakville blossomed into a commercial hub, opening the county’s first bank, public school, and the Live Oak County Leader newspaper in 1891.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Oakville%2C_Texas",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Oakville began as a stagecoach station just after the Texas Revolution, serving travelers between San Antonio and Corpus Christi.",
      "sourceSentenceIds": [
        24
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Oakville%2C_Texas",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Oakville’s post office, the first in Live Oak County, opened in 1857 after a local landowner donated the land.",
      "sourceSentenceIds": [
        30
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Oakville%2C_Texas"
    },
    {
      "id": 5,
      "text": "Today, a restored old jail in Oakville has been converted into a bed‑and‑breakfast, showcasing the town’s historic preservation efforts.",
