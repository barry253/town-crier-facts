  "facts": [
    {
      "id": 1,
      "text": "Silverton's history lives on every corner, with historic homes, museums, and murals proudly displayed in downtown buildings.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://silvertonchamber.org/blog/heritage-travel-in-silverton",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The Silverton Country Historical Society museum, housed in preserved historic buildings, tells the story of early settlers, industries, and community traditions.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://silvertonchamber.org/blog/heritage-travel-in-silverton",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Silverton's downtown is an open‑air history gallery, where large‑scale murals by the Silverton Mural Society transform streets into storytelling canvases.",
      "sourceSentenceIds": [
        5,
        6
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://silvertonchamber.org/blog/heritage-travel-in-silverton",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The Great Fire of 1910, also called the Devil's Broom fire, scorched millions of acres and left Silverton listed as a key impact site.",
      "sourceSentenceIds": [
        10,
        12,
        26
      ],
      "sourceLabels": [
        "Web source 2",
        "Wikipedia"
      ],
      "source": "https://kids.kiddle.co/Silverton,_Idaho",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Silverton grew during the silver boom, as miners discovered valuable minerals that sparked the town’s early economic development.",
      "sourceSentenceIds": [
        21
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://kids.kiddle.co/Silverton,_Idaho",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Guided tours at the Silverton Country Historical Society let visitors step inside and experience one of America’s most influential architectural legacies.",
      "sourceSentenceIds": [
        2
