    {
      "id": 1,
      "text": "New Home, Texas, began as the Deuce of Hearts Ranch, a settlement opened for settlers in the 1890s.",
      "sourceSentenceIds": [
        5,
        19
      ],
      "sourceLabels": [
        "Web source 2",
        "Wikipedia"
      ],
