  "facts": [
    {
      "id": 1,
      "text": "Fort Morgan takes its name from Colonel Christopher A. Morgan, a Civil War officer honored when the fort was renamed in 1866.",
      "sourceSentenceIds": [
        1,
        5
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.britannica.com/place/Fort-Morgan-Colorado-United-States",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "After the fort closed in 1868, the nearby settlement blossomed into a bustling hub for livestock, dairy, and grain shipments.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.britannica.com/place/Fort-Morgan-Colorado-United-States",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The town was officially platted on May 1, 1884, just south of the old military fort’s ruins.",
      "sourceSentenceIds": [
        17
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Fort_Morgan%2C_Colorado",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Fort Morgan became the county seat of newly formed Morgan County on February 19, 1889.",
      "sourceSentenceIds": [
        19
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Fort_Morgan%2C_Colorado",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Morgan Community College opened its doors in 1967, marking the city’s first higher‑education institution.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
