  "facts": [
    {
      "id": 1,
      "text": "Bowdoinham was officially incorporated in 1762 and named after William Bowdoin, a prominent Boston figure.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Bowdoinham%2C_Maine"
    },
    {
      "id": 2,
      "text": "Fort Richmond, built in 1719 upriver, helped spur early British settlement, including Captain Gyles Watkins’ 1720 settlement at the Cathance River mouth.",
      "sourceSentenceIds": [
        14,
        15
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Bowdoinham%2C_Maine"
    },
    {
      "id": 3,
      "text": "By 1886, Bowdoinham boasted three sawmills, a gristmill, plaster mill, two clothing factories, a cheese factory, and a dozen ice companies.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Bowdoinham%2C_Maine"
    },
    {
      "id": 4,
      "text": "Bowdoinham sits on the west side of Merrymeeting Bay, drained by the Cathance, Abagadasset, Muddy, and Kennebec rivers.",
      "sourceSentenceIds": [
        13,
        25
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Bowdoinham%2C_Maine"
    },
    {
      "id": 5,
      "text": "Shipbuilding thrived from 1768 to 1912, and Cathance Landing’s wharves later became the commercial heart of Bowdoinham Village.",
      "sourceSentenceIds": [
