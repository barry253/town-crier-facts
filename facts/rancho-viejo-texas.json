  "facts": [
    {
      "id": 1,
      "text": "Rancho Viejo gets its name from a historic ranch called “Rancho Viejo,” meaning “Old Ranch” in Spanish.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Rancho_Viejo%2C_Texas",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Located in Cameron County, Texas, Rancho Viejo sits near the Gulf Coast and is part of the Brownsville–Harlingen metro area.",
      "sourceSentenceIds": [
        15
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Rancho_Viejo%2C_Texas",
      "category": "other",
      "quality": "poor",
      "qualityReason": "location_description"
    },
    {
      "id": 3,
      "text": "The town’s centerpiece is the Rancho Viejo Country Club, a resort that dominates the local landscape.",
      "sourceSentenceIds": [
        26
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Rancho_Viejo%2C_Texas",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The club’s golf courses spread across 1,400 acres, making it one of the largest single‑property golf complexes in Texas.",
      "sourceSentenceIds": [
        27
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Rancho_Viejo%2C_Texas",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Rancho Viejo’s history is celebrated in the local Sesquicentennial Book Committee’s 1986 publication, “History of the Land.”.",
