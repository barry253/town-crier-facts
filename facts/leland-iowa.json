  "facts": [
    {
      "id": 1,
      "text": "The arrival of the railroad in 1879 spurred settlement and led to Leland being platted on July 15, 1887.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/leland_iowa",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Leland was named for founder John D. Thompson, who moved the post office from Benson's Grove and shortened the original name Lelandsburg.",
      "sourceSentenceIds": [
        2,
        4
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Leland%2C_Iowa",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The first general store in Leland opened in 1880 when Pat Mahar relocated a store building to the town.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/leland_iowa",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "World War II caused labor shortages in Leland, leading to increased mechanization and women taking on farm work, a shift that accelerated postwar productivity.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/leland_iowa",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Leland incorporated as a city in 1894, following an 1895 election that granted it self‑governance and the ability to tax for infrastructure.",
