  "facts": [
    {
      "id": 1,
      "text": "Moses Cleaveland named the area east of the Cuyahoga River Euclid in 1797, honoring the Greek mathematician.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/South_Euclid%2C_Ohio",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "By the 1860s, quarrying of the region's rich Bluestone deposits had become South Euclid's main industry, replacing farming.",
      "sourceSentenceIds": [
        26
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/South_Euclid%2C_Ohio",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "When Bluestone quarrying declined due to poured concrete, the former Bluestone village was absorbed into South Euclid.",
      "sourceSentenceIds": [
        29
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/South_Euclid%2C_Ohio",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The South Euclid‑Lyndhurst Historical Society, founded in 1966, has served the Greater Cleveland community ever since.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://se-lhistory.org/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "In 2015, a 30,000‑square‑foot LEED‑certified library opened across from Notre Dame College, replacing the old Telling mansion.",
      "sourceSentenceIds": [
        17,
        18
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://southeuclid.gov/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "South Euclid officially became a city in 1941, after growing through the Great Depression with WPA support.",
