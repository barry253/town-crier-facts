      "category": "nature",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Tennessee State Route 72 skirts the western edge of Rarity Bay, leading south 2.5 miles to U.S. Route 411 in Vonore.",
      "sourceSentenceIds": [
