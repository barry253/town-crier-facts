  "facts": [
    {
      "id": 1,
      "text": "Raymondville was first settled in 1809 by Erastus Hall, a Massachusetts native, marking the hamlet’s earliest permanent residency.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/raymondville_new_york",
      "category": "people",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The hamlet’s name honors Benjamin Raymond, a 19th‑century supervisor, and its Iroquois name Tsi‑ia‑ko‑on‑tie‑ta means “where they leave the canoe.”.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/raymondville_new_york",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "A 1886 lenticular truss bridge, the Raymondville Parabolic Bridge, spans the Raquette River and is one of the few surviving art‑nouveau ironworks in the region.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/raymondville_new_york",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The village’s historic Belle tours reveal lake lore and stories rarely heard elsewhere, offering a unique glimpse into local heritage.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://takingthekids.com/this-lakeside-town-in-new-york-feels-like-a-1950s-getaway-youll-never-want-to-leave-again/",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Raymondville sits on the western bank of the Raquette River, 6 miles north of Norwood, and is served by New York State Route 56.",
      "sourceSentenceIds": [
        13
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Raymondville%2C_New_York",
      "category": "other",
      "quality": "poor",
      "qualityReason": "location_description"
    },
    {
      "id": 6,
      "text": "The hamlet experiences a humid continental climate, with July highs around 78 °F and January lows near 10 °F, shaped by Lake Ontario’s influence.",
