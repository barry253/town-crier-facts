  "facts": [
    {
      "id": 1,
      "text": "The name Ekwok derives from the Central Yupik term Iquaq, meaning \"end of the bluff\" or \"river's edge\" in southwestern Alaska.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/ekwok_alaska"
    },
    {
      "id": 2,
      "text": "During the 1800s, the settlement was used in the spring and summer as a fish camp, and in the fall as a base camp for picking berries.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Ekwok%2C_Alaska"
    },
    {
      "id": 3,
      "text": "After a flood in the early 1960s, the village was relocated to its current location.",
      "sourceSentenceIds": [
        14
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Ekwok%2C_Alaska"
    },
    {
      "id": 4,
      "text": "By 1923, it was the largest settlement along the river.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Ekwok%2C_Alaska"
    },
    {
      "id": 5,
      "text": "Ekwok stands as the oldest continuously occupied Yupik village on the Nushagak River.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Ekwok%2C_Alaska"
    },
    {
      "id": 6,
      "text": "From the early 1900s until 1941, mail was delivered by dog sled from Dillingham.",
