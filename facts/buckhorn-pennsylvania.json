      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Founded in the 1820s, Buckhorn grew around iron mines, with Vaniah Rees building the first house in 1820.",
      "sourceSentenceIds": [
        4,
        16
      ],
      "sourceLabels": [
        "Web source 1",
        "Wikipedia"
      ],
