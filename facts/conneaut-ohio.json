      ],
      "source": "https://conneautohio.gov/about/history.php",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Perched on Lake Erie’s edge, Conneaut lies at the mouth of Conneaut Creek and is Ohio’s northernmost city.",
      "sourceSentenceIds": [
        19
      ],
      "sourceLabels": [
