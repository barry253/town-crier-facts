      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Early settlers followed an old Native American trail that later guided pioneers of Moses Cleaveland’s Western Reserve.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
