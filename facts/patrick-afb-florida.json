        17
      ],
      "sourceLabels": [
        "Web source 2",
        "Wikipedia"
      ],
      "source": "https://fortwiki.com/Patrick_Space_Force_Base",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The 9th Strategic Reconnaissance Wing opened a U‑2 operating location at Patrick in January 1982.",
