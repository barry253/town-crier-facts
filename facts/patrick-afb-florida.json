      ],
      "source": "https://en.wikipedia.org/wiki/Patrick_Space_Force_Base",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "In 1948 the Navy base transferred to Air Force, became Long Range Proving Ground, and was renamed Patrick Air Force Base in 1950 after Major General Mason Patrick.",
      "sourceSentenceIds": [
        5,
        6,
        8,
        12,
        15
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 2"
      ],
