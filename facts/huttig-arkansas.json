  "facts": [
    {
      "id": 1,
      "text": "Huttig was founded in 1904 as a company town by the Frost-Johnson Lumber Company and named for industrialist William Huttig.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/huttig_arkansas"
    },
    {
      "id": 2,
      "text": "Huttig is the birthplace of civil rights activist Daisy Bates, who led efforts in school desegregation.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/huttig_arkansas"
    },
    {
      "id": 3,
      "text": "Country music pianist Floyd Cramer spent his childhood in Huttig and became known for his distinctive slip-note piano style.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/huttig_arkansas"
    },
    {
      "id": 4,
      "text": "The local economy of Huttig long centered on lumber production, anchored by the Union Sawmill, which closed permanently in 2024.",
      "sourceSentenceIds": [
        17
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/huttig_arkansas"
    },
    {
      "id": 5,
      "text": "As a classic company town, Huttig once featured employer-provided housing, a company store, and a movie theater.",
      "sourceSentenceIds": [
        28,
        29
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/huttig_arkansas"
    },
    {
      "id": 6,
      "text": "Early development in Huttig included the creation of the Louisiana and Pine Bluff Railway to transport logs via rail lines.",
