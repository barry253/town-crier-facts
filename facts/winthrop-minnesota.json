      "id": 1,
      "text": "Winthrop got its name from railroad associate Campbell, who honored Puritan governor John Winthrop when the town was founded.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/winthrop_minnesota",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "By the early 1900s, Winthrop shipped more than 350 carloads of grain each year, cementing its role as a regional grain hub.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/winthrop_minnesota",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The town’s early history includes Lutheran churches founded in the 1880s, and today the Winthrop Community Historical Society preserves artifacts in a local museum.",
      "sourceSentenceIds": [
        7,
        11
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/winthrop_minnesota",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Winthrop sits near the South Fork of the Crow River, a major tributary that shapes the local watershed and landscape.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/winthrop_minnesota",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "A post office has been operating in Winthrop since 1882, marking the town’s long‑standing community presence.",
