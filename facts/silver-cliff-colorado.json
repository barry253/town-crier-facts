  "facts": [
    {
      "id": 1,
      "text": "Silver Cliff sprang up in the late 1870s to house miners working the Silver Cliff mine and nearby Bull‑Domingo silver mines.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Silver_Cliff%2C_Colorado",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town sits near Custer County’s geographic center, with Westcliffe just to its west.",
      "sourceSentenceIds": [
        19,
        20
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Silver_Cliff%2C_Colorado",
      "category": "other",
      "quality": "poor",
      "qualityReason": "location_description"
    },
    {
      "id": 3,
      "text": "The original firehouse and town hall now houses the Silver Cliff Museum, preserving the town’s mining‑camp heritage.",
      "sourceSentenceIds": [
        3,
        6
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.uncovercolorado.com/towns/silver-cliff/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The Silver Cliff mine, also called the Geyser mine, once held the title of Colorado’s deepest mine.",
      "sourceSentenceIds": [
        18
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Silver_Cliff%2C_Colorado",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Silver Cliff and neighboring Westcliffe are International Dark Sky Communities, a status earned by reducing light pollution.",
      "sourceSentenceIds": [
        21,
        22
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Silver_Cliff%2C_Colorado",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Just outside town lies Silver Cliff Cemetery, founded in the early 1880s to serve the mining community.",
      "sourceSentenceIds": [
