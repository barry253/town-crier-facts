  "facts": [
    {
      "id": 1,
      "text": "Ellicott City Station, built in 1830, is the oldest surviving train station in the United States and now a living history museum.",
      "sourceSentenceIds": [
        5,
        7,
        14
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Ellicott_City%2C_Maryland",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town was founded in 1772 by the Ellicott brothers, who purchased the land and established one of the East's largest milling towns.",
      "sourceSentenceIds": [
        6,
        28,
        29
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Ellicott_City%2C_Maryland",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Main Street’s cobblestone streets and 18th‑ and 19th‑century architecture make Ellicott City a beautifully preserved mill town.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://visitellicottcity.com/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The B&O Railroad’s first terminus outside Baltimore began in Ellicott City, linking the town to the nation’s first commercial railroad.",
      "sourceSentenceIds": [
        14
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Ellicott_City%2C_Maryland",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Ellicott City sits atop the Ellicott City Granodiorite, a Silurian or Ordovician rock that gives the town its distinctive geological foundation.",
      "sourceSentenceIds": [
        26
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Ellicott_City%2C_Maryland",
      "category": "nature",
      "quality": "good"
    },
    {
