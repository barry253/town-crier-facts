  "facts": [
    {
      "id": 1,
      "text": "Moulton takes its name from Lieutenant Michael Moulton, a soldier who fell fighting under Andrew Jackson at Horseshoe Bend in 1814.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Moulton%2C_Alabama"
    },
    {
      "id": 2,
      "text": "When Alabama joined the Union in 1819, the first building in present‑day Moulton was an inn that welcomed travelers on early routes.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Moulton%2C_Alabama"
    },
    {
      "id": 3,
      "text": "Since 1820, Moulton has served as Lawrence County’s seat, chosen by Governor Thomas Bibb for its central location.",
      "sourceSentenceIds": [
        15,
        19
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Moulton%2C_Alabama"
    },
    {
      "id": 4,
      "text": "The Moulton Advertiser, the county’s only newspaper, has been publishing local news out of Moulton for generations.",
      "sourceSentenceIds": [
        12
