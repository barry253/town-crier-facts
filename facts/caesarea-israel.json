  "facts": [
    {
      "id": 1,
      "text": "Caesarea was rebuilt by Herod the Great between 22–10 BCE and renamed for Emperor Caesar Augustus.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.britannica.com/place/Caesarea",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The original Phoenician settlement, Straton's Tower, was founded in the 4th century BCE by Abdashtart I of Sidon.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Caesarea_Maritima",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "In 22 BCE Herod constructed a deep‑sea harbour called Sebastos, adding markets, baths, and a temple to Roma and Augustus.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Caesarea_Maritima",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Caesarea served as the administrative, economic, and cultural capital of Judea, later Syria‑Palaestina, for several centuries.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Caesarea_Maritima",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The city’s Roman harbour features three channels (A–C) that were expanded over time and still echo ancient maritime trade.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Caesarea_Maritima",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "In 1940 a fishing kibbutz, Sedot Yam, was founded just south of Caesarea, building a jetty over the ancient breakwater.",
      "sourceSentenceIds": [
