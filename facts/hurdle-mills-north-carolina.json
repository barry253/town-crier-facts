  "facts": [
    {
      "id": 1,
      "text": "Hurdle Mills began as Daniel's Mill when a post office opened in 1846, with William Daniel as its first postmaster.",
      "sourceSentenceIds": [
        3,
        28,
        29
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 2"
      ],
      "source": "https://en.wikipedia.org/wiki/Hurdle_Mills%2C_North_Carolina",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "In 1859 the mill was bought by the Hurdle family, and the town’s name changed to Hurdle's Mill.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Hurdle_Mills%2C_North_Carolina",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Perched at about 614 feet, Hurdle Mills overlooks the Flat River where its original mill once stood.",
      "sourceSentenceIds": [
        25,
        30
      ],
      "sourceLabels": [
        "Web source 2",
        "Wikipedia"
      ],
      "source": "https://kids.kiddle.co/Hurdle_Mills,_North_Carolina",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Hurdle Mills straddles Person and Orange counties in southern North Carolina's Piedmont region.",
      "sourceSentenceIds": [
        6,
        24
      ],
      "sourceLabels": [
