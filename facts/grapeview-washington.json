  "facts": [
    {
      "id": 1,
      "text": "Grapeview, Washington, earned its nickname “Detroit of the West” when a 19th‑century developer plotted a city opposite Reach Island.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grapeviewwa.com/about-gca/history-grapeview-gca/",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The historic 1850 Chambers Creek Mill Site, still standing, was one of the first industrial mills that helped launch Grapeview’s early economy.",
      "sourceSentenceIds": [
        8,
        19
      ],
      "sourceLabels": [
        "Web source 2",
        "Web source 1"
      ],
      "source": "https://beckdc.com/historical-places-in-grapeview/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The Squaxin Island Museum, housed in a former library, preserves artifacts that trace the history of the Squaxin Island Tribe and surrounding region.",
      "sourceSentenceIds": [
        15,
        17
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://beckdc.com/historical-places-in-grapeview/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Lambert Evans, a 36‑year‑old Confederate veteran, became Grapeview’s first settler in 1872, marking the town’s formal beginning.",
      "sourceSentenceIds": [
        20
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grapeviewwa.com/about-gca/history-grapeview-gca/",
      "category": "people",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "In 2006, volunteers and contractors finished the Horton Community Center, a renovated building that now serves as Grapeview’s civic hub.",
      "sourceSentenceIds": [
