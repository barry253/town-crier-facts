  "facts": [
    {
      "id": 1,
      "text": "Fort Lyon was renamed in 1862 after Brigadier General Nathaniel Lyon, the first Union general killed in the Civil War.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Fort_Lyon",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The original fort, called Fort Wise, operated from 1860 to 1867 before a flood prompted a new post near Las Animas.",
      "sourceSentenceIds": [
        19,
        20
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Fort_Lyon",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "After the Indian Wars ended, the Army abandoned Fort Lyon in 1897, and the site later became a sanatorium and neuropsychiatry facility.",
      "sourceSentenceIds": [
        10,
        21
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Fort_Lyon",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "In 2013 the Colorado Coalition for the Homeless rescued the campus, turning it into a transitional housing program for people with substance abuse issues.",
      "sourceSentenceIds": [
        13,
        22,
        23,
        24
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.bentcountyheritage.org/fort-lyon/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Fort Lyon National Cemetery, which began burials in 1907, remains open and is part of the historic campus.",
      "sourceSentenceIds": [
        25
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Fort_Lyon",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The original fort was used by the Army to store annuity goods for the Cheyenne and Arapaho after renting Bent's New Fort in 1860.",
      "sourceSentenceIds": [
        26
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Fort_Lyon",
      "category": "history",
      "quality": "good"
    }
