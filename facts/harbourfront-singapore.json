  "facts": [
    {
      "id": 1,
      "text": "HarbourFront was originally called Seah Im and later Jardine Steps before the Port of Singapore expanded.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/HarbourFront_(Singapore)"
    },
    {
      "id": 2,
      "text": "After the port expansion it became Maritime Square, and in the 2000s was renamed HarbourFront to give the area a more upmarket feel.",
      "sourceSentenceIds": [
        2,
        12
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/HarbourFront_(Singapore)"
    },
    {
      "id": 3,
      "text": "The area once housed Singapore’s oldest docks and the World Trade Centre, anchoring its history to shipping.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://curiocity.nlb.gov.sg/resource-room/story-maps/harbourfront/"
    },
    {
      "id": 4,
      "text": "Singapore’s first international cruise terminal, the Singapore Cruise Centre, opened in 1991 at HarbourFront.",
      "sourceSentenceIds": [
        16
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/HarbourFront_(Singapore)"
    },
    {
      "id": 5,
      "text": "The Circle Line HarbourFront station opened on 8 October 2011, dramatically improving access to the waterfront.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/HarbourFront_(Singapore)"
    },
    {
      "id": 6,
      "text": "The Sentosa Express monorail link to Sentosa began operating on 15 January 2007, connecting HarbourFront to the island.",
