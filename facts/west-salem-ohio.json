  "facts": [
    {
      "id": 1,
      "text": "West Salem Historical Society, founded in 1974, is run by volunteers dedicated to preserving the town’s heritage.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://museumsdatabase.com/museums/view/24908"
    },
    {
      "id": 2,
      "text": "The society hosts lectures, tours, and special exhibits that explore different aspects of local history.",
      "sourceSentenceIds": [
        26
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://museumsdatabase.com/museums/view/24908"
    },
    {
      "id": 3,
      "text": "It partners with local schools to provide educational resources and support teachers incorporating West Salem history into curricula.",
      "sourceSentenceIds": [
        27
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://museumsdatabase.com/museums/view/24908"
    },
    {
      "id": 4,
      "text": "Historic Sanborn Fire Insurance Maps of West Salem span from 1884 to 1951, detailing downtown layout and businesses.",
      "sourceSentenceIds": [
        11
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://hometownhistorymaps.com/pages/history-of-west-salem-ohio"
    },
    {
      "id": 5,
      "text": "West Salem offers 18 historic maps, with the oldest dating back to 1884 and the newest from 1951.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://hometownhistorymaps.com/pages/history-of-west-salem-ohio"
    },
    {
      "id": 6,
      "text": "These maps serve as a direct window into West Salem’s past, revealing footprints of schools, hotels, and factories.",
      "sourceSentenceIds": [
        13
      ],
      "sourceLabels": [
        "Web source 1"
      ],
