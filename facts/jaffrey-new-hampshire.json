    {
      "id": 1,
      "text": "Jaffrey was named for Portsmouth merchant George Jaffrey, a man who never visited the town that bears his name.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.jaffreyhistory.org/index2.php"
    },
    {
      "id": 2,
      "text": "The town was officially incorporated in 1773 by Governor John Wentworth and has kept that charter ever since.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.jaffreyhistory.org/index2.php"
    },
    {
      "id": 3,
      "text": "Mount Monadnock rises to 3,165 feet, making it the highest point in both Jaffrey and all of Cheshire County.",
      "sourceSentenceIds": [
        27
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Jaffrey%2C_New_Hampshire"
    },
    {
      "id": 4,
      "text": "The Contoocook River once powered a network of mills that helped shape Jaffrey’s early industrial economy.",
