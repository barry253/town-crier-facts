      ],
      "source": "https://en.wikipedia.org/wiki/Hillsborough%2C_New_Hampshire",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Franklin Pierce Homestead, the former home of the 14th U.S. President, sits in Hillsborough and is a preserved historic site.",
      "sourceSentenceIds": [
        13
      ],
      "sourceLabels": [
