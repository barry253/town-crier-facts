    },
    {
      "id": 2,
      "text": "Startex emerged in the 1890s as a planned mill village tied to the textile industry along the Middle Tyger River.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/startex_south_carolina"
    },
    {
      "id": 3,
      "text": "The textile mill in Startex ceased operations in 1998 and was mostly dismantled the following year.",
      "sourceSentenceIds": [
        16
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Startex%2C_South_Carolina"
    },
    {
      "id": 4,
      "text": "The Startex-Tucapau Preservation Foundation dedicated a time capsule in 2016 to mark the legacy of the local mill.",
      "sourceSentenceIds": [
