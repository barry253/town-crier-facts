  "facts": [
    {
      "id": 1,
      "text": "Bena takes its name from the Ojibwe word for partridge, a bird celebrated in Longfellow's Song of Hiawatha.",
      "sourceSentenceIds": [
        9,
        18
      ],
      "sourceLabels": [
        "Web source 1",
        "Wikipedia"
      ],
      "source": "https://www.lakesnwoods.com/Bena.htm",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Ernest Flemming, a pioneer businessman, founded Bena and served as its first postmaster when the post office opened in 1898.",
      "sourceSentenceIds": [
        9,
        14
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.lakesnwoods.com/Bena.htm",
      "category": "people",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The town once hosted a Great Northern Railway station, linking Bena to regional trade and travel.",
      "sourceSentenceIds": [
        14
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.lakesnwoods.com/Bena.htm",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "In 1975, after a walkout by 70 Indigenous students, the Leech Lake Band of Ojibwe established Bug-O-Nay-Ge-Shig School, a culturally responsive tribal school.",
      "sourceSentenceIds": [
        3,
        5
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Bena%2C_Minnesota",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "From 1901 to 1911, Bena housed the Bena Boarding School, an American Indian residential school operated by the federal government.",
      "sourceSentenceIds": [
        20
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Bena%2C_Minnesota",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "During World War II, a logging camp staffed by German prisoners of war operated near Bena, and two POWs briefly escaped in 1944.",
      "sourceSentenceIds": [
