  "facts": [
    {
      "id": 1,
      "text": "The Boston Theater District dates back to the 19th century, once called the 'Theater Block,' hosting vaudeville and famous actors.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://bostonsightseeing.us/boston-theater-district-2",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The Shubert Theatre on Stuart Street has long served as a tryout venue for Broadway-bound productions.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://boston.wiki/a/Theater_District",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The Wang Theatre, originally the Metropolitan Theatre of the 1920s, remains one of the district's most architecturally elaborate venues.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://boston.wiki/a/Theater_District",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Boston’s first theater opened in 1793, after Puritans banned plays until 1792 in the city.",
      "sourceSentenceIds": [
        12,
        13
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Boston_Theater_District",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The district’s development spans more than two centuries, reflecting Boston’s long-standing relationship with live performance.",
      "sourceSentenceIds": [
        25
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://boston.wiki/a/Theater_District",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The Washington Street Theatre District, seven buildings on Washington Street, was listed on the National Register of Historic Places in 1979.",
      "sourceSentenceIds": [
        19
      ],
