  "facts": [
    {
      "id": 1,
      "text": "Waterford earned its name from Waterford, Ireland, where some of its founders once lived before immigrating to the United States.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Waterford%2C_Virginia",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "In 1970, the entire village and surrounding farmland were declared a National Historic Landmark District, the highest U.S. historic designation.",
      "sourceSentenceIds": [
        4,
        17
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Waterford%2C_Virginia",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The Waterford Foundation, founded over 75 years ago, preserves the village’s historic buildings and open spaces through education and stewardship.",
      "sourceSentenceIds": [
        8,
        18,
        19
      ],
      "sourceLabels": [
        "Web source 1",
        "Wikipedia"
      ],
      "source": "https://www.waterfordvillage.org/",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The Second Street School, built in 1867, was the first one‑room African‑American schoolhouse in Waterford, funded by the Freedmen’s Bureau and Quaker support.",
      "sourceSentenceIds": [
        15
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.waterfordfoundation.org/visit-waterford/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Waterford’s annual fair, called “An Autumn Celebration of Americana,” showcases historic homes, artisan crafts, live music, and living history exhibits.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Waterford%2C_Virginia",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The Phillips Farm Trail Network invites visitors to explore Waterford’s natural side, winding through preserved farmland and historic landscapes.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Web source 2"
      ],
