      "id": 1,
      "text": "Neck City began as a rough zinc‑mining camp called Hell's Neck in 1890, earning a rowdy reputation before formal incorporation.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/neck_city_missouri",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "In 1957 the town’s post office was renamed Neck City, solidifying the community’s official name.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/neck_city_missouri",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Neck City sits between the Spring River and its North Fork, about nine miles northwest of Carthage.",
      "sourceSentenceIds": [
        15
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Neck_City%2C_Missouri",
      "category": "other",
      "quality": "poor",
      "qualityReason": "location_description"
    },
    {
      "id": 4,
      "text": "By the late 1890s the mining boom drew roughly 600 residents to Neck City.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
