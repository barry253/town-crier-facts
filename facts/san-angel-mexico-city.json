  "facts": [
    {
      "id": 1,
      "text": "San Ángel was originally called Tenanitla, meaning 'walled in place' in Nahuatl.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/San_%C3%81ngel",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The Dominican friars founded a hermitage in the 16th century, built of red brick and volcanic stone, which became the seed of the neighborhood.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://mymexicotrip.com/san-angel-neighborhood-guide-mexico-city/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "In 1613 a monastery school named San Ángel was inaugurated, marking the area's first formal educational institution.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/San_%C3%81ngel",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The Plaza del Carmen hosts the Museo de El Carmen, a museum that showcases the Carmelite order’s role in colonial Mexico.",
      "sourceSentenceIds": [
        27
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://mexicocity-guide.com/zones/san_angel/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The twin houses of Diego Rivera and Frida Kahlo, designed by Juan O’Gorman, sit just a ten‑minute walk from the plaza and are a key architectural landmark.",
      "sourceSentenceIds": [
        28
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://mexicocity-guide.com/zones/san_angel/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "San Ángel was declared a Pueblo Típico Pintoresco in 1934 and later a historical monument zone in 1987, preserving its rural layout and historic buildings.",
      "sourceSentenceIds": [
        13
      ],
