  "facts": [
    {
      "id": 1,
      "text": "Montgomery County was named in honor of Revolutionary War general Richard Montgomery, who died in 1775 while trying to capture Quebec City.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Montgomery_County%2C_Georgia",
      "category": "people",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The settlement that became Montgomery was founded by three British brothers—William, James, and Robert Montgomery—who arrived in the area in the early 1800s.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://kids.kiddle.co/Montgomery,_Georgia",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "After Arthur Lott's Plantation served as the first county seat, Mount Vernon was officially designated the new seat in 1813.",
      "sourceSentenceIds": [
        10,
        19
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Montgomery_County%2C_Georgia",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Montgomery County was created on December 19, 1793, carved out of the southern portion of Washington County, Georgia.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Montgomery_County%2C_Georgia",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "In 1801, the southern part of Montgomery was split off to form Tattnall County, reshaping the region’s borders.",
      "sourceSentenceIds": [
        11
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Montgomery_County%2C_Georgia",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Because of its pine barrens and poor soil, Montgomery never developed the cotton plantation culture that dominated much of Georgia.",
      "sourceSentenceIds": [
        24
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Montgomery_County%2C_Georgia",
