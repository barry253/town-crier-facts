  "facts": [
    {
      "id": 1,
      "text": "Crown Hill Cemetery began in 1863 during the Civil War, originally named Strawberry Hill before becoming “The Crown” for its lofty overlook of Indianapolis.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Crown_Hill_Cemetery",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Located at 700 West 38th Street, Crown Hill is Indiana’s largest rural cemetery and was added to the National Register of Historic Places in 1973.",
      "sourceSentenceIds": [
        12,
        14
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Crown_Hill_Cemetery",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "In 1970 the cemetery’s Waiting Station was leased for a dollar a year to the Historic Landmarks Foundation of Indiana, which restored the historic structure.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Crown_Hill_Cemetery",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The Crown Hill Heritage Foundation, founded in 1984, raises money to preserve the cemetery’s historic buildings and beautiful grounds.",
      "sourceSentenceIds": [
        13,
        15
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Crown_Hill_Cemetery",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "A docent‑led public tour at Crown Hill shares the cemetery’s history and the arboretum’s natural beauty, adding cultural context to the walk.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://crownhillhf.org/tours-events/public-tours/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The Hearts Remembered Memorial, dedicated in 2006, honors Indianapolis’s orphaned children, many of whom were buried in unmarked graves.",
      "sourceSentenceIds": [
        20
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Crown_Hill_Cemetery",
