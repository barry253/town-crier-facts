  "facts": [
    {
      "id": 1,
      "text": "Knox‑Henderson was founded in 1843 and named for James Pinckney Henderson, the first governor of Texas.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.hendersontx.us/324/About-Henderson",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The Baptist and Methodist churches, first built in 1845, now bear historical markers at their modern brick buildings.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.hendersontx.us/324/About-Henderson",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "In 1874 the Henderson and Overton Branch Railroad Company was chartered to lay 16 miles of track to Henderson.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.hendersontx.us/324/About-Henderson",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "By the early 1900s the line was sold to Missouri‑Pacific, now Union Pacific, and remains in service today.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.hendersontx.us/324/About-Henderson",
      "category": "transport",
      "quality": "good",
      "qualityReason": "other"
    },
    {
      "id": 5,
      "text": "During the 1990s DART excavated a Knox‑Henderson station platform 80 feet below ground, but it was never completed.",
      "sourceSentenceIds": [
        14,
        19
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Knox%E2%80%93Henderson_station",
      "category": "landmark",
      "quality": "poor",
      "qualityReason": "editorial_filler"
    },
    {
