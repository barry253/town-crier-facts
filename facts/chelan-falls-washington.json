  "facts": [
    {
      "id": 1,
      "text": "Chelan Falls sits on the Columbia River at the mouth of the Chelan River, about five miles south‑southeast of Chelan.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Chelan_Falls%2C_Washington",
      "category": "other",
      "quality": "poor",
      "qualityReason": "location_description"
    },
    {
      "id": 2,
      "text": "The falls total roughly 55 feet in height, split into four small cascades that together drop about 55 feet.",
      "sourceSentenceIds": [
        18,
        28
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.waterfallsnorthwest.com/waterfall/Chelan-Falls-4944",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Chelan Falls is the historic name of the waterfall that drops down the final gorge between Lake Chelan and the Columbia River.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.waterfallsnorthwest.com/waterfall/Chelan-Falls-4944",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Before 2009 the Chelan River was largely regulated by a hydroelectric system, often leaving the falls dry or greatly reduced.",
      "sourceSentenceIds": [
        24
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.waterfallsnorthwest.com/waterfall/Chelan-Falls-4944",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Since 2009 the hydro project was re‑licensed, allowing the river to flow through the gorge at all times and restoring the falls’ natural appearance.",
      "sourceSentenceIds": [
        25,
        26
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.waterfallsnorthwest.com/waterfall/Chelan-Falls-4944",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The river drops 350 feet from Lake Chelan to the Columbia, but the falls account for only a fraction of that total descent.",
