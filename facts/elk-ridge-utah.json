  "facts": [
    {
      "id": 1,
      "text": "Elk Ridge was originally built on the eighteen hundred acre Goosenest Ranch, nestled against Mount Loafer.",
      "sourceSentenceIds": [
        2,
        5
      ],
      "sourceLabels": [
        "Web source 2",
        "Wikipedia"
      ],
      "source": "https://onlineutah.us/elkridgehistory.shtml"
    },
    {
      "id": 2,
      "text": "The area was first developed into a settlement called Salem Hills after a dirt road was built in 1970.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Elk_Ridge%2C_Utah"
    },
    {
      "id": 3,
      "text": "Elk Ridge incorporated as a town on December 22, 1976, after the community grew to over one hundred residents.",
      "sourceSentenceIds": [
        11
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Elk_Ridge%2C_Utah"
    },
    {
      "id": 4,
      "text": "The town changed its name to Elk Ridge in 1978, honoring the large herds of elk that roamed the area.",
      "sourceSentenceIds": [
        3,
        4,
        12
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 2"
      ],
      "source": "https://en.wikipedia.org/wiki/Elk_Ridge%2C_Utah"
    },
    {
      "id": 5,
      "text": "The first home in the Elk Ridge area was completed in 1973.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
