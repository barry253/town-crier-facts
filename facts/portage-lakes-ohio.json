  "facts": [
    {
      "id": 1,
      "text": "Portage Lakes are a group of glacial kettle lakes and reservoirs in Northeast Ohio.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Portage_Lakes"
    },
    {
      "id": 2,
      "text": "The name comes from an Indian portage path that linked the Cuyahoga River to the Tuscarawas River, enabling an eight‑mile portage between Lake Erie and the Ohio River.",
      "sourceSentenceIds": [
        7,
        8
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Portage_Lakes"
    },
    {
      "id": 3,
      "text": "During the War of 1812, Portage Lakes served as a rendezvous point for American troops.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Portage_Lakes"
    },
    {
      "id": 4,
      "text": "Several lakes were built as feeder reservoirs for the Ohio and Erie Canal, keeping a 4‑foot depth.",
      "sourceSentenceIds": [
        16
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Portage_Lakes"
    },
    {
      "id": 5,
      "text": "The Portage Lakes Visitor Center opened in 2025, offering interactive displays about the park’s eight canal lakes.",
      "sourceSentenceIds": [
        28,
        21
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://sykes.house.gov/media/in-the-news/portage-lakes-visitor-center-opens-to-the-public"
    },
    {
