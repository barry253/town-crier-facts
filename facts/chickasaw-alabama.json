  "facts": [
    {
      "id": 1,
      "text": "Chickasaw takes its name from the Chickasaw people who once inhabited southwestern Alabama.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://encyclopediaofalabama.org/article/chickasaw/"
    },
    {
      "id": 2,
      "text": "The town began as a company town owned by the Chickasaw Shipyard, built for its workers.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://encyclopediaofalabama.org/article/chickasaw/"
    },
    {
      "id": 3,
      "text": "In 1917, Tennessee Coal, Iron, and Railroad Company purchased the land to build the Chickasaw Shipbuilding and Car Company at Mobile Bay's north end.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://encyclopediaofalabama.org/article/chickasaw/"
    },
    {
      "id": 4,
      "text": "During World War II, the shipyard expanded dramatically as part of the defense buildup.",
      "sourceSentenceIds": [
        17
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Chickasaw%2C_Alabama"
    },
    {
      "id": 5,
      "text": "The Chickasaw Shipyard Village was the setting of Marsh v. Alabama, a Supreme Court case on free speech.",
      "sourceSentenceIds": [
        18,
        19
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Chickasaw%2C_Alabama"
    },
    {
      "id": 6,
      "text": "In 2004, the Chickasaw Shipyard Village Historic District earned a spot on the National Register of Historic Places.",
      "sourceSentenceIds": [
        24
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Chickasaw%2C_Alabama"
