  "facts": [
    {
      "id": 1,
      "text": "Telegraph Hill was originally called Loma Alta during the Spanish and Mexican era.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Telegraph_Hill%2C_San_Francisco",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The hill earned California Historical Landmark #91 status, with a bronze plaque in Coit Tower’s lobby marking the original signal station.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Telegraph_Hill%2C_San_Francisco",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "In 1849 a semaphore windmill‑like structure was erected on Telegraph Hill, signaling ships and giving the hill its name.",
      "sourceSentenceIds": [
        30
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Telegraph_Hill%2C_San_Francisco",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The first California telegraph, an eight‑mile line to Point Lobos, was installed on Telegraph Hill in 1853, replacing the semaphore.",
      "sourceSentenceIds": [
        22
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Telegraph_Hill%2C_San_Francisco",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Coit Tower, a 210‑foot Art Deco structure, crowns Telegraph Hill’s apex and is visible across San Francisco.",
      "sourceSentenceIds": [
        24
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Telegraph_Hill%2C_San_Francisco",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The steep cliffs of Telegraph Hill shaped the district’s development pattern and remain a highly significant aesthetic component.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 1"
      ],
