  "facts": [
    {
      "id": 1,
      "text": "Holly was named after Mount Holly, New Jersey, a choice that may have been inspired by the bright red holly berries that grew in Michigan swamps.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://michigan4you.com/history-of-holly-michigan/",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Detroit & Milwaukee Railroad came through Holly in 1855, followed by the Flint & Holly Railroad in 1864, making Holly one of the first Michigan communities with a junction.",
      "sourceSentenceIds": [
        20
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.hollyhistorical.org/",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Grinnell Brothers Piano Factory opened in 1908, billed as the world's largest piano factory, producing thousands by the 1920s.",
      "sourceSentenceIds": [
        11,
        12,
        13
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://michigan4you.com/history-of-holly-michigan/",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Heinz built a factory in Holly producing ketchup and pickles.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://michigan4you.com/history-of-holly-michigan/",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Holly Union Depot was built in 1886, served two lines, and is now abandoned.",
