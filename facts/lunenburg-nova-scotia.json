  "facts": [
    {
      "id": 1,
      "text": "Lunenburg was founded in 1753 as one of the first British attempts to settle Protestants in Nova Scotia.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Lunenburg%2C_Nova_Scotia",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town was named after the Duke of Braunschweig‑Lüneburg, who became King George II of Great Britain.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Lunenburg%2C_Nova_Scotia",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Lunenburg’s historic core is a UNESCO World Heritage Site, the only other North American urban community with that status.",
      "sourceSentenceIds": [
        13,
        26
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.novascotia.com/explore-by-region/south-shore/lunenburg/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Its wooden vernacular architecture preserves the original 1800s layout, making it the best example of planned British colonial settlement in North America.",
      "sourceSentenceIds": [
        27
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Lunenburg%2C_Nova_Scotia",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Lunenburg hosts Canada’s largest secondary fish‑processing plant, a legacy of its historic offshore fishery economy.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Lunenburg%2C_Nova_Scotia",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The Lunenburg Academy National Historic Site, known as the “castle on the hill,” houses a heritage classroom and hosts music performances.",
      "sourceSentenceIds": [
        16
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.novascotia.com/explore-by-region/south-shore/lunenburg/",
      "category": "landmark",
      "quality": "good"
    }
