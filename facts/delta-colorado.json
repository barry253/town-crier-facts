  "facts": [
    {
      "id": 1,
      "text": "Delta earned its name from the river delta where the Uncompahgre meets the Gunnison.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Delta%2C_Colorado"
    },
    {
      "id": 2,
      "text": "The city sits at the confluence of the Gunnison and Uncompahgre rivers, a spot that has drawn travelers for centuries.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://colorado.wiki/a/Delta,_Colorado"
    },
    {
      "id": 3,
      "text": "Delta’s riverside location makes it a gateway to hiking, fishing, and rafting adventures on the Western Slope.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://colorado.wiki/a/Delta,_Colorado"
    },
    {
      "id": 4,
      "text": "The Delta County Historical Museum preserves artifacts that tell the story of Ute, Spanish, and pioneer life in the region.",
      "sourceSentenceIds": [
        14
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://colorado.wiki/a/Delta,_Colorado"
    },
    {
      "id": 5,
      "text": "Delta hosts the United States Forest Service headquarters for the Grand Mesa, Gunnison, and Uncompahgre National Forests.",
      "sourceSentenceIds": [
        17
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Delta%2C_Colorado"
    },
    {
      "id": 6,
      "text": "A post office opened in Delta on January 5, 1882, and the town was officially incorporated the same year.",
