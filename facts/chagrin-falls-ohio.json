  "facts": [
    {
      "id": 1,
      "text": "Chagrin Falls takes its name from the series of waterfalls that cascade along the Chagrin River through the village.",
      "sourceSentenceIds": [
        24
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Chagrin_Falls%2C_Ohio"
    },
    {
      "id": 2,
      "text": "The village was laid out in 1837 and officially incorporated in 1844 from parts of three townships.",
      "sourceSentenceIds": [
        23,
        25
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Chagrin_Falls%2C_Ohio"
    },
    {
      "id": 3,
      "text": "Walk through the historic core and you’ll find the original waterfall and dam still framing the town’s center.",
      "sourceSentenceIds": [
        9,
        13
      ],
      "sourceLabels": [
        "Web source 1",
        "Web source 2"
      ],
      "source": "https://www.chagrinfallsoh.gov/231/About-the-Village"
    },
    {
      "id": 4,
      "text": "The 1977 television film The Gathering was shot on location in Chagrin Falls, giving the town a brief moment in Hollywood history.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Chagrin_Falls%2C_Ohio"
    },
    {
      "id": 5,
      "text": "In the early 1900s, Leader Tractors were manufactured in Chagrin Falls, adding a slice of industrial heritage to the village.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Chagrin_Falls%2C_Ohio"
    },
    {
      "id": 6,
      "text": "By 1842, the Chagrin River powered nine mills—including saw, flour, foundry, and paper mills—fueling the village’s early economy.",
