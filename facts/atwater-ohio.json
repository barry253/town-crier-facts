      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The first settlers arrived in June 1799, making Atwater one of the earliest townships established in the Connecticut Western Reserve.",
      "sourceSentenceIds": [
        7,
        15
      ],
      "sourceLabels": [
        "Web source 2",
