  "facts": [
    {
      "id": 1,
      "text": "Dunlap, Kansas, was named after Indian agent Joseph Gage Dunlap, who founded the town in 1869 after the Kanza tribe moved to Oklahoma.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Dunlap%2C_Kansas",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Originally established in 1869, Dunlap became a key Exoduster settlement where freed African Americans sought refuge after the Civil War.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://unitedstatesghosttowns.com/dunlap-kansas-ghost-town/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "In 1880, the Presbyterian Church founded Dunlap’s Freedmen’s Academy to provide education for African‑American settlers.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Dunlap%2C_Kansas",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Today, only concrete foundations, the preserved Methodist Church, and the historic Freedmen’s Cemetery remain as tangible echoes of the town.",
      "sourceSentenceIds": [
        16
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://unitedstatesghosttowns.com/dunlap-kansas-ghost-town/",
      "category": "landmark",
      "quality": "poor",
      "qualityReason": "vague"
    },
    {
      "id": 5,
      "text": "Dunlap sprang up beside the Missouri, Kansas & Texas Railway, and the Katy Railroad’s passenger service ended in 1952 before tracks were torn up in 1957.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://unitedstatesghosttowns.com/dunlap-kansas-ghost-town/",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The town’s last Black resident died in 1993, closing a chapter of the African‑American community founded by Benjamin Singleton.",
      "sourceSentenceIds": [
        18
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://unitedstatesghosttowns.com/dunlap-kansas-ghost-town/",
