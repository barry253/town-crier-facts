    {
      "id": 1,
      "text": "Washoe people inhabited the lands surrounding Lake Tahoe for at least 2,000 years before European contact.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/lakeridge_nevada"
    },
    {
      "id": 2,
      "text": "Family bands occupied distinct areas, hunting, gathering piñon nuts and acorns, and rabbit drives.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/lakeridge_nevada"
    },
    {
      "id": 3,
      "text": "Sawmills appeared at Glenbrook on Lake Tahoe's east shore as early as 1861, extracting millions of board feet of sugar pine.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/lakeridge_nevada"
    },
    {
      "id": 4,
      "text": "Lakeridge began its modern development in 1966 as a planned subdivision on Lake Tahoe's east shore, featuring about 75 upscale residences.",
      "sourceSentenceIds": [
        14
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/lakeridge_nevada"
    },
    {
      "id": 5,
      "text": "Lakeridge sits at roughly 6,400 feet above sea level on the east shore of Lake Tahoe.",
      "sourceSentenceIds": [
        20
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/lakeridge_nevada"
    },
    {
      "id": 6,
      "text": "Groundwater in Lakeridge is recharged by snowmelt and flows westward through fractured granite toward Lake Tahoe.",
