  "facts": [
    {
      "id": 1,
      "text": "Anaconda was founded by copper magnate Marcus Daly in 1883, who named the town after the large snake to reflect the smelter’s power.",
      "sourceSentenceIds": [
        21,
        26
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Anaconda%2C_Montana",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The Washoe Theatre, an Art Deco‑style landmark built in the mid‑1930s, still shows films and hosts plays in downtown Anaconda.",
      "sourceSentenceIds": [
        6,
        18,
        20
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 2"
      ],
      "source": "https://en.wikipedia.org/wiki/Anaconda%2C_Montana",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The Copper Village Museum and Arts Center houses an art gallery upstairs and a history museum in its basement, showcasing local copper‑mining heritage.",
      "sourceSentenceIds": [
        7,
        19
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 2"
      ],
      "source": "https://en.wikipedia.org/wiki/Anaconda%2C_Montana",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Anaconda’s historic bus tours depart from 306 East Park Street, offering a narrated walk through the town’s mining past.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://montanadiscovered.com/anaconda-mt/",
      "category": "other",
      "quality": "poor",
      "qualityReason": "vague"
    },
    {
      "id": 5,
      "text": "The town sits at the foot of the Anaconda Range, with the Continental Divide just eight miles south, giving it dramatic mountain scenery.",
      "sourceSentenceIds": [
        24
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Anaconda%2C_Montana",
      "category": "nature",
      "quality": "good"
    },
    {
