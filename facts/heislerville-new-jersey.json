  "facts": [
    {
      "id": 1,
      "text": "Heislerville got its name from the Heisler family, prominent Methodist Episcopal Church members who settled there in 1828.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Heislerville%2C_New_Jersey",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "A survey marker east of Milmay, placed by the 1688 West New Jersey Proprietors, once divided three townships.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://mauricerivertwp.org/2169/History",
      "category": "landmark",
      "quality": "poor",
      "qualityReason": "vague"
    },
    {
      "id": 3,
      "text": "The Maurice River Historical Society, founded in 1980, preserves Heislerville’s maritime and agricultural heritage in its museum and research library.",
      "sourceSentenceIds": [
        12,
        6
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://museumsdatabase.com/museums/view/19759",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Heislerville’s railroad station, “Link City,” once shipped thousands of strawberries and supported nearby oyster packing operations.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://mauricerivertwp.org/2169/History",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The town’s museum showcases Native American artifacts, maritime history, and local industry, reflecting the region’s diverse past.",
      "sourceSentenceIds": [
        15
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://museumsdatabase.com/museums/view/19759",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "In 1995, the town’s historic bridge was added to the National Register of Historic Places for its engineering and transportation significance.",
