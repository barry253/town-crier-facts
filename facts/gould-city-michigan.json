    },
    {
      "id": 2,
      "text": "By 1893 a Minneapolis, St. Paul and Sault Ste. Marie line stopped in Gould City, turning it into a bustling rail hub.",
      "sourceSentenceIds": [
        11,
        13
      ],
      "sourceLabels": [
        "Wikipedia",
