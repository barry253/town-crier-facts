  "facts": [
    {
      "id": 1,
      "text": "Bel Alton began as Cox's Station in 1873 on land owned by Samuel Cox of nearby Rich Hill before adopting its current name in the late 19th century.",
      "sourceSentenceIds": [
        1,
        15
      ],
      "sourceLabels": [
        "Web source 1",
        "Wikipedia"
      ],
      "source": "https://grokipedia.com/page/bel_alton_maryland",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town’s historic district covers about 10 acres and includes 26 buildings that showcase Victorian‑era railroad architecture from 1880 to 1951.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/bel_alton_maryland",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "A former school in Bel Alton was saved from demolition in the late 1980s, restored as a community center by 2015, and added to the National Register of Historic Places in February 2025.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/bel_alton_maryland",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Ignatius Church and Cemetery, located two miles west of Bel Alton, claims to be the oldest continuously operating Roman Catholic parish in the United States.",
      "sourceSentenceIds": [
