  "facts": [
    {
      "id": 1,
      "text": "The area around Monroe was originally inhabited by the Kalapuya peoples, specifically bands such as the Santiam Kalapuya.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/monroe_oregon"
    },
    {
      "id": 2,
      "text": "Monroe was formed in 1857 when two early settlements, Starrs Point and White's Mill, merged into one town.",
      "sourceSentenceIds": [
        3,
        19
      ],
      "sourceLabels": [
        "Web source 2",
        "Wikipedia"
      ],
      "source": "https://grokipedia.com/page/monroe_oregon"
    },
    {
      "id": 3,
      "text": "Monroe once served as a vital nexus for commercial river traffic, transporting lumber and grain along the Willamette River.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/monroe_oregon"
    },
    {
      "id": 4,
      "text": "Monroe is home to the historic Hull-Oakes Lumber Mill, the only steam-powered sawmill still operating in the United States.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Monroe%2C_Oregon"
    },
    {
      "id": 5,
      "text": "The city refurbished its old historic train station to create a new community library serving Monroe and the surrounding area.",
      "sourceSentenceIds": [
        13
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://monroeoregon.gov/1230/Community-Profile"
    },
    {
      "id": 6,
      "text": "Monroe High School was built in the 1920s and continues to serve the local community.",
      "sourceSentenceIds": [
        22
