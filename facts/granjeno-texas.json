      ],
      "source": "https://en.wikipedia.org/wiki/Granjeno%2C_Texas",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Granjeno’s name comes from the granjeno tree, a spiny hackberry native to the area.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Granjeno%2C_Texas",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "El Granjeno Cemetery was founded in 1872, beginning with the burial of Don Antonio Garza.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Granjeno%2C_Texas",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Historic documents reserve the cemetery’s rear solely for direct descendants of Don Juan Garza Escheverria.",
      "sourceSentenceIds": [
