  "facts": [
    {
      "id": 1,
      "text": "Tripoli earned its original name, Old Tripoli, to honor the Battle of Tripoli, a nod to early American history.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.tripoliiowa.com/pages/about-us-1"
    },
    {
      "id": 2,
      "text": "Founded in 1880 by H.J. Wynhoff, Tripoli began as a modest settlement before growing into the community it is today.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.tripoliiowa.com/pages/about-us-1"
    },
    {
      "id": 3,
      "text": "When the Chicago Great Western Railroad laid tracks nearby, the town moved half a mile north to its current spot.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.tripoliiowa.com/pages/about-us-1"
    },
    {
      "id": 4,
      "text": "The Tripoli Post Office opened in 1860, long before the town’s official founding, serving early settlers in the area.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Tripoli%2C_Iowa"
    },
    {
      "id": 5,
      "text": "Nestled in Bremer County, Tripoli sits within the Waterloo–Cedar Falls metropolitan area, linking it to a larger regional community.",
      "sourceSentenceIds": [
        4,
        5
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Tripoli%2C_Iowa"
    },
    {
      "id": 6,
      "text": "High school athletes rally behind the Tripoli Panthers, a local team that embodies the town’s spirited community pride.",
