  "facts": [
    {
      "id": 1,
      "text": "Pick City was founded in July 1946 and named after General Lewis A., the city was platted to oversee the Garrison Dam.",
      "sourceSentenceIds": [
        1,
        2,
        8
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Pick_City%2C_North_Dakota"
    },
    {
      "id": 2,
      "text": "Pick City overlooks the Garrison Dam, a key hydroelectric project that also irrigates the Missouri Basin.",
      "sourceSentenceIds": [
        6,
        29
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Pick_City%2C_North_Dakota"
    },
    {
      "id": 3,
      "text": "During the 1940s, the Bureau of Reclamation and Army Corps of Engineers proposed plans to control flooding, leading to the dam’s construction.",
      "sourceSentenceIds": [
        4,
        7
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Pick_City%2C_North_Dakota"
    },
    {
      "id": 4,
      "text": "The Pick-Sloan Missouri Basin Plan, which merged the dam’s plans, became a cornerstone of regional water management.",
      "sourceSentenceIds": [
        30
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.pickcitynd.com/"
    },
    {
      "id": 5,
      "text": "The town sits near the shores of Lake Sakakawea, known for its abundant fishing opportunities.",
      "sourceSentenceIds": [
        27
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.pickcitynd.com/"
    },
    {
      "id": 6,
      "text": "Construction of the Garrison Dam brought an influx of people from all areas, shaping Pick City’s early community.",
