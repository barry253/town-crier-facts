  "facts": [
    {
      "id": 1,
      "text": "Hillsdale sits where NY 22 and NY 23 cross, a junction so historic it earned a spot on the National Register of Historic Places.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
