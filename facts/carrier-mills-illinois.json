  "facts": [
    {
      "id": 1,
      "text": "Carrier Mills grew around George Washington Carrier's saw and grist mills, becoming a boomtown when the Cairo and Vincennes Railroad arrived.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Carrier_Mills%2C_Illinois",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The village’s original name, Morrillsville, honored surveyor Benjamin D. Lewis and was renamed Carrier Mills as more woodworking factories appeared.",
      "sourceSentenceIds": [
        8,
        15
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Carrier_Mills%2C_Illinois",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Lakeview, a mile south, was one of Illinois’ oldest documented Black settlements, founded by free and runaway slaves after the War of 1812.",
      "sourceSentenceIds": [
        1,
        11
      ],
      "sourceLabels": [
        "Web source 1",
        "Wikipedia"
      ],
      "source": "https://grokipedia.com/page/carrier_mills_illinois",
      "category": "people",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The Lakeview cemetery is now a state historical landmark, preserving the legacy of that early African‑American community.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Carrier_Mills%2C_Illinois",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Carrier Mills hosts the annual Catskin Days Fair and Parade each October, celebrating the town’s heritage with a multi‑day festival.",
