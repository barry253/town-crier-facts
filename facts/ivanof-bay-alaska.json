  "facts": [
    {
      "id": 1,
      "text": "Ivanof Bay received its name in 1880 from a lieutenant who charted the area.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.ivanofbaytribe.org/about"
    },
    {
      "id": 2,
      "text": "Ivanof Bay sits at the north end of a Pacific arm, positioned at 55°54′40″N 159°29′21″W.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Ivanof_Bay%2C_Alaska"
    },
    {
      "id": 3,
      "text": "The community lies 13 miles west of Perryville and 53 miles northeast of Sand Point, making it the farthest southwest spot in the borough.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Ivanof_Bay%2C_Alaska"
    },
    {
      "id": 4,
      "text": "A salmon cannery and post office operated from the 1930s to the early 1950s, before permanent residents settled in the 1960s.",
      "sourceSentenceIds": [
        16
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.ivanofbaytribe.org/about"
    },
    {
      "id": 5,
      "text": "The Ivanof Bay Tribal Council’s mission is to safeguard sovereign rights, nurture community resources, and preserve cultural traditions.",
      "sourceSentenceIds": [
        18
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.ivanofbaytribe.org/about"
    },
    {
      "id": 6,
      "text": "In the 1960s, families moved from Perryville seeking better hunting grounds, water sources, and a peaceful lifestyle with religious freedom.",
      "sourceSentenceIds": [
