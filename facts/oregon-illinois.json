  "facts": [
    {
      "id": 1,
      "text": "Oregon was founded in 1833 by John Phelps, a sawmiller.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.britannica.com/place/Oregon-Illinois"
    },
    {
      "id": 2,
      "text": "The city’s name was briefly changed to Florence in 1839 after a visitor compared the Rock River to the Italian city, but the name reverted.",
      "sourceSentenceIds": [
        6,
        10
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Oregon%2C_Illinois"
    },
    {
      "id": 3,
      "text": "In the early 1900s, sculptor Lorado Taft founded the Eagle’s Nest Art Colony north of town, influencing local culture.",
      "sourceSentenceIds": [
        8,
        11
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Oregon%2C_Illinois"
    },
    {
      "id": 4,
      "text": "Taft also erected a 50‑foot statue called The Eternal Indian (now the Black Hawk Statue) on a bluff overlooking the Rock River.",
      "sourceSentenceIds": [
        1,
        7
      ],
      "sourceLabels": [
        "Wikipedia",
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Oregon%2C_Illinois"
    },
    {
      "id": 5,
      "text": "Oregon’s economy grew with industries such as oatmeal, furniture, flour, and a foundry after the railroad arrived in the 1870s.",
      "sourceSentenceIds": [
        20,
        3
      ],
      "sourceLabels": [
        "Web source 1",
        "Wikipedia"
      ],
      "source": "https://visitoregonil.com/history"
    },
    {
      "id": 6,
      "text": "The Oregon Public Library, built in 1908, includes a second‑story art gallery added because of the nearby art colony.",
      "sourceSentenceIds": [
        23
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
