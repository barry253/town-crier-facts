  "facts": [
    {
      "id": 1,
      "text": "Big Pool is a 1.5‑mile stretch of the Chesapeake and Ohio Canal that served as a convenient turning point for canal boats.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.canaltrust.org/pyv/big-pool/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The canal’s 113‑mile mark, known as the 14‑mile level, hosts the large body of water called Big Pool.",
      "sourceSentenceIds": [
        30
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Big_Pool%2C_Maryland",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Big Pool sits along Interstate 70 between Clear Spring and Hancock, within the Hagerstown Metropolitan Area.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Big_Pool%2C_Maryland",
      "category": "other",
      "quality": "poor",
      "qualityReason": "location_description"
    },
    {
      "id": 4,
      "text": "The Chesapeake and Ohio Canal National Historical Park, which protects the historic canal, runs adjacent to Big Pool.",
      "sourceSentenceIds": [
        2,
        3
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://kids.kiddle.co/Big_Pool,_Maryland",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Big Pool’s warm‑water fishery supports species such as largemouth bass, catfish, carp, and bluegill.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Web source 1"
      ],
