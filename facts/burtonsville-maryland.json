  "facts": [
    {
      "id": 1,
      "text": "Burtonsville was named after Isaac Burton, who bought his siblings' shares in 1825 and became the area's major landowner.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Burtonsville%2C_Maryland"
    },
    {
      "id": 2,
      "text": "The town grew around the intersection of Old Columbia Pike and the road to Sandy Spring, later becoming a stop between Baltimore and Washington.",
      "sourceSentenceIds": [
        27,
        1
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Burtonsville%2C_Maryland"
    },
    {
      "id": 3,
      "text": "In the 1850s Isaac Burton opened the first post office in his store at that intersection, becoming the town’s first postmaster.",
      "sourceSentenceIds": [
        28
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Burtonsville%2C_Maryland"
    },
    {
      "id": 4,
      "text": "Burtonsville hosts an annual Burtonsville Day parade, craft fair, and live music that draws families each year.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Burtonsville%2C_Maryland"
    },
    {
      "id": 5,
      "text": "Paint Branch Park, once agricultural land, was converted into a public park in the late 1970s, preserving local natural scenery.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://touristplaces.guide/top-10-places-to-visit-in-burtonsville-nature-adventure-and-history/"
    },
    {
      "id": 6,
      "text": "The Burtonsville Historic District showcases Victorian and early 20th‑century homes, including the town hall, reflecting the town’s architectural heritage.",
