      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Danville’s Old Meeting House, built in 1755, is the oldest original meeting house in New Hampshire and sits on the National Register of Historic Places.",
      "sourceSentenceIds": [
        8,
        9
      ],
      "sourceLabels": [
