      "qualityReason": "location_description"
    },
    {
      "id": 4,
      "text": "As a class B town, New Hope operates under an aldermanic form of government defined by Texas general law.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/New_Hope%2C_Texas",
