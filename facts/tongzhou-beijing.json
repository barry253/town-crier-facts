  "facts": [
    {
      "id": 1,
      "text": "Tongzhou was founded in 195 BC as Lu County during the Western Han dynasty, with evidence of Neolithic settlement.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Tongzhou%2C_Beijing",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "In 1151 the Jin dynasty renamed Lu County to Tongzhou, meaning “the place for passing through,” highlighting its role as Beijing’s land‑and‑water gateway.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Tongzhou%2C_Beijing",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Tongzhou sits at the northern end of the Grand Canal, where the Tonghui and Northern Canals meet, making it a historic transport hub.",
      "sourceSentenceIds": [
        5,
        20
      ],
      "sourceLabels": [
        "Web source 1",
        "Wikipedia"
      ],
      "source": "https://ruqintravel.com/china-destination-guides/beijing-tongzhou-district-travel-guide/",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The Tongzhou Lighthouse Pagoda, originally built during the Northern Zhou Dynasty, stands as a striking symbol of the district’s rich heritage.",
      "sourceSentenceIds": [
        17,
        8
      ],
      "sourceLabels": [
        "Web source 1",
        "Wikipedia"
      ],
      "source": "https://ruqintravel.com/china-destination-guides/beijing-tongzhou-district-travel-guide/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Tongzhou’s southern city wall remnants still stand today, offering a glimpse into the town’s ancient defensive architecture.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://ruqintravel.com/china-destination-guides/beijing-tongzhou-district-travel-guide/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "In July 2015 Tongzhou became Beijing’s second administrative seat, moving many municipal departments to ease congestion in the capital’s center.",
      "sourceSentenceIds": [
        26,
        27
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
