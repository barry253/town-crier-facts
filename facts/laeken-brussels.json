  "facts": [
    {
      "id": 1,
      "text": "The name Laeken comes from the Germanic word Lacha, meaning water, because a network of ponds once dotted the area.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Laeken",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Charles de Wailly built Laeken’s Royal Palace between 1782 and 1784, and it has been the Belgian royal family’s official home ever since.",
      "sourceSentenceIds": [
        12,
        13
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Laeken",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Alphonse Balat, assisted by young Victor Horta, designed Laeken’s Royal Greenhouses, whose monumental domes open to the public only a few days each year.",
      "sourceSentenceIds": [
        18,
        19
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Laeken",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Leopold II commissioned the Chinese Pavilion and Japanese Tower, now housed in the Museums of the Far East on Laeken’s park grounds.",
      "sourceSentenceIds": [
        26,
        27
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Laeken",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The neo‑Gothic Church of Our Lady, built as a mausoleum for Queen Louise‑Marie, contains the Royal Crypt where Belgian royals rest.",
      "sourceSentenceIds": [
