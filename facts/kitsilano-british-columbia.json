      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "A 1932 Imperial Gasoline station on Cornwall Avenue evolved into a long‑running restaurant spot that still serves locals today.",
      "sourceSentenceIds": [
