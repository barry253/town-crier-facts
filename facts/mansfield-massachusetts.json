  "facts": [
    {
      "id": 1,
      "text": "Mansfield was named for William Murray, 1st Earl of Mansfield, a pro‑colonial member of the House of Lords.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Mansfield%2C_Massachusetts",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "In 1815 Solomon Pratt and Elkanah Bates started the Upper Factory for cotton spinning, and by 1830 the town boasted dozens of water‑powered cotton mills and tack factories.",
      "sourceSentenceIds": [
        1,
        7
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/Mansfield,_Massachusetts",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The Boston and Providence Railroad arrived in 1835, linking Mansfield to Boston and Providence and sparking a boom in cotton, iron, and leather production.",
      "sourceSentenceIds": [
        19
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/Mansfield,_Massachusetts",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Walter Lowney Chocolate Factory opened in 1903, moving from Boston to Mansfield and employing hundreds until the mid‑20th century.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/Mansfield,_Massachusetts",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The Fisher–Richardson House, built 1743‑51, now serves as a local history museum after a 1930 restoration.",
      "sourceSentenceIds": [
        9,
        10
      ],
