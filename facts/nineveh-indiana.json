      "category": "culture",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Nineveh took its name from Nineveh Creek, itself named after hunter Nineveh Berry who fell into the creek while hunting deer.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
