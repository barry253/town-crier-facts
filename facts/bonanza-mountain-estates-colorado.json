    {
      "id": 1,
      "text": "Bonanza Mountain Estates sits on a ridge between Middle and North Boulder Creek, giving it a unique high‑elevation setting.",
      "sourceSentenceIds": [
        6,
        15
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Bonanza_Mountain_Estates%2C_Colorado",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The community’s name echoes the 19th‑century silver boom that shifted the area from gold prospecting to mining after 1870.",
      "sourceSentenceIds": [
        17,
        18
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/bonanza_mountain_estates_colorado",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "At about 8,450 feet, the enclave is surrounded by dense pine forests that historically have increased wildfire risk due to fire suppression.",
      "sourceSentenceIds": [
        8,
        2
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/bonanza_mountain_estates_colorado",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "All 98 homes are owner‑occupied single‑family houses valued between $500,000 and $1 million, reflecting its affluent, long‑term residency.",
      "sourceSentenceIds": [
        9,
        10
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/bonanza_mountain_estates_colorado",
      "category": "other",
      "quality": "poor",
      "qualityReason": "other"
    },
    {
      "id": 5,
      "text": "The area transitioned from mining camps to ranching in the late 1800s, laying groundwork for the modern residential enclave.",
      "sourceSentenceIds": [
        19,
        21
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/bonanza_mountain_estates_colorado",
      "category": "history",
      "quality": "good"
    },
