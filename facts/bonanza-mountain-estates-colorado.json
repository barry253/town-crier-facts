    },
    {
      "id": 2,
      "text": "The community’s name echoes the 19th‑century silver boom that shifted the area from gold prospecting to mining after 1870.",
      "sourceSentenceIds": [
        17,
        18
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/bonanza_mountain_estates_colorado"
    },
    {
      "id": 3,
      "text": "At about 8,450 feet, the enclave is surrounded by dense pine forests that historically have increased wildfire risk due to fire suppression.",
      "sourceSentenceIds": [
        8,
        2
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/bonanza_mountain_estates_colorado"
    },
    {
      "id": 4,
      "text": "All 98 homes are owner‑occupied single‑family houses valued between $500,000 and $1 million, reflecting its affluent, long‑term residency.",
      "sourceSentenceIds": [
        9,
        10
      ],
      "sourceLabels": [
