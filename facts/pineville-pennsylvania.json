  "facts": [
    {
      "id": 1,
      "text": "Pineville earned its name from a cluster of pine trees that marked the crossroads, a landmark that guided early settlers.",
      "sourceSentenceIds": [
        1,
        3,
        8
      ],
      "sourceLabels": [
        "Web source 1",
        "Wikipedia"
      ],
      "source": "https://grokipedia.com/page/pineville_pennsylvania",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The Pineville Tavern, built around 1742 and expanded in 1797, has operated continuously as an inn along a stagecoach route.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/pineville_pennsylvania",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Pineville sits just east of Neshaminy Creek, whose baseflow and flood dynamics have carved the surrounding valleys.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/pineville_pennsylvania",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Eastburn Farm hosts seasonal events and fresh produce, while the village’s equestrian facilities keep the rural charm alive.",
      "sourceSentenceIds": [
        26
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/pineville_pennsylvania",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Iron for Doylestown’s 1812 county jail was forged in Pineville, later turning the local forge into a nail manufacturer.",
      "sourceSentenceIds": [
        18,
