  "facts": [
    {
      "id": 1,
      "text": "Cherokee was named by Welsh miners in the 1850s to honor Cherokee prospectors who first worked the claims.",
      "sourceSentenceIds": [
        5,
        6,
        7
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://unitedstatesghosttowns.com/cherokee-california-ghost-town/",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town once boasted a Chinese Taoist temple built in the 1860s, one of America's oldest Taoist establishments, now a state historic site.",
      "sourceSentenceIds": [
        11
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Cherokee%2C_California",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Cherokee’s peak population swelled to several thousand during the gold rush, but by the 1900s most mines closed and the town nearly abandoned.",
      "sourceSentenceIds": [
        15,
        23
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://westernmininghistory.com/towns/california/cherokee/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Today, scattered mining ruins and a cemetery mark Cherokee as an authentic ghost town, with remnants still visible after a 1940s wildfire.",
      "sourceSentenceIds": [
        20,
        26
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://unitedstatesghosttowns.com/cherokee-california-ghost-town/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The town sits at 1,306 feet on Cherokee Road off State Route 70, within the traditional territory of the Maidu people.",
      "sourceSentenceIds": [
        24,
        25,
        28
      ],
