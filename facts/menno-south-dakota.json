  "facts": [
    {
      "id": 1,
      "text": "German-Russians who first settled in Nebraska founded the city of Menno after arriving in the United States between 1847 and 1848.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.mennosd.org/index.asp?SEC=CD7B0B90-E53E-4A31-8688-73663827AA3E&Type=B_BASIC"
    },
    {
      "id": 2,
      "text": "The area around Menno was settled in 1874 after delegates traveled north to find land for permanent settlements.",
      "sourceSentenceIds": [
        28
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.mennosd.org/index.asp?SEC=CD7B0B90-E53E-4A31-8688-73663827AA3E&Type=B_BASIC"
    },
    {
      "id": 3,
      "text": "Menno was officially laid out in 1879 in the southeastern part of Hutchinson County.",
      "sourceSentenceIds": [
        4,
        30
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Menno%2C_South_Dakota"
    },
    {
      "id": 4,
      "text": "Menno continues to hold its small town character and celebrates the heritage of its diverse yet united residents.",
      "sourceSentenceIds": [
        29,
        30
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.mennosd.org/index.asp?SEC=CD7B0B90-E53E-4A31-8688-73663827AA3E&Type=B_BASIC"
    },
    {
      "id": 5,
      "text": "Menno experiences a humid continental climate with warm, humid summers and cold winters.",
      "sourceSentenceIds": [
        24
