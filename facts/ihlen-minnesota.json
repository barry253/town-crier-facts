    {
      "id": 1,
      "text": "Ihlen, Minnesota was platted in July 1888 on land owned by Norwegian immigrant Carl Ihlen, after whom the town was named.",
      "sourceSentenceIds": [
        1,
        6,
        8,
        10
      ],
      "sourceLabels": [
        "Web source 1",
        "Wikipedia"
      ],
      "source": "https://grokipedia.com/page/ihlen_minnesota",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Ihlen grew as a key stop on the Willmar & Sioux Falls Railway, later part of the Great Northern system, moving grain to regional markets.",
      "sourceSentenceIds": [
        12,
        4
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/ihlen_minnesota",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The 1892 Ihlen Mercantile Company building, also known as Rodman's Store, earned a National Register of Historic Places spot in 1980.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/ihlen_minnesota",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "A post office opened in Ihlen in 1889, marking the town’s first federal service.",
      "sourceSentenceIds": [
        20
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Ihlen%2C_Minnesota",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Ihlen experiences sharp seasonal swings, with January lows around 2°F and July highs reaching 84°F.",
