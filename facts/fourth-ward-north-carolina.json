      "quality": "good"
    },
    {
      "id": 2,
      "text": "The 1970s revitalization of Fourth Ward became a model that ignited Uptown Charlotte’s modern downtown growth.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 1"
      ],
