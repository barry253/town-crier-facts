        5
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://unitedstatesghosttowns.com/ardara-pennsylvania-ghost-town/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town’s pure white sand was the finest in the country, a key ingredient for industrial glassmaking.",
      "sourceSentenceIds": [
        22
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://unitedstatesghosttowns.com/ardara-pennsylvania-ghost-town/",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "In 1962 a city‑sanctioned trash fire sparked underground fires, forcing residents to abandon their homes.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://unitedstatesghosttowns.com/ardara-pennsylvania-ghost-town/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Today smoke still seeps from the ground where Ardara once stood, hinting at lingering underground fires.",
