  "facts": [
    {
      "id": 1,
      "text": "Worsley’s history dates back to 1195, when the first documented mention of the village appeared in medieval records.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://secretmanchester.com/worsley-salford-greater-manchester-birthplace-of-transport-revolution/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The village earned the nickname “Birthplace of the Transport Revolution” thanks to the pioneering canals that cut through the area in the 18th century.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://secretmanchester.com/worsley-salford-greater-manchester-birthplace-of-transport-revolution/",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Worsley’s canal banks still showcase original aqueducts and underground tunnels, engineering marvels that survive to this day.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://secretmanchester.com/worsley-salford-greater-manchester-birthplace-of-transport-revolution/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Over 40 buildings in Worsley are listed, including the historic Delph sluice gates and mock Tudor houses that line the village green.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://secretmanchester.com/worsley-salford-greater-manchester-birthplace-of-transport-revolution/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The village green is bordered by charming bridges that offer a picturesque backdrop for leisurely strolls, especially in autumn and winter.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://secretmanchester.com/worsley-salford-greater-manchester-birthplace-of-transport-revolution/",
      "category": "culture",
      "quality": "poor",
      "qualityReason": "editorial_filler"
    },
    {
      "id": 6,
      "text": "Worsley is a hidden gem within Greater Manchester, tucked away in leafy Salford yet steeped in Tudor architecture and woodland walks.",
      "sourceSentenceIds": [
