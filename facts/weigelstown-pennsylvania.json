  "facts": [
    {
      "id": 1,
      "text": "Weigelstown, Pennsylvania, takes its name from the Weigel family, who settled the area in the early 19th century.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.wisdomlib.org/cities/weigelstown-29603",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Historic Hanna's Town, founded in 1773, sits just outside Weigelstown and houses a reconstructed tavern, log houses, and a Revolutionary War fort.",
      "sourceSentenceIds": [
        17
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://westmorelandhistory.org/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The Westmoreland Historical Society, headquartered in Hanna's Town, runs the Westmoreland History Education Center near Weigelstown.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://westmorelandhistory.org/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "During winter, the Society’s Exhibit Gallery, Research Library, and Museum Shop remain open, offering year‑round history exploration.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://westmorelandhistory.org/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Penny River, operated by Jessica Young, crafts authentic 18th‑century costumes that have appeared in shows like Outlander and Bridgerton.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://westmorelandhistory.org/",
      "category": "people",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Weigelstown lies in South Central Pennsylvania, an area celebrated for its rich agricultural traditions and historic farm life.",
      "sourceSentenceIds": [
        8
      ],
