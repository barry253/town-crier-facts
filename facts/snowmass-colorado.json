      "id": 1,
      "text": "Snowmass Village got its name from the nearby Snowmass Valley, chosen to replace the less appealing Brush Creek for the new ski resort.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Snowmass_Village%2C_Colorado",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Bill Janss and DRC Brown turned the American Cement Company into the developers of Snowmass Village, launching the ski resort in 1966.",
      "sourceSentenceIds": [
        18
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Snowmass_Village%2C_Colorado",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The Anderson Ranch Arts Center, born from the Hoaglund Ranch, now sits on Owl Creek Road using historic buildings relocated from the original site.",
      "sourceSentenceIds": [
        1,
        16,
        17
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Snowmass_Village%2C_Colorado",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "A bulldozer in 2010 uncovered Pleistocene fossils at Ziegler Reservoir, putting Snowmass Village on North America's paleontological map.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Snowmass_Village%2C_Colorado",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Olympic medalist Stein Eriksen was hired to lead the ski school, adding European flair to the fledgling resort.",
