  "facts": [
    {
      "id": 1,
      "text": "George, Washington, takes its name from the first U.S. president and is the only city in the nation that carries a president’s full name.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.cityofgeorge.org/about/"
    },
    {
      "id": 2,
      "text": "The town was founded in the 1950s to meet the growing need for communities in Grant County’s large irrigation district.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.cityofgeorge.org/about/"
    },
    {
      "id": 3,
      "text": "Local pharmacist Charlie Brown submitted the winning bid for 339 acres, leading to the town’s official naming as George.",
      "sourceSentenceIds": [
        24
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.cityofgeorge.org/about/"
    },
    {
      "id": 4,
      "text": "George sits within Grant County, a region known for its extensive irrigation projects that shaped the town’s early development.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.cityofgeorge.org/about/"
    },
    {
      "id": 5,
      "text": "The town’s establishment was part of a broader effort to support agricultural growth in the high desert of central Washington.",
