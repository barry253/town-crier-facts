  "facts": [
    {
      "id": 1,
      "text": "North Windham is located between Sebago Lake's Jordan Bay to the west and Little Sebago Lake to the east.",
      "sourceSentenceIds": [
        17
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/North_Windham%2C_Maine"
    },
    {
      "id": 2,
      "text": "The area of North Windham was originally inhabited by the Rockameecooks, a subgroup of the Abenaki people's Sokokis tribe.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/north_windham_maine"
    },
    {
      "id": 3,
      "text": "European settlers first arrived in North Windham during the 18th century, after early English exploration began in the 1600s.",
      "sourceSentenceIds": [
        8,
        9
      ],
      "sourceLabels": [
        "Web source 1",
        "Web source 2"
      ],
      "source": "https://winslowmaine.org/a-tale-of-tranquility-exploring-the-unspoiled-charms-of-north-windham-maine"
    },
    {
      "id": 4,
      "text": "North Windham grew rapidly during the Industrial Revolution as several mills and factories were established along the riverbanks.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://winslowmaine.org/a-tale-of-tranquility-exploring-the-unspoiled-charms-of-north-windham-maine"
    },
    {
      "id": 5,
      "text": "The Windham Historical Society operates out of the town's original schoolhouse to showcase local history and artifacts.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://winslowmaine.org/a-tale-of-tranquility-exploring-the-unspoiled-charms-of-north-windham-maine"
    },
    {
      "id": 6,
      "text": "Local ordinances in North Windham provide archaeological protections for prehistoric and historic sites during new land development.",
      "sourceSentenceIds": [
