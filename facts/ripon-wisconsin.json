  "facts": [
    {
      "id": 1,
      "text": "Ripon was founded in 1849 by David P. Mapes, a former New York steamboat captain who platted the village and built its first hotel.",
      "sourceSentenceIds": [
        4,
        18,
        11
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Ripon%2C_Wisconsin",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The city’s name comes from Ripon, North Yorkshire, England, the ancestral home of its founder, David P. Mapes.",
      "sourceSentenceIds": [
        5,
        7
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Ripon%2C_Wisconsin",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Ripon is famously known as the birthplace of the Republican Party, where a 1854 meeting at a local schoolhouse sparked the movement.",
      "sourceSentenceIds": [
        21,
        24,
        22
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Ripon%2C_Wisconsin",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Ripon College, originally Brockway College, was incorporated in 1851 by founder David P. Mapes and remains a key part of the town’s heritage.",
      "sourceSentenceIds": [
        9,
        18
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Ripon%2C_Wisconsin",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The neoclassical Ripon Public Library, funded by a Carnegie grant, opened in 1905 and served the community until a new building was completed in 1973.",
      "sourceSentenceIds": [
        13,
        14
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://riponhistory.org/city-of-ripon/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Ripon’s well‑preserved architecture and deep‑rooted heritage earned it a spot on Budget Travel Magazine’s list of America’s coolest small towns.",
      "sourceSentenceIds": [
        8
      ],
