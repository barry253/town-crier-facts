    },
    {
      "id": 2,
      "text": "Cabot Yerxa, a pioneer who arrived in 1913, built a Pueblo‑style home that now houses the Cabot’s Pueblo Museum.",
      "sourceSentenceIds": [
        9,
        10
      ],
      "sourceLabels": [
