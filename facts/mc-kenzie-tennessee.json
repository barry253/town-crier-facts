  "facts": [
    {
      "id": 1,
      "text": "McKenzie grew around the 1865 crossing of the Nashville & Northwestern and Louisville & Memphis railroads, earning its nickname \"Railroad City\".",
      "sourceSentenceIds": [
        1,
        2,
        16,
        22
      ],
      "sourceLabels": [
        "Web source 1",
        "Wikipedia",
        "Web source 2"
      ],
      "source": "https://mckenzietn.org/residents/community-resources/tourism/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The historic Gordon Browning Museum, housed in the former post office, preserves Carroll County records and honors Tennessee’s two‑term governor.",
      "sourceSentenceIds": [
        3,
        7,
        13
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://mckenzietn.org/residents/community-resources/tourism/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "In 1887 President Grover Cleveland stayed overnight at the McKenzie Hotel beside the depot, a rare presidential visit to a small Tennessee town.",
      "sourceSentenceIds": [
        27
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/McKenzie%2C_Tennessee",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The Park Theatre, built in the 1940s, still hosts local plays and movies, keeping McKenzie's mid‑century entertainment tradition alive.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/McKenzie%2C_Tennessee",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The Webb School Alumni Museum, opened 2016 in a former all‑African‑American school, showcases the history of a Rosenwald school that served 22 communities.",
