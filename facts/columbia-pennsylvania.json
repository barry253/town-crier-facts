    },
    {
      "id": 2,
      "text": "The Philadelphia and Columbia Railroad opened in October 1834, making Columbia one of the first commercial railways in the United States.",
      "sourceSentenceIds": [
        2,
        15
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Columbia%2C_Pennsylvania"
    },
    {
      "id": 3,
      "text": "Columbia sits along the Susquehanna River, and its historic downtown is a true site to see for its rich history.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 2"
      ],
