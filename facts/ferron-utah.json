  "facts": [
    {
      "id": 1,
      "text": "Ferron takes its name from surveyor Augustus D. Ferron, who agreed to a playful “dunking” in the creek that later became Ferron Creek.",
      "sourceSentenceIds": [
        14,
        15,
        16
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Ferron%2C_Utah",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Three Mormon families answered a church call in 1877, arriving in Castle Valley after 21 days and settling in what would become Ferron.",
      "sourceSentenceIds": [
        3,
        10,
        11
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Ferron%2C_Utah",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Since its founding, Ferron has relied on farming and stockraising, a tradition that still defines its rural economy.",
      "sourceSentenceIds": [
        6,
        8
      ],
      "sourceLabels": [
        "Web source 1",
        "Web source 2"
      ],
      "source": "https://www.uen.org/utah_history_encyclopedia/f/FERRON.shtml",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "In 1900, the Ferron precinct—town plus surrounding farms—boasted 660 residents, reflecting early growth.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://onlineutah.us/ferronhistory_02.shtml",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Ferron sits in western Emery County along Utah State Route 10, just 11 miles northeast of Castle Dale and 14 miles southwest of Emery.",
      "sourceSentenceIds": [
        17
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Ferron%2C_Utah",
      "category": "other",
      "quality": "poor",
      "qualityReason": "route_only"
    },
    {
      "id": 6,
      "text": "Early settlers first built dugouts beside the creek before turning to agriculture, laying the groundwork for Ferron's enduring farming heritage.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
