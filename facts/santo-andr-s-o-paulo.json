    },
    {
      "id": 2,
      "text": "In 1938 the municipality of São Bernardo moved its headquarters near Santo André’s train station, sparking the town’s rebirth.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Santo_Andr%C3%A9%2C_S%C3%A3o_Paulo"
    },
    {
      "id": 3,
      "text": "The 1930s saw rapid growth as factories for chemicals, textiles, and metallurgy sprang up across the city.",
      "sourceSentenceIds": [
        13,
        14
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Santo_Andr%C3%A9%2C_S%C3%A3o_Paulo"
    },
    {
      "id": 4,
      "text": "Santo André became the seat of its Roman Catholic Diocese in 1954, marking a key religious milestone.",
      "sourceSentenceIds": [
        15
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Santo_Andr%C3%A9%2C_S%C3%A3o_Paulo"
    },
    {
      "id": 5,
      "text": "The local football club, Esporte Clube Santo André, captured the Brazilian National Cup in 2004, beating Flamengo at Maracanã.",
      "sourceSentenceIds": [
        18,
        20
      ],
      "sourceLabels": [
