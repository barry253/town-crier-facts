      "id": 1,
      "text": "Faunsdale takes its name from the 1843 plantation founded by Harrison, itself named after the Roman god Faunus.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Web source 2"
      ],
