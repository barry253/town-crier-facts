  "facts": [
    {
      "id": 1,
      "text": "Dellwood was developed in the 1920s as a summer resort community by Chicago builder Simon P. Linehan.",
      "sourceSentenceIds": [
        4,
        20
      ],
      "sourceLabels": [
        "Web source 2",
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/dellwood_adams_county_wisconsin"
    },
    {
      "id": 2,
      "text": "The area now known as Dellwood was part of the traditional territory of the Ho-Chunk Nation.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/dellwood_adams_county_wisconsin"
    },
    {
      "id": 3,
      "text": "Famous bands from Chicago and Milwaukee once came to play in the Dellwood resort community.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://adamshistory.com/?page_id=1351"
    },
    {
      "id": 4,
      "text": "The original George Nemitz farmhouse in Dellwood became the Community House for the free use of all residents.",
      "sourceSentenceIds": [
        22,
        23
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://adamshistory.com/?page_id=1351"
    },
    {
      "id": 5,
      "text": "Dellwood is described as the phoenix of Adams County because it collapsed during the Depression and later prospered again.",
      "sourceSentenceIds": [
        18,
        19
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://adamshistory.com/?page_id=1351"
    },
    {
      "id": 6,
      "text": "Modern Dellwood serves as a recreational and retirement community featuring original cabins and the renovated Dellwood Pavilion.",
      "sourceSentenceIds": [
        11
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/dellwood_adams_county_wisconsin"
