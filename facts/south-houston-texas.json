      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Early South Houston farmers shipped strawberries, figs and other truck‑farm produce on the Galveston, Houston and Henderson Railroad.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
