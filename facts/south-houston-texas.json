      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "In 1913 Dumont was incorporated as the city of South Houston, keeping its territory outside Houston’s city limits.",
      "sourceSentenceIds": [
        29,
        30
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
