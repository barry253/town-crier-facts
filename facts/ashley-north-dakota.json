    },
    {
      "id": 2,
      "text": "Ashley’s courthouse mirrors the 1914 Mountrail County Courthouse in Stanley, sharing the same architects and builders.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.ashley-nd.com/tourism/"
    },
    {
      "id": 3,
      "text": "The Ashley Jewish Homesteaders Cemetery, added to the National Register in 2015, houses graves of early settlers.",
      "sourceSentenceIds": [
