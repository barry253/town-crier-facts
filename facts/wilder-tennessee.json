  "facts": [
    {
      "id": 1,
      "text": "Wilder was founded in 1902 as a planned company town by the Fentress Coal and Coke Company, named after its owner John T.",
      "sourceSentenceIds": [
        1,
        2,
        3,
        28,
        30
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Wilder%2C_Tennessee",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town’s first coal mine opened in 1902, and a school was established by 1903, with high school classes added in 1923.",
      "sourceSentenceIds": [
        12,
        13,
        15
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Wilder%2C_Tennessee",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Boyer's Chapel, the town church, was built in 1922, becoming a local landmark.",
      "sourceSentenceIds": [
        14
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Wilder%2C_Tennessee",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Wilder hosted a violent coal‑miners strike from July 1932 to April 1933, a pivotal moment in Tennessee labor history.",
      "sourceSentenceIds": [
        16
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Wilder%2C_Tennessee",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The strike’s climax involved the killing of UMW leader Barney Graham in front of the company store on April 30, 1933.",
      "sourceSentenceIds": [
        17
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Wilder%2C_Tennessee",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Wilder’s coal seam still holds tens of millions of tons of recoverable coal, though the mine never recovered from the strike.",
      "sourceSentenceIds": [
        20
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
