  "facts": [
    {
      "id": 1,
      "text": "Venetia sits in Peters Township, part of the Pittsburgh metropolitan area, and is known for its historic Peters Creek district.",
      "sourceSentenceIds": [
        12,
        13,
        14
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Venetia%2C_Pennsylvania",
      "category": "other",
      "quality": "poor",
      "qualityReason": "location_description"
    },
    {
      "id": 2,
      "text": "The Peters Creek Historical Society, founded in 1999, preserves Venetia’s heritage through research, education, and advocacy.",
      "sourceSentenceIds": [
        1,
        2
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://museumsdatabase.com/museums/view/27648",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Its museum, located on the grounds of Venetia Presbyterian Church, displays artifacts, photographs, and documents that trace the area’s past.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://museumsdatabase.com/museums/view/27648",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The society protects the Peters Creek Historic District, a National Register site with homes dating back to the early 19th century.",
      "sourceSentenceIds": [
        14,
        15
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://museumsdatabase.com/museums/view/27648",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Venetia’s historic 1816 Wright House and 1780 log house now serve as a museum showing life in the 1700s and 1800s.",
      "sourceSentenceIds": [
        19
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.wccf.net/charities/peters-creek-historical-society",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Annual events like the Old‑Fashioned Christmas celebration and the Soup n’ Stroll fundraiser bring the community together each year.",
