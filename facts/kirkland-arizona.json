  "facts": [
    {
      "id": 1,
      "text": "Kirkland was named after early settler William H. Kirkland, who arrived in 1863 and planted the first barley crop in Yavapai County.",
      "sourceSentenceIds": [
        3,
        18,
        25
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/kirkland_arizona",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "In 1864, Kirkland built a fortified stage stop with portholes to defend against Apache raids, becoming a key stop for travelers.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/kirkland_arizona",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The historic Kirkland Store, founded in 1894, served as a mercantile, post office, and Wells Fargo office before becoming the Kirkland Bar and Steakhouse today.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/kirkland_arizona",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The Santa Fe, Prescott and Phoenix Railway reached Kirkland in 1894, adding a depot and stockyard that helped ship cattle from local ranches.",
      "sourceSentenceIds": [
        11
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/kirkland_arizona",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Kirkland Creek, flowing from the Weaver Mountains, has been a vital water source for the valley and the site of early placer gold panning in the 1870s.",
      "sourceSentenceIds": [
        8,
        30
      ],
      "sourceLabels": [
        "Web source 1"
      ],
