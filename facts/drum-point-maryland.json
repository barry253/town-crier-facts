  "facts": [
    {
      "id": 1,
      "text": "Drum Point Lighthouse originally had a fourth‑order Fresnel lens whose red light could be seen eleven nautical miles away.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.lighthousefriends.com/light.asp?ID=432",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "A $25,000 congressional appropriation intended for two range lights was redirected to build a single screwpile lighthouse at Drum Point.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.lighthousefriends.com/light.asp?ID=432",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The lighthouse was first erected in ten feet of water, but shoreline silting has since reduced that depth.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.lighthousefriends.com/light.asp?ID=432",
      "category": "other",
      "quality": "poor",
      "qualityReason": "other"
    },
    {
      "id": 4,
      "text": "The station’s fog bell, weighing 1,400 pounds, was cast in 1880 by Baltimore’s McShane Bell Foundry.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.lighthousefriends.com/light.asp?ID=432",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "In the winter of 1895 an ice floe struck Drum Point Lighthouse, toppling chairs but leaving the structure unharmed.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.lighthousefriends.com/light.asp?ID=432",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Drum Point began as a summer retreat in the late 1940s and now hosts about 982 year‑round homes.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 2"
      ],
