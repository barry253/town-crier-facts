  "facts": [
    {
      "id": 1,
      "text": "Hillsboro Beach takes its name from the Earl of Hillsborough, a British land grant holder during Florida’s East Florida era.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Hillsboro_Beach%2C_Florida",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town’s southern boundary is punctuated by the historic Hillsboro Lighthouse, a landmark that has guided mariners since 1907.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.townofhillsborobeach.com/252/About-Hillsboro-Beach",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Hillsboro Beach officially became a municipality on June 12, 1939, but it wasn't until 1947 that it was fully incorporated by Florida law.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Hillsboro_Beach%2C_Florida",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The 3.2-mile stretch of State Road A1A, known locally as the Hillsboro Mile, is the town’s only main road and a favorite for sunset drives.",
      "sourceSentenceIds": [
        15
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Hillsboro_Beach%2C_Florida",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Hillsboro Beach enjoys a tropical savanna climate, with warm temperatures year-round and a brief, wet monsoon season.",
      "sourceSentenceIds": [
        22
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Hillsboro_Beach%2C_Florida",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Situated on Deerfield Beach Island, Hillsboro Beach sits at the southern tip of a narrow barrier island that separates the Atlantic Ocean from the Intracoastal Waterway.",
