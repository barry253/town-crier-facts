  "facts": [
    {
      "id": 1,
      "text": "Saint Cloud was founded on April 16, 1909 as a retirement community for Civil War Union veterans who paid $50 for five‑acre lots.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://osceolahistory.org/history-of-st-cloud/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The city earned the nickname “Friendly Soldier City” because its streets were named after the U.S. states where veterans had served.",
      "sourceSentenceIds": [
        13,
        14
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://osceolahistory.org/history-of-st-cloud/",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "In 1888 Disston opened the Sugar Belt Railway, linking Saint Cloud’s sugar mills to the South Florida Railroad and boosting the local economy.",
      "sourceSentenceIds": [
        18,
        19
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/St._Cloud%2C_Florida",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "On February 17, 1923, Saint Cloud dedicated the Veteran’s Memorial Library, a landmark that still serves the community today.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/St._Cloud%2C_Florida",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The city’s identity as a “Soldier City” is celebrated in local events that highlight its veteran heritage and community spirit.",
