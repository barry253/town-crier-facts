  "facts": [
    {
      "id": 1,
      "text": "La Harpe was platted in 1881 and founded by the Fort Scott, Wichita and Western Railroad company.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/La_Harpe%2C_Kansas"
    },
    {
      "id": 2,
      "text": "La Harpe takes its name from Bernard de la Harpe, a prominent French explorer of the southern Great Plains.",
      "sourceSentenceIds": [
        5,
        6
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 2"
      ],
      "source": "https://en.wikipedia.org/wiki/La_Harpe%2C_Kansas"
    },
    {
      "id": 3,
      "text": "The discovery of natural gas in 1899 helped La Harpe grow rapidly into a city of importance.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/La_Harpe%2C_Kansas"
    },
    {
      "id": 4,
      "text": "By 1910, La Harpe featured an opera house and some of the largest zinc smelters in the world.",
      "sourceSentenceIds": [
        23
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/La_Harpe%2C_Kansas"
    },
    {
      "id": 5,
      "text": "The La Harpe post office opened in November 1881 and was authorized to issue international money orders.",
      "sourceSentenceIds": [
