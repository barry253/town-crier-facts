  "facts": [
    {
      "id": 1,
      "text": "Churchtown’s Bangor Episcopal Church, founded in 1722, is one of the earliest Church of England congregations in colonial America.",
      "sourceSentenceIds": [
        1,
        5
      ],
      "sourceLabels": [
        "Web source 1",
        "Wikipedia"
      ],
      "source": "https://www.lancastercountymag.com/churchtown/"
    },
    {
      "id": 2,
      "text": "The church’s nave proudly displays a Welsh flag, honoring the Welsh pioneers who first settled the valley.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.lancastercountymag.com/churchtown/"
    },
    {
      "id": 3,
      "text": "Churchtown sits on a ridge that drains south to the Conestoga River, a tributary of the Susquehanna.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Churchtown%2C_Pennsylvania"
    },
    {
      "id": 4,
      "text": "The oldest Amish settlement still existing, Lancaster Amish, began near Churchtown in the 18th century.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Churchtown%2C_Pennsylvania"
    },
    {
      "id": 5,
      "text": "Churchtown’s Main Street is Pennsylvania Route 23, stretching 4 miles east to Morgantown and 20 miles west to Lancaster.",
      "sourceSentenceIds": [
        11
