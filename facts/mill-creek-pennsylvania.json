  "facts": [
    {
      "id": 1,
      "text": "Mill Creek borough takes its name from the creek that joins the Juniata River right beside the town.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Mill_Creek%2C_Pennsylvania"
    },
    {
      "id": 2,
      "text": "In the 1700s and 1800s the creek’s water powered dozens of mills that fueled the settlement’s early economy.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Mill_Creek%2C_Pennsylvania"
    },
    {
      "id": 3,
      "text": "Although settlers arrived in the 1770s, Mill Creek was officially founded in 1848.",
      "sourceSentenceIds": [
        4,
        22
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://millcreekpa.neocities.org/"
    },
    {
      "id": 4,
      "text": "Route 22 cuts through Mill Creek, linking the borough northwest to Huntingdon and southeast to Mount Union.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Mill_Creek%2C_Pennsylvania"
    },
    {
      "id": 5,
      "text": "The borough sits on the northeastern side of the Juniata River where Mill Creek merges into it.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Mill_Creek%2C_Pennsylvania"
    },
    {
      "id": 6,
      "text": "The first families—Eaton, Loudenslager, Pridmore, and Vandevender—settled the area around early 1770.",
