  "facts": [
    {
      "id": 1,
      "text": "Founded March 1 1814 on Connecticut Western Reserve land, Wadsworth was the southernmost point of that vast Connecticut claim.",
      "sourceSentenceIds": [
        2,
        3
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Wadsworth%2C_Ohio",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town’s name honors Revolutionary War hero General Elijah Wadsworth, who owned the largest share of the land that became Medina County.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Wadsworth%2C_Ohio",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Pinball lovers will recognize the Grizzly Arcade, a retro gaming spot on Broad Street that has been a local favorite for decades.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.visitmedinacounty.com/plan-your-visit/visit-wadsworth-ohio-things-to-do/",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The Wadsworth Public Library, established in the early 20th century, still serves the community with a collection that reflects the town’s rich history.",
      "sourceSentenceIds": [
        14
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Wadsworth%2C_Ohio",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "A post office has operated in Wadsworth since 1823, making it one of the oldest continuously running postal facilities in the county.",
