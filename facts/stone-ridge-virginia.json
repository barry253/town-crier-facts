    {
      "id": 3,
      "text": "Stone Ridge sits just south of U.S. Route 50, a major corridor that links the town to nearby Loudoun County centers.",
      "sourceSentenceIds": [
        18
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Stone_Ridge%2C_Virginia"
    },
    {
      "id": 4,
      "text": "Water from the south side of Stone Ridge flows through Foley Branch toward Bull Run, eventually joining the Occoquan River.",
      "sourceSentenceIds": [
        22
