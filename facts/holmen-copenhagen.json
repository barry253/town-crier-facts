  "facts": [
    {
      "id": 1,
      "text": "Holmen was born in the 1680s when Copenhagen ran out of harbour space at Slotsholmen.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://thedanishdream.com/holmen-where-denmarks-naval-prowess-meets-cultural-renaissance/"
    },
    {
      "id": 2,
      "text": "The area was reclaimed and annexed to Langeø, which at this stage was renamed Frederiksholm.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Holmen%2C_Copenhagen"
    },
    {
      "id": 3,
      "text": "Holmen now hosts Denmark’s largest creative cluster, with the Design School, Architecture School, Rhythmic Music Conservatory, Film School and Theatre & Contemporary Dance School.",
      "sourceSentenceIds": [
        11
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Holmen%2C_Copenhagen"
    },
    {
      "id": 4,
      "text": "The former naval base, now Marinestation København, is confined to Nyholm, home of the Royal Danish Naval Academy.",
      "sourceSentenceIds": [
        15
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Holmen%2C_Copenhagen"
    },
    {
      "id": 5,
      "text": "Holmen’s original plan was to house Navy barracks, but the idea was abandoned.",
