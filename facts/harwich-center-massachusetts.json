  "facts": [
    {
      "id": 1,
      "text": "Harwich Center sits at the crossroads of Massachusetts Route 39 and Route 124, the village’s historic heart.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Harwich_Center%2C_Massachusetts"
    },
    {
      "id": 2,
      "text": "On Main Street’s western edge, the Brooks Academy Museum houses the Harwich Historical Society’s archives.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://harwichhistorical.org/history-of-harwich/"
    },
    {
      "id": 3,
      "text": "Harwich was incorporated in 1694, originally encompassing what is now Brewster before it split in 1803.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://harwichhistorical.org/history-of-harwich/"
    },
    {
      "id": 4,
      "text": "The Brooks family, once known as Broadbrooks, officially shortened their name by Massachusetts law.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://harwichhistorical.org/history-of-harwich/"
    },
    {
      "id": 5,
      "text": "After the Civil War, South Harwich gained a railroad spur that linked it to Chatham and the Cape’s main line.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://harwichhistorical.org/history-of-harwich/"
    },
    {
      "id": 6,
      "text": "Harwich Center’s coordinates place it at 41°41′18″N 70°4′19″W, right in the heart of Cape Cod.",
      "sourceSentenceIds": [
        8
