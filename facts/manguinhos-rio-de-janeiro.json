  "facts": [
    {
      "id": 1,
      "text": "Manguinhos is home to the Oswaldo Cruz Foundation, founded in 1900 on former municipal farmlands to produce vaccines against the bubonic plague.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://whc.unesco.org/en/tentativelists/6712/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The foundation’s campus features the Moorish Pavilion, a 20th‑century building that mixes Moorish, English, and French architectural styles.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://link.springer.com/chapter/10.1007/978-3-031-39450-8_65",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "In 1980, Brazil’s National Historic and Artistic Heritage Institute listed the Moorish Pavilion and its complex as protected heritage sites.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://link.springer.com/chapter/10.1007/978-3-031-39450-8_65",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The institute began as the Federal Serum Therapy Institute, later becoming Instituto Soroterápico Federal and then Instituto de Patologia Experimental de Manguinhos.",
      "sourceSentenceIds": [
        25,
        26,
        27
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://whc.unesco.org/en/tentativelists/6712/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Manguinhos sits between a railway line and Guanabara Bay, giving the original institute easy access by land and sea.",
      "sourceSentenceIds": [
        23
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://whc.unesco.org/en/tentativelists/6712/",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Located in Rio’s North Zone, Manguinhos is renowned for its pivotal role in Brazil’s public health history and scientific research.",
      "sourceSentenceIds": [
        14
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Manguinhos%2C_Rio_de_Janeiro",
      "category": "culture",
      "quality": "good"
    }
  ],
