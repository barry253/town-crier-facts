  "facts": [
    {
      "id": 1,
      "text": "Fort Dix began as Camp Dix on July 16, 1917, named for Major General John Adams Dix, a War of 1812 and Civil War veteran.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Fort_Dix",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The 78th Infantry Division, known as the Lightning Division, honed its tactics at Camp Dix during World War I, named in honor of Major General John A. Dix.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Fort_Dix",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The Dix‑McGuire‑Lakehurst Museum, located on Joint Base McGuire‑Dix‑Lakehurst, showcases the intertwined histories of Fort Dix, McGuire Air Force Base, and Lakehurst.",
      "sourceSentenceIds": [
        15
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.wonderfulmuseums.com/museum/fort-dix-museum/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Between 2015 and 2016, Colonel Shelley Balderson became the first female commander of Fort Dix, marking a milestone in its century-long history.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Fort_Dix",
      "category": "people",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Joint Base McGuire‑Dix‑Lakehurst, formed in 2009, unites Army, Air Force, and Navy installations, creating one of the largest military bases in the U.S.",
      "sourceSentenceIds": [
        22
