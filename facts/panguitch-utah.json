  "facts": [
    {
      "id": 1,
      "text": "Panguitch’s name comes from a Southern Paiute word meaning “Big Fish,” a nod to the rainbow trout that thrive in nearby lakes.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Panguitch%2C_Utah"
    },
    {
      "id": 2,
      "text": "The town was first settled in March 1864 when Jens Nielsen led 54 families from Parowan and Beaver to the Sevier River.",
      "sourceSentenceIds": [
        25
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Panguitch%2C_Utah"
    },
    {
      "id": 3,
      "text": "During a brutal snowstorm in 1865, settlers abandoned their wagons and trekked over quilted snow, a daring move that earned the legend of the “quilt walk.”.",
      "sourceSentenceIds": [
        3,
        4,
        6
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Panguitch%2C_Utah"
    },
    {
      "id": 4,
      "text": "Each year, Panguitch celebrates that legend with a three‑day Quilt Walk Festival that draws visitors to the historic trail.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.visitutah.com/places-to-go/cities-and-towns/panguitch"
    },
    {
      "id": 5,
      "text": "Panguitch sits at 6,600 feet on the western edge of Garfield County, nestled in the Sevier River valley.",
      "sourceSentenceIds": [
        14,
        16
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Panguitch%2C_Utah"
    },
    {
      "id": 6,
      "text": "Route 89 cuts through Panguitch, connecting the town north to Junction and south to Orderville.",
