  "facts": [
    {
      "id": 1,
      "text": "Bagley is a small village in Grant County, situated along the Mississippi River near the confluence with the Wisconsin River.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/bagley_wisconsin"
    },
    {
      "id": 2,
      "text": "The village was named for Alfred and Mary Bagley, Vermont natives who owned the land in the mid-nineteenth century.",
      "sourceSentenceIds": [
        3,
        8
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 2"
      ],
      "source": "https://en.wikipedia.org/wiki/Bagley%2C_Wisconsin"
    },
    {
      "id": 3,
      "text": "The Saint Paul Land Company purchased the land from Mary Bagley in 1884 to plat the village.",
      "sourceSentenceIds": [
        4,
        15
      ],
      "sourceLabels": [
        "Web source 2",
        "Wikipedia"
      ],
      "source": "https://grokipedia.com/page/bagley_wisconsin"
    },
    {
      "id": 4,
      "text": "The arrival of the Chicago, Burlington and Quincy Railroad in 1884 brought a depot that helped the community grow.",
      "sourceSentenceIds": [
        2,
        7,
        9
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 2"
      ],
      "source": "https://en.wikipedia.org/wiki/Bagley%2C_Wisconsin"
    },
    {
      "id": 5,
      "text": "William Thiessa opened the first hotel in Bagley on January 1, 1885, using lumber hauled across the frozen Mississippi River.",
      "sourceSentenceIds": [
        7,
        10
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/bagley_wisconsin"
    },
    {
      "id": 6,
      "text": "Early pioneers in Bagley established a foundational economy based on mixed farming and river-based trade.",
