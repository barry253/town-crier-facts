  "facts": [
    {
      "id": 1,
      "text": "The name Dromana is of Irish origin, said to stem from Irish gold prospectors arriving in the late 1830s.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.visitmorningtonpeninsula.org/Places-To-See/Towns-Villages/Dromana"
    },
    {
      "id": 2,
      "text": "Dromana sits south of Melbourne, nestled between Safety Beach, Rosebud and Red Hill on the Mornington Peninsula.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Dromana"
    },
    {
      "id": 3,
      "text": "Before European settlement, the Boonwurrung people called the area now known as Dromana Kangerrong in the 19th century.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Dromana"
    },
    {
      "id": 4,
      "text": "In 1841, Hugh Jamieson purchased 5,120 acres of land from the Crown for £1 an acre under the Special Survey regulations.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Dromana"
    },
    {
      "id": 5,
      "text": "The completion of Dromana's pier in 1872 opened a shipping route for produce to Melbourne markets.",
      "sourceSentenceIds": [
        15
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Dromana"
    },
    {
      "id": 6,
      "text": "Dromana was officially proclaimed a town in February 1861, marking its emergence as a seaside resort.",
      "sourceSentenceIds": [
        17
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Dromana"
    }
  ]
