      "source": "https://en.wikipedia.org/wiki/Elizabethtown%2C_Ohio"
    },
    {
      "id": 2,
      "text": "The Logsdon Downtown Elizabethtown Historic Walking Tour began in 1988 and is now in its 37th season.",
      "sourceSentenceIds": [
        28
      ],
      "sourceLabels": [
        "Web source 1"
      ],
