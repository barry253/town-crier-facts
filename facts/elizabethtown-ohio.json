    },
    {
      "id": 3,
      "text": "Elizabethtown once served as a depot on the Cleveland, Cincinnati, Chicago and St. Louis Railroad.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Elizabethtown%2C_Ohio"
    },
    {
      "id": 4,
      "text": "The community sits in the valley of the Great Miami River, about 20 miles west of downtown Cincinnati.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Elizabethtown%2C_Ohio"
    },
    {
      "id": 5,
      "text": "Route 50 cuts through downtown Elizabethtown, while Interstate 275 skirts the northwest but offers no direct exit.",
