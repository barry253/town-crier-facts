  "facts": [
    {
      "id": 1,
      "text": "Gresham was named in honor of Walter Quinton Gresham, a Union Army general and judge who served as a U.S. statesman.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.wikixm.com/us/wi/gresham/overview"
    },
    {
      "id": 2,
      "text": "The arrival of the Wisconsin Central Railroad in the 1880s was the primary driver for the founding of Gresham.",
      "sourceSentenceIds": [
        15,
        16
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.wikixm.com/us/wi/gresham/overview"
    },
    {
      "id": 3,
      "text": "Early settlers of German, Scandinavian, and Irish descent moved to Gresham to find work in logging camps and sawmills.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.wikixm.com/us/wi/gresham/overview"
    },
    {
      "id": 4,
      "text": "Gresham serves as the headquarters for the Stockbridge-Munsee Community, a federally recognized band of Mohican Indians.",
      "sourceSentenceIds": [
        13
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.wikixm.com/us/wi/gresham/overview"
    },
    {
      "id": 5,
      "text": "The Gresham Historical Society is housed in a Tudor Revival building that once served as the town library starting in 1913.",
      "sourceSentenceIds": [
        2
