      "id": 1,
      "text": "Costa Mesa’s name, meaning “coastal tableland” in Spanish, was adopted in 1920 when Harper changed its name.",
      "sourceSentenceIds": [
        21,
        22
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
