      "id": 1,
      "text": "Glen Spey was founded in 1880 by George Ross Mackenzie, a Scottish‑born executive of Singer Sewing Machine Company, and named after his homeland.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
