  "facts": [
    {
      "id": 1,
      "text": "The Cayuse and Nez Perce Tribes called this area Wiweeletitpe, meaning many creeks flowing at that place.",
      "sourceSentenceIds": [
        14
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Cove%2C_Oregon"
    },
    {
      "id": 2,
      "text": "Samuel Cowles and his niece Fannie Pauline became the first permanent residents of Cove on the last day of 1861.",
      "sourceSentenceIds": [
        11
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://coveoregon.org/history/"
    },
    {
      "id": 3,
      "text": "Cove was originally called Forest Cove, but the name was shortened in 1868 to avoid confusion with Forest Grove.",
      "sourceSentenceIds": [
        4,
        10
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 2"
      ],
      "source": "https://en.wikipedia.org/wiki/Cove%2C_Oregon"
    },
    {
      "id": 4,
      "text": "Cove was platted in the 1870s along Ruckles Road, which was only the second road over the Blue Mountains.",
      "sourceSentenceIds": [
        16
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Cove%2C_Oregon"
    },
    {
      "id": 5,
      "text": "Cove is known as the land of the big prize cherries and the home of apple pies.",
      "sourceSentenceIds": [
        5,
        7
      ],
      "sourceLabels": [
        "Web source 1",
        "Web source 2"
      ],
      "source": "https://coveoregon.org/history/"
    },
    {
      "id": 6,
      "text": "The Episcopal Chapel and bishop’s residence in Cove are listed in the national registry of historic buildings.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://coveoregon.org/"
    }
  ]
