  "facts": [
    {
      "id": 1,
      "text": "Ingalls was settled during the historic Oklahoma Land Run of 1889 as a promising frontier settlement.",
      "sourceSentenceIds": [
        6,
        20
      ],
      "sourceLabels": [
        "Web source 1",
        "Wikipedia"
      ],
      "source": "https://unitedstatesghosttowns.com/ingalls-oklahoma-ghost-town/"
    },
    {
      "id": 2,
      "text": "The town was named for Senator John J. Ingalls of Kansas, who helped pass legislation to open the land run.",
      "sourceSentenceIds": [
        2,
        5,
        7,
        21
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Ingalls%2C_Oklahoma"
    },
    {
      "id": 3,
      "text": "Ingalls became known as the site of a famous 1893 shootout between U.S. Marshals and the Doolin-Dalton gang.",
      "sourceSentenceIds": [
        22,
        23
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Ingalls%2C_Oklahoma"
    },
    {
      "id": 4,
      "text": "Oil was discovered just east of Ingalls in 1920, which briefly breathed new life into the community.",
      "sourceSentenceIds": [
        24,
        25,
        28
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Ingalls%2C_Oklahoma"
    },
    {
      "id": 5,
      "text": "Failed railroad connections and declining oil production in the 1920s led to Ingalls becoming a ghost town.",
      "sourceSentenceIds": [
        11
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://unitedstatesghosttowns.com/ingalls-oklahoma-ghost-town/"
    },
    {
      "id": 6,
      "text": "The original sixteen-block layout of Ingalls remains visible today, though most of its buildings have been dismantled.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://unitedstatesghosttowns.com/ingalls-oklahoma-ghost-town/"
