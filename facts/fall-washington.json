  "facts": [
    {
      "id": 1,
      "text": "Fall City earned its name 'The Landing' because shallow water and rapids on the Snoqualmie River made it impassable to large dugout canoes.",
      "sourceSentenceIds": [
        9,
        25
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://facts.net/world/cities/35-facts-about-fall-city/",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The Prescott-Harshman House stands as one of Fall City's most preserved historic homes, reflecting 19th-century architecture.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://facts.net/world/cities/35-facts-about-fall-city/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "When the Seattle, Lake Shore and Eastern Railway reached the area in 1889, a mile‑away line and the first Snoqualmie River bridge spurred tourism and lumber growth.",
      "sourceSentenceIds": [
        6,
        18,
        30
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 2"
      ],
      "source": "https://en.wikipedia.org/wiki/Fall_City%2C_Washington",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Fall City sits where the Snoqualmie and Raging Rivers meet, a spot that sometimes floods in autumn and winter.",
      "sourceSentenceIds": [
        7,
        23
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Fall_City%2C_Washington",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Today, Fall City functions as a bedroom community for Seattle's high‑tech industry, yet its historic homes contrast with sprawling suburban estates.",
