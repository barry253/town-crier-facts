      "id": 1,
      "text": "Sour John takes its name from Levi Sourjohn, a Cherokee Nation citizen who owned land in the area.",
      "sourceSentenceIds": [
        1,
        25
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/sour_john_oklahoma"
    },
    {
      "id": 2,
      "text": "Greenleaf Lake, a reservoir on Greenleaf Creek, sits along the northwestern boundary of Sour John.",
      "sourceSentenceIds": [
        4,
        9
      ],
      "sourceLabels": [
        "Web source 1",
        "Wikipedia"
      ],
      "source": "https://grokipedia.com/page/sour_john_oklahoma"
    },
    {
      "id": 3,
      "text": "Levi Sourjohn sold part of his property to the government in 1933 to establish a local school.",
      "sourceSentenceIds": [
        23,
        26
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/sour_john_oklahoma"
    },
    {
      "id": 4,
      "text": "The one-room Sourjohn Indian School opened in 1934 to help local children who previously walked miles to class.",
      "sourceSentenceIds": [
        27,
        28
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/sour_john_oklahoma"
    },
    {
      "id": 5,
      "text": "Teachers at the Sourjohn Indian School banned Native languages like Cherokee and Creek inside the classroom.",
      "sourceSentenceIds": [
        30
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/sour_john_oklahoma"
    },
    {
      "id": 6,
      "text": "The original school building and teacher residence in Sour John now serve as a private home.",
