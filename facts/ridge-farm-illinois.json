  "facts": [
    {
      "id": 1,
      "text": "Ridge Farm was founded in 1839 by Abraham Smith, who moved his Tennessee farm to a glacial ridge and called it “Farm on the Ridge.”.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.ridgefarmillinois.com/about-us",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The village’s post office opened on May 17, 1841, marking the first federal service in the community.",
      "sourceSentenceIds": [
        20
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Ridge_Farm%2C_Illinois",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Railroads arrived in 1873‑74, spurring the growth of a flower mill, lumber yards, and a hardware store that helped shape Ridge Farm’s economy.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.ridgefarmillinois.com/about-us",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The historic Ridge Farm Gavel, used in 2024’s sesquicentennial celebrations, is a relic of the village’s early civic life.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.ridgefarmusa.com/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "A small Carnegie library, built on a tight budget, remains a cherished landmark where locals gather for books and community events.",
      "sourceSentenceIds": [
        17
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.ridgefarmusa.com/",
      "category": "other",
      "quality": "poor",
      "qualityReason": "editorial_filler"
    },
    {
      "id": 6,
      "text": "Ridge Farm’s name comes from the ridge of land that runs east to west through Elwood Township, a feature that guided its early settlement.",
