  "facts": [
    {
      "id": 1,
      "text": "Atlas Township was organized in 1836 as part of Lapeer County, one of the earliest settlements in the region.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Atlas_Township%2C_Michigan",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The first settler, Asa Farrar, built a log house on section 18 in September 1839, marking the township’s first permanent home.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Atlas_Township%2C_Michigan",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The first birth and marriage in the township occurred in Asa Farrar’s family in 1833 and 1834, the earliest recorded life events.",
      "sourceSentenceIds": [
        13
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Atlas_Township%2C_Michigan",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "In 1831, Norman Davison founded Davisonville on Kearsley Creek, the original name that later became Atlas.",
      "sourceSentenceIds": [
        14
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Atlas_Township%2C_Michigan",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Goodrich, the township’s central village, began in September 1835 when Moses and Enos Goodrich bought over a thousand acres and built a log cabin.",
      "sourceSentenceIds": [
        17
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Atlas_Township%2C_Michigan",
