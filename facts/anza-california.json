  "facts": [
    {
      "id": 1,
      "text": "Anza Valley was renamed on September 16, 1926, honoring explorer Juan Bautista de Anza, after the area was originally called Cahuilla Valley.",
      "sourceSentenceIds": [
        1,
        3
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Anza%2C_California",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The Juan Bautista de Anza Trail, first ridden by the explorer in 1774, now follows Anza from southeast to northwest and joins the Pacific Crest Trail.",
      "sourceSentenceIds": [
        6,
        7
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Anza%2C_California",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "For over 5,000 years, the Mountain Cahuilla people inhabited the Anza Valley, leaving archaeological traces that predate Spanish exploration.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/Anza,_California",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The Cary Ranch, still owned by descendants of the original settlers, sits on a 20‑acre parcel that once covered hundreds of acres.",
      "sourceSentenceIds": [
        12,
        19,
        20,
        21
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Anza%2C_California",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "At 4,000 feet, Anza’s weather swings from warm summer highs in the 90s to chilly winter nights that can drop into the 30s.",
