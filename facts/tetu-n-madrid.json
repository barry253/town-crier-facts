  "facts": [
    {
      "id": 1,
      "text": "Tetuán earned its name \"Tetuán de las Victorias\" after Moroccan soldiers returned from the 1859–60 African War, celebrating their triumph.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Tetu%C3%A1n%2C_Madrid",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Before Madrid’s expansion, Tetuán was part of Chamartín de la Rosa, a rural area of grazing woodlands and scattered farms.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/Tetu%C3%A1n,_Madrid",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "By the 1910s, speculative developers parceled former farmland into residential lots, drawing working‑class migrants to new factories north of Madrid.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/Tetu%C3%A1n,_Madrid",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The Spanish Civil War halted Tetuán’s growth, as Republican Madrid endured repeated Nationalist air raids that damaged its fledgling buildings.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/Tetu%C3%A1n,_Madrid",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "After the war, Franco’s 1941 urban plan spurred rapid rebuilding, expanding northward along Paseo de la Castellana to house Madrid’s growing workforce.",
      "sourceSentenceIds": [
        26
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/Tetu%C3%A1n,_Madrid",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Tetuán hosts Madrid’s oldest mosque, the Central Mosque, a key place of worship for the city’s Muslim community.",
      "sourceSentenceIds": [
        15
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
