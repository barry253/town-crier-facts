  "facts": [
    {
      "id": 1,
      "text": "Tetuán was renamed Tetuán de las Victorias after the Moroccan city Tetouan, where victorious soldiers returned from the African War.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Tetu%C3%A1n%2C_Madrid"
    },
    {
      "id": 2,
      "text": "The district began as a military camp for troops of the 1859–60 African War, later evolving into a working‑class neighborhood.",
      "sourceSentenceIds": [
        8,
        4
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 2"
      ],
      "source": "https://en.wikipedia.org/wiki/Tetu%C3%A1n%2C_Madrid"
    },
    {
      "id": 3,
      "text": "Madrid Central Mosque, the oldest mosque in the city, sits in Tetuán and reflects the area’s multicultural heritage.",
      "sourceSentenceIds": [
        13
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Tetu%C3%A1n%2C_Madrid"
    },
    {
      "id": 4,
      "text": "Tetuán’s streets are lined with Neo‑Mudéjar houses, a Spanish style that blends Moorish and Christian architectural elements.",
      "sourceSentenceIds": [
        10,
        25,
        27
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 2"
      ],
      "source": "https://en.wikipedia.org/wiki/Tetu%C3%A1n%2C_Madrid"
    },
    {
      "id": 5,
      "text": "The Tetuán Histórico walking route covers 14 stops over 5 km, guiding visitors through the district’s historical milestones.",
      "sourceSentenceIds": [
        18
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.madrid.es/portales/munimadrid/es/Inicio/El-Ayuntamiento/Tetuan/Actividades-y-eventos/Tetuan-historico/?vgnextoid=96f2b8ab4b8e5810VgnVCM1000001d4a900aRCRD&vgnextchannel=ae6948e063f28010VgnVCM100000dc0ca8c0RCRD"
    },
    {
      "id": 6,
      "text": "Along the current Bravo Murillo street, the former Chamartín de la Rosa district gave rise to Tetuán’s working‑class neighborhoods.",
      "sourceSentenceIds": [
        23
      ],
