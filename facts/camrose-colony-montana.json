  "facts": [
    {
      "id": 2,
      "text": "Founded in 2001 as a daughter colony of East End Hutterite Colony near Havre, Camrose Colony reflects the Lehrerleut tradition of common ownership.",
      "sourceSentenceIds": [
        2,
        4,
        29
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/camrose_colony_montana",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The colony’s pacifist stance, rooted in Anabaptist non‑resistance, means its members reject military service and political involvement.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/camrose_colony_montana",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Despite limiting TV and radio, Camrose Colony uses GPS‑guided tractors and computers to run its efficient farming operations.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/camrose_colony_montana",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Camrose Colony’s cattle ranching and aquaculture support traditional Hutterite practices while participating in Montana’s Block Management Area #210 for public hunting.",
      "sourceSentenceIds": [
        16
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/camrose_colony_montana",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Harsh winters and moderate summers in Camrose Colony shape local environmental dynamics and dictate its agricultural cycles.",
