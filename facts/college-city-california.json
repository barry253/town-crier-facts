      ],
      "source": "https://en.wikipedia.org/wiki/College_City%2C_California",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The town’s post office opened in 1873, just two years after the community was founded.",
      "sourceSentenceIds": [
