      "quality": "good"
    },
    {
      "id": 2,
      "text": "Phillipsburg was named for Civil War colonel William A. Phillips, while Phillips County honors another William Phillips, a Free‑State supporter murdered in 1856.",
      "sourceSentenceIds": [
        10,
        3
      ],
      "sourceLabels": [
