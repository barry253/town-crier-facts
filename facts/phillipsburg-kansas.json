      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "A branch of the Chicago, Kansas and Nebraska Railway ran through Phillipsburg starting in 1887, linking the town to regional trade.",
      "sourceSentenceIds": [
        16
