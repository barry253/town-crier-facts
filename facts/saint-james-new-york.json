  "facts": [
    {
      "id": 1,
      "text": "Saint James earned its name from the Episcopal church founded in the 1850s, which still stands on North Country Road.",
      "sourceSentenceIds": [
        24
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/St._James%2C_New_York",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The Saint James train station, the second‑oldest on the Long Island Rail Road, opened in the 19th century and still serves commuters.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/St._James%2C_New_York",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The hamlet’s oldest continuously operating general store, located on Moriches Road, dates back to the 1800s and is on the National Register.",
      "sourceSentenceIds": [
        21,
        22
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/St._James%2C_New_York",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Saint James was a summer retreat for Hollywood legends like Buster Keaton and Irving Berlin during the early 20th century.",
      "sourceSentenceIds": [
        19,
        20
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/St._James%2C_New_York",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "A Vietnam‑War memorial at the train station, erected by the American Legion, honors local servicemen and women.",
