  "facts": [
    {
      "id": 1,
      "text": "The Sautee‑Nacoochee Center was founded by the Sautee‑Nacoochee Community Association, which also secured both valleys’ placement on the National Register of Historic Places.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Sautee_Nacoochee%2C_Georgia",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "In 1986, Sautee Valley joined the National Register, and two years later the Center opened its first art exhibit and History Museum display.",
      "sourceSentenceIds": [
        13,
        14
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://sauteenacoocheecenter.org/history",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Today the 8.5‑acre Sautee‑Nacoochee Center hosts gallery shops, a renovated History Museum, an African American Heritage Site, and a 98‑seat theatre.",
      "sourceSentenceIds": [
        15
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://sauteenacoocheecenter.org/history",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "A state historical marker notes that Hernando de Soto visited the area in 1540.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Sautee_Nacoochee%2C_Georgia",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The town’s name blends Cherokee placenames; Sautee likely derives from “Itsati,” the ancient Cherokee capital, while Nacoochee’s origin remains unknown.",
      "sourceSentenceIds": [
        20,
        21,
        22
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Sautee_Nacoochee%2C_Georgia",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Legend says lovers Sautee and Nacoochee leapt from a mountain after elders forbade them, a tale echoed in Lookout Mountain’s Rock City.",
      "sourceSentenceIds": [
        26,
