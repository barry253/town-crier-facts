    },
    {
      "id": 2,
      "text": "The name Camuy derives from a Taíno word for “sun,” a meaning echoed in the town’s coat of arms.",
      "sourceSentenceIds": [
        11,
        22,
        24
      ],
      "sourceLabels": [
        "Web source 2",
        "Wikipedia"
