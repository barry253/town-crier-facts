      "id": 1,
      "text": "Optimist Park got its name from a former recreation area that once sat on the site of the neighborhood.",
      "sourceSentenceIds": [
        21
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.charlotteobserver.com/news/local/article307534096.html",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The neighborhood’s roots trace back to a blue‑collar community of factory workers and shopkeepers that helped Charlotte grow.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.charlotteobserver.com/news/local/article307534096.html",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "A historic textile mill, the former Highland Park Gingham Mill, now houses Optimist Hall, a community center for residents.",
      "sourceSentenceIds": [
        19
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.charlotteobserver.com/news/local/article307534096.html",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Old smokestacks and abandoned textile mills still line the streets, standing as silent witnesses to the area’s industrial past.",
      "sourceSentenceIds": [
        20
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.charlotteobserver.com/news/local/article307534096.html",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Artists painted a large mural on the parking deck of a big apartment building, turning the space into a local art landmark.",
      "sourceSentenceIds": [
        22
      ],
      "sourceLabels": [
        "Web source 2"
      ],
