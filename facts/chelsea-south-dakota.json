  "facts": [
    {
      "id": 1,
      "text": "Chelsea was founded in 1906 as a railroad town in Faulk County, emerging from a wheat field in the Great Plains.",
      "sourceSentenceIds": [
        1,
        4
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/chelsea_south_dakota"
    },
    {
      "id": 2,
      "text": "The town of Chelsea was named after Chelsea, London, perhaps via Chelsea, Massachusetts.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Chelsea%2C_South_Dakota"
    },
    {
      "id": 3,
      "text": "By 1909, Chelsea boasted around 30 businesses, including a bank, a weekly newspaper, and a two-story pool hall and saloon.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/chelsea_south_dakota"
    },
    {
      "id": 4,
      "text": "Sacred Heart Catholic Church was one of three churches founded in the initial years of Chelsea and continues to serve the community.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/chelsea_south_dakota"
    },
    {
      "id": 5,
      "text": "Early pioneers in Chelsea came from Europe and Midwestern states like Iowa and Missouri to farm wheat and raise livestock.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/chelsea_south_dakota"
    },
    {
      "id": 6,
      "text": "Chelsea is located within the fertile farmlands of northern South Dakota, covering a total area of zero point three square miles.",
