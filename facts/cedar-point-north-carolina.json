      ],
      "source": "https://en.wikipedia.org/wiki/Cedar_Point%2C_North_Carolina",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Cedar Point sits at the western edge of Carteret County, bordered by Peletier to the north and Cape Carteret to the east.",
      "sourceSentenceIds": [
        9,
        10
      ],
      "sourceLabels": [
