      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town’s early economy relied on small shops, farming, and fishing, keeping life tightly knit for generations.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
