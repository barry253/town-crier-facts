      ],
      "source": "https://cedarpointnc.gov/history",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "In 2024, developers unearthed an ancient Native American settlement, sparking controversy over preservation and new regulations.",
      "sourceSentenceIds": [
        8
      ],
