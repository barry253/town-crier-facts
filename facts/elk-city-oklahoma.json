  "facts": [
    {
      "id": 1,
      "text": "Elk City got its name from Elk Creek, named after elk tracks seen by explorer Marcy in 1852.",
      "sourceSentenceIds": [
        2,
        28,
        30
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Elk_City%2C_Oklahoma",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town was officially founded on March 20, 1901, when the first lots were sold by the Choctaw Townsite and Development Company.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Elk_City%2C_Oklahoma",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The Choctaw, Oklahoma and Gulf Railroad reached Elk City on August 13, 1901, laying the last rail of the “Choctaw Route.”.",
      "sourceSentenceIds": [
        11
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Elk_City%2C_Oklahoma",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Elk City sits on historic Route 66 and Interstate 40, roughly halfway between Amarillo and Oklahoma City.",
      "sourceSentenceIds": [
        19,
        21
      ],
      "sourceLabels": [
        "Web source 2",
        "Wikipedia"
      ],
      "source": "https://visitelkcity.com/",
