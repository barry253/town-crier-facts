      "category": "other",
      "quality": "poor",
      "qualityReason": "other"
    },
    {
      "id": 3,
      "text": "Palmyra’s name comes from settlers who originally came from Palmyra, New York.",
      "sourceSentenceIds": [
        22
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://genealogytrails.com/mich/lenawee/citypalmyra.html",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "A post office opened soon after settlement, yet the town never surpassed nearby locales with better advantages.",
      "sourceSentenceIds": [
        23
