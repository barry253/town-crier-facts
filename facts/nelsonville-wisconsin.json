  "facts": [
    {
      "id": 1,
      "text": "English immigrant Jerome Nelson founded Nelsonville around 1855 by building a dam and sawmill along the Tomorrow River.",
      "sourceSentenceIds": [
        6,
        12
      ],
      "sourceLabels": [
        "Web source 2",
        "Wikipedia"
      ],
      "source": "https://grokipedia.com/page/nelsonville_wisconsin"
    },
    {
      "id": 2,
      "text": "The Rising Star Mill was built in 1868 and remains a defining landmark of the local heritage in Nelsonville.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/nelsonville_wisconsin"
    },
    {
      "id": 3,
      "text": "Nelsonville established its own post office in 1871 and was named in honor of the community's founder and mill owner.",
      "sourceSentenceIds": [
        1,
        2
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 2"
      ],
      "source": "https://en.wikipedia.org/wiki/Nelsonville%2C_Wisconsin"
    },
    {
      "id": 4,
      "text": "Nelsonville incorporated as a village partly to outlaw saloons and stop livestock from pasturing on the village streets.",
      "sourceSentenceIds": [
        17,
        18
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Nelsonville%2C_Wisconsin"
    },
    {
      "id": 5,
      "text": "The Nelsonville Creamery and Cheese Association was founded in 1896 to process dairy products from surrounding farms.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/nelsonville_wisconsin"
    },
    {
      "id": 6,
      "text": "The Portage County Historical Society now operates the preserved mill in Nelsonville as a site for education and events.",
      "sourceSentenceIds": [
        5
