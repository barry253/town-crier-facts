  "facts": [
    {
      "id": 1,
      "text": "Reisterstown was founded March 2 1758 by German immigrant John Reister, who named his 20‑acre plot 'Reister's Desire' along Conewago Road.",
      "sourceSentenceIds": [
        1,
        30
      ],
      "sourceLabels": [
        "Web source 2",
        "Wikipedia"
      ],
      "source": "https://grokipedia.com/page/Reisterstown,_Maryland",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town grew into a key stopping place one day’s ride from Baltimore, positioned where MD 30 and MD 140 once formed the Great Road to Conewago.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/Reisterstown,_Maryland",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "In 1764 Reister bought a quarter‑acre called Church Hill and built the community’s first log church, later replaced by a brick school in 1824.",
      "sourceSentenceIds": [
        4,
        5
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Reisterstown%2C_Maryland",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Luke’s United Methodist Church, founded in 1880, remains Reisterstown’s oldest African‑American church and today hosts outreach programs.",
      "sourceSentenceIds": [
        6,
        13
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.reisterstown.com/heritage-trails/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The Heritage Trail invites drivers to walk through Reisterstown’s history, with markers that tell stories of homes, businesses, and paths that shaped the town.",
      "sourceSentenceIds": [
        9,
        10,
        11
      ],
