  "facts": [
    {
      "id": 1,
      "text": "Saint Joseph was settled by German Catholic immigrants in the early 1870s, who founded the town’s first community.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Saint_Joseph%2C_Tennessee",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The original St. Joseph Catholic Church, built by those settlers, still serves as the town’s parish church today.",
      "sourceSentenceIds": [
        5,
        6
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Saint_Joseph%2C_Tennessee",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The town sits on a broad ridge between the Shoal Creek Valley to the west and the Bluewater Creek Valley to the east.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Saint_Joseph%2C_Tennessee",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Little Bluewater Creek, a tributary of Bluewater Creek, winds right through the heart of Saint Joseph.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Saint_Joseph%2C_Tennessee",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Saint Joseph’s borders stretch southward to the Tennessee‑Alabama state line, marking the city’s southernmost edge.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
