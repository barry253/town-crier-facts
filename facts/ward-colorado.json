  "facts": [
    {
      "id": 1,
      "text": "Ward, Colorado sprang to life in 1860 when gold was struck at nearby Gold Hill, and the town was named for prospector Calvin Ward.",
      "sourceSentenceIds": [
        1,
        2,
        7
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 2"
      ],
      "source": "https://en.wikipedia.org/wiki/Ward%2C_Colorado",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The railroad arrived in Ward in 1898 over the Whiplash and Switzerland Trail, a 26‑mile climb that rose more than 4,000 feet from Boulder.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Ward%2C_Colorado",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "After a period of decline, Ward was revived in the 1930s, breathing new life into its historic streets.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.thirstcolorado.com/source/2025/10/13/weird-wild-ward",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The old Ward Schoolhouse now houses the town’s post office, town hall, and library, while the historic Ward Community Church remains a landmark.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.uncovercolorado.com/towns/ward/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Ward once boasted the richest mining camps in Colorado, earning a reputation as the state’s oldest and longest‑lasting gold‑mining town.",
      "sourceSentenceIds": [
        27
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.uncovercolorado.com/towns/ward/",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Just five miles west of Ward lies Brainard Lake Recreation Area, a popular summer destination for fishing, boating, and hiking.",
