  "facts": [
    {
      "id": 1,
      "text": "Guntersville was founded by John Gunter, Will Rogers’ great‑grandfather, in the early 19th century.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Guntersville%2C_Alabama"
    },
    {
      "id": 2,
      "text": "A town sprung up next to the mine and was named after Gunter.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Guntersville%2C_Alabama"
    },
    {
      "id": 3,
      "text": "With the influx of people who came to build the Tennessee Valley Authority Dam, located nine miles below Guntersville, the town saw a great change physically.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.lakeguntersville.org/profile-of-guntersville/history/"
    },
    {
      "id": 4,
      "text": "Guntersville is located at the southernmost point of the Tennessee River on Lake Guntersville, formed by the Guntersville Dam (built by the Tennessee Valley Authority).",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Guntersville%2C_Alabama"
    },
    {
      "id": 5,
      "text": "In 1892 the much sought‑after railroad arrived in Guntersville and with it came an era of growth on many fronts.",
      "sourceSentenceIds": [
        11
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.lakeguntersville.org/profile-of-guntersville/history/"
    },
    {
      "id": 6,
      "text": "The town of Guntersville puts on a festival every July to celebrate Will Rogers, involving many activities of interest to Rogers.",
