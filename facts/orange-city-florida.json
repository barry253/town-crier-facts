  "facts": [
    {
      "id": 1,
      "text": "Orange City was incorporated in 1882 and named for the orange groves that once covered the area.",
      "sourceSentenceIds": [
        2,
        5
      ],
      "sourceLabels": [
        "Web source 1",
        "Wikipedia"
      ],
      "source": "https://www.florida-backroads-travel.com/orange-city-florida.html"
    },
    {
      "id": 2,
      "text": "The Great Freeze of 1894‑1895 wiped out those groves, ending the town’s original citrus boom.",
      "sourceSentenceIds": [
        2,
        6
      ],
      "sourceLabels": [
        "Web source 1",
        "Wikipedia"
      ],
      "source": "https://www.florida-backroads-travel.com/orange-city-florida.html"
    },
    {
      "id": 3,
      "text": "The Dickinson Memorial Library, built in 1916, now houses the Orange City Historical Society museum and research library.",
      "sourceSentenceIds": [
        1,
        11,
        4
      ],
      "sourceLabels": [
        "Web source 1",
        "Web source 2"
      ],
      "source": "https://www.florida-backroads-travel.com/orange-city-florida.html"
    },
    {
      "id": 4,
      "text": "The 1876 Heritage Inn, a National Register site, sits in the historic district and is one of the town’s oldest buildings.",
      "sourceSentenceIds": [
        13,
        8
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.florida-backroads-travel.com/orange-city-florida.html"
    },
    {
      "id": 5,
      "text": "Orange City’s water earned a “highest award” at the 1904 Louisiana Purchase Exposition, a rare honor for a small town.",
      "sourceSentenceIds": [
        30
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Orange_City%2C_Florida"
    },
    {
      "id": 6,
      "text": "The town hosts annual walking tours and festivals hosted by the Historical Society, keeping its heritage alive each year.",
