      ],
      "source": "https://centercitysa.com/government-hill/",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Coffee shops, restaurants, historic landmarks, hiking routes, and parks line Government Hill’s streets, offering a blend of culture and outdoor adventure.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 1"
