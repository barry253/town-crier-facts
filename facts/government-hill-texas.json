      "category": "culture",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "State historical markers in Texas commemorate diverse topics, from military sites to influential individuals, many of which are found in the Government Hill area.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 2"
      ],
