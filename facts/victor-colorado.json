    {
      "id": 1,
      "text": "Victor earned its name from the Victor Mine, which may have been named for early settler Victor Adams.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Victor%2C_Colorado"
    },
    {
      "id": 2,
      "text": "Gold struck Victor in 1891 after Winfield Scott Stratton discovered nearby deposits, sparking a mining boom.",
      "sourceSentenceIds": [
        22
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Victor%2C_Colorado"
    },
    {
      "id": 3,
      "text": "Victor’s historic downtown still showcases original 1899 structures like the Victor Hotel and the Lowell Thomas Museum.",
      "sourceSentenceIds": [
        5,
        8
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Victor%2C_Colorado"
    },
    {
      "id": 4,
      "text": "The Gold Coin Mine, opened by the Woods brothers in 1894, remains one of Victor’s earliest gold‑mining sites.",
      "sourceSentenceIds": [
        29
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Victor%2C_Colorado"
    },
    {
      "id": 5,
      "text": "The Cripple Creek and Victor Narrow Gauge Railroad once linked Victor to the Gold Belt Tour National Scenic and Historic Byway.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Victor%2C_Colorado"
    },
    {
