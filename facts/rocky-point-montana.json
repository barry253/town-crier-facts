  "facts": [
    {
      "id": 1,
      "text": "Long before a trading post sign, Rocky Point was a natural crossing used by Indigenous nations for subsistence and passage.",
      "sourceSentenceIds": [
        21,
        22
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.bigskytreasure.org/history/places/rocky-point",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The white cliffs and shale reefs that give Rocky Point its name still frame a river that has carried travelers, buffalo, and steamboats for centuries.",
      "sourceSentenceIds": [
        19
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.bigskytreasure.org/history/places/rocky-point",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "During Montana’s gold fever in the 1860s, Rocky Point evolved from a ford into a bustling steamboat landing that supplied wood, freight, and entertainment.",
      "sourceSentenceIds": [
        25,
        27
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.bigskytreasure.org/history/places/rocky-point",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The Missouri River near Rocky Point reshapes banks and erases footpaths with every seasonal rise, yet it keeps currents that carried fish and sheltered camps.",
      "sourceSentenceIds": [
        23
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.bigskytreasure.org/history/places/rocky-point",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Local groups like the Flathead Lake Biological Station and the Confederated Salish and Kootenai Tribes work to suppress invasive fish such as zebra mussels in Rocky Point’s waters.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/rocky_point_montana",
      "category": "other",
      "quality": "poor",
      "qualityReason": "editorial_filler"
    },
    {
      "id": 6,
      "text": "Rocky Point’s proximity to Flathead Lake moderates temperatures, keeping extremes milder than inland areas and adding a touch of humidity during the growing season.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/rocky_point_montana"
    }
