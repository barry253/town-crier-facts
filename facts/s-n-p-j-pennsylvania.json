  "facts": [
    {
      "id": 1,
      "text": "Founded in 1904, the Slovene National Benefit Society created S.N.P.J. to provide affordable life insurance to Slovenian immigrants.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://pabook.libraries.psu.edu/literary-cultural-heritage-map-pa/feature-articles/population-zero-snpj-borough"
    },
    {
      "id": 2,
      "text": "In 1977 the society incorporated a 500‑acre recreation center as a separate municipality, allowing it to obtain its own liquor license.",
      "sourceSentenceIds": [
        13,
        14
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://pabook.libraries.psu.edu/literary-cultural-heritage-map-pa/feature-articles/population-zero-snpj-borough"
    },
    {
      "id": 3,
      "text": "S.N.P.J. is the smallest borough in Pennsylvania, covering only 0.7 square miles.",
      "sourceSentenceIds": [
        26
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://pabook.libraries.psu.edu/literary-cultural-heritage-map-pa/feature-articles/population-zero-snpj-borough"
    },
    {
      "id": 4,
      "text": "The borough’s name comes from the Slovene phrase “Slovenska Narodna Podporna Jednota,” meaning Slovene National Benefit Society.",
      "sourceSentenceIds": [
        15
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/S.N.P.J.%2C_Pennsylvania"
    },
    {
      "id": 5,
      "text": "The recreation center hosts Slovenefest, featuring traditional Slovenian polka, waltz music, and jam sessions in a “Food and Jam Tent.”.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://pabook.libraries.psu.edu/literary-cultural-heritage-map-pa/feature-articles/population-zero-snpj-borough"
    },
    {
      "id": 6,
      "text": "The 500 acres host 60 cabins, 115 mobile home slots, and an artificial lake, open for summer resorts, bingo, weddings, and dances.",
      "sourceSentenceIds": [
