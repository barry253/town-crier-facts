  "facts": [
    {
      "id": 1,
      "text": "Glen St. Mary began when Ohio developer Alverdo Geitgey bought 12,700 acres in the late 1800s and laid out the town.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.florida-backroads-travel.com/glen-st-mary-florida.html"
    },
    {
      "id": 2,
      "text": "After the Civil War, farmers from Georgia and South Carolina moved into the area, turning abandoned cotton fields into new homes.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.florida-backroads-travel.com/glen-st-mary-florida.html"
    },
    {
      "id": 3,
      "text": "Just three miles from town, Heritage Park Village preserves restored buildings that reveal what life was like in early Florida.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.florida-backroads-travel.com/glen-st-mary-florida.html"
    },
    {
      "id": 4,
      "text": "Glen St. Mary falls within the Jacksonville Metropolitan Statistical Area, linking it to the larger North Florida region.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Glen_St._Mary%2C_Florida"
    },
    {
