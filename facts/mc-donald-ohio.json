  "facts": [
    {
      "id": 1,
      "text": "McDonald was founded in 1916 as a company town by Carnegie Steel to house workers for its new steel mills.",
      "sourceSentenceIds": [
        1,
        4
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/mcdonald_ohio",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The village was named after Thomas G. McDonald, a local family that owned land before the steel era.",
      "sourceSentenceIds": [
        3,
        5
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/mcdonald_ohio",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "A statewide grant will fund a historical path called the McDonald Millworkers Trail, honoring the village’s steelmaking roots.",
      "sourceSentenceIds": [
        13,
        15,
        17
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.wkbn.com/news/local-news/mcdonald-news/statewide-grant-helps-local-village-build-historical-path/",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "McDonald sits along the Mahoning River, a waterway that shaped its early agrarian life and later industrial growth.",
      "sourceSentenceIds": [
        9,
        21
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/mcdonald_ohio",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The first steel mill construction began in 1916, drawing workers to a previously rural area before full operations.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/mcdonald_ohio",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The village’s topography ranges from 837 to 1,037 feet, giving it gentle hills that drain toward the Mahoning River.",
