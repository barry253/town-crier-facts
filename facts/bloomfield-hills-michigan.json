      ],
      "source": "https://en.wikipedia.org/wiki/Bloomfield_Hills%2C_Michigan",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Kirk in the Hills Presbyterian on Long Lake Rd and Christ Church Cranbrook Episcopal, consecrated 1928, are notable churches in Bloomfield Hills.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Wikipedia"
