  "facts": [
    {
      "id": 1,
      "text": "Erin Springs is a town in Garvin County, Oklahoma, located in a ranching and farming region once part of the Chickasaw Nation.",
      "sourceSentenceIds": [
        13,
        27
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 2"
      ],
      "source": "https://en.wikipedia.org/wiki/Erin_Springs%2C_Oklahoma"
    },
    {
      "id": 2,
      "text": "Irish immigrant Frank Murray founded Erin Springs in 1871, eventually becoming a cattle rancher with twenty thousand acres of land.",
      "sourceSentenceIds": [
        18,
        28,
        29
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 2"
      ],
      "source": "https://en.wikipedia.org/wiki/Erin_Springs%2C_Oklahoma"
    },
    {
      "id": 3,
      "text": "The town was originally called Elm Springs because of a large elm tree that grew near a local stage stand.",
      "sourceSentenceIds": [
        12,
        26,
        30
      ],
      "sourceLabels": [
        "Web source 1",
        "Web source 2",
        "Wikipedia"
      ],
      "source": "https://okgenweb.net/~okgarvin/towns/erinspringstown.html"
    },
    {
      "id": 4,
      "text": "Various stories explain the name Erin Springs, including a tribute to Ireland or a naming honor for Frank Murray's sister.",
      "sourceSentenceIds": [
        7,
        10,
        11
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 2"
      ],
      "source": "https://en.wikipedia.org/wiki/Erin_Springs%2C_Oklahoma"
    },
    {
      "id": 5,
      "text": "The Murray-Lindsay Mansion in Erin Springs is listed on the National Register of Historic Places and was constructed starting in 1880.",
      "sourceSentenceIds": [
        14,
        19
      ],
      "sourceLabels": [
        "Web source 1",
        "Web source 2"
      ],
      "source": "https://okgenweb.net/~okgarvin/towns/erinspringstown.html"
    },
    {
      "id": 6,
      "text": "Early settlers in Erin Springs lived near the Washita River on a busy stage line that carried freight and passengers.",
