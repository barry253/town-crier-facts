  "facts": [
    {
      "id": 1,
      "text": "Moss Landing was named after Captain Charles Moss, who built a 200‑foot wharf in 1866.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://mosslandingchamber.com/our-history/",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The harbor’s submerged lands were acquired by California in 1850 when the state joined the Union.",
      "sourceSentenceIds": [
        5,
        7
      ],
      "sourceLabels": [
        "Web source 1",
        "Web source 2"
      ],
      "source": "https://mosslandingchamber.com/our-history/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "In 1945 Congress authorized building a harbor by the Army Corps of Engineers, shaping modern fishing industry.",
      "sourceSentenceIds": [
        17,
        18
      ],
      "sourceLabels": [
        "Web source 1",
        "Web source 2"
      ],
      "source": "https://mosslandingchamber.com/our-history/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "A whaling station of considerable capacity opened around 1917, reflecting the town’s maritime heritage.",
      "sourceSentenceIds": [
        19,
        20
      ],
      "sourceLabels": [
        "Web source 1",
        "Web source 2"
      ],
      "source": "https://mosslandingchamber.com/our-history/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The Pajaro Valley Consolidated Railroad reached Moss Landing around 1890, linking it to San Francisco before the rail line.",
      "sourceSentenceIds": [
        14,
        15
      ],
      "sourceLabels": [
        "Web source 1",
        "Web source 2"
      ],
      "source": "https://mosslandingchamber.com/our-history/",
      "category": "transport",
      "quality": "good"
    },
    {
