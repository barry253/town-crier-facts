  "facts": [
    {
      "id": 1,
      "text": "Glen Canyon Park began when Adolph Sutro bought 76 acres in the 1850s and called it 'Gum Tree Ranch' after planting blue gum eucalyptus.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Glen_Canyon_Park",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The neighborhood grew from earthquake refugees in the late 19th century, blending historic homes with modern residences and small local businesses.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://sanfrancisco.wiki/a/Glen_Park",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Glen Park’s name echoes its 1890s nickname 'Little Switzerland,' a nod to the windswept hills that resembled alpine scenery.",
      "sourceSentenceIds": [
        19
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://sanfrancisco.wiki/a/Glen_Park",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "O'Shaughnessy Hollow, a 3.6‑acre rugged tract, sits just west of the park and is considered an extension of Glen Canyon Park.",
      "sourceSentenceIds": [
        29
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Glen_Canyon_Park",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The Glen Park Neighborhoods History Project, founded in 2014, documents the area’s diverse stories from the 1850s onward.",
      "sourceSentenceIds": [
        11,
        12,
        15
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.glenparkhistory.org/about-us",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Glen Canyon Park’s Mission Zoo and extensive green space make it a key green lung for the surrounding neighborhoods.",
