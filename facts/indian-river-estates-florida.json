  "facts": [
    {
      "id": 1,
      "text": "Indian River Estates sits in a county that once grew pineapples, and the former plantation is now a museum bequeathed to the Historical Society by Ruth Hallstrom.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://visitindianrivercounty.com/history/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The Hallstrom House, a 1918 landmark listed on the National Registry of Historic Places, is just a short drive from Indian River Estates.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://visitindianrivercounty.com/history/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The Indian River Citrus Museum, a historic site that showcases the region’s citrus heritage, is located near Indian River Estates.",
      "sourceSentenceIds": [
        16
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://visitindianrivercounty.com/history/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The Indian River County Historical Society, headquartered near Indian River Estates, focuses on restoring and preserving historic sites throughout the county.",
      "sourceSentenceIds": [
        11
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://visitindianrivercounty.com/history/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The Historical Society’s collection includes over 7,000 photographs, offering a visual history of Indian River County and its communities.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.indianriver.gov/services/library/genealogy/guides_and_indexes/irc_history.php",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Indian River County’s first library, the Marian Fell Library, opened as a pioneering institution for women’s suffrage and remains open today.",
