  "facts": [
    {
      "id": 1,
      "text": "Highland was founded in December 1858 by land promoter William Larimer Jr., who also founded Denver City the month before.",
      "sourceSentenceIds": [
        1,
        5
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Highland%2C_Denver",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Within the Highlands, historic designations include Potter Highlands, Scottish Highlands, and Highlands Park, each reflecting different eras of the neighborhood.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Highland%2C_Denver",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Potter Highlands is celebrated for its deep roots in Denver’s early settlement, drawing visitors to its storied streets and historic homes.",
      "sourceSentenceIds": [
        13
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://history.denverlibrary.org/neighborhood-history-guide/potter-highlands-neighborhood-history",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "A 1½‑hour walking tour guides guests through Potter Highlands, highlighting its oldest neighborhood status and the stories of its founding families.",
      "sourceSentenceIds": [
        14
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://historicdenver.org/all-tours/potter-highlands/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "In 1859 the Highland town company formed, planning a Platte River bridge to connect the new town with Auraria and Denver.",
