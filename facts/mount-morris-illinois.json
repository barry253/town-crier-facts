      ],
      "source": "https://mtmorrisil.net/visit/history/",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Since 1896, the Kable Concert Band has performed free summer concerts from the campus bandshell, a tradition that still thrives today.",
      "sourceSentenceIds": [
        12,
        16
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://mtmorrisil.net/visit/history/",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Mount Morris is home to a notable collection of Lustron homes, with five on First Street, three on Hannah Avenue, and five on Sunset Lane.",
