      "quality": "good"
    },
    {
      "id": 3,
      "text": "The Kable brothers turned an abandoned print shop into the largest employer in Mount Morris, launching a printing empire in 1898.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
