      "id": 1,
      "text": "Catonsville takes its name from Richard Caton, an English merchant who married Mary Carroll in 1786 and owned much of the area.",
      "sourceSentenceIds": [
        26
      ],
      "sourceLabels": [
        "Web source 1"
      ],
