      "id": 1,
      "text": "Sylvan Grove was founded in 1877 on the site of a mill built two years earlier.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Sylvan_Grove%2C_Kansas",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town takes its name from twin sylvan groves that once surrounded the original site.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Sylvan_Grove%2C_Kansas",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "When the Salina, Lincoln & Western Railway arrived in September 1887, Sylvan Grove gained a second chance for growth.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
