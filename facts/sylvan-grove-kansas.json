      ],
      "source": "https://legendsofkansas.com/sylvan-grove-kansas/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The Sylvan Grove Public Library began in 1925, first housed above the Sylvan State Bank before moving to City Hall in 1956.",
      "sourceSentenceIds": [
