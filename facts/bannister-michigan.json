      "quality": "poor",
      "qualityReason": "vague"
    },
    {
      "id": 4,
      "text": "A cheese factory opened in Bannister, but nearby Elsie took over the business, leaving the factory abandoned.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
