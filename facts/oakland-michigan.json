  "facts": [
    {
      "id": 1,
      "text": "Oakland was named for the oak openings described by early geologist Bela Hubbard.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.michigan.gov/libraryofmichigan/public/michigan/county-guides/guides/oakland",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Oakland County was founded on March 28, 1820, organized the next year, and was carved out of Macomb County.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Oakland_County%2C_Michigan",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Pontiac’s Oakland Motor Car Company began in 1907 and later joined General Motors, cementing Pontiac as a major auto center.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Oakland_County%2C_Michigan",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "US 24 runs through Oakland County as Telegraph Road, a historic north‑south corridor that once carried early settlers.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Oakland_County%2C_Michigan",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "From 1975 to 2001 the Detroit Lions called Pontiac Silverdome home, a landmark stadium in Oakland County.",
      "sourceSentenceIds": [
        15
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Oakland_County%2C_Michigan",
