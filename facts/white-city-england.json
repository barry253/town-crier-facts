      ],
      "source": "https://en.wikipedia.org/wiki/White_City%2C_London",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The former BBC Television Centre, a mid‑century modernist ring, sits on the former stadium site and has been redeveloped into luxury residences.",
      "sourceSentenceIds": [
        16,
        30
      ],
      "sourceLabels": [
        "Wikipedia",
