  "facts": [
    {
      "id": 1,
      "text": "The Town of Wilson was named after Thomas Blair Wilson Senior, a surveyor and early member of the Dunn County Board.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.townofwilsondunncty.com/history"
    },
    {
      "id": 2,
      "text": "Established in 1886, the Town of Wilson was the twenty-second and final political township to form in Dunn County.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.townofwilsondunncty.com/history"
    },
    {
      "id": 3,
      "text": "Wilson was described in a 1925 county history as being modest and generous, often giving anonymously and avoiding attention.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.townofwilsondunncty.com/history"
    },
    {
      "id": 4,
      "text": "The Village of Ridgeland is the only remaining incorporated municipality within the Town of Wilson.",
      "sourceSentenceIds": [
        25
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.townofwilsondunncty.com/history"
    },
    {
      "id": 5,
      "text": "Some of the earliest settlers in Wilson purchased their land directly from the railroad companies.",
