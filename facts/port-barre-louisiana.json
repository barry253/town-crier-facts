  "facts": [
    {
      "id": 1,
      "text": "Port Barre began in 1760 as an Indian trading post where Bayou Teche meets Bayou Courtableau.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Port_Barre%2C_Louisiana",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Port Barre takes its name from Alex Charles Barre, who acquired the land in 1765, and the town adopted the name in 1898.",
      "sourceSentenceIds": [
        14
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Port_Barre%2C_Louisiana",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Port Barre sits at the confluence of Bayou Courtableau and Bayou Teche, just 8 miles east of Opelousas.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Port_Barre%2C_Louisiana",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Capitalizing on abundant timber, Port Barre grew into a sawmill town as railroads arrived.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.townofportbarre.com/",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Despite Civil War devastation, 1927 and 1953 floods, and fires in 1928 and 1931, Port Barre kept growing.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.townofportbarre.com/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "French explorer Pierre Le Moyne d'Iberville sent an expedition to establish a permanent settlement in the Port Barre area.",
      "sourceSentenceIds": [
        5
      ],
