  "facts": [
    {
      "id": 1,
      "text": "Galena earned its name from the lead ore mined there, with early settlers calling the town Short Creek before adopting the mineral’s name in 1877.",
      "sourceSentenceIds": [
        25
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Galena%2C_Kansas",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Lead mining sparked Galena’s growth, with the first community forming after a spring 1877 discovery, even though the railroad reached the area in 1871.",
      "sourceSentenceIds": [
        6,
        12
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Galena%2C_Kansas",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Galena sits on the 13‑mile Kansas stretch of historic Route 66, where landmarks like the Kan‑O‑Tex station and the Haunted Staffleback Bordello echo the highway’s legacy.",
      "sourceSentenceIds": [
        1,
        22
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://intotheozarks.com/cities-of-the-ozarks/galena-kansas/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The Galena Mining and Historical Museum on Route 66 preserves artifacts from the town’s mining past, school life, and Route 66 memorabilia.",
      "sourceSentenceIds": [
        8,
        9
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Galena%2C_Kansas",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "In 1983, the Cherokee County Superfund site was added to the EPA’s National Priorities List because of historic lead, zinc, antimony, and cadmium contamination.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Galena%2C_Kansas",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Strolling through Galena, visitors can admire murals that illustrate the town’s rich mining heritage and cultural legacy.",
