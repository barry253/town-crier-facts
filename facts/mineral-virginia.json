      "id": 1,
      "text": "Mineral, originally Tolersville, changed its name in 1902 to honor the booming mining industry that defined the town.",
      "sourceSentenceIds": [
        2,
        6
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
