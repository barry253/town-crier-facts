  "facts": [
    {
      "id": 1,
      "text": "Newtok, known in Yup'ik as Niugtaq meaning 'rustling of grass,' began as a seasonal camp used by Yup'ik people for over two millennia along the Ninglick River.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/newtok_alaska",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The village experiences persistent cold snaps, but occasional chinook winds from the Bering Sea bring temporary relief during winter.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/newtok_alaska",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "A 2007 New York Times report noted that erosion had turned Newtok into an island between the widening Ningliq River and a northern slough, as melting permafrost accelerated.",
      "sourceSentenceIds": [
        19
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Newtok%2C_Alaska",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "In 2024 the village was abandoned after residents relocated to the new town of Mertarvik.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/newtok_alaska",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "A 2009 Army Corps of Engineers report warned that Newtok's high school, the town's highest point, would be submerged by 2017.",
