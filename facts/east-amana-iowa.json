  "facts": [
    {
      "id": 1,
      "text": "East Amana was founded in 1855 by German Pietist immigrants from the Community of True Inspiration seeking religious freedom.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/east_amana_iowa",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The village’s name, Amana, comes from the German word 'Bleibtreu,' meaning 'remain true' in the Bible.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/east_amana_iowa",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "From 1855 to 1932, East Amana operated under a strict communal system where residents shared all property, labor, and resources.",
      "sourceSentenceIds": [
        28
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/east_amana_iowa",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The Amana Colonies, including East Amana, earned National Historic Landmark status for preserving their communal heritage.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/east_amana_iowa",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Middle Amana gave birth to the Amana Corporation, which introduced the Radarange, the first consumer microwave, in 1967.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://sideofculture.com/2026/04/preserving-heritage-the-amana-colonies-in-iowa/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "At the Amana Heritage Museum’s schoolhouse, visitors watch a 22‑minute film that chronicles the colony’s history.",
