      ],
      "source": "https://en.wikipedia.org/wiki/Mandeville%2C_Louisiana",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The Lake Pontchartrain Causeway, the world’s longest continuous bridge, opened its first span in 1956, linking Mandeville to New Orleans.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Wikipedia"
