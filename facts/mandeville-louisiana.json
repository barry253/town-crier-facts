      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The Dew Drop Social and Benevolent Hall, built in 1895, is the oldest standing jazz hall in America and is listed on the National Register of Historic Places.",
      "sourceSentenceIds": [
        12,
        19
      ],
      "sourceLabels": [
