  "facts": [
    {
      "id": 1,
      "text": "Waipio Valley, pronounced why‑pee‑oh, lies on the rugged Hāmākua Coast of Hawaiʻi Island.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.hawaii.com/blog/waipio-valley-hawaiis-sacred-valley-of-the-kings",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Nicknamed the “Valley of the Kings,” Waipiʻo was once the political and spiritual center of ancient Hawaiʻi.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.hawaii.com/blog/waipio-valley-hawaiis-sacred-valley-of-the-kings",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "In 1780, King Kamehameha the Great received his war god Kukailimoku in Waipio Valley, a pivotal moment in his rise to kingship.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.hawaiiactivities.com/travelguide/waipio-valley/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The valley’s dramatic cliffs and fertile landscapes make it a sacred residence for Hawaiian royalty and a historic agricultural center.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.hawaiiactivities.com/travelguide/waipio-valley/",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Chinese immigrants arrived in the 19th century and established a community within Waipio Valley, adding a layer of foreign influence.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.hawaiiactivities.com/travelguide/waipio-valley/",
      "category": "people",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Access to the valley floor is limited to authorized tours, so most visitors experience it from the lookout or via guided trips.",
      "sourceSentenceIds": [
        17
      ],
