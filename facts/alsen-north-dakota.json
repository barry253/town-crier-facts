  "facts": [
    {
      "id": 1,
      "text": "Alsen began as Storlie in 1899, named for Halvor Storlie, before being renamed Alsen in 1905 after a Danish island.",
      "sourceSentenceIds": [
        3,
        4
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.ccjda.org/alsen.html",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The Soo Line Railroad made Alsen a townsite, and the town grew around grain elevators, hardware stores, and a Mirolene medicine factory.",
      "sourceSentenceIds": [
        1,
        5
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.ccjda.org/alsen.html",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The former Alsen High School, closed in 1980, held the longest basketball winning streak in North Dakota history with 79 consecutive wins from 1956 to 1959.",
      "sourceSentenceIds": [
        6,
        29
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Alsen%2C_North_Dakota",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "A curling club founded in 1960 remains a social hub in Alsen, showcasing the town's love for winter sports.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.ccjda.org/alsen.html",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The Swiss Mennonite Church, established in Alsen, stands as a historic religious landmark in the community.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.ccjda.org/alsen.html",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Lost Prairie Lodge, originally low‑income housing, now serves as a hunting lodge and community rental space in Alsen.",
