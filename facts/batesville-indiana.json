      "id": 1,
      "text": "Batesville was founded in 1852 by Joshua Bates, who platted the town and gave it its name.",
      "sourceSentenceIds": [
        27,
        6
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 2"
      ],
