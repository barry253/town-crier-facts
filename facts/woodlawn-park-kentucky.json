  "facts": [
    {
      "id": 1,
      "text": "Woodlawn Park’s famous Woodlawn Vase, designed by Tiffany’s for races in 1861–62, was buried during the Civil War and now crowns the Preakness Stakes winner.",
      "sourceSentenceIds": [
        18,
        19,
        20
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Woodlawn_Park%2C_Kentucky",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Woodlawn Station, a flagstop opened in 1858 for racegoers, later became Beechwood Station from 1882–90 and stayed active until about 1935.",
      "sourceSentenceIds": [
        2,
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/woodlawn_park_kentucky",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Woodlawn Park officially became a city on March 10, 1955, marking its transition from a former racecourse to a modern municipality.",
      "sourceSentenceIds": [
        21
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Woodlawn_Park%2C_Kentucky",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Woodlawn Park sits on the former Woodlawn Race Course, which opened in 1859 and attracted national attention.",
      "sourceSentenceIds": [
        15
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Woodlawn_Park%2C_Kentucky",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Before becoming a racecourse, the Woodlawn Park area was part of a 1774 land grant in Jefferson County, reflecting early colonial settlement.",
      "sourceSentenceIds": [
        7,
        8
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Woodlawn_Park%2C_Kentucky",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "By the early 1960s, Woodlawn Park had shifted from racing grounds to residential streets, and a 1986 historic marker commemorated its racing past.",
      "sourceSentenceIds": [
