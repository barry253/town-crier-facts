  "facts": [
    {
      "id": 1,
      "text": "Lookeba was founded in 1902 on 160 acres along the proposed route of the Enid and Anadarko Railway.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.okhistory.org/publications/enc/entry?entry=LO012"
    },
    {
      "id": 2,
      "text": "The name Lookeba is a portmanteau of the names of three founding fathers: Lowe, Kelley, and Baker.",
      "sourceSentenceIds": [
        20
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Lookeba%2C_Oklahoma"
    },
    {
      "id": 3,
      "text": "By the mid-1930s, Lookeba operated a grain elevator, a movie theater, two garages, and a bakery.",
      "sourceSentenceIds": [
        13
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.okhistory.org/publications/enc/entry?entry=LO012"
    },
    {
      "id": 4,
      "text": "Lookeba is located in northern Caddo County, where Sugar Creek travels south-southeast past the east side of the community.",
      "sourceSentenceIds": [
        22,
        24
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Lookeba%2C_Oklahoma"
    },
    {
      "id": 5,
      "text": "Lookeba is old enough to appear on a 1911 Rand McNally map of the county.",
