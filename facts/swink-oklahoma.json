  "facts": [
    {
      "id": 1,
      "text": "Swink is home to the District Choctaw Chief's House, which was the residence of District Choctaw Chief Thomas LeFlore.",
      "sourceSentenceIds": [
        29
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Swink%2C_Oklahoma"
    },
    {
      "id": 2,
      "text": "Built in 1837, the District Choctaw Chief's House is the oldest house in Oklahoma that remains on its original site.",
      "sourceSentenceIds": [
        30
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Swink%2C_Oklahoma"
    },
    {
      "id": 3,
      "text": "A post office was first established at Swink, Indian Territory, on August 14, 1902.",
