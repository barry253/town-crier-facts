  "facts": [
    {
      "id": 1,
      "text": "Stevensburg was renamed in 1782 to honor Revolutionary War general Edward Stevens, a Culpeper native who led militia at Brandywine and Germantown.",
      "sourceSentenceIds": [
        3,
        6
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Stevensburg%2C_Virginia",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The Georgian manor Salubria, built circa 1757 by Rev. John Thompson, sits on a hilltop overlooking the village and was listed on the National Register in 1970.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/stevensburg_virginia",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Stevensburg was a Confederate supply base during the Civil War and hosted the “Stevensburg” phase of the Battle of Brandy Station, the largest U.S. cavalry engagement.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/stevensburg_virginia",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "In 1863–1864, Union troops camped in Stevensburg while enslaved people at Salubria achieved self‑emancipation, though some were forcibly moved to prevent escape.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/stevensburg_virginia",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The village sits at the intersection of U.S. Route 3 and Route 663, about 6.9 miles east of Culpeper, placing it in the Piedmont’s rolling hills.",
      "sourceSentenceIds": [
        14,
        15,
        24,
        25
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Stevensburg%2C_Virginia",
      "category": "transport",
      "quality": "poor",
      "qualityReason": "route_only"
    },
    {
      "id": 6,
      "text": "Salubria, now owned by the Germanna Foundation since 2000, offers a window into colonial life, emancipation, and preservation after a 2011 earthquake.",
