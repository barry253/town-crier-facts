  "facts": [
    {
      "id": 1,
      "text": "Hicksville was platted in 1835–36, got its post office in 1838, and became an incorporated village in 1871.",
      "sourceSentenceIds": [
        22,
        23,
        24
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Hicksville%2C_Ohio"
    },
    {
      "id": 2,
      "text": "In 1870, the Baltimore & Ohio Railroad announced a line that would pass through Hicksville, linking it to regional trade.",
      "sourceSentenceIds": [
        16
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://hicksvilleohiochamber.org/visit-hicksville/"
    },
    {
      "id": 3,
      "text": "The Huber Opera House, built in the late 19th century, ranks among the finest opera houses in the Midwest.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://hicksvilleohiochamber.org/visit-hicksville/"
    },
    {
      "id": 4,
      "text": "The all‑volunteer Hicksville Historical Society, founded in the 1970s, dedicates itself to preserving the village’s story.",
      "sourceSentenceIds": [
        11
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://hicksvillehistoricalsociety.com/"
    },
    {
      "id": 5,
      "text": "Daeida Hartle Wilcox Beveridge, a native of Hicksville, co‑founded Hollywood and helped name the California suburb.",
