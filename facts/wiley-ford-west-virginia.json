  "facts": [
    {
      "id": 1,
      "text": "Wiley Ford is a community in Mineral County located near a former ford in the North Branch of the Potomac River.",
      "sourceSentenceIds": [
        19
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://wvexplorer.com/travel/communities/cities-towns/wiley-ford-west-virginia/"
    },
    {
      "id": 2,
      "text": "The community was originally known as Dixie until the early 1900s.",
      "sourceSentenceIds": [
        26
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.wvgw.net/mineral/WilFordt.htm"
    },
    {
      "id": 3,
      "text": "Wiley Ford took its current name because a family named Wiley lived near the ford over the Potomac River.",
      "sourceSentenceIds": [
        27
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.wvgw.net/mineral/WilFordt.htm"
    },
    {
      "id": 4,
      "text": "The Potomac River was forded between Wiley Ford and Cumberland, Maryland, until 1909.",
      "sourceSentenceIds": [
        23
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.wvgw.net/mineral/WilFordt.htm"
    },
    {
      "id": 5,
      "text": "The Chesapeake and Ohio Canal National Historical Park skirts the town of Wiley Ford on the opposite bank of the river.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://wvexplorer.com/travel/communities/cities-towns/wiley-ford-west-virginia/"
    },
    {
      "id": 6,
      "text": "The Homestead Development Company purchased land in Wiley Ford from James Stickley in 1913 to sell off into lots.",
      "sourceSentenceIds": [
        21
      ],
