  "facts": [
    {
      "id": 1,
      "text": "Belmont's name comes from Italian 'bel monte' meaning beautiful mountain, named for a rounded eminence nearby.",
      "sourceSentenceIds": [
        14
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Belmont%2C_California"
    },
    {
      "id": 2,
      "text": "The town began as a stagecoach station in 1850 and grew around a villa once owned by Italian aristocrat Count Leonetto Cipriani.",
      "sourceSentenceIds": [
        13,
        19
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 2"
      ],
      "source": "https://en.wikipedia.org/wiki/Belmont%2C_California"
    },
    {
      "id": 3,
      "text": "In 1866 banker William Ralston converted Cipriani’s villa into a grand mansion that later became Notre Dame de Namur University’s main building.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.britannica.com/place/Belmont-California"
    },
    {
      "id": 4,
      "text": "Southern Pacific Railroad stopped at Belmont in 1864, but the depot opened only in 1867, linking the town to the Bay Area.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.thesanfranciscopeninsula.com/places-to-go/belmont/history/"
    },
    {
      "id": 5,
      "text": "Belmont hosts a surviving structure from the 1915 Panama–Pacific International Exposition, a relic of a world fair that once toured the city.",
      "sourceSentenceIds": [
        21
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Belmont%2C_California"
    },
    {
      "id": 6,
      "text": "The city’s strict 2009 smoking ordinance, one of the nation’s toughest, reflects Belmont’s commitment to public health.",
      "sourceSentenceIds": [
