  "facts": [
    {
      "id": 1,
      "text": "Markle got its name in 1852 when the post office changed from Tracy to Markle, after one of the founders’ wives’ family.",
      "sourceSentenceIds": [
        7,
        8
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.markleindiana.com/our-story",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "When the Chicago & Erie Railroad reached Markle around 1878, merchants flooded in, adding a drug store, hotel, and livery barn.",
      "sourceSentenceIds": [
        15,
        17
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.markleindiana.com/our-story",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "A former quarry near Markle now serves as a popular swimming spot that draws visitors from all over the region.",
      "sourceSentenceIds": [
        20
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://visithuntington.org/about/huntington-county/markle",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Don’t miss the giant “Pickle on a Tractor” mural, a quirky photo‑op that locals love.",
      "sourceSentenceIds": [
        11
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://visithuntington.org/about/huntington-county/markle",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Historical photos and artifacts are housed in the Markle Town Hall on Morse Street, preserving the town’s early days.",
      "sourceSentenceIds": [
        18
      ],
      "sourceLabels": [
        "Web source 1"
      ],
