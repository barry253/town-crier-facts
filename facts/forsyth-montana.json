  "facts": [
    {
      "id": 1,
      "text": "Forsyth was founded in 1876 as the first settlement on the Yellowstone River, serving as a steamboat landing for Army operations.",
      "sourceSentenceIds": [
        2,
        20,
        21
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Forsyth%2C_Montana",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town was named in 1882 after General James William Forsyth, commander of Fort Maginnis during the Indian Wars.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Forsyth%2C_Montana",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The historic Howdy Hotel & Lounge traces its roots to the 1901 Commercial Hotel, a landmark of early Forsyth hospitality.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://discoveringmontana.com/towns/forsyth/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The Rosebud County Courthouse, built by architects Link and Haire, is one of only eighteen Montana courthouses designed by that firm.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.forsythmtchamber.com/things-to-do/history-culture",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Forsyth sits on the south bank of the Yellowstone River, a spot that has long attracted hunting, fishing, and camping enthusiasts.",
      "sourceSentenceIds": [
        11,
        15
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://discoveringmontana.com/towns/forsyth/",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The town hosts the Rosebud County Fair and houses the Pioneer Museum, preserving the region’s homesteader history.",
      "sourceSentenceIds": [
