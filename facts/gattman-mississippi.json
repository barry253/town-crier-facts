      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Before European settlers, the Chickasaw people inhabited the Gattman area, maintaining villages and trading in northeastern Mississippi.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/gattman_mississippi",
      "category": "people",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Hollis Lumber Company, founded in 1918, still operates in Gattman, sustaining the town amid rural economic shifts.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/gattman_mississippi",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The Buttahatchie River, a Tombigbee tributary, runs just north of Gattman, shaping the local valley and creeks.",
