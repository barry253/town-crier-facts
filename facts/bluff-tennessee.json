  "facts": [
    {
      "id": 1,
      "text": "Bluff City first appeared on maps as Choate’s Ford, a shallow Holston River crossing that early settlers used to cross the Appalachians.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/bluff_city_tennessee",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town’s name changed to Union in 1870 after the East Tennessee, Virginia and Georgia Railroad built a bridge over the Holston, reflecting its strategic rail spot.",
      "sourceSentenceIds": [
        2,
        10
      ],
      "sourceLabels": [
        "Web source 1",
        "Wikipedia"
      ],
      "source": "https://grokipedia.com/page/bluff_city_tennessee",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "During the Civil War, Union’s wooden trestle bridge was torched by Unionist Daniel Stover and his men, disrupting Confederate supply lines.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/bluff_city_tennessee",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "After the war, the town briefly honored Confederate General Felix Zollicoffer by adopting his name before reverting to Union and finally becoming Bluff City in 1887.",
      "sourceSentenceIds": [
        6,
        25,
        24
      ],
      "sourceLabels": [
