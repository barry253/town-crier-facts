  "facts": [
    {
      "id": 1,
      "text": "Eldridge was originally called Camp Springs in 1914 because travelers used its natural springs to replenish water.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://encyclopediaofalabama.org/article/eldridge/"
    },
    {
      "id": 2,
      "text": "The Frisco Railroad completed a line through Eldridge in 1887, bringing a depot and an inn.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://encyclopediaofalabama.org/article/eldridge/"
    },
    {
      "id": 3,
      "text": "The community was officially renamed Eldridge in honor of Eldridge T for its contributions.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/eldridge_alabama"
    },
    {
      "id": 4,
      "text": "Early settlers were attracted in the early 19th century by abundant natural springs that served as watering spots for travelers.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/eldridge_alabama"
    },
    {
      "id": 5,
      "text": "The settlement grew significantly when Alabama's first state road connected northwest Alabama to Tuscaloosa, passing through Eldridge.",
      "sourceSentenceIds": [
        15
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/eldridge_alabama"
    },
    {
      "id": 6,
      "text": "Eldridge is located in northwest Walker County in the north-central part of the state.",
      "sourceSentenceIds": [
        30
