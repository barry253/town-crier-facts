  "facts": [
    {
      "id": 1,
      "text": "Elyria was founded in 1817 by Heman Ely, who built a log house, dam, gristmill, and sawmill along the Black River.",
      "sourceSentenceIds": [
        1,
        12
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Elyria%2C_Ohio",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The city’s name comes from founder Heman Ely and echoes Illyria, the ancient Greek name for the western Balkans.",
      "sourceSentenceIds": [
        11
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Elyria%2C_Ohio",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Elyria’s river location made it a stop on the Underground Railroad, where Ely helped escaped slaves reach Canada.",
      "sourceSentenceIds": [
        16
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.cityofelyria.org/history-of-elyria/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Elyria Memorial Hospital opened in 1908 after a fatal trolley accident the year before.",
      "sourceSentenceIds": [
        5,
        28
      ],
      "sourceLabels": [
        "Web source 1",
        "Wikipedia"
      ],
      "source": "https://www.cityofelyria.org/history-of-elyria/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Heman Ely founded Lorain Iron Company on what is now Furnace Street, forging iron beside West Falls.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.cityofelyria.org/history-of-elyria/",
