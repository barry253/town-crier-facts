  "facts": [
    {
      "id": 1,
      "text": "Palo was named by Albert Van Vleck after General Zachary Taylor’s 1846 victory at the Battle of Palo Alto.",
      "sourceSentenceIds": [
        3,
        9
      ],
      "sourceLabels": [
        "Web source 1",
        "Wikipedia"
      ],
      "source": "https://99wfmk.com/palo-michigan/",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Matthew and John Van Vleck were among the first settlers who owned the land that became Palo.",
      "sourceSentenceIds": [
        2,
        8
      ],
      "sourceLabels": [
        "Web source 1",
        "Wikipedia"
      ],
      "source": "https://99wfmk.com/palo-michigan/",
      "category": "people",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Albert Van Vleck opened the first general store in 1854 to supply nearby residents, sparking the town’s commercial growth.",
      "sourceSentenceIds": [
        22,
        23
      ],
      "sourceLabels": [
        "Web source 1",
        "Web source 1"
      ],
      "source": "https://99wfmk.com/palo-michigan/",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "A post office opened in Palo on July 14, 1857, with Dr. Orla H. Taylor as its first postmaster.",
      "sourceSentenceIds": [
        27,
        28
      ],
      "sourceLabels": [
        "Web source 1",
        "Web source 1"
      ],
      "source": "https://99wfmk.com/palo-michigan/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The town was officially platted and recorded on March 12, 1867, cementing its status as a formal community.",
      "sourceSentenceIds": [
        12,
        29
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Ronald_Township%2C_Michigan",
      "category": "history",
      "quality": "good"
    },
    {
