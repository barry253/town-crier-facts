  "facts": [
    {
      "id": 1,
      "text": "Old Hickory takes its name from President Andrew Jackson, who was nicknamed “Old Hickory.”.",
      "sourceSentenceIds": [
        1,
        3
      ],
      "sourceLabels": [
        "Web source 1",
        "Wikipedia"
      ],
      "source": "https://www.oldhickorychamber.com/old-hickory-tn-history"
    },
    {
      "id": 2,
      "text": "In 1918 DuPont and the federal government built a massive gunpowder plant and village at Hadley Bend, originally called Jacksonville.",
      "sourceSentenceIds": [
        10,
        12
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.oldhickoryvillage.org/history"
    },
    {
      "id": 3,
      "text": "The village grew to over 300 homes by November 1918 and boasted its own hospital, churches, gymnasium, and theater.",
      "sourceSentenceIds": [
        12,
        22
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.oldhickoryvillage.org/history"
    },
    {
      "id": 4,
      "text": "After the war, DuPont shut the gunpowder plant and turned the complex into a rayon factory, adding a cellophane plant by the decade’s end.",
      "sourceSentenceIds": [
        14
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.oldhickoryvillage.org/history"
    },
    {
      "id": 5,
      "text": "Numerous historic homes in Old Hickory Village are listed on the National Register of Historic Places, preserving the area’s early 20th‑century architecture.",
      "sourceSentenceIds": [
        16,
        18,
        19
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1",
        "Web source 2"
      ],
      "source": "https://en.wikipedia.org/wiki/Old_Hickory%2C_Tennessee"
    },
    {
      "id": 6,
      "text": "The Old Hickory Post Office earned a spot on the National Register of Historic Places in 1985, highlighting its architectural significance.",
      "sourceSentenceIds": [
        17
      ],
