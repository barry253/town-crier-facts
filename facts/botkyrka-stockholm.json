  "facts": [
    {
      "id": 1,
      "text": "Botkyrka named after 12th-century missionary Saint Botvid, whose axe and fish appear on the coat of arms.",
      "sourceSentenceIds": [
        3,
        12
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Botkyrka_Municipality",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The medieval Botkyrka Church, built of stone, stands where Saint Botvid was martyred in 1120 and became a pilgrimage site.",
      "sourceSentenceIds": [
        5,
        6
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Botkyrka_Municipality",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "In 1568, a battle between John III, Duke Charles, and Eric XIV took place in Botkyrka, ending with Eric XIV’s victory.",
      "sourceSentenceIds": [
        21,
        22
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Botkyrka_Municipality",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The railway station in Tumba, opened mid‑19th century, sparked industrial growth and drew workers to the area.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/Botkyrka_Municipality",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Botkyrka hosts the historic Hågelby gård, once owned by Ericsson founder Lars Magnus Ericsson, now a conference and heritage site.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Botkyrka_Municipality",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The municipality’s multicultural character is highlighted by a large Syriac Orthodox Church in Hallunda and a mosque in Fittja.",
      "sourceSentenceIds": [
