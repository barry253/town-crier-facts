  "facts": [
    {
      "id": 1,
      "text": "Sloten hosted the rowing competitions in the 1928 Amsterdam Summer Olympics that drew international crowds.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Sloten%2C_Amsterdam"
    },
    {
      "id": 2,
      "text": "Absorbed into Amsterdam in 1921, Sloten became the city’s oldest part, founded in 990.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Sloten%2C_Amsterdam"
    },
    {
      "id": 3,
      "text": "Sloten still boasts an active town crier, Pieter Haringsma, echoing its fortified past.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.waterlandvanfriesland.nl/en/sloten"
    },
    {
      "id": 4,
      "text": "Every year, residents celebrate Sipelsneon, an onion‑Saturday market that keeps the village’s nickname alive.",
      "sourceSentenceIds": [
        4,
        19
      ],
      "sourceLabels": [
        "Web source 1",
        "Web source 2"
      ],
      "source": "https://www.waterlandvanfriesland.nl/en/sloten"
    },
    {
      "id": 5,
      "text": "The Rembrandt Sloten Windmill museum, housed in a working windmill, showcases Dutch milling heritage.",
      "sourceSentenceIds": [
        14
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Sloten%2C_Amsterdam"
    },
    {
      "id": 6,
      "text": "The late‑Gothic Protestant church, built in 1647, stands where St. John’s Chapel once did.",
