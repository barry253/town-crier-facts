  "facts": [
    {
      "id": 1,
      "text": "Gowanus Canal was completed in 1869, turning a natural creek into a navigable waterway for barges and factories.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.cityneighborhoods.nyc/gowanus",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The canal’s tidal flow was sealed off, turning it into a stagnant sewer filled with runoff from tanneries, gas plants, cement works, and chemical factories.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.cityneighborhoods.nyc/gowanus",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "From 1883 to 1891 Washington Park Stadium in Gowanus hosted the Brooklyn Baseball Club, known as the Dodgers.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.citysignal.com/gowanus-brooklyn-neighborhood-guide/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Artists began occupying abandoned factories in the 1970s, turning them into pottery studios, recording spaces, printshops, and art collectives, making Gowanus a creative hub.",
      "sourceSentenceIds": [
        13,
        14,
        15
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.cityneighborhoods.nyc/gowanus",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The “Bat Cave,” an eight‑story building once used to burn coal, is now a landmark owned by the Powerhouse Environmental Arts Foundation and has landmark status.",
      "sourceSentenceIds": [
        21
      ],
