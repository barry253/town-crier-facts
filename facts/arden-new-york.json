  "facts": [
    {
      "id": 1,
      "text": "Arden began as Greenwood, settled in the early 1800s for iron mining, drawing workers to Orange County’s ore-rich hills.",
      "sourceSentenceIds": [
        1,
        6
      ],
      "sourceLabels": [
        "Web source 2",
        "Wikipedia"
      ],
      "source": "https://grokipedia.com/page/arden_new_york",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The Greenwood Furnace, erected in 1810 by James Cunningham, supplied cannonballs to American forces during the War of 1812.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/arden_new_york",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "During the Civil War, the same furnace forged iron for the famed Parrott gun that helped secure Union victories.",
      "sourceSentenceIds": [
        17,
        24
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Arden%2C_New_York",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Railroad magnate Edward Henry Harriman began buying the Arden Estate in 1885, preserving about 8,000 acres from logging and development.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/arden_new_york",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The Arden Estate earned National Historic Landmark status in 1966, celebrated for its distinctive architecture and historical significance.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/arden_new_york",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "In 1886, as iron waned, Harriman turned much of the estate into Arden Farms, a dairy that supplied New York for 80 years.",
      "sourceSentenceIds": [
        26,
        27
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.tuxedohistory.org/arden",
      "category": "history",
      "quality": "good"
    }
