      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Scotland%2C_Virginia",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Two historic plantations, Pleasant Point and Swann's Point, lie nearby and are listed on the National Register of Historic Places.",
      "sourceSentenceIds": [
