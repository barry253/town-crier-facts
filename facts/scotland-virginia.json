  "facts": [
    {
      "id": 1,
      "text": "Scotland sits on the James River and serves as a ferry terminal for travelers heading to Virginia's Historic Triangle.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Scotland%2C_Virginia"
    },
    {
      "id": 2,
      "text": "The town once hosted a narrow‑gauge railroad that ran from Dendron, making it a former rail hub.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Scotland%2C_Virginia"
    },
    {
      "id": 3,
      "text": "Two historic plantations, Pleasant Point and Swann's Point, lie nearby and are listed on the National Register of Historic Places.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Scotland%2C_Virginia"
    },
    {
      "id": 4,
      "text": "Replicas of the three ships that carried Jamestown settlers—Susan Constant, Godspeed, and Discovery—can be seen docked near Glasshouse Point, just north of Scotland’s ferry stop.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Scotland%2C_Virginia"
    },
    {
      "id": 5,
      "text": "Scotland’s geographic coordinates are 37.1838° N, 76.7863° W, placing it in eastern Virginia’s Surry County.",
      "sourceSentenceIds": [
        15
      ],
      "sourceLabels": [
