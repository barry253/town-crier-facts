  "facts": [
    {
      "id": 1,
      "text": "Louviers was laid out by the DuPont Company in 1906 and named after the Delaware estate of the Du Pont family.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Louviers%2C_Colorado",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town grew around DuPont’s western dynamite factory, which began production in 1906 and closed in 1971.",
      "sourceSentenceIds": [
        6,
        25
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://thehrhs.org/2450-2/",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "A 1917 arts‑and‑crafts style Village Club House still stands, complete with one of Colorado’s oldest two‑lane bowling alleys.",
      "sourceSentenceIds": [
        23,
        24
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://thehrhs.org/2450-2/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Louviers’ original workers lived in 384‑square‑foot cottages built on railroad ties, while foremen occupied larger homes on Capitol Hill.",
      "sourceSentenceIds": [
        4,
        21
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.castlepinesconnection.com/louviers-colorados-only-bonafide-boom-town/",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "In 1999, the entire community was designated a National Historic District, preserving its early 20th‑century industrial heritage.",
      "sourceSentenceIds": [
        25
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://thehrhs.org/2450-2/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The Highlands Ranch Historical Society hosts annual tours of Louviers, where volunteers called Wranglers guide visitors through the historic town site.",
      "sourceSentenceIds": [
        1,
        5
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://thehrhs.org/2450-2/",
      "category": "culture",
      "quality": "good"
    }
