  "facts": [
    {
      "id": 1,
      "text": "Blue Diamond started as a company town built by a wallboard manufacturer in 1942 on the leased Cottonwood Ranch.",
      "sourceSentenceIds": [
        1,
        28
      ],
      "sourceLabels": [
        "Web source 1",
        "Wikipedia"
      ],
      "source": "https://historiclasvegasproject.com/post/801224985524994048/blue-diamond"
    },
    {
      "id": 2,
      "text": "The town’s mercantile, built in 1942, still keeps its original exterior and displays historic photos from the Blue Diamond Historical Society.",
      "sourceSentenceIds": [
        3,
        5,
        25
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Blue_Diamond%2C_Nevada"
    },
    {
      "id": 3,
      "text": "Blue Diamond sits on Cottonwood Spring, a historic watering spot on the Old Spanish Trail and later the Mormon Road.",
      "sourceSentenceIds": [
        26
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Blue_Diamond%2C_Nevada"
    },
    {
      "id": 4,
      "text": "The town’s name evolved from Cottonwood Springs to Blue Diamondville in 1942, and the post office adopted the Blue Diamond name that year.",
      "sourceSentenceIds": [
        29
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Blue_Diamond%2C_Nevada"
    },
    {
      "id": 5,
      "text": "Blue Diamond’s historic crest includes a 2014 listing on the Nevada State Register of Historic Places and a 2009 National Register sign marking its heritage.",
