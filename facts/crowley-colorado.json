      "quality": "good"
    },
    {
      "id": 2,
      "text": "The Crowley County Heritage Center, a former school from 1914 to 1992, became a state historical property in 1993 and joined the National Historic list in 1999.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Web source 2"
      ],
