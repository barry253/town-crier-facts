  "facts": [
    {
      "id": 1,
      "text": "Purdy was platted in 1885 and named after Ernest Purdy, a Tacoma grocer who donated lumber for the town’s first schoolhouse.",
      "sourceSentenceIds": [
        2,
        3
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/purdy_washington",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The Purdy Bridge, the fourth iteration, stretches 550 feet with a 190‑foot central span and earned a spot on the National Register for its rigid‑frame design.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/purdy_washington",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Burley Lagoon and Henderson Bay sit on Purdy’s shores, separated by a sandspit that the Purdy Bridge crosses.",
      "sourceSentenceIds": [
        10,
        11
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Purdy%2C_Washington",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The original schoolhouse, donated by Horace Knapp, was abandoned in the 1890s after a second building replaced it in 1900.",
      "sourceSentenceIds": [
        5,
        28
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Purdy%2C_Washington",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Japanese oysters and clams are still cultivated on Purdy’s sandbars and in Burley Lagoon, a tradition that began with early oyster canners.",
      "sourceSentenceIds": [
