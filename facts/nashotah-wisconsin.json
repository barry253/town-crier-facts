      "id": 1,
      "text": "Nashotah is home to the Red Circle Inn, which is the oldest restaurant in the state of Wisconsin.",
      "sourceSentenceIds": [
        25,
        30
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Nashotah%2C_Wisconsin"
    },
    {
      "id": 2,
      "text": "The Red Circle Inn was founded in 1848 on the Watertown Plank Road as a resting place for stagecoaches.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Nashotah%2C_Wisconsin"
    },
    {
      "id": 3,
      "text": "The Pabst Brewing family bought the Red Circle Inn in 1889 for summer guests staying at nearby lake mansions.",
      "sourceSentenceIds": [
        26
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Nashotah%2C_Wisconsin"
    },
    {
      "id": 4,
      "text": "The Nashotah train station on Rasmus Road was originally known as the Pine Lake Station until 1875.",
      "sourceSentenceIds": [
