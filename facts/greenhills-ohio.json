  "facts": [
    {
      "id": 1,
      "text": "Greenhills was built by the U.S. government during the Great Depression as one of three New Deal greenbelt communities.",
      "sourceSentenceIds": [
        21,
        22
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Greenhills%2C_Ohio",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The village’s original townhomes were designed in the International style and still house many third‑ and fourth‑generation families.",
      "sourceSentenceIds": [
        23
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Greenhills%2C_Ohio",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "In 2017, the Greenhills Historic District was declared a National Historic Landmark, covering about three‑quarters of the village.",
      "sourceSentenceIds": [
        1,
        11,
        12,
        13
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Greenhills%2C_Ohio",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Greenhills began as a federally managed “sundown town” that used restrictive covenants to keep minorities out of the community.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Greenhills%2C_Ohio",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The village’s radial layout and community facilities were preserved when it transitioned to private ownership in the 1950s and incorporated in 1961.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/greenhills_ohio",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The James Whallon House, now the village hall, is listed on the National Register of Historic Places and reflects Greenhills’ early architectural heritage.",
      "sourceSentenceIds": [
        18
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Greenhills%2C_Ohio",
      "category": "landmark",
      "quality": "good"
