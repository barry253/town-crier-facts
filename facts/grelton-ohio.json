  "facts": [
    {
      "id": 1,
      "text": "Grelton was founded in 1881 when the Cloverleaf Railroad arrived, and its name honored landowner Alexander Grelle, dropping one 'l' from the original spelling.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/grelton_ohio",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town sits at the four‑corner junction of Monroe, Richfield, Harrison, and Damascus townships, a crossroads that helped it grow.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/grelton_ohio",
      "category": "other",
      "quality": "poor",
      "qualityReason": "location_description"
    },
    {
      "id": 3,
      "text": "Early economy was driven by timber; sawmills and barrel‑stave factories processed oak, walnut, and poplar for Canadian shipbuilders.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/grelton_ohio",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The Grelton Cemetery, started in 1893 on a five‑acre Noah Jackson donation, now spans 40 acres and hosts walking paths.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/grelton_ohio",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "A veterans memorial in the cemetery honors local military service, reflecting the community’s long‑standing patriotism.",
      "sourceSentenceIds": [
        19
