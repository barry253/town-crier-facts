      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Somerdale sits along State Route 212, beside Conotton Creek, and near the historic Wheeling and Lake Erie Railway.",
      "sourceSentenceIds": [
        4,
        10
      ],
      "sourceLabels": [
        "Wikipedia",
