      "id": 1,
      "text": "Smoketown earned its name from the many smoke‑producing kilns that fired bricks in the 1800s.",
      "sourceSentenceIds": [
        20,
        4
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Smoketown%2C_Louisville",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The neighborhood sits one mile southeast of downtown Louisville, bounded by Broadway, CSX tracks, Kentucky Street, and I‑65.",
      "sourceSentenceIds": [
        10,
        19
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Smoketown%2C_Louisville",
      "category": "other",
      "quality": "poor",
      "qualityReason": "location_description"
    },
    {
      "id": 3,
      "text": "In 1865 a streetcar line reached Smoketown, spurring growth after the Civil War.",
      "sourceSentenceIds": [
        22
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Smoketown%2C_Louisville",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The area once housed one of Louisville’s first African‑American public schools, founded in 1874.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://history.ky.gov/markers/smoketown",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Shelby Park, a 16‑acre green space designed by Frederick Law Olmsted, anchors the Smoketown and Shelby Park neighborhoods.",
      "sourceSentenceIds": [
        2
      ],
