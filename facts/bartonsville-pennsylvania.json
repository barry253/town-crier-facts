  "facts": [
    {
      "id": 1,
      "text": "Bartonsville was founded in 1831 when Colonel Joseph Benjamin Barton opened a hotel and post office along the Easton‑Belmont Turnpike.",
      "sourceSentenceIds": [
        1,
        4,
        6
      ],
      "sourceLabels": [
        "Web source 1",
        "Wikipedia"
      ],
      "source": "https://monroecountypa.com/communities/bartonsville",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "In the 19th century the village supported a grist mill, tannery, creamery, dance hall, and even a brass band.",
      "sourceSentenceIds": [
        10,
        12
      ],
      "sourceLabels": [
        "Web source 1",
        "Web source 2"
      ],
      "source": "https://monroecountypa.com/communities/bartonsville",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Bartonsville sits on the historic Easton‑Belmont Turnpike, a key stagecoach route that linked Pennsylvania’s eastern and western regions.",
      "sourceSentenceIds": [
        1,
        4
      ],
      "sourceLabels": [
        "Web source 1",
        "Wikipedia"
      ],
      "source": "https://monroecountypa.com/communities/bartonsville",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The community spans parts of Hamilton, Pocono, Jackson, and Stroud townships, making it one of the few villages that crosses multiple municipal boundaries.",
      "sourceSentenceIds": [
        27
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://monroecountypa.com/communities/bartonsville",
      "category": "other",
      "quality": "poor",
      "qualityReason": "other"
    },
    {
      "id": 5,
      "text": "A lively dance hall and brass band once entertained locals, while a baseball team kept the town’s spirit alive in the early 1900s.",
      "sourceSentenceIds": [
        7,
        12
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 2"
      ],
      "source": "https://en.wikipedia.org/wiki/Bartonsville%2C_Pennsylvania",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Today Bartonsville functions as a suburban bedroom community, with retail and hospitality businesses serving both residents and Pocono tourists.",
      "sourceSentenceIds": [
        20,
        22
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
