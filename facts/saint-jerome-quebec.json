  "facts": [
    {
      "id": 1,
      "text": "Saint‑Jérôme was founded in 1834 by Barthélemy Joliette and named after Saint Jerome, the patron saint of translators and librarians.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.trawellino.com/destinations/canada/quebec_saint-jerome",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "In 1876, a railway reached Saint‑Jérôme, spurred by priest Antoine Labelle who championed the line to bring firewood and construction materials to Montreal.",
      "sourceSentenceIds": [
        24,
        29,
        30
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Saint-J%C3%A9r%C3%B4me",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The town’s first rubber factory opened in 1911, later becoming Dominion Rubber in 1926 and UNIROYAL LTD in 1966, marking a long industrial legacy.",
      "sourceSentenceIds": [
        3,
        4
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Saint-J%C3%A9r%C3%B4me",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Saint‑Jérôme hosts the Musée d’art contemporain des Laurentides, a modern art museum that also houses a small museum inside the Roman Catholic cathedral.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Saint-J%C3%A9r%C3%B4me",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The Saint‑Jérôme Panthers, a junior AAA hockey team, began playing in 1990‑91, reflecting the town’s passion for ice sports.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Saint-J%C3%A9r%C3%B4me",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The Saint‑Jérôme train station, upgraded in 2013 with double‑track and ATC, now serves all trains and connects the town to Greater Montreal.",
      "sourceSentenceIds": [
        11
      ],
