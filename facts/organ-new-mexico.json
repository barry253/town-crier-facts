  "facts": [
    {
      "id": 1,
      "text": "Organ was founded in 1884, drawing about 250 prospectors who quickly built saloons, a church, a schoolhouse, smelters, stores, and a tunnel jail.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/organ_new_mexico"
    },
    {
      "id": 2,
      "text": "After White Sands Missile Range opened in 1945, Organ revived as a home and leisure hub for military personnel and contractors.",
      "sourceSentenceIds": [
        2,
        4
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Organ%2C_New_Mexico"
    },
    {
      "id": 3,
      "text": "At about 5,000 feet, Organ swings from 95‑100°F in summer to below 20°F in winter.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/organ_new_mexico"
    },
    {
      "id": 4,
      "text": "Mining collapsed in the 1930s when shafts flooded and the Great Depression hit, leaving ghost town remnants amid modern development.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/organ_new_mexico"
    },
    {
      "id": 5,
      "text": "Old mining left subtle scars like tailing piles and adits that still mark the surrounding hillsides.",
      "sourceSentenceIds": [
        13
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/organ_new_mexico"
    },
    {
      "id": 6,
      "text": "Organ began as a mining camp before the Civil War, long before it was officially established in 1883.",
      "sourceSentenceIds": [
        16
