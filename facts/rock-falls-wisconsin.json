  "facts": [
    {
      "id": 1,
      "text": "Rock Falls was formally established in 1857 and named for a prominent 18-foot waterfall on Rock Creek.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/rock_falls_dunn_county_wisconsin"
    },
    {
      "id": 2,
      "text": "The ancestral lands of Rock Falls were originally used by Native American tribes, including the Ho-Chunk and Ojibwe.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/rock_falls_dunn_county_wisconsin"
    },
    {
      "id": 3,
      "text": "Early industries in Rock Falls included a creamery, an implement dealer, and a pickle factory during the late 19th century.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/rock_falls_dunn_county_wisconsin"
    },
    {
      "id": 4,
      "text": "Rock Creek flows northward through the area into the Chippewa River, shaping the local woodlands and wetlands.",
      "sourceSentenceIds": [
        30
      ],
      "sourceLabels": [
