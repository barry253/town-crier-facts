  "facts": [
    {
      "id": 1,
      "text": "Glendora hosts the Cookie Jar House, a 1940s home famed as one of New Jersey’s oddest residences.",
      "sourceSentenceIds": [
        20
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Glendora%2C_New_Jersey",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The 1756 Gabreil Daveis Tavern, now a historic landmark, once served watermen traveling along Timber Creek.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://glotwp.com/information/history-of-gloucester-township-nj/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Every month, volunteers from the Historic and Scenic Preservation Committee guide free tours of the tavern, sharing its colonial past.",
      "sourceSentenceIds": [
        2,
        12
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://glotwp.com/information/history-of-gloucester-township-nj/",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "During tavern tours, visitors can watch cannon demonstrations, blacksmithing, and even participate in children’s musket drills.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://glotwp.com/information/history-of-gloucester-township-nj/",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The tavern’s restoration preserved a small but visible part of the region’s unique cultural heritage.",
      "sourceSentenceIds": [
        9
