  "facts": [
    {
      "id": 1,
      "text": "Middleton earned its name by sitting midway between Old Fort Boise and Keeney’s Ferry, a key rest stop for travelers.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Middleton%2C_Idaho",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Founded in the 1860s, Middleton was a vital midway stop for pioneers journeying between Boise and the Snake River.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.43re.com/middleton-idaho",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "In 1872, a Boise River flood carved a new channel that left Middleton isolated on an island, prompting its relocation after 1880.",
      "sourceSentenceIds": [
        14,
        15
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Middleton%2C_Idaho",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The Lee Moberly Museum preserves Middleton’s history and hosts an annual Quilt Show every May.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://leemoberlymuseum.org/",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Every February, the Middleton Historical Society meets at the United Methodist Church for its annual gathering.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://leemoberlymuseum.org/",
      "category": "people",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Middleton is the oldest settlement in Canyon County, with its land first parceled out in 1863 by William N. Montgomery.",
