  "facts": [
    {
      "id": 1,
      "text": "Thayne sits in the northern portion of Wyoming's grassy Star Valley, close to the Salt River.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Thayne%2C_Wyoming"
    },
    {
      "id": 2,
      "text": "Pioneers in the late 1870s followed the Salt River through the hills to settle in the Lower Star Valley.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.starvalleyhistoricalsociety.org/Thayne/"
    },
    {
      "id": 3,
      "text": "Thayne is nestled on the Wyoming and Idaho border, surrounded by the Bridger Teton, Caribou, and Targhee national forests.",
      "sourceSentenceIds": [
        18
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://thayne-wy.com/visitors/about-thayne/"
    },
    {
      "id": 4,
      "text": "The Salt River winds past the western edge of Thayne, providing opportunities for fishing, boating, and inner tube trips.",
      "sourceSentenceIds": [
        20
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://thayne-wy.com/visitors/about-thayne/"
    },
    {
      "id": 5,
      "text": "Thayne hosts cutter racing during the winter months.",
      "sourceSentenceIds": [
        24
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://thayne-wy.com/visitors/about-thayne/"
    },
    {
      "id": 6,
      "text": "Thayne is known as a patriotic community that holds some of the best parades and celebrations in the area.",
