  "facts": [
    {
      "id": 1,
      "text": "Bath was granted in 1761 by Governor Benning Wentworth and named after William Pulteney, 1st Earl of Bath.",
      "sourceSentenceIds": [
        11
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Bath%2C_New_Hampshire",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town sits at the head of navigation on the Connecticut River, shielded by the Green and White Mountains, making it a historic trade hub.",
      "sourceSentenceIds": [
        20
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Bath%2C_New_Hampshire",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The White Mountains Railroad opened in 1853, shipping Bath's lumber, potatoes, livestock, and wood pulp to distant markets.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Bath%2C_New_Hampshire",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The Brick Store, built in 1824 by Alexander Parris, dominated the town center until its closure in 2020.",
      "sourceSentenceIds": [
        27
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Bath%2C_New_Hampshire",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The Swiftwater Covered Bridge, the longest in New Hampshire, spans the Ammonoosuc River and nearby Big Eddy Swimming Hole is a local summer favorite.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://localnh.com/towns/bath",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "A disastrous fire in 1872 destroyed Bath's Congregational church and Bath Hotel, but the church was rebuilt in 1873, preserving the town's historic character.",
      "sourceSentenceIds": [
        23,
