      ],
      "source": "https://en.wikipedia.org/wiki/Greencastle%2C_Pennsylvania",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "In 1845, Sidney Rigdon brought a group of Latter Day Saints to Greencastle, forming a short‑lived Rigdonite settlement.",
      "sourceSentenceIds": [
