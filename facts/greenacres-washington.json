  "facts": [
    {
      "id": 1,
      "text": "Greenacres was planned in 1901 as a fruit‑raising community, not a mining town, with irrigation promised from Liberty Lake.",
      "sourceSentenceIds": [
        28
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.spokesman.com/stories/2020/jan/06/then-and-now-greenacres-washington/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The Greenacres Shopping Center, a crescent of shops along East Appleway, served as the commercial heart of the unincorporated community since the 1920s.",
      "sourceSentenceIds": [
        2,
        27
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.spokesman.com/stories/2020/jan/06/then-and-now-greenacres-washington/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "In 1903 the developers lured the Spokane and Inland Empire electric railway through their land, linking Greenacres to the regional rail network.",
      "sourceSentenceIds": [
        29
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.spokesman.com/stories/2020/jan/06/then-and-now-greenacres-washington/",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Greenacres hosts a heritage program that showcases historic images and Q&A about its early ties to Liberty Lake, highlighting how the two communities shaped each other.",
      "sourceSentenceIds": [
        4,
        6
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.spokanevalleymuseum.com/event/greenacres-liberty-lake-historic-connections/",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The community’s own post office remains a local landmark, keeping the Greenacres name alive within the larger Spokane Valley area.",
