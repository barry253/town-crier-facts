  "facts": [
    {
      "id": 1,
      "text": "Twin Groves earned its name when the neighboring communities of Solomon Grove and Zion Grove joined together in 1991.",
      "sourceSentenceIds": [
        13,
        24
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Twin_Groves%2C_Arkansas"
    },
    {
      "id": 2,
      "text": "Twin Groves follows the crest of Batesville Mountain, a low ridge that rises 300 feet above Cadron Creek to the south.",
      "sourceSentenceIds": [
        15
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Twin_Groves%2C_Arkansas"
    },
    {
      "id": 3,
      "text": "The Smith‑Hughes Building in Twin Groves began as a school and now serves as a community center and library.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.faulknerhistory.org/communities/twin-groves/"
    },
    {
      "id": 4,
      "text": "Solomon Grove, part of Twin Groves, was founded by free African‑Americans from Memphis before the Civil War.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.faulknerhistory.org/communities/twin-groves/"
    },
    {
      "id": 5,
      "text": "Silas Owens, Sr., a stonemason from Solomon Grove, crafted five buildings that now sit on the National Register of Historic Places.",
      "sourceSentenceIds": [
        4
