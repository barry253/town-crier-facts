      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Corolla shelters a herd of feral Banker horses, descendants of 16th‑century Spanish mustangs, on a 12,000‑acre sanctuary.",
      "sourceSentenceIds": [
