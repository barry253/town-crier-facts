  "facts": [
    {
      "id": 1,
      "text": "Woodside originated as a rural crossroads in the mid‑18th century, with buildings dating to 1765, now an affluent suburb preserving vernacular architecture.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/woodside_pennsylvania",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The Lenape first inhabited the area, using fertile lands near the Delaware River before European arrival.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/woodside_pennsylvania",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Quaker settlers fleeing persecution, families like the Yardleys, Houghes, and Palmers received 500‑acre grants that shaped early road patterns.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/woodside_pennsylvania",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Woodside once sat at the crossroads of Stony Hill Road and Yardley‑Langhorne Road, a stagecoach link between Philadelphia and New York.",
      "sourceSentenceIds": [
        22
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/woodside_pennsylvania",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "In 1979, preservation efforts earned Woodside a local historic district designation and a National Register of Historic Places listing.",
      "sourceSentenceIds": [
        27
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/woodside_pennsylvania",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "A fieldstone inn built by Jesse Palmer in 1765 once served travelers, now a historic landmark in Woodside.",
      "sourceSentenceIds": [
        23
