  "facts": [
    {
      "id": 1,
      "text": "Mixcoac means 'Place of the Cloud Serpent' in Nahuatl, alluding to the Milky Way and the god Mixcóatl.",
      "sourceSentenceIds": [
        19
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Mixcoac"
    },
    {
      "id": 2,
      "text": "The historic heart of Mixcoac, centered on its main square, still preserves the Glorieta de Goya roundabout and a statue of Álvaro Obregón.",
      "sourceSentenceIds": [
        6,
        2
      ],
      "sourceLabels": [
        "Wikipedia",
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Mixcoac"
    },
    {
      "id": 3,
      "text": "A former silk textile factory, the Antiguo Obraje de Mixcoac, now houses part of the Universidad Panamericana campus.",
      "sourceSentenceIds": [
        3,
        7
      ],
      "sourceLabels": [
        "Wikipedia",
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Mixcoac"
    },
    {
      "id": 4,
      "text": "Ruins of an early settlement, occupied from about 900 to 1521 AD, can be seen at the Mixcoac archaeological site.",
      "sourceSentenceIds": [
        21
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Mixcoac"
    },
    {
      "id": 5,
      "text": "Mixcoac station, served by metro lines 7 and 12, links the neighborhood directly to downtown Mexico City.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Mixcoac"
    },
    {
      "id": 6,
      "text": "Casa de la Campana, once the city hall built under Porfirio Díaz, now functions as a cultural center.",
      "sourceSentenceIds": [
