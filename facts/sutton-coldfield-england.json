  "facts": [
    {
      "id": 1,
      "text": "Sutton Coldfield earned its royal charter in 1528, becoming the first town in England to be granted a royal charter by Henry VIII.",
      "sourceSentenceIds": [
        13
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Sutton_Coldfield",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town’s name first appeared as Sutton‑in‑Coldfield in 1242 when the manor passed to Ela Longespee, the widow of the Earl of Warwick.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Sutton_Coldfield",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Bishop John Vesey, a native of Sutton Coldfield, arranged the construction of the town’s historic St. Mary's Church in the Tudor period.",
      "sourceSentenceIds": [
        27
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.sutton-coldfield.net/about-sutton-coldfield/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Sutton Coldfield’s local history is preserved by the Sutton Coldfield Local History Research Group, which maintains a collection of primary sources in the former town library.",
      "sourceSentenceIds": [
        23
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://sclhrg.org.uk/",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The Royal Sutton Coldfield Orchestra, founded in 1975, regularly hosts concerts that feature guest professional musicians.",
      "sourceSentenceIds": [
        22
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Sutton_Coldfield",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The town’s football club, Sutton Coldfield Town F.C., was established in 1879 and currently competes in the Northern Premier League.",
