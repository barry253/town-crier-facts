  "facts": [
    {
      "id": 1,
      "text": "Crete was formed in 1871 when two settlements merged, named after Crete, Illinois, the hometown of an early settler.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Crete%2C_Nebraska",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The railroad reached Crete in 1870, drawing settlers and making it a stop on the Chicago Burlington & Quincy line.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Crete%2C_Nebraska",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The town’s first permanent residents, Jesse and Elizabeth Bickle, built a log cabin in 1863 that doubled as the first post office.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.crete.ne.gov/vnews/display.v/SEC/Living%20in%20Crete%7CAbout%20Crete%2C%20Nebraska%3E%3ECrete%20History",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Crete’s downtown streets, officially 13th Street, showcase classic midwestern storefronts with warm amber brick facades that glow in the afternoon sun.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 2"
