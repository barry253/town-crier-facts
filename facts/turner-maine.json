  "facts": [
    {
      "id": 1,
      "text": "Turner, Maine, was granted in 1690 to Captain Joseph Sylvester for his service in King William's War, and was first called Sylvester‑Canada.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/turner_maine",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "In 1786, Sylvester‑Canada was renamed for Reverend Charles Turner and incorporated, becoming an agricultural community that grew corn, apples, and early manufacturing.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/turner_maine",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Turner’s 19th‑century chair industry, led by the North Turner Chair Factory—rebuilt in 1886 as the Washburn Chair Company—pioneered willow chair production in Maine.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/turner_maine",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Samuel Blake built Turner’s first sawmill and gristmill on the Nezinscot River in 1775; it was destroyed by a freshet in 1785 and rebuilt the next year.",
      "sourceSentenceIds": [
        29,
        30
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Turner%2C_Maine",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Turner’s historic buildings and landmarks, many listed on the National Register of Historic Places, showcase the town’s rich architectural heritage.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://winslowmaine.org/turner-maine-exploring-the-charm-beauty-and-rich-history-of-the-pine-tree-state-s-hidden-gem",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Turner encompasses the villages of Turner, Turner Center, and North Turner, each reflecting different aspects of the town’s rural character.",
      "sourceSentenceIds": [
        19
