  "facts": [
    {
      "id": 1,
      "text": "Bayswater’s name comes from the 1380 placename “Bayards Watering Place,” meaning a horse watering spot or one belonging to the Bayard family.",
      "sourceSentenceIds": [
        21
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Bayswater",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Historically, Bayswater lay west of Westminster on the road from Tyburn toward Uxbridge, long before it became part of the city.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Bayswater",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The area is famous for its Victorian stucco terraces, many of which have been subdivided into flats over the years.",
      "sourceSentenceIds": [
        18
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Bayswater",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "In the late 19th century, Bayswater welcomed thriving Greek and Jewish communities, each building now Grade I listed places of worship.",
      "sourceSentenceIds": [
        27
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Bayswater",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The Alfred Hitchcock film *Frenzy* was shot in Bayswater, giving the neighborhood a touch of cinematic history.",
