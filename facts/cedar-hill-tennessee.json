  "facts": [
    {
      "id": 1,
      "text": "The Louisville & Nashville Railroad arrived in 1858, turning Cedar Hill into a rail hub after locals built a depot on donated land.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/cedar_hill_tennessee",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Cedar Hill earned its name in the mid‑19th century, likely from the cedar trees that lined the surrounding hills.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/cedar_hill_tennessee",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Officially founded in 1870 by a Tennessee General Assembly act, Cedar Hill grew around its agricultural roots and a city‑hall museum.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/cedar_hill_tennessee",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "City Hall doubles as Cedar Hill’s museum, preserving local history and artifacts for residents and visitors alike.",
      "sourceSentenceIds": [
        16
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.cityofcedarhill.org/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "For decades, tobacco was Cedar Hill’s main crop, supporting a service economy that catered to surrounding farmers.",
      "sourceSentenceIds": [
        19
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Cedar_Hill%2C_Tennessee",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The historic Wessyngton Plantation, once a dark‑fired tobacco farm, remained a family operation until the 1950s.",
