    },
    {
      "id": 2,
      "text": "Colonel Daniel Keating Norris founded the town after relocating to the upstate region in the late nineteenth century.",
      "sourceSentenceIds": [
        4,
        22
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/norris_south_carolina"
    },
    {
      "id": 3,
      "text": "The town of Norris grew from a rail siding originally known as Bowen's Sidetrack before being renamed Norris Station.",
      "sourceSentenceIds": [
        1,
        2
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/norris_south_carolina"
    },
    {
      "id": 4,
      "text": "Colonel Norris established Pickens County's first cotton mill along the Twelve Mile River in 1896.",
      "sourceSentenceIds": [
        2,
        22
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/norris_south_carolina"
    },
    {
      "id": 5,
      "text": "Local folklore tells of Cateechee, a Cherokee maiden who warned colonial settlers of an impending attack during the Anglo-Cherokee War.",
