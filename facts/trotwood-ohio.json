  "facts": [
    {
      "id": 1,
      "text": "Trotwood was originally called Higgins Station and was officially platted in 1854.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Trotwood%2C_Ohio",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Amos Higgins saw a commercial opportunity and built a railway station, tavern, and inn just west of Main Street.",
      "sourceSentenceIds": [
        1,
        22
      ],
      "sourceLabels": [
        "Web source 2",
        "Web source 1"
      ],
      "source": "https://www.trotwoodchamber.org/history.php",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The village’s first planned development happened in 1898 when Robert Pleasant and Nathan Worley platted the town, later naming streets after them.",
      "sourceSentenceIds": [
        5,
        6
      ],
      "sourceLabels": [
        "Web source 1",
        "Web source 2"
      ],
      "source": "https://trotwood.org/community/trotwood-historical-society/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The Iams House, built in 1847, now houses the Trotwood-Madison Historical Society and was once the family home of the pet‑food empire’s matriarch.",
      "sourceSentenceIds": [
        10,
        16
      ],
      "sourceLabels": [
        "Web source 1",
        "Web source 2"
      ],
      "source": "https://trotwood.org/community/trotwood-historical-society/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Trotwood incorporated as a village in 1901 from parts of Madison Township and merged with the township in 1996 to form a single city.",
      "sourceSentenceIds": [
        27
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
