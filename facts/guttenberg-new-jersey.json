  "facts": [
    {
      "id": 1,
      "text": "Guttenberg became an independent town on March 9, 1859, carved out of North Bergen Township.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Guttenberg%2C_New_Jersey",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town’s name honors Johannes Gutenberg, the printing‑press inventor, though some say it means “good village” in German.",
      "sourceSentenceIds": [
        14
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Guttenberg%2C_New_Jersey",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Back in the late 1800s, the White Brewery stood where the Galaxy Towers now rise, hosting a beer garden, dance hall, and sporting club.",
      "sourceSentenceIds": [
        3,
        5
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.guttenbergnj.org/News/View/8454/library-historian-michael-maring-leads-a-fascinating-history-tour-of-guttenberg",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The Galaxy Towers, three octagonal skyscrapers built in the late 1970s, rise 415 feet and house 1,075 apartments.",
      "sourceSentenceIds": [
        15,
        16
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Guttenberg%2C_New_Jersey",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Local historian Michael Maring gives monthly talks at the North Bergen Public Library, sharing Guttenberg’s rich history.",
      "sourceSentenceIds": [
        4,
        7
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.guttenbergnj.org/News/View/8454/library-historian-michael-maring-leads-a-fascinating-history-tour-of-guttenberg",
      "category": "people",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Guttenberg sits atop the Hudson Palisades, just south of Woodcliff and north of West New York, bordering Manhattan across the Hudson River.",
