  "facts": [
    {
      "id": 1,
      "text": "Before European settlers, the land that is now Sharon belonged to the Sisseton and Wahpeton Dakota Sioux, who hunted bison and set up seasonal camps through the mid‑1800s.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/sharon_north_dakota",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Sharon was officially founded in 1896 after being platted the year before by Iver Storland.",
      "sourceSentenceIds": [
        2,
        3
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/sharon_north_dakota",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The town was incorporated as a village on August 23, 1909, giving it formal municipal status.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/sharon_north_dakota",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The 1851 Treaty of Traverse des Sioux and the 1862 Dakota War displaced many Native Americans to reservations, opening the area for non‑Native homesteading.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/sharon_north_dakota",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Between 1878 and 1890, the Great Dakota Boom drew immigrants from eastern U.S., Scandinavia, and Canada to the Red River Valley, making Steele County a settlement zone.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/sharon_north_dakota",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Steele County, where Sharon lies, was formed in 1883 from parts of Griggs and Traill counties.",
      "sourceSentenceIds": [
