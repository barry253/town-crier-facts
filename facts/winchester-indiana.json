    {
      "id": 1,
      "text": "Winchester, Indiana, was named after Winchester, Virginia, when early settlers donated land for the county seat in 1818.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Winchester%2C_Indiana",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "During Indiana's Gas Boom, Winchester's natural gas fueled glass factories, turning the town into a regional glass‑making hub.",
      "sourceSentenceIds": [
        2,
        13,
        14
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Winchester%2C_Indiana",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "In the mid‑1800s, Winchester hosted Underground Railroad stops, with free African‑American settlements and churches aiding escaped slaves.",
      "sourceSentenceIds": [
        4,
        5
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Winchester%2C_Indiana",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Winchester Speedway, a quarter‑mile oval, draws racing fans each year and is a staple of local culture.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Winchester%2C_Indiana",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The Asahel Stone Mansion, Winchester Courthouse Square Historic District, and Winchester Residential Historic District are all listed on the National Register of Historic Places.",
      "sourceSentenceIds": [
        15
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Winchester%2C_Indiana",
      "category": "landmark",
      "quality": "good"
    },
