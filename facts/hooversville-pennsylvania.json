  "facts": [
    {
      "id": 1,
      "text": "Hooversville was founded in 1836 by Jonas Hoover, a farmer who ran a gristmill and sawmill on Hoover Street in 1847.",
      "sourceSentenceIds": [
        9,
        13
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Hooversville%2C_Pennsylvania"
    },
    {
      "id": 2,
      "text": "The town’s name comes from its founder, Jonas Hoover, who bought land from Casper Ripple’s heirs in 1834.",
      "sourceSentenceIds": [
        11
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Hooversville%2C_Pennsylvania"
    },
    {
      "id": 3,
      "text": "Jonas Hoover also served as a justice of the peace from 1852 to 1862, helping shape early local governance.",
      "sourceSentenceIds": [
        14
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Hooversville%2C_Pennsylvania"
    },
    {
      "id": 4,
      "text": "The Hooversville Area Historic Society Museum, located at 100 Church Street, opens first Saturday of each month from 8 to 10 a.m. by appointment.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://thenewpittsburghexposition.org/directory-content/hooversville-area-historic-society"
    },
    {
      "id": 5,
      "text": "Hooversville sits on the eastern edge of Quemahoning Township, bordering Shade Township, at coordinates 40.149267, -78.914062.",
      "sourceSentenceIds": [
        18
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Hooversville%2C_Pennsylvania"
    },
    {
      "id": 6,
      "text": "The German Reformed Church, co‑founded by Jonas Hoover and David Crissey, reflects the town’s early religious heritage.",
      "sourceSentenceIds": [
        15
