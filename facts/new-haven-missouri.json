  "facts": [
    {
      "id": 1,
      "text": "New Haven was originally called Miller's Landing, founded in 1836 by Philip Miller who supplied wood to steamboats on the Missouri River.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://aboutstlouis.com/local/day-trips/historic-new-haven-missouri"
    },
    {
      "id": 2,
      "text": "The town began as a riverboat stop along the Missouri River, becoming a key stop for steamboats traveling up and down the river.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://aboutstlouis.com/local/day-trips/historic-new-haven-missouri"
    },
    {
      "id": 3,
      "text": "The historic Mercantile building, built in 1872, now houses the Riverfront Cultural Society and was once the town’s general store.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://aboutstlouis.com/local/day-trips/historic-new-haven-missouri"
    },
    {
      "id": 4,
      "text": "A residential area on Maupin Avenue and Wall Street is listed on the National Register of Historic Places, showcasing 19th‑century architecture.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://aboutstlouis.com/local/day-trips/historic-new-haven-missouri"
    },
    {
      "id": 5,
      "text": "New Haven sits within the Hermann AVA and the Missouri Rhineland, making it part of a celebrated wine‑growing region.",
      "sourceSentenceIds": [
        14
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/New_Haven%2C_Missouri"
    },
    {
      "id": 6,
      "text": "The town’s public library is a branch of the Scenic Regional Library system, serving as a community hub.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/New_Haven%2C_Missouri"
