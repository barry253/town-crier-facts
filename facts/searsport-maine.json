  "facts": [
    {
      "id": 1,
      "text": "Searsport was named after David Sears of Boston, who funded its founding.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Searsport%2C_Maine",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Settled in the 1760s, Searsport became an incorporated town on February 13, 1845, carved from Prospect and Belfast.",
      "sourceSentenceIds": [
        18
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Searsport%2C_Maine",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "In the 19th century, Searsport’s 17 shipyards built 200 vessels, supplying a tenth of the U.S. deep‑water merchant captains per square mile.",
      "sourceSentenceIds": [
        20
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Searsport%2C_Maine",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The Penobscot Marine Museum spans a campus of historic sea‑captain homes, showcasing maritime art, ship models, and navigation tools.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://mainesociety.com/towns/searsport/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Searsport ranks Maine’s second‑largest deep‑water port and served as the Penobscot Bay terminus for the Northern Seaport Railroad, which shipped timber, potatoes, and coal without Maine Central rates.",
      "sourceSentenceIds": [
        5,
        6
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Searsport%2C_Maine",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Searsport harbor offers a sheltered anchorage about 2 by 3 miles, with a mean low‑water depth of 40 feet and a tidal swing of 10 feet.",
      "sourceSentenceIds": [
        22
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Searsport%2C_Maine",
      "category": "nature",
      "quality": "good"
    }
