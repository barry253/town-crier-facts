  "facts": [
    {
      "id": 1,
      "text": "Altenburg was laid out and platted in 1839 by a colony of Lutherans from Saxony, Germany.",
      "sourceSentenceIds": [
        20
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Altenburg%2C_Missouri"
    },
    {
      "id": 2,
      "text": "The town’s name honors the Duchy of Saxe‑Altenburg, not the German city, reflecting settlers’ homeland.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Altenburg%2C_Missouri"
    },
    {
      "id": 3,
      "text": "Trinity Lutheran Church began in a log cabin in 1839, later replaced by limestone and frame structures, and now houses the Lutheran Heritage Center.",
      "sourceSentenceIds": [
        22,
        16
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 2"
      ],
      "source": "https://en.wikipedia.org/wiki/Altenburg%2C_Missouri"
    },
    {
      "id": 4,
      "text": "A unique co‑educational “Log Cabin College” was built from native timber, a rare idea for the era.",
      "sourceSentenceIds": [
        24
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Altenburg%2C_Missouri"
    },
    {
      "id": 5,
      "text": "Seven Saxon Lutheran settlements, including Altenburg, were founded on 4,475 acres financed by a communal treasury of $88,000.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.greatriverroad.com/altenburg-mo"
    },
    {
      "id": 6,
      "text": "Altenburg’s Heritage Center opened in 1985, preserving the community’s 19th‑century buildings and Lutheran legacy.",
      "sourceSentenceIds": [
        25
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Altenburg%2C_Missouri"
    }
  ]
