    {
      "id": 1,
      "text": "Surf City began as Long Beach City in 1894, then changed its name to Surf City in 1899.",
      "sourceSentenceIds": [
        2,
        6,
        8
      ],
      "sourceLabels": [
        "Web source 2",
        "Wikipedia"
      ],
      "source": "https://surfcitynewjersey.com/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Surf City is the oldest continuously settled community on Long Beach Island.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://surfcitynewjersey.com/local-history/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Whalers set up a station in 1690, and the area has been called Great Swamp, Buzby’s Place, Old Mansion, Long Beach City, and now Surf City.",
      "sourceSentenceIds": [
        25
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://surfcitynewjersey.com/local-history/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Surf City once hosted the Mansion of Health, one of the earliest large boarding hotels on the Jersey Shore, owned by Hudson Buzby.",
      "sourceSentenceIds": [
        29
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Surf_City%2C_New_Jersey",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Surf City grew around the Long Beach Railroad, which brought visitors to the island during the railroad era.",
