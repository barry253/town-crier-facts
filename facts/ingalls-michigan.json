  "facts": [
    {
      "id": 1,
      "text": "Ingalls was officially named in 1863 after Eleazer Stillman Ingalls, a local judge who helped organize Menominee County.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/ingalls_michigan",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The Chicago and North Western Railway arrived in 1872, building a station that linked Ingalls to lumber markets.",
      "sourceSentenceIds": [
        18
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/ingalls_michigan",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Ingalls’ settlement began in the mid‑19th century as part of the broader Menominee County formation from Ontonagon County.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/ingalls_michigan",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Before European settlers, the area was traditional territory of the Menominee, an Algonquian‑speaking tribe spanning Wisconsin and Michigan.",
      "sourceSentenceIds": [
        11
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/ingalls_michigan",
      "category": "other",
      "quality": "poor",
      "qualityReason": "vague"
    },
    {
      "id": 5,
      "text": "The Menominee River ran through Ingalls, serving as a key boundary and cultural corridor for Ojibwe and other Indigenous peoples.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/ingalls_michigan",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Ingalls’ early growth was driven by lumbering and mining interests that attracted settlers to its abundant forests, rivers, and wetlands.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Web source 1"
      ],
