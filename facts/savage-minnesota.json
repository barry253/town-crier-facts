  "facts": [
    {
      "id": 1,
      "text": "Savage was renamed in 1904 after Marion Willis Savage, the owner of the celebrated racehorse Dan Patch.",
      "sourceSentenceIds": [
        2,
        6
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Savage%2C_Minnesota",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The first railroad tracks reached the town in October 1865, linking it to the Chicago, Minneapolis and Omaha Railway.",
      "sourceSentenceIds": [
        12,
        16,
        22
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1",
        "Web source 2"
      ],
      "source": "https://en.wikipedia.org/wiki/Savage%2C_Minnesota",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The Minnesota River was dredged 14 miles to 9 feet from Savage, allowing ships to launch from the town to the Mississippi.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Savage%2C_Minnesota",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The historic Savage Depot, built in 1880, was relocated to the city center in the early 21st century to preserve its heritage.",
      "sourceSentenceIds": [
        13
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Savage%2C_Minnesota",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "During World War II, Camp Savage hosted a Military Intelligence Service Language School that trained soldiers for overseas service.",
