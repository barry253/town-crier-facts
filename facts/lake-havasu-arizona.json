  "facts": [
    {
      "id": 1,
      "text": "Lake Havasu City is famous for the historic London Bridge, which was moved from London and now spans the narrow Bridgewater Channel.",
      "sourceSentenceIds": [
        6,
        9
      ],
      "sourceLabels": [
        "Web source 1",
        "Web source 2"
      ],
      "source": "https://www.golakehavasu.com/media-room/fact-sheet/"
    },
    {
      "id": 2,
      "text": "The city draws about 835,000 visitors each year, thanks to its lake, sunshine, and the iconic London Bridge.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.golakehavasu.com/media-room/fact-sheet/"
    },
    {
      "id": 3,
      "text": "Lake Havasu City began as Site Six, a World War II Army Air Corps rest camp on the lake’s shore.",
      "sourceSentenceIds": [
        21
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Lake_Havasu_City%2C_Arizona"
    },
    {
      "id": 4,
      "text": "After decades of development, Lake Havasu City was officially incorporated in 1978.",
      "sourceSentenceIds": [
        29
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Lake_Havasu_City%2C_Arizona"
    },
    {
      "id": 5,
      "text": "Every year the city hosts events such as the Havasu Balloon Festival, Winterfest, and the Lake Havasu Marine Association Boat Show.",
      "sourceSentenceIds": [
        19
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.golakehavasu.com/media-room/fact-sheet/"
    },
    {
      "id": 6,
      "text": "Lake Havasu City sits on the eastern shore of Lake Havasu, right on the Colorado River border between Arizona and California.",
      "sourceSentenceIds": [
        6
      ],
