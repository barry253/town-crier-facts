  "facts": [
    {
      "id": 1,
      "text": "Żoliborz means \"Beautiful Embankment,\" a name borrowed from the French Joli Bord and later Polishized.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/%C5%BBoliborz",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "During the 1944 Warsaw Uprising, Żoliborz was one of the first districts to rise, yet it escaped the widespread destruction that befell the city.",
      "sourceSentenceIds": [
        24,
        25
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/%C5%BBoliborz",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The 1831 Warsaw Citadel, once a Russian fortress, now shelters the 10th Pavilion Museum, the Katyń Museum, and the Museum of Polish History.",
      "sourceSentenceIds": [
        9,
        8
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/%C5%BBoliborz",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Just a 15‑minute walk from Wilsona Square lies the Olympic Centre, home to the Museum of Sport and Tourism and a collection of Olympic medals.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://go2warsaw.pl/en/walk-around-zoliborz-district/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Żoliborz’s streets showcase 1930s modernist villas, many built for officers and journalists, reflecting the district’s early 20th‑century elite character.",
      "sourceSentenceIds": [
        20,
        26
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/%C5%BBoliborz",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Polish rock legend Czesław Niemen, film director Andrzej Wajda, and actress Zofia Merle all called Żoliborz home at some point.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/%C5%BBoliborz",
      "category": "people",
      "quality": "good"
    }
  ],
