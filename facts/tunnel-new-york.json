  "facts": [
    {
      "id": 1,
      "text": "The tunnel inside Tunnel, NY’s 770 Chabad synagogue was first reported by local media on December 22, 2023.",
      "sourceSentenceIds": [
        11
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/New_York_City_synagogue_tunnel_incident",
      "category": "other",
      "quality": "poor",
      "qualityReason": "editorial_filler"
    },
    {
      "id": 2,
      "text": "Measured roughly 60 ft long, 8 ft wide and 5 ft tall, the tunnel had inadequate shoring that raised safety concerns.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/New_York_City_synagogue_tunnel_incident",
      "category": "other",
      "quality": "poor",
      "qualityReason": "editorial_filler"
    },
    {
      "id": 3,
      "text": "Construction crews filled the tunnel with concrete on January 10, 2025, sealing the cavity permanently.",
      "sourceSentenceIds": [
        25
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/New_York_City_synagogue_tunnel_incident",
      "category": "other",
      "quality": "poor",
      "qualityReason": "editorial_filler"
    },
    {
      "id": 4,
      "text": "Footage of the January 8 incident went viral, especially on Twitter, sparking widespread online discussion.",
      "sourceSentenceIds": [
        26
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/New_York_City_synagogue_tunnel_incident",
      "category": "other",
      "quality": "poor",
      "qualityReason": "editorial_filler"
    },
    {
      "id": 5,
      "text": "A USA Today fact‑check revealed the stained mattress seen in viral videos was removed from behind wood paneling, not from the tunnel.",
      "sourceSentenceIds": [
