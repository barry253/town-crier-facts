  "facts": [
    {
      "id": 1,
      "text": "Portageville is a hamlet in the town of Genesee Falls, Wyoming County, New York.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Portageville%2C_New_York"
    },
    {
      "id": 2,
      "text": "The hamlet’s name comes from Native American canoeists who had to portage their boats past three waterfalls in the Genesee River gorge.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Portageville%2C_New_York"
    },
    {
      "id": 3,
      "text": "The First Universalist Church of Portageville, built in 1841, is a historic Greek‑Revival structure with Gothic and Federal details.",
      "sourceSentenceIds": [
        4,
        12
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Portageville%2C_New_York"
    },
    {
      "id": 4,
      "text": "Portageville’s post office opened in 1828, long before the town’s formal establishment.",
      "sourceSentenceIds": [
        16
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://roadsidethoughts.com/ny/portageville-xx-wyoming-profile.htm"
    },
    {
      "id": 5,
      "text": "The hamlet sits 1,110 feet above sea level, offering a modest elevation within the Genesee Valley.",
      "sourceSentenceIds": [
        17
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://roadsidethoughts.com/ny/portageville-xx-wyoming-profile.htm"
    },
    {
      "id": 6,
      "text": "The nearby Genesee River Gorge, sometimes called the Grand Canyon of the East, was carved by glacial debris and dramatic waterfalls.",
