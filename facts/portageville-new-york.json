      "qualityReason": "vague"
    },
    {
      "id": 2,
      "text": "The hamlet’s name comes from Native American canoeists who had to portage their boats past three waterfalls in the Genesee River gorge.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Portageville%2C_New_York",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The First Universalist Church of Portageville, built in 1841, is a historic Greek‑Revival structure with Gothic and Federal details.",
      "sourceSentenceIds": [
        4,
        12
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Portageville%2C_New_York",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Portageville’s post office opened in 1828, long before the town’s formal establishment.",
