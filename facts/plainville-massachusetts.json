  "facts": [
    {
      "id": 1,
      "text": "Plainville became an officially recognized town on April 4, 1905, making it the third youngest town in Massachusetts.",
      "sourceSentenceIds": [
        23
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Plainville%2C_Massachusetts",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town’s seal features the Angle Tree Stone, a historic marker that once divided the old Massachusetts Bay Colony from Plymouth Bay Colony.",
      "sourceSentenceIds": [
        11,
        28
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Plainville%2C_Massachusetts",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Plainville’s first post office opened in 1856, and the town’s name was chosen for the abundance of flat plains in the area.",
      "sourceSentenceIds": [
        26
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Plainville%2C_Massachusetts",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The original Plainville Town Hall, built in 1938 as a fire station, was replaced by a new municipal complex funded by local casino tax revenue.",
      "sourceSentenceIds": [
        3,
        30
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Plainville%2C_Massachusetts",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "In 1940, the Plainville railroad station was razed, ending a century of rail service that once connected the town to the New York–New Haven line.",
      "sourceSentenceIds": [
        5,
        6
      ],
      "sourceLabels": [
        "Web source 1"
      ],
