  "facts": [
    {
      "id": 1,
      "text": "Powder Springs is an unincorporated community in Grainger County, Tennessee.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Powder_Springs%2C_Tennessee"
    },
    {
      "id": 2,
      "text": "The community’s name comes from a nearby spring that fed Flat Creek, and the area was known as Powder Spring Gap in the 19th century.",
      "sourceSentenceIds": [
        13,
        17,
        19
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://appalachianhistorian.org/powder-springs-grainger-county-a-bridge-a-gap-and-a-community-north-of-clinch-mountain/"
    },
    {
      "id": 3,
      "text": "A historic Pratt half‑hip truss bridge, built by the Converse Bridge Company, once spanned Flat Creek at Dale Road in Powder Springs.",
      "sourceSentenceIds": [
        5,
        9
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://appalachianhistorian.org/powder-springs-grainger-county-a-bridge-a-gap-and-a-community-north-of-clinch-mountain/"
    },
    {
      "id": 4,
      "text": "During the Civil War, Powder Spring Gap served as a contested route, with Union and Confederate forces moving through the valley in 1864.",
      "sourceSentenceIds": [
        28,
        30
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://appalachianhistorian.org/powder-springs-grainger-county-a-bridge-a-gap-and-a-community-north-of-clinch-mountain/"
    },
    {
      "id": 5,
      "text": "Grainger County, where Powder Springs lies, was formed in 1796 from parts of Hawkins and Knox Counties, the same year Tennessee became a state.",
      "sourceSentenceIds": [
        14
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://appalachianhistorian.org/powder-springs-grainger-county-a-bridge-a-gap-and-a-community-north-of-clinch-mountain/"
    },
    {
      "id": 6,
      "text": "Voters in Grainger County rejected secession in June 1861 by 1,756 to 495, reflecting the region’s divided loyalties during the Civil War.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://appalachianhistorian.org/powder-springs-grainger-county-a-bridge-a-gap-and-a-community-north-of-clinch-mountain/"
    }
  ]
