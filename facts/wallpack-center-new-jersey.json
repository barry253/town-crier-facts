      "id": 1,
      "text": "Wallpack Center was added to National Register 1980 for agriculture, architecture, settlement.",
      "sourceSentenceIds": [
        4,
        13,
        16
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
