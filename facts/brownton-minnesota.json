  "facts": [
    {
      "id": 1,
      "text": "Brownton began as Grimshaw Settlement and was officially founded in 1877 by Alonzo Brown.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.twincities.com/2020/05/10/more-to-the-story-the-origins-of-brownton-and-lake-addie/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Alonzo Brown named the town after his brother Charles, who died in the Civil War siege of Cornith, Mississippi.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.twincities.com/2020/05/10/more-to-the-story-the-origins-of-brownton-and-lake-addie/",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The arrival of the railroad transformed Brownton, turning it into a thriving mid‑century community before recent decline.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.twincities.com/2020/05/10/more-to-the-story-the-origins-of-brownton-and-lake-addie/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "A post office has served Brownton continuously since 1878, marking its early civic infrastructure.",
      "sourceSentenceIds": [
        15
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Brownton%2C_Minnesota",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Brownton was officially incorporated as a city in 1886, solidifying its municipal status.",
      "sourceSentenceIds": [
        16
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Brownton%2C_Minnesota",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Situated on the south side of Buffalo Creek, Brownton lies within the Crow River watershed that feeds the Mississippi.",
      "sourceSentenceIds": [
