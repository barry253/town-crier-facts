  "facts": [
    {
      "id": 1,
      "text": "Jacobs Creek got its name from Captain Jacobs, a Lenape chief who lived along the stream in the mid‑1700s.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Jacobs_Creek%2C_Pennsylvania",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Settlers first arrived in 1768 after the Treaty of Fort Stanwix opened the area to European colonists.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Jacobs_Creek%2C_Pennsylvania",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The first permanent building was a log Methodist Episcopal church erected in 1817, still a landmark of the community.",
      "sourceSentenceIds": [
        13
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Jacobs_Creek%2C_Pennsylvania",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Jacobs Creek’s waters have long powered local industry, with the watershed’s history steeped in early industrial growth.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.jacobscreekwatershed.org/history",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Since the 1960s, the Jacobs Creek Watershed Association has led community‑driven flood‑control projects that protect the river’s banks.",
      "sourceSentenceIds": [
        15
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.jacobscreekwatershed.org/history",
      "category": "other",
      "quality": "poor",
      "qualityReason": "vague"
    },
    {
      "id": 6,
      "text": "The community sits at the mouth of Jacobs Creek where it joins the Youghiogheny River, just 1.5 miles south of Smithton.",
