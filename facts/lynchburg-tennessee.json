  "facts": [
    {
      "id": 1,
      "text": "Lynchburg was named after Judge Lynch, who presided over a vigilante committee sometime after the War of 1812.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Lynchburg%2C_Tennessee",
      "category": "people",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Lynchburg is best known for Jack Daniel's distillery, where Tennessee whiskey is marketed worldwide from a town that has only one traffic light.",
      "sourceSentenceIds": [
        17
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Lynchburg%2C_Tennessee",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Although the distillery operates, Lynchburg's home county of Moore remains a dry county, prohibiting alcohol sales outside the plant.",
      "sourceSentenceIds": [
        18
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Lynchburg%2C_Tennessee",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The downtown area of Lynchburg is listed on the National Register of Historic Places as the Lynchburg Historic District.",
      "sourceSentenceIds": [
        21
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Lynchburg%2C_Tennessee",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Settlers first arrived in the Lynchburg area around 1801, establishing the foundations of the town.",
      "sourceSentenceIds": [
        22
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Lynchburg%2C_Tennessee",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "During the Civil War, residents of Lynchburg generally supported the Confederacy, reflecting the region's Southern loyalties.",
