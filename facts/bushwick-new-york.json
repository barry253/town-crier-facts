  "facts": [
    {
      "id": 1,
      "text": "Bushwick was first settled on Feb 16 1660 by French Huguenots, a Dutch translator, and a freed slave named Franciscus the Negro.",
      "sourceSentenceIds": [
        6,
        12
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Bushwick%2C_Brooklyn",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "In the 19th century, Bushwick became a manufacturing hub with factories for sugar, oil, chemicals, and even a glue plant built by Peter Cooper.",
      "sourceSentenceIds": [
        18,
        19
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Bushwick%2C_Brooklyn",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The Bushwick Chemical Works on Metropolitan Avenue and Grand Street was one of the first industrial sites along the English Kills waterway, which was dredged to boost commerce.",
      "sourceSentenceIds": [
        20
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Bushwick%2C_Brooklyn",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The William Ulmer Brewery at Beaver and Belvidere Streets earned landmark status in 2010, the first brewery in Brooklyn to receive that honor.",
      "sourceSentenceIds": [
        29
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Bushwick%2C_Brooklyn",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "A major blackout on July 13 1977 left Bushwick in darkness, sparking widespread arson and looting that marked a dark chapter in the neighborhood’s history.",
