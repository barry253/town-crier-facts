  "facts": [
    {
      "id": 1,
      "text": "Centre’s Cherokee County Historical Museum showcases artifacts from local newspapers to Civil War memorabilia, offering a tangible glimpse into the region’s past.",
      "sourceSentenceIds": [
        1,
        7
      ],
      "sourceLabels": [
        "Web source 1",
        "Web source 2"
      ],
      "source": "https://centreal.gov/about-centre/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "In 1844, the county seat moved from Cedar Bluff to the centrally located town of Centre, a change that also inspired the town’s British spelling.",
      "sourceSentenceIds": [
        3,
        4,
        14
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1",
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Centre%2C_Alabama",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Before becoming a city, the area was home to the Cherokee settlement known as Turkey Town, which later became the county seat in 1844.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://centreal.gov/about/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Centre boasts several Alabama Register of Historic Places sites, including the Bradford‑West House, Jordans Old Place, Pratt Park, and the Savage‑Campbell House.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://centreal.gov/about/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "In 2011, Centre lifted its dry status, allowing the sale of alcoholic beverages for the first time in its history.",
      "sourceSentenceIds": [
        15
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Centre%2C_Alabama",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The city limits of Centre extend north to the south shore of Weiss Lake on the Coosa River, offering scenic waterfront views.",
      "sourceSentenceIds": [
        17
      ],
