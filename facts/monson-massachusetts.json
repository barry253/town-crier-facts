  "facts": [
    {
      "id": 1,
      "text": "Monson was named after Sir John Monson, a British Board of Trade president and friend of Gov. Thomas Pownall.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Monson%2C_Massachusetts",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "In the 1600s, Monson hosted sawmills, woolen mills, and gristmills that powered early industry.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.monson-ma.gov/412/Visit-Monson",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The town’s hat industry thrived in the late 1800s, sending hats to New York from several factories on Main Street.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.monson-ma.gov/412/Visit-Monson",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The Cushman Street mill was converted into a hat factory by Heimann & Lichten in 1912 after a fire.",
      "sourceSentenceIds": [
        9,
        10
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://lostnewengland.com/category/massachusetts/monson-massachusetts/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Monson’s railroad history includes the New England Central Railroad running north‑south through town, parallel to Route 32.",
      "sourceSentenceIds": [
        13
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Monson%2C_Massachusetts",
