  "facts": [
    {
      "id": 1,
      "text": "Clarenville was founded in 1891 when Lower Shoal Harbour, Dark Hole, Brook Cove, Broad Cove and Red Beach merged, originally called “Clarenceville”.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
