      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The former CN Railway station built in 1942 now houses the Clarenville Heritage Museum, a volunteer‑run exhibit in a historic building.",
      "sourceSentenceIds": [
        12,
        13,
        14
      ],
      "sourceLabels": [
        "Web source 2",
