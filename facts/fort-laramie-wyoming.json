    },
    {
      "id": 2,
      "text": "Fort Laramie served as a Pony Express station in 1860.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Fort_Laramie%2C_Wyoming"
    },
    {
      "id": 3,
      "text": "The original fort sat south of town at the confluence of the Laramie and North Platte Rivers.",
      "sourceSentenceIds": [
        3,
        12
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 2"
      ],
      "source": "https://en.wikipedia.org/wiki/Fort_Laramie%2C_Wyoming"
    },
    {
      "id": 4,
      "text": "Fort Laramie began as a fur trade post before becoming a military garrison that played a strategic role in the United States.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.nps.gov/fola/learn/historyculture/index.htm"
    },
    {
      "id": 5,
      "text": "Trappers, traders, Native Americans, and soldiers interacted for fifty-six years at the site known as the Grand Old Post.",
      "sourceSentenceIds": [
        8,
        9
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.nps.gov/fola/learn/historyculture/index.htm"
    },
    {
      "id": 6,
      "text": "Temperatures in Fort Laramie have ranged from a record high of 106 degrees to a record low of minus 40 degrees.",
