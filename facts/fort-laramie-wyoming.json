  "facts": [
    {
      "id": 1,
      "text": "Fort Laramie is named after a historic fort that served as an important stop on the Oregon, California, and Mormon trails.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
