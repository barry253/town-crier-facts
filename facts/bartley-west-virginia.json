  "facts": [
    {
      "id": 1,
      "text": "Bartley derives its name from Bartley Ross, who was an original owner of the town site.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Bartley%2C_West_Virginia"
    },
    {
      "id": 2,
      "text": "The community of Bartley lies along the Dry Fork, a tributary of the Tug Fork River.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/bartley_west_virginia"
    },
    {
      "id": 3,
      "text": "Bartley was once a thriving hub for bituminous coal extraction in the early twentieth century.",
      "sourceSentenceIds": [
        19
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/bartley_west_virginia"
    },
    {
      "id": 4,
      "text": "The Norfolk and Western Railway helped Bartley grow as a railroad siding for moving timber and agricultural goods.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/bartley_west_virginia"
    },
    {
      "id": 5,
      "text": "Bartley is situated within the Pocahontas Coalfield, where bituminous coal seams from the Carboniferous period are prominent.",
      "sourceSentenceIds": [
        25
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/bartley_west_virginia"
    },
    {
      "id": 6,
      "text": "Early European settlers in the Bartley area began arriving around 1802 to engage in hunting and subsistence farming.",
      "sourceSentenceIds": [
