  "facts": [
    {
      "id": 1,
      "text": "Deerfield Colony is a Hutterite settlement in Edmunds County that adheres to communal living practices, including shared property and collective labor.",
      "sourceSentenceIds": [
        5,
        7
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/deerfield_colony_south_dakota"
    },
    {
      "id": 2,
      "text": "Established in 1971, Deerfield Colony was formed as a division from the Plainview Hutterite Colony due to overpopulation.",
      "sourceSentenceIds": [
        6,
        10
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/deerfield_colony_south_dakota"
    },
    {
      "id": 3,
      "text": "The community at Deerfield Colony maintains its own elementary school for children through grade eight to support its self-sufficient nature.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/deerfield_colony_south_dakota"
    },
    {
      "id": 4,
      "text": "Deerfield Colony features a communal layout with a central dining hall, row-style residences, and expansive barns for livestock and crops.",
      "sourceSentenceIds": [
        16,
        23
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/deerfield_colony_south_dakota"
    },
    {
      "id": 5,
      "text": "Deerfield Colony has expanded the Hutterite network by founding daughter colonies in South Dakota and North Dakota.",
      "sourceSentenceIds": [
        8,
        20
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/deerfield_colony_south_dakota"
    },
    {
      "id": 6,
      "text": "Located in the James River watershed, Deerfield Colony sits on approximately 5,387 acres of glaciated plains.",
      "sourceSentenceIds": [
        22,
        23
      ],
      "sourceLabels": [
        "Web source 1"
