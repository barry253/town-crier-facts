  "facts": [
    {
      "id": 1,
      "text": "Iona's name, meaning \"beauty,\" was chosen by early settlers to honor pioneer spirit.",
      "sourceSentenceIds": [
        24,
        28
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.cityofiona.org/welcome/main-street/"
    },
    {
      "id": 2,
      "text": "First settlers arrived in 1883, about five miles northeast of Idaho Falls, seeking new homestead land.",
      "sourceSentenceIds": [
        25
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.cityofiona.org/welcome/main-street/"
    },
    {
      "id": 3,
      "text": "Before becoming Iona, the area was known as Sand Creek, reflecting the local waterway.",
      "sourceSentenceIds": [
        26
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.cityofiona.org/welcome/main-street/"
    },
    {
      "id": 4,
      "text": "Settlers claimed 160‑acre homestead tracts, bringing wagons, cows, and all their personal property to the new town.",
      "sourceSentenceIds": [
        27,
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.cityofiona.org/welcome/main-street/"
    },
    {
      "id": 5,
      "text": "On June 17, 1884, Apostle Wilford Woodruff visited the area, marking early religious influence.",
