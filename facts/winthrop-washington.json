  "facts": [
    {
      "id": 1,
      "text": "Winthrop was named for author and explorer Theodore Winthrop, who visited Washington Territory in the 1860s.",
      "sourceSentenceIds": [
        2,
        29
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Winthrop%2C_Washington",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Guy Waring founded Winthrop in 1890, opening the first general store at the confluence of the Methow and Chewuch rivers.",
      "sourceSentenceIds": [
        11,
        14
      ],
      "sourceLabels": [
        "Web source 1",
        "Wikipedia"
      ],
      "source": "https://www.winthropwashington.com/about",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The town’s first telephone service arrived in the 1910s, alongside the Winthrop Eagle newspaper, a school, and a bank.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Winthrop%2C_Washington",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Winthrop’s economy shifted from mining and logging to tourism and outdoor recreation over the decades.",
      "sourceSentenceIds": [
        18
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Winthrop%2C_Washington",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The Shafer Museum, housed in Waring’s former “Castle” home, showcases the town’s pioneer history.",
      "sourceSentenceIds": [
        30,
        25
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Winthrop%2C_Washington",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Confluence Park, acquired in 2016, sits where the Methow and Chewuch rivers meet, offering a historic gathering spot.",
      "sourceSentenceIds": [
        16,
