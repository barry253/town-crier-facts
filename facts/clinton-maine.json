  "facts": [
    {
      "id": 1,
      "text": "Clinton was named for New York Governor DeWitt Clinton, not the Revolutionary War general as some sources suggest.",
      "sourceSentenceIds": [
        3,
        4,
        5
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Clinton%2C_Maine",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The first settlers arrived around 1775, after the area joined the Plymouth Patent, and early pioneers like George FitzGerald and David Gray came from Ireland.",
      "sourceSentenceIds": [
        16,
        13
      ],
      "sourceLabels": [
        "Web source 2",
        "Web source 1"
      ],
      "source": "https://townline.org/up-and-down-the-kennebec-valley-clinton/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Clinton’s Grange Hall, built in 1915, earned a spot on the National Register of Historic Places, reflecting the town’s agricultural heritage.",
      "sourceSentenceIds": [
        15
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://townline.org/category/towns/clinton/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "A ferry operated across the Kennebec River in the late 18th century, started by Benjamin Noble, and was abandoned about twenty years later.",
      "sourceSentenceIds": [
        8,
        18
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://townline.org/category/towns/clinton/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The Sebasticook River winds north‑south through Clinton, giving the town its own scenic waterway that feeds into the Kennebec.",
      "sourceSentenceIds": [
        6,
        26
      ],
