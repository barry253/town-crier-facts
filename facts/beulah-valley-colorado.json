  "facts": [
    {
      "id": 1,
      "text": "Beulah’s name comes from Isaiah 62:4, a biblical term meaning \"married,\" chosen to replace the earlier, less wholesome name.",
      "sourceSentenceIds": [
        16,
        17
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Beulah_Valley%2C_Colorado",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Early settlers left petroglyphs and artifacts in the valley’s caves, making Beulah one of the first settlements in the Wet Mountains.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.uncovercolorado.com/towns/beulah-valley/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Archaeologists have uncovered evidence that Confederate Army troops once used a headquarters in Beulah during the Civil War.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.uncovercolorado.com/towns/beulah-valley/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Between Beulah and San Isabel stands Bishop Castle, a one‑man construction by Jim Bishop that still towers over the valley.",
      "sourceSentenceIds": [
        17
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Beulah_Valley%2C_Colorado",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Perched at about 6,800 feet, Beulah lies in the Wet Mountains, the oldest sub‑range of Colorado’s Sangre de Cristo Mountains.",
