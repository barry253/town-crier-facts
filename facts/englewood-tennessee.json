  "facts": [
    {
      "id": 1,
      "text": "Englewood grew around the Eureka Cotton Mills founded by John Dixon in 1857.",
      "sourceSentenceIds": [
        20
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Englewood%2C_Tennessee"
    },
    {
      "id": 2,
      "text": "The town was renamed Englewood in 1894 by the Brient family after the mill town of Eureka Mills.",
      "sourceSentenceIds": [
        2,
        5
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 2"
      ],
      "source": "https://en.wikipedia.org/wiki/Englewood%2C_Tennessee"
    },
    {
      "id": 3,
      "text": "In 1907 the entire mill operation moved to Tellico Junction to use the railroad, creating a new mill village.",
      "sourceSentenceIds": [
        11
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Englewood%2C_Tennessee"
    },
    {
      "id": 4,
      "text": "By the late 1990s most textile mills had closed, leaving only Eureka Sportswear and Allied Hosiery until 2008.",
      "sourceSentenceIds": [
        7,
        16
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 2"
      ],
      "source": "https://en.wikipedia.org/wiki/Englewood%2C_Tennessee"
    },
    {
      "id": 5,
      "text": "Women made up a large portion of mill workers, mainly as weavers, while men held supervisory roles.",
      "sourceSentenceIds": [
        27
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Englewood%2C_Tennessee"
    },
    {
      "id": 6,
      "text": "The original mill village had distinct sections: Yellow Top for the cotton mill, Socktown for hosiery, and Onion Hill for the flour mill.",
      "sourceSentenceIds": [
        26
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Englewood%2C_Tennessee"
    }
  ]
