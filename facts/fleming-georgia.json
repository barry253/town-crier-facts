  "facts": [
    {
      "id": 1,
      "text": "Fleming, Georgia takes its name from the pioneer William Fleming family, who owned large plantations in the area.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://vanishinggeorgia.com/2026/03/09/fleming-georgia/",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Around 1815, William Fleming surveyed a tract ten miles west of Midway and called his summer retreat Gravel Hill.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://cityofflemington.org/flemington-history",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Turpentine stills in Flemington and nearby McIntosh shipped their product by railroad to Savannah in the 19th century.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://cityofflemington.org/flemington-history",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Today, a few historic structures remain in Fleming, including a precinct house and a fire station, though the precinct is now closed.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://vanishinggeorgia.com/2026/03/09/fleming-georgia/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Early settlers such as John Osgood, Oliver Stevens, and Major John Bacon helped establish the community that would become Fleming.",
      "sourceSentenceIds": [
        14
