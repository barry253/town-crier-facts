      "quality": "poor",
      "qualityReason": "location_description"
    },
    {
      "id": 3,
      "text": "During the 19th century, Hudson grew into a factory town, producing ironworks, brickworks, and railroad car wheels.",
      "sourceSentenceIds": [
        13,
        4
      ],
      "sourceLabels": [
        "Wikipedia",
