  "facts": [
    {
      "id": 1,
      "text": "Slaterville Springs earned its name from early settler and first schoolteacher Levi Slater, who helped establish the post office in 1823.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/slaterville_springs_new_york",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The historic town hall, once a schoolhouse listed on the National Register, still features an artesian well that offers free water year‑round.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/slaterville_springs_new_york",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Between 1871 and 1900, the springs drew up to 200 guests at a time for water‑cure treatments, boosting the hamlet’s resort fame.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/slaterville_springs_new_york",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The Town of Caroline incorporated in 1811, and Slaterville Springs became part of newly formed Tompkins County in 1817.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/slaterville_springs_new_york",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Mid‑19th century growth was driven by discovery and promotion of mineral springs, attracting health‑seeking visitors and spurring local development.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/slaterville_springs_new_york",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "In 1893, spring water from Slaterville Springs won an award at Chicago’s Columbian Exposition for its clarity and excellence.",
      "sourceSentenceIds": [
        30
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/slaterville_springs_new_york",
      "category": "culture",
      "quality": "good"
    }
