      ],
      "source": "https://www.morganzala.com/historic-sites",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Old Hickory, a Creole‑raised plantation house, sits on the historic Morganza Plantation grounds.",
