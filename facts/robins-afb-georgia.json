  "facts": [
    {
      "id": 1,
      "text": "Robins AFB is named after Brigadier General Augustine Warner Robins, the Air Force’s “father of logistics.”.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Robins_Air_Force_Base"
    },
    {
      "id": 2,
      "text": "The base opened the Museum of Aviation in 1981, a 51‑acre complex that houses more than 85 historic aircraft.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Robins_Air_Force_Base"
    },
    {
      "id": 3,
      "text": "Robins AFB is Georgia’s largest industrial complex, employing more than 25,584 civilian, contractor, and military personnel.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Robins_Air_Force_Base"
    },
    {
      "id": 4,
      "text": "The Warner Robins Air Logistics Complex at Robins manages a worldwide supply chain for aircraft, engines, missiles, software, and avionics.",
      "sourceSentenceIds": [
        24
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Robins_Air_Force_Base"
    },
    {
      "id": 5,
      "text": "The 78th Air Base Wing, the host unit, supplies services and support to the complex and its tenant organizations.",
      "sourceSentenceIds": [
        27
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Robins_Air_Force_Base"
    },
    {
      "id": 6,
      "text": "Robins AFB served as a filming location for the 2020 disaster movie Greenland, where a family is evacuated before a comet impact.",
