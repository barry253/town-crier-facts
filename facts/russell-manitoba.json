      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The townsite was first surveyed in 1881 and named after Surveyor‑General Lindsay Russell.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
