      ],
      "source": "https://russellbinscarthlibrary.ca/community-information/local-history/",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The historic walking tour showcases some of the oldest homes and historic points of interest, including the Arches of Russell.",
      "sourceSentenceIds": [
