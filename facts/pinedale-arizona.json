  "facts": [
    {
      "id": 1,
      "text": "Pinedale first called Mortensen after the pioneer families, later Percheron for the stallions James Mortensen brought, and settled on Pinedale by 1888.",
      "sourceSentenceIds": [
        19,
        20,
        21
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Pinedale%2C_Arizona",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Perched about 6,500 feet on the Mogollon Rim, Pinedale sits high above the surrounding desert.",
      "sourceSentenceIds": [
        18
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Pinedale%2C_Arizona",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The town’s Community Center began as a two‑room schoolhouse, now a National Register historic building.",
      "sourceSentenceIds": [
        1,
        10
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Pinedale%2C_Arizona",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "In 1880 the Mortensen brothers helped grade a railbed for the Atlantic and Pacific Railroad, linking Pinedale to Joseph City and Winslow.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Pinedale%2C_Arizona",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Ancient petroglyphs and Anasazi ruins dot the hills around Pinedale, evidence of long‑time Native American presence.",
      "sourceSentenceIds": [
        26,
        27,
        28
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Pinedale%2C_Arizona",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Arizona hosts two communities named Pinedale, one in Navajo County where we’re driving, the other in Apache County.",
