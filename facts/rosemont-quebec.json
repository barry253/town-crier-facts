  "facts": [
    {
      "id": 1,
      "text": "Rosemont–La Petite-Patrie is a borough of Montreal located centre‑east of the island.",
      "sourceSentenceIds": [
        2,
        3
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Rosemont%E2%80%93La_Petite-Patrie"
    },
    {
      "id": 2,
      "text": "The borough’s name reflects its historic industrial roots, once home to the Canadian Pacific’s Technopôle Angus where locomotives were built in the 1900s.",
      "sourceSentenceIds": [
        23
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://montreal.ca/apropos/rosemont-la-petite-patrie"
    },
    {
      "id": 3,
      "text": "The Petite‑Italie neighbourhood, part of Rosemont, became the first Italian enclave in Montreal, now famed for its cafés, pizzas, and the Jean‑Talon market.",
      "sourceSentenceIds": [
        25,
        26
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://montreal.ca/apropos/rosemont-la-petite-patrie"
    },
    {
      "id": 4,
      "text": "The Cité‑Jardin, built between 1940‑47, was designed as a green workers’ community inspired by Britain’s City Beautiful movement.",
      "sourceSentenceIds": [
        27,
        28
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://montreal.ca/apropos/rosemont-la-petite-patrie"
    },
    {
      "id": 5,
      "text": "Rosemont’s streets are served by the orange and blue Metro lines, making it one of the few boroughs with two lines intersecting.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Rosemont%E2%80%93La_Petite-Patrie"
    },
    {
      "id": 6,
      "text": "The borough hosts 60 green spaces, including 13 community gardens, reflecting its commitment to urban nature.",
