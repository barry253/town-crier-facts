      "id": 1,
      "text": "Norton Shores sits on Lake Michigan’s eastern shore, a feature that shapes its weather and makes beachside biking a local favorite.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Web source 1"
      ],
