  "facts": [
    {
      "id": 1,
      "text": "Clifton station opened April 23 1860 as Vanderbilt's Landing, the original northern terminal of the Staten Island Railway.",
      "sourceSentenceIds": [
        2,
        20,
        21
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Clifton_station_(Staten_Island_Railway)",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The station was later renamed Clifton and became a key transfer point for ferry passengers heading to Manhattan's South Ferry.",
      "sourceSentenceIds": [
        21
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Clifton_station_(Staten_Island_Railway)",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The waterfront once buzzed with ship repair yards, warehouses, and factories along Front and Edgewater Streets, but industrial activity waned as shipping moved to New Jersey.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.cityneighborhoods.nyc/clifton",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The Clifton Hotel, a grand 1840s resort, was one of the area’s earliest landmarks, offering fresh air and bay views to visitors.",
      "sourceSentenceIds": [
        14
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.cityneighborhoods.nyc/clifton",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "In 2019 the MTA announced Clifton station would become ADA‑accessible as part of the 2020–2024 Capital Program, modernizing the historic stop.",
