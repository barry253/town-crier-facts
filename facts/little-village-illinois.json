  "facts": [
    {
      "id": 1,
      "text": "Peter Crawford sold 160 acres to the Chicago, Burlington and Quincy railroad, ensuring a train stop that sparked Little Village’s growth.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.enlacechicago.org/littlevillagehistory",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Originally called Crawford, the area later became Pulaski before adopting the name Little Village to honor its Eastern European settlers.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.enlacechicago.org/littlevillagehistory",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "In 1990, Mexican architect Adrian Lozano designed a terracotta arch over 26th Street that greets visitors with “Bienvenidos a Little Village.”.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://littlevillagechamber.org/the-story-of-little-village/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Each September, Little Village celebrates Mexican Independence Day with a parade of colorful floats, mariachi bands, and dancing.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://littlevillagechamber.org/the-story-of-little-village/",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "After the Great Chicago Fire of 1871, German, Czech, and Polish immigrants flooded into the area that would become Little Village.",
      "sourceSentenceIds": [
        7
