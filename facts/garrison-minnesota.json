  "facts": [
    {
      "id": 1,
      "text": "Garrison was founded in the late 19th century during the logging era and has become known as the \"Walleye Capital of the World\".",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.wimnre.com/post/the-history-of-garrison-minnesota"
    },
    {
      "id": 2,
      "text": "The city’s name honors Oscar E. Garrison, a land surveyor and civil engineer who helped lay out the town in 1883.",
      "sourceSentenceIds": [
        4,
        7,
        20
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.wimnre.com/post/the-history-of-garrison-minnesota"
    },
    {
      "id": 3,
      "text": "A giant fiberglass walleye statue stands on Mille Lacs Lake’s shore in Garrison, symbolizing the town’s fishing heritage.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.wimnre.com/post/the-history-of-garrison-minnesota"
    },
    {
      "id": 4,
      "text": "The Ojibwe people established a permanent homeland around Mille Lacs in the mid‑1700s, founding what is now the Mille Lacs Band of Ojibwe.",
      "sourceSentenceIds": [
        6,
        9
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.wimnre.com/post/the-history-of-garrison-minnesota"
    },
    {
      "id": 5,
      "text": "In 1855 a treaty set aside a reservation for the Mille Lacs Band on the south end of Mille Lacs Lake.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.wimnre.com/post/the-history-of-garrison-minnesota"
    },
    {
      "id": 6,
      "text": "Garrison is the world’s smallest city to have a McDonald’s restaurant, a quirky claim that locals proudly celebrate.",
      "sourceSentenceIds": [
        26
