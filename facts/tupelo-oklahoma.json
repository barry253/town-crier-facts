  "facts": [
    {
      "id": 1,
      "text": "Tupelo is a city located in Coal County, Oklahoma, within the boundaries of the former Choctaw Nation in Indian Territory.",
      "sourceSentenceIds": [
        24,
        29
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 2"
      ],
      "source": "https://en.wikipedia.org/wiki/Tupelo%2C_Oklahoma"
    },
    {
      "id": 2,
      "text": "Tupelo was named after the Mississippi hometown of early entrepreneur William Napoleon McCary, which itself was named for the tupelo gum tree.",
      "sourceSentenceIds": [
        6,
        7
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Tupelo%2C_Oklahoma"
    },
    {
      "id": 3,
      "text": "Tupelo sits in the Sandstone Hills region of southeastern Oklahoma, a landscape historically suited for farming.",
      "sourceSentenceIds": [
        23
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/tupelo_oklahoma"
    },
    {
      "id": 4,
      "text": "By 1907, approximately 50,000 peach trees had been planted around Tupelo, leading to the opening of a canning factory in 1908.",
      "sourceSentenceIds": [
        8,
        12
      ],
      "sourceLabels": [
        "Web source 1",
        "Web source 2"
      ],
      "source": "https://www.okhistory.org/publications/enc/entry?entry=TU018"
    },
    {
      "id": 5,
      "text": "Rail service was vital to Tupelo, provided by the Missouri, Kansas and Texas Railway, Oklahoma Central Railway, and Missouri, Oklahoma and Gulf Railroad.",
