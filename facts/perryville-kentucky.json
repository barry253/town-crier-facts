  "facts": [
    {
      "id": 1,
      "text": "Perryville was named for Commodore Oliver Hazard Perry, the naval hero who won the Battle of Lake Erie in the War of 1812.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.perryvilleky.gov/",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "A row of commercial buildings built in the 1830s—known as Merchants' Row—still stands today along the Chaplin River.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.perryvilleky.gov/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Perryville became a Civil War flashpoint when the Battle of Perryville unfolded on October 8, 1862.",
      "sourceSentenceIds": [
        11
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.perryvilleky.gov/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The entire town was added to the National Register of Historic Places in 1973 for its historical significance.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Perryville%2C_Kentucky",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "James Harbeson and other Virginian settlers founded Harbeson's Station in the early 1780s, using a local cave for protection.",
      "sourceSentenceIds": [
        19
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.perryvilleky.gov/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "In 1961, Perryville and its surrounding area were designated a National Historic Landmark district.",
