  "facts": [
    {
      "id": 1,
      "text": "Rader Creek sits in southwestern Jefferson County, Montana, and is sparsely settled.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Rader_Creek%2C_Montana"
    },
    {
      "id": 2,
      "text": "The community takes its name from Rader Creek, a mountain stream that rises near the Continental Divide.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Rader_Creek%2C_Montana"
    },
    {
      "id": 3,
      "text": "Rader Creek flows northwest from the mountains, joins Little Pipestone Creek in the eastern part of the CDP.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Rader_Creek%2C_Montana"
    },
    {
      "id": 4,
      "text": "Both Rader Creek and Little Pipestone Creek belong to the Jefferson River watershed, which eventually feeds the Missouri River.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Rader_Creek%2C_Montana"
    },
    {
      "id": 5,
      "text": "The CDP covers about 20.25 square miles of land, with no water bodies within its boundaries.",
      "sourceSentenceIds": [
