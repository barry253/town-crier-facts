  "facts": [
    {
      "id": 1,
      "text": "In 1944 a local remembered walking six miles each way between McCutchanville School and his home on what is now Hitch‑Peters Road.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Melody_Hill%2C_Indiana",
      "category": "other",
      "quality": "poor",
      "qualityReason": "other"
    },
    {
      "id": 2,
      "text": "The older part of Melody Hill sits south of St. Route 41, while the newer 1960s homes rise on the north side of the same road.",
      "sourceSentenceIds": [
        13
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Melody_Hill%2C_Indiana",
      "category": "other",
      "quality": "poor",
      "qualityReason": "other"
    },
    {
      "id": 3,
      "text": "The neighborhood known as Melody Hills—note the “s”—consists only of the two streets off St. Route 41.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Melody_Hill%2C_Indiana",
      "category": "other",
      "quality": "poor",
      "qualityReason": "other"
    },
    {
      "id": 4,
      "text": "The area that became Melody Hill was once served by Center Township School #7, the Hooker School at Oak Hill and Whetstone Roads.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Melody_Hill%2C_Indiana",
      "category": "other",
      "quality": "poor",
      "qualityReason": "other"
    },
    {
      "id": 5,
      "text": "Knob Hill, just east of Melody Hill, features a single street of homes built around a small lake and hill.",
      "sourceSentenceIds": [
        15
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Melody_Hill%2C_Indiana",
      "category": "other",
      "quality": "poor",
      "qualityReason": "other"
    },
    {
      "id": 6,
      "text": "The community includes older subdivisions such as Melody Hills, Cloverlawn Estates, Ridgeview Estates, and Bergdolt Road.",
