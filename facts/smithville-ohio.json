  "facts": [
    {
      "id": 1,
      "text": "Smithville was founded in 1818 when pioneer Thomas Smith built a cabin on Portage Road.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.visitwaynecountyohio.com/communities/smithville/"
    },
    {
      "id": 2,
      "text": "The village’s name honors Thomas Smith, the settler who first established the community.",
      "sourceSentenceIds": [
        18
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Smithville%2C_Ohio"
    },
    {
      "id": 3,
      "text": "Pioneer Village, run by the Smithville Community Historical Society, showcases life from 1830 to 1890 in restored log cabins.",
      "sourceSentenceIds": [
        6,
        7
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.visitwaynecountyohio.com/communities/smithville/"
    },
    {
      "id": 4,
      "text": "The Downey Pioneer Visitor Center, originally built in 1830, now houses rotating exhibits and historic artifacts like a 1900 threshing machine.",
      "sourceSentenceIds": [
        1,
        15,
        16
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://sohchs.org/historic-buildings"
    },
    {
      "id": 5,
      "text": "A 1840s “Yankee” barn on the historic site features hand‑hewn beams and mortise‑and‑tenon construction.",
      "sourceSentenceIds": [
        11
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://sohchs.org/historic-buildings"
    },
    {
      "id": 6,
      "text": "Smithville’s historic Church of God, founded in 1838, still stands as a testament to the village’s early religious community.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://sohchs.org/historic-buildings"
    }
  ]
