      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "In 1968 the town renamed itself Mercier to honor former Quebec Premier Honoré Mercier.",
      "sourceSentenceIds": [
        20
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Mercier%2C_Quebec",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Église Saint‑Édouard, a Roman Catholic landmark, showcases beautiful stained‑glass windows and classic Quebec religious architecture.",
      "sourceSentenceIds": [
