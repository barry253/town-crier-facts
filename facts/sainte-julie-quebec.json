  "facts": [
    {
      "id": 1,
      "text": "Sainte-Julie takes its name from Julia of Corsica, a fifth‑century virgin martyr honored by the parish founded in 1850.",
      "sourceSentenceIds": [
        2,
        4
      ],
      "sourceLabels": [
        "Web source 2",
        "Wikipedia"
      ],
      "source": "https://www.comeexplorecanada.com/quebec/sainte-julie",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Residents pushed for their own parish in 1843, and by May 6, 1851 the municipality of Sainte-Julie was officially recognized.",
      "sourceSentenceIds": [
        12,
        13
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Sainte-Julie%2C_Quebec",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The 1980s saw Sainte-Julie connect to Montreal’s metro via a new public transport line to Longueuil, opening direct access for commuters.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Sainte-Julie%2C_Quebec",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Construction of Autoroute 20 in the mid‑1960s turned Sainte-Julie into a rapidly growing suburb south of Montreal.",
      "sourceSentenceIds": [
        16
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Sainte-Julie%2C_Quebec",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Hydro‑Quebec’s electricity interpretation centre, Électrium, is located in Sainte-Julie, offering visitors a hands‑on look at power generation.",
      "sourceSentenceIds": [
        22
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Sainte-Julie%2C_Quebec",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The city hosts La Vallée du Richelieu Golf Club’s Verchères course, a popular spot for golfers on the south shore.",
      "sourceSentenceIds": [
        23
      ],
