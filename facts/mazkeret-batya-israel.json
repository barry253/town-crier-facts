  "facts": [
    {
      "id": 1,
      "text": "Mazkeret Batya was founded in 1883 by 11 ultra‑Orthodox Russian farmers, becoming the first Hovevei Zion agricultural settlement.",
      "sourceSentenceIds": [
        17,
        18
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Mazkeret_Batya"
    },
    {
      "id": 2,
      "text": "In 1887 the town was renamed Mazkeret Batya to honor Betty Solomon de Rothschild, mother of Baron Edmond James de Rothschild.",
      "sourceSentenceIds": [
        3,
        22
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Mazkeret_Batya"
    },
    {
      "id": 3,
      "text": "The village originally relied on dry farming until Mekorot built a pipeline from Rehovot, transforming its agriculture.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Mazkeret_Batya"
    },
    {
      "id": 4,
      "text": "During the 1948 War of Independence, convoys to besieged Jerusalem departed from Mazkeret Batya, and a field hospital there treated Haganah fighters.",
      "sourceSentenceIds": [
        24,
        25
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Mazkeret_Batya"
    },
    {
      "id": 5,
      "text": "A railway station opened in the eastern part of town, linking it to the national network.",
      "sourceSentenceIds": [
        12,
        13
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://en.wikivoyage.org/wiki/Mazkeret_Batya"
    },
    {
      "id": 6,
      "text": "Mazkeret Batya hosts a heritage museum that showcases its stone houses, narrow lanes, and 19th‑century agricultural roots.",
