    },
    {
      "id": 2,
      "text": "Hodges sold a right‑of‑way to the San Antonio and Aransas Pass Railway and donated the local streets that now form Pettus’s main thoroughfares.",
      "sourceSentenceIds": [
        30
      ],
      "sourceLabels": [
