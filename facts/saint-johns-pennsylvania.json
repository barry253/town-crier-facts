  "facts": [
    {
      "id": 1,
      "text": "Saint Johns began as Hughesville, renamed in 1881 after its post office to honor the local church and avoid confusion with another borough.",
      "sourceSentenceIds": [
        1,
        9
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/saint_johns_pennsylvania",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Henry Benner built a sawmill in 1836, and Hughes' gristmill followed in 1853, turning Saint Johns into a farmer trading hub.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/saint_johns_pennsylvania",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Saint Johns sits at the crossroads of state routes amid fertile fields between Big and Little Nescopeck Creeks, just 0.1 miles from Drums.",
      "sourceSentenceIds": [
        25
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/saint_johns_pennsylvania",
      "category": "other",
      "quality": "poor",
      "qualityReason": "location_description"
    },
    {
      "id": 4,
      "text": "The town lies in the Appalachian Ridge and Valley province, once called “Towamensing” by the Lenape, meaning wilderness.",
      "sourceSentenceIds": [
        16
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/saint_johns_pennsylvania",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Early settlers arrived amid the Pennamite‑Yankee War, caught between Connecticut and Pennsylvania claimants over overlapping colonial land grants.",
      "sourceSentenceIds": [
        14
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/saint_johns_pennsylvania",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Today, Saint Johns remains a quiet residential enclave with limited commercial activity, part of the larger Scranton–Wilkes‑Barre metropolitan area.",
      "sourceSentenceIds": [
