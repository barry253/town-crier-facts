  "facts": [
    {
      "id": 1,
      "text": "Kenvir was founded in 1919 by the Black Mountain Coal Company on Yocum Creek, a tributary of the Clover Fork.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Kenvir%2C_Kentucky"
    },
    {
      "id": 2,
      "text": "The name Kenvir comes from the town's close proximity to the Kentucky-Virginia border.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Kenvir%2C_Kentucky"
    },
    {
      "id": 3,
      "text": "Kenvir was designed as a classic early twentieth century coal camp rather than a cluster of independent holdings.",
      "sourceSentenceIds": [
        21
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://appalachianhistorian.org/black-mountain-coal-company-and-the-camp-at-kenvir/"
    },
    {
      "id": 4,
      "text": "Everyday life in Kenvir once revolved around the company store and a scrip system used by the coal company.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://appalachianhistorian.org/black-mountain-coal-company-and-the-camp-at-kenvir/"
    },
    {
      "id": 5,
      "text": "Black Mountain Coal Company maintained its own hospital at Kenvir, which was one of only three in the county in 1931.",
      "sourceSentenceIds": [
        27
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://appalachianhistorian.org/black-mountain-coal-company-and-the-camp-at-kenvir/"
    },
    {
      "id": 6,
      "text": "Deep mining in Kenvir roughly ended in 1958 when the Black Mountain Coal Company shut down its mines.",
