  "facts": [
    {
      "id": 1,
      "text": "Hollister earned its name when residents renamed the “Meadows” after banker Clay Hollister and his son in the early 1900s.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.rrdailyherald.com/news/local/local-history-from-florine-bell-the-booming-town-of-hollister-part-2/article_b02ec102-1ca7-5823-bccb-1e7aeae38626.html"
    },
    {
      "id": 2,
      "text": "A 14‑and‑one‑half‑mile logging road built by Foster of Littleton linked Hollister to the Seaboard Air Line Railroad in Vaughan, hauling logs all the way to Norfolk.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.rrdailyherald.com/news/local/local-history-from-florine-bell-the-booming-town-of-hollister-part-2/article_b02ec102-1ca7-5823-bccb-1e7aeae38626.html"
    },
    {
      "id": 3,
      "text": "In 1904 the town’s history shifted when the Meadows underwent a dramatic transformation, marking a new era for Hollister.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.rrdailyherald.com/news/local/local-history-from-florine-bell-the-booming-town-of-hollister-part-2/article_b02ec102-1ca7-5823-bccb-1e7aeae38626.html"
    },
    {
      "id": 4,
      "text": "Matthews Place and White Rock Plantation, both historic homes in Hollister, are listed on the National Register of Historic Places.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Hollister%2C_North_Carolina"
    },
    {
      "id": 5,
      "text": "Hollister Elementary School and the nearby Haliwa‑Saponi Tribal School serve the community’s youth, reflecting the town’s educational heritage.",
      "sourceSentenceIds": [
        23
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Hollister%2C_North_Carolina"
    },
    {
