  "facts": [
    {
      "id": 1,
      "text": "McLean was founded in 1855 by Franklin Price, a Pennsylvania native, and incorporated as a village by 1866.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.theroute-66.com/mclean-il.html",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The village grew around the Alton and Springfield Railroad, which later became the Alton Railroad, and the town layout mirrored other railroad towns like Normal and Dwight.",
      "sourceSentenceIds": [
        11,
        12
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/McLean%2C_Illinois",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "A carriage factory opened in 1859 by Glotfelter and Harrison Wood, later operated by Woods and Stones, marking early industrial activity.",
      "sourceSentenceIds": [
        9,
        10
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.mclean-il.com/history/",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "McLean County, created in 1830, was named after John McLean, a territorial judge and Illinois congressman who served as a U.S. Senator in 1824‑1825.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.theroute-66.com/mclean-il.html",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The Hope–Funks Grove Library, part of McLean’s historical heritage, is a resource for those wanting to explore the village’s first century of history.",
      "sourceSentenceIds": [
