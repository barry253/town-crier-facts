  "facts": [
    {
      "id": 1,
      "text": "Thomaston was named after Seth Thomas, the clockmaker whose factory put the town on the map.",
      "sourceSentenceIds": [
        17,
        5,
        15
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.ct.one/towns/thomaston",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town’s clockmaking heritage began in 1803 when Eli Terry started mass production, later joined by Seth Thomas in 1812.",
      "sourceSentenceIds": [
        4,
        20,
        21
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Thomaston%2C_Connecticut",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Thomaston hosts the Railroad Museum of New England, where visitors can ride excursion trains along the Naugatuck River.",
      "sourceSentenceIds": [
        12,
        14
      ],
      "sourceLabels": [
        "Web source 1",
        "Web source 2"
      ],
      "source": "https://www.thomastonct.gov/culture-recreation/travel-tourism",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The town center once boasted the Seth Thomas Clock Company factory, whose building still stands as a reminder of the industry’s legacy.",
      "sourceSentenceIds": [
        6,
        8
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 2"
      ],
      "source": "https://en.wikipedia.org/wiki/Thomaston%2C_Connecticut",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Thomaston sits at the confluence of the Naugatuck River, Northfield Brook and Black Rock Brook, protected by U.S. Army Corps of Engineers flood control dams.",
      "sourceSentenceIds": [
        7,
        25
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Thomaston%2C_Connecticut",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The town was incorporated in 1875, carved from Plymouth, and grew around the clockmaking empire that shaped its identity.",
      "sourceSentenceIds": [
        23,
        15
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 2"
      ],
      "source": "https://en.wikipedia.org/wiki/Thomaston%2C_Connecticut",
      "category": "history",
      "quality": "good"
    }
