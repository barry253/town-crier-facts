  "facts": [
    {
      "id": 1,
      "text": "Rockland earned its name from its rocky terrain, which made it ideal for mills and industry rather than farming.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Rockland%2C_Massachusetts",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "In 1874, the town separated from Abington and incorporated as Rockland, marking its formal founding.",
      "sourceSentenceIds": [
        29
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Rockland%2C_Massachusetts",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The Grand Army of the Republic Hall, built in 1899, stands as one of Rockland’s earliest structures on the National Register of Historic Places.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Rockland%2C_Massachusetts",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "During the Civil War, Rockland’s shoe factories produced twice the number of shoes as neighboring Brockton, fueling the town’s industrial boom.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://rockland-ma.gov/622/Rockland-Historic-Commission",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The former Rockland High School, now the Community Center, began as Mckinley School in 1909 and reflects the town’s educational heritage.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Rockland%2C_Massachusetts",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "A spur of the Old Colony rail line once ran through Rockland, now abandoned, hinting at the town’s past rail connectivity.",
      "sourceSentenceIds": [
        10
