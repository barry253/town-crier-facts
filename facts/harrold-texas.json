  "facts": [
    {
      "id": 1,
      "text": "Harrold sprang up overnight in 1885 when the Fort Worth and Denver City Railway reached its western terminus, drawing a boom of settlers.",
      "sourceSentenceIds": [
        5,
        26
      ],
      "sourceLabels": [
        "Web source 1",
        "Web source 2"
      ],
      "source": "https://www.tshaonline.org/handbook/entries/harrold-tx",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Within a year, about 1,500 people had arrived, turning Harrold into a spirited frontier town with sixteen saloons.",
      "sourceSentenceIds": [
        27,
        29
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.tshaonline.org/handbook/entries/harrold-tx",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The community was renamed Harrold to honor promoter Ephraim Harrold, owner of the nearby Bar‑X Ranch.",
      "sourceSentenceIds": [
        22,
        23
      ],
      "sourceLabels": [
        "Web source 1",
        "Web source 2"
      ],
      "source": "https://www.tshaonline.org/handbook/entries/harrold-tx",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Harrold was originally called Cottonwood in the early 1880s, when a stage station and store stood near China Creek.",
      "sourceSentenceIds": [
        20,
        21
      ],
      "sourceLabels": [
        "Web source 1",
        "Web source 2"
      ],
      "source": "https://www.tshaonline.org/handbook/entries/harrold-tx",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "A school opened around 1893, and by 1900 Methodist, Baptist, and Church of Christ congregations were organized in town.",
      "sourceSentenceIds": [
        30,
        28
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.tshaonline.org/handbook/entries/harrold-tx",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Prospective settlers were welcomed with train rides from Wichita Falls and a brass band that greeted them at the new town’s gates.",
      "sourceSentenceIds": [
        6,
        16
      ],
