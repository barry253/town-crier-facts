      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Snoqualmie Falls served as the backdrop for many exterior shots in David Lynch’s Twin Peaks and its 1992 film Fire Walk with Me.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
