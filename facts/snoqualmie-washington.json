      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The historic Snoqualmie Depot, built in 1890, has been restored to its turn‑of‑the‑century grandeur and still operates as a train station.",
      "sourceSentenceIds": [
        1,
        3,
        12
      ],
