      "category": "culture",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Every summer, Snoqualmie celebrates Railroad Days, Movies and Music in the Park, and the Tree Lighting Festival, drawing locals and tourists alike.",
      "sourceSentenceIds": [
        14
      ],
      "sourceLabels": [
