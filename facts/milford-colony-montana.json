  "facts": [
    {
      "id": 1,
      "text": "Milford Colony was established in 1947 as a communal Anabaptist settlement for the Hutterian Brethren, who share property, labor, and resources.",
      "sourceSentenceIds": [
        1,
        5
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/milford_colony_montana"
    },
    {
      "id": 2,
      "text": "Milford Colony is situated in the valley of Flat Creek, an east-flowing tributary of the Dearborn River.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Milford_Colony%2C_Montana"
    },
    {
      "id": 3,
      "text": "The community focuses on agriculture, including grain production and dairy operations, contributing to the local economy through markets and taxes.",
      "sourceSentenceIds": [
        11
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/milford_colony_montana"
    },
    {
      "id": 4,
      "text": "Milford Colony has expanded its network by founding three daughter colonies in Montana, including Springdale, Big Sky, and Elk Creek.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/milford_colony_montana"
    },
    {
      "id": 5,
      "text": "Early pioneers at Milford Colony constructed basic communal housing, barns, and a central kitchen to support their collective lifestyle on the prairie.",
      "sourceSentenceIds": [
        15
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/milford_colony_montana"
