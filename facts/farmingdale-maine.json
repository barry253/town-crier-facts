  "facts": [
    {
      "id": 1,
      "text": "Farmingdale was incorporated in 1852, merging parts of South Hallowell, North Gardiner, and East/West Gardiner.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Farmingdale%2C_Maine",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The Kennebec River forms the eastern border of Farmingdale, and the town's riverbanks once hosted shipyards, brickyards, pottery, and a glue factory.",
      "sourceSentenceIds": [
        17,
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Farmingdale%2C_Maine",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Farmingdale's historic ice industry included the Knickerbocker Ice Company, the largest ice company in the country, and the Marshall Ice Company, both operating at Bowman's Point.",
      "sourceSentenceIds": [
        11
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Farmingdale%2C_Maine",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The Peter Grant House and the Captain Nathaniel Stone House in Farmingdale are listed on the National Register of Historic Places.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Farmingdale%2C_Maine",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Farmingdale never developed a town center comparable to Gardiner or Augusta, and its commercial growth centered in neighboring cities.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Farmingdale%2C_Maine",
      "category": "other",
      "quality": "poor",
      "qualityReason": "other"
    },
    {
      "id": 6,
      "text": "In the 21st century, Farmingdale remains a quiet residential community for people who work in Augusta, offering family-friendly neighborhoods.",
      "sourceSentenceIds": [
        14,
        29
      ],
