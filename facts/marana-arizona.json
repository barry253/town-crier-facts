  "facts": [
    {
      "id": 1,
      "text": "Marana got its name from the Spanish word maraña, meaning thicket, after railroad workers cut through thick mesquite stands in the 1880s.",
      "sourceSentenceIds": [
        1,
        18
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 2"
      ],
      "source": "https://en.wikipedia.org/wiki/Marana%2C_Arizona",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Marana hosts the oldest‑known cemetery in the American Southwest and the earliest canals in North America, evidence of Hohokam engineering.",
      "sourceSentenceIds": [
        27
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Marana%2C_Arizona",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The Butterfield Overland Stage Company built remount stations at Pointer Mountain, Nelson’s Desert Ranch, and Picacho Pass near Marana in 1858.",
      "sourceSentenceIds": [
        19
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.maranaaz.gov/Marana-Life/Marana-Heritage",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "On April 15, soldiers at Picacho Pass Butterfield Stage Station fought a brief skirmish with Confederate cavalry, the westernmost Civil War conflict.",
