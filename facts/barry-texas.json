  "facts": [
    {
      "id": 1,
      "text": "Barry, Texas, takes its name from Bryan Thomas Barry, a Corsicana landowner who sold 300 acres to early settlers.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://texaslocalhistory.com/navarro/towns/barry/index.htm"
    },
    {
      "id": 2,
      "text": "When the railroad between Corsicana and Hillsboro opened in 1888, residents moved Barry to sit beside the tracks.",
      "sourceSentenceIds": [
        6,
        7
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Barry%2C_Texas"
    },
    {
      "id": 3,
      "text": "A public school opened in 1896, serving a settlement that also had a post office, general store, and gin.",
      "sourceSentenceIds": [
        23
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Barry%2C_Texas"
    },
    {
      "id": 4,
      "text": "By 1914, Barry’s population of 400 boasted two banks, a newspaper, hotel, stores, eateries, a blacksmith, and three churches.",
      "sourceSentenceIds": [
        24
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Barry%2C_Texas"
    },
    {
      "id": 5,
      "text": "Originally located a mile south of its current site, Barry now sits within Navarro County, Texas.",
      "sourceSentenceIds": [
        20,
        22
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Barry%2C_Texas"
