  "facts": [
    {
      "id": 1,
      "text": "Lincoln, Virginia, began as the Quaker settlement Goose Creek in the 1750s before being renamed after President Lincoln in 1860.",
      "sourceSentenceIds": [
        2,
        3
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Lincoln%2C_Virginia",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The village sits in the heart of the Goose Creek Historic District, the first rural historic district designated in Virginia.",
      "sourceSentenceIds": [
        10,
        12
      ],
      "sourceLabels": [
        "Web source 1",
        "Wikipedia"
      ],
      "source": "https://www.lincolncommunityleague.org/lincoln-history.html",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Lincoln’s stone Meeting House, originally built in 1765, now stands beside the historic Quaker cemetery that dates back to the early 1730s.",
      "sourceSentenceIds": [
        29,
        9
      ],
      "sourceLabels": [
        "Web source 1",
        "Wikipedia"
      ],
      "source": "https://www.lincolncommunityleague.org/lincoln-history.html",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Grace Methodist Episcopal Church, founded in Lincoln, was one of the first legally recognized Black churches in Loudoun County.",
      "sourceSentenceIds": [
        17
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.lincolncommunityleague.org/lincoln-history.html",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Lincoln’s landscape was originally part of the vast Northern Neck Grant, a 5.2‑million‑acre parcel given by Charles II to the Culpepper and Fairfax families.",
