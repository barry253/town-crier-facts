      "quality": "poor",
      "qualityReason": "location_description"
    },
    {
      "id": 4,
      "text": "With irrigation and citrus‑fruit farming introduced in the early 1920s, Rangerville evolved into a key shipping point for the region.",
      "sourceSentenceIds": [
        29
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.tshaonline.org/handbook/entries/rangerville-tx",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "By 1922 the town had about fifty residents and five businesses, and a post office operated there from 1924 until 1942.",
      "sourceSentenceIds": [
        28
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.tshaonline.org/handbook/entries/rangerville-tx",
      "category": "history",
      "quality": "good"
    },
    {
