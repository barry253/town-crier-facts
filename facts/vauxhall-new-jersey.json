  "facts": [
    {
      "id": 1,
      "text": "Vauxhall evolved from a 19th‑century farming community into a diverse urban center.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/vauxhall_new_jersey",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The East Branch of the Rahway River borders Vauxhall, and a 1831 gristmill by Lewis Pierson dammed the river.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/vauxhall_new_jersey",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The Lewis Pierson House, a Greek Revival temple‑fronted home built in 1843, is a rare architectural gem in Vauxhall.",
      "sourceSentenceIds": [
        19
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/vauxhall_new_jersey",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The Vauxhall Historical Society, founded in 1972, preserves artifacts, documents, and photographs of the town’s past.",
      "sourceSentenceIds": [
        8,
        9
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://museumsdatabase.com/museums/view/19934",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The society hosts lectures, exhibits, and tours each year, engaging residents with Vauxhall’s cultural heritage.",
      "sourceSentenceIds": [
        10,
        11
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://museumsdatabase.com/museums/view/19934",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Vauxhall is home to the Home Depot Superstore, the chain’s largest store in the world as of 2012, covering 217,000 square feet.",
      "sourceSentenceIds": [
        21
