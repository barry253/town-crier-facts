      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "In 1825, Thomas Cole, a founder of the Hudson River School, painted his first Catskill mountain works in Haines Falls, including the Kaaterskill Falls.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Wikipedia"
