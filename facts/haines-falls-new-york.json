      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Haines Falls, New York, is home to the former Catskill Mountain House and Kaaterskill Hotel, which were located atop the famous Kaaterskill Falls.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
