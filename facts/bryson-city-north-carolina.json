  "facts": [
    {
      "id": 1,
      "text": "Bryson City was originally called Charleston and served as Swain County seat when the county split from surrounding counties.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Bryson_City%2C_North_Carolina",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town’s layout was a T‑shape formed by Main and Everett streets, the latter named after first sheriff Epp Everett.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Bryson_City%2C_North_Carolina",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The Western North Carolina Railroad arrived in 1884, turning Bryson City into a rail hub that later became the Great Smoky Mountains Railroad depot.",
      "sourceSentenceIds": [
        8,
        12
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Bryson_City%2C_North_Carolina",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Bryson City sits just west of the confluence of the Tuckasegee River and Deep Creek, rivers that flow from the Great Smoky Mountains.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Bryson_City%2C_North_Carolina",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The area was once Cherokee land; a 640‑acre reservation was granted to Chief Big Bear near the river confluence in 1818.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Bryson_City%2C_North_Carolina",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Bryson City is the base of the Eastern Band of Cherokee Indians, the only federally recognized tribe in North Carolina.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
