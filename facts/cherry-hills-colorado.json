  "facts": [
    {
      "id": 1,
      "text": "Cherry Hills Village got its name from a grove of cherry trees that lined the original town site.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Cherry_Hills_Village%2C_Colorado"
    },
    {
      "id": 2,
      "text": "The area that is now Cherry Hills Village began as a rural estate plot in 1900, with lots remaining unsold into the early 20th century.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/Cherry_Hills_Village,_Colorado"
    },
    {
      "id": 3,
      "text": "In 1938, the community organized a steering committee that divided the town into six districts, each electing a trustee.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.cherryhillsvillage.com/315/History-of-Cherry-Hills-Village"
    },
    {
      "id": 4,
      "text": "The town officially incorporated on July 19, 1945, becoming a home‑rule city in Arapahoe County.",
      "sourceSentenceIds": [
        12,
        13
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Cherry_Hills_Village%2C_Colorado"
    },
    {
      "id": 5,
      "text": "Cherry Hills Country Club, founded in 1922, has hosted three U.S. Open golf championships and multiple PGA events.",
      "sourceSentenceIds": [
        14,
        15,
        16,
        17
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Cherry_Hills_Village%2C_Colorado"
    },
    {
      "id": 6,
      "text": "Early settlers were drawn to the area for its scenic beauty, proximity to the country club, and local schools like Cherry Hills School on Quincy Avenue.",
      "sourceSentenceIds": [
        3
      ],
