  "facts": [
    {
      "id": 1,
      "text": "Albrightsville derives its name from Aquilla Albright, an early landowner who acquired a significant portion of the Brotzman tract in 1840.",
      "sourceSentenceIds": [
        30
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/Albrightsville,_Pennsylvania",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The area was frontier wilderness until the early 19th century, when logging operations in the Pocono region spurred settlement.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/Albrightsville,_Pennsylvania",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Albright and associates were destroyed by a flood in 1841, after which a forge was briefly rebuilt before abandonment in 1860, reflecting early iron manufacturing.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/Albrightsville,_Pennsylvania",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Albrightsville has a warm-summer humid continental climate, with January lows around 23.5°F and July highs near 68.5°F.",
      "sourceSentenceIds": [
        11
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Albrightsville%2C_Pennsylvania",
      "category": "nature",
      "quality": "poor",
      "qualityReason": "vague"
    },
    {
      "id": 5,
      "text": "Mud Run, which forms the township boundary, drains westward into the Lehigh River.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Albrightsville%2C_Pennsylvania",
