  "facts": [
    {
      "id": 1,
      "text": "Midway earned its name because it sits exactly midway between Pittsburgh and Steubenville on the historic Pennsylvania Railroad.",
      "sourceSentenceIds": [
        3,
        4
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://midwayborough.org/",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The borough occupies the head of Robinson’s Run on the boundary of Smith and Robinson Townships, formed from parts of both.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://midwayborough.org/",
      "category": "other",
      "quality": "poor",
      "qualityReason": "location_description"
    },
    {
      "id": 3,
      "text": "Before the Civil War, a village called Egypt stood here for forty years, long before Midway was established.",
      "sourceSentenceIds": [
        14
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://midwayborough.org/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Midway is celebrated for its historic charm and friendly atmosphere, plus outdoor activities like hiking and fishing nearby.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://pennsylvaniainfo.blog/midway-pennsylvania-living-guide",
      "category": "culture",
      "quality": "poor",
      "qualityReason": "other"
    },
    {
      "id": 5,
      "text": "Washington County, where Midway lies, is noted for its rich agricultural heritage and scenic landscapes that add to the town’s appeal.",
      "sourceSentenceIds": [
        19
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://pennsylvaniainfo.blog/midway-pennsylvania-living-guide",
      "category": "other",
      "quality": "poor",
      "qualityReason": "location_description"
    },
    {
      "id": 6,
      "text": "Midway sits 16 miles north of Washington, Pennsylvania, placing it comfortably within the county’s central corridor.",
