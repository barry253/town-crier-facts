    },
    {
      "id": 2,
      "text": "Thunderbird Bay emerged during the mid-twentieth century as a private planned residential subdivision for people seeking waterfront living.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/thunderbird_bay_texas"
    },
    {
      "id": 3,
      "text": "Initial construction in Thunderbird Bay began in the 1960s, with thirty-three structures built between 1960 and 1969.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/thunderbird_bay_texas"
    },
    {
      "id": 4,
      "text": "The Thunderbird Bay Owners' Association was incorporated in 1976 to oversee shared amenities and maintain a family-friendly environment.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/thunderbird_bay_texas"
    },
    {
      "id": 5,
      "text": "Thunderbird Bay features a humid subtropical climate with hot, humid summers and mild winters.",
      "sourceSentenceIds": [
