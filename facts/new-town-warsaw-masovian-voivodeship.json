  "facts": [
    {
      "id": 1,
      "text": "New Town, founded in the early 15th century north of Old Warsaw, remained an independent city until 1791 when it merged into Warsaw.",
      "sourceSentenceIds": [
        21,
        23,
        24,
        22
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/New_Town%2C_Warsaw",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Baroque elegance thrives here, with ornate residences and churches such as the Holy Spirit Church and Kotowski Palace dating from the 17th and 18th centuries.",
      "sourceSentenceIds": [
        3,
        30
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/New_Town%2C_Warsaw",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "After World War II, architects restored the district’s late‑18th‑century appearance using paintings and photographs, a feat that helped earn UNESCO World Heritage status in 1980.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/New_Town,_Warsaw",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The grid‑like streets weave through remnants of medieval defensive walls and the historic Bridge Gate, echoing the area’s original fortifications.",
      "sourceSentenceIds": [
        7,
        19
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/New_Town,_Warsaw",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "New Town shelters the Royal Route, historic royal residences, Jewish monuments, and the modern Palace of Culture and Science, blending past and present.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://en.wikivoyage.org/wiki/Warsaw",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "During the 1944 Warsaw Uprising, Nazis demolished over 85 % of the district, yet postwar reconstruction rebuilt it as a symbol of Polish resilience.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/New_Town,_Warsaw",
      "category": "history",
