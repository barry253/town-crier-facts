      ],
      "source": "https://whitecone.navajochapters.org/"
    },
    {
      "id": 3,
      "text": "The chapter’s mission is to promote education, health, and economic development while preserving traditional values.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://whitecone.navajochapters.org/"
    },
    {
      "id": 4,
      "text": "White Cone sits 6,110 feet above sea level, roughly one‑half a mile high.",
      "sourceSentenceIds": [
