  "facts": [
    {
      "id": 1,
      "text": "Stirling City was named after the Stirling Boiler Company, whose boiler inspired the name chosen by Diamond Match official Fred Clough.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Stirling_City%2C_California",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town’s history museum sits in a 1930s U.S. Forest Service fire station, preserving logging heritage from the Diamond Match Company era.",
      "sourceSentenceIds": [
        8,
        17
      ],
      "sourceLabels": [
        "Web source 1",
        "Web source 2"
      ],
      "source": "https://www.explorebuttecounty.com/places/stirling-city-historical-society",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Founded in 1903 by the Diamond Match Company of Barberton, Ohio, Stirling City began as a lumber processing center for surrounding forests.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Stirling_City%2C_California",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "A Southern Pacific Railroad loop ran through Stirling City, built to haul lumber from Lassen National Forest to the town’s mill.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Stirling_City%2C_California",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Since 2003, the Stirling City Historical Society has operated the museum, run by volunteers dedicated to preserving the town’s rich history.",
      "sourceSentenceIds": [
        1,
        2
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://museumsdatabase.com/museums/view/3142",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "During the 2018 Camp Fire, Stirling City suffered minimal damage thanks to protection by California Department of Forestry and Fire Protection.",
      "sourceSentenceIds": [
        24
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
