      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The hospital once buried medical waste in six unlined landfills, prompting decades of environmental cleanup.",
      "sourceSentenceIds": [
        28
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/castle_point_new_york",
      "category": "other",
      "quality": "poor",
      "qualityReason": "other"
    },
    {
      "id": 4,
      "text": "During the Revolutionary War, local farms supplied wheat, corn, and livestock to Continental Army troops passing the Hudson.",
      "sourceSentenceIds": [
        17
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/castle_point_new_york",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Wappinger Creek, a 41.7‑mile tributary, runs through Castle Point and has caused occasional flooding in recent years.",
