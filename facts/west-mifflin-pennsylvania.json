      ],
      "source": "https://www.localoffices.org/historical-society/pennsylvania/west-mifflin"
    },
    {
      "id": 4,
      "text": "West Mifflin borders the Monongahela River three times, giving the borough a distinctive riverfront character.",
      "sourceSentenceIds": [
        20,
        22
      ],
      "sourceLabels": [
        "Wikipedia"
