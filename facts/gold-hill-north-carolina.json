  "facts": [
    {
      "id": 1,
      "text": "Gold Hill’s first gold discovery in 1824 sparked a boom that made the town one of North Carolina’s richest mining centers before the Civil War.",
      "sourceSentenceIds": [
        2,
        28,
        29
      ],
      "sourceLabels": [
        "Web source 1",
        "Wikipedia"
      ],
      "source": "https://historicgoldhill.org/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The Gold Hill Mines Historic Park, now 70 acres, opened in 1993 after a 16‑acre donation and preserves original mine sites and trails.",
      "sourceSentenceIds": [
        3,
        6
      ],
      "sourceLabels": [
        "Web source 2",
        "Wikipedia"
      ],
      "source": "https://www.visitrowancountync.com/places-to-visit/gold-hill/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "In the 1840s, Gold Hill was a raucous mining camp with numerous saloons and brothels, a far cry from its quiet historic village today.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Gold_Hill%2C_North_Carolina",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The Barnhardt shaft, opened in 1842, reached 435 feet and was one of the deepest gold mines in the region.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Gold_Hill%2C_North_Carolina",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Every September, Gold Hill hosts Founders Day, a parade and live music that celebrates its gold‑mining heritage and community spirit.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.visitrowancountync.com/places-to-visit/gold-hill/",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The historic village’s wooden sidewalks and restored buildings were moved and rebuilt to recreate a 19th‑century mining town atmosphere.",
      "sourceSentenceIds": [
        9
