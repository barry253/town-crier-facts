  "facts": [
    {
      "id": 1,
      "text": "Nash was founded during the Cherokee Outlet land run on September 16, 1893, as part of the largest land run in U.S. history.",
      "sourceSentenceIds": [
        18
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/nash_oklahoma"
    },
    {
      "id": 2,
      "text": "Originally called Nashville, the town was renamed Nash in 1911 to honor its first postmaster, Clark L. Nash.",
      "sourceSentenceIds": [
        10,
        11
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/nash_oklahoma"
    },
    {
      "id": 3,
      "text": "The arrival of the Denver, Enid and Gulf Railroad in 1905 helped Nash grow into a viable farming hub.",
      "sourceSentenceIds": [
        16,
        20,
        21
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/nash_oklahoma"
    },
    {
      "id": 4,
      "text": "Early industry in Nash included a broom factory established in 1906 to process locally grown broomcorn.",
      "sourceSentenceIds": [
        3,
        13,
        15
      ],
      "sourceLabels": [
