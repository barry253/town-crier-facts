  "facts": [
    {
      "id": 1,
      "text": "Shawmut’s post office was the first in Wheatland County, opening in 1885, closing in 1887, and reopening in 1888.",
      "sourceSentenceIds": [
        2,
        4
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.mtmemory.org/nodes/view/128381"
    },
    {
      "id": 2,
      "text": "The town’s name reflects its founder’s Boston ties and the Algonquin word for Boston, meaning “Living waters.”.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.mtmemory.org/nodes/view/128381"
    },
    {
      "id": 3,
      "text": "Shawmut lies along the Musselshell River, about 16 miles east of Harlowton.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.visitmt.com/cities-towns/shawmut"
    },
    {
      "id": 4,
      "text": "A dinosaur species, Avaceratops lammersi, was discovered near Shawmut and now lives in Harlowton’s Upper Musselshell Museum.",
      "sourceSentenceIds": [
        11
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.visitmt.com/cities-towns/shawmut"
    },
    {
      "id": 5,
      "text": "The original postmaster of Shawmut was Francis E. Shaw.",
      "sourceSentenceIds": [
        13
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.mtmemory.org/nodes/view/128381"
    },
    {
      "id": 6,
      "text": "During its heyday, Shawmut boasted a hotel, store, restaurant, lumberyard, hardware store, and grain elevator.",
