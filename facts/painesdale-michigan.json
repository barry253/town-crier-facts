  "facts": [
    {
      "id": 1,
      "text": "Painesdale was built by Champion Mining Company between 1899 and 1917 and named after Boston businessman William Paine.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Painesdale%2C_Michigan",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town’s layout features rows of identical saltbox workers’ houses and more individualized managers’ houses, reflecting efficient planning.",
      "sourceSentenceIds": [
        13
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Painesdale%2C_Michigan",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "In 1967 the Champion Mine #4, the town’s lifeblood, closed, leaving behind a single shaft house still visible in the lower part of town.",
      "sourceSentenceIds": [
        21,
        14
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://99wfmk.com/painesdale-michigan/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Painesdale was added to the National Register of Historic Places in 1993, preserving its mining heritage.",
      "sourceSentenceIds": [
        4,
        5
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Painesdale%2C_Michigan",
      "category": "landmark",
      "quality": "good"
    },
