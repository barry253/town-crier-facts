      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Grace Episcopal Church, founded on a 1747 site, was rebuilt in Gothic style in 1855 after a fire and restored in 1895.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/keswick_virginia",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Keswick Hall, a historic estate turned luxury resort, reopened in 2021 after major renovations, reflecting early 20th‑century development.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/keswick_virginia",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "A post office opened in 1849 and was renamed Keswick in August 1887, marking the town’s formal recognition.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
