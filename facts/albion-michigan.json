      ],
      "source": "https://cityofalbionmi.gov/residents/city_at_a_glance/history.php",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The Festival of the Forks, held each summer, celebrates Albion’s heritage and diverse cultures with food, music, and art.",
