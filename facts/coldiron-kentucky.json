  "facts": [
    {
      "id": 1,
      "text": "Coldiron takes its name from the pioneering Coldiron family, whose ancestors settled the area in the early 1800s.",
      "sourceSentenceIds": [
        2,
        3,
        9
      ],
      "sourceLabels": [
        "Web source 1",
        "Web source 2"
