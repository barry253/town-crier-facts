  "facts": [
    {
      "id": 1,
      "text": "Flemington was named after Squire John Flemming, a Revolutionary War soldier who purchased over 1,600 acres in the area in 1770.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Flemington%2C_Pennsylvania"
    },
    {
      "id": 2,
      "text": "The Flemings, who were among the first settlers of Flemington, were descended from the Earl of Wigtown of Scotland.",
      "sourceSentenceIds": [
        12,
        13
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Flemington%2C_Pennsylvania"
    },
    {
      "id": 3,
      "text": "Flemington is situated along Bald Eagle Creek and the remnants of the Bald Eagle Crosscut Canal in southern Clinton County.",
      "sourceSentenceIds": [
        14
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Flemington%2C_Pennsylvania"
    },
    {
      "id": 4,
      "text": "The Bald Eagle Crosscut Canal supported local milling and farming until railroads took precedence in the 1870s.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/flemington_pennsylvania"
    },
    {
      "id": 5,
      "text": "Flemington was annexed to Lock Haven in 1868 before being restored as an independent borough in 1878.",
      "sourceSentenceIds": [
        29
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/flemington_pennsylvania"
    },
    {
      "id": 6,
      "text": "Early industrial landmarks in Flemington included a grist mill built in 1854 and a sawmill established in 1860.",
      "sourceSentenceIds": [
        30
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/flemington_pennsylvania"
    }
