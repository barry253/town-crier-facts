  "facts": [
    {
      "id": 1,
      "text": "Alpha was named after the Greek letter Alpha because the first mill in Greene County stood there.",
      "sourceSentenceIds": [
        1,
        3,
        4
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Alpha%2C_Ohio",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The original Alpha Mill, built by Owen Davis in 1798, still stands at 745 Alpha Road and marks the town’s earliest industrial site.",
      "sourceSentenceIds": [
        10,
        25
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/alpha_ohio",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "A post office has served Alpha continuously since 1850, making it one of the county’s oldest operating institutions.",
      "sourceSentenceIds": [
        17
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Alpha%2C_Ohio",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Alpha’s location on the historic Pinckney Road linked Cincinnati to Bellbrook and made it a key stop before the railroad era.",
      "sourceSentenceIds": [
        14
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/alpha_ohio",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Little Beaver Creek runs through Alpha, its waters once powered grist mills and shaped the local landscape.",
      "sourceSentenceIds": [
        6,
        9
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/alpha_ohio",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The town’s first courthouse was a 25‑foot square log cabin built by General Benjamin Whiteman, later used as Greene County’s first court in 1803.",
      "sourceSentenceIds": [
        22,
