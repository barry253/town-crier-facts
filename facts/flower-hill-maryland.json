  "facts": [
    {
      "id": 1,
      "text": "The Flower Hill Village Historical Gallery opened in September 2023, thanks to Village Historian Mitchell Schwartz.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://villageflowerhill.gov/about-us/flower-hill-village-historical-gallery/",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Housed inside Village Hall, the gallery displays historic images, documents, and maps of Flower Hill and its surrounding communities.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://villageflowerhill.gov/about-us/flower-hill-village-historical-gallery/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Visitors can explore the gallery at their own pace— it is self‑guided and open to both residents and non‑residents.",
      "sourceSentenceIds": [
        13,
        16
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://villageflowerhill.gov/about-us/flower-hill-village-historical-gallery/",
      "category": "other",
      "quality": "poor",
      "qualityReason": "editorial_filler"
    },
    {
      "id": 4,
      "text": "A free guidebook, available online and as a downloadable PDF, walks guests through the gallery’s exhibits and layout.",
      "sourceSentenceIds": [
        4,
        9,
        10,
        30
      ],
      "sourceLabels": [
        "Web source 1",
        "Web source 2"
      ],
      "source": "https://www.longislandpress.com/2024/02/22/the-village-of-flower-hill-puts-together-a-guidebook-to-the-flower-hill-historical-gallery/",
      "category": "other",
      "quality": "poor",
      "qualityReason": "editorial_filler"
    },
    {
      "id": 5,
      "text": "The gallery’s mission is to preserve local heritage, strengthen community pride, and foster a love of history among all visitors.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://villageflowerhill.gov/about-us/flower-hill-village-historical-gallery/",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Exhibits in the gallery cover not only Flower Hill’s past but also the histories of Greater Manhasset, Port Washington, and Roslyn.",
