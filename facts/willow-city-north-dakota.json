  "facts": [
    {
      "id": 1,
      "text": "Willow City was founded in 1884 by Thomas Halvorson and renamed from McCrea to Willow City in 1886 because of the many willow trees that lined the area.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/willow_city_north_dakota",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The Great Northern Railway laid tracks through Willow City in 1886, linking the town to Bottineau and the West Coast.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Willow_City%2C_North_Dakota",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Willow City held its first election in 1890 and officially incorporated as a city in 1906.",
      "sourceSentenceIds": [
        11
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Willow_City%2C_North_Dakota",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Willow City hosts the nation's smallest annual Relay for Life, raising cancer research funds per capita at a record rate.",
      "sourceSentenceIds": [
        28
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/willow_city_north_dakota",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Frederick McCrea opened the first inland post office in the area, initially naming it McCrea before the town became Willow City.",
