  "facts": [
    {
      "id": 1,
      "text": "Elmwood, a Georgian mansion built around 1774 by Muscoe Garnett, stands as Loretto's most notable landmark.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/loretto_virginia",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The historic Vauter family home, a T‑shaped brick building in Flemish bond, exemplifies colonial expansion near the Rappahannock River.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/loretto_virginia",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Loretto sits on the Rappahannock River Valley, where low‑lying farmland and forested patches shape its topography.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/loretto_virginia",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Brooke's Bank, Elmwood, Port Micou, Vauter's Church, and Wheatland are all listed on the National Register of Historic Places.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Loretto%2C_Virginia",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The hamlet overlooks the Rappahannock River Valley and preserves colonial and antebellum architecture, reflecting ties to early settlers and free Black landowners.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/loretto_virginia",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Loretto emerged in the eighteenth or early nineteenth century at a crossroads of secondary roads west from the Tidewater Trail.",
      "sourceSentenceIds": [
        11
      ],
      "sourceLabels": [
        "Web source 1"
      ],
