      "quality": "good"
    },
    {
      "id": 2,
      "text": "In 1902 the community shifted two miles east to become a stop on the International‑Great Northern Railroad.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.tshaonline.org/handbook/entries/malone-tx",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "By 1913 Malone boasted thirty businesses, including eight grocery stores, two banks, four cotton gins, and two hotels.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.tshaonline.org/handbook/entries/malone-tx",
