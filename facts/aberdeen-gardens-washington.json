  "facts": [
    {
      "id": 1,
      "text": "Aberdeen Gardens was founded in 1884 by pioneer Samuel Benn, who saw the area’s potential for growth.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
