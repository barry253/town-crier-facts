  "facts": [
    {
      "id": 1,
      "text": "Ferndale has historic attractions, including the Benson-Hammon House that displays late 1800s farming equipment and Victorian textiles.",
      "sourceSentenceIds": [
        24,
        25
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.islands.com/2073607/between-baltimore-annapolis-friendly-ferndale-maryland-village-streets/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The village sits just 10 miles south of Baltimore, offering suburban ease while staying cheaper and less crowded than the city.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.islands.com/2073607/between-baltimore-annapolis-friendly-ferndale-maryland-village-streets/",
      "category": "other",
      "quality": "poor",
      "qualityReason": "location_description"
    },
    {
      "id": 3,
      "text": "Ferndale’s streets are known for their friendliness and laid‑back charm, making it a popular local playground rather than a tourist hub.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.islands.com/2073607/between-baltimore-annapolis-friendly-ferndale-maryland-village-streets/",
      "category": "other",
      "quality": "poor",
      "qualityReason": "other"
    },
    {
      "id": 4,
      "text": "Arundel Plaza on Ferndale’s eastern edge connects to Pleasantville Park via walkable residential streets, providing a convenient shopping and park experience.",
      "sourceSentenceIds": [
        23
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.islands.com/2073607/between-baltimore-annapolis-friendly-ferndale-maryland-village-streets/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The Ferndale Civic Association hosts annual events like Ferndale Day, an Easter Fair, and a Christmas tree‑lighting ceremony each year.",
      "sourceSentenceIds": [
        28,
        29
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.islands.com/2073607/between-baltimore-annapolis-friendly-ferndale-maryland-village-streets/",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The Benson-Hammon House, open alternating Saturdays from March to November, charges a $7 donation for adult non‑members and $3 for minors.",
