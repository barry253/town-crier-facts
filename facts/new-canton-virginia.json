  "facts": [
    {
      "id": 1,
      "text": "New Canton was officially founded in November 1793 when the Virginia General Assembly authorized a town on 25 acres donated by William Cannon.",
      "sourceSentenceIds": [
        5,
        4,
        6
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/New_Canton%2C_Virginia",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town sits on the James River near Bear Garden Creek, placing it in Buckingham County’s rolling Piedmont landscape.",
      "sourceSentenceIds": [
        5,
        1
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 2"
      ],
      "source": "https://en.wikipedia.org/wiki/New_Canton%2C_Virginia",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "In the mid‑1880s a railroad bridge over the James River connected New Canton to Bremo Bluff, replacing the old ferry and spurring rail traffic.",
      "sourceSentenceIds": [
        16,
        17
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/New_Canton%2C_Virginia",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Remnants of an old iron factory and nearby mines still dot the area, hinting at the region’s brief 19th‑century mining era.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://kids.kiddle.co/New_Canton,_Virginia",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The Cannon family’s ferry and warehouse, operated since the mid‑1700s, laid the commercial groundwork that led to the town’s establishment.",
      "sourceSentenceIds": [
        11
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/new_canton_virginia",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Buckingham County, formed in 1761 from Albemarle County, surrounds New Canton and is named after the English county.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 2"
      ],
