      "category": "culture",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Herriman Mansion, a preserved 19th‑century home, stands as a testament to Wadena’s early architectural heritage.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
