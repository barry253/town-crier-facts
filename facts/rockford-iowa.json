  "facts": [
    {
      "id": 1,
      "text": "Rockford sits where the Shell Rock and Winnebago rivers meet, giving the town a unique river confluence.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Rockford%2C_Iowa"
    },
    {
      "id": 2,
      "text": "The first settler arrived in August 1851, building a small cabin on the south bank of the Winnebago River.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://rockfordiowa.org/history.php"
    },
    {
      "id": 3,
      "text": "In 1865 a Howe Truss bridge spanned the Shell Rock River, and by 1871 the Burlington, Cedar Rapids, and Minnesota Railroad had linked Rockford to the line.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://rockfordiowa.org/history.php"
    },
    {
      "id": 4,
      "text": "On July 4, 1918, residents dedicated an unfinished bandstand that still stands in Central Park today.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://rockfordiowa.org/history.php"
    },
    {
      "id": 5,
      "text": "What began as a clay pit for the defunct Rockford Brick and Tile Company is now a public county park owned by Floyd County.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Rockford%2C_Iowa"
    },
    {
