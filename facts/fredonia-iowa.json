  "facts": [
    {
      "id": 1,
      "text": "Fredonia sits just east of where the Iowa and Cedar Rivers meet, placing it on the river’s east bank.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Fredonia%2C_Iowa"
    },
    {
      "id": 2,
      "text": "Alvin Clark founded Fredonia in 1836 as a ferry landing, and the town was formally surveyed that same year.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/fredonia_iowa"
    },
    {
      "id": 3,
      "text": "In the 19th century, Fredonia served as a key river port, moving lumber and grain via steamboats and barges.",
      "sourceSentenceIds": [
        11
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/fredonia_iowa"
    },
    {
      "id": 4,
      "text": "Because of its flat river valley setting, Fredonia faces occasional flooding from the Iowa and Cedar Rivers.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/fredonia_iowa"
    },
    {
      "id": 5,
      "text": "Local lore says Fredonia almost became Iowa’s capital, losing the vote by a single point in the 1830s.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/fredonia_iowa"
    },
    {
      "id": 6,
      "text": "Fredonia is one of Iowa’s oldest continuously incorporated towns, having been incorporated in 1851.",
