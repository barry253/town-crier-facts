  "facts": [
    {
      "id": 1,
      "text": "Taylorsville was named for General Zachary Taylor while he fought in the Mexican–American War.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Taylorsville%2C_North_Carolina",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town was founded in 1847, the same year Alexander County was created, and incorporated in 1879.",
      "sourceSentenceIds": [
        11,
        23
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Taylorsville%2C_North_Carolina",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Taylorsville serves as the county seat of Alexander County, hosting the historic courthouse and county offices.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Taylorsville%2C_North_Carolina",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The Old Jail Museum, a former county jail, now houses a genealogical library and local history exhibits.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.taylorsvillenc.com/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Every spring the town hosts the Apple Blossom Festival, drawing visitors to downtown for music, food, and crafts.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.taylorsvillenc.com/",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Taylorsville’s scenic parks, like Courthouse Park, offer walking trails and a historic tree‑lighting ceremony each winter.",
      "sourceSentenceIds": [
        1,
        7
      ],
