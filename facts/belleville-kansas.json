  "facts": [
    {
      "id": 1,
      "text": "Belleville was founded in 1869 and incorporated as a city in 1878, a milestone still celebrated.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Belleville%2C_Kansas",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town was named for Arabelle Tutton, the wife of a member of the town company.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Belleville%2C_Kansas",
      "category": "people",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Belleville is the home of the historic Highbanks Racetrack, built in 1910 and dubbed the world’s fastest half‑mile dirt track.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.bellevilleks.org/history-of-belleville.html",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The High Banks Hall of Fame and National Midget Auto Racing Museum opened in 2004 to preserve Belleville’s racing heritage.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.bellevilleks.org/history-of-belleville.html",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The Blair Theatre, a historic art‑deco movie house, sits beside the Highbanks Hall of Fame and the Republic County Historical Museum.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.cityofbellevillekansas.com/about-us",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Belleville’s Boyer Museum showcases animated carvings, and the town boasts art‑deco architecture and Rocky Pond as local landmarks.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.bellevilleks.org/history-of-belleville.html",
