  "facts": [
    {
      "id": 1,
      "text": "Centreville earned its name because it sits roughly midway between the county seats of Liberty and Woodville and between Natchez and Baton Rouge.",
      "sourceSentenceIds": [
        29
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://townofcentrevillems.org/about-us"
    },
    {
      "id": 2,
      "text": "The town sprang to life in the 1800s when the Yazoo and Mississippi Valley Railroad cut tracks through region, laying the town on either side of the line.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://townofcentrevillems.org/about-us"
    },
    {
      "id": 3,
      "text": "Bethany Presbyterian Church, built in 1855, stands as a National Register of Historic Places landmark in Centreville.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Centreville%2C_Mississippi"
    },
    {
      "id": 4,
      "text": "Centreville was officially incorporated on March 8, 1884, just a month after the first locomotive arrived.",
      "sourceSentenceIds": [
        13
