  "facts": [
    {
      "id": 1,
      "text": "Founded in 1924 by patent‑medicine magnate George Francis Willis, Avondale Estates grew from the former Ingleside village into a planned community.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Avondale_Estates%2C_Georgia",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The city’s name honors Stratford‑upon‑Avon, England, the birthplace of William Shakespeare.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Avondale_Estates%2C_Georgia",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Downtown buildings and many homes showcase Tudor‑style architecture, echoing the English inspiration behind the town’s design.",
      "sourceSentenceIds": [
        14
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Avondale_Estates%2C_Georgia",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Avondale Estates was officially incorporated in 1927, solidifying its status within DeKalb County.",
      "sourceSentenceIds": [
        15
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Avondale_Estates%2C_Georgia",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Granite underlies the entire city, with outcrops visible along the shore of Lake Avondale.",
