  "facts": [
    {
      "id": 1,
      "text": "Southeastern’s roots trace back to the early 1600s when English, Dutch, and Swedish explorers first charted the Delaware River, sparking the region’s colonial era.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://genpa.org/public-collections/pennsylvania-resources/pennsylvania-regions/southeast-pennsylvania/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The area that is now southeastern Pennsylvania is famously known as Pennsylvania Dutch Country, where Amish, Mennonite, and ‘Fancy Dutch’ communities still thrive.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://genpa.org/public-collections/pennsylvania-resources/pennsylvania-regions/southeast-pennsylvania/",
      "category": "people",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Immigrants flocked to the Philadelphia region in the 1700s, drawn by booming manufacturing, publishing, textile, and railroad jobs that shaped the local economy.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://genpa.org/public-collections/pennsylvania-resources/pennsylvania-regions/southeast-pennsylvania/",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Southeastern Pennsylvania spans ten counties—Berks, Bucks, Chester, Delaware, Lancaster, Lebanon, Lehigh, Montgomery, Northampton, and Philadelphia—each with its own unique history.",
      "sourceSentenceIds": [
        19
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://genpa.org/public-collections/pennsylvania-resources/pennsylvania-regions/southeast-pennsylvania/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "William Penn’s 1681 charter granted nearly all of present-day Pennsylvania, and his ‘Holy Experiment’ promised religious freedom that attracted English, Welsh, and Huguenot settlers.",
      "sourceSentenceIds": [
        27,
