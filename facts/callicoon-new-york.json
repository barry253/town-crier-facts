  "facts": [
    {
      "id": 1,
      "text": "Callicoon was renamed Callicoon Depot when the Erie Railroad built its Delaware Division in 1848, making the station the town’s heart.",
      "sourceSentenceIds": [
        2,
        3,
        9
      ],
      "sourceLabels": [
        "Web source 1",
        "Wikipedia"
      ],
      "source": "https://visitcallicoon.com/callicoon-history/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The first settlers were Dutch hunters from the Hudson Valley in the 1600s, and the name “Kollikoonkill” means Wild Turkey Creek.",
      "sourceSentenceIds": [
        13,
        23,
        24
      ],
      "sourceLabels": [
        "Web source 1",
        "Wikipedia"
      ],
      "source": "https://visitcallicoon.com/callicoon-history/",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "A 1888 fire nearly destroyed Main Street, leaving only buildings older than that year, a fact etched into the town’s history.",
      "sourceSentenceIds": [
        15
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://visitcallicoon.com/callicoon-history/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Callicoon hosts an annual Tractor Parade each June, where over 200 antique and modern tractors march down Main Street.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Callicoon_(CDP)%2C_New_York",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The last passenger train ran on November 27, 1966, after which tourism grew, bringing campgrounds, canoe liveries, and bed‑and‑breakfast inns.",
      "sourceSentenceIds": [
        26,
        27,
        28
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Callicoon_(CDP)%2C_New_York",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The Upper Delaware Scenic and Recreational River was established in 1978 to protect the valley’s natural beauty and the Delaware River’s quality.",
