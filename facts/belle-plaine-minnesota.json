  "facts": [
    {
      "id": 1,
      "text": "Belle Plaine’s name comes from French, meaning “Beautiful Prairie,” and it was the only borough in Minnesota from 1868 to 1974.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Belle_Plaine%2C_Minnesota",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "In 1853, Judge Chatfield chose Belle Plaine as a halfway court stop while traveling between Mendota and Traverse des Sioux.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Belle_Plaine%2C_Minnesota",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Legislation in 1870 and 1871 helped develop Belle Plaine’s salt springs, donating state land and funding drilling efforts.",
      "sourceSentenceIds": [
        8,
        10
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Belle_Plaine%2C_Minnesota",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The historic Hooper Bowler Hillstrom House, a preserved 19th‑century residence, remains a local landmark for visitors.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.belleplainemn.gov/266/Visitors",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The Minnesota River winds northeast through Belle Plaine, giving the town a scenic riverside setting.",
