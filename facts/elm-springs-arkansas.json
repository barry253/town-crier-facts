      ],
      "source": "https://en.wikipedia.org/wiki/Elm_Springs%2C_Arkansas",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Two minor skirmishes were fought in Elm Springs on April 26 and July 30, 1863.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Elm_Springs%2C_Arkansas",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Elm Springs sits between the Boston Mountains and the Springfield Plateau in the Ozark Mountains.",
