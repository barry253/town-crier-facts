  "facts": [
    {
      "id": 1,
      "text": "Millbrae got its name from a settler who combined his surname Mills with the Scottish word for rolling hills, brae.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.thesanfranciscopeninsula.com/places-to-go/millbrae/history/",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "In 1976, the Millbrae Historical Society saved the train depot by having it declared a national historic landmark.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.thesanfranciscopeninsula.com/places-to-go/millbrae/history/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The Millbrae Historical Society created the Millbrae History Walk, a self‑guided tour of the city’s most significant landmarks.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.thesanfranciscopeninsula.com/places-to-go/millbrae/history/"
    },
    {
      "id": 4,
      "text": "The San Francisco and San Jose Railroad began operations in 1863, directly linking Millbrae to Market Street and later to San Jose.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Millbrae%2C_California"
    },
    {
      "id": 5,
      "text": "A failed 1970s attempt to save the Sixteen Mile House sparked the Millbrae Historical Society, which later preserved the train station and now houses the Millbrae Historical Museum.",
