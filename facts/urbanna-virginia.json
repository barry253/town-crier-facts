  "facts": [
    {
      "id": 1,
      "text": "Urbanna was named 'City of Anne' in honor of England's Queen Anne when founded in 1706.",
      "sourceSentenceIds": [
        5,
        7
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 2"
      ],
      "source": "https://en.wikipedia.org/wiki/Urbanna%2C_Virginia"
    },
    {
      "id": 2,
      "text": "The James Mills Scottish Factor Store, built around 1765, is the last remaining Scottish Factor Store on the continent and now houses the Urbanna Museum.",
      "sourceSentenceIds": [
        1,
        27,
        11
      ],
      "sourceLabels": [
        "Web source 1",
        "Web source 2",
        "Wikipedia"
      ],
      "source": "https://urbannava.gov/pages/history-of-urbanna.php"
    },
    {
      "id": 3,
      "text": "The museum displays a first‑edition 1755 John Mitchell Map, a prized artifact of colonial Virginia.",
      "sourceSentenceIds": [
        15,
        11
      ],
      "sourceLabels": [
        "Web source 1",
        "Wikipedia"
      ],
      "source": "https://urbannava.gov/pages/history-of-urbanna.php"
    },
    {
      "id": 4,
      "text": "Urbanna’s irregular grid street pattern is a direct carryover from its 1706 founding layout.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://urbanna.com/pages/history-of-urbanna.php"
    },
    {
      "id": 5,
      "text": "Two National Register plantations flank the town: Ralph Wormeley’s Rosegill and Hewick, reflecting its colonial elite heritage.",
      "sourceSentenceIds": [
        16,
        24
      ],
      "sourceLabels": [
        "Web source 1",
        "Web source 2"
      ],
      "source": "https://urbannava.gov/pages/history-of-urbanna.php"
    },
    {
      "id": 6,
      "text": "As Chesapeake Bay vessels shifted from sailing ships to schooners, steamboats, and modern pleasure boats, Urbanna’s fortunes have always been tied to the bay.",
      "sourceSentenceIds": [
        17,
        25
      ],
      "sourceLabels": [
        "Web source 1",
        "Web source 2"
      ],
      "source": "https://urbannava.gov/pages/history-of-urbanna.php"
    }
  ]
