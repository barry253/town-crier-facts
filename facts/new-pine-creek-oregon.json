  "facts": [
    {
      "id": 1,
      "text": "New Pine Creek is the southernmost community in Oregon, sitting just south of the boundary line that nominally separates the state from California.",
      "sourceSentenceIds": [
        11,
        18
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/New_Pine_Creek%2C_Oregon"
    },
    {
      "id": 2,
      "text": "A nineteenth-century surveying error caused New Pine Creek to be placed in Oregon instead of California, a status that remains today.",
      "sourceSentenceIds": [
        20,
        23
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/New_Pine_Creek%2C_Oregon"
    },
    {
      "id": 3,
      "text": "New Pine Creek is considered the oldest settlement in Lake County, with early prospectors and farmers arriving in the 1870s.",
      "sourceSentenceIds": [
        6,
        30
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/new_pine_creek_oregon"
    },
    {
      "id": 4,
      "text": "Postal authorities renamed the town New Pine Creek in 1876 because another settlement was already using the name Pine Creek.",
      "sourceSentenceIds": [
        2,
        4,
        9
      ],
      "sourceLabels": [
        "Web source 1",
        "Wikipedia"
      ],
      "source": "https://grokipedia.com/page/new_pine_creek_oregon"
    },
    {
      "id": 5,
      "text": "New Pine Creek experienced a massive boom during the 1912 gold rush, with the population peaking at around 5,000 residents.",
      "sourceSentenceIds": [
        26
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/new_pine_creek_oregon"
    },
    {
      "id": 6,
      "text": "The local economy of New Pine Creek now revolves around ranching, retirement living, and the region's rare rainbow obsidian deposits.",
      "sourceSentenceIds": [
