  "facts": [
    {
      "id": 1,
      "text": "Bruntsfield's name comes from 'Brounysfelde' or Brown's Fields, after the owner of Bruntsfield House built on Crown land in the Burgh Muir.",
      "sourceSentenceIds": [
        2,
        26
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://edinburghdaily.co.uk/area-guide/discover-bruntsfield-edinburgh-historic-links-shops-neighborhood-gem/",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Sophia Jex‑Blake, a pioneering feminist physician, founded Bruntsfield Hospital for Women in 1885 and opened a purpose‑built wing in 1911.",
      "sourceSentenceIds": [
        5,
        6
      ],
      "sourceLabels": [
        "Web source 1",
        "Web source 2"
      ],
      "source": "https://www.scottish-places.info/features/featurefirst7773.html",
      "category": "people",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Muriel Spark, author of 'The Prime of Miss Jean Brodie', lived in Bruntsfield; the film’s opening scene shows her walking from Admiral Terrace to school.",
      "sourceSentenceIds": [
        4,
        16
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 2"
      ],
      "source": "https://en.wikipedia.org/wiki/Bruntsfield",
      "category": "people",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The former Chic Murray hotel on Bruntsfield Crescent, later the Nova Hotel, was owned by comedian Chic Murray and his wife Maidie.",
      "sourceSentenceIds": [
        1,
        13
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 2"
      ],
      "source": "https://en.wikipedia.org/wiki/Bruntsfield",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Bruntsfield Place lies less than a mile south of Princes Street, making it a short walk from Edinburgh’s main thoroughfare.",
      "sourceSentenceIds": [
        20
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Bruntsfield",
      "category": "other",
      "quality": "poor",
      "qualityReason": "location_description"
    },
    {
      "id": 6,
      "text": "The area was part of the feudal barony of Colinton, originally within the Burgh Muir, linking it to Edinburgh’s medieval past.",
