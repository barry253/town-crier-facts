      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Perry’s Victory and International Peace Memorial on Put‑in‑Bay commemorates the 1813 naval battle that secured American control of Lake Erie.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.villageofpib.com/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The Lake Erie Islands Historical Society Museum, a 6,000‑square‑foot building, preserves artifacts and genealogy from the entire Great Lakes region.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Put-in-Bay%2C_Ohio",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Put‑in‑Bay’s only grocery, hardware, school, and post office serve a tight‑knit community that relies on ferry and air links to the mainland.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Put-in-Bay%2C_Ohio",
