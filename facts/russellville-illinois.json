  "facts": [
    {
      "id": 1,
      "text": "Russellville was named for the Russell brothers, August, Andrew, and Clement, who supplied lumber for the town’s first buildings.",
      "sourceSentenceIds": [
        1,
        2
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Russellville%2C_Illinois",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The village’s roots trace back to a fort built by Samuel and Jonathan Allison near an abandoned Indian village called “Little Village” in the early 1800s.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Russellville%2C_Illinois",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Russellville sits on the west bank of the Wabash River, the natural border between Illinois and Indiana.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Russellville%2C_Illinois",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Illinois Route 33 cuts through the village center, linking Russellville north to Palestine and south to Westport across the river from Vincennes.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Russellville%2C_Illinois",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "In 1834, Gustavus Russell erected the first steam-powered sawmill in Eastern Illinois, a landmark industrial first for the region.",
      "sourceSentenceIds": [
        23
      ],
      "sourceLabels": [
