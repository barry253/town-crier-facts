  "facts": [
    {
      "id": 1,
      "text": "Newington’s name comes from the second Truro Parish glebe house completed in 1760, later home of Richard and Sarah McCarty Chichester.",
      "sourceSentenceIds": [
        5,
        7
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Newington%2C_Virginia"
    },
    {
      "id": 2,
      "text": "The Alexandria and Fredericksburg Railway opened a station on Newington property in April 1872, originally called Long Branch Station.",
      "sourceSentenceIds": [
        2,
        8
      ],
      "sourceLabels": [
        "Web source 1",
        "Wikipedia"
      ],
      "source": "https://newingtonva.org/historic-sites/newington-historical-marker/"
    },
    {
      "id": 3,
      "text": "The original Long Branch Station closed in 1971, the last known as Newington, and a historic marker was erected in 2005.",
      "sourceSentenceIds": [
        1,
        11
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Newington%2C_Virginia"
    },
    {
      "id": 4,
      "text": "A house on the Nevitt property burned in 1875; its ruins remain and are marked by a 2006 historic marker owned by Fairfax County Park Authority.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Newington%2C_Virginia"
    },
    {
      "id": 5,
      "text": "Newington sits at 38°44′7″N 77°12′13″W, bordered by Springfield, Franconia, Fort Belvoir, Lorton, Newington Forest, and West Springfield.",
