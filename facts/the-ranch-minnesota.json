  "facts": [
    {
      "id": 1,
      "text": "The Ranch got its name from Moses Lagarde, a Civil War veteran who farmed the area and ran a hotel in nearby Beaulieu.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/the_ranch_minnesota"
    },
    {
      "id": 2,
      "text": "The Ranch covers just 0.31 square miles, all inside the White Earth Indian Reservation, and has no significant water bodies.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/the_ranch_minnesota"
    },
    {
      "id": 3,
      "text": "Mahnomen County, where The Ranch sits, was carved from Norman County on December 27, 1906, entirely within the reservation.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/the_ranch_minnesota"
    },
    {
      "id": 4,
      "text": "Farmers in The Ranch rely on fertile Mollisols and Alfisols soils, which support crops like wheat, oats, corn, and barley.",
      "sourceSentenceIds": [
        19,
        29
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/the_ranch_minnesota"
    },
    {
      "id": 5,
      "text": "The Ranch sits at latitude 47.32°N and longitude 95.70°W, placing it in northwestern Minnesota’s rural agricultural heartland.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/the_ranch_minnesota"
    },
    {
      "id": 6,
      "text": "Wild rice harvesting on the White Earth Reservation historically yielded about 10,000 bushels annually, a staple for the Ojibwe people.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/the_ranch_minnesota"
    }
  ]
