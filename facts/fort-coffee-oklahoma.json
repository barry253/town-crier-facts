  "facts": [
    {
      "id": 1,
      "text": "Fort Coffee is a town in Le Flore County, Oklahoma, that traces its beginnings to the Choctaw removal in 1832.",
      "sourceSentenceIds": [
        25,
        27
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Fort_Coffee%2C_Oklahoma"
    },
    {
      "id": 2,
      "text": "The U.S. Army established Fort Coffee in 1834 to stop the influx of illegal whiskey and contraband into Indian Territory.",
      "sourceSentenceIds": [
        13,
        19
      ],
      "sourceLabels": [
        "Web source 1",
        "Web source 2"
      ],
      "source": "https://www.okhistory.org/publications/enc/entry?entry=FO058"
    },
    {
      "id": 3,
      "text": "Fort Coffee was named for General John Coffee, a veteran of the Seminole Wars.",
      "sourceSentenceIds": [
        6,
        26
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Fort_Coffee%2C_Oklahoma"
    },
    {
      "id": 4,
      "text": "The army abandoned Fort Coffee in 1838 when Fort Smith was reestablished.",
      "sourceSentenceIds": [
        10,
        14
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Fort_Coffee%2C_Oklahoma"
    },
    {
      "id": 5,
      "text": "The site of Fort Coffee served as a port on the Arkansas River for the Choctaw Indian tribe.",
      "sourceSentenceIds": [
        20,
        28
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 2"
      ],
      "source": "https://en.wikipedia.org/wiki/Fort_Coffee%2C_Oklahoma"
    },
    {
      "id": 6,
      "text": "Riverboats and several railroads once transported cotton from Fort Coffee to outside markets.",
