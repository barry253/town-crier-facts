  "facts": [
    {
      "id": 1,
      "text": "New Market bills itself as the \"Antiques capital of Maryland\" and hosts over 30 specialty shops on its historic Main Street.",
      "sourceSentenceIds": [
        12,
        9
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 2"
      ],
      "source": "https://en.wikipedia.org/wiki/New_Market%2C_Maryland"
    },
    {
      "id": 2,
      "text": "The town grew along the National Road, a colonial route that opened in 1807 and became the Gateway to the West.",
      "sourceSentenceIds": [
        1,
        15
      ],
      "sourceLabels": [
        "Web source 2",
        "Wikipedia"
      ],
      "source": "https://www.islands.com/1995267/new-market-maryland-situated-between-baltimore-frederick-charming-town-aerial-adventures-shopping-centers/"
    },
    {
      "id": 3,
      "text": "New Market’s historic district earned a spot on the National Register of Historic Places in 1975, preserving its 18th‑century charm.",
      "sourceSentenceIds": [
        23
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/New_Market%2C_Maryland"
    },
    {
      "id": 4,
      "text": "Every first Saturday in December, New Market celebrates \"Christmas in New Market,\" a holiday event that draws visitors to its festive streets.",
      "sourceSentenceIds": [
        27
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/New_Market%2C_Maryland"
    },
    {
      "id": 5,
      "text": "From June through October, the town hosts free concerts, movies, and art markets on the second Saturday of each month.",
      "sourceSentenceIds": [
        28
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/New_Market%2C_Maryland"
    },
    {
      "id": 6,
      "text": "New Market sits roughly midway between Baltimore and Frederick, offering a blend of small‑town nostalgia, antiques, and outdoor adventure.",
      "sourceSentenceIds": [
        5
      ],
