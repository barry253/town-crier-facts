    },
    {
      "id": 2,
      "text": "The Taylors Falls Library, a historic building on Bench Street, is listed on the National Register of Historic Places.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://taylorsfallsmn.gov/our-community/"
    },
    {
      "id": 3,
      "text": "The city’s name honors Jesse Taylor, a territorial politician who was among its earliest settlers.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Taylors_Falls%2C_Minnesota"
    },
    {
      "id": 4,
      "text": "Taylors Falls sits on cliffs overlooking the St. Croix River, offering dramatic river views.",
      "sourceSentenceIds": [
        11
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://taylorsfallsmn.gov/our-community/"
    },
    {
      "id": 5,
      "text": "Platted in 1850 or 1851, Taylors Falls was incorporated as a city in 1858.",
