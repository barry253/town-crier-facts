  "facts": [
    {
      "id": 1,
      "text": "Founded in 1853 as Cross City, Corinth was renamed after the ancient Greek crossroads city.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Corinth%2C_Mississippi"
    },
    {
      "id": 2,
      "text": "Its railroad junction, where the Mobile‑Ohio and Memphis‑Charleston lines meet, made Corinth a Civil War flashpoint.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.corinthms.gov/tourism"
    },
    {
      "id": 3,
      "text": "The Second Battle of Corinth, fought Oct. 3‑4 1862, ended after a month‑long siege that turned the town into a Union stronghold.",
      "sourceSentenceIds": [
        17,
        19,
        21
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Corinth%2C_Mississippi"
    },
    {
      "id": 4,
      "text": "During the war, Corinth hosted a contraband camp that many historians called a 'model' refuge for escaped slaves.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Corinth%2C_Mississippi"
    },
    {
      "id": 5,
      "text": "The Northeast Mississippi Museum’s Civil War Interpretive Center, part of the National Park Service, preserves the town’s battle history.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Corinth%2C_Mississippi"
    },
    {
      "id": 6,
      "text": "Corinth serves as the county seat of Alcorn County and sits directly on the Mississippi‑Tennessee state line.",
      "sourceSentenceIds": [
        15,
        16
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Corinth%2C_Mississippi"
