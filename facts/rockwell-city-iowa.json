      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://calhouncountyiowa.com/communities/rockwell_city/"
    },
    {
      "id": 3,
      "text": "The Calhoun County Historical Museum, housed in the former high school building, opened its doors in 1986.",
      "sourceSentenceIds": [
