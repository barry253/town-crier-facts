  "facts": [
    {
      "id": 1,
      "text": "Friendswood was founded in 1895 by Quakers led by Frank Jacob Brown and Thomas Hadley Lewis, who sought a promised land for their faith.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.ci.friendswood.tx.us/402/History-of-Friendswood",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The settlers named the new community Friendswood, a nod to their Quaker heritage and the nearby Friends Church.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.ci.friendswood.tx.us/402/History-of-Friendswood",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "In its early years, Friendswood’s economy thrived on growing and preserving Magnolia figs, with fig orchards dotting the landscape.",
      "sourceSentenceIds": [
        27,
        17
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 2"
      ],
      "source": "https://en.wikipedia.org/wiki/Friendswood%2C_Texas",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "A Texas State Historical Marker on the Friends Church property authenticates Friendswood’s history as a predominantly Quaker settlement.",
      "sourceSentenceIds": [
        2,
        3
      ],
      "sourceLabels": [
        "Web source 1",
        "Web source 2"
      ],
      "source": "https://www.ci.friendswood.tx.us/402/History-of-Friendswood",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The city endured a devastating blow when Hurricane Harvey struck in 2017, flooding many neighborhoods and reshaping its recovery efforts.",
      "sourceSentenceIds": [
        11
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Friendswood%2C_Texas",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "After 1950, Friendswood shifted from a small farming community to a suburban bedroom town as Houston residents sought its peaceful countryside.",
      "sourceSentenceIds": [
        28
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
