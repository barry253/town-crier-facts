    },
    {
      "id": 2,
      "text": "The area now known as Chesnee was originally inhabited by the Cherokee people for centuries prior to European contact.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/Chesnee,_South_Carolina"
    },
    {
      "id": 3,
      "text": "The Zeno Hicks House, a vernacular farmhouse built in 1886, is listed on the National Register of Historic Places.",
      "sourceSentenceIds": [
        3,
