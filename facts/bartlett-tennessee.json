      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Davies Manor, the oldest home in Bartlett, sits on a plantation and is listed on the National Register of Historic Places, showcasing antebellum architecture.",
      "sourceSentenceIds": [
        2,
        16
      ],
      "sourceLabels": [
