  "facts": [
    {
      "id": 1,
      "text": "Bonnie Doon’s name means “pleasant hill,” inspired by Scotland’s River Doon and Robert Burns’ poem.",
      "sourceSentenceIds": [
        21
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.bonniedoondentist.com/the-history-and-heart-of-bonnie-doon-a-vibrant-edmonton-community/",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The neighborhood grew around the old Edmonton streetcar line, with a 91‑Street terminus that still leaves a streetcar‑line triangle near Bulgogi House.",
      "sourceSentenceIds": [
        11,
        12
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://yeg.tracksintime.ca/riding-the-rails-of-bonnie-doons-past/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Bonnie Doon Shopping Centre sits where Whyte Avenue meets 83 Street and once housed Sears, Target, and Blockbuster before becoming a mix of modern retailers.",
      "sourceSentenceIds": [
        3,
        4,
        14
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Bonnie_Doon_Shopping_Centre",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Edmonton’s Valley Line LRT now stops at Bonnie Doon, linking the historic valley community directly to downtown.",
      "sourceSentenceIds": [
        19
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Bonnie_Doon_Shopping_Centre",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The area is known for its scenic North Saskatchewan River views and a strong French‑Canadian presence, hosting events like Fête franco‑albertaine.",
      "sourceSentenceIds": [
        20,
        29
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.bonniedoondentist.com/the-history-and-heart-of-bonnie-doon-a-vibrant-edmonton-community/",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Father Albert Lacombe, a missionary who helped settle Edmonton, is celebrated as a foundational figure in Bonnie Doon’s early history.",
