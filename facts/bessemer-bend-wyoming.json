  "facts": [
    {
      "id": 1,
      "text": "Bessemer Bend served as a vital crossing for emigrants on the California, Mormon Pioneer, Oregon, and Pony Express trails.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.nps.gov/places/000/bessemer-bend-national-historic-site.htm"
    },
    {
      "id": 2,
      "text": "Most overlanders used the Bessemer Bend ford to cross the North Platte River before the first ferry was established in 1847.",
      "sourceSentenceIds": [
        26
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.nps.gov/places/000/bessemer-bend-national-historic-site.htm"
    },
    {
      "id": 3,
      "text": "Travelers often used the free ford at Bessemer Bend to avoid paying tolls at downstream ferries and bridges.",
      "sourceSentenceIds": [
        27
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.nps.gov/places/000/bessemer-bend-national-historic-site.htm"
    },
    {
      "id": 4,
      "text": "Bessemer Bend provided a scenic camping area for pioneers, with the majestic Red Buttes rising to the south.",
      "sourceSentenceIds": [
        29
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.nps.gov/places/000/bessemer-bend-national-historic-site.htm"
    },
    {
      "id": 5,
      "text": "Emigrants leaving the Platte River system at Bessemer Bend finally moved away from the waters that guided them across the Plains.",
      "sourceSentenceIds": [
        30
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.nps.gov/places/000/bessemer-bend-national-historic-site.htm"
    },
    {
      "id": 6,
      "text": "The North Platte River at Bessemer Bend typically flowed about three hundred yards wide and three feet deep during the summer.",
      "sourceSentenceIds": [
        28
      ],
