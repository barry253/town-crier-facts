  "facts": [
    {
      "id": 1,
      "text": "Suquamish means “people of the clear salt water” in Lushootseed, reflecting their historic fishing and canoe building skills.",
      "sourceSentenceIds": [
        20
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://suquamish.nsn.us/home/about-us/history-culture/",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The village hosts the Old Man House, a winter longhouse that once sheltered the Suquamish tribe and now marks a historic burial site of Chief Seattle.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Suquamish%2C_Washington",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Suquamish Museum curates artifacts from the tribe, including handcrafted jewelry and art that tell stories spanning centuries.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://suquamishmuseum.org/",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The Suquamish Tribe’s history dates back thousands of years, with ancestors thriving in the Puget Sound before European contact.",
      "sourceSentenceIds": [
        21
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://suquamish.nsn.us/home/about-us/history-culture/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "In 1792, Captain George Vancouver’s expedition mapped the Puget Sound, bringing the first direct contact between Suquamish people and Europeans.",
      "sourceSentenceIds": [
        27
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://suquamish.nsn.us/home/about-us/history-culture/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The Suquamish community once housed Northwest College of Art & Design, which later became the Chief Kitsap Building after the tribe purchased the property.",
      "sourceSentenceIds": [
        18
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
