  "facts": [
    {
      "id": 1,
      "text": "Weston got its name on June 15, 1869, when the post office was renamed after professional pedestrian Edward Payson Weston.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Fairfield_Township%2C_Lenawee_County%2C_Michigan",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The first post office in the area opened as Baker's on January 29, 1835, with Orrin Baker as its first postmaster.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Fairfield_Township%2C_Lenawee_County%2C_Michigan",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The Lake Shore and Michigan Southern Railway once had a depot in Weston, linking the town to regional trade routes.",
      "sourceSentenceIds": [
        23
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Fairfield_Township%2C_Lenawee_County%2C_Michigan",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Weston’s Local History Room, housed in the public library, preserves artifacts and records that trace the town’s early days.",
      "sourceSentenceIds": [
        6,
        7
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://westonpl.org/history-resources/weston-local-history",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Andrew Millet, the first European settler, arrived in Weston in 1824, laying the groundwork for the community that would follow.",
