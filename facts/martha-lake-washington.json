  "facts": [
    {
      "id": 1,
      "text": "Martha Lake’s name simply means a body of water named Martha, reflecting the town’s early settlers’ affection for the lake.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.wisdomlib.org/cities/martha-lake-21915",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The Rucker Mansion, built in the late 1800s by the prominent Rucker family, still stands as a testament to the town’s early prosperity.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://beckdc.com/historical-places-in-martha-lake/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The Rhodes Mansion, constructed in the early 1900s by the wealthy Rhodes family, showcases the architectural style that once dominated Martha Lake.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://beckdc.com/historical-places-in-martha-lake/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Martha Lake Park, listed as a historical site, offers a green space that preserves the town’s natural and cultural heritage.",
      "sourceSentenceIds": [
        30
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://beckdc.com/historical-places-in-martha-lake/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Scandinavian immigrants first settled in Martha Lake, drawn by the lush forests and abundant natural resources of the Pacific Northwest.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://beckdc.com/historical-places-in-martha-lake/",
