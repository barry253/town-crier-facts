      ],
      "source": "https://en.wikipedia.org/wiki/Carbon%2C_Iowa",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Coal discovered in the Nodaway River valley during the 1860s sparked mining near Walters Mill, founded by Elijah Walters in 1849.",
      "sourceSentenceIds": [
