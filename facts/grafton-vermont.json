    {
      "id": 1,
      "text": "Grafton was originally founded as Thomlinson in 1754 before the renaming rights were auctioned off in 1791.",
      "sourceSentenceIds": [
        13
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Grafton%2C_Vermont"
    },
    {
      "id": 2,
      "text": "The town of Grafton was renamed after a bidder offered five dollars and a jug of rum for the rights.",
      "sourceSentenceIds": [
        25
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Grafton%2C_Vermont"
    },
    {
      "id": 3,
      "text": "The Grafton Inn is one of the oldest continually operating hotels in the United States, dating back to 1801.",
      "sourceSentenceIds": [
        3,
        6,
        17,
        18
      ],
      "sourceLabels": [
