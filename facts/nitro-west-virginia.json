  "facts": [
    {
      "id": 1,
      "text": "Nitro takes its name from a World War I nitrocellulose plant that produced smokeless gunpowder for the war effort.",
      "sourceSentenceIds": [
        15,
        18,
        19
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Nitro%2C_West_Virginia",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Within eleven months of the war, 110,000 workers built a powder plant and an entire town, complete with a hospital and civic center.",
      "sourceSentenceIds": [
        11
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.wvencyclopedia.org/entries/1623",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The town sprang up on 1,772 acres of muddy pastures and cornfields, transforming the landscape into a wartime engineering landmark.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://cityofnitro.org/about-nitro-west-virginia/history-of-nitro/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Nitro proudly calls itself a Living Memorial to World War I, honoring its origins as a federal explosives plant.",
      "sourceSentenceIds": [
        20
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Nitro%2C_West_Virginia",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Hollywood legend Clark Gable once worked at Nitro’s Explosive Plant C in 1918, linking the town to film history.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Nitro%2C_West_Virginia",
      "category": "people",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The city’s environmental legacy includes the Fike/Artel Chemical Site, a Superfund location on the National Priorities List.",
      "sourceSentenceIds": [
