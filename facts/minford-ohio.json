  "facts": [
    {
      "id": 1,
      "text": "Minford was renamed from Harrisonville in 1917 when the Chesapeake & Ohio Railroad arrived, avoiding confusion with another town of the same name.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Minford%2C_Ohio",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The Bennett family gave the town its name, honoring Benjamin Franklin Bennett, a former resident and third son of Joseph Bennett.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.minford.k12.oh.us/CommunityHistory.aspx",
      "category": "people",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Joseph Bennett proposed naming the settlement after his friend, General William Henry Harrison, reflecting his admiration for the former president.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.minfordfalcons.net/HarrisonvilleBecomesMinford.aspx",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Historic schoolhouses dot the area, including the old Sunshine School and the 1878 Harrisonville School, illustrating Minford’s early commitment to education.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Minford%2C_Ohio",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The Little Scioto River skirts Minford’s eastern edge, winding southward toward the Ohio River near Sciotoville.",
      "sourceSentenceIds": [
        15
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Minford%2C_Ohio",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Minford’s downtown centers around the junction of State Route 335 and State Route 139, a key crossroads in southern Ohio.",
      "sourceSentenceIds": [
        22
      ],
