  "facts": [
    {
      "id": 1,
      "text": "Robinson Pond, named after tenant Nicholas Robison, grew around a Livingston family gristmill built in 1778.",
      "sourceSentenceIds": [
        3,
        4
      ],
      "sourceLabels": [
        "Web source 1",
        "Web source 2"
      ],
      "source": "https://taconicshores.org/history",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Robinson Pond serves as a sediment detention basin in the Roeliff Jansen Kill watershed, with a 19:1 ratio that shapes downstream Hudson water quality.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/taconic_shores_new_york",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "After early 1900s private ownership changes, the Livingston Manor lands shifted from feudal tenant farming to recreational use, paving the way for Taconic Shores.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/taconic_shores_new_york",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "During a winter under Vernon’s ownership, Albert Bristol hauled ice from Robinson Pond to Borden’s plant across the Copake Railroad Depot.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://taconicshores.org/history",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Paper magnate Paul Vernon later ran a hydroelectric plant on the pond’s dam, selling power to nearby homes.",
      "sourceSentenceIds": [
        11
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://taconicshores.org/history",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Taconic Shores emerged mid‑20th century as a planned community centered on Robinson Pond, reflecting post‑WWII suburban growth.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Web source 2"
      ],
