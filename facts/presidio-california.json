  "facts": [
    {
      "id": 1,
      "text": "The Presidio of San Francisco began as a Spanish fort built in 1776 by José Joaquín Moraga.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Presidio_of_San_Francisco",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "In 1933 the Presidio was named a California Historical Landmark, and it earned National Historic Landmark status in 1962.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Presidio_of_San_Francisco",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Today the Presidio Trust manages 80 percent of the park, including nearly all of its historic buildings.",
      "sourceSentenceIds": [
        18
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Presidio_of_San_Francisco",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The Presidio preserves more than 30 archaeological sites that trace the land from Native Ohlone settlement to U.S. military use.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://presidio.gov/about/history",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "A walking trail built under the “Trails Forever” initiative features interpretive signage that explains the Presidio’s military history.",
      "sourceSentenceIds": [
        17
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Presidio_of_San_Francisco",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The Presidio is now a National Park Service site and a National Historic Landmark District, celebrated as a 20th‑century preservation success story.",
      "sourceSentenceIds": [
        30
