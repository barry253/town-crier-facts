  "facts": [
    {
      "id": 1,
      "text": "Kenilworth was founded in 1889 when Joseph Sears bought 223.6 acres between the Chicago and North Western Railroad and Lake Michigan for $150,300.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Kenilworth%2C_Illinois",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town was built on four principles: large lots, high construction standards, no alleys, and sales to Caucasians only, later amended to allow live-in servants of color.",
      "sourceSentenceIds": [
        3,
        24
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Kenilworth%2C_Illinois",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Kenilworth’s original plan called for single‑family homes, wide tree‑lined streets, and strict limits on commercial activity—ideas that still shape zoning today.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.villageofkenilworth.org/history.html",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The village’s location on Lake Michigan’s shoreline and its planned layout made it the only North Shore community developed as a fully planned suburb.",
      "sourceSentenceIds": [
        13,
        22
      ],
      "sourceLabels": [
        "Web source 1",
        "Wikipedia"
      ],
      "source": "https://www.vok.org/2227/Kenilworth-History",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Joseph Sears School, the village’s sole public school, carries the founder’s name and reflects Kenilworth’s emphasis on education from day one.",
      "sourceSentenceIds": [
        18
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Kenilworth%2C_Illinois",
      "category": "landmark",
      "quality": "good"
    }
  ]
