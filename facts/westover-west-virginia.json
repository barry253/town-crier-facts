  "facts": [
    {
      "id": 1,
      "text": "Westover was named for its location west of Morgantown and over the Monongahela River.",
      "sourceSentenceIds": [
        2,
        3
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Westover%2C_West_Virginia",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The city expanded by annexing Riverside in 1945 and Morgan Heights, Fairmor, Maple Grove in 1947, plus Westover Park in 1955.",
      "sourceSentenceIds": [
        16
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Westover%2C_West_Virginia",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "In 1909 a steel truss bridge opened, carrying trolleys across the Monongahela until the 1920s, linking Westover to Morgantown.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/westover_west_virginia",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Westover’s Mary’s Orthodox Church, built 1923, features onion‑shaped golden domes and was listed on the National Register in 1988.",
      "sourceSentenceIds": [
        6,
        7
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.wvencyclopedia.org/articles/1150",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The city hosted Monongalia High School, the county’s only African‑American high school, founded in 1938 and dedicated by Eleanor Roosevelt, operating until 1954.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/westover_west_virginia",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Early European settlers in 1772, like Isaac Lesmasters, purchased land that later became Westover, near a ferry established in 1807 across the Monongahela.",
