      "id": 1,
      "text": "Scotty Watson, a pioneer stockman, named Inverness after his hometown in Scotland, honoring the Scottish city of the same name.",
      "sourceSentenceIds": [
        1,
        2
      ],
      "sourceLabels": [
        "Wikipedia",
