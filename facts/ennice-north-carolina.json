  "facts": [
    {
      "id": 1,
      "text": "Ennice earned its name from Ennice Higgins, the daughter of an early postmaster, reflecting personal ties in 19th‑century North Carolina naming practices.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/ennice_north_carolina",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The community’s post office opened March 6, 1888, marking Ennice’s first formal connection to regional mail networks and signaling its emergence as a settled locale.",
      "sourceSentenceIds": [
        25
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/ennice_north_carolina",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Scotch‑Irish settlers arrived in the late 1700s, clearing rugged valleys for corn, livestock, and orchards, and laying the agricultural foundation of Ennice.",
      "sourceSentenceIds": [
        20,
        21
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/ennice_north_carolina",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Ennice sits in the Blue Ridge Mountains, part of the Appalachian Range, and falls within USDA zone 6b, where winter lows average between –5 and 0°F.",
      "sourceSentenceIds": [
        14,
        16
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Ennice%2C_North_Carolina",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "In the early 1900s, moonshining thrived in Ennice’s isolated hollows, a clandestine industry that supplemented farm incomes amid the county’s “Lost Province” isolation.",
      "sourceSentenceIds": [
        29
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/ennice_north_carolina",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Bottomley Evergreen Farms, founded in 1990 near Ennice, grew from a local Christmas tree operation into one of North Carolina’s largest holiday greenery producers.",
