      ],
      "source": "https://roadsidethoughts.com/az/hotevilla-bacavi-xx-navajo-profile.htm"
    },
    {
      "id": 3,
      "text": "Hotevilla-Bacavi lies within the Hopi Nation, specifically on Third Mesa.",
      "sourceSentenceIds": [
