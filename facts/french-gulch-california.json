  "facts": [
    {
      "id": 1,
      "text": "Founded by French miners in 1849, French Gulch became one of California's major gold producing areas.",
      "sourceSentenceIds": [
        3,
        7
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/French_Gulch%2C_California"
    },
    {
      "id": 2,
      "text": "The town was registered as a California Historical Landmark in 1935, preserving its mining heritage.",
      "sourceSentenceIds": [
        1,
        2
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/French_Gulch%2C_California"
    },
    {
      "id": 3,
      "text": "French Gulch served as the terminus of the western branch of the California Trail, turning it into a major supply hub.",
      "sourceSentenceIds": [
        16
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/French_Gulch%2C_California"
    },
    {
      "id": 4,
      "text": "The Washington vein system, discovered in 1852, was worked until about 1914, yielding roughly 100,000 ounces of gold.",
      "sourceSentenceIds": [
        17,
        18
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/French_Gulch%2C_California"
    },
    {
      "id": 5,
      "text": "The Niagara Mine, another key operation, produced about 50,000 ounces of gold before production paused.",
      "sourceSentenceIds": [
        19
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/French_Gulch%2C_California"
    },
    {
      "id": 6,
      "text": "In 2004, a forest fire forced the evacuation of the entire town, but residents returned after three days.",
      "sourceSentenceIds": [
        21,
        23
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
