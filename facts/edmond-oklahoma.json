      "id": 1,
      "text": "Edmond was christened on March 28, 1887 after Santa Fe railroad agent Edmond Schuyler Burdick.",
      "sourceSentenceIds": [
        5,
        6
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.okhistory.org/publications/enc/entry?entry=ED002",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town’s first station, originally named Summit for its high point between the Cimarron and North Canadian rivers, was later renamed Edmond.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://visitedmondok.com/things-to-do/art-culture-history/historic-sites/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Edmond’s 1889 Territorial Schoolhouse still stands, one of the city’s oldest surviving school buildings.",
      "sourceSentenceIds": [
        14
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://visitedmondok.com/things-to-do/art-culture-history/historic-sites/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The Edmond History Museum, housed in a WPA‑built armory at 5th and Boulevard, preserves local heritage.",
      "sourceSentenceIds": [
        13
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://visitedmondok.com/things-to-do/art-culture-history/historic-sites/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Edmondite Shannon Miller represented the United States in gymnastics at the 1992 and 1996 Olympics.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
