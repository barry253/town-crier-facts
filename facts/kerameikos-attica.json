  "facts": [
    {
      "id": 1,
      "text": "Kerameikos gets its name from the ancient potters’ quarter, and the English word \"ceramic\" traces back to the Greek word κέραμος.",
      "sourceSentenceIds": [
        15,
        16
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Kerameikos",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The cemetery at Kerameikos has been in use since the 3rd millennium BC, serving as a burial ground along the Sacred Way.",
      "sourceSentenceIds": [
        2,
        22
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Kerameikos",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "In 431 BC, Pericles delivered his famous funeral oration here, making Kerameikos a landmark of Athenian political history.",
      "sourceSentenceIds": [
        17
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Kerameikos",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "While constructing the Kerameikos metro station, archaeologists uncovered a plague pit and roughly 1,000 tombs from the 4th and 5th centuries BC.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Kerameikos",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The Archaeological Museum of Kerameikos, founded in 1937, showcases artifacts unearthed during German excavations of the site.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://athens-tourist-information.com/things-to-do/museums/kerameikos",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Located northwest of the Acropolis, Kerameikos sits between the Dipylon Gate and the banks of the Eridanos River.",
      "sourceSentenceIds": [
        14
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
