  "facts": [
    {
      "id": 1,
      "text": "Absarokee’s name comes from the Crow word Apsáalookěi, meaning “children of the large‑beaked bird.”.",
      "sourceSentenceIds": [
        14,
        15
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Absarokee%2C_Montana"
    },
    {
      "id": 2,
      "text": "The town was founded in 1893 after the Crow Indian Reservation opened to homesteaders.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://discoveringmontana.com/towns/absarokee/"
    },
    {
      "id": 3,
      "text": "Sever Simonson and his family claimed squatter rights at the Stillwater and East Rosebud Rivers in 1892, just before the town’s founding.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Absarokee%2C_Montana"
    },
    {
      "id": 4,
      "text": "The historic Big Yellow House, built in 1904 by rancher Jacob Wagner, sits on Woodard Ave and is on the National Register.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Absarokee%2C_Montana"
    },
    {
      "id": 5,
      "text": "Absarokee lies in the Rosebud River watershed, about three miles north of the confluence of the East and West Rosebud Rivers.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Absarokee%2C_Montana"
    },
    {
      "id": 6,
      "text": "Guided float trips down the Stillwater River start near Absarokee, leading to the Yellowstone River confluence 12 miles away.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 2"
      ],
