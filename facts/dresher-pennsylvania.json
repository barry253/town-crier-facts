  "facts": [
    {
      "id": 1,
      "text": "Dresher was named after George Dresher, a miller and landowner whose family helped shape the area.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.trawellino.com/destinations/united-states/pennsylvania_dresher",
      "category": "people",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The Pennsylvania Railroad built a line through Dreshertown in 1888, with a station at Susquehanna Road and Limekiln Pike.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Dresher%2C_Pennsylvania",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Dreshertown grew around a sawmill and gristmill built by John Kirk before 1750, later owned by George Dresher in 1780.",
      "sourceSentenceIds": [
        6,
        7
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Dresher%2C_Pennsylvania",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The Dreshertown Cemetery mainly contains descendants of Christopher Dresher, an early Schwenkfelder immigrant fleeing persecution in Silesia.",
      "sourceSentenceIds": [
        9,
        10,
        11
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Dresher%2C_Pennsylvania",
      "category": "people",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The headwaters of Sandy Run, a tributary of Wissahickon Creek, rise in Dresher, giving the area a modest watershed.",
      "sourceSentenceIds": [
        15
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Dresher%2C_Pennsylvania",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Dresher sits just north of Philadelphia and borders the Pennsylvania Turnpike (I-276), placing it within the greater metro area.",
      "sourceSentenceIds": [
