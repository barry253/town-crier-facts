  "facts": [
    {
      "id": 1,
      "text": "Kapp Heights sits just outside Northumberland along Pennsylvania Route 147, near where the West Branch Susquehanna meets the main river.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Kapp_Heights%2C_Pennsylvania",
      "category": "other",
      "quality": "poor",
      "qualityReason": "location_description"
    },
    {
      "id": 2,
      "text": "The area that is now Kapp Heights was part of Turbot Township when Pennsylvania first divided the region on April 9, 1772.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://pointtownship.org/history",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Kapp Heights observes Eastern Standard Time, shifting to Eastern Daylight Time in the summer.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://pennsylvania.hometownlocator.com/pa/northumberland/kapp-heights.cfm",
      "category": "other",
      "quality": "poor",
      "qualityReason": "vague"
    },
    {
      "id": 5,
      "text": "In February 1775, Mahoning Township was carved out of this area, and a decade later, Point Township emerged from Mahoning.",
      "sourceSentenceIds": [
        24
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://pointtownship.org/history",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The community’s name honors early settlers with the surname Kapp, who established homesteads along the riverbanks in the 19th century.",
