      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The village is home to Grant’s Farm, a historic working farm that once belonged to the Grant family plantation.",
      "sourceSentenceIds": [
        23
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Grantwood_Village%2C_Missouri",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Grant’s Farm was later purchased by August Anheuser Busch, Sr., linking the village to the Anheuser‑Busch brewing legacy.",
      "sourceSentenceIds": [
        24
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
