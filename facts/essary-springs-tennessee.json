  "facts": [
    {
      "id": 1,
      "text": "Settlers arrived 1819, including Ezekiel Polk, grandfather of President James Polk, and Colonel Thomas Hardeman, the county’s first clerk.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.hardemancountychamber.com/county-info/history/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Essary Springs sits on the Hatchie River, which flows south to north before joining the Mississippi west of Covington.",
      "sourceSentenceIds": [
        18,
        19
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Essary_Springs%2C_Tennessee",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Hardeman County opened to settlers in 1820, and Essary Springs grew around the river’s spring-fed water.",
      "sourceSentenceIds": [
        22
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.hardemancountychamber.com/county-info/history/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "In October 1862, Union and Confederate forces clashed near the Essary Springs bridge, a Civil War Battle of Davis Bridge.",
      "sourceSentenceIds": [
        14,
        15
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.asfoundationrepair.com/essary-springs-tennessee/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The area features well‑preserved Colonial style homes that echo its early 19th‑century architecture.",
      "sourceSentenceIds": [
        13
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.asfoundationrepair.com/essary-springs-tennessee/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Hatchie Town, Hardeman County’s first hamlet, was founded in 1823 along the river and later moved a mile south due to flooding.",
