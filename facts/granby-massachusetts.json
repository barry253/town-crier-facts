  "facts": [
    {
      "id": 1,
      "text": "Granby was officially incorporated on June 11, 1768, after residents petitioned the Massachusetts General Court for separation from South Hadley.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/Granby,_Massachusetts",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town’s name honors John Manners, Marquess of Granby, a celebrated hero of the Seven Years' War.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Granby%2C_Massachusetts",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Forge Pond and Aldrich Lake dams sparked early industry, spawning small iron‑forging and textile factories in the 19th century.",
      "sourceSentenceIds": [
        4,
        5
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.granby-ma.gov/about",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The Aldrich Mill, first a woolen factory that produced blankets for the Civil War, later became a gristmill in 1870.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/Granby,_Massachusetts",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Granby’s original 1768 meetinghouse now houses the Granby Historical Society, anchoring the town’s historic center.",
      "sourceSentenceIds": [
        18
