  "facts": [
    {
      "id": 1,
      "text": "Zelienople was founded in 1802 by Baron Dettmar Basse, who named it after his eldest daughter Zelie.",
      "sourceSentenceIds": [
        8,
        9,
        21
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.experiencebutler.com/directory/zelienople-historical-society/",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town’s historic Buhl House, built 1819, now serves as a museum showcasing early 19‑century life.",
      "sourceSentenceIds": [
        1,
        16
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 2"
      ],
      "source": "https://en.wikipedia.org/wiki/Zelienople%2C_Pennsylvania",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "In 1879 a railroad cut through Zelienople, sparking a boom that linked the borough to Pittsburgh’s growing market.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Zelienople%2C_Pennsylvania",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The Strand Theater, restored on Main Street, remains a performing‑arts hub that hosts concerts and films for the region.",
      "sourceSentenceIds": [
        18
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Zelienople%2C_Pennsylvania",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The Zelienople Historical Society, incorporated in 1975, preserves two of the town’s oldest homes: the 1808 Passavant House and the 1819 Buhl House.",
      "sourceSentenceIds": [
        3,
        16
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.experiencebutler.com/directory/zelienople-historical-society/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Zelienople’s annual Horse Trading Days, held July 16‑18, celebrate the town’s frontier heritage with rides, crafts, and historic reenactments.",
      "sourceSentenceIds": [
        14
      ],
      "sourceLabels": [
