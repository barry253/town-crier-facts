  "facts": [
    {
      "id": 1,
      "text": "Carmel Valley Village grew from Rancho Los Laureles, a 6,625‑acre Mexican land grant given in 1839.",
      "sourceSentenceIds": [
        2,
        12,
        13
      ],
      "sourceLabels": [
        "Web source 2",
        "Wikipedia"
      ],
      "source": "https://grokipedia.com/page/Carmel_Valley_Village,_California",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "After WWII the community expanded and was renamed Carmel Valley Village to reflect its broader residential focus beyond aviation.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/Carmel_Valley_Village,_California",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "In 1882 the Pacific Improvement Company bought Rancho Los Laureles to boost dairy production for its Del Monte operations.",
      "sourceSentenceIds": [
        8,
        14
      ],
      "sourceLabels": [
        "Web source 2",
        "Wikipedia"
      ],
      "source": "https://grokipedia.com/page/Carmel_Valley_Village,_California",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The Carmel River snakes northwest through Carmel Valley Village before reaching the Pacific at Carmel‑by‑the‑Sea.",
      "sourceSentenceIds": [
        18
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Carmel_Valley_Village%2C_California",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Garland Ranch Regional Park sits at 700 West Carmel Valley Road, offering hiking and equestrian trails.",
