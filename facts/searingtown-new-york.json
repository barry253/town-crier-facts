  "facts": [
    {
      "id": 1,
      "text": "Searingtown’s name comes from the Searing family, the area’s dominant landowners in the mid‑1700s.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/Searingtown_New_York"
    },
    {
      "id": 2,
      "text": "John Searing was among the first settlers in the area, helping lay the foundations of the hamlet.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Searingtown%2C_New_York"
    },
    {
      "id": 3,
      "text": "Coe Searing served as elder of the Methodist church in 1806, reflecting the family’s lasting influence.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/Searingtown_New_York"
    },
    {
      "id": 4,
      "text": "The nearest Long Island Rail Road stations are Manhasset, New Hyde Park, and Albertson.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Searingtown%2C_New_York"
    },
    {
      "id": 5,
      "text": "The Searingtown Methodist Church first opened on I.U. Willets Road in 1788, and parts of its original structure still stand today.",
      "sourceSentenceIds": [
        9,
        10,
        11
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Searingtown%2C_New_York"
    },
    {
      "id": 6,
      "text": "Today, Searingtown remains a quiet residential community while preserving its connection to the area’s historic roots.",
      "sourceSentenceIds": [
        5
      ],
