  "facts": [
    {
      "id": 1,
      "text": "Bluffton began as a small village centered around a creamery, sawmill, gristmill, and a Northern Pacific Railroad station, with its post office opening in 1878.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://lakesnwoods.com/Bluffton.htm"
    },
    {
      "id": 2,
      "text": "The town was platted in March 1880 and named for the prominent bluffs along the Leaf River that border its southern edge.",
      "sourceSentenceIds": [
        13,
        10
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Bluffton%2C_Minnesota"
    },
    {
      "id": 3,
      "text": "Bluffton was incorporated as a village on February 26, 1903, and later became an independent city on March 19, 1909.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://lakesnwoods.com/Bluffton.htm"
    },
    {
      "id": 4,
      "text": "Amtrak’s Empire Builder runs through Bluffton on BNSF tracks, but the train never stops in the town.",
      "sourceSentenceIds": [
        29
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Bluffton%2C_Minnesota"
    },
    {
      "id": 5,
      "text": "Bluffton Township was organized July 17, 1878, before the city was platted in 1880.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://lakesnwoods.com/Bluffton.htm"
    },
    {
      "id": 6,
      "text": "Bluffton sits along the Leaf River in Otter Tail County, Minnesota, a region known for its scenic waterways.",
