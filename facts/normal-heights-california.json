  "facts": [
    {
      "id": 1,
      "text": "Normal Heights earned its name from the State Normal School—today San Diego State University—whose campus sat just across the street in University Heights.",
      "sourceSentenceIds": [
        2,
        5
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Normal_Heights%2C_San_Diego",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "A 1905 reservoir in nearby University Heights sparked a building boom, swelling Normal Heights from a single house in January 1906 to 43 homes by December that year.",
      "sourceSentenceIds": [
        14
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Normal_Heights%2C_San_Diego",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The neighborhood became one of San Diego’s first streetcar suburbs when an electric trolley line ran along Adams Avenue, part of the San Diego Electric Railway system.",
      "sourceSentenceIds": [
        17
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Normal_Heights%2C_San_Diego",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "In 1911 residents formed the Normal Heights Improvement Association, which opened the county public library and pushed other community improvements.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Normal_Heights%2C_San_Diego",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The 1920s commercial strip on Adams Avenue between 37th and 38th Streets evolved into a potential historic district known today as the Carteri Center.",
      "sourceSentenceIds": [
        21
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Normal_Heights%2C_San_Diego",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "A bright neon sign over Adams Avenue at Felton Street still marks the neighborhood’s historic downtown heart.",
      "sourceSentenceIds": [
        6
