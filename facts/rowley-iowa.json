  "facts": [
    {
      "id": 1,
      "text": "Rowley was founded in 1873 when the Burlington, Cedar Rapids, and Northern Railroad expanded through the area, sparking the town's growth.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://communityhistoryarchives.com/places/the-rowley-historical-society/"
    },
    {
      "id": 2,
      "text": "The Rowley Historical Society, established in 2009, dedicates itself to preserving and sharing the town's rich heritage.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://communityhistoryarchives.com/places/the-rowley-historical-society/"
    },
    {
      "id": 3,
      "text": "In partnership with Advantage Archives, the society has digitized 13 pages of photographs from 1900, making them freely online.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://communityhistoryarchives.com/places/the-rowley-historical-society/"
    },
    {
      "id": 4,
      "text": "The society offers free access to its digital archives, opening a portal to Rowley's past for residents and researchers.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://communityhistoryarchives.com/places/the-rowley-historical-society/"
    },
    {
      "id": 5,
      "text": "Rowley's museum displays artifacts such as old school memorabilia, vintage clothing, and historic basketball uniforms, showcasing local history.",
      "sourceSentenceIds": [
        11
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://communityhistoryarchives.com/places/the-rowley-historical-society/"
    },
    {
      "id": 6,
      "text": "Visitors can explore the Rowley Historical Society's Community History Archive online at https://rowley.historyarchives.online/home.",
      "sourceSentenceIds": [
        5
      ],
