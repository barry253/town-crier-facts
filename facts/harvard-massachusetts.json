    },
    {
      "id": 2,
      "text": "In 1781 Mother Ann Lee founded a Shaker Village in Harvard, a community that still exists today.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.harvard-ma.gov/379/History-of-Harvard"
    },
    {
      "id": 3,
      "text": "Bronson Alcott established Fruitlands in 1843, a short‑lived transcendentalist utopian community that experimented with communal living.",
      "sourceSentenceIds": [
        7,
        8,
        10
      ],
      "sourceLabels": [
        "Web source 1",
