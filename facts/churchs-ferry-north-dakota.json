  "facts": [
    {
      "id": 1,
      "text": "Churchs Ferry was founded in 1883 and named after Irvine Church, the ferryman who operated a crossing on Devils Lake.",
      "sourceSentenceIds": [
        2,
        3
      ],
      "sourceLabels": [
        "Web source 2",
        "Web source 1"
      ],
      "source": "https://unitedstatesghosttowns.com/plan-your-ghost-town-road-trip-churchs-ferry-north-dakota/"
    },
    {
      "id": 2,
      "text": "Churchs Ferry grew alongside the railroad, becoming a vital stop for travelers heading to Devils Lake.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://unitedstatesghosttowns.com/churchs-ferry-north-dakota-ghost-town/"
    },
    {
      "id": 3,
      "text": "Rising waters of Devils Lake forced most residents to abandon Churchs Ferry by 2000, turning it into a ghost town.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://unitedstatesghosttowns.com/churchs-ferry-north-dakota-ghost-town/"
    },
    {
      "id": 4,
      "text": "Today only abandoned buildings and waterline marks remain, tracing Churchs Ferry’s former streets.",
      "sourceSentenceIds": [
        16,
        19
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://unitedstatesghosttowns.com/plan-your-ghost-town-road-trip-churchs-ferry-north-dakota/"
    },
    {
      "id": 5,
      "text": "The Minnie H steamboat once linked Churchs Ferry to other lakeside communities, cementing its role as a regional hub.",
      "sourceSentenceIds": [
        21
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://unitedstatesghosttowns.com/plan-your-ghost-town-road-trip-churchs-ferry-north-dakota/"
    },
    {
      "id": 6,
      "text": "Churchs Ferry disincorporated on September 30, 2022, handing governance over to Ramsey County.",
      "sourceSentenceIds": [
        5
      ],
