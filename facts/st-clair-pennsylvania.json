  "facts": [
    {
      "id": 1,
      "text": "St. Clair was named after the Nichols farm owner, with the first street laid out in 1831 by Carey, Lee & Hart.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.livingplaces.com/PA/Schuylkill_County/St_Clair_Borough.html"
    },
    {
      "id": 2,
      "text": "The town’s early economy hinged on mining safety, with Hayes and Daddow & Beadles factories producing squibs and caps.",
      "sourceSentenceIds": [
        2,
        3,
        15
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://stclairpa.gov/history-of-st-clair/"
    },
    {
      "id": 3,
      "text": "In 1829 the Mill Creek Railroad reached St. Clair, and a tavern called The Cross Keys opened beside the depot.",
      "sourceSentenceIds": [
        11,
        12
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.livingplaces.com/PA/Schuylkill_County/St_Clair_Borough.html"
    },
    {
      "id": 4,
      "text": "A 1888 blaze destroyed the Hayes squib factory, while the Daddow & Beadles plant closed two decades later.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://stclairpa.gov/history-of-st-clair/"
    },
    {
      "id": 5,
      "text": "St. Clair’s geography sits just 2 miles north of Pottsville in Pennsylvania’s southern coal region.",
      "sourceSentenceIds": [
        17
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/St._Clair%2C_Pennsylvania"
    },
    {
      "id": 6,
      "text": "The borough once housed a telegraph station inside its post office by 1880, reflecting early communication tech.",
      "sourceSentenceIds": [
