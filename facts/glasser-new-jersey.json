      "id": 1,
      "text": "Glasser takes its name from Bill Glasser, who bought the land in 1910 and later ran the local general store.",
      "sourceSentenceIds": [
        2,
        15
      ],
      "sourceLabels": [
        "Web source 1",
        "Wikipedia"
      ],
