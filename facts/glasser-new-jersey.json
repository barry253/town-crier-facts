      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "In 1933 the U.S. Postal Service officially appointed Glasser as postmaster, turning his store into the town’s first post office.",
      "sourceSentenceIds": [
        24
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
