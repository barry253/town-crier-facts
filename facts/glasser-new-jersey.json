      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The Glasser restaurant and bar sit on a bluff overlooking Lake Hopatcong, offering diners a panoramic lake view.",
      "sourceSentenceIds": [
        17
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Glasser%2C_New_Jersey",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Because of its unique status, GPS devices sometimes list the area as Glasser, Hopatcong, Lake Hopatcong, or even Andover.",
      "sourceSentenceIds": [
        18,
        19,
        20
      ],
      "sourceLabels": [
