      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Known originally as Peach Grove, the area became Tysons Crossroads after the Civil War.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Tysons%2C_Virginia",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "In 1963, Tysons shifted from a country crossroads to a commercial hub after contracts at the VA Route 7 and 123 interchange.",
      "sourceSentenceIds": [
        26
