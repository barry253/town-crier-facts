      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Tysons%2C_Virginia",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The Tysons Corner Center opened July 25, 1968, proclaimed the largest enclosed mall in the world at that time.",
      "sourceSentenceIds": [
        28
