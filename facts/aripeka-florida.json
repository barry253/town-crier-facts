  "facts": [
    {
      "id": 1,
      "text": "Aripeka takes its name from Seminole chief Abiaka, a war and medicine leader who shaped the Second Seminole War.",
      "sourceSentenceIds": [
        3,
        15
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Aripeka%2C_Florida",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town straddles the Pasco‑Hernando line, placing its post office, church and library in Pasco while the rest lies in Hernando.",
      "sourceSentenceIds": [
        29
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://wanderflorida.net/history-of-aripeka/",
      "category": "other",
      "quality": "poor",
      "qualityReason": "location_description"
    },
    {
      "id": 3,
      "text": "In 1921 the Aripeka post office crossed the county line from Hernando into Pasco, cementing the town’s dual‑county identity.",
      "sourceSentenceIds": [
        14
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Aripeka%2C_Florida",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "June 3, 1993 marked Aripeka’s designation as a Florida State Historic Site by the Pasco County Historic Preservation Committee.",
      "sourceSentenceIds": [
        16
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Aripeka%2C_Florida",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "County Road 595, the main artery through Aripeka, is known as Aripeka Road in Pasco and Osowaw Boulevard in Hernando.",
      "sourceSentenceIds": [
