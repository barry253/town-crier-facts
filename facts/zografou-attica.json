  "facts": [
    {
      "id": 1,
      "text": "The Marika Kotopouli Museum, opened in 1990, occupies the 1926 villa once home to famed actress Marika Kotopouli.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Zografou",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Zografou nurtures local sports with Asteras Zografou football club, founded in 1965, and the basketball team EFAO Zografou B.C.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Zografou",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The town takes its name from Ioannis Zografos, a parliamentarian who purchased the area in 1902, sparking its development.",
      "sourceSentenceIds": [
        5,
        26
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Zografou",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Hills of Hymettus crown Zografou, making its streets famously steep and winding for drivers.",
      "sourceSentenceIds": [
        21
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Zografou",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "A sprawling campus of the National and Kapodistrian University of Athens sits in Ano Ilisia, the suburb's easternmost quarter.",
      "sourceSentenceIds": [
        17
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Zografou",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Bus lines 140, 220, 221, 230, 235, 250, and 608 connect Zografou to central Athens and neighboring districts.",
