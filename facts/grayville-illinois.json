    {
      "id": 1,
      "text": "Grayville was founded around 1810 by James Gray, who later built the town’s first business house with his brother‑in‑law in 1830.",
      "sourceSentenceIds": [
        1,
        2
      ],
      "sourceLabels": [
        "Wikipedia",
