  "facts": [
    {
      "id": 1,
      "text": "De Aker’s name comes from the historic Akerpolder, where 'aker' means field, echoing its origins as reclaimed farmland.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/de_aker",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "After World War II, De Aker joined Amsterdam’s Western Garden Cities plan, expanding green, low‑density housing in the 1950s and 1960s.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/de_aker",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Bordered by the Ringvaart canal and a protective dyke, De Aker offers walking paths that overlook the surrounding Haarlemmermeer polder.",
      "sourceSentenceIds": [
        3,
        8,
        19
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/de_aker",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The neighborhood sits on flat polder land, roughly 2–3 meters below sea level, a legacy of historic drainage and windmill pumping.",
      "sourceSentenceIds": [
        17,
        18
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/de_aker",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "In the 1990s, former horticultural fields in De Aker were rapidly converted into residential blocks, including a 33‑apartment sculptural tower by Marlies Rohmer.",
      "sourceSentenceIds": [
        12,
        26,
        28
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/de_aker",
      "category": "other",
      "quality": "poor",
      "qualityReason": "vague"
    },
    {
      "id": 6,
      "text": "As of 2023, public spaces in De Aker enjoy about 16 % tree canopy coverage, a figure that reflects its garden‑city heritage.",
      "sourceSentenceIds": [
        7
      ],
