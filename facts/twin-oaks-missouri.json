  "facts": [
    {
      "id": 1,
      "text": "Twin Oaks got its name from two stately oak trees that once marked the corner of Crescent Road and Crescent Avenue.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.cityoftwinoaks.gov/HistoryofTwinOaks"
    },
    {
      "id": 2,
      "text": "The village officially incorporated in 1938, keeping local control and independence for its residents.",
      "sourceSentenceIds": [
        29
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.cityoftwinoaks.gov/HistoryofTwinOaks"
    },
    {
      "id": 3,
      "text": "Residential growth began in the late 1950s with the creation of “Old Town,” a cluster of about 30 homes.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.cityoftwinoaks.gov/HistoryofTwinOaks"
    },
    {
      "id": 4,
      "text": "In November 2016, Twin Oaks voters elected to change from a village to a city.",
      "sourceSentenceIds": [
        11
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Twin_Oaks%2C_Missouri"
    },
    {
      "id": 5,
      "text": "The city covers just 0.27 square miles, making it one of the smallest incorporated places in Missouri.",
