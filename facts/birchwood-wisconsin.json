  "facts": [
    {
      "id": 1,
      "text": "Birchwood was originally named Loomis after Wilbur Loomis, who was one of the first residents and the first storekeeper.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Birchwood%2C_Wisconsin"
    },
    {
      "id": 2,
      "text": "Birchwood exists today because of a local lumber camp and the crossing of the Soo and Omaha railroads.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Birchwood%2C_Wisconsin"
    },
    {
      "id": 3,
      "text": "The village of Birchwood was platted in 1901 and later grew from a logging camp into a small town.",
      "sourceSentenceIds": [
        20,
        21
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Birchwood%2C_Wisconsin"
    },
    {
      "id": 4,
      "text": "In 1912, the town officially became Birchwood due to a political argument and the abundance of birch trees in the area.",
      "sourceSentenceIds": [
        22
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Birchwood%2C_Wisconsin"
    },
    {
      "id": 5,
      "text": "The first Birchwood dam was built from logs in 1881 and was later enlarged in 1893.",
      "sourceSentenceIds": [
        24,
        25,
        26
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Birchwood%2C_Wisconsin"
    },
    {
      "id": 6,
      "text": "Electricity service first arrived in Birchwood in 1916 through the Wisconsin-Minnesota Light and Power Company.",
      "sourceSentenceIds": [
        29,
