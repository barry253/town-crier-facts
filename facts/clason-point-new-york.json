  "facts": [
    {
      "id": 1,
      "text": "Clason Point was named after Isaac Clason, a Scottish merchant who owned much of the peninsula in the late 1700s.",
      "sourceSentenceIds": [
        2,
        10
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Clason_Point%2C_Bronx",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "In the early 1900s, a railroad builder bought 25 acres and turned the waterfront into a summer resort, mirroring Coney Island.",
      "sourceSentenceIds": [
        1,
        12
      ],
      "sourceLabels": [
        "Web source 2",
        "Web source 1"
      ],
      "source": "https://ephemeralnewyork.wordpress.com/tag/clason-point-bronx-history/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The area once hosted an amusement park that operated in the first half of the 20th century, complete with rides and a ferris wheel.",
      "sourceSentenceIds": [
        9,
        19
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 2"
      ],
      "source": "https://en.wikipedia.org/wiki/Clason_Point%2C_Bronx",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "A 1949 sale turned the amusement grounds into a private country club, and today the space is Clason Point Park.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://ephemeralnewyork.wordpress.com/tag/clason-point-bronx-history/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Clason Point sits on a green‑and‑gray peninsula where the Bronx River meets the East River, bounded by Westchester Creek.",
      "sourceSentenceIds": [
        7,
        8
      ],
