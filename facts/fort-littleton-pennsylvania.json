  "facts": [
    {
      "id": 1,
      "text": "Fort Littleton takes its name from the 18th‑century Fort Lyttleton, a British outpost built to defend settlers during the French and Indian War.",
      "sourceSentenceIds": [
        5,
        6,
        28
      ],
      "sourceLabels": [
        "Web source 2",
        "Wikipedia"
      ],
      "source": "https://grokipedia.com/page/fort_littleton_pennsylvania"
    },
    {
      "id": 2,
      "text": "The 4.9‑acre site, owned by The Archaeological Conservancy, yielded a 1750s swivel gun barrel and musket parts, confirming its military role.",
      "sourceSentenceIds": [
        26,
        29
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/fort_littleton_pennsylvania"
    },
    {
      "id": 3,
      "text": "A Pennsylvania Historical and Museum Commission marker, erected in 1924, marks the fort’s location on a knoll in Dublin Township.",
      "sourceSentenceIds": [
        29
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/fort_littleton_pennsylvania"
    },
    {
      "id": 4,
      "text": "Pennsylvania built a chain of forts along Kittatinny Mountain after Native American raids, with Fort Lyttleton serving as a key node.",
      "sourceSentenceIds": [
        27
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/fort_littleton_pennsylvania"
    },
    {
      "id": 5,
      "text": "No Native American artifacts have been found at the site, underscoring its identity as a British outpost rather than a pre‑colonial settlement.",
      "sourceSentenceIds": [
        8
