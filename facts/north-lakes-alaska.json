  "facts": [
    {
      "id": 1,
      "text": "North Lakes sits northeast of Wasilla and west of Palmer, its name coming from the chain of lakes that define the community.",
      "sourceSentenceIds": [
        15
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/North_Lakes%2C_Alaska",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The area that is now North Lakes was part of the traditional territory of the Dena'ina Athabascan people, who have lived there for millennia.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/north_lakes_alaska",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The first permanent residents arrived in the 1920s, turning the fertile valley into a small-scale farming and logging community.",
      "sourceSentenceIds": [
        11
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/north_lakes_alaska",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "North Lakes experiences a subarctic climate, with long, cold winters from October to April and short, cool summers that shape local wildlife.",
      "sourceSentenceIds": [
        13,
        4
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/north_lakes_alaska",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "North Lakes was established as a small fishing and trading post in the early 20th century, a legacy still visible in its historic sites.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://touristplaces.guide/top-10-must-visit-tourist-places-in-north-lakes/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The Chugach Mountains rise to the south and east, shaping drainage patterns through their glacial history and providing a dramatic backdrop.",
      "sourceSentenceIds": [
