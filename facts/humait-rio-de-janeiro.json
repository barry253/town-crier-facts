      ],
      "source": "https://www.riofilmcommission.com/en/locations/ruinas-do-sitio-humaita-humaita-site-ruins/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Rua São Clemente, originally opened in 1657 as the Caminho Novo, now cuts through Humaitá and Botafogo.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
