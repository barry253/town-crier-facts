      "source": "https://www.riofilmcommission.com/en/locations/ruinas-do-sitio-humaita-humaita-site-ruins/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "That same son was killed fighting in the Battle of Humaitá during the Paraguayan War.",
      "sourceSentenceIds": [
        11
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.riofilmcommission.com/en/locations/ruinas-do-sitio-humaita-humaita-site-ruins/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Today the Ruínas do Sítio Humaitá sit inside Tijuca National Park’s Forest section, a vast green heart of Rio.",
      "sourceSentenceIds": [
        7,
        8,
        16
      ],
      "sourceLabels": [
