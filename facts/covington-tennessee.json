      ],
      "source": "https://en.wikipedia.org/wiki/Covington%2C_Tennessee",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Tipton County Museum in Covington displays artifacts from ancient earthworks to Civil War relics, including antique farm equipment and cotton gins.",
      "sourceSentenceIds": [
