        4
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.covingtontn.gov/history",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The city was officially incorporated in 1826 after the state legislature authorized its charter that same year.",
      "sourceSentenceIds": [
        23
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.covingtontn.gov/history",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The Memphis and Paducah Railroad completed tracks to Covington in July 1873, linking the town to regional commerce.",
      "sourceSentenceIds": [
        11
      ],
      "sourceLabels": [
