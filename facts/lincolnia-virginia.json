  "facts": [
    {
      "id": 1,
      "text": "Lincolnia was founded after the Civil War as a community of freed slaves, remaining one of Fairfax County's original African‑American communities for over a century.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Lincolnia%2C_Virginia",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town’s name honors Abraham Lincoln, the 16th U.S. president, with “Lincolnia” meaning “land of Lincoln.”.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.wisdomlib.org/cities/lincolnia-24391",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "A historic building still stands in Lincolnia, now serving as the Lincolnia Senior Center.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Lincolnia%2C_Virginia",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "During segregation, Lincolnia operated its own schoolhouse, a rare example of an independent black school in the county.",
      "sourceSentenceIds": [
        30
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Lincolnia%2C_Virginia",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Lincolnia’s borders follow Columbia Pike and Holmes Run to the north and Interstate 395 to the south, defining its modern limits.",
      "sourceSentenceIds": [
        15
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Lincolnia%2C_Virginia",
      "category": "other",
      "quality": "poor",
      "qualityReason": "location_description"
    },
    {
      "id": 6,
      "text": "Lincolnia is the most diverse area in Fairfax County, with a mix of White, African‑American, Asian, and other residents.",
      "sourceSentenceIds": [
        24
