  "facts": [
    {
      "id": 1,
      "text": "Sabin was officially platted in 1881, and its post office has operated continuously since that same year.",
      "sourceSentenceIds": [
        20,
        24
      ],
      "sourceLabels": [
        "Web source 1",
        "Wikipedia"
      ],
      "source": "https://grokipedia.com/page/sabin_minnesota",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town was renamed Sabin to honor state senator Dwight May Sabin, a prominent Minnesota politician of the late 19th century.",
      "sourceSentenceIds": [
        3,
        17,
        20
      ],
      "sourceLabels": [
        "Web source 1",
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/sabin_minnesota",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The Paul, Minneapolis and Manitoba Railroad, later part of the Great Northern Railway, ran through Sabin in 1880, turning it into a key potato shipping point by 1917.",
      "sourceSentenceIds": [
        10,
        11
      ],
      "sourceLabels": [
        "Web source 1",
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/sabin_minnesota",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Sabin’s rural setting is dominated by potato and grain farming, a legacy that dates back to its 19th‑century homesteading roots.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/sabin_minnesota",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Every year, Sabin hosts Harvest Days, a family‑friendly festival featuring pancake feeds, street fairs, and an inflatable game zone.",
      "sourceSentenceIds": [
