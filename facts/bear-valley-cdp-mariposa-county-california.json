  "facts": [
    {
      "id": 1,
      "text": "Bear Valley earned California Historical Landmark status as #331, honoring its rich mining heritage.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Bear_Valley%2C_Mariposa_County%2C_California"
    },
    {
      "id": 2,
      "text": "John C. Frémont, a Gold Rush pioneer, called Bear Valley home and built the Little White House, which burned in 1866.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Bear_Valley%2C_Mariposa_County%2C_California"
    },
    {
      "id": 3,
      "text": "Originally named Haydenville after three gold‑mining Haydens, the settlement adopted the name Bear Valley in 1858.",
      "sourceSentenceIds": [
        7,
        8,
        11
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Bear_Valley%2C_Mariposa_County%2C_California"
    },
    {
      "id": 4,
      "text": "After a 1888 blaze razed most of the town, survivors rebuilt with structures like the Bon Ton Saloon, Trabucco Store, and Odd Fellows Hall.",
      "sourceSentenceIds": [
        22
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Bear_Valley%2C_Mariposa_County%2C_California"
    },
    {
      "id": 5,
      "text": "Perched 2,054 feet above sea level, Bear Valley lies 10.5 miles southeast of Coulterville in Mariposa County.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Bear_Valley%2C_Mariposa_County%2C_California"
    },
    {
      "id": 6,
      "text": "The Bear Valley post office opened in 1858, closed in 1912, reopened 1914–1919, and operated again from 1933 to 1955.",
      "sourceSentenceIds": [
        13
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Bear_Valley%2C_Mariposa_County%2C_California"
    }
