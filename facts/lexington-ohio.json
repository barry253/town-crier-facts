  "facts": [
    {
      "id": 1,
      "text": "Lexington was named in honor of Lexington, Massachusetts, the site of the first battle of the American Revolutionary War; it was officially incorporated in 1839.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Lexington%2C_Ohio",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Lexington was laid out in 1812 on the northwest quarter of section 24 in Troy Township, Richland County, along the Clear Fork of the Mohican River.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/Lexington,_Ohio",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "In 1850 the railroad made its path through Lexington and this contributed to much of the business activity and travel for the settlers.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Lexington%2C_Ohio",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Lexington thrives on the Mid-Ohio Sports Car Course, which hosts IndyCar Grand Prix and USF Pro Championships every year.",
      "sourceSentenceIds": [
        14
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/Lexington,_Ohio",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Lexington has a public library, a branch of the Mansfield–Richland County Public Library.",
