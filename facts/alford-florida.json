  "facts": [
    {
      "id": 1,
      "text": "Alford’s early growth was shaped by its proximity to Marianna and the Pensacola and Atlantic Railroad that reached Jackson County in 1882.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/alford_florida",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town began as a small farming community in the early 1900s, part of a broader wave of settlement driven by fertile soils.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/alford_florida",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Alford sits on the Florida Panhandle’s coastal plain, where the terrain is flat and supports both agriculture and forested land.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/alford_florida",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The town’s topography features minimal dramatic relief, reflecting the subdued geological history of the coastal plain.",
