      "id": 1,
      "text": "Lewisham’s clock tower, completed in 1900, was built to commemorate Queen Victoria’s Diamond Jubilee.",
      "sourceSentenceIds": [
        11
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
