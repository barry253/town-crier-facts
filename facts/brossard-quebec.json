  "facts": [
    {
      "id": 1,
      "text": "Brossard was founded Feb 14 1958, originally part of La Prairie‑de‑la‑Madeleine Parish.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Brossard",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The city’s name honors the Brossard family, first noted in 1766, whose name means “brushwood”.",
      "sourceSentenceIds": [
        13
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Brossard",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Brossard’s city hall opened July 14 1962, accompanied by Armand Vaillancourt’s sculpture “Brossard Ville”, a tribute to the working class.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://brossard.ca/en/topics/history-of-brossard/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The Complexe aquatique, opened 2021, is Quebec’s first indoor Olympic pool designed for universal accessibility.",
      "sourceSentenceIds": [
        22
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://brossard.ca/en/topics/history-of-brossard/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Brossard is served by three Réseau express métropolitain stations—Panama, Du Quartier, and Brossard—since July 31 2023.",
      "sourceSentenceIds": [
        20
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Brossard",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Brossard evolved from a farming village founded in the early 19th century to a modern suburb, driven by Montreal’s demographic boom.",
      "sourceSentenceIds": [
        12
      ],
