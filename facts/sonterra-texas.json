  "facts": [
    {
      "id": 1,
      "text": "Sonterra’s name blends Spanish 'son' and Latin 'terra', meaning 'land of the sun' or 'son of the earth', hinting at its sunny, fertile landscape.",
      "sourceSentenceIds": [
        23,
        24
      ],
