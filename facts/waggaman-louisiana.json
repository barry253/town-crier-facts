  "facts": [
    {
      "id": 1,
      "text": "Waggaman takes its name from Senator George Augustus Waggaman, who moved from Maryland in 1810, married Camille Arnoult, and secured riverfront land from Spanish colonial grants.",
      "sourceSentenceIds": [
        23,
        24,
        7
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 2"
      ],
      "source": "https://en.wikipedia.org/wiki/Waggaman%2C_Louisiana",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Avondale Plantation, founded by Waggaman in 1839, was later eroded by the Mississippi River in the early 1900s.",
      "sourceSentenceIds": [
        3,
        21
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 2"
      ],
      "source": "https://en.wikipedia.org/wiki/Waggaman%2C_Louisiana",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The Westbank Historical Museum, opened in the late 20th century, showcases Waggaman’s artifacts and offers educational programs for all ages.",
      "sourceSentenceIds": [
        1,
        5,
        10,
        11
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://touristplaces.guide/top-10-must-visit-tourist-places-in-waggaman/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Livaudais Park, a historic green space in Waggaman, reflects the town’s suburban growth and provides a tranquil retreat for families.",
      "sourceSentenceIds": [
