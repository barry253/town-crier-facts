  "facts": [
    {
      "id": 1,
      "text": "Onaquaga was originally home to the Oneida tribe, one of the Five Nations of the Iroquois Confederacy.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Onaquaga",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "When the American Revolution reached the area, the Oneida abandoned Onaquaga and the town was later burned by American forces.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Onaquaga",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The Old Onaquaga Historical Society hosts a famous chili and homemade dessert night every summer, drawing locals and visitors alike.",
      "sourceSentenceIds": [
        8,
        9
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.onaquagahistoricalsociety.org/",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "On June 14, the society unveiled a historic marker honoring the original Oneida settlement of Onaquaga.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.onaquagahistoricalsociety.org/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The Shako:wi Cultural Center in nearby Oneida houses ancient artifacts, including sacred wampum belts and handmade lacrosse sticks.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.onaquagahistoricalsociety.org/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Revolutionary War veteran Ezra Pratt was honored with a historic marker at Pratt Cemetery in the Town of Colesville.",
      "sourceSentenceIds": [
        13
      ],
      "sourceLabels": [
        "Web source 2"
      ],
