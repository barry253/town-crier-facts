  "facts": [
    {
      "id": 1,
      "text": "Founded in 1846, Gilmer takes its name from former Secretary of the Navy Thomas Walker Gilmer.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Gilmer%2C_Texas",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The original settlement, Old Gilmer, was abandoned, and a historic marker now marks its site three miles north on the Cherokee Trace.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.tshaonline.org/handbook/entries/gilmer-tx",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Gilmer sits on the Old Cherokee Trace, a trail once used by Cherokee Indians, and arrowheads still surface with little digging.",
      "sourceSentenceIds": [
        25,
        26
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Gilmer%2C_Texas",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "In 1929 the state took over a black Baptist preacher’s home, renaming it Gilmer State Orphanage for Negroes until 1943.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.tshaonline.org/handbook/entries/gilmer-tx",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The 1980s saw Gilmer’s public library grow after a federal grant, eventually housing 37,794 volumes.",
      "sourceSentenceIds": [
        21,
        22
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.tshaonline.org/handbook/entries/gilmer-tx",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Every year Gilmer hosts the East Texas Yamboree, a festival celebrating the region’s yam harvest.",
