  "facts": [
    {
      "id": 1,
      "text": "Neutral Bay earned its name when Governor Arthur Phillip declared the harbour a neutral zone for foreign ships in 1789.",
      "sourceSentenceIds": [
        3,
        23,
        20,
        21
      ],
      "sourceLabels": [
        "Web source 2",
        "Wikipedia"
      ],
      "source": "https://dictionaryofsydney.org/entry/neutral_bay"
    },
    {
      "id": 2,
      "text": "A tiny creek that once ran into the bay was the first freshwater source for those neutral ships.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://dictionaryofsydney.org/entry/neutral_bay"
    },
    {
      "id": 3,
      "text": "By 1888, nearly 190 homes lined Ben Boyd Road and Wycombe Road, shaping Neutral Bay’s early residential character.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://dictionaryofsydney.org/entry/neutral_bay"
    },
    {
      "id": 4,
      "text": "Children’s author May Gibbs once called Derry, a Federation home on Phillips Street, her residence.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Neutral_Bay"
    },
    {
      "id": 5,
      "text": "Neutral Bay became an Arts and Crafts enclave in the early 1900s, attracting those who prized handcrafted design.",
      "sourceSentenceIds": [
        25
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Neutral_Bay"
    },
    {
      "id": 6,
      "text": "The Oaks Hotel, opened in 1880 beside local brickworks, remains a historic landmark of Neutral Bay.",
