  "facts": [
    {
      "id": 1,
      "text": "West Mineral was named for the coal mines found there in the late 19th century.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/West_Mineral%2C_Kansas",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Founded as a booming coal camp, West Mineral became the industrial heartbeat of Southeast Kansas.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://cityofwestmineral.org/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The town’s iconic Big Brutus, the world’s second‑largest electric shovel, now stands as a National Historic Mechanical Engineering Landmark.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://cityofwestmineral.org/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "When the coal engines shut in 1974, residents rallied to preserve Big Brutus instead of dismantling it.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://cityofwestmineral.org/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The community’s effort turned Big Brutus into a museum, keeping the mining heritage alive for visitors.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://cityofwestmineral.org/",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "West Mineral’s history is also captured in its modest white‑clapboard church, a pillar of faith and resilience.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://cityofwestmineral.org/",
      "category": "landmark",
      "quality": "good"
    }
