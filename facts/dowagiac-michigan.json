  "facts": [
    {
      "id": 1,
      "text": "Dowagiac’s name comes from the Potawatomi word meaning “fishing water,” reflecting the area’s early Native American roots.",
      "sourceSentenceIds": [
        20
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Dowagiac%2C_Michigan",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "In 1854, the town was the final stop for the first group of orphans on America’s Orphan Train, a historic migration of children.",
      "sourceSentenceIds": [
        24
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Dowagiac%2C_Michigan",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The historic train depot once served as a Michigan Central station before becoming a Penn Central hub, a key link in regional rail history.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Dowagiac%2C_Michigan",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Dowagiac hosts the headquarters of the Pokagon Band of Potawatomi Indians, making it a focal point of Native American heritage in Michigan.",
      "sourceSentenceIds": [
        8,
        13
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Dowagiac%2C_Michigan",
      "category": "people",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Philo Beckwith’s Round Oak Furnace Company funded the 19th‑century Beckwith Theatre, a local cultural landmark that still stands today.",
