  "facts": [
    {
      "id": 1,
      "text": "West End was first settled in the late 1700s as part of the Town of Union before becoming its own neighborhood tied to the Erie Railroad.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.trawellino.com/destinations/united-states/new-york_west-end",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The neighborhood still shows its industrial past with brick row houses and former factories now turned into homes and shops.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.trawellino.com/destinations/united-states/new-york_west-end",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The West End‑Collegiate Historic District Extension, added in the 20th century, now covers more than twice the original historic district’s size.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://westendpreservation.org/west-end-collegiate-historic-district-ext-2/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Notable buildings include the Apthorp Apartments (built 1906‑08) and the Kleeberg Residence (1896‑98), both designed by prominent architects.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://westendpreservation.org/west-end-collegiate-historic-district-ext-2/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "West End borders Riverside Park, giving residents scenic views of the Hudson River.",
      "sourceSentenceIds": [
        19
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.trawellino.com/destinations/united-states/new-york_west-end",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The area’s tree‑lined streets and proximity to Central Park make it a popular spot for families and professionals alike.",
      "sourceSentenceIds": [
        20
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.trawellino.com/destinations/united-states/new-york_west-end",
