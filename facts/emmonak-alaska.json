  "facts": [
    {
      "id": 1,
      "text": "Emmonak, whose Yup'ik name means 'black fish,' was christened after the local fish that sustains the community.",
      "sourceSentenceIds": [
        2,
        1
      ],
      "sourceLabels": [
        "Web source 1",
        "Web source 2"
      ],
      "source": "https://www.kupi.com/en/explore/united-states/emmonak/history",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "In 1964, residents relocated from the flood‑damaged village of Kwiguk to the new site of Emmonak, abandoning its old cannery.",
      "sourceSentenceIds": [
        10,
        23
      ],
      "sourceLabels": [
        "Web source 1",
        "Wikipedia"
      ],
      "source": "https://www.kupi.com/en/explore/united-states/emmonak/history",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Kwik’pak Fisheries, founded in 2002, provides processing facilities that create jobs and stabilize Emmonak’s fishing economy.",
      "sourceSentenceIds": [
        3,
        5
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.kupi.com/en/explore/united-states/emmonak/history",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The community’s culture values respect for elders, cooperation, sharing, love for children, humility, hard work, skill development, humor, and harmony with nature.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://cityofemmonak.org/community-1",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "While the Yukon Delta has been home to Yup'ik hunters and fishermen for millennia, Emmonak’s modern history began only in the mid‑20th century.",
      "sourceSentenceIds": [
        9,
        11
      ],
