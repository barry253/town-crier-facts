  "facts": [
    {
      "id": 1,
      "text": "La Push sits at the mouth of the Quillayute River, a small unincorporated community on the Olympic Peninsula.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/La_Push%2C_Washington"
    },
    {
      "id": 2,
      "text": "The name La Push comes from French \"La Bouche\" meaning \"the mouth\", adapted into Chinook Jargon.",
      "sourceSentenceIds": [
        15
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/La_Push%2C_Washington"
    },
    {
      "id": 3,
      "text": "The Quileute Tribe, home to La Push, historically built cedar canoes ranging from two‑man to ocean‑going freight vessels.",
      "sourceSentenceIds": [
        17
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/La_Push%2C_Washington"
    },
    {
      "id": 4,
      "text": "In 2017, residents began moving the village to higher ground to protect against sea‑level rise and tsunamis.",
      "sourceSentenceIds": [
        26,
        27
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/La_Push%2C_Washington"
    },
    {
      "id": 5,
      "text": "La Push Beach and Rialto Beach flank the river mouth, offering dramatic coastal scenery.",
      "sourceSentenceIds": [
        29
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/La_Push%2C_Washington"
    },
    {
