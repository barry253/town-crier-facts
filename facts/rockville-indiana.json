  "facts": [
    {
      "id": 1,
      "text": "Rockville was laid out in 1824, three years after Parke County was founded, and quickly became the county seat.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Rockville%2C_Indiana",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "When early settlers debated a name, one suggested honoring the granite boulders that marked the town’s public square, and the name Rockville stuck.",
      "sourceSentenceIds": [
        6,
        7
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.roxalumni.com/member_survey_form.cfm?SurveyID=10932",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The town proudly calls itself “The Covered Bridge Capital of the World,” a title earned by its many historic covered bridges.",
      "sourceSentenceIds": [
        22
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Rockville%2C_Indiana",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Rockville’s historic district and the Chautauqua Pavilion are listed on the National Register of Historic Places, preserving 19th‑century architecture.",
      "sourceSentenceIds": [
        23
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Rockville%2C_Indiana",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The Rockville Public Library, a long‑standing community hub, serves residents with books, events, and research resources.",
      "sourceSentenceIds": [
        18
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Rockville%2C_Indiana",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "On June 17, 2021, a 3.8‑meter‑scale earthquake rattled Rockville, with aftershocks felt across Indiana and Illinois.",
