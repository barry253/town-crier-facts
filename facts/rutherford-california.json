  "facts": [
    {
      "id": 1,
      "text": "Rutherford was founded on the nearly 12,000‑acre Mexican land grant Rancho Caymus, given to early settler George C. Yount.",
      "sourceSentenceIds": [
        1,
        3,
        13
      ],
      "sourceLabels": [
        "Web source 2",
        "Web source 1",
        "Wikipedia"
      ],
      "source": "https://www.visitnapavalley.com/things-to-do/towns-regions/rutherford/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "In 1864, Yount gifted a 1,040‑acre parcel to his granddaughter Elizabeth and her husband Thomas Rutherford, a wedding present that seeded the town’s wine legacy.",
      "sourceSentenceIds": [
        4,
        6
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Rutherford%2C_California",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The town’s name honors Thomas Rutherford, whose family planted vineyards in the late 1800s, laying the groundwork for Rutherford AVA.",
      "sourceSentenceIds": [
        15
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Rutherford%2C_California",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Rutherford hosts the historic Inglenook estate, bought by filmmaker Francis Ford Coppola in 1975, which now houses a museum on wine and cinema history.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.visitnapavalley.com/things-to-do/towns-regions/rutherford/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The Auberge du Soleil resort and restaurant sit within Rutherford, offering guests a taste of the region’s renowned terroir.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Rutherford%2C_California",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Rutherford’s soil, once a riverbed, gives its wines a depth of flavor with fruit notes and subtle herbaceous undertones that linger after the last sip.",
      "sourceSentenceIds": [
        28,
