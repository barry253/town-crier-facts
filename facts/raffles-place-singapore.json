        23
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://singaporetripguide.com/destinations/historical-landmarks-and-sightseeing-around-raffles-place",
      "category": "culture",
      "quality": "good"
    },
    {
