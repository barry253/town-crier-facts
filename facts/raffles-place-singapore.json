      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The statue of Sir Stamford Raffles in Raffles Place symbolizes both Singapore's founding and its colonial history.",
      "sourceSentenceIds": [
        5,
        20
      ],
      "sourceLabels": [
        "Web source 1"
      ],
