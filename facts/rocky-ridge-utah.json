  "facts": [
    {
      "id": 1,
      "text": "Rocky Ridge is located on the northern edge of the Juab Valley in the eastern foothills of the Wasatch Range.",
      "sourceSentenceIds": [
        11
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Rocky_Ridge%2C_Utah"
    },
    {
      "id": 2,
      "text": "The town of Rocky Ridge was named for the colorful rocks strewn across the ridges separating Juab and Utah counties.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Rocky_Ridge%2C_Utah"
    },
    {
      "id": 3,
      "text": "Spanish explorers Father Dominguez and Father Escalante crossed this pass in 1776, naming it the Gate of Saint Pedro.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://rockyridgetown.com/?page_id=550"
    },
    {
      "id": 4,
      "text": "The original community in the area was known as York and served as the southern terminus of the Utah Southern Railroad.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Rocky_Ridge%2C_Utah"
    },
    {
      "id": 5,
      "text": "The community grew significantly after 1971 when it was known locally as Allred Ranch before incorporating as Rocky Ridge.",
      "sourceSentenceIds": [
        14,
        15,
        16,
        17
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Rocky_Ridge%2C_Utah"
    },
    {
      "id": 6,
      "text": "The majority of the residents of Rocky Ridge are members of the Apostolic United Brethren.",
      "sourceSentenceIds": [
        29
