  "facts": [
    {
      "id": 1,
      "text": "White Cloud earned its name from Ioway chief White Cloud, also known as Mahaska, who led the tribe until his death in 1834.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/white_cloud_historic_district",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "In 1857, over 2,000 land bidders arrived by steamboat, turning White Cloud into a bustling river port.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://unitedstatesghosttowns.com/white-cloud-kansas-ghost-town/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Early growth hinged on ferries, lumber mills, freighting, grain trade, and pork packing, with four sawmills producing more lumber than other river towns by 1868 in White Cloud.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/white_cloud_historic_district",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The Atchison & Nebraska Railroad arrived in 1871, boosting connectivity before its abandonment in 1933 stalled the growth in White Cloud.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/white_cloud_historic_district",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The 1880s Poulet Mansion, perched on a hill overlooking former riverboat landings in White Cloud, is listed on the National Register of Historic Places.",
      "sourceSentenceIds": [
        11
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://unitedstatesghosttowns.com/white-cloud-kansas-ghost-town/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The Ma-Hush-Kah Historical Society and Museum, housed in an 1872 schoolhouse in White Cloud, showcases both native and settler histories.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://unitedstatesghosttowns.com/white-cloud-kansas-ghost-town/",
      "category": "culture",
      "quality": "good"
    }
