  "facts": [
    {
      "id": 1,
      "text": "Calumet City was founded in 1893 when Schrumville and Sobieski Park merged as West Hammond, and it was incorporated on February 13, 1893.",
      "sourceSentenceIds": [
        3,
        13
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Calumet_City%2C_Illinois"
    },
    {
      "id": 2,
      "text": "The city’s iconic smiley‑face water towers sit on Ring Road near River Oaks Mall and on State Street near I‑94.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Calumet_City%2C_Illinois"
    },
    {
      "id": 3,
      "text": "In the early 1880s, German Lutherans settled in what was then West Hammond and Sobieski Park, shaping the community’s early culture.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.calumetcityhistoricalsociety.org/calumet-city-history.html"
    },
    {
      "id": 4,
      "text": "Workers in Calumet City historically found jobs at nearby Standard Oil, Pullman Standard Car Co., and the steel mills of East Chicago and Gary.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.calumetcityhistoricalsociety.org/calumet-city-history.html"
    },
    {
      "id": 5,
      "text": "The Smiley Tower, a local landmark, appears in the movie Natural Born Killers, seen from a mall house window.",
