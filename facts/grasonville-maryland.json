      "quality": "poor",
      "qualityReason": "location_description"
    },
    {
      "id": 2,
      "text": "The Chesapeake Bay Environmental Center, open daily from 9 a.m. to 5 p.m., covers more than 500 acres of forests, wetlands, and open water.",
      "sourceSentenceIds": [
        21,
