      ],
      "source": "https://www.islands.com/2011298/grasonville-ocean-charming-maryland-town-lakes-parks-boardwalks/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Kayak and paddleboard rentals cost $20 a day, and guided tours are available for beginners.",
      "sourceSentenceIds": [
        29,
        30
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.islands.com/2011298/grasonville-ocean-charming-maryland-town-lakes-parks-boardwalks/",
      "category": "other",
      "quality": "poor",
      "qualityReason": "other"
    },
    {
      "id": 4,
      "text": "Grasonville sits just off U.S. Route 50, about 7 miles past the Bay Bridge across Kent Island.",
      "sourceSentenceIds": [
        24,
        25
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.islands.com/2011298/grasonville-ocean-charming-maryland-town-lakes-parks-boardwalks/",
      "category": "other",
      "quality": "poor",
      "qualityReason": "route_only"
    },
    {
      "id": 5,
      "text": "In summer, you can rent a kayak and paddle through narrow marsh channels that eventually open to the Bay itself.",
      "sourceSentenceIds": [
        23
      ],
      "sourceLabels": [
