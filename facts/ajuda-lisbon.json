  "facts": [
    {
      "id": 1,
      "text": "Ajuda’s name comes from a 15th‑century legend of a shepherd who found an image of Nossa Senhora da Ajuda in a rock fissure, sparking pilgrimages.",
      "sourceSentenceIds": [
        6,
        8
      ],
      "sourceLabels": [
        "Web source 1",
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/Ajuda",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The royal family abandoned the Ribeira Palace after the 1755 earthquake and settled in Ajuda’s Quinta de Cima, first in wooden Real Barraca.",
      "sourceSentenceIds": [
        4,
        12
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Ajuda",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Ajuda National Palace, begun in 1795, was interrupted by the French invasion and finished in the mid‑19th century, later becoming King Carlos I’s residence.",
      "sourceSentenceIds": [
        13,
        27,
        30
      ],
      "sourceLabels": [
        "Wikipedia",
        "Wikipedia",
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Ajuda",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The area’s low‑lying Tagus estuary zones expose it to occasional winter flooding, a risk heightened by storm surges and tidal dynamics.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/Ajuda",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Ajuda borders the Monsanto Forest Park to the north and the Tagus estuary to the south, linking historic royal routes to Belém.",
      "sourceSentenceIds": [
        5,
        7
      ],
      "sourceLabels": [
        "Web source 1",
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/Ajuda",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The parish hosts nine Properties of Public Interest, ranging from Manueline rib vaults to a 17th‑century pipe‑factory now a contemporary‑art pop‑up.",
