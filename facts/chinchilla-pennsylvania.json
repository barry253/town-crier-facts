  "facts": [
    {
      "id": 1,
      "text": "Chinchilla began in 1849 as a modest railroad stop on the Delaware, Lackawanna & Western line, fueling local coal and lumber trade.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.trawellino.com/destinations/united-states/pennsylvania_chinchilla",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The borough’s name comes from the South American chinchilla, even though the animal never once roamed the area.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.trawellino.com/destinations/united-states/pennsylvania_chinchilla",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Nestled in the gorge of Leggetts Creek, Chinchilla sits where the creek flows south into the Lackawanna River.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Chinchilla%2C_Pennsylvania",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Every summer, residents celebrate Chinchilla Community Days, a festival that mixes food, music, and family activities.",
      "sourceSentenceIds": [
        11
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.trawellino.com/destinations/united-states/pennsylvania_chinchilla",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Despite its small size, Chinchilla enjoys a rural charm while remaining part of the Scranton–Wilkes-Barre metropolitan area.",
