  "facts": [
    {
      "id": 1,
      "text": "Marion was founded in 1900 as Elmo, renamed in 1902 after Marion Mellen, daughter of Northern Pacific Railway president Charles Sanger Mellen.",
      "sourceSentenceIds": [
        1,
        6
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Marion%2C_North_Dakota"
    },
    {
      "id": 2,
      "text": "The town sat at the end of a Northern Pacific branch line known as the \"lady line,\" a route that linked cities named after women.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Marion%2C_North_Dakota"
    },
    {
      "id": 3,
      "text": "Marion’s coordinates place it at 46°36′26″N 98°20′1″W, a spot in the northern plains of North Dakota.",
