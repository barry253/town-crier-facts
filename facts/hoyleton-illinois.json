  "facts": [
    {
      "id": 1,
      "text": "Hoyleton was platted as a town in 1858, named after pioneer Henry Hoyle, a settler from the east.",
      "sourceSentenceIds": [
        4,
        2
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://genealogytrails.com/ill/washington/hoyletonhistory.html",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "In 1895 the Zion Evangelical Church deeded a former seminary to launch Hoyleton Orphan’s Home, a charity that served children for decades.",
      "sourceSentenceIds": [
        14,
        15
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://hoyleton.org/about/timeline-history/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "A chimney fire in 1915 destroyed the original orphanage, prompting the construction of a fire‑proof brick building in 1916.",
      "sourceSentenceIds": [
        17,
        16
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://hoyleton.org/about/timeline-history/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The orphanage celebrated its 50th anniversary in 1945, marking half a century of caring for children in the community.",
      "sourceSentenceIds": [
        21
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://hoyleton.org/about/timeline-history/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "By 1960 the facility shifted from a traditional orphanage to a residential program for children coming through the court system.",
      "sourceSentenceIds": [
        23
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://hoyleton.org/about/timeline-history/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "In 1970 the home’s mission changed again, focusing on reuniting children with their families and teaching life‑skills and vocational training.",
      "sourceSentenceIds": [
        25,
        26
      ],
