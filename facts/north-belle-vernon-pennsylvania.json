  "facts": [
    {
      "id": 1,
      "text": "The name 'Belle Vernon' means 'beautiful green' in French, a title Noah Speers and his son Louis chose for the town and its northern neighbor.",
      "sourceSentenceIds": [
        2,
        4
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://bellevernonboro.net/our-history/",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Founded in 1813, the original 'Bellevernon' was laid out by pioneer Noah Speers in northwestern Fayette County.",
      "sourceSentenceIds": [
        6,
        7
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 2"
      ],
      "source": "https://en.wikipedia.org/wiki/Belle_Vernon%2C_Pennsylvania",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "North Belle Vernon was plotted in 1872 by Louis Speers and officially incorporated four years later in 1876.",
      "sourceSentenceIds": [
        30
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Belle_Vernon%2C_Pennsylvania",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "A bustling boatyard on 3rd Street built hulls in the 1830s and 1840s, employing more than 50 workers.",
      "sourceSentenceIds": [
        3,
        5,
        21
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Belle_Vernon%2C_Pennsylvania",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The Belle Vernon Public Library serves residents of all ages with books, online services, and community resources.",
      "sourceSentenceIds": [
        11
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.northbellevernonboro.com/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Belle Vernon shares borders with Washington Township to the southeast and the Westmoreland County neighborhoods of North Belle Vernon and Rostraver Township.",
      "sourceSentenceIds": [
        14
