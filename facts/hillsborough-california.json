  "facts": [
    {
      "id": 1,
      "text": "Hillsborough’s roots trace back to the 1890s when the caretaker’s cottage for Henry T. became the first historic compound in town.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://hillsboroughblog.com/History",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town’s early growth was spurred by new railroad stations in San Mateo and Burlingame, making Hillsborough a quick stop from San Francisco between 1893 and 1910.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://hillsboroughblog.com/History",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Hillsborough’s landscape hosts serpentinite outcrops that shelter rare plants like the San Mateo woolly sunflower.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Hillsborough%2C_California",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The grand Carolands Chateau, built in 1914, sits on a hill overlooking the Bay and was once the home of the Pullman family.",
      "sourceSentenceIds": [
        2,
        3
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://hillsboroughblog.com/History",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The Crystal Springs Uplands School, founded in the 1910s, occupies the former Rosecourt villa designed by Lewis Hobart in 1913.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://hillsboroughblog.com/History",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Hillsborough’s historic Tevis Carriage House anchors the Homeplace area of Mid North Hillsborough, a reminder of the town’s early affluent settlers.",
      "sourceSentenceIds": [
        20
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://hillsboroughblog.com/History",
      "category": "landmark",
