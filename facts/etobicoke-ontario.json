  "facts": [
    {
      "id": 1,
      "text": "Etobicoke’s name comes from a Mississauga word meaning 'place where the alders grow,' echoing the area's alder‑rich wetlands.",
      "sourceSentenceIds": [
        3,
        9,
        24
      ],
      "sourceLabels": [
        "Web source 1",
        "Web source 2",
        "Wikipedia"
      ],
      "source": "https://www.etobicokehistorical.com/brief-history-of-etobicoke.html"
    },
    {
      "id": 2,
      "text": "European settlers first arrived in Etobicoke during the 1790s, marking the start of its colonial history.",
      "sourceSentenceIds": [
        18
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Etobicoke"
    },
    {
      "id": 3,
      "text": "The former McGuiness Whisky factory was transformed into high‑rise lofts that now crown the Mystic Pointe development.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Etobicoke"
    },
    {
      "id": 4,
      "text": "Etobicoke hosts the western terminus of Toronto’s Line 2 Bloor‑Danforth subway, where trains end at Kipling station.",
      "sourceSentenceIds": [
        14
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Etobicoke"
    },
    {
      "id": 5,
      "text": "Around 1900, developer Robert Home Smith cleared the former Kingsmill forest, creating the upscale communities of Kingsway and Humber Valley Village.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Etobicoke"
    },
    {
      "id": 6,
      "text": "In 1998, Etobicoke’s city status dissolved as it merged into the larger City of Toronto.",
      "sourceSentenceIds": [
