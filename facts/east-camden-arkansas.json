  "facts": [
    {
      "id": 1,
      "text": "East Camden was originally called Billkitts Rental Housing and began as a planned community to support the nearby Shumaker Naval Ammunition Depot.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/East_Camden%2C_Arkansas",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The United States Navy built East Camden to support a mission that mattered to the entire country, making it the only Arkansas city literally constructed by the Navy.",
      "sourceSentenceIds": [
        29,
        21
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://eastcamdenar.gov/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "A surveyor named Smith designed East Camden’s layout and named its streets, shaping the town’s grid from its inception.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/East_Camden%2C_Arkansas",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Brown and Root’s Highland Resources later transformed the depot into an industrial park that attracts defense contractors thanks to a nearby eight‑mile rocket range and extensive underground bunkers.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/East_Camden%2C_Arkansas",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The Brown Foundation donated 70 acres of land and six buildings to create Southern Arkansas University Tech, a two‑year college that now serves the community.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/East_Camden%2C_Arkansas",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Highland Industrial Park hosts major defense manufacturers such as Lockheed Martin, L3Harris, and General Dynamics, keeping the town’s defense legacy alive.",
      "sourceSentenceIds": [
        30
      ],
      "sourceLabels": [
        "Web source 1"
