  "facts": [
    {
      "id": 1,
      "text": "Kokhanok sits on the southern shore of Alaska’s largest freshwater lake, Lake Iliamna, giving residents a vital waterway for transport and resources.",
      "sourceSentenceIds": [
        3,
        11
      ],
      "sourceLabels": [
        "Web source 1",
        "Wikipedia"
      ],
      "source": "https://www.kupi.com/en/explore/united-states/kokhanok/history"
    },
    {
      "id": 2,
      "text": "Before becoming a village, Kokhanok was a seasonal fishing and hunting camp used by indigenous peoples in the late 1800s, only turning permanent in the 20th century.",
      "sourceSentenceIds": [
        5,
        21,
        6
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.kupi.com/en/explore/united-states/kokhanok/history"
    },
    {
      "id": 3,
      "text": "The community’s culture blends Athabascan and Eskimo traditions, passing down survival skills from generation to generation.",
      "sourceSentenceIds": [
        23
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.kupi.com/en/explore/united-states/kokhanok/history"
    },
    {
      "id": 4,
      "text": "Saints Peter and Paul Church, with its onion dome and Orthodox cross, stands as a reminder of Russian cultural influence in Kokhanok.",
      "sourceSentenceIds": [
        7,
        9
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.kupi.com/en/explore/united-states/kokhanok/history"
    },
    {
      "id": 5,
      "text": "Unlike nearby Iliamna, Kokhanok’s economy relies on subsistence hunting and fishing rather than sport fishing.",
      "sourceSentenceIds": [
        20
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.kupi.com/en/explore/united-states/kokhanok/history"
    },
    {
      "id": 6,
      "text": "In the early 2000s, rising water levels in Lake Iliamna forced Kokhanok residents to relocate some homes to higher ground.",
