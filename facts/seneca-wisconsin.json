    },
    {
      "id": 2,
      "text": "French explorer Jean Nicolet was the first white man to visit the vicinity of Seneca on a diplomatic mission.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.bowlerareahistory.org/history-of-seneca"
    },
    {
      "id": 3,
      "text": "Land speculators arrived around 1800 to build dams and sawmills to float pine logs down the local rivers.",
      "sourceSentenceIds": [
        13
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.bowlerareahistory.org/history-of-seneca"
    },
    {
      "id": 4,
      "text": "Christian Friedrick Maas, known as Old Fritz, is recognized as the first permanent settler in the Seneca area.",
      "sourceSentenceIds": [
        19,
        23
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.bowlerareahistory.org/history-of-seneca"
    },
    {
      "id": 5,
      "text": "Early settlers in Seneca cleared forests, but hardwoods were burned as scrap until railroads brought harvesting equipment to the area.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.bowlerareahistory.org/history-of-seneca"
    },
    {
      "id": 6,
      "text": "The Tilleda House and Saloon began as a rooming house in the late 1920s to accommodate local loggers and millworkers.",
