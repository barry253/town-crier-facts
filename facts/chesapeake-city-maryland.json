  "facts": [
    {
      "id": 1,
      "text": "Chesapeake City was originally called the Village of Bohemia by colonist Augustine Herman, renamed in 1839 after the canal opened.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Chesapeake_City%2C_Maryland",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The 14‑mile hand‑dug Chesapeake & Delaware Canal opened to traffic on October 17, 1829, cutting the town in half.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.chesapeakecity-md.gov/town-history/",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "A drawbridge once spanned the canal until 1942 when a freighter smashed it; the current high bridge opened in 1949 to let supertankers pass.",
      "sourceSentenceIds": [
        16,
        17,
        18
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Chesapeake_City%2C_Maryland",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Chesapeake City’s south bank, with its intact 19th‑century architecture, was listed on the National Register of Historic Places in 1974.",
      "sourceSentenceIds": [
        7,
        27
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.chesapeakecity-md.gov/town-history/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Every Sunday July through September, local musicians perform live at Pell Gardens, a historic downtown spot.",
      "sourceSentenceIds": [
        3,
        12
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://chesapeakecity.com/",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "In 1911, Ukrainian settlers bought farmland at Chesapeake City’s edge, later building Basil’s Ukrainian Church and an orphanage that served children until the 1970s.",
      "sourceSentenceIds": [
