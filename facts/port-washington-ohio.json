  "facts": [
    {
      "id": 1,
      "text": "Port Washington was originally called Salisbury and was laid out in 1827.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Port_Washington%2C_Ohio"
    },
    {
      "id": 2,
      "text": "John Knight settled the village in 1827, making it a major stop on the canal between Cleveland and Portsmouth.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.portwashingtonohio.org/history"
    },
    {
      "id": 3,
      "text": "The canal’s prosperity gave way to the railroad, with the Pennsylvania Railroad playing a major role in the town’s growth.",
      "sourceSentenceIds": [
        5,
        6
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.portwashingtonohio.org/history"
    },
    {
      "id": 4,
      "text": "The Port Washington station was a key fueling stop for trains, a major employer, and the hub for mail delivery.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.portwashingtonohio.org/history"
    },
    {
      "id": 5,
      "text": "A post office has operated in Port Washington since 1832.",
      "sourceSentenceIds": [
        13
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Port_Washington%2C_Ohio"
    },
    {
      "id": 6,
      "text": "Union Cemetery was named to honor Northern soldiers who died in the Civil War.",
      "sourceSentenceIds": [
