  "facts": [
    {
      "id": 1,
      "text": "Hereford’s name comes from Herefordshire, England, honoring the ironmasters who founded the township in 1753.",
      "sourceSentenceIds": [
        19
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/hereford_pennsylvania",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The first iron furnaces appeared in 1734, employing up to 150 workers and powering early mills with Perkiomen Creek.",
      "sourceSentenceIds": [
        18,
        25
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/hereford_pennsylvania",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Rail service began in the 1830s when the Philadelphia and Reading Railroad linked Hereford to Reading, cutting transport costs for farm goods.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/hereford_pennsylvania",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Wheat dominated Hereford’s early 1800s agriculture, making the township a key grain supplier to Philadelphia via the Schuylkill River.",
      "sourceSentenceIds": [
        28
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/hereford_pennsylvania",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "By the mid‑19th century, soil exhaustion shifted farmers to dairy, producing butter and cheese for city markets.",
      "sourceSentenceIds": [
        29
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/hereford_pennsylvania",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The post office operated from 1830 until its abrupt 2019 closure after the lease owner refused renewal.",
