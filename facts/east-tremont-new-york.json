  "facts": [
    {
      "id": 1,
      "text": "Tremont derives from Latin tres montes, meaning \"three hills\", a nod to the triad of ridges that once marked the Bronx.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.cityneighborhoods.nyc/east-tremont",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The mid‑19th‑century construction of Tremont Avenue and the arrival of the New York & Harlem Railroad along Webster Avenue opened East Tremont to rapid development.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.cityneighborhoods.nyc/east-tremont",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "In the 1950s, as white families moved to the suburbs, Puerto Rican and African‑American families displaced by urban renewal settled in East Tremont.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.cityneighborhoods.nyc/east-tremont",
      "category": "people",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The Tremont branch of the New York Public Library, a Carnegie‑funded Italian Renaissance building designed by Carrère and Hastings, opened in 1905.",
      "sourceSentenceIds": [
        22,
        23
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/East_Tremont%2C_Bronx",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "East Tremont Avenue evolved into a lively commercial corridor, home to kosher bakeries, delis, theaters, clothing shops, and candy stores.",
      "sourceSentenceIds": [
        25
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.cityneighborhoods.nyc/east-tremont",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Louis Niñé Boulevard, named for a 1970s Bronx assemblyman and Puerto Rican activist, stands as a symbol of the neighborhood’s civic pride.",
      "sourceSentenceIds": [
        2
