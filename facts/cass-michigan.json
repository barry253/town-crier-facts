  "facts": [
    {
      "id": 1,
      "text": "Cass City grew along the Cass River in the mid‑1800s into a hub of farming, industry, and small‑town life.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://thumbwind.com/2025/08/25/history-of-cass-city-michigan/"
    },
    {
      "id": 2,
      "text": "The village’s name honors Lewis Cass, Michigan’s 19th‑century territorial governor, after whom the nearby Cass River was also named.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://thumbwind.com/2025/08/25/history-of-cass-city-michigan/"
    },
    {
      "id": 3,
      "text": "In 1906, Pleasant Home Hospital opened, marking a milestone in Cass City’s progress and care for residents.",
      "sourceSentenceIds": [
        13
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://thumbwind.com/2025/08/25/history-of-cass-city-michigan/"
    },
    {
      "id": 4,
      "text": "A sawmill began operation in 1851, and settlers arrived by 1855, laying the groundwork for the village’s early economy.",
      "sourceSentenceIds": [
        28,
        29
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://thumbwind.com/2025/08/25/history-of-cass-city-michigan/"
    },
    {
      "id": 5,
      "text": "Cass City’s annual “Cruise‑In” on Main Street celebrates classic cars, while the Historical Society preserves old photos of the town’s past.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://thumbwind.com/2025/08/25/history-of-cass-city-michigan/"
    },
    {
      "id": 6,
      "text": "The Rawson Memorial Library earned the 2007 State Librarian’s Excellence Award, highlighting Cass City’s commitment to public service.",
      "sourceSentenceIds": [
        22
      ],
