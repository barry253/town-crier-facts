  "facts": [
    {
      "id": 1,
      "text": "Wallins Creek was named after an early surveyor, and its post office opened on May 22, 1866, marking the community’s first official recognition.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://appalachianhistorian.org/wallins-creek-harlan-county-post-office-coal-church-and-the-making-of-a-mountain-community/",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The Arthur Kilgore Mine issued 1915 scrip for workers, and the company, founded in 1912, operated in Wallins Creek until 1919.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://appalachianhistorian.org/wallins-creek-harlan-county-post-office-coal-church-and-the-making-of-a-mountain-community/",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Wallins Creek began life as a coal‑mining town in 1925, with the mine owned by the Wallins Creek Coal Corporation.",
      "sourceSentenceIds": [
        11
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Wallins_Creek%2C_Kentucky",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The Wallins Creek Baptist Church was founded in 1855, starting with just 30 members who gathered at the creek’s banks.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Wallins_Creek%2C_Kentucky",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The town grew along the Cumberland River, a few miles west of Harlan, where creek mouths and narrow crossings made settlement possible.",
      "sourceSentenceIds": [
        24
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://appalachianhistorian.org/wallins-creek-harlan-county-post-office-coal-church-and-the-making-of-a-mountain-community/",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "By the early twentieth century, Wallins Creek became part of Harlan County’s expanding coal industry, linked by the railroad.",
