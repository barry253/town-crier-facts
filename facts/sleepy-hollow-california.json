  "facts": [
    {
      "id": 1,
      "text": "Sleepy Hollow’s name echoes Washington Irving’s “The Legend of Sleepy Hollow,” adding literary charm even though the town has no direct ties to the story.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.marincountyvisitor.com/history-of-sleepy-hollow-marin-county-california/"
    },
    {
      "id": 2,
      "text": "In 1839, the Mexican government granted 6,659 acres of Rancho Canada de Herrera to Domingo Sais, laying the land‑grant foundation of the area.",
      "sourceSentenceIds": [
        5,
        30
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.marincountyvisitor.com/history-of-sleepy-hollow-marin-county-california/"
    },
    {
      "id": 3,
      "text": "Richard Hotaling’s elegant mansion, built in the 19th century, became a landmark that influenced Marin County’s architectural style.",
      "sourceSentenceIds": [
        7,
        12
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.marincountyvisitor.com/history-of-sleepy-hollow-marin-county-california/"
    },
    {
      "id": 4,
      "text": "World War II left a substantial imprint on Sleepy Hollow, shaping its community and development during the mid‑20th century.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.marincountyvisitor.com/history-of-sleepy-hollow-marin-county-california/"
    },
    {
      "id": 5,
      "text": "Local soccer star Sam Coffey earned a gold medal at the 2024 Paris Olympics, a proud moment for Sleepy Hollow residents.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://strollsleepyhollow.com/"
    },
    {
      "id": 6,
      "text": "From ranching roots, Sleepy Hollow evolved into a quiet residential enclave, preserving its rural charm while growing into a modern community.",
