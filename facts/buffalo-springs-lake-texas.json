      ],
      "source": "https://www.tshaonline.org/handbook/entries/buffalo-springs-lake",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "In 1877 the Causey brothers built a half‑dugout at Buffalo Springs, and ranchers moved in the next year.",
      "sourceSentenceIds": [
        29
      ],
      "sourceLabels": [
        "Web source 1"
      ],
