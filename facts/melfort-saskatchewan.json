  "facts": [
    {
      "id": 1,
      "text": "Melfort became Saskatchewan's twelfth city on September 2, 1980, marking its growth from a small railway stop to a municipal hub.",
      "sourceSentenceIds": [
        25
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Melfort%2C_Saskatchewan",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The city sits on the banks of Melfort Creek, a tributary of the Carrot River that helped shape early settlement patterns.",
      "sourceSentenceIds": [
        30
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Melfort%2C_Saskatchewan",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The Clift Brothers built the landmark Pioneer General Store in 1907, a commercial cornerstone that later became part of the town’s historic core.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.melfort.ca/p/history-of-melfort",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Melfort earned the nickname “City of Northern Lights” because the aurora borealis frequently lights up its night sky.",
      "sourceSentenceIds": [
        18
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Melfort%2C_Saskatchewan",
      "category": "culture",
      "quality": "good"
    },
    {
