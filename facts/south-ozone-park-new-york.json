  "facts": [
    {
      "id": 1,
      "text": "South Ozone Park’s name comes from developers Benjamin Hitchcock and Charles Denton in the 1880s, who marketed the area as a sea‑air health retreat.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.cityneighborhoods.nyc/south-ozone-park"
    },
    {
      "id": 2,
      "text": "When the New York, Woodhaven, and Rockaway Railroad opened in 1883, it linked South Ozone Park to Brooklyn and Manhattan, sparking suburban growth.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.cityneighborhoods.nyc/south-ozone-park"
    },
    {
      "id": 3,
      "text": "The South Ozone Park Library, opened early in the neighborhood’s history, remains a hub for education and community events.",
      "sourceSentenceIds": [
        15
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.longislandexchange.com/new-york-city/queens/south-ozone-park/"
    },
    {
      "id": 4,
      "text": "Founded in the mid‑century, the South Ozone Park Civic Association has played a key role in keeping property values and safety high.",
      "sourceSentenceIds": [
