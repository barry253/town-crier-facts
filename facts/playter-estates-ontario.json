      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The old Playter farmhouse at 28 Playter Crescent now serves as the Playter Mansion, a popular backdrop for films and commercials.",
      "sourceSentenceIds": [
