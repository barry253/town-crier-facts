      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The Playter Area Residents’ Association began in 1972 to oppose high‑rise development and foster community advocacy.",
      "sourceSentenceIds": [
        14
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://playterarearesidents.com/playter-estates-para/",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Playter Estates sits between Pape Avenue, the Don River Valley, Danforth Avenue, and Fulton Avenue, giving it a distinct east‑end boundary.",
      "sourceSentenceIds": [
        20
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Playter_Estates",
