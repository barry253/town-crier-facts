  "facts": [
    {
      "id": 1,
      "text": "Lutwyche is named after Alfred Lutwyche, a Supreme Court judge appointed to Moreton Bay in 1859 before Queensland's self‑government.",
      "sourceSentenceIds": [
        5,
        7
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Lutwyche%2C_Queensland",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The suburb’s main artery, Lutwyche Road, is part of Metroad 3 and hosts a cluster of small shops and the HomeCo shopping centre.",
      "sourceSentenceIds": [
        12,
        13
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Lutwyche%2C_Queensland",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "A Cross of Sacrifice was erected at Lutwyche Cemetery in 1950 to honor those who served in both World Wars.",
      "sourceSentenceIds": [
        20,
        3
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 2"
      ],
      "source": "https://en.wikipedia.org/wiki/Lutwyche%2C_Queensland",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The Lutwyche busway station, finished in June 2012, is part of the Northern Busway tunnel that links the suburb to Brisbane’s city centre.",
      "sourceSentenceIds": [
        6,
        9,
        10
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 2"
      ],
      "source": "https://en.wikipedia.org/wiki/Lutwyche%2C_Queensland",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Kedron Brook, a creek with parklands and a bikeway, marks Lutwyche’s north‑western boundary and offers a green corridor through the suburb.",
      "sourceSentenceIds": [
        14
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Lutwyche%2C_Queensland",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Before 1968, frequent tram services ran along Lutwyche Road from Chermside, Kalinga, and Stafford, making the suburb a key tram hub.",
