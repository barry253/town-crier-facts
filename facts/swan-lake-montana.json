  "facts": [
    {
      "id": 1,
      "text": "Swan Lake's name might come from trumpeter swans that once filled the valley, or from early settler Emmett Swan.",
      "sourceSentenceIds": [
        1,
        2
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://roamingmontana.com/swan-lake-montana/",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "A logging camp that slowed down the small, unincorporated community of Swan Lake started as a logging camp in the early 1900s, cutting timber for the Great Northern Railroad.",
      "sourceSentenceIds": [
        3,
        4
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://roamingmontana.com/swan-lake-montana/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The Swan Lake CDP sits on the east shore of the lake, extending east to the Lake County/Flathead County line along the crest of the Swan Range.",
      "sourceSentenceIds": [
        5,
        6
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Swan_Lake%2C_Montana",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Elevations in Swan Lake range from 3,066 feet on the lake to 7,218 feet at Con Kelly Mountain's summit.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Swan_Lake%2C_Montana",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Today, Swan Lake thrives on outdoor recreation—fishing, hiking, birding, backcountry skiing, and dog sledding.",
      "sourceSentenceIds": [
        19
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://roamingmontana.com/swan-lake-montana/",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The lake itself stretches almost 10 miles long and about a mile wide.",
