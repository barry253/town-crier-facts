  "facts": [
    {
      "id": 1,
      "text": "Óbuda, literally \"Old Buda\", joined Buda and Pest in 1873 to form modern Budapest.",
      "sourceSentenceIds": [
        15
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/%C3%93buda"
    },
    {
      "id": 2,
      "text": "Roman legionnaires stationed at Aquincum built baths, a villa, and two amphitheatres that still echo the ancient city.",
      "sourceSentenceIds": [
        11
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/%C3%93buda"
    },
    {
      "id": 3,
      "text": "The Aquincum Museum showcases jewels, glassware, metal tools, and wall paintings that reveal daily life of ancient Romans.",
      "sourceSentenceIds": [
        24
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/%C3%93buda"
    },
    {
      "id": 4,
      "text": "Óbuda Island hosts the Sziget Festival, a yearly music and cultural celebration that attracts visitors from around the world.",
      "sourceSentenceIds": [
        16
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/%C3%93buda"
    },
    {
      "id": 5,
      "text": "Fő tér, Óbuda's main square, sits beside the Szentlélek tér BHÉV station and has preserved its peaceful charm through turbulent centuries.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.budapestbylocals.com/obuda/"
    },
    {
      "id": 6,
      "text": "The historic Silk Spinner Manufactory on Miklós tér 1 once produced fine textiles for the region.",
