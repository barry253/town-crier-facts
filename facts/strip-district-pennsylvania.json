  "facts": [
    {
      "id": 1,
      "text": "Officially named the “Northern Liberties of Pittsburgh,” locals called the Strip District Bayardstown, a nickname that still echoes in the streets.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.stripdistrictneighbors.org/history/",
      "category": "other",
      "quality": "poor",
      "qualityReason": "editorial_filler"
    },
    {
      "id": 2,
      "text": "After the Civil War, factories sprang up along the Allegheny River, pushing industrial growth eastward and shaping the district’s skyline.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.stripdistrictneighbors.org/history/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "George Westinghouse launched his first air‑brake factory on Liberty Avenue’s 2400 block, marking the district’s role in transportation innovation.",
      "sourceSentenceIds": [
        11
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.stripdistrictneighbors.org/history/",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Railroad tracks once ran straight down Liberty Avenue, turning the Strip into a bustling freight corridor in the 1800s.",
      "sourceSentenceIds": [
        18
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.stripdistrictneighbors.org/history/",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Wholey’s Fish Market, Pennsylvania Macaroni Co., and the original Primanti Brothers still line the streets, preserving the area’s historic flavor.",
      "sourceSentenceIds": [
        21
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.stripdistrictneighbors.org/history/",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Today the Strip hosts award‑winning spirits, from Wigle Whiskey’s historic rye to Maggie’s Farm Rum’s tropical small‑batch vibes.",
      "sourceSentenceIds": [
        15
      ],
