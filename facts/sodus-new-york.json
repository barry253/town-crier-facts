  "facts": [
    {
      "id": 1,
      "text": "Sodus takes its name from the Seneca word “Assorodus,” meaning “silvery water,” a nod to its historic Lake Ontario shoreline.",
      "sourceSentenceIds": [
        15,
        18
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Sodus%2C_New_York",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "During the War of 1812, British naval forces landed at Sodus Point on June 19–20, 1813, marking the town’s most significant military conflict.",
      "sourceSentenceIds": [
        11
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Sodus%2C_New_York",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The Sodus Bay Yacht Club, founded in 1893, still hosts competitive regattas, keeping the town’s maritime heritage alive on the bay.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Sodus%2C_New_York",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The 19th-century schooner Lotus, along with the local Customs House and Sodus Point Light, is listed on the National Register of Historic Places in the village of Sodus Point.",
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Sodus_Point%2C_New_York",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Sodus once thrived as a coal transshipment center in the 1880s, thanks to the Sodus Bay and Southern Railroad that later joined the Pennsylvania Railroad.",
      "sourceSentenceIds": [
        22
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Sodus%2C_New_York",
      "category": "economy",
      "quality": "good"
    }
