      ],
      "source": "https://en.wikipedia.org/wiki/Montgomery_Township%2C_New_Jersey",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The Van Harlingen Historical Society, founded in 1965, preserves Montgomery’s heritage through exhibits and educational programs.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
