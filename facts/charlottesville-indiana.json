      "category": "culture",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The annual Virginia Festival of the Book brings nationally known authors to Charlottesville, celebrating literature that spans history, folklore, and family narratives.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 2"
