      "quality": "good"
    },
    {
      "id": 3,
      "text": "Each September, the Maupintown Film Festival in Charlottesville showcases films about Black culture and history, honoring the town’s African‑American heritage.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 2"
