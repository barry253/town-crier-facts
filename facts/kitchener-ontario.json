  "facts": [
    {
      "id": 1,
      "text": "Founded by Bishop Benjamin Eby in 1807, the settlement grew from a Mennonite farm into the village later called Berlin.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Kitchener%2C_Ontario",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "In 1916, residents voted to rename Berlin to Kitchener after British field marshal Lord Kitchener, a change that stuck.",
      "sourceSentenceIds": [
        3,
        9
      ],
      "sourceLabels": [
        "Web source 1",
        "Wikipedia"
      ],
      "source": "https://www.britannica.com/place/Kitchener",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "German immigrants, mainly Lutheran and Catholic, settled after 1850 and brought Turner societies, gymnastics, and band music to the city.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Kitchener%2C_Ontario",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Kitchener–Waterloo Collegiate and Vocational School, opened in 1855, remains the oldest high school in the city.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Kitchener%2C_Ontario",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The Berlin and Waterloo Street Railway, later renamed Kitchener and Waterloo Street Railway, began municipal operation in 1906 and carried passengers across the region.",
      "sourceSentenceIds": [
        13,
        14
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Kitchener%2C_Ontario",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "GO train service reached Kitchener in 2011, extending the commuter line from Georgetown to the city.",
      "sourceSentenceIds": [
        29
