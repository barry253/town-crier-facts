  "facts": [
    {
      "id": 1,
      "text": "Newbern was founded in 1810 by Adam Hance, a Revolutionary War veteran, on his 1,400‑acre plantation along the Wilderness Road.",
      "sourceSentenceIds": [
        7,
        15
      ],
      "sourceLabels": [
        "Web source 2",
        "Wikipedia"
      ],
      "source": "https://grokipedia.com/page/newbern_virginia",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town’s name echoes its Swiss roots, chosen by early settlers from Bern, Switzerland.",
      "sourceSentenceIds": [
        13
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Newbern%2C_Virginia",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Newbern once served as Pulaski County’s seat from 1839 until the courthouse burned in 1892, after which Pulaski took over.",
      "sourceSentenceIds": [
        12,
        5
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Newbern%2C_Virginia",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The Newbern Historic District, covering the whole village, includes 26 original structures and was listed on the Virginia Landmarks Register in 1975 and the National Register in 1979.",
      "sourceSentenceIds": [
        6,
        14
      ],
      "sourceLabels": [
        "Web source 2",
        "Wikipedia"
      ],
      "source": "https://grokipedia.com/page/newbern_virginia",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The Great Road, now the Wilderness Trail, ran directly through Newbern, making it a key stop for westward travelers in the 1800s.",
      "sourceSentenceIds": [
        3,
        23
      ],
      "sourceLabels": [
        "Wikipedia",
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Newbern%2C_Virginia",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "After the courthouse fire, Newbern’s economy shifted to agriculture and small‑scale farming, marking a quiet but lasting change in the town’s character.",
