  "facts": [
    {
      "id": 1,
      "text": "Oswegatchie means \"Black Water\" and was the name given by the British after renaming the French community La Gallette.",
      "sourceSentenceIds": [
        2,
        7
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Oswegatchie%2C_New_York"
    },
    {
      "id": 2,
      "text": "The town was founded in 1802 from the town of Lisbon when Lawrence County was formed.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Oswegatchie%2C_New_York"
    },
    {
      "id": 3,
      "text": "During the War of 1812, Ogdensburg and much of Oswegatchie were captured by British forces.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Oswegatchie%2C_New_York"
    },
    {
      "id": 4,
      "text": "The Oswegatchie River defines part of the southern town line, while the St. Lawrence River marks the northwestern border with Canada.",
      "sourceSentenceIds": [
        15,
        16,
        17
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Oswegatchie%2C_New_York"
    },
    {
      "id": 5,
      "text": "Mater Dei College opened in 1960 and closed in 2001, later becoming a school for troubled teens.",
      "sourceSentenceIds": [
        14
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Oswegatchie%2C_New_York"
    },
    {
      "id": 6,
      "text": "In 1821, the western part of Oswegatchie was split to create the Town of Morristown.",
