  "facts": [
    {
      "id": 1,
      "text": "Powhatan Point was platted in 1849 and has had a post office in operation since 1828.",
      "sourceSentenceIds": [
        11,
        12
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Powhatan_Point%2C_Ohio",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town’s name honors Chief Powhatan of Virginia, while “Point” marks the confluence of Captina Creek and the Ohio River.",
      "sourceSentenceIds": [
        2,
        3,
        4
      ],
      "sourceLabels": [
        "Web source 2",
        "Wikipedia"
      ],
      "source": "https://www.visitbelmontcounty.com/ba_location/powhatan-point/",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "In 1850 the Powhatan Enterprise Flouring Mill and Woolen Factory sparked local commerce, shipping grain, fruit, lumber, cheese, whiskey, livestock, wool, and tobacco to northern and southern ports.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.visitbelmontcounty.com/ba_location/powhatan-point/",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Powhatan Point sits on the Ohio River and is the nearest Ohio‑side town to Captina Island.",
      "sourceSentenceIds": [
        10,
        8
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Powhatan_Point%2C_Ohio",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The village hosts a K‑8 elementary school that serves its residents.",
      "sourceSentenceIds": [
        26
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Powhatan_Point%2C_Ohio",
      "category": "landmark",
      "quality": "good"
    },
    {
