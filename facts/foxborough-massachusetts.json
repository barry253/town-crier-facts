  "facts": [
    {
      "id": 1,
      "text": "Foxborough was settled in 1704 and incorporated in 1778, named after British Whig Charles James Fox, a supporter of colonial independence.",
      "sourceSentenceIds": [
        4,
        6,
        7
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 2"
      ],
      "source": "https://en.wikipedia.org/wiki/Foxborough%2C_Massachusetts",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town once housed the world's largest straw hat factory, the Union Straw Works, built in 1886 and destroyed by fire in 1900.",
      "sourceSentenceIds": [
        11,
        14,
        15
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 2"
      ],
      "source": "https://en.wikipedia.org/wiki/Foxborough%2C_Massachusetts",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Gillette Stadium, home of the New England Patriots and New England Revolution, opened in 1971 after construction began in 1970.",
      "sourceSentenceIds": [
        10,
        16,
        28
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 2"
      ],
      "source": "https://en.wikipedia.org/wiki/Foxborough%2C_Massachusetts",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Memorial Hall, a stone building in the town center, now serves as a veterans memorial with a permanent collection of local historical artifacts.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Foxborough%2C_Massachusetts",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Boyden Library, located off the Common on Bird Street, offers lifelong learning and is a cultural hub for residents.",
      "sourceSentenceIds": [
        19
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.foxboroughma.gov/Residents/Welcome_to_Foxborough/About_the_Town",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Foxborough sits about 22 miles southwest of Boston in the MetroWest region, part of the Boston metropolitan area.",
