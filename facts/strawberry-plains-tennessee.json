  "facts": [
    {
      "id": 1,
      "text": "Strawberry Plains earned its name from the wild strawberries that flourished there when North Carolina settlers first arrived.",
      "sourceSentenceIds": [
        1,
        2
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 2"
      ],
      "source": "https://en.wikipedia.org/wiki/Strawberry_Plains%2C_Tennessee",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Adam Meek, a North Carolina pioneer, first settled the area that would become Strawberry Plains in 1785.",
      "sourceSentenceIds": [
        22
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Strawberry_Plains%2C_Tennessee",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "In 1808, William Williams bought 1,200 acres in Strawberry Plains, turning the land into a thriving agricultural area.",
      "sourceSentenceIds": [
        25
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Strawberry_Plains%2C_Tennessee",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "During the Civil War, Union sympathizers targeted the Strawberry Plains railroad bridge in 1861, though the plot failed.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Strawberry_Plains%2C_Tennessee",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The bridge was ultimately destroyed in 1864 during an artillery duel between Confederate and Union forces.",
      "sourceSentenceIds": [
        27
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Strawberry_Plains%2C_Tennessee",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Through much of the 20th century, Strawberry Plains hosted a limestone quarry and an underground zinc mine.",
      "sourceSentenceIds": [
        30
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Strawberry_Plains%2C_Tennessee",
      "category": "history",
      "quality": "good"
    }
