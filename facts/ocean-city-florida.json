    },
    {
      "id": 4,
      "text": "Whether you’re looking for a base for fishing adventures or a calm spot to retreat after a day at the beach, Ocean City provides a low‑key Florida experience.",
      "sourceSentenceIds": [
        24
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://travelpal.ai/destinations/north-america/united-states/florida/ocean-city"
    },
    {
