  "facts": [
    {
      "id": 1,
      "text": "Alamo began as a trading post called Cageville, founded in 1846 by Isaac M. Johnson and Lycurgus Cage.",
      "sourceSentenceIds": [
        1,
        6,
        7
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Alamo%2C_Tennessee"
    },
    {
      "id": 2,
      "text": "In 1871 the town was renamed Alamo when Crockett County was formed to honor Davy Crockett’s stand at the Alamo.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Alamo%2C_Tennessee"
    },
    {
      "id": 3,
      "text": "Alamo serves as the county seat of Crockett County, established in late 1871.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Alamo%2C_Tennessee"
    },
    {
      "id": 4,
      "text": "The town was officially incorporated in 1911, nearly fifty years after its founding.",
      "sourceSentenceIds": [
        10,
        24
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Alamo%2C_Tennessee"
    },
    {
      "id": 5,
      "text": "Alamo sits at the crossroads of State Routes 54, 221, and 88, northwest of Jackson.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Alamo%2C_Tennessee"
    },
    {
      "id": 6,
      "text": "Alamo’s small‑town charm is highlighted by its Pre‑K through 6th grade elementary school and several churches.",
