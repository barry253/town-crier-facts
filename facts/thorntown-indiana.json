  "facts": [
    {
      "id": 1,
      "text": "Thorntown was officially founded by Cornelius Westfall, who platted the town on April 10, 1830.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Thorntown%2C_Indiana"
    },
    {
      "id": 2,
      "text": "The first permanent settlement began in 1827 when George Harness opened a trading post in the area.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Thorntown%2C_Indiana"
    },
    {
      "id": 3,
      "text": "When the railroad was completed here it signaled general improvement and secured Thorntown’s future.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://townofthorntown.com/history-of-thorntown"
    },
    {
      "id": 4,
      "text": "The Thorntown Public Library, listed on the National Register of Historic Places in 1986, still serves the community.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Thorntown%2C_Indiana"
    },
    {
      "id": 5,
      "text": "In 1977 Mildred Spencer donated the property that became the Thorntown Heritage Museum, preserving local artifacts.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://thorntownpl.org/heritage-museum/"
    },
    {
      "id": 6,
      "text": "Thorntown’s name translates from a former Native American village that once stood on the site.",
      "sourceSentenceIds": [
        23
