  "facts": [
    {
      "id": 1,
      "text": "Versailles was founded in 1671 by decree of Louis XIV, offering free lots to anyone who wanted to build a home.",
      "sourceSentenceIds": [
        13
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Versailles%2C_Yvelines",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "From 1682 to 1789, Versailles served as France’s de facto capital, hosting the royal court and government.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Versailles%2C_Yvelines",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The Palace’s gardens, designed by André Le Nôtre, are a UNESCO World Heritage Site and were the setting for the first scenes of the French Revolution.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.britannica.com/place/Versailles-France",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The Treaty of Versailles, signed in the palace after World I, ended the war and reshaped Europe.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Versailles%2C_Yvelines",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Versailles is served by Versailles‑Château‑Rive Gauche station, the closest stop to the palace and a favorite for tourists.",
      "sourceSentenceIds": [
        17
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Versailles%2C_Yvelines",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The town’s name comes from the Latin “versare,” meaning “to turn over,” a nod to the ploughed lands cleared before the city was built.",
      "sourceSentenceIds": [
        25
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Versailles%2C_Yvelines",
