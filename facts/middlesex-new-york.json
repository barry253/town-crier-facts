      "id": 1,
      "text": "Middlesex got its name in 1808, swapping the original 'Augusta' to avoid confusion with another town of the same name.",
      "sourceSentenceIds": [
        1,
        2
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Middlesex%2C_New_York",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Bare Hill, rising 865 feet, still shows the earthworks of a Seneca fort that once guarded the area.",
      "sourceSentenceIds": [
        5,
        14,
        15
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Middlesex%2C_New_York",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Five historic sites in Middlesex, including the Bates Cobblestone Farmhouse and Overackers Corners Schoolhouse, are on the National Register.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Middlesex%2C_New_York",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The first settlers arrived around 1789, long before the town was officially formed.",
      "sourceSentenceIds": [
        17
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Middlesex%2C_New_York",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Middlesex was established in 1796 while still part of Ontario County before Yates County was created in 1823.",
      "sourceSentenceIds": [
        18,
        19
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Middlesex%2C_New_York",
      "category": "history",
      "quality": "good"
    },
