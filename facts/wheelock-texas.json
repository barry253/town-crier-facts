  "facts": [
    {
      "id": 1,
      "text": "Founded in 1834 by Eleazer Louis Ripley Wheelock, a Texas Ranger captain and surveyor, Wheelock began as a frontier settlement.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/wheelock_texas",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "In 1837 the town was renamed Wheelock after Wheelock, Vermont, honoring founder’s grandfather Eleazar Wheelock, the Dartmouth College founder.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/wheelock_texas",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The Houston and Texas Central Railroad bypassed Wheelock in the 1860s, placing its station in nearby Hearne and redirecting regional growth.",
      "sourceSentenceIds": [
        24
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/wheelock_texas",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The Old Cavitt House, begun in 1836, served as a key stage stop between Nacogdoches and San Antonio and is now a Recorded Texas Historic Landmark.",
      "sourceSentenceIds": [
        23
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/wheelock_texas",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Wheelock became the county seat of Robertson County in 1850, a title it held for several decades.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.tshaonline.org/handbook/entries/wheelock-tx",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Located about fifteen miles northeast of Bryan, Wheelock is part of the Bryan–College Station Metropolitan Statistical Area.",
      "sourceSentenceIds": [
        28
