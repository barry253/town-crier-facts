      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The historic Chelsea Train Depot, rebuilt in 1880 in Victorian Stick Style, replaced an 1850 station destroyed by vandalism and fire.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Web source 1"
      ],
