  "facts": [
    {
      "id": 1,
      "text": "Scotland Neck was settled in 1722 by a colony of Scots Highlanders led by Lord Nairn, giving the town its name.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://carolana.com/NC/Towns/Scotland_Neck_NC.html",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The Wilmington and Weldon Railroad reached Scotland Neck between 1881‑1883, and a brick warehouse there helped the town grow.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://visitscotlandneck.com/area-history",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "During the Civil War, the town’s volunteer company, the Scotland Neck Mounted Riflemen, became Company G of the 3rd North Carolina Cavalry.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://visitscotlandneck.com/area-history",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The historic district of Scotland Neck includes the Hoffman‑Bowers‑Josey‑Riddick House and Trinity Church, both on the National Register.",
      "sourceSentenceIds": [
