  "facts": [
    {
      "id": 1,
      "text": "Busby, Montana, takes its name from Sheridan Busby, a homesteader who opened the first post office in 1904.",
      "sourceSentenceIds": [
        1,
        4,
        15
      ],
      "sourceLabels": [
        "Web source 1",
        "Wikipedia"
      ],
      "source": "https://www.visitmt.com/cities-towns/busby",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "In 1993, Busby became the site of a historic reburial for seven members of Chief Morning Star’s band killed in the 1879 Fort Robinson massacre.",
      "sourceSentenceIds": [
        5,
        6
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.visitmt.com/cities-towns/busby",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Busby hosts the Alvin Young Barn and Cabin Historic District, listed on the National Register of Historic Places.",
      "sourceSentenceIds": [
        17
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Busby%2C_Montana",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Busby sits on the Northern Cheyenne Indian Reservation along Rosebud Creek, a tributary of the Little Bighorn River.",
      "sourceSentenceIds": [
        14,
        22
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Busby%2C_Montana",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The Warriors Trail, a local nickname, gives access to battlefields of the Great Sioux War.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://discoveringmontana.com/towns/busby/",
      "category": "other",
      "quality": "poor",
      "qualityReason": "other"
    },
    {
