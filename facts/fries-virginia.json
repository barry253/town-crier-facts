      ],
      "source": "https://en.wikipedia.org/wiki/Fries%2C_Virginia",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town grew around Washington Mill, a cotton mill that operated from 1903 until its closure in 1989.",
      "sourceSentenceIds": [
