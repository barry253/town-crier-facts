    },
    {
      "id": 3,
      "text": "From the 1860s until 1912, Kiowa was known as Middle Kiowa before dropping the word when incorporated.",
      "sourceSentenceIds": [
        4,
        6,
        17
      ],
      "sourceLabels": [
        "Web source 1",
