      ],
      "source": "https://www.propertylistingsnorthwest.com/welcome/city-guides/everson-guide/",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Riverside Park on the Nooksack River was once a Fourth of July parade finish line with fireworks.",
      "sourceSentenceIds": [
        1
      ],
