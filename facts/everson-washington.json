      "id": 1,
      "text": "Everson was named after pioneer Ever Everson, whose 1871 homestead sparked the town’s founding.",
      "sourceSentenceIds": [
        2,
        3,
        4
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Everson%2C_Washington",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "When the Bellingham Bay and British Columbia Railroad arrived in 1890, Everson moved east and grew rapidly.",
      "sourceSentenceIds": [
        10,
        13
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.historylink.org/File/10775",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Everson Library hosts cedar‑weaving workshops and community breakfasts, keeping the town’s creative spirit alive.",
      "sourceSentenceIds": [
        16
      ],
      "sourceLabels": [
