  "facts": [
    {
      "id": 1,
      "text": "Ville Platte means \"Flat Town\" in French, a nod to its level terrain compared to the hilly north.",
      "sourceSentenceIds": [
        2,
        16
      ],
      "sourceLabels": [
        "Web source 2",
        "Wikipedia"
      ],
      "source": "https://www.downtowncajunband.nl/sitewillem/Acadiana%20Gateway/villeplt.htm.html"
    },
    {
      "id": 2,
      "text": "The town was founded in 1824 when Garand and Dr. secured the first two lots from William O'Donegan's estate.",
      "sourceSentenceIds": [
        19,
        20
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Ville_Platte%2C_Louisiana"
    },
    {
      "id": 3,
      "text": "Louisiana declared Ville Platte the Swamp Pop Capital of the World, home to JIN Records and stars like Rod Bernard.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.downtowncajunband.nl/sitewillem/Acadiana%20Gateway/villeplt.htm.html"
    },
    {
      "id": 4,
      "text": "The Louisiana Swamp Pop Museum, housed in a former railway station, chronicles the region’s musical legacy.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Ville_Platte%2C_Louisiana"
    },
    {
      "id": 5,
      "text": "Every April, Pine Prairie hosts a festival with Cajun cooking, a $1,000 giveaway, and the Boggy Bayou Olympics.",
