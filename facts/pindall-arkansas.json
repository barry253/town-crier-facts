  "facts": [
    {
      "id": 1,
      "text": "Pindall got its name in 1908 when the railroad switch, originally Hurricane Switch, was renamed to honor acting governor Xenophon Overton Pindall.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/pindall_arkansas",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The Big Hurricane Mine opened in 1903 about two miles west of Pindall, sparking zinc mining that operated through both World Wars.",
      "sourceSentenceIds": [
        15
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/pindall_arkansas",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "During the Great Depression, Pindall became a regional timber market, hosting a bean and tomato canning factory alongside general stores and machine shops.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/pindall_arkansas",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Before white settlers arrived, the area that is now Pindall was part of the Osage Indians' hunting grounds in the rugged Ozark terrain.",
      "sourceSentenceIds": [
