      "quality": "poor",
      "qualityReason": "location_description"
    },
    {
      "id": 3,
      "text": "Kino Springs lies on the western foothills of the Patagonia Mountains, with Mount Washington rising about four miles to the east.",
      "sourceSentenceIds": [
        14
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Kino_Springs%2C_Arizona",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The Mexican border is only about 1.5 miles south of Kino Springs, placing it very close to international waters.",
      "sourceSentenceIds": [
        15
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Kino_Springs%2C_Arizona",
