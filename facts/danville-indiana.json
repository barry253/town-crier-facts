    {
      "id": 1,
      "text": "Danville was founded in 1824, and its post office opened the following year.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Danville%2C_Indiana",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The Danville‑Center Township Public Library opened in 1903 with Andrew Carnegie funding and houses the Indiana Room for local history.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://danvillein.gov/department/division.php?structureid=166",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The Hendricks County Historical Museum sits in the 1866 former sheriff’s residence and jail, preserving pioneer life and the county’s jail cells.",
      "sourceSentenceIds": [
        4,
        6
      ],
      "sourceLabels": [
        "Web source 1",
        "Wikipedia"
      ],
      "source": "https://danvillein.gov/department/division.php?structureid=166",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Ellis Park, established in 1913, offers clay tennis courts, trails, a playground, and the historic Swinging Bridge.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://danvillein.gov/department/division.php?structureid=166",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Historic downtown Danville surrounds the courthouse square, now home to shops, restaurants, and galleries like Seize the Night Designs.",
      "sourceSentenceIds": [
        10,
        11
      ],
      "sourceLabels": [
        "Web source 1",
        "Web source 2"
      ],
      "source": "https://danvillein.gov/department/division.php?structureid=166",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Danville lies at the geographic center of Hendricks County, making it the county seat and a natural hub for the region.",
