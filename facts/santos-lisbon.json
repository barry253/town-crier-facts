  "facts": [
    {
      "id": 1,
      "text": "Santos, a Lisbon parish formed in 2012, merged the former parishes of São Mamede, São José and Coração de Jesus.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Santo_Ant%C3%B3nio%2C_Lisbon"
    },
    {
      "id": 2,
      "text": "The Ancient Art Museum, housed in a 17th‑century palace overlooking the river, is Portugal’s national gallery with works from the 12th to 19th centuries.",
      "sourceSentenceIds": [
        15,
        16
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.lisbonportugaltourism.com/guide/santos.html"
    },
    {
      "id": 3,
      "text": "The church of São Francisco de Paula survived the 1755 earthquake and still showcases baroque and neoclassical interiors.",
      "sourceSentenceIds": [
        19,
        22
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.lisbonportugaltourism.com/guide/santos.html"
    },
    {
      "id": 4,
      "text": "Santos lies on the lower part of the hill topped by Estrela, with Rua das Janelas Verdes as its main street.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.lisbonportugaltourism.com/guide/santos.html"
    },
    {
      "id": 5,
      "text": "Largo Vitorino Damásio features a marble fountain from 1755, crowned by a Venus sculpture flanked by Cupid and a dolphin.",
      "sourceSentenceIds": [
        13,
        14
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.lisbonportugaltourism.com/guide/santos.html"
    },
    {
      "id": 6,
      "text": "The historic hotel Janelas Verdes, an 18th‑century mansion, now offers a boutique stay overlooking the river.",
      "sourceSentenceIds": [
        28
      ],
