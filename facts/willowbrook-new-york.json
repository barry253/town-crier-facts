      "id": 1,
      "text": "In 1972, journalist Geraldo Rivera exposed appalling conditions at Willowbrook State School, sparking national outrage and reform.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 1"
      ],
