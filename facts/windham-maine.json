  "facts": [
    {
      "id": 1,
      "text": "Windham was incorporated June 12 1762 as New Marblehead Plantation, later renamed after Wymondham, England.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Windham%2C_Maine",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The Windham Historical Society, founded 1967, preserves local history and runs museums like the Old Grocery and Old Town Hall.",
      "sourceSentenceIds": [
        1,
        7,
        16
      ],
      "sourceLabels": [
        "Web source 2",
        "Web source 1"
      ],
      "source": "https://www.travellens.co/best-things-to-do-in-windham-me/",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "In 1888, the Maine Central Railroad leased the line through Windham, making the town a key rail hub until the early 20th century.",
      "sourceSentenceIds": [
        13
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Windham%2C_Maine",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The Old Town Hall, now a museum, once served as town meeting house, office, and school, reflecting Windham’s civic past.",
      "sourceSentenceIds": [
        24
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.travellens.co/best-things-to-do-in-windham-me/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The Parson Smith House, built 1764 by the town’s second minister, became a museum in 1952 and joined the National Register in 1973.",
      "sourceSentenceIds": [
        21,
        22,
        23
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.travellens.co/best-things-to-do-in-windham-me/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The Oriental Powder Company, once Maine’s largest gunpowder factory, supplied 25 % of the Union’s Civil War powder until 1905.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
