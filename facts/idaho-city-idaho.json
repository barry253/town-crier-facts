  "facts": [
    {
      "id": 1,
      "text": "Idaho City was founded in December 1862 as “Bannock” during the Boise Basin gold rush, the largest U.S. gold rush since California’s a dozen years earlier.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Idaho_City%2C_Idaho",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The Grand Lodge of Idaho, the state's first Masonic organization, was established in Idaho City in 1867.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Idaho_City%2C_Idaho",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "After the gold was extracted, visitors can still wander through well‑preserved 1860s mining structures and artifacts that capture Idaho’s frontier history.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://unitedstatesghosttowns.com/idaho-city-idaho-ghost-town/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Today, Idaho City’s economy depends mainly on hunting, fishing, and visits to historic sites such as the Boot Hill Cemetery.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Idaho_City%2C_Idaho",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The town’s wooden buildings sparked four major fires in 1865, 1867, 1868, and 1871, prompting repeated rebuilding efforts.",
