  "facts": [
    {
      "id": 1,
      "text": "Suisun City takes its name from Suisun Bay, itself named after the Suisun people, a Native group of the area.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Suisun_City%2C_California",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "In the late 1860s, Suisun City joined the First transcontinental railroad via the California Pacific line, later rerouted through Suisun Marsh to sit on the main overland route.",
      "sourceSentenceIds": [
        4,
        5
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Suisun_City%2C_California",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "After a devastating fire, citizens chose to rebuild and fund a waterworks system to better fight future fires.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Suisun_City%2C_California",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "A 1888 blaze destroyed downtown landmarks like the Robert Hotel and Crowley's saloon.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Suisun_City%2C_California",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The city borders 84,000-acre Suisun Marsh, the largest contiguous estuarine marsh on the west coast of North America.",
      "sourceSentenceIds": [
        12
      ],
