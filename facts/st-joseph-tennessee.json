      "category": "nature",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Little Bluewater Creek, a tributary of Bluewater Creek, flows right through the heart of St. Joseph.",
      "sourceSentenceIds": [
        11
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Saint_Joseph%2C_Tennessee",
