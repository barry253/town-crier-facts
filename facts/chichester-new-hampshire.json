  "facts": [
    {
      "id": 1,
      "text": "Chichester was granted as a township on May 20, 1727, by Lieutenant Governor John Wentworth, covering about 64 square miles in the Suncook Valley.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/chichester_new_hampshire",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town was named for Thomas Pelham-Holles, 1st Duke of Newcastle‑upon‑Tyne, who served as England’s Secretary of State for the Southern Department.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Chichester%2C_New_Hampshire",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Early settlement began in 1759 with pioneer Paul Morrill, and the community grew after the New Hampshire Turnpike opened in 1797.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/chichester_new_hampshire",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The Suncook Valley Railroad, completed in 1869, linked Chichester’s mills at Webster Mills and Pineground to broader markets.",
      "sourceSentenceIds": [
        11
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/chichester_new_hampshire",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The town’s original 64‑square‑mile area was reduced after the 1782 separation of its northern portion, which became Pittsfield.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Web source 2"
      ],
