  "facts": [
    {
      "id": 1,
      "text": "West Portsmouth sits where the Ohio and Scioto Rivers meet, a scenic spot highlighted by Scioto County’s natural beauty.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.portsmouth.org/travel-tourism/",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The Portsmouth Earthworks, a vast ceremonial center at the river confluence, includes horseshoe‑shaped enclosures and parallel‑walled roads.",
      "sourceSentenceIds": [
        4,
        5
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.portsmouth.org/travel-tourism/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Along the Ohio River, a 2,000‑foot floodwall in Portsmouth showcases Robert Dafford’s mural series telling the area’s history.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.portsmouth.org/travel-tourism/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Horseshoe Mound, part of the earthworks, earned a spot on the National Register of Historic Places for its archaeological significance.",
      "sourceSentenceIds": [
        11
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.portsmouth.org/travel-tourism/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Tremper Mound is famed for the discovery of Indian “stone pipe” artifacts that shed light on prehistoric trade routes.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.portsmouth.org/travel-tourism/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "A local building houses Clarence Holbrook Carter’s largest single collection of works and 10,000 prehistoric Native American objects.",
