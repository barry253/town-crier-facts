    {
      "id": 1,
      "text": "Condon's museum showcases artifacts from historic Swan Valley lodges, a Forest Service logging section, and an interactive map of homesteader claims.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://swanvalleystay.com/condon-montana-guide/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Condon's Upper Swan Valley Historical Society houses a meticulously recreated homesteader schoolroom with period desks and textbooks, an early settler kitchen, and a 1920s bedroom.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://swanvalleystay.com/condon-montana-guide/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Condon sits at 3,700 feet between the Swan Range and Mission Mountains, offering access to Montana's most spectacular wilderness while keeping its mountain community vibe.",
      "sourceSentenceIds": [
        15
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://swanvalleystay.com/condon-montana-guide/",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Condon's local weather station sits at the USFS Condon Work Center, providing up-to-date climate data for the surrounding Swan Valley.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Condon%2C_Montana",
      "category": "other",
      "quality": "poor",
      "qualityReason": "vague"
    },
    {
      "id": 5,
      "text": "Condon hosts a branch of the Missoula Public Library, offering residents access to regional books and community programs.",
      "sourceSentenceIds": [
