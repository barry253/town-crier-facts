  "facts": [
    {
      "id": 1,
      "text": "French explorers named Grosse Ile 'Big Island' in 1679, a name that still echoes across the Detroit River.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Grosse_Ile_Township%2C_Michigan",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Hennepin Point, the island’s northern tip, honors 17th‑century French explorer Father Louis Hennepin.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Grosse_Ile_Township%2C_Michigan",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "In 1873, the Canada Southern Bridge Company built a railroad linking Grosse Ile to the mainland, carrying passengers and freight.",
      "sourceSentenceIds": [
        19
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Grosse_Ile_Township%2C_Michigan",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The south‑end Wayne County Bridge, locally dubbed the 'Free Bridge,' lets cars, bikes, and pedestrians cross the Trenton Channel.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Grosse_Ile_Township%2C_Michigan",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Founded in 1959, the Grosse Ile Historical Society preserves the island’s past through museums, lighthouse care, and community events.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.gihistsoc.org/",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The GIHS safeguards the historic Grosse Ile Lighthouse, a beacon that once guided ships through the Detroit River.",
      "sourceSentenceIds": [
        16
      ],
      "sourceLabels": [
