  "facts": [
    {
      "id": 1,
      "text": "Aquashicola, pronounced ack-wa-SHIK-la, means “where we fish with the bush nets” in the local Indian language.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Aquashicola%2C_Pennsylvania",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The community sits at the crossroads of Little Gap Road and Forest Inn Road, just north of Aquashicola Creek and east of Palmerton.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Aquashicola%2C_Pennsylvania",
      "category": "other",
      "quality": "poor",
      "qualityReason": "location_description"
    },
    {
      "id": 3,
      "text": "A grist‑mill first opened in Aquashicola in 1806, operated by George Ziegenfuss Sr., and stayed in use until 1930.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Aquashicola%2C_Pennsylvania",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "In 1830 a tannery sprang up along Aquashicola Creek, only to be destroyed by fire in 1874.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Aquashicola%2C_Pennsylvania",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The first Evangelical Church in Aquashicola organized in 1844, followed by a United Methodist Church in 1866.",
      "sourceSentenceIds": [
        6,
        7
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Aquashicola%2C_Pennsylvania",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Aquashicola’s name changed from Millport to avoid confusion with another Millport in Potter County, a move made by postal workers.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
