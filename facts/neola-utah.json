  "facts": [
    {
      "id": 1,
      "text": "Founded in 1912, Neola's name is said to mean “last move” or “move no more” in a Native American language.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://uintahmeridian.com/community-guides/neola"
    },
    {
      "id": 2,
      "text": "Neola sits on land that was a Ute reservation until the federal government opened the Uintah Basin to homesteaders in 1905.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://openroadguide.com/marker/settlement-of-neola"
    },
    {
      "id": 3,
      "text": "The town of Neola was chosen as a site instead of another planned townsite called Packer, located two miles to the east.",
      "sourceSentenceIds": [
        16
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://uintahmeridian.com/community-guides/neola"
    },
    {
      "id": 4,
      "text": "When the plan for the town of Packer was scrapped, its log schoolhouse was moved to Neola.",
      "sourceSentenceIds": [
        17
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://uintahmeridian.com/community-guides/neola"
    },
    {
      "id": 5,
      "text": "The Neola Fourth of July Rodeo has been a cherished town tradition since 1932.",
      "sourceSentenceIds": [
        29
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://uintahmeridian.com/community-guides/neola"
    },
    {
      "id": 6,
      "text": "Neola's Fourth of July Celebration includes a parade and a patriotic program alongside the annual rodeo.",
      "sourceSentenceIds": [
        30
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://uintahmeridian.com/community-guides/neola"
    }
  ]
