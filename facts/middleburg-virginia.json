  "facts": [
    {
      "id": 1,
      "text": "Middleburg was founded in 1787 by Revolutionary War officer Leven Powell, who bought the land for just $2.50 an acre from Joseph Chinn.",
      "sourceSentenceIds": [
        13,
        26,
        27
      ],
      "sourceLabels": [
        "Web source 2",
        "Wikipedia"
      ],
      "source": "https://www.middleburgva.gov/163/About-Middleburg",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town’s name evolved from Chinn’s Crossroads to Powell Town, and finally to Middleburg, reflecting its position midway between Alexandria and Winchester.",
      "sourceSentenceIds": [
        28,
        29
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Middleburg%2C_Virginia",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The Red Fox Inn & Tavern, opened in 1728 as Chinn’s Ordinary, claims to be the oldest continually operated inn in the United States.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Middleburg%2C_Virginia",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The town’s historic downtown, listed on the National Register of Historic Places, preserves a 19th‑century core that attracts visitors year‑round.",
      "sourceSentenceIds": [
        25
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Middleburg%2C_Virginia",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Middleburg hosts the National Sporting Library, a 15,000‑square‑foot research center that publishes the online Thoroughbred Heritage archive.",
      "sourceSentenceIds": [
        18
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
