  "facts": [
    {
      "id": 1,
      "text": "Lake Medina Shores feels less like a plotted town and more like a collective deep breath, nestled along cypress‑lined shores of its namesake lake.",
      "sourceSentenceIds": [
        14
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.wikixm.com/us/tx/lake-medina-shores/overview",
      "category": "other",
      "quality": "poor",
      "qualityReason": "editorial_filler"
    },
    {
      "id": 2,
      "text": "The lake is the community’s compass, social calendar, and most cherished heirloom, guiding every gathering and outing in Lake Medina Shores.",
      "sourceSentenceIds": [
        15
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.wikixm.com/us/tx/lake-medina-shores/overview",
      "category": "other",
      "quality": "poor",
      "qualityReason": "editorial_filler"
    },
    {
      "id": 3,
      "text": "Life here is measured by the lap of waves and the turning of seasons, a sanctuary where the wider world softens into a tranquil beat.",
      "sourceSentenceIds": [
        16
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.wikixm.com/us/tx/lake-medina-shores/overview",
      "category": "other",
      "quality": "poor",
      "qualityReason": "editorial_filler"
    },
    {
      "id": 4,
      "text": "Neighbors keep an eye on the water level, sharing stories at the marina or convenience store about whether the lake is “full and happy” or sitting low.",
      "sourceSentenceIds": [
        19
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.wikixm.com/us/tx/lake-medina-shores/overview",
      "category": "other",
      "quality": "poor",
      "qualityReason": "editorial_filler"
    },
    {
      "id": 5,
      "text": "Volunteers organize shoreline clean‑ups, generations teach fishing in the same coves, and everyone is ready to lend a tool or a sympathetic ear.",
      "sourceSentenceIds": [
        21
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.wikixm.com/us/tx/lake-medina-shores/overview",
      "category": "other",
      "quality": "poor",
      "qualityReason": "editorial_filler"
    },
    {
      "id": 6,
      "text": "Each summer, the Shoreline Shindig turns the park into a tapestry of music, homemade crafts, and barbecue, celebrating another year together.",
