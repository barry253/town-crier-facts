  "facts": [
    {
      "id": 1,
      "text": "Idlewild was founded in 1912 as a resort marketed to African‑Americans during Jim Crow, earning the nickname “Black Eden.”.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.idlewild-michigan.org/history",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "In 1979 Idlewild earned a spot on the National Register of Historic Places, with its historic district boundary expanded in 2015.",
      "sourceSentenceIds": [
        23
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.idlewild-michigan.org/history",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The Idlewild Historic & Cultural Center opened in 2019, offering a self‑guided tour that includes the Flamingo Club and Paradise Club sites.",
      "sourceSentenceIds": [
        24
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.idlewild-michigan.org/history",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "From 1950 to 1959 the Fiesta Room at the Paradise Club was dubbed Michigan’s “Summer Apollo,” hosting singers like Aretha Franklin and The Four Tops.",
      "sourceSentenceIds": [
        14
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Idlewild%2C_Michigan",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "After the 1964 Civil Rights Act, Idlewild’s boom ended as the Chesapeake and Ohio Railway stopped serving the town, sparking a decline.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.idlewild-michigan.org/history",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Today Idlewild hosts annual festivals such as the Grier Music Fest and the Mid‑Michigan Idlewild Summer Soul Festival, keeping its cultural legacy alive.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.experienceidlewild.com/",
      "category": "culture",
      "quality": "good"
    }
