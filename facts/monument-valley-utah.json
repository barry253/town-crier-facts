      "quality": "good"
    },
    {
      "id": 2,
      "text": "The Goulding family’s trading post, opened in the 1920s, put Monument Valley on the map and sparked Hollywood interest.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 1"
      ],
