    {
      "id": 1,
      "text": "Østerbro lies just north of Copenhagen’s city centre, beyond the old Østerport gate that moved around 1700.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/%C3%98sterbro",
      "category": "other",
      "quality": "poor",
      "qualityReason": "location_description"
    },
    {
      "id": 2,
      "text": "The district hosts Denmark’s largest public park, Fælledparken, which offers sports fields, playgrounds, and dog‑off‑leash areas.",
      "sourceSentenceIds": [
        16
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.visitdenmark.com/denmark/plan-your-trip/osterbro-gdk957757",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Østerbro’s main street, Østerbrogade, runs from Trianglen to Svanemøllen station, a route traced by the historic S‑train line A.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://en.wikivoyage.org/wiki/Copenhagen/%C3%98sterbro",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The Little Mermaid statue, Copenhagen’s famed sea‑nymph, sits on the waterfront near Østerbro’s new beach park at Svanemøllen.",
      "sourceSentenceIds": [
        17
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.visitdenmark.com/denmark/plan-your-trip/osterbro-gdk957757",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Designer shops like Normann Copenhagen and Rambow line Østerbro’s boulevards, reflecting the area’s blend of upscale taste and everyday charm.",
      "sourceSentenceIds": [
        18
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.visitdenmark.com/denmark/plan-your-trip/osterbro-gdk957757",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Østerbro’s quiet cobblestone streets and tree‑lined avenues earned it a reputation as an upper‑middle‑class neighbourhood since the 1850s.",
