  "facts": [
    {
      "id": 1,
      "text": "Liberty Village got its name from Liberty Street, the first street convicts walked once freed.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Liberty_Village"
    },
    {
      "id": 2,
      "text": "In 1884 John Inglis and Company opened a factory that later produced heavy machinery, boilers, and electrical appliances.",
      "sourceSentenceIds": [
        9,
        18
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 2"
      ],
      "source": "https://en.wikipedia.org/wiki/Liberty_Village"
    },
    {
      "id": 3,
      "text": "In 1891 Massey-Harris built a factory that produced agricultural implements, later becoming Massey Ferguson.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Liberty_Village"
    },
    {
      "id": 4,
      "text": "During both world wars, Liberty Village factories manufactured armaments, bombs, and weapons, leaving soil pollution that still exists.",
      "sourceSentenceIds": [
        11
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Liberty_Village"
    },
    {
      "id": 5,
      "text": "The Toronto Carpet Factory Building on Mowat Avenue, built 1899–1920, originally made carpets and later produced coats and blankets for soldiers.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.libertyvillagebia.com/love-liberty/history-of-liberty-village"
    },
    {
      "id": 6,
      "text": "Today, former industrial sites like the Toronto Carpet Factory and the old Inglis factory have been converted into lofts, studios, and creative offices, blending past and present.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 2"
