  "facts": [
    {
      "id": 1,
      "text": "Cassopolis was laid out in 1831 and became the county seat the same year, cementing its early role in regional governance.",
      "sourceSentenceIds": [
        10,
        19,
        20
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.cassvanchamber.com/community-history",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The village’s name honors Lewis Cass, a New Hampshire native who served as a U.S. senator and later governor of Michigan.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Cassopolis%2C_Michigan",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "During the 1870s Cassopolis boasted a bustling commercial scene with dry goods, hardware, and even a machine shop and foundry.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.cassvanchamber.com/community-history",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Cassopolis was a key stop on the Underground Railroad, offering shelter to escaping slaves seeking freedom in the North and Canada.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Cassopolis%2C_Michigan",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The Cass District Library’s Local History Branch, located in Cassopolis, serves as a treasure trove for researchers exploring the area’s past.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.cassopolis-mi.us/community/history.php",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "In 1899 the new courthouse was completed, and a decade later Andrew Carnegie funded the construction of the La Grange Township Library in 1908.",
