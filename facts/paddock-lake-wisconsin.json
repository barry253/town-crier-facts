    {
      "id": 2,
      "text": "Three generations of the Paddock family arrived in Paddock Lake by covered wagon from New York in 1838.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://paddocklake.net/history/"
    },
    {
      "id": 3,
      "text": "The Paddock family settled between two bodies of water now known as Paddock and Hooker Lakes.",
      "sourceSentenceIds": [
        21
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://paddocklake.net/history/"
    },
    {
      "id": 4,
      "text": "The first school in the Paddock Lake area still stands today as a house next to Brass Ball Fruit Stand.",
      "sourceSentenceIds": [
        26,
        27
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://paddocklake.net/history/"
    },
    {
      "id": 5,
      "text": "The Huntoon family operated the Brass Ball Tavern, a favorite stop for farmers transporting goods to the Kenosha harbor.",
      "sourceSentenceIds": [
        28
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://paddocklake.net/history/"
    },
    {
      "id": 6,
      "text": "Paddock Lake is home to the regional high school, Westosha Central High School.",
