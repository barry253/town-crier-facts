  "facts": [
    {
      "id": 1,
      "text": "Maywood Park was originally a thick semi-old growth conifer forest located beneath the eastern shadow of Rocky Butte.",
      "sourceSentenceIds": [
        30
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://cityofmaywoodpark.com/about/history/"
    },
    {
      "id": 2,
      "text": "Columbia Realty purchased the triangular plot of land that makes up Maywood Park back in 1926.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Maywood_Park%2C_Oregon"
    },
    {
      "id": 3,
      "text": "Commonwealth Inc. designed Maywood Park as a subdivision modeled after the Laurelhurst and Eastmoreland neighborhoods of Portland.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Maywood_Park%2C_Oregon"
    },
    {
      "id": 4,
      "text": "The Great Depression delayed development of Maywood Park, but construction was largely completed by 1943 with about 400 homes.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Maywood_Park%2C_Oregon"
    },
    {
      "id": 5,
      "text": "Maywood Park was once so large that the city boundaries crossed over where Interstate 205 is located today.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Maywood_Park%2C_Oregon"
    },
    {
      "id": 6,
      "text": "Interstate 205 is built below grade as it passes by Maywood Park to help reduce noise for the community.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Maywood_Park%2C_Oregon"
    }
  ]
