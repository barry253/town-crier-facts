    },
    {
      "id": 2,
      "text": "The Cochise County Historical Society, founded in 1966 and incorporated in 1968, preserves the county’s past through research and publications.",
      "sourceSentenceIds": [
        1,
        4
      ],
      "sourceLabels": [
        "Web source 2",
