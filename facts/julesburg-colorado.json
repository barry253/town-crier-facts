  "facts": [
    {
      "id": 1,
      "text": "Julesburg was founded by half‑French Canadian, half‑Indian trapper Jules Beni, who opened a trading post and saloon at the Upper Crossing in 1858.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.legendsofamerica.com/julesburg-colorado/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town became a notorious “wickedest city in the West” as a rendezvous for traders, buffalo hunters, and desperados during the 1860s.",
      "sourceSentenceIds": [
        27
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.legendsofamerica.com/julesburg-colorado/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "In 1867 the Union Pacific Railroad made Julesburg the end‑of‑track town, where workers lived while the line pushed westward.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Julesburg%2C_Colorado",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Julesburg’s Union Pacific Depot, built in 1886 at the junction of the transcontinental and Denver branches, still stands as a historic landmark.",
      "sourceSentenceIds": [
        15
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.legendsofamerica.com/julesburg-colorado/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The town’s name honors Jules Beni, whose legacy lives on in the depot and the nearby Fort Rankin, once a military post.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.legendsofamerica.com/julesburg-colorado/",
