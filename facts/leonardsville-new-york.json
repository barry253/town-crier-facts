  "facts": [
    {
      "id": 1,
      "text": "Leonardsville got its name from Reuben Leonard, a local grocer who turned his shop into a convenient mail drop for residents.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Leonardsville%2C_New_York",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "In the 1820s, factories powered by a dam on the Unadilla River sprang up, turning the hamlet into a modest manufacturing hub.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Leonardsville%2C_New_York",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "A 1856 fire destroyed the grist, saw, and implement mills, but they were rebuilt the same year, showing the town’s resilience.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Leonardsville%2C_New_York",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Until the 1950s, Leonardsville sat on the Unadilla Valley Railway, hosting a milk station—now a recycling center—and a feed store.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Leonardsville%2C_New_York",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The Wheeler House Complex, a landmark of the town, earned a spot on the National Register of Historic Places in 1983.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Leonardsville%2C_New_York",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Although mainly in Madison County, a slice of Leonardsville extends into Otsego County, straddling two New York counties.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
