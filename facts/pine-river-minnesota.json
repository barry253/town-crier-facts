  "facts": [
    {
      "id": 1,
      "text": "Pine River was originally established as a logging and fur trading community.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://cityofpinerivermn.gov/?SEC=FBC0B865-2D9E-4219-8426-99A8ADE02B5F"
    },
    {
      "id": 2,
      "text": "Dakota Indians lived in the Pine River area until the Ojibwa began moving into the region in the early 1700s.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://cityofpinerivermn.gov/?SEC=FBC0B865-2D9E-4219-8426-99A8ADE02B5F"
    },
    {
      "id": 3,
      "text": "Barclay Avenue is named after George Barclay, the founder of Pine River who operated a local trading post.",
      "sourceSentenceIds": [
        3,
        7
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://cityofpinerivermn.gov/?SEC=FBC0B865-2D9E-4219-8426-99A8ADE02B5F"
    },
    {
      "id": 4,
      "text": "The Pine River Depot was built in 1895 and was later restored by community members after railroad service ended in 1985.",
      "sourceSentenceIds": [
        8,
        9
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://cityofpinerivermn.gov/?SEC=FBC0B865-2D9E-4219-8426-99A8ADE02B5F"
    },
    {
      "id": 5,
      "text": "Pine River was incorporated in 1901, though its post office began service earlier in 1877.",
