      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Cerro Navia is one of Santiago’s most densely populated communes, a fact that reflects its rapid urban growth in the 20th century.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
