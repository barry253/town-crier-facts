      "quality": "good"
    },
    {
      "id": 2,
      "text": "The commune was officially created on March 17, 1981, but only became independent in December 1984 after separating from Pudahuel and Las Barrancas.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Wikipedia"
