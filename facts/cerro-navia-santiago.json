      "quality": "poor",
      "qualityReason": "vague"
    },
    {
      "id": 4,
      "text": "In 2020 the municipality launched Plan 80, a person‑centred support model that earned the Zero Project Award in 2023 for its innovative approach.",
      "sourceSentenceIds": [
