  "facts": [
    {
      "id": 1,
      "text": "New Roads traces its roots to a 1719 trading post founded by French settlers, marking one of the earliest European footholds in the Mississippi Valley.",
      "sourceSentenceIds": [
        1,
        7,
        8
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1",
        "Web source 2"
      ],
      "source": "https://en.wikipedia.org/wiki/New_Roads%2C_Louisiana",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town’s name comes from a Spanish “new road” built in 1776 linking the Mississippi to the False River, a vital trade route.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.louisiana-destinations.com/new-roads.htm",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "In 1847, New Roads was chosen as the seat of Pointe Coupée Parish, and a courthouse was erected the same year.",
      "sourceSentenceIds": [
        4,
        6
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/New_Roads%2C_Louisiana",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The arrival of the railroad in 1898–99 spurred industrial growth, turning New Roads into a regional commercial hub.",
      "sourceSentenceIds": [
        14
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/New_Roads%2C_Louisiana",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The John James Audubon Bridge, completed in 2010, became the longest cable‑stayed bridge in the Western Hemisphere when its two spans connected.",
      "sourceSentenceIds": [
        18
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.louisiana-destinations.com/new-roads.htm",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "New Roads’ historic courthouse, built in 1847, still stands as a centerpiece of the town’s civic life and architectural heritage.",
