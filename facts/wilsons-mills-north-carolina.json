  "facts": [
    {
      "id": 1,
      "text": "Named after John Marshall Wilson, who ran a gristmill and cotton gin in the mid‑1800s, Wilson’s Mills grew when the North Carolina Railroad arrived in 1856.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.wilsonsmillsnc.org/about-wilsons-mills",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town’s official birth came with incorporation on August 2, 1996, though its roots trace back to 1868 when it was chartered to supply electricity to nearby mills.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.wilsonsmillsnc.org/about-wilsons-mills",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Wilson’s Mills sits just north of Smithfield, the county seat, and is bordered by the Neuse River, giving it a scenic rural feel.",
      "sourceSentenceIds": [
        4,
        5,
        25
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Wilson's_Mills%2C_North_Carolina",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The community hosts the award‑winning White Swan BBQ, a local culinary staple that draws visitors from across the county.",
      "sourceSentenceIds": [
        29
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.johnstoncountync.org/wilsons-mills/",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Wright Community Park offers seasonal events and recreational activities, making it a hub for family gatherings in the town.",
