      ],
      "source": "https://museumsdatabase.com/museums/view/23988",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The museum showcases artifacts, photographs, and documents that trace Buckland’s early days and surrounding communities.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://museumsdatabase.com/museums/view/23988",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The society also hosts lectures, exhibits, and reenactments each year, keeping history alive for residents.",
