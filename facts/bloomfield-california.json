  "facts": [
    {
      "id": 1,
      "text": "Bloomfield began in 1852 as a Gold Rush mining town originally called Humbug after the nearby creek.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/North_Bloomfield%2C_California",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "As the settlement grew, it was renamed Humbug City and later adopted the dignified name Bloomfield.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/North_Bloomfield%2C_California",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Hydraulic mining began in 1860 by the North Bloomfield Mining and Gravel Company, but ended in 1884 after the Woodruff v. North Bloomfield Gravel Mining Company lawsuit.",
      "sourceSentenceIds": [
        14,
        15,
        16
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/North_Bloomfield%2C_California",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Bloomfield sits inside Malakoff Diggins State Historic Park, a preserved Gold Rush mining area that now protects the town’s original structures.",
      "sourceSentenceIds": [
        5,
        6
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/North_Bloomfield%2C_California",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The town never recovered after railroads bypassed it, causing its growth to taper off.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Web source 1"
      ],
