    {
      "id": 1,
      "text": "Ames was founded on September 16, 1893, during the opening of the Cherokee Outlet.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Ames%2C_Oklahoma"
    },
    {
      "id": 2,
      "text": "Originally named Hoyle after a nearby creek, the town was later renamed for railroad official Henry S. Ames.",
      "sourceSentenceIds": [
        8,
        23
      ],
      "sourceLabels": [
        "Web source 1",
        "Wikipedia"
      ],
      "source": "https://www.okhistory.org/publications/enc/entry?entry=AM015"
    },
    {
      "id": 3,
      "text": "Ames is best known for being located within the boundary of a geological structure called the Ames crater.",
      "sourceSentenceIds": [
        25
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Ames%2C_Oklahoma"
    },
    {
      "id": 4,
      "text": "The Ames Astrobleme Museum is located in town to highlight the area's unique geological history.",
      "sourceSentenceIds": [
        26
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Ames%2C_Oklahoma"
    },
    {
      "id": 5,
      "text": "Oil was discovered within the Ames crater in 1991.",
