  "facts": [
    {
      "id": 1,
      "text": "Sleepy Hollow houses Philipsburg Manor House, a National Historic Landmark and living‑history museum that traces the village’s colonial roots.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Sleepy_Hollow%2C_New_York",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The village’s Old Dutch Church of Sleepy Hollow and Philipsburg Manor House are both National Historic Landmarks, anchoring its historic character.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Sleepy_Hollow%2C_New_York",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Sleepy Hollow Cemetery, Patriot's Park, the Edward Harden Mansion, Philipse Manor Railroad Station, Tarrytown Light, and the Old Croton Aqueduct State Historic Park all sit on the National Register of Historic Places.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Sleepy_Hollow%2C_New_York",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Washington Irving’s 1820 short story “The Legend of Sleepy Hollow” set its famous characters—Ichabod Crane and the Headless Horseman—in this very village.",
      "sourceSentenceIds": [
        18
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Sleepy_Hollow%2C_New_York",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Originally incorporated as North Tarrytown, the village adopted the name Sleepy Hollow in 1996, echoing the Dutch term “Slapershaven” or “Sleepers’ Harbor.”",
      "sourceSentenceIds": [
        23
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Sleepy_Hollow%2C_New_York",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "An automotive factory opened on the Sleepy Hollow waterfront in 1900, marking the village’s transition from a quiet settlement to an industrial hub.",
      "sourceSentenceIds": [
        30
      ],
