  "facts": [
    {
      "id": 1,
      "text": "Beaver Bay was founded in 1856 by German immigrants, making it one of the earliest settlements on Minnesota’s North Shore.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://lovinlakecounty.com/discover/lake-county-communities/beaver-bay/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "In 1866, Beaver Bay was named Lake County’s seat, a status it held for many decades.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://bayareahistoricalsociety.com/stories/history-of-beaver-bay/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Beaver Bay holds the distinction of being the oldest settlement on the North Shore of Lake Superior.",
      "sourceSentenceIds": [
        11
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Beaver_Bay%2C_Minnesota",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Every year, the community hosts the John Beargrease Dog Sled Race, a tradition that celebrates local heritage.",
      "sourceSentenceIds": [
        13
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Beaver_Bay%2C_Minnesota",
      "category": "culture",
      "quality": "good"
    },
    {
