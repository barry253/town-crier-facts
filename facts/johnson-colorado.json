      "id": 1,
      "text": "Johnson Village sits on the west side of the Arkansas River, where the river is bridged by U.S. Highway 24.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
