      "quality": "poor",
      "qualityReason": "location_description"
    },
    {
      "id": 3,
      "text": "Johnson Village’s economy thrives on pass‑through traffic, especially tourists who come for whitewater rafting on the Arkansas River.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
