  "facts": [
    {
      "id": 1,
      "text": "Vernon Hills began as a 200‑acre farm in 1857, founded by Richard Theodore Freese, Ron Freese, Nathan Kowitt, and Jim Carswell.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Vernon_Hills%2C_Illinois",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The village officially incorporated on June 16, 1958, with just 123 residents and 125 houses in a single subdivision built by Quinn Hogan and Barney Loeb.",
      "sourceSentenceIds": [
        12,
        4
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Vernon_Hills%2C_Illinois",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "On July 10, 2010, Vernon Hills opened its first full‑service library, a 20,000‑square‑foot building that includes a high‑tech teen area and a computer lab.",
      "sourceSentenceIds": [
        6,
        7,
        8,
        9
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Vernon_Hills%2C_Illinois",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The village hosts a Metra station on the North Central Service line, offering weekday rush‑hour trains between Antioch and Chicago’s Union Station.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Vernon_Hills%2C_Illinois",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Zebra Technologies, a global leader in barcode printers used by over 90 percent of Fortune 500 companies, is headquartered in Vernon Hills.",
