  "facts": [
    {
      "id": 1,
      "text": "Martineztown, one of Albuquerque’s oldest neighborhoods, was named after the founding Martín family and dates back to the 1700s.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://digitalharvest.io/martineztown-southwest-albuquerque/"
    },
    {
      "id": 2,
      "text": "The neighborhood sits on the historic El Camino Real de Tierra Adentro, the 1,600‑mile trail that linked Mexico City to Santa Fe.",
      "sourceSentenceIds": [
        5,
        14
      ],
      "sourceLabels": [
        "Web source 1",
        "Web source 1"
      ],
      "source": "https://www.nps.gov/places/martineztown.htm"
    },
    {
      "id": 3,
      "text": "Older adobe‑style homes and historic sites pepper Martineztown, giving drivers a glimpse of its rich architectural heritage.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://digitalharvest.io/martineztown-southwest-albuquerque/"
    },
    {
      "id": 4,
      "text": "Martineztown’s central location made it a natural hub for travelers and traders along the El Camino Real before Albuquerque expanded.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.nps.gov/places/martineztown.htm"
    },
    {
      "id": 5,
      "text": "The neighborhood’s streets echo the path once used by Indigenous groups, later evolving into the modern Interstate 25 corridor.",
      "sourceSentenceIds": [
        23
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.nps.gov/places/martineztown.htm"
    },
    {
      "id": 6,
      "text": "Martineztown’s history reflects continuous habitation since its founding as an outpost in 1706, long before Albuquerque’s formal establishment.",
      "sourceSentenceIds": [
        3,
        8
      ],
