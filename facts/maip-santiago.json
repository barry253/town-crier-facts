  "facts": [
    {
      "id": 1,
      "text": "The 1818 Battle of Maipú, where Chile’s independence was sealed, unfolded on the plains that now host Maipú’s Plaza de Armas.",
      "sourceSentenceIds": [
        2,
        6,
        23
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Maip%C3%BA%2C_Chile",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Maipú derives from the Mapudungun words maypun and we, meaning ‘place that works the land’.",
      "sourceSentenceIds": [
        3,
        21
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://academia-lab.com/encyclopedia/maipu-chile/",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The Basilica of Our Lady of Mount Carmel, built on the historic battle ground, is a pilgrimage shrine that crowns Maipú’s skyline.",
      "sourceSentenceIds": [
        5,
        9
      ],
      "sourceLabels": [
        "Web source 1",
        "Web source 2"
      ],
      "source": "https://academia-lab.com/encyclopedia/maipu-chile/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Just outside Santiago, Maipú’s vineyards and century‑old bodegas offer wine tastings amid olive groves that echo the region’s winemaking heritage.",
      "sourceSentenceIds": [
        7,
        8
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.traveldojo.com/maipu/",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Maipú’s Plaza de Armas, 12 km from downtown Santiago, doubles as a civic square and the symbolic heart of Chile’s fight for freedom.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://academia-lab.com/encyclopedia/maipu-chile/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Maipú was officially founded on February 16, 1821, shortly after the decisive battle that secured Chile’s independence.",
      "sourceSentenceIds": [
        2
      ],
