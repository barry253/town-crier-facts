  "facts": [
    {
      "id": 1,
      "text": "Russellville was laid out in 1817 by pioneer Russell Shaw, who named the village after himself.",
      "sourceSentenceIds": [
        2,
        3
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Russellville%2C_Ohio",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The Johnson Carriage Factory, built in 1850, stands as a reminder of the village’s mid‑19th‑century industrial heritage.",
      "sourceSentenceIds": [
        4,
        6
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/russellville_ohio",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Shaw donated land for a public square and cemetery, shaping Russellville’s early civic layout.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/russellville_ohio",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Russellville emerged during Ohio’s frontier expansion, as settlers from New York, Virginia, and Pennsylvania claimed fertile farmland in the early 1800s.",
      "sourceSentenceIds": [
        28,
        29
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/russellville_ohio",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The village’s development in the late 19th century made it a hub for agriculture and local trade within Jefferson Township.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/russellville_ohio",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Russellville Elementary School, the only school in the village, serves about 480 pupils with 28 full‑time staff.",
      "sourceSentenceIds": [
        25
