      "id": 1,
      "text": "Hebbronville sprang to life in 1883 when the Texas‑Mexican Railway Company built a line through the area.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Hebbronville%2C_Texas",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town’s name came from a flatcar that carried the old Peñitas station 1½ miles west to its new spot.",
      "sourceSentenceIds": [
        1,
        2
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Hebbronville%2C_Texas",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Hebbronville sits on land that once formed part of the early Las Noriecitas ranch, one of the first in the region.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Hebbronville%2C_Texas",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Summers in Hebbronville are blisteringly hot, with 152 days each year reaching at least 90 °F (32 °C).",
      "sourceSentenceIds": [
        23
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Hebbronville%2C_Texas",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The record high temperature here was 118 °F (47.8 °C) on July 9, 2009, a blistering peak for the town.",
