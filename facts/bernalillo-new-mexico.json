    },
    {
      "id": 3,
      "text": "The town lies in the Rio Grande Valley of the Albuquerque Basin on the east bank of the Rio Grande.",
      "sourceSentenceIds": [
        15
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Bernalillo%2C_New_Mexico"
    },
    {
      "id": 4,
      "text": "Bernalillo hosts the New Mexico Wine Festival each Labor Day, celebrating a wine heritage that dates back to the 1620s.",
      "sourceSentenceIds": [
