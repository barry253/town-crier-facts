      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The area that is now Lake Arrowhead was first inhabited by the Yuhaaviatam clan of the Serrano people, known as the “People of the Pines.”.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
