      "category": "people",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Lake Arrowhead Village serves as the town’s commercial hub, featuring boutiques, restaurants, banks, a post office, and a supermarket.",
      "sourceSentenceIds": [
        21
      ],
      "sourceLabels": [
        "Wikipedia"
