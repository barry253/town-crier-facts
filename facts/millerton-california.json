  "facts": [
    {
      "id": 1,
      "text": "Millerton began as Rootville in 1852, a mining boomtown that later grew into the county seat of Fresno County.",
      "sourceSentenceIds": [
        1,
        4
      ],
      "sourceLabels": [
        "Web source 1",
        "Wikipedia"
      ],
      "source": "https://www.yourcentralvalley.com/digital-enterprise/the-forgotten-underwater-town-at-the-bottom-of-a-california-lake/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Cassady’s 1851 placer mine, later called Cassady’s Bar, sparked the first wave of gold seekers along the San Joaquin River.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Millerton%2C_Madera_County%2C_California",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "A nearby Army post, Fort Miller, was built a mile upriver and helped secure the settlement, prompting its renaming to Millerton.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Millerton%2C_Madera_County%2C_California",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "In 1872 the Central Pacific Railroad opened a station on a farm owned by Anthony Easterby, turning Millerton into a rail hub.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Millerton%2C_Madera_County%2C_California",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Today the town lies beneath Millerton Lake, its former streets now submerged after the 1942 dam construction.",
