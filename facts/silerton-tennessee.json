  "facts": [
    {
      "id": 1,
      "text": "Silerton grew around a railroad depot named after the Siler family, who owned the store, the doctor, and the land.",
      "sourceSentenceIds": [
        1,
        2
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Silerton%2C_Tennessee",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "In 1923, Silerton was officially incorporated by a private act of the state legislature.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Silerton%2C_Tennessee",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The town’s name changed from Silers to Silerton to avoid confusion with nearby Serles, a community fifteen miles down the track.",
      "sourceSentenceIds": [
        27
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://hardemancounty.org/about-us/cities-and-towns/silerton",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Silerton hosts an old‑fashioned Fourth of July celebration with homemade ice cream, box lunches, a parade, and fireworks that draws hundreds each year.",
      "sourceSentenceIds": [
        24
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://hardemancounty.org/about-us/cities-and-towns/silerton",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "A frame home built by one of the original Siler brothers in the late 1800s still stands and is used as a residence today.",
      "sourceSentenceIds": [
