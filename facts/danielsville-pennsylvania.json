  "facts": [
    {
      "id": 1,
      "text": "Danielsville got its current name on June 7 1855, honoring Charles B., after a brief stint as Wales.",
      "sourceSentenceIds": [
        4,
        6,
        18
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/danielsville_pennsylvania",
      "category": "etymology",
      "quality": "poor",
      "qualityReason": "dropped_surname_no_wiki_source"
    },
    {
      "id": 2,
      "text": "Lehigh Township, where Danielsville sits, was surveyed in 1735 and settled by Palatine Germans in the mid‑1700s.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/danielsville_pennsylvania",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Tracks from the Blue Ridge Traction Company’s trolley line, once a lifeline to Walnutport, still echo through Danielsville.",
      "sourceSentenceIds": [
        8,
        21,
        22
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.lehightownshiphistoricalsociety.org/danielsville.html",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Herman’s Store, a historic shop, has been reborn as the cozy Filbert Bed & Breakfast.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.lehightownshiphistoricalsociety.org/danielsville.html",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Edgemont Park, once a bustling early‑20th‑century amusement spot, drew families via the trolley to picnics and rides.",
      "sourceSentenceIds": [
