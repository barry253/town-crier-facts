    },
    {
      "id": 2,
      "text": "Lehigh Township, where Danielsville sits, was surveyed in 1735 and settled by Palatine Germans in the mid‑1700s.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/danielsville_pennsylvania"
    },
    {
      "id": 3,
      "text": "Tracks from the Blue Ridge Traction Company’s trolley line, once a lifeline to Walnutport, still echo through Danielsville.",
      "sourceSentenceIds": [
        8,
        21,
        22
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.lehightownshiphistoricalsociety.org/danielsville.html"
    },
    {
      "id": 4,
      "text": "Herman’s Store, a historic shop, has been reborn as the cozy Filbert Bed & Breakfast.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
