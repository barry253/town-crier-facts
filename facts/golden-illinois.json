  "facts": [
    {
      "id": 1,
      "text": "Golden was originally laid out as Keokuk Junction in 1866 before becoming the village we know today.",
      "sourceSentenceIds": [
        13
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Golden%2C_Illinois",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "In 1881 the village adopted the name Golden, probably after a local Hotel Golden that once stood there.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Golden%2C_Illinois",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Two railroads crossed in the 1850s, turning the spot into a transfer point called Keokuk Junction.",
      "sourceSentenceIds": [
        5,
        6,
        7,
        8
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://goldenwindmill.org/local-resources/",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The Prairie Mills Windmill, a Dutch‑style landmark, stands in Golden and can be seen at sunrise, sunset, and night.",
      "sourceSentenceIds": [
        1,
        4,
        26,
        28
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://goldenwindmill.org/local-resources/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Golden lies roughly 30 miles northeast of Quincy, the county seat of Adams County.",
