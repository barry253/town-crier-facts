      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Caldwell%2C_Ohio",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Caldwell boasts the Caldwell Public Library, the only public lending library in Noble County.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
