  "facts": [
    {
      "id": 1,
      "text": "Caldwell, Ohio, was founded in 1857 and named after Joseph and Samuel Caldwell, the original owners of the town site.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Caldwell%2C_Ohio"
    },
    {
      "id": 2,
      "text": "The Pennsylvania Railroad reached Caldwell in the 1870s, linking the village to eastern and northern markets along the Great Lakes.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Caldwell%2C_Ohio"
    },
    {
      "id": 3,
      "text": "Caldwell boasts the Caldwell Public Library, the only public lending library in Noble County.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Caldwell%2C_Ohio"
    },
    {
      "id": 4,
      "text": "Caldwell serves as the county seat of Noble County, Ohio, anchoring the region’s administrative center.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Caldwell%2C_Ohio"
    },
    {
      "id": 5,
      "text": "The village sits along the West Fork of Duck Creek, about 23 miles north of Marietta.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Caldwell%2C_Ohio"
    },
    {
      "id": 6,
      "text": "Our rich Appalachian history is spelled out in museums, while parks and lakes offer plentiful outdoor recreation.",
      "sourceSentenceIds": [
