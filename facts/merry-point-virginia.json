  "facts": [
    {
      "id": 1,
      "text": "Merry Point’s ferry has crossed the Western Branch of the Corrotoman River since 1847, still carrying two cars today.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/merry_point_virginia",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The community’s name echoes its early role as a river landing, where steamboats docked from the 19th to early 20th century.",
      "sourceSentenceIds": [
        16,
        17
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/merry_point_virginia",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Verville, a plantation house built around 1742, sits nearby and was listed on the National Register of Historic Places in 1987.",
      "sourceSentenceIds": [
        6,
        7,
        10,
        11
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 2"
      ],
      "source": "https://en.wikipedia.org/wiki/Merry_Point%2C_Virginia",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Merry Point’s flat terrain rises from sea level to about 85 feet inland, making it prone to tidal flooding from the Rappahannock River.",
      "sourceSentenceIds": [
        21,
        22,
        23
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/merry_point_virginia",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "In the early 1900s, a Chilton and Derickson Canning Factory employed up to 100 workers processing seafood, highlighting the town’s oystering heritage.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/merry_point_virginia",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The area was originally inhabited by the Rappahannock Indian Tribe, an Algonquian group within the Powhatan Chiefdom, before European settlement.",
