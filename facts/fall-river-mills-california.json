  "facts": [
    {
      "id": 1,
      "text": "Fall River Mills takes its name from the nearby Fall River, a stream with notable drops that inspired the town’s early settlers.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Fall_River_Mills%2C_California",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town’s identity grew around sawmills that operated for decades, turning the surrounding forests into lumber for the region.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.wisdomlib.org/cities/fall-river-mills-119161",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Bing Crosby helped raise funds to build and furnish the town’s only hospital, a landmark of community care in the 20th century.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Fall_River_Mills%2C_California",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "From every direction, the valley is framed by mountains, with Mount Shasta and Mount Lassen visible from almost any street.",
      "sourceSentenceIds": [
        15
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Fall_River_Mills%2C_California",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Local farms produce a surprising mix of crops, including wild rice, garlic, mint, lavender, and alfalfa, reflecting the valley’s fertile soil.",
      "sourceSentenceIds": [
        13
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Fall_River_Mills%2C_California",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Established near the confluence of the Pit River and Fall River, the area attracted settlers who used the water power for early industry.",
