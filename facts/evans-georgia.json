  "facts": [
    {
      "id": 1,
      "text": "Evans takes its name from General Clement A. Evans, a 19th‑century soldier, lawyer, minister, statesman, and author who died in 1911.",
      "sourceSentenceIds": [
        1,
        6
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 2"
      ],
      "source": "https://en.wikipedia.org/wiki/Evans%2C_Georgia"
    },
    {
      "id": 2,
      "text": "Although Appling remains the legal county seat, Evans functions as Columbia County’s de facto capital.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Evans%2C_Georgia"
    },
    {
      "id": 3,
      "text": "The Columbia County Government Center, its annex, and the courthouse annex all sit in Evans, making it the hub of county administration.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Evans%2C_Georgia"
    },
    {
      "id": 4,
      "text": "Evans sits on the Savannah River, which marks the border between Georgia and South Carolina to the northeast.",
      "sourceSentenceIds": [
        11
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Evans%2C_Georgia"
    },
    {
      "id": 5,
      "text": "The Euchee Creek Greenway, a developing bike and pedestrian trail, currently offers a two‑mile southern segment and a five‑mile northern stretch.",
      "sourceSentenceIds": [
        25,
        26,
        27
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Evans%2C_Georgia"
    },
    {
      "id": 6,
      "text": "Evans hosts 17 public elementary schools, including Baker Place, Blue Ridge, and Greenbrier, all part of the Columbia County Public School System.",
