      "quality": "good"
    },
    {
      "id": 3,
      "text": "The neighborhood’s historic rowhouses along Vanderbilt, Underhill, Carlton, and Washington blend cafés and new condos, keeping its graceful density.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.cityneighborhoods.nyc/prospect-heights",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Prospect Heights hosts the Brooklyn Central Library at Grand Army Plaza, a landmark opened in 1941.",
      "sourceSentenceIds": [
        16
