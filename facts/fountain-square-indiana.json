    {
      "id": 1,
      "text": "Fountain Square earned its name from the series of fountains that have marked the intersection of Virginia Avenue, East Prospect, and Shelby Streets.",
      "sourceSentenceIds": [
        22,
        20
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 2"
      ],
      "source": "https://en.wikipedia.org/wiki/Fountain_Square%2C_Indianapolis",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The neighborhood was the last stop on Indianapolis's Virginia Avenue streetcar line, making it a historic transportation hub.",
      "sourceSentenceIds": [
        10,
        12
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Fountain_Square%2C_Indianapolis",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "In the late 1990s, historic preservation efforts revived Fountain Square, turning it into a vibrant commercial center.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Fountain_Square%2C_Indianapolis",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Fountain Square Theatre opened in 1928 as a 1,500‑seat motion‑picture and vaudeville house, still a landmark today.",
      "sourceSentenceIds": [
        19
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Fountain_Square%2C_Indianapolis",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The area once hosted a diverse mix of immigrants: Irish near South Street, Eastern and Southern Europeans, and Appalachian settlers during WWII.",
      "sourceSentenceIds": [
        1,
        4,
        5
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Fountain_Square%2C_Indianapolis",
      "category": "people",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Fountain Square sits 1.5 miles southeast of downtown Indianapolis and contains three National Register historic districts: Laurel & Prospect, State & Prospect, and Virginia Avenue.",
