  "facts": [
    {
      "id": 1,
      "text": "Roaring Spring received its name from a spring that once roared and could be heard a mile away.",
      "sourceSentenceIds": [
        20
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.blairhistory.org/roaring-spring.html",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The borough’s historic core still houses the Roaring Spring Blank Book Company and the Roaring Spring Water Bottling Company, both dating back to the 19th century.",
      "sourceSentenceIds": [
        3,
        4
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 2"
      ],
      "source": "https://en.wikipedia.org/wiki/Roaring_Spring%2C_Pennsylvania",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "A grist mill powered by the spring water operated there since at least the 1760s, long before the paper mill that sparked the town’s growth.",
      "sourceSentenceIds": [
        29,
        30
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Roaring_Spring%2C_Pennsylvania",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The Roaring Spring Historic District earned a spot on the National Register of Historic Places in 1995, preserving its 19th‑century character.",
      "sourceSentenceIds": [
        26
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Roaring_Spring%2C_Pennsylvania",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The town’s restored 1942 PRR N5C caboose and the only remaining train station in Blair County sit side‑by‑side, a reminder of its rail heritage.",
      "sourceSentenceIds": [
        23
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.roaringspring.net/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Roaring Spring was officially organized in 1887, a decade after the first paper mill opened, marking its transition from hamlet to borough.",
      "sourceSentenceIds": [
        28
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Roaring_Spring%2C_Pennsylvania",
      "category": "history",
      "quality": "good"
    }
