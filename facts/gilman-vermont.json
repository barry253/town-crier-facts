  "facts": [
    {
      "id": 1,
      "text": "Gilman is a quiet mill town located on the banks of the Connecticut River in the scenic Northeast Kingdom of Vermont.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.gilmanhistory.org/"
    },
    {
      "id": 2,
      "text": "The village of Gilman was originally farmland owned by Stephen Thompson in the late nineteenth century.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.gilmanhistory.org/"
    },
    {
      "id": 3,
      "text": "The Dalton Power Company purchased land in Gilman in 1896 to build a dam and a pulp mill for paper production.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.gilmanhistory.org/"
    },
    {
      "id": 4,
      "text": "Early mill workers in Gilman used water wheels and large stone grinders to turn wood pulp into groundwood for newsprint.",
      "sourceSentenceIds": [
        26
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.gilmanhistory.org/"
    },
    {
      "id": 5,
      "text": "The Boston Post was once one of the most important newsprint customers for the paper mills in Gilman.",
      "sourceSentenceIds": [
        30
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.gilmanhistory.org/"
    },
    {
      "id": 6,
      "text": "Some of the original granite stones used for grinding wood pulp still remain on the Gilman mill site.",
      "sourceSentenceIds": [
        27
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.gilmanhistory.org/"
    }
  ]
