      ],
      "source": "https://unitedstatesghosttowns.com/manchester-california-ghost-town/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Manchester sits 5 miles north of Point Arena along California State Route 1, just 1.5 miles inland from the Pacific Ocean.",
      "sourceSentenceIds": [
