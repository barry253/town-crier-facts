  "facts": [
    {
      "id": 1,
      "text": "Barrackville was founded in 1767 by William “Indian Billy” Ice and named after settler John Barrack.",
      "sourceSentenceIds": [
        1,
        6
      ],
      "sourceLabels": [
        "Web source 1",
        "Wikipedia"
      ],
      "source": "https://wvexplorer.com/communities/cities-towns/barrackville-west-virginia/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town’s iconic Barrackville Covered Bridge, built in 1853, is the second‑oldest covered bridge in West Virginia and spans Buffalo Creek.",
      "sourceSentenceIds": [
        26
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://wvexplorer.com/communities/cities-towns/barrackville-west-virginia/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "In the early 1900s, Barrackville became a coal hub when the Jamison Coal & Coke Company built a mining camp for its workers.",
      "sourceSentenceIds": [
        23,
        24
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://wvexplorer.com/communities/cities-towns/barrackville-west-virginia/",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The community sits two miles northwest of Fairmont in the Monongahela Valley, placing it near the West Fork River watershed.",
      "sourceSentenceIds": [
        27,
        28
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://wvexplorer.com/communities/cities-towns/barrackville-west-virginia/",
      "category": "other",
      "quality": "poor",
      "qualityReason": "location_description"
    },
    {
      "id": 5,
      "text": "Barrackville was officially incorporated on January 25, 1968, nearly two centuries after its founding.",
      "sourceSentenceIds": [
