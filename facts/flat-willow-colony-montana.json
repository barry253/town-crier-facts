  "facts": [
    {
      "id": 1,
      "text": "Flat Willow Colony takes its name from the willows that line Flatwillow Creek, giving the area a distinctive natural landmark.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.mtmemory.org/nodes/view/127721",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Around 1880, Pike Landusky and Jo Hamilton opened a general store at Flatwillow Crossing, drawing business from nearby Fort Maginnis and gold miners in the Judith Mountains.",
      "sourceSentenceIds": [
        18
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.mtmemory.org/nodes/view/127721",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The community historically served as a market town for neighboring homesteaders and ranchers, supplying goods and services to the surrounding frontier.",
      "sourceSentenceIds": [
        15
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.mtmemory.org/nodes/view/127721",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Flat Willow Colony sits at an elevation of 3,225 feet, offering a high‑altitude prairie landscape typical of central Montana.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.mtmemory.org/nodes/view/127721",
      "category": "other",
      "quality": "poor",
      "qualityReason": "vague"
    },
    {
      "id": 5,
      "text": "Designated as a census‑designated place, Flat Willow Colony has no governmental functions, reflecting its status as a community rather than a municipality.",
