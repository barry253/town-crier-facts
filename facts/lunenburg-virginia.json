  "facts": [
    {
      "id": 1,
      "text": "Lunenburg County was formed May 1 1746 from Brunswick County, and later gave land to nine other counties – the “Mother of Counties.”.",
      "sourceSentenceIds": [
        10,
        30
      ],
      "sourceLabels": [
        "Web source 1",
        "Wikipedia"
      ],
      "source": "https://lunenburgva.gov/government/county_administration/county_history.php",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The county seat, Lunenburg, hosts a National Historic Landmark: the Lunenburg County Courthouse, one of only four Jeffersonian courthouses in Virginia.",
      "sourceSentenceIds": [
        2,
        13
      ],
      "sourceLabels": [
        "Web source 2",
        "Web source 1"
      ],
      "source": "https://lunenburgva.com/lunenburg-county/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Nicknamed “The Old Free State,” Lunenburg declared it would secede if Virginia joined the Confederacy during the Civil War buildup.",
      "sourceSentenceIds": [
        3,
        11
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Lunenburg_County%2C_Virginia",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The courthouse’s red clay bricks were hand‑kilned from local soil, reflecting the abundant red clay that shaped many antebellum homes.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://lunenburgva.gov/government/county_administration/county_history.php",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Lunenburg’s downtown features historic railroad heritage, with shops and restaurants echoing its past as a rail hub.",
