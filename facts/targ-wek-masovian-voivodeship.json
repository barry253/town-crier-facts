  "facts": [
    {
      "id": 1,
      "text": "Targówek first appeared in the 15th century as a village known for its marketplace, giving the area its name.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.trawellino.com/destinations/poland/mazovia_targowek"
    },
    {
      "id": 2,
      "text": "Mary Magdalene church, built in the early 20th century, blends Neo‑Gothic and Romanesque styles and remains a local landmark.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.trawellino.com/destinations/poland/mazovia_targowek"
    },
    {
      "id": 3,
      "text": "Bródno Park, one of Warsaw’s largest green spaces, offers walking trails, ponds, and a historic 19th‑century cemetery.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.trawellino.com/destinations/poland/mazovia_targowek"
    },
    {
      "id": 4,
      "text": "Remains of a 10th‑century ring fort—the oldest settlement within modern Warsaw—can be seen in Targówek, alongside historic cemeteries.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://go2warsaw.pl/en/walk-around-targowek-district/"
    },
    {
      "id": 5,
      "text": "Sculpture Park in Bródno is Warsaw’s only outdoor contemporary art gallery, a joint venture of Targówek authorities, artist Paweł Althamer, and the Museum of Modern Art.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://go2warsaw.pl/en/walk-around-targowek-district/"
    },
    {
      "id": 6,
      "text": "Targówek is divided into residential and industrial parts, reflecting its mixed character.",
      "sourceSentenceIds": [
        17
      ],
