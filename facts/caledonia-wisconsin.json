      ],
      "source": "https://caledonia-wi.gov/history",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The Caledonia Historical Society preserves an 1888 town hall, a train depot, a caboose, a 1840s log cabin, and a museum of farm tools.",
