  "facts": [
    {
      "id": 1,
      "text": "Doss was founded in 1849 by brothers John E. and William Doss, who operated a mill on Threadgill Creek.",
      "sourceSentenceIds": [
        1,
        28
      ],
      "sourceLabels": [
        "Web source 1",
        "Wikipedia"
      ],
      "source": "https://www.historictexas.net/city/doss-texas",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The community’s first post office opened at Lange's Mill in 1898, but by 1907 the name changed to Doss and a new post office was established.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Doss%2C_Gillespie_County%2C_Texas",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "In 1884 the Doss school was founded, and it remained the last two‑room rural school in Gillespie County until the 1980s.",
      "sourceSentenceIds": [
        6,
        24
      ],
      "sourceLabels": [
        "Web source 1",
        "Web source 2"
      ],
      "source": "https://www.historictexas.net/city/doss-texas",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The town earned recognition as a Recorded Texas Historic Landmark in 1985, with a marker dedicated by the Texas Historical Commission in 1989.",
      "sourceSentenceIds": [
        2,
        14
      ],
      "sourceLabels": [
        "Wikipedia",
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Doss%2C_Gillespie_County%2C_Texas",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Doss sits on Mormon Creek, about nineteen miles northwest of Fredericksburg, and its elevation is 1,729 feet above sea level.",
      "sourceSentenceIds": [
        18,
        27
      ],
      "sourceLabels": [
