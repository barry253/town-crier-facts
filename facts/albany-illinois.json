  "facts": [
    {
      "id": 1,
      "text": "Albany was laid out in 1837 and named after Albany, New York, the native home of many of its first settlers.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Albany%2C_Illinois",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "In 1849, ice breaking in the Rock River carved a gorge below where the Meredocia joins, sending ice and water so forcefully it destroyed a nearby bridge.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://genealogytrails.com/ill/whiteside/albany.html",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The present Albany township originally formed part of Van Buren Precinct, then became its own precinct, later encompassing the current townships of Newton and Garden Plain.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://genealogytrails.com/ill/whiteside/albany.html",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Early planners from Galena envisioned a canal connecting the Mississippi to the Rock River to bypass Rock Island rapids, but the project was abandoned after a survey revealed greater obstructions.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://genealogytrails.com/ill/whiteside/albany.html",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "A post office has operated in Albany continuously since 1838, serving the village for nearly two centuries.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Albany%2C_Illinois",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Albany is a village in Whiteside County, Illinois, situated in the state’s northwestern region near the Mississippi River.",
