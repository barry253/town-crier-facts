      "id": 1,
      "text": "Bendigo was originally called Sandhurst from 1853 until 1891, a name that disappeared when the town embraced its gold‑rush identity.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
