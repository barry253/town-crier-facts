  "facts": [
    {
      "id": 1,
      "text": "Headland was founded in 1871 by physician James Joshua Head, who named it \"Head's Land\" and plotted the town on his patented land.",
      "sourceSentenceIds": [
        1,
        2,
        13
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 2"
      ],
      "source": "https://en.wikipedia.org/wiki/Headland%2C_Alabama"
    },
    {
      "id": 2,
      "text": "The first post office opened on October 10, 1871, the same year the town was laid out.",
      "sourceSentenceIds": [
        1,
        14
      ],
      "sourceLabels": [
        "Web source 2",
        "Wikipedia"
      ],
      "source": "https://encyclopediaofalabama.org/article/headland/"
    },
    {
      "id": 3,
      "text": "In 1893 the Seaboard Coast Line Railroad arrived, and the depot built that year later earned a spot on the National Register of Historic Places in 1980.",
      "sourceSentenceIds": [
        3,
        4
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Headland%2C_Alabama"
    },
    {
      "id": 4,
      "text": "The Headland Public Square, laid out in 1871, was paved in 1935 and hosted the town’s first public statue, the Spirit of the American Doughboy, erected in 1926.",
      "sourceSentenceIds": [
        23,
        24,
        25
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Headland%2C_Alabama"
    },
    {
      "id": 5,
      "text": "Headland sits in Alabama’s Wiregrass region, where Creek legend says the area was once called Yatta Abba, meaning ‘grove of dogwoods.’.",
