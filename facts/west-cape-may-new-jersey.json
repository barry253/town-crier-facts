  "facts": [
    {
      "id": 1,
      "text": "West Cape May hosts Historic Cold Spring Village, an open‑air museum that recreates life in South Jersey from 1790‑1840.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://capemaycountynj.gov/950/History"
    },
    {
      "id": 2,
      "text": "The Cape May Lighthouse, with its 199 steps, offers panoramic views and a glimpse into the county’s maritime past.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://capemaycountynj.gov/950/History"
    },
    {
      "id": 3,
      "text": "During World War II, Naval Air Station Wildwood nearby served as a training base, reflecting the area’s wartime heritage.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://capemaycountynj.gov/950/History"
    },
    {
      "id": 4,
      "text": "West Cape May’s streets are lined with Victorian homes, part of the Cape May Historic District, the nation’s only city‑wide National Historic Landmark.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://capemaycountynj.gov/950/History"
    },
    {
      "id": 5,
      "text": "The town’s name honors Dutch captain Cornelius Jacobsen Mey, who charted the coast in the early 1600s.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Cape_May%2C_New_Jersey"
    },
    {
      "id": 6,
      "text": "Whale and dolphin sightings are common off West Cape May’s coast, thanks to the nutrient‑rich mix of the Delaware Bay and Atlantic Ocean.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
