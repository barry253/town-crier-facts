  "facts": [
    {
      "id": 1,
      "text": "Mackinaw City hosts the National Historic Landmark Fort Michilimackinac, now an open‑air museum preserving the original 18th‑century fort.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Mackinaw_City%2C_Michigan",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Colonial Michilimackinac, the preserved fort, is accredited by the American Association of Museums, underscoring its national significance.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.mackinawcity.net/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The area was first settled by the Council of Three Fires—Ojibwe, Ottawa, and Potawatomi—who called the region Michilimackinac.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Mackinaw_City%2C_Michigan",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "After the American Revolution, British troops relocated the fort to Mackinac Island, establishing Fort Mackinac.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Mackinaw_City%2C_Michigan",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "In the late 19th century, railroads like the Michigan Central and Grand Rapids & Indiana brought passengers to Mackinaw City on trains such as the Northern Arrow.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Mackinaw_City%2C_Michigan",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Every summer, Mackinaw City hosts the Arts & Crafts Show at Conkling Heritage Park, featuring handcrafted wares and local artisans.",
      "sourceSentenceIds": [
        8
      ],
