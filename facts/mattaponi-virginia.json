  "facts": [
    {
      "id": 1,
      "text": "Mattaponi is one of only two Virginia Indian tribes that still own reservation land, a legacy dating back to the colonial era.",
      "sourceSentenceIds": [
        14
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Mattaponi",
      "category": "people",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The Upper Mattaponi Tribe, settled on the upper reaches of the Mattaponi River, organized officially in 1921 and later received federal recognition in 2018.",
      "sourceSentenceIds": [
        20,
        22,
        23
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Mattaponi",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "In 1677 the Treaty of Middle Plantation, signed near the Mattaponi River, ended hostilities between the tribe and English settlers.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Mattaponi",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The Mattaponi people were part of the Powhatan Confederacy, a political alliance of Algonquian-speaking tribes led by Chief Powhatan.",
      "sourceSentenceIds": [
        11
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://mattaponi.gov/mattaponi-history",
      "category": "people",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "A historic hamlet called Adamstown, located on the upper Mattaponi River, was home to a Mattaponi band outside the reservation.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Mattaponi",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The tribe’s Algonquian language ties them culturally to other Powhatan chiefdom members, reflecting shared linguistic heritage.",
      "sourceSentenceIds": [
        17
      ],
      "sourceLabels": [
