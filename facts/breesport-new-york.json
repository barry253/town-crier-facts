      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Breesport%2C_New_York",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The Rodbourn House, a hotel in Breesport, officially opened in January 1855 and was built shortly after the village was surveyed.",
