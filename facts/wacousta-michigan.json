    {
      "id": 1,
      "text": "Wacousta began in 1837 when the Waterloo Joint Stock Company built a sawmill and gristmill along the Looking Glass River.",
      "sourceSentenceIds": [
        12,
        13,
        14,
        15,
        16,
        27
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Wacousta%2C_Michigan",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Nathaniel I bought half the town’s land, leased the rest, and became a key figure in Wacousta’s early growth.",
      "sourceSentenceIds": [
        17,
        18,
        19
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Wacousta%2C_Michigan",
      "category": "people",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Daniells, a New York entrepreneur, repaired the sawmill, added a gristmill, and helped attract settlers to the fledgling community.",
      "sourceSentenceIds": [
        2,
        20,
        21,
        22
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Wacousta%2C_Michigan",
      "category": "people",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The Looking Glass River winds east to west across Wacousta, shaping its landscape and early industry.",
      "sourceSentenceIds": [
        27
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Wacousta%2C_Michigan",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Wacousta covers 8.99 square miles, with almost all of it land and just 0.89% water.",
      "sourceSentenceIds": [
        26
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Wacousta%2C_Michigan",
