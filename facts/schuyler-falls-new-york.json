  "facts": [
    {
      "id": 1,
      "text": "Schuyler Falls was named for Peter Schuyler, who bought a mill on the Salmon River from Zephaniah Platt in the 18th century.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Schuyler_Falls%2C_New_York",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The community claims it was founded in 1641 and became an incorporated village in 1758, long before the town itself was created.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Schuyler_Falls%2C_New_York",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Schuyler Falls was officially erected from the town of Plattsburgh by New York State action on April 4, 1848.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://schuylerfallsny.gov/about-us/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The Salmon River cuts through the southern part of the town, flowing just over a mile north of the border with Peru.",
      "sourceSentenceIds": [
        16
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Schuyler_Falls%2C_New_York",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Ezra Turner settled near the Salmon River around 1794 and built the town’s first sawmill in 1801.",
      "sourceSentenceIds": [
        13
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Schuyler_Falls%2C_New_York",
      "category": "people",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The Saranac River marks the northern town line, with Plattsburgh on the opposite shore.",
