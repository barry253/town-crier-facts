  "facts": [
    {
      "id": 1,
      "text": "Kobuk was founded in 1899 as Shungnak, a supply point for miners north of the Kobuk River.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Kobuk%2C_Alaska",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "In 1928 the original Shungnak was renamed Kobuk after river erosion forced residents to move downstream.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Kobuk%2C_Alaska",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Kobuk sits on the bank of the Kobuk River, 10 km northeast of Shungnak, and lies near Kobuk Valley National Park.",
      "sourceSentenceIds": [
        20,
        21
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Kobuk%2C_Alaska",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The town's economy relies on subsistence hunting for caribou and moose, reflecting traditional Inupiat practices.",
      "sourceSentenceIds": [
        16
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Kobuk%2C_Alaska",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Kobuk holds the record for the coldest temperature ever recorded in the United States in March, at -68°F on March 1, 1971.",
      "sourceSentenceIds": [
        22,
        23
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Kobuk%2C_Alaska",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The ancient Onion Portage archaeological site, just a short boat ride away, is considered the most significant Arctic site of its kind.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Web source 1"
      ],
