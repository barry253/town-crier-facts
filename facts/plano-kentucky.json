  "facts": [
    {
      "id": 1,
      "text": "Plano’s early growth hinged on a road network that linked the outpost to southern Kentucky’s agricultural expansion, drawing pioneer families in the late 1800s.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/plano_kentucky",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The origin of Plano’s name remains uncertain, though some suggest a link to Plano, Texas, and a local store that moved closer to Bowling Green in the 1890s.",
      "sourceSentenceIds": [
        5,
        19
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/plano_kentucky",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Plano Elementary School, whose teams are called the Panthers, serves the community’s children.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Plano%2C_Kentucky",
      "category": "landmark",
      "quality": "poor",
      "qualityReason": "editorial_filler"
    },
    {
      "id": 4,
      "text": "Freeman Park, a seven‑acre space donated by the Freeman family in the 1950s, offers volleyball courts, a walking trail, and picnic shelters.",
      "sourceSentenceIds": [
        13,
        22
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/plano_kentucky",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Plano emerged in the early 19th century as part of Warren County’s pioneer wave, with farmers moving in after the county split from Logan County in 1797.",
      "sourceSentenceIds": [
        4,
        27
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/plano_kentucky",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "By the 1830s, Plano Baptist Church—originally Union Church—was formed with 29 members, reflecting the growing spiritual needs of early settlers.",
      "sourceSentenceIds": [
