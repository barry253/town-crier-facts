  "facts": [
    {
      "id": 1,
      "text": "Cibolo means \"buffalo\" and the city was named after the creek that flows through the area.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.cibolotx.gov/community/index.php"
    },
    {
      "id": 2,
      "text": "Cibolo’s beginnings trace back to 1876 when the Southern Pacific Railroad cut through the area, linking it to Houston and San Antonio.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.cibolotx.gov/community/index.php"
    },
    {
      "id": 3,
      "text": "In 1883 the U.S. Post Office opened a branch in the town, officially calling it Cibolo.",
      "sourceSentenceIds": [
        30
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Cibolo%2C_Texas"
    },
    {
      "id": 4,
      "text": "Before European settlers, the Comanche and other Native American tribes inhabited the Cibolo Valley.",
      "sourceSentenceIds": [
        25
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Cibolo%2C_Texas"
    },
    {
      "id": 5,
      "text": "Cibolo Creek, running through the valley, remains a central element of the city’s formation and modern landscape.",
