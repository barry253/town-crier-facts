  "facts": [
    {
      "id": 1,
      "text": "Jakes Corner began as a 1916 stage stop on the Annie Hardt ranch, where stagecoaches paused for the Salt River floods.",
      "sourceSentenceIds": [
        15,
        16,
        17
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://discovergilacounty.com/jakes-corner/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "In 1924 George Felton opened the first store at the corner, while his wife Virginia ran the shop while he toured Wild West shows.",
      "sourceSentenceIds": [
        18,
        19
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://discovergilacounty.com/jakes-corner/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "By 1972 the road outside the store was paved, drawing more traffic from anglers heading to Roosevelt Lake.",
      "sourceSentenceIds": [
        20
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://discovergilacounty.com/jakes-corner/",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The 2008 film “Jake’s Corner” was shot at the local bar and later shown at the Sedona Film Festival.",
      "sourceSentenceIds": [
        4,
        5,
        6,
        7
      ],
      "sourceLabels": [
        "Web source 1",
        "Web source 2"
      ],
      "source": "https://discovergilacounty.com/jakes-corner/",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Jakes Corner sits in the Hardt Creek valley, a tributary of Tonto Creek, in northwestern Gila County.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Jakes_Corner%2C_Arizona",
