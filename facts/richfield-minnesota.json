  "facts": [
    {
      "id": 1,
      "text": "Richfield was officially incorporated in 1908, its name chosen to honor the fertile farmland that once covered the area.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.richfieldmn.gov/residents/about_richfield.php"
    },
    {
      "id": 2,
      "text": "The Richfield Historical Society, founded in 1967, preserves the town’s heritage and maintains the historic Bartholomew House.",
      "sourceSentenceIds": [
        1,
        6
      ],
      "sourceLabels": [
        "Web source 2",
        "Wikipedia"
      ],
      "source": "https://richfield-history.org/"
    },
    {
      "id": 3,
      "text": "Bartholomew House, built in 1852 on Wood Lake’s eastern shore, is listed on the National Register of Historic Places and still stands today.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Richfield%2C_Minnesota"
    },
    {
      "id": 4,
      "text": "Richfield claims the title of Minnesota’s oldest suburb, dating back to settlers around Fort Snelling in the 1820s.",
      "sourceSentenceIds": [
        13,
        18
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Richfield%2C_Minnesota"
    },
    {
      "id": 5,
      "text": "The city is home to Best Buy, the world’s largest electronics retailer, whose headquarters are located in Richfield.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Richfield%2C_Minnesota"
    },
    {
      "id": 6,
      "text": "During the late 1830s, the area that became Richfield attracted lumbermen, missionaries, and traders moving out from Fort Snelling.",
