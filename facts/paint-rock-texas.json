  "facts": [
    {
      "id": 1,
      "text": "Paint Rock got its name from a nearby Native American shelter covered in pictographs.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://texastimetravel.com/cities/paint-rock/",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Just north of the Concho River, a 70‑foot limestone cliff at the Painted Rocks Historical Site displays over 1,500 Native American pictographs.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://thepaintedrocks.org/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "A railroad reached Paint Rock in 1910, but a flood later washed away the Concho River bridge, ending rail service.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://texastimetravel.com/cities/paint-rock/",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The town’s 1886 courthouse is a fine example of French Second Empire architecture that still looks much as it did when built.",
      "sourceSentenceIds": [
        29
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://texastimetravel.com/cities/paint-rock/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Paint Rock’s town square burned twice, first in 1909 and again in 1922, reshaping its commercial core.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://texastimetravel.com/cities/paint-rock/",
