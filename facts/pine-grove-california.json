  "facts": [
    {
      "id": 1,
      "text": "Pine Grove first appeared on maps as the Pine Grove House, a lodging inn that became the town’s first post office in 1856.",
      "sourceSentenceIds": [
        21
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://pinegroveca.com/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "A town hall was erected in 1877 on donated land, marking the formal establishment of Pine Grove as a township under federal law.",
      "sourceSentenceIds": [
        22
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://pinegroveca.com/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Unlike many nearby communities, Pine Grove never incorporated and has remained under Amador County’s jurisdiction ever since.",
      "sourceSentenceIds": [
        23
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://pinegroveca.com/",
      "category": "other",
      "quality": "poor",
      "qualityReason": "editorial_filler"
    },
    {
      "id": 4,
      "text": "The town’s location near the High Sierra and Carson Pass made it a popular spot for early miners and loggers seeking easy access to lakes and rivers.",
      "sourceSentenceIds": [
        24
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://pinegroveca.com/",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "At 2,400 feet, Pine Grove sits where oak and pine trees mingle, and a light dusting of snow falls each year.",
      "sourceSentenceIds": [
        29
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://amadorchamber.com/pine-grove/",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Just an hour from Kirkwood Ski Resort, Pine Grove offers family restaurants, cafes, and a range of shops for visitors and locals alike.",
      "sourceSentenceIds": [
        30
      ],
      "sourceLabels": [
        "Web source 2"
      ],
