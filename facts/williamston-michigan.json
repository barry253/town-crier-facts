  "facts": [
    {
      "id": 1,
      "text": "Miles Williams built a dam and sawmill, platted Williamston in 1845, and named the town after himself.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Williamston%2C_Michigan",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Originally called Williamstown, the town’s spelling changed to Williamston when it was incorporated in 1871.",
      "sourceSentenceIds": [
        4,
        6
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Williamston%2C_Michigan",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The 1871 arrival of the railroad cut travel between Lansing and Detroit from two days to a few hours.",
      "sourceSentenceIds": [
        22
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://totallocal.com/williamston/history/",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Before written history, the Tawas band of the Chippewa used the area as a summer home, planting crops and holding spring gatherings.",
      "sourceSentenceIds": [
        1,
        14
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://williamston-mi.us/about/",
      "category": "people",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Inside the city limits, Williamston Road becomes Putnam Street, honoring the Putnam family who helped establish the town.",
      "sourceSentenceIds": [
        3,
        5
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Williamston%2C_Michigan",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "A Carpenter Gothic building designed by Higbee, built in 1871, now sits on the National Register of Historic Places.",
