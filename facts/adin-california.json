  "facts": [
    {
      "id": 1,
      "text": "Founded in 1869 by Adin McDowell as a supply point for the mining town of Hayden, the community was named Adin in 1870 after its founder.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Adin%2C_California",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Adin sits 29 miles southwest of Alturas at an elevation of 4,203 feet, placing it high in the Modoc County plateau.",
      "sourceSentenceIds": [
        27
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Adin%2C_California",
      "category": "other",
      "quality": "poor",
      "qualityReason": "location_description"
    },
    {
      "id": 3,
      "text": "Every summer, Adin hosts the Golden State Star Party, a gathering that attracts amateur and professional astronomers from across California and the United States.",
      "sourceSentenceIds": [
        28
      ],
      "sourceLabels": [
