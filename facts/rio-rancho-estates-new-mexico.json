  "facts": [
    {
      "id": 1,
      "text": "In the early 1960s, AMREP bought 55,000 acres on Albuquerque's outskirts, naming the area Rio Rancho Estates.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.rrnm.gov/337/City-History-General-Information"
    },
    {
      "id": 2,
      "text": "AMREP marketed the new community to residents from the Midwest and eastern United States.",
      "sourceSentenceIds": [
        20
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.rrnm.gov/337/City-History-General-Information"
    },
    {
      "id": 3,
      "text": "Home building began in 1962, drawing many middle‑income retirees as the first residents.",
      "sourceSentenceIds": [
        21
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.rrnm.gov/337/City-History-General-Information"
    },
    {
      "id": 4,
      "text": "A 1971 expansion added 35,000 acres, making Rio Rancho Estates 92,000 acres—larger than Albuquerque itself.",
      "sourceSentenceIds": [
        22,
        23
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.rrnm.gov/337/City-History-General-Information"
    },
    {
      "id": 5,
      "text": "A low‑interest home‑loan program later attracted young families, shifting the town from a retirement enclave to a family‑friendly community.",
      "sourceSentenceIds": [
        24
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.rrnm.gov/337/City-History-General-Information"
    },
    {
      "id": 6,
      "text": "The Loma Colorado Main Library’s Local History Room, located in its southeast corner, houses a digitized collection that began in 2019 and includes oral histories of residents.",
      "sourceSentenceIds": [
        5,
        6,
        10
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.rrnm.gov/4229/Local-History-Collection"
    }
  ]
