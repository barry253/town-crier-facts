  "facts": [
    {
      "id": 1,
      "text": "Adams was incorporated in 1778 and named after Samuel Adams, a signer of the Declaration of Independence.",
      "sourceSentenceIds": [
        6,
        8
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 2"
      ],
      "source": "https://en.wikipedia.org/wiki/Adams%2C_Massachusetts",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town’s first settlers were Quakers and Baptists from Rhode Island who arrived in the late 1760s when the area was called East Hoosuck.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://exploreadams.com/history/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "In 1897 President William McKinley laid the cornerstone of the Adams Free Library, which was built as a war memorial.",
      "sourceSentenceIds": [
        3,
        26
      ],
      "sourceLabels": [
        "Wikipedia",
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Adams%2C_Massachusetts",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "By 1829 Adams already hosted 15 textile factories, and cotton from the South was hauled up the Hudson and over the mountains to be woven here.",
      "sourceSentenceIds": [
        13,
        14
      ],
      "sourceLabels": [
        "Web source 2",
        "Web source 2"
      ],
      "source": "https://exploreadams.com/history/",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The railroad that linked North Adams to Pittsfield brought paper‑making, lime quarrying, shoe manufacturing, and railroading to the town’s north and south villages.",
      "sourceSentenceIds": [
        22,
        23
      ],
      "sourceLabels": [
        "Web source 2",
        "Web source 2"
      ],
      "source": "https://exploreadams.com/history/",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The Adams Historical Society preserves the town’s story through an interactive StoryMap that blends maps, photos, and archival records.",
