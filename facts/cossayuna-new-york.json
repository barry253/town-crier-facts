  "facts": [
    {
      "id": 1,
      "text": "Cossayuna’s name comes from the Native American word Quabbauna, meaning “Lake of the Three Pines,” named for the giant pines at Oaks Point.",
      "sourceSentenceIds": [
        13,
        14
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://cossayunalake.com/area-history/",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The hamlet sits on the shores of Cossayuna Lake, a picturesque body of water shared by the towns of Argyle and Greenwich in southern Washington County.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://cossayunalake.com/area-history/",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Early settlers arrived in 1765, including Alexander McNaughton and Cornelius McEachron, who helped establish the community after the Revolutionary War.",
      "sourceSentenceIds": [
        27,
        28,
        29
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://cossayunalake.com/area-history/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "From 1885 to 1915, a small factory on the lake’s south end produced inexpensive woolen blankets for the region’s farmers.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://cossayunalake.com/area-history/",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The Argyle Patent, granted in 1764, brought Scotch Highlanders to the area, laying the groundwork for Cossayuna’s early development.",
      "sourceSentenceIds": [
        23,
        25
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://cossayunalake.com/area-history/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Cossayuna’s highland back includes Dutchtown on the west shore and Bunker Hill on the east, reflecting the area’s early settlement patterns.",
      "sourceSentenceIds": [
        7
      ],
