  "facts": [
    {
      "id": 1,
      "text": "Albany was founded in 1848 by brothers Walter and Thomas Monteith, who claimed the east bank of the Willamette River just below the Calapooia mouth.",
      "sourceSentenceIds": [
        18,
        16
      ],
      "sourceLabels": [
        "Web source 2",
        "Web source 1"
      ],
      "source": "https://www.visitoregon.com/cities/albany-oregon/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The city’s name comes from the Monteiths’ hometown of Albany, New York, and the name was briefly changed to New Albany in 1850 before reverting in 1853.",
      "sourceSentenceIds": [
        17,
        10
      ],
      "sourceLabels": [
        "Web source 1",
        "Wikipedia"
      ],
      "source": "https://albanyoregon.gov/history",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Albany sits at the confluence of the Calapooia and Willamette rivers, a spot the Kalapuya called Takenah, meaning a deep pool.",
      "sourceSentenceIds": [
        5,
        6
      ],
      "sourceLabels": [
        "Web source 2",
        "Wikipedia"
      ],
      "source": "https://www.visitoregon.com/cities/albany-oregon/",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The 1888 Albany-Corvallis railroad bridge was the world’s longest wooden drawbridge until it was replaced in the 20th century.",
      "sourceSentenceIds": [
        28
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Albany%2C_Oregon",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The Albany Regional Museum, housed in a historic building originally built by S., showcases the city’s farming and manufacturing heritage.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Albany%2C_Oregon",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Albany’s early economy boomed with foundries, blacksmith shops, and flour mills that served local farmers and processed their crops.",
      "sourceSentenceIds": [
        24
