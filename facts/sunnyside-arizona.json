  "facts": [
    {
      "id": 1,
      "text": "Sunnyside was founded as a religious commune by Samuel Donnelly.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Sunnyside%2C_Arizona",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Donnelly co‑founded the Copper Glance Mine nine miles southeast of Sunnyside, about 50 miles southwest of Tombstone.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.legendsofamerica.com/az-sunnyside/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The community, called Donnellites, grew to about 20‑30 followers before the camp dissolved by 1903.",
      "sourceSentenceIds": [
        6,
        14
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.legendsofamerica.com/az-sunnyside/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "In 1912 the abandoned camp briefly revived as a ranching community before fading again.",
      "sourceSentenceIds": [
        8,
        17
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.legendsofamerica.com/az-sunnyside/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Today Sunnyside is a ghost town with no inhabitants, yet visitors can still walk its private roads and read a guest book.",
      "sourceSentenceIds": [
        20,
        21
      ],
      "sourceLabels": [
        "Web source 1"
