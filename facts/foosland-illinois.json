  "facts": [
    {
      "id": 1,
      "text": "Foosland takes its name from William Foos, an Ohio farmer who bought 3,500 acres in the 1840s and lobbied for a railroad station.",
      "sourceSentenceIds": [
        1,
        2,
        6,
        7,
        13
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 2"
      ],
      "source": "https://en.wikipedia.org/wiki/Foosland%2C_Illinois",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The village was founded in 1867, with a post office opening on June 6 or 7 of that year.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Foosland%2C_Illinois",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Foosland sits on Lone Tree Creek, a tributary that feeds the Sangamon River.",
      "sourceSentenceIds": [
        21
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Foosland%2C_Illinois",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The village park occupies the land William Foos donated over a century ago, a gift still cherished by residents.",
      "sourceSentenceIds": [
        18
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.news-gazette.com/news/our_county/small-town-values-population-99-foosland-a-town-where-residents-stick-together/article_97a4e1ef-5c8b-501e-84fe-cc2da7f3ef06.html",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Today, about five trains still roll through Foosland daily, even though the original station no longer exists.",
      "sourceSentenceIds": [
        17
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.news-gazette.com/news/our_county/small-town-values-population-99-foosland-a-town-where-residents-stick-together/article_97a4e1ef-5c8b-501e-84fe-cc2da7f3ef06.html",
      "category": "other",
      "quality": "poor",
      "qualityReason": "vague"
    },
    {
      "id": 6,
      "text": "Foosland was officially incorporated in 1959, long after its 19th‑century founding.",
