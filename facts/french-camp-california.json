  "facts": [
    {
      "id": 1,
      "text": "French Camp was the final stop on the Oregon‑California Trail, where Hudson’s Bay Company trappers camped from 1832 to 1845.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/French_Camp%2C_California",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Founded in 1832, the fur‑trading camp swelled to nearly 400 people before over‑hunting and smallpox ended its growth.",
      "sourceSentenceIds": [
        4,
        5
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.mantecabulletin.com/news/local-news/french-camp-was-once-sj-countys-largest-community/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Its name derives from the Spanish “Campo de los Franceses,” meaning “Field of the Frenchmen,” recorded in an 1844 land grant.",
      "sourceSentenceIds": [
        19
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/French_Camp%2C_California",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "French Camp is the oldest settlement in San Joaquin County and today hosts the U.S. Army Sharpe Depot and the GSA Western Distribution Center.",
      "sourceSentenceIds": [
        15
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/French_Camp%2C_California",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "During World War II, Japanese Americans from French Camp were relocated to assembly and concentration centers under Executive Order 9066.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/French_Camp%2C_California",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The town sits at the southern end of the Delta’s southernmost slough, using the waterway for easy transportation.",
      "sourceSentenceIds": [
        23
