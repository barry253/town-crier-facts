  "facts": [
    {
      "id": 1,
      "text": "Hendon’s first proper fire station opened in 1914, a design by architect A that marked the town’s commitment to public safety.",
      "sourceSentenceIds": [
        19
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Hendon",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The Midland Main Line reached Hendon in 1868, and the Underground followed in 1923 with Hendon Central station on the Edgware Branch.",
      "sourceSentenceIds": [
        17
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Hendon",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "In 1925 Duple Coachbuilders opened a factory in Hendon that employed 800 workers, becoming one of the town’s largest employers until its closure in 1970.",
      "sourceSentenceIds": [
        6,
        7
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Hendon",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "A Roman settlement once stood in Hendon, and the Edgware Road was part of the ancient Roman road known as Watling Street.",
      "sourceSentenceIds": [
        11
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.barnet.gov.uk/libraries/local-studies-and-archives/pocket-histories/hendon",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Historically, Hendon was a civil parish in the hundred of Gore within the county of Middlesex before becoming part of London.",
      "sourceSentenceIds": [
        14
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Hendon",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Next to the town hall, Hendon Library was built in 1929 to designs by architect T, serving as a cultural hub for residents.",
      "sourceSentenceIds": [
