  "facts": [
    {
      "id": 1,
      "text": "In 1908, George Bratzel, a Hebron settler, founded Golden Valley after buying 160 acres 40 miles north of Hebron.",
      "sourceSentenceIds": [
        1,
        10
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Golden_Valley%2C_North_Dakota",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Golden Valley was originally called Olanta until 1913, when Bratzel renamed it after the surrounding valley.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Golden_Valley%2C_North_Dakota",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The Golden Valley County Historical Society preserves local heritage in a museum that houses the Little Beaver School, a 1909 building.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://gvcohistoricalsociety.org/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "On May 19, 1909, Bratzel finished his first shop and hosted a dance to promote the new town.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Golden_Valley%2C_North_Dakota",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Just a month later, on June 1, 1909, Bratzel applied for a post office, which was quickly approved.",
      "sourceSentenceIds": [
        13,
        14
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Golden_Valley%2C_North_Dakota",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The Shultz Building, the heart of Golden Valley’s museum, showcases artifacts from the county’s pioneer era.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 2"
      ],
