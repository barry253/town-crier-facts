  "facts": [
    {
      "id": 1,
      "text": "Gardners takes its name from Uriah Gardner, a local miller who built the first feed mill and post office in the late 1800s.",
      "sourceSentenceIds": [
        30
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/gardners_pennsylvania",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town’s birth came with the railroad: the Reading Company bought the line in 1891, and Gardners Station opened in 1912 for passengers and freight.",
      "sourceSentenceIds": [
        11,
        12,
        4
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/gardners_pennsylvania",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "In 1912 Musselman built a second processing plant in Gardners, beginning apple processing the following fall and expanding the local fruit industry.",
      "sourceSentenceIds": [
        16,
        18
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Gardners%2C_Pennsylvania",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "During World War I, the Gardners and Biglerville plants kept canned fruit flowing despite labor, fuel, and transportation shortages.",
      "sourceSentenceIds": [
        19
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Gardners%2C_Pennsylvania",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Today Knouse Foods keeps a warehouse in Gardners, producing over 300 products that ship to more than 50 countries worldwide.",
      "sourceSentenceIds": [
        25,
        26
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Gardners%2C_Pennsylvania",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Gardners sits just off Pennsylvania Route 34 in Tyrone Township, surrounded by apple orchards that have defined the region’s agriculture.",
      "sourceSentenceIds": [
