      "category": "transport",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The Wake Forest Historical Museum, located in the historic Calvin Jones House, preserves town lore and hosts events like Juneteenth celebrations.",
      "sourceSentenceIds": [
        1,
        14
      ],
      "sourceLabels": [
        "Web source 2"
