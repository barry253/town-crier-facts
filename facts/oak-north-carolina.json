      "quality": "good"
    },
    {
      "id": 2,
      "text": "In 1905, a local visitor’s admiration for a delivery wagon named “Oak City Laundry” prompted the town’s official renaming.",
      "sourceSentenceIds": [
        14
      ],
      "sourceLabels": [
        "Web source 1"
      ],
