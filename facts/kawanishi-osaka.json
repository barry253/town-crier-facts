  "facts": [
    {
      "id": 1,
      "text": "From the Heian period, Tada-in became a sacred site for the Seiwa Genji clan after Minamoto no Mitsunaka retired there.",
      "sourceSentenceIds": [
        17
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Kawanishi%2C_Hy%C5%8Dgo",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The Tada Silver Mine, opened in the 11th century, produced silver and copper and reached peak output in the 17th century, making Kawanishi a tenryō territory Tokugawa rule.",
      "sourceSentenceIds": [
        18,
        19
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Kawanishi%2C_Hy%C5%8Dgo",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "In 1884, Mitsubishi established Japan's first noted water plant in Kawanishi, which later became the famous Mitsuya Cider brand.",
      "sourceSentenceIds": [
        24
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Kawanishi%2C_Hy%C5%8Dgo",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Hankyu's Kawanishi-Noseguchi Station serves as a transfer hub to the Nose Railway, which runs primarily within Kawanishi.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Kawanishi%2C_Hy%C5%8Dgo",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Kawanishi lies directly east of the Inagawa River, which forms its western boundary.",
      "sourceSentenceIds": [
        11
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Kawanishi%2C_Hy%C5%8Dgo",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The city experiences a humid subtropical climate with warm summers, cool winters, and an average annual temperature of 14.0 °C.",
