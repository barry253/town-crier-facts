  "facts": [
    {
      "id": 1,
      "text": "Black Hawk sprang to life in 1859 when a gold strike ignited the Pike's Peak Gold Rush, drawing miners to the Rockies.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Black_Hawk%2C_Colorado",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Named after the Sauk leader Black Hawk, the settlement was first called Black Hawk Point before shortening its name in the 1860s.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://unitedstatesghosttowns.com/black-hawk-colorado-ghost-town/",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Cornish miners, known as “Cousin Jacks,” built sturdy stone walls and foundations that still punctuate Black Hawk’s historic streets.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://unitedstatesghosttowns.com/black-hawk-colorado-ghost-town/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The Colorado Central Railroad reached Black Hawk in 1872, linking the town to Golden and spurring a boom in mining infrastructure.",
      "sourceSentenceIds": [
        11
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Black_Hawk%2C_Colorado",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "In 1991, casino gaming opened, rescuing Black Hawk from near abandonment and reshaping its economy while preserving historic buildings.",
      "sourceSentenceIds": [
        28
