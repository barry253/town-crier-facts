  "facts": [
    {
      "id": 1,
      "text": "Gapland earned its name when novelist George Alfred Townsend, known as “Gath,” bought lots in Crampton's Gap in 1884 and called the estate Gapland.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.southmountainheritage.org/gapland-scenes.html",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Gath built ten distinctive structures on the estate over twenty years, including the heart of the property, the Den and Library, which housed his vast book collection and artwork.",
      "sourceSentenceIds": [
        3,
        5
      ],
      "sourceLabels": [
        "Web source 1",
        "Web source 2"
      ],
      "source": "https://dnr.maryland.gov/publiclands/Pages/western/Gathland/History-Gathland.aspx",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "In the 1890s, Gath helped farmers and businessmen construct a road from the mountain top to Clagget's Station—now Gapland—connecting the town to the Baltimore and Ohio Railroad.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.southmountainheritage.org/gapland-scenes.html",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "After Gath's death in 1914, the estate was left abandoned and heavily indebted, marking the end of an era of lavish estate building in Gapland.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.southmountainheritage.org/gapland-scenes.html",
