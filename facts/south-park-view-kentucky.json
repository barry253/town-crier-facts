  "facts": [
    {
      "id": 1,
      "text": "South Park View earned its name from its perch beside South Park Hill, the county’s highest point at 902 feet.",
      "sourceSentenceIds": [
        1,
        22
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/South_Park_View%2C_Kentucky",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "South Park View became a sixth‑class city in April 1961, making it Kentucky’s smallest incorporated city.",
      "sourceSentenceIds": [
        8,
        7
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/South_Park_View%2C_Kentucky",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "After remaining on the state registry for decades, the city was officially dissolved in 2023 under new ghost‑city legislation.",
      "sourceSentenceIds": [
        9,
        19
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/South_Park_View%2C_Kentucky",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "By 2003, all homes were demolished, leaving the former city’s site vacant and earmarked for industrial redevelopment.",
      "sourceSentenceIds": [
        28
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/south_park_view_kentucky",
      "category": "other",
      "quality": "poor",
      "qualityReason": "vague"
    },
    {
      "id": 5,
      "text": "Despite having no residents, South Park View lingered on Kentucky’s official city list until its 2023 dissolution.",
      "sourceSentenceIds": [
        18,
        29
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/south_park_view_kentucky",
      "category": "other",
      "quality": "poor",
      "qualityReason": "vague"
    },
    {
      "id": 6,
      "text": "The neighborhood fell within a 65‑dB noise contour, making it incompatible with FAA runway 17L/17R operations.",
