  "facts": [
    {
      "id": 1,
      "text": "Shortsville began in 1804 when Theophilus Short built two mills on the Canandaigua Outlet, later becoming the village of Shortsville.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Shortsville%2C_New_York",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "In 1844 the New York Central Railroad built a line from Auburn to Rochester, giving Shortsville a station that moved from east to west side of the tracks.",
      "sourceSentenceIds": [
        10,
        13
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://shortsvilleny.us/history",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The village’s park is still being laid out along the Canandaigua Outlet, a stream that drew the first settler whose name lives on in Shortsville.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://shortsvilleny.us/history",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Shortsville was once home to the Empire Drill Works, founded in 1850, and the Shortsville Wheel Company, a wheel maker that closed in the early 20th century.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Shortsville%2C_New_York",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The 2014 film “We Are Still Here” was shot in Shortsville, showcasing the village’s historic streets.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Shortsville%2C_New_York",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Shortsville’s historic downtown once housed a cottage hotel, a barber shop, and a jewelry store, reflecting its 19th‑century commercial life.",
      "sourceSentenceIds": [
        14
      ],
      "sourceLabels": [
        "Web source 2"
      ],
