    {
      "id": 1,
      "text": "Jurupa Valley’s name comes from a Native American village called Jurupa, whose word meant “peace and friendship” when early priests arrived.",
      "sourceSentenceIds": [
        4,
        6,
        28
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Jurupa_Valley%2C_California",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "In 1838, Mexican land grant Rancho Jurupa was given to Juan Bandini after Mexico gained independence from Spain.",
      "sourceSentenceIds": [
        16
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://ohmyfacts.com/world/cities/30-facts-about-jurupa-valley/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Rancho Jurupa began as an outpost of Mission San Gabriel Arcángel before becoming a Mexican land grant in 1838.",
      "sourceSentenceIds": [
        26,
        27
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Jurupa_Valley%2C_California",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Jurupa Valley became an official city on July 1, 2011, after voters approved incorporation in a March 8 ballot.",
      "sourceSentenceIds": [
        29,
        30
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Jurupa_Valley%2C_California",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The Pedley station, formerly Pedley Station, serves Jurupa Valley residents on the Metrolink commuter rail line.",
      "sourceSentenceIds": [
