      "quality": "good"
    },
    {
      "id": 2,
      "text": "Micah Mudge and Ichabod Wood first settled Richmond in 1759, arriving from Connecticut and Rehoboth respectively.",
      "sourceSentenceIds": [
        20,
        21
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Richmond%2C_Massachusetts",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Richmont officially became Richmond in 1785, a name change that solidified the town’s identity separate from Lenox.",
      "sourceSentenceIds": [
        27
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Richmond%2C_Massachusetts",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The society’s museum displays a curated collection of Richmond’s historical artifacts and memorabilia for visitors and researchers alike.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://museumsdatabase.com/museums/view/14738",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Richmond maintains its own public library, offering residents access to books, archives, and community programs.",
      "sourceSentenceIds": [
        16
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Richmond%2C_Massachusetts",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Unlike many New England towns, Richmond has no local bus service; the nearest stop is in Pittsfield.",
