  "facts": [
    {
      "id": 1,
      "text": "Eldon is said to have been named after the town of Eldon, Illinois.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Eldon%2C_Oklahoma"
    },
    {
      "id": 2,
      "text": "Eldon sits along the eastern edge of Cherokee County in the valley of the Baron Fork of the Illinois River.",
      "sourceSentenceIds": [
        14
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Eldon%2C_Oklahoma"
    },
    {
      "id": 3,
      "text": "The abandoned Hitchcock Store at the base of Eldon Hill served as a general store and community center starting in 1913.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/eldon_oklahoma"
    },
    {
      "id": 4,
      "text": "Development in Eldon began with the construction of the Ozark and Cherokee Central Railway between 1901 and 1903.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/eldon_oklahoma"
    },
    {
      "id": 5,
      "text": "The Eldon Post Office served the community from March 1911 until May 1936.",
      "sourceSentenceIds": [
        13
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Eldon%2C_Oklahoma"
    },
    {
      "id": 6,
      "text": "Eldon's historical identity is tied to Cherokee heritage and its position within the scenic Illinois River watershed.",
