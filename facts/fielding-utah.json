    },
    {
      "id": 2,
      "text": "Early settlers in the late eighteen seventies and early eighteen eighties lived in a scattered community known as Hessville.",
      "sourceSentenceIds": [
        9,
        25
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.boxeldercountyut.gov/531/Fielding-History"
    },
    {
      "id": 3,
      "text": "The LDS Church encouraged the residents of Fielding to centralize their community and form a formal townsite in the eighteen eighties.",
      "sourceSentenceIds": [
        26
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.boxeldercountyut.gov/531/Fielding-History"
    },
    {
      "id": 4,
      "text": "A frame building in Fielding served as both a church and a school, affectionately known as the Pink Schoolhouse.",
