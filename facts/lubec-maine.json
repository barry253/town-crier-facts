  "facts": [
    {
      "id": 1,
      "text": "Lubec was named after the German city of Lübeck, reflecting early settlers’ admiration for the European port.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Lubec%2C_Maine",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Lubec holds the title of the easternmost town in the continental United States, stretching to the Atlantic’s edge.",
      "sourceSentenceIds": [
        13
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.visitlubecmaine.com/about/town-overview.php",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Because of its position, Lubec is the closest continental point in the U.S. to Africa, just over 3,000 miles away.",
      "sourceSentenceIds": [
        16
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Lubec%2C_Maine",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "First settled around 1775, Lubec sits on a peninsula that overlooks an ice‑free harbor, a strategic advantage for early fishermen.",
      "sourceSentenceIds": [
        17
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Lubec%2C_Maine",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Following the War of 1812, Lubec became a hub for gypsum smuggling, while its main industries remained agriculture and fisheries.",
      "sourceSentenceIds": [
        19
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Lubec%2C_Maine",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "By 1859 Lubec boasted a tannery, three gristmills, and nine sawmills; by 1886 it also had two shipyards, three boatbuilders, and three sailmakers.",
      "sourceSentenceIds": [
        20
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Lubec%2C_Maine",
      "category": "history",
      "quality": "good"
    }
  ]
