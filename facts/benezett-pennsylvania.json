  "facts": [
    {
      "id": 1,
      "text": "Benezette was once home to Seneca Indians and called Salt Lick because of nearby salt deposits.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://benezettetwp.com/history/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town’s name evolved from Benezette to Benezett; its origin story is detailed in local history.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://benezettetwp.com/history/",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Benezette is dubbed the “Elk Capital of Pennsylvania” and sits in the heart of a herd of nearly 1,400 elk.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://visitpago.com/counties/elk-county/benezette/",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The Elk Country Visitor Center on Winslow Hill is the prime spot for spotting elk in the area.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://visitpago.com/counties/elk-county/benezette/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Zion Historical Park near Benezette features a quiet honor walkway and memorials for Civil War, veterans, and Boy Scouts.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://visitpago.com/counties/elk-county/benezette/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The Bennett Branch river offers 40 miles of seasonal paddling with five public launches, popular in spring and fall.",
