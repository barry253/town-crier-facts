  "facts": [
    {
      "id": 1,
      "text": "Buckeystown earned its spot on the National Register of Historic Places in 1982, thanks to its well-preserved Victorian homes and historic district.",
      "sourceSentenceIds": [
        20
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Buckeystown%2C_Maryland",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town’s name honors George Buckey, a tanner, and his brother John, a blacksmith and tavern owner who helped launch the community in the 18th century.",
      "sourceSentenceIds": [
        4,
        29
      ],
      "sourceLabels": [
        "Web source 1",
        "Wikipedia"
      ],
      "source": "https://www.housewivesoffrederickcounty.com/theres-something-everybody-historic-buckeystown-md/",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Buckeystown’s Baker family shaped the 19th‑century economy by running a tannery, a cannery, a Methodist church, and an industrial school for boys.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Buckeystown%2C_Maryland",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The town’s historic district showcases Queen Anne and Victorian architecture, with many homes proudly displaying plaque markers that reveal their construction year.",
      "sourceSentenceIds": [
        1,
        15
      ],
      "sourceLabels": [
        "Web source 1",
        "Web source 1"
      ],
      "source": "https://www.housewivesoffrederickcounty.com/theres-something-everybody-historic-buckeystown-md/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Buckeystown sits on the Monocacy River, a major tributary of the Potomac, which attracted early settlers seeking fertile, flat land for farming.",
      "sourceSentenceIds": [
        24,
        25
      ],
      "sourceLabels": [
        "Wikipedia",
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Buckeystown%2C_Maryland",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "In 1731, Meridith Davis patented the “Good Luck” tract, the land that later became the foundation for Buckeystown’s first meetinghouse and community.",
      "sourceSentenceIds": [
        23,
        27
      ],
