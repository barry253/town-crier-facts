  "facts": [
    {
      "id": 1,
      "text": "Baruch Schleisinger Weil founded Slinger in 1845, buying 2,000 acres and establishing the village that would grow into today’s community.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Slinger%2C_Wisconsin",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Originally called Schleisingerville, the village honored Weil, a merchant who developed the area as a railroad stop in the 1840s.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Slinger%2C_Wisconsin",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The Slinger Historical Museum opened June 28, 2020, inside the historic 1911 Union Depot downtown.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.slingermuseum.org/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Its 5,000‑square‑foot exhibit space takes visitors through 180 years of local history, from 1845 to today.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.slingermuseum.org/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Before 1833, Potawatomi people lived in the Slinger area, later forced to leave by the Treaty of Chicago.",
