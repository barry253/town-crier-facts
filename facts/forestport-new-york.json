  "facts": [
    {
      "id": 1,
      "text": "Forestport’s western boundary is carved by the Black River and Kayuta Lake, anchoring the town within the Adirondack Park.",
      "sourceSentenceIds": [
        12,
        15
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Forestport%2C_New_York",
      "category": "nature",
      "quality": "poor",
      "qualityReason": "location_description"
    },
    {
      "id": 2,
      "text": "The infamous “Forestport Breaks” occurred when workers cut sections of the Black River Canal to profit from repair contracts, a scandal that still echoes in local lore.",
      "sourceSentenceIds": [
        13
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Forestport%2C_New_York",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "In 1913, the arrival of the Adirondack Division of the New York Central Railroad turned Forestport into a bustling hub for commerce and tourism.",
      "sourceSentenceIds": [
        1,
        3
      ],
      "sourceLabels": [
        "Web source 1",
        "Web source 2"
      ],
      "source": "https://townofforestport.gov/history/",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Otter Lake, once a modest waterway, evolved into a resort area in 1944, drawing visitors seeking Adirondack recreation.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://townofforestport.gov/history/",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The town celebrated its centennial in 1970, marking a hundred years since Forestport’s founding and reflecting its enduring community spirit.",
