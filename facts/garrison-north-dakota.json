      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Garrison takes its name from nearby Garrison Creek, a small stream that once guided early settlers.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Garrison%2C_North_Dakota",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The original town moved to its current location when the Soo Line rerouted its tracks farther north, reshaping the community’s layout.",
