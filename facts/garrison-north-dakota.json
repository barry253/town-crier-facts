      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town sprang up in 1905 when the Soo Line Railroad extended to the area and was officially laid out that year.",
      "sourceSentenceIds": [
        2,
        3,
        24
      ],
      "sourceLabels": [
        "Wikipedia",
