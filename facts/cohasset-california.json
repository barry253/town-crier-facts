  "facts": [
    {
      "id": 1,
      "text": "Cohasset means 'long rocky place' in an Algonquian language, echoing the rugged ridge that defines the town.",
      "sourceSentenceIds": [
        11
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Cohasset%2C_California",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Cohasset sits atop an eleven-mile ridge that stretches southwest to northeast, rising to 2,828 feet above sea level.",
      "sourceSentenceIds": [
        13,
        12
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Cohasset%2C_California",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Long before Euro-American settlers, the Northwestern Maidu and Yahi subgroup of the Yana people hunted, gathered, and camped along Cohasset's oak woodlands.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/cohasset_california",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The first Cohasset post office opened on February 20, 1888, after residents persuaded the government to rename the ridge from North Point.",
      "sourceSentenceIds": [
        4,
        3
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Cohasset%2C_California",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "In the early 1900s, Cohasset gained a reputation for producing high‑quality apples that were prized across California.",
      "sourceSentenceIds": [
        18
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Cohasset%2C_California",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Every August, the Cohasset Community Association hosts a lively Bazaar and Music Festival that showcases local crafts and talent.",
