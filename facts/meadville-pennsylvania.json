  "facts": [
    {
      "id": 1,
      "text": "Meadville was founded in 1788 by David Mead, who chose the spot where Cussewago and French Creeks meet for its strategic transport potential.",
      "sourceSentenceIds": [
        1,
        3
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.experiencemeadville.org/history",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Allegheny College, the oldest college west of the Allegheny Mountains, opened its doors in 1815 and has been a center of learning ever since.",
      "sourceSentenceIds": [
        5,
        7
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Meadville%2C_Pennsylvania",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The French Creek Feeder Canal, opened in 1837, linked Meadville to the Beaver and Erie Canal, turning the town into a key transportation hub.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Meadville%2C_Pennsylvania",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Meadville earned the nickname “Tool City USA” after the railroad arrived in 1862 and companies like Channellock and Talon established major manufacturing plants.",
      "sourceSentenceIds": [
        19,
        20
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.experiencemeadville.org/history",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The Crawford Trust Building, a six‑story steel‑beam skyscraper, was erected in 1911 and still stands beside Pennsylvania’s oldest operating Market House.",
      "sourceSentenceIds": [
        21
      ],
      "sourceLabels": [
        "Web source 1"
      ],
