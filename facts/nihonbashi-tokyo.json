      ],
      "source": "https://en.wikipedia.org/wiki/Nihonbashi",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The historic fish market on Nihonbashi became the predecessor of today’s Tsukiji and Toyosu markets.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
