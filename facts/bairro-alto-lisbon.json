  "facts": [
    {
      "id": 1,
      "text": "Bairro Alto began in 1513 when King Manuel I authorized urbanization outside Lisbon's medieval walls.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://historicquarters.com/portugal/lisbon/bairro-alto-history-bohemian-lisbon"
    },
    {
      "id": 2,
      "text": "The neighborhood grew from two distinct urbanization phases, creating an almost orthogonal street grid that still defines its layout.",
      "sourceSentenceIds": [
        11
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Bairro_Alto"
    },
    {
      "id": 3,
      "text": "Small taverns in the 19th century turned private guitar sessions into public memories, giving Bairro Alto its bohemian reputation.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://historicquarters.com/portugal/lisbon/bairro-alto-history-bohemian-lisbon"
    },
    {
      "id": 4,
      "text": "The Convento dos Cardaes on Rua do Século survived the 1755 earthquake and now houses a museum of sacred art.",
      "sourceSentenceIds": [
        14
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://goaskalocal.com/blog/guide-to-bairro-alto-lisbon"
    },
    {
      "id": 5,
      "text": "A charming pharmacy museum next to the Santa Catarina viewpoint chronicles Portugal's pharmaceutical history.",
      "sourceSentenceIds": [
        15
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://goaskalocal.com/blog/guide-to-bairro-alto-lisbon"
    },
    {
      "id": 6,
      "text": "By the 19th century, noble families abandoned their palaces, allowing artists and writers to occupy the area and cement its cultural legacy.",
      "sourceSentenceIds": [
        16
      ],
      "sourceLabels": [
        "Web source 2"
      ],
