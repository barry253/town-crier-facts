    },
    {
      "id": 2,
      "text": "The 1898 arrival of the Pecos and Northern Railroad turned Canyon into the first railhead for shipping cattle in the Panhandle.",
      "sourceSentenceIds": [
        14
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.canyontx.gov/58/History"
    },
    {
      "id": 3,
      "text": "The Panhandle‑Plains Historical Museum opened in 1932, preserving the region’s heritage on the West Texas A&M campus.",
      "sourceSentenceIds": [
        19
      ],
      "sourceLabels": [
        "Web source 2"
      ],
