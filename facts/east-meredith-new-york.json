    },
    {
      "id": 3,
      "text": "The society’s museum showcases artifacts, photographs, and documents that trace East Meredith’s local history.",
      "sourceSentenceIds": [
        15
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://museumsdatabase.com/museums/view/22559"
    },
    {
      "id": 4,
      "text": "The society maintains historic properties like the Meredith Town Hall and the Kellogg Memorial Research Library.",
