      "id": 1,
      "text": "Millen was first settled in 1835 and was originally called “79” because it lay about 79 miles from Savannah.",
      "sourceSentenceIds": [
        8,
        2,
        3
      ],
      "sourceLabels": [
        "Web source 1",
