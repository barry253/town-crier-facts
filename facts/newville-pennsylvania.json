      "category": "culture",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Historic carriage rides have returned to Newville, offering a nostalgic tour of the town’s preserved Victorian homes and green spaces.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 1"
      ],
