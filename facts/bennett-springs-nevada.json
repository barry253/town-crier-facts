      "id": 1,
      "text": "Bennett Springs sprang up in the late 19th century as a ranching outpost drawn by its natural springs amid Nevada's mining boom.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
