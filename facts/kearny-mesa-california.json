    {
      "id": 1,
      "text": "Kearny Mesa takes its name from Camp Kearny, a U.S. Army training site founded in 1917 during World War I.",
      "sourceSentenceIds": [
        1,
        4
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 2"
      ],
      "source": "https://en.wikipedia.org/wiki/Kearny_Mesa%2C_San_Diego",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Camp Kearny honored Brigadier General Stephen Watts Kearny, a hero of the Mexican–American War.",
      "sourceSentenceIds": [
        2,
        4
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 2"
      ],
      "source": "https://en.wikipedia.org/wiki/Kearny_Mesa%2C_San_Diego",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "In 1937 Gibbs Airfield—now Montgomery Field—was built, sparking Kearny Mesa’s shift to aviation‑related industry.",
      "sourceSentenceIds": [
        3,
        20
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Kearny_Mesa%2C_San_Diego",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Annexed by San Diego in 1951, the mesa was rezoned for light industry, attracting General Dynamics and other aerospace firms.",
      "sourceSentenceIds": [
        20,
        26
      ],
      "sourceLabels": [
        "Web source 1",
