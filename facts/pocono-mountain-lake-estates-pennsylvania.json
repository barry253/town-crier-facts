  "facts": [
    {
      "id": 1,
      "text": "Pocono Mountain Lake Estates sits in Lehman Township, a region once home to the Lenape Minsi people who hunted and fished along the Delaware River.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/pocono_mountain_lake_estates_pennsylvania",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "English and German settlers arrived in the 1740s, and Nicholas Depui built the first permanent home in 1725.",
      "sourceSentenceIds": [
        18
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.poconomountains.com/plan-your-vacation/about-the-poconos/pocono-mountains-history/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "By the late 19th century, the region’s lumber economy shifted toward recreation as railroads opened in the 1850s, bringing tourists from New York and Philadelphia.",
      "sourceSentenceIds": [
        11
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/pocono_mountain_lake_estates_pennsylvania",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "In 1926, the Pennsylvania Power and Light Company began building Lake Wallenpaupack, the third‑largest man‑made lake in Pennsylvania, which today offers 52 miles of shoreline.",
      "sourceSentenceIds": [
        26,
        27
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.poconomountains.com/plan-your-vacation/about-the-poconos/pocono-mountains-history/",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "During World War II, many GIs vacationed in the Poconos, and the area’s romantic appeal drew them back as honeymooners after the war.",
      "sourceSentenceIds": [
        29,
        30
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.poconomountains.com/plan-your-vacation/about-the-poconos/pocono-mountains-history/",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The first boarding house hotel in the Delaware Water Gap, founded in 1829 by Anthony Dutot, sparked the region’s long‑standing resort industry.",
      "sourceSentenceIds": [
        19
      ],
      "sourceLabels": [
        "Web source 1"
