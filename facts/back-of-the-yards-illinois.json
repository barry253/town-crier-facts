  "facts": [
    {
      "id": 1,
      "text": "Back of the Yards was part of the Town of Lake until Chicago annexed it in 1889.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://bync.org/history"
    },
    {
      "id": 2,
      "text": "The neighborhood grew around the Union Stockyards, founded in 1865, and the refrigerated boxcar by 1880 fueled a meatpacking boom.",
      "sourceSentenceIds": [
        16
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://chicagostudies.uchicago.edu/back-yards/back-yards-history-back-yards"
    },
    {
      "id": 3,
      "text": "Remnants of that era survive at the historic Union Stockyard Gate on Exchange Avenue at Peoria Street.",
      "sourceSentenceIds": [
        17,
        18
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://chicagostudies.uchicago.edu/back-yards/back-yards-history-back-yards"
    },
    {
      "id": 4,
      "text": "Back of the Yards was once a hotbed of anti‑establishment activism, with the neighborhood center clashing with stockyard owners.",
      "sourceSentenceIds": [
        13
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://bync.org/history"
    },
    {
      "id": 5,
      "text": "The neighborhood sits within Chicago’s New City community area, bordering Canaryville on the southwest side.",
      "sourceSentenceIds": [
        15
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://chicagostudies.uchicago.edu/back-yards/back-yards-history-back-yards"
    },
    {
      "id": 6,
      "text": "Its name reflects its origins as the rear of the city’s massive stockyard complex.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://bync.org/history"
    }
