  "facts": [
    {
      "id": 1,
      "text": "Hatillo was founded June 30, 1823 by Agustín Ruiz Miranda, a Canarian immigrant, on about ten cuerdas of land.",
      "sourceSentenceIds": [
        2,
        4
      ],
      "sourceLabels": [
        "Web source 2",
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/Hatillo,_Puerto_Rico",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town’s name honors its founder, who required public buildings and wide streets, shaping Hatillo’s early layout.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Hatillo%2C_Puerto_Rico",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Hatillo’s coastal location on Puerto Rico’s north coast places it directly on the Atlantic Ocean, overlooking the Northern Karst region.",
      "sourceSentenceIds": [
        11,
        26
      ],
      "sourceLabels": [
        "Wikipedia",
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Hatillo%2C_Puerto_Rico",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Dairy farming dominates Hatillo’s economy; the municipality hosts 75 farms that supply much of the island’s milk.",
      "sourceSentenceIds": [
        23
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Hatillo%2C_Puerto_Rico",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "In 2017 Hurricane Maria, Hatillo’s 75 dairy farms suffered up to a 45% drop in production, highlighting the town’s vulnerability.",
      "sourceSentenceIds": [
        24
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Hatillo%2C_Puerto_Rico",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The historic Hacienda Santa Rosa and Hacienda Perseverancia once covered 150 and 50 cuerdas, illustrating Hatillo’s early sugarcane plantation heritage.",
