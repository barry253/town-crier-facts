    {
      "id": 1,
      "text": "Stone City was founded in 1850 along the banks of the Wapsipinicon River.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Stone_City%2C_Iowa",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "John Green named the community Stone City to honor its limestone quarries and booming quarrying economy.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/stone_city_iowa",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Stone City grew as a company town, with workers living and working in the Anamosa limestone quarries.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/stone_city_iowa",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Between 1859 and 1895, more than 150,000 railroad cars shipped Anamosa limestone from Stone City to build bridges and foundations.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Stone_City%2C_Iowa",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "In 1932, Grant Wood founded the Stone City Art Colony, a short‑lived summer school that hosted 120 artists in repurposed ice wagons.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/stone_city_iowa",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Columbia Hall, a three‑story hotel and opera house completed in 1883, was built from 500,000 tons of Stone City limestone.",
      "sourceSentenceIds": [
        26,
