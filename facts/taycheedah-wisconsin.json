  "facts": [
    {
      "id": 1,
      "text": "Taycheedah is located on the east shore of Lake Winnebago in Fond du Lac County, Wisconsin.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.townoftaycheedahwi.gov/history/"
    },
    {
      "id": 2,
      "text": "Early explorers found a Winnebago Indian village at Taycheedah, where Chief Sar-ro-chau led the band in 1705.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://digicoll.library.wisc.edu/WIReader/WER0438.html"
    },
    {
      "id": 3,
      "text": "Taycheedah Indians were remembered by early settlers for their friendly attitude and willingness to assist newcomers.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://digicoll.library.wisc.edu/WIReader/WER0438.html"
    },
    {
      "id": 4,
      "text": "A settlement begun in 1839 briefly made Taycheedah the social and cultural center of Fond du Lac County.",
      "sourceSentenceIds": [
        4,
        29
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://digicoll.library.wisc.edu/WIReader/WER0438.html"
    },
    {
      "id": 5,
      "text": "Early travel routes from Green Bay to the Fond du Lac region used Taycheedah as a gateway to the prairie.",
