  "facts": [
    {
      "id": 1,
      "text": "Heber Springs began as Sugar Loaf, founded by Max Frauenthal who plotted the town site in 1882.",
      "sourceSentenceIds": [
        1,
        5
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Heber_Springs%2C_Arkansas",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "In 1910 the town renamed itself Heber Springs to avoid confusion with another Sugar Loaf, honoring its natural springs.",
      "sourceSentenceIds": [
        6,
        4
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Heber_Springs%2C_Arkansas",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The 200‑foot Swinging Bridge over the Little Red River, built in 1912, now serves pedestrians and is on the National Register of Historic Places.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Heber_Springs%2C_Arkansas",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "A railroad ran through Heber Springs from 1908 until 1946, linking the town to regional trade routes.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.cleburnecountyar.com/historical-society",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The Cleburne County Historical Society, housed at 102 East Main Street, operates a museum and research library that chronicles local history.",
