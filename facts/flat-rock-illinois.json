  "facts": [
    {
      "id": 1,
      "text": "Flat Rock was founded in 1876 by merchant John W. Jones, who opened the village’s first general store.",
      "sourceSentenceIds": [
        10,
        11,
        26,
        27
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Flat_Rock%2C_Illinois",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The village’s name comes from a large, flat rock that once stood near the original post office.",
      "sourceSentenceIds": [
        29
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.marykozy.net/CrawfordCo/history/flat.rock.php",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "When the railroad was built, it ran through Flat Rock but missed the nearby town of Morea, a decision that shaped the area’s growth.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.marykozy.net/CrawfordCo/history/flat.rock.php",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The first postmaster was William Thompson, who ran the office out of his home a mile west of the town’s current center.",
      "sourceSentenceIds": [
        28
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.marykozy.net/CrawfordCo/history/flat.rock.php",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Flat Rock’s early economy included a hardware store, a filling station, and a motor service, all owned by local entrepreneurs.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.marykozy.net/CrawfordCo/history/flat.rock.php",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The village was officially laid out on April 20, 1876, as recorded in the 1883 “History of Crawford and Clark Counties.”.",
