  "facts": [
    {
      "id": 1,
      "text": "Penns Park is the oldest village in Wrightstown Township, first called Logtown in 1716 before becoming Penns Park in 1862.",
      "sourceSentenceIds": [
        14,
        16,
        17
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Penns_Park%2C_Pennsylvania"
    },
    {
      "id": 2,
      "text": "The village’s name change honored William Penn, reflecting his vision of peaceful rural settlements after another Pennsville existed.",
      "sourceSentenceIds": [
        27
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://pennsparknewtownneighborhood.org/penns-park-unfolding-the-charming-history-and-heritage-of-a-bucks-county-gem/"
    },
    {
      "id": 3,
      "text": "Penns Park United Methodist Church, founded in 1791, sits beside a centuries‑old graveyard that holds many township founders.",
      "sourceSentenceIds": [
        9,
        20
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://pennsparknewtownneighborhood.org/penns-park-unfolding-the-charming-history-and-heritage-of-a-bucks-county-gem/"
    },
    {
      "id": 4,
      "text": "The solitary log house at Penns Park Road and Mud Road is reputed to be Bucks County’s oldest house.",
      "sourceSentenceIds": [
        18,
        19
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Penns_Park%2C_Pennsylvania"
    },
    {
      "id": 5,
      "text": "The Penns Park Historic District, with more than a dozen 18th‑ and 19th‑century homes, was listed on the National Register of Historic Places in 1986.",
      "sourceSentenceIds": [
        21,
        8
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Penns_Park%2C_Pennsylvania"
    },
    {
      "id": 6,
      "text": "Every summer, residents celebrate the village’s heritage with a tractor parade, classic fair food, and a chainsaw carving contest.",
