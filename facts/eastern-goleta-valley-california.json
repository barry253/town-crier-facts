        14
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://goletahistory.org/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The valley hosts Sundays at the Ranch with barn animals, tractor rides, and outdoor fun.",
