  "facts": [
    {
      "id": 1,
      "text": "Goleta Valley Historical Society began modestly in 1967, taking stewardship of Rancho La Patera, the Stow family ranch.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://goletahistory.org/"
    },
    {
      "id": 2,
      "text": "Rancho La Patera, listed on the National Register, lets visitors experience early 20th‑century life.",
      "sourceSentenceIds": [
        14
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://goletahistory.org/"
    },
    {
      "id": 3,
      "text": "The valley hosts Sundays at the Ranch with barn animals, tractor rides, and outdoor fun.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://goletahistory.org/"
    },
    {
      "id": 4,
      "text": "The Stow House and South Coast Railroad Museum are preserved landmarks connecting to the valley’s past.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://phase3projects.com/_clients/gvhs/index.html"
    },
    {
      "id": 5,
      "text": "The valley lies between Goleta, Santa Barbara, the Pacific, and the Santa Ynez Mountains.",
      "sourceSentenceIds": [
        29
