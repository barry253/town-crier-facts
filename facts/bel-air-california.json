  "facts": [
    {
      "id": 1,
      "text": "Bel Air was founded in 1923 by oil tycoon Alphonzo Bell, who parceled out 600 acres of west Los Angeles land.",
      "sourceSentenceIds": [
        7,
        2,
        3
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1",
        "Web source 2"
      ],
      "source": "https://en.wikipedia.org/wiki/Bel_Air%2C_Los_Angeles"
    },
    {
      "id": 2,
      "text": "The name Bel‑Air means “Beautiful Air,” a blend of the Mexican grant’s Spanish title and the Italian word bellissima.",
      "sourceSentenceIds": [
        12,
        13
      ],
      "sourceLabels": [
        "Web source 1",
        "Web source 2"
      ],
      "source": "https://www.belairassociation.org/history/"
    },
    {
      "id": 3,
      "text": "In 1927 the Hotel Bel‑Air began as the Bell estate planning office before becoming a luxury hotel.",
      "sourceSentenceIds": [
        16
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.belairassociation.org/history/"
    },
    {
      "id": 4,
      "text": "The Bel‑Air Association, the neighborhood’s civic group, was established in 1942 to preserve its character.",
      "sourceSentenceIds": [
        16
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.belairassociation.org/history/"
    },
    {
      "id": 5,
      "text": "Despite Bell’s early rule against selling homes to Hollywood actors, the area later became home to many famous stars.",
      "sourceSentenceIds": [
        17
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.belairassociation.org/history/"
    },
    {
      "id": 6,
      "text": "Bel‑Air sits beside Beverly Hills and Holmby Hills, together forming Los Angeles’s Platinum Triangle of upscale neighborhoods.",
      "sourceSentenceIds": [
        28
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Bel_Air%2C_Los_Angeles"
    }
  ]
