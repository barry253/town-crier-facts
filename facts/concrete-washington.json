  "facts": [
    {
      "id": 1,
      "text": "Concrete earned its name when two neighboring cement towns merged in 1909, choosing the industry’s moniker to honor the Washington Portland Cement Company.",
      "sourceSentenceIds": [
        1,
        5,
        16
      ],
      "sourceLabels": [
        "Web source 2",
        "Wikipedia"
      ],
      "source": "https://www.townofconcrete.com/about/",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The Henry Thompson Bridge, finished 1916‑18, crosses the Skagit River and commemorates a settler killed by a logging train.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Concrete%2C_Washington",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Every May, Concrete hosts the Mountain Film Festival, a three‑day celebration of mountain life and outdoor recreation.",
      "sourceSentenceIds": [
        13
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://concrete-wa.com/",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Concrete’s Historic Preservation and Landmarks Commission meets monthly on the fourth Wednesday at 6 p.m. in Town Hall.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.townofconcrete.com/about/",
      "category": "other",
      "quality": "poor",
      "qualityReason": "other"
    },
    {
      "id": 5,
      "text": "Concrete sits in the North Cascades, just southeast of Mount Baker and almost directly south of Mount Shuksan.",
      "sourceSentenceIds": [
        18,
        19
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Concrete%2C_Washington",
      "category": "other",
      "quality": "poor",
      "qualityReason": "location_description"
    },
    {
      "id": 6,
      "text": "The town is restoring the historic Superior Building, a landmark that once housed the Washington Portland Cement Company’s factory.",
