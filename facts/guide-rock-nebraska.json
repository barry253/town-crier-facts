  "facts": [
    {
      "id": 1,
      "text": "Guide Rock takes its name from the nearby Pa‑hur bluff, a Pawnee “hill that points the way” that guided early trappers and settlers.",
      "sourceSentenceIds": [
        1,
        3
      ],
      "sourceLabels": [
        "Web source 1",
        "Web source 2"
      ],
      "source": "https://www.visitredcloud.com/government/village-guide-rock",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The first recorded homestead in the area was filed by Samuel Giger on May 30, 1870, marking the start of settlement.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/guide_rock_nebraska",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "When the Burlington & Missouri River Railroad arrived between 1878 and 1880, Guide Rock moved to a new site to house the depot and spur growth.",
      "sourceSentenceIds": [
        5,
        7
      ],
      "sourceLabels": [
        "Web source 2",
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/guide_rock_nebraska",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "A historical marker near the village commemorates the former site of a large Pawnee village that once thrived in the area.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Guide_Rock%2C_Nebraska",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The Auld‑Doudna Library, a gift from former banker Wm., houses an extensive newspaper collection that dates back to the early 20th century.",
      "sourceSentenceIds": [
        15,
        16
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.visitredcloud.com/government/village-guide-rock",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Guide Rock was officially platted in 1873, setting the stage for its later incorporation as a village.",
