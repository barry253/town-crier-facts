      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Chinese miners kept Dogtown alive for nearly a decade after most European miners left for Monoville in 1859.",
      "sourceSentenceIds": [
        25,
        30
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://unitedstatesghosttowns.com/dogtown-california-ghost-town/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Today visitors can see stone hovel remnants, a historic cemetery, and try panning for gold in Dogtown Creek.",
      "sourceSentenceIds": [
        26
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://unitedstatesghosttowns.com/dogtown-california-ghost-town/",
