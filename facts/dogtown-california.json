      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town’s name changed from Woodville to Dogtown, a shift highlighted by early settlers.",
      "sourceSentenceIds": [
        2,
        3
      ],
      "sourceLabels": [
        "Web source 1"
      ],
