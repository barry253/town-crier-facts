  "facts": [
    {
      "id": 1,
      "text": "Candler, once called Candlertown, sprang up in the late 1800s when the Western North Carolina Railroad reached the Hominy Valley.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/Candler,_North_Carolina"
    },
    {
      "id": 2,
      "text": "Nestled in Hominy Valley, Candler sits roughly midway between Asheville and Canton at an elevation of 2,122.7 feet.",
      "sourceSentenceIds": [
        13,
        15
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Candler%2C_North_Carolina"
    },
    {
      "id": 3,
      "text": "The town’s elevation directs water flow toward Hominy Creek and the French Broad River, while Candler Knob rises 4,548 feet nearby.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/Candler,_North_Carolina"
    },
    {
      "id": 4,
      "text": "The Enka Clock Tower stands as a historic reminder of Candler’s once‑thriving industrial past.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/Candler,_North_Carolina"
    },
    {
      "id": 5,
      "text": "Candler enjoys a humid subtropical climate with four distinct seasons, mild summers and cool winters shaped by its Blue Ridge location.",
      "sourceSentenceIds": [
        11
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/Candler,_North_Carolina"
    },
    {
      "id": 6,
      "text": "Candler is officially part of the Asheville metropolitan area, linking it to North Carolina’s largest city.",
