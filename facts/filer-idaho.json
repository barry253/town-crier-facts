  "facts": [
    {
      "id": 1,
      "text": "Filer is named after Walter Filer, a mining engineer who oversaw building the Milner diversion dam on the Snake River.",
      "sourceSentenceIds": [
        1,
        6
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Filer%2C_Idaho",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Filer was founded in 1906 as the western terminus of the Oregon Short Line railroad branch that extended from Twin Falls.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Filer%2C_Idaho",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Since 1916, Filer has hosted the Twin Falls County Fair and Rodeo, also called the Magic Valley Stampede.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Filer%2C_Idaho",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The Twin Falls County Fair takes place in Filer every first week of September.",
