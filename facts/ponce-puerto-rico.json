  "facts": [
    {
      "id": 1,
      "text": "Ponce, founded August 12 1692, takes its name from Juan Ponce de León y Loayza, the great‑grandson of the famed conquistador.",
      "sourceSentenceIds": [
        1,
        6
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Ponce%2C_Puerto_Rico",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "In 2020, the National Trust for Historic Preservation listed Ponce’s Historic Zone among America’s most endangered historic places.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Ponce%2C_Puerto_Rico",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Along Calle 25 de Enero, Ponce’s red‑and‑black firefighter houses remain owned by descendants, offering a scenic glimpse into the city’s past.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Ponce%2C_Puerto_Rico",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The Museo de Arte de Ponce, opened in 1959 by Luis A., showcases Caribbean art and anchors the city’s cultural scene.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Ponce%2C_Puerto_Rico",
      "category": "culture",
      "quality": "poor",
      "qualityReason": "unverified=['ferrer']"
    },
    {
      "id": 5,
      "text": "Every July, Ponce hosts a Bomba and Plena festival, where musicians parade through streets, celebrating the city’s vibrant Afro‑Puerto Rican rhythms.",
      "sourceSentenceIds": [
        20
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Ponce%2C_Puerto_Rico",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "In May, the Ponce Grand Prix draws over 100 track‑and‑field athletes, turning the city’s streets into a temporary stadium.",
      "sourceSentenceIds": [
        24
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
