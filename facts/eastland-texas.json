  "facts": [
    {
      "id": 1,
      "text": "County voters moved the county seat from Merriman to the newly platted site, naming it Eastland because it lay closer to the county center.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://eastlandtexas.gov/history"
    },
    {
      "id": 2,
      "text": "Early promoters gave a quarter of Eastland’s lots to the Texas and Pacific Railway, and the first train rolled through in 1880.",
      "sourceSentenceIds": [
        5,
        6
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://texastimetravel.com/directory/eastland-tour/"
    },
    {
      "id": 3,
      "text": "By 1914 Eastland boasted two banks, telephone service, and a public library.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://eastlandtexas.gov/history"
    },
    {
      "id": 4,
      "text": "In 1928 the current courthouse was built, and a local lizard named 'Old Rip' gained national fame before dying in 1929 and being displayed in the courthouse.",
      "sourceSentenceIds": [
        15,
        16,
        17
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Eastland%2C_Texas"
    },
    {
      "id": 5,
      "text": "Eastland sits 96 miles west‑southwest of Fort Worth and 55 miles east of Abilene, north of the county’s center.",
      "sourceSentenceIds": [
        18
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Eastland%2C_Texas"
    },
    {
      "id": 6,
      "text": "Eastland experiences hot, humid summers and generally mild to cool winters in the Texas heartland.",
