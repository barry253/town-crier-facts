  "facts": [
    {
      "id": 1,
      "text": "Beaconsfield sprang to life in 1881 when the Humeston and Shenandoah Railroad built a station, drawing settlers to the new village.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/Beaconsfield,_Iowa",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town was officially incorporated on January 18, 1900, giving it its own city council and local governance.",
      "sourceSentenceIds": [
        13
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/Beaconsfield,_Iowa",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Beaconsfield’s name honors Benjamin Disraeli, the 1st Earl of Beaconsfield and former British Prime Minister.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/Beaconsfield,_Iowa",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The original Beaconsfield Supply Store, opened in 1930 by Charles Hyde and David Vredenburg, is the birthplace of the Hy‑Vee grocery chain.",
      "sourceSentenceIds": [
        19
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Beaconsfield%2C_Iowa",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "A historic commercial building in Beaconsfield earned a spot on the National Register of Historic Places in 2007 for its role in local commerce and Hy‑Vee’s early history.",
      "sourceSentenceIds": [
