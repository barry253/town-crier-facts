      "quality": "good"
    },
    {
      "id": 2,
      "text": "Local activists call the Clover Creek Watershed an “orphan” because no tribe or government body is responsible for its health.",
      "sourceSentenceIds": [
        3,
        15
      ],
      "sourceLabels": [
        "Web source 1"
