  "facts": [
    {
      "id": 1,
      "text": "Hartstown began as a crossroads community in the early 1800s, founded by James Hart who patented land and sold lots by 1830.",
      "sourceSentenceIds": [
        1,
        25
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/hartstown_pennsylvania",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town’s name evolved from \"Hart's Town\" (1837) to Hartford on an 1839 map, settling on Hartstown by 1848.",
      "sourceSentenceIds": [
        17,
        28
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/hartstown_pennsylvania",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The 1913 Pymatuning Act spurred a reservoir project nearby; construction began 1931 and finished 1934, creating a 17,000‑acre lake that now supports recreation.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/hartstown_pennsylvania",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "James White House, once listed on the National Register of Historic Places in 1980, was removed from the register in 2004.",
