  "facts": [
    {
      "id": 1,
      "text": "Cambridge was platted in November 1856 by Josiah Chandler, who named it after Cambridge, England.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/cambridge_iowa",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The arrival of the Paul Railroad in 1869 spurred mills, creameries, and farms that still define the town.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/cambridge_iowa",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Norwegian immigrants began arriving around 1860, establishing Lutheran churches that shaped Cambridge's cultural identity.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/cambridge_iowa",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The Cambridge Historical Association published \"Cambridge, Iowa: The First 150 Years\" in 2006 to celebrate the town's sesquicentennial.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/cambridge_iowa",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The Cambridge City Center houses the Cambridge Memorial Library, founded in 1946, and a versatile events hall used for community gatherings.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/cambridge_iowa",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Cambridge is part of the Ames, Iowa Metropolitan Statistical Area, which is within the larger Ames‑Boone Combined Statistical Area.",
