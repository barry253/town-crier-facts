  "facts": [
    {
      "id": 1,
      "text": "Blakely Township, formed in 1818, was named for War of 1812 hero Johnston Blakely, who captained the sloop Wasp against the British brig‑sloop Avon.",
      "sourceSentenceIds": [
        1,
        2
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Blakely%2C_Pennsylvania",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The Borough of Blakely was established on August 27, 1867, as the first borough carved from Blakely Township.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Blakely%2C_Pennsylvania",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The Lackawanna River winds through Blakely, and the borough contains the historic village of Peckville.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Blakely%2C_Pennsylvania",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Blakely Borough Recreation Complex sits on the riverbank, offering sports facilities that have hosted community events for decades.",
      "sourceSentenceIds": [
        15
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Blakely%2C_Pennsylvania",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "In the 1970s, Blakely housed Masterpiece Inc., the seventh‑largest producer of artificial Christmas trees nationwide.",
