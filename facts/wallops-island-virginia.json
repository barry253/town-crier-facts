  "facts": [
    {
      "id": 1,
      "text": "Wallops Island proper, originally called Kegotank Island, was granted to John Wallop by the Crown on April 29, 1692.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Wallops_Island",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The first rocket launch from Wallops Island occurred on June 27, 1945, marking the start of a 75‑year history of space exploration.",
      "sourceSentenceIds": [
        2,
        3
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.nasa.gov/wallops/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Wallops Island spans six square miles and lies just south of the tourist‑popular Chincoteague Island.",
      "sourceSentenceIds": [
        8,
        9
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Wallops_Island",
      "category": "other",
      "quality": "poor",
      "qualityReason": "vague"
    },
    {
      "id": 4,
      "text": "The National Advisory Committee for Aeronautics leased 1,000 acres of the island for rocket launching, a precursor to NASA’s Wallops Flight Facility.",
      "sourceSentenceIds": [
        16
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Wallops_Island",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The island hosts the Wallops Visitor Center, where exhibits showcase spacecraft and technology developed at the Wallops Flight Facility.",
      "sourceSentenceIds": [
        21
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.nasa.gov/wallops/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "A wildlife refuge and the Chincoteague Bay Field Station occupy parts of Wallops Island, preserving its natural habitats.",
