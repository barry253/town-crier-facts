  "facts": [
    {
      "id": 1,
      "text": "The 10th arrondissement hosts two of Paris’s busiest railway termini, Gare du Nord and Gare de l’Est, both built in the 19th century.",
      "sourceSentenceIds": [
        6,
        14
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/10th_arrondissement_of_Paris",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Canal Saint‑Martin, created in the early 1800s to aid transport, now winds through the 10th, lined with trees and footbridges.",
      "sourceSentenceIds": [
        4,
        24,
        15
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://culturetravel.com/10th-arrondissement-paris/",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The area earned the nickname “l’Entrepôt” because it once housed many warehouses along the Seine.",
      "sourceSentenceIds": [
        13,
        17
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/10th_arrondissement_of_Paris",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Alhambra Theatre, opened in the 19th century, remains a historic cultural landmark in the 10th arrondissement.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.about-paris.com/10th-arrondissement.html",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Hospital Saint‑Louis, founded by King Louis IX in the 17th century, showcases architectural heritage within the 10th.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.about-paris.com/10th-arrondissement.html",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The 10th is called “La Petite Turquie” thanks to its large Turkish community, giving the area a vibrant multicultural vibe.",
      "sourceSentenceIds": [
