  "facts": [
    {
      "id": 1,
      "text": "Bay Hill began as former tangerine groves in the Dr., before evolving into the residential community seen today.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/Bay_Hill,_Florida",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "By 1975, Palmer became the principal owner, turning the club from a modest golf facility into a premier destination.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/Bay_Hill,_Florida",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Palmer made Bay Hill his winter retreat from the 1970s until his death in 2016, adding prestige to the area.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/Bay_Hill,_Florida",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Arnold Palmer’s Bay Hill Club & Lodge, a historic golf resort, remains the centerpiece of the community and is still owned by his family.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/Bay_Hill,_Florida",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Bay Hill sits on either side of Apopka‑Vineland Road, north of Lake Buena Vista and south of Windermere.",
      "sourceSentenceIds": [
