  "facts": [
    {
      "id": 1,
      "text": "Yarmouth's historic village Main Street hosts homes from the 1700s, cafés, and shops, reflecting its shipbuilding past.",
      "sourceSentenceIds": [
        28
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://yarmouthmaine.org/about-yarmouth/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The Royal River’s Second, Third, and Fourth Falls line the town, offering scenic views just west of Bridge Street and near East Elm.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Yarmouth%2C_Maine",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Yarmouth’s Riverside Cemetery, founded 1869, contains graves of early business owners like Leon Gorman and is listed on the National Register.",
      "sourceSentenceIds": [
        8,
        21
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Yarmouth%2C_Maine",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The Yarmouth History Center at 118 East Elm Street houses an interpretive gallery that traces the region from pre‑settlement to today.",
      "sourceSentenceIds": [
        30
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://yarmouthmaine.org/about-yarmouth/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "In 1946, the Village Improvement Society preserved the interior of the historic meeting house, a gesture that continues to honor Yarmouth’s heritage.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Yarmouth%2C_Maine",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Yarmouth’s railroad heritage includes two junctions—Royal Junction on Greely Road and Yarmouth Junction near Depot Road—once serving the Maine Central Railroad.",
      "sourceSentenceIds": [
        14
      ],
