  "facts": [
    {
      "id": 1,
      "text": "Melvindale was named after Melvin Wilkinson, one of the original developers of the settlement.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Melvindale%2C_Michigan",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The area that is now Melvindale began as the unincorporated settlement of Oakwood Heights in the early 1920s.",
      "sourceSentenceIds": [
        4,
        7
      ],
      "sourceLabels": [
        "Web source 2",
        "Wikipedia"
      ],
      "source": "https://www.waynecountymi.gov/Government/Departments/Economic-Development/Our-Communities/Melvindale",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "In 1922 the eastern part of Oakwood Heights was annexed by Detroit, while the rest became the village of Melvindale the same year.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Melvindale%2C_Michigan",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Melvindale officially incorporated as a city in 1933 after growing from its village roots.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Melvindale%2C_Michigan",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The city has long been a key hub for railroad traffic in Metro Detroit, shaping its early economy.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Melvindale%2C_Michigan",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Melvindale sits within Wayne County, the same county that contains Detroit and the heart of Michigan’s automotive industry.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
