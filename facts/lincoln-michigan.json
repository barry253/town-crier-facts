  "facts": [
    {
      "id": 1,
      "text": "Lincoln's historic train depot, built in 1886 by the Detroit, Bay City and Alpena Railroad, is the last remaining depot of its type in northeastern Michigan.",
      "sourceSentenceIds": [
        1,
        6
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Lincoln%2C_Michigan",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The village was originally called West Harrisville and was renamed Lincoln when Gustin and Hawes Townships incorporated the area in 1886.",
      "sourceSentenceIds": [
        3,
        4
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://villageoflincoln.com/",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Lincoln sits on the boundary between Gustin Township to the south and Hawes Township to the north, overlooking Brownlee Lake and Lincoln Lake.",
      "sourceSentenceIds": [
        13,
        14
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Lincoln%2C_Michigan",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The annual Alcona County Fair, held near the end of August, takes place at the Alcona Recreation Area in downtown Lincoln.",
      "sourceSentenceIds": [
        29
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Lincoln%2C_Michigan",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The downtown Lincoln Train Depot now houses the Alcona Historical Society, which hosts Depot Days, a fundraising event for the community.",
