      ],
      "source": "https://en.wikipedia.org/wiki/Little_Rock%2C_Arkansas",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The Historic Arkansas Museum and the MacArthur Museum together showcase frontier life and the birthplace of General Douglas MacArthur.",
      "sourceSentenceIds": [
