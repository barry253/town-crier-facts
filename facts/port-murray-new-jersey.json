  "facts": [
    {
      "id": 1,
      "text": "Port Murray was named after Colonel James Boyles Murray, third president of the Morris Canal and Banking Company.",
      "sourceSentenceIds": [
        15
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Port_Murray%2C_New_Jersey",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The village grew around the Morris Canal opened 1831 and the Morris and Essex Railroad built 1850, making it a transportation hub.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.livingplaces.com/NJ/Warren_County/Mansfield_Township/Port_Murray_Historic_District.html",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The Port Murray Historic District, added to the National Register in 1996, showcases vernacular architecture from early 19th to early 20th century.",
      "sourceSentenceIds": [
        21,
        26
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 2"
      ],
      "source": "https://en.wikipedia.org/wiki/Port_Murray%2C_New_Jersey",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The first school in the area opened in 1841, serving the growing community.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.livingplaces.com/NJ/Warren_County/Mansfield_Township/Port_Murray_Historic_District.html",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Historic Beattystown, once Beaty's Mill, was settled by the 1760s, predating the village’s canal era.",
      "sourceSentenceIds": [
