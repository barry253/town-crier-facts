      ],
      "source": "https://en.wikipedia.org/wiki/Rothville%2C_Missouri",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The village was officially laid out in 1883, marking the beginning of its formal development.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Rothville%2C_Missouri",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "A post office opened in Rothville in 1868, long before the town was formally established.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Rothville%2C_Missouri",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Famed author Laura Ingalls‑Wilder lived briefly in Rothville from 1868 to 1869 on land within the town’s borders.",
      "sourceSentenceIds": [
        10
