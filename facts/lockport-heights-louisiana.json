  "facts": [
    {
      "id": 1,
      "text": "Lockport was named for the canal locks that linked Bayou Lafourche to New Orleans, boosting shipping in the 1800s.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.lacajunbayou.com/about/towns-in-lafourche-parish/lockport"
    },
    {
      "id": 2,
      "text": "The canal, finished in 1847, brought prosperity, and by 1850 locks were completed where it met Bayou Lafourche.",
      "sourceSentenceIds": [
        3,
        10
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://townoflockport.com/about-us/history/"
    },
    {
      "id": 3,
      "text": "An iron bridge over Bayou Lafourche, built around 1900, linked Lockport to Rita and caused a stir among residents.",
      "sourceSentenceIds": [
        19,
        20,
        21
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://townoflockport.com/about-us/history/"
    },
    {
      "id": 4,
      "text": "Lockport’s first public school opened in 1849, a one‑room classroom in Scanian’s Cooperage.",
      "sourceSentenceIds": [
        16,
        17
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://townoflockport.com/about-us/history/"
    },
    {
      "id": 5,
      "text": "The 1876 crevasse partially destroyed the locks, yet remnants of the brick bulwark still lie beneath weeds.",
      "sourceSentenceIds": [
        13,
        14
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://townoflockport.com/about-us/history/"
    },
    {
      "id": 6,
      "text": "Today Lockport keeps its small‑town charm while honoring its history as a vital waterway hub in Louisiana’s Cajun Bayou region.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
