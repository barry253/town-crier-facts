  "facts": [
    {
      "id": 1,
      "text": "Glade Spring’s name comes from the Indian word Passawatami meaning “this is the place.”.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Glade_Spring%2C_Virginia",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town grew around the railroad; the depot moved in 1856 and the town became a shipping hub for produce and livestock.",
      "sourceSentenceIds": [
        4,
        5
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Glade_Spring%2C_Virginia",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The Glade Spring Commercial Historic District, the town’s 19th‑century core, is listed on the National Register of Historic Places.",
      "sourceSentenceIds": [
        8,
        26
      ],
      "sourceLabels": [
        "Web source 2",
        "Wikipedia"
      ],
      "source": "https://www.dhr.virginia.gov/historic-registers/222-0001/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "During the Civil War, local men formed the Glade Spring Rifles and federal and Confederate troops marched through, leaving cannon emplacements still visible.",
      "sourceSentenceIds": [
        15,
        16
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Glade_Spring%2C_Virginia",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "In 2011 an EF‑3 tornado struck Glade Spring, killing three people and injuring many; the event was part of the larger Super Outbreak.",
      "sourceSentenceIds": [
        23,
