  "facts": [
    {
      "id": 1,
      "text": "Whaleyville was founded in the early 19th century and named after James Whaley, a local landowner.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://nearbylens.com/cities/usa/md/whaleyville/",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The village traces its origins to 1859, when land deeds referenced property “situate in the village of Whaleyville,” and the Whaley family were central merchants and officials.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/whaleyville_maryland",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "During World War II, German POWs worked at a local tomato cannery in 1944, helping keep the town’s agriculture running.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/whaleyville_maryland",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The Whaleyville Store, a single‑story wood‑shingled frame building erected around 1850, still stands at the village center.",
      "sourceSentenceIds": [
        14
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/whaleyville_maryland",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Whaleyville lies within the Salisbury, Maryland‑Delaware Metropolitan Statistical Area and serves as a small rural hub centered around agriculture and historic mercantile activities.",
      "sourceSentenceIds": [
        16
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/whaleyville_maryland",
