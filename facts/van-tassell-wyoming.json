  "facts": [
    {
      "id": 1,
      "text": "Van Tassell is the least populous town in the least populous county of the least populous state in the U.S.",
      "sourceSentenceIds": [
        26
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Van_Tassell%2C_Wyoming"
    },
    {
      "id": 2,
      "text": "Railroad officials named the town after Van Rensselaer Schuyler Van Tassell, a prominent cattle rancher who owned the surrounding lands since 1880.",
      "sourceSentenceIds": [
        1,
        10
      ],
      "sourceLabels": [
        "Web source 1",
        "Web source 2"
      ],
      "source": "https://unitedstatesghosttowns.com/van-tassell-wyoming-ghost-town/"
    },
    {
      "id": 3,
      "text": "Van Tassell holds the unique historical distinction of organizing the very first American Legion post in the United States on June 28, 1919.",
      "sourceSentenceIds": [
        23
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://wakeupwyo.com/van-tassell-wyoming-history/"
    },
    {
      "id": 4,
      "text": "Historic remnants of the town's prosperous past include Woodman Hall, the Buckaroo Bar, and the Van Tassell Cooperative Creamery.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://unitedstatesghosttowns.com/van-tassell-wyoming-ghost-town/"
    },
    {
      "id": 5,
      "text": "A post office operated in Van Tassell for over a century, from its establishment in 1910 until it closed in 2017.",
