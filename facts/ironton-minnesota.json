  "facts": [
    {
      "id": 1,
      "text": "Ironton's name comes from the Cuyuna Iron Range, the very ore that built the town.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Ironton%2C_Minnesota"
    },
    {
      "id": 2,
      "text": "Ironton was platted in September 1910 and incorporated the following year, with its post office opening the same year.",
      "sourceSentenceIds": [
        9,
        10
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Ironton%2C_Minnesota"
    },
    {
      "id": 3,
      "text": "Immigrants from northern and southern Europe settled in Ironton to work the manganese‑rich iron ore that fueled its early growth.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://cityofironton.org/welcome"
    },
    {
      "id": 4,
      "text": "After mining shut down in the 1980s, Ironton’s former mine pits became scenic lakes now part of the Cuyuna Country State Recreation Area.",
      "sourceSentenceIds": [
        25,
        26
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://cityofironton.org/welcome"
    },
    {
      "id": 5,
      "text": "Ironton invites walkers, bikers, hikers, and kayakers to explore its historic iron‑ore mining trails and surrounding lakes.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://cityofironton.org/welcome"
    },
    {
      "id": 6,
      "text": "Ironton's mine lakes host northern pike, walleye, bass, crappie, and sunfish, and are stocked with trout each year.",
      "sourceSentenceIds": [
        29,
        30
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://cityofironton.org/welcome"
    }
  ]
}
