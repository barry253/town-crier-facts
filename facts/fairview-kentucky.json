  "facts": [
    {
      "id": 1,
      "text": "Fairview’s name came from a local resident’s suggestion, while the town’s early growth was linked to the nearby railroad.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://fairview.ky.gov/",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Fairview is best known as the birthplace of Jefferson Davis, the future Confederate president, and hosts his historic site.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Fairview%2C_Kentucky",
      "category": "people",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Construction of the Jefferson Davis State Historic Site began in 1917, preserving the legacy of the town’s most famous resident.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Fairview%2C_Kentucky",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Samuel Davis, a Revolutionary War veteran, likely founded Fairview around 1793 on the Todd County side.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Fairview%2C_Kentucky",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Fairview was incorporated on February 6, 1846, and its post office opened on the Christian County side that June.",
      "sourceSentenceIds": [
        13
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Fairview%2C_Kentucky",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The original U.S. Route 68 ran through Fairview, but the new alignment bypasses the town, leaving the old road named Jefferson Davis Road.",
      "sourceSentenceIds": [
        19
