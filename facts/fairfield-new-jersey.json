  "facts": [
    {
      "id": 1,
      "text": "Fairfield once hosted the world’s most famous Naval Rifle Range, a dairy and milk processing operation, and a mineral water well.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.07004history.com/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The first settlement in what is now Western Essex County began in Fairfield, where the first religious congregation was organized.",
      "sourceSentenceIds": [
        19
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.07004history.com/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "A local history collection published by the Fairfield Historical Society contains more articles than any other book in the Fairfield Library.",
      "sourceSentenceIds": [
        1,
        2
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.07004history.com/",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The Fairfield Public Library offers a bibliography of ten local history books, many of which are available on its shelves.",
      "sourceSentenceIds": [
        4,
        5
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.07004history.com/",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "At one point, New Jersey planners considered flooding Fairfield to create a reservoir that would have erased the township’s historic sites.",
      "sourceSentenceIds": [
        20,
        21
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.07004history.com/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Adelia Van Ness Collerd, a Fairfield native, wrote the original “This WAS Fairfield” column for the local Chronicle.",
