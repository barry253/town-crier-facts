  "facts": [
    {
      "id": 1,
      "text": "Lake City was founded in 1873 when the Paris and Decatur Railroad arrived, and the village was platted on donated land, quickly becoming a grain‑shipping hub.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/lake_city_illinois",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Lake City takes its name from a land donor who gave 20 acres on section 12, after whom the town is named.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/lake_city_illinois",
      "category": "people",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The first grain office opened in 1873, followed by a 10,000‑bushel elevator in 1874 that could handle the region’s corn.",
      "sourceSentenceIds": [
        20,
        21
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/lake_city_illinois",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "A one‑room schoolhouse was built in 1876 for $800, serving Lake City’s early students.",
      "sourceSentenceIds": [
        22
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/lake_city_illinois",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "In 1880 the village chartered Silver Spring Lodge No. 13 of the Independent Order of Good Templars, with 45 members.",
      "sourceSentenceIds": [
        23,
        24
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/lake_city_illinois",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Lake City sits in the drainage basin of Stringtown Branch, which feeds the West Okaw River in the Kaskaskia watershed.",
      "sourceSentenceIds": [
        16
      ],
