    {
      "id": 2,
      "text": "In 1883, Thigpen was promised the station agent role on the Texas and New Orleans Railroad if he promoted the town.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 1"
      ],
