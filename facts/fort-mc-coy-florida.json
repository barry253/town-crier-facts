  "facts": [
    {
      "id": 1,
      "text": "Fort McCoy, a military installation in Florida, was originally named Fort Mackay in the early 20th century.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Fort_McCoy%2C_Florida",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The Fort McCoy Commemorative Area spans 10 acres and opened its History Center in 1999 during the 90th anniversary.",
      "sourceSentenceIds": [
        2,
        15
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.army.mil/article/292576/fort_mccoy_commemorative_area_preserves_army_heritage_showcases_installation_history_through_unique_exhibits_artifacts",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Veterans Memorial Plaza was dedicated June 13, 2009 during Fort McCoy’s centennial celebration.",
      "sourceSentenceIds": [
        21
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.army.mil/article/292576/fort_mccoy_commemorative_area_preserves_army_heritage_showcases_installation_history_through_unique_exhibits_artifacts",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The History Center displays artifacts from World War I through Operation Allies Welcome, covering every major conflict since 1914.",
      "sourceSentenceIds": [
        16
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.army.mil/article/292576/fort_mccoy_commemorative_area_preserves_army_heritage_showcases_installation_history_through_unique_exhibits_artifacts",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "A century‑old wooden crate donated by Robert Bruce McCoy, bearing original Camp Emery Upton and Camp Robinson markings, is on display as one of the earliest artifacts.",
      "sourceSentenceIds": [
        25,
        26
      ],
      "sourceLabels": [
