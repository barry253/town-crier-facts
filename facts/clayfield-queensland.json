  "facts": [
    {
      "id": 1,
      "text": "Clayfield’s name comes from the fine white‑grey clay mined in Albion, used for bricks near Sandgate Road.",
      "sourceSentenceIds": [
        14
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Clayfield%2C_Queensland",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The suburb once hosted “the clay fields”, a brick‑making industry that spurred European settlement of inner‑north Brisbane.",
      "sourceSentenceIds": [
        15
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Clayfield%2C_Queensland",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Clayfield’s early streets were laid out in 1885 when the Sefton Estate, 254 allotments, was auctioned by John Cameron.",
      "sourceSentenceIds": [
        19
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Clayfield%2C_Queensland",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "In 1901 the local congregation chose to become Eagle Junction Congregational Church, avoiding the Methodist amalgamation.",
      "sourceSentenceIds": [
        30
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Clayfield%2C_Queensland",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The area’s first school, Eagle Junction State School, opened in July 1901 after the estate’s development.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Clayfield%2C_Queensland",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Clayfield borders Ascot to the east and Wooloowin to the west, placing it between two historic Brisbane suburbs.",
