      "id": 1,
      "text": "Livingston was named after Scottish explorer David Livingstone, though a misspelling changed the town’s name.",
      "sourceSentenceIds": [
        19,
        20
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
