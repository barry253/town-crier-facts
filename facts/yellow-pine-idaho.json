  "facts": [
    {
      "id": 1,
      "text": "Yellow Pine is a 247‑acre inholder community on the East Fork of the South Fork Salmon River, half a mile upstream from Johnson Creek.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Yellow_Pine%2C_Idaho",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Albert Behne opened Yellow Pine’s first post office in 1906, later patenting the 47½ acres that became the town in 1924 and platting it in 1930.",
      "sourceSentenceIds": [
        13,
        14,
        15
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Yellow_Pine%2C_Idaho",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Original patentees included Oscar Ray Call, Behne’s former mining partner, and Henry Abstein, who homesteaded 160 acres north‑east of the town and planted apple trees still alive today.",
      "sourceSentenceIds": [
        16,
        17,
        18
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Yellow_Pine%2C_Idaho",
      "category": "people",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Yellow Pine historically served as the trade hub for the surrounding mining district, especially the Stibnite Mining District.",
      "sourceSentenceIds": [
        6,
        22
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Yellow_Pine%2C_Idaho",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Every August, the town celebrates its heritage with the Yellow Pine Harmonica Festival on the first weekend of the month.",
      "sourceSentenceIds": [
        28
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Yellow_Pine%2C_Idaho",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Winters bring an average of 104 inches of snow, with a typical snowpack depth of 24 inches reached in February.",
      "sourceSentenceIds": [
        26,
