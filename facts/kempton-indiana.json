      "id": 1,
      "text": "Kempton was founded in 1875 when the Lake Erie and Western Railroad reached the area.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Kempton%2C_Indiana",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The land that became Kempton was owned by David Kemp, the town’s namesake.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Kempton%2C_Indiana",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Early Kempton boasted a tile factory, a canning factory, and a milling company, making it a local industrial hub.",
      "sourceSentenceIds": [
        4,
        5
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Kempton%2C_Indiana",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The first house in Kempton was built by Henry Hays, who also ran a grocery out of the same building.",
      "sourceSentenceIds": [
        11,
        12
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Kempton%2C_Indiana",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "A Methodist Episcopal Church was constructed in Kempton in 1902, adding to the town’s early religious architecture.",
