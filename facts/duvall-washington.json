  "facts": [
    {
      "id": 1,
      "text": "James and Francis Duvall homesteaded the hillside overlooking the Snoqualmie River in the early 1870s, founding what would become Duvall.",
      "sourceSentenceIds": [
        20
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://duvallchamberofcommerce.com/duvalls-history/"
    },
    {
      "id": 2,
      "text": "The town was briefly called Cosgrove after Samuel G. Duvall before adopting the Duvall name in honor of the founding family.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Duvall%2C_Washington"
    },
    {
      "id": 3,
      "text": "The Dougherty Farmstead, a National Historic Landmark, and the famous “big rock” remain popular historic landmarks in Duvall.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://duvallchamberofcommerce.com/duvalls-history/"
    },
    {
      "id": 4,
      "text": "Bob Crossman built the two‑story Valley House in 1892, later a tavern run by Fern Colett that served the early community.",
      "sourceSentenceIds": [
        7,
        8
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://duvallchamberofcommerce.com/duvalls-history/"
    },
    {
      "id": 5,
      "text": "Railroad workers moved the historic train depot from Taylor’s Landing in six weeks, and the last whistle blew in 1973, ending an era.",
      "sourceSentenceIds": [
        21,
        26
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://duvallchamberofcommerce.com/duvalls-history/"
    },
    {
      "id": 6,
      "text": "Boyd’s Grocery, opened in 1912, originally housed a bakery, post office, and grocery store, making it a community hub.",
