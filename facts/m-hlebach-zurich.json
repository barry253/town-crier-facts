  "facts": [
    {
      "id": 1,
      "text": "Mühlebach was first mentioned in 1215 and got its name from the mills that once powered the village.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.myswitzerland.com/en/experiences/events/dorffuehrung-muehlebach/"
    },
    {
      "id": 2,
      "text": "The village is the birthplace of Cardinal Matthäus Schiner, a prominent 15th‑century church figure.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.myswitzerland.com/en/experiences/events/dorffuehrung-muehlebach/"
    },
    {
      "id": 3,
      "text": "Thanks to the lack of disasters, Mühlebach boasts Switzerland’s oldest compact wooden village centre.",
      "sourceSentenceIds": [
        27
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.myswitzerland.com/en/experiences/events/dorffuehrung-muehlebach/"
    },
    {
      "id": 4,
      "text": "Along the old Gommerweg you can see historic wooden buildings, including houses from the 14th to 16th centuries.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.myswitzerland.com/en/experiences/events/dorffuehrung-muehlebach/"
    },
    {
      "id": 5,
      "text": "A chapel built in 1676 crowns a hill, marking the village’s long‑standing religious heritage.",
      "sourceSentenceIds": [
        26
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.myswitzerland.com/en/experiences/events/dorffuehrung-muehlebach/"
    },
    {
      "id": 6,
      "text": "In the 16th century, Mühlebach supplied the provincial governor several times, highlighting its regional importance.",
      "sourceSentenceIds": [
