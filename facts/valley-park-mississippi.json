      "quality": "good"
    },
    {
      "id": 2,
      "text": "The Louisville, New Orleans and Texas Railroad reached Valley Park in 1884, linking Memphis to New Orleans and sparking local growth.",
      "sourceSentenceIds": [
        11,
        17
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/valley_park_mississippi",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "In the early 20th century, Valley Park hosted a Rosenwald‑funded school, reflecting nationwide efforts to educate African American children in rural Mississippi.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Web source 1"
      ],
