  "facts": [
    {
      "id": 1,
      "text": "Coulee City was founded in 1881 and officially incorporated on May 10, 1907.",
      "sourceSentenceIds": [
        1,
        8
      ],
      "sourceLabels": [
        "Web source 1",
        "Wikipedia"
      ],
      "source": "https://couleecitywa.org/"
    },
    {
      "id": 2,
      "text": "The town takes its name from the nearby Grand Coulee, a massive canyon carved by the Columbia River.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Coulee_City%2C_Washington"
    },
    {
      "id": 3,
      "text": "About two miles southwest lies Dry Falls, the site of a catastrophic prehistoric waterfall that once cascaded over 300 feet.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Coulee_City%2C_Washington"
    },
    {
      "id": 4,
      "text": "Coulee City sits on the southern shore of Banks Lake, a man‑made reservoir that stretches 27 miles to Grand Coulee Dam.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Coulee_City%2C_Washington"
    },
    {
      "id": 5,
      "text": "Water from Banks Lake enters irrigation canals that carry it to Billy Clapp Lake and then across the broader Columbia Basin Project.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Coulee_City%2C_Washington"
    },
    {
      "id": 6,
      "text": "U.S. Route 2 cuts through Coulee City from west to east, meeting State Route 17, which runs north‑south through the region.",
      "sourceSentenceIds": [
        11
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
