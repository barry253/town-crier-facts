      "id": 1,
      "text": "Olaria earned its name from the brick and tile factories that flourished on its red clay soil in the 19th century.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/olaria_rio_de_janeiro"
    },
    {
      "id": 2,
      "text": "Olaria once housed the Olaria Slaughterhouse, founded in 1892 by Custódio Nunes, a key industrial hub for the city.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/olaria_rio_de_janeiro"
    },
    {
      "id": 3,
      "text": "The famed Olaria Atlético Clube, founded in 1915, once hosted soccer legends Garrincha and Romário at its Mourão Filho Stadium.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/olaria_rio_de_janeiro"
    },
    {
      "id": 4,
      "text": "The historic Cacique de Ramos samba school, located in Olaria, continues to bring carnival traditions to the neighborhood’s streets.",
      "sourceSentenceIds": [
        15
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/olaria_rio_de_janeiro"
    },
    {
