  "facts": [
    {
      "id": 1,
      "text": "Blounts Creek earned its name from the Blount family, early English settlers who received one of the first land grants in the county in 1697.",
      "sourceSentenceIds": [
        1,
        2
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/blounts_creek_north_carolina",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The creek itself is a tidal waterway that empties into Blounts Bay, a shallow estuary connected to the Pamlico River.",
      "sourceSentenceIds": [
        22
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/blounts_creek_north_carolina",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Blounts Creek’s landscape is dominated by wetlands and marshes, supporting a rich habitat of pine, gum, and oak forests.",
      "sourceSentenceIds": [
        26,
        27
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/blounts_creek_north_carolina",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The historic Blounts Creek Baptist Meeting House, founded in 1808, reflects the community’s long Baptist heritage tied to the Kehukee Association.",
      "sourceSentenceIds": [
        13
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/blounts_creek_north_carolina",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "During the Civil War, Blounts Creek was a site of fighting as part of the Washington Front in 1862 and 1863.",
      "sourceSentenceIds": [
        15
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
