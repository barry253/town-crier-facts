    {
      "id": 1,
      "text": "Cordova got its name from Captain Benjamin M., who renamed the original Dent’s Place after a Mexican city where he served during the Mexican–American War.",
      "sourceSentenceIds": [
        2,
        4,
        7
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 2"
      ],
      "source": "https://en.wikipedia.org/wiki/Cordova%2C_Alabama",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Before it was Cordova, the town sat on the Mulberry Fork of the Black Warrior River as the settlement called Dent’s Place.",
      "sourceSentenceIds": [
        3,
        7
      ],
      "sourceLabels": [
        "Web source 2",
        "Wikipedia"
      ],
      "source": "https://cordovaal.org/history-of-cordova",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Nashua Manufacturing Company’s Indian Head Textile Mills built over 100 houses, a village, and even its own police force in Cordova.",
      "sourceSentenceIds": [
        22,
