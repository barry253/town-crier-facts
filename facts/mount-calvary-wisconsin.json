    {
      "id": 2,
      "text": "Missionary Casper Rehrl chose the location of Mount Calvary because of the large hill's excellent view and placed a wood cross there.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Wikipedia"
