  "facts": [
    {
      "id": 1,
      "text": "Venedy was named after the German town Vene, with “dy” added by founder Brockschmidt.",
      "sourceSentenceIds": [
        28,
        29
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://genealogytrails.com/ill/washington/venedy.html"
    },
    {
      "id": 2,
      "text": "The village’s first church, a frame Lutheran building, was erected in 1841 and replaced by a brick church with a 110‑foot spire in 1861.",
      "sourceSentenceIds": [
        18,
        19
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://genealogytrails.com/ill/washington/venedy.html"
    },
    {
      "id": 3,
      "text": "Brockschmidt donated three acres for church and school, and a 700‑pound anvil from Germany now sits at the village park gateway.",
      "sourceSentenceIds": [
        16,
        22,
        23
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://genealogytrails.com/ill/washington/venedy.html"
    },
    {
      "id": 4,
      "text": "Early settlers in Venedy included families such as Kinyon, Walton, Jones, William, Wilson, Brown, and Dr. Brockschmidt.",
      "sourceSentenceIds": [
        12,
        13,
        14,
        15
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://genealogytrails.com/ill/washington/venedy.html"
    },
    {
      "id": 5,
      "text": "The Lutheran congregation built a historic brick schoolhouse with modern improvements for its time.",
      "sourceSentenceIds": [
        20
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://genealogytrails.com/ill/washington/venedy.html"
    },
    {
      "id": 6,
      "text": "The 700‑pound Brockschmidt anvil is heavier than most modern anvils and was shipped from Germany over a century ago.",
