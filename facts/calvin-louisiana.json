  "facts": [
    {
      "id": 1,
      "text": "The community moved to a level site in 1901–1902 when the Louisiana and Arkansas Railroad extended tracks, shifting from the original Carter location.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/calvin_louisiana",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Renamed Calvin in 1902 to honor Calvin Carter, son of William, who donated right‑of‑way land for a depot built in 1929.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/calvin_louisiana",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "A major sawmill established by John Swanson, along with logging camps, drove Calvin’s boom to about 1,000 residents and six stores by 1906.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/calvin_louisiana",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Calvin Baptist Church organized in 1903, rebuilt in brick in 1968, remains a landmark of community faith.",
      "sourceSentenceIds": [
        24
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/calvin_louisiana",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Calvin High School began as a one‑room schoolhouse in 1903, earned accreditation in 1926, and remains a central community hub.",
      "sourceSentenceIds": [
        24
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/calvin_louisiana",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The Winn Parish Library operates a Calvin Library Branch, providing residents with access to books and community programs.",
