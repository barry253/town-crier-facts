  "facts": [
    {
      "id": 1,
      "text": "Keller was founded in 1898 by Baby Ray Peone, a local fisherman.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Keller%2C_Washington",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town moved several times starting in 1940 because of backwatering from the Grand Coulee Dam, now 18 miles north of the Columbia River.",
      "sourceSentenceIds": [
        20
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Keller%2C_Washington",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The Keller History Museum began in 2012 as a vision of long‑time residents, now a hub showcasing Cross Timbers heritage.",
      "sourceSentenceIds": [
        11
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://kickinitlocal.com/2025/01/17/keller-history-museum-jarvies-house/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Jarvies House, originally at Main and Taylor, faced demolition but now stands in the Keller History Museum, celebrating its centenary in 2026.",
      "sourceSentenceIds": [
        6,
        16
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://kickinitlocal.com/2025/01/17/keller-history-museum-jarvies-house/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "In July 2024, dry lightning ignited the Swawilla Fire southwest of Keller, forcing the Keller Ferry to close and triggering evacuation orders.",
      "sourceSentenceIds": [
        21,
        22,
        23,
        24
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Keller%2C_Washington",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "David Thompson first mentioned the area now Ferry County in 1811, noting a major salmon fishing site at Kettle Falls.",
