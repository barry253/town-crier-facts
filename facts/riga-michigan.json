  "facts": [
    {
      "id": 1,
      "text": "Riga began as Knight’s Station on the Erie & Kalamazoo Railroad in 1844, named after early settler John Knight.",
      "sourceSentenceIds": [
        4,
        5
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://99wfmk.com/riga-michigan/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "In 1851 the station was renamed Riga and quickly became a bustling shipping hub for the region.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://99wfmk.com/riga-michigan/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "A devastating fire in 1908 gutted half the town, destroying the bank, post office, depot, and many stores.",
      "sourceSentenceIds": [
        25
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://99wfmk.com/riga-michigan/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Riga was rebuilt after the fire and today still boasts charming classic buildings that echo its early 20th‑century character.",
      "sourceSentenceIds": [
        26
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://99wfmk.com/riga-michigan/",
      "category": "other",
      "quality": "poor",
      "qualityReason": "editorial_filler"
    },
    {
      "id": 5,
      "text": "The unincorporated community of Riga lies within Riga Township, a civil township of Lenawee County, Michigan.",
