      "id": 1,
      "text": "Berlin sits in the heart of Ohio’s Amish Country, where horse‑drawn buggy rides are a popular way to explore the countryside.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 2"
      ],
