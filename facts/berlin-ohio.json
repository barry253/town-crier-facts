      "category": "culture",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Mel’s Buggy Rides, operated by local guide Mel Gingerich, departs from behind Boyd & Wurthmann Restaurant for a scenic tour of Amish life.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://ohiosamishcountry.com/berlin",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The town’s dining scene blends Amish home‑cooked meals with Italian brick‑oven pizzas and authentic German Stollen bread.",
      "sourceSentenceIds": [
        4,
        5
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.visitberlinohio.com/",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Berlin’s Main Street hosts more than 50 restaurants, inns, hotels, and historic attractions, making it a lively hub for travelers.",
      "sourceSentenceIds": [
        8,
        17
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.visitberlinohio.com/",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Artisan shops in Berlin offer heirloom‑quality Amish furniture, antiques, chocolates, cheeses, and freshly baked goods that showcase local craftsmanship.",
      "sourceSentenceIds": [
        11,
        24
      ],
      "sourceLabels": [
