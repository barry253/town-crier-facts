  "facts": [
    {
      "id": 1,
      "text": "Pennsylvania Furnace was founded in 1813 by John Lyon along Spruce Creek, using local iron ore and limestone.",
      "sourceSentenceIds": [
        13,
        19
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://centrehistory.org/article/pennsylvania-furnace/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The furnace operated continuously until 1888, surviving economic downturns and ownership changes.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://centrehistory.org/article/pennsylvania-furnace/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "By 1820, the furnace employed about seventy men, sparking the growth of a village that became the community of Pennsylvania Furnace.",
      "sourceSentenceIds": [
        23,
        24
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://centrehistory.org/article/pennsylvania-furnace/",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "A single large ore deposit and nearby limestone outcropping made the site ideal for pig iron production, even as other local furnaces closed.",
      "sourceSentenceIds": [
        20,
        28
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://centrehistory.org/article/pennsylvania-furnace/",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The town lies along Pennsylvania Route 45, 9.7 miles southwest of State College.",
