    {
      "id": 1,
      "text": "Arkabutla Dam, authorized by the Flood Control Act of 1928, was completed in 1943 as part of the Yazoo Headwaters Project to tame the 1927 Mississippi flood.",
      "sourceSentenceIds": [
        3,
        10,
        22
      ],
      "sourceLabels": [
        "Web source 1"
      ],
