  "facts": [
    {
      "id": 1,
      "text": "Frankfort’s name comes from pioneer Stephen Frank, who was killed in 1780; the ford was named “Frank’s Ford” in his memory.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Frankfort%2C_Kentucky",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The city houses Kentucky’s only Frank Lloyd Wright house, the Zeigler House, built in 1909.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Frankfort%2C_Kentucky",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The Old State Capitol, a Greek Revival building from the 1830s, sits on the historic downtown core of Frankfort.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://en.wikivoyage.org/wiki/Frankfort_(Kentucky)",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Paul Sawyier Public Library, opened in 1965, honors watercolor artist Paul Sawyier whose paintings document Frankfort’s history.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Frankfort%2C_Kentucky",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Frankfort’s downtown features red‑brick streets lined with boutique shops, galleries, and restaurants that host live music and events.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.bluegrasskentucky.com/destinations/frankfort",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The city’s capital plaza office tower, opened in 1972, became a visual landmark for downtown Frankfort.",
