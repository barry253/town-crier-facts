  "facts": [
    {
      "id": 1,
      "text": "Lloydminster’s name honors Reverend Lloyd, with 'minster' meaning 'mother church,' reflecting the town’s early religious roots.",
      "sourceSentenceIds": [
        1,
        5
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.lloydminster.ca/recreation-culture-community/history-and-heritage/",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Lloydminster uniquely straddles the Alberta–Saskatchewan border, making it one of Canada’s only bi‑provincial cities.",
      "sourceSentenceIds": [
        15
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Lloydminster",
      "category": "other",
      "quality": "poor",
      "qualityReason": "other"
    },
    {
      "id": 3,
      "text": "Meridian Avenue, the city’s main street, runs straight along the Fourth Meridian that became the provincial boundary in 1905.",
      "sourceSentenceIds": [
        4,
        25
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Lloydminster",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "In 1994, a 30‑metre survey marker monument was erected downtown to celebrate Lloydminster’s dual‑province status.",
      "sourceSentenceIds": [
        29
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Lloydminster",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Founded in 1903 by the Barr Colonists from the UK, Lloydminster began as a British utopian settlement focused on sobriety.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Lloydminster",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "In 2000, the city hall shifted from Saskatchewan to an Alberta location on Meridian Avenue, aligning municipal offices with the border.",
      "sourceSentenceIds": [
        30
      ],
      "sourceLabels": [
