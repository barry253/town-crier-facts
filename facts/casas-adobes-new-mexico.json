  "facts": [
    {
      "id": 1,
      "text": "Casas Adobes means \"adobe houses\" in Spanish, reflecting the traditional building material used by early settlers.",
      "sourceSentenceIds": [
        28
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/casas_adobes_new_mexico",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Archaeological evidence shows human occupation in the Mimbres Valley dating back to the Archaic period, around 2000 B.C.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/casas_adobes_new_mexico",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Mimbres artisans crafted black‑on‑white pottery with intricate animal and mythological designs, a hallmark of the region’s pre‑colonial culture.",
      "sourceSentenceIds": [
        22
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/casas_adobes_new_mexico",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "In April 2020, the Grant County Commission officially designated the Casas Adobes subdivision as a colonia under U.S. HUD criteria.",
      "sourceSentenceIds": [
        14
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/casas_adobes_new_mexico",
