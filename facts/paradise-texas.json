  "facts": [
    {
      "id": 1,
      "text": "Paradise began as Eldorado, then renamed Paradise Prairie for its wildflowers before shortening to Paradise.",
      "sourceSentenceIds": [
        22
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.tshaonline.org/handbook/entries/paradise-tx"
    },
    {
      "id": 2,
      "text": "Bill Anderson opened a general store in the early 1870s, sparking the town’s first settlement.",
      "sourceSentenceIds": [
        29
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.tshaonline.org/handbook/entries/paradise-tx"
    },
    {
      "id": 3,
      "text": "A post office branch opened in Paradise in 1876, officially recognizing the community.",
      "sourceSentenceIds": [
        30
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.tshaonline.org/handbook/entries/paradise-tx"
    },
    {
      "id": 4,
      "text": "When the Rock Island railroad arrived in 1893, Paradise moved a mile northeast to become a farmers’ retail hub.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.tshaonline.org/handbook/entries/paradise-tx"
    },
    {
      "id": 5,
      "text": "Old Town Paradise, located at the water tower, is a historic site preserved by the Wise County Historical Society.",
      "sourceSentenceIds": [
        15
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://wisehistory.com/site/old-town-paradise/"
    },
    {
      "id": 6,
      "text": "The Wise County Historical Society is restoring Old Town Paradise to house local artifacts and documents.",
      "sourceSentenceIds": [
        21
