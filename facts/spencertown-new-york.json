      ],
      "source": "https://www.austerlitzny.gov/departments/historian/austerlitz-history-center",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Spencertown Academy, founded in 1847 as one of the first coeducational teacher‑training colleges, now serves as a community arts center hosting concerts and exhibitions.",
