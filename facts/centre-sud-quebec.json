  "facts": [
    {
      "id": 1,
      "text": "The Jacques Cartier Bridge, whose construction began in 1925, opened to traffic on May 14, 1930, becoming a landmark of Centre‑Sud.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Centre-Sud",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Centre‑Sud, once known for poverty and prostitution on Rue Ontario and Rue Dufresne, has seen significant gentrification in recent years.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Centre-Sud",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "In the 1980s, affordable housing drew Montreal’s gay and lesbian community to Centre‑Sud, laying the groundwork for the Gay Village that emerged by the 1990s.",
      "sourceSentenceIds": [
        14,
        15
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Centre-Sud",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The skyline of Centre‑Sud features the Jacques Cartier Bridge, Maison Radio‑Canada, and the Sûreté du Québec headquarters, the former Prison Parthenais.",
      "sourceSentenceIds": [
        18
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Centre-Sud",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Centre‑Sud hosts several shelters, including Dans la Rue for homeless youth, the Old Brewery Mission’s Patricia Mackenzie Pavilion for women, and Refuge des Jeunes for young men.",
      "sourceSentenceIds": [
        19,
        20,
        21
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Centre-Sud",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Main east‑west arteries through Centre‑Sud are Rue Ontario, Boulevard De Maisonneuve, Rue Saint Catherine Est, and Boulevard René Lévesque.",
      "sourceSentenceIds": [
        26
      ],
