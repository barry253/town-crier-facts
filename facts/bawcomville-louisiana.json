    },
    {
      "id": 2,
      "text": "Bawcomville emerged as a distinct community in the late 19th or early 20th century, tied to local agricultural expansion.",
      "sourceSentenceIds": [
        24
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/bawcomville_louisiana"
    },
    {
      "id": 3,
      "text": "Located at 32°30′32″N 92°10′6″W, Bawcomville covers 3.2 square miles of rural‑suburban land dotted with modest single‑family homes and mobile units.",
      "sourceSentenceIds": [
        17
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/bawcomville_louisiana"
    },
    {
      "id": 4,
      "text": "The Redneck Christmas Parade is held annually in Bawcomville, drawing locals for a festive celebration.",
      "sourceSentenceIds": [
        8
