      "quality": "poor",
      "qualityReason": "location_description"
    },
    {
      "id": 2,
      "text": "Andover grew into a historic coal company town during the early 20th‑century mining boom in the Appalachian coalfields.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/andover_virginia",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The Andover School, built around 1920, is a one‑story T‑shaped frame building that remains largely intact.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/andover_virginia",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The Andover Store, a one‑story frame commissary built circa 1915, now serves as storage after becoming vacant.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/andover_virginia",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Perched at 1,676 feet, Andover experiences a humid subtropical climate with hot summers and mild winters.",
      "sourceSentenceIds": [
        14,
        6
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/andover_virginia",
