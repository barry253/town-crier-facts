  "facts": [
    {
      "id": 1,
      "text": "Civitavecchia, once called Centumcellae, means 'hundred cells' and was first mentioned in a 107‑AD letter by Pliny the Younger.",
      "sourceSentenceIds": [
        1,
        20,
        21
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 2"
      ],
      "source": "https://en.wikipedia.org/wiki/Civitavecchia",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Trajan’s 2nd‑century harbor expansion created vaulted cells that still line the port’s breakwater and lighthouse.",
      "sourceSentenceIds": [
        20,
        13
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Civitavecchia",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "During World War II, Allied bombing raids struck Civitavecchia, damaging the city and killing civilians.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Civitavecchia",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The Civitavecchia railway station opened in 1859, becoming the western terminus of the Rome–Civitavecchia line.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Civitavecchia",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Civitavecchia is twinned with Bethlehem, Ishinomaki, and Nantong, showcasing its international friendships.",
      "sourceSentenceIds": [
        5
