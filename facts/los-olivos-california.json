  "facts": [
    {
      "id": 1,
      "text": "Los Olivos was founded after the Pacific Coast Railway arrived in 1887, prompting a land auction that birthed the town.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.losolivosca.com/historical"
    },
    {
      "id": 2,
      "text": "The town’s name comes from a nearby olive tree ranch, and its heritage lives on in historic sites like Mattei’s Tavern.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.visitsyv.com/towns/los-olivos/"
    },
    {
      "id": 3,
      "text": "Mattei’s Tavern, originally the Central Hotel, opened in 1886 and still stands as a Victorian-era landmark.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.losolivosca.com/historical"
    },
    {
      "id": 4,
      "text": "Los Olivos is known for its tree‑lined streets, lush gardens, and beautifully preserved Victorian architecture that dates back more than a century.",
      "sourceSentenceIds": [
        1,
        13
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.losolivosca.com/historical"
    },
    {
      "id": 5,
      "text": "The town’s historic flagpole and Victorian charm trace back to its origins as a stagecoach stop in the 1860s.",
