      ],
      "source": "https://en.wikipedia.org/wiki/Bethnal_Green",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Bethnal Green Road Market, founded in the 18th century, grew into a bustling stall‑filled hub that still thrives today.",
      "sourceSentenceIds": [
        12
