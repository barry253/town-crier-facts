  "facts": [
    {
      "id": 1,
      "text": "Pageton was established as a company town in McDowell County between 1902 and 1909 to house coal mining workers.",
      "sourceSentenceIds": [
        15
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/pageton_west_virginia"
    },
    {
      "id": 2,
      "text": "The town of Pageton was named after Louis Rodman Page, a key executive for the Page Coal and Coke Company.",
      "sourceSentenceIds": [
        6,
        9
      ],
      "sourceLabels": [
        "Web source 1",
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/pageton_west_virginia"
    },
    {
      "id": 3,
      "text": "The Page Coal and Coke Company Store is a two-story brick building listed on the National Register of Historic Places.",
      "sourceSentenceIds": [
        20,
        21
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.bramwellwv.com/pagetonindex.html"
    },
    {
      "id": 4,
      "text": "Pageton sits along the Pocahontas seam, which contains rich bituminous coal reaching thicknesses of up to eight feet.",
      "sourceSentenceIds": [
        10,
        26
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Pageton%2C_West_Virginia"
    },
    {
      "id": 5,
      "text": "Rail access to Pageton was historically provided by the Tug Fork Branch of the Norfolk and Western Railway.",
      "sourceSentenceIds": [
        12,
        18
      ],
      "sourceLabels": [
        "Web source 1",
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/pageton_west_virginia"
    },
    {
      "id": 6,
      "text": "The Dry Fork flows through narrow valleys near Pageton and is prone to flash flooding during heavy rains.",
