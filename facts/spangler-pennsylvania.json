      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Immigrant labor from Eastern Europe—Slovaks, Poles, and others—shaped Spangler’s workforce during its mining boom.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
