  "facts": [
    {
      "id": 1,
      "text": "Lexington’s name honors the 1775 Battles of Lexington and Concord, replacing the original German township name Saxe Gotha in 1785.",
      "sourceSentenceIds": [
        2,
        17
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Lexington%2C_South_Carolina",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town’s early economy thrived on corn, wheat, tobacco, hemp, flax, beeswax, and livestock, reflecting its German and Swiss settlers’ heritage.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Lexington%2C_South_Carolina",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "After the Civil War, the Columbia‑to‑Augusta Railroad and the 1890 Lexington Textile Mill sparked a boom that turned Lexington into a growing industrial hub.",
      "sourceSentenceIds": [
        5,
        10
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 2"
      ],
      "source": "https://en.wikipedia.org/wiki/Lexington%2C_South_Carolina",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Lexington’s historic courthouse survived a 19th‑century flood that forced the county seat to relocate from Granby to this town in 1820.",
      "sourceSentenceIds": [
        19
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Lexington%2C_South_Carolina",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The town’s “move‑over law,” first enacted in 1996 after a paramedic’s 1994 accident, requires drivers to change lanes when approaching stopped emergency vehicles.",
      "sourceSentenceIds": [
        26,
        28
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Lexington%2C_South_Carolina",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The Lexington County Museum showcases 36 historic structures, offering a glimpse into the town’s architectural past.",
