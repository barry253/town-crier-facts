      ],
      "source": "https://en.wikipedia.org/wiki/Oriskany%2C_New_York",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Oriskany sits at the confluence of the Mohawk River and Oriskany Creek, the site of the 1777 Battle of Oriskany.",
      "sourceSentenceIds": [
