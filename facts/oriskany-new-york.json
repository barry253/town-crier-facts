        5
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Oriskany%2C_New_York",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The Oriskany Battlefield State Historic Site marks the battlefield today in the village.",
      "sourceSentenceIds": [
        8
