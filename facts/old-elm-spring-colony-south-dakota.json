  "facts": [
    {
      "id": 1,
      "text": "Old Elm Spring Colony was founded in 1877 by Hutterite families who immigrated from Ukraine to preserve their communal Anabaptist traditions.",
      "sourceSentenceIds": [
        2,
        19
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/old_elm_spring_colony_south_dakota"
    },
    {
      "id": 2,
      "text": "As one of three original mother colonies in the United States, Old Elm Spring served as a base for future daughter settlements.",
      "sourceSentenceIds": [
        2,
        22
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/old_elm_spring_colony_south_dakota"
    },
    {
      "id": 3,
      "text": "The historic site of Old Elm Spring Colony sits on high ground on the east side of the James River.",
      "sourceSentenceIds": [
        12,
        20
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Old_Elm_Spring_Colony%2C_South_Dakota"
    },
    {
      "id": 4,
      "text": "Anti-German sentiment during World War One led many residents of Old Elm Spring Colony to migrate to Canada in 1918.",
      "sourceSentenceIds": [
        17,
        27
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/old_elm_spring_colony_south_dakota"
    },
    {
      "id": 5,
      "text": "Old Elm Spring Colony is listed on the National Register of Historic Places and includes the Good Samaritan Home.",
      "sourceSentenceIds": [
        6,
        10
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Old_Elm_Spring_Colony%2C_South_Dakota"
    },
    {
      "id": 6,
      "text": "The current Old Elm Spring Colony was established in 1998 as a division from the New Elm Spring Hutterite Colony.",
