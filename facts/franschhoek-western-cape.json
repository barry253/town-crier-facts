  "facts": [
    {
      "id": 1,
      "text": "Franschhoek, literally \"French Corner\", was settled by nearly 300 Huguenot refugees in 1688 after Louis XIV banned Protestantism.",
      "sourceSentenceIds": [
        13,
        19,
        21,
        22,
        23
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Franschhoek"
    },
    {
      "id": 2,
      "text": "The valley’s first farms—La Motte, Champagne, La Cotte—still stand in Cape Dutch style and now operate as celebrated wineries.",
      "sourceSentenceIds": [
        24,
        25
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Franschhoek"
    },
    {
      "id": 3,
      "text": "A Dutch‑era halfway station in the late 1600s supplied ships between Europe and the East, laying the groundwork for the town’s trade legacy.",
      "sourceSentenceIds": [
        11,
        12
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://africantravelcanvas.com/cape-winelands-guides/the-history-of-franschhoek/"
    },
    {
      "id": 4,
      "text": "The Huguenot Monument in Franschhoek displays tools, clothing, and artifacts that illustrate the settlers’ winemaking heritage.",
      "sourceSentenceIds": [
        29,
        30
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Franschhoek"
    },
    {
      "id": 5,
      "text": "Franschhoek’s name evolved from Oliphants hoek, named for roaming elephants, to Le Coin Français, and finally to its current Dutch spelling.",
      "sourceSentenceIds": [
        14,
        13,
        23
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Franschhoek"
    },
    {
      "id": 6,
      "text": "Located just 75 km from Cape Town, Franschhoek’s historic centre sits amid vineyards, making it a natural stop for wine lovers.",
      "sourceSentenceIds": [
