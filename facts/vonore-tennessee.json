  "facts": [
    {
      "id": 1,
      "text": "Vonore developed at confluence of Little Tennessee and Tellico Rivers, a site of indigenous settlement for thousands of years.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Vonore%2C_Tennessee",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "In 1890, the Atlanta, Knoxville and Northern Railroad laid tracks through Monroe County, anchoring Vonore’s growth.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Vonore%2C_Tennessee",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The town’s name came from Walter Kennedy choosing “Vonore” after a post office name conflict, combining German “von” and English “ore” to hint at mining.",
      "sourceSentenceIds": [
        27
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Vonore%2C_Tennessee",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Tellico Dam’s completion in 1979 flooded most of the valley’s archaeological sites, prompting salvage excavations of Cherokee towns Tanasi and Chota.",
      "sourceSentenceIds": [
        21,
        12
      ],
      "sourceLabels": [
        "Wikipedia",
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Vonore%2C_Tennessee",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Vonore sits on Tellico Lake and hosts two Tennessee State Historic Areas: Fort Loudoun State Historic Park and the Tellico Blockhouse State Historic Site.",
      "sourceSentenceIds": [
        14
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Vonore%2C_Tennessee",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The Sequoyah Birthplace Museum, operated by the Eastern Band of Cherokee Indians, honors the Cherokee scholar who created the syllabary.",
      "sourceSentenceIds": [
        15
