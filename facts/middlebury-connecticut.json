  "facts": [
    {
      "id": 1,
      "text": "Middlebury got its name from its central spot between Waterbury, Woodbury, and Southbury, a fact noted when the town was incorporated in 1807.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Middlebury%2C_Connecticut",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The Middlebury Historical Society Museum, Archives and Research Center sits just north of the town green on Library Road, preserving local stories.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.middleburyhistoricalsociety.org/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Settled in the early 1700s, Middlebury still boasts colonial‑era homes and landmarks that pepper the town’s streets.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://discovernewhaven.org/cities-and-towns/middlebury-ct/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The Josiah Bronson House, built in 1738, earned a spot on the National Register of Historic Places in 1982.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Middlebury%2C_Connecticut",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The 2001 Timex Building, once the headquarters of Timex Group USA, now stands as a modern landmark in Middlebury.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Middlebury%2C_Connecticut",
      "category": "landmark",
      "quality": "good"
    },
    {
