  "facts": [
    {
      "id": 1,
      "text": "Acorn, Arkansas, was renamed from Gourdneck in 1897 after a post office and school moved near new railroad tracks amid a bumper acorn harvest from local oak trees.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/acorn_arkansas",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Pioneers first settled Acorn around 1820, chasing free land in the rugged terrain that would later become Polk County.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/acorn_arkansas",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Between 1908 and 1910, Acorn briefly boomed when miners discovered gold, silver, platinum, and quartz, drawing prospectors nationwide.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/acorn_arkansas",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Acorn’s first school opened in 1876, offering ten‑hour days funded by state money and family contributions.",
      "sourceSentenceIds": [
        22
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/acorn_arkansas",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Acorn sits in a narrow valley between the Ouachita and Fourche mountain ranges, its gourd‑shaped contour giving the area its original name.",
      "sourceSentenceIds": [
        5
      ],
