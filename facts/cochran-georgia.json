  "facts": [
    {
      "id": 1,
      "text": "Cochran was renamed in 1869 after Arthur Cochran, a railroad official who brought the Macon and Brunswick Railroad to town.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Cochran%2C_Georgia",
      "category": "people",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The city’s nickname, Castle City, comes from the shared theme of school mascots: Barons, Royals, and Knights.",
      "sourceSentenceIds": [
        22
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Cochran%2C_Georgia",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Three historic sites in Cochran are listed on the National Register of Historic Places: the Bleckley County Courthouse, the Municipal Building and School, and Hillcrest.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Cochran%2C_Georgia",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Bleckley County High School and Middle Georgia State University share Cochran’s reputation for education, with the university’s campus located just outside town.",
      "sourceSentenceIds": [
        21
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Cochran%2C_Georgia",
      "category": "people",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The town’s historic homes, lovingly maintained, offer a glimpse into life in the 19th and early 20th centuries.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.cochran-bleckley.com/tourism",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Cochran’s location along U.S. Route 23 connects it to Macon 40 miles northwest and Eastman 18 miles southeast, making it a crossroads of central Georgia.",
      "sourceSentenceIds": [
        26
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
