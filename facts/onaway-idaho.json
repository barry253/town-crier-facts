  "facts": [
    {
      "id": 1,
      "text": "Onaway’s name comes from the phrase “on the way,” a nickname mill bosses used to assure wives that husbands were “onaway” home.",
      "sourceSentenceIds": [
        1,
        6
      ],
      "sourceLabels": [
        "Web source 1",
        "Wikipedia"
      ],
      "source": "https://grokipedia.com/page/onaway_idaho",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Onaway grew as a vital outpost for Potlatch mill workers, becoming a popular spot for refreshments after shifts because Potlatch banned alcohol.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/onaway_idaho",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The 1905 construction of the Potlatch Lumber Company mill just a mile away spurred railroad development, integrating Onaway into the timber economy.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/onaway_idaho",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Onaway sits in the Palouse, a grain‑producing region known for its rolling, undulating terrain shaped by geology and farming.",
      "sourceSentenceIds": [
        11
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/onaway_idaho",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The town experiences a humid continental climate with dry summers, classified Dsb, offering distinct seasonal changes across the year.",
      "sourceSentenceIds": [
        12
