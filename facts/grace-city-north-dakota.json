      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Grace City's layout followed railroad plans, making it a key station for early 20th-century agricultural expansion.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/grace_city_north_dakota",
