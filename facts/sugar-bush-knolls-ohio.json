  "facts": [
    {
      "id": 1,
      "text": "Sugar Bush Knolls takes its name from the sugar maple trees that once lined the shore of Lake Martin.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Sugar_Bush_Knolls%2C_Ohio",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Lake Martin honors its creator, Martin Davey, while nearby Lake Roger and Lake Quincy honor Davey Tree officers William Roger Williams and David Quincy Grove.",
      "sourceSentenceIds": [
        3,
        4
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Sugar_Bush_Knolls%2C_Ohio",
      "category": "people",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The village officially formed in 1964, carved from parts of Streetsboro and Franklin townships.",
      "sourceSentenceIds": [
        14
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Sugar_Bush_Knolls%2C_Ohio",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "During the Great Depression, the Davey Tree Company ran a nursery and experimental tree farm on what is now Sugar Bush Knolls.",
      "sourceSentenceIds": [
        16
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Sugar_Bush_Knolls%2C_Ohio",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "In the 1950s the former Davey land was parceled into building lots, sold, and early homes sprang up from families like the McElhones and Bushes.",
      "sourceSentenceIds": [
