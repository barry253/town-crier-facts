  "facts": [
    {
      "id": 1,
      "text": "Sun Village, originally called Western Mojave Desert by Native Americans, was founded as a settlement for Indigenous peoples displaced by redlining.",
      "sourceSentenceIds": [
        1,
        2
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.sunvillagecalifornia.org/about"
    },
    {
      "id": 2,
      "text": "Sun Village is a historic Black town in Los Angeles’ Antelope Valley.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://sunvillage.digital.uic.edu/"
    },
    {
      "id": 3,
      "text": "The area once known as Littlerock was renamed Sun Village in 1939 when it was established.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.sunvillagecalifornia.org/about"
    },
    {
      "id": 4,
      "text": "In the 1930s, Afro-American Melvin Ray Grubbs moved to the area and established the first black community in the Antelope Valley.",
      "sourceSentenceIds": [
        20
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Sun_Village%2C_California"
    },
    {
      "id": 5,
      "text": "The first Baptist church in Sun Village opened in 1950, marking a key moment in the town’s religious history.",
      "sourceSentenceIds": [
        22
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Sun_Village%2C_California"
    },
    {
      "id": 6,
      "text": "Jackie Robinson Park opened in Sun Village in 1965, honoring the legendary baseball player.",
      "sourceSentenceIds": [
        23
