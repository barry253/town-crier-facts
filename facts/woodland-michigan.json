  "facts": [
    {
      "id": 1,
      "text": "Woodland was first settled in 1837 by Charles and Jonathan Galloway along with Charles Haight.",
      "sourceSentenceIds": [
        13
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Woodland%2C_Michigan"
    },
    {
      "id": 2,
      "text": "The Chicago, Kalamazoo and Saginaw Railway arrived in 1889, spurring growth and leading to Woodland’s incorporation in 1892.",
      "sourceSentenceIds": [
        14
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Woodland%2C_Michigan"
    },
    {
      "id": 3,
      "text": "Woodland’s historic town hall, built in 1867 for $2,000, still stands and hosts town meetings today.",
      "sourceSentenceIds": [
        4,
        5
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://99wfmk.com/woodland-then-now/"
    },
    {
      "id": 4,
      "text": "Woodland’s name comes from the dense forests that once covered the area for miles.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Woodland%2C_Michigan"
    },
    {
      "id": 5,
      "text": "Downtown Woodland features one of the coolest strips of historic storefronts seen in small‑town Michigan.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
