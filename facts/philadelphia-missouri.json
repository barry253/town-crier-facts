    {
      "id": 1,
      "text": "Philadelphia, Missouri was platted in December 1835 by William Muldrow, giving the town its formal layout.",
      "sourceSentenceIds": [
        7,
        19
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 2"
      ],
      "source": "https://en.wikipedia.org/wiki/Philadelphia%2C_Missouri",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The community’s name honors Philadelphia, Pennsylvania, reflecting the settlers’ admiration for the eastern city.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Philadelphia%2C_Missouri",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "A post office has operated in Philadelphia since 1847, serving as a longstanding hub for local communication.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Philadelphia%2C_Missouri",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "During the Civil War, Philadelphia supplied a company of thirty men armed with muskets and bayonets, one of the county’s few prepared units.",
      "sourceSentenceIds": [
        21
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://momarion.genealogyvillage.com/history/philadelphia.html",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The town sits 12 miles west of Palmyra on Missouri Route 168, placing it firmly within the Hannibal Micropolitan Statistical Area.",
      "sourceSentenceIds": [
        5,
        6
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Philadelphia%2C_Missouri",
      "category": "other",
      "quality": "poor",
      "qualityReason": "location_description"
    },
    {
      "id": 6,
      "text": "Philadelphia’s landscape drains north to a tributary of the South Fabius River and south to a tributary of the North River, both flowing east to the Mississippi.",
