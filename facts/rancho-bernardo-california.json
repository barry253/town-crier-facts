  "facts": [
    {
      "id": 1,
      "text": "Rancho Bernardo is a master‑planned community nestled in San Diego’s northern hills, about 20 miles north‑northeast of downtown.",
      "sourceSentenceIds": [
        18
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
