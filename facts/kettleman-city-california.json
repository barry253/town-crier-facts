    {
      "id": 1,
      "text": "Manford Brown founded Kettleman City in 1929 on donated land, drawing oilfield workers and building a school and church on his parcels.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/Kettleman_City,_California",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town’s name honors pioneer sheep‑raiser Dave Kettelman, whose 1860s grazing lands gave the Kettleman Hills their early identity.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Kettleman_City%2C_California",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Kettleman City sits at the west side of the San Joaquin Valley, just north of the 36th parallel and near the old Tulare Lake shoreline.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Kettleman_City%2C_California",
      "category": "other",
      "quality": "poor",
      "qualityReason": "location_description"
    },
    {
      "id": 4,
      "text": "Its Tesla Supercharger station was the first in California to feature a solar‑roofed design and an indoor lounge for travelers.",
      "sourceSentenceIds": [
        14
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Kettleman_City%2C_California",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The town experiences a cold semi‑arid climate, with scorching summers, cool winters, and frequent dense tule fog that blankets the valley.",
      "sourceSentenceIds": [
        25
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Kettleman_City%2C_California",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Discovered in the late 1920s, the Kettleman Hills oil fields sparked rapid growth, and today the area hosts a major hazardous‑waste facility under federal scrutiny.",
