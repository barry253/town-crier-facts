  "facts": [
    {
      "id": 1,
      "text": "Toponas sits at 8,284 feet in a broad mountain pass between the Yampa River to the north and the Colorado River to the south.",
      "sourceSentenceIds": [
        1,
        7
      ],
      "sourceLabels": [
        "Web source 1",
        "Wikipedia"
      ],
      "source": "https://www.uncovercolorado.com/towns/toponas/",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The village’s name comes from the nearby Toponas Rock, a distinctive granite outcrop that gives the area its character.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.uncovercolorado.com/towns/toponas/",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "An old Denver and Rio Grande Western Railroad line once crossed Toponas, linking the Yampa Valley to Middle Park and making the town a key travel spot.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://kids.kiddle.co/Toponas,_Colorado",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Toponas’s single general store doubles as a gas station, a living reminder of the town’s rural heritage.",
