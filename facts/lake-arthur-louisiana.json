  "facts": [
    {
      "id": 1,
      "text": "Lake Arthur takes its name from early settler Arthur LeBlanc, who built a home on the lake’s banks in the 1800s, and the town was incorporated in 1903.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/lake_arthur_louisiana",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The Southern Pacific Railroad reached Lake Arthur in 1904, linking the town to Lake Charles and bringing goods, passengers, and campgrounds excursions.",
      "sourceSentenceIds": [
        1,
        8
      ],
      "sourceLabels": [
        "Web source 1",
        "Wikipedia"
      ],
      "source": "https://grokipedia.com/page/lake_arthur_louisiana",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Before European settlement, the Atakapa people used the Lake Arthur area for seasonal camping, hunting, and fishing along its lakes and bayous.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/lake_arthur_louisiana",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Historic Sanborn maps from 1912 to 1935 let you see how Lake Arthur’s downtown, businesses, and schools looked a century ago.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://hometownhistorymaps.com/pages/history-of-lake-arthur-louisiana",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Lake Arthur has become a hub for fishing, birdwatching, and ecotourism along the Mississippi Flyway.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/lake_arthur_louisiana",
      "category": "economy",
      "quality": "good"
    },
