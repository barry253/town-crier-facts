  "facts": [
    {
      "id": 1,
      "text": "Scotia was founded in the 1870s and named after Scotland by early settler Samuel Scott, who platted the town in 1879.",
      "sourceSentenceIds": [
        1,
        4,
        16
      ],
      "sourceLabels": [
        "Web source 1",
        "Web source 2",
        "Wikipedia"
      ],
      "source": "https://villageofscotia.org/historian/scotia-nebraska/",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "In 1883 a Union Pacific spur reached Scotia, forcing trains to back into the village and boosting grain shipping via elevators and a roller mill.",
      "sourceSentenceIds": [
        2,
        13
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/scotia_nebraska",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Early 1870s settlers from Wisconsin, Indiana, Illinois, Germany, and Ireland homesteaded the North Loup Valley under the Homestead Act, securing 160‑acre plots after five years.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/scotia_nebraska",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Scotia served as Greeley County's first county seat before the capital moved to other towns.",
      "sourceSentenceIds": [
        17
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Scotia%2C_Nebraska",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "During the 1880s, railroads sold 180,000 acres in Greeley County for as little as $1.25 per acre, spurring rapid settlement.",
      "sourceSentenceIds": [
        14
      ],
      "sourceLabels": [
        "Web source 2"
      ],
