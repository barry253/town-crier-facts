    },
    {
      "id": 2,
      "text": "In 1883 a Union Pacific spur reached Scotia, forcing trains to back into the village and boosting grain shipping via elevators and a roller mill.",
      "sourceSentenceIds": [
        2,
        13
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/scotia_nebraska"
    },
    {
      "id": 3,
      "text": "Early 1870s settlers from Wisconsin, Indiana, Illinois, Germany, and Ireland homesteaded the North Loup Valley under the Homestead Act, securing 160‑acre plots after five years.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/scotia_nebraska"
    },
    {
      "id": 4,
      "text": "Scotia served as Greeley County's first county seat before the capital moved to other towns.",
      "sourceSentenceIds": [
        17
