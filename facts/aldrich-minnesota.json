  "facts": [
    {
      "id": 1,
      "text": "Aldrich earned its name from Cyrus Aldrich, a Minnesota legislator honored by Northern Pacific Railroad officials in the 1870s.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/aldrich_minnesota"
    },
    {
      "id": 2,
      "text": "Aldrich stands as Wadena County’s first permanent settlement and the first town to establish a post office.",
      "sourceSentenceIds": [
        20
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Aldrich%2C_Minnesota"
    },
    {
      "id": 3,
      "text": "In 1870, Our Mother of Sorrows Catholic mission church opened in Aldrich, becoming the area’s first Catholic church.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/aldrich_minnesota"
    },
    {
      "id": 4,
      "text": "The city lies along the Partridge River, which supplied early settlers with essential water resources.",
      "sourceSentenceIds": [
        19
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Aldrich%2C_Minnesota"
    },
    {
      "id": 5,
      "text": "Late 19th‑century Aldrich grew into a dairy hub, building a creamery that processed milk and cheese from surrounding farms.",
