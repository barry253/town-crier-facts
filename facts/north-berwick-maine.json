      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The North Berwick Historical Society acquired land on Old County Road called Parish of Unity Park, honoring Scottish settlers brought by the ship Unity.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 1"
      ],
