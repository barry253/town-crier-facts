      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "In 1896, Springfield became a machine‑tool hub when the Fellows Gear Shaper Company was founded by Edwin R. Fellows.",
      "sourceSentenceIds": [
        4,
        7
      ],
      "sourceLabels": [
        "Wikipedia",
