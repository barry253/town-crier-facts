  "facts": [
    {
      "id": 1,
      "text": "Shaughnessy Village got its name from Thomas Shaughnessy’s 1874 mansion, the former Canadian Pacific Railway president’s palatial home.",
      "sourceSentenceIds": [
        2,
        3
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Shaughnessy_Village"
    },
    {
      "id": 2,
      "text": "The neighborhood’s 1874 Shaughnessy House is now a National Historic Site and part of the Canadian Centre for Architecture.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Shaughnessy_Village"
    },
    {
      "id": 3,
      "text": "Shaughnessy Village was once considered Montreal’s second Gay Village before Expo ’67, largely by anglophones.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Shaughnessy_Village"
    },
    {
      "id": 4,
      "text": "The Montreal Forum, a National Historic Site, stood in Shaughnessy Village and hosted the Canadiens for 70 years, winning 22 of 24 Stanley Cups.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.mtl.org/en/experience/shaughnessy-village-neighbourhood"
    },
    {
      "id": 5,
      "text": "Two Metro stations—Guy–Concordia and Atwater—serve the area, linking it directly to the city’s Green Line.",
      "sourceSentenceIds": [
        10,
        11
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Shaughnessy_Village"
    },
    {
      "id": 6,
      "text": "The neighborhood’s Claire‑Morissette bike path and BIXI stations make cycling a popular way to explore its Victorian row houses and beaux‑arts towers.",
      "sourceSentenceIds": [
        13
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
