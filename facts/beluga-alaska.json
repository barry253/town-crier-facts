  "facts": [
    {
      "id": 1,
      "text": "The area's name originates from the Russian word 'byeluga', meaning white whale, in reference to the beluga whales that inhabit Cook Inlet.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/beluga_alaska",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Beluga’s subarctic climate features long, cold winters and short, cool summers, with maritime influences from Cook Inlet that moderate extremes.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/beluga_alaska",
      "category": "other",
      "quality": "poor",
      "qualityReason": "vague"
    },
    {
      "id": 3,
      "text": "Access is by air or by water, as the road network is local only.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Beluga%2C_Alaska",
      "category": "other",
      "quality": "poor",
      "qualityReason": "vague"
    },
    {
      "id": 4,
      "text": "Beluga hosts three main fishing rivers: the Beluga, Chuitna, and Three Mile Creek, each yielding king, silver, and sockeye salmon.",
      "sourceSentenceIds": [
        20
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Beluga%2C_Alaska"
    },
    {
      "id": 5,
      "text": "Hilcorp Energy runs a nearby field that fuels regional projects like the 183‑MW Southcentral Power Project and the 120‑MW Sullivan Power Plant.",
      "sourceSentenceIds": [
        26
