      ],
      "source": "https://www.kupi.com/en-ae/explore/puerto-rico/aguadilla/history",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The 1918 San Fermín earthquake and its tsunami struck Aguadilla, killing 40 residents and damaging key landmarks.",
