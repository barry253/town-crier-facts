  "facts": [
    {
      "id": 1,
      "text": "Portage County’s name comes from a Native American trail called Portage Path that linked the Cuyahoga and Tuscarawas rivers.",
      "sourceSentenceIds": [
        24,
        11
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 2"
      ],
      "source": "https://en.wikipedia.org/wiki/Portage_County%2C_Ohio"
    },
    {
      "id": 2,
      "text": "The county was created in 1807 and formally organized the following year, 1808.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Portage_County%2C_Ohio"
    },
    {
      "id": 3,
      "text": "After the Treaty of Greenville, Ohio’s northeast opened to white settlement for the first time, reshaping Portage’s early history.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Portage_County%2C_Ohio"
    },
    {
      "id": 4,
      "text": "The last great train robbery in U.S. history took place in nearby Garrettsville in 1935, a story still told in Portage lore.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Portage_County%2C_Ohio"
    },
    {
      "id": 5,
      "text": "Ravenna, the county seat, hosts the historic Portage County Courthouse and is the birthplace of the county’s administrative center.",
      "sourceSentenceIds": [
        21
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Portage_County%2C_Ohio"
    },
    {
      "id": 6,
      "text": "Kent, the largest city in Portage, is home to Kent State University, a major research institution with over 2.5 million volumes.",
