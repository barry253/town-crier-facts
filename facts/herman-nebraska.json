      "id": 1,
      "text": "Herman was platted in 1871 as part of the Omaha & Northwestern Railroad expansion, becoming a planned community to support rail operations.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 1"
      ],
