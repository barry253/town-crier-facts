      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town was named after Samuel Herman, a conductor on the first train that arrived in 1872, and the spelling was later simplified from \"Hermann\".",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 1"
      ],
