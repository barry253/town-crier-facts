  "facts": [
    {
      "id": 1,
      "text": "Lakeland Shores was incorporated as a village on November 16, 1949, after residents protested high taxes.",
      "sourceSentenceIds": [
        9,
        28
      ],
      "sourceLabels": [
        "Web source 2",
        "Web source 1"
      ],
      "source": "https://www.lakesnwoods.com/LakelandShores.htm"
    },
    {
      "id": 2,
      "text": "The city sits along the Croix River, with Lakeland Shores Road tracing the path of a former railroad.",
      "sourceSentenceIds": [
        1,
        2
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.wchsmn.org/lakeland-shores/"
    },
    {
      "id": 3,
      "text": "Before becoming a town, the area was a single farm owned by William and Mary Jones.",
      "sourceSentenceIds": [
        25
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.wchsmn.org/lakeland-shores/"
    },
    {
      "id": 4,
      "text": "In the 1940s the Jones family subdivided the farm into 100‑to‑150‑foot lots, sparking a residential boom.",
      "sourceSentenceIds": [
        26
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.wchsmn.org/lakeland-shores/"
    },
    {
      "id": 5,
      "text": "Lakeland Shores covers 443 acres between the river and County Road 18, yet it has no industry or shopping.",
      "sourceSentenceIds": [
        30
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.wchsmn.org/lakeland-shores/"
    },
    {
      "id": 6,
      "text": "The community has remained quiet and residential, preserving its rural character since its incorporation.",
      "sourceSentenceIds": [
        29
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.wchsmn.org/lakeland-shores/"
    }
  ]
