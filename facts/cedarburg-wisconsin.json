  "facts": [
    {
      "id": 1,
      "text": "Cedarburg was founded by Irish and German settlers in the early 1840s who were drawn to Cedar Creek's power potential.",
      "sourceSentenceIds": [
        11
      ],
      "sourceLabels": [
        "Web source 1"
      ],
