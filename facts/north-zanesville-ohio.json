  "facts": [
    {
      "id": 1,
      "text": "North Zanesville sits on high ground that drains east toward the Muskingum River and west toward Joes Run, a tributary of the Licking River.",
      "sourceSentenceIds": [
        18
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/North_Zanesville%2C_Ohio",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "North Zanesville was named after Ebenezer Zane, who built Zane's Trace, a pioneer road from Wheeling to Maysville.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.visitzanesville.com/About-Muskingum-County/History/",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The Y‑Bridge, a three‑way bridge at the confluence of the Licking and Muskingum Rivers, is a historic landmark in downtown Zanesville.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.visitzanesville.com/About-Muskingum-County/History/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The first bridge in Zanesville, the Third Street bridge, was constructed by the Putnam Yankees in 1813.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://coz.org/232/History",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Muskingum County, where North Zanesville lies, was authorized by the Ohio government on January 7, 1804.",
