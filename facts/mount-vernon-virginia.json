      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://virginiavacationguide.com/mount-vernon-va/",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The property includes Washington’s Tomb, the beautiful gardens, and a museum‑education center showcasing his legacy.",
