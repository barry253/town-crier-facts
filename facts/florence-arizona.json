      ],
      "source": "https://en.wikipedia.org/wiki/Florence%2C_Arizona",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Florence, Arizona, is the county seat of Pinal County and hosts a National Historic District with more than 25 buildings on the National Register.",
      "sourceSentenceIds": [
        20
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Florence%2C_Arizona",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "McFarland State Historic Park in Florence preserves the first Pinal County courthouse, built in 1876.",
      "sourceSentenceIds": [
        11
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Florence%2C_Arizona",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Poston Butte, the pyramid tomb of Charles Debrille Poston, stands on Primrose Hill, now called Poston Butte.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Florence%2C_Arizona",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Main Street in Florence boasts more than 125 well‑preserved adobe buildings that chronicle its Old West heritage.",
