      "id": 1,
      "text": "San Lorenzo was founded in 1869 by nineteen miners from the nearby camp of Pinos Altos and their families.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/san_lorenzo_historic_district",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The San Lorenzo Historic District covers 80 acres along the Mimbres River valley, encompassing the village’s core.",
      "sourceSentenceIds": [
        13
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/san_lorenzo_historic_district",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "In 1988 the district was listed on the National Register of Historic Places for its early Hispanic settlement and vernacular architecture.",
      "sourceSentenceIds": [
        15
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/san_lorenzo_historic_district",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Settlers immediately dug an irrigation ditch, positioning the village just above it for optimal water access.",
      "sourceSentenceIds": [
        24
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/san_lorenzo_historic_district",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "San Lorenzo supplied corn, vegetables, and hay to nearby mining towns like Pinos Altos and Silver City, fueling their growth.",
      "sourceSentenceIds": [
        27
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/san_lorenzo_historic_district",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The 1936 San Lorenzo School, built by the WPA with sandstone, showcases federal relief efforts during the Great Depression.",
