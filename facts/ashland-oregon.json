      "category": "culture",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "John McLaren, the landscape architect behind San Francisco’s Golden Gate Park, designed Ashland’s Lithia Park, originally called Lithia Springs Park.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
