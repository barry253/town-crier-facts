        2
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.nps.gov/subjects/travelashlandor/introduction.htm",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Every October, the ANPF narrows hundreds of plays to four that are performed live by professionals during its five‑day festival.",
