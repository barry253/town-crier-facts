    },
    {
      "id": 2,
      "text": "The town first appeared on the Atchison, Topeka and Santa Fe Railway in 1879, becoming a stop that helped grow the area.",
      "sourceSentenceIds": [
        19,
        20
      ],
      "sourceLabels": [
        "Web source 1",
