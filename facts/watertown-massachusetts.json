  "facts": [
    {
      "id": 1,
      "text": "Watertown was founded in 1630 by settlers led by Richard Saltonstall and George Phillips, becoming one of the earliest Massachusetts Bay settlements.",
      "sourceSentenceIds": [
        7,
        11
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 2"
      ],
      "source": "https://en.wikipedia.org/wiki/Watertown%2C_Massachusetts",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town's fertile land made it the first inland farming town in Massachusetts, supporting early agriculture and cattle raising.",
      "sourceSentenceIds": [
        1,
        11
      ],
      "sourceLabels": [
        "Web source 1",
        "Web source 2"
      ],
      "source": "https://www.watertown-ma.gov/101/About",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Watertown housed the historic Watertown Arsenal, a major heavy ordnance factory from 1816 until the late 1960s, before becoming a museum.",
      "sourceSentenceIds": [
        6,
        13
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 2"
      ],
      "source": "https://en.wikipedia.org/wiki/Watertown%2C_Massachusetts",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The Perkins School for the Blind, founded in Boston in 1829, relocated to Watertown in 1912 and remains a national leader in vision education.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.britannica.com/place/Watertown-Massachusetts",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Mount Auburn Cemetery, established in 1831, was the first garden cemetery in the United States and spans 151.1 acres of landscaped grounds.",
      "sourceSentenceIds": [
        8,
        10
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Watertown%2C_Massachusetts",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The Locomobile Company of America produced steam-powered cars in Watertown from 1899 until it moved to Connecticut, marking an early automotive era.",
      "sourceSentenceIds": [
        9
