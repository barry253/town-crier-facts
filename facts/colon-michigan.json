  "facts": [
    {
      "id": 1,
      "text": "Colon is dubbed \"The Magic Capital of the World\" because it hosts Abbott Magic Company and annual Magic Get‑Together, and once housed Harry Blackstone Sr.",
      "sourceSentenceIds": [
        14
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Colon%2C_Michigan",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The Abbott Magic Company, founded in 1934 by Australian Percy Abbott and Recil Bordner, still manufactures tricks in its local showroom and factory.",
      "sourceSentenceIds": [
        1,
        4
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Colon%2C_Michigan",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Colon’s Community Historical Society, established in 1962, preserves the town’s story from its 1832 founding through today with exhibits and programs.",
      "sourceSentenceIds": [
        2,
        6,
        7
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://museumsdatabase.com/museums/view/16049",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The town’s annual Colon Days Festival celebrates local heritage and is supported by the Historical Society.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://museumsdatabase.com/museums/view/16049",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Colon sits between Sturgeon Lake and Palmer Lake, which connect via a narrow channel, giving the village a unique lakeside layout.",
      "sourceSentenceIds": [
        17
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Colon%2C_Michigan",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Colon was platted in 1844 and incorporated as a village in 1904, marking its formal growth from a township settlement.",
