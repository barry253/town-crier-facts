  "facts": [
    {
      "id": 1,
      "text": "Victoria takes its name from the 1857 Laketown Moravian Brethren church, a 30‑acre landmark now on the National Register.",
      "sourceSentenceIds": [
        3,
        5,
        6
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Victoria%2C_Minnesota",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The 1882 arrival of the railroad and the Victoria Union Depot turned the former Laketown Township into the thriving city we see today.",
      "sourceSentenceIds": [
        2,
        14
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.victoriamn.gov/community/about_victoria/discover_victoria_history.php",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Known as the City of Lakes and Parks, Victoria boasts thirteen lakes and 25 parks across more than 200 acres of reserved land.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Victoria%2C_Minnesota",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The Victoria post office, first called Laketown, opened in 1860 and only found a permanent downtown home decades later.",
      "sourceSentenceIds": [
        16
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.victoriamn.gov/community/about_victoria/discover_victoria_history.php",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Floyd’s, a popular local spot, traces its roots back to 1898 when it first opened as the Victoria Saloon.",
      "sourceSentenceIds": [
        17
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.victoriamn.gov/community/about_victoria/discover_victoria_history.php",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Victoria also shelters the 1,800‑acre Carver Park Reserve, one of Minnesota’s largest municipal parks.",
