      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Dumfries%2C_Virginia",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The town's seal features a thistle honoring its Scottish founders, a ship symbolizing its maritime past, and a tobacco leaf representing early trade.",
