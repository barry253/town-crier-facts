  "facts": [
    {
      "id": 1,
      "text": "Lily Lake was named after John Lilly, who was one of the area's early settlers.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://wheatlandkenoshaco.gov/lily-lake"
    },
    {
      "id": 2,
      "text": "Underground springs from Lake Superior feed the waters of Lily Lake.",
      "sourceSentenceIds": [
        11
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://wheatlandkenoshaco.gov/lily-lake"
    },
    {
      "id": 3,
      "text": "Lily Lake served as the home for a Boy Scout camp during the 1920s.",
      "sourceSentenceIds": [
        16
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://wheatlandkenoshaco.gov/lily-lake"
    },
    {
      "id": 4,
      "text": "Serious development at Lily Lake began in the 1930s with the construction of summer cottages along the north shore.",
      "sourceSentenceIds": [
        19
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://wheatlandkenoshaco.gov/lily-lake"
    },
    {
      "id": 5,
      "text": "Lily Lake spans about 88 acres and reaches a maximum depth of 22 feet.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://wheatlandkenoshaco.gov/lily-lake"
    },
    {
      "id": 6,
      "text": "The Wisconsin Department of Natural Resources routinely stocks Lily Lake with bluegill, northern pike, and largemouth bass.",
