  "facts": [
    {
      "id": 1,
      "text": "Portage Park’s name comes from a Native American portage that linked the Des Plaines and Chicago Rivers, a trail used for canoe travel.",
      "sourceSentenceIds": [
        1,
        9,
        10,
        18
      ],
      "sourceLabels": [
        "Web source 1",
        "Web source 2",
        "Wikipedia"
      ],
      "source": "https://www.portageparkchamber.org/history-portage-park",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "In 1959, the park’s second pool hosted the swimming events of the Pan‑American Games, a precursor to the 1972 Olympic trials.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Portage_Park%2C_Chicago",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The area’s swampy terrain once allowed Native Americans and trappers to paddle through the wetlands without leaving their canoes.",
      "sourceSentenceIds": [
        19
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Portage_Park%2C_Chicago",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Portage Park’s theater, once the Belpark, was renovated with TIF funds and now serves as a performing‑arts center showcasing arthouse and silent films.",
      "sourceSentenceIds": [
        11
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Portage_Park%2C_Chicago",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The city acquired 36 acres for Portage Park in 1912, developing it into a recreational hub with athletic fields and cultural facilities.",
      "sourceSentenceIds": [
        9
