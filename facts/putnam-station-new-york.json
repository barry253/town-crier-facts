  "facts": [
    {
      "id": 1,
      "text": "Putnam Station takes its name from Revolutionary War general Israel Putnam, whose 18th‑century military exploits echoed across the region.",
      "sourceSentenceIds": [
        1,
        9
      ],
      "sourceLabels": [
        "Web source 1",
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/putnam_station_new_york",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The 1875 arrival of the New York and Canada Railroad turned Putnam Station into a bustling trade hub with a depot, store, and ferry links.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/putnam_station_new_york",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Putnam Station sits on a narrow peninsula jutting between Lake Champlain to the east and Lake George to the west.",
      "sourceSentenceIds": [
        11,
        15
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/putnam_station_new_york",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "In the 19th century, Putnam Station powered local economies with sawmills, grist mills, and fulling mills that processed homespun cloth.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/putnam_station_new_york",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Militia musters of the Putnam Rifle Greens and Civil War enlistments from the hamlet fed regiments like the 123rd New York Infantry.",
      "sourceSentenceIds": [
        20
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/putnam_station_new_york",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Before European settlers, Abenaki, Mohican, and Mohawk peoples used the peninsula as a vital trade corridor between Algonquian and Iroquoian groups.",
      "sourceSentenceIds": [
        4,
        6
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/putnam_station_new_york",
      "category": "history",
      "quality": "good"
    }
