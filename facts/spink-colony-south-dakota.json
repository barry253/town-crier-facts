  "facts": [
    {
      "id": 1,
      "text": "Spink Colony is a Hutterite community of the Schmiedeleut branch, known for practicing communal living based on New Testament teachings.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/spink_colony_south_dakota"
    },
    {
      "id": 2,
      "text": "Founded in 1905, Spink Colony was abandoned in 1918 before being repurchased and rebuilt in 1945 by the Bon Homme Colony.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/spink_colony_south_dakota"
    },
    {
      "id": 3,
      "text": "The Old Spink Colony site was listed on the National Register of Historic Places in 1982.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Spink_Colony%2C_South_Dakota"
    },
    {
      "id": 4,
      "text": "Spink Colony established the Käsemeister Creamery in 2018 to produce artisan cheeses using European-inspired recipes passed down through generations.",
      "sourceSentenceIds": [
        22,
        23
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/spink_colony_south_dakota"
    },
    {
      "id": 5,
      "text": "Spink Colony sits on the east side of the James River, where seasonal flooding has shaped the local valley geography.",
      "sourceSentenceIds": [
        4,
        10
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 2"
      ],
      "source": "https://en.wikipedia.org/wiki/Spink_Colony%2C_South_Dakota"
    },
    {
      "id": 6,
      "text": "Spink Colony has helped expand Hutterite communities in the region by founding daughter colonies like Hutterville and Plainview.",
