  "facts": [
    {
      "id": 1,
      "text": "SeaTac’s roots trace back to a military road finished in 1860 that linked Fort Steilacoom with Fort Bellingham.",
      "sourceSentenceIds": [
        24
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/SeaTac%2C_Washington",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "European Americans began settling the Highline area, which now includes SeaTac, during the mid‑1850s after the road opened.",
      "sourceSentenceIds": [
        22
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/SeaTac%2C_Washington",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "A 1990 dive in Angle Lake uncovered two dugout canoes dated to 1678, proving indigenous activity long before settlers.",
      "sourceSentenceIds": [
        20
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/SeaTac%2C_Washington",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "SeaTac’s name derives from the nearby Seattle‑Tacoma Airport, originally called Sea‑Tac, with the hyphen dropped when the city incorporated.",
      "sourceSentenceIds": [
        29
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/SeaTac%2C_Washington",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The Highline Heritage Museum, formerly the Highline Historical Society, showcases artifacts that chronicle SeaTac’s early history.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.seatacwa.gov/our-city/visiting",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "SeaTac’s Valley View Library, part of the King County Library System, offers residents access to a wide range of resources.",
