  "facts": [
    {
      "id": 1,
      "text": "In 1818, Killam tried a logging venture on Kelleys Island, but the steam boat wrecked and he abandoned the island.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Kelleys_Island%2C_Ohio",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The island was renamed Kelleys Island in 1840 when brothers Datus and Irad Kelley bought almost the whole island.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Kelleys_Island%2C_Ohio",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Inscription Rock on the south shore holds petroglyphs carved by indigenous peoples, dated to about 1643 by Henry Rowe Schoolcraft.",
      "sourceSentenceIds": [
        5,
        10
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Kelleys_Island%2C_Ohio",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The first regular ferry to Kelleys Island was the Neuman Ferry, founded in 1907 by John Paul Neuman.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Kelleys_Island%2C_Ohio",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "A seasonal Jet Express ferry runs multiple times daily from Sandusky and Cedar Point to Kelleys Island.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Kelleys_Island%2C_Ohio",
      "category": "transport",
      "quality": "poor",
      "qualityReason": "route_only"
    },
    {
      "id": 6,
      "text": "The Kelleys Island Historical Association hosts a museum campus filled with artifacts, a historic church, and a memorial walk honoring local history.",
