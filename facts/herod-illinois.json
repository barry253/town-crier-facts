    },
    {
      "id": 2,
      "text": "The community takes its name from the Herod family, prominent early residents who helped shape the town’s early days.",
      "sourceSentenceIds": [
        24
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/herod_illinois",
      "category": "people",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "A general store opened around 1880 under George Smith, becoming the local hub while the post office, first called Herod Springs, opened in 1888.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/herod_illinois",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Herod sits at 427 feet above sea level in the Shawnee Hills, within the Ohio River basin that feeds fertile bottomlands.",
      "sourceSentenceIds": [
        16,
        2
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/herod_illinois",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The Herod Fault Zone runs through the area, contributing to local mineralization and the landscape’s distinctive geology.",
      "sourceSentenceIds": [
        17
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/herod_illinois",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "In the 1830s, settlers like Elbert Rose and Joseph Lambert began claiming land, turning a sparse frontier into nascent farming hamlets.",
