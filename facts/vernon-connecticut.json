  "facts": [
    {
      "id": 1,
      "text": "Vernon was incorporated in October 1808, carved out of Bolton, and named after George Washington's Mount Vernon estate.",
      "sourceSentenceIds": [
        2,
        3,
        17
      ],
      "sourceLabels": [
        "Web source 2",
        "Wikipedia"
      ],
      "source": "https://www.ct.one/towns/vernon",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The historic village of Rockville sits within Vernon, blending New England charm with suburban convenience.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.ct.one/towns/vernon",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Fox Hill’s stone tower in Henry Park offers sweeping views and is a favorite gathering spot for locals year‑round.",
      "sourceSentenceIds": [
        13
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.ct.one/towns/vernon",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Rockville’s historic district, added to the National Register in 1984, showcases Greek Revival, Late Victorian, and Classical Revival architecture.",
      "sourceSentenceIds": [
        27,
        28
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Vernon%2C_Connecticut",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Vernon’s former city of Rockville was incorporated in 1889 and consolidated back into Vernon in 1965.",
      "sourceSentenceIds": [
        18
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Vernon%2C_Connecticut",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The town hosts the New England Civil War Museum housed in the Bernard Church Memorial Building, a former Grand Army of the Republic Hall.",
      "sourceSentenceIds": [
