      "quality": "good"
    },
    {
      "id": 3,
      "text": "Eldoret hosts Kenya’s first small‑arms manufacturer, the Kenya Ordnance Factories Corporation, which began production in 1997.",
      "sourceSentenceIds": [
        14
      ],
      "sourceLabels": [
