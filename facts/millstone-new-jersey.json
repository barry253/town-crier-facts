  "facts": [
    {
      "id": 1,
      "text": "Millstone Township takes its name from the Millstone River, named after a millstone that fell into the water during early settlement.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Millstone_Township%2C_New_Jersey",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "During the Revolution, Millstone hid a secret Continental Army post called Signal Beacon #21, a hidden lookout for the troops.",
      "sourceSentenceIds": [
        14
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Millstone_Township%2C_New_Jersey",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The township’s first business, the Rising Sun Tavern, hosted George Washington and later British General Sir Henry Clinton on the stagecoach route between Philadelphia and Freehold.",
      "sourceSentenceIds": [
        15,
        17
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Millstone_Township%2C_New_Jersey",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Originally called Somerset Courthouse, the town was the county seat until the British burned it to the ground in 1779 during the war.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://millstoneboro.org/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The Millstone River’s headwaters begin right in the township, making it a cradle for several New Jersey waterways.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Millstone_Township%2C_New_Jersey",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Millstone was officially formed as a township on February 28, 1844, carved from parts of Freehold, Upper Freehold, and Monroe Townships.",
      "sourceSentenceIds": [
        19
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Millstone_Township%2C_New_Jersey",
      "category": "history",
      "quality": "good"
    }
