  "facts": [
    {
      "id": 1,
      "text": "Dellroy was founded as Cannonsburg in 1849 and renamed Dellroy around 1878.",
      "sourceSentenceIds": [
        1,
        2
      ],
      "sourceLabels": [
        "Web source 1",
        "Wikipedia"
      ],
      "source": "https://villageofdellroy.org/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "In the 1930s, Atwood Lake was created as a flood control project, turning Dellroy into a recreational gateway.",
      "sourceSentenceIds": [
        9,
        28
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://villageofdellroy.org/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The 1936 dam project that created Atwood Lake cost $1.4 million and produced 28 miles of shoreline that now defines Dellroy’s modern identity.",
      "sourceSentenceIds": [
        29
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://villageofdellroy.org/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Dellroy sits at the junction of Ohio State Routes 39 and 542, a historic crossroads that once linked the Great Trail trade route.",
      "sourceSentenceIds": [
        13,
        4
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Dellroy%2C_Ohio",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Dellroy is part of the Canton–Massillon metropolitan area, linking it to a larger regional economy.",
      "sourceSentenceIds": [
        11
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
