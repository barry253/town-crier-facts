      ],
      "source": "https://en.wikipedia.org/wiki/Hvidovre",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "In 1929, a 3,500‑year‑old Bronze Age sword was unearthed in Hvidovre, linking the town to Denmark’s ancient past.",
      "sourceSentenceIds": [
        15
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
