  "facts": [
    {
      "id": 1,
      "text": "Hvidovre hosts Filmbyen, a post‑industrial filmmaking hub founded by Lars von Trier and Peter Aalbæk Jensen’s Zentropa.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
