  "facts": [
    {
      "id": 1,
      "text": "Brandon was originally called Bungtown when the town was created in 1856.",
      "sourceSentenceIds": [
        1,
        3
      ],
      "sourceLabels": [
        "Web source 1",
        "Wikipedia"
      ],
      "source": "https://villageofbrandon.com/about-us/"
    },
    {
      "id": 2,
      "text": "The completion of the Milwaukee and Horicon Railroad in 1856 helped Brandon grow as a key stop for settlers and commerce.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/brandon_wisconsin"
    },
    {
      "id": 3,
      "text": "The Rens Hemp Company in Brandon was the last legal hemp producer in the United States after World War Two.",
      "sourceSentenceIds": [
        6,
        12
      ],
      "sourceLabels": [
        "Web source 2",
        "Wikipedia"
      ],
      "source": "https://grokipedia.com/page/brandon_wisconsin"
    },
    {
      "id": 4,
      "text": "Prior to closing in 1957, the Rens Hemp Company served as the primary provider of hemp rope for the United States Navy.",
      "sourceSentenceIds": [
        13
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Brandon%2C_Wisconsin"
    },
    {
      "id": 5,
      "text": "The northernmost West Branch of the Rock River begins in the Community Park on the west edge of Brandon.",
      "sourceSentenceIds": [
        15
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Brandon%2C_Wisconsin"
    },
    {
      "id": 6,
      "text": "Pioneers first settled the area of present-day Brandon in 1844, with the first building erected in 1849.",
      "sourceSentenceIds": [
        4,
        7
      ],
      "sourceLabels": [
        "Web source 2"
      ],
