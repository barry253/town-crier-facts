  "facts": [
    {
      "id": 1,
      "text": "Beach Haven was named after early settler Nathan Beach (1763–1847), reflecting post‑Revolutionary settlement along the Susquehanna River.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/beach_haven_pennsylvania",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The community sits on the Susquehanna River bank, about 3 miles east of Berwick along U.S. Route 11.",
      "sourceSentenceIds": [
        10,
        11,
        26
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 2"
      ],
      "source": "https://en.wikipedia.org/wiki/Beach_Haven%2C_Pennsylvania",
      "category": "other",
      "quality": "poor",
      "qualityReason": "location_description"
    },
    {
      "id": 3,
      "text": "In the 19th century, the North Branch of the Pennsylvania Canal ran through Beach Haven before the Delaware Railroad took over.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/beach_haven_pennsylvania",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Beach Haven’s early infrastructure included a union church near Mill Creek, donated by the Beach family, serving as a modest hub for farming and milling.",
      "sourceSentenceIds": [
        28
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/beach_haven_pennsylvania",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The Beach Haven Methodist Episcopal Church, built in 1870 after a fire, was decommissioned in 2020 and sold in 2021 for an event space.",
      "sourceSentenceIds": [
        29,
        30
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/beach_haven_pennsylvania",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Beach Haven is an unincorporated community within Salem Township, one of Luzerne County’s eleven original townships formed in 1786.",
      "sourceSentenceIds": [
        4,
        7
      ],
