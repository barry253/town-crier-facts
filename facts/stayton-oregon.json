  "facts": [
    {
      "id": 1,
      "text": "Drury Smith Stayton founded Stayton in 1872 after building a carding mill and sawmill along the North Santiam River.",
      "sourceSentenceIds": [
        1,
        3
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 2"
      ],
      "source": "https://en.wikipedia.org/wiki/Stayton%2C_Oregon"
    },
    {
      "id": 2,
      "text": "The founder originally wanted to name the city after his daughter, Florence, but the post office denied the request.",
      "sourceSentenceIds": [
        2,
        4
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Stayton%2C_Oregon"
    },
    {
      "id": 3,
      "text": "Before European settlers arrived, the area that is now Stayton was inhabited by the Kalapuya Native American tribe.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.visitoregon.com/cities/stayton-oregon/"
    },
    {
      "id": 4,
      "text": "A ferry crossing of the Santiam River served the community from 1876 until a bridge was finally constructed in 1888.",
      "sourceSentenceIds": [
        16
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Stayton%2C_Oregon"
    },
    {
      "id": 5,
      "text": "Stayton serves as a regional agricultural and light manufacturing center located along the banks of the North Santiam River.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Stayton%2C_Oregon"
    },
    {
      "id": 6,
      "text": "The lowest temperature ever recorded in Stayton was seven degrees below zero on December 8, 1972.",
