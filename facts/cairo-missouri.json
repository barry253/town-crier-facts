  "facts": [
    {
      "id": 1,
      "text": "Cairo was originally called 'Fairview' and was founded in 1858, reflecting the early settlers' vision for a peaceful community.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Cairo%2C_Missouri"
    },
    {
      "id": 2,
      "text": "The village was named after Cairo, Egypt, perhaps via Cairo, Illinois in the mid‑19th century.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Cairo%2C_Missouri"
    },
    {
      "id": 3,
      "text": "A post office called Cairo has been in operation since 1860, serving as a hub for local farmers.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Cairo%2C_Missouri"
    },
    {
      "id": 4,
      "text": "The Mitchell Petroglyph Archeological Site was listed on the National Register of Historic Places in 1969.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Cairo%2C_Missouri"
    },
    {
      "id": 5,
      "text": "The village’s pronunciation is 'Kay-row,' unlike the city in Egypt in the local dialect.",
      "sourceSentenceIds": [
        11
      ],
