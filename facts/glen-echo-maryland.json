  "facts": [
    {
      "id": 1,
      "text": "Glen Echo began in 1889 when brothers Edwin and Edward Baltzley bought land along the Potomac and named it Glen‑Echo‑on‑the‑Potomac.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://glenecho.gov/about/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The park’s Streamline Moderne architecture and antique Dentzel carousel make it a rare example of early 20th‑century amusement design.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Glen_Echo_Park_(Maryland)",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "A 1947 PCC streetcar from Philadelphia was donated to the park in 2005, now part of its historic transportation collection.",
      "sourceSentenceIds": [
        24
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Glen_Echo_Park_(Maryland)",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Dances in the Spanish Ballroom echo the Chautauqua era, while the Bumper Car Pavilion was converted into a dance pavilion in the 1970s.",
      "sourceSentenceIds": [
        10,
        14
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Glen_Echo_Park_(Maryland)",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Glen Echo’s early days featured a merry‑go‑round, bowling alley, band pavilion, Ferris wheel, and roller coaster before it became a Chautauqua assembly.",
      "sourceSentenceIds": [
        19
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://glenecho.gov/about/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The town’s history includes notable residents like Clara Barton, the Red Cross founder, who once lived in the area.",
      "sourceSentenceIds": [
        25
      ],
