  "facts": [
    {
      "id": 1,
      "text": "Pennington Gap was chartered in 1892 by the Pennington Gap Land Improvement Company and grew around the Louisville and Nashville Railroad.",
      "sourceSentenceIds": [
        16
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.dhr.virginia.gov/historic-registers/281-5002/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town’s historic commercial core features masonry storefronts, a former movie theater, two auto dealerships, and a former service station.",
      "sourceSentenceIds": [
        17
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.dhr.virginia.gov/historic-registers/281-5002/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Cumberland Gap National Historical Park, less than an hour from Pennington Gap, offers White Rocks overlook views and ranger‑guided tours of Gap Cave.",
      "sourceSentenceIds": [
        4,
        9
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.mysmokymountainpark.com/road-trips/road-trip-stops/pennington-gap/",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "In 2013 the town restored a historic theater that now hosts movies and concerts, with tickets often selling out for big shows.",
      "sourceSentenceIds": [
        14,
        15
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.mysmokymountainpark.com/road-trips/road-trip-stops/pennington-gap/",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The Appalachian African American Cultural Center in Pennington Gap showcases Virginia’s Black history through exhibits and community programs.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.mysmokymountainpark.com/road-trips/road-trip-stops/pennington-gap/",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Pennington Gap’s name honors the Pennington family, early settlers who established the Hensley Settlement near the gap.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
