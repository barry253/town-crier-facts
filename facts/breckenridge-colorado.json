  "facts": [
    {
      "id": 1,
      "text": "Breckenridge sprang to life in November 1859 when prospector Thomas Breckenridge and his crew struck gold along the Blue River.",
      "sourceSentenceIds": [
        1,
        6
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Breckenridge%2C_Colorado",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town’s name honors its founder, Thomas Breckenridge, who led the first mining party into the high‑country canyon.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Breckenridge%2C_Colorado",
      "category": "people",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "In 1882, the Denver, South Park, and Pacific Railroad built a depot, making Breckenridge the first rail‑served town in the Rockies.",
      "sourceSentenceIds": [
        14
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://breckhistory.org/the-history-of-breckenridge-co/",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Main Street’s clapboard and log buildings still echo the town’s 19th‑century mining heritage, giving Breckenridge a unique historic charm.",
      "sourceSentenceIds": [
        11
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Breckenridge%2C_Colorado",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Since 1981, Breckenridge has hosted the Breckenridge Festival of Film each September, drawing filmmakers from around the world.",
      "sourceSentenceIds": [
