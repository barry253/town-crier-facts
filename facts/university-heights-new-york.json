  "facts": [
    {
      "id": 1,
      "text": "University Heights takes its name from the hill where NYU’s Bronx campus was built in 1894.",
      "sourceSentenceIds": [
        23
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/University_Heights%2C_Bronx",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The campus’s restoration projects culminated in its 2012 designation as a National Historic Landmark, reaffirming its status as an architectural treasure.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/University_Heights%2C_Bronx",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The Gould Memorial Library, with its domed rotunda and marble colonnades, became a visual symbol for the neighborhood.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/University_Heights%2C_Bronx",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The IRT Jerome Avenue Line opened in 1917, and the 4 train stations at 183rd Street and Fordham Road sparked a wave of low‑rise apartment development.",
      "sourceSentenceIds": [
        13
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.cityneighborhoods.nyc/university-heights",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Bronx Community College houses the Hall of Fame for Great Americans, an outdoor arcade of 98 busts stretching 630 feet over the highest point in the Bronx.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.nyc.gov/site/bronxcb7/about/university-heights.page",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "University Heights borders the Harlem River to the west, giving it a waterfront edge that once supported the Hudson River Railroad and later the New York Central Railroad.",
      "sourceSentenceIds": [
        5
      ],
