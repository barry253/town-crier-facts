    },
    {
      "id": 3,
      "text": "In 1923 the railroad spur station was renamed Macomber to honor the local Macomber family, though the name Doty remained for the town.",
      "sourceSentenceIds": [
        1,
        4
      ],
      "sourceLabels": [
        "Wikipedia",
