    {
      "id": 2,
      "text": "The post office opened November 2, 1900, later moved to a postmaster's house in 1957 and returned to the general store in 1973.",
      "sourceSentenceIds": [
        2,
        13
      ],
      "sourceLabels": [
        "Web source 2",
