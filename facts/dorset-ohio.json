  "facts": [
    {
      "id": 1,
      "text": "Dorset was founded as Millsford in 1828 and renamed in 1849 after Dorset, Vermont, the hometown of early settler Joel Thorp.",
      "sourceSentenceIds": [
        1,
        2,
        11
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Dorset%2C_Ohio",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The first permanent European‑American settlers, Joel and Sarah Thorp, arrived in 1799 from Connecticut and built a log cabin near a beaver dam.",
      "sourceSentenceIds": [
        17,
        18
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/dorset_ohio",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "In 1831, the Garlick family’s way station on the Andover Road became a stop on the Underground Railroad, sheltering fugitive slaves.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/dorset_ohio",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Dorset’s first school opened in 1823 inside a Cowles family log house, with teacher Sarah Houghton earning about 75 cents a week.",
      "sourceSentenceIds": [
        23
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/dorset_ohio",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Dorset Township’s development mirrored the Connecticut Land Company’s 1795 purchase, which opened the Western Reserve to New England settlers and spurred local farming.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Web source 1"
      ],
