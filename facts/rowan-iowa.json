  "facts": [
    {
      "id": 1,
      "text": "Rowan began as a settlement called Horse Grove, named after a lone wandering horse, and was first settled around 1854 by Adam Ford and Bill Murdock.",
      "sourceSentenceIds": [
        2,
        3
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.heartlandmuseum.org/post/rowan-the-early-days",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Rowan became a station point on the Great Western and Rock Island Railroads, cementing its role as a regional transport hub.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://iagenweb.org/wright/Histories/Rowan/EarlyRowanhistory.htm",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Before settlers, Native American bands hunted and fished along the Iowa River, chasing buffalo and elk across what is now Rowan.",
      "sourceSentenceIds": [
        11
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://iagenweb.org/wright/Histories/Rowan/EarlyRowanhistory.htm",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The 2007 Rowan Community Building on Main Street houses the public library, city hall, and a community center, serving as the town’s civic heart.",
