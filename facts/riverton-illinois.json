    },
    {
      "id": 2,
      "text": "John Taylor founded Riverton in 1837, setting the stage for its early growth.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Riverton%2C_Illinois"
    },
    {
      "id": 3,
      "text": "A state rule banning town names after people forced Howlett to become Riverton in the 1870s.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Riverton%2C_Illinois"
    },
    {
      "id": 4,
      "text": "The railroad that promised prosperity turned out unreliable, leading Jamestown to economic distress and sale of its land.",
      "sourceSentenceIds": [
