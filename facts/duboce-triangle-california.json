  "facts": [
    {
      "id": 1,
      "text": "Duboce Triangle derives its name from Victor Duboce, a lieutenant colonel in the First California Volunteer Infantry during the Spanish–American War.",
      "sourceSentenceIds": [
        25
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Duboce_Triangle%2C_San_Francisco",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The neighborhood’s oldest house, at 22 Beaver Street, dates back to 1876, making it one of San Francisco’s earliest surviving residences.",
      "sourceSentenceIds": [
        26
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Duboce_Triangle%2C_San_Francisco",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "A Victorian apartment on the north side of 400 Duboce Avenue survived the 1906 earthquake and is described as the largest wooden structure west of the Mississippi.",
      "sourceSentenceIds": [
        27
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Duboce_Triangle%2C_San_Francisco",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "From 1970 to 1984, the area hosted Scott’s Pit, the city’s first lesbian biker bar, a notable slice of LGBTQ history.",
      "sourceSentenceIds": [
        28
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Duboce_Triangle%2C_San_Francisco",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "In 2019, the Duboce Triangle Neighborhood Association began a decade‑long effort to survey every historic building, completing the project in spring 2021.",
      "sourceSentenceIds": [
        3,
        14,
        16
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.dtna.org/Duboce-Triangle-Historic-District-Update",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The neighborhood’s historic survey database now lets residents see which properties qualify for California Register protection, giving developers “certainty” before proposing projects.",
