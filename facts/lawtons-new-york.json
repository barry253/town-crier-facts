  "facts": [
    {
      "id": 1,
      "text": "Lawtons was formally established as a hamlet in 1873 by Henry Lawton, a local settler and land developer.",
      "sourceSentenceIds": [
        22
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/lawtons_new_york",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The hamlet’s post office once lived in a larger store built by Henry Lawton at the end of what became Seneca Street, making it a community hub.",
      "sourceSentenceIds": [
        23
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/lawtons_new_york",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Lawtons grew around a railroad station negotiated by Henry Lawton, linking the hamlet to broader networks including Jamestown.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/lawtons_new_york",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Early settlers were primarily English Quakers from New England who cleared forest for wheat, corn, and hay, shaping the area’s agrarian roots.",
      "sourceSentenceIds": [
        16,
        18
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/lawtons_new_york",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The hamlet’s name honors Henry Lawton, whose land holdings and development efforts gave the community its identity.",
      "sourceSentenceIds": [
        22
