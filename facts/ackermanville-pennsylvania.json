  "facts": [
    {
      "id": 1,
      "text": "Ackermanville was named for the Ackerman family.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Ackermanville%2C_Pennsylvania",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "In 1788 Henry Miller built a house, grist mill, and saw mill on a 560‑acre tract that now contains the village.",
      "sourceSentenceIds": [
        13
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Ackermanville%2C_Pennsylvania",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Four years later Miller sold the properties to John Ackerman, who had moved from Bucks County with his family.",
      "sourceSentenceIds": [
        14
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Ackermanville%2C_Pennsylvania",
      "category": "people",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Ackerman had six sons who each built their own houses, and over time other families settled in the area.",
      "sourceSentenceIds": [
        15
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Ackermanville%2C_Pennsylvania",
      "category": "people",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "In the early 1800s the village was called Ackermans Mill, and from 1850 to about 1870 it was known simply as Ackermans.",
      "sourceSentenceIds": [
        16
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Ackermanville%2C_Pennsylvania",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The village and its surroundings are drained by Martins Creek, which flows southward into the Delaware River.",
      "sourceSentenceIds": [
        18
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
