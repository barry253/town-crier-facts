  "facts": [
    {
      "id": 1,
      "text": "Farmerville was named after a local planter and Baptist elder who helped organize the Concord Baptist Association in 1832.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://farmerville.org/history/"
    },
    {
      "id": 2,
      "text": "The first land grant in Union Parish, which would become Farmerville, was issued by the Spanish government in 1790.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://farmerville.org/history/"
    },
    {
      "id": 3,
      "text": "Just a mile west of Farmerville, where Bayou Corney meets the river, the historic meeting place Forks Ferry once served as a key crossing.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://farmerville.org/history/"
    },
    {
      "id": 4,
      "text": "Farmerville adopted its historic Charter in 1870, a document that still governs the town’s municipal government today.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://farmerville.org/history/"
    },
    {
      "id": 5,
      "text": "Farmerville is the parish seat of Union Parish, Louisiana.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Farmerville%2C_Louisiana"
    },
    {
