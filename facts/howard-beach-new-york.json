  "facts": [
    {
      "id": 1,
      "text": "Howard Beach was founded in 1897 by William J. Howard, a glove maker who turned his 150‑acre goat farm into a seaside community.",
      "sourceSentenceIds": [
        25,
        26,
        27,
        28,
        29,
        30
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Howard_Beach",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The Long Island Rail Road opened the Ramblersville station in 1905, a name that later became the basis for the Howard Beach – JFK Airport station.",
      "sourceSentenceIds": [
        4,
        5,
        19
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 2"
      ],
      "source": "https://en.wikipedia.org/wiki/Howard_Beach",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Folk legend Woody Guthrie called Howard Beach home, living at 159‑13 85th Street after leaving Coney Island.",
      "sourceSentenceIds": [
        11
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Howard_Beach",
      "category": "people",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The neighborhood’s quiet, low‑rise homes were shaped by Howard’s original cottages and a hotel that burned in 1907.",
      "sourceSentenceIds": [
        28,
        29
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Howard_Beach",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Howard Beach’s proximity to Idlewild Airport—renamed JFK in 1963—brought both convenience and noise, yet the community’s strong civic networks kept its small‑town feel.",
      "sourceSentenceIds": [
        21
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.cityneighborhoods.nyc/howard-beach",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The Queens Public Library’s Howard Beach branch, located at 92‑06 156th Avenue, serves the neighborhood’s residents with a long history of community learning.",
