  "facts": [
    {
      "id": 1,
      "text": "The name Atmautluak comes from the Central Yup'ik word atmaut, meaning backpack, and the village was named after a river curve that looks like a knapsack.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.kupi.com/en/explore/united-states/atmautluak",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Atmautluak was founded in the 1960s on high ground above the floodplain to protect the community from seasonal flooding.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Atmautluak%2C_Alaska",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Before the 1960s, the area that is now Atmautluak was used by Yup'ik Eskimos as a seasonal camp for fish harvesting and berry picking.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.kupi.com/en/explore/united-states/atmautluak/history",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "In the 1960s, the seasonal camp transitioned into a permanent settlement, marking a decisive shift toward sedentary life in the region.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.kupi.com/en/explore/united-states/atmautluak/history",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The village sits on the west bank of the Pitmiktakik River in the Yukon‑Kuskokwim Delta, giving residents access to water routes and transport.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.kupi.com/en/explore/united-states/atmautluak/history",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Atmautluak incorporated in 1976 but dissolved that status in 1996 to return to a traditional native government structure.",
      "sourceSentenceIds": [
        12
