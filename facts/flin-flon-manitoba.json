  "facts": [
    {
      "id": 1,
      "text": "Founded in 1927 by Hudson Bay Mining and Smelting Co., Flin Flon grew around copper and zinc ore deposits.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Flin_Flon"
    },
    {
      "id": 2,
      "text": "Named after Josiah Flintabbatey Flonatin, the lead character in the 1905 novel The Sunless City, a statue of “Flinty” by Al Capp now graces the town square.",
      "sourceSentenceIds": [
        16,
        25
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Flin_Flon"
    },
    {
      "id": 3,
      "text": "In 2003 the Chamber of Commerce minted a $3 coin featuring Flinty, legal tender locally until 2004, and a $5 coin until 2008.",
      "sourceSentenceIds": [
        24
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Flin_Flon"
    },
    {
      "id": 4,
      "text": "CBWBT channel 10, Manitoba’s first community TV station, began broadcasting in Flin Flon in 1962.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Flin_Flon"
    },
    {
      "id": 5,
      "text": "The 777 mine, the last major Flin Flon operation, closed in 2022, ending more than nine decades of mining.",
      "sourceSentenceIds": [
        30
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Flin_Flon"
    },
    {
      "id": 6,
      "text": "Flin Flon’s eclectic community hosts an active arts scene, with festivals and galleries that showcase local creativity.",
