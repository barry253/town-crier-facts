  "facts": [
    {
      "id": 1,
      "text": "After the Revolutionary War, Varna became part of the Military Tract, a vast land grant of nearly two million acres given to veterans.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/varna_new_york",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Before European settlers, the Cayuga Nation, one of the Haudenosaunee Confederacy, used the Varna area for hunting, fishing, and agriculture.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/varna_new_york",
      "category": "people",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "In the 1800s, Varna’s mills and factories sprang up along Fall Creek, powered by the creek’s water flow.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/varna_new_york",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Erasmus Brown built a sash factory on the site in 1837, later converted by Israel Brown into a distillery.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/varna_new_york",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Fall Creek winds through Varna before emptying into Cayuga Lake, one of New York’s Finger Lakes.",
      "sourceSentenceIds": [
        9,
        18
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Varna%2C_New_York",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Varna borders a 4,000‑acre Cornell Botanic Gardens, offering hiking trails like the Cayuga Trail and Monkey Run.",
