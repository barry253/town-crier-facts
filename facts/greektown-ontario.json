      "id": 1,
      "text": "Greektown in Toronto was founded by Communist Greek refugees after the civil war and named for Nikos Beloyannis.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Greektown",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The area that became Greektown was first linked to the Don River by the 1851 Don and Danforth Plank Road, later Danforth Avenue.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/Greektown,_Toronto",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Greektown sits along Danforth Avenue, served by Toronto Transit Commission's Line 2 Bloor–Danforth subway with Chester and Pape stations.",
      "sourceSentenceIds": [
        9,
        10
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/Greektown,_Toronto",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Immigrants who settled in Greektown often worked in factories, construction, and small‑scale entrepreneurship, shaping its early economy.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/Greektown,_Toronto",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Greektown is a generic term for a neighborhood dominated by Greeks or people of Greek ancestry, common in many cities.",
