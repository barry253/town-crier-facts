  "facts": [
    {
      "id": 1,
      "text": "Durham, New York, takes its name from Durham, Connecticut, and was first settled around 1755 in what was then Albany County.",
      "sourceSentenceIds": [
        13,
        15
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Durham%2C_New_York",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "In 1790, settlers carved out the Town of Freehold from Coxsackie; it became Durham in 1805 after settlers called it New Durham.",
      "sourceSentenceIds": [
        16,
        18
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Durham%2C_New_York",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The first recorded lease in Durham dates to May 3 1774, when Lucas DeWitt signed a deed for property in DeWittsburg.",
      "sourceSentenceIds": [
        27,
        28
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Durham%2C_New_York",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Durham’s earliest settlers are credited to Lucas DeWitt, John Plank, and Hendrick Plank, who helped establish the first community.",
      "sourceSentenceIds": [
        30
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Durham%2C_New_York",
      "category": "people",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Three historic stone arch bridges—Moore Road, Shady Glen, and Hervey Street—stand in Durham and were listed on the National Register in 2008.",
      "sourceSentenceIds": [
        9,
        10
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Durham%2C_New_York",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Jazz icon Blossom Dearie spent her childhood in East Durham before rising to international fame.",
      "sourceSentenceIds": [
