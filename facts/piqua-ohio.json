      "quality": "poor",
      "qualityReason": "route_only"
    },
    {
      "id": 2,
      "text": "Fort Piqua, built by Wayne’s forces in 1794, stood on the same site that later became a small farm and supply depot.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Piqua%2C_Ohio",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The historic Piqua Coca‑Cola Bottling Company, owned by the Lange family, occupied the corner of Main and High streets downtown.",
      "sourceSentenceIds": [
        19
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Piqua%2C_Ohio",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Evenflo, once known as Questor Juvenile Furniture, remains one of Piqua’s leading employers, producing infant and toddler car seats.",
      "sourceSentenceIds": [
        11
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Piqua%2C_Ohio",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "A 174‑acre farm near Piqua houses a restored 1829 home of Federal Indian Agent Colonel John Johnston, complete with a mule‑drawn canal boat.",
      "sourceSentenceIds": [
        23
      ],
      "sourceLabels": [
        "Web source 2"
      ],
