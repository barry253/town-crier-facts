  "facts": [
    {
      "id": 1,
      "text": "Fort Atkinson was built to protect the Ho‑Chunk (Winnebago) people during their removal from Wisconsin.",
      "sourceSentenceIds": [
        17
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Fort_Atkinson%2C_Iowa",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "After the Ho‑Chunk were removed, the military post was abandoned on February 14, 1849.",
      "sourceSentenceIds": [
        6,
        12
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 2"
      ],
      "source": "https://en.wikipedia.org/wiki/Fort_Atkinson%2C_Iowa",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Twenty years after the fort’s abandonment, a railroad arrived in 1869, sparking the town’s growth southeast of the original post.",
      "sourceSentenceIds": [
        13
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.fortatkinsoniowa.com/about",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Each September, Fort Atkinson hosts a large annual fur‑trapper rendezvous, celebrating fifty years of tradition.",
      "sourceSentenceIds": [
        5,
        9
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Fort_Atkinson%2C_Iowa",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The city’s name honors Henry Atkinson, the commanding officer who led the fort’s construction.",
      "sourceSentenceIds": [
        18
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Fort_Atkinson%2C_Iowa",
      "category": "people",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Construction of the original fort began in May 1840 and finished by summer 1842.",
      "sourceSentenceIds": [
        19
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
