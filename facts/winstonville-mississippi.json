      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "In 1931 a Yazoo and Mississippi Valley Railroad station turned the area into a railway settlement called Wyandotte.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
