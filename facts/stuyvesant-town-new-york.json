      ],
      "source": "https://historian.columbiacountyny.com/municipal-historians/town-of-stuyvesant"
    },
    {
      "id": 5,
      "text": "Community pride shines on Historic Stuyvesant Day, celebrated each second Saturday of August by local volunteers.",
      "sourceSentenceIds": [
