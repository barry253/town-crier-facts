      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "According to Omaha tribal legend, Chief Blackbird was buried atop a hill on his horse after death, a lasting regional legend.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Web source 1"
      ],
