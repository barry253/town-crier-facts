  "facts": [
    {
      "id": 1,
      "text": "McCaskill got its name in 1912 when the post office, originally called Dixon, was renamed after Daniel Berryman McCaskill, a local agricultural pioneer.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/mccaskill_arkansas",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town sprang to life around 1900 when the Prescott and Northwestern Railroad arrived, turning a quiet outpost into a lumber and crop shipping hub.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/mccaskill_arkansas",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "McCaskill sits on flat to gently rolling blackland prairie, where fertile soils once made the area both productive and remote before roads improved access.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/mccaskill_arkansas",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Spring and summer in McCaskill bring frequent thunderstorms as warm, moist Gulf air rises, creating high humidity that peaks from May through September.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/mccaskill_arkansas",
      "category": "nature",
      "quality": "poor",
      "qualityReason": "vague"
    },
    {
      "id": 5,
      "text": "The average annual temperature hovers around 62°F, with July and August highs reaching 93°F and January lows dipping to about 31°F.",
      "sourceSentenceIds": [
        27
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/mccaskill_arkansas",
      "category": "nature",
      "quality": "poor",
      "qualityReason": "vague"
    },
    {
      "id": 6,
      "text": "McCaskill receives roughly 54 inches of rain each year, most of it falling in spring—May alone sees about 5.6 inches of precipitation.",
      "sourceSentenceIds": [
        28
