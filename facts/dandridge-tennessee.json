      "id": 1,
      "text": "Dandridge was founded in 1783 and named for Martha Dandridge Washington, the first First Lady of the United States.",
      "sourceSentenceIds": [
        1,
        5
      ],
      "sourceLabels": [
        "Web source 2",
        "Wikipedia"
      ],
