      "id": 1,
      "text": "Youngsville sits in the Town of Callicoon along New York State Route 52, about seven miles west of Liberty.",
      "sourceSentenceIds": [
        16,
        17
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
