  "facts": [
    {
      "id": 1,
      "text": "Worthington was named by the daughters of its founder, who honored their father when they established the town.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Worthington%2C_Kentucky"
    },
    {
      "id": 2,
      "text": "Situated on the south bank of the Ohio River, Worthington sits in eastern Greenup County, Kentucky.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Worthington%2C_Kentucky"
    },
    {
      "id": 3,
      "text": "The city is part of the Huntington‑Ashland‑Ironton metropolitan area, linking it to a larger regional community.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Worthington%2C_Kentucky"
    },
    {
      "id": 4,
      "text": "Before becoming a town, the land was owned by Abraham Buford and later sold to the Means and Russell Iron Company.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Worthington%2C_Kentucky"
    },
    {
      "id": 5,
      "text": "Worthington officially became a city on February 5, 1920, when the Kentucky General Assembly incorporated it.",
