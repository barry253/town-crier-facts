  "facts": [
    {
      "id": 1,
      "text": "Walnut’s name comes from the Rancho Los Nogales land grant, where 'nogales' means walnut trees in Spanish.",
      "sourceSentenceIds": [
        9,
        19
      ],
      "sourceLabels": [
        "Web source 1",
        "Wikipedia"
      ],
      "source": "https://www.walnutca.gov/For-Residents/City-Facts/Our-History",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Walnut became an incorporated city on January 19, 1959.",
      "sourceSentenceIds": [
        20
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Walnut%2C_California",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The city sits between the steep San Jose Hills to the north and the gently sloping Puente Hills to the south.",
      "sourceSentenceIds": [
        16
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Walnut%2C_California",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Snow Creek and Lemon Creek run southward, joining San Jose Creek before it meets the San Gabriel River.",
      "sourceSentenceIds": [
        24
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Walnut%2C_California",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Before becoming a city, the area was part of three Mexican ranchos: San Jose, Los Nogales, and La Puente.",
      "sourceSentenceIds": [
        29
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Walnut%2C_California",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The land that is now Walnut was traditionally inhabited by the Tongva people.",
