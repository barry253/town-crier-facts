  "facts": [
    {
      "id": 1,
      "text": "White Sands sits in the Tularosa Basin, a high desert area 1,185 meters above sea level.",
      "sourceSentenceIds": [
        16
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/White_Sands%2C_New_Mexico",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Its dunes are made of gypsum, not quartz, making them the world’s largest surface deposit of this mineral.",
      "sourceSentenceIds": [
        17,
        19
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/White_Sands%2C_New_Mexico",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Gypsum sand feels cool to the touch because it evaporates surface moisture quickly and reflects sunlight.",
      "sourceSentenceIds": [
        18
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/White_Sands%2C_New_Mexico",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The desert began about 100 million years ago when a shallow sea covered the basin, later evaporating to leave salt and gypsum.",
      "sourceSentenceIds": [
        21,
        22,
        23
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/White_Sands%2C_New_Mexico",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Rising tectonic forces lifted the gypsum layers about 70 million years ago, creating the basin between the Sacramento and San Andres Mountains.",
      "sourceSentenceIds": [
        24,
        25
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/White_Sands%2C_New_Mexico",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Wind carried fine gypsum grains from Lake Lucero, where evaporated water left thin selenite layers, forming dunes up to 15 meters tall.",
