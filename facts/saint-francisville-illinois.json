  "facts": [
    {
      "id": 1,
      "text": "Saint Francisville began as a stockade built by Joseph Tougas in the early 1810s, later platted by his widow in the 1830s and incorporated in 1873.",
      "sourceSentenceIds": [
        12,
        13,
        14
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/St._Francisville%2C_Illinois"
    },
    {
      "id": 2,
      "text": "The city sits on the west bank of the Wabash River, which marks the Illinois‑Indiana state line.",
      "sourceSentenceIds": [
        15
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/St._Francisville%2C_Illinois"
    },
    {
      "id": 3,
      "text": "Saint Francisville lies just 12 miles south of Lawrenceville, the county seat of Lawrence County.",
      "sourceSentenceIds": [
        16
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/St._Francisville%2C_Illinois"
    },
    {
      "id": 4,
      "text": "The Wabash Cannon Ball Bridge, a 1.5‑mile span, connects Saint Francisville to Indiana just northeast of town.",
      "sourceSentenceIds": [
        17
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/St._Francisville%2C_Illinois"
    },
    {
      "id": 5,
      "text": "Saint Francisville is famous for its locally grown popcorn variety, the Black Jewell, known for its dark‑colored kernels.",
      "sourceSentenceIds": [
        27
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/St._Francisville%2C_Illinois"
    },
    {
      "id": 6,
      "text": "The town covers 0.78 square miles, with 95.64% land and 4.36% water.",
