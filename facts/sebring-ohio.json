  "facts": [
    {
      "id": 1,
      "text": "Sebring was founded in 1898 by the Sebring brothers from East Liverpool, Ohio, who built factories, homes, and stores that became the village.",
      "sourceSentenceIds": [
        5,
        15
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.sebring.k12.oh.us/page/community-get-to-know-sebring",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The village earned the nickname “Pottery Capital of the World” because its founders were successful pottery owners from East Liverpool.",
      "sourceSentenceIds": [
        10,
        14
      ],
      "sourceLabels": [
        "Web source 2",
        "Wikipedia"
      ],
      "source": "https://www.sebring.k12.oh.us/page/community-get-to-know-sebring",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The Sebring Mansion, built in 1900 by founder Frank Sebring, now serves as an inn and spa that preserves the town’s early history.",
      "sourceSentenceIds": [
        11,
        12,
        13
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.sebring.k12.oh.us/page/community-get-to-know-sebring",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Sebring’s Cultural Center, located downtown, houses the public library, historical society, art league, museum, and a lakeside theatre—all within walking distance.",
      "sourceSentenceIds": [
        17
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.sebring.org/history-of-sebring/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "In 1912, George Sebring officially incorporated the village, giving it the formal status it holds today.",
      "sourceSentenceIds": [
        7,
        20
      ],
      "sourceLabels": [
        "Web source 1",
        "Wikipedia"
      ],
      "source": "https://www.sebring.org/history-of-sebring/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Sebring’s early growth was tied to the Seaboard Air Line Railroad’s Orange Blossom Special, which connected the town to cities nationwide.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.sebring.org/history-of-sebring/",
      "category": "transport",
      "quality": "good"
    }
