  "facts": [
    {
      "id": 1,
      "text": "Hampstead grew from a 19th‑century stage‑coach stop to a modern town of about 6,300 residents.",
      "sourceSentenceIds": [
        28
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Hampstead%2C_Maryland",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town’s name comes from Hampstead, England, after the original Spring Garden stage‑line stop was renamed.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Hampstead%2C_Maryland",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "In 1879 the Western Maryland Railroad’s Harrisburg Division reached Hampstead, turning the town into a rail hub.",
      "sourceSentenceIds": [
        5,
        9
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Hampstead%2C_Maryland",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Hampstead School, listed on the National Register of Historic Places in 2002, now serves as a retirement facility called The Residences at Hampstead School.",
      "sourceSentenceIds": [
        7,
        29
      ],
      "sourceLabels": [
        "Wikipedia",
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Hampstead%2C_Maryland",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The town renovated an old bank building on Main Street into a police station, preserving historic architecture while modernizing services.",
