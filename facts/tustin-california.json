      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Tustin’s Marine Corps Air Station, a former Navy airship base, remains a key landmark and is listed on the National Register of Historic Places.",
      "sourceSentenceIds": [
        2,
        27
      ],
      "sourceLabels": [
        "Wikipedia",
