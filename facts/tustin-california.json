    {
      "id": 2,
      "text": "During World War II, a Navy anti‑submarine airship base with two massive wooden dirigible hangars was built south of Tustin.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Wikipedia"
