  "facts": [
    {
      "id": 1,
      "text": "Founded in 1869, Lindsborg began as a Swedish settlement led by Pastor Olof Olsson on land bought by the First Swedish Agricultural Company.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.visitlindsborg.com/aboutlindsborgkansas"
    },
    {
      "id": 2,
      "text": "Even after 150 years, Swedish heritage shapes Lindsborg’s architecture, traditions, businesses, churches, schools, and celebrations.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.visitlindsborg.com/aboutlindsborgkansas"
    },
    {
      "id": 3,
      "text": "Lindsborg incorporated as a city in 1879, the same year the first railroad arrived.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Lindsborg%2C_Kansas"
    },
    {
      "id": 4,
      "text": "In 2004, Lindsborg earned the title Chess City of the Year from the U.S. Chess Federation.",
      "sourceSentenceIds": [
