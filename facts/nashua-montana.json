  "facts": [
    {
      "id": 1,
      "text": "Nashua was founded in 1888 as a station on the St. Paul, Minneapolis & Manitoba Railway.",
      "sourceSentenceIds": [
        3,
        14
      ],
      "sourceLabels": [
        "Web source 2",
        "Wikipedia"
      ],
      "source": "https://grokipedia.com/page/nashua_montana",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town’s name comes from a Native American term meaning 'the land between two rivers,' reflecting its location at Porcupine Creek and Milk River confluence.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/nashua_montana",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "During the 1930s construction of Fort Peck Dam, Nashua experienced a brief economic boom as a supply hub for the dam’s laborers.",
      "sourceSentenceIds": [
        6,
        15
      ],
      "sourceLabels": [
        "Web source 2",
        "Wikipedia"
      ],
      "source": "https://grokipedia.com/page/nashua_montana",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Nashua’s climate swings from warm, dry summers to bitterly cold winters, with rapid changes in transitional months.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/nashua_montana",
