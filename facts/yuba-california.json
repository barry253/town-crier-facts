      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Fernando’s Cali Kitchen, housed in a brick‑edged historic downtown building, offers a menu that mirrors California’s culinary diversity.",
      "sourceSentenceIds": [
