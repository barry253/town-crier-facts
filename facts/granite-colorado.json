  "facts": [
    {
      "id": 1,
      "text": "Granite began as a mining camp during the Pike's Peak Gold Rush and once served as Chaffee County’s seat.",
      "sourceSentenceIds": [
        13
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Granite%2C_Colorado"
    },
    {
      "id": 2,
      "text": "The town’s name appeared in 1866 when the Barlow & Sanderson Stage Line made Granite a key stop on its route to Leadville.",
      "sourceSentenceIds": [
        9,
        10
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://westernmininghistory.com/towns/colorado/granite/"
    },
    {
      "id": 3,
      "text": "In 1887 crews laid Denver & Rio Grande tracks through Granite, and the railroad reached Leadville that same summer, opening passenger service the next day.",
      "sourceSentenceIds": [
        19
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Granite%2C_Colorado"
    },
    {
      "id": 4,
      "text": "A 1925 head‑on collision near Granite claimed two lives and injured 107, prompting a nationwide review of train‑order safety.",
      "sourceSentenceIds": [
        20
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Granite%2C_Colorado"
    },
    {
      "id": 5,
      "text": "The town’s river rafting outfit and access to Cache Creek keep Granite alive as a gateway to Colorado’s backcountry adventures.",
      "sourceSentenceIds": [
