      "quality": "good"
    },
    {
      "id": 2,
      "text": "In the late 1850s and 1860s, farmers moved into the prairies around Danvers, turning it into a center of exceptionally productive agriculture.",
      "sourceSentenceIds": [
        15
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
