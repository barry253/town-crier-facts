  "facts": [
    {
      "id": 1,
      "text": "Nelson, Nevada was renamed after Charles Nelson, a camp leader murdered in 1897 by Paiute man Ahvote, honoring his memory.",
      "sourceSentenceIds": [
        2,
        10,
        11
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/Nelson_Nevada",
      "category": "people",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Spanish explorers first discovered silver in Eldorado Canyon in 1775, but it was the 1859 gold strike that sparked Nevada's earliest major mining boom.",
      "sourceSentenceIds": [
        13,
        5
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Nelson%2C_Nevada",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Nelson grew beside the 1905 Los Angeles–Salt Lake railroad, which brought a fifty‑ton smelter and connected the town to the national rail network.",
      "sourceSentenceIds": [
        18,
        27
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 2"
      ],
      "source": "https://en.wikipedia.org/wiki/Nelson%2C_Nevada",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Nelson’s preserved buildings and desert backdrop have hosted several feature films, including 3000 Miles to Graceland, making it a sought‑after shooting spot.",
      "sourceSentenceIds": [
        12,
        30
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 2"
      ],
      "source": "https://en.wikipedia.org/wiki/Nelson%2C_Nevada",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Since the 1990s, private owners have restored historic structures and opened a museum and daily mine tours, breathing new life into the ghost town.",
      "sourceSentenceIds": [
        22,
        25
      ],
