  "facts": [
    {
      "id": 1,
      "text": "Castor's original inhabitants were Caddo Indians who settled on lands rich in wildlife, creeks, clay, and castor bean fields used for food, medicine, and brews.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/castor_louisiana",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The village, once called Old Castor, moved to a new site when the Louisiana and Arkansas Railroad came through, becoming an official village in 1900.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/castor_louisiana",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Local lore says the name Castor comes either from the castor beans or a young Caddo warrior, with a nearby creek named after him.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/castor_louisiana",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "During the Civil War, a salt works operated west of Castor, supplying salt to the Confederacy.",
      "sourceSentenceIds": [
        18,
