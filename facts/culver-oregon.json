  "facts": [
    {
      "id": 1,
      "text": "Culver was originally settled in the 1880s as Perryville, serving as a stage station for travelers in the high desert.",
      "sourceSentenceIds": [
        1,
        2
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/culver_oregon"
    },
    {
      "id": 2,
      "text": "Orace Gabriel Collver founded the town and chose the name Culver to avoid confusion with another similarly named location.",
      "sourceSentenceIds": [
        4,
        15
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Culver%2C_Oregon"
    },
    {
      "id": 3,
      "text": "Culver relocated six miles west in 1909 to align with the arriving Oregon Trunk Railroad.",
      "sourceSentenceIds": [
        1,
        7
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/culver_oregon"
    },
    {
      "id": 4,
      "text": "When the town moved, Orace Gabriel Collver had his entire house transported to the new location.",
      "sourceSentenceIds": [
        17
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Culver%2C_Oregon"
    },
    {
      "id": 5,
      "text": "Culver briefly served as the temporary county seat of Jefferson County from 1915 to 1917.",
      "sourceSentenceIds": [
        11
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/culver_oregon"
    },
    {
      "id": 6,
      "text": "The community center of early Culver featured a general store with a meeting hall upstairs for local events and dances.",
      "sourceSentenceIds": [
        16,
        18
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Culver%2C_Oregon"
    }
  ]
}
