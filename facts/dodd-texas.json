  "facts": [
    {
      "id": 1,
      "text": "Dodd City was founded in 1839 by Major Edmund Hall Dodd and his wife Elizabeth, both from Kentucky.",
      "sourceSentenceIds": [
        4,
        8
      ],
      "sourceLabels": [
        "Web source 1",
        "Web source 2"
      ],
      "source": "https://www.fannincountyhistory.org/dodd-city"
    },
    {
      "id": 2,
      "text": "The town was originally called Quency and had a post office named Lick until the Civil War.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.fannincountyhistory.org/dodd-city"
    },
    {
      "id": 3,
      "text": "The Texas and Pacific Railroad began laying track through Dodd City in 1873, bringing the town into the national rail network.",
      "sourceSentenceIds": [
        7,
        8
      ],
      "sourceLabels": [
        "Web source 1",
        "Web source 2"
      ],
      "source": "https://www.fannincountyhistory.org/dodd-city"
    },
    {
      "id": 4,
      "text": "The Dodd City Spectator newspaper was founded in 1883, making it one of the oldest local papers in the area.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.fannincountyhistory.org/dodd-city"
    },
    {
      "id": 5,
      "text": "The Dodd family’s log cabin, built in 1840 on a hill above a ravine, later became the town’s first post office when it was still called Lick.",
      "sourceSentenceIds": [
        23,
