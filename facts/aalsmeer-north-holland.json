      "quality": "good"
    },
    {
      "id": 3,
      "text": "In 1912, Aalsmeer saw the birth of two auction houses, Centrale Aalsmeerse Veiling and Bloemenlust.",
      "sourceSentenceIds": [
        29
      ],
      "sourceLabels": [
        "Wikipedia"
