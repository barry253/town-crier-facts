  "facts": [
    {
      "id": 1,
      "text": "Hillside Colony was founded in 1951 as a daughter settlement of Sunny Site Hutterite Colony near Warner, Alberta, Canada.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/hillside_colony_montana",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The colony belongs to the Lehrerleut branch of the Hutterian Brethren, an Anabaptist community that practices communal living and agriculture.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/hillside_colony_montana",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Hillside has spawned two daughter colonies—Rimrock near Sunburst and Horizon near Cut Bank—expanding Hutterite presence across Montana.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/hillside_colony_montana",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Residents focus on dairy and crop farming, selling fresh produce and goods at local Montana markets.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/hillside_colony_montana",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The colony sits on flat prairie at about 3,600 feet, with the distant Sweet Grass Hills rising nearly 7,000 feet to the east.",
      "sourceSentenceIds": [
        15,
        16
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/hillside_colony_montana",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "A semi‑arid continental climate brings only about 13.7 inches of precipitation annually, mostly summer rain and winter snow.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 1"
      ],
