  "facts": [
    {
      "id": 1,
      "text": "Miccosukee was first mapped by the British in 1778 and originally called Mikasuki, featuring 60 homes and a town square.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Miccosukee%2C_Florida",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town grew from a Creek Confederacy group that migrated to Florida in the 18th century.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://facts.net/history/culture/35-facts-about-the-miccosukee-nation/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "After the Civil War, farms returned, and by 1887 the Florida Central Railroad linked Miccosukee to the region.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Miccosukee%2C_Florida",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Miccosukee thrived until the boll‑weevil infestation of 1918 devastated crops.",
      "sourceSentenceIds": [
        18
      ],
      "sourceLabels": [
