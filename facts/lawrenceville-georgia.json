  "facts": [
    {
      "id": 1,
      "text": "Lawrenceville was incorporated on December 15, 1821, making it the oldest city in Gwinnett County and the second oldest in the metro Atlanta area.",
      "sourceSentenceIds": [
        25,
        26,
        27,
        4
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Lawrenceville%2C_Georgia",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The city’s name honors Commodore James Lawrence, famed for his “Don’t give up the ship!” command during the War of 1812.",
      "sourceSentenceIds": [
        5,
        2
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Lawrenceville%2C_Georgia",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Lawrenceville’s historic downtown features the Heritage Trail, a series of medallions that celebrate local figures who shaped the city’s history.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Lawrenceville%2C_Georgia",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "During the Civil War, a cotton factory in Lawrenceville supplied the Confederacy; after it burned, a new plant was built to replace it.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.lawrencevillega.org/245/History-of-Lawrenceville",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The Old Seminary Building, Isaac Adair House, and Gwinnett County Courthouse are all listed on the National Register of Historic Places.",
      "sourceSentenceIds": [
        13
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Lawrenceville%2C_Georgia",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The Gwinnett County Public Library’s Hooper‑Renwick Historic School Site is the first themed library of its kind in the southeastern United States.",
