  "facts": [
    {
      "id": 1,
      "text": "Centerville was first settled in April 1808 by Joseph Maxson, who traded a pair of new shoes for an axe to build his first hut.",
      "sourceSentenceIds": [
        10,
        12
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Centerville%2C_New_York",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town’s name comes from its location in the center of several valley confluences, a fact noted by local historian Ronald Taylor.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.alleganyhistory.org/index.php/town-a-village-of-centerville",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Centerville was officially established on January 15, 1819, carved out of the town of Pike in what was then Wyoming County.",
      "sourceSentenceIds": [
        16
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Centerville%2C_New_York",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The first settler, an 18‑year‑old from Otsego County, arrived in 1808 and lived alone for eight months before other families followed.",
      "sourceSentenceIds": [
        3,
        15
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Centerville%2C_New_York",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Sixtown Creek, an important stream, runs through the town and has shaped local agriculture and settlement patterns.",
      "sourceSentenceIds": [
        18
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Centerville%2C_New_York",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Centerville Town Hall earned a place on the National Register of Historic Places in 2009, recognizing its architectural and historical significance.",
