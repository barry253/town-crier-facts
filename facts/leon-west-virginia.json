    {
      "id": 1,
      "text": "Leon is a town in Mason County, West Virginia, situated along the banks of the Kanawha River.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Leon%2C_West_Virginia"
    },
    {
      "id": 2,
      "text": "Benjamin Byram platted the town of Leon in 1840, and it was officially incorporated in 1872.",
      "sourceSentenceIds": [
        23,
        28
      ],
      "sourceLabels": [
        "Web source 1",
        "Web source 2"
      ],
      "source": "https://wvexplorer.com/travel/communities/cities-towns/leon-west-virginia/"
    },
    {
      "id": 3,
      "text": "Leon was originally known as Cologne until the town changed its name in 1880.",
      "sourceSentenceIds": [
        7,
        24
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Leon%2C_West_Virginia"
    },
    {
      "id": 4,
      "text": "The John McCausland House in Leon was listed on the National Register of Historic Places in 1980.",
      "sourceSentenceIds": [
