  "facts": [
    {
      "id": 1,
      "text": "Brownsville was founded in 1846 by families who traveled west on the Oregon Trail to claim land in the Calapooia River valley.",
      "sourceSentenceIds": [
        15
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.historicbrownsville.com/visit-brownsville-or"
    },
    {
      "id": 2,
      "text": "The area now known as Brownsville was originally inhabited by the Kalapuya people.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.visitoregon.com/cities/brownsville-oregon/"
    },
    {
      "id": 3,
      "text": "Brownsville was originally known as Calapooya or Kirk's Ferry, after the ferry operated across the river by early settlers Alexander and Sarah Kirk.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Brownsville%2C_Oregon"
    },
    {
      "id": 4,
      "text": "The Linn County Pioneer Picnic held in Brownsville is Oregon's oldest annual event that is continuously held.",
      "sourceSentenceIds": [
        16
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.historicbrownsville.com/visit-brownsville-or"
    },
    {
      "id": 5,
      "text": "Brownsville features over 60 historic buildings, including homes, churches, and businesses from the late 19th and early 20th centuries.",
      "sourceSentenceIds": [
        21
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.visitoregon.com/cities/brownsville-oregon/"
    },
    {
      "id": 6,
      "text": "Living Rock Studios in Brownsville is a walk-through wonderland of geology, art, and history built as a castle of stone and cement.",
      "sourceSentenceIds": [
        14
