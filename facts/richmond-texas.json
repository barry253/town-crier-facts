  "facts": [
    {
      "id": 1,
      "text": "Richmond, Texas, was named after Richmond, England, incorporated in May 1837, and became the seat of Fort Bend County that same year.",
      "sourceSentenceIds": [
        4,
        5
      ],
      "sourceLabels": [
        "Web source 1",
        "Web source 2"
      ],
      "source": "https://www.richmondtx.gov/about-richmond/history",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The city sits on the Brazos River, fifteen miles southwest of Houston, anchoring it in the heart of the Texas Gulf Coast region.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.tshaonline.org/handbook/entries/richmond-tx",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Morton Cemetery, founded in 1825, is one of Richmond’s oldest public burial grounds and a quiet reminder of early settlers.",
      "sourceSentenceIds": [
        30
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.richmondtx.gov/about-richmond/history",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The 1908 Historic County Courthouse, a classic example of early 20th‑century civic architecture, still stands at the center of downtown Richmond.",
      "sourceSentenceIds": [
        30
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.richmondtx.gov/about-richmond/history",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "After the Civil War, a Freedmen’s Bureau agency opened in Richmond in 1866, and a federal troop company was stationed there the next year.",
      "sourceSentenceIds": [
        27,
        28
      ],
      "sourceLabels": [
        "Web source 1",
        "Web source 2"
      ],
      "source": "https://www.richmondtx.gov/about-richmond/history",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "During the Civil War, many local men joined Confederate units, yet Richmond’s economy largely stayed insulated from the conflict’s worst effects.",
      "sourceSentenceIds": [
        6,
