  "facts": [
    {
      "id": 1,
      "text": "Lumberville was originally called Wall's Saw Mills and Walls Landing, founded by Colonel George Wall in 1775.",
      "sourceSentenceIds": [
        1,
        12,
        13
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Lumberville%2C_Pennsylvania",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "In 1835 a covered bridge spanned the Delaware River to Raven Rock, New Jersey, but one span was lost in the 1903 flood.",
      "sourceSentenceIds": [
        21,
        23,
        24
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Lumberville%2C_Pennsylvania",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The village hosted Lock #12 of the Delaware Canal, a set of locks that moved barges between Easton and Bristol.",
      "sourceSentenceIds": [
        28
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Lumberville%2C_Pennsylvania",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The Black Bass Hotel, built in the early 1740s, later became known as the Rising Sun and other taverns over the years.",
      "sourceSentenceIds": [
        14,
        15
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Lumberville%2C_Pennsylvania",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "William Tinsman acquired the mill property in 1873, abandoned the mill yet kept the lumber business alive, still owned by his family.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://soleburyhistory.org/solebury-history/national-historic-districts-and-landmarks/lumberville/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The 1984 historic designation of Lumberville preserves its two‑centuries‑old character, keeping the village’s 19th‑century mill village charm intact.",
      "sourceSentenceIds": [
        9,
