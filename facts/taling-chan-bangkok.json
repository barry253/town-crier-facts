  "facts": [
    {
      "id": 1,
      "text": "Taling Chan once was mostly orchards and kitchen gardens, earning it the nickname \"Bangkok's Kitchen.\".",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Taling_Chan_district"
    },
    {
      "id": 2,
      "text": "Bang Ramat and Bang Chueak Nang, two zones in Taling Chan, were mentioned during the Ayutthaya period and are among Bangkok's oldest.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Taling_Chan_district"
    },
    {
      "id": 3,
      "text": "The district’s rectangular shape is sliced by many canals, making its layout a maze of waterways.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Taling_Chan_district"
    },
    {
      "id": 4,
      "text": "Electricity reached Taling Chan only in 1972, long after the rest of Bangkok.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Taling_Chan_district"
    },
    {
      "id": 5,
      "text": "In 1987 Chamlong Srimuang launched the floating market to honor King Bhumibol's 60th birthday, reviving a vanished Bangkok tradition.",
      "sourceSentenceIds": [
        11
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Taling_Chan_district"
    },
    {
      "id": 6,
      "text": "The weekend floating market, open 08:30‑16:00, sells produce from boats and features live Thai music from 11:00‑14:00.",
      "sourceSentenceIds": [
