  "facts": [
    {
      "id": 1,
      "text": "Governor Winthrop named the settlement Saye‑Brooke after Viscount Seye and Sele and Lord Brooke when he arrived a month later.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.oldsaybrookct.gov/159/Our-History"
    },
    {
      "id": 2,
      "text": "A rich sense of history and seafaring tradition can be felt throughout Saybrook Manor, where more than 100 homes hold historic significance.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.oldsaybrookct.gov/159/Our-History"
    },
    {
      "id": 3,
      "text": "Old Saybrook's landscape was shaped by continental glaciers that moved south across Connecticut about 22,000 years ago.",
      "sourceSentenceIds": [
        13
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.oldsaybrookct.gov/159/Our-History"
    },
    {
      "id": 4,
      "text": "North Cove was the main harbor of Old Saybrook, deeper before 1871 when railroad fill reduced its opening.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.oldsaybrookct.gov/159/Our-History"
    },
    {
      "id": 5,
      "text": "Before Europeans arrived, the area that is now Saybrook Manor was home to the Algonquin Nehantic Nations.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.oldsaybrookct.gov/159/Our-History"
    },
    {
      "id": 6,
      "text": "Saybrook Manor lies along the southern edge of Long Island Sound, giving it a scenic waterfront.",
