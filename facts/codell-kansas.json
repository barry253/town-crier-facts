      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town’s original post office began as Floreyville in 1875 before relocating to Codell in 1888.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
