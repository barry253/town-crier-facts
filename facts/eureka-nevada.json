  "facts": [
    {
      "id": 1,
      "text": "The town’s name sprang from a prospector’s shout of “Eureka!” after discovering silver ore.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Eureka%2C_Nevada",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Founded in 1864, Eureka grew into Nevada’s fastest boom town, gaining a post office in 1870 and becoming county seat in 1873.",
      "sourceSentenceIds": [
        2,
        3,
        14
      ],
      "sourceLabels": [
        "Web source 1",
        "Wikipedia"
      ],
      "source": "https://www.visiteurekanevada.net/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Eureka’s streets once echoed with the clatter of the narrow‑gauge Eureka and Palisade Railroad, running from 1873 to 1938.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Eureka%2C_Nevada",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The old Eureka Sentinel building, standing since 1879, still houses its original, complete press room.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.visiteurekanevada.net/history",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Only by appointment can visitors explore the last remaining chambers of a 2‑mile tunnel that once crisscrossed downtown Eureka.",
      "sourceSentenceIds": [
        11
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.visiteurekanevada.net/history",
      "category": "other",
      "quality": "poor",
      "qualityReason": "vague"
    },
    {
      "id": 6,
      "text": "Perched at 6,481 feet in the Diamond Mountains, Eureka sits in a draw between Antelope and Newark valleys.",
