  "facts": [
    {
      "id": 1,
      "text": "The East Coast Integrated Depot will be the first Singapore depot to serve three MRT lines and the third to combine bus and train facilities.",
      "sourceSentenceIds": [
        15
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/East_Coast_Integrated_Depot",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Its design saves about 44 hectares of land—roughly the size of 60 football fields—by stacking three levels of train tracks.",
      "sourceSentenceIds": [
        16
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/East_Coast_Integrated_Depot",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The depot can accommodate more than 200 trains of varying lengths and over 550 buses, all within a single site.",
      "sourceSentenceIds": [
        17
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/East_Coast_Integrated_Depot",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Construction began in 2016 and, after a delay, is now slated to finish in the second half of 2026.",
      "sourceSentenceIds": [
        20,
        22
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/East_Coast_Integrated_Depot",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The abandoned Old Changi Hospital, once a British military hospital, is reputedly one of Singapore’s eeriest buildings, while Selarang and Roberts Barracks house the famous Changi Murals and remain closed to the public.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://en.wikivoyage.org/wiki/Singapore/East_Coast",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Katong and Joo Chiat on the East Coast preserve a handful of traditional shophouses that still sell Peranakan crafts and food.",
      "sourceSentenceIds": [
