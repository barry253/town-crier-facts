  "facts": [
    {
      "id": 1,
      "text": "Parque das Nações grew from the 1998 Lisbon World Exposition site, reshaping an old industrial zone into a modern urban quarter.",
      "sourceSentenceIds": [
        16,
        18,
        27
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Parque_das_Na%C3%A7%C3%B5es"
    },
    {
      "id": 2,
      "text": "Santiago Calatrava’s Oriente Station, with its glass‑steel arches, was built to serve the 1998 Expo and now links trains, metro and buses.",
      "sourceSentenceIds": [
        3,
        11,
        15
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.lisbonportugaltourism.com/guide/parque-das-nacoes.html"
    },
    {
      "id": 3,
      "text": "The 142‑meter Vasco da Gama Tower, standing in the park, is Lisbon’s tallest building and a striking skyline marker.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.lisbonportugaltourism.com/guide/parque-das-nacoes.html"
    },
    {
      "id": 4,
      "text": "Parque das Nações Marina hosts 600 berths and a pier for cruise and historic vessels, nestled beside the Tagus Estuary’s bird‑watching reserve.",
      "sourceSentenceIds": [
        7,
        24,
        25,
        26
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Parque_das_Na%C3%A7%C3%B5es"
    },
    {
      "id": 5,
      "text": "Álvaro Siza Vieira’s Portugal Pavilion, with its undulating concrete roof, opened in 1998 and remains a celebrated example of contemporary architecture.",
      "sourceSentenceIds": [
        3,
        10,
        20
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.lisbonportugaltourism.com/guide/parque-das-nacoes.html"
    },
    {
      "id": 6,
      "text": "The park houses the Lisbon Oceanarium, the largest aquarium in Europe, and the Altice Arena, a major concert and sports venue.",
      "sourceSentenceIds": [
        8,
        21
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
