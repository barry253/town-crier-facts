    },
    {
      "id": 2,
      "text": "Crook City emerged during the Black Hills gold rush of the mid-1870s as a hub for miners.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/crook_city_south_dakota"
    },
    {
      "id": 3,
      "text": "The town of Crook City served as a key stopover for freight wagons transporting goods from Nebraska.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/crook_city_south_dakota"
    },
    {
      "id": 4,
      "text": "Crook City was designated as the initial county seat of Lawrence County in April 1877.",
      "sourceSentenceIds": [
        17
