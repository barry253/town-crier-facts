  "facts": [
    {
      "id": 1,
      "text": "Frankford was laid out in 1819 on land owned by Solomon Fisher, a pioneer from Kentucky.",
      "sourceSentenceIds": [
        30
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/frankford_missouri",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "A post office opened in 1830, likely named after Frankfort, Kentucky, the former home of early settlers.",
      "sourceSentenceIds": [
        14,
        15
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Frankford%2C_Missouri",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The town grew in the 1830s as farmers moved in, and it was officially recorded in 1831.",
      "sourceSentenceIds": [
        1,
        3
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/frankford_missouri",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The Short Line Railroad reached Frankford in the 1870s, linking it to regional markets after a $40,000 bond issue.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/frankford_missouri",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Early trades included blacksmithing, cabinetmaking, and shoemaking, with the first store opening in 1820.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/frankford_missouri",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "By 1920 the population had dropped to 653, a decline driven by mechanization and the Great Depression.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Web source 2"
      ],
