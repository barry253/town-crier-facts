  "facts": [
    {
      "id": 1,
      "text": "Campbellton earned its name in 1833, honoring Lieutenant‑Governor Sir Archibald Campbell after a long string of French and Scottish nicknames.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Campbellton%2C_New_Brunswick"
    },
    {
      "id": 2,
      "text": "The 1875 Intercolonial Railway arrival and a permanent station in 1876 turned Campbellton into a bustling rail hub, with 16 trains daily at its Central Station.",
      "sourceSentenceIds": [
        16,
        22
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Campbellton%2C_New_Brunswick"
    },
    {
      "id": 3,
      "text": "Campbellton’s 18‑hole Restigouche Golf Club, founded in 1923, offers a scenic round overlooking the Restigouche River.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Campbellton%2C_New_Brunswick"
    },
    {
      "id": 4,
      "text": "Legend says the infamous Fireship of Baie des Chaleurs once drifted through Campbellton’s waters, a phantom vessel haunting local lore.",
      "sourceSentenceIds": [
        8,
        13
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Campbellton%2C_New_Brunswick"
    },
    {
      "id": 5,
      "text": "Riverside Park hosts two historic cannons from the Restigouche battle, one bearing three fleurs‑de‑lys and the other stylized anchors.",
      "sourceSentenceIds": [
        9,
        14
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Campbellton%2C_New_Brunswick"
    },
    {
      "id": 6,
      "text": "In 2017, Campbellton marked 50 years of its Salmon Festival and its Centennial Library, celebrating local culture and heritage.",
      "sourceSentenceIds": [
        19
      ],
