  "facts": [
    {
      "id": 1,
      "text": "Founded in 1905 by the Phosphate Mining Company, Nichols began as a company town built to house workers extracting phosphate.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/nichols_florida"
    },
    {
      "id": 2,
      "text": "The town’s layout featured a commissary, schools, churches, and medical facilities, all constructed to support the mining workforce.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/nichols_florida"
    },
    {
      "id": 3,
      "text": "Nichols sits on the CSX Valrico Subdivision, a railroad that once hauled phosphate ore and supplies across Central Florida.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/nichols_florida"
    },
    {
      "id": 4,
      "text": "The surrounding geology is rich in phosphate‑laden Bone Valley Member sands, making the area a prime mining hotspot.",
      "sourceSentenceIds": [
        24
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/nichols_florida"
    },
    {
      "id": 5,
      "text": "Hydrologically, Nichols lies near the Peace River and North Prong of the Alafia River, where sinkholes can form in the karst landscape.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/nichols_florida"
    },
    {
      "id": 6,
      "text": "Located 11.4 miles south‑southwest of Lakeland, Nichols is accessed via Polk County Road 676 and State Road 60.",
