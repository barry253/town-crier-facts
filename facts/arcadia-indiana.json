  "facts": [
    {
      "id": 1,
      "text": "Arcadia was named after the ancient Greek region, chosen by Judge Jeremiah Smith in the 1830s, after settlers first called it 'Shaltz'.",
      "sourceSentenceIds": [
        2,
        3
      ],
      "sourceLabels": [
        "Web source 2",
        "Wikipedia"
      ],
      "source": "https://talktoannie.com/discover-arcadia-indiana-a-quiet-retreat-with-a-rich-history/",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town was laid out in 1849 when the Peru‑Indianapolis Railroad surveyed a route across land owned by Shaffer and Waltz, and the railroad was completed by 1852.",
      "sourceSentenceIds": [
        1,
        10,
        11
      ],
      "sourceLabels": [
        "Wikipedia",
        "Wikipedia",
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Arcadia%2C_Indiana",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "In the late 1800s, gas donated by Arcadia powered the Baker Glass Company and later the Flint House Glass Company, turning the town into a glass‑making hub.",
      "sourceSentenceIds": [
        7,
        8
      ],
      "sourceLabels": [
        "Wikipedia",
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Arcadia%2C_Indiana",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The Arcadia Cheese Factory opened in 1898, marking the town’s entry into dairy manufacturing.",
