      ],
      "source": "https://en.wikipedia.org/wiki/Berkeley_Township%2C_New_Jersey",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The Royal Pines Hotel, a $1.175 million investment facing Crystal Lake, was built on the site of an earlier hotel dating back to the days of Barnegat Park.",
      "sourceSentenceIds": [
        27
      ],
      "sourceLabels": [
        "Wikipedia"
