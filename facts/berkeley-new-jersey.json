      ],
      "source": "https://en.wikipedia.org/wiki/Berkeley_Township%2C_New_Jersey",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Between 1928 and 1929, about 8,000 lots were sold in Pinewald, a 'new-type, residential, recreational city-of-the sea-and-pines.'.",
      "sourceSentenceIds": [
        25
      ],
      "sourceLabels": [
