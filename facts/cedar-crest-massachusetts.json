  "facts": [
    {
      "id": 1,
      "text": "Cedar Crest earned its name when a handful of cedar trees sprouted atop the former Gotham Hill, inspiring the community’s new identity.",
      "sourceSentenceIds": [
        5,
        16,
        21,
        22
      ],
      "sourceLabels": [
        "Web source 2",
        "Wikipedia"
      ],
      "source": "https://grokipedia.com/page/cedar_crest_massachusetts",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The ridge that forms Cedar Crest climbs 82 feet, providing a gentle overlook of Massachusetts Bay.",
      "sourceSentenceIds": [
        5,
        6
      ],
      "sourceLabels": [
        "Web source 2",
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/cedar_crest_massachusetts",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Cedar Crest’s layout is densely walkable, with many single-family homes overlooking the waterfront, echoing its nautical heritage.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/cedar_crest_massachusetts",
      "category": "other",
      "quality": "poor",
      "qualityReason": "other"
    },
    {
      "id": 4,
      "text": "Cedar Crest borders Duxbury to the south and Green Harbor to the southeast, yet it remains an unincorporated community in Plymouth County.",
