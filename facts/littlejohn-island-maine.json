  "facts": [
    {
      "id": 1,
      "text": "Littlejohn Island, Cousins River, and Cousins Island all bear the name of Englishman John Cousins, who arrived from Marlborough, Wiltshire in the 1600s.",
      "sourceSentenceIds": [
        1,
        5
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Littlejohn_Island",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Long before Europeans, the Abenaki called Littlejohn Island Pemasong and used it for seasonal camps, leaving shell middens that reveal a 12,000‑year heritage.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/littlejohn_island",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "A bridge built in 1896, later rebuilt in 1941 and 1968, linked Littlejohn to Cousins Island, turning isolated farms into a summer retreat.",
      "sourceSentenceIds": [
        9,
        7
      ],
      "sourceLabels": [
        "Web source 1",
        "Wikipedia"
      ],
      "source": "https://grokipedia.com/page/littlejohn_island",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "During World War II, Littlejohn Island hosted U.S. military personnel who installed submarine nets to protect Portland Harbor.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/littlejohn_island",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Oak‑pine forests and rocky beaches on Littlejohn Island shelter bald eagles, great horned owls, and the famed Morning Flight of migrating birds.",
      "sourceSentenceIds": [
