  "facts": [
    {
      "id": 1,
      "text": "Custer Park sits on Illinois Route 113 along the south bank of the Kankakee River, just 4.5 miles east‑southeast of Braidwood.",
      "sourceSentenceIds": [
        8,
        10
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Custer_Park%2C_Illinois"
    },
    {
      "id": 2,
      "text": "The township that became Custer Park was organized in 1886, breaking away from the larger Reed Township and naming itself after General George Custer.",
      "sourceSentenceIds": [
        21,
        22,
        23
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://will-ilgw.genealogyvillage.com/townships/1907past6cust.htm"
    },
    {
      "id": 3,
      "text": "Early settlers arrived as far back as 1840, establishing farms along the Kankakee River and using flatboats to ship crops downriver to Chicago.",
      "sourceSentenceIds": [
        28
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://will-ilgw.genealogyvillage.com/townships/1907past6cust.htm"
    },
    {
      "id": 4,
      "text": "Before railroads, small steamers once navigated the Kankakee and Desplaines Rivers, carrying farmers’ surplus to Chicago.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://will-ilgw.genealogyvillage.com/townships/1907past6cust.htm"
    },
    {
      "id": 5,
      "text": "Custer Park’s name honors the famed Indian fighter, reflecting the national trend of commemorating military figures in place names during the late 19th century.",
      "sourceSentenceIds": [
        23
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://will-ilgw.genealogyvillage.com/townships/1907past6cust.htm"
    }
  ]
