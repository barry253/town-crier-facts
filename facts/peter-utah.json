  "facts": [
    {
      "id": 1,
      "text": "Peter, Utah, was named in honor of Peter Maughan, an early Mormon settler and church leader who helped organize Cache Valley.",
      "sourceSentenceIds": [
        1,
        3,
        4
      ],
      "sourceLabels": [
        "Web source 1",
        "Wikipedia"
      ],
      "source": "https://grokipedia.com/page/peter_utah"
    },
    {
      "id": 2,
      "text": "Sylvanus Collett first settled the area, originally known as Petersboro, in 1867 near a small spring by the Bear River.",
      "sourceSentenceIds": [
        2,
        11
      ],
      "sourceLabels": [
        "Web source 1",
        "Wikipedia"
      ],
      "source": "https://grokipedia.com/page/peter_utah"
    },
    {
      "id": 3,
      "text": "Early settlers in Peter included families from England, Scotland, and Denmark who built log homesteads along local streams and springs.",
      "sourceSentenceIds": [
        22
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/peter_utah"
    },
    {
      "id": 4,
      "text": "Peter historically centered on cattle raising and dry farming, using techniques that allowed wheat and alfalfa to grow without irrigation.",
      "sourceSentenceIds": [
        6,
        23
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/peter_utah"
    },
    {
      "id": 5,
      "text": "The landscape of Peter features a semi-arid continental climate with elevations reaching up to 5,000 feet above sea level.",
      "sourceSentenceIds": [
        9,
        26,
        30
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/peter_utah"
    },
    {
      "id": 6,
      "text": "Residents of Peter participate in a traditional May Day celebration every year alongside the people of nearby Mendon.",
      "sourceSentenceIds": [
        13
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
