  "facts": [
    {
      "id": 1,
      "text": "North Capitol Hill once housed Denver's elite in grand Victorian and Queen Anne mansions that later became boarding houses for working‑class families.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/north_capitol_hill_denver",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "By the mid‑20th century, artists and musicians turned the area into a bohemian hub with eclectic shops, cafés, and a Restaurant Row along Seventeenth Avenue.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/north_capitol_hill_denver",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The Esquire Theatre, originally the Hiawatha Theater opened in 1927, served as Denver's primary art‑house cinema until its July 2024 closure.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Capitol_Hill%2C_Denver",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "North Capitol Hill borders the Colorado State Capitol and Downtown Denver, placing it just east of Broadway and west of City Park.",
      "sourceSentenceIds": [
        23
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Capitol_Hill%2C_Denver",
      "category": "other",
      "quality": "poor",
      "qualityReason": "location_description"
    },
    {
      "id": 5,
      "text": "The neighborhood’s proximity to City Park means residents enjoy easy access to the Denver Zoo and the Museum of Nature & Science.",
      "sourceSentenceIds": [
        16
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/north_capitol_hill_denver",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "In the 1950s and 1960s, urban renewal demolished historic structures along East Colfax Avenue, replacing them with commercial developments and modern apartments.",
      "sourceSentenceIds": [
        18
      ],
      "sourceLabels": [
        "Web source 1"
      ],
