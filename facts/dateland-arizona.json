  "facts": [
    {
      "id": 1,
      "text": "Dateland began as a simple road stop in the 1920s, serving travelers between Yuma and Gila Bend.",
      "sourceSentenceIds": [
        16
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Dateland%2C_Arizona",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "During World War II, General Patton’s desert training camps—Camp Horn and Camp Hyder—were located right in Dateland.",
      "sourceSentenceIds": [
        17
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Dateland%2C_Arizona",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "In 1942, three airstrips were built in Dateland to train B‑25 bombers, including the Dateland Air Force Auxiliary Field.",
      "sourceSentenceIds": [
        18
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Dateland%2C_Arizona",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Sugar rationing in 1942 pushed Arizona to grow more dates, turning Dateland into a key producer of the state’s famous date palms.",
      "sourceSentenceIds": [
        21
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Dateland%2C_Arizona",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The town’s name reflects its desert oasis vibe, with a historic date grove still standing beside the original café, gift shop, and gas station.",
      "sourceSentenceIds": [
        11
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.dateland.com/history-of-dateland-arizona/",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Even today, U.S. troops from Iraq and Afghanistan train in Dateland’s open desert, continuing the area’s military legacy.",
      "sourceSentenceIds": [
