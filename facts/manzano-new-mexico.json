  "facts": [
    {
      "id": 1,
      "text": "Manzano’s name comes from the Spanish word for 'apple tree,' reflecting the region’s historic apple orchards.",
      "sourceSentenceIds": [
        22
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Manzano%2C_New_Mexico",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The Quarai Ruins of Salinas Pueblo Missions National Monument sit just outside Manzano, offering a glimpse into ancient Pueblo life.",
      "sourceSentenceIds": [
        20
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Manzano%2C_New_Mexico",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Spanish colonists in the early 1800s turned Manzano into a mission town, with the Catholic Church guiding land grants and settlement.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://unitedstatesghosttowns.com/manzano-new-mexico-ghost-town/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Between 1100 and 1300, Tompiro and Tiwa peoples built stone villages on Manzano Mountain’s eastern slopes, creating a thriving prehistoric trade hub.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://unitedstatesghosttowns.com/manzano-new-mexico-ghost-town/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Late 17th‑century droughts and raids forced both Indigenous peoples and Spanish settlers to abandon homes, sparking Manzano’s decline.",
      "sourceSentenceIds": [
        11
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://unitedstatesghosttowns.com/manzano-new-mexico-ghost-town/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Manzano’s cultural tourism spotlights the blend of Tiwa, Tompiro, and Spanish mission heritage, drawing visitors to historic ruins and mission‑era architecture.",
      "sourceSentenceIds": [
