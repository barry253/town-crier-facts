    },
    {
      "id": 2,
      "text": "The town of Lone Wolf is named for Chief Lone Wolf, a Kiowa warrior chief who fought to preserve his people's autonomy.",
      "sourceSentenceIds": [
        5,
        8
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Lone_Wolf%2C_Oklahoma"
    },
    {
      "id": 3,
      "text": "Lone Wolf was established along the Chicago, Rock Island and Pacific Railway to help the settlement grow quickly.",
      "sourceSentenceIds": [
        8,
        9
      ],
      "sourceLabels": [
        "Web source 1",
        "Wikipedia"
      ],
      "source": "https://www.okhistory.org/publications/enc/entry?entry=LO008"
    },
    {
