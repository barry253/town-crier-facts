  "facts": [
    {
      "id": 1,
      "text": "Fujiidera lies where the Yamato and Ishikawa rivers meet, giving the city its name and a scenic waterfront.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Fujiidera",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Part of the Mozu‑Furuichi Kofun Group, Fujiidera hosts more than 30 well‑preserved ancient tombs that earned UNESCO World Heritage status in 2019.",
      "sourceSentenceIds": [
        5,
        8
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 2"
      ],
      "source": "https://en.wikipedia.org/wiki/Fujiidera",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Historically, Fujiidera occupied the site of Kawachi Province’s capital, a center of governance during Japan’s ancient era.",
      "sourceSentenceIds": [
        20
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Fujiidera",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Fujiidera Stadium, built in 1928, was the home field for the Kintetsu Buffaloes until they moved to Osaka Dome in 1997.",
      "sourceSentenceIds": [
        28
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Fujiidera",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The city’s flat landscape is safeguarded by high levees, and both riverbanks are maintained as recreational promenades.",
      "sourceSentenceIds": [
