  "facts": [
    {
      "id": 1,
      "text": "Henderson was incorporated in 1971 after levees forced residents of the former Village of Atchafalaya to relocate.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.cajuncountry.org/travel-to-st-martin-parish/about/towns/henderson/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "First appearing on maps as \"New Henderson Landing\" in the 1940s, the town evolved into a Cajun culture hub known for cuisine, crawfish, and swamp tours.",
      "sourceSentenceIds": [
        13
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.cajuncountry.org/travel-to-st-martin-parish/about/towns/henderson/",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Henderson is famous for its boiled crawfish, a staple of the Atchafalaya Swamp cuisine.",
      "sourceSentenceIds": [
        21
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.louisiana-destinations.com/henderson.htm",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Located east of Lafayette on I‑10, Henderson sits in the heart of Cajun Country and America's wetland, the Atchafalaya Basin.",
      "sourceSentenceIds": [
        23
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.louisiana-destinations.com/henderson.htm",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Henderson Lake lies in the West Atchafalaya Basin Floodway between Ramah and Henderson, reflecting the region's floodplain.",
      "sourceSentenceIds": [
        27
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.louisiana-destinations.com/henderson.htm",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Each November, the town hosts the Atchafalaya Basin Festival in Henry Guidry Memorial Park, celebrating local culture and nature.",
      "sourceSentenceIds": [
        29
