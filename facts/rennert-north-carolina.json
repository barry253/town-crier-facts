  "facts": [
    {
      "id": 1,
      "text": "Rennert began as Alpin's Grove, named for Scottish settler James McAlpin who served in the British army during the American Revolution.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Rennert%2C_North_Carolina",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "When the Atlantic Coast Line Railroad arrived, the town was renamed Rennert after a New York City hotel, a nod to rail influence.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Rennert%2C_North_Carolina",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Rennert was incorporated in 1895, lost its charter in 1947, and had the incorporation restored in 1977.",
      "sourceSentenceIds": [
        10,
        11
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Rennert%2C_North_Carolina",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The town sits in Robeson County, part of North Carolina’s Coastal Plain, characterized by flat terrain and wetlands.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Rennert%2C_North_Carolina",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Rennert lies roughly 80 miles south of Raleigh, about 20 miles southwest of Fayetteville, close to the South Carolina border.",
      "sourceSentenceIds": [
        26
      ],
