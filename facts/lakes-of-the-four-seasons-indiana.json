  "facts": [
    {
      "id": 1,
      "text": "Lakes of the Four Seasons straddles Porter and Lake counties, with the county line cutting through its center.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Lakes_of_the_Four_Seasons%2C_Indiana"
    },
    {
      "id": 2,
      "text": "The four lakes—Lake Holiday, Big Bass Lake, Lake on the Green, and Trouthaven Lake—connect through Stony Run and the Deep River, feeding the Kankakee and Little Calumet watersheds.",
      "sourceSentenceIds": [
        8,
        9,
        10
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Lakes_of_the_Four_Seasons%2C_Indiana"
    },
    {
      "id": 3,
      "text": "In 1973 the private community was founded, and in 2023 it celebrated its 50th anniversary with a light show, fireworks, and a commemorative hardcover book.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.chicagotribune.com/2016/04/15/milestone-inside-the-gate-lofs-marks-50-years-2/"
    },
    {
      "id": 4,
      "text": "Porter‑side residents attend Porter Township schools, while Lake‑side residents belong to the Crown Point school system.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Lakes_of_the_Four_Seasons%2C_Indiana"
    },
    {
      "id": 5,
      "text": "The lakes attracted early settlers, including Sally Lugo and her husband Richard Brown, who moved there in 1985.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.chicagotribune.com/2016/04/15/milestone-inside-the-gate-lofs-marks-50-years-2/"
    },
    {
      "id": 6,
      "text": "Its 50th‑anniversary celebrations featured a pig roast, water show, marching band parade, and a special fireworks display.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 2"
      ],
