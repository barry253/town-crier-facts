      "id": 1,
      "text": "Buikslotermeer was once a 340-hectare lake drained in 1627, now a polder in Amsterdam-Noord.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Buikslotermeer"
    },
    {
      "id": 2,
      "text": "The polder’s western ring ditch became part of the Noordhollandsch Kanaal in 1824, linking it to the canal network.",
      "sourceSentenceIds": [
        13
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Buikslotermeer"
    },
    {
      "id": 3,
      "text": "In 1916 the Buikslotermeerpolder flooded again, the last time before modern drainage systems took over.",
      "sourceSentenceIds": [
        15
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Buikslotermeer"
    },
    {
      "id": 4,
      "text": "The neighborhood hosts IKC De Buikslotermeer, a public primary school known for its extensive curriculum and community ties.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://amsterdamlokaal.nl/buikslotermeer/"
    },
    {
      "id": 5,
      "text": "A ferry from Amsterdam Central Station is the most popular way to reach Buikslotermeer, reflecting its historic water connections.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://amsterdamcitycard.com/buikslotermeer-amsterdam-read-this-before-your-visit/"
    },
