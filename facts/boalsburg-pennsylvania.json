    },
    {
      "id": 3,
      "text": "The name Boalsburg comes from the Boal family, Irish emigrants from County Londonderry.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Boalsburg%2C_Pennsylvania",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The Columbus Chapel, brought from Spain in 1919, sits in the Boal Mansion and houses an admiral’s desk said to belong to Columbus.",
      "sourceSentenceIds": [
        13
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Boalsburg%2C_Pennsylvania",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Boalsburg’s market square, called “the Diamond,” mirrors the town‑design style of Ulster, Ireland, brought by early settlers.",
