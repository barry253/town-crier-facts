  "facts": [
    {
      "id": 1,
      "text": "Coulterville was founded in 1850 during the Gold Rush, drawing miners to Maxwell Creek.",
      "sourceSentenceIds": [
        6,
        23
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Coulterville%2C_California",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town’s original name was Banderita, a nickname from a flag atop George Coulter’s tent that sparked the Spanish term “little flag.”.",
      "sourceSentenceIds": [
        10,
        13
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Coulterville%2C_California",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Coulterville’s Main Street Historic District, listed on the National Register, preserves surviving 19th‑century commercial buildings.",
      "sourceSentenceIds": [
        22,
        28
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Coulterville%2C_California",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The Coulterville Road, completed in 1874, was one of the first wagon routes into Yosemite Valley, bringing tourists to the town.",
      "sourceSentenceIds": [
        12,
        26
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Coulterville%2C_California",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The former Coulter Hotel now houses the Northern Mariposa County History Center, keeping the town’s mining heritage alive.",
