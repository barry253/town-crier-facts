  "facts": [
    {
      "id": 1,
      "text": "Kohler began as a model company town in 1900 when the Kohler Company moved its plant from Sheboygan to the Riverside site.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Kohler%2C_Wisconsin"
    },
    {
      "id": 2,
      "text": "The village officially became incorporated in 1912, adopting the name Kohler as a distinct municipality.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Kohler%2C_Wisconsin"
    },
    {
      "id": 3,
      "text": "Starting in 1917, Kohler’s planners hired the renowned Olmsted Brothers to design its green streets and parks.",
      "sourceSentenceIds": [
        11
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Kohler%2C_Wisconsin"
    },
    {
      "id": 4,
      "text": "Even today, the Kohler Company keeps final say over any home or business addition to preserve the village’s classic look.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Kohler%2C_Wisconsin"
    },
    {
      "id": 5,
      "text": "Kohler sits along the Sheboygan River, giving the village a picturesque waterfront setting.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Kohler%2C_Wisconsin"
    },
    {
      "id": 6,
      "text": "The Shops at Woodlake Kohler and Deertrace are the village’s two main shopping hubs, each offering unique local retailers.",
