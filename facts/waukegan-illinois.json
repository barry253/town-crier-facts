    },
    {
      "id": 2,
      "text": "The museum’s exhibits trace Waukegan’s story from the Ice Age through the 21st century.",
      "sourceSentenceIds": [
        11
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.visitlakecounty.org/WaukeganHistoryMuseumattheCarnegie"
    },
    {
      "id": 3,
      "text": "The historic Genesee Theatre still hosts concerts, comedy, and live performances, keeping downtown culture alive.",
