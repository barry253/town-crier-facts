      "id": 1,
      "text": "The Waukegan History Museum at The Carnegie, built in 1903, has been beautifully restored and now serves as a regional treasure.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 2"
      ],
