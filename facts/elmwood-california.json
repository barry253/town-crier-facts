  "facts": [
    {
      "id": 1,
      "text": "Elmwood was the first Berkeley subdivision and one of the first U.S. neighborhoods to receive single‑family residential zoning.",
      "sourceSentenceIds": [
        13
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Elmwood%2C_Berkeley%2C_California",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The neighborhood’s early‑20th‑century zoning was designed to keep density low and, according to records, to exclude non‑white residents.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/elmwood_berkeley_california",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "In 1905, the Elmwood Park tract was bounded by Claremont and College Avenues and Prince and Russell Streets, forming the core of the neighborhood.",
      "sourceSentenceIds": [
        22
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Elmwood%2C_Berkeley%2C_California",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The historic Rialto Cinemas Elmwood, a renovated 1914 theater originally called the Strand, once pioneered family‑oriented and later foreign films in the area.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/elmwood_berkeley_california",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Elmwood’s streetcar suburb origins placed it on open land away from central Berkeley, later absorbed by the East Bay’s urban expansion.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Elmwood%2C_Berkeley%2C_California",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The neighborhood’s single‑family zoning, first set in 1919 and reaffirmed in 1949, has preserved its low‑density residential character through the 1960s and beyond.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/elmwood_berkeley_california",
      "category": "culture",
      "quality": "good"
    }
