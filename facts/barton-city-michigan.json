  "facts": [
    {
      "id": 1,
      "text": "Barton City began as Mud Lake, a post office opened March 10 1887 on the shore of what is now Jewell Lake.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Barton_City%2C_Michigan",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "In 1912, two surveyors stayed with resident Frank Barton, platted the town, and named it after him.",
      "sourceSentenceIds": [
        2,
        4,
        7
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1",
        "Web source 2"
      ],
      "source": "https://en.wikipedia.org/wiki/Barton_City%2C_Michigan",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "A bustling lumber hub featured a railroad station that housed a post office, general store, lodging, and dining for loggers.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/barton_city_michigan",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "When timber ran out, Barton City shifted from logging to recreational use, attracting visitors to its lakes and forests.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/barton_city_michigan",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Every July 4th, Barton City hosts the Biggest Little Fourth in the North, featuring a grease pole contest, sawdust pile, and fireworks.",
      "sourceSentenceIds": [
        18,
        19
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Barton_City%2C_Michigan",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Nestled on Jewell Lake’s eastern shore, Barton City lies within the expansive Huron‑Manistee National Forests of northeastern Michigan.",
      "sourceSentenceIds": [
        12,
        29
      ],
