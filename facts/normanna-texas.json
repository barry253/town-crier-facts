      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The San Antonio and Aransas Pass Railway cut through Normanna in 1896, pulling settlers from San Domingo to the new tracks.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.tshaonline.org/handbook/entries/normanna-tx",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Normanna sits on Bee County’s northern edge, just 2½ miles east of the original San Domingo settlement.",
      "sourceSentenceIds": [
        25
      ],
      "sourceLabels": [
