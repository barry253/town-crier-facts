      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The canyon stretches southwest into Tonto National Forest, rising over 3,000 feet to Signal Peak at 7,812 feet.",
      "sourceSentenceIds": [
