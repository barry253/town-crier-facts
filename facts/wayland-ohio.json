    {
      "id": 1,
      "text": "Wayland was originally called Newport and served as a stop along the Pennsylvania and Ohio Canal.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Wayland%2C_Ohio",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "In 1900, confusion over the railroad name Cyclone prompted residents to rename the town Wayland after minister Wayland Hoyt.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Wayland%2C_Ohio",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The first shoe factory opened in 1830 at Main and Commonwealth, sparking Wayland’s industrial boom.",
      "sourceSentenceIds": [
        17
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.waylandpost.org/community/historical-tour-includes-fun-facts-about-wayland/",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "A walking tour in 2025 highlighted buildings built between 1868‑1890 that once housed shoe‑factory managers and their businesses, showcasing Wayland’s 19th‑century architecture.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.waylandpost.org/community/historical-tour-includes-fun-facts-about-wayland/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The Methodist Church, erected in 1868, anchors the historic downtown and was the tour’s starting point.",
      "sourceSentenceIds": [
        15
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.waylandpost.org/community/historical-tour-includes-fun-facts-about-wayland/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "A playground named Hannah Williams Playground honors the mother of 13 children, funded by a factory‑owner foundation.",
