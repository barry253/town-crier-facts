      "id": 1,
      "text": "Apple Valley was founded in the early 1970s by American Central Corporation as a planned residential and recreational community.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/apple_valley_ohio",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Apple Valley Lake is a 511‑acre engineered reservoir created by damming Little Jelloway Creek, surrounded by the community.",
      "sourceSentenceIds": [
        15,
        1
      ],
      "sourceLabels": [
        "Web source 1",
        "Wikipedia"
      ],
      "source": "https://grokipedia.com/page/apple_valley_ohio",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The community contains a golf course that has been a staple of its resort‑style identity since the 1970s.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Apple_Valley%2C_Ohio",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Residents enforce no‑wake hours from sunset to sunrise and scheduled beach maintenance to keep Apple Valley Lake among Ohio’s cleanest lakes.",
      "sourceSentenceIds": [
        10,
        9
      ],
      "sourceLabels": [
        "Web source 1",
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/apple_valley_ohio",
      "category": "other",
      "quality": "poor",
      "qualityReason": "other"
    },
    {
      "id": 5,
      "text": "The Knox County Sewer District, founded in 1971, began treating wastewater for Apple Valley with a plant capable of 2 million gallons per day.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/apple_valley_ohio",
