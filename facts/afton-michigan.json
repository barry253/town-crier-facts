  "facts": [
    {
      "id": 1,
      "text": "Afton got its name in 1906 when resident McPherson suggested it, inspired by Scotland's River Afton because the local Pigeon River looked similar.",
      "sourceSentenceIds": [
        2,
        6
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Afton%2C_Michigan",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The Michigan Central Railroad opened a logging branch to Afton in 1903, bringing the first train to the stone quarry on May 29, 1903.",
      "sourceSentenceIds": [
        4,
        13,
        14
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Afton%2C_Michigan",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The area that is now Afton was first settled in 1887 as a lumber camp by Patrick O’Connor, part of Cheboygan County’s boom during the 1880s timber rush.",
      "sourceSentenceIds": [
        12,
        28,
        29
      ],
      "sourceLabels": [
        "Web source 1",
        "Wikipedia"
      ],
      "source": "https://grokipedia.com/page/afton_michigan",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Monica’s Catholic Mission Church, built in 1937, still hosts Sunday Masses and sits beside a historic cemetery, reflecting Afton’s enduring religious heritage.",
      "sourceSentenceIds": [
        11
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/afton_michigan",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Afton sits in the Pigeon River watershed, where the main branch flows west and the Little Pigeon’s middle branch runs east, while Kimberly Creek skirts its eastern edge.",
