  "facts": [
    {
      "id": 1,
      "text": "Nanticoke, Maryland sits on the Eastern Shore and is part of the Salisbury Metropolitan Statistical Area.",
      "sourceSentenceIds": [
        16
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Nanticoke%2C_Maryland",
      "category": "other",
      "quality": "poor",
      "qualityReason": "location_description"
    },
    {
      "id": 2,
      "text": "The Nanticoke people, whose name means “tidewater people,” were an Algonquian‑speaking confederacy living along the Chesapeake Bay.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.britannica.com/topic/Nanticoke-people",
      "category": "people",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Captain John Smith first recorded contact with the Nanticoke in 1608 while exploring the Kuskarawaok River, now the Nanticoke River.",
      "sourceSentenceIds": [
        17,
        18,
        19
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.nanticokeindians.org/about/history/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "During the 17th century, the Nanticoke and the Choptank were the only native tribes still living on Maryland’s Eastern Shore, surviving 70 years of conflict with European settlers.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.nanticokeindians.org/about/history/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The Nanticoke cultivated gardens of corn, beans, squash, pumpkins, sunflowers, and tobacco, sustaining their community through agriculture.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.nanticokeindians.org/about/history/",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "In 1742, after nearly a century of conflict, the Nanticoke petitioned Maryland authorities for land tracts, but were forced to agree not to leave their reservation.",
      "sourceSentenceIds": [
        4,
        11,
        12
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.nanticokeindians.org/about/history/",
