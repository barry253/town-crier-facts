  "facts": [
    {
      "id": 1,
      "text": "Abeytas Pueblo, the northernmost Piro settlement, thrived from about AD 1300 until roughly 1540 during the Pueblo IV period.",
      "sourceSentenceIds": [
        20,
        21
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/abeytas_new_mexico"
    },
    {
      "id": 2,
      "text": "The Abeytas Pueblo stretched 350 to 15,000 square meters, housing 200–300 rooms built of adobe and featuring a central plaza.",
      "sourceSentenceIds": [
        6,
        22
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/abeytas_new_mexico"
    },
    {
      "id": 3,
      "text": "Abeytas sits at 34°27′55″N 106°48′50″W, rising to about 4,750 feet above sea level.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/abeytas_new_mexico"
    },
    {
      "id": 4,
      "text": "The town receives roughly 10 inches of rain yearly, mostly during July‑September monsoons, with dry winters.",
      "sourceSentenceIds": [
        14
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/abeytas_new_mexico"
    },
    {
      "id": 5,
      "text": "Abeytas lies within the Chihuahuan Desert, where mesquite dominates uplands and cottonwood trees line the Rio Grande.",
      "sourceSentenceIds": [
        16
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/abeytas_new_mexico"
    },
    {
      "id": 6,
      "text": "After Juan de Oñate’s 1598 expedition, Abeytas became part of New Spain during the early Spanish colonization of New Mexico.",
      "sourceSentenceIds": [
