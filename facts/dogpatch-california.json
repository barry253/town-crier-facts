      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Dogpatch%2C_San_Francisco",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The neighborhood’s oldest public school, Scott School, was built in 1895 and still stands on 3rd Street.",
      "sourceSentenceIds": [
        13
      ],
      "sourceLabels": [
