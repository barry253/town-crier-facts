  "facts": [
    {
      "id": 1,
      "text": "Dogpatch got its name from Al Capp’s comic strip Li’l Abner, where the fictional town sat in a remote, back‑water valley.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Dogpatch%2C_San_Francisco"
    },
    {
      "id": 2,
      "text": "Originally part of Spanish land grant Potrero Nuevo, Dogpatch’s history runs parallel to neighboring Potrero Hill.",
      "sourceSentenceIds": [
        1,
        14
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Dogpatch%2C_San_Francisco"
    },
    {
      "id": 3,
      "text": "In 1856 San Francisco Cordage opened a massive Manila rope factory that powered ships across the Pacific.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Dogpatch%2C_San_Francisco"
    },
    {
      "id": 4,
      "text": "The neighborhood’s oldest public school, Scott School, was built in 1895 and still stands on 3rd Street.",
      "sourceSentenceIds": [
        13
