  "facts": [
    {
      "id": 1,
      "text": "The Chestnuthill Township Historical Society, founded in 1986, preserves and shares the area’s early 1800s heritage.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://museumsdatabase.com/museums/view/27916"
    },
    {
      "id": 2,
      "text": "Its museum sits in a 1878 one‑room schoolhouse that once served local children.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://museumsdatabase.com/museums/view/27916"
    },
    {
      "id": 3,
      "text": "Inside the museum visitors see a recreated schoolhouse, a military history display, and an exhibit on the town’s farming past.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://museumsdatabase.com/museums/view/27916"
    },
    {
      "id": 4,
      "text": "Brodheadsville was renamed on June 28 1852 in honor of Charles D. Brodhead, a local resident who opened the first post office.",
      "sourceSentenceIds": [
        2,
        25
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Brodheadsville%2C_Pennsylvania"
    },
    {
      "id": 5,
      "text": "The town’s modest size belies its role as a hub of small‑town warmth, natural beauty, and practical amenities in Monroe County’s western region.",
