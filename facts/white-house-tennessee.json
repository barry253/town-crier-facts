  "facts": [
    {
      "id": 1,
      "text": "White House’s name comes from a white, two‑story house built by Richard Stone Wilks in 1829 that became a stage‑coach stop.",
      "sourceSentenceIds": [
        24,
        26,
        28
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/White_House%2C_Tennessee",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "In 1986 the community erected a replica of that original house, now housing the city’s museum, visitor center and chamber of commerce.",
      "sourceSentenceIds": [
        29,
        17,
        15
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/White_House%2C_Tennessee",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The town sits on the historic Louisville & Nashville Turnpike, later US Highway 31W, a trail first used by Native Americans.",
      "sourceSentenceIds": [
        5,
        6,
        22
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/White_House%2C_Tennessee",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "White House’s replica inn also serves as the public library, part of the Warioto Regional Library Service.",
      "sourceSentenceIds": [
        18,
        16,
        17
      ],
      "sourceLabels": [
        "Web source 1",
        "Wikipedia"
      ],
      "source": "https://www.whitehousetn.gov/170/Museum",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Although incorporated only in 1971, White House has a 200‑year history that began with Wilks’ 1828 land purchase.",
      "sourceSentenceIds": [
        30,
        21
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/White_House%2C_Tennessee",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The town’s growth led to a new library in 2015, while the replica building was remodeled to house the museum and chamber of commerce.",
