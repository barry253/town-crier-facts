  "facts": [
    {
      "id": 1,
      "text": "West Brownsville sits on the inside curve of the Monongahela River, making it more flood‑prone than its sister town across the river.",
      "sourceSentenceIds": [
        17
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/West_Brownsville%2C_Pennsylvania",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town’s roots trace back to a 1784 land grant to the Gillespie family, early settlers who laid the groundwork for the community.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://westbrownsvillepa.com/about/history/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "West Brownsville once hosted one of the nation’s longest railroad crossings, a rare reversing loop that was only seen in model railroading.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/West_Brownsville%2C_Pennsylvania",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The Joseph Dorsey House, built around 1787, stands as one of the oldest surviving homes in the borough.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://westbrownsvillepa.com/about/history/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "America’s first cast‑iron bridge, a historic landmark, can be found in the nearby borough of Brownsville, just across the river.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://brownsvilleborough.com/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The area was a key point on Nemacolin’s Path, later the National Road, where early westward migrants crossed the Monongahela at a shallow ford.",
      "sourceSentenceIds": [
        3
      ],
