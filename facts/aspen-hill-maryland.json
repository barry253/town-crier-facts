  "facts": [
    {
      "id": 1,
      "text": "Aspen Hill takes its name from the aspen trees that once lined the spot of the first post office in the area.",
      "sourceSentenceIds": [
        5,
        7,
        11
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/Aspen_Hill,_Maryland",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The original post office opened around 1864 in a general store at the corner of what is now Connecticut and Georgia Avenues.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Aspen_Hill%2C_Maryland",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "By the early 1900s, Aspen Hill was shifting from isolated farms to suburban life, thanks to its closeness to Washington, D.C.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/Aspen_Hill,_Maryland",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "In 1921 Richard and Bertha Birney opened Aspin Hill Memorial Park, one of the East Coast’s first pet cemeteries, on their Rockville property.",
      "sourceSentenceIds": [
        2,
        13
      ],
      "sourceLabels": [
        "Web source 2",
        "Wikipedia"
      ],
      "source": "https://grokipedia.com/page/Aspen_Hill,_Maryland",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "A 1955 sale transferred 268 acres to Metropolitan Homes, which planned to build 12,000 homes, schools, and shopping centers in the area.",
      "sourceSentenceIds": [
        20,
