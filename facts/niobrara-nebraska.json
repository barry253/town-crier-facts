  "facts": [
    {
      "id": 1,
      "text": "Niobrara was founded in 1856 by a group of men led by a doctor.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Niobrara%2C_Nebraska"
    },
    {
      "id": 2,
      "text": "Niobrara sits at the confluence of the Niobrara and Missouri rivers, and its name means \"running water\".",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://niobrarane.com/"
    },
    {
      "id": 3,
      "text": "In 1902 a railroad arrived, and the county seat moved from Niobrara to the new town of Center.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://niobrarane.com/history/"
    },
    {
      "id": 4,
      "text": "Ferry boats historically linked Niobrara to South Dakota across the Missouri River.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://niobrarane.com/history/"
    },
    {
      "id": 5,
      "text": "The village was moved twice: first after a 1881 flood, then after a 1976 court ruling over dam‑related damage.",
      "sourceSentenceIds": [
        18,
        19,
        20,
        21
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Niobrara%2C_Nebraska"
    },
    {
      "id": 6,
      "text": "Niobrara celebrated its 112th anniversary in 1981 with a pageant, parade, and a volunteer‑built nine‑hole golf course.",
