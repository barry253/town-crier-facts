  "facts": [
    {
      "id": 1,
      "text": "Clay City got its name in 1883 when the post office was renamed after local clay deposits.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Clay_City%2C_Kentucky"
    },
    {
      "id": 2,
      "text": "The first European settlement near Clay City began in 1786 when Stephen Collins and his brother discovered pyrite deposits.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Clay_City%2C_Kentucky"
    },
    {
      "id": 3,
      "text": "Soon after, the Collins brothers built the first iron forge west of the Allegheny Mountains, called Collins Forge.",
      "sourceSentenceIds": [
        13
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Clay_City%2C_Kentucky"
    },
    {
      "id": 4,
      "text": "In 1805 the forge was sold to Clark and Smith, forming the forerunner of the Red River Iron Works.",
      "sourceSentenceIds": [
        14
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Clay_City%2C_Kentucky"
    },
    {
      "id": 5,
      "text": "Clay City was incorporated as a fifth‑class city in Powell County on April 19, 1890.",
      "sourceSentenceIds": [
        16
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Clay_City%2C_Kentucky"
    },
    {
      "id": 6,
      "text": "Because it sits in a low‑lying Red River Valley, Clay City floods often during heavy storms.",
      "sourceSentenceIds": [
        18,
        19
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Clay_City%2C_Kentucky"
    }
  ]
