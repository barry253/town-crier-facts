  "facts": [
    {
      "id": 1,
      "text": "Arlington Heights grew from a 19th‑century farming community called the “Town of Dunton” before officially adopting its current name in 1874.",
      "sourceSentenceIds": [
        19
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.vah.com/residents/about_arlington_heights/history.php",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The village’s first train station, built in 1854, sparked a boom that turned the area into a truck‑farm hub feeding Chicago with dairy and vegetables.",
      "sourceSentenceIds": [
        29
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Arlington_Heights%2C_Illinois",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The Sigwalt Sewing Machine Company, founded by Civil War veteran Charles Sigwalt in 1878, produced 40,000 machines before closing in 1883.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Arlington_Heights%2C_Illinois",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Arlington Park, a racetrack opened in 1927 by millionaire Harry D., became a regional landmark and hosted major horse‑race events.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Arlington_Heights%2C_Illinois",
      "category": "landmark",
      "quality": "poor",
      "qualityReason": "unverified=['mccormick']"
    },
    {
      "id": 5,
      "text": "The Arlington Heights Historical Museum, a tri‑party effort, preserves landmarks like the Müller and Banta Houses and the Soda Pop Factory on its campus.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.ahpd.org/arlington-heights-historical-museum/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The former Arlington High School, closed in 1984, now houses the private Liberty Academy and was a filming location for movies such as “Lucas” and “A Nightmare on Elm Street.”.",
