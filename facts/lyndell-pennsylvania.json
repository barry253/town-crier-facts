      "quality": "good"
    },
    {
      "id": 4,
      "text": "Singer‑songwriter Jim Croce lived in a 200‑year‑old farmhouse in Lyndell from 1970 until his 1973 plane crash, inspiring his music.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
