      "category": "transport",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "In 1880 the Lyndell Post Office opened, cementing the hamlet’s name after the earlier “Brooklyn” era.",
      "sourceSentenceIds": [
        29
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/lyndell_pennsylvania",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The Brandywine Creek Campground, once called Frank's Folly, sits in Lyndell and honors local pioneer Frank P. Sinex.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
