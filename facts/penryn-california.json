  "facts": [
    {
      "id": 1,
      "text": "Penryn began in 1864 when Welsh immigrant Griffith Griffith leased land from the Central Pacific Railroad to start a granite quarry.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/penryn_california",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Griffith named the siding after his Welsh hometown Penrhyn, dropping the 'h' so the town became Penryn.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/penryn_california",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "In 1977 Griffith Quarry earned a spot on the National Register of Historic Places and became California Historical Landmark #885.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Penryn%2C_California",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Stone from Penryn’s quarry can be found in the foundations of the California State Capitol and the U.S. Mint in San Francisco.",
      "sourceSentenceIds": [
        13
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Penryn%2C_California",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Enid Griffith donated the quarry site in 1976, creating a 23‑acre public park that now houses the Griffith Quarry Museum.",
      "sourceSentenceIds": [
        8,
        17
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/penryn_california",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "A self‑guided walking tour in Penryn stops at historic landmarks like the Penryn Firehouse and the Penryn Masonic Lodge.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 2"
      ],
