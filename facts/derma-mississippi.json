  "facts": [
    {
      "id": 1,
      "text": "Derma began as a railroad town when the Mobile & Ohio Railroad extended from Okolona to Houston, bringing commerce to Calhoun County.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://calhouneda.com/cities/derma-2",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town’s name comes from a young man’s shorthand “Der Ma” written home, which evolved into Derma.",
      "sourceSentenceIds": [
        28
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://calhouneda.com/cities/derma-2",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "In 1910, Calhoun County Agricultural High School opened in Derma, marking the town’s early commitment to education.",
      "sourceSentenceIds": [
        29
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://calhouneda.com/cities/derma-2",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Olympic gold medalist sprinter Glenn Hardin was born in Derma, adding a dash of athletic fame to the town’s history.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Derma%2C_Mississippi",
      "category": "people",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The Yalobusha River, a tributary of the Yazoo, runs just one mile south of Derma, shaping its local landscape.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Derma%2C_Mississippi",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "In 1959, Derma High School merged with Calhoun City School, ending the town’s independent secondary education.",
