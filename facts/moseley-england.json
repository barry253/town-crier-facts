      "quality": "good"
    },
    {
      "id": 3,
      "text": "Moseley Old Hall’s low light levels and uneven floors reflect its 18th‑century origins, inviting visitors to step back in time.",
      "sourceSentenceIds": [
        20
      ],
      "sourceLabels": [
        "Web source 2"
