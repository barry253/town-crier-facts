        10
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://museumsdatabase.com/museums/view/3925",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The Simpkins Family Swim Center opened a photo exhibit titled “What You Don’t Know About Live Oak in Photos,” showcasing vintage images of the town’s past.",
      "sourceSentenceIds": [
        17,
