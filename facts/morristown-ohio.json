  "facts": [
    {
      "id": 1,
      "text": "Morristown was platted in 1802 and named for pioneer settler Duncan Morrison.",
      "sourceSentenceIds": [
        1,
        2
      ],
      "sourceLabels": [
        "Web source 1",
        "Wikipedia"
      ],
      "source": "https://www.morristownohio.org/morristownhistory"
    },
    {
      "id": 2,
      "text": "Founded on April 14 1802, Morristown predates Ohio itself.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://belmontcountytourism.info/morristown/"
    },
    {
      "id": 3,
      "text": "The National Road, the era’s main westward route, ran through Morristown.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.morristownohio.org/morristownhistory"
    },
    {
      "id": 4,
      "text": "In 1826 Main Street replaced Wheeling Road as the village’s main thoroughfare.",
      "sourceSentenceIds": [
        3,
        29
      ],
      "sourceLabels": [
        "Web source 1",
        "Wikipedia"
      ],
      "source": "https://www.morristownohio.org/morristownhistory"
    },
    {
      "id": 5,
      "text": "When the railroad bypassed the town in the 1850s, it ran south through Barnesville instead.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.morristownohio.org/morristownhistory"
    },
    {
      "id": 6,
      "text": "Morristown’s Historic District was listed on the National Register of Historic Places in 1980.",
      "sourceSentenceIds": [
        14
