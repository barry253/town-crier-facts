  "facts": [
    {
      "id": 1,
      "text": "North Vandergrift was founded in 1895 by George G. McMurtry, who built a planned industrial community.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://westmorelandheritage.org/portfolio-item/victorian-vandergrift-museum-historical-society/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Frederick Law Olmsted designed North Vandergrift with gently curving streets and green spaces for workers.",
      "sourceSentenceIds": [
        11
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://westmorelandheritage.org/portfolio-item/victorian-vandergrift-museum-historical-society/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The Victorian Vandergrift Museum, housed in the 1911 Sherman School, opened in 1990 to preserve local history.",
      "sourceSentenceIds": [
        4,
        21
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://westmorelandheritage.org/portfolio-item/victorian-vandergrift-museum-historical-society/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The Casino building still hosts live theater and concerts while also serving as the town’s library.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://westmorelandheritage.org/portfolio-item/victorian-vandergrift-museum-historical-society/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The original mill that powered North Vandergrift is now part of ATI, still employing locals.",
      "sourceSentenceIds": [
