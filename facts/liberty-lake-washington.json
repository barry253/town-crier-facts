  "facts": [
    {
      "id": 1,
      "text": "Liberty Lake got its name when Lake Grier was renamed to honor French‑Canadian settler Etienne Laliberté, later known as Stephen Liberty.",
      "sourceSentenceIds": [
        3,
        4,
        7
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.historylink.org/File/20794",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "In 1903 electric trains from Spokane arrived, and by 1909 the railroad built Liberty Lake Park, a resort that vanished when trains stopped in 1926.",
      "sourceSentenceIds": [
        10,
        9
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.historylink.org/File/20794",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The park’s wooden dance pavilion became a regional hotspot, hosting live bands, dancing, and boat rentals for visitors.",
      "sourceSentenceIds": [
        11,
        5
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.historylink.org/File/20794",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Liberty Lake officially became a city on August 31, 2001, after decades as an unincorporated community.",
      "sourceSentenceIds": [
        19
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Liberty_Lake%2C_Washington",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The eponymous lake lies just three blocks south of Sprague Avenue, outside the city limits.",
      "sourceSentenceIds": [
