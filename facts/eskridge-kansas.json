  "facts": [
    {
      "id": 1,
      "text": "Eskridge was platted in 1868 by Colonel Ephraim H. Sanford, who named the town after his friend Charles V.",
      "sourceSentenceIds": [
        7,
        8,
        9
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/eskridge_kansas",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Eskridge City Park, founded in 1903 on donated land, hosts an octagonal wooden bandstand built around 1908–1909 and earned National Register status in 2017.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/eskridge_kansas",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The arrival of the Atchison, Topeka and Santa Fe Railway in 1880 turned Eskridge into a cattle shipping hub, with the county leading Kansas in 1898 shipments.",
      "sourceSentenceIds": [
        13,
        22,
        23
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 2"
      ],
      "source": "https://en.wikipedia.org/wiki/Eskridge%2C_Kansas",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Eskridge faced repeated fires, including a 1909 bakery blaze that destroyed five businesses and a 1913 conflagration that razed nine Main Street buildings.",
      "sourceSentenceIds": [
        25
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/eskridge_kansas",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "A post office opened on October 18, 1869, marking Eskridge’s formal recognition and early community with a store, tavern, and stage station.",
      "sourceSentenceIds": [
        26
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/eskridge_kansas",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Eskridge sits atop a 1,700‑foot plateau, giving it a higher elevation than many surrounding towns.",
