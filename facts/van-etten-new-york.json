  "facts": [
    {
      "id": 1,
      "text": "Van Etten was named for early settler Jacob Swartwood, whose legacy lives in the town’s name.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Van_Etten%2C_New_York",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town was carved out of Erin and Cayuta in 1854, marking its official birth in Chemung County.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Van_Etten%2C_New_York",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "In 1876 the village of Van Etten joined the town, becoming the first incorporated community within its borders.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Van_Etten%2C_New_York",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "New York State Route 34 meets Route 224 right in the village, a historic crossroads that still guides travelers today.",
      "sourceSentenceIds": [
        13
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Van_Etten%2C_New_York",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The hamlet of Van Etten sits at that junction, while Van Etten Junction lies just south along NY 34.",
      "sourceSentenceIds": [
        23,
        24
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Van_Etten%2C_New_York",
      "category": "other",
      "quality": "poor",
      "qualityReason": "location_description"
    },
    {
      "id": 6,
      "text": "Town officials say small‑town values—preserving heritage, guiding growth, and fostering community—are the core principles that make Van Etten a great place to live.",
