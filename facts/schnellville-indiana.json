  "facts": [
    {
      "id": 1,
      "text": "Schnellville was founded by German immigrant Henry Schnell, born 1821 in Hesse, who later purchased 40 acres in Dubois County.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Schnellville%2C_Indiana",
      "category": "people",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town’s first post office operated under the name Worth from 1848 to 1861 before being renamed Schnellville in 1869, remaining until 1962.",
      "sourceSentenceIds": [
        17,
        18
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Schnellville%2C_Indiana",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "In 1873, residents petitioned Bishop St. Palais, leading to the establishment of Sacred Heart Parish on November 10, 1873.",
      "sourceSentenceIds": [
        21,
        22,
        23
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Schnellville%2C_Indiana",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Henry Schnell built a saw and flour mill in 1876, marking the town’s early industrial activity.",
      "sourceSentenceIds": [
        19
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Schnellville%2C_Indiana",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "A devastating fire on April 24, 1898 destroyed all church records and personal property, prompting a community rebuild.",
      "sourceSentenceIds": [
        27
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Schnellville%2C_Indiana",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The original Sacred Heart Church featured a 65‑foot cupola, a striking landmark visible from miles away.",
