  "facts": [
    {
      "id": 1,
      "text": "Dutchtown’s name comes from the German word 'Deutsch,' reflecting the Swiss and German settlers who founded the village in the 1830s.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Dutchtown%2C_Missouri",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Martin Rodner, a Hessian soldier, moved to the area in 1801 and built Rodney's Mill on Hubble Creek, the village’s first industrial site.",
      "sourceSentenceIds": [
        9,
        10
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Dutchtown%2C_Missouri",
      "category": "people",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The first Protestant sermon west of the Mississippi River was preached in 1799 at Randol Creek, just outside modern Dutchtown.",
      "sourceSentenceIds": [
        14
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Dutchtown%2C_Missouri",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The original log church was replaced by a brick building in 1887, a structure that still stands today.",
      "sourceSentenceIds": [
        15,
        16
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Dutchtown%2C_Missouri",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Repeated flooding—from 1973 through 2017—has prompted federal buyouts, and all of Dutchtown’s assets will now be managed by Cape Girardeau County.",
      "sourceSentenceIds": [
        18
