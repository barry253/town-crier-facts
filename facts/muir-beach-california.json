  "facts": [
    {
      "id": 1,
      "text": "Muir Beach takes its name from naturalist John Muir, even though he never visited this stretch of sand.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.marincountyvisitor.com/things-to-do/hiking-biking-outdoor-activities/beaches/muir-beach/"
    },
    {
      "id": 2,
      "text": "Historic base‑end stations and observation posts along the coast were once part of San Francisco Bay’s coastal defense system.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.nps.gov/goga/planyourvisit/muirbeach.htm"
    },
    {
      "id": 3,
      "text": "The northern tip of Muir Beach is known for clothing‑optional sunbathers, a unique local tradition.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.nps.gov/goga/planyourvisit/muirbeach.htm"
    },
    {
      "id": 4,
      "text": "The beach stretches roughly 1,000 feet long and 200 feet wide, featuring coarse sand and large boulders.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Muir_Beach%2C_California"
    },
    {
      "id": 5,
      "text": "A parking lot at the beach is accessed via a footbridge, making the walk a scenic start to the day.",
      "sourceSentenceIds": [
        14
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Muir_Beach%2C_California"
    },
    {
      "id": 6,
      "text": "Long before European settlers, the Coast Miwok people inhabited this coast, harvesting its abundant marine resources.",
