  "facts": [
    {
      "id": 1,
      "text": "Patagonia was founded in 1893 when Richardson developed ranch land where the railroad crossed Sonoita Creek, naming it after nearby mountains.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://patagonia-az.gov/about/history/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "By 1900 Patagonia had a two‑story depot, and by WWI it featured running water, an opera house, three hotels, a schoolhouse, two parks and several stores.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://patagonia-az.gov/about/history/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The Nature Conservancy bought 312 acres near Sonoita Creek in 1969, creating the Patagonia‑Sonoita Creek Preserve, now a National Natural Landmark.",
      "sourceSentenceIds": [
        11
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://patagonia-az.gov/about/history/",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Patagonia’s name honors the nearby Patagonia Mountains, not the South American region.",
      "sourceSentenceIds": [
        6
