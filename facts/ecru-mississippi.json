  "facts": [
    {
      "id": 1,
      "text": "Ecru’s name comes from the French word for unbleached linen, chosen because the first depot’s beige paint matched that hue.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/ecru_mississippi"
    },
    {
      "id": 2,
      "text": "Colonel William Clark Falkner, a post‑Civil War businessman, founded Ecru in the late 1800s as a railroad depot town.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/ecru_mississippi"
    },
    {
      "id": 3,
      "text": "Ecru hosts the world’s largest upholstered furniture plant, a 2.4‑million‑square‑foot Ashley Furniture factory that fuels local jobs.",
      "sourceSentenceIds": [
        29
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/ecru_mississippi"
    },
    {
      "id": 4,
      "text": "Ecru sits on gently rolling hills of the Pontotoc Ridge, giving the town a mild, undulating landscape.",
      "sourceSentenceIds": [
        11
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/ecru_mississippi"
    },
    {
