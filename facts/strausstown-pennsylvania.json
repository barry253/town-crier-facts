      "id": 1,
      "text": "Strausstown was founded in 1840 when John Strauss laid out the town on his farm.",
      "sourceSentenceIds": [
        2,
        25
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Strausstown%2C_Pennsylvania",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The borough takes its name from its founder, John Strauss, who owned most of the land the town grew on.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.pa-roots.com/2025/08/14/strausstown/",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The first house in the area was built in 1835 by Joseph Boltz, a few years before the town was officially laid out.",
      "sourceSentenceIds": [
        28
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.pa-roots.com/2025/08/14/strausstown/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "An old log house just west of town served as a landmark for generations, standing until it was abandoned in 1876.",
      "sourceSentenceIds": [
        7,
        8
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.pa-roots.com/2025/08/14/strausstown/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Every year the Strausstown Lions Club Park hosts an Antique Auto Show & Flea Market that draws car enthusiasts from the region.",
      "sourceSentenceIds": [
        24
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Strausstown%2C_Pennsylvania",
      "category": "culture",
      "quality": "good"
    },
    {
