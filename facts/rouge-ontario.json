      ],
      "source": "https://ontariovisited.ca/rouge-national-urban-park/",
      "category": "nature",
      "quality": "good",
      "qualityReason": "editorial_filler"
    },
    {
      "id": 3,
      "text": "The Rouge River begins in the Oak Ridges Moraine and empties into Lake Ontario at Rouge Beach, where the Rouge Marsh borders the lake.",
      "sourceSentenceIds": [
        13,
        14,
        27,
        28
      ],
      "sourceLabels": [
