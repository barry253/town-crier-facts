      ],
      "source": "https://en.wikipedia.org/wiki/Rouge_River_(Ontario)",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The Rouge River watershed covers 336 km², with 40 % agricultural, 35 % urban, 24 % forest/wetland/meadow, and 1 % watercourses.",
      "sourceSentenceIds": [
