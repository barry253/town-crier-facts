  "facts": [
    {
      "id": 1,
      "text": "Hurley, Virginia, sits at the mouth of Lester's Fork where it meets Knox Creek, a spot that once powered a bustling timber industry.",
      "sourceSentenceIds": [
        21,
        15
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 2"
      ],
      "source": "https://en.wikipedia.org/wiki/Hurley%2C_Virginia",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The community’s name honors pioneer settler Samuel Robert Hurley, whose early presence helped shape the area’s Appalachian roots.",
      "sourceSentenceIds": [
        4,
        6
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 2"
      ],
      "source": "https://en.wikipedia.org/wiki/Hurley%2C_Virginia",
      "category": "people",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "In 1893, Hurley opened its first post office, marking the town’s emergence as a regional hub for timber and later coal.",
      "sourceSentenceIds": [
        20,
        14
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 2"
      ],
      "source": "https://en.wikipedia.org/wiki/Hurley%2C_Virginia",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "A narrow‑gauge railroad, the Big Sandy and Cumberland, once ran through Hurley, hauling logs with unique Shay engines before the Norfolk and Western Railway took over in 1923.",
      "sourceSentenceIds": [
        5,
        16,
        17,
        18
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 2"
      ],
      "source": "https://en.wikipedia.org/wiki/Hurley%2C_Virginia",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Hurley’s high school, long a community centerpiece, has educated generations while reflecting the town’s enduring spirit and resilience.",
      "sourceSentenceIds": [
        12,
        24
      ],
      "sourceLabels": [
        "Web source 1",
        "Wikipedia"
      ],
      "source": "https://allthingsusa.blog/hurley-virginia-history-spirit",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The Levisa Fork River, a vital waterway for transportation and recreation, runs nearby and has shaped Hurley’s cultural and economic life for centuries.",
      "sourceSentenceIds": [
