  "facts": [
    {
      "id": 1,
      "text": "Hughesville takes its name from Jeptha Hughes, who laid out Hughesburg in 1816 before selling the plot to Daniel Harrold in 1820.",
      "sourceSentenceIds": [
        1,
        2
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Hughesville%2C_Pennsylvania",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Early Hughesville industries featured a chair factory opened in 1829, a wagon shop in 1830, distilleries, a sawmill, planing mill, and furniture factory.",
      "sourceSentenceIds": [
        3,
        4
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Hughesville%2C_Pennsylvania",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Hughesville became an incorporated borough on April 23, 1852, marking its formal municipal status.",
      "sourceSentenceIds": [
        12,
        29
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Hughesville%2C_Pennsylvania",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Electricity and running water arrived in Hughesville in 1891, modernizing the borough’s infrastructure.",
      "sourceSentenceIds": [
        15
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Hughesville%2C_Pennsylvania",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The town’s early growth centered around a gristmill constructed by Jacob Clayton, the first major industry.",
      "sourceSentenceIds": [
        9,
        26
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Hughesville%2C_Pennsylvania",
      "category": "history",
      "quality": "good"
    },
    {
