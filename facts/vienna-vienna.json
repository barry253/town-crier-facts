      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The University of Vienna, founded in 1365 by Duke Rudolph IV, remains the oldest and largest university in the German‑speaking world.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
