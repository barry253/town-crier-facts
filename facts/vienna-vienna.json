  "facts": [
    {
      "id": 1,
      "text": "Vienna began as a Roman fort called Vindobona in the 1st century, marking the city’s earliest known settlement.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Vienna",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The University of Vienna, founded in 1365 by Duke Rudolph IV, remains the oldest and largest university in the German‑speaking world.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Vienna",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Schönbrunn Palace’s 18th‑century park houses the Schönbrunn Zoo, established in 1752 and still operating today as the world’s oldest zoo.",
      "sourceSentenceIds": [
        15
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Vienna",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Vienna attracted a constellation of composers—Haydn, Mozart, Beethoven, Brahms, Liszt, Mahler, Bruckner, and Salieri—making it a global music capital.",
      "sourceSentenceIds": [
        21
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Vienna",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The Ringstrasse, a grand boulevard completed in the late 19th century, encircles Vienna’s historic centre with Baroque palaces, monuments, and parks.",
      "sourceSentenceIds": [
        25
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Vienna",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The city sits on the Danube, with the Wienfluss river flowing through its heart, linking Vienna to the wider river network.",
      "sourceSentenceIds": [
        17
