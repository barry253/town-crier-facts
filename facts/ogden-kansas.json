  "facts": [
    {
      "id": 1,
      "text": "Ogden was founded in the mid-1850s, around 1854, as settlers moved near the newly built Fort Riley.",
      "sourceSentenceIds": [
        4,
        6
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/ogden_kansas"
    },
    {
      "id": 2,
      "text": "The town’s name honors Major Edmund Augustus Ogden, a U.S. Army officer who helped secure the frontier.",
      "sourceSentenceIds": [
        2,
        3
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/ogden_kansas"
    },
    {
      "id": 3,
      "text": "Ogden’s first post office opened March 20, 1856, making it Riley County’s inaugural postal station.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/ogden_kansas"
    },
    {
      "id": 4,
      "text": "The city was officially incorporated in 1870, solidifying its status as a permanent community.",
      "sourceSentenceIds": [
        11
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Ogden%2C_Kansas"
    },
    {
      "id": 5,
      "text": "Ogden sits between Manhattan and Junction City, just north of the expansive Fort Riley military installation.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Ogden%2C_Kansas"
    },
    {
      "id": 6,
      "text": "The town’s early economy boomed as soldiers and support staff from Fort Riley increased demand for housing and services.",
