      "quality": "good"
    },
    {
      "id": 2,
      "text": "The original village sat in the Mississippi floodplain, but after the 1993 flood it was moved two miles east onto higher ground.",
      "sourceSentenceIds": [
        3,
        9
      ],
      "sourceLabels": [
        "Wikipedia",
