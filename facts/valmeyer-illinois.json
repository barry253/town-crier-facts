      ],
      "source": "https://en.wikipedia.org/wiki/Valmeyer%2C_Illinois",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "FEMA helped fund the town’s relocation, positioning Valmeyer as a model for communities retreating from rising waters.",
      "sourceSentenceIds": [
        10,
        12
      ],
      "sourceLabels": [
        "Wikipedia",
