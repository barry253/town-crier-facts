  "facts": [
    {
      "id": 1,
      "text": "Pleasanton was founded in 1869 and named after Union General Alfred Pleasonton, though the town’s spelling differs.",
      "sourceSentenceIds": [
        1,
        5
      ],
      "sourceLabels": [
        "Web source 2",
        "Wikipedia"
      ],
      "source": "https://pleasantonks.com/index.php/about/welcome",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The 1864 Battle of Mine Creek, fought near Pleasanton, ended Confederate invasion threat with a 25,000‑man Union victory.",
      "sourceSentenceIds": [
        19,
        20
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Pleasanton%2C_Kansas",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Pleasanton's start came in 1869 when the Kansas City, Fort Scott & Memphis Railroad cut through the area.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Pleasanton%2C_Kansas",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The Frontier Military Historic Byway snakes north‑south through Pleasanton, offering scenic views and access to Civil War sites like Mine Creek.",
      "sourceSentenceIds": [
        9,
        10,
        11
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.travelks.com/places-to-visit/cities/pleasanton/",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The Linn County Museum and Genealogy Library, housed in historic Dunlap Park, preserves Pleasanton's rich local history and records.",
      "sourceSentenceIds": [
        14,
        17
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://pleasantonks.com/index.php/about/welcome",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Pleasanton's first post office opened in August 1869, marking the town’s early communication link.",
      "sourceSentenceIds": [
