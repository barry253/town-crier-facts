      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The Society’s museum showcases artifacts that tell the story of Jay and its surrounding communities.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://museumsdatabase.com/museums/view/6500",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Through its research library, Jay Historical Society offers access to a wide range of records for anyone curious about local history.",
