      "quality": "poor",
      "qualityReason": "vague"
    },
    {
      "id": 4,
      "text": "Jay sits in Santa Rosa County, part of the Pensacola–Ferry Pass–Brent Metropolitan Statistical Area.",
      "sourceSentenceIds": [
        16
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Jay%2C_Florida",
      "category": "other",
      "quality": "poor",
      "qualityReason": "location_description"
    },
    {
      "id": 5,
      "text": "The town lies about 38 miles north of Pensacola and just a few miles from the Alabama state line.",
