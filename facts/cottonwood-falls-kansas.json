  "facts": [
    {
      "id": 1,
      "text": "Cottonwood Falls began in 1854 when Indian trader Seth Hayes established a cattle ranch near the Cottonwood River and Diamond Spring Creek.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Cottonwood_Falls%2C_Kansas",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "By 1910 Cottonwood Falls sat at the junction of two Atchison, Topeka & Santa Fe Railroad lines, becoming a key market for farm produce.",
      "sourceSentenceIds": [
        15
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://legendsofkansas.com/cottonwood-falls-kansas/",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The Chase County Historical Society now occupies the former Chase County National Bank, a building listed on the National Register of Historic Places.",
      "sourceSentenceIds": [
        17,
        18
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://legendsofkansas.com/cottonwood-falls-kansas/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Cottonwood Falls has endured numerous floods, most notably the Great Flood of 1951 that reshaped the Cottonwood River valley.",
      "sourceSentenceIds": [
        8,
        11
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Cottonwood_Falls%2C_Kansas",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The Burnley Memorial Library, located on Oak Street, serves as a cultural hub and houses historic collections for Cottonwood Falls residents.",
      "sourceSentenceIds": [
        26
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Cottonwood_Falls%2C_Kansas",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Nestled in the heart of the Flint Hills, Cottonwood Falls lies along the scenic Flint Hills National Scenic Byway, showcasing rolling prairie landscapes.",
