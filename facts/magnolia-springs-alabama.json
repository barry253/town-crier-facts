  "facts": [
    {
      "id": 1,
      "text": "Magnolia Springs earned its name from the town’s abundant natural springs and the many magnolia trees that once lined the area.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://encyclopediaofalabama.org/article/magnolia-springs/",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "After the Civil War, residents flocked to Magnolia Springs, a community that began as part of a Spanish land grant in the early 1800s.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://encyclopediaofalabama.org/article/magnolia-springs/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The historic McNair House, a landmark of Magnolia Springs, is listed on the Alabama Register of Landmarks and Heritage.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://encyclopediaofalabama.org/article/magnolia-springs/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Turpentine distillation once dominated the area, but owners burned their stills in 1865 to prevent capture by Union soldiers.",
      "sourceSentenceIds": [
        18,
        19
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Magnolia_Springs%2C_Alabama",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Magnolia Springs sits at the headwaters of the Magnolia River, which locals historically called River de Lin, Cataract Creek, or River del Salto.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Magnolia_Springs%2C_Alabama",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "In 2007, activists pushed for Magnolia Springs to receive Outstanding Alabama Water status, the state’s highest environmental protection designation.",
