  "facts": [
    {
      "id": 1,
      "text": "Joseph Fenwick founded Meridianville in the early 1800s, buying land and selling lots in 1818 along the road that would become U.S. Route 231.",
      "sourceSentenceIds": [
        2,
        11
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Meridianville%2C_Alabama",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town grew along the historic Meridianville Road, a key north‑south link that guided pioneers from Tennessee into what became Madison County.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/meridianville_alabama",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "After Cherokee and Chickasaw land cessions in 1806 and 1816, white settlers poured into Madison County, sparking Meridianville’s early development.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/meridianville_alabama",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Green Lawn, a Greek Revival mansion built around 1850 by William Madison Otey, survived Union raids in 1863 and earned a National Register spot in 1982.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/meridianville_alabama",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Within its first decade, Meridianville hosted several mills, gins, and stores, turning the small settlement into a bustling local trade center.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Meridianville%2C_Alabama",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The name of U.S. Route 231/431 reflects its placement on the state's base meridian line, a nod to Meridianville’s geographic significance.",
