  "facts": [
    {
      "id": 1,
      "text": "Calamvale takes its name from early settler James Calam and the surrounding Calam family who once owned the land.",
      "sourceSentenceIds": [
        1,
        2
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Calamvale%2C_Queensland"
    },
    {
      "id": 2,
      "text": "The original Calam family homestead perched on a hill above Calam Road, now a historic landmark.",
      "sourceSentenceIds": [
        14
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Calamvale%2C_Queensland"
    },
    {
      "id": 3,
      "text": "In 1984 the Calam homestead was sold to the McGuire family, who erected the Calamvale Hotel on the site.",
      "sourceSentenceIds": [
        16
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Calamvale%2C_Queensland"
    },
    {
      "id": 4,
      "text": "Calamvale State School opened its doors on 11 May 1955, serving the suburb’s growing families.",
      "sourceSentenceIds": [
        18
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Calamvale%2C_Queensland"
    },
    {
      "id": 5,
      "text": "A secondary campus joined the primary school in January 2002, creating Calamvale Community College.",
      "sourceSentenceIds": [
        19
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Calamvale%2C_Queensland"
    },
    {
