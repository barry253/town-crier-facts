  "facts": [
    {
      "id": 1,
      "text": "Lake Lillian got its name from Lillian Whitefield, wife of explorer Edwin Whitefield who visited the area in 1856.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Lake_Lillian%2C_Minnesota"
    },
    {
      "id": 2,
      "text": "The town of Lake Lillian sprang to life in February 1923 when the Luce Line Railroad laid tracks through the area.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Lake_Lillian%2C_Minnesota"
    },
    {
      "id": 3,
      "text": "Lake Lillian officially became an incorporated city on February 25, 1926.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Lake_Lillian%2C_Minnesota"
    },
    {
      "id": 4,
      "text": "The first school in Lake Lillian opened in 1913, long before the town was officially founded.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Lake_Lillian%2C_Minnesota"
    },
    {
      "id": 5,
      "text": "In 1926, oil was reportedly found within the city limits of Lake Lillian.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Lake_Lillian%2C_Minnesota"
    },
    {
      "id": 6,
      "text": "During World War II, a hemp processing plant was built near Lake Lillian to support the war effort.",
