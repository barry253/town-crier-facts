  "facts": [
    {
      "id": 1,
      "text": "Pelican was founded in 1938 by fish buyer Charlie Raatikainen, who built the town as a cold‑storage hub for his fish‑processing company.",
      "sourceSentenceIds": [
        2,
        6
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 2"
      ],
      "source": "https://en.wikipedia.org/wiki/Pelican%2C_Alaska"
    },
    {
      "id": 2,
      "text": "Pelican sits on the east side of Lisianski Inlet, a waterway that opens into Lisianski Strait and Cross Sound on Chichagof Island.",
      "sourceSentenceIds": [
        11
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Pelican%2C_Alaska"
    },
    {
      "id": 3,
      "text": "The only way to reach Pelican is by boat or seaplane, reflecting its remote island location.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Pelican%2C_Alaska"
    },
    {
      "id": 4,
      "text": "A gold mine called the Apex, founded earlier, lies across the inlet from Sunnyside, alongside the Mork mine.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Pelican%2C_Alaska"
    },
    {
      "id": 5,
      "text": "Pelican’s motto, 'Closest to the Fish,' highlights its long‑standing role as a premier fishing hub in Southeast Alaska.",
