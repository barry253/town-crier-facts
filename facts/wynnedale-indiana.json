  "facts": [
    {
      "id": 1,
      "text": "Wynnedale takes its name from the Wynne family, who subdivided the land and platted the town in 1924.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://indyencyclopedia.org/wynnedale/"
    },
    {
      "id": 2,
      "text": "In 1970, Wynnedale became an 'included town' when it was incorporated into Indianapolis as part of Unigov.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Wynnedale%2C_Indiana"
    },
    {
      "id": 3,
      "text": "Despite being part of Indianapolis, Wynnedale still operates its own town government under IC 36-3-1-11.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Wynnedale%2C_Indiana"
    },
    {
      "id": 4,
      "text": "Wynnedale sits just five miles northwest of downtown Indianapolis, making it a close suburban neighbor.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Wynnedale%2C_Indiana"
    },
    {
      "id": 5,
      "text": "The town is bordered to the east by the neighboring town of Spring Hill.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Wynnedale%2C_Indiana"
    },
    {
      "id": 6,
      "text": "Wynnedale lies within Washington Township in Marion County, Indiana.",
