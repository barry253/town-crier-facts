      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Devon was renamed after the English county of Devon, reflecting its settlers’ heritage.",
      "sourceSentenceIds": [
        10,
        26
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 2"
      ],
