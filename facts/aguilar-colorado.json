  "facts": [
    {
      "id": 1,
      "text": "Aguilar, Colorado, was founded in 1894 by cattleman and pioneer José Ramón Aguilar, who owned the land the town still sits on.",
      "sourceSentenceIds": [
        1,
        5,
        6
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Aguilar%2C_Colorado",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "In 1892 the Colorado & Southern Railway reached Aguilar, turning the town into a coal‑mining hub along the new rail line.",
      "sourceSentenceIds": [
        12,
        10
      ],
      "sourceLabels": [
        "Web source 2",
        "Web source 1"
      ],
      "source": "https://www.uncovercolorado.com/towns/aguilar/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Aguilar takes its name from its founder, state legislator José Ramón Aguilar, honoring his role in the town’s early development.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.uncovercolorado.com/towns/aguilar/",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Nestled at the foot of Twin Spanish Peaks, the town was first settled by Spaniards who called the area “The New Spain.”.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.aguilarco.us/about",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Aguilar’s post office opened December 16, 1890, and the town was officially incorporated on January 18, 1894.",
      "sourceSentenceIds": [
        3
      ],
