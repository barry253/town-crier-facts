      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Monroe sits where the Skykomish and Snoqualmie rivers meet, creating the Snohomish River.",
      "sourceSentenceIds": [
        23,
        29
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Monroe%2C_Washington",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The Condensery Smokestack in Monroe North stands as a relic of the town’s early industrial era.",
