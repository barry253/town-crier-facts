      "id": 1,
      "text": "McClurg founded Park Place in 1864, and the town was renamed Monroe in 1890 to honor the United States.",
      "sourceSentenceIds": [
        15,
        13
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
