  "facts": [
    {
      "id": 1,
      "text": "Brighton earned its name from the Brighton Hotel, which was itself named after Brighton in Sussex, England.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Brighton%2C_Queensland"
    },
    {
      "id": 2,
      "text": "Flinders Parade, the road that follows Brighton's esplanade, honors Captain Matthew Flinders, the first European to chart the area.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Brighton%2C_Queensland"
    },
    {
      "id": 3,
      "text": "During the 1950s Brighton grew as Sandgate's outer urban area, opening the Brighton Bowls Club in 1950 and the Marching Girls' Association in 1955.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.queenslandplaces.com.au/brighton"
    },
    {
      "id": 4,
      "text": "The first bridge over Cabbage Tree Creek was constructed in 1861, dramatically improving access to Brighton.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.slq.qld.gov.au/blog/brighton"
    },
    {
      "id": 5,
      "text": "Brighton is bounded to the east by Bramble Bay, a side bay of Moreton Bay, giving it a waterfront edge.",
      "sourceSentenceIds": [
        16
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Brighton%2C_Queensland"
    },
    {
      "id": 6,
      "text": "The Brighton Hotel, originally built by David Rowntree Somerset, served as an orphanage after 1893 before returning to hotel status in 1912.",
