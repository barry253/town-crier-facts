      "id": 1,
      "text": "Lawndale was first known as \"Kickapoo\" before being platted by the Chicago, Alton & St. Railroad.",
      "sourceSentenceIds": [
        26
      ],
      "sourceLabels": [
        "Web source 1"
      ],
