    },
    {
      "id": 2,
      "text": "Odebolt’s name comes from Odebolt Creek, though the creek’s name origin is disputed between a French fur trapper and a bolt falling in the water.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Wikipedia"
