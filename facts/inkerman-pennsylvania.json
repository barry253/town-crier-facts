  "facts": [
    {
      "id": 1,
      "text": "Inkerman earned its name from the 1854 Battle of Inkerman in the Crimean War, a nod to a distant military clash.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/inkerman_pennsylvania",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Peter Winter opened the first blacksmith shop in 1810, drawing miners and setting the stage for Inkerman’s coal‑mining boom.",
      "sourceSentenceIds": [
        15,
        20
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/inkerman_pennsylvania",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "By 1878, the Inkerman No. 6 Colliery churned out nearly 45,000 tons of anthracite in just 192 days, employing over 170 workers.",
      "sourceSentenceIds": [
        26
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/inkerman_pennsylvania",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "During the 1940s wartime surge, the colliery’s workforce swelled to about 600, reflecting anthracite’s critical role in the war effort.",
      "sourceSentenceIds": [
        27
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/inkerman_pennsylvania",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Inkerman sits southeast of the Susquehanna River, nestled between the river and Gardner Creek in Luzerne County.",
      "sourceSentenceIds": [
        13
      ],
