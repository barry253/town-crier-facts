  "facts": [
    {
      "id": 1,
      "text": "Prestbury was named after an English town that dates back to the 1100s, linking the community to centuries of history.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.prestbury.org/prestbury-history/"
    },
    {
      "id": 2,
      "text": "The town began as a 700‑acre farm owned by the Judd family before RCA Associates purchased it in 1966 for development.",
      "sourceSentenceIds": [
        5,
        6
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.prestbury.org/prestbury-history/"
    },
    {
      "id": 3,
      "text": "RCA Associates promised the Planned Unit Development would take ten years to complete, a timeline that shaped Prestbury’s growth.",
      "sourceSentenceIds": [
        16
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.prestbury.org/prestbury-history/"
    },
    {
      "id": 4,
      "text": "Prestbury now hosts 526 single‑family homes and 417 multi‑family units, organized into eight distinct associations.",
      "sourceSentenceIds": [
        22,
        23
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.prestbury.org/prestbury-history/"
    },
    {
      "id": 5,
      "text": "A maintenance garage finished in 2018 serves the community’s upkeep needs, a key facility for the planned unit development.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.prestbury.org/prestbury-history/"
    },
    {
      "id": 6,
      "text": "Sunrise in Prestbury is at 8:26 AM and sunset at 8:51 PM, giving drivers a 12‑hour‑25‑minute day in the summer.",
