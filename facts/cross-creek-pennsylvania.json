  "facts": [
    {
      "id": 1,
      "text": "Cross Creek earned its name from the creek that winds through the heart of Avella, giving the township its identity.",
      "sourceSentenceIds": [
        15
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.crosscreektwp.org/history",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The township’s roots trace back to 1789 when Alexander Wells built a grist mill in Browntown, a landmark that guided early settlers.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.crosscreektwp.org/history",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Above the rocky bluffs lies Meadowcroft Village, the oldest known human habitation in North America, dating back roughly 13,000 years.",
      "sourceSentenceIds": [
        11
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.crosscreektwp.org/history",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Cross Creek sits atop the Pittsburgh Coal Seam, one of the world’s richest bituminous coal veins, shaping its early economy.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.crosscreektwp.org/history",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "In 2005, the township opened its first natural gas exploration, tapping the Marcellus Shale and other gas seams for modern energy.",
      "sourceSentenceIds": [
        13
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.crosscreektwp.org/history",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The community lies just two miles southwest of Atlasburg in northern Washington County, placing it close to the Ohio River watershed.",
