  "facts": [
    {
      "id": 1,
      "text": "Williamson was founded by George E. Williamson, who platted the town on his farmland in 1914.",
      "sourceSentenceIds": [
        1,
        3,
        4
      ],
      "sourceLabels": [
        "Web source 1",
        "Wikipedia"
      ],
      "source": "https://grokipedia.com/page/williamson_iowa"
    },
    {
      "id": 2,
      "text": "The town was initially named Gunwald before officially changing its name to Williamson in 1922.",
      "sourceSentenceIds": [
        1,
        5
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/williamson_iowa"
    },
    {
      "id": 3,
      "text": "Williamson grew quickly in the early twentieth century due to an influx of miners and workers from nearby coal operations.",
      "sourceSentenceIds": [
        5,
        9
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/williamson_iowa"
    },
    {
      "id": 4,
      "text": "The construction of the Rock Island Line railroad through the area in 1913 served as a key catalyst for the town's founding.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/williamson_iowa"
    },
    {
      "id": 5,
      "text": "Williamson was formally incorporated as a city in Lucas County on June 14, 1913.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/williamson_iowa"
    },
    {
      "id": 6,
      "text": "The former local high school now functions as a historical museum preserving artifacts of mining, agriculture, and education.",
      "sourceSentenceIds": [
        8,
        13
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/williamson_iowa"
    }
  ]
