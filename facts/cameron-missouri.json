  "facts": [
    {
      "id": 1,
      "text": "Cameron was founded when Judge Stokes moved all buildings from Somerville to a new town named after his wife's maiden name, Malinda Cameron.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Cameron%2C_Missouri",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town once hosted Missouri Wesleyan College, a Methodist institution that operated from 1883 until 1930.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Cameron%2C_Missouri",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The historic Cameron Train Depot Museum preserves regional rail and pioneer heritage, reflecting the town’s role at the junction of the Joseph and Rock Island railroads.",
      "sourceSentenceIds": [
        14,
        18
      ],
      "sourceLabels": [
        "Web source 1",
        "Web source 2"
      ],
      "source": "https://www.visitcameronmo.com/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "McCorkle Park remains Cameron’s centerpiece, where the Municipal Band performs free summer concerts every Thursday evening.",
      "sourceSentenceIds": [
        16,
        26
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://cameronmochamber.com/attractions/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The Veteran’s Memorial wall honors local soldiers from all four major U.S. conflicts and serves as the site of Memorial Day and Veterans Day services.",
      "sourceSentenceIds": [
