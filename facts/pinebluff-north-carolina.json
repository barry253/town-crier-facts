      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Founder John Tyrant Patrick originally envisioned Pinebluff as a bustling winter resort before it became a quiet residential community.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 1"
      ],
