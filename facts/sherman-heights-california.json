  "facts": [
    {
      "id": 1,
      "text": "Sherman Heights takes its name from Mathew Sherman, who bought the land in 1867 just after Alonzo Horton acquired much of downtown San Diego.",
      "sourceSentenceIds": [
        15
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.sandiego.gov/citycouncil/cd8/communities/shermanheights",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Villa Montezuma, a Victorian home built in 1887 for musician and spiritualist Jesse Shepard, now serves as a city‑owned house museum.",
      "sourceSentenceIds": [
        1,
        4
      ],
      "sourceLabels": [
        "Web source 1",
        "Wikipedia"
      ],
      "source": "https://www.sandiego.gov/citycouncil/cd8/communities/shermanheights",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Sherman Heights is a historic district, with roughly 70 % of its buildings deemed architecturally significant by the City of San Diego.",
      "sourceSentenceIds": [
        5,
        19
      ],
      "sourceLabels": [
        "Web source 2",
        "Wikipedia"
      ],
      "source": "https://sandiego.cfwebtools.com/search.cfm?display=records&res_id=16093&recordnum=5&dpr_id=14",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Immigrant waves have shaped the area: Germans arrived in the 1920s, Japanese in the 1940s, African‑Americans in the 1970s, and Mexican‑Americans have settled there ever since.",
      "sourceSentenceIds": [
        6,
        23,
        24
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Sherman_Heights%2C_San_Diego",
      "category": "people",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The 1969 Model Cities program financed the purchase of Villa Montezuma and sparked broader historic preservation efforts in Sherman Heights.",
