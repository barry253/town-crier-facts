  "facts": [
    {
      "id": 1,
      "text": "Englewood is located in Schuylkill County, which takes its name from a Dutch term meaning hidden stream.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/englewood_pennsylvania"
    },
    {
      "id": 2,
      "text": "Early European settlement in the area was heavily influenced by Dutch explorers and German immigrants from neighboring Berks County.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/englewood_pennsylvania"
    },
    {
      "id": 3,
      "text": "Englewood experiences a humid continental climate with hot summers and cold, snowy winters in the Appalachian Mountains region.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/englewood_pennsylvania"
    },
    {
      "id": 4,
      "text": "German farmers cultivated the productive soils of the region for agriculture and small-scale logging during the late eighteenth century.",
      "sourceSentenceIds": [
        23
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/englewood_pennsylvania"
    },
    {
      "id": 5,
      "text": "Englewood emerged as a residential outpost for workers during the regional anthracite coal boom of the mid-nineteenth century.",
      "sourceSentenceIds": [
        27
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/englewood_pennsylvania"
    },
    {
      "id": 6,
      "text": "Following the decline of the mining industry, Englewood transitioned toward sustainable residential development and small-scale agriculture.",
      "sourceSentenceIds": [
        29
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/englewood_pennsylvania"
