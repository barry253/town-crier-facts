  "facts": [
    {
      "id": 1,
      "text": "Middletown was founded in 1767 when the first lots were sold, marking its official start.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Middletown%2C_Maryland",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town’s name comes from its position midway between the Catoctin Mountains and South Mountain.",
      "sourceSentenceIds": [
        21
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Middletown%2C_Maryland",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "During the Civil War, both Union and Confederate armies passed through Middletown en route to South Mountain and Antietam, and the town opened its homes to wounded soldiers.",
      "sourceSentenceIds": [
        27,
        28
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Middletown%2C_Maryland",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The historic Main Street core showcases Federal and Greek Revival buildings like the 1859–1860 Zion Evangelical Lutheran Church.",
      "sourceSentenceIds": [
        29
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Middletown%2C_Maryland",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Middletown hosts an annual Heritage Festival every fourth Saturday of September, celebrating its long history and community.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.middletown.md.us/?SEC=5C954131-47E8-47D7-A732-43FCD65C9073",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The Welcome Center offers a Heritage Tour map funded by the Heart of the Civil War Heritage Area, highlighting the town’s Civil War significance.",
