  "facts": [
    {
      "id": 1,
      "text": "Center Ridge was founded in 1878 when settlers Frank O. and others established a post office on a ridge, giving the community its name.",
      "sourceSentenceIds": [
        14,
        30
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.livelovearkansas.homes/blog/2024/1/27-center-ridge-arkansas",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Archaeological digs before Brewer Lake revealed that Native Americans had lived in the Center Ridge area for thousands of years.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.livelovearkansas.homes/blog/2024/1/27-center-ridge-arkansas",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "During the Civil War, families in Center Ridge split loyally between the Confederacy and the Union, with men joining Confederate regiments and others enlisting in the Union army.",
      "sourceSentenceIds": [
        22,
        23,
        24,
        25
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.livelovearkansas.homes/blog/2024/1/27-center-ridge-arkansas",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "In 1868, Unionist militia clashed with former Confederates and the Ku Klux Klan during Reconstruction in Center Ridge.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.livelovearkansas.homes/blog/2024/1/27-center-ridge-arkansas",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "In 1962, Merle Kilgore and Claude King wrote the hit song “Wolverton Mountain” about Kilgore’s uncle Clifton Clowers, who lived near Center Ridge.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.livelovearkansas.homes/blog/2024/1/27-center-ridge-arkansas",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The historic Stobaugh house, which also served as a hotel, still stands in Center Ridge and is a key landmark for local history.",
