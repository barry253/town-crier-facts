      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Zerega’s Sons Inc., founded in 1848 in Brooklyn, now produces 100 million pounds of pasta annually and is headquartered in Fair Lawn.",
      "sourceSentenceIds": [
