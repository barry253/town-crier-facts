  "facts": [
    {
      "id": 1,
      "text": "Blackshear was founded in 1858 as the seat of newly formed Pierce County.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Blackshear%2C_Georgia",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The city is named after General David Blackshear, a patriot who built roads, bridges and forts.",
      "sourceSentenceIds": [
        2,
        3
      ],
      "sourceLabels": [
        "Web source 1",
        "Wikipedia"
      ],
      "source": "https://www.travellens.co/best-things-to-do-in-blackshear-ga/",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The historic Blackshear Railroad Depot, built in 1903, now houses the Pierce County Heritage Museum and Genealogical Library.",
      "sourceSentenceIds": [
        6,
