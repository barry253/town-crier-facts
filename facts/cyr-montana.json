  "facts": [
    {
      "id": 1,
      "text": "The station was named for the Cyr family, from whom the Northern Pacific obtained a right‑of‑way.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Cyr%2C_Montana"
    },
    {
      "id": 2,
      "text": "Cyr emerged during the Milwaukee Road's 1914 electrification, kept passenger service until 1961, and saw the line abandoned in 1980.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/cyr_montana"
    },
    {
      "id": 3,
      "text": "The station drew settlers and railroad workers, creating a community that included section houses for track‑maintenance crews.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/cyr_montana"
    },
    {
      "id": 4,
      "text": "The Clark Fork River near Cyr shelters trout, deer, and beavers, while its seasonal floods renew floodplain habitats.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/cyr_montana"
    },
    {
      "id": 5,
      "text": "French‑Canadian families settled Cyr, boosting agriculture and timber production in the Bitterroot and Clark Fork valleys.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/cyr_montana"
    },
    {
      "id": 6,
      "text": "The 1928 Cyr Bridge, a steel truss built by the Milwaukee Road, is now being rehabilitated to keep traffic flowing.",
      "sourceSentenceIds": [
