  "facts": [
    {
      "id": 1,
      "text": "Mount Bullion earned its name when a nearby peak was renamed in honor of Benton, a Missouri miner whose daughter married John C. Bullion.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://beyond.nvexpeditions.com/california/mariposa/mtbullion.php",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The first major gold rush in the area began in 1852 when the Princeton mine opened, sparking a boom in the surrounding hills.",
      "sourceSentenceIds": [
        29
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://beyond.nvexpeditions.com/california/mariposa/mtbullion.php",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "In 1970, a ground‑breaking ceremony for the new Library‑History Center drew six hundred volunteers, each bringing a shovel and a family story.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.mariposamuseum.com/about-3",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The Library‑History Center opened its doors in August 1971, and the dedication that month cost $206,373, a sum that included all volunteer labor.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.mariposamuseum.com/about-3",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "A bell that once rang in the Presbyterian Church on Bullion Street now hangs proudly in front of the History Center, a relic moved during the center’s construction.",
      "sourceSentenceIds": [
        1,
        10
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.mariposamuseum.com/about-3",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The original Presbyterian Church stood on what is now the site of Freeman and Seaman Surveying, a detail that ties the town’s early religious life to its modern landscape.",
      "sourceSentenceIds": [
        10
