  "facts": [
    {
      "id": 1,
      "text": "Bantry was founded in 1905 by Irish immigrants who named it after the coastal town of Bantry in County Cork, Ireland.",
      "sourceSentenceIds": [
        1,
        12
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/bantry_north_dakota"
    },
    {
      "id": 2,
      "text": "The Great Northern Railroad arrived in 1905, turning Bantry into a rail hub that supported wheat transport during North Dakota's 1910s agricultural boom.",
      "sourceSentenceIds": [
        13,
        15
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/bantry_north_dakota"
    },
    {
      "id": 3,
      "text": "Bantry sits near the Souris River valley, about 10 miles east, where alluvial soils keep the land fertile for prairie farming.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/bantry_north_dakota"
    },
    {
      "id": 4,
      "text": "A Methodist church led by first pastor George Hoy and a Catholic church founded around 1912 served the growing Irish community.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/bantry_north_dakota"
    },
    {
      "id": 5,
      "text": "Bantry’s elevation is 1,453 feet (443 meters), giving it a slightly higher prairie plateau compared to surrounding lowlands.",
      "sourceSentenceIds": [
        11
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/bantry_north_dakota"
    },
    {
      "id": 6,
      "text": "Bantry dissolved as a city in November 2019, returning the area to township status within McHenry County.",
