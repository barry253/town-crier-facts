  "facts": [
    {
      "id": 1,
      "text": "Brownsville was first known as Thetis Station and once had a narrow gauge railroad connection to Fond du Lac and Iron Ridge.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Brownsville%2C_Wisconsin"
    },
    {
      "id": 2,
      "text": "The village of Brownsville was renamed in April 1878 to honor Alfred Brown, an English immigrant and pioneer farmer.",
      "sourceSentenceIds": [
        4,
        6,
        13
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 2"
      ],
      "source": "https://en.wikipedia.org/wiki/Brownsville%2C_Wisconsin"
    },
    {
      "id": 3,
      "text": "Kummel Creek, a tributary of the Rock River, begins just north of Brownsville and flows directly through the village.",
      "sourceSentenceIds": [
        30
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Brownsville%2C_Wisconsin"
    },
    {
      "id": 4,
      "text": "Saint Paul's Lutheran Church in Brownsville was founded in 1885 by fifteen local families from a congregation in Lomira.",
      "sourceSentenceIds": [
        20
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Brownsville%2C_Wisconsin"
    },
    {
      "id": 5,
      "text": "Early businesses in Brownsville included a hotel, a post office, a cheese factory, and a bowling alley and tavern.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.brownsvillewi.com/history"
    },
    {
      "id": 6,
      "text": "Brownsville's public library was finally completed in November 1949 when a new building was erected next to the village pump house.",
