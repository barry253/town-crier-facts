  "facts": [
    {
      "id": 1,
      "text": "Middletown was founded in 1755 by George Fisher, who named it because it lay midway between Lancaster and Carlisle.",
      "sourceSentenceIds": [
        3,
        4,
        5,
        6
      ],
      "sourceLabels": [
        "Web source 1",
        "Web source 2"
      ],
      "source": "https://middletownborough.com/about/",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "William Penn chose the site in 1690 as a settlement on the Susquehanna River, making Middletown the oldest community in Dauphin County.",
      "sourceSentenceIds": [
        1,
        8,
        24
      ],
      "sourceLabels": [
        "Web source 1",
        "Web source 2"
      ],
      "source": "https://middletownborough.com/about/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "In 1809, George Fisher’s son laid out Harborton at the junction of Swatara Creek and the Susquehanna, later merged with Middletown in 1857.",
      "sourceSentenceIds": [
        28,
        9,
        10
      ],
      "sourceLabels": [
        "Web source 1",
        "Web source 2"
      ],
      "source": "https://middletownborough.com/about/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "President George Washington stopped in Middletown in October 1774, staying at a tavern on West Main Street.",
      "sourceSentenceIds": [
        30
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://middletownborough.com/about/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The 1909 Kreider Shoe Factory remains the oldest existing industry building in Middletown, a relic of its early manufacturing past.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://middletownareahistoricalsociety.org/history-of-middletown",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The 1736 state road from Lancaster via Pine Ford crossed Swatara Creek at Middletown, establishing the town as a key early transportation hub.",
      "sourceSentenceIds": [
