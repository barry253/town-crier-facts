    {
      "id": 1,
      "text": "Lakeview Colony was established in 1988 as a daughter colony of the Maxwell Hutterite Colony near Scotland, South Dakota.",
      "sourceSentenceIds": [
        1,
        4
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/lakeview_colony_south_dakota"
    },
    {
      "id": 2,
      "text": "Members of Lakeview Colony practice communal living based on Anabaptist principles and belong to the Schmiedeleut Group 2 branch of Hutterites.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/lakeview_colony_south_dakota"
    },
    {
      "id": 3,
      "text": "Lakeview Colony is one of the state's Hutterite colonies producing turkeys, raising approximately 100,000 birds annually.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/lakeview_colony_south_dakota"
    },
    {
      "id": 4,
      "text": "Lakeview Colony overlooks Lake Andes, a natural water body located just two miles to the east.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Lakeview_Colony%2C_South_Dakota"
    },
    {
      "id": 5,
      "text": "Lakeview Colony founded the Pease Creek Hutterite Colony in 2018 after reaching the traditional Hutterite population threshold for splitting.",
      "sourceSentenceIds": [
        25
      ],
      "sourceLabels": [
