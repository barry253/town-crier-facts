    },
    {
      "id": 2,
      "text": "The settlement of West Peavine traces its origins to the forced relocation of the Cherokee Nation during the Trail of Tears.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/west_peavine_oklahoma"
    },
    {
      "id": 3,
      "text": "West Peavine emerged as part of the Cherokee Nation's Going Snake and Flint districts before Oklahoma achieved statehood in 1907.",
      "sourceSentenceIds": [
        28
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/west_peavine_oklahoma"
    },
    {
      "id": 4,
      "text": "West Peavine's early schools were built as Works Progress Administration projects during the Great Depression to provide local economic relief.",
