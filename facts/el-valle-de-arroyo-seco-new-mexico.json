    {
      "id": 1,
      "text": "El Valle de Arroyo Seco was originally called El Ojito because of its natural springs amid the desert.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/el_valle_de_arroyo_seco_new_mexico",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "In 1927, homesteader Procopio Herrera Roybal bought a large ranch for cattle and dry‑land beans, sparking early settlement.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/el_valle_de_arroyo_seco_new_mexico",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "During the 1940s and 1950s, homesteading lots filled fast as families moved in, drawn by jobs linked to Los Alamos.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/el_valle_de_arroyo_seco_new_mexico",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "El Valle de Arroyo Seco sits in the Española Valley, a high‑desert basin shaped by the Rio Grande rift.",
      "sourceSentenceIds": [
        24
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/el_valle_de_arroyo_seco_new_mexico",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The area receives about 12 inches of rain each year, mostly from summer monsoons, with winter snow adding to the mix.",
      "sourceSentenceIds": [
        30
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/el_valle_de_arroyo_seco_new_mexico",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Santa Fe County officially recognized El Valle de Arroyo Seco as a Traditional Community, honoring its historic settlement patterns.",
