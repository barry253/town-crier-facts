      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "In 1870 the Big Creek Post Office moved and was renamed the Stanwood Post Office, marking the village’s official name change.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 2"
      ],
