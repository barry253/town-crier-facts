      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Stanwood sits in western Mecosta County, just nine miles south of the county seat Big Rapids and six miles north of Morley.",
      "sourceSentenceIds": [
        18,
        20
      ],
      "sourceLabels": [
        "Wikipedia"
