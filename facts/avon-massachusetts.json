      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Avon%2C_Massachusetts",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town separated from Stoughton and incorporated on February 21, 1888, marking its official birth.",
      "sourceSentenceIds": [
        14
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Avon%2C_Massachusetts",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Moses Curtis, a blacksmith from Braintree, was the first settler in the area that would become Avon.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
