  "facts": [
    {
      "id": 1,
      "text": "Lancaster earned its name from a Pennsylvania town, either because a settler hailed there or the layout mirrored the original.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Lancaster%2C_Kentucky"
    },
    {
      "id": 2,
      "text": "The historic Grand Theater, built in 1925, has recently been renovated, restoring its classic charm to downtown Lancaster.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://cityoflancasterky.com/about-us/"
    },
    {
      "id": 3,
      "text": "Nearly fifty Lancaster buildings sit on the National Historic Register, many downtown and currently undergoing renovation.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://cityoflancasterky.com/about-us/"
    },
    {
      "id": 4,
      "text": "The Garrard County Historical Society, a key local resource, is housed right in Lancaster.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://cityoflancasterky.com/about-us/"
    },
    {
      "id": 5,
      "text": "Lancaster Public Library occupies structures dating back to 1810 and 1850, offering a glimpse into the town’s early architecture.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://cityoflancasterky.com/about-us/"
    },
    {
      "id": 6,
      "text": "Kentucky Route 27 cuts through Lancaster, meeting Route 52 at the city center, linking the town to Lexington, Somerset, Richmond, and Danville.",
