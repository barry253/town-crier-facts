      "id": 1,
      "text": "Lennon was founded by Peter Lennon, who secured the Grand Trunk Western Railroad to pass through the settlement and built a depot there.",
      "sourceSentenceIds": [
        1,
        5
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
