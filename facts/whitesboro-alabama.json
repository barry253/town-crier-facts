  "facts": [
    {
      "id": 1,
      "text": "Whitesboro was settled in the late 1800s by Steve White, becoming one of Etowah County’s earliest communities after the county formed in 1866.",
      "sourceSentenceIds": [
        13,
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/whitesboro_alabama",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Etowah County, where Whitesboro sits, was renamed in 1868 from Baine County to a Cherokee word meaning \"edible tree,\" reflecting Native American roots.",
      "sourceSentenceIds": [
        6,
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/whitesboro_alabama",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Unlike neighboring Gadsden, Whitesboro has stayed agricultural, with residents mainly farming the county’s hilly terrain.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/whitesboro_alabama",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The area’s early settlers followed treaties like the 1816 Turkeytown agreement, opening Cherokee lands for farming of edible crops.",
      "sourceSentenceIds": [
        18
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/whitesboro_alabama",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "During World War II, nearby Gadsden’s ordnance plant and Camp Sibert drew workers from Whitesboro, briefly diversifying its economy.",
      "sourceSentenceIds": [
        23,
        24
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/whitesboro_alabama"
    }
