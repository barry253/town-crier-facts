  "facts": [
    {
      "id": 1,
      "text": "Warrington was named after Navy Commodore Lewis Warrington, who helped establish the Pensacola Navy Yard in the 1820s.",
      "sourceSentenceIds": [
        1,
        2
      ],
      "sourceLabels": [
        "Web source 2",
        "Wikipedia"
      ],
      "source": "https://grokipedia.com/page/warrington_florida",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The Pensacola Navy Yard, initially known as Warrington Navy Yard, was built in the 1820s on land previously used by Spanish settlers.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/warrington_florida",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The town was relocated north of Bayou Grande in the 1930s to make additional space available for the expanding Naval Air Station.",
      "sourceSentenceIds": [
        15
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Warrington%2C_Florida",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "He promoted Warrington’s expansion and the nearby settlement of Woolsey to encourage homebuilding among yard employees, providing essential housing for the workforce.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/warrington_florida",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Today, the site of the former Navy Yard forms part of Naval Air Station Pensacola, underscoring Warrington's enduring connection to U.S.",
      "sourceSentenceIds": [
        21
      ],
      "sourceLabels": [
        "Web source 2"
      ],
