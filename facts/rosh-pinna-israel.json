  "facts": [
    {
      "id": 1,
      "text": "Rosh Pinna, founded in 1878 as Gei Oni by Jews from Safed, later renamed in 1882 by Romanian immigrants after Psalm 118:22.",
      "sourceSentenceIds": [
        2,
        3,
        11
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Rosh_Pinna",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "In 1883, Rosh Pinna became the first Jewish settlement to receive patronage from Baron Edmond James de Rothschild, boosting its growth.",
      "sourceSentenceIds": [
        19
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Rosh_Pinna",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The 19th‑century synagogue, one of the town’s best‑preserved historic buildings, still stands amid the village’s cobblestone streets.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.trawellino.com/destinations/israel/northern-district_rosh-pinna",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The nearby Lake Hula, once a swamp drained in the 1950s, lies north of the town and once fed the region’s agriculture.",
      "sourceSentenceIds": [
        14
      ],
      "sourceLabels": [
