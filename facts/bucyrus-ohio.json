      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Colonel James Kilbourne founded Bucyrus in 1821, laying out the town on land that would become Crawford County's seat.",
      "sourceSentenceIds": [
        10,
        26
      ],
      "sourceLabels": [
        "Web source 1",
