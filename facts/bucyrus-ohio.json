      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The Bucyrus Foundry and Manufacturing Company, founded locally, later evolved into Bucyrus International, Inc., moving its headquarters to Wisconsin in 1893.",
      "sourceSentenceIds": [
        28,
        29
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
