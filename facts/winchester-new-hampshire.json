  "facts": [
    {
      "id": 1,
      "text": "Originally called Arlington, the town was renamed Winchester in 1753 after Charles Paulet, the 3rd Duke of Bolton.",
      "sourceSentenceIds": [
        1,
        18
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Winchester%2C_New_Hampshire"
    },
    {
      "id": 2,
      "text": "The Ashuelot Railroad arrived in 1850, sparking growth of textile mills and wooden‑ware factories, especially boxes and leather tanning.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Winchester%2C_New_Hampshire"
    },
    {
      "id": 3,
      "text": "Winchester’s first church, founded in 1736, remains the oldest religious body in Cheshire County.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Winchester%2C_New_Hampshire"
    },
    {
      "id": 4,
      "text": "In 1803, a Universalist congress in Winchester adopted the influential Winchester Profession, outlining Universalism’s core principles.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Winchester%2C_New_Hampshire"
    },
    {
      "id": 5,
      "text": "Winchester proudly hosts two covered bridges, each a testament to 19th‑century engineering.",
      "sourceSentenceIds": [
        21
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Winchester%2C_New_Hampshire"
    },
    {
      "id": 6,
      "text": "The town’s landscape is shaped by the Ashuelot River and its tributary Mirey Brook, both flowing through Winchester.",
      "sourceSentenceIds": [
        24
