      "id": 1,
      "text": "Falmouth earned its name when the Massachusetts Bay Colony renamed the area after the 1645 Parliamentary victory at the Battle of Falmouth in England.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
