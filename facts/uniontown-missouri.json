  "facts": [
    {
      "id": 1,
      "text": "Uniontown began as Paitzdorf, named after a village in Thuringia, Germany, where many early settlers came from.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Uniontown%2C_Missouri",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "During the Civil War, Union soldiers could not pronounce Paitzdorf, so they called it Uniontown.",
      "sourceSentenceIds": [
        11,
        12
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Uniontown%2C_Missouri",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "In 1839, a group of Saxon‑German immigrants founded the community that would become Uniontown.",
      "sourceSentenceIds": [
        13
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Uniontown%2C_Missouri",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Uniontown sits in Union Township, southeastern Perry County, Missouri, in the heart of the state.",
