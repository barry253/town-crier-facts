  "facts": [
    {
      "id": 1,
      "text": "Kinzers was named after Harry Kinzer, a descendant of Palatine German settlers, and was founded in 1835.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Kinzers%2C_Pennsylvania"
    },
    {
      "id": 2,
      "text": "The Cambrian Kinzers Formation, mostly marble and shale, was named after the town and its type section sits in a nearby railroad cut.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Kinzers%2C_Pennsylvania"
    },
    {
      "id": 3,
      "text": "The Rough and Tumble Engineers Historical Association in Salisbury Township’s part of Kinzers showcases a steam engine display and hosts a thresherman’s reunion each year.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Kinzers%2C_Pennsylvania"
    },
    {
      "id": 4,
      "text": "Kinzers lies along the historic Philadelphia and Lancaster Turnpike, one of the earliest roads in the region.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://kids.kiddle.co/Kinzers,_Pennsylvania"
    },
    {
