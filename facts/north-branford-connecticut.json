  "facts": [
    {
      "id": 1,
      "text": "North Branford’s Totoket Historical Society, founded in 1958 as the Northford Historical Institute, preserves four historic buildings including the Reynolds Beers House.",
      "sourceSentenceIds": [
        1,
        6
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/North_Branford%2C_Connecticut",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The Reynolds Beers House, the society’s main museum, once served as a saltbox home with a large fieldstone chimney before expanding as families grew.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://nbranfordlibraries.org/community/history-of-north-branford/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "In 1926, Totoket Mountain’s Lake Gaillard reservoir was created, now managed by the South Central Connecticut Regional Water Authority.",
      "sourceSentenceIds": [
        15
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/North_Branford%2C_Connecticut",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "North Branford’s early economy boomed when Maltby Fowler opened a button‑making shop in 1830, sparking a wave of local manufacturing.",
      "sourceSentenceIds": [
        25
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/North_Branford%2C_Connecticut",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "By the early 1900s, the town’s abundant trap rock supply turned quarrying into a major industry, shaping its industrial heritage.",
      "sourceSentenceIds": [
        27
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/North_Branford%2C_Connecticut",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The Branford Steam Railroad, once a steam‑powered freight line, transported Tilcon products to shoreline barges, linking North Branford to regional trade.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Wikipedia"
