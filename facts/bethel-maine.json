  "facts": [
    {
      "id": 1,
      "text": "Bethel was first settled in 1774 and was originally named \"Sudbury Canada\" after settlers from Sudbury, Massachusetts who fought in the 1690 campaign.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://bethelhistorical.org/catalog/exhibits/show/historic-town/introduction",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The Lawrence Railroad opened in 1851, linking Bethel to Portland and later Montreal, turning the town into a hub for freight and summer tourists.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://bethelhistorical.org/catalog/exhibits/show/historic-town/introduction",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Founded in 1836, Gould Academy remains one of the Northeast's premier college‑preparatory schools, drawing students from across the region.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://bethelhistorical.org/catalog/exhibits/show/historic-town/introduction",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "In 1897, the Maine Music Festival was founded in Bethel, and its founder brought Metropolitan Opera star Geraldine Farrar to perform in Odeon Hall.",
      "sourceSentenceIds": [
        18
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://bethelhistorical.org/catalog/exhibits/show/historic-town/introduction",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "An Abenaki village once stood on the north side of the Androscoggin River near Bethel, but it was abandoned before English settlement.",
      "sourceSentenceIds": [
        13
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Bethel%2C_Maine",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Large summer hotels sprang up on Bethel Hill in the 19th century, making the town a key stop for tourists heading to the White Mountains and Rangeley Lakes.",
      "sourceSentenceIds": [
        25
      ],
      "sourceLabels": [
        "Web source 1"
      ],
