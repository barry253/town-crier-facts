  "facts": [
    {
      "id": 1,
      "text": "Primm Springs grew from a mid‑1830s watering spa founded by the John Primm family, who named the springs after their own homestead.",
      "sourceSentenceIds": [
        1,
        23
      ],
      "sourceLabels": [
        "Web source 2",
        "Web source 1"
      ],
      "source": "https://sharetngov.tnsosfiles.com/tsla/exhibits/tnresorts/spring_histories.htm",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The resort expanded in the 1860s under the Estes family, adding a dance pavilion, bowling alley, and the flagship Estes House with 21 rooms.",
      "sourceSentenceIds": [
        15,
        16
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/primm_springs_tennessee",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Primm Springs’ mineral waters—black sulphur, white sulphur, lime, calomel, and arsenic—were famed for curative properties and drew guests for health and leisure.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/primm_springs_tennessee",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The Peavine Railroad, completed in 1896, brought wealthy travelers in private cars, boosting the resort’s popularity during its heyday.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://sharetngov.tnsosfiles.com/tsla/exhibits/tnresorts/spring_histories.htm",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "After World War II, the resort closed in 1945, reopening only for meals until 1965 before floods and abandonment left many buildings in disrepair.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/primm_springs_tennessee",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "In 1986 the Primm Springs district was listed on the National Register of Historic Places, preserving its 1836‑1935 vernacular resort heritage.",
      "sourceSentenceIds": [
        19
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/primm_springs_tennessee",
