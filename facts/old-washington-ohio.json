      "id": 1,
      "text": "Platted in 1805 by George and Henry Beymer, Old Washington was first called Beymerstown and New Washington.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
