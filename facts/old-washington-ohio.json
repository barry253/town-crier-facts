      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "In 1829 the village incorporated as Washington, but changed its name to Old Washington to avoid postal confusion with Washington Court House.",
      "sourceSentenceIds": [
        9,
        10
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Old_Washington%2C_Ohio",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The National Road arrived shortly after incorporation, making Old Washington a key stop for early travelers.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
