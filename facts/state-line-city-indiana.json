  "facts": [
    {
      "id": 1,
      "text": "State Line City sprang to life in 1857 when Robert Casement platted the town at the junction of two railroads that met on the Indiana‑Illinois border.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/State_Line_City%2C_Indiana",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "On February 11, 1861, Abraham Lincoln paused in State Line City for a quick meal and a brief speech before heading to Washington for his inauguration.",
      "sourceSentenceIds": [
        7,
        8
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/State_Line_City%2C_Indiana",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The town’s grain elevators, first built in 1857, were destroyed by fire three times—1900, 1932, and 1984—yet each time the community rebuilt them.",
      "sourceSentenceIds": [
        13
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/State_Line_City%2C_Indiana",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "A 1975 fertilizer and agricultural sales facility northeast of town, now operated by Westland Co‑Op, remains one of State Line City’s largest businesses.",
      "sourceSentenceIds": [
        15
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/State_Line_City%2C_Indiana",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The annual State Line Fun Days festival, once sponsored by the KTFD, was a community highlight but has not been held in recent years.",
      "sourceSentenceIds": [
        16
