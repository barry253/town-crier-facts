  "facts": [
    {
      "id": 1,
      "text": "Thonburi’s name comes from Pali dhána ‘wealth’ and Pali púra ‘fortress’, reflecting its historic role as a garrison town.",
      "sourceSentenceIds": [
        14
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Thonburi",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "After the Burmese sacked Ayutthaya in 1767, General Taksin made Thonburi the capital of his new kingdom until 1782.",
      "sourceSentenceIds": [
        16
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Thonburi",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Thonburi remained an independent town until 1971, when it was merged into the larger Bangkok municipality.",
      "sourceSentenceIds": [
        18
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Thonburi",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Many of Thonburi’s traditional khlongs—waterways that once crisscrossed the district—still exist today, a rarity on the other side of the river.",
      "sourceSentenceIds": [
        20
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Thonburi",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Across from Bangkok Noi railway station, the Royal Barge Museum showcases the royal barges that once sailed the Chao Phraya River.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://bangkokforvisitors.com/thonburi/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Wongwian Yai, a historic traffic circle, stands as a landmark of Thonburi District and a reminder of its past as a bustling trade hub.",
      "sourceSentenceIds": [
        23
      ],
      "sourceLabels": [
