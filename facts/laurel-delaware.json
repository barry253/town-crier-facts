  "facts": [
    {
      "id": 1,
      "text": "Laurel was founded in 1683, incorporated 1883, once one of Delaware's wealthiest towns with about 2,500 residents.",
      "sourceSentenceIds": [
        1,
        3
      ],
      "sourceLabels": [
        "Web source 2",
        "Web source 1"
      ],
      "source": "https://www.townoflaurel.net/history.htm"
    },
    {
      "id": 2,
      "text": "The town’s name comes from laurel bushes that grew along Broad Creek, where the original settlement was laid out in the 1790s.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Laurel%2C_Delaware"
    },
    {
      "id": 3,
      "text": "The Delmarva Central Railroad’s Delmarva Subdivision line runs north–south through Laurel, linking it to regional rail history.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Laurel%2C_Delaware"
    },
    {
      "id": 4,
      "text": "Laurel Heritage Museum sits in the historic train station, offering a glimpse into the town’s mill and shop era.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://visitsoutherndelaware.com/area-info/laurel"
    },
    {
      "id": 5,
      "text": "The town hosts the Broad Creek Bash, a July/August cycling event that passes historic sites like the Laurel Heritage Museum and Old Christ Church.",
      "sourceSentenceIds": [
        13
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://visitsoutherndelaware.com/area-info/laurel"
    },
    {
      "id": 6,
      "text": "Laurel contains more historic buildings than any Delaware town, with 800 listed on the National Historic Record.",
      "sourceSentenceIds": [
        14
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.townoflaurel.net/history.htm"
    }
