      "id": 1,
      "text": "Dunbar School opened on September 22, 1913, as Tucson’s first public school for African American students.",
      "sourceSentenceIds": [
        11
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Dunbar_School_(Tucson%2C_Arizona)",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "During segregation, the school was named after celebrated African‑American poet Paul Laurence Dunbar.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Dunbar_School_(Tucson%2C_Arizona)",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The Dunbar Historic District received city designation in 1994 and was added to the National Register of Historic Places.",
      "sourceSentenceIds": [
        18
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://hoffmanhomestucson.com/top-5-neighborhoods/dunbar-historic-district/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Pilgrim Rest Baptist Church, founded in 1917, relocated to the Dunbar neighborhood in 1926.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://hoffmanhomestucson.com/top-5-neighborhoods/dunbar-historic-district/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The former Dunbar Elementary School now functions as the Dunbar Pavilion, a community cultural hub.",
