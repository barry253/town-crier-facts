  "facts": [
    {
      "id": 1,
      "text": "Adelphi takes its name from the historic Adelphi Mill, built in 1796 along the Northwest Branch of the Anacostia River.",
      "sourceSentenceIds": [
        5,
        8
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Adelphi%2C_Maryland"
    },
    {
      "id": 2,
      "text": "The Adelphi Mill is the oldest and largest surviving mill in the Washington, D.C., area and the only historic mill preserved in Prince George's County.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/Adelphi,_Maryland"
    },
    {
      "id": 3,
      "text": "The mill originally served as a grist mill for grinding grain and later for wool carding, a role it played from 1811 onward.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/Adelphi,_Maryland"
    },
    {
      "id": 4,
      "text": "Today the Adelphi Mill sits within the Northwest Branch Stream Valley Park, where visitors can see its preserved fieldstone structure.",
      "sourceSentenceIds": [
        2,
        7
      ],
      "sourceLabels": [
        "Web source 1",
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/Adelphi,_Maryland"
    },
    {
      "id": 5,
      "text": "Adelphi’s early growth was spurred by the establishment of the Adelphi Laboratory Center, the Army Research Laboratory, on 137 acres in 1971.",
      "sourceSentenceIds": [
