  "facts": [
    {
      "id": 1,
      "text": "South Lead Hill earned its name from the lead deposits that sparked a mining boom in the early 1900s.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.leadhill.net/",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "When Bull Shoals Dam flooded the original Lead Hill in 1952, residents moved to higher ground, founding South Lead Hill.",
      "sourceSentenceIds": [
        16
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/south_lead_hill_arkansas",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Before European settlement, the Osage people used the area around South Lead Hill as seasonal hunting grounds for bison and deer.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/south_lead_hill_arkansas",
      "category": "people",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "By 1854, the original Lead Hill boasted a Baptist church, a hotel, and its own newspaper, the Lead Hill Bugle.",
      "sourceSentenceIds": [
        23
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/south_lead_hill_arkansas",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "South Lead Hill’s proximity to Bull Shoals Lake offers residents easy access to boating, fishing, and scenic shoreline.",
      "sourceSentenceIds": [
        17
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/south_lead_hill_arkansas",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "In 1854, land patents granted to Eli Dodson and William Cantrell marked the first private claims near what is now South Lead Hill.",
      "sourceSentenceIds": [
        22
