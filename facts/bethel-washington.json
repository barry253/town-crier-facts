      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://beckdc.com/historical-places-in-bethel/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The McGraw Street Bridge, built in the early 1900s, once carried travelers over the river that runs through Bethel.",
