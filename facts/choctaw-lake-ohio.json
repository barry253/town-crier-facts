  "facts": [
    {
      "id": 1,
      "text": "Choctaw Lake is built around an impoundment on Deer Creek, a tributary of the Scioto River.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Choctaw_Lake%2C_Ohio",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The lake itself was created in 1964 when American Realty Service Corp dammed Deer Creek and George’s Fork Creek.",
      "sourceSentenceIds": [
        17
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://madisonhist2024.net/?page_id=1317",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "More than 800 homes circle the lake, making it a sizable residential community.",
      "sourceSentenceIds": [
        21
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://madisonhist2024.net/?page_id=1317",
      "category": "other",
      "quality": "poor",
      "qualityReason": "other"
    },
    {
      "id": 4,
      "text": "Water comes from the Deer Creek watershed, fed by runoff from 15,616 acres of farmland across three counties.",
      "sourceSentenceIds": [
        22
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://madisonhist2024.net/?page_id=1317",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The watershed supplies 60% of the lake’s water, with the rest coming from local ditches and small creeks.",
      "sourceSentenceIds": [
        23
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://madisonhist2024.net/?page_id=1317",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Property owners and their guests can boat and fish on the lake, but access is limited to those with passes.",
      "sourceSentenceIds": [
        25
      ],
      "sourceLabels": [
        "Web source 1"
      ],
