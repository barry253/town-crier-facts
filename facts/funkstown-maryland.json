  "facts": [
    {
      "id": 1,
      "text": "Funkstown began in 1754 when Henry Funk purchased 88 acres from Frederick Calvert, the 6th Baron Baltimore, and the settlement was originally named Jerusalem.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Funkstown%2C_Maryland",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "During the Civil War, a strong Confederate presence at Funkstown threatened any Union advance against General Lee.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Funkstown%2C_Maryland",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "On July 10, 1863, John Buford's Federal cavalry cautiously approached Funkstown via the National Road, encountering Stuart's crescent-shaped battle line.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Funkstown%2C_Maryland",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The day-long battle east of Funkstown resulted in 479 casualties, a toll that echoed the fierce fighting of Gettysburg.",
      "sourceSentenceIds": [
        20
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Funkstown%2C_Maryland",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Funkstown Historic District was listed on the National Register of Historic Places in 2000, preserving its 18th‑century architecture.",
      "sourceSentenceIds": [
        25
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Funkstown%2C_Maryland",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Antietam Creek flows south through Funkstown, joining the Potomac River just south of Hagerstown.",
      "sourceSentenceIds": [
        27
      ],
