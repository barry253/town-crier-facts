  "facts": [
    {
      "id": 1,
      "text": "The name Neopit comes from the Menominee word Neyōpet, which means four sitting.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Neopit%2C_Wisconsin"
    },
    {
      "id": 2,
      "text": "Menominee families began relocating to the Neopit area by the mid-1850s, establishing villages for hunting, fishing, and maple sugaring.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/neopit_wisconsin"
    },
    {
      "id": 3,
      "text": "The Menominee Indian Tribe is recognized for pioneering sustainable forestry management to preserve old-growth forests through selective logging.",
      "sourceSentenceIds": [
        26
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/neopit_wisconsin"
    },
    {
      "id": 4,
      "text": "The Menominee people trace their origins to this region, with oral traditions asserting they have always inhabited the area.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/neopit_wisconsin"
    },
    {
      "id": 5,
      "text": "Neopit remains a center for the Menominee people, who maintain a distinct Algonquian-speaking culture and clan-based social structures.",
