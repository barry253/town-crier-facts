  "facts": [
    {
      "id": 1,
      "text": "Union Parish earned its name from the union of states that form the United States, reflecting its early settlers' patriotic spirit.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.louisiana.gov/local-louisiana/union-parish",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Farmerville serves as the parish seat of Union Parish, acting as the local hub for government and community events.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.louisiana.gov/local-louisiana/union-parish",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Lake D'Arbonne, a centerpiece of Union Parish, offers anglers a chance to catch 1.5 to 2-pound fish and occasionally 3-pounders.",
      "sourceSentenceIds": [
        13
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://tourunionparish.com/",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The Upper Ouachita National Wildlife Refuge within Union Parish houses the Finch and Harrell lakes complex, a haven for summer bream fishing.",
      "sourceSentenceIds": [
        17
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://tourunionparish.com/",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Before Lake D'Arbonne filled the valley, Forks Ferry was a common crossing where two bayous met, a historic transportation point.",
      "sourceSentenceIds": [
        30
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://tourunionparish.com/",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Union Parish’s geography includes the Corney Creek arm of Lake D'Arbonne, which flows under the highway and supports public fishing ramps in Bernice.",
