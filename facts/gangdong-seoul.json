    {
      "id": 1,
      "text": "Gangdong's prehistoric heritage dates back 6,000 years, evidenced by the Amsa-dong Neolithic site.",
      "sourceSentenceIds": [
        14,
        16
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Gangdong_District",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The Pungnap Earthen Fortress, built by Gojoseon ancestors, marks the earliest known fortification in the area.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.gangdong.go.kr/web/eng/contents/gde_010_020",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "In 1988, a portion of Gangdong was split off to create Songpa-gu just before the Seoul Olympics.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.gangdong.go.kr/web/eng/contents/gde_010_020",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Achasan Mountain Fortress, a Joseon‑era site, offers hiking trails and sweeping views of Seoul.",
      "sourceSentenceIds": [
        24
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.koreatripguide.com/destinations/historical-landmarks-and-sightseeing-around-gangdong-gu-seoul",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Lotte World Tower, Seoul’s tallest building, stands in Gangdong and draws visitors to its observation deck.",
