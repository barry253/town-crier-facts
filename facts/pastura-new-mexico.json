  "facts": [
    {
      "id": 1,
      "text": "Pastura was founded in 1901 as a watering stop for steam trains on the Southern Pacific Railroad.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Pastura%2C_New_Mexico",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "In 1903 the U.S. Postal Service opened a post office in Pastura, and by 1907 a 142‑mile wooden pipeline brought water from the Sierra Blanca mountains.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Pastura%2C_New_Mexico",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "When diesel locomotives replaced steam engines in the 1940s, Pastura lost its role as a watering stop and the town began to shrink.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Pastura%2C_New_Mexico",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The town slipped into decline after Route 66 bypassed it, sending traffic 20 miles north and leaving Pastura isolated.",
      "sourceSentenceIds": [
        13
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Pastura%2C_New_Mexico",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Pastura remains a small farming community today, surrounded by open fields and ranches that echo its agricultural roots.",
      "sourceSentenceIds": [
        14
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Pastura%2C_New_Mexico",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The Chicano author Rudolfo Anaya was born in Pastura in 1937, adding literary heritage to the town’s history.",
      "sourceSentenceIds": [
        11
      ],
