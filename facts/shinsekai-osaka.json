  "facts": [
    {
      "id": 1,
      "text": "Shinsekai was created in 1912, modeled after New York's Coney Island and Paris.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Shinsekai"
    },
    {
      "id": 2,
      "text": "The original Tsutenkaku Tower, finished 1912, was 64m tall and resembled Eiffel Tower and Arc de Triomphe.",
      "sourceSentenceIds": [
        28
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Shinsekai"
    },
    {
      "id": 3,
      "text": "After a wartime fire, the tower was rebuilt in 1956, now 103m tall and designed by Tachū Naitō.",
      "sourceSentenceIds": [
        29
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Shinsekai"
    },
    {
      "id": 4,
      "text": "Shinsekai's 500‑meter arcade hosts traditional game centers, bars, and kushi‑katsu eateries.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://jw-webmagazine.com/tips/shinsekai-guide/"
    },
    {
      "id": 5,
      "text": "Every Monday, enka singers perform underground at Tsutenkaku Tower Theater; Saturdays and Sundays feature manzai and rakugo.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://osaka-info.jp/en/spot/shinsekai/"
    },
    {
      "id": 6,
      "text": "From Tsutenkaku's top, drivers can see Osaka's skyline, including Tennoji Zoo and Spa World below.",
      "sourceSentenceIds": [
        27
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
