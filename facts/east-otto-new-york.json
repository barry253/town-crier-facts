  "facts": [
    {
      "id": 1,
      "text": "East Otto was carved out of the eastern half of Otto in 1854, making it one of Cattaraugus County’s last towns to be formed.",
      "sourceSentenceIds": [
        5,
        12,
        13
      ],
      "sourceLabels": [
        "Web source 1",
        "Wikipedia"
      ],
      "source": "https://historicpath.com/history/east-otto",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town’s name honors Jacob Otto, an agent of the Holland Land Company who helped settle the region.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/East_Otto%2C_New_York",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The 1920 East Otto Union School now serves as the town hall and is listed on the National Register of Historic Places.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/East_Otto%2C_New_York",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Plato, a small hamlet in the southeast corner of East Otto, opened its post office in 1832.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://historicpath.com/history/east-otto",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "County Roads 12, 14, and 75 all meet at the hamlet of East Otto, making it a local crossroads.",
