      ],
      "source": "https://en.wikipedia.org/wiki/California_City%2C_California",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "A former WWII bombing range, the Mojave Gunnery Range “C”, now part of the city, still contains unexploded ordnance and toxic waste.",
      "sourceSentenceIds": [
        10,
        12
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/California_City%2C_California",
      "category": "other",
      "quality": "poor",
      "qualityReason": "editorial_filler"
    },
    {
      "id": 5,
      "text": "California City’s workforce is heavily tied to nearby Edwards Air Force Base, located 18 miles southeast.",
      "sourceSentenceIds": [
        6
