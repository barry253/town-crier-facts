      ],
      "source": "https://en.wikipedia.org/wiki/California_City%2C_California",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "It covers 203.63 sq mi, making it California's third-largest city by land area and the largest non‑county‑seat city.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Wikipedia"
