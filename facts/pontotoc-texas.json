  "facts": [
    {
      "id": 1,
      "text": "Pontotoc was founded in 1878 by Robert Kidd, who named it after his hometown in Mississippi.",
      "sourceSentenceIds": [
        7,
        8
      ],
      "sourceLabels": [
        "Web source 2",
        "Wikipedia"
      ],
      "source": "https://unitedstatesghosttowns.com/pontotoc-texas-ghost-town/",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town once hosted the San Fernando Academy, established in 1882, which trained teachers before closing in 1890.",
      "sourceSentenceIds": [
        1,
        3
      ],
      "sourceLabels": [
        "Web source 2",
        "Web source 2"
      ],
      "source": "https://unitedstatesghosttowns.com/pontotoc-texas-ghost-town/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Three railroad proposals missed Pontotoc by a few miles, leaving the town isolated and leading to its decline.",
      "sourceSentenceIds": [
        12,
        11
      ],
      "sourceLabels": [
        "Web source 1",
        "Wikipedia"
      ],
      "source": "https://www.tshaonline.org/handbook/entries/pontotoc-tx",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Pontotoc’s early economy relied on cotton and pecan farming, making it a thriving agricultural community before becoming largely deserted.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://unitedstatesghosttowns.com/pontotoc-texas-ghost-town/",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "A historic sandstone building of the former San Fernando Academy still stands as a reminder of the town’s once prosperous frontier past.",
      "sourceSentenceIds": [
        25
      ],
