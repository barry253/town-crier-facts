      "quality": "good"
    },
    {
      "id": 2,
      "text": "The city officially became the county seat on January 27, 1886, after being dubbed North Yakima during its early incorporation.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Yakima%2C_Washington",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Yakima’s name comes from the Yakama Nation, whose reservation lies just south of the city, and the tribe were the first known inhabitants of the valley.",
      "sourceSentenceIds": [
        28,
        29
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Yakima%2C_Washington",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The former Yakima Valley Transportation Company tracks still run five miles of historic trolley line that connects Yakima and Selah during summer weekends.",
      "sourceSentenceIds": [
        11
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Yakima%2C_Washington",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Yakima Valley produces 77% of all hops in the United States, making the city a key hub for the national hop industry.",
