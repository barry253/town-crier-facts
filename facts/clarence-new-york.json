      ],
      "source": "https://www4.erie.gov/clarence/about-our-town",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The Eshelman and Company Store at 6000 Goodrich Road earned a spot on the National Register of Historic Places in 1982.",
      "sourceSentenceIds": [
