    },
    {
      "id": 2,
      "text": "The mall opened to the public on September 15, 2012, after a renovation that began in December 2010.",
      "sourceSentenceIds": [
        11,
        13
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Seacon_Bangkae"
    },
    {
      "id": 3,
      "text": "Seacon Bangkae spans five floors and covers 130,000 square meters, hosting over 300 retail stores.",
      "sourceSentenceIds": [
        15
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Seacon_Bangkae"
    },
    {
      "id": 4,
      "text": "Its wave‑shaped modern design was chosen to reflect contemporary architecture trends in Bangkok.",
      "sourceSentenceIds": [
        14
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Seacon_Bangkae"
    },
    {
      "id": 5,
      "text": "Bangkae is served by the Phasi Charoen MRT station on the Blue Line, linking it to central Bangkok.",
      "sourceSentenceIds": [
