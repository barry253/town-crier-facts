  "facts": [
    {
      "id": 1,
      "text": "Bourne was incorporated in 1884 and named after Jonathan Bourne, a local whale‑oil tycoon.",
      "sourceSentenceIds": [
        3,
        22
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.britannica.com/place/Bourne-Massachusetts"
    },
    {
      "id": 2,
      "text": "The Cape Cod Canal, opened in 1914, cuts through Bourne and makes the town the first Cape town with three bridges, including the unique vertical‑lift railroad bridge.",
      "sourceSentenceIds": [
        6,
        8
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Bourne%2C_Massachusetts"
    },
    {
      "id": 3,
      "text": "The Massachusetts Maritime Academy, founded in 1891, sits on Bourne’s southern canal shore and trains future maritime leaders.",
      "sourceSentenceIds": [
        26
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Bourne%2C_Massachusetts"
    },
    {
      "id": 4,
      "text": "Bourne Village, the historic heart, hosts the Aptucxet Trading Post, the oldest surviving trading post on Cape Cod.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.bourne-ma.gov/1192/About-Bourne"
    },
    {
      "id": 5,
      "text": "The town’s Jonathan Bourne Public Library, near the trading post, is part of the Cape Libraries Automated Materials Sharing network.",
      "sourceSentenceIds": [
        16
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Bourne%2C_Massachusetts"
    },
    {
      "id": 6,
      "text": "President Grover Cleveland spent summers at Gray Gables in Bourne Village, using it as the Summer White House from 1893 to 1896.",
