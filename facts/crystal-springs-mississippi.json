      "quality": "good"
    },
    {
      "id": 4,
      "text": "The town’s railroad expansion turned packing sheds into bustling hubs, fueling a hard‑working community that grew with the tracks.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Web source 1"
