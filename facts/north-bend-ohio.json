  "facts": [
    {
      "id": 1,
      "text": "North Bend was founded in 1789, making it one of Ohio’s oldest villages.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/North_Bend%2C_Ohio",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "After being platted as Symmes City, the village officially incorporated as North Bend in 1845.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/North_Bend%2C_Ohio",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The village’s name comes from the Ohio River’s northward bend right beside its banks.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/North_Bend%2C_Ohio",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "North Bend is the birthplace of Benjamin Harrison, the 23rd President of the United States.",
      "sourceSentenceIds": [
        13
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/North_Bend%2C_Ohio",
      "category": "people",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The William Henry Harrison Tomb State Memorial in North Bend houses the grave of the 9th U.S. President.",
      "sourceSentenceIds": [
        15
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/North_Bend%2C_Ohio",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "On May 5, 1865, North Bend witnessed one of the earliest railway train hold‑ups in American history.",
