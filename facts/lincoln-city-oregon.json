  "facts": [
    {
      "id": 1,
      "text": "Lincoln City was incorporated in 1965 by uniting the communities of Oceanlake, Taft, Cutler City, and Nelscott.",
      "sourceSentenceIds": [
        21
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Lincoln_City%2C_Oregon"
    },
    {
      "id": 2,
      "text": "Local school children chose the name Lincoln City through a contest to avoid controversy over which community name to use.",
      "sourceSentenceIds": [
        23,
        24
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Lincoln_City%2C_Oregon"
    },
    {
      "id": 3,
      "text": "Lincoln City is located on the Oregon Coast between Tillamook to the north and Newport to the south.",
      "sourceSentenceIds": [
        19
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Lincoln_City%2C_Oregon"
    },
    {
      "id": 4,
      "text": "The community of Cutler City is located on the east shore of Siletz Bay.",
      "sourceSentenceIds": [
        25
      ],
      "sourceLabels": [
