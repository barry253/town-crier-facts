  "facts": [
    {
      "id": 1,
      "text": "Carmel Valley Village sits on land once granted as Rancho Los Laureles, a 6,625‑acre Mexican estate awarded in 1839 by Governor Alvarado.",
      "sourceSentenceIds": [
        13,
        14
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Carmel_Valley_Village%2C_California",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "After World War II, the community expanded and adopted the name Carmel Valley Village, shifting its identity from an aviation hub to a residential enclave.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/Carmel_Valley_Village,_California",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "From the 1960s through the 1990s, the Jamesburg Earth Station in Carmel Valley transmitted Intelsat’s global communications network, even relaying Apollo 11’s first‑step video.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://carmelvalleyhistoricalsociety.org/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Indigenous peoples, including the Rumsen Ohlone and possibly the Esselen, have inhabited the lower Carmel River valley for at least 2,000 years.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/Carmel_Valley_Village,_California",
      "category": "people",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "In 1882, the Pacific Improvement Company bought Rancho Los Laureles to support regional development, diverting water for irrigation and expanding dairy production for Del Monte.",
      "sourceSentenceIds": [
        7,
        15
      ],
      "sourceLabels": [
        "Web source 1",
        "Wikipedia"
      ],
      "source": "https://grokipedia.com/page/Carmel_Valley_Village,_California",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The Carmel River snakes northwest through the village, eventually emptying into the Pacific at Carmel‑by‑the‑Sea, shaping the local landscape.",
      "sourceSentenceIds": [
        19
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
