  "facts": [
    {
      "id": 1,
      "text": "Lincoln Beach began as a beachfront settlement in the 1920s when developers platted the area as a summer resort.",
      "sourceSentenceIds": [
        28,
        29
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/lincoln_beach_oregon"
    },
    {
      "id": 2,
      "text": "The name Lincoln Beach was chosen descriptively because the community is located within Lincoln County.",
      "sourceSentenceIds": [
        29
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/lincoln_beach_oregon"
    },
    {
      "id": 3,
      "text": "Early settlement in Lincoln Beach followed the allotment of lands from the Siletz Indian Reservation under the Dawes Severalty Act of 1887.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/lincoln_beach_oregon"
    },
    {
      "id": 4,
      "text": "The arrival of the railroad in the early 20th century helped Lincoln Beach grow by facilitating the transport of timber.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.city-usa.top/state-oregon-city-lincoln-beach"
    },
    {
      "id": 5,
      "text": "Lincoln Beach transitioned from a fishing and logging outpost to a haven for retirees and vacationers starting in the 1980s.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/lincoln_beach_oregon"
    },
    {
      "id": 6,
      "text": "Lincoln Beach is an unincorporated coastal community bordered to the west by the Pacific Ocean.",
