    },
    {
      "id": 2,
      "text": "Jonathan H. Cheney laid out Ellsworth on December 6, 1871, carving a 40‑acre townsite.",
      "sourceSentenceIds": [
        17
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Ellsworth%2C_Illinois"
    },
    {
      "id": 3,
      "text": "A 200‑foot swath of railroad land split Ellsworth into two nearly equal halves.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Ellsworth%2C_Illinois"
    },
    {
      "id": 4,
      "text": "Early shops sprang up along Main Street south of the tracks, becoming the town’s commercial heart.",
      "sourceSentenceIds": [
        20
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Ellsworth%2C_Illinois"
    },
    {
      "id": 5,
      "text": "The original depot sat on the south side of the tracks, while the first grain elevator stood north.",
      "sourceSentenceIds": [
        21
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Ellsworth%2C_Illinois"
    },
    {
