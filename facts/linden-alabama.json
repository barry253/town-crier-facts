  "facts": [
    {
      "id": 1,
      "text": "Linden, Alabama, became Marengo County’s seat in 1819 after settlers first called the area Screamersville because wild animals could still be heard at night.",
      "sourceSentenceIds": [
        16,
        17
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Linden%2C_Alabama",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "In 1823 the town was renamed Hohenlinden to honor French Bonapartist refugees, later shortened simply to Linden.",
      "sourceSentenceIds": [
        18,
        19,
        20,
        21
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Linden%2C_Alabama",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The volunteer‑run City of Linden Historical Society, founded in 1975, operates a downtown museum that showcases artifacts telling the town’s story.",
      "sourceSentenceIds": [
        1,
        5,
        8
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://museumsdatabase.com/museums/view/236",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Its research library holds books, periodicals, maps, and photographs that chronicle Linden and neighboring Marengo and Choctaw counties.",
      "sourceSentenceIds": [
        4,
        14,
        15
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://museumsdatabase.com/museums/view/236",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Linden’s waterways drain north into Chickasaw Bogue, a tributary of the Tombigbee River, and south into Sycamore Creek.",
      "sourceSentenceIds": [
        24
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Linden%2C_Alabama",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Linden sits in the heart of Marengo County, Alabama, roughly midway between the county’s northern and southern borders.",
