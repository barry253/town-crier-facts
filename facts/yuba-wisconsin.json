  "facts": [
    {
      "id": 1,
      "text": "Yuba is the smallest incorporated municipality in Wisconsin, leading to the unofficial village slogan, \"Where the hell is Yuba?\".",
      "sourceSentenceIds": [
        13
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Yuba%2C_Wisconsin"
    },
    {
      "id": 2,
      "text": "The village of Yuba may have been named after a gold locality in California.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://legacy.wisconsinhistory.org/Records/Article/CS14697"
    },
    {
      "id": 3,
      "text": "Edward Pinick registered the plat for Yuba in 1855, but he moved to Kansas before the village was ever realized.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.badgerinstitute.org/where-the-hell-is-yuba/"
    },
    {
      "id": 4,
      "text": "Yuba is situated on a hill and in a valley within Richland County.",
      "sourceSentenceIds": [
        30
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.badgerinstitute.org/where-the-hell-is-yuba/"
    },
    {
      "id": 5,
      "text": "Bohemian settlers in Yuba historically celebrated Masopust, a pre-Lenten festival involving tuba bands and drinking pivo, the Czech word for beer.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.badgerinstitute.org/where-the-hell-is-yuba/"
    },
    {
      "id": 6,
      "text": "Some of the first Bohemians in Yuba established farms that have remained in the same family for over 160 years.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.badgerinstitute.org/where-the-hell-is-yuba/"
