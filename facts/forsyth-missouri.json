      "id": 1,
      "text": "Forsyth’s first courthouse rose where Swan Creek meets the White River, anchoring the town’s early civic life.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 1"
      ],
