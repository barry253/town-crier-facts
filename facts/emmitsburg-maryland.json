  "facts": [
    {
      "id": 1,
      "text": "Emmitsburg was founded in 1785 by William Emmit, a pioneer settler, and the town was originally called Silver Fancy before adopting its current name.",
      "sourceSentenceIds": [
        4,
        5
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Emmitsburg%2C_Maryland",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town sits just 0.3 miles south of the Mason-Dixon line, placing it right on the historic border between Maryland and Pennsylvania.",
      "sourceSentenceIds": [
        16
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Emmitsburg%2C_Maryland",
      "category": "other",
      "quality": "poor",
      "qualityReason": "location_description"
    },
    {
      "id": 3,
      "text": "Emmitsburg hosts Catholic pilgrimage sites: the National Shrine Grotto of Our Lady of Lourdes on Mount St. Mary's campus and the Basilica and National Shrine of St. Mary's.",
      "sourceSentenceIds": [
        17,
        18
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Emmitsburg%2C_Maryland",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The National Shrine of St. Mary's was home to Elizabeth Ann Seton, the first native-born U.S. citizen to be canonized, whose convent, school, and hospital began there.",
      "sourceSentenceIds": [
        19,
        28
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Emmitsburg%2C_Maryland",
      "category": "people",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "During the Civil War, Union forces fortified Emmitsburg to halt a Confederate invasion in June 1863, making the town a key defensive point.",
      "sourceSentenceIds": [
        30
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Emmitsburg%2C_Maryland",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The former Saint Joseph College campus now houses the National Emergency Training Center, including the Emergency Management Institute, National Fire Academy, and National Fallen Firefighters Memorial.",
      "sourceSentenceIds": [
        21,
        22
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
