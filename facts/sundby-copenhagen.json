  "facts": [
    {
      "id": 1,
      "text": "Sundbyvester and Sundbyøster were two villages first mentioned around 1100, forming the core of modern Sundby.",
      "sourceSentenceIds": [
        1,
        17
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Sundby%2C_Copenhagen",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "By the late 18th century, sailors, craftsmen and workers began settling along Amagerbrogade, turning the area from rural farmsteads into a bustling community.",
      "sourceSentenceIds": [
        9,
        18
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Sundby%2C_Copenhagen",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Jacob Holm, an early industrialist, built a smock mill, an oil‑press, a glue factory and a rope walk on both sides of Amagerbrogade between 1808 and 1812.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Sundby%2C_Copenhagen",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Sundby was part of the civil parish of Tårnby until 1793, when the northern section, Amagerbro, was transferred to Copenhagen under the city’s Demarcation Line.",
      "sourceSentenceIds": [
        10,
        11
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Sundby%2C_Copenhagen",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "In 1895 Sundby was finally separated from Tårnby, gaining independent civil parish status that lasted only seven years before reintegration.",
      "sourceSentenceIds": [
        13,
        14
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Sundby%2C_Copenhagen",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Today Sundby is a neighbourhood on Amager in Copenhagen, often called Sundbyerne to distinguish its western and eastern halves along Amagerbrogade.",
      "sourceSentenceIds": [
        6,
        7
      ],
      "sourceLabels": [
