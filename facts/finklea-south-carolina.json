  "facts": [
    {
      "id": 1,
      "text": "The Waccamaw Native American people originally inhabited the area encompassing modern-day Finklea in northern Horry County.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/finklea"
    },
    {
      "id": 2,
      "text": "Finklea likely takes its name from the Finklea family, who were early settlers in the adjacent Marion County.",
      "sourceSentenceIds": [
        14
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/finklea"
    },
    {
      "id": 3,
      "text": "Early settlers in Finklea focused on small-scale agriculture, particularly the cultivation of tobacco and cotton.",
      "sourceSentenceIds": [
        13,
        15
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/finklea"
    },
    {
      "id": 4,
      "text": "The arrival of the boll weevil around 1915 prompted Finklea farms to diversify into lumber and peanuts.",
      "sourceSentenceIds": [
        19
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/finklea"
    },
    {
      "id": 5,
      "text": "Horry Electric Cooperative extended electrification to northwest Horry County farms in 1946, improving living standards in Finklea.",
      "sourceSentenceIds": [
        23
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/finklea"
    },
    {
      "id": 6,
      "text": "Finklea features a humid subtropical climate with an average annual temperature of sixty-four degrees Fahrenheit.",
      "sourceSentenceIds": [
