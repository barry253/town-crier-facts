  "facts": [
    {
      "id": 1,
      "text": "Pikeville was founded in 1816 on land purchased from Charles Love, became Bledsoe County’s seat in 1818, and was incorporated in 1830.",
      "sourceSentenceIds": [
        25,
        26,
        27
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Pikeville%2C_Tennessee",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The Sequatchie Valley, where Pikeville lies, was Cherokee land until the 1805 Treaty of Tellico ceded it to the United States.",
      "sourceSentenceIds": [
        21,
        22
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Pikeville%2C_Tennessee",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Joy Vincent Wigle electrified Pikeville, ran an ironworks, and even bottled Coca‑Cola, giving the town early industrial flair.",
      "sourceSentenceIds": [
        2,
        3,
        4,
        7,
        18
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Pikeville%2C_Tennessee",
      "category": "people",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The historic John Bridgeman House in downtown Pikeville now serves as a community center, preserving a 19th‑century landmark.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Pikeville%2C_Tennessee",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "After the Louisville & Nashville Railroad reached Pikeville, the town became a vital terminal that opened doors for expanded trade.",
      "sourceSentenceIds": [
        12,
        13
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://pikevilletn.com/history/",
