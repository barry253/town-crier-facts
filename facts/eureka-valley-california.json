  "facts": [
    {
      "id": 1,
      "text": "Founded 1850 during the Gold Rush, Eureka has 26,000 residents and attracts over 500,000 visitors each year.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.offbeatpathfinder.com/destinations/eureka-california/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Dubbed the Victorian Seaport, Eureka boasts the West Coast's largest collection of preserved 19th‑century architecture, highlighted by the Carson Mansion.",
      "sourceSentenceIds": [
        15
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.offbeatpathfinder.com/destinations/eureka-california/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The Carson Mansion, built in 1886, features turrets and gables that make it one of America's most photographed Victorian homes.",
      "sourceSentenceIds": [
        20
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.offbeatpathfinder.com/destinations/eureka-california/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Fort Humboldt State Historic Park preserves an 1850s military outpost, offering logging exhibits and sweeping views of Humboldt Bay.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.offbeatpathfinder.com/destinations/eureka-california/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Eureka lies near the Cascadia Subduction Zone; its 1992 7.2‑magnitude quake rattled Victorian homes that still stand today.",
      "sourceSentenceIds": [
        28
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.offbeatpathfinder.com/destinations/eureka-california/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Old Town Eureka spans 350 historic buildings, its cobblestone streets lined with 1880s storefronts, galleries, and seafood restaurants.",
      "sourceSentenceIds": [
        22
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.offbeatpathfinder.com/destinations/eureka-california/",
