  "facts": [
    {
      "id": 1,
      "text": "Oroville began as Ophir City, renamed in 1854 when the first post office opened, and its name means 'gold' in Spanish.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Oroville%2C_California",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "In 1968 Lake Oroville flooded the town, but the Bidwell Bar Bridge—California’s first suspension bridge—still stands today.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Oroville%2C_California",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The Pioneer History Museum, modeled after a 49er cabin, showcases Oroville’s Gold Rush and Native American heritage.",
      "sourceSentenceIds": [
        19
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.visitcalifornia.com/places-to-visit/oroville/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The Visitor Center at Lake Oroville features exhibits on Ishi and the State Water Project, offering a deep dive into local history.",
      "sourceSentenceIds": [
        15,
        21
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Oroville%2C_California",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The Western Pacific Railroad’s Feather River Route, known as “The Feather River Route,” once chugged through Oroville, linking the Sierra Nevada to the coast.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Oroville%2C_California",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The Chinese Temple and Museum Complex, established in 1863, remains a religious center adorned with Far Eastern tapestries and costumes.",
