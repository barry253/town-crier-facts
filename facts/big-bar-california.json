      "quality": "good"
    },
    {
      "id": 3,
      "text": "Mining began in 1848 when a bridge crossed the Mokelumne River; a quartz vein yielded eight pounds of gold in 1850.",
      "sourceSentenceIds": [
        9,
        10
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.calaverashistory.org/big-bar",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Gold Rush travelers used a unique “whale boat” ferry along the steep Miwok Trail from Mokelumne Hill to Big Bar.",
      "sourceSentenceIds": [
        6,
        10
      ],
      "sourceLabels": [
        "Web source 2",
        "Web source 1"
      ],
      "source": "https://kids.kiddle.co/Big_Bar,_Calaveras_County,_California",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "In 1855 the Kelton family homesteaded on the Calaveras side, offering a watering trough for miners and ranchers.",
