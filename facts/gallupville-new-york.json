  "facts": [
    {
      "id": 1,
      "text": "Gallupville sits at the crossroads of NY‑146 and NY‑443, the southwestern corner of the Town of Wright.",
      "sourceSentenceIds": [
        30
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Wright%2C_New_York"
    },
    {
      "id": 2,
      "text": "The town’s name honors New York Governor Silas Wright, a prominent 19th‑century statesman.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Wright%2C_New_York"
    },
    {
      "id": 3,
      "text": "In 1735 the Jacob Becker family settled here, and their stone house, built in 1772, still stands today.",
      "sourceSentenceIds": [
        17,
        18
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Wright%2C_New_York"
    },
    {
      "id": 4,
      "text": "During the Revolutionary War, a house in Gallupville withstood a July 26, 1782 attack by Tories and Native Americans.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Wright%2C_New_York"
    },
    {
      "id": 5,
      "text": "Three historic churches—Evangelical Lutheran, Methodist, and the Gallupville House—are listed on the National Register of Historic Places.",
      "sourceSentenceIds": [
