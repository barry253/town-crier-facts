  "facts": [
    {
      "id": 1,
      "text": "Shawnee Mission takes its name from the Shawnee Methodist Mission, founded in 1830 by the Methodist church.",
      "sourceSentenceIds": [
        1,
        19
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Shawnee_Mission%2C_Kansas",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The 12‑acre campus is a National Historic Landmark where the mission served as a school, legislative chamber, and military encampment over 185 years.",
      "sourceSentenceIds": [
        5,
        6,
        7
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://shawneeindianmission.org/visit/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The mission’s East Building, opened in 1839, was the first manual‑training school for boys and girls from Shawnee, Delaware, and other Indian nations.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.kansashistory.gov/shawnee_indian",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The mission’s grounds feature the largest expanse of greenspace in northeast Johnson County, with native and demonstration gardens.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://shawneeindianmission.org/visit/",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Visitors can walk the grounds year‑round, with free parking on the east side of the main building.",
