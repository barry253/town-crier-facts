    {
      "id": 1,
      "text": "Nahma was founded in 1881 by the Bay De Noquet Lumber Company as a base for upper Michigan lumbering operations.",
      "sourceSentenceIds": [
        14
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Nahma_Township%2C_Michigan",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The township’s name comes from Ojibway word “Nami,” meaning sturgeon, reflecting the area's rich fishing heritage.",
      "sourceSentenceIds": [
        15
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Nahma_Township%2C_Michigan",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "A historic sawmill once logged the surrounding forests, employing over 1,200 workers, before the timber ran out and the town was sold in 1951.",
      "sourceSentenceIds": [
        28,
        29
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Nahma_Township%2C_Michigan",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Peninsula Point Lighthouse sits on the tip of Lake Michigan, offering a classic Upper Peninsula landmark.",
