      "id": 1,
      "text": "Little Browning sits 3 miles southeast of Browning, on the Blackfeet Reservation at 48°37′31″N 112°21′00″W.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/little_browning_montana"
    },
    {
      "id": 2,
      "text": "Early 1800s fur traders set up posts like Fort McKenzie near the Missouri and Teton Rivers, marking peaceful exchanges with the Blackfeet.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/little_browning_montana"
    },
    {
      "id": 3,
      "text": "Annual precipitation averages 15 inches, mostly summer rain from May to July and snow from November to March.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/little_browning_montana"
    },
    {
      "id": 4,
      "text": "Chinook winds can raise temperatures by 40°F in hours, melting snow and ending deep winter cold.",
      "sourceSentenceIds": [
        19
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/little_browning_montana"
    },
    {
      "id": 5,
      "text": "The Blackfeet Reservation, including Little Browning, holds significant oil and gas resources, boosting tribal economic opportunities.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/little_browning_montana"
    },
