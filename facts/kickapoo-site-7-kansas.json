      "quality": "good"
    },
    {
      "id": 4,
      "text": "In 1854, settlers from Missouri founded a pro‑slavery town on 309 acres of former Kickapoo reservation land, sparking “Bleeding Kansas” tensions.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Web source 2"
