  "facts": [
    {
      "id": 1,
      "text": "Marshfield was platted May 22 1857 and named after Marshfield, Massachusetts, the home of statesman Daniel Webster.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Marshfield%2C_Indiana"
    },
    {
      "id": 2,
      "text": "The town sprang up as a railroad stop on the Wabash Railroad, becoming a bustling hub where five major railroads once converged.",
      "sourceSentenceIds": [
        13,
        16
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://unitedstatesghosttowns.com/marshfield-indiana-ghost-town/"
    },
    {
      "id": 3,
      "text": "At its peak in 1903, Marshfield handled 38 daily passenger trains, second only to Milwaukee in the region.",
      "sourceSentenceIds": [
        20
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://unitedstatesghosttowns.com/marshfield-indiana-ghost-town/"
    },
    {
      "id": 4,
      "text": "A grain elevator remains today, the only surviving structure that once served the town’s thriving grain warehouse.",
      "sourceSentenceIds": [
        15
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://unitedstatesghosttowns.com/marshfield-indiana-ghost-town/"
    },
    {
      "id": 5,
      "text": "A post office operated from April 6 1857 until 1989, marking over a century of postal service in the community.",
