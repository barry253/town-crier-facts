    {
      "id": 1,
      "text": "Interlochen sits between two lakes originally named Wahbekaness and Wahbekanetta, now Duck Lake and Green Lake.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
