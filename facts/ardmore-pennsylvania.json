      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "In 1899 the Autocar Company moved its headquarters to Ardmore, building a factory that later burned in 1956 during demolition.",
      "sourceSentenceIds": [
        6,
