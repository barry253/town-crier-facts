  "facts": [
    {
      "id": 1,
      "text": "Pittsfield grew from a frontier hunting site into a mill town when the Penobscot and Kennebec Railroad arrived in 1855.",
      "sourceSentenceIds": [
        7,
        15
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 2"
      ],
      "source": "https://en.wikipedia.org/wiki/Pittsfield%2C_Maine",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town’s first mills sprang up along the Sebasticook River, setting the stage for its later woodworking and canning industries.",
      "sourceSentenceIds": [
        5,
        15
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 2"
      ],
      "source": "https://en.wikipedia.org/wiki/Pittsfield%2C_Maine",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "In the 1940s, the Waverly mill was repurposed into a shoe factory, and a decade later the Pioneer mill began making doorbells.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Pittsfield%2C_Maine",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The Pittsfield Historical Society, founded in 1983, collects artifacts, photographs, and diaries to preserve the town’s layered history.",
