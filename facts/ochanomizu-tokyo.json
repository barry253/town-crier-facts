  "facts": [
    {
      "id": 1,
      "text": "Ochanomizu means \"tea water\" because the area supplied water for the shogun's tea ceremonies during the Edo period.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.japan-experience.com/all-about-japan/tokyo/attractions-excursions/ochanomizu"
    },
    {
      "id": 2,
      "text": "The main street beside Ochanomizu Station is nicknamed \"Guitar Street,\" lined with dozens of shops for musicians of every level.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.japan-experience.com/all-about-japan/tokyo/attractions-excursions/ochanomizu"
    },
    {
      "id": 3,
      "text": "Ochanomizu Station opened on 31 December 1904 and today serves both JR East and the Tokyo Metro Marunouchi Line.",
      "sourceSentenceIds": [
        22,
        19
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Ochanomizu_Station"
    },
    {
      "id": 4,
      "text": "The Japan Football Museum, located near Ochanomizu, showcases the history and achievements of Japanese soccer.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.japan-experience.com/all-about-japan/tokyo/attractions-excursions/ochanomizu"
    },
    {
      "id": 5,
      "text": "Kanda Myojin Shrine, just north of Ochanomizu, dates back nearly 1,300 years and hosts the annual Kanda Matsuri festival.",
      "sourceSentenceIds": [
        15
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.japan365days.com/tokyo_ochanomizu.php"
    },
    {
      "id": 6,
      "text": "Ochanomizu is home to Tokyo Medical and Dental University, a leading medical research institution founded during the Edo period.",
      "sourceSentenceIds": [
