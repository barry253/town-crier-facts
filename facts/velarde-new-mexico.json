  "facts": [
    {
      "id": 1,
      "text": "Velarde was founded in 1750 by Juan Matias Velarde, who named it La Joya after his ancestor.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Velarde%2C_New_Mexico",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town sits at the mouth of the Rio Grande canyon along the Low Road to Taos, serving as a resting spot for travelers heading north.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Velarde%2C_New_Mexico",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Velarde's landscape features a basin with hummocky topography from Quaternary landslides, and the Rio Grande flows through exposing Miocene Tesuque Formation units.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/velarde_new_mexico",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Velarde gained early prominence for its finely woven blankets and its position along the historic Camino Real de Tierra Adentro, a major trade route.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/velarde_new_mexico",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "During the Taos Revolt, Velarde was part of the scene of the Battle of Embudo Pass on January 29, 1847.",
      "sourceSentenceIds": [
        17
      ],
