    },
    {
      "id": 3,
      "text": "Stillwater State Forest, headquartered in Olney, holds the distinction of being Montana’s first state forest.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.visitmt.com/cities-towns/olney"
    },
    {
      "id": 4,
      "text": "Construction of the Stillwater Ranger Station began in 1922, and some of its original 1920s buildings remain visible today.",
