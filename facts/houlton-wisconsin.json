  "facts": [
    {
      "id": 1,
      "text": "Thomas Haggerty named Houlton in 1872 after his hometown of Houlton, Maine, when he established a general store here.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/houlton_wisconsin"
    },
    {
      "id": 2,
      "text": "Houlton serves as the eastern endpoint of the historic Stillwater Lift Bridge, which was completed in 1931.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/houlton_wisconsin"
    },
    {
      "id": 3,
      "text": "Houlton lies within the Saint Croix National Scenic Riverway, a federally protected area managed by the National Park Service.",
      "sourceSentenceIds": [
        11,
        20
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/houlton_wisconsin"
    },
    {
      "id": 4,
      "text": "The landscape around Houlton was shaped by the Pleistocene epoch, featuring glacial formations like drumlins and eskers.",
      "sourceSentenceIds": [
        25
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/houlton_wisconsin"
    },
    {
      "id": 5,
      "text": "Houlton's environment supports over 700 plant species, including deciduous forests of oak, maple, and basswood trees.",
      "sourceSentenceIds": [
        26
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/houlton_wisconsin"
    },
    {
      "id": 6,
      "text": "The first bridge connecting Houlton to Stillwater was a wooden toll structure built in 1876 to facilitate trade.",
      "sourceSentenceIds": [
