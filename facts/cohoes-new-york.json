  "facts": [
    {
      "id": 1,
      "text": "Cohoes earned the nickname “Spindle City” because 19th‑century textile mills powered by the falls made it a textile hub.",
      "sourceSentenceIds": [
        24
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Cohoes%2C_New_York",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "In 1836 the Harmony Manufacturing Company, later known as Harmony Mills, began operations, cementing Cohoes’ textile legacy.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Cohoes%2C_New_York",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The historic Cohoes Falls, a 65‑foot waterfall, was first noted by indigenous peoples and later became the city’s most famous landmark.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Cohoes%2C_New_York",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The Delaware and Hudson Railroad’s Laurentian train stopped in Cohoes until the mid‑1950s, linking the city to Montreal.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Cohoes%2C_New_York",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "A 2020 redesign of Canal Square Park turned the historic downtown space into a venue for farmers’ markets and outdoor concerts.",
      "sourceSentenceIds": [
