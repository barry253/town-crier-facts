  "facts": [
    {
      "id": 1,
      "text": "Perry takes its name from Commodore Oliver Hazard Perry, the famed naval hero of the War of 1812.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Perry%2C_New_York"
    },
    {
      "id": 2,
      "text": "The town proudly calls itself the home of the Silver Lake Sea Serpent, a legendary creature first sighted in 1855.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Perry%2C_New_York"
    },
    {
      "id": 3,
      "text": "In 2016, Silver Lake even installed an artificial serpent to keep the myth alive for visitors and locals alike.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Perry%2C_New_York"
    },
    {
      "id": 4,
      "text": "Perry was officially founded in 1814, carved out of the Town of Leicester as part of Wyoming County’s early expansion.",
      "sourceSentenceIds": [
        13
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Perry%2C_New_York"
    },
    {
      "id": 5,
      "text": "In 2017, the Village joined Tree City USA, committing to sustainable forestry and community stewardship.",
      "sourceSentenceIds": [
