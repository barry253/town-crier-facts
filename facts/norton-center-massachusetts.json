  "facts": [
    {
      "id": 1,
      "text": "Norton Center was incorporated on June 12, 1711, and named after Norton in Oxfordshire, England, reflecting its historic ties to Taunton.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/norton_center_historic_district",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The Norton Center Historic District, covering about 50 acres around the town common, was listed on the National Register of Historic Places in 1977.",
      "sourceSentenceIds": [
        22
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/norton_center_historic_district",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The town common’s triangular shape anchors the district, with open lawns and pathways that encourage pedestrian flow among historic buildings.",
      "sourceSentenceIds": [
        27
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/norton_center_historic_district",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Wheaton College’s campus extends into the historic district, adding educational heritage to the area’s architectural timeline from 1700 to 1924.",
      "sourceSentenceIds": [
        22
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/norton_center_historic_district",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The district’s terrain rises gently, never exceeding 200 feet above sea level, giving it a pastoral and cohesive visual character.",
      "sourceSentenceIds": [
        26
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/norton_center_historic_district",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "A complex five‑way intersection of Mansfield Street, Taunton Street, and Route 140 defines the core of Norton Center’s historic layout.",
      "sourceSentenceIds": [
