      "id": 1,
      "text": "Jefferson was founded in 1799 when a special commission purchased 50 acres for $100 to establish the county seat.",
      "sourceSentenceIds": [
        2,
        6
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
