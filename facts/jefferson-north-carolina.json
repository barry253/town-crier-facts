      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town’s name honors Thomas Jefferson, making it one of the first U.S. towns named after the future president.",
      "sourceSentenceIds": [
        4,
        19
      ],
      "sourceLabels": [
        "Web source 1",
