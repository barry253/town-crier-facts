      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The Ashe County Courthouse, completed in 1904, sits beside the historic Adam Roberts house on Long Street, both listed on the National Register of Historic Places.",
      "sourceSentenceIds": [
        13,
        14,
        5
      ],
      "sourceLabels": [
