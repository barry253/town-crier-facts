  "facts": [
    {
      "id": 1,
      "text": "Thornhill was founded in 1794, originally called Thorne's Mills after Benjamin Thorne’s mills on Yonge Street.",
      "sourceSentenceIds": [
        9,
        27,
        28
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Thornhill%2C_Ontario",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The Thornhill Historical Society, founded in 1974, preserves the town’s heritage through plaques, archives, and guided walking tours.",
      "sourceSentenceIds": [
        5,
        6,
        13
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.thornhillhistoric.org/",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Andrew Wiggins, the NBA star for the Golden State Warriors, grew up in Thornhill and still visits the local community centre.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Thornhill%2C_Ontario",
      "category": "people",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The Thornhill Skating Club, housed in the community centre’s double arena, has produced several national figure skating champions.",
      "sourceSentenceIds": [
        20
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Thornhill%2C_Ontario",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Thornhill’s eastern side lies within the City of Markham while the western side is in Vaughan, with Yonge Street as the boundary.",
