  "facts": [
    {
      "id": 1,
      "text": "Mabton’s name comes from Mabel Baker Anderson, a woman who once rode a train through the area, inspiring the depot’s original name.",
      "sourceSentenceIds": [
        1,
        2
      ],
      "sourceLabels": [
        "Web source 1",
        "Wikipedia"
      ],
      "source": "https://www.historylink.org/File/10419",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "In 1912 the Northern Pacific Railroad finally moved Mabton’s depot closer to downtown after years of local petitions.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.historylink.org/File/10419",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "A devastating fire in November 1905 nearly destroyed Mabton, prompting a rapid rebuilding effort that reshaped the town.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.historylink.org/File/10419",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "By 1912 irrigation had reached south of the tracks, turning the area into a leading alfalfa hay producer.",
      "sourceSentenceIds": [
        13
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.historylink.org/File/10419",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "After World War II, Mabton welcomed a wave of Latino farm workers who helped sustain its agricultural economy.",
