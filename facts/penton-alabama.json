  "facts": [
    {
      "id": 1,
      "text": "Penton was incorporated in 1858 and its name honors a railroad official or a prominent local family, though the exact origin remains local lore.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.wikixm.com/us/al/penton/overview",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Today, Penton is known primarily as a quiet, rural crossroads community rooted in the agricultural and timber heritage of the region.",
      "sourceSentenceIds": [
        29
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.wikixm.com/us/al/penton/overview",
      "category": "other",
      "quality": "poor",
      "qualityReason": "editorial_filler"
    },
    {
      "id": 3,
      "text": "Penton’s formal history began with the arrival of white settlers in the early 1830s, drawn by the fertile soils of the Piedmont region.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.wikixm.com/us/al/penton/overview",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "While Penton does not have a significant tourism industry, its reputation is that of a friendly, hardworking community that values its history and traditions.",
      "sourceSentenceIds": [
