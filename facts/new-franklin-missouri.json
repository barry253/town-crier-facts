      "quality": "good"
    },
    {
      "id": 2,
      "text": "The historic Santa Fe Trail ends at New Franklin, marking the eastern terminus of the 19th‑century trade route.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
