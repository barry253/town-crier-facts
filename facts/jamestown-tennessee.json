  "facts": [
    {
      "id": 1,
      "text": "Jamestown was founded in 1823 as the county seat of Fentress County, named after state legislator James Fentress.",
      "sourceSentenceIds": [
        1,
        5,
        11
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Jamestown%2C_Tennessee",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The city lies on the western edge of the Cumberland Plateau, with eastern streams feeding the Big South Fork and western streams draining into the Obey River.",
      "sourceSentenceIds": [
        27,
        28
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Jamestown%2C_Tennessee",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "A single historic spring remains in Mark Twain City Park, northeast of the courthouse, once supplying water to John M. Clemens, father of Mark Twain.",
      "sourceSentenceIds": [
        2,
        15,
        16,
        18
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://jamestowntn.gov/visitors",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "During the Civil War, Fentress County supplied both Confederate and Union companies, though they rarely saw combat.",
      "sourceSentenceIds": [
        20,
        21,
        22
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Jamestown%2C_Tennessee",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Jamestown’s radio heritage includes stations WCLC‑FM 105.1, WDEB 1500 AM, WDEB‑FM 103.9, and low‑power WSAB‑LP 92.5.",
      "sourceSentenceIds": [
        6,
        7
      ],
      "sourceLabels": [
