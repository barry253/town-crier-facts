  "facts": [
    {
      "id": 1,
      "text": "Garden City was created in 1939 as Industrial City Gardens to house the workforce for new factories and chemical plants just west of downtown Savannah.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Garden_City%2C_Georgia",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The city hosts the largest and busiest ocean terminal of the Port of Savannah, the flagship operation of the Georgia Ports Authority.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Garden_City%2C_Georgia",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Garden City blends industry and residence, with heavy manufacturing and logistics coexisting in a compact urban setting.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Garden_City%2C_Georgia",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Its waterfront is lined with industrial facilities, a pattern common to surrounding coastal communities.",
      "sourceSentenceIds": [
        25
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Garden_City%2C_Georgia",
      "category": "other",
      "quality": "poor",
      "qualityReason": "other"
    },
    {
      "id": 5,
      "text": "Numerous trucking and railway companies call Garden City home, making it a key node for freight movement.",
      "sourceSentenceIds": [
        26
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Garden_City%2C_Georgia",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The Georgia Department of Corrections operates the Coastal State Prison near Garden City, a notable correctional facility in the area.",
