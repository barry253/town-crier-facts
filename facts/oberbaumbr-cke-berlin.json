  "facts": [
    {
      "id": 1,
      "text": "Oberbaumbrücke, a double‑deck bridge over the Spree, links Friedrichshain and Kreuzberg and symbolizes Berlin’s reunification.",
      "sourceSentenceIds": [
        2,
        9
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Oberbaum_Bridge"
    },
    {
      "id": 2,
      "text": "The upper deck carries U‑bahn lines U1 and U3 between Schlesisches Tor and Warschauer Straße stations.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Oberbaum_Bridge"
    },
    {
      "id": 3,
      "text": "Before its stone façade, a wooden drawbridge served as a gate to the city, blocking the river at night to stop smuggling.",
      "sourceSentenceIds": [
        3,
        12,
        13
      ],
      "sourceLabels": [
        "Web source 2",
        "Wikipedia"
      ],
      "source": "https://www.berlin.de/en/attractions-and-sights/3559975-3104052-oberbaum-bridge.en.html"
    },
    {
      "id": 4,
      "text": "The bridge’s two towers echo the Middle Gate Tower in Prenzlau and were added purely for decorative remembrance of Berlin’s river gateway.",
      "sourceSentenceIds": [
        21,
        22
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Oberbaum_Bridge"
    },
    {
      "id": 5,
      "text": "In 1945 the Wehrmacht blew up the middle section to halt the Red Army, but the bridge was later rebuilt and now spans the Spree again.",
      "sourceSentenceIds": [
        27,
        28,
        29
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Oberbaum_Bridge"
    },
    {
      "id": 6,
      "text": "Oberbaumbrücke has appeared in films like Run Lola Run and Unknown, and the TV series Berlin Station, making it a familiar cinematic backdrop.",
      "sourceSentenceIds": [
