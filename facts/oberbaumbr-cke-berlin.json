  "facts": [
    {
      "id": 1,
      "text": "Oberbaumbrücke links Friedrichshain and Kreuzberg, former boroughs split by the Berlin Wall, becoming a symbol of reunification.",
      "sourceSentenceIds": [
        13
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Oberbaum_Bridge"
    },
    {
      "id": 2,
      "text": "The bridge's red brick towers echo the Middle Gate Tower of Prenzlau and were added for decorative purposes, reminding of Berlin's old river gateway.",
      "sourceSentenceIds": [
        25,
        26
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Oberbaum_Bridge"
    },
    {
      "id": 3,
      "text": "In 1896, the new stone bridge opened for the Berlin Trades Exhibition, designed by Otto Stahn in North German Brick Gothic style.",
      "sourceSentenceIds": [
        23,
        24
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Oberbaum_Bridge"
    },
    {
      "id": 4,
      "text": "The upper deck carries U-Bahn lines U1 and U3, connecting Schlesisches Tor to Warschauer Straße, a key transit link.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Oberbaum_Bridge"
    },
    {
      "id": 5,
      "text": "Customs duties were once collected on the bridge where armed border guards stood, now replaced by street musicians and tourists.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://notouristinfo.com/en/blogs/berlin-story/oberbaumbruecke"
    },
    {
      "id": 6,
      "text": "The name Oberbaumbrücke comes from a heavy tree trunk used as a boom to block the Spree at night, preventing smuggling.",
      "sourceSentenceIds": [
        17,
        18
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Oberbaum_Bridge"
    }
  ]
