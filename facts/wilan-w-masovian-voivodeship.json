  "facts": [
    {
      "id": 1,
      "text": "Wilanów Palace, dubbed the Polish Versailles, was erected for King Jan III Sobieski and still showcases stunning baroque architecture.",
      "sourceSentenceIds": [
        7,
        21
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Wilan%C3%B3w",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The first record of Wilanów dates back to the 13th century when Benedictine monks of Płock founded the village of Milanów.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Wilan%C3%B3w",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "In 1805, Stanisław Kostka Potocki opened one of Poland’s earliest public museums inside Wilanów Palace.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://okeask.com/en/category/useful-info/1689681864-history-of-wilanowa",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Giovanni Spazzio designed the palace’s lateral wings between 1720 and 1728, expanding its elegant façade.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://okeask.com/en/category/useful-info/1689681864-history-of-wilanowa",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "A horse‑drawn railway opened in 1890 to ferry grain and passengers between Wilanów and Warsaw.",
      "sourceSentenceIds": [
        26
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Wilan%C3%B3w",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Steam trains began running on the Wilanów‑Warsaw line in 1892, marking a new era of rapid travel.",
      "sourceSentenceIds": [
        27
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Wilan%C3%B3w",
