  "facts": [
    {
      "id": 1,
      "text": "Santaquin was named after the son of local Native American chief Guffich, who declined the honor for his own family.",
      "sourceSentenceIds": [
        2,
        3,
        4
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1",
        "Web source 2"
      ],
      "source": "https://en.wikipedia.org/wiki/Santaquin%2C_Utah",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Before its renaming, the settlement was called Summit City because it sits on the high divide between Utah Valley and Juab Valley.",
      "sourceSentenceIds": [
        1,
        7,
        8
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1",
        "Web source 2"
      ],
      "source": "https://en.wikipedia.org/wiki/Santaquin%2C_Utah",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Pioneers who helped settle nearby Payson founded Santaquin in late 1851, marking it as one of the earliest stops along the historic Salt Lake Road.",
      "sourceSentenceIds": [
        5,
        7,
        8
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1",
        "Web source 2"
      ],
      "source": "https://en.wikipedia.org/wiki/Santaquin%2C_Utah",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Horse and buggy ruled until 1875, when the Utah Southern Railroad finally linked Santaquin to the wider rail network.",
      "sourceSentenceIds": [
        10,
        13
      ],
      "sourceLabels": [
        "Web source 1",
        "Web source 2"
      ],
      "source": "https://www.santaquin.gov/community/page/history",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "From its hilltop perch, Santaquin offers sweeping views of Utah Lake and the distant peaks of Mount Timpanogos.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.santaquin.gov/community/page/history",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Santaquin transitioned from a town to a city on January 4, 1932, after decades of growth in the Utah–Juab county area.",
      "sourceSentenceIds": [
        24
      ],
      "sourceLabels": [
