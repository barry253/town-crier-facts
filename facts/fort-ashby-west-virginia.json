    {
      "id": 2,
      "text": "George Washington ordered the construction of Fort Ashby in 1755 to protect settlers during the French and Indian War.",
      "sourceSentenceIds": [
        12,
        15
      ],
      "sourceLabels": [
        "Web source 1"
      ],
