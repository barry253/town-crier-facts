  "facts": [
    {
      "id": 1,
      "text": "Madison Park takes its name from the city park that sits at the foot of Madison Street along Lake Washington’s shore.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Madison_Park%2C_Seattle",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The neighborhood’s Pioneer Hall, also called Washington Pioneer Hall, earned a spot on the National Register of Historic Places in 1970.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Madison_Park%2C_Seattle",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Judge John J. McGilvra transformed the lakeside area in the 1860s, building a boathouse, piers, a wooden promenade, and twin bandstands for crowds of a thousand.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.postalley.org/2025/08/03/madison-park-home-of-seattles-first-pro-baseball-champs/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Seattle’s first ballpark opened in 1890 along Madison Street, marking the start of the city’s professional baseball history.",
      "sourceSentenceIds": [
        24
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Madison_Park%2C_Seattle",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "In the early 1900s, Madison Park became a favored summer escape for Seattleites, reachable by cable car and Eastside ferries.",
      "sourceSentenceIds": [
        25
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Madison_Park%2C_Seattle",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The neighborhood stretches from Lake Washington on the east to Union Bay on the north, bounded by East Prospect Street to the south and Lake Washington Boulevard E. to the west.",
      "sourceSentenceIds": [
        21
      ],
