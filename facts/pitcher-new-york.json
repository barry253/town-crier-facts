    },
    {
      "id": 2,
      "text": "The town takes its name from Nathaniel Pitcher, New York’s eighth governor.",
      "sourceSentenceIds": [
        3,
        4
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Pitcher%2C_New_York"
    },
    {
      "id": 3,
      "text": "Pitcher was carved out of German and Lincklaen in 1827, then grew another slice of Lincklaen in 1833.",
      "sourceSentenceIds": [
        10,
        11
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Pitcher%2C_New_York"
    },
    {
      "id": 4,
      "text": "The Otselic River snakes south through Pitcher, eventually joining the Tioughnioga and the larger Susquehanna watershed.",
      "sourceSentenceIds": [
        13,
        14
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Pitcher%2C_New_York"
    },
    {
      "id": 5,
      "text": "New York State Route 23 cuts across southern Pitcher, tracing the path of Brakel Creek.",
      "sourceSentenceIds": [
