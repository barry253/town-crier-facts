      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Eight colonial families founded Wading River in the 17th century, establishing the hamlet’s earliest English settlement.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
