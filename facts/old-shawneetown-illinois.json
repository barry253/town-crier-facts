  "facts": [
    {
      "id": 1,
      "text": "Old Shawneetown hosts the Shawneetown Bank State Historic Site, a Greek Revival building that once housed Illinois' first chartered bank in 1816.",
      "sourceSentenceIds": [
        5,
        16,
        24
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Old_Shawneetown%2C_Illinois"
    },
    {
      "id": 2,
      "text": "The town was a stop for Lewis and Clark in November 1803 as they headed to Fort Massac down the Ohio River.",
      "sourceSentenceIds": [
        21
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Old_Shawneetown%2C_Illinois"
    },
    {
      "id": 3,
      "text": "In 1825, Marquis de Lafayette visited Old Shawneetown, a highlight remembered by residents for its social significance.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Old_Shawneetown%2C_Illinois"
    },
    {
      "id": 4,
      "text": "The John Marshall House, rebuilt in brick in 1822, stands as the town's second historic structure and now serves as a museum.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Old_Shawneetown%2C_Illinois"
    },
    {
      "id": 5,
      "text": "A devastating flood in 1937 forced many residents to relocate, leading to the construction of a new county courthouse in 1939.",
      "sourceSentenceIds": [
        19,
