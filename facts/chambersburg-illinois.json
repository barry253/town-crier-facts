  "facts": [
    {
      "id": 1,
      "text": "Chambersburg was formally surveyed and platted on May 7, 1833 by Seabourn Gilmore.",
      "sourceSentenceIds": [
        11
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/chambersburg_illinois",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The village’s first school opened in 1830 in a log house, and the first sermon was delivered in 1827 by Methodist Rev. John Medford.",
      "sourceSentenceIds": [
        14
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/chambersburg_illinois",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Early settlers arrived in 1826, drawn by timbered uplands and creek valleys suitable for small‑scale farming.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/chambersburg_illinois",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Chambersburg sits on the North Fork of McGee Creek in section 8 of the township, about 8 miles northeast of Griggsville.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/chambersburg_illinois",
      "category": "other",
      "quality": "poor",
      "qualityReason": "location_description"
    },
    {
      "id": 5,
      "text": "The township’s loess soils over limestone bedrock support agriculture and fruit cultivation, despite periodic flooding from the Illinois River.",
      "sourceSentenceIds": [
        13
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/chambersburg_illinois",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "In the late 19th century, the village hosted several stores, churches, a schoolhouse, flour and sawmills, and blacksmith shops, serving as a modest inland trade hub.",
      "sourceSentenceIds": [
        16
      ],
      "sourceLabels": [
        "Web source 1"
      ],
