  "facts": [
    {
      "id": 1,
      "text": "Olmos Park was developed in the 1920s as an exclusive suburb of San Antonio, now completely surrounded by the city.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Olmos_Park%2C_Texas"
    },
    {
      "id": 2,
      "text": "The town’s name comes from Olmos Creek, a tributary of the San Antonio River that once flowed through the area.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.olmospark.org/340/History-of-Olmos-Park"
    },
    {
      "id": 3,
      "text": "In 2023, Olmos Park installed 60 historic gaslights, reviving the gaslight era without needing a lamplighter.",
      "sourceSentenceIds": [
        5,
        6
      ],
      "sourceLabels": [
        "Web source 1",
