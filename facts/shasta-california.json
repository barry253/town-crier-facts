  "facts": [
    {
      "id": 1,
      "text": "Shasta was the largest settlement in the region during the 1850s‑1880s, serving as a hub for mining and commerce.",
      "sourceSentenceIds": [
        14
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Shasta%2C_California",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town earned the nickname \"Old Shasta\" and was a major shipping point for mule trains and stagecoaches to northern California mines.",
      "sourceSentenceIds": [
        15
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Shasta%2C_California",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "In 1873, the Central Pacific Railroad bypassed Shasta for Redding, sparking the town’s decline into a ghost town.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Shasta%2C_California",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Shasta State Historic Park, located six miles west of Redding, preserves original 19th‑century brick buildings and streets from the former mining town.",
      "sourceSentenceIds": [
        3,
        12
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 2"
      ],
      "source": "https://en.wikipedia.org/wiki/Shasta%2C_California",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The park’s Courthouse Museum, open Thursday‑Sunday 10‑4, charges a $3 adult entry fee and showcases historic California artwork.",
      "sourceSentenceIds": [
        9,
        10
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.parks.ca.gov/?page_id=456",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Jim Hanks, the actor and brother of Tom Hanks, was born in Shasta, linking the town to Hollywood fame.",
