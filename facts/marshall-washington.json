  "facts": [
    {
      "id": 1,
      "text": "Marshall grew around William Marshall’s water‑powered lumber mill, which gave the town its name.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://cheneymuseum.org/poi/marshall/",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "By 1880, the town had become a staging area for laborers building the Northern Pacific Railroad, and its mill supplied lumber to the line.",
      "sourceSentenceIds": [
        9,
        10
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://cheneymuseum.org/poi/marshall/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Around 1910, Leon Oriard opened a dynamite factory on a hill above his home, and by the 1930s four companies operated dynamite factories in Marshall.",
      "sourceSentenceIds": [
