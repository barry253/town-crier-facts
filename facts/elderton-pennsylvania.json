  "facts": [
    {
      "id": 1,
      "text": "Elderton began on the Wheatfield tract, first surveyed in 1786 for Sarah Elder and patented in 1799.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://pa-roots.com/southbend/community/EldertonHistory.html"
    },
    {
      "id": 2,
      "text": "When laid out, Elder called the new settlement New Middletown, a name still seen in early court records.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://pa-roots.com/southbend/community/EldertonHistory.html"
    },
    {
      "id": 3,
      "text": "In 1872 the borough council mandated sidewalks ten feet wide along every street, enforcing them with liens if ignored.",
      "sourceSentenceIds": [
        8,
        9
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://pa-roots.com/southbend/community/EldertonHistory.html"
    },
    {
      "id": 4,
      "text": "The town hosts three historic cemeteries—Elderton, Presbyterian, and United Methodist—reflecting its early religious roots.",
      "sourceSentenceIds": [
        22
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://pa-roots.com/southbend/community/EldertonHistory.html"
    },
    {
      "id": 5,
      "text": "Armstrong County, where Elderton sits, boasts fifteen historic sites, from museums to preserved landmarks that trace Pennsylvania’s past.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://experiencearmstrong.org/"
    },
    {
      "id": 6,
      "text": "The first building in Elderton was a modest log tavern owned by William Elgin, advertising “Oats and whiskey for sale.”.",
      "sourceSentenceIds": [
        30
      ],
      "sourceLabels": [
        "Web source 1"
      ],
