  "facts": [
    {
      "id": 1,
      "text": "Finley named after James Allen Finley, a local businessman who moved there in 1858 and had a post office in his home.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Finley%2C_Tennessee",
      "category": "people",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The community began as Pleasant Hill in 1840 on high ground north of the modern village.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Finley%2C_Tennessee",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Finley sits about 5.5 miles west of downtown Dyersburg along Tennessee State Route 104.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Finley%2C_Tennessee",
      "category": "other",
      "quality": "poor",
      "qualityReason": "location_description"
    },
    {
      "id": 4,
      "text": "Tennessee State Route 182 runs through Finley, linking it with Interstate 155 and Lenox to the north.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Finley%2C_Tennessee",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Finley hosts an annual Freedom Festival each July, organized by local churches including Baptist, Methodist, United Pentecostal, and Junction Church of God.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
