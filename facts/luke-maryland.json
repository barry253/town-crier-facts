  "facts": [
    {
      "id": 1,
      "text": "Luke earned its name when Scottish papermaker William Luke bought the sawmill site in 1881 and renamed the town after himself around 1900.",
      "sourceSentenceIds": [
        14,
        2,
        4
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/luke_maryland",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town’s economy grew around the Piedmont Pulp and Paper Company, which began operations in 1888 and employed about 1,000 people by 1909.",
      "sourceSentenceIds": [
        2,
        1
      ],
      "sourceLabels": [
        "Web source 2",
        "Wikipedia"
      ],
      "source": "https://grokipedia.com/page/luke_maryland",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Luke sits on the north bank of the North Branch Potomac River, just 23 miles southwest of Cumberland, right on the Maryland–West Virginia border.",
      "sourceSentenceIds": [
        13,
        14
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/luke_maryland",
      "category": "other",
      "quality": "poor",
      "qualityReason": "location_description"
    },
    {
      "id": 4,
      "text": "Before the mill, the area was a company town called West Piedmont built around a sawmill started by Henry Gassaway Davis in 1872 to supply railroad ties.",
      "sourceSentenceIds": [
        3,
        18
      ],
      "sourceLabels": [
        "Web source 2",
        "Wikipedia"
      ],
      "source": "https://grokipedia.com/page/luke_maryland",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Verso shut down the Luke paper mill on June 30, 2019, ending more than a century of paper production in the town.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Luke%2C_Maryland",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The Devon Club, opened in 1911, served as a social hub for mill workers, offering billiards, bowling, and a library until the 1950s.",
      "sourceSentenceIds": [
        15
      ],
      "sourceLabels": [
        "Web source 2"
      ],
