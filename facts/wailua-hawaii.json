  "facts": [
    {
      "id": 1,
      "text": "The Great Sacred Wailua, also called the Wailua Complex, is a National Historic Landmark perched along the Wailua River on Kauai’s east side.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.hawaii-guide.com/kauai/sights/the-great-sacred-wailua-wailua-ahu-ano"
    },
    {
      "id": 2,
      "text": "Wailua means ‘two waters’ in Hawaiian, and the area was named Wailuanuiaho’ano after a 14th‑century chief who ruled the region.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.hawaii-guide.com/kauai/sights/the-great-sacred-wailua-wailua-ahu-ano"
    },
    {
      "id": 3,
      "text": "Kamolia Hawaiian Village sits above a bend in the Wailua River and was restored in 1979 as a living example of a traditional fishing village.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.hawaii-guide.com/kauai/sights/the-great-sacred-wailua-wailua-ahu-ano"
    },
    {
      "id": 4,
      "text": "Historically, King Kaumuali'i stored his war canoes in the Wailua area, making it a strategic naval hub during his reign.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.hawaii-guide.com/kauai/sights/the-great-sacred-wailua-wailua-ahu-ano"
    },
    {
      "id": 5,
      "text": "The Wailua River is Hawaii’s only navigable river, drawing locals and tourists alike for water‑skiing, kayaking, and a popular boat tour to Fern Grotto.",
      "sourceSentenceIds": [
        14
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
