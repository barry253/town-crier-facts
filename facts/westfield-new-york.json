  "facts": [
    {
      "id": 1,
      "text": "Westfield’s Barcelona Lighthouse, built in 1829, was the first lighthouse worldwide to run on natural gas, guiding Lake Erie sailors until 1859.",
      "sourceSentenceIds": [
        15,
        16
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Westfield%2C_New_York",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town’s roots trace back to 1802 when James McMahan settled near Chautauqua Creek, later building a mill that was dismantled before the War of 1812.",
      "sourceSentenceIds": [
        11,
        13
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Westfield%2C_New_York",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "In 1828, Westfield was carved out of Portland and Ripley, officially becoming a town just a year after the lighthouse lit its first gas flame.",
      "sourceSentenceIds": [
        14,
        15
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Westfield%2C_New_York",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "A handful of historic structures—twenty on the National Register—dot Westfield, with the lone outlier, Barcelona Lighthouse, listed in 1972.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Westfield%2C_New_York",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Welch’s Grape Juice founder Charles moved his company to Westfield in 1897, drawn by the region’s ideal Concord grape climate.",
      "sourceSentenceIds": [
        17,
        18
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Westfield%2C_New_York",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Millstones from McMahan’s original mill now rest outside the Patterson Library, a quiet reminder of the town’s early industrial past.",
