  "facts": [
    {
      "id": 1,
      "text": "Springlake got its name from the nearby Spring Lake Division of the old XIT Ranch.",
      "sourceSentenceIds": [
        17
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.tshaonline.org/handbook/entries/springlake-tx"
    },
    {
      "id": 2,
      "text": "The town’s first post office opened in 1889 at the Spring Lake ranch headquarters and operated until 1901.",
      "sourceSentenceIds": [
        30
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.tshaonline.org/handbook/entries/springlake-tx"
    },
    {
      "id": 3,
      "text": "Wright Land Company built a store, a hotel, and a post office in Springlake in 1908 after buying the land from the Halsell Cattle Company.",
      "sourceSentenceIds": [
        29
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.tshaonline.org/handbook/entries/springlake-tx"
    },
    {
      "id": 4,
      "text": "Springlake is famously known as the home of Aquarena Springs, a popular natural spring attraction.",
      "sourceSentenceIds": [
        14
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://exhibits.library.txstate.edu/s/archives/page/introduction"
    },
    {
      "id": 5,
      "text": "The San Marcos River, fed by over two hundred underwater springs, flows near Springlake’s historic Aquarena Springs.",
      "sourceSentenceIds": [
        13
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://exhibits.library.txstate.edu/s/archives/page/introduction"
    },
    {
      "id": 6,
      "text": "Springlake celebrated its 250th anniversary of the town’s founding in 2026, marking a quarter‑century of community life.",
