  "facts": [
    {
      "id": 1,
      "text": "Jackson was named after Andrew Jackson on August 31, 1819, making it the first town in the United States to honor the future president.",
      "sourceSentenceIds": [
        2,
        3
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Jackson%2C_Missouri",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The city’s courthouse square, anchored by a stately courthouse built in 1818, remains the heart of historic uptown Jackson.",
      "sourceSentenceIds": [
        1,
        18
      ],
      "sourceLabels": [
        "Web source 2",
        "Wikipedia"
      ],
      "source": "https://www.cityofjacksonmo.gov/184/Community-Profile",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "In 1877, Jackson gained its first long‑distance railway link to Cape Girardeau, a milestone that connected the city to the wider Missouri rail network.",
      "sourceSentenceIds": [
        25
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Jackson%2C_Missouri",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The city’s public library, part of the Riverside Regional Library system, serves as a cultural hub for residents and visitors alike.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Jackson%2C_Missouri",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Jackson’s historic district includes the Big Hill Farmstead and the Frizel‑Welling House, both listed on the National Register of Historic Places.",
      "sourceSentenceIds": [
        28
