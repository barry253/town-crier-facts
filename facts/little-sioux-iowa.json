      ],
      "source": "https://www.nps.gov/places/little-sioux-iowa.htm",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The Little Sioux Scout Ranch, a major Boy Scouts of America camp, is the town’s most famous landmark.",
