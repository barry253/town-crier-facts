  "facts": [
    {
      "id": 1,
      "text": "Juniper Canyon is a unique nine-mile long tributary canyon to the Columbia River at Wallula Gap in northeastern Oregon.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.whitman.edu/geology/Leslie.htm"
    },
    {
      "id": 2,
      "text": "The creek incised Juniper Canyon into Miocene Columbia River basalts long before the arrival of modern vegetation.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.whitman.edu/geology/Leslie.htm"
    },
    {
      "id": 3,
      "text": "Outburst floods from glacial Lake Missoula once filled Juniper Canyon with giant gravel bars and scattered erratic boulders.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.whitman.edu/geology/Leslie.htm"
    },
    {
      "id": 4,
      "text": "Sand dunes from the Umatilla Basin have migrated into the area, while loess blankets the surrounding uplands.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.whitman.edu/geology/Leslie.htm"
    },
    {
      "id": 5,
      "text": "Juniper trees and native shrubs grow on the wetter north-facing slopes, while the south-facing side remains mostly devoid of vegetation.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.whitman.edu/geology/Leslie.htm"
    },
    {
      "id": 6,
      "text": "Beavers and the McNary Dam on the Columbia River helped create the wetlands found on the canyon floor.",
      "sourceSentenceIds": [
        13
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.whitman.edu/geology/Leslie.htm"
    }
  ]
