  "facts": [
    {
      "id": 1,
      "text": "La Verne began in 1887 as the railroad boomtown Lordsburg, founded by Los Angeles businessman Issac Lord to lure Midwesterners.",
      "sourceSentenceIds": [
        2,
        4
      ],
      "sourceLabels": [
        "Web source 1",
        "Web source 2"
      ],
      "source": "https://www.laverneca.gov/407/Discover-La-Verne",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The La Verne Historical Society, founded in 1969 and incorporated in 1973, preserves the city’s orange‑grove heritage and historic structures.",
      "sourceSentenceIds": [
        3,
        6
      ],
      "sourceLabels": [
        "Web source 2",
        "Web source 2"
      ],
      "source": "https://lavernehistoricalsociety.org/",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Carrion Adobe, built in 1868 for Saturnino Carrion, is a California Registered Landmark that once served as a chicken corral before restoration.",
      "sourceSentenceIds": [
        5,
        18,
        19
      ],
      "sourceLabels": [
        "Web source 1",
        "Web source 1",
        "Web source 1"
      ],
      "source": "https://www.laverneca.gov/407/Discover-La-Verne",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The city’s motto, “Preserving Old La Verne’s Environment: Making History for the Future,” reflects its commitment to safeguarding historic sites.",
      "sourceSentenceIds": [
        7,
        8
      ],
      "sourceLabels": [
        "Web source 2",
        "Web source 2"
      ],
      "source": "https://lavernehistoricalsociety.org/",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "La Verne’s early streets, lined with towering Deodar trees, showcase the architecture of the town’s formative years and its citrus‑belt roots.",
      "sourceSentenceIds": [
        17
      ],
      "sourceLabels": [
        "Web source 1"
      ],
