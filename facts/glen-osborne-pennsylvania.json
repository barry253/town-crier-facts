  "facts": [
    {
      "id": 1,
      "text": "Glen Osborne takes its name from a Scottish glen—a valley by a stream—and from local landowner Frank Osborne.",
      "sourceSentenceIds": [
        19,
        8
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 2"
      ],
      "source": "https://en.wikipedia.org/wiki/Glen_Osborne%2C_Pennsylvania",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "In 1851 the Pittsburgh, Fort Wayne and Chicago Railroad cut through the area, opening a station called Osborne to avoid confusion with another stop.",
      "sourceSentenceIds": [
        1,
        4,
        12
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 2",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Glen_Osborne%2C_Pennsylvania",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Local residents petitioned in 1883, and the borough of Osborne was officially incorporated that year.",
      "sourceSentenceIds": [
        20
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Glen_Osborne%2C_Pennsylvania",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Glen Osborne sits on the north bank of the Ohio River, overlooking the water that once powered early steamboats.",
      "sourceSentenceIds": [
        22
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Glen_Osborne%2C_Pennsylvania",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Osborne Elementary School, part of Quaker Valley School District, serves the borough’s families and reflects its commitment to education.",
