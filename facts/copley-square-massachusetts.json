  "facts": [
    {
      "id": 1,
      "text": "Copley Square earned its name from painter John Singleton Copley and grew from a 19th‑century marsh into Boston’s cultural heart.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://bostonpoi.com/copley-square/"
    },
    {
      "id": 2,
      "text": "Across the plaza stands Boston Public Library, founded in 1848 as the nation’s first large free municipal library.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://boston.wiki/a/Copley_Square"
    },
    {
      "id": 3,
      "text": "The library’s McKim Building, completed in 1895, showcases Italian Renaissance style and murals by John Singer Sargent and others.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Copley_Square"
    },
    {
      "id": 4,
      "text": "Fairmont Copley Plaza Hotel, built in 1912 in Beaux‑Arts style, occupies the former site of Boston’s original Museum of Fine Arts.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Copley_Square"
    },
    {
      "id": 5,
      "text": "Trinity Church, a Richardsonian Romanesque masterpiece completed in the 1870s, borders Copley Square.",
      "sourceSentenceIds": [
        20
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://boston.wiki/a/Copley_Square"
    },
    {
      "id": 6,
      "text": "Copley Square hosts a farmers’ market and preserves Boston’s streetcar heritage through historic transit displays.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Copley_Square"
    }
