      ],
      "source": "https://hometownhistorymaps.com/pages/history-of-moscow-mills-missouri",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Moscow Mills sits on the west bank of the Cuivre River, just east of U.S. Route 61.",
      "sourceSentenceIds": [
        28
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Moscow_Mills%2C_Missouri",
