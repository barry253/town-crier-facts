  "facts": [
    {
      "id": 1,
      "text": "Maryvale was named after John F. Long’s wife, Mary, who inspired the community’s early marketing to young families.",
      "sourceSentenceIds": [
        2,
        3
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
