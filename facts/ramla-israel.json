  "facts": [
    {
      "id": 1,
      "text": "Ramla was founded in the early 8th century CE by Umayyad caliph Sulayman ibn Abd al-Malik as the capital of Jund Filastin.",
      "sourceSentenceIds": [
        21
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Ramla",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The city quickly eclipsed neighboring Lydda, prompting relocation of its inhabitants to the new urban center.",
      "sourceSentenceIds": [
        27
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Ramla",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Ramla’s strategic position at the crossroads of the Via Maris and the road from Jaffa to Jerusalem made it a hub for pottery, dyeing, weaving, and olive oil.",
      "sourceSentenceIds": [
        26,
        28
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Ramla",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The oldest active railway station in Israel, opened in April 1891, sits on Ramla’s northeast side and still serves the Tel Aviv–Jerusalem line.",
      "sourceSentenceIds": [
        3,
        23
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Ramla",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Nesher Israel Cement Enterprises, Israel’s sole cement producer, keeps its flagship factory in Ramla, anchoring the city’s industrial profile.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Ramla",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The Ramla Museum, housed in the former British Mandatory municipal headquarters, opened as a museum in 2001 documenting the city’s layered history.",
      "sourceSentenceIds": [
