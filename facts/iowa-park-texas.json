      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://iowapark.com/history/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The Wichita Valley Agriculture Experiment Station, built in 1924, remains operational and is a key research site.",
