  "facts": [
    {
      "id": 1,
      "text": "Savin Hill’s name comes from Joseph Tuttle’s 1819 choice, inspired by the red juniper trees that once lined the area.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Savin_Hill",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The neighborhood was first settled in June 1630, just months before Boston itself was founded.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Savin_Hill",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The Shawmut Branch Railroad linked Savin Hill to downtown Boston in 1872, later becoming part of the Old Colony Railroad network.",
      "sourceSentenceIds": [
        6,
        7
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Savin_Hill",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "In 2003 the entire Savin Hill neighborhood earned a spot on the National Register of Historic Places for its preserved architecture.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Savin_Hill",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Savin Hill Station joined Boston’s rapid‑transit system in 1927 and now serves the MBTA Red Line.",
