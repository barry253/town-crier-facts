  "facts": [
    {
      "id": 1,
      "text": "South New Castle was established as a borough in 1901 after seceding from Shenango Township to seek better local governance.",
      "sourceSentenceIds": [
        6,
        29
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/south_new_castle_pennsylvania"
    },
    {
      "id": 2,
      "text": "South New Castle originally attracted European immigrants seeking affordable housing near the factories and foundries of nearby New Castle.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/south_new_castle_pennsylvania"
    },
    {
      "id": 3,
      "text": "The Hoover Heights Christian and Missionary Alliance Church is a local landmark that actually predates the formation of South New Castle.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/south_new_castle_pennsylvania"
    },
    {
      "id": 4,
      "text": "Early infrastructure in South New Castle included a schoolhouse in 1901, telephone service in 1908, and street lights by 1914.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/south_new_castle_pennsylvania"
    },
    {
      "id": 5,
      "text": "The Carney brothers' greenhouse served as a notable local landmark from around 1930 until it closed in 1971.",
      "sourceSentenceIds": [
        5,
        7
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/south_new_castle_pennsylvania"
    },
    {
      "id": 6,
      "text": "South New Castle officially dissolved as an independent borough on January 1, 2026, following a merger with Shenango Township.",
