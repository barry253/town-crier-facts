      "quality": "good"
    },
    {
      "id": 4,
      "text": "Bob Davis, a Rio Frio resident, helped launch Texas’s Angora goat industry as the first president of the Texas Angora Goat Raisers Association.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 2"
