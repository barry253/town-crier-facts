  "facts": [
    {
      "id": 1,
      "text": "South Milwaukee was laid out in 1891 by the South Milwaukee company as a rival industrial suburb of Milwaukee.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/South_Milwaukee%2C_Wisconsin",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The city incorporated as a village in 1892 and became a city five years later, in 1897.",
      "sourceSentenceIds": [
        17
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/South_Milwaukee%2C_Wisconsin",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "South Milwaukee developed as a streetcar suburb, sitting just 5 miles south of downtown Milwaukee on Lake Michigan’s western shore.",
      "sourceSentenceIds": [
        16
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/South_Milwaukee%2C_Wisconsin",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Its former passenger depot, once a hub for travelers, is now listed on the National Register of Historic Places.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/South_Milwaukee%2C_Wisconsin",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Freight rail services are still provided by the Union Pacific Railroad, keeping the town connected to the national network.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/South_Milwaukee%2C_Wisconsin",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The South Milwaukee Public Library houses a rich local history collection, including historic photos, newspapers, and scrapbooks that chronicle the town’s past.",
