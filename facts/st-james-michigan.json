  "facts": [
    {
      "id": 1,
      "text": "James Jesse Strang, a Mormon leader, founded St. James on Beaver Island in 1847, bringing his followers to the northern coast of Lake Michigan.",
      "sourceSentenceIds": [
        13
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/St._James%2C_Michigan",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Strang crowned himself king, the only monarch ever crowned in the United States, a unique claim in American history.",
      "sourceSentenceIds": [
        15
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/St._James%2C_Michigan",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The first post office on the island opened as Beaver Island on January 13, 1849, with Charles Wright as its inaugural postmaster.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/St._James%2C_Michigan",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Following Strang’s 1856 murder, the post office closed in 1868, only to reopen later that year under Wright’s restored name.",
      "sourceSentenceIds": [
        16,
        17
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/St._James%2C_Michigan",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "St. James occupies the northern shore of Beaver Island, the largest island in Lake Michigan, offering a unique maritime setting.",
      "sourceSentenceIds": [
        11
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/St._James%2C_Michigan",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The Beaver Island Community School, located within St. James, serves the entire CDP, educating residents from kindergarten through high school.",
