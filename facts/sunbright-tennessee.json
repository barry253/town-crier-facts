  "facts": [
    {
      "id": 1,
      "text": "Sunbright began as Pine Top, then the Staples family’s post office turned the town into Stapleton in the mid‑1800s.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Sunbright%2C_Tennessee"
    },
    {
      "id": 2,
      "text": "When the railroad arrived in 1879, the Stapleton depot was christened Sunbright, and the name stuck for the whole town.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Sunbright%2C_Tennessee"
    },
    {
      "id": 3,
      "text": "Early settlers arrived in the early 1800s, laying the groundwork for what would become Sunbright.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Sunbright%2C_Tennessee"
    },
    {
      "id": 4,
      "text": "An oil field was found west of Sunbright in 1916, turning the city into a bustling oil shipping hub for a decade.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Sunbright%2C_Tennessee"
    },
    {
      "id": 5,
      "text": "Sunbright sits atop the Cumberland Plateau, about 25 miles west of Walden Ridge’s escarpment.",
      "sourceSentenceIds": [
        11
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Sunbright%2C_Tennessee"
    },
    {
      "id": 6,
      "text": "White Oak Creek drains Sunbright into the Big South Fork, whose watershed meets the Emory River at Pilot Mountain.",
      "sourceSentenceIds": [
        13,
