  "facts": [
    {
      "id": 1,
      "text": "Erlanger was named after Baron Frederic Emile D’Erlanger, who led the land syndicate that persuaded the railroad to stop there.",
      "sourceSentenceIds": [
        8,
        23
      ],
      "sourceLabels": [
        "Web source 1",
        "Web source 2"
      ],
      "source": "https://erlangerky.gov/erlanger-history/",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "In 1882 a post office opened and the depot adopted the name Erlanger, honoring the same Baron.",
      "sourceSentenceIds": [
        8,
        10
      ],
      "sourceLabels": [
        "Web source 1",
        "Web source 2"
      ],
      "source": "https://erlangerky.gov/erlanger-history/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The city’s first settlement dates to 1807 when Bartlett Graves built a log cabin, marking the start of Erlanger’s long history.",
      "sourceSentenceIds": [
        13
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://erlangerky.gov/erlanger-history/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Every year on the third Sunday of September, the Historical Society hosts Heritage Day, a celebration of Erlanger’s heritage.",
