  "facts": [
    {
      "id": 1,
      "text": "Lanett was officially founded on February 1, 1895, after years of growth along the Chattahoochee River.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.cityoflanett.com/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The city’s name comes from textile mill developers Lafayette Lanier and Theodore Bennett, founders of the West Point Manufacturing Company.",
      "sourceSentenceIds": [
        5,
        17
      ],
      "sourceLabels": [
        "Web source 1",
        "Wikipedia"
      ],
      "source": "https://www.cityoflanett.com/",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Before becoming Lanett, the town was incorporated as Bluffton on December 7, 1865.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.cityoflanett.com/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The area that is now Lanett was first settled in the 1840s by former residents of West Point, Georgia, on the east bank of the Chattahoochee River.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://encyclopediaofalabama.org/article/lanett/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Several historic buildings, including the Griggs‑Simmons House and Old Lanett High School, are listed on the Alabama Register of Landmarks and Heritage.",
      "sourceSentenceIds": [
        13
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://encyclopediaofalabama.org/article/lanett/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The Chattahoochee River forms Lanett’s eastern boundary and marks the Alabama–Georgia state line.",
      "sourceSentenceIds": [
        21
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
