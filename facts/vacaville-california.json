  "facts": [
    {
      "id": 1,
      "text": "Vacaville was founded in 1851 and named after Juan Manuel Vaca, a landowner who sold part of his Rancho Los Putos to William McDaniel.",
      "sourceSentenceIds": [
        4,
        8
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Vacaville%2C_California",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The Buck family’s legacy lives on in Buck Avenue, a tree‑lined boulevard that once housed the original Vacaville Museum opened in 1984 after Eva Buck’s donation.",
      "sourceSentenceIds": [
        3,
        7
      ],
      "sourceLabels": [
        "Web source 1",
        "Web source 1"
      ],
      "source": "https://bestattractions.org/usa/california/vacaville-ca-local-facts/",
      "category": "people",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The Nut Tree, a 1920s roadside fruit stand, once featured a half‑mile railroad with tunnels and bridges, and a modern version still operates inside Nut Tree Plaza.",
      "sourceSentenceIds": [
        15,
        16
      ],
      "sourceLabels": [
        "Web source 1",
        "Web source 1"
      ],
      "source": "https://bestattractions.org/usa/california/vacaville-ca-local-facts/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Every December, downtown Vacaville hosts a Festival of Trees where a 50‑foot tree lights up, the Jepson Band plays, and horse‑drawn carriages glide across the ice rink.",
      "sourceSentenceIds": [
        11
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Vacaville%2C_California",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Vacaville’s Peña Adobe Historical Area preserves the 19th‑century Peña Adobe home and the Mowers‑Goheen Museum, showcasing early pioneer life.",
      "sourceSentenceIds": [
        12,
        9
      ],
      "sourceLabels": [
