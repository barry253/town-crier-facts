  "facts": [
    {
      "id": 1,
      "text": "Omar was named after James Omar Cole, a land investor and the grandfather of famous composer Cole Porter.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/omar_west_virginia"
    },
    {
      "id": 2,
      "text": "By 1916, Omar was praised as a model coal town with modern amenities like electric lighting and piped water.",
      "sourceSentenceIds": [
        13
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/omar_west_virginia"
    },
    {
      "id": 3,
      "text": "The economy of Omar centered on coal mining, with production reaching up to four million tons annually by the mid-1910s.",
      "sourceSentenceIds": [
        14
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/omar_west_virginia"
    },
    {
      "id": 4,
      "text": "Farm Security Administration photographs from the 1930s captured the daily lives of mining families living in the hollows of Omar.",
      "sourceSentenceIds": [
        15
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/omar_west_virginia"
    },
    {
      "id": 5,
      "text": "Island Creek flows through Omar, influencing the local hydrology and creating riparian habitats for native fish and amphibians.",
      "sourceSentenceIds": [
        5,
        24
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/omar_west_virginia"
    },
    {
      "id": 6,
      "text": "Omar is situated in a rugged landscape of narrow valleys and forested hills within the Appalachian terrain of Logan County.",
      "sourceSentenceIds": [
