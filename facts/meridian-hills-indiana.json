  "facts": [
    {
      "id": 1,
      "text": "Meridian Hills first saw homes built in the early 1920s, and its country club opened in 1923 before the town officially incorporated in 1937.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Meridian_Hills%2C_Indiana"
    },
    {
      "id": 2,
      "text": "In 1970 Meridian Hills became an \"included town,\" joining Indianapolis under Unigov while still keeping its own town government.",
      "sourceSentenceIds": [
        7,
        8
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Meridian_Hills%2C_Indiana"
    },
    {
      "id": 3,
      "text": "The town remains a wooded enclave, home to many of Indianapolis’ wealthiest residents.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Meridian_Hills%2C_Indiana"
    },
    {
      "id": 4,
      "text": "Perched on high ground, Meridian Hills overlooks the White River to the southeast and Williams Creek to the northeast.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Meridian_Hills%2C_Indiana"
    },
    {
      "id": 5,
      "text": "A local historical society was founded in 2015 to collect and preserve Meridian Hills’ unique heritage.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://indyencyclopedia.org/meridian-hills/"
    },
    {
      "id": 6,
      "text": "When the town abandoned plans for its own sanitary sewers, the Indianapolis Hebrew Congregation was allowed to build a synagogue on the land north of the White River.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 2"
      ],
