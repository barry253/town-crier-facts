      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Center_Point%2C_Alabama",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Between 1960 and 1970, more than 80 % of the homes inside the city limits were built, turning Center Point into a rapidly expanding suburb.",
      "sourceSentenceIds": [
        21
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Center_Point%2C_Alabama",
