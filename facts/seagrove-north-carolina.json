  "facts": [
    {
      "id": 1,
      "text": "Seagrove earned its name when a railroad official, Seagraves, was honored, but a sign painter dropped the 's' and the town became Seagrove.",
      "sourceSentenceIds": [
        4,
        19,
        20
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Seagrove%2C_North_Carolina",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town’s pottery heritage dates back to the 18th century, with over 100 potteries today, including historic Owens and Jugtown Pottery.",
      "sourceSentenceIds": [
        3,
        16,
        29
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Seagrove%2C_North_Carolina",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "In 1982 local potters founded the North Carolina Museum of Traditional Pottery, and the Seagrove Pottery Festival now draws visitors each Thanksgiving weekend.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Seagrove%2C_North_Carolina",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The old train depot, once serving Seagrove until 1951, was later converted into a pottery museum and now hosts the Celebration of Seagrove Potters.",
      "sourceSentenceIds": [
        8,
        21,
        14
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Seagrove%2C_North_Carolina",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Plank Road, built in 1849, connected Seagrove to wider markets and helped establish its reputation as a pottery town.",
      "sourceSentenceIds": [
        22,
        11
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Seagrove%2C_North_Carolina",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Seagrove’s famous glass bar displays a collection of political, humorous, and historic buttons owned by the local pottery family.",
