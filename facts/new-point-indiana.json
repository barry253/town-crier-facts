  "facts": [
    {
      "id": 1,
      "text": "New Point was founded in 1840 and originally called “Crackaway,” a name inspired by buggy races that cracked horse whips.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.visitgreensburg.com/articles/post/a-day-in-new-point-indiana/"
    },
    {
      "id": 2,
      "text": "The town was officially laid out in 1859, marking its formal establishment on the map of Decatur County.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/New_Point%2C_Indiana"
    },
    {
      "id": 3,
      "text": "An active railway bisects New Point, running east toward Cincinnati and west toward Indianapolis, a key feature of its geography.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/New_Point%2C_Indiana"
    },
    {
      "id": 4,
      "text": "Tub Creek, a small stream, rises just north of New Point and flows south through the town’s center.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/New_Point%2C_Indiana"
    },
    {
      "id": 5,
      "text": "Every year the community celebrates Crackaway Daze, a festival held on the third full weekend of September.",
      "sourceSentenceIds": [
        24
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/New_Point%2C_Indiana"
    },
    {
      "id": 6,
      "text": "New Point hosts two churches—New Point Christian Church and New Point Baptist Church—serving as longstanding community gathering spots.",
      "sourceSentenceIds": [
        22
