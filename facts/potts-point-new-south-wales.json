      ],
      "source": "https://pottspointpreservation.org/local-history/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Kings Cross railway station sits beneath Darlinghurst Road, giving Potts Point instant access to Sydney’s train network.",
      "sourceSentenceIds": [
