  "facts": [
    {
      "id": 1,
      "text": "Jacksonville was founded in 1858 as a depot station on the North Missouri Railroad, becoming a key stop before the Civil War.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/jacksonville_missouri"
    },
    {
      "id": 2,
      "text": "The town honors Hancock Jackson, an early settler who later served as Missouri’s lieutenant governor from 1857 to 1861.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/jacksonville_missouri"
    },
    {
      "id": 3,
      "text": "A post office opened in Jacksonville in 1837, serving as the community’s first hub for mail and local exchange.",
      "sourceSentenceIds": [
        16
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/jacksonville_missouri"
    },
    {
      "id": 4,
      "text": "Jacksonville lies within the historic Boonslick region, where pioneers from Kentucky, Virginia, and North Carolina settled after Missouri’s 1821 statehood.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/jacksonville_missouri"
    },
    {
      "id": 5,
      "text": "The village sits in Jackson Township, named for John Randolph of Virginia, reflecting the county’s early 19th‑century naming tradition.",
