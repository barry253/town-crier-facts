  "facts": [
    {
      "id": 1,
      "text": "Saint Louis was founded on February 14, 1764 by French fur traders Gilbert Antoine de St. Laclède and his stepson Auguste Chouteau.",
      "sourceSentenceIds": [
        13
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/St._Louis"
    },
    {
      "id": 2,
      "text": "The city was named for King Louis IX of France and quickly became the regional hub of the French Illinois Country.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/St._Louis"
    },
    {
      "id": 3,
      "text": "In 1904 Saint Louis hosted the World’s Fair and the Summer Olympics, becoming the first non‑European city to hold the games.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/St._Louis"
    },
    {
      "id": 4,
      "text": "The 1874 Eads Bridge, the first steel arch bridge in the world, linked Saint Louis to Illinois and set a new engineering standard.",
      "sourceSentenceIds": [
        14
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/St._Louis"
    },
    {
      "id": 5,
      "text": "The Missouri Botanical Garden, a National Historic Landmark, is one of the oldest botanical gardens in the United States.",
      "sourceSentenceIds": [
