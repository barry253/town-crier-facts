  "facts": [
    {
      "id": 1,
      "text": "Bolivar County was named to honor Simón Bolívar, the 19th‑century leader who fought for independence across South America.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Bolivar_County%2C_Mississippi",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "In 1836, the county was carved from Choctaw land and quickly became a prime agricultural area in the state.",
      "sourceSentenceIds": [
        14
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Bolivar_County%2C_Mississippi",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Mound Bayou, a town within Bolivar, was founded and run entirely by African Americans, attracting many Black settlers.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Bolivar_County%2C_Mississippi",
      "category": "people",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "During the 1920s, Bolivar hosted 17 chapters of the UNIA, making it a hotspot for African‑American self‑determination.",
      "sourceSentenceIds": [
        11
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Bolivar_County%2C_Mississippi",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The Mississippi River has long shaped Bolivar’s cultural heritage, influencing everything from agriculture to local music traditions.",
