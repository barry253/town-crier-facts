  "facts": [
    {
      "id": 1,
      "text": "Budaörs lies among the Buda and Csiki hills and the Tétény plateau in the Budaörs-basin.",
      "sourceSentenceIds": [
        19
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Buda%C3%B6rs"
    },
    {
      "id": 2,
      "text": "The first settlements date back to 3500 BC, with Bronze Age finds near Hosszúrét creek.",
      "sourceSentenceIds": [
        21,
        22
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Buda%C3%B6rs"
    },
    {
      "id": 3,
      "text": "During Ottoman rule the area was empty, then repopulated by Swabian peasants in the early 18th century by Countess Zsuzsanna Bercsényi.",
      "sourceSentenceIds": [
        28
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Buda%C3%B6rs"
    },
    {
      "id": 4,
      "text": "The Jakob Bleyer Local History Museum, housed in a typical Swabian house, chronicles German settlers’ story.",
      "sourceSentenceIds": [
        3,
        6,
        8
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Buda%C3%B6rs"
    },
    {
      "id": 5,
      "text": "A sculpture of John of Nepomuk stands opposite the museum, a nod to local religious heritage.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://en.wikivoyage.org/wiki/Buda%C3%B6rs"
    },
    {
      "id": 6,
      "text": "The town hosted the Battle of Budaörs in 1921, a brief clash between Hungarian royalists and the government.",
