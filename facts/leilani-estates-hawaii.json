      "id": 1,
      "text": "Leilani Estates was once called Keahialaka, meaning 'the fire of Laka,' a sacred Hawaiian landscape that stretched from mountain to sea.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 2"
      ],
