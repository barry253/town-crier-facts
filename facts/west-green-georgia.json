  "facts": [
    {
      "id": 1,
      "text": "West Green was first called The Twenty because it sat 20 miles south of Hazlehurst, then renamed Garrant after a lumber company.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/West_Green%2C_Georgia",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "West Green remains an unincorporated community in Coffee County, Georgia, United States.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/West_Green%2C_Georgia",
      "category": "other",
      "quality": "poor",
      "qualityReason": "other"
    },
    {
      "id": 3,
      "text": "The town lies along U.S. Route 221, just northeast of Douglas and southwest of Lehigh, near the Coffee‑Jeff Davis County line.",
      "sourceSentenceIds": [
        8,
        9
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/West_Green%2C_Georgia",
      "category": "transport",
      "quality": "poor",
      "qualityReason": "route_only"
    },
    {
      "id": 4,
      "text": "The Georgia General Assembly incorporated West Green as a town in 1914, giving it a brief period of municipal status.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/West_Green%2C_Georgia",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "West Green’s municipal charter was repealed in 1995, ending its official town designation after eighty-one years.",
      "sourceSentenceIds": [
        11
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/West_Green%2C_Georgia",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "West Green’s history reflects the rise and fall of the lumber industry that once dominated Coffee County’s economy.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
