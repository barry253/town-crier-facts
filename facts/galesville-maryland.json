  "facts": [
    {
      "id": 1,
      "text": "Galesville was founded in 1652 by two families fleeing religious persecution and was originally called Browntown.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.his.com/~vann/KrgStuff/Summer99/history.htm",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town’s name changed to West River Landing by 1682, becoming an official port of entry for shipping and trade.",
      "sourceSentenceIds": [
        11,
        27
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.his.com/~vann/KrgStuff/Summer99/history.htm",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Galesville is the birthplace of organized Quakerism in Maryland, thanks to the early West River Friends meeting.",
      "sourceSentenceIds": [
        14
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Galesville%2C_Maryland",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "In 1923 the Smith Brothers founded a pile‑driving company that still operates around the Bay, a legacy of the town’s maritime roots.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.his.com/~vann/KrgStuff/Summer99/history.htm",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The West River Sailing Club, originally called Our Own Damned Yacht Club, began hosting regattas in 1929, making sailing a local pastime.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.his.com/~vann/KrgStuff/Summer99/history.htm",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The Galesville Heritage Society, formed in 1991, preserves the village’s history through a museum, educational outreach, and community events.",
      "sourceSentenceIds": [
