  "facts": [
    {
      "id": 1,
      "text": "Sorel was founded in 1642, making it one of Quebec's oldest settlements.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Sorel-Tracy",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Tracy was founded February 10, 1954, after evolving from the parish municipality of Saint‑Joseph de Sorel.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Sorel-Tracy",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The parish of Tracy was named for Lieutenant General Alexander de Prouville, Sieur de Tracy, commander of the Carignan‑Salières Regiment.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Sorel-Tracy",
      "category": "people",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "In 1642, Governor Charles Huault de Montmagny erected a fort at the confluence of the Richelieu and St. Lawrence Rivers.",
      "sourceSentenceIds": [
        11
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://en.wikivoyage.org/wiki/Sorel-Tracy",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Sorel houses the historic Colisée Cardin, an ice‑hockey arena that opened in 1954 and hosts local teams.",
      "sourceSentenceIds": [
        16
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Sorel-Tracy",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The Société historique Pierre‑de‑Saurel, founded in 1970, preserves and shares Sorel‑Tracy's rich history with visitors.",
      "sourceSentenceIds": [
