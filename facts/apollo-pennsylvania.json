  "facts": [
    {
      "id": 1,
      "text": "Apollo was first settled in 1790, laid out in 1816, and officially incorporated as a borough in 1848.",
      "sourceSentenceIds": [
        20,
        21
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Apollo%2C_Pennsylvania"
    },
    {
      "id": 2,
      "text": "The town’s original name was Warren, but a post office opened in 1848 and the name changed to Apollo to avoid confusion with another Pennsylvanian town.",
      "sourceSentenceIds": [
        4,
        5
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Apollo%2C_Pennsylvania"
    },
    {
      "id": 3,
      "text": "Apollo’s Drake Log Cabin, a 1‑½‑story log house restored in 1971, still stands and is one of Armstrong County’s oldest buildings.",
      "sourceSentenceIds": [
        9,
        22
      ],
      "sourceLabels": [
        "Web source 1",
        "Wikipedia"
      ],
      "source": "https://apollopa.net/"
    },
    {
      "id": 4,
      "text": "In 1911, Apollo opened the first public library in Armstrong County, a milestone for local education.",
      "sourceSentenceIds": [
        16
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Apollo%2C_Pennsylvania"
    },
    {
      "id": 5,
      "text": "The Apollo Iron & Steel Company once dominated the local economy, and in 1895 its president hired Olmsted & Co. to design a workers’ town that became Vandergrift.",
      "sourceSentenceIds": [
        24,
        25
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Apollo%2C_Pennsylvania"
    },
    {
      "id": 6,
      "text": "The Roaring Run Recreation Area lies just one mile upriver from Apollo and can be reached via the Apollo Kiski River Trail.",
