      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/River_Hills%2C_Wisconsin",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The private University School of Milwaukee’s campus sits within River Hills, serving the village’s students.",
      "sourceSentenceIds": [
