  "facts": [
    {
      "id": 1,
      "text": "Fort Mackinac, a well‑preserved 18th‑century military outpost, hosts exhibits and reenactments that bring the island’s history to life.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.mackinacisland.org/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The Ojibwe name Michilimackinac means “Great Turtle,” a nod to the island’s shape and indigenous heritage.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Mackinac_Island%2C_Michigan",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "A 1895 ordinance bans motor vehicles, so visitors travel by foot, bicycle, horse, or horse‑drawn carriage.",
      "sourceSentenceIds": [
        18
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Mackinac_Island%2C_Michigan",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The Grand Hotel, erected in the late 1800s, became the island’s premier summer resort for wealthy tourists.",
      "sourceSentenceIds": [
        22
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Mackinac_Island%2C_Michigan",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The Inn at Stonecliffe, a historic mansion, offers timeless elegance and stunning views overlooking the Straits of Mackinac.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
