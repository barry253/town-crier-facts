      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town was named for David Trainer, a wealthy textile magnate who owned Linwood Mills.",
      "sourceSentenceIds": [
        1,
        2,
        3,
        5
      ],
      "sourceLabels": [
        "Wikipedia",
        "Wikipedia",
        "Web source 2",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Trainer%2C_Pennsylvania",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Linwood Mills grew into one of the region’s largest textile factories, powered by water and served by rail, road, or steamer.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.trainerboro.com/history/",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Delta Air Lines bought the Trainer Refinery for $180 million from Phillips 66 in 2012, turning it into a major oil facility.",
      "sourceSentenceIds": [
        21,
        22
      ],
      "sourceLabels": [
        "Wikipedia",
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Trainer%2C_Pennsylvania",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Stoney Creek winds through Trainer before emptying into the Delaware River in the heart of the borough.",
      "sourceSentenceIds": [
        14
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Trainer%2C_Pennsylvania",
