      "id": 1,
      "text": "Trainer became an independent borough on March 1, 1919, breaking away from Lower Chichester Township.",
      "sourceSentenceIds": [
        7,
        9
      ],
      "sourceLabels": [
        "Web source 1",
        "Web source 2"
      ],
