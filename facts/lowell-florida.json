    {
      "id": 1,
      "text": "Lowell Correctional Institution opened in April 1956 as Florida’s first women‑only prison, a milestone in the state’s correctional history.",
      "sourceSentenceIds": [
        14,
        16
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Lowell_Correctional_Institution",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Today the complex holds almost 3,000 women, ranging from juveniles aged 14 to 18 to adults, all at varying security levels.",
      "sourceSentenceIds": [
        13,
        19
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Lowell_Correctional_Institution",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "In 1999 the facility was renamed Lowell Correctional Institution/Women’s Unit, and a year later it adopted the current title, Lowell Correctional Institution.",
      "sourceSentenceIds": [
        17
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Lowell_Correctional_Institution",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The Lowell Annex, overseen by the main institution, serves as an inmate reception center for new arrivals.",
      "sourceSentenceIds": [
        20
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Lowell_Correctional_Institution",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Lowell’s Work Camp lets eligible inmates work outside the gates and interact with the public, a rare opportunity in Florida prisons.",
      "sourceSentenceIds": [
        22
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Lowell_Correctional_Institution",
      "category": "landmark",
      "quality": "good"
    },
