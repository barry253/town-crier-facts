  "facts": [
    {
      "id": 1,
      "text": "Mosquero was founded in 1908 by Benjamin Brown, who built the first home and post office.",
      "sourceSentenceIds": [
        1,
        2
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Mosquero%2C_New_Mexico",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The name Mosquero means 'swarm of flies,' named for flies drawn to bison carcasses hunted by local tribes.",
      "sourceSentenceIds": [
        13,
        29
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Mosquero%2C_New_Mexico",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Mosquero began as a water stop on the 1902 Dawson Railway, later growing into a small town with a hotel and post office.",
      "sourceSentenceIds": [
        12,
        4
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Mosquero%2C_New_Mexico",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The village once operated a dry ice plant that used carbon dioxide from local Bravo Dome wells beneath Harding County.",
      "sourceSentenceIds": [
        14
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Mosquero%2C_New_Mexico",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "After Benjamin Brown built a home, store, hotel, and post office, Mosquero grew into a supply hub for surrounding homesteads.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.villageofmosquero.com/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Mosquero has drawn families for generations, with its school, equestrian arena, courthouse, and CO2 pump station keeping new residents coming.",
      "sourceSentenceIds": [
