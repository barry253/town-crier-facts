      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Mosquero began as a water stop on the 1902 Dawson Railway, later growing into a small town with a hotel and post office.",
      "sourceSentenceIds": [
        12,
        4
      ],
      "sourceLabels": [
        "Wikipedia",
