      "id": 1,
      "text": "Smock, Pennsylvania takes its name from Samuel Smock, the original owner of the town site.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Smock%2C_Pennsylvania",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The Smock Heritage Museum sits on the top floor of the Smock Community Recreation and Heritage Center, the old Company Store.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://pittsburghmuseums.org/organizations/smock-historical-society",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The museum displays two murals, maps, aerial views, artifacts, antiques, photographs, books, and rooms that replicate a Patch House and a local tavern.",
      "sourceSentenceIds": [
        18
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://pittsburghmuseums.org/organizations/smock-historical-society",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Smock lies along Redstone Creek, which marks the boundary between Franklin and Menallen townships.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Smock%2C_Pennsylvania",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Smock sits roughly halfway between Perryopolis and Uniontown, making it part of the Pittsburgh metropolitan area.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Smock%2C_Pennsylvania",
      "category": "other",
      "quality": "poor",
      "qualityReason": "location_description"
    },
    {
      "id": 6,
      "text": "Route 51 runs north from Smock to Perryopolis and south to Uniontown, the county seat.",
