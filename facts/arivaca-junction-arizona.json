  "facts": [
    {
      "id": 1,
      "text": "Arivaca sits at the crossroads of prehistoric trade routes linking the Pacific Coast, northern Mexico, and the American Southwest.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://azpaths.com/towns-and-cities/frontier-cultural-crossroads/arivaca",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town’s name comes from a Tohono O’odham word meaning “small springs” or “place of the little fields,” adapted by Spanish explorers.",
      "sourceSentenceIds": [
        19
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://azpaths.com/towns-and-cities/frontier-cultural-crossroads/arivaca",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "In 1856, the Gadsden Purchase brought Arivaca under U.S. jurisdiction, shifting it from Mexican to American control.",
      "sourceSentenceIds": [
        22
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://azpaths.com/towns-and-cities/frontier-cultural-crossroads/arivaca",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "During the late 19th century, Arivaca buzzed with miners, traders, cowboys, and teamsters on dusty roads linking Tucson to the Mexican border.",
      "sourceSentenceIds": [
        25
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://azpaths.com/towns-and-cities/frontier-cultural-crossroads/arivaca",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The Arivaca Library and Visitor Center, one of the state’s oldest continuously operating rural libraries, stands as a testament to enduring community values.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://azpaths.com/towns-and-cities/frontier-cultural-crossroads/arivaca",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Rolling panoramic mountain views and abundant birding opportunities make Arivaca a unique destination for nature lovers.",
      "sourceSentenceIds": [
