  "facts": [
    {
      "id": 1,
      "text": "Arivaca sits at the crossroads of prehistoric trade routes linking the Pacific Coast, northern Mexico, and the American Southwest.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 2"
      ],
