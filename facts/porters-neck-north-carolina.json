  "facts": [
    {
      "id": 1,
      "text": "Porters Neck Plantation began as a 960‑acre royal grant bought by John Porter in 1732, anchoring the area’s name.",
      "sourceSentenceIds": [
        19,
        2
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.portersneckhoa.com/porters-neck-history-1/",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The plantation runs parallel to the Intracoastal Waterway, bounded by Futch Creek to the north and Little Creek to the south.",
      "sourceSentenceIds": [
        17,
        18
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.portersneckhoa.com/porters-neck-history-1/",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "In 1861, Nicholas Nixon turned Porters Neck into a peanut powerhouse, netting $20,000 from a single crop.",
      "sourceSentenceIds": [
        25
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.portersneckhoa.com/porters-neck-history-1/",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Nixon also built a wharf so English schooners could dock at Rich Inlet and load peanuts, sweet potatoes, soybeans, and peas.",
      "sourceSentenceIds": [
        26
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.portersneckhoa.com/porters-neck-history-1/",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The late‑1990s saw a parcel off Bald Eagle Lane develop into Eagle Point Golf Club, an exclusive course on the west side of Little Creek.",
