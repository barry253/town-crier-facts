  "facts": [
    {
      "id": 1,
      "text": "Shiocton was originally named Jordan's Landing or Jordanville, likely after one of the area's first two white settlers, Woodford D. Jordan.",
      "sourceSentenceIds": [
        1,
        12
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Shiocton%2C_Wisconsin"
    },
    {
      "id": 2,
      "text": "In the Menominee language, Shiocton is known as Māēnomehsāyak, which means wild rice along the banks.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Shiocton%2C_Wisconsin"
    },
    {
      "id": 3,
      "text": "The Menominee ceded this territory to the United States in the 1836 Treaty of the Cedars.",
      "sourceSentenceIds": [
        11
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Shiocton%2C_Wisconsin"
    },
    {
      "id": 4,
      "text": "The Shioc River flows through Shiocton and empties into the Wolf River.",
      "sourceSentenceIds": [
        15
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Shiocton%2C_Wisconsin"
    },
    {
      "id": 5,
      "text": "Fishermen gather at Bamboo Bend in April to watch sturgeon spawn in the Wolf River as they swim from Lake Winnebago.",
      "sourceSentenceIds": [
        25,
        26
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Shiocton%2C_Wisconsin"
    },
    {
      "id": 6,
      "text": "The Newton Blackmour State Trail runs through Shiocton, supporting activities from snowmobiling in winter to horseback riding in summer.",
      "sourceSentenceIds": [
        29,
        30
      ],
