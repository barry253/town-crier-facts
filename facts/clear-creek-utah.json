  "facts": [
    {
      "id": 1,
      "text": "Clear Creek was founded in the 1870s as a logging camp that supplied lumber to the nearby mining town of Winter Quarters.",
      "sourceSentenceIds": [
        8,
        9
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Clear_Creek%2C_Utah"
    },
    {
      "id": 2,
      "text": "The town takes its name from the clear stream of water that flows through the valley.",
      "sourceSentenceIds": [
        20
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.legendsofamerica.com/clear-creek-utah/"
    },
    {
      "id": 3,
      "text": "At 8,200 feet, the Clear Creek mine was the highest of all the coal mines in Utah.",
      "sourceSentenceIds": [
        23
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.legendsofamerica.com/clear-creek-utah/"
    },
    {
      "id": 4,
      "text": "Winter in Clear Creek is cold and snowy, with a yearly average of 237 inches of snow accumulation.",
      "sourceSentenceIds": [
