  "facts": [
    {
      "id": 1,
      "text": "Loachapoka, a town in Lee County, Alabama, gets its name from the Muskogee phrase meaning 'place where turtles live.'.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.atlasalabama.gov/municipalities/loachapoka/"
    },
    {
      "id": 2,
      "text": "The Western Railroad of Alabama reached Loachapoka from Montgomery in 1845, making it the easternmost point on the line.",
      "sourceSentenceIds": [
        16
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://encyclopediaofalabama.org/article/loachapoka/"
    },
    {
      "id": 3,
      "text": "Loachapoka houses the Lee County Historical Museum, a collection of nine historic structures known as Pioneer Park.",
      "sourceSentenceIds": [
        18
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://encyclopediaofalabama.org/article/loachapoka/"
    },
    {
      "id": 4,
      "text": "Loachapoka once celebrated two fall festivals—Syrup Sopping Day and the Lee County Historical Fair—before merging them into Pioneer Day.",
      "sourceSentenceIds": [
        3,
        6
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Loachapoka%2C_Alabama"
    },
    {
      "id": 5,
      "text": "Loachapoka School, the nation's first Rosenwald School, stands as a landmark of early 20th‑century African‑American education.",
      "sourceSentenceIds": [
        30
      ],
      "sourceLabels": [
