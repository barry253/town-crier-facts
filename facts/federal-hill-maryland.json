  "facts": [
    {
      "id": 1,
      "text": "Federal Hill was once known as Signal Hill, where a maritime observatory warned merchants of ships arriving up the Patapsco River.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Federal_Hill%2C_Baltimore"
    },
    {
      "id": 2,
      "text": "The Cross Street Market, built in the 19th century, remains the neighborhood’s primary social and commercial hub.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Federal_Hill%2C_Baltimore"
    },
    {
      "id": 3,
      "text": "Federal Hill Park sits on the hill’s eastern edge, offering sweeping views of downtown Baltimore and the Inner Harbor.",
      "sourceSentenceIds": [
        13
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://fedhill.org/history-of-federal-hill/"
    },
    {
      "id": 4,
      "text": "Federal Hill’s historic district was added to the National Register of Historic Places in 1970, preserving its diverse architectural styles.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://fedhill.org/history-of-federal-hill/"
    },
    {
      "id": 5,
      "text": "Every summer, Federal Hill hosts Shakespeare on the Hill, a series of free performances staged in the park atop the hill.",
      "sourceSentenceIds": [
        28
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Federal_Hill%2C_Baltimore"
    },
    {
      "id": 6,
      "text": "The Light Street Branch of the Enoch Pratt Free Library, located in Federal Hill, serves as a key cultural resource for residents.",
      "sourceSentenceIds": [
        17
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
