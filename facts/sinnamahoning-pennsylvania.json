  "facts": [
    {
      "id": 1,
      "text": "Sinnamahoning’s name comes from the Native American word “Achsinnimahoni,” meaning “stony lick.”.",
      "sourceSentenceIds": [
        16
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.pa.gov/agencies/dcnr/recreation/where-to-go/state-parks/find-a-park/sinnemahoning-state-park/history",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "In the 1800s, the valley’s abundant pine and hemlock forests sparked a logging boom that reshaped the landscape.",
      "sourceSentenceIds": [
        16
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.pa.gov/agencies/dcnr/recreation/where-to-go/state-parks/find-a-park/sinnemahoning-state-park/history",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The Lowlands Trail traces the old rail bed of the Goodyear Brothers Railroad, a relic of the early 20th‑century Sinnemahoning Valley Railroad System.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.pa.gov/agencies/dcnr/recreation/where-to-go/state-parks/find-a-park/sinnemahoning-state-park/history",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Sinnemahoning State Park opened to the public in 1958, with its first recreation areas finished the following year.",
      "sourceSentenceIds": [
        21,
        22
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.pa.gov/agencies/dcnr/recreation/where-to-go/state-parks/find-a-park/sinnemahoning-state-park/history",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The George B. Stevenson Dam, completed in 1955, was part of a flood‑control plan for the West Branch Susquehanna River Basin.",
      "sourceSentenceIds": [
        24,
        25
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.pa.gov/agencies/dcnr/recreation/where-to-go/state-parks/find-a-park/sinnemahoning-state-park/history",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Local legend Chauncey “Chance” Logue planted 48 maples in the park’s Day Use Area, a living tribute to early settlers.",
      "sourceSentenceIds": [
