  "facts": [
    {
      "id": 1,
      "text": "Etna was originally called Miller's Settlement, renamed Columbia in 1815, then adopted its current name inspired by distillery chimneys resembling Mount Etna.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/etna_new_york",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The hamlet’s early growth hinged on Fall Creek’s waterpower, which fueled up to twelve distilleries and a reputation for horse racing by the mid‑1800s.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/etna_new_york",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Etna sits about seven miles northeast of Ithaca, along New York State Route 366 near Etna Corners, within the Town of Dryden.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/etna_new_york",
      "category": "transport",
      "quality": "poor",
      "qualityReason": "location_description"
    },
    {
      "id": 4,
      "text": "The First Baptist Church, founded in 1804 and rebuilt in 1830, was remodeled in 1880 and remains a historic landmark in Etna.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/etna_new_york",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Etna’s geology features Devonian shale, siltstone, sandstone, and limestone, giving the area fertile soils that support mixed forests and agriculture.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/etna_new_york",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The Connecticut Hill Wildlife Management Area, part of a 11,000‑acre preserve, borders Etna and shelters deer, turkey, and diverse bird species.",
      "sourceSentenceIds": [
        22
      ],
      "sourceLabels": [
        "Web source 1"
      ],
