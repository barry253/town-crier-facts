  "facts": [
    {
      "id": 1,
      "text": "Madragoa was once a fishermen quarter where fishwives called varinas made the streets lively.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.lisbonportugaltourism.com/guide/madragoa.html",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The neighborhood’s name honors the nuns of the convents that once dotted the area, especially Convento das Bernardas founded 1653.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.lisbonportugaltourism.com/guide/madragoa.html",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The Chafariz da Esperança fountain, built in 1768, survived the 1755 earthquake and still serves as a historic water source.",
      "sourceSentenceIds": [
        22
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.lisbonportugaltourism.com/guide/madragoa.html",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The Marionette Museum, housed in an old convent since 2001, displays nearly 1,000 marionettes from Portugal and abroad.",
      "sourceSentenceIds": [
        24
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.lisbonportugaltourism.com/guide/madragoa.html",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Tile-covered façades began in Madragoa when residents protected their homes from river humidity, sparking a citywide tiling tradition.",
      "sourceSentenceIds": [
        16
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.lisbonportugaltourism.com/guide/madragoa.html",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "In 1928, the Estado Novo government banned barefoot walking in Lisbon, affecting Madragoa’s traditional varinas who walked barefoot.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 2"
      ],
