  "facts": [
    {
      "id": 1,
      "text": "Beulah is recognized as the oldest town in Crook County, tracing its origins back to 1876.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/beulah_wyoming"
    },
    {
      "id": 2,
      "text": "Beulah may have been named after a local schoolteacher or the serene realm described in the book The Pilgrim's Progress.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/beulah_wyoming"
    },
    {
      "id": 3,
      "text": "The town once served as a vital frontier outpost and stage station for mail routes between Spearfish and Sundance.",
      "sourceSentenceIds": [
        11,
        12
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/beulah_wyoming"
    },
    {
      "id": 4,
      "text": "Beulah's growth declined in the 1890s after the Burlington Railroad line shifted freight and stage routes away from the town.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/beulah_wyoming"
    },
    {
      "id": 5,
      "text": "Ranch A is a historic log lodge built in 1932 that originally served as a vacation retreat for a newspaper publisher.",
      "sourceSentenceIds": [
        4,
        5,
        23
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Beulah%2C_Wyoming"
    },
    {
      "id": 6,
      "text": "Vore Buffalo Jump, located just west of Beulah, is a natural sinkhole used by Plains Indian tribes to hunt bison.",
