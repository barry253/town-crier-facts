  "facts": [
    {
      "id": 1,
      "text": "Meridian Village takes its name from the Colorado River, whose Spanish name means 'colored red' because of its sediment.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://the50unitedstates.com/colorado/meridian-village"
    },
    {
      "id": 2,
      "text": "Historically, Meridian Village grew around agriculture and mining, but today its economy is driven by technology, aerospace, renewable energy, and outdoor recreation.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://the50unitedstates.com/colorado/meridian-village"
    },
    {
      "id": 3,
      "text": "The community is part of the Denver–Aurora–Lakewood Metropolitan Statistical Area, linking it to Colorado’s largest urban region.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Meridian_Village%2C_Colorado"
    },
    {
      "id": 4,
      "text": "Meridian Village covers 1,641 acres—about 6.6 square kilometers—entirely land with no bodies of water.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Meridian_Village%2C_Colorado"
    },
    {
      "id": 5,
      "text": "Its geographic coordinates are roughly 39.531°N latitude and 104.8261°W longitude, placing it in Douglas County.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://colorado.hometownlocator.com/co/douglas/meridian-village.cfm"
    },
    {
      "id": 6,
      "text": "As a census-designated place, Meridian Village has no municipal government and relies on county-level administration.",
