      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://the50unitedstates.com/colorado/meridian-village",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Meridian Village covers 1,641 acres—about 6.6 square kilometers—entirely land with no bodies of water.",
