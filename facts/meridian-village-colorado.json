      ],
      "source": "https://the50unitedstates.com/colorado/meridian-village",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Historically, Meridian Village grew around agriculture and mining, but today its economy is driven by technology, aerospace, renewable energy, and outdoor recreation.",
      "sourceSentenceIds": [
