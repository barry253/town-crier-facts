  "facts": [
    {
      "id": 1,
      "text": "Tyrone takes its name from County Tyrone in Ireland.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Tyrone%2C_New_Mexico",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Phelps Dodge founded Tyrone in 1915, building a masterfully planned Mediterranean‑style mining town for nearly 7,000 workers.",
      "sourceSentenceIds": [
        2,
        22
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://unitedstatesghosttowns.com/tyrone-new-mexico-ghost-town/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Tyrone’s design featured white stucco buildings, red‑tiled roofs, and terraced rooflines, echoing coastal villages in Spain.",
      "sourceSentenceIds": [
        4,
        23
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://unitedstatesghosttowns.com/tyrone-new-mexico-ghost-town/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "When copper prices collapsed in 1921, the town emptied and the mine closed, sparking a mass exodus.",
      "sourceSentenceIds": [
        10,
        24
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://unitedstatesghosttowns.com/tyrone-new-mexico-ghost-town/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "During the 1960s, Tyrone’s original townsite was converted into an open‑pit copper mine, erasing most historic buildings.",
      "sourceSentenceIds": [
        11
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://unitedstatesghosttowns.com/tyrone-new-mexico-ghost-town/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Between 1968 and 1972, 320 homes were built in Tyrone, and the mining company divested them in the 1990s, leaving them privately owned today.",
      "sourceSentenceIds": [
        16,
        19
      ],
      "sourceLabels": [
        "Web source 1"
      ],
