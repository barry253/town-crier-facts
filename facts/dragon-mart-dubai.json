      ],
      "source": "https://en.wikipedia.org/wiki/Dragon_Mart",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The complex opened after a $100 million investment and was officially inaugurated by Sheikh Mohammed bin Rashid Al Maktoum on 9 February 2016.",
      "sourceSentenceIds": [
        15,
        17,
        19
      ],
      "sourceLabels": [
