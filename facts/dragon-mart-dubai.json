      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Its layout mirrors a traditional marketplace, with long rows of shops and oriental architecture inspired by Beijing’s Forbidden City.",
      "sourceSentenceIds": [
        5,
