  "facts": [
    {
      "id": 1,
      "text": "Founded in 1810 by Joseph Cahoon of Connecticut, Bay Village keeps a New England feel in its architecture and community life.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.cityofbayvillage.gov/31/Community",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The Huntington water tower, a well‑known landmark, once stored water pumped from Lake Erie to irrigate orchards and vineyards.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.bayhistorical.com/bay-village-history/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Bay Village’s Lakeside Cemetery, founded in 1814, sits on half an acre and is one of the city’s oldest burial grounds.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.bayhistorical.com/bay-village-history/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "In 2020 the Bay Village Historical Society received a grant to digitize 600 early family papers, preserving the town’s heritage.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.bayhistorical.com/bay-village-history/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The city’s first train station, the Nickel Plate Dover station, was located on Dover Center Road beside the railroad tracks.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.bayhistorical.com/bay-village-history/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Bay Village’s name reflects its early settlers’ experience: the area was called the “Firelands” after many homes were lost to war fires.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
