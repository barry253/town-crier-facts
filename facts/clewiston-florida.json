      ],
      "source": "https://en.wikipedia.org/wiki/Clewiston%2C_Florida",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The Clewiston Library houses a Florida room with historical books and recently digitized the local newspaper for the Florida Digital Newspaper Library.",
      "sourceSentenceIds": [
