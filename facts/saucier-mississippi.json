  "facts": [
    {
      "id": 1,
      "text": "The Pierre Phillip Saucier family, descendants of exiled French Canadian Jean Baptiste Saucier, first settled the area in 1848, naming it after their family.",
      "sourceSentenceIds": [
        30
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://thesaucierfamily.weebly.com/the-history-of-saucier-mississippi.html"
    },
    {
      "id": 2,
      "text": "Originally on the now-defunct Gulf & Ship Island Railroad, Saucier opened a money order post office and express office in 1893.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Saucier%2C_Mississippi"
    },
    {
      "id": 3,
      "text": "During World War II, Axis prisoners were held in a POW camp in Saucier.",
      "sourceSentenceIds": [
        18
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Saucier%2C_Mississippi"
    },
    {
      "id": 4,
      "text": "After the war, the camp closed and became a recreation area, leaving only an ammunition bunker ruin.",
      "sourceSentenceIds": [
        19
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Saucier%2C_Mississippi"
    },
    {
      "id": 5,
      "text": "Saucier began desegregating schools 24 years after the 1954 Brown v. Board decision, one of the last towns to integrate.",
      "sourceSentenceIds": [
        21
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Saucier%2C_Mississippi"
    },
    {
      "id": 6,
      "text": "The Armed Forces Museum on the base is open to the public, showcasing military vehicles, weapons, and memorabilia from multiple conflicts.",
