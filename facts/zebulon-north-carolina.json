      ],
      "source": "https://www.visitraleigh.com/plan-a-trip/cities-and-towns/zebulon/",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Zebulon is the easternmost town in Wake County, sitting where the Piedmont meets the Atlantic Coastal Plain.",
      "sourceSentenceIds": [
        11,
        25
      ],
      "sourceLabels": [
