  "facts": [
    {
      "id": 1,
      "text": "Chalfant was named after pioneer Henry Chalfant, an early 19th‑century innkeeper, store owner, and the first postmaster of Turtle Creek Valley.",
      "sourceSentenceIds": [
        1,
        3,
        28
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/chalfant_pennsylvania",
      "category": "people",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The borough incorporated on December 14 1914, separating from Wilkins Township to become its own municipality.",
      "sourceSentenceIds": [
        3,
        6
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/chalfant_pennsylvania",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The Chalfant Steps, a zigzag concrete staircase built in 1936 by the Works Progress Administration, connect hilly neighborhoods with sweeping valley views.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/chalfant_pennsylvania",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Chalfant sits about ten miles east of downtown Pittsburgh, covering just 0.16 square miles of tightly knit residential land.",
      "sourceSentenceIds": [
        26
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/chalfant_pennsylvania",
      "category": "other",
      "quality": "poor",
      "qualityReason": "vague"
    },
    {
      "id": 5,
      "text": "Henry Chalfant owned a 102‑acre estate that later formed the core of the borough, underscoring his foundational influence on local development.",
      "sourceSentenceIds": [
        3,
        4
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/chalfant_pennsylvania",
      "category": "people",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The borough’s community center at 218 North Avenue hosts local events, including sports practices and council meetings, keeping residents connected.",
