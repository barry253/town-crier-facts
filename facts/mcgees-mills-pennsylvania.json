  "facts": [
    {
      "id": 1,
      "text": "McGees Mills earned its name from a gristmill run by Henry Holmes McGee, whose milling operation gave the community its identity.",
      "sourceSentenceIds": [
        18
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/McGees_Mills%2C_Pennsylvania",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town’s founding dates back to 1826, when itinerant Methodist minister James McGee established a sawmill and gristmill along the West Branch of the Susquehanna River.",
      "sourceSentenceIds": [
        16
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/mcgees_mills_pennsylvania",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "In 1873, builders completed the McGees Mills Covered Bridge, the last covered bridge spanning the West Branch Susquehanna and the only one in Clearfield County.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/mcgees_mills_pennsylvania",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The Bell's Gap Railroad reached McGees Mills in 1887, with a station opening by 1893 and linking the village to coal and lumber markets via the Clearfield and Jefferson Railway.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/mcgees_mills_pennsylvania",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "McGees Mills sits at the junction of U.S. Route 219 and Pennsylvania Route 36, about two miles west‑northwest of Mahaffey.",
      "sourceSentenceIds": [
        20
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/McGees_Mills%2C_Pennsylvania",
      "category": "nature",
      "quality": "poor",
      "qualityReason": "location_description"
    },
    {
      "id": 6,
      "text": "Today the village preserves its 19th‑century layout, with frame houses and the historic bridge framing a scenic river backdrop that echoes the era of Pennsylvania lumber.",
      "sourceSentenceIds": [
        11
      ],
      "sourceLabels": [
        "Web source 2"
      ],
