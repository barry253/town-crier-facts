  "facts": [
    {
      "id": 1,
      "text": "Golden Valley Colony began in 1978 as a daughter settlement of Springdale Hutterite Colony, embracing Lehrerleut Anabaptist principles of communal living.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/golden_valley_colony_montana",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The colony sits about five miles south of Ryegate in Golden Valley County, Montana.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/golden_valley_colony_montana",
      "category": "other",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Agriculture remains the colony’s main livelihood, while residents share meals, worship, and education in a tightly knit community.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/golden_valley_colony_montana",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "In 2017, Golden Valley became Montana’s sole Hutterite colony to launch large‑scale non‑agricultural manufacturing, keeping pace with market shifts.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/golden_valley_colony_montana",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The area experiences a semi‑arid continental climate, with cold, snowy winters and warm, dry summers.",
      "sourceSentenceIds": [
        27
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/golden_valley_colony_montana",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "When the community grows to about 130‑150 members, Golden Valley splits, following a long‑standing Anabaptist tradition of colony division.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Web source 1"
