  "facts": [
    {
      "id": 1,
      "text": "Hamilton was named after Artois Hamilton, a local landowner whose early involvement helped shape the town’s founding.",
      "sourceSentenceIds": [
        2,
        6
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Hamilton%2C_Illinois",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town was laid out in 1852 by Samuel Gordon and others, who donated a 160‑acre tract for its development.",
      "sourceSentenceIds": [
        5,
        13
      ],
      "sourceLabels": [
        "Web source 1",
        "Wikipedia"
      ],
      "source": "https://hamiltonillinois.org/history/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "In 1871 a single‑deck bridge was built over the Mississippi, becoming the longest covered bridge in Illinois at 169 feet.",
      "sourceSentenceIds": [
        7,
        8
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://hamiltonillinois.org/history/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Hamilton shares Lock & Dam 19 with Keokuk, a key Mississippi River structure that supplies much of the region’s electricity.",
      "sourceSentenceIds": [
        15
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Hamilton%2C_Illinois",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Lake Cooper, created above the dam, stretches the widest span of the Mississippi between Montrose, IA and Nauvoo, IL.",
      "sourceSentenceIds": [
        17
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Hamilton%2C_Illinois",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The community was officially incorporated as a town in 1854 and re‑incorporated as a city in 1859.",
      "sourceSentenceIds": [
        14
      ],
      "sourceLabels": [
