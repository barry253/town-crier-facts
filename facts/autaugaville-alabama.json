  "facts": [
    {
      "id": 1,
      "text": "William Thompson, the first settler, built a gristmill and sawmill on Swift Creek around 1820, sparking the town’s early growth.",
      "sourceSentenceIds": [
        21,
        9
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 2"
      ],
      "source": "https://en.wikipedia.org/wiki/Autaugaville%2C_Alabama"
    },
    {
      "id": 2,
      "text": "A cotton mill opened in 1849 on Swift Creek, and its owner constructed housing for workers, turning Autaugaville into a modest industrial hub.",
      "sourceSentenceIds": [
        23
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Autaugaville%2C_Alabama"
    },
    {
      "id": 3,
      "text": "After a downtown fire in 1853, the town was quickly rebuilt and the Autauga Citizen newspaper began publishing the same year.",
      "sourceSentenceIds": [
        24,
        25
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Autaugaville%2C_Alabama"
    },
    {
      "id": 4,
      "text": "The town incorporated in 1907, and the Alabama Central Railroad built a branch through Autaugaville in 1911, linking it to regional trade.",
      "sourceSentenceIds": [
        8,
        10
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 2"
      ],
      "source": "https://en.wikipedia.org/wiki/Autaugaville%2C_Alabama"
    },
    {
      "id": 5,
      "text": "Blues legend George \"Wild Child\" Butler was born in Autaugaville, adding a musical note to the town’s heritage.",
