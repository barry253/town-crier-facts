  "facts": [
    {
      "id": 1,
      "text": "Chandler Park was named for Zachariah Chandler, Detroit’s most famous abolitionist and a leading 19th‑century politician.",
      "sourceSentenceIds": [
        5,
        27
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.detroit1701.org/Chandler%20Park.html"
    },
    {
      "id": 2,
      "text": "The park’s borders run roughly from Frankfort Street in the south to Olga Street in the north, with Dickerson Avenue on the east and Conner Street on the west.",
      "sourceSentenceIds": [
        17
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.detroit1701.org/Chandler%20Park.html"
    },
    {
      "id": 3,
      "text": "Before becoming part of Detroit, the land that is now Chandler Park belonged to Grosse Pointe Township until the city annexed it in 1917.",
      "sourceSentenceIds": [
        18
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.detroit1701.org/Chandler%20Park.html"
    },
    {
      "id": 4,
      "text": "After World War I, Detroit earmarked Chandler Park for development, making it one of the city’s first major park projects.",
      "sourceSentenceIds": [
        26
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.detroit1701.org/Chandler%20Park.html"
    },
    {
      "id": 5,
      "text": "Wayne County opened a large aquatic center in Chandler Park in 1998, a facility that remains well‑maintained today.",
      "sourceSentenceIds": [
        30
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.detroit1701.org/Chandler%20Park.html"
    },
    {
      "id": 6,
      "text": "Chandler Park covers about 201 acres, making it one of Detroit’s larger municipal parks.",
      "sourceSentenceIds": [
        17
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.detroit1701.org/Chandler%20Park.html"
