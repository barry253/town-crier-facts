  "facts": [
    {
      "id": 1,
      "text": "Tarpey Village takes its name from Patrick Tarpey, an Irish immigrant who opened a stagecoach stop on the route to Yosemite in the 1860s.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.trawellino.com/destinations/united-states/california_tarpey-village",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The historic Tarpey Depot, built in 1892 on the ranch, handled freight, passengers, and a post office before relocating to Old Town Clovis in the 20th century.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/tarpey_village_california",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "A 26‑mile San Joaquin Valley Railroad line, constructed in 1891 from Fresno to Friant, ran through Tarpey before being sold to Southern Pacific in 1893.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/tarpey_village_california",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Tarpey Elementary School opened in 1958 to accommodate a growing population, a response to overcrowding in local schools during the post‑war boom.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/tarpey_village_california",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The aviation industry spurred further residential growth in Tarpey, shifting the area’s economy and demographics toward suburban living.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/tarpey_village_california",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Tarpey Village sits at an elevation of 351 feet, giving it a modest rise above the surrounding San Joaquin Valley plains.",
      "sourceSentenceIds": [
        12
