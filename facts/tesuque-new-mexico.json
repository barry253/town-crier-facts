  "facts": [
    {
      "id": 1,
      "text": "The Pueblo of Tesuque dates back to at least 1200 AD, making it one of the oldest continuously inhabited sites in the region.",
      "sourceSentenceIds": [
        25,
        30
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.tesuquepueblo.org/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The name Tesuque comes from a Tewa word meaning 'village of the narrow place of the cottonwood trees,' reflecting the area's natural features.",
      "sourceSentenceIds": [
        26
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.tesuquepueblo.org/",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The Pueblo was abandoned after the Pueblo Revolt of 1680, but the current community reestablished itself in the 18th century.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.tesuquepueblo.org/history",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Tesuque is listed on the National Register of Historic Places, recognizing its cultural and historical significance.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.tesuquepueblo.org/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The town has inspired writers and artists, appearing in novels such as Aldous Huxley's 'Brave New World' and being the setting for Michael Tobias's 'The Adventures of Marigold'.",
      "sourceSentenceIds": [
        18,
        20
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Tesuque%2C_New_Mexico",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Photography is prohibited inside the Pueblo, preserving its sacred spaces and historic architecture.",
      "sourceSentenceIds": [
        29
