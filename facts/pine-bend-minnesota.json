  "facts": [
    {
      "id": 1,
      "text": "Pine Bend’s name comes from a bend in the Mississippi where tall white pines once stood, a detail noted in 1915 accounts.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/pine_bend_minnesota",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Pine Bend once hosted a Dakota Sioux village led by Chief Medicine Bottle in the mid‑19th century before treaties relocated the band.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/pine_bend_minnesota",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The Pine Bend Bluffs cover 1,300 acres of oak savannas, tall‑grass prairies, wetlands, and towering white pines, supporting endangered species like the rusty‑patched bumblebee.",
      "sourceSentenceIds": [
        14
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/pine_bend_minnesota",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Pine Bend Refinery, operated by Flint Hills Resources, is Minnesota’s largest oil processing plant, handling 375,000 barrels per day.",
      "sourceSentenceIds": [
        15
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/pine_bend_minnesota",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The refinery’s 45‑megawatt solar project, completed in 2023, is the largest single‑user solar installation in the United States.",
      "sourceSentenceIds": [
        16
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/pine_bend_minnesota",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Pine Bend’s bluffs rise up to 200 feet above the Mississippi, a dramatic feature formed by glacial and post‑glacial processes over the last 8,000 years.",
      "sourceSentenceIds": [
        22
      ],
      "sourceLabels": [
        "Web source 1"
      ],
