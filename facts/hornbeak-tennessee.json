    {
      "id": 1,
      "text": "Hornbeak was originally settled in the 1870s as Wilsonville.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Hornbeak%2C_Tennessee",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town was renamed Hornbeak in 1887 after Frank Hornbeak, a local store owner who also served as postmaster.",
      "sourceSentenceIds": [
        9,
        18
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Hornbeak%2C_Tennessee",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "A school began in 1854 near what locals call \"old Center Cemetery\" south of modern Hornbeak, operating until 1885.",
      "sourceSentenceIds": [
        7,
        8
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Hornbeak%2C_Tennessee",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Hornbeak was incorporated in 1916, solidifying its status within Obion County.",
      "sourceSentenceIds": [
        19
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://obioncounty.org/live/major-towns/hornbeak",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The town lies in northwestern Tennessee, about 15 miles southeast of the Kentucky border and northeast of Reelfoot Lake.",
      "sourceSentenceIds": [
