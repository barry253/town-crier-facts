  "facts": [
    {
      "id": 1,
      "text": "Quitman was founded in 1839 and named after Mississippi’s second state chancellor.",
      "sourceSentenceIds": [
        2,
        3
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Quitman%2C_Mississippi",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "During the Civil War, Quitman hosted the Texas Hospital, built with funds from Galveston and Houston to treat Confederate soldiers from Texas.",
      "sourceSentenceIds": [
        15,
        16
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Quitman%2C_Mississippi",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "In 1864, Union troops burned the Texas Hospital complex, including its main buildings and barracks, and the town’s courthouse and railroad depot.",
      "sourceSentenceIds": [
        6,
        19
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Quitman%2C_Mississippi",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The town later became a backdrop for the Civil Rights Movement’s struggles and triumphs.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://quitmancountyms.org/visit/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The Chickasawhay River runs through Quitman, and during the war Union forces destroyed bridges over it to hinder Confederate supply lines.",
      "sourceSentenceIds": [
        14,
        18
      ],
