  "facts": [
    {
      "id": 1,
      "text": "Emporia, Virginia got its name from Emporia, Kansas, the hometown of Benjamin Tillar, a Virginia House of Delegates member.",
      "sourceSentenceIds": [
        3,
        4
      ],
      "sourceLabels": [
        "Web source 1",
        "Wikipedia"
      ],
      "source": "https://www.ci.emporia.va.us/300/About-Emporia",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "In 1887, Emporia sprang to life when the towns of Hicksford and Belfield merged into a single city.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.ci.emporia.va.us/300/About-Emporia",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "During the Civil War, the Petersburg Railroad ran through Emporia, becoming a strategic target as Union forces tried to cut off Richmond.",
      "sourceSentenceIds": [
        10,
        11
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Emporia%2C_Virginia",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Today, Emporia sits where a CSX north–south line meets a former Norfolk Southern east–west track, echoing its historic crossroads role.",
      "sourceSentenceIds": [
        16
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Emporia%2C_Virginia",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Three landmarks—Klugel Architectural Sheet Metal Work Building, Old Merchants and Farmers Bank Building, and Village View—are listed on the National Register of Historic Places.",
      "sourceSentenceIds": [
