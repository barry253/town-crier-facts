  "facts": [
    {
      "id": 1,
      "text": "Pine Village grew from a trading post that may have been named after a lone pine tree on Pine Creek’s bluff or simply after the creek itself.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Pine_Village%2C_Indiana",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Rail service reached Pine Village in the 1870s, and the Chicago, Attica and Southern Railroad—once called the Coal Road—was abandoned and its tracks removed by 1945.",
      "sourceSentenceIds": [
        6,
        7,
        8,
        26
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Pine_Village%2C_Indiana",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The Pine Village post office has been serving residents continuously since 1854, operating for over a century.",
      "sourceSentenceIds": [
        21
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Pine_Village%2C_Indiana",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Pine Village sits at the crossroads of State Road 55 and State Road 26, about 20 miles west of Lafayette and 14 miles east of Illinois.",
      "sourceSentenceIds": [
        28,
        29
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Pine_Village%2C_Indiana",
      "category": "other",
      "quality": "poor",
      "qualityReason": "location_description"
    },
    {
      "id": 5,
      "text": "The Methodist Church, standing since before Pine Village’s founding, predates the town’s layout by several years.",
      "sourceSentenceIds": [
        20
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Pine_Village%2C_Indiana",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "East of Pine Village, a grain elevator and homes once formed a small community called Oklahoma.",
