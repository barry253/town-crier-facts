  "facts": [
    {
      "id": 1,
      "text": "Columbus was platted by Lewis Ludington in 1844, laying out nine downtown lots that became the village core.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://columbuswiareahistory.com/?page_id=105",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Elbert Dickason invested $10,000 of his own money to build a sawmill and later a grist‑flour mill, sparking the town’s early industry.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://columbuswiareahistory.com/?page_id=105",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The Farmers and Merchants Union Bank, designed by Louis Sullivan in 1919‑20, stands as a nationally recognized Prairie School landmark in Columbus.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Columbus%2C_Wisconsin",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Columbus hosts the primary Amtrak station for the Madison metro area, with daily Empire Builder and Borealis trains stopping there.",
      "sourceSentenceIds": [
        21
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Columbus%2C_Wisconsin",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The Crawfish River, which flows through Columbus, was a vital trade route for the Ho‑Chunk Nation before European settlement.",
      "sourceSentenceIds": [
        27,
        28
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Columbus%2C_Wisconsin",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Historic downtown Columbus, preserved by the Columbus Historic Landmark Preservation Commission and the Columbus Historical Society, showcases many 19th‑century homes and businesses.",
