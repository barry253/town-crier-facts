  "facts": [
    {
      "id": 1,
      "text": "Farwell sprang up when the Minneapolis and Pacific Railway, the Soo Line predecessor, built a line through the area in 1886 and platted the town around its station.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Farwell%2C_Minnesota",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town was officially platted a year later, in 1887, marking its formal establishment.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Farwell%2C_Minnesota",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "A post office opened in Farwell in 1887 and operated until 1998, after which the city entered a community post office arrangement with the U.S. Postal Service.",
      "sourceSentenceIds": [
        9,
        10
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Farwell%2C_Minnesota",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The town’s name may trace back to Charles Hammond’s wife, whose maiden name was Farwell, giving the village a personal touch.",
