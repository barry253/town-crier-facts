  "facts": [
    {
      "id": 1,
      "text": "Desert View Watchtower was designed in 1932 by Mary Colter to resemble an Ancestral Puebloan watchtower, yet its 70‑foot height dwarfs any known Pueblan tower.",
      "sourceSentenceIds": [
        22,
        17,
        19
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Desert_View_Watchtower",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The tower’s base was intentionally built to look like a ruin, giving the impression of an ancient structure that later housed the observation deck.",
      "sourceSentenceIds": [
        25,
        24
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Desert_View_Watchtower",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Inside the Kiva Room, murals painted by Hopi artist Fred Kabotie adorn the ceiling, a collaboration between Colter and Native artists.",
      "sourceSentenceIds": [
        20,
        8
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 2"
      ],
      "source": "https://en.wikipedia.org/wiki/Desert_View_Watchtower",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Located more than 20 miles east of Grand Canyon Village, Desert View offers one of the widest panoramic views of the canyon’s eastern rim.",
      "sourceSentenceIds": [
        18
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Desert_View_Watchtower",
      "category": "nature",
      "quality": "poor",
      "qualityReason": "location_description"
    },
    {
      "id": 5,
      "text": "The watchtower was the last of Mary Colter’s visitor concession buildings at the Grand Canyon until she renovated Bright Angel Lodge in 1935.",
      "sourceSentenceIds": [
        21
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Desert_View_Watchtower",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The structure sits on a rubble base that was originally part of the old Grandview Hotel, whose salvaged logs were reused for the Kiva Room roof.",
      "sourceSentenceIds": [
        27
      ],
