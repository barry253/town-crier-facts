  "facts": [
    {
      "id": 1,
      "text": "Grover began as a post office called Point of Rocks in the late 1800s, serving ranches north of present town.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://history.weld.gov/County-150/Your-Stories/Point-of-Rocks-Grover"
    },
    {
      "id": 2,
      "text": "The town was officially plotted on Nov 10 1888 after a railroad survey, and the Burlington Railroad ran through from 1887 to 1973.",
      "sourceSentenceIds": [
        8,
        9,
        10
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://history.weld.gov/County-150/Your-Stories/Point-of-Rocks-Grover"
    },
    {
      "id": 3,
      "text": "Dolly Donovan, the first white woman in the area, gave the town its name when the post office moved into her ranch house.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://history.weld.gov/County-150/Your-Stories/Point-of-Rocks-Grover"
    },
    {
      "id": 4,
      "text": "The original Grover Depot, built in 1889, still stands and now houses a museum.",
      "sourceSentenceIds": [
        30
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://history.weld.gov/County-150/Your-Stories/Point-of-Rocks-Grover"
    },
    {
      "id": 5,
      "text": "Grover sits at 40°52′6″N 104°13′34″W, placing it in the heart of the Front Range Urban Corridor.",
