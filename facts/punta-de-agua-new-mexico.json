  "facts": [
    {
      "id": 1,
      "text": "Punta de Agua means 'point of water' in Spanish, named for a historic spring that sustained local agriculture.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/punta_de_agua_new_mexico",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The late 19th century saw gradual homesteading under the Homestead Act, but the arrival of the New Mexico Central Railroad around 1903 sparked a significant influx.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/punta_de_agua_new_mexico",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The Quarai unit of Salinas Pueblo Missions National Monument lies within Punta de Agua’s southwest, preserving 17th‑century church ruins that echo early Spanish missionary efforts.",
      "sourceSentenceIds": [
        11
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Punta_de_Agua%2C_New_Mexico",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Punta de Agua sits at about 6,700 feet on the eastern slopes of the Manzano Mountains, between the Rio Grande Valley and the Estancia Valley basin.",
      "sourceSentenceIds": [
        24
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/punta_de_agua_new_mexico",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The area overlies Quaternary valley fill deposits of sand, gravel, silt, and clay, creating sandy clay soils that characterize the basin’s agriculture.",
      "sourceSentenceIds": [
        26
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/punta_de_agua_new_mexico",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Punta de Agua emphasizes preserving its natural landscape and traditional farming, serving as a quiet base for hiking and birdwatching in the Manzano Mountain Wilderness.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Web source 1"
      ],
