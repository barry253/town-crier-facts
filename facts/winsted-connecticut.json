  "facts": [
    {
      "id": 1,
      "text": "Winsted, settled in 1750, grew into one of Connecticut’s first mill towns at the junction of the Still and Mad Rivers.",
      "sourceSentenceIds": [
        20
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Winsted%2C_Connecticut",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The Gilbert Clock Company, founded in 1871 along the Still River, became one of the world’s largest clock makers by the early 1900s.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Winsted%2C_Connecticut",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "In 1858 Winsted was incorporated as a borough, later becoming a city in 1917, its name blending Winchester and Barkhamsted.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.britannica.com/place/Winsted",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "After a 2004 renovation, the former factory mill earned Yankee Magazine’s 2016 title of Best Artists’ Community in Connecticut.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Winsted%2C_Connecticut",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Beardsley Library, the town’s public library, was established thanks to Eliot Beardsley’s $10,000 donation in the early 20th century.",
      "sourceSentenceIds": [
