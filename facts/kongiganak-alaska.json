    },
    {
      "id": 2,
      "text": "The original Kongiganak settled in the 19th century on a small creek just above Kuskokwim Bay.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Kongiganak%2C_Alaska"
    },
    {
      "id": 3,
      "text": "The current settlement was permanently moved in the 1960s by former residents of Kwigillingok seeking higher ground to escape floods.",
      "sourceSentenceIds": [
        14
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Kongiganak%2C_Alaska"
    },
    {
      "id": 4,
      "text": "Kongiganak's school is named after an elder who helped start the first school in the community.",
