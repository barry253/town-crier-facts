      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Each summer, Stanton Heights hosts a Fun Festival that brings residents together for music, food, and games.",
      "sourceSentenceIds": [
        17
      ],
      "sourceLabels": [
