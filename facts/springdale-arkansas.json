      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Springdale’s historic railroad offers round‑trip excursions on restored 1920s‑1950s cars, winding through the Boston Mountains and the Winslow Tunnel.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Web source 2"
