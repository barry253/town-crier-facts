  "facts": [
    {
      "id": 1,
      "text": "Clemson was originally named Calhoun, a settlement that developed around the railroad tracks to support agricultural growth.",
      "sourceSentenceIds": [
        1,
        16
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 2"
      ],
      "source": "https://en.wikipedia.org/wiki/Clemson%2C_South_Carolina"
    },
    {
      "id": 2,
      "text": "European Americans settled in Clemson after the Cherokee were forced to cede their land in 1819.",
      "sourceSentenceIds": [
        18
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Clemson%2C_South_Carolina"
    },
    {
      "id": 3,
      "text": "Clemson University was founded in 1889 as an agricultural college on the former Fort Hill Plantation.",
      "sourceSentenceIds": [
        21,
        26
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Clemson%2C_South_Carolina"
    },
    {
      "id": 4,
      "text": "The town was renamed to Clemson in 1943 to reflect its identification with the adjacent university.",
      "sourceSentenceIds": [
        22
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Clemson%2C_South_Carolina"
    },
    {
      "id": 5,
      "text": "Fort Hill is one of the most photographed landmarks in Clemson and sits on a hill overlooking Bowman Field.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://discoversouthcarolina.com/clemson"
    },
    {
      "id": 6,
      "text": "The village of Clemson was originally settled in 1872, chartered in 1892, and incorporated in 1937.",
      "sourceSentenceIds": [
