  "facts": [
    {
      "id": 1,
      "text": "Homestead Valley lies in the southern Mojave Desert, just north of the San Bernardino Mountains foothills.",
      "sourceSentenceIds": [
        11
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://countywideplan.sbcounty.gov/community/east-desert-unincorporated/homestead-valley-communities/",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Residents prize a rural desert lifestyle, with wide open spaces, unpaved roads, and dark night skies that feel like a private sky gallery.",
      "sourceSentenceIds": [
        26
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://countywideplan.sbcounty.gov/community/east-desert-unincorporated/homestead-valley-communities/",
      "category": "culture",
      "quality": "poor",
      "qualityReason": "editorial_filler"
    },
    {
      "id": 3,
      "text": "The community’s spirit is built on rugged individualism, valuing self‑sufficiency, privacy, and the freedom to live on one’s own terms.",
      "sourceSentenceIds": [
        27
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://countywideplan.sbcounty.gov/community/east-desert-unincorporated/homestead-valley-communities/",
      "category": "culture",
      "quality": "poor",
      "qualityReason": "editorial_filler"
    },
    {
      "id": 4,
      "text": "In 2016, Homestead Valley launched a new community plan, holding public workshops on September 12 and November 17 to shape its future.",
      "sourceSentenceIds": [
        2,
        3
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://countywideplan.sbcounty.gov/community/east-desert-unincorporated/homestead-valley-communities/",
      "category": "other",
      "quality": "poor",
      "qualityReason": "vague"
    },
    {
      "id": 5,
      "text": "Homestead Valley encompasses the communities of Landers, Flamingo Heights, Johnson Valley, and Yucca Mesa, each sharing the same desert character.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://countywideplan.sbcounty.gov/community/east-desert-unincorporated/homestead-valley-communities/",
      "category": "other",
      "quality": "poor",
      "qualityReason": "vague"
    },
    {
      "id": 6,
      "text": "The Community Action Guide, created from workshop input, serves as a practical framework to implement the community’s shared goals and policies.",
      "sourceSentenceIds": [
        6,
