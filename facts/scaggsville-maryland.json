  "facts": [
    {
      "id": 1,
      "text": "Scaggsville gets its name from the Scaggs family, who settled 700 acres in the 1830s and still live in the area.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Scaggsville%2C_Maryland"
    },
    {
      "id": 2,
      "text": "In the 19th century, Scaggsville was a stagecoach stop between Washington, D.C., and Baltimore, with coaches fording the Patuxent River until a wooden bridge appeared in 1859.",
      "sourceSentenceIds": [
        12,
        13
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Scaggsville%2C_Maryland"
    },
    {
      "id": 3,
      "text": "The historic path through town, shown on maps as early as 1795, later became known as Lime Kiln Road, Scaggsville Road, and Whiskey Bottom Road.",
      "sourceSentenceIds": [
        2,
        3
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Scaggsville%2C_Maryland"
    },
    {
      "id": 4,
      "text": "The Patuxent River borders Scaggsville’s southern edge and also marks the Howard County line.",
      "sourceSentenceIds": [
        17
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Scaggsville%2C_Maryland"
    },
    {
      "id": 5,
      "text": "Scaggsville sits near the Rocky Gorge Reservoir on the Patuxent River, a quiet base for exploring Chesapeake history.",
      "sourceSentenceIds": [
        28,
        29
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Scaggsville%2C_Maryland"
    },
    {
      "id": 6,
      "text": "From a stagecoach stop to a suburban community, Scaggsville now hosts several neighborhoods while remaining largely residential with a few commercial spots.",
      "sourceSentenceIds": [
        10,
        15
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Scaggsville%2C_Maryland"
    }
  ]
