      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Gold first struck Diamond Creek in 1863, and the mine later yielded between £1,000,000 and £2,000,000 Australian at the time.",
      "sourceSentenceIds": [
        19,
        21
      ],
      "sourceLabels": [
