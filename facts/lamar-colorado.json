  "facts": [
    {
      "id": 1,
      "text": "Lamar was founded May 24 1886 by Issac Holmes and named after Secretary of Interior Lucius Quintus Cincinnatus Lamar II.",
      "sourceSentenceIds": [
        6,
        7,
        8
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Lamar%2C_Colorado",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town grew around a single railroad; the historic downtown is housed in a former railroad depot that was moved three miles west in 1886.",
      "sourceSentenceIds": [
        3,
        2
      ],
      "sourceLabels": [
        "Web source 2",
        "Web source 1"
      ],
      "source": "https://www.uncovercolorado.com/towns/lamar/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Lamar hosts the Lamar Amtrak Station, where the Southwest Chief connects the city to Chicago and Los Angeles.",
      "sourceSentenceIds": [
        20
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Lamar%2C_Colorado",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The historic main street features the Petrified Wood Gas Station, a local tire shop built from fossilized wood found thirty miles south.",
      "sourceSentenceIds": [
        22,
        23
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.uncovercolorado.com/towns/lamar/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Lamar is a premier birding hotspot, with over 400 species passing through each year along the Arkansas River corridor.",
      "sourceSentenceIds": [
        15,
        17
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.uncovercolorado.com/towns/lamar/",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The city is the county seat of Prowers County and the largest municipality in southeastern Colorado, established as the county seat in 1889.",
      "sourceSentenceIds": [
