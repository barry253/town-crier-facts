  "facts": [
    {
      "id": 1,
      "text": "Waterloo was named after Napoleon's 1815 defeat, thanks to founder Bumpass in the early 19th century.",
      "sourceSentenceIds": [
        20,
        1
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 2"
      ],
      "source": "https://en.wikipedia.org/wiki/Waterloo%2C_Alabama"
    },
    {
      "id": 2,
      "text": "In the 1930s, the Tennessee Valley Authority flooded the original town, moving Waterloo inland to its current spot.",
      "sourceSentenceIds": [
        14,
        16
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Waterloo%2C_Alabama"
    },
    {
      "id": 3,
      "text": "Waterloo sits on the north shore of Pickwick Lake, a reservoir created by the Pickwick Landing Dam.",
      "sourceSentenceIds": [
        22
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Waterloo%2C_Alabama"
    },
    {
      "id": 4,
      "text": "Second Creek empties into Pickwick Lake at Waterloo, forming a small inlet that once fed the town’s early industry.",
      "sourceSentenceIds": [
        23
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Waterloo%2C_Alabama"
    },
    {
      "id": 5,
      "text": "Waterloo was originally founded on the northern bank at the confluence of Second Creek, opposite Riverton, a former Southern Railway terminus.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://waterloohistory.com/history"
    },
    {
      "id": 6,
      "text": "The Edith Newman Culver Museum, housed in an 1872 historic home, showcases Waterloo’s local and regional history.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://encyclopediaofalabama.org/article/waterloo/"
