  "facts": [
    {
      "id": 1,
      "text": "Mission, Texas was founded in 1907 when John J. founded the settlement that would become the city.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.tshaonline.org/handbook/entries/mission-tx"
    },
    {
      "id": 2,
      "text": "The town’s name comes from the historic La Lomita Mission, which still stands and welcomes visitors each year.",
      "sourceSentenceIds": [
        1,
        14
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.missiontexas.us/287/History-of-Mission"
    },
    {
      "id": 3,
      "text": "In 1908 the Missouri Pacific Railroad built a station near Mission’s center, sparking rapid growth in the area.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.missiontexas.us/287/History-of-Mission"
    },
    {
      "id": 4,
      "text": "Mission’s citrus growers celebrate their harvest with the multimillion‑dollar Texas Citrus Fiesta, drawing guests from both sides of the Rio Grande.",
      "sourceSentenceIds": [
        14
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.missiontexas.us/287/History-of-Mission"
    },
    {
      "id": 5,
      "text": "The Mission Times newspaper began as the Missionate in October 1909, becoming a long‑running local voice.",
      "sourceSentenceIds": [
        11
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.tshaonline.org/handbook/entries/mission-tx"
    },
    {
      "id": 6,
      "text": "Ann Voltz, a local resident, suggested naming the new town Mission after the nearby La Lomita Mission.",
