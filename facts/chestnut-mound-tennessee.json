  "facts": [
    {
      "id": 1,
      "text": "Chestnut Mound earned its name from a prominent hill blanketed in American chestnut trees that once crowned the local landscape.",
      "sourceSentenceIds": [
        2,
        26
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/chestnut_mound_tennessee",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The community’s post office opened in 1855, officially recognizing Chestnut Mound as a distinct rural settlement in Smith County.",
      "sourceSentenceIds": [
        1,
        28
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/chestnut_mound_tennessee",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Chestnut Mound once served as the terminus of the Trousdale Ferry Pike, a stagecoach route that crossed the Caney Fork River by ferry.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/chestnut_mound_tennessee",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Nestled on Smith County’s eastern ridge, Chestnut Mound sits between the Nashville Basin and the Highland Rim, where hills rise from river valleys.",
      "sourceSentenceIds": [
        17
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/chestnut_mound_tennessee",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Early 19th‑century settlers, mainly Scots‑Irish, English, and German from North Carolina, arrived via the Walton Road and cleared farms along the Caney Fork.",
      "sourceSentenceIds": [
        23
      ],
