  "facts": [
    {
      "id": 1,
      "text": "Troupsburg was founded on February 12, 1808, carved from parts of Canisteo and Addison, and was first spelled Troupsburgh.",
      "sourceSentenceIds": [
        5,
        11
      ],
      "sourceLabels": [
        "Web source 2",
        "Wikipedia"
      ],
      "source": "https://grokipedia.com/page/troupsburg_new_york",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town honors Robert Troup, a Revolutionary War colonel, federal judge, and chief land agent for the Pulteney Estate.",
      "sourceSentenceIds": [
        2,
        7,
        13
      ],
      "sourceLabels": [
        "Web source 2",
        "Wikipedia"
      ],
      "source": "https://grokipedia.com/page/troupsburg_new_york",
      "category": "people",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Rice, a Connecticut native, built the first homestead in 1805, sparking European-American settlement in the hilly uplands.",
      "sourceSentenceIds": [
        3,
        10
      ],
      "sourceLabels": [
        "Web source 2",
        "Wikipedia"
      ],
      "source": "https://grokipedia.com/page/troupsburg_new_york",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Troupsburg sits higher than any other town in Steuben County, giving it a distinctive hilltop character.",
      "sourceSentenceIds": [
        20
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Troupsburg%2C_New_York",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The town’s western edge follows the Genesee River while its eastern boundary meets Seneca Lake, tracing the old Pulteney Estate.",
      "sourceSentenceIds": [
        14,
        15
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Troupsburg%2C_New_York",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "After adding land from Canisteo in 1818, Troupsburg later ceded portions to Greenwood, Jasper, and Woodhull between 1827 and 1828.",
      "sourceSentenceIds": [
        17,
        18
      ],
