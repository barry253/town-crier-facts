  "facts": [
    {
      "id": 1,
      "text": "Carter Lake got its name from the oxbow lake formed when the Missouri River’s old course, Saratoga Bend, was cut off.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Carter_Lake%2C_Iowa"
    },
    {
      "id": 2,
      "text": "Carter Lake is Iowa’s sole city situated west of the Missouri River, making it an exclave.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://cityofcarterlake.com/about-carter-lake/"
    },
    {
      "id": 3,
      "text": "In 1892, the U.S. Supreme Court ruled Carter Lake belonged to Iowa after a dispute over the river’s sudden shift.",
      "sourceSentenceIds": [
        10,
        11
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Carter_Lake%2C_Iowa"
    },
    {
      "id": 4,
      "text": "Early 20th-century Carter Lake hosted two amusement parks—Courtland Beach (1905‑1917) and Lakeview (1917‑1933)—drawing river‑front crowds.",
      "sourceSentenceIds": [
        17,
        18
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Carter_Lake%2C_Iowa"
    },
    {
      "id": 5,
      "text": "During the 1930s and ’40s, Carter Lake became a gambling hub, with venues like the Chez Paree offering horse‑race betting and prime‑rib meals.",
      "sourceSentenceIds": [
        20,
        21
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Carter_Lake%2C_Iowa"
    },
    {
      "id": 6,
      "text": "Carter Lake is almost encircled by Omaha, Nebraska, with the Missouri River forming its fourth boundary.",
