  "facts": [
    {
      "id": 1,
      "text": "Carter Lake got its name from the oxbow lake formed when the Missouri River’s old course, Saratoga Bend, was cut off.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
