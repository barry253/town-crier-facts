    {
      "id": 1,
      "text": "The name 'The Plains' comes from the area where the Adena mound builders lived and built their signature Indian mounds.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/The_Plains%2C_Ohio",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Nearly 25 Native American burial mounds were identified here, and the complex is listed on the National Register of Historic Places.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/The_Plains%2C_Ohio",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The Hartman Mound on Mound Street is the largest mound still visible in The Plains.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.athensnews.com/news/local/it-s-worth-remembering-the-plains-owns-special-legacy/article_895599cc-45bc-11e9-8940-7f5b72c1a2a6.html",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The Plains hosts a public library that is a branch of the Athens County Public Libraries.",
      "sourceSentenceIds": [
        22
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/The_Plains%2C_Ohio",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "A nature preserve was recently created by the Athens Conservancy, and an extension of the Hockhocking Adena Bikeway will traverse it.",
