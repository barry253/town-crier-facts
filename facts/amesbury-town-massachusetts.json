      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town’s name shifted from New Salisbury to Amesbury in 1667, echoing Amesbury, England, which sits next to Salisbury.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Wikipedia"
