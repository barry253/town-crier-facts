    },
    {
      "id": 2,
      "text": "During colonial times, the area north of the city limits was called 'Northern Liberties'.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://philadelphia.wiki/a/Northern_Liberties"
    },
    {
      "id": 3,
      "text": "Schmidt's Brewery, founded in 1860, grew to be Philadelphia's largest employer before closing in 1987.",
      "sourceSentenceIds": [
