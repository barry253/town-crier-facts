  "facts": [
    {
      "id": 1,
      "text": "Saint Michaels got its name in 1897 when Anselm Weber renamed the area after the nearby Franciscan mission, drawing from the Navajo term Tsʼíhootso.",
      "sourceSentenceIds": [
        14
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/St._Michaels%2C_Arizona"
    },
    {
      "id": 2,
      "text": "In 1898 Franciscan friars established Michael's Mission, the first permanent Catholic mission to the Navajo, aiming to teach doctrine and education.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/st_michaels_arizona"
    },
    {
      "id": 3,
      "text": "The community sits on the western edge of Black Creek Valley, a north‑flowing tributary that joins the Rio Puerco downstream.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/St._Michaels%2C_Arizona"
    },
    {
      "id": 4,
      "text": "Saint Michael Indian School, a K‑12 Catholic institution founded by Saint Katharine Drexel in 1902, remains a cornerstone of local education.",
      "sourceSentenceIds": [
        30
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/St._Michaels%2C_Arizona"
    },
    {
      "id": 5,
      "text": "Construction of the Franciscan Mission began in 1896, funded by a local reverend.",
