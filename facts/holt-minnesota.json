      "id": 1,
      "text": "Holt became an official city on March 16, 1915, after evolving from Holt Township founded in 1890.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/holt_minnesota",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town’s name honors Norwegian pioneer Halvor Holte, whose arrival in 1886 inspired the anglicized spelling.",
      "sourceSentenceIds": [
        28
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/holt_minnesota",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Scandinavian settlers shaped Holt’s culture, giving the area a distinct Norwegian heritage that still echoes today.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/holt_minnesota",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Pioneers began farming in Holt during the 1880s homesteading boom, clearing prairie for wheat and other crops.",
      "sourceSentenceIds": [
        6,
        27
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/holt_minnesota",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The Great Northern Railway’s arrival brought rail service to Holt, linking the town to regional markets.",
      "sourceSentenceIds": [
        7,
        8
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/holt_minnesota",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Holt sits in sections 32 and 33 of its township, a layout defined by the Public Land Survey System.",
