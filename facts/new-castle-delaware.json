  "facts": [
    {
      "id": 1,
      "text": "New Castle began as Dutch Fort Casimir in 1651, built to control river traffic.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://delaware.wiki/a/New_Castle",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The fort was renamed Fort Trinity after New Sweden seized it in 1654 on Trinity Sunday.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/New_Castle%2C_Delaware",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The town’s cupola marks the center of the Twelve‑Mile Circle, the historic line that set Delaware’s border with Pennsylvania.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/New_Castle%2C_Delaware",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "New Castle’s historic district became a National Historic Landmark in 1967 and expanded in 1984.",
      "sourceSentenceIds": [
        5,
        21
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/New_Castle%2C_Delaware",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The district includes the 1855 Lesley‑Travers Mansion and the 1700‑era Old Dutch House, showcasing colonial architecture.",
      "sourceSentenceIds": [
