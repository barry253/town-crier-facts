  "facts": [
    {
      "id": 1,
      "text": "Fieldton sits on the high plains of the Llano Estacado, just north of Blackwater Draw, a dry tributary of the Double Mountain Fork Brazos River.",
      "sourceSentenceIds": [
        22
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Fieldton%2C_Texas"
    },
    {
      "id": 2,
      "text": "The town’s name comes from its midway spot between Littlefield and Olton, a fact noted by the Texas State Historical Association.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.tshaonline.org/handbook/entries/fieldton-tx"
    },
    {
      "id": 3,
      "text": "Fieldton opened its first post office in 1930, marking the start of its formal community services.",
      "sourceSentenceIds": [
        28
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.tshaonline.org/handbook/entries/fieldton-tx"
    },
    {
      "id": 4,
      "text": "A shared church built in 1926 served Baptists, Methodists, and the Church of Christ, reflecting early cooperative spirit.",
      "sourceSentenceIds": [
        29
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.tshaonline.org/handbook/entries/fieldton-tx"
    },
    {
      "id": 5,
      "text": "The first cotton gin began operating in Fieldton in 1931, boosting local agriculture during the Great Depression.",
      "sourceSentenceIds": [
        30
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.tshaonline.org/handbook/entries/fieldton-tx"
    },
    {
      "id": 6,
      "text": "Fieldton lies at the intersection of Farm to Market Roads 37 and 1072, a crossroads that helped shape its early growth.",
