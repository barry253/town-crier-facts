  "facts": [
    {
      "id": 1,
      "text": "Creighton was named after Thomas (Tom) Creighton, whose 1915 prospecting sparked mining at Flin Flon.",
      "sourceSentenceIds": [
        1,
        2
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 2"
      ],
      "source": "https://en.wikipedia.org/wiki/Creighton%2C_Saskatchewan",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Creighton sits on the Saskatchewan‑Manitoba border, right next to Flin Flon, creating a unique cross‑border community vibe.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Creighton%2C_Saskatchewan",
      "category": "other",
      "quality": "poor",
      "qualityReason": "location_description"
    },
    {
      "id": 3,
      "text": "Creighton’s origins trace back to the 1930s when a road from Flin Flon to Amisk Lake opened the area to settlement.",
      "sourceSentenceIds": [
        28
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.esask.uregina.ca/entry/creighton.html",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The towering 251‑metre Hudson Bay Mining & Smelting Company stack, finished in 1973, dominates the local skyline.",
      "sourceSentenceIds": [
        23
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.esask.uregina.ca/entry/creighton.html",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Northlands College maintains a campus in Creighton, offering higher‑education opportunities in northern Saskatchewan.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Creighton%2C_Saskatchewan",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Residents informally observe daylight saving time, keeping in sync with Flin Flon despite Saskatchewan’s statewide policy.",
