    {
      "id": 1,
      "text": "Tenkiller is located in southeastern Cherokee County and is bordered to the west by Tenkiller Ferry Lake on the Illinois River.",
      "sourceSentenceIds": [
        4,
        8
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Tenkiller%2C_Oklahoma"
    },
    {
      "id": 2,
      "text": "Lake Tenkiller is known for clear waters and is considered one of the best places for scuba diving in the state.",
      "sourceSentenceIds": [
        28
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.travelok.com/listings/view.profile/id.4378"
    },
    {
      "id": 3,
      "text": "Tenkiller Scuba Park features sunken vehicles, planes, and boats available for underwater exploration.",
      "sourceSentenceIds": [
        29
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.travelok.com/listings/view.profile/id.4378"
    },
    {
      "id": 4,
      "text": "Divers in Lake Tenkiller can discover the remains of homesteads and artifacts left behind from before the lake was formed.",
      "sourceSentenceIds": [
        30
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.travelok.com/listings/view.profile/id.4378"
    },
    {
      "id": 5,
      "text": "Anglers at Lake Tenkiller can spend hours fishing for bass, crappie, catfish, bream, walleye, and rainbow trout.",
      "sourceSentenceIds": [
        23
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.travelok.com/listings/view.profile/id.4378"
    },
    {
      "id": 6,
      "text": "Hunters west of Lake Tenkiller can find deer, quail, dove, and other wildlife within thousands of acres of protected project land.",
