  "facts": [
    {
      "id": 1,
      "text": "Glenwillow was carved out of Solon Township and founded in 1893 as a company town by the Austin Powder Company.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Glenwillow%2C_Ohio",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The Austin Powder plant moved to Athens, Ohio, and shut down in Glenwillow in 1972, ending the village’s original industry.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Glenwillow%2C_Ohio",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "In the 1980s, Glenwillow added a 250‑acre industrial park, marking a shift from its powder‑making roots to diversified manufacturing.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Glenwillow%2C_Ohio",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The former Austin Powder housing stock and general store were renovated in the early 2000s into boutiques, a tavern, and a new town center.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Glenwillow%2C_Ohio",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "East of Tinker’s Creek, Glenwillow once occupied half the area along the Wheeling & Lake Erie Railroad, a key rail corridor.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 1"
      ],
