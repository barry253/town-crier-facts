  "facts": [
    {
      "id": 1,
      "text": "Sheldon takes its name from the ancestral estate of the Bull family in England, reflecting the region's early colonial ties.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/sheldon_south_carolina"
    },
    {
      "id": 2,
      "text": "The Old Sheldon Church Ruins were originally constructed between 1745 and 1753 in a pioneering Greek Revival architectural style.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/sheldon_south_carolina"
    },
    {
      "id": 3,
      "text": "Pocosabo Town, located near Sheldon, served as a significant Yamasee village and trading hub before European contact.",
      "sourceSentenceIds": [
        28
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/sheldon_south_carolina"
    },
    {
      "id": 4,
      "text": "Old Sheldon Church Road is designated as a South Carolina Scenic Byway to preserve the area's cultural and aesthetic significance.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.beaufort.com/old-sheldon-ruins-its-significance-and-100th-service-celebration/"
    },
    {
      "id": 5,
      "text": "Early colonial Sheldon developed into a dispersed community of plantations that focused on the cultivation of rice and indigo.",
      "sourceSentenceIds": [
        27
