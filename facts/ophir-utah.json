  "facts": [
    {
      "id": 1,
      "text": "The mining district of Ophir was named for the biblical place where King Solomon brought back gold to Israel.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Ophir%2C_Utah"
    },
    {
      "id": 2,
      "text": "Ophir was once one of the smallest incorporated municipalities in Utah before it was disincorporated in 2016.",
      "sourceSentenceIds": [
        12,
        13
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Ophir%2C_Utah"
    },
    {
      "id": 3,
      "text": "Mining operations in Ophir continued for decades, with zinc being recovered in 1911 and other activities lasting until 1959.",
      "sourceSentenceIds": [
        11
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Ophir%2C_Utah"
    },
    {
      "id": 4,
      "text": "The town hall area in Ophir features relocated historic buildings and various mining relics.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://ghosttowntrails.com/utah/ophir"
    },
    {
      "id": 5,
      "text": "Historic cottages and mine portals remain scattered throughout the canyon and town center of Ophir.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://ghosttowntrails.com/utah/ophir"
    },
    {
      "id": 6,
      "text": "Ophir is now considered a living hamlet where the public core remains open for exploration.",
