  "facts": [
    {
      "id": 2,
      "text": "The town’s roots trace back to a U.S. Army frontier post founded July 8 1855 just outside Bandera Pass.",
      "sourceSentenceIds": [
        19
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.hillcountryportal.com/campverde.html",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Camp Verde was surrendered to the Confederacy in 1861, re‑occupied by Union troops in 1865, and finally abandoned on April 1 1869.",
      "sourceSentenceIds": [
        20,
        21
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.hillcountryportal.com/campverde.html",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "After the military camp closed, a post office and general store kept irregular service for local residents.",
      "sourceSentenceIds": [
        6,
        18
      ],
      "sourceLabels": [
        "Web source 1",
        "Web source 2"
      ],
      "source": "https://www.tshaonline.org/handbook/entries/camp-verde-tx",
      "category": "other",
      "quality": "poor",
      "qualityReason": "location_description"
    },
    {
      "id": 5,
      "text": "The community grew around the Williams store, established in 1857 to supply soldiers stationed at Camp Verde.",
      "sourceSentenceIds": [
        27
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.tshaonline.org/handbook/entries/camp-verde-tx",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Campo Verde lies three miles north of the historic Bandera Pass, a natural gateway that has guided travelers through the Hill Country for centuries.",
