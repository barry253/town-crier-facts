  "facts": [
    {
      "id": 1,
      "text": "Kinderhook was founded in 1836 by Chester Churchill and Bridge Whitten, both natives of New York.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://mississippivalleytraveler.com/kinderhook/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The Kinderhook Historical Society runs a museum and library in a building across from the post office, preserving the village’s heritage.",
      "sourceSentenceIds": [
        18,
        20
      ],
      "sourceLabels": [
        "Web source 1",
        "Web source 2"
      ],
      "source": "https://museumsdatabase.com/museums/view/9512",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Historic sites such as the old Kinderhook School House, First Congregational Church, and the original village square are maintained by the society.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://museumsdatabase.com/museums/view/9512",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Every year the village hosts Kinderhook Heritage Days, a celebration that brings residents and visitors together to learn about local history.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://museumsdatabase.com/museums/view/9512",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Walking tours offered by the society let visitors explore Kinderhook’s past in depth, highlighting key landmarks and stories.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://museumsdatabase.com/museums/view/9512",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "In 2009 the former settlement of New Philadelphia, founded by Free Frank McWorter, was designated a National Historic Landmark.",
      "sourceSentenceIds": [
