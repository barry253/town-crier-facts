  "facts": [
    {
      "id": 1,
      "text": "Becenti takes its name from Chief Becenti, the community’s first documented leader, chosen because other names were hard for non‑Navajos to pronounce.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://becenti.navajochapters.org/"
    },
    {
      "id": 2,
      "text": "The land around Becenti features rolling hills, sandstone mesas, and sandy washes that shape its distinctive landscape.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://becenti.navajochapters.org/"
    },
    {
      "id": 3,
      "text": "Becenti sits between 6,169 and 6,354 feet above sea level, giving it a high desert altitude.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://becenti.navajochapters.org/"
    },
    {
      "id": 4,
      "text": "The chapter’s land base lies in a checkerboard area that mixes Indian allotments, tribal trust, fee lands, and BLM parcels.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://becenti.navajochapters.org/"
    },
    {
      "id": 5,
      "text": "Antelope once roamed the area, and hunters chased them off a cliff at Jadi hadi t'iih, two miles south of the chapter house.",
      "sourceSentenceIds": [
        14,
        15,
        17
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://becenti.navajochapters.org/"
    },
    {
      "id": 6,
      "text": "Becenti lies less than a mile west of New Mexico State Road 371, part of the Trail of the Ancients Scenic Byway.",
      "sourceSentenceIds": [
        2
      ],
