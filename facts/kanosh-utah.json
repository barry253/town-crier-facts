    },
    {
      "id": 2,
      "text": "Brigham Young advised pioneers to move to the area of Kanosh on April 28, 1867, with the approval of Chief Kanosh.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Kanosh%2C_Utah"
    },
    {
      "id": 3,
      "text": "Local pioneer Mortimer Wilson Warner suggested naming the town Kanosh to honor the wise tribal chief.",
      "sourceSentenceIds": [
        4,
        6
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Kanosh%2C_Utah"
    },
    {
      "id": 4,
      "text": "Chief Kanosh led the Pahvant band of Utes and worked to ensure his people's survival through negotiation rather than conflict.",
      "sourceSentenceIds": [
        7,
        9
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Kanosh%2C_Utah"
    },
    {
      "id": 5,
      "text": "The Daughters of the Utah Pioneers worked with the Civilian Conservation Corps in 1934 to erect a monument to Chief Kanosh.",
