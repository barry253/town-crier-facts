  "facts": [
    {
      "id": 1,
      "text": "Kingston, Nevada sits at the mouth of Kingston Canyon, rising to about 5,961 feet, and is famed for its 19th‑century silver and gold mining.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/kingston_nevada",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "In spring 1863, silver and gold were discovered in Kingston Canyon, prompting July claims at mines such as Victorine, Bi‑Metallic, and Goldpoint.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/kingston_nevada",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Kingston’s post office returned to its original name in 1863 and remained open until April 15, 1886.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/kingston_nevada",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "During the 1930s, the CCC constructed a road from Kingston to Big Creek and set up a guard station 2.5 miles up the canyon.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/kingston_nevada",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Kingston lies in southern Lander County, on the northeast flank of the Toiyabe Range, just a few miles from the county’s highest peak, Bunker Hill.",
      "sourceSentenceIds": [
        7,
        8
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Kingston%2C_Nevada",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Nevada State Route 376 skirts Kingston, heading north 20 mi to Austin and south 90 mi toward Tonopah.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Kingston%2C_Nevada",
