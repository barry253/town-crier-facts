      ],
      "source": "https://discovernewhaven.org/cities-and-towns/woodbridge-ct/"
    },
    {
      "id": 5,
      "text": "The Woodbridge Land Trust and Woodbridge Park Association protect undeveloped land and historic sites throughout the town.",
      "sourceSentenceIds": [
