    {
      "id": 1,
      "text": "Rapid City began as Hay Camp in 1876, founded by miners who called it the 'Gateway to the Black Hills'.",
      "sourceSentenceIds": [
        1,
        9,
        14,
        25
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 2"
      ],
      "source": "https://en.wikipedia.org/wiki/Rapid_City%2C_South_Dakota",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The city sits on the eastern slope of the Black Hills and was named after the spring‑fed Rapid Creek that flows through it.",
      "sourceSentenceIds": [
        4,
        5
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Rapid_City%2C_South_Dakota",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Two railroads, the Chicago & North Western and the Milwaukee Road, made Rapid City a natural rail hub in the late 1880s.",
      "sourceSentenceIds": [
        3,
        15
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Rapid_City%2C_South_Dakota",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The 1972 Black Hills Flood was South Dakota’s worst disaster, prompting a decade‑long building boom that reshaped the city.",
      "sourceSentenceIds": [
        16,
        27,
        28
      ],
      "sourceLabels": [
        "Wikipedia",
