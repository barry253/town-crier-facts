  "facts": [
    {
      "id": 1,
      "text": "The community's name originates from the Rawls family and the natural mineral springs discovered in the vicinity, which were initially called Heckla by Choctaw people before being renamed.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/rawls_springs_mississippi",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Originally called Heckla by Choctaw settlers who found the springs while foraging for cane, a post office opened in 1895, changing to Rawls Springs in 1905.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/rawls_springs_mississippi",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Historically known for its mineral springs with reputed healing properties, the area developed as a health resort in the early 20th century, attracting visitors until operations ceased by 1936.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/rawls_springs_mississippi",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Rawls Springs is located on the former Illinois Central Gulf Railroad.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Rawls_Springs%2C_Mississippi",
      "category": "transport",
      "quality": "poor",
      "qualityReason": "route_only"
    },
    {
      "id": 5,
      "text": "Benjamin Rawles (also spelled Rawls) settled the area in 1833, establishing one of the first homesteads near the Bouie River amid dense pine forests rich in wildlife.",
      "sourceSentenceIds": [
        18
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/rawls_springs_mississippi",
      "category": "people",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The community continues to honor its heritage through local landmarks like the former Rawls Springs Hotel site and ongoing genealogical interest in early settlers.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Web source 1"
      ],
