  "facts": [
    {
      "id": 1,
      "text": "Like the parish, Livingston takes its name from the jurist Edward Livingston.",
      "sourceSentenceIds": [
        11
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Livingston%2C_Louisiana"
    },
    {
      "id": 2,
      "text": "Livingston began as a company town built by the Lyons Lumber Company when it switched its Garyville mill from cypress to pine in 1915.",
      "sourceSentenceIds": [
        16
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Livingston%2C_Louisiana"
    },
    {
      "id": 3,
      "text": "To support these new operations, the company extended its logging railroad northward and established Livingston as the northern terminus of the Garyville Northern Railroad.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Livingston%2C_Louisiana"
    },
    {
      "id": 4,
      "text": "Livingston hosts one of the two LIGO gravitational wave detector sites, the other one being located in Hanford, Washington.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Livingston%2C_Louisiana"
    },
    {
      "id": 5,
      "text": "By 1835, several small industries were thriving in the area, notably sawmills and brick factories.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://livingstontourism.com/more/about-livingston"
    },
    {
      "id": 6,
      "text": "The communities of Doyle and Livingston, combined in 1955 to create the Town of Livingston.",
