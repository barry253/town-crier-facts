  "facts": [
    {
      "id": 1,
      "text": "Pottersville was named after early homesteader Joel L. Potter, whose family settled the area between 1840 and 1842.",
      "sourceSentenceIds": [
        2,
        7
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/pottersville_missouri"
    },
    {
      "id": 2,
      "text": "The town’s post office opened in 1860, paused during the Civil War, and resumed in 1867 under postmaster Josephus Carrico.",
      "sourceSentenceIds": [
        18,
        21
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Pottersville%2C_Missouri"
    },
    {
      "id": 3,
      "text": "A grist and sawmill built by the Pease brothers in 1884 later became a flour mill owned by Jim Endecott, whose branded flour shipped nationwide.",
      "sourceSentenceIds": [
        22
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/pottersville_missouri"
    },
    {
      "id": 4,
      "text": "Pottersville’s historic brick mercantile, once owned by Henry Garrett, still stands as a reminder of the town’s 19th‑century mercantile heyday.",
      "sourceSentenceIds": [
        22
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/pottersville_missouri"
    },
    {
      "id": 5,
      "text": "The community lies about ten miles west of West Plains, nestled in the Ozark Mountains along Spring Creek.",
      "sourceSentenceIds": [
        17,
        20
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Pottersville%2C_Missouri"
    },
    {
      "id": 6,
      "text": "During the late 1800s, Pottersville served as a local trade hub until the railroad bypassed it in favor of nearby West Plains in 1883.",
      "sourceSentenceIds": [
        13
      ],
      "sourceLabels": [
        "Web source 1"
      ],
