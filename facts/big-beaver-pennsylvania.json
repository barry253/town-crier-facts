      ],
      "source": "https://bcpahistory.org/beavercounty/BeaverCountyCommunities/BigBeaver/BigBeaver.html",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Villages grew around the Homewood station, and later New Galilee, eventually becoming separate boroughs.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://bcpahistory.org/beavercounty/BeaverCountyCommunities/BigBeaver/BigBeaver.html",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Stockman Run, Clarks Run, and Wallace Run drain Big Beaver, feeding into the Beaver River system.",
