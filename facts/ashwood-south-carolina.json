    },
    {
      "id": 2,
      "text": "The Ashwood School Gymnasium and Auditorium is a 1930s-era building listed on the National Register of Historic Places.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
