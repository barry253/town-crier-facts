      ],
      "source": "https://museumsdatabase.com/museums/view/16085",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The Hadley Township Historical Society, founded in 1973, preserves the area’s past through lectures, tours, and exhibitions.",
