        9
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://museumsdatabase.com/museums/view/16085",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "A 1920s caboose, a steam engine, and a mail car are on display in the society’s railroad collection.",
