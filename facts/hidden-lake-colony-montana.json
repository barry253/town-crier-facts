  "facts": [
    {
      "id": 1,
      "text": "Hidden Lake Colony was founded in 1996 as a daughter of Big Sky Hutterite Colony, establishing a new communal community in Glacier County.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/hidden_lake_colony_montana",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The colony sits inside the Blackfeet Indian Reservation, drawing groundwater from the Two Medicine Formation aquifer for its farms and homes.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/hidden_lake_colony_montana",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Hidden Lake’s residents share all agricultural labor and resources, following traditional Hutterite practices of communal living and collective crop production.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/hidden_lake_colony_montana",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The colony operates under a 501(d) tax status, recognized by the IRS in 2009 as an apostolic religious organization.",
      "sourceSentenceIds": [
        11
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/hidden_lake_colony_montana",
      "category": "other",
      "quality": "poor",
      "qualityReason": "other"
    },
    {
      "id": 5,
      "text": "Hidden Lake experiences a humid continental climate, with cold snowy winters, mild summers, and an average of about 12 inches of precipitation annually.",
      "sourceSentenceIds": [
        22,
