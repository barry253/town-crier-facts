  "facts": [
    {
      "id": 1,
      "text": "Short North earned its nickname in the 1980s when police and taxi drivers began calling the High Street corridor the “Short North.”.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/The_Short_North",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The neighborhood’s rebirth began in the early 1980s when artists and entrepreneurs saw potential in its historic brick buildings and low rents.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://adathakkar.com/short-north-history/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Since 1983, the Short North has hosted the Doo Dah Parade, a Fourth‑of‑July spoof that features absurd floats like the “Marching Fidel” band of Castro look‑alikes.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/The_Short_North",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The 17 lighted metal arches that line High Street were installed in 1981, echoing the original arches that once marked the area’s early 1900s thoroughfare.",
      "sourceSentenceIds": [
        14
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/The_Short_North",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The Gallery Hop, now held every first Saturday, started in 1984 when two local galleries opened exhibits together to build a unified arts community.",
      "sourceSentenceIds": [
        19,
        20
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/The_Short_North",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "A 2019 construction on the 800 block of High Street now houses Klarna’s U.S. headquarters, a Marriott Moxy hotel, and two restaurants, marking a new era of mixed‑use development.",
      "sourceSentenceIds": [
        25
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/The_Short_North",
      "category": "landmark",
      "quality": "good"
    }
