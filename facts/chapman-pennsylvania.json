  "facts": [
    {
      "id": 1,
      "text": "Chapman was named for William Chapman, a Cornish slate quarry owner who founded the town.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Chapman%2C_Pennsylvania",
      "category": "people",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The borough’s slate quarries opened in 1850 and were incorporated in 1864 with a capital of $300,000.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Chapman%2C_Pennsylvania",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "A railroad was essential to haul slate; the Lehigh and Lackawanna Railroad reached Chapman in 1867, with the first train running on Thanksgiving Day.",
      "sourceSentenceIds": [
        15
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.lehighvalleyhistory.com/the-borough-of-chapman/",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The former Chapman Quarries Slate Co. left a “Hole” now filled with water, a visible reminder of the industry.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.chapmanborough.com/about-chapman-1",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "William Chapman began working in Cornwall quarries at age seven, emigrated to the U.S. at 26, and started the Chapman Slate Company.",
      "sourceSentenceIds": [
        23,
        24
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Chapman%2C_Pennsylvania",
      "category": "people",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Chapman sits on the west branch of Monocacy Creek, which drains into the Lehigh River.",
      "sourceSentenceIds": [
        28
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Chapman%2C_Pennsylvania",
