  "facts": [
    {
      "id": 1,
      "text": "Rose City was originally called Churchill, a lumbering town that moved east in 1892 when the railroad arrived.",
      "sourceSentenceIds": [
        1,
        12
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://northernmichiganhistory.com/rose-city-and-the-big-fire/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "In 1892 the town was relocated to its current spot and renamed Rose City in honor of founder Allen D. Rose.",
      "sourceSentenceIds": [
        3,
        12
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://visitrosecity.com/area-history/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Rose City Park hosts a double‑sided historic marker that commemorates the 2002 designation of the town and its historic fire site as Michigan State Historic Sites.",
      "sourceSentenceIds": [
        5,
        13
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 2"
      ],
      "source": "https://en.wikipedia.org/wiki/Rose_City%2C_Michigan",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The Cleveland Park Pavilion, just north of Rose City Park, is another registered historic site that reflects the town’s early 20th‑century architecture.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Rose_City%2C_Michigan",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Known once as “The Home of the Artesian Wells,” Rose City still relies on a network of historic wells for its water supply.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Web source 1"
      ],
