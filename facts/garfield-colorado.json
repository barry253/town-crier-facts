  "facts": [
    {
      "id": 1,
      "text": "Garfield County, Colorado was founded February 10, 1883, and named in honor of President James A. Garfield.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Garfield_County%2C_Colorado",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Before settlers, the Ute people—especially the Parianuche and White River bands—called the area home.",
      "sourceSentenceIds": [
        4,
        12,
        13
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://uscountyhistorybooksdirectoryandlookup.com/states/co/garfield-county-history/",
      "category": "people",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The 1879 Meeker Incident north of the county forced the Utes onto reservations, opening the land for American settlement.",
      "sourceSentenceIds": [
        11
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://uscountyhistorybooksdirectoryandlookup.com/states/co/garfield-county-history/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "In 1887 the Denver & Rio Grande Railroad reached Glenwood Springs, sparking rapid growth and commerce.",
      "sourceSentenceIds": [
        15,
        28
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 2"
      ],
      "source": "https://en.wikipedia.org/wiki/Garfield_County%2C_Colorado",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The Frontier Historical Museum at 1001 Colorado Avenue in Glenwood Springs houses artifacts from the county’s pioneer families and industries.",
