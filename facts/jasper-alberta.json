  "facts": [
    {
      "id": 1,
      "text": "Jasper began as a Grand Trunk Pacific Railway divisional point in 1911, originally called Fitzhugh after a vice president.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Jasper%2C_Alberta"
    },
    {
      "id": 2,
      "text": "The town was renamed Jasper after the historic fur trade post Jasper House, first established in 1813 by the North West Company.",
      "sourceSentenceIds": [
        4,
        8
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Jasper%2C_Alberta"
    },
    {
      "id": 3,
      "text": "The Athabasca Hotel, opened in 1929, remains the oldest hotel in Jasper and a historic gathering place for locals and visitors.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.jasper.travel/discover-jasper/jaspers-story/"
    },
    {
      "id": 4,
      "text": "In 1916, a Ukrainian Canadian internment camp operated briefly at Dominion Park in Jasper, reflecting a lesser‑known chapter of Canadian history.",
      "sourceSentenceIds": [
        28
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Jasper%2C_Alberta"
    },
    {
      "id": 5,
      "text": "Jasper’s love for cabin living stems from the national park’s history and continues to evolve with modern accommodations.",
