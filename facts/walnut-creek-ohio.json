      ],
      "source": "https://en.wikipedia.org/wiki/Walnut_Creek%2C_Ohio",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Jonas Stutzman, the first permanent settler, arrived in 1809 from Somerset County and built a log home that still marks the town’s origins.",
      "sourceSentenceIds": [
        16
      ],
      "sourceLabels": [
        "Web source 1"
