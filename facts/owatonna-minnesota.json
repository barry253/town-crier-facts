  "facts": [
    {
      "id": 1,
      "text": "Owatonna was founded in 1854 by settlers with English roots and named after the Dakota name for the Straight River, “Wakpá Owóthaŋna.”.",
      "sourceSentenceIds": [
        1,
        3
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://owatonna.org/visit/about/history-of-owatonna/",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The Straight River dam, once powering a mill, was rebuilt to include a fish ladder, keeping the river alive for wildlife.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Owatonna%2C_Minnesota",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Kaplan's Woods, a hardwood preserve on the southern border, was originally owned by Josef Kaplan and now protects local biodiversity.",
      "sourceSentenceIds": [
        13
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Owatonna%2C_Minnesota",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The Village of Yesteryear, a pioneer village opened in 1962, houses relocated historic buildings and museum exhibits about early Owatonna life.",
      "sourceSentenceIds": [
        19
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Owatonna%2C_Minnesota",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "In 1904, Federated Insurance, later known as Minnesota Implement Mutual Fire Insurance Company, was founded right here in Owatonna.",
      "sourceSentenceIds": [
        11
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://owatonna.org/visit/about/history-of-owatonna/",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Owatonna’s historic downtown Main Street still echoes its 19th‑century roots, with preserved storefronts and the National Farmers’ Bank as a landmark.",
