    },
    {
      "id": 2,
      "text": "The town of Skaneateles was formed from Marcellus in 1830, and the village incorporated in 1833.",
      "sourceSentenceIds": [
        14,
        24
      ],
      "sourceLabels": [
        "Web source 2",
        "Wikipedia"
      ],
      "source": "https://www.skaneateleshistoricalsociety.org/skaneateles-history/"
    },
    {
      "id": 3,
      "text": "Underground Railroad sites have been documented in Skaneateles, reflecting its role in the anti‑slavery movement.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Skaneateles%2C_New_York"
    },
    {
      "id": 4,
      "text": "In 1843, the Skaneateles Community operated a large farm and small industries before dissolving in 1846.",
