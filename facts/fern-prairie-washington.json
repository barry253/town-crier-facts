  "facts": [
    {
      "id": 1,
      "text": "Native American tribes, including the Klickitat, historically used the Fern Prairie area for seasonal hunting and gathering activities.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/fern_prairie_washington"
    },
    {
      "id": 2,
      "text": "James Parker named Fern Prairie in the 1850s after the abundant bracken ferns that dominated the open landscape.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/fern_prairie_washington"
    },
    {
      "id": 3,
      "text": "Early settlers arrived in Fern Prairie during the mid-1850s under the Oregon Donation Land Act to establish homesteads.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/fern_prairie_washington"
    },
    {
      "id": 4,
      "text": "Lewis VanVleet filed a land claim in 1855 and donated the land for the community's historic cemetery.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/fern_prairie_washington"
    },
    {
      "id": 5,
      "text": "The Fern Prairie Grange was founded in 1928 to support the local agricultural families of the region.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/fern_prairie_washington"
    },
    {
      "id": 6,
      "text": "Fern Prairie features a mild Mediterranean climate with warm, dry summers and cool, wet winters influenced by the Pacific Ocean.",
      "sourceSentenceIds": [
        6
