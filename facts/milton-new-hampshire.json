  "facts": [
    {
      "id": 1,
      "text": "Milton was settled in 1760 as part of Rochester, originally called 'Three Ponds' before becoming its own town.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Milton%2C_New_Hampshire",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The first saw‑mill in Milton, built by Samuel Palmer in 1775 at Three Ponds, sits near the present dam.",
      "sourceSentenceIds": [
        17
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://greenerpasture.com/Places/Details/2372",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The town’s distinctive 1808 Milton Town House and the 1875 Milton Free Public Library, a former schoolhouse, showcase its historic architecture.",
      "sourceSentenceIds": [
        25
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Milton%2C_New_Hampshire",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Milton Mills was the terminus of the Great Falls and Conway railroad, linking the town to the North Conway division of the Eastern Railroad in the 19th century.",
      "sourceSentenceIds": [
        21
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://greenerpasture.com/Places/Details/2372",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The Milton Historical Society, housed in a 1916 building that once served as a library, preserves and shares the town’s heritage through collections and education.",
      "sourceSentenceIds": [
        6,
        1
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Milton%2C_New_Hampshire",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "In 1844 a cotton factory was built at Three Ponds, but it burned in September 1845 after only a few months of operation.",
