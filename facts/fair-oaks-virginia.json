  "facts": [
    {
      "id": 1,
      "text": "Fair Oaks History Center opened in 1980 inside a Fair Oaks Cemetery office building, thanks to the Fair Oaks Historical Society.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://fairoakshistory.org/center/"
    },
    {
      "id": 2,
      "text": "In 2014 the Center added an interactive video unit showcasing 800 historic photos, movie clips, and oral histories of Fair Oaks.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://fairoakshistory.org/center/"
    },
    {
      "id": 3,
      "text": "The Center displays 11 storyboards that trace Fair Oaks history from its 1895 founding through the 1960s Aerojet era and river dredging operations.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://fairoakshistory.org/center/"
    },
    {
      "id": 4,
      "text": "Fair Oaks farm, built in 1881, covered 91 acres and was listed on the National Register of Historic Places in 2014.",
      "sourceSentenceIds": [
        21
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.dhr.virginia.gov/historic-registers/053-6119/"
    },
    {
      "id": 5,
      "text": "Alexander Moore’s 1881 house, the main building of Fair Oaks, was constructed using materials produced at his family’s Aldie Mill.",
      "sourceSentenceIds": [
        23
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.dhr.virginia.gov/historic-registers/053-6119/"
    },
    {
      "id": 6,
      "text": "The Fair Oaks property contains a Moore family cemetery founded in 1844, visible from public roads.",
      "sourceSentenceIds": [
        27
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.dhr.virginia.gov/historic-registers/053-6119/"
