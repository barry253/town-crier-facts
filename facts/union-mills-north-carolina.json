  "facts": [
    {
      "id": 1,
      "text": "Union Mills got its name when several local sawmills merged between 1885‑1890, forming a single hub that drew workers and stores.",
      "sourceSentenceIds": [
        24,
        29,
        30
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/union_mills_north_carolina",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town incorporated in 1907 but lost its charter in 1924, leaving it an unincorporated community today.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/union_mills_north_carolina",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "A post office opened in 1892, cementing Union Mills as a community center for mail and social exchange.",
      "sourceSentenceIds": [
        25
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/union_mills_north_carolina",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The former ASI campus now houses the Union Mills Learning Center, a nonprofit that repurposes the 1946 high school building for arts and wellness programs.",
      "sourceSentenceIds": [
        18
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/union_mills_north_carolina",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Union Mills’ economy today relies on small businesses, timber, and a growing number of retirees and “equity refugees” from larger cities.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://nolandchaliha.com/what-youll-actually-find-in-union-mills-nc-a-real-look-at-rutherford-countys-quietest-corner-pj1",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The James Milton Webb home, built in 1825, exemplifies early 19th‑century modest development and served ministers and farmers who helped foster community ties.",
