  "facts": [
    {
      "id": 1,
      "text": "Fort Ogden takes its name from Captain Edmund Ogden, a commander in the 8th U.S. Infantry during the Second Seminole War.",
      "sourceSentenceIds": [
        2,
        3
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.fortogden.com/",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The U.S. Army erected Fort Ogden in summer 1841, but the post was abandoned a year later when the Second Seminole War ended.",
      "sourceSentenceIds": [
        6,
        7,
        12
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.fortogden.com/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "A historic marker in front of the Fort Ogden Post Office marks the exact spot where the 1841 fort once stood.",
      "sourceSentenceIds": [
        9,
        13
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.fortogden.com/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Fort Ogden sits about 10 miles southwest of Arcadia, right beside the Peace River that winds through DeSoto County.",
      "sourceSentenceIds": [
        16,
        22
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Fort_Ogden%2C_Florida",
      "category": "other",
      "quality": "poor",
      "qualityReason": "location_description"
    },
    {
      "id": 5,
      "text": "Route 17 and the Fort Myers Division of the Seminole Gulf Railway cross paths in Fort Ogden, linking the town to regional trade routes.",
      "sourceSentenceIds": [
        17,
        23
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
