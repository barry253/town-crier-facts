    },
    {
      "id": 3,
      "text": "The Benbow Inn, originally the Hotel Benbow, opened its doors on July 17, 1926, and still welcomes guests today.",
      "sourceSentenceIds": [
        6,
        5
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Benbow%2C_California"
    },
    {
      "id": 4,
      "text": "Early guests relied on two diesel generators for power until a dam on the South Fork Eel River supplied electricity.",
      "sourceSentenceIds": [
