  "facts": [
    {
      "id": 1,
      "text": "Brush Creek takes its name from the adjacent small stream that served as a key local landmark during the Indian Territory period.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/brush_creek_oklahoma"
    },
    {
      "id": 2,
      "text": "Brush Creek is located near the center of Delaware County in a rural area about seventy miles northeast of Tulsa.",
      "sourceSentenceIds": [
        7,
        21
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Brush_Creek%2C_Oklahoma"
    },
    {
      "id": 3,
      "text": "The community of Brush Creek coalesced in the early 1900s around subsistence farming and timber harvesting from the Ozark foothills.",
      "sourceSentenceIds": [
        30
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/brush_creek_oklahoma"
    },
    {
      "id": 4,
      "text": "Forced removal via the Trail of Tears brought Cherokee families to the region, including those who settled on Brush Creek.",
      "sourceSentenceIds": [
        24
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/brush_creek_oklahoma"
    },
    {
      "id": 5,
      "text": "The Dawes Act of 1887 initiated individual allotments of Cherokee lands, which eventually allowed non-Native settlers to enter the area.",
      "sourceSentenceIds": [
        28
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/brush_creek_oklahoma"
    },
    {
      "id": 6,
      "text": "Oklahoma statehood in 1907 allowed the formal allocation of surplus acreage in Brush Creek to settlers through lotteries and homesteading.",
      "sourceSentenceIds": [
        29
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/brush_creek_oklahoma"
