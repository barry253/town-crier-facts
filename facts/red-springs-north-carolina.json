  "facts": [
    {
      "id": 1,
      "text": "Red Springs grew from a 1775 land grant by King George III to a town named after its rusty‑colored mineral springs.",
      "sourceSentenceIds": [
        4,
        12,
        17
      ],
      "sourceLabels": [
        "Web source 1",
        "Wikipedia"
      ],
      "source": "https://www.redsprings.org/history",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "In the mid‑1800s the town became a summer resort, drawing visitors to its mineral springs and a hotel opened by Hector McNeill’s grandson in 1852.",
      "sourceSentenceIds": [
        13,
        14
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Red_Springs%2C_North_Carolina",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "A Cape Fear and Yadkin Valley Railway line reached Red Springs in 1884, helping the town thrive as a regional hub.",
      "sourceSentenceIds": [
        16
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Red_Springs%2C_North_Carolina",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "From 1896 to 1915 Red Springs hosted a military school for boys and a Southern Conservatory of Music for girls, attracting students from across the country.",
      "sourceSentenceIds": [
        21
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Red_Springs%2C_North_Carolina",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The town’s first professional baseball team, the Red Springs Red Robins, won the Tobacco State League championship in 1948 and 1949.",
      "sourceSentenceIds": [
        25,
        26,
        27
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Red_Springs%2C_North_Carolina",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Red Springs preserves its history in a local museum that chronicles the town’s founding, the 1940s baseball era, and the life of NASA astronaut William McArthur Jr.",
      "sourceSentenceIds": [
        5
