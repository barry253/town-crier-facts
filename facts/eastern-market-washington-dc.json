  "facts": [
    {
      "id": 1,
      "text": "Eastern Market, a 19th‑century brick building, has operated continuously since 1873 and remains the only historic public market in Washington, DC.",
      "sourceSentenceIds": [
        3,
        11
      ],
      "sourceLabels": [
        "Web source 1",
        "Web source 1"
      ],
      "source": "https://easternmarket-dc.org/our-history/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Designed by German‑born architect Adolf Cluss, the market’s original structure earned National Historic Landmark status in 1971.",
      "sourceSentenceIds": [
        4,
        2,
        5
      ],
      "sourceLabels": [
        "Web source 1",
        "Web source 1",
        "Wikipedia"
      ],
      "source": "https://easternmarket-dc.org/our-history/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "A 2007 fire gutted the building, but a $30‑million renovation restored the historic roof and skylight, reopening in summer 2009.",
      "sourceSentenceIds": [
        16,
        7,
        8
      ],
      "sourceLabels": [
        "Wikipedia",
        "Wikipedia",
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Eastern_Market%2C_Washington%2C_D.C.",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Pierre L’Enfant’s 1791 plan earmarked space for a market at this spot, and Thomas Jefferson later proclaimed its location at 7th and L Streets SE.",
      "sourceSentenceIds": [
        9,
        28
      ],
      "sourceLabels": [
        "Web source 1",
        "Wikipedia"
      ],
      "source": "https://easternmarket-dc.org/our-history/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Eastern Market’s South Hall now hosts community events, while the North Hall can be rented for weddings and other occasions.",
      "sourceSentenceIds": [
        8,
        24
      ],
      "sourceLabels": [
        "Wikipedia",
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Eastern_Market%2C_Washington%2C_D.C.",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The market’s flea market attracts up to 100 exhibitors from five continents, making it a global cultural hub in Capitol Hill.",
