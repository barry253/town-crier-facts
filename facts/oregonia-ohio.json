  "facts": [
    {
      "id": 1,
      "text": "Oregonia first settled around 1802, when a mill operated by Nebo Gaunt, Ignatius Brown, and David Brown marked the beginning of the community.",
      "sourceSentenceIds": [
        14
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Oregonia%2C_Ohio",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "In 1820 the settlement was called Freeport before adopting the name Oregonia in 1882 after a post office renamed from Oregon.",
      "sourceSentenceIds": [
        15,
        16
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Oregonia%2C_Ohio",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The Little Miami Railroad reached Oregonia around 1850, linking the village to regional trade routes.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Oregonia%2C_Ohio",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Every October, riders tackle the “Devils Staircase,” a motorcycle hill climb just south of Oregonia’s main settlement.",
      "sourceSentenceIds": [
        20
      ],
      "sourceLabels": [
