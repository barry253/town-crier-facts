  "facts": [
    {
      "id": 1,
      "text": "Lackey was an unincorporated community near Yorktown, established mainly after the Civil War by freedmen.",
      "sourceSentenceIds": [
        17
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Lackey%2C_Virginia",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The community disappeared when the federal government bought land in 1918 for the Naval Weapons Station Yorktown.",
      "sourceSentenceIds": [
        18
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Lackey%2C_Virginia",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Around sixty African‑American families were displaced by the Navy, many owning their land.",
      "sourceSentenceIds": [
        23
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Lackey%2C_Virginia",
      "category": "people",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "A self‑educated farmer John Tack Roberts helped displaced residents secure compensation from the government.",
      "sourceSentenceIds": [
        25
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Lackey%2C_Virginia",
      "category": "people",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The original Lackey is now considered extinct and listed among Virginia's lost towns.",
      "sourceSentenceIds": [
        28
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Lackey%2C_Virginia",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "A modern residential neighborhood named Lackey exists along Yorktown Road but has little continuity with the original settlement.",
