  "facts": [
    {
      "id": 1,
      "text": "Whitetop is named after Whitetop Mountain, the second‑tallest independent peak in Virginia, standing just shy of Mount Rogers.",
      "sourceSentenceIds": [
        5,
        6
      ],
      "sourceLabels": [
        "Wikipedia",
