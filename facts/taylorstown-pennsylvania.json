  "facts": [
    {
      "id": 1,
      "text": "Taylorstown was granted to Robert Taylor in 1788 and later laid out into 66 plots by his son William.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://washcolandmarks.com/landmarks/historic-district/taylorstown-historic-district"
    },
    {
      "id": 2,
      "text": "The village preserves its original 1795 town plan, keeping the same size and scale it was set in.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://washcolandmarks.com/landmarks/historic-district/taylorstown-historic-district"
    },
    {
      "id": 3,
      "text": "The historic district spans 16.9 acres and contains almost four dozen mostly residential buildings.",
      "sourceSentenceIds": [
        11
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://washcolandmarks.com/landmarks/historic-district/taylorstown-historic-district"
    },
    {
      "id": 4,
      "text": "Early homes were two‑story clapboard logs with frame additions, while 1880‑1900 buildings added Italianate or Victorian gingerbread trim.",
      "sourceSentenceIds": [
        12,
        14
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://washcolandmarks.com/landmarks/historic-district/taylorstown-historic-district"
    },
    {
      "id": 5,
      "text": "Taylorstown’s first commercial scene featured a general store, dry goods shop, church, hatter’s shop, tavern‑hotel, blacksmith, livery, grain and planing mills, and woodworking shop.",
      "sourceSentenceIds": [
        15
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://washcolandmarks.com/landmarks/historic-district/taylorstown-historic-district"
    },
    {
      "id": 6,
      "text": "The town experienced an oil boom in the 1880s, spurring rapid development.",
      "sourceSentenceIds": [
        16
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://washcolandmarks.com/landmarks/historic-district/taylorstown-historic-district"
    }
  ]
