  "facts": [
    {
      "id": 1,
      "text": "Nanty‑Glo’s name comes from the Welsh phrase “Nant y Glo,” meaning stream of coal, a nod to the coal seams along Blacklick Creek.",
      "sourceSentenceIds": [
        1,
        27
      ],
      "sourceLabels": [
        "Web source 1",
        "Wikipedia"
      ],
      "source": "https://abandonedonline.net/a-legacy-in-coal-the-history-of-nanty-glo/",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The borough grew from a lumber camp in 1888 into one of America’s most prominent coal‑mining communities by the early 1900s.",
      "sourceSentenceIds": [
        4,
        6
      ],
      "sourceLabels": [
        "Web source 1",
        "Wikipedia"
      ],
      "source": "https://abandonedonline.net/a-legacy-in-coal-the-history-of-nanty-glo/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "In 1899 the Pennsylvania Railroad installed a spur line through Nanty‑Glo, connecting the town’s mines to the wider rail network.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Nanty_Glo%2C_Pennsylvania",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The Nant‑Y‑Glo Tri‑Area Museum & Historical Society, founded in 2000, preserves the town’s coal‑mining heritage and tri‑area culture.",
      "sourceSentenceIds": [
        5,
        16
      ],
      "sourceLabels": [
        "Web source 2",
        "Wikipedia"
      ],
      "source": "https://museumsdatabase.com/museums/view/27694",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The former Liberty Theater building is now a museum that showcases artifacts from the Blacklick Valley’s mining past.",
