      ],
      "source": "https://en.wikipedia.org/wiki/Hillside%2C_New_Jersey",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Lionel Trains operated in Hillside from 1929 to 1974, employing up to 2,000 workers at its factory.",
      "sourceSentenceIds": [
