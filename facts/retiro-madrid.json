    {
      "id": 1,
      "text": "El Retiro Park spans more than 125 hectares and shelters over 15,000 trees, a true green oasis in Madrid's heart.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.esmadrid.com/en/tourist-information/parque-del-retiro",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Its large artificial lake lets visitors rent rowing boats, while the Velázquez and Glass Palaces now host Reina Sofía Museum exhibitions.",
      "sourceSentenceIds": [
        14
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.esmadrid.com/en/tourist-information/parque-del-retiro",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "In spring 2018 an observation deck opened atop the Monument to Alfonso XII, offering panoramic views of the lake and gardens.",
      "sourceSentenceIds": [
        17
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.esmadrid.com/en/tourist-information/parque-del-retiro",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The park’s oldest tree is a 627‑year‑old olive planted near the Gate of the Fallen Angel, dating back to 1396.",
      "sourceSentenceIds": [
        29
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.esmadrid.com/en/tourist-information/parque-del-retiro",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Cat Mountain, closed for twenty years, reopened in 2023 as a quirky monument where monarchs once rested.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.esmadrid.com/en/tourist-information/parque-del-retiro",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The 1887 Glass Pavilion, built to house exotic plants for a Philippines exhibition, remains one of Spain’s finest cast‑iron structures.",
