  "facts": [
    {
      "id": 1,
      "text": "Anderson is named after Chief William “Adam” Anderson, whose Lenape mother was a Delaware Indian and whose Swedish father helped shape the town’s early roots.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Anderson%2C_Indiana",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Anderson was founded in 1823 on the site of a Delaware Indian village, marking the first permanent settlement in the area.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://indyencyclopedia.org/anderson/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The 1852 arrival of the Indianapolis‑Bellefontaine Railroad and its station sparked Anderson’s rapid growth, leading to its third incorporation on June 9, 1853.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://indyencyclopedia.org/anderson/",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "In the 1949–50 season, Anderson hosted the NBA’s Anderson Packers, one of the league’s smallest cities to field a major‑league team.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Anderson%2C_Indiana",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The historic Paramount Theatre and the elegant Gruenewald House are two of Anderson’s most celebrated architectural landmarks.",
      "sourceSentenceIds": [
        21
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
