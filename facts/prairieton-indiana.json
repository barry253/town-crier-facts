  "facts": [
    {
      "id": 1,
      "text": "Prairieton was laid out on July 22, 1837, by Robert Hoggatt, who also ran the first shop in the area.",
      "sourceSentenceIds": [
        11,
        14
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Prairieton%2C_Indiana"
    },
    {
      "id": 2,
      "text": "The community began as Hoggatt's Store in 1818, when Moses Hoggatt opened a post office and general store along Honey Creek.",
      "sourceSentenceIds": [
        13,
        15
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Prairieton%2C_Indiana"
    },
    {
      "id": 3,
      "text": "In 1840 the town was renamed Prairieton, a change that coincided with the opening of its post office under that name.",
      "sourceSentenceIds": [
        1,
        18
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Prairieton%2C_Indiana"
    },
    {
      "id": 4,
      "text": "Prairieton sits on the historic Vincennes wagon road, a key route that once linked the frontier to the east.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Prairieton%2C_Indiana"
    },
    {
      "id": 5,
      "text": "The town’s elevation is 470 feet above sea level, a detail noted in local historical records.",
