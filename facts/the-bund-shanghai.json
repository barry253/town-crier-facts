  "facts": [
    {
      "id": 1,
      "text": "The Bund’s 52 neoclassical buildings, built between 1900‑1930, form a living museum of European styles like Gothic, Baroque, and Art Deco.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.meet-in-shanghai.net/en/huangpu-district/the-bund-648313/"
    },
    {
      "id": 2,
      "text": "The Gutzlaff Signal Tower, erected in 1907, once broadcast weather to ships on the Huangpu River.",
      "sourceSentenceIds": [
        13
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/The_Bund"
    },
    {
      "id": 3,
      "text": "In the 1990s, Zhongshan Road was widened to ten lanes, reshaping the Bund’s historic streetscape.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/The_Bund"
    },
    {
      "id": 4,
      "text": "The Bund once housed the Shanghai offices of Royal Dutch Shell, the first major international oil company in China.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/The_Bund"
    },
    {
      "id": 5,
      "text": "The Bund’s waterfront faces Pudong’s modern skyscrapers, creating a dramatic contrast between old and new Shanghai.",
      "sourceSentenceIds": [
        28
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/The_Bund"
    },
    {
      "id": 6,
      "text": "The Bund inspired the 1980 Hong Kong TV series “The Bund” and the 1996 film Shanghai Grand, cementing its cultural legacy.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/The_Bund"
    }
