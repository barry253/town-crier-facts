      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Queenstown Library, opened in 1970, was Singapore’s first branch library and later became the oldest public library still standing.",
      "sourceSentenceIds": [
        21,
        22
      ],
      "sourceLabels": [
