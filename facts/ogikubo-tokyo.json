  "facts": [
    {
      "id": 1,
      "text": "Ogikubo’s name comes from the Japanese words for reed, “ogi,” and hollow, “kubo,” reflecting the area’s natural geography.",
      "sourceSentenceIds": [
        19
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Ogikubo%2C_Tokyo"
    },
    {
      "id": 2,
      "text": "Near Ogikubo Station, the historic Komyoin Temple rings its bell on New Year’s Eve, a long‑standing local tradition.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://japanmapper.com/area-guide/ogikubo"
    },
    {
      "id": 3,
      "text": "Ogikubo is celebrated as the birthplace of Tokyo ramen, with Harukiya opening in 1949 after the war to serve affordable, fish‑bone broth.",
      "sourceSentenceIds": [
        16,
        21,
        23
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Ogikubo%2C_Tokyo"
    },
    {
      "id": 4,
      "text": "Three gardens—Otaguro Park, Tekigaiso, and Kadokawa Garden—offer quiet retreats and symbolize Ogikubo’s natural charm.",
      "sourceSentenceIds": [
        25,
        26
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://en.japantravel.com/tokyo/ogikubo/63861"
    },
    {
      "id": 5,
      "text": "Ogikubo’s refined history fuels a deep love for classical music, contrasting with punk and folk live houses close to the station.",
      "sourceSentenceIds": [
        4,
        10
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://japanmapper.com/area-guide/ogikubo"
    },
    {
      "id": 6,
      "text": "Ogikubo Station serves as a terminus for the Marunouchi Line and a hub for the JR Chūō Line’s rapid service.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
