  "facts": [
    {
      "id": 1,
      "text": "Martinsville was founded in the 1850s by Martin, a native of Alabama, who built a large plantation.",
      "sourceSentenceIds": [
        16,
        17
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.tshaonline.org/handbook/entries/martinsville-tx"
    },
    {
      "id": 2,
      "text": "Around 1857 Martin erected a mill, and the settlement was briefly known as Martin's Mill before becoming Martinsville.",
      "sourceSentenceIds": [
        18,
        19
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.tshaonline.org/handbook/entries/martinsville-tx"
    },
    {
      "id": 3,
      "text": "Residents applied for a post office in 1867 under the name Martin's Mill, but a duplicate name forced a change to Martinsville.",
      "sourceSentenceIds": [
        19,
        20
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.tshaonline.org/handbook/entries/martinsville-tx"
    },
    {
      "id": 4,
      "text": "A school opened before 1904, enrolling eighty‑four students that year, marking early educational development.",
      "sourceSentenceIds": [
        21
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.tshaonline.org/handbook/entries/martinsville-tx"
    },
    {
      "id": 5,
      "text": "By 1990 Martinsville remained a dispersed rural community, reflecting its modest growth over time.",
