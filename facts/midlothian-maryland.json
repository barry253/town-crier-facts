  "facts": [
    {
      "id": 1,
      "text": "Midlothian earned its name when two Scottish brothers from East and West Lothian founded the village, blending their homelands into one.",
      "sourceSentenceIds": [
        6,
        30
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://experiencechesterfield.com/blog/midlothian/",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Remnants of the town’s mining past linger at Mid‑Lothian Mines Park, a 44‑acre preserve that once hosted one of the country’s first major industrial sites.",
      "sourceSentenceIds": [
        5,
        7
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://experiencechesterfield.com/blog/midlothian/",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Two coal‑fired Bowery iron furnaces, built in 1868 by Cumberland Coal and Iron, churned pig iron from 1874 until 1880.",
      "sourceSentenceIds": [
        9,
        10,
        11,
        12,
        13
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Midlothian%2C_Maryland",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The Juniata Lumber Company’s circular sawmill, powered by a Class‑B Climax engine, hauled logs 12 miles into Garrett County before closing by 1913.",
      "sourceSentenceIds": [
        16,
        17,
        18
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Midlothian%2C_Maryland",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Midlothian nestles on the eastern base of Big Savage Mountain, giving the community a rugged Appalachian backdrop.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Midlothian%2C_Maryland",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "A spur line of the Cumberland & Pennsylvania Railroad ran through Midlothian, shipping lumber and pig iron by boxcar to Cumberland.",
