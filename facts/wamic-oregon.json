  "facts": [
    {
      "id": 1,
      "text": "Wamic was named for the Womack family, including brothers Asa and Levi, who first settled the area in the 1800s.",
      "sourceSentenceIds": [
        2,
        3,
        11
      ],
      "sourceLabels": [
        "Web source 1",
        "Wikipedia",
        "Web source 2"
      ],
      "source": "https://wamichistory.wixsite.com/wamichistory/local-history"
    },
    {
      "id": 2,
      "text": "Before being called Wamic, the settlement was known as Prattville after a local justice of the peace in 1877.",
      "sourceSentenceIds": [
        4,
        5,
        23
      ],
      "sourceLabels": [
        "Web source 2",
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/wamic_oregon"
    },
    {
      "id": 3,
      "text": "Wamic lies along the historic Barlow Road, the final southern overland leg of the Oregon Trail established in 1846.",
      "sourceSentenceIds": [
        9,
        26
      ],
      "sourceLabels": [
        "Web source 2",
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/wamic_oregon"
    },
    {
      "id": 4,
      "text": "The historical Smock Prairie Schoolhouse number forty-four is one of the best remaining examples of a rural one-room school.",
      "sourceSentenceIds": [
        7,
        29
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://wamichistory.wixsite.com/wamichistory/local-history"
    },
    {
      "id": 5,
      "text": "Wamic celebrates its connection to westward expansion every Labor Day with a pioneer festival called Rendezvous Days.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/wamic_oregon"
    },
    {
      "id": 6,
      "text": "A post office was established in Wamic on November 25, 1884, and served the community until it closed in 1958.",
      "sourceSentenceIds": [
        5,
        14,
        24
      ],
      "sourceLabels": [
