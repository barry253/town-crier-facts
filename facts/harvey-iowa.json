    {
      "id": 1,
      "text": "Harvey was founded in 1876 by engineer James Harvey and his wife.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://harveyiowa.org/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town hosts the Harvey Arboretum, where Barker planted a diverse collection of trees and shrubs.",
      "sourceSentenceIds": [
        23
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://harveyiowa.org/about/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Harvey is the birthplace of the National Peace Tree concept, first adopted by the Survivors of the Battle of Shiloh.",
      "sourceSentenceIds": [
        24,
        25
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://harveyiowa.org/about/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The original Peace Tree, a sycamore, was planted at the entrance of the Harvey Arboretum when World War I began.",
      "sourceSentenceIds": [
        28
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://harveyiowa.org/about/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The sycamore was chosen for its white trunk and limbs, symbolizing purity of peace, according to Barker.",
      "sourceSentenceIds": [
        29
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://harveyiowa.org/about/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The sycamore was later designated the peace tree by Assistant Secretary of War Hanford Mac Nider, leading to a sycamore planted at each of the 84 National Cemeteries.",
      "sourceSentenceIds": [
        26
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://harveyiowa.org/about/",
      "category": "history",
      "quality": "good"
    }
  ]
