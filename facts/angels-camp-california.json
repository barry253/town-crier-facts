      ],
      "source": "https://www.calaverashistory.org/angels-camp",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "In 1902 the Sierra Railroad arrived, linking the mining town to the wider region.",
      "sourceSentenceIds": [
