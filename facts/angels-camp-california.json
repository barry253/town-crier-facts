        6
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.calaverashistory.org/angels-camp",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town sits where Angels Creek, China Gulch, and Dry Creek meet, a spot highlighted in local history.",
