  "facts": [
    {
      "id": 1,
      "text": "Delft is famed for its Delft Blue pottery, a blue‑and‑white ceramic that has been produced there since the 17th century.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.holland.com/global/tourism/discover-the-netherlands/visit-the-cities/delft",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The city’s canals and historic facades make it a living museum of Dutch history and culture.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.holland.com/global/tourism/discover-the-netherlands/visit-the-cities/delft",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Johannes Vermeer’s celebrated painting “View of Delft” captures the city’s streets and has been housed at the Mauritshuis since 1822.",
      "sourceSentenceIds": [
        9,
        30
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.holland.com/global/tourism/discover-the-netherlands/visit-the-cities/delft",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The Nieuwe Kerk in Delft served as a royal crypt and played a key role in national history.",
      "sourceSentenceIds": [
        20
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.holland.com/global/tourism/discover-the-netherlands/visit-the-cities/delft",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Delft’s train station blends technical innovation with historical charm, welcoming travelers from across the Netherlands.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.holland.com/global/tourism/discover-the-netherlands/visit-the-cities/delft",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The Prinsentheater hosts productions like William of Orange – The Musical, linking the city’s artistic scene with its historical roots.",
