  "facts": [
    {
      "id": 1,
      "text": "Pequot Lakes was platted in March 1900, with Walter and Flora Brown filing the town's official plat that same year.",
      "sourceSentenceIds": [
        22,
        24
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Pequot_Lakes%2C_Minnesota"
    },
    {
      "id": 2,
      "text": "The town’s name may stem from a Chippewa word for arrow, as noted by historian Carl Zapffe, linking the name to local indigenous language.",
      "sourceSentenceIds": [
        27,
        28
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Pequot_Lakes%2C_Minnesota"
    },
    {
      "id": 3,
      "text": "A post office opened in Pequot Lakes in 1896, predating the town’s official plat by four years.",
      "sourceSentenceIds": [
        23
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Pequot_Lakes%2C_Minnesota"
    },
    {
      "id": 4,
      "text": "The Pequot Lakes Area Historical Society, founded in 1997, preserves artifacts, documents, and photographs that chronicle the town’s early days.",
