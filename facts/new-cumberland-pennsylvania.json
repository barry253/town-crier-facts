  "facts": [
    {
      "id": 1,
      "text": "New Cumberland sits on the Susquehanna River where it meets Yellow Breeches Creek, a spot once vital for lumber rafting.",
      "sourceSentenceIds": [
        1,
        19
      ],
      "sourceLabels": [
        "Web source 1",
        "Wikipedia"
      ],
      "source": "https://newcumberlandborough.com/living-here/about-new-cumberland/"
    },
    {
      "id": 2,
      "text": "The borough’s name evolved from Shawneetown to Haldeman’s Town before settling on New Cumberland in 1827.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/New_Cumberland%2C_Pennsylvania"
    },
    {
      "id": 3,
      "text": "In 1831, New Cumberland became a commercial stop between Harrisburg and York, thanks to its ferry site on the West Shore.",
      "sourceSentenceIds": [
        11
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.visitcumberlandvalley.com/explore/towns/new-cumberland/"
    },
    {
      "id": 4,
      "text": "The historic West Shore Theater, a centerpiece of downtown, still hosts performances and echoes the town’s 19th‑century cultural life.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/New_Cumberland%2C_Pennsylvania"
    },
    {
      "id": 5,
      "text": "A walking‑tour pamphlet lists 48 historic sites within the original 1831 borough limits, complete with a numbered map.",
      "sourceSentenceIds": [
        3,
        15
      ],
      "sourceLabels": [
        "Web source 2",
        "Web source 1"
      ],
      "source": "https://www.visitcumberlandvalley.com/explore/towns/new-cumberland/"
    },
    {
      "id": 6,
      "text": "The William Black Homestead, a National Register landmark, stands as a reminder of New Cumberland’s early industrial era.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/New_Cumberland%2C_Pennsylvania"
    }
  ]
