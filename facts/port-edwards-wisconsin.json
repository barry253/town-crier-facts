  "facts": [
    {
      "id": 1,
      "text": "Port Edwards was originally called Frenchtown because of the large number of French Canadians living in the area.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.townofportedwardswi.org/"
    },
    {
      "id": 2,
      "text": "The village was renamed in 1869 to honor John Edwards, a local mill owner who helped establish the community.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Port_Edwards%2C_Wisconsin"
    },
    {
      "id": 3,
      "text": "Port Edwards formed around a sawmill built around 1829, which served as the foundation for the early settlement.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Port_Edwards%2C_Wisconsin"
    },
    {
      "id": 4,
      "text": "A local sawmill company in Port Edwards took a risk and converted into a paper mill company in 1896.",
      "sourceSentenceIds": [
        24
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Port_Edwards%2C_Wisconsin"
    },
    {
      "id": 5,
      "text": "Port Edwards officially incorporated as a village in 1902 after growing as a community dependent on the local mill.",
      "sourceSentenceIds": [
        26,
        27
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Port_Edwards%2C_Wisconsin"
    },
    {
      "id": 6,
      "text": "The village of Port Edwards features a small cluster of preserved and refurbished homes dating from the 1890s to the 1940s.",
      "sourceSentenceIds": [
        28
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Port_Edwards%2C_Wisconsin"
