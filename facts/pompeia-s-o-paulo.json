  "facts": [
    {
      "id": 1,
      "text": "Pompeia was renamed after senator Rodolfo Miranda's wife, Aretuza Pompeia.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Pompeia%2C_S%C3%A3o_Paulo"
    },
    {
      "id": 2,
      "text": "The SESC Pompeia cultural center was born from a 1920s drum factory that Lina Bo Bardi converted into a modernist landmark in 1982.",
      "sourceSentenceIds": [
        2,
        3,
        14
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://archeyes.com/sesc-pompeia-factory-lina-bo-bardi-architecture-sao-paulo/"
    },
    {
      "id": 3,
      "text": "The SESC complex features three concrete towers linked by aerial walkways, a design that surprised São Paulo with its bold, red‑brick industrial roots.",
      "sourceSentenceIds": [
        14
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://archeyes.com/sesc-pompeia-factory-lina-bo-bardi-architecture-sao-paulo/"
    },
    {
      "id": 4,
      "text": "The Jacto Group, a major agricultural machinery maker, was founded in Pompeia in 1948 by Japanese immigrant Shunji Nishimura.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Pompeia%2C_S%C3%A3o_Paulo"
    },
    {
      "id": 5,
      "text": "Pompeia’s early settlers arrived in 1852 when the Imperial Government granted land near Rio do Peixe and Aguapeí River to three families.",
      "sourceSentenceIds": [
        29
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Pompeia%2C_S%C3%A3o_Paulo"
    },
    {
      "id": 6,
      "text": "The original factory’s “Spanish civil war holes” are amoeba‑shaped windows that give the building its distinctive, socially utopian character.",
      "sourceSentenceIds": [
