  "facts": [
    {
      "id": 1,
      "text": "Landover Hills grew from a colonial crossroads, once the main road between Bladensburg and Annapolis.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.landoverhillsmd.gov/about/history_of_landover_hills",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town’s name may honor Llandovery in Carmarthenshire, Wales, linking it to a historic Welsh village.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://2024mdmanual.msa.maryland.gov/msa/mdmanual/37mun/landover/html/l.html",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Growth began in the 1920s, as the area transitioned from rural farmland to a developing suburb.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.landoverhillsmd.gov/about/history_of_landover_hills",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Early homes clustered along the Landover, Ardmore, and Lanham railroad stops, reflecting the town’s rail heritage.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.landoverhillsmd.gov/about/history_of_landover_hills",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Landover Hills officially incorporated as a town in 1945, marking its formal municipal status.",
