  "facts": [
    {
      "id": 1,
      "text": "Sandy Hook was named for the fishhook‑shaped bend in the Little Sandy River where the settlement first appeared.",
      "sourceSentenceIds": [
        4,
        22
      ],
      "sourceLabels": [
        "Web source 2",
        "Wikipedia"
      ],
      "source": "https://grokipedia.com/page/Sandy_Hook,_Kentucky"
    },
    {
      "id": 2,
      "text": "Sandy Hook became the county seat of Elliott County in 1869, chosen by the first county court.",
      "sourceSentenceIds": [
        15
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/Sandy_Hook,_Kentucky"
    },
    {
      "id": 3,
      "text": "A post office opened in 1867, but the town was briefly called Martinsburg before reverting to Sandy Hook in 1888.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/Sandy_Hook,_Kentucky"
    },
    {
      "id": 4,
      "text": "Country singer Keith Whitley grew up in Sandy Hook, and a statue of him stands in the local cemetery.",
      "sourceSentenceIds": [
        6,
        14
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 2"
      ],
      "source": "https://en.wikipedia.org/wiki/Sandy_Hook%2C_Kentucky"
    },
    {
      "id": 5,
      "text": "The Little Sandy River, a tributary of the Ohio, forms a distinctive boundary that shaped Sandy Hook’s development.",
      "sourceSentenceIds": [
        16
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Sandy_Hook%2C_Kentucky"
    },
    {
      "id": 6,
      "text": "During the Civil War, Sandy Hook’s area hosted guerrilla skirmishes, with Union soldiers buried in the local cemetery.",
