  "facts": [
    {
      "id": 1,
      "text": "Ardentown was founded in 1922 as an outgrowth of Arden, built on Henry George's single tax idea and William Morris's Arts and Crafts principles.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Ardentown%2C_Delaware",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The former Harvey barn, now the Harvey Barn Theater, has staged performances since 1931, making it a historic cultural hub.",
      "sourceSentenceIds": [
        16,
        17
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://delaware.wiki/a/Ardentown",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The Ardens trio—Arden, Ardentown, Ardencroft—collectively known as \"the Ardens,\" was founded on Henry George's land value tax philosophy and an arts‑oriented identity.",
      "sourceSentenceIds": [
        20
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://delaware.wiki/a/Ardentown_and_Ardencroft",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The barn theater drew actors Barbara Bel Geddes, Jack Klugman, and Anthony Perkins, who all spent time as resident performers.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://delaware.wiki/a/Ardentown",
      "category": "people",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Ardentown sits on former Harvey and Hanby farms, now hosting a natural preserve and one of the region's oldest theater venues.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://delaware.wiki/a/Ardentown",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "When Delmarva Power proposed high‑voltage towers near Ardentown, the village used its ordinance power to try to block the project, spotlighting limits of small‑town authority.",
      "sourceSentenceIds": [
        11,
