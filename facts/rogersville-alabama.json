  "facts": [
    {
      "id": 1,
      "text": "Rogersville was originally called 'Rodgersville' after Andrew and Patience Rodgers, who bought 79.8 acres in 1818.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Rogersville%2C_Alabama",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town’s name evolved when the post office opened in 1825, dropping the 'd' to become Rogersville.",
      "sourceSentenceIds": [
        15
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Rogersville%2C_Alabama",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Rogersville grew into a trading hub thanks to its position at the crossroads of three early roads, including 72, Snake Road, and Lamb’s Ferry Road.",
      "sourceSentenceIds": [
        16,
        17,
        18
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Rogersville%2C_Alabama",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The settlement emerged in the early 19th century along trade routes linking Chattanooga and Memphis, with a bypass around the Muscle Shoals via the Wheeler Dam lock.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://encyclopediaofalabama.org/article/rogersville/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The town was incorporated as a municipality on February 2, 1858.",
