      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The peninsula between the Warwick and James Rivers was called Mulberry Island by English colonists in 1610, long before the fort existed.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.jble.af.mil/About-Us/Fort-Eustis-History/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Soldiers trained at Fort Eustis moved 3 million troops and over 7 million tons of material during the Korean Conflict, braving harsh winters and scorching summers.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.jble.af.mil/About-Us/Fort-Eustis-History/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Fort Eustis hosts the Army Training and Doctrine Command, the Army Aviation Logistics School, and the 7th Transportation Brigade.",
