  "facts": [
    {
      "id": 1,
      "text": "According to the Roman geographer Pausanias, the place was originally named Actaea, but was later renamed in the honour of Atthis, daughter of king Cranaus of Athens.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Attica",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Attica's modern region stretches beyond its historic borders, adding West Attica's Megaris, the Saronic Islands, Cythera, and Troizinia from the Peloponnese.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Attica",
      "category": "other",
      "quality": "poor",
      "qualityReason": "other"
    },
    {
      "id": 3,
      "text": "The Acropolis Museum’s pedestrian walkway links ancient monuments, turning the area into one of Athens’ most fashionable postcodes.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.thisisathens.org/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "It is a peninsula projecting into the Aegean Sea, bordering on Boeotia to the north and Megaris to the west.",
      "sourceSentenceIds": [
        26
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Attica",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The mines of Laurion were an important mining region located at Lavrio, on the southern tip of the peninsula.",
      "sourceSentenceIds": [
        27
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Attica",
      "category": "other",
      "quality": "poor",
      "qualityReason": "other"
    },
    {
      "id": 6,
      "text": "Attica, the land that gave birth to ideas and arts, has created and shaped what we call today the western civilisation.",
      "sourceSentenceIds": [
        11
