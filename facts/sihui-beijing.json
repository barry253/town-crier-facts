    {
      "id": 1,
      "text": "Sihui sits where Beijing’s eastern 4th Ring Road meets the Jingtong Expressway, making it a key traffic junction.",
      "sourceSentenceIds": [
        16
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Sihui%2C_Beijing"
    },
    {
      "id": 2,
      "text": "The Sihui Bridge, named after the area, links the two express roads and hints at the region’s growing infrastructure.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Sihui%2C_Beijing"
    },
    {
      "id": 3,
      "text": "Sihui Station serves both Line 1 and the Batong Line, while Sihui East is the eastern terminus of Line 1.",
      "sourceSentenceIds": [
        14,
        17
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Sihui%2C_Beijing"
    },
    {
      "id": 4,
      "text": "The Batong Line actually begins at Sihui, connecting the city’s eastern suburbs to downtown.",
      "sourceSentenceIds": [
        17
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Sihui%2C_Beijing"
    },
