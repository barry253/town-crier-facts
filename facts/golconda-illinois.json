  "facts": [
    {
      "id": 1,
      "text": "Golconda was named after the ancient Indian city of Golkonda, once famed for its diamond mines.",
      "sourceSentenceIds": [
        2,
        3
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Golconda%2C_Illinois",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "First settled in 1798, Golconda became Pope County’s earliest permanent town and a key Ohio River ferry point.",
      "sourceSentenceIds": [
        22
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Golconda%2C_Illinois",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The First Presbyterian Church, built in 1869, remains Illinois’ oldest continuous Presbyterian congregation.",
      "sourceSentenceIds": [
        6,
        23
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Golconda%2C_Illinois",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Golconda’s historic district, listed on the National Register, was the 25th historic place approved in Illinois.",
      "sourceSentenceIds": [
        13,
        14
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.enjoyillinois.com/explore/listing/historic-golconda-tour/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "During the Trail of Tears, roughly 13,000 Cherokees crossed the Ohio River at Golconda, paying a dollar each.",
      "sourceSentenceIds": [
        25,
        28
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Golconda%2C_Illinois",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Golconda’s City Hall bears a plaque declaring the entire town “Historic Golconda,” a title reserved for only a handful of Illinois localities.",
