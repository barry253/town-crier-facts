  "facts": [
    {
      "id": 1,
      "text": "North Lilbourn takes its name from early settler Lilbourn Lewis, whose family helped found the nearby town of Lilbourn in the late 1800s.",
      "sourceSentenceIds": [
        1,
        3
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Lilbourn%2C_Missouri",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The village officially became incorporated in 1954, transitioning from a rural community in New Madrid County.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/north_lilbourn_missouri",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Situated on a flat agricultural plain, North Lilbourn sits near the Mississippi River, making it prone to periodic flooding.",
      "sourceSentenceIds": [
        4,
        9
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/north_lilbourn_missouri",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Just southeast of North Lilbourn lies the Lilbourn Fortified Village, a Mississippian‑era mound site listed on the National Register of Historic Places.",
      "sourceSentenceIds": [
        10,
        12
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/north_lilbourn_missouri",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The town’s public library, the Lilbourn Memorial Library, serves as a community hub for residents.",
      "sourceSentenceIds": [
        13
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Lilbourn%2C_Missouri",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The historic Louis Southwestern Railway once ran through North Lilbourn’s southern edge, linking the area to regional trade.",
