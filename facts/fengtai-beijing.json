  "facts": [
    {
      "id": 1,
      "text": "Fengtai hosts Beijing South and West Railway Stations, two of the city’s busiest, linking high‑speed trains across China.",
      "sourceSentenceIds": [
        21,
        22
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://ruqintravel.com/china-destination-guides/beijing-fengtai-district-travel-guide/",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The historic Marco Polo Bridge, the longest ancient stone bridge in North China, stands in Fengtai and now houses a war museum.",
      "sourceSentenceIds": [
        3,
        10
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://ruqintravel.com/china-destination-guides/beijing-fengtai-district-travel-guide/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Fengtai’s Dabaotai Western Han Dynasty Mausoleum opened to visitors after 1974 excavations, revealing tombs of Prince Liu Jian and his wife.",
      "sourceSentenceIds": [
        27,
        28
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Fengtai%2C_Beijing",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The Zhengangta pagoda, restored in 1958, 1982, and 2001, symbolizes Fengtai’s Buddhist heritage and architectural resilience.",
      "sourceSentenceIds": [
        14,
        15,
        16
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.chinaculturetrip.com/beijing-fengtai-zhengangta/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Beijing Garden Expo Park, built for the 2013 China International Garden Expo, now offers lakes, gardens, and cultural pavilions to the public.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://ruqintravel.com/china-destination-guides/beijing-fengtai-district-travel-guide/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Fengtai’s strategic location southwest of downtown, extending beyond the Sixth Ring Road, made it a Qing‑Dynasty training ground for the Imperial Manchu Army.",
      "sourceSentenceIds": [
