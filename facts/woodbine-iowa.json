  "facts": [
    {
      "id": 1,
      "text": "Woodbine earned its name from the dense growth of the woodbine plant that once covered the original town site.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Woodbine%2C_Iowa",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town was platted in 1866, the same year the Chicago Northwestern Railroad began regular service through the area.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.woodbineia.com/our-story",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Woodbine’s downtown Brick Street Historic District, along with the Lincolnway and Carnegie Library, is listed on the National Register of Historic Places.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.woodbineia.com/our-story",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The Zell Millard Historic Preservation Park showcases the original depot, a CNW caboose, and a 1928 canopy gas station now serving as the town’s welcome center.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.woodbineia.com/our-story",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Woodbine sits along the Boyer River in Harrison County, Iowa, giving the town a scenic riverside setting.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Woodbine%2C_Iowa",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Woodbine officially incorporated as a town in 1877, solidifying its community structure after a decade of growth.",
      "sourceSentenceIds": [
        7
      ],
