  "facts": [
    {
      "id": 1,
      "text": "Thorne Bay was named after Frank Manly Thorn, the sixth U.S. Coast and Geodetic Survey superintendent, though the spelling was never corrected.",
      "sourceSentenceIds": [
        1,
        28
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Thorne_Bay%2C_Alaska",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "In 1960, the Ketchikan Pulp Company established a massive logging camp in Hollis that later became Thorne Bay.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Thorne_Bay%2C_Alaska",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "During the 1960s and 1970s, Thorne Bay hosted over 1,500 workers, making it North America’s largest logging camp.",
      "sourceSentenceIds": [
        30
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Thorne_Bay%2C_Alaska",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The town’s road passes the historic Salt Chuck mine, where ruins of shacks, a collapsed refinery, and machinery still linger.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://discoverpowisland.com/communities/thorne-bay/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Thorne Bay enjoys a mild oceanic climate, with steady humidity and frequent rain from the Pacific Ocean.",
