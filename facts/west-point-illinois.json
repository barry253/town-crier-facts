  "facts": [
    {
      "id": 1,
      "text": "West Point Township sits within Stephenson County, Illinois, in the northern part of the state.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/West_Point_Township%2C_Illinois"
    },
    {
      "id": 2,
      "text": "The township once contained a community called West Point, which has since disappeared from modern maps.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/West_Point_Township%2C_Illinois"
    },
    {
      "id": 3,
      "text": "In 1838 a log Buckhorn Inn was built in Alida—now Lena—along Old State Road 2, now the Stagecoach Trail.",
      "sourceSentenceIds": [
        11
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/West_Point_Township%2C_Illinois"
    },
    {
      "id": 4,
      "text": "That inn served as a stop for Frink, Walker & Company’s stage line between Chicago and Galena from 1839 to 1854.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/West_Point_Township%2C_Illinois"
    },
    {
      "id": 5,
      "text": "In 1848 Samuel Dodds rebuilt the site as Dodd’s Inn, continuing the stage‑coach service for the same line.",
      "sourceSentenceIds": [
        13
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/West_Point_Township%2C_Illinois"
    },
    {
      "id": 6,
      "text": "The stone building that housed Dodd’s Inn also operated as a post office from 1854 until 1857.",
      "sourceSentenceIds": [
        14
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/West_Point_Township%2C_Illinois"
    }
  ]
