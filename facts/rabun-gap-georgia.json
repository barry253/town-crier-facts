    {
      "id": 3,
      "text": "In 1905, Andrew Jackson Ritchie and his wife founded the Rabun Gap Industrial School to educate the region’s isolated residents.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://rabunhistory.org/towns/rabun-gap/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "A 1926 fire destroyed the school’s main building, an event that also followed a blaze at the Nacoochee Institute in nearby White County.",
      "sourceSentenceIds": [
        13
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://rabunhistory.org/towns/rabun-gap/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Rabun Gap’s flat topography in the Little Tennessee River Valley has long made it the center of farming in Rabun County.",
      "sourceSentenceIds": [
