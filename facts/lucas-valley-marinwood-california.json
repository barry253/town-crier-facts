  "facts": [
    {
      "id": 1,
      "text": "Lucas Valley was named after 19th‑century rancher John Lucas, nephew of Timothy Murphy, not related to filmmaker George Lucas.",
      "sourceSentenceIds": [
        3,
        22
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Lucas_Valley-Marinwood%2C_California",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "In 1844 Irish immigrant James Miller arrived via the Stephens–Townsend–Murphy Party, later buying 680 acres that became Miller Creek and Marinwood.",
      "sourceSentenceIds": [
        25,
        26,
        10
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Lucas_Valley-Marinwood%2C_California",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Miller rebuilt an old adobe into Miller Hall on a hill overlooking Miller Creek, a landmark now relocated in front of Miller Creek Middle School.",
      "sourceSentenceIds": [
        27,
        29
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Lucas_Valley-Marinwood%2C_California",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Mid‑20th‑century development introduced distinctive Eichler modern homes, shaping the neighborhood’s architectural identity.",
      "sourceSentenceIds": [
        23,
        11
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Lucas_Valley-Marinwood%2C_California",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Streets in lower Lucas Valley end with “‑berry” – Appleberry, Cedarberry, Newberry – a quirky naming tradition.",
      "sourceSentenceIds": [
        12,
        6
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://kids.kiddle.co/Lucas_Valley-Marinwood,_California",
      "category": "culture",
      "quality": "good"
    },
    {
