  "facts": [
    {
      "id": 1,
      "text": "Wilseyville was named for Lawrence Wilsey, a manager at the Blagen Mill in White Pines, near Arnold.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.calaverashistory.org/wilseyville",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town sprang up in 1941 as a lumber company town during World II’s shift from mining to timber harvesting.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/Wilseyville,_California",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Howard Blagen laid out Wilseyville and designed the company’s lumber mill, creating a planned community for workers.",
      "sourceSentenceIds": [
        18
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.calaverashistory.org/wilseyville",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Company‑owned homes and a general store lined the streets, giving Wilseyville a classic mill‑town feel in the 1940s.",
      "sourceSentenceIds": [
        20
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.calaverashistory.org/wilseyville",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Wilseyville enjoys a Mediterranean climate, with dry, warm summers and mild, wet winters typical of the Sierra Nevada foothills.",
      "sourceSentenceIds": [
        15
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Wilseyville%2C_California",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Every year, around 750 off‑road racers gather for the Wilseyville Hare Scramble, a popular event that showcases the area’s rugged terrain.",
