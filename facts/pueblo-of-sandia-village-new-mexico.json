  "facts": [
    {
      "id": 1,
      "text": "Sandia Pueblo’s name comes from the Spanish word for watermelon, named after the mountains’ red glow at sunset.",
      "sourceSentenceIds": [
        28
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.newmexico.org/native-culture/native-communities/sandia-pueblo/"
    },
    {
      "id": 2,
      "text": "The Pueblo has been home to the Sandia people since around 1300 AD, making it one of New Mexico’s oldest communities.",
      "sourceSentenceIds": [
        15
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.sandiapueblo.nsn.us/"
    },
    {
      "id": 3,
      "text": "Its reservation spans 22,877 acres, stretching from the foothills of the Sandia Mountains to the Rio Grande’s banks.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.sandiapueblo.nsn.us/"
    },
    {
      "id": 4,
      "text": "The Sandia Mountain is a spiritual center, providing plants, animals, and other resources vital for survival in the desert.",
      "sourceSentenceIds": [
        16
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.sandiapueblo.nsn.us/"
    },
    {
      "id": 5,
      "text": "The Pueblo operates several thriving enterprises, creating a broad economic base that supports its future as a self‑reliant tribe.",
      "sourceSentenceIds": [
        18
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.sandiapueblo.nsn.us/"
    },
    {
      "id": 6,
      "text": "Over 2,000 residents of the Albuquerque area, both Indians and non‑Indians, work for the Pueblo.",
      "sourceSentenceIds": [
        19
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.sandiapueblo.nsn.us/"
    }
  ]
}
