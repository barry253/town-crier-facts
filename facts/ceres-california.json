  "facts": [
    {
      "id": 1,
      "text": "Founded in 1888, Ceres was named after the Roman goddess of agriculture and fertility.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.california.com/city/ceres",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The Whitmore Mansion, built by pioneer Daniel Whitmore in 1867, still stands fully restored by the city and the Ceres Historical Society.",
      "sourceSentenceIds": [
        6,
        7
      ],
      "sourceLabels": [
        "Web source 1",
        "Wikipedia"
      ],
      "source": "https://www.thecrazytourist.com/14-best-things-to-do-in-ceres-ca/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "In the early 1890s, outlaws Chris Evans and John Sontag robbed several Southern Pacific Railroad trains at Ceres.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Ceres%2C_California",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Ceres is also a very important site for American history, featuring some of the earliest human remains found anywhere in the U.S.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.thecrazytourist.com/14-best-things-to-do-in-ceres-ca/",
      "category": "other",
      "quality": "poor",
      "qualityReason": "vague"
    },
    {
      "id": 5,
      "text": "The Ceres Historical Museum highlights items from the town's history, focusing on everyday artifacts used in daily life.",
      "sourceSentenceIds": [
        21
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Ceres%2C_California",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Every spring, Ceres hosts the Street Faire on the first weekend in May, drawing locals and visitors alike.",
