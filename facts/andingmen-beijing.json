  "facts": [
    {
      "id": 1,
      "text": "Andingmen gate was built during the early Ming dynasty when the earlier Anzhenmen gate was moved south, giving the area its historic name.",
      "sourceSentenceIds": [
        16,
        17,
        18
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://english.visitbeijing.com.cn/article/47OMl3QK24O",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The original gate tower measured 31 m by 16.5 m and rose 36 m tall, a striking example of Ming military architecture.",
      "sourceSentenceIds": [
        18
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://english.visitbeijing.com.cn/article/47OMl3QK24O",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The barbican was dismantled in 1915, and the gate tower itself was removed in 1969, erasing most of the original structure.",
      "sourceSentenceIds": [
        20
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://english.visitbeijing.com.cn/article/47OMl3QK24O",
      "category": "other",
      "quality": "poor",
      "qualityReason": "other"
    },
    {
      "id": 4,
      "text": "Today the site hosts Andingmen Bridge, a roundabout overpass on the northern 2nd Ring Road linking inner and outer streets.",
      "sourceSentenceIds": [
        13,
        14
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Andingmen",
      "category": "landmark",
      "quality": "poor",
      "qualityReason": "other"
    },
    {
      "id": 5,
      "text": "Locals once called it Shengmen, meaning “bountiful harvest,” because emperors frequently used the gate to leave the city for prayers at the Temple of Earth.",
      "sourceSentenceIds": [
        24
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://english.visitbeijing.com.cn/article/47OMl3QK24O",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The area is close to Olympic Park, Happy Valley, and the China Science and Technology Museum, making it a hub for modern Beijing attractions.",
      "sourceSentenceIds": [
        1
