  "facts": [
    {
      "id": 1,
      "text": "Aristes got its name when a post office opened in 1897, shortening Aristides, a Greek statesman.",
      "sourceSentenceIds": [
        15
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Aristes",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town began as “Montana” in 1865 when the Red Tavern owner plotted a village along the Old Reading Road.",
      "sourceSentenceIds": [
        13,
        14
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Aristes",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The historic Red Tavern, built around 1800, sits on the old Catawissa‑Reading route and still marks Aristes’ early roots.",
      "sourceSentenceIds": [
        13
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Aristes",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "In 1948, United Airlines Flight 624 crashed into a power line near Aristes, a notable mid‑20th‑century aviation incident.",
      "sourceSentenceIds": [
        16
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Aristes",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Aristes lies just east of Conyngham Township and northeast of the abandoned Centralia ghost town, placing it in a unique geographic corridor.",
      "sourceSentenceIds": [
        17
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Aristes",
      "category": "other",
      "quality": "poor",
      "qualityReason": "location_description"
    },
    {
      "id": 6,
      "text": "The community is served by Pennsylvania Route 42, a key corridor that has connected Aristes to regional trade since the 19th century.",
