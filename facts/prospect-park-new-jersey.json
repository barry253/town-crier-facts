      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.westfieldnj.com/whs/history/prospectpark.htm",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "A historic toll gate once stood on Godwinville Road, east of Belle Avenue, marking early travel routes.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.westfieldnj.com/whs/history/prospectpark.htm",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Cannonball Road, stretching between Preakness and Paramus, saw Continental Army movements during the Revolutionary War.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.westfieldnj.com/whs/history/prospectpark.htm",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Revolutionary leaders, including General Lafayette, used the Dey House as a temporary headquarters while traveling Cannonball Road.",
