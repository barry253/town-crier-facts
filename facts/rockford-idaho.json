    {
      "id": 1,
      "text": "Rockford began as a Mormon pioneer settlement in the 1800s, as members of the Church of Jesus Christ of Latter‑Day Saints pushed north into the Snake River Plain.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/rockford_idaho",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Rockford was established as an unincorporated community the same day Bingham County was created in 1885.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/rockford_idaho",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The town sits on a volcanic plain formed by the Yellowstone hotspot, giving it deep, fertile basaltic soils ideal for farming.",
      "sourceSentenceIds": [
        21
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/rockford_idaho",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Irrigation ditches dug in 1886 near Blackfoot mirrored cooperative projects that enabled a potato and grain boom across the valley.",
      "sourceSentenceIds": [
        11,
        13
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/rockford_idaho",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "During World War II, Bingham County’s potato growers supplied dehydrated products to the U.S. military, with Simplot’s plants processing millions of pounds.",
      "sourceSentenceIds": [
        14,
        16
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/rockford_idaho",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Rockford experiences a semi‑arid continental climate, with cold winters, warm dry summers, about 12 inches of annual precipitation and roughly 28 inches of snowfall.",
