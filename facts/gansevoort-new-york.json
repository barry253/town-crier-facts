      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Gansevoort%2C_New_York",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Before settlers, Mohawk and Iroquois Indians inhabited the area, leaving burial mounds and artifacts still visible today.",
      "sourceSentenceIds": [
        4,
        9
      ],
      "sourceLabels": [
        "Wikipedia",
