  "facts": [
    {
      "id": 1,
      "text": "Dry Run was originally called Morrowstown, named after founder Stephen Skinner's wife's maiden name Morrow.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Dry_Run%2C_Pennsylvania",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town was founded in 1838 by Stephen Skinner, whose descendants live in Chambersburg and Path Valley.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.therecordherald.com/story/news/history/2026/01/13/dry-run-franklin-county-pennsylvania-fannettsburg-path-valley-lee-daywalt-preserving-heritage/88102921007/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "A post office has operated in Dry Run since 1825, long before the town was platted.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Dry_Run%2C_Pennsylvania",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The Dry Run Academy, now the town hall and public school, was built in 1874 for $3,000.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.therecordherald.com/story/news/history/2026/01/13/dry-run-franklin-county-pennsylvania-fannettsburg-path-valley-lee-daywalt-preserving-heritage/88102921007/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "In 1906 Dry Run was described as a bustling village with a prominent hotel, several stores, and a town hall.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.therecordherald.com/story/news/history/2026/01/13/dry-run-franklin-county-pennsylvania-fannettsburg-path-valley-lee-daywalt-preserving-heritage/88102921007/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The Miller Hotel, rebuilt after a fire, was once considered one of the best-equipped hotels in the county.",
      "sourceSentenceIds": [
