  "facts": [
    {
      "id": 1,
      "text": "Applegate was originally settled in 1849 by Lisbon Applegate, who came from Missouri.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Applegate%2C_California"
    },
    {
      "id": 2,
      "text": "The town grew and was once called Bear River House because of its proximity to the Bear River.",
      "sourceSentenceIds": [
        21
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Applegate%2C_California"
    },
    {
      "id": 3,
      "text": "In the 1870s the settlement was renamed Applegate to honor its founder after a post office was established in 1855.",
      "sourceSentenceIds": [
        3,
        22
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Applegate%2C_California"
    },
    {
      "id": 4,
      "text": "Applegate was a station on the Central Pacific Railroad, later Southern Pacific, and had a second track added in 1929 named East Applegate.",
      "sourceSentenceIds": [
        4,
        1,
        2
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Applegate%2C_California"
    },
    {
      "id": 5,
      "text": "The main house of the Applegate Ranch now houses Oliver's gas station and bar, a nod to the family’s fruit ranch roots.",
      "sourceSentenceIds": [
        14,
        15
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Applegate%2C_California"
    },
    {
      "id": 6,
      "text": "Applegate sits 2,005 feet above sea level, about 7.25 miles south-southwest of Colfax and 9.3 miles northeast of Auburn.",
