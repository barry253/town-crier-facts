      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The village became the seventh community in the Amana Colonies, joining six earlier villages along the Iowa River valley.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/homestead_iowa",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The 1865 Homestead Church now operates as a museum that preserves the village’s utopian history.",
