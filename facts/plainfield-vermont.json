  "facts": [
    {
      "id": 1,
      "text": "Plainfield is nestled along the waterways of the Winooski River and the Great Brook.",
      "sourceSentenceIds": [
        21
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.plainfieldvt.gov/plainfield-history.html"
    },
    {
      "id": 2,
      "text": "The Winooski River was named Winooski-Took, meaning Onion Land River, for the wild onions that grew along its banks.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.plainfieldvt.gov/plainfield-history.html"
    },
    {
      "id": 3,
      "text": "Plainfield once had a train station with wood fired steam engines that carried passengers, lumber, and granite.",
      "sourceSentenceIds": [
        28
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.plainfieldvt.gov/plainfield-history.html"
    },
    {
      "id": 4,
      "text": "A sawmill near the old train station once cut local ash wood for a tennis racket factory in Rhode Island.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.plainfieldvt.gov/plainfield-history.html"
    },
    {
      "id": 5,
      "text": "Plainfield retains the influence of the back-to-the-land movement of the 1960s.",
      "sourceSentenceIds": [
