      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The Soo Line Railroad arrived in 1904, prompting Strandquist's store to relocate and leading to the closure of the nearby Lund post office in 1905.",
      "sourceSentenceIds": [
        5,
        11,
        12,
        13
      ],
