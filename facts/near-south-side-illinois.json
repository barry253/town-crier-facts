      "quality": "good"
    },
    {
      "id": 2,
      "text": "DuSable Museum of African American History and Pullman National Monument are landmarks offering insights into that period.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://chicago-beautiful.com/exploring-the-south-side-of-chicago/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "South Side once called “Black Metropolis,” filled with art galleries, murals, historic landmarks, and the city’s first Black‑owned microbrewery.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.choosechicago.com/south-side-chicago/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The Water Tower landmark sits on Water Tower Park with its historic clock and neighbors the eight‑level Water Tower Place shopping center.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Near_North_Side%2C_Chicago",
