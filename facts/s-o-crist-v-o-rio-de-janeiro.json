  "facts": [
    {
      "id": 1,
      "text": "The Palace of São Cristóvão became home to the National Museum in 1892, preserving Brazil’s scientific heritage.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Pa%C3%A7o_de_S%C3%A3o_Crist%C3%B3v%C3%A3o",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Before the 2018 fire, the palace housed 92.5% of the National Museum’s collections, making it a national treasure.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Pa%C3%A7o_de_S%C3%A3o_Crist%C3%B3v%C3%A3o",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "After a long restoration, the palace reopened to the public in 2025, welcoming visitors to its historic halls.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Pa%C3%A7o_de_S%C3%A3o_Crist%C3%B3v%C3%A3o",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Situated in the Quinta da Boa Vista park, São Cristóvão offers sweeping views of the Tijuca Forest and Corcovado.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Pa%C3%A7o_de_S%C3%A3o_Crist%C3%B3v%C3%A3o",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "From 1808 to 1889, the palace served as the residence of both the Portuguese royal family and the Brazilian imperial family.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Pa%C3%A7o_de_S%C3%A3o_Crist%C3%B3v%C3%A3o",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "In 1889, the provisional government briefly used the palace as the venue for the constituent assembly drafting Brazil’s first republican constitution.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Pa%C3%A7o_de_S%C3%A3o_Crist%C3%B3v%C3%A3o",
      "category": "history",
      "quality": "good"
    }
