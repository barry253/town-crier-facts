    {
      "id": 2,
      "text": "The community’s post office opened in 1890, marking Redford’s early role as a local mail hub amid a timber‑rich region.",
      "sourceSentenceIds": [
        6,
        17
      ],
      "sourceLabels": [
        "Web source 1",
