      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Pinhook%2C_Missouri",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "In May 2011, the Mississippi River flooded Pinhook after the Army Corps breached Bird's Point Levee.",
      "sourceSentenceIds": [
        16,
        17,
        18,
        19
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Pinhook%2C_Missouri",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "After the flood, residents were left to fend for themselves before eventually resettling in East Prairie and Sikeston.",
      "sourceSentenceIds": [
        20
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
