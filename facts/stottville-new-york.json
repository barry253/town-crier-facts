  "facts": [
    {
      "id": 1,
      "text": "Stottville was renamed after the Stott family, whose founders built the village's early mills.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/stottville_new_york",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The village grew around woolen mills powered by Claverack and Kinderhook Creeks, which joined to form Stockport Creek.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/stottville_new_york",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Remnants of a large brick factory still stand along Claverack Creek, offering a glimpse of the 19th‑century textile industry.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/stottville_new_york",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The Gardner and Whitney Ice Cream Company, founded in 1872 by Charles E., began operations in Stottville.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/stottville_new_york",
      "category": "economy",
      "quality": "poor",
      "qualityReason": "dropped_surname_no_wiki_source"
    },
    {
      "id": 5,
      "text": "At its peak, four mills lined the creek, employing hundreds of weavers and spinners; two ruins remain today.",
