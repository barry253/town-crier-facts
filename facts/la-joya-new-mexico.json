  "facts": [
    {
      "id": 1,
      "text": "La Joya sits on the east bank of the Rio Grande, about 20 miles north of Socorro.",
      "sourceSentenceIds": [
        15
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/La_Joya%2C_New_Mexico",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The community was first settled in 1598 by Piro Indians who built a pueblo at the site.",
      "sourceSentenceIds": [
        16
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/La_Joya%2C_New_Mexico",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "In 1581 a Spanish expedition led by friar Rodriquez and Captain Chamascado reached the northernmost Piro pueblo, later called Sevilleta.",
      "sourceSentenceIds": [
        1,
        19
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.amigosdelasevilleta.org/cultural-history",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The Sevilleta land grant became a cattle ranch in 1946 when Thomas Campbell bought out John Raskob.",
      "sourceSentenceIds": [
        10,
        21
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.amigosdelasevilleta.org/cultural-history",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "In 1973 the Sevilleta area was turned into a National Wildlife Refuge, preserving its historic landscape.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.amigosdelasevilleta.org/cultural-history",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "A 2006 master’s thesis by Ramona L. Rand‑Caplan documents oral histories from La Joya in the 1930s, offering a unique local perspective.",
