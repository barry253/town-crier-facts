    {
      "id": 1,
      "text": "Berkeley Heights began as New Providence Township on November 8, 1809, carved from Springfield Township while still part of Essex County.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.berkeleyheights.gov/1484/Berkeley-Heights-History",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The township takes its name from John Berkeley, 1st Baron Berkeley of Stratton, one of New Jersey’s founding figures.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Berkeley_Heights%2C_New_Jersey",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "A small village called Feltville grew around a mill built by Felt, giving the area its early industrial character.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Berkeley_Heights%2C_New_Jersey",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Berkeley Heights straddles the crest of the Second Watchung Mountain and the Passaic River Valley, with the river marking its northern edge.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Berkeley_Heights%2C_New_Jersey",
      "category": "nature",
      "quality": "poor",
      "qualityReason": "vague"
    },
    {
      "id": 5,
      "text": "The Berkeley Heights Public Library opened in 1949 but later closed its 290 Plainfield Avenue location to the public.",
      "sourceSentenceIds": [
