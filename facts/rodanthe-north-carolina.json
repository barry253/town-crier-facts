    },
    {
      "id": 2,
      "text": "The Chicamacomico Life‑Saving Station, now a museum, was decommissioned in 1954 and is one of the most complete historic stations in the U.S.",
      "sourceSentenceIds": [
        1,
        4,
        17
      ],
