      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "In 1918, men at Chicamacomico rescued 42 sailors during a German U‑Boat attack, a pivotal Coast Guard event.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Web source 2"
      ],
