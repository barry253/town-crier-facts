      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Rodanthe’s name comes from the larger Chicamacomico settlement that once included Waves and Salvo.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.outerbanksvacations.com/blog/about-rodanthe-nc-history-restaurants-things-do",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The town hosted exterior shots for Nicholas Sparks’ “Nights in Rodanthe,” making the Inn at Rodanthe a film landmark.",
      "sourceSentenceIds": [
        13,
        7
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.outerbanksvacations.com/blog/about-rodanthe-nc-history-restaurants-things-do",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Rodanthe observes “Old Christmas” on January 6, a tradition from settlers who used the Julian calendar.",
