      "quality": "good"
    },
    {
      "id": 2,
      "text": "The fort that now sits in Mackinaw City was preserved as an open‑air historical museum and is a National Historic Landmark.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
