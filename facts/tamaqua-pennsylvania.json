  "facts": [
    {
      "id": 1,
      "text": "Tamaqua was originally to be named Tuscarora, but the name Tamaqua was chosen after realizing another Tuscarora existed nearby.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Tamaqua%2C_Pennsylvania",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The 55‑block Tamaqua Historic District, including the Anthracite Bank Building and George Ormrod House, is on the National Register of Historic Places.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Tamaqua%2C_Pennsylvania",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The town’s Victorian‑era train station, built in 1874, still stands and houses the Tamaqua Historical Society Museum.",
      "sourceSentenceIds": [
        6,
        7
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Tamaqua%2C_Pennsylvania",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Tamaqua’s roots trace back to 1799 when settlers Burkhardt Moser, Jacob Moser, and John Kershner built a sawmill at the Little Schuylkill River and Panther Creek confluence.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Tamaqua%2C_Pennsylvania",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "In the 1840s and 1850s, Irish, Welsh, and German immigrants settled Tamaqua, followed by large waves of Italians, Lithuanians, Russians, Ukrainians, Slovaks, and Poles in the 1890s.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Tamaqua%2C_Pennsylvania",
      "category": "people",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The active Reading, Blue Mountain & Northern Railroad still crosses the borough north‑south west of Five Points, a junction of PA Routes 209, 309, and Mauch Chunk Street.",
      "sourceSentenceIds": [
        27,
