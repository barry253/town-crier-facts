      "id": 1,
      "text": "Stanford, California, takes its name from the university founded in 1885 by railroad magnate Leland Stanford and his wife Jane to honor their son.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/Stanford,_California",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "In the 1920s, former president Herbert Hoover helped stabilize Stanford’s finances and founded the Hoover Institution on War, Revolution and Peace in 1919.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/Stanford,_California",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Postwar years saw Stanford become a hub for electronics and computing precursors, driving the surrounding community’s shift from rural to tech‑adjacent.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/Stanford,_California",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The Stanford CDP remains unincorporated, while most of the university campus lies within it; the Stanford Shopping Center and Research Park belong to Palo Alto.",
      "sourceSentenceIds": [
        16
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Stanford%2C_California",
      "category": "other",
      "quality": "poor",
      "qualityReason": "location_description"
    },
    {
      "id": 5,
      "text": "Stanford’s climate features warm, dry summers with average highs never exceeding 77.6 °F and cool, wet winters that stay above 37.7 °F.",
