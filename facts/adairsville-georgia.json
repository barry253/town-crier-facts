      "category": "economy",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Downtown Adairsville feels like a Norman Rockwell scene, offering history, antiquing, and good food.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.adairsvillega.net/community/downtown_adairsville/index.php",
