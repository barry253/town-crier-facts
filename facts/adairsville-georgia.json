      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Railroad magnate William Watts brought the Western and Atlantic Railroad to Adairsville, earning it the nickname “Granary of the State.”.",
      "sourceSentenceIds": [
        4,
        5,
        6,
        28
      ],
      "sourceLabels": [
