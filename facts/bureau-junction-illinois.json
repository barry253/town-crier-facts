  "facts": [
    {
      "id": 1,
      "text": "Bureau Junction gets its name from Michel or Pierre Bureau, early settlers who helped shape the area.",
      "sourceSentenceIds": [
        1,
        15
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Bureau_Junction%2C_Illinois",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "In the 1870s, Bureau Junction became a key railroad hub, splitting the Rock Island Line to Peoria and serving as the midway point between Chicago and Rock Island.",
      "sourceSentenceIds": [
        6,
        7,
        8
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Bureau_Junction%2C_Illinois",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The village sits where the Illinois River meets Bureau Creek, about 50 miles north of Peoria and 100 miles southwest of Chicago.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.citydirectory.us/village-bureau-junction.html",
      "category": "other",
      "quality": "poor",
      "qualityReason": "location_description"
    },
    {
      "id": 4,
      "text": "The nearby historic Hennepin Canal offers a scenic reminder of 19th‑century engineering.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://bureaucounty-il.gov/tourism/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Crossing Bureau Creek, you can spot the old Red Covered Bridge or the newer Captain Swift Covered Bridge, both landmarks of local heritage.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Web source 2"
      ],
