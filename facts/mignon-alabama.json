  "facts": [
    {
      "id": 1,
      "text": "Mignon grew around Avondale Mills, a textile plant started in 1897 by former Alabama governor Braxton Bragg Comer.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/mignon_alabama",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Mignon is named after Eva Mignon Comer, B.B. Comer's second daughter, reflecting the family’s deep ties to the area.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/mignon_alabama",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Comer Memorial High School began as a private school for mill workers’ children in 1911, becoming public in 1937 with federal PWA help.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/mignon_alabama",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Mignon briefly incorporated around 1915, then returned to unincorporated status in the 1930s as the mill’s influence waned.",
      "sourceSentenceIds": [
        29
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/mignon_alabama",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Early settlers arrived after the 1832 Treaty of Cusseta, when Creek lands were ceded, and Talladega County was formed the same year.",
      "sourceSentenceIds": [
