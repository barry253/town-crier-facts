  "facts": [
    {
      "id": 1,
      "text": "East Columbia was founded in 1824 by Josiah Hughes Bell, a South Carolina native who came to Texas with Stephen F. Austin.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/East_Columbia%2C_Texas",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Bell first built a landing on the Brazos River called Bell’s Landing, then laid out a town named Marion, and by 1842 the settlement was renamed East Columbia.",
      "sourceSentenceIds": [
        5,
        6,
        9
      ],
      "sourceLabels": [
        "Web source 1",
        "Web source 2"
      ],
      "source": "https://www.tshaonline.org/handbook/entries/east-columbia-tx",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The Houston Tap and Brazoria Railroad reached East Columbia in 1859, but the Civil War halted its growth and pushed the town into decline.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.tshaonline.org/handbook/entries/east-columbia-tx",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "East Columbia was one of Texas’s most important inland ports, supplying the plantation economy that flourished along the Brazos River in the 19th century.",
      "sourceSentenceIds": [
        25,
        26
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
