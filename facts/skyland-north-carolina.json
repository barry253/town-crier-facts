  "facts": [
    {
      "id": 1,
      "text": "Skyland was founded in 1887 by real estate developer Otis A. Miller.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/skyland_north_carolina",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Miller’s original plat named streets after his family, including Otis Street.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/skyland_north_carolina",
      "category": "people",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The Skyland Springs Hotel opened in 1888, hosting social events for visitors from major cities.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/skyland_north_carolina",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Miller envisioned Skyland as a resort with 20 medicinal springs, a racetrack, lake, and its own railroad depot.",
      "sourceSentenceIds": [
        11
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/skyland_north_carolina",
      "category": "other",
      "quality": "poor",
      "qualityReason": "editorial_filler"
    },
    {
      "id": 5,
      "text": "Today Skyland is a residential neighborhood in the Asheville metro, home to the Skyland/South Buncombe Library opened in 1962.",
      "sourceSentenceIds": [
        15
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/skyland_north_carolina",
      "category": "other",
      "quality": "poor",
      "qualityReason": "editorial_filler"
    },
    {
      "id": 6,
      "text": "Skyland sits north of Royal Pines, south of Biltmore Forest, and is a suburb of Asheville.",
      "sourceSentenceIds": [
        16,
        17,
        18
      ],
