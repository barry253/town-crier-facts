  "facts": [
    {
      "id": 1,
      "text": "Saint David was founded in 1877 by Mormon pioneers arriving on the San Pedro River on Nov 29, seeking a new settlement.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/St._David,_Arizona",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town was named after David Patten Kimball, a local Mormon leader.",
      "sourceSentenceIds": [
        3,
        6
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 2"
      ],
      "source": "https://en.wikipedia.org/wiki/St._David%2C_Arizona",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "A brick schoolhouse built in 1938 still stands and is on the National Register of Historic Places.",
      "sourceSentenceIds": [
        11
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/St._David%2C_Arizona",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The annual 1880s Historic Costume Ball at the school reenacts a post‑bellum Indian War‑era military ball.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/St._David%2C_Arizona",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Saint David hosts the Holy Trinity Benedictine Monastery, founded in 1974, featuring a meditation garden, bird sanctuary, and Stations of the Cross trail.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/St._David,_Arizona",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The historic driving tour includes the original 1920 Apache Powder Company facility, a 2025 San Pedro River bridge, and century‑old trees planted by settlers.",
      "sourceSentenceIds": [
        17
