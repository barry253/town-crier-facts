  "facts": [
    {
      "id": 1,
      "text": "Bridge City earned its name in 1938 when the Port Arthur-Orange Bridge, now called the Rainbow Bridge, opened over the Neches River.",
      "sourceSentenceIds": [
        6,
        26
      ],
      "sourceLabels": [
        "Web source 2",
        "Wikipedia"
      ],
      "source": "https://www.east-texas.com/bridge-city-texas.htm",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The city’s borders run along the Neches River and Cow Bayou, placing it right on the Gulf of Mexico’s inland waterways.",
      "sourceSentenceIds": [
        23
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Bridge_City%2C_Texas",
      "category": "nature",
      "quality": "poor",
      "qualityReason": "location_description"
    },
    {
      "id": 3,
      "text": "Bridge City sits 100 miles east of Houston, within the Beaumont–Port Arthur Metropolitan Statistical Area.",
      "sourceSentenceIds": [
        22,
        24
      ],
      "sourceLabels": [
        "Wikipedia",
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Bridge_City%2C_Texas",
      "category": "other",
      "quality": "poor",
      "qualityReason": "location_description"
    },
    {
      "id": 4,
      "text": "Oil and petroleum products have long defined Bridge City’s economy, shaping its development since the early 20th century.",
      "sourceSentenceIds": [
        25
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Bridge_City%2C_Texas",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The town has faced numerous hurricanes and tropical storms, a common challenge for communities along Texas’s coast.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Bridge_City%2C_Texas",
