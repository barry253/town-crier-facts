      "quality": "good"
    },
    {
      "id": 2,
      "text": "Legend says George Washington slept in comfort at the Shine Inn during his 1791 Southern tour, and the town’s name stuck.",
      "sourceSentenceIds": [
        7,
        8,
        9
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Comfort%2C_North_Carolina",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The original settlement, called Old Comfort, grew around the historic Shine plantations.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Comfort%2C_North_Carolina",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Comfort was one of four early settlements in Jones County, alongside Pollocksville, Trenton, and Maysville.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Comfort%2C_North_Carolina",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Early maps describe Comfort as a crossroads that may have been little more than a junction in the county’s eastern part.",
