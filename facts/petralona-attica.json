  "facts": [
    {
      "id": 1,
      "text": "Petralona’s name comes from the Greek 'Petrina Alonia', literally 'stone threshing floors', once used to grind grain before the area urbanised.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Petralona",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "A metro line cuts through Petralona, splitting it into Upper and Lower areas that locals still distinguish today.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.travel.gr/en/explore-en/petralona-a-journey-into-the-heart-of-athens-folk-culture/",
      "category": "other",
      "quality": "poor",
      "qualityReason": "editorial_filler"
    },
    {
      "id": 3,
      "text": "Alkminis Street once housed the KOPER pharmaceutical factory, now home to The Hub art space that marks the shift from industry to culture.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.travel.gr/en/explore-en/petralona-a-journey-into-the-heart-of-athens-folk-culture/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "On Troon Street, the Zephyros open‑air cinema, dating back to 1938, still lights up summer evenings for movie lovers.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.travel.gr/en/explore-en/petralona-a-journey-into-the-heart-of-athens-folk-culture/",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Petralona F.C., founded in 1983 after merging AO and GS Petralona, carries the neighborhood’s sporting spirit into the present.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Petralona",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Dexameni Hill, where the underground Ilissos River flows, sits at the crossroads of Kilis and Kallirois streets in Upper Petralona.",
