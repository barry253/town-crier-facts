      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "James Kellar erected Lovington’s first building in 1838, a wooden structure that still marks the town’s origins.",
      "sourceSentenceIds": [
        30
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.lovingtonil.com/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Lovington was officially incorporated as a village in 1873, solidifying its community status.",
