  "facts": [
    {
      "id": 1,
      "text": "Port Deposit sits on the east bank of the Susquehanna River near its mouth into Chesapeake Bay.",
      "sourceSentenceIds": [
        14
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Port_Deposit%2C_Maryland",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "In 1812 the town was officially named Port Deposite after a bill signed by Governor Levin Winder, dropping the trailing 'e' later.",
      "sourceSentenceIds": [
        26
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Port_Deposit%2C_Maryland",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The Susquehanna and Tidewater Canal, completed in 1812, redirected barge traffic into Port Deposit, sparking rapid growth.",
      "sourceSentenceIds": [
        27,
        29
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Port_Deposit%2C_Maryland",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Jacob Tome founded the Jacob Tome School for Boys on Main Street in 1889, part of the Jacob Tome Institute system.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Port_Deposit%2C_Maryland",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The historic Tome Gas House, built circa 1850 from local granite, originally supplied power to the Jacob Tome mansion and now houses the Tome Visitor Center.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Web source 1"
      ],
