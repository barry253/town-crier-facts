  "facts": [
    {
      "id": 1,
      "text": "Horsham’s historic core, the Carfax, once hosted twice‑weekly markets in a triangular open space that shaped the town’s layout.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.horshamsociety.org/horsham-past",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "In 1887, the Tanbridge house became one of the first homes in Horsham to light its rooms with electricity, built by a wealthy railway contractor.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.horshamsociety.org/horsham-past",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The town’s name appears on what was probably the first national “recommended routes” map, a milestone sixty years after its founding.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.horshamsociety.org/horsham-past",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "During the Revolutionary War, Graeme Park hosted three U.S. encampments in 1776‑77, a key military site in the area.",
      "sourceSentenceIds": [
        30
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://horshampreservation.org/history/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Horsham’s Biddle Air National Guard Base sits on the former Naval Air Station Joint Reserve Base Willow Grove, linking the town to national defense history.",
      "sourceSentenceIds": [
        16
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Horsham%2C_Pennsylvania",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The oldest surviving buildings in Horsham date back to the early colonial period, and several are listed on the National Register of Historic Places.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Web source 1"
      ],
