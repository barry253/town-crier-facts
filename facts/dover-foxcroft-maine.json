  "facts": [
    {
      "id": 1,
      "text": "The Dover‑Foxcroft Historical Society, a non‑profit, preserves artifacts and stories from Dover and Foxcroft, keeping the town’s heritage alive.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
