  "facts": [
    {
      "id": 1,
      "text": "Belle Prairie City was platted in February 1862 with 25 original lots along Main Street, reflecting mid‑19‑century settlement patterns driven by migration from Kentucky and Tennessee.",
      "sourceSentenceIds": [
        22
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/belle_prairie_city_illinois",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town formally incorporated on March 30, 1869, establishing a post office around 1867 and operating a grist and saw mill by 1863.",
      "sourceSentenceIds": [
        23
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/belle_prairie_city_illinois",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Belle Prairie City’s name evolved from Belle City to Belle Prairie, a nod to the fertile prairie lands that attracted settlers in the 1840s.",
      "sourceSentenceIds": [
        2,
        5
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/belle_prairie_city_illinois",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Early settlers such as William C. Davis, born in Kentucky, expanded his farm to about 200 acres after moving to the area in 1845.",
      "sourceSentenceIds": [
        28
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/belle_prairie_city_illinois",
      "category": "people",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Belle Prairie City sits on a modest 0.4 square miles of all‑land territory within Crouch Township, surrounded by the rural prairie landscape of southern Illinois.",
