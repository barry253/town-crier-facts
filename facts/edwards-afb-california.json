  "facts": [
    {
      "id": 1,
      "text": "In December 1949, Muroc was renamed Edwards Air Force Base to honor Captain Glen Edwards, who died in a 1948 YB‑49 crash.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Edwards_Air_Force_Base",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Edwards AFB became the primary landing area for the Space Shuttle from 1981 until its final flight in 2011, thanks to its vast lakebeds and proximity to Plant 42.",
      "sourceSentenceIds": [
        22
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Edwards_Air_Force_Base",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The base’s first major speed record came when the X‑1 rocket plane broke Mach 1 over Edwards in 1947, a milestone that sparked global aviation history.",
      "sourceSentenceIds": [
        28
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Edwards_Air_Force_Base",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Pancho Barnes’ Rancho Oro Verde Fly‑Inn Dude Ranch, built in the 1930s, hosted legendary parties and became a cultural icon of early Edwards aviation life.",
      "sourceSentenceIds": [
        27
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Edwards_Air_Force_Base",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Edwards AFB’s F‑22A “Raptor” continues to undergo testing there, keeping the base at the forefront of modern fighter development.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Edwards_Air_Force_Base",
      "category": "other",
      "quality": "poor",
      "qualityReason": "other"
    },
    {
      "id": 6,
      "text": "The F‑35 Lightning II’s Block 2 and 3 initial operational tests are conducted by an Air Force Materiel Command detachment based at Edwards.",
      "sourceSentenceIds": [
        9
