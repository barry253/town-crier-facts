      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Trinity_Center%2C_California",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Trinity Lake, formed by the 1961 Trinity River Dam, now surrounds the town and attracts summer visitors.",
      "sourceSentenceIds": [
        23,
        25
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 2"
      ],
      "source": "https://en.wikipedia.org/wiki/Trinity_Center%2C_California",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Gold rush arrivals included about 3,000 Chinese laborers who helped shape the region.",
