      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Israel Moore laid out Searcy’s first streets, naming them after Philadelphia streets like Race, Arch, and Market.",
      "sourceSentenceIds": [
        2,
        6
      ],
      "sourceLabels": [
