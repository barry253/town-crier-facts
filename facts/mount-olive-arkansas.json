  "facts": [
    {
      "id": 1,
      "text": "Mount Olive became Izard County seat in 1836, but lost that status when the seat moved to Melbourne in 1875.",
      "sourceSentenceIds": [
        14,
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/mount_olive_izard_county_arkansas"
    },
    {
      "id": 2,
      "text": "Jehoiada Jeffery, a War of 1812 veteran, established the first permanent homestead in Mount Olive around 1816.",
      "sourceSentenceIds": [
        5,
        25
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/mount_olive_izard_county_arkansas"
    },
    {
      "id": 3,
      "text": "In 1826, Jehoiada and Daniel Jeffery chartered the Mount Olive Cumberland Presbyterian congregation, one of the county's earliest churches.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/mount_olive_izard_county_arkansas"
    },
    {
      "id": 4,
      "text": "On June 17, 1862, a skirmish erupted in Mount Olive between early rebel and Union forces, one of the region's first Civil War engagements.",
      "sourceSentenceIds": [
        20
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/mount_olive_izard_county_arkansas"
    },
    {
      "id": 5,
      "text": "By the early 1900s, Mount Olive boasted a railroad depot, with dirt roads lined by buildings alongside tracks.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/mount_olive_izard_county_arkansas"
    },
    {
      "id": 6,
      "text": "Today, Mount Olive remains largely agricultural, with the historic Cumberland Presbyterian Church still active.",
      "sourceSentenceIds": [
        23
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/mount_olive_izard_county_arkansas"
