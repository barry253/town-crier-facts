    },
    {
      "id": 2,
      "text": "The town’s name comes from Wampanoag Cushnea meaning “peaceful resting place near water,” referencing the river that runs through Acushnet Center.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Wikipedia"
