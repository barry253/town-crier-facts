      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Founded in 1822 as a Missouri Fur Company trading post, Bellevue is Nebraska’s oldest continuous settlement.",
      "sourceSentenceIds": [
