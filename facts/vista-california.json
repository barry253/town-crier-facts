  "facts": [
    {
      "id": 1,
      "text": "Vista’s name comes from the Spanish word for \"view,\" a nod to the city’s scenic outlooks.",
      "sourceSentenceIds": [
        18
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Vista%2C_California",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Just seven miles from the Pacific, Vista enjoys a classic Mediterranean climate with mild, wet winters and dry summers.",
      "sourceSentenceIds": [
        20
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Vista%2C_California",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The Rancho Guajome Adobe, a National Historic Landmark, stands in Vista as a preserved example of 19th‑century adobe architecture.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Vista%2C_California",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Tourists can step into history at the Rancho Buena Vista Adobe, a mid‑century ranch house open for guided visits.",
      "sourceSentenceIds": [
        11
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Vista%2C_California",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Long before settlers arrived, the Luiseño people inhabited the Vista area, naming the land Tovalum.",
      "sourceSentenceIds": [
        6,
        9
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
