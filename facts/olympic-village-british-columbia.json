  "facts": [
    {
      "id": 1,
      "text": "Olympic Village was built to house 2,800 athletes, coaches, and officials for the 2010 Winter Olympics and Paralympics.",
      "sourceSentenceIds": [
        4,
        3
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/2010_Olympic_Village",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The Village spans over a million square feet and contains more than a thousand residential units, making it one of Vancouver’s largest mixed‑use communities.",
      "sourceSentenceIds": [
        4,
        12
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/2010_Olympic_Village",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Completed on 1 November 2009, the Village was handed over to the Vancouver Organizing Committee just weeks before the Games opened.",
      "sourceSentenceIds": [
        22
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/2010_Olympic_Village",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "After the Games, the accommodations were converted into permanent residential housing, creating a vibrant neighborhood that now sits at the core of Southeast False Creek.",
      "sourceSentenceIds": [
        9,
        19
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/2010_Olympic_Village",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The Village’s design earned it North America’s first LEED Platinum certification, a first for a large urban development.",
      "sourceSentenceIds": [
        13
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/2010_Olympic_Village",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "A former industrial site, the Village sparked the revitalization of False Creek, turning a neglected waterfront into a lively community hub.",
      "sourceSentenceIds": [
        30
      ],
