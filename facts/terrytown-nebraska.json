  "facts": [
    {
      "id": 1,
      "text": "Terrytown sprang to life in 1949, founded by Terry Carpenter, a Scottsbluff businessman who later served as a Nebraska state senator.",
      "sourceSentenceIds": [
        1,
        2
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Terrytown%2C_Nebraska",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town sits on the North Platte River, tucked between the larger cities of Scottsbluff and Gering.",
      "sourceSentenceIds": [
        6,
        26
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Terrytown%2C_Nebraska",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Terrytown is part of the Scottsbluff Micropolitan Statistical Area, a region that ranks as Nebraska’s seventh largest urban cluster.",
      "sourceSentenceIds": [
        5,
        25
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Terrytown%2C_Nebraska",
      "category": "other",
      "quality": "poor",
      "qualityReason": "location_description"
    },
    {
      "id": 4,
      "text": "Before 1955, Terry Carpenter ran the Carena Drive‑In, a local landmark that could accommodate up to 600 cars.",
      "sourceSentenceIds": [
        29,
        30
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.terrytown.org/terrytown-history.html",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Public transit arrived on January 10, 2018, when Tri‑City Roadrunner launched two bus routes serving Terrytown residents.",
      "sourceSentenceIds": [
        21
      ],
      "sourceLabels": [
