  "facts": [
    {
      "id": 1,
      "text": "Leoti was founded in 1885 by a company of men from Garden City, Kansas.",
      "sourceSentenceIds": [
        1,
        3
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 2"
      ],
      "source": "https://en.wikipedia.org/wiki/Leoti%2C_Kansas",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Leoti’s name may come from an Indian term meaning “prairie flower,” a settler named Leoti Kibbee, or the daughter of a town founder, Leoti Gray.",
      "sourceSentenceIds": [
        2,
        4,
        5
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 2"
      ],
      "source": "https://en.wikipedia.org/wiki/Leoti%2C_Kansas",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "In 1887, Leoti was the site of the bloodiest county seat fight in the American West, with a shoot‑out that left several dead and wounded.",
      "sourceSentenceIds": [
        7,
        22
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Leoti%2C_Kansas",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The Missouri Pacific Railroad arrived in 1885, followed by the Atchison, Topeka & Santa Fe line, making Leoti a railroad hub in its early years.",
      "sourceSentenceIds": [
        11,
        12
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://legendsofkansas.com/leoti-kansas/",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Leoti’s wild western past is on display at the Museum of the Great Plains and the historic Washington Ames House.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.travelks.com/places-to-visit/cities/leoti/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "In the early 1980s, Leoti donated its Auditorium and City Hall to the Wichita Historical Society, and the building joined the National Register of Historic Places in 2019.",
      "sourceSentenceIds": [
        15,
        17
      ],
      "sourceLabels": [
        "Web source 2"
      ],
