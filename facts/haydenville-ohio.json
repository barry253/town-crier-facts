  "facts": [
    {
      "id": 1,
      "text": "Haydenville was founded in 1852 by industrialist Peter Hayden, who named the town after himself.",
      "sourceSentenceIds": [
        3,
        4
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Haydenville%2C_Ohio"
    },
    {
      "id": 2,
      "text": "Peter Hayden built the town around a brick factory, coal mines, and sandstone quarries, making it Ohio’s last entirely owned company town.",
      "sourceSentenceIds": [
        1,
        15,
        29
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.hockinghillsohio.org/blog/haydenville-ohio-last-company-town.html"
    },
    {
      "id": 3,
      "text": "A mile‑long Haydenville Tunnel once carried clay to the brick plant and still lies open, visible just south of the cemetery.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.hockinghillsohio.org/blog/haydenville-ohio-last-company-town.html"
    },
    {
      "id": 4,
      "text": "Redrow Holler, a hill above Haydenville, was once called Hopperville and featured rows of red‑brick houses built from the company’s own clay.",
      "sourceSentenceIds": [
        5,
        7
      ],
      "sourceLabels": [
        "Web source 1",
        "Web source 2"
      ],
      "source": "https://www.hockinghillsohio.org/blog/haydenville-ohio-last-company-town.html"
    },
    {
      "id": 5,
      "text": "The town’s historic houses, many built in the 1880s and 1890s from tile block, still stand today and are home to residents.",
      "sourceSentenceIds": [
        8,
        21
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.hockinghillsohio.org/blog/haydenville-ohio-last-company-town.html"
    },
    {
      "id": 6,
      "text": "The Hocking Valley Scenic Railway passes through Haydenville, where conductors point out the town’s brick‑making heritage on narrated trips.",
      "sourceSentenceIds": [
        20
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.hockinghillsohio.org/blog/haydenville-ohio-last-company-town.html"
    }
