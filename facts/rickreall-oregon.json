  "facts": [
    {
      "id": 1,
      "text": "Rickreall was originally inhabited by the Luckiamute band of the Kalapuya people, who used the landscape for seasonal hunting and gathering.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/rickreall_oregon"
    },
    {
      "id": 2,
      "text": "The community takes its name from Rickreall Creek, which may have been influenced by French Métis settlers in the fertile valley.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/rickreall_oregon"
    },
    {
      "id": 3,
      "text": "Nathaniel Ford served as the first postmaster when the Rickreall post office was established in 1851.",
      "sourceSentenceIds": [
        24
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Rickreall%2C_Oregon"
    },
    {
      "id": 4,
      "text": "Rickreall was often called Dixie during the Civil War era due to the Southern sympathies of the local population.",
      "sourceSentenceIds": [
        28
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Rickreall%2C_Oregon"
    },
    {
      "id": 5,
      "text": "The Oregon and California Railroad arrived in Rickreall in 1880, providing important regional connectivity for the agricultural hub.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/rickreall_oregon"
    },
    {
      "id": 6,
      "text": "The Polk County Museum in Rickreall serves as a repository for the region's history from 1842 to 1960.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Web source 2"
      ],
