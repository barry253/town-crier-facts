  "facts": [
    {
      "id": 1,
      "text": "Marlinton is named for Jacob Marlin, one of the first non-native settlers to arrive in the Greenbrier Valley in 1749.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Marlinton%2C_West_Virginia"
    },
    {
      "id": 2,
      "text": "Marlinton sits at the center of Pocahontas County along the seventy-eight mile Greenbrier River Trail.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://monforesttowns.org/town/marlinton/"
    },
    {
      "id": 3,
      "text": "Marlinton is the county seat of Pocahontas County and is known for its scenic location along the Greenbrier River.",
      "sourceSentenceIds": [
        16,
        17
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Marlinton%2C_West_Virginia"
    },
    {
      "id": 4,
      "text": "The town is located in the southwest part of the United States National Radio Quiet Zone.",
      "sourceSentenceIds": [
        21
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Marlinton%2C_West_Virginia"
    },
    {
      "id": 5,
      "text": "Marlinton hosts a cook-off that began in 1991 and has gained national recognition through food and travel television shows.",
      "sourceSentenceIds": [
        15
      ],
      "sourceLabels": [
