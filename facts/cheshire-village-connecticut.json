  "facts": [
    {
      "id": 1,
      "text": "Cheshire, known as the Bedding Plant Capital, hosts over 5 million square feet of greenhouses that supply flowers across the Northeast.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
