    },
    {
      "id": 2,
      "text": "Originally called North Farms, Cheshire grew into a thriving agricultural community in the 18th century.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.connecticutvisitorguide.com/counties/new-haven/cheshire/"
    },
    {
      "id": 3,
      "text": "The town has dedicated several hundred acres to corporate and industrial parks, attracting aerospace manufacturers and research facilities.",
      "sourceSentenceIds": [
        14
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://cheshirect.gov/495/About-the-Town"
    },
    {
      "id": 4,
      "text": "The First Congregational Church stands as an iconic landmark at the center of town, near Routes 10, 70, and 68.",
      "sourceSentenceIds": [
