      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Alexandria%2C_Pennsylvania",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Hartslog Street and the surrounding Hartslog Valley keep the original log’s memory alive.",
      "sourceSentenceIds": [
        4
