  "facts": [
    {
      "id": 1,
      "text": "Djurgården is officially called Kungliga Djurgården, meaning 'The Animal Park,' and is an island in central Stockholm.",
      "sourceSentenceIds": [
        17
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Djurg%C3%A5rden"
    },
    {
      "id": 2,
      "text": "The island became a National City Park in 1995, preserving its historic buildings and extensive green spaces.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Djurg%C3%A5rden"
    },
    {
      "id": 3,
      "text": "Skansen, the open‑air museum, opened in 1891 on Djurgården and was the first open‑air museum in the world.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Djurg%C3%A5rden"
    },
    {
      "id": 4,
      "text": "The amusement park Gröna Lund, founded in 1883, still hosts concerts by international stars like Bob Marley.",
      "sourceSentenceIds": [
        15
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Djurg%C3%A5rden"
    },
    {
      "id": 5,
      "text": "Prince Eugen praised Djurgården’s oak trees, noting how their majesty depends on people playing beneath them.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.kungligaslotten.se/english/royal-palaces-and-sites/royal-djurgarden/history.html"
    },
    {
      "id": 6,
      "text": "The island’s name evolved from Valmundsö to Djurgården, with early references linking it to King Valdemar and the word 'walder' meaning embankment.",
      "sourceSentenceIds": [
        22,
        23
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
