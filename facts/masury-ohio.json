      "id": 1,
      "text": "Frederick L. Masury and his wife Olive founded Masury in 1903, building a stately house just north of their explosives factory.",
      "sourceSentenceIds": [
        30,
        4,
        5
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://businessjournaldaily.com/boom-town-how-an-explosives-factory-made-masury/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The Masurite Explosive Company turned Masury into a boom town, supplying 16 company homes for its growing workforce.",
      "sourceSentenceIds": [
        30,
        13
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://businessjournaldaily.com/boom-town-how-an-explosives-factory-made-masury/",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "In 1908, the company won a case against the Pittsburgh & Lake Erie Railroad, reducing shipping costs for the town.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://businessjournaldaily.com/boom-town-how-an-explosives-factory-made-masury/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Masury is part of the Youngstown–Warren metropolitan area, linking it to a larger industrial region.",
      "sourceSentenceIds": [
        16
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Masury%2C_Ohio",
