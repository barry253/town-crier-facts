      "id": 1,
      "text": "Helena hosts a 135‑acre industrial park zoned for heavy industry, served by the Mississippi Export Railroad that links to national lines like CN and CSXT.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
