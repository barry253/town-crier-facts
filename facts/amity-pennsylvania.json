  "facts": [
    {
      "id": 1,
      "text": "Amity Township in Berks County grew from a Swedish settlement founded in 1701, when William Penn granted 10,000 acres to the Swedes’ congregation.",
      "sourceSentenceIds": [
        26
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://discoverdouglassville.com/douglassville-pennsylvania-local-history/"
    },
    {
      "id": 2,
      "text": "The George Douglass Mansion, a historic home in Amity Township, still stands as a reminder of the town’s early 19th‑century prosperity.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://discoverdouglassville.com/douglassville-pennsylvania-local-history/"
    },
    {
      "id": 3,
      "text": "Old Swedes’ Church, established in 1720, is the oldest church in Berks County and sits on the banks of the Schuylkill River.",
      "sourceSentenceIds": [
        5,
        10
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://discoverdouglassville.com/douglassville-pennsylvania-local-history/"
    },
    {
      "id": 4,
      "text": "Brinton Lodge, a 300‑year‑old landmark in Douglassville, showcases the region’s unique architecture and eccentric local legends.",
      "sourceSentenceIds": [
        15,
        16
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://discoverdouglassville.com/douglassville-pennsylvania-local-history/"
    },
    {
      "id": 5,
      "text": "Amity Township shares its name with another unincorporated community in Washington County, but the Berks County Amity is the one with the historic Swedish roots.",
      "sourceSentenceIds": [
        24,
        8
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 2"
      ],
      "source": "https://en.wikipedia.org/wiki/Amity%2C_Pennsylvania"
    },
    {
      "id": 6,
      "text": "The White Horse Inn, a historic tavern in Douglassville, once served travelers along the early Schuylkill River trade routes.",
