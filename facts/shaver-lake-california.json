  "facts": [
    {
      "id": 1,
      "text": "Shaver Lake takes its name from pioneer logger Charles B. Shaver, who first logged the surrounding hills.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://oceaninfo.com/lakes/shaver-lake/",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "A 45‑mile flume once carried sawn lumber from Shaver’s sawmill to Clovis, showcasing early industrial ingenuity.",
      "sourceSentenceIds": [
        9,
        13
      ],
      "sourceLabels": [
        "Web source 2",
        "Wikipedia"
      ],
      "source": "https://www.monohotsprings.com/historic-shaver-lake-california/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The area’s first Shaver Lake was a modest pond built by a sawmill dam in the 1890s.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.monohotsprings.com/historic-shaver-lake-california/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Edison Company enlarged the lake in 1919, transforming the modest pond into the reservoir that surrounds the town today.",
      "sourceSentenceIds": [
        15
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Shaver_Lake%2C_California",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The Central Sierra Historical Society Museum at Camp Edison Campground lets visitors explore the region’s logging and hydroelectric legacy.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.monohotsprings.com/historic-shaver-lake-california/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Perched at 5,627 feet, Shaver Lake enjoys a warm‑summer Mediterranean climate with snowy winters and alpine vistas.",
