  "facts": [
    {
      "id": 1,
      "text": "Connerton began as an 8,000‑acre cattle ranch owned by the Conner family.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Connerton%2C_Florida",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "In the early 2000s the Conner family sold the ranch, and a developer bought the land to build a new community.",
      "sourceSentenceIds": [
        17,
        18
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://kids.kiddle.co/Connerton,_Florida",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The family sold the land in early 2000 to a developer who originally planned more than 15,000 homes and up to three golf courses in Connerton.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Connerton%2C_Florida",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The original development plan in Connerton was later modified to protect much of the natural lands.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Connerton%2C_Florida",
      "category": "other",
      "quality": "poor",
      "qualityReason": "editorial_filler"
    },
    {
      "id": 5,
      "text": "The first homes in Connerton were sold in 2005, marking the start of residential construction.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Connerton%2C_Florida",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "After a housing‑market slowdown, construction picked up again in Connerton in 2012, and Lennar Homes bought the remaining land for $26 million in 2019.",
