  "facts": [
    {
      "id": 1,
      "text": "North Georgetown’s Old Stagecoach Inn, built in 1822 by Samuel Long Sturgeon, was a key stop for travelers heading from Pittsburgh to Massillon.",
      "sourceSentenceIds": [
        1,
        6
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/north_georgetown_ohio",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The inn also served as a station on the Underground Railroad, complete with an underground tunnel that helped enslaved people escape to Canada.",
      "sourceSentenceIds": [
        1,
        6
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/north_georgetown_ohio",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The village was officially platted in 1830, with George Stiger laying out the northern part and John Whiteleather the southern part of the town.",
      "sourceSentenceIds": [
        12,
        18,
        25
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/North_Georgetown%2C_Ohio",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "A post office has operated in North Georgetown since 1833, marking the community’s early establishment as a local hub.",
      "sourceSentenceIds": [
        14
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/North_Georgetown%2C_Ohio",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "North Georgetown sits at the crossroads of Georgetown Road (County Highway 400) and Rochester Road (County Highway 402), a layout that dates back to its original platting.",
      "sourceSentenceIds": [
        10,
        11,
        25
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/North_Georgetown%2C_Ohio",
      "category": "other",
      "quality": "poor",
      "qualityReason": "route_only"
    },
    {
      "id": 6,
      "text": "The town’s name honors George Stidger, an original owner of the town site, whose legacy lives on in the community’s identity.",
      "sourceSentenceIds": [
        13
      ],
