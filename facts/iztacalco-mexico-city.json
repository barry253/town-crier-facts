  "facts": [
    {
      "id": 1,
      "text": "Iztacalco’s name means “house of salt” in Nahuatl, though some scholars suggest “place of white houses.”.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Iztacalco",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The borough began as an island in Lake Texcoco, settled by Mexica in 1309 before Tenochtitlan rose.",
      "sourceSentenceIds": [
        16
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Iztacalco",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Drainage projects dried the lake, turning Iztacalco’s canals and chinampas into the densely populated urban core we see today.",
      "sourceSentenceIds": [
        19,
        20,
        22
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Iztacalco",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The historic center of Santa Cruz houses the 16th‑century Parish and Ex‑Convent of San Matías Apóstol, a Baroque architectural jewel.",
      "sourceSentenceIds": [
        13
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://mexicocity.cdmx.gob.mx/locations/iztacalco/?lang=en",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Iztacalco’s rapid urbanization in the mid‑20th century saw factories and housing replace rural chinampas in less than forty years.",
