  "facts": [
    {
      "id": 1,
      "text": "Palisade earned the nickname \"The Peach Capital of Colorado\" thanks to its 182‑day growing season and 78 percent sunshine, making it a top peach‑producing town.",
      "sourceSentenceIds": [
        22,
        23
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Palisade%2C_Colorado",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Founded in the 1890s and incorporated in 1904, Palisade grew around irrigation projects that turned the Grand Valley into a fertile farming hub.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.historicpalisade.org/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "In 2014 volunteers saved 111 years of the Palisade Tribune from destruction, preserving a vital record of the town’s history in a digitized archive.",
      "sourceSentenceIds": [
        6,
        17
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.historicpalisade.org/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The Palisade Historical Society now houses the town’s first history museum in a renovated pre‑1939 log building, showcasing photos, documents, and memorabilia.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.historicpalisade.org/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Palisade sits 11 miles east of Grand Junction on the north side of the Colorado River, offering easy access to the river’s scenic vistas and the nearby Grand Mesa.",
