  "facts": [
    {
      "id": 1,
      "text": "Griswold was named after Roger Griswold, the Federalist Governor of Connecticut, when the town was finally divided in 1815.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.griswold-ct.org/about_our_town/index.php",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Most of Griswold’s development sits on flat land along the Pachaug River, especially around the confluence with the Quinebaug in Jewett City.",
      "sourceSentenceIds": [
        18
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.griswold-ct.org/about_our_town/index.php",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The 1965 Supreme Court case Griswold v. Connecticut, decided in Griswold, struck down a state law banning contraceptives.",
      "sourceSentenceIds": [
        19
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Griswold_v._Connecticut",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "That law prohibited using any drug or instrument to prevent conception, a restriction the Court found unconstitutional for violating marital privacy.",
      "sourceSentenceIds": [
        20
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Griswold_v._Connecticut",
      "category": "other",
      "quality": "poor",
      "qualityReason": "editorial_filler"
    },
    {
      "id": 5,
      "text": "Griswold offers a scenic New England experience, drawing nature lovers to its rolling hills and historic downtown.",
