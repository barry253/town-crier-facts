  "facts": [
    {
      "id": 1,
      "text": "Bisbee was founded in 1880 as a copper, gold, and silver mining town, named after Judge DeWitt Bisbee, a backer of the Copper Queen Mine.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Bisbee%2C_Arizona",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The Phelps Dodge General Office Building, now the Bisbee Mining & Historical Museum, stands as a National Historic Landmark in the city.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Bisbee%2C_Arizona",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Old Bisbee today hosts a thriving downtown cultural scene, drawing artists and visitors to its preserved historic architecture.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Bisbee%2C_Arizona",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "In 1919, Bisbee was the site of the Bisbee Riot, a violent clash that marked a pivotal moment in the town’s labor history.",
      "sourceSentenceIds": [
        28
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Bisbee%2C_Arizona",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The county seat moved from Tombstone to Bisbee in 1929, cementing the city’s role as Cochise County’s administrative center.",
      "sourceSentenceIds": [
        29
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Bisbee%2C_Arizona",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Legendary actor John Wayne was a frequent visitor to Bisbee and the nearby Copper Queen Mine, adding Hollywood lore to the town’s mining heritage.",
      "sourceSentenceIds": [
        5
      ],
