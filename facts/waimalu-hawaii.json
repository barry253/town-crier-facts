  "facts": [
    {
      "id": 1,
      "text": "Waimalu means \"sheltered water,\" a nod to its many streams and protected waters.",
      "sourceSentenceIds": [
        30
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/waimalu_hawaii",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Historically, Waimalu was an ahupuaʻa that stretched from sea to mountain, sustaining agriculture, fishing, and culture.",
      "sourceSentenceIds": [
        1,
        2
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/waimalu_hawaii",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Waimalu and Punanani Streams once irrigated taro terraces and dryland fields, shaping local farming.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/waimalu_hawaii",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "After the 1930s, loʻi, ponds, and heiau were filled in for homes, parks, and Pearl Ridge Community Park.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/waimalu_hawaii",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Waimalu borders Pearl Harbor National Memorial, the site that remembers the 1941 attack on the U.S. Navy.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/waimalu_hawaii",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Waimalu serves as a quiet base for exploring Oʻahu’s military history and scenic coastal drives.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.trawellino.com/destinations/united-states/hawaii_waimalu",
