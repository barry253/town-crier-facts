  "facts": [
    {
      "id": 1,
      "text": "Woodland emerged as a distinct hamlet in the mid‑19th century, evolving from the earlier Williams’s Grove named after Edward Williams.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/woodland_pennsylvania"
    },
    {
      "id": 2,
      "text": "Woodland became known for the county’s first major brickworks, founded by Woodland Fire Brick Company in 1870 and Hope Fire Brick Company in 1872.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/woodland_pennsylvania"
    },
    {
      "id": 3,
      "text": "Route 322 connected Woodland to Clearfield by the 1840s, improving access for settlers and goods.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/woodland_pennsylvania"
    },
    {
      "id": 4,
      "text": "Woodland sits at about 1,660 feet elevation within Moshannon State Forest, offering varied Appalachian weather.",
      "sourceSentenceIds": [
        19,
        21
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/woodland_pennsylvania"
    },
    {
      "id": 5,
      "text": "The area experiences a humid continental climate with cold snowy winters and warm humid summers, averaging 48°F annually.",
      "sourceSentenceIds": [
        22,
        24
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/woodland_pennsylvania"
    },
    {
      "id": 6,
      "text": "Early settlers cleared land for farming and logging, with only 175 residents recorded in Bradford Township by 1809.",
