  "facts": [
    {
      "id": 1,
      "text": "Rhodes takes its name from Murry Bently Rhodes, an early postmaster and lumber businessman.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Bentley_Township%2C_Michigan",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Settled in 1890, Rhodes once boasted a bustling downtown packed with a barrell hoop factory, blacksmith, church, hotel, post office, saloon, sawmill and shops.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://99wfmk.com/estey-rhodes-2018/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The town grew around a lumber mill established in 1891.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Bentley_Township%2C_Michigan",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Rhodes lost its village status when it was disincorporated in 1920.",
      "sourceSentenceIds": [
        13
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Bentley_Township%2C_Michigan",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Historic Rhodes once housed a bank, blacksmith shop, elevator, general store, hardware store, hotel, livery stable, Methodist church, post office, railroad depot, restaurant, saloon and more.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 2"
