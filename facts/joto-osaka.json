  "facts": [
    {
      "id": 1,
      "text": "Jōtō‑ku means “east of the castle,” a name that dates back to when Osaka Castle was the city’s focal point.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/J%C5%8Dt%C5%8D-ku%2C_Osaka"
    },
    {
      "id": 2,
      "text": "The ward split from Higashinari and Asahi in 1943, and its eastern part became Tsurumi in 1974, marking a key administrative shift.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/J%C5%8Dt%C5%8D-ku%2C_Osaka"
    },
    {
      "id": 3,
      "text": "Jōtō‑ku hosts Osaka Shin‑ai College’s Joto Campus, a private university that attracts students from across the Kansai region.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/J%C5%8Dt%C5%8D-ku%2C_Osaka"
    },
    {
      "id": 4,
      "text": "The JR West Osaka Higashi Line runs through Jōtō‑ku, connecting Noe Station to Shigino Station and linking the ward to the city’s core.",
      "sourceSentenceIds": [
        2,
        4
      ],
      "sourceLabels": [
        "Web source 2",
        "Wikipedia"
      ],
      "source": "https://en.namu.wiki/w/%EC%A1%B0%ED%86%A0%EA%B5%AC"
    },
    {
      "id": 5,
      "text": "Keihan Electric Railway’s Main Line also serves Jōtō‑ku, with Noe Station offering transfers to the Osaka Loop Line at Kyōbashi Station.",
      "sourceSentenceIds": [
        2,
        4
      ],
      "sourceLabels": [
        "Web source 2",
        "Wikipedia"
      ],
      "source": "https://en.namu.wiki/w/%EC%A1%B0%ED%86%A0%EA%B5%AC"
    }
  ]
