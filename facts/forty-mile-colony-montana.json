  "facts": [
    {
      "id": 1,
      "text": "Forty Mile Colony takes its name from a historic stagecoach stop about halfway between Hardin, Montana, and Sheridan, Wyoming.",
      "sourceSentenceIds": [
        4,
        8
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/forty_mile_colony_montana",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Founded in 1980 as a split from Spring Creek Hutterite Colony near Lewistown, Forty Mile Colony began its own community.",
      "sourceSentenceIds": [
        3,
        6
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/forty_mile_colony_montana",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Forty Mile Colony sits in the Little Bighorn River valley, just three miles south of the town of Lodge Grass.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Forty_Mile_Colony%2C_Montana",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The colony experiences a modified continental climate, with cold winters dropping below -30°F, hot summers over 100°F, and 10‑14 inches of annual rain.",
      "sourceSentenceIds": [
        25,
        26,
        27
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/forty_mile_colony_montana",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Every year, Forty Mile Colony hosts a labor‑intensive branding roundup after calving, where men and women ride, rope, and brand calves.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/forty_mile_colony_montana",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Belonging to the Dariusleut Hutterites, Forty Mile Colony upholds Anabaptist traditions of communal goods, nonresistance, and separation from worldly influences.",
      "sourceSentenceIds": [
        1,
        6
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/forty_mile_colony_montana",
