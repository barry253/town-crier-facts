      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The first log house in the area was built by Colonel James Burd in the 1760s while he was stationed at Fort Pitt.",
      "sourceSentenceIds": [
        24
      ],
      "sourceLabels": [
        "Web source 1"
      ],
