      "category": "nature",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Shady Avenue, originally Shady Lane, has long served as the main gateway between East Liberty, Shadyside, and Squirrel Hill.",
      "sourceSentenceIds": [
        13
      ],
      "sourceLabels": [
