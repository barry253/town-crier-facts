  "facts": [
    {
      "id": 1,
      "text": "Liebenthal was founded on February 22, 1876 by fourteen Volga German families who left Saratov, Russia.",
      "sourceSentenceIds": [
        3,
        8
      ],
      "sourceLabels": [
        "Web source 1",
        "Web source 2"
      ],
      "source": "https://rushcounty.org/history_liebenthal.html",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town’s name means “love valley,” echoing the settlers’ original Russian hometown of Liebenthal.",
      "sourceSentenceIds": [
        4,
        9
      ],
      "sourceLabels": [
        "Web source 1",
        "Web source 2"
      ],
      "source": "https://rushcounty.org/history_liebenthal.html",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Shortly after arriving, settlers built simple sod houses along Big Timber Creek, the town’s first structures.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://legendsofkansas.com/liebenthal-kansas/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "A nearby community, Schoenchen, sprang up a few miles north on the Smoky Hill River, sharing the same Ukrainian roots.",
      "sourceSentenceIds": [
        5,
        10
      ],
      "sourceLabels": [
        "Web source 1",
        "Web source 2"
      ],
      "source": "https://rushcounty.org/history_liebenthal.html",
      "category": "other",
      "quality": "poor",
      "qualityReason": "other"
    },
    {
      "id": 5,
      "text": "In 1875, the Russian czar revoked the Volga Germans’ special privileges, prompting their migration to Kansas.",
      "sourceSentenceIds": [
        29
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://rushcounty.org/history_liebenthal.html",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The first steamship voyage began on November 2, 1875, when the group boarded the Ohio in Bremen, heading to Baltimore.",
