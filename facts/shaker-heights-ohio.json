      "quality": "good"
    },
    {
      "id": 2,
      "text": "The Van Sweringen brothers built Shaker Heights as a planned railroad suburb, offering a suburban retreat from Cleveland’s industrial core.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
