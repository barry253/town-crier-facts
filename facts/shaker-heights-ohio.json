      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Horseshoe Lake and Lower Shaker Lake were dammed by the Shakers, while Green Lake and Marshall Lake were added later by developers.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
