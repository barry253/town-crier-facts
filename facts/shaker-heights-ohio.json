      "category": "nature",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The Shaker Historical Society Museum sits on the former North Union Shaker dwelling site, showcasing furniture and artifacts from the 19th‑century sect.",
      "sourceSentenceIds": [
