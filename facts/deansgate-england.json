  "facts": [
    {
      "id": 1,
      "text": "Deansgate’s name comes from the lost River Dene, which may have flowed along the Hanging Ditch near the street’s northern end.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Deansgate",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "At over one mile long, Deansgate is the longest street in Manchester’s city centre.",
      "sourceSentenceIds": [
        28
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Deansgate",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Roman roads near Deansgate led from the River Medlock to Deva, passing close to the fort of Mamucium.",
      "sourceSentenceIds": [
        30
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Deansgate",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Deansgate Station opened on 20 July 1849 at Knott Mill, operated by the Manchester, South Junction and Altrincham Railway.",
      "sourceSentenceIds": [
        25
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Deansgate",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Today, Deansgate links to the Deansgate‑Castlefield Metrolink station, connecting the city’s tram network.",
      "sourceSentenceIds": [
        26
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Deansgate",
      "category": "transport",
      "quality": "good"
    },
    {
