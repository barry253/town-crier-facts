  "facts": [
    {
      "id": 1,
      "text": "Lake Havasu City is home to the historic London Bridge, which now spans the eastern shore of Lake Havasu along the Colorado River.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.golakehavasu.com/media-room/fact-sheet/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Each year, about 835,000 visitors come to Lake Havasu City for its London Bridge, clear lake, sunshine, and a calendar full of events and dining options.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.golakehavasu.com/media-room/fact-sheet/",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The community began in World War II as Site Six, an Army Air Corps rest camp on the shores of Lake Havasu.",
      "sourceSentenceIds": [
        21
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Lake_Havasu_City%2C_Arizona",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The 1985 television film Bridge Across Time was filmed in Lake Havasu City, using the relocated London Bridge as a key set piece.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Lake_Havasu_City%2C_Arizona",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Lake Havasu City’s calendar includes the Havasu Balloon Festival in January, the Bluegrass on the Beach Music Festival in March, and the Boat Parade of Lights in December.",
      "sourceSentenceIds": [
        19
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.golakehavasu.com/media-room/fact-sheet/",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The city’s name comes from the lake itself, which was named after the town of Havasupai, meaning “red rock people” in the local Native American language.",
      "sourceSentenceIds": [
        20
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Lake_Havasu_City%2C_Arizona",
      "category": "etymology",
      "quality": "good"
    }
