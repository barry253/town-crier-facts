  "facts": [
    {
      "id": 1,
      "text": "Montevideo earned its name from the bluff views overlooking the Minnesota and Chippewa rivers, a Latin phrase roughly meaning 'mountain view'.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 2"
