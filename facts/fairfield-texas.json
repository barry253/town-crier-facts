  "facts": [
    {
      "id": 1,
      "text": "Fairfield was founded in 1851 when David H. established a trading post that grew into the town’s first commercial hub.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.fairfieldtexaschamber.com/fairfieldhistory",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town’s name honors Fairfield, Alabama, reflecting the origins of many early settlers who renamed the county seat in 1850.",
      "sourceSentenceIds": [
        4,
        10
      ],
      "sourceLabels": [
        "Web source 1",
        "Web source 2"
      ],
      "source": "https://www.fairfieldtexaschamber.com/fairfieldhistory",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Fairfield has remained the county seat of Freestone County since its designation in 1850, even when nearby towns tried to relocate it in 1891 and 1910.",
      "sourceSentenceIds": [
        17
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.fairfieldtexaschamber.com/fairfieldhistory",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Unlike many Texas towns, Fairfield never acquired a railroad, a fact that limited its economic boom but preserved its historic downtown.",
      "sourceSentenceIds": [
        18,
        19
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.tshaonline.org/handbook/entries/fairfield-tx",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The city installed its first water and sewer lines in 1933, a milestone that modernized public utilities for the first time.",
      "sourceSentenceIds": [
        28
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.tshaonline.org/handbook/entries/fairfield-tx",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "A public library opened in Fairfield in 1954, becoming the town’s first dedicated space for books and community learning.",
      "sourceSentenceIds": [
        28
