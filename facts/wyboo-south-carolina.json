    },
    {
      "id": 2,
      "text": "Patriot forces led by Brigadier General Francis Marion ambushed British troops in Wyboo Swamp during the American Revolutionary War in 1781.",
      "sourceSentenceIds": [
        3,
        29
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/wyboo_south_carolina"
    },
    {
      "id": 3,
      "text": "The construction of the Santee Dam in 1941 flooded the historic Wyboo Swamp to create the expansive Lake Marion reservoir.",
      "sourceSentenceIds": [
        6,
        24
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/wyboo_south_carolina"
    },
    {
      "id": 4,
      "text": "Early European settlement in Wyboo began in the mid-eighteenth century with Scots-Irish Protestants and French Huguenots migrating up the Santee River.",
