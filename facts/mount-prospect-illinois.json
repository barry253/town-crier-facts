  "facts": [
    {
      "id": 1,
      "text": "Mount Prospect’s slogan, \"Where Friendliness is a Way of Life,\" has echoed through the village since its founding and still rings true today.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.mountprospect.org/community/about-mount-prospect/history-centennial-anniversary-2017"
    },
    {
      "id": 2,
      "text": "The Kensington Business Center, opened in the 1970s, has hosted national firms such as Cummins‑Allison and CVS Caremark.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.mountprospect.org/community/about-mount-prospect/history-centennial-anniversary-2017"
    },
    {
      "id": 3,
      "text": "A train station built in the late 19th century sparked downtown growth, turning Mount Prospect into a commuter hub for Chicago.",
      "sourceSentenceIds": [
        12,
        13
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.mountprospect.org/community/about-mount-prospect/history-centennial-anniversary-2017"
    },
    {
      "id": 4,
      "text": "Mount Prospect Public Library, founded in 1904, now serves as a community hub and houses the local historical society.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Mount_Prospect%2C_Illinois"
    },
    {
      "id": 5,
      "text": "The village sits at 42°3′56″N 87°56′10″W, placing it just north of Chicago’s urban core.",
      "sourceSentenceIds": [
        16
      ],
      "sourceLabels": [
        "Wikipedia"
