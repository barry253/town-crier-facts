      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Before becoming Burkburnett, the area was known as Nesterville, a cowboy community founded by Samuel Burk Burnett’s Four Sixes Ranch.",
      "sourceSentenceIds": [
        10,
        27
      ],
      "sourceLabels": [
