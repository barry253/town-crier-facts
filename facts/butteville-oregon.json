  "facts": [
    {
      "id": 1,
      "text": "Butteville takes its name from La Butte, a small basalt outcropping that rises over three hundred feet above the town.",
      "sourceSentenceIds": [
        1,
        24
      ],
      "sourceLabels": [
        "Web source 1",
        "Wikipedia"
      ],
      "source": "https://butteville.org/history.html"
    },
    {
      "id": 2,
      "text": "Members of the Methodist Mission founded Butteville in the 1840s, with early residents consisting mostly of French-Canadians.",
      "sourceSentenceIds": [
        3,
        21
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Butteville%2C_Oregon"
    },
    {
      "id": 3,
      "text": "Butteville once served as a shipping hub for wheat and hops, competing with neighboring Champoeg for steamboat business in the 1850s.",
      "sourceSentenceIds": [
        19,
        20
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Butteville%2C_Oregon"
    },
    {
      "id": 4,
      "text": "The Historic Butteville Store is the longest continuously operating retail establishment in the state of Oregon.",
      "sourceSentenceIds": [
        11
