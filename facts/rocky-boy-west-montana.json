      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://discoveringmontana.com/towns/rocky-boy-west/"
    },
    {
      "id": 3,
      "text": "Square Butte Trading Post, founded in 2007 by two Chippewa‑Cree sisters, offers unique gifts and a window into local history.",
      "sourceSentenceIds": [
