  "facts": [
    {
      "id": 1,
      "text": "Kearney Park’s name comes from early plantation owners surnamed Kearney, reflecting the Irish immigrant influence that shaped Mississippi’s settlement patterns.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/kearney_park_mississippi",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The community sits just 1.5 miles southeast of the Big Black River, whose floodplains can reach up to 3 miles wide.",
      "sourceSentenceIds": [
        2,
        7
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/kearney_park_mississippi",
      "category": "nature",
      "quality": "poor",
      "qualityReason": "vague"
    },
    {
      "id": 3,
      "text": "During World War II, the U.S. government bought 6,000 acres in Kearney Park for an ordnance plant, later selling them to private owners.",
      "sourceSentenceIds": [
        11,
        13
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/kearney_park_mississippi",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Amtrak’s City of New Orleans trains run through Kearney Park on CN tracks but never stop.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Kearney_Park%2C_Mississippi",
      "category": "transport",
      "quality": "poor",
      "qualityReason": "route_only"
    },
    {
      "id": 5,
      "text": "After the war, firms like Fleetmaster Corporation and M‑R‑S Manufacturing set up operations, turning the area into a mix of industry, residence, and agriculture.",
      "sourceSentenceIds": [
        14,
        15
      ],
      "sourceLabels": [
