  "facts": [
    {
      "id": 1,
      "text": "Paoli earned its name in 1816, honoring Pasquale Paoli Ash, son of North Carolina governor Samuel Ashe.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://getindiana.com/news/paoli",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Paoli Historic District joined the National Register of Historic Places in 1975, preserving its 19th‑century charm.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.historicorangecounty.org/index.php/historic-district/paoli-historic-district",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The Lindley Family Home, once a key Underground Railroad stop, now serves as a museum near Lick Creek.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://getindiana.com/news/paoli",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Orange County Courthouse, still in use, is Indiana’s third‑oldest operational courthouse and celebrated its 175th anniversary this September.",
      "sourceSentenceIds": [
        17
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://getindiana.com/news/paoli",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Paoli Public Library began as a 1913 rental space, grew into a Carnegie‑funded building in 1918, and moved after 90 years.",
      "sourceSentenceIds": [
        27,
        28,
        29
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.historicorangecounty.org/index.php/historic-district/paoli-historic-district",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The town’s Greek Revival courthouse, built by local craftsmen, is one of only two in Indiana still in continuous use.",
      "sourceSentenceIds": [
        9
