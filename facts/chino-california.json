  "facts": [
    {
      "id": 1,
      "text": "Chino’s name comes from Spanish “Chino” meaning “curly,” referencing the curly grass at the top of grama in the valley.",
      "sourceSentenceIds": [
        5,
        6,
        11,
        12
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Chino%2C_California",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town began as Rancho Santa Ana del Chino, a Mexican land grant given to Antonio Maria Lugo in 1834, later subdivided into the Town of Chino in 1910.",
      "sourceSentenceIds": [
        2,
        16,
        26,
        27
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Chino%2C_California",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "During the Mexican–American War, the Battle of Chino took place at the rancho, ending before the Mormon Battalion arrived.",
      "sourceSentenceIds": [
        20,
        21
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Chino%2C_California",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Chino’s fertile alluvial plain made it an agricultural mecca from the 1890s through the mid‑20th century, producing sugar beets, corn, peaches, and strawberries.",
      "sourceSentenceIds": [
        29,
        30
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Chino%2C_California",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The Chino Valley’s topsoil reaches depths of four feet, contributing to its long‑standing dairy and fruit orchards.",
      "sourceSentenceIds": [
        29
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Chino%2C_California",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Chino’s early 20th‑century economy featured “Chino corn,” a sweet corn variety marketed across the Pacific coast.",
      "sourceSentenceIds": [
        30
      ],
