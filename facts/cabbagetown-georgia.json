  "facts": [
    {
      "id": 1,
      "text": "Cabbagetown was built around the Fulton Bag and Cotton Mill, a textile plant that began operations in 1881 after the old Atlanta Rolling Mill was destroyed.",
      "sourceSentenceIds": [
        28,
        29
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Cabbagetown%2C_Atlanta",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The mill and its worker houses were added to the National Register of Historic Places in 1976, preserving the neighborhood’s early industrial architecture.",
      "sourceSentenceIds": [
        1,
        17
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Cabbagetown%2C_Atlanta",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "After the mill closed, Cabbagetown fell into decline until the 1980s, when artists like Panorama Ray opened galleries and sparked revitalization.",
      "sourceSentenceIds": [
        8,
        9
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Cabbagetown%2C_Atlanta",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "A tornado in March 2008 damaged many historic homes, but neighbors quickly organized to rebuild the loft complex and restore the community.",
      "sourceSentenceIds": [
        13,
        18,
        19
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Cabbagetown%2C_Atlanta",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The Patch Works Art & History Center, founded by the community, hosts exhibits and public programs that celebrate Cabbagetown’s mill‑town heritage.",
      "sourceSentenceIds": [
        4,
        20
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://thepatchworks.org/",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Cabbagetown borders historic Oakland Cemetery, one of Atlanta’s oldest burial grounds, adding a quiet, historic backdrop to the neighborhood.",
