        13
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Belvedere_Park%2C_Georgia",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "In 1959 Rich's Department Store opened its second Atlanta branch inside the Belvedere Shopping Center, adding a metropolitan touch to the suburb.",
      "sourceSentenceIds": [
        20
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Belvedere_Park%2C_Georgia",
      "category": "history",
      "quality": "good"
    },
    {
