  "facts": [
    {
      "id": 1,
      "text": "Mountain Village began as a seasonal Yup'ik fish camp, grew into a trading and mission hub in the early 1900s, and opened its post office in 1923.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/mountain_village_alaska",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Mountain Village experiences a continental climate with temperatures swinging from -44°F in winter to 80°F in summer, and 44 inches of snow each year.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/mountain_village_alaska",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Permafrost patches across Mountain Village create elevated plateaus on abandoned floodplains, limiting vegetation to low shrubs, grasses, and mosses adapted to wet soils.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/mountain_village_alaska",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The 4.3‑square‑mile community sits at the base of 500‑foot Azachorok Mountain and lies within the Yukon Delta National Wildlife Refuge, preserving Yup'ik traditions.",
      "sourceSentenceIds": [
        28
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/mountain_village_alaska",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Mountain Village faces flooding, erosion, wildfires, earthquakes, severe weather, and distant volcanic activity from Ingakslugwat Hills 50 miles south.",
      "sourceSentenceIds": [
        29
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/mountain_village_alaska",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "High wind speeds support a test wind turbine operated by the Alaska Village Electric Cooperative, supplementing diesel power in Mountain Village.",
      "sourceSentenceIds": [
