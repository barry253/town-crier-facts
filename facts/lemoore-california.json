      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The Southern Pacific Railroad reached Lemoore in 1877, sparking its growth as a rail town.",
      "sourceSentenceIds": [
        15
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://sarahamooneymuseum.org/396-2/",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Naval Air Station Lemoore, a master jet base housing F‑18 and F‑35 squadrons, opened in 1961 and drives the local economy.",
      "sourceSentenceIds": [
        21,
        27
      ],
      "sourceLabels": [
        "Wikipedia",
