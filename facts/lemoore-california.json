      ],
      "source": "https://en.wikipedia.org/wiki/Lemoore%2C_California",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Lemoore High School produced Olympic sprinter Tommie Smith, who set a world record in the 200 m at the 1968 Mexico City Games.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
