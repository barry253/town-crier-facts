  "facts": [
    {
      "id": 1,
      "text": "Hiouchi began as a modest donation by Clara Stout in 1929, laying groundwork for the park that now spans 10,000 acres of redwoods.",
      "sourceSentenceIds": [
        22,
        21
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://visitdelnortecounty.com/article/hiouchi-california-travel-guide/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The Old Kelsey Trail, once a mule route in the 1800s, still lets hikers trace the path that linked Crescent City and Fort Jones.",
      "sourceSentenceIds": [
        4,
        5
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://visitdelnortecounty.com/article/hiouchi-california-travel-guide/",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "A short loop less than one mile winds through Stout Grove, offering access to the aquamarine Smith River and a cathedral‑like canopy of ferns.",
      "sourceSentenceIds": [
        24,
        25
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://visitdelnortecounty.com/article/hiouchi-california-travel-guide/",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Float down the Smith River to see some of the world’s tallest redwoods, then hike into Stout Grove for a full wilderness experience.",
      "sourceSentenceIds": [
        28,
        29
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://visitdelnortecounty.com/article/hiouchi-california-travel-guide/",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Stopping by the Historic Hiouchi Cafe is a must during your redwoods adventure, serving local fare amid towering trees.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://visitdelnortecounty.com/article/hiouchi-california-travel-guide/",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Hiouchi sits 7.5 miles east‑northeast of Crescent City on the Smith River at an elevation of 171 feet, nestled in a Mediterranean climate.",
