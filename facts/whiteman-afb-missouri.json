  "facts": [
    {
      "id": 1,
      "text": "Whiteman AFB was renamed in honor of Earlie Whiteman, whose son served as a 2nd Lieutenant in the Army Air Forces.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.visitwarrensburg.com/about/warrensburg-history/whiteman-air-force-base/"
    },
    {
      "id": 2,
      "text": "The 351st Strategic Missile Wing became the first U.S. ICBM wing to complete the Force Modernization Program with LGM‑30F Minuteman II missiles.",
      "sourceSentenceIds": [
        18
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/351st_Missile_Wing_LGM-30_Minuteman_Missile_Launch_Sites"
    },
    {
      "id": 3,
      "text": "Today Whiteman AFB is home to the 509th Bomb Wing and its B‑2 Spirit stealth bomber, the nation’s most advanced bomber.",
      "sourceSentenceIds": [
        25
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/351st_Missile_Wing_LGM-30_Minuteman_Missile_Launch_Sites"
    },
    {
      "id": 4,
      "text": "The 509th Bomb Wing traces its roots to the 509th Composite Group that dropped the Enola Gay atomic bomb on Hiroshima in 1945.",
      "sourceSentenceIds": [
        6,
        7
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.visitwarrensburg.com/about/warrensburg-history/whiteman-air-force-base/"
    },
    {
      "id": 5,
      "text": "In September 1991 President Bush ordered all Minuteman II missiles off alert, ending the 351st’s active ICBM role.",
      "sourceSentenceIds": [
        20,
        21
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/351st_Missile_Wing_LGM-30_Minuteman_Missile_Launch_Sites"
    },
    {
      "id": 6,
      "text": "Oscar One, the only Minuteman launch facility built on the base itself, now serves as a museum open to qualified personnel.",
      "sourceSentenceIds": [
        27
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/351st_Missile_Wing_LGM-30_Minuteman_Missile_Launch_Sites"
    }
  ]
