  "facts": [
    {
      "id": 1,
      "text": "Franklin was chartered December 19, 1794, and renamed for Benjamin Franklin, the famed American inventor and statesman.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Franklin%2C_West_Virginia",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town was founded by Francis Evick in 1794, whose 1769 land patent with his brother George laid the groundwork for Franklin’s early settlement.",
      "sourceSentenceIds": [
        3,
        20
      ],
      "sourceLabels": [
        "Web source 1",
        "Wikipedia"
      ],
      "source": "https://www.townfranklinwv.com/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Franklin sits in the Allegheny Mountains on the eastern edge of Monongahela National Forest, beside the South Branch of the Potomac River, and serves as Pendleton County’s seat.",
      "sourceSentenceIds": [
        17,
        18
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Franklin%2C_West_Virginia",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The Ananias Pitsenbarger Farm was added to the National Register of Historic Places in 2011, preserving a key piece of local agricultural history.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Franklin%2C_West_Virginia",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "McCoy House, an 1848 home opposite the courthouse on Main Street, earned National Register status in 1996 for its well‑preserved architecture.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Franklin%2C_West_Virginia",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Priest Mill, a historic watermill in Franklin, was listed on the National Register of Historic Places in 2000, highlighting the town’s milling heritage.",
