  "facts": [
    {
      "id": 1,
      "text": "Chihuahuita, El Paso’s oldest neighborhood, dates back over 400 years and was declared a historic district in 1991.",
      "sourceSentenceIds": [
        6,
        24
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Chihuahuita%2C_Texas",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The Santa Fe Railroad arrived in 1881, turning Chihuahuita into a bustling rail hub and spawning businesses like the El Paso Laundry Company.",
      "sourceSentenceIds": [
        7,
        19,
        20
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://epcc.libguides.com/c.php?g=754288&p=5406326",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The infamous “Puente Negro” bridge linked Chihuahuita to Ciudad Juárez and became a primary entryway into El Paso.",
      "sourceSentenceIds": [
        21
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://epcc.libguides.com/c.php?g=754288&p=5406326",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "In 2014, an exhibit about Chihuahuita opened at the El Paso Museum of History, highlighting its 400‑year legacy.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Chihuahuita%2C_Texas",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Barrio Chihuahuita earned the nickname “Ellis Island of the West” for serving as a vital passageway for Mexican immigrants since 1848.",
      "sourceSentenceIds": [
        27
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.latinoheritage.us/ell-2025-nominations/barrio-chihuahuita",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Today, Chihuahuita faces threats from gentrification, border militarization, and under‑investment, sparking preservation efforts.",
      "sourceSentenceIds": [
        28
      ],
      "sourceLabels": [
