  "facts": [
    {
      "id": 1,
      "text": "Cle Elum takes its name from the Kittitas word Tle‑el‑Lum, meaning \"swift water,\" a nod to the nearby river.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Cle_Elum%2C_Washington",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Before settlers arrived, the Kittitas band of the Yakama tribe called this valley home and fished the Yakima River.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Cle_Elum%2C_Washington",
      "category": "people",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The town’s early boom came from the Liberty gold mine, one of the few places in Washington that yielded several gold types.",
      "sourceSentenceIds": [
        1,
        17
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.discovercleelum.com/timeline/",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "When the Northern Pacific Railroad finished its track in 1886, Cle Elum became a functioning town with a new depot.",
      "sourceSentenceIds": [
        21,
        25
      ],
      "sourceLabels": [
        "Web source 1",
        "Wikipedia"
      ],
      "source": "https://www.discovercleelum.com/timeline/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Nearly twenty buildings in Cle Elum are on the historic register, and plaques on many of them share the town’s past.",
      "sourceSentenceIds": [
        16
      ],
      "sourceLabels": [
        "Web source 1"
      ],
