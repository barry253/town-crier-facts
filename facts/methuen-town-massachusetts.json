      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Edward Francis Searles, a wealthy patron, donated the building that now houses Methuen City Hall, originally erected as Searles High School in the early 1900s.",
      "sourceSentenceIds": [
        2,
        3
      ],
      "sourceLabels": [
