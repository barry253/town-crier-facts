      "quality": "good"
    },
    {
      "id": 2,
      "text": "The Nevins Memorial Library, begun by philanthropist David Nevins Sr. in 1868 and finished in 1883, earned a National Register of Historic Places spot in 1984.",
      "sourceSentenceIds": [
        4,
        12
      ],
      "sourceLabels": [
