      "id": 1,
      "text": "Lexington Park was founded in 1943 when Patuxent Naval Air Station was built, named after the USS Lexington.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Lexington_Park%2C_Maryland",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town grew from 150 cinder‑block homes built for civilian workers around the base’s main gate in 1943.",
      "sourceSentenceIds": [
        11
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://lexba.org/LexPark",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The Patuxent River Naval Air Museum, located in Lexington Park, preserves naval aviation history with a collection of historic aircraft.",
      "sourceSentenceIds": [
        17,
        20
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://touristplaces.guide/top-10-must-visit-tourist-places-in-lexington-park/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The Calvert Marine Museum, also in Lexington Park, showcases Chesapeake Bay maritime heritage and native American history.",
      "sourceSentenceIds": [
        21,
        22
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://touristplaces.guide/top-10-must-visit-tourist-places-in-lexington-park/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Sotterley Plantation, a historic landmark in Lexington Park, offers a glimpse into Southern Maryland’s agricultural past.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
