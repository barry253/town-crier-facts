  "facts": [
    {
      "id": 1,
      "text": "Sherwood began as Kitchen's Station, a modest stagecoach stop named for operator Meridith Catchings, appearing on post‑Civil War railroad maps.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/sherwood_tennessee",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "On June 19, 1878, Kitchen's Station was renamed Sherwood in honor of Charles D., a former lieutenant governor of Minnesota who owned the land.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/sherwood_tennessee",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The community sits in Crow Creek Valley, a narrow corridor surrounded by the Cumberland Plateau, with Crow Creek flowing through its western side.",
      "sourceSentenceIds": [
        24
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Sherwood%2C_Tennessee",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Sherwood lies along Tennessee State Route 56, which climbs over 1,000 feet to Sewanee and continues south into Alabama as State Route 117.",
