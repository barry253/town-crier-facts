  "facts": [
    {
      "id": 1,
      "text": "Durants Neck earned its name from pioneer settler George Durant, who arrived in the mid‑1700s.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/New_Hope%2C_Perquimans_County%2C_North_Carolina",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "George Durant married Ann Marwood in 1659, and by 1665 they were living on the peninsula now called Durants Neck.",
      "sourceSentenceIds": [
        13,
        14
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.dncr.nc.gov/blog/2016/01/04/durants-durants-neck",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Durant traveled to London to lobby colonists, later becoming a key leader in Culpeper’s Rebellion of 1677.",
      "sourceSentenceIds": [
        15,
        16
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.dncr.nc.gov/blog/2016/01/04/durants-durants-neck",
      "category": "people",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Ann Durant broke barriers in 1673, becoming Carolina’s first woman to act as an attorney.",
      "sourceSentenceIds": [
        17
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.dncr.nc.gov/blog/2016/01/04/durants-durants-neck",
      "category": "people",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The first recorded land grant in North Carolina was given to George Durant in 1660 by Yeopim chief Kiscutanaweh.",
      "sourceSentenceIds": [
        18,
        19
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.carolana.com/Carolina/Settlement/gdurant.html",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Durants Neck sits 8.8 miles east‑southeast of Hertford, within Perquimans County, North Carolina.",
      "sourceSentenceIds": [
        11
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
