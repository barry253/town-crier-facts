      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Basin%2C_Montana",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Corliss steam engines powered mine hoists and a water‑wheel generator supplied electric light for Basin’s street intersections.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
