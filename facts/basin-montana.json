      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Basin%2C_Montana",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Basin Creek flows north‑south through the town before joining the Boulder River on its south side.",
      "sourceSentenceIds": [
