      ],
      "source": "https://en.wikipedia.org/wiki/Basin%2C_Montana",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Today Basin hosts artist residencies in historic buildings, drawing painters, musicians, writers, and poets year‑round.",
      "sourceSentenceIds": [
        14,
