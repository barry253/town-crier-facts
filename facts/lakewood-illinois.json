  "facts": [
    {
      "id": 1,
      "text": "Lakewood was incorporated as a village on July 10, 1933, marking its formal establishment in McHenry County.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Lakewood%2C_Illinois",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Lakewood sits immediately adjacent to Crystal Lake, sharing a shoreline that stretches across both the village and the city of Crystal Lake.",
      "sourceSentenceIds": [
        18
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Lakewood%2C_Illinois",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Six lakes lie within Lakewood’s borders, including the well‑known Crystal Lake that bisects the village and the city.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Lakewood%2C_Illinois",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Two golf courses and several natural areas, such as the Kishwaukee Fen Nature Preserve, offer residents outdoor recreation within the village.",
      "sourceSentenceIds": [
        13
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Lakewood%2C_Illinois",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Private parks along Crystal Lake’s south shore are maintained by the Country Club Additions Property Owners Association, whose gates give each lakeside park a unique name.",
      "sourceSentenceIds": [
        16,
        17
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Lakewood%2C_Illinois",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Lakewood’s open space totals about 650 acres, roughly three‑quarters of an acre per household, preserving a generous amount of green land for residents.",
