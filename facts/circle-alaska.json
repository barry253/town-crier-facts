  "facts": [
    {
      "id": 1,
      "text": "Circle earned its name from miners who mistakenly thought it sat on the Arctic Circle, but it lies about 50 miles south.",
      "sourceSentenceIds": [
        1,
        2
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 2"
      ],
      "source": "https://en.wikipedia.org/wiki/Circle%2C_Alaska",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Circle sprang up in 1893 after gold was found on Birch Creek in 1892, drawing miners like Pitka Pavaloff and Sergei Cherosky.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/Circle,_Alaska",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Its position on the Yukon River turned Circle into a vital steamboat landing that supplied distant mining camps.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/Circle,_Alaska",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Every February, Circle City hosts a checkpoint for the long‑distance Yukon Quest sled dog race.",
      "sourceSentenceIds": [
        11
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Circle%2C_Alaska",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Circle’s mining past lives on in the historic Pioneer Cemetery, whose 19th‑century headstones are preserved by the Civic Community Association.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/Circle,_Alaska",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The hottest temperature recorded in Circle was 94 °F (34.4 °C) on July 25, 1955, and the coldest was –60 °F (–51.1 °C) on December 15, 1946.",
