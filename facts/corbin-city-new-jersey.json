      ],
      "source": "https://grokipedia.com/page/corbin_city_new_jersey",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Corbin City became New Jersey's smallest city when it was incorporated on March 11, 1922, from parts of Weymouth Township.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Web source 1"
      ],
