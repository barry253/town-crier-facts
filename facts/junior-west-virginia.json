    },
    {
      "id": 2,
      "text": "The Row family founded the town of Junior in the mid-nineteenth century after fleeing a flood in the Shenandoah Valley.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://barbourcountywv.gov/junior/"
    },
    {
      "id": 3,
      "text": "Junior was originally known as Rowtown before being renamed at the request of Senator Henry Davis.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://barbourcountywv.gov/junior/"
    },
    {
      "id": 4,
      "text": "The community of Junior was officially established on November 13, 1897.",
