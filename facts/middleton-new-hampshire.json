  "facts": [
    {
      "id": 1,
      "text": "Middleton was named after Sir Charles Middleton, 1st Baron Barham, an admiral who oversaw convoy service between Barbados and the colonies.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Middleton%2C_New_Hampshire",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town incorporated March 4, 1778, originally including Brookfield until it split off in December 1794.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Middleton%2C_New_Hampshire",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Middleton sits on the historic road between Exeter and Wolfeboro, the route to Governor John Wentworth’s summer home, Kingswood.",
      "sourceSentenceIds": [
        26
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www2.nhes.nh.gov/GraniteStats/SessionServlet?page=Community.jsp&SID=1&city=000907&cityName=Middleton",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The Moose Mountains border Middleton, with peaks reaching 1,670 feet, the town’s highest point.",
      "sourceSentenceIds": [
        13
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Middleton%2C_New_Hampshire",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Sunrise Lake empties south toward the Cocheco River, while the rest of Middleton drains east into the Branch River, part of the Piscataqua watershed.",
