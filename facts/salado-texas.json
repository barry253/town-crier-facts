      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Salado College operated twice—1860‑1885 and 1895‑1913—before its former building became Thomas Arnold High School.",
      "sourceSentenceIds": [
        27
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
