      "category": "nature",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The Stagecoach Inn, built in 1866, is the oldest continuously running hotel in Texas and once served cattle drives on the Chisholm Trail.",
      "sourceSentenceIds": [
        28,
        30
      ],
      "sourceLabels": [
        "Wikipedia"
