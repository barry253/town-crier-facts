  "facts": [
    {
      "id": 1,
      "text": "Foster Brook takes its name from Leonard S. Foster, the first white settler who homesteaded there in 1824.",
      "sourceSentenceIds": [
        29,
        30
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/foster_brook_pennsylvania"
    },
    {
      "id": 2,
      "text": "Before European arrival, the Seneca Nation used the area as hunting grounds rather than permanent settlements.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/foster_brook_pennsylvania"
    },
    {
      "id": 3,
      "text": "The brook feeds the Tunungwant Creek system, channeling water toward the Allegheny River.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/foster_brook_pennsylvania"
    },
    {
      "id": 4,
      "text": "Foster Brook experiences a humid continental climate, with cold, snowy winters and mild, humid summers.",
      "sourceSentenceIds": [
        20
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/foster_brook_pennsylvania"
    },
    {
      "id": 5,
      "text": "About half of the homes face flood risk from the brook during spring thaws or heavy rains.",
      "sourceSentenceIds": [
        22
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/foster_brook_pennsylvania"
    },
    {
      "id": 6,
      "text": "Early economic life hinged on lumber, with pioneers like Samuel Bradley and H.W. Barr operating sawmills and rafting.",
      "sourceSentenceIds": [
