  "facts": [
    {
      "id": 1,
      "text": "Federal Dam earned its name from the 1882 Leech Lake Reservoir Dam, part of the Mississippi Headwaters system that regulated river flow.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/federal_dam_minnesota",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Federal Dam started as a railroad town, growing around the Soo Line depot that opened in 1910.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/federal_dam_minnesota",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The city incorporated on October 30, 1911, and split from the township a year later in 1912.",
      "sourceSentenceIds": [
        17
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.lakesnwoods.com/FederalDam.htm",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The dam’s construction flooded Ojibwe tribal lands, sparking a century‑long dispute with the U.S. government.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/federal_dam_minnesota",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Improved water regulation from the dam enabled log sluices that moved timber rafts until about 1920.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/federal_dam_minnesota",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Today Federal Dam is a recreational hub for fishing, boating, camping, and winter sports around Leech Lake and the Chippewa National Forest.",
      "sourceSentenceIds": [
