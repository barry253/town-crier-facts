  "facts": [
    {
      "id": 1,
      "text": "Victor earned its name from George Victor Sherwood, a mail carrier who braved threats to deliver letters.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Victor%2C_Idaho"
    },
    {
      "id": 2,
      "text": "Founded in 1889, Victor grew from the merger of Trail Creek, Fox Creek, Chapin and Cedron.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Victor%2C_Idaho"
    },
    {
      "id": 3,
      "text": "Perched at 6,214 feet, Victor enjoys a high‑altitude setting typical of the Teton Valley.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Victor%2C_Idaho"
    },
    {
      "id": 4,
      "text": "Victor stands as the largest city in Teton County, Idaho, drawing residents from the surrounding rural area.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Victor%2C_Idaho"
    },
    {
      "id": 5,
      "text": "Every July, Victor hosts the Laid‑Back Car Show, its 15th annual gathering of classic and custom vehicles.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
