  "facts": [
    {
      "id": 1,
      "text": "Moses Lake North takes its name from Chief Moses, a Columbia‑Sinkiuse tribal leader who guided the area in the late 1800s.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.cityofml.com/116/History-of-Moses-Lake",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town began as Neppel in 1911, then blossomed into a profitable lakeside orchard hub before water disputes slowed its growth.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.cityofml.com/116/History-of-Moses-Lake",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "By 1913, tangled water‑rights battles over Moses Lake’s supply effectively strangled the community’s expansion.",
      "sourceSentenceIds": [
        20
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.cityofml.com/116/History-of-Moses-Lake",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "When the apple market collapsed, local orchards were uprooted and replaced by sprawling fields of potatoes and onions.",
      "sourceSentenceIds": [
        19
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.cityofml.com/116/History-of-Moses-Lake",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The 1940s saw Moses Lake North boom after the nearby Moses Lake Army Air Base—now Larson AFB—opened, bringing jobs and irrigation water.",
      "sourceSentenceIds": [
        25
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.cityofml.com/116/History-of-Moses-Lake",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Residents rallied to back the Columbia Basin Irrigation Project and Grand Coulee Dam, shaping the region’s modern agricultural landscape.",
      "sourceSentenceIds": [
        23
      ],
      "sourceLabels": [
        "Web source 1"
      ],
