  "facts": [
    {
      "id": 1,
      "text": "Trevilians is the site of the largest all\u2011cavalry Civil War battle, the Battle of Trevilian Station, fought June 11\u201112 1864.",
      "sourceSentenceIds": [
        14
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Trevilians%2C_Virginia",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The battle centered on the Virginia Central Railroad, where Union forces tried to destroy tracks to cut Confederate supply lines.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://piedmontvahistory.louisacountyhistoricalsociety.org/archives14/items/show/1765",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Confederate General Wade Hampton\u2019s forces held a strong position at Trevilian Station, earning the nickname \u201cBloody Angle\u201d from Union soldiers.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://piedmontvahistory.louisacountyhistoricalsociety.org/archives14/items/show/1765",
      "category": "people",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Trevilians hosts four National Register of Historic Places sites: Grassdale, Green Springs, Ionia, and Westend.",
