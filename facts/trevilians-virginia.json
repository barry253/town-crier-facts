  "facts": [
    {
      "id": 1,
      "text": "Trevilians is the site of the largest all‑cavalry Civil War battle, the Battle of Trevilian Station, fought June 11‑12 1864.",
      "sourceSentenceIds": [
        14
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Trevilians%2C_Virginia"
    },
    {
      "id": 2,
      "text": "The battle centered on the Virginia Central Railroad, where Union forces tried to destroy tracks to cut Confederate supply lines.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://piedmontvahistory.louisacountyhistoricalsociety.org/archives14/items/show/1765"
    },
    {
      "id": 3,
      "text": "Confederate General Wade Hampton’s forces held a strong position at Trevilian Station, earning the nickname “Bloody Angle” from Union soldiers.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://piedmontvahistory.louisacountyhistoricalsociety.org/archives14/items/show/1765"
    },
    {
      "id": 4,
      "text": "Trevilians hosts four National Register of Historic Places sites: Grassdale, Green Springs, Ionia, and Westend.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Trevilians%2C_Virginia"
    },
    {
      "id": 5,
      "text": "Trevilians sits at the junction of U.S. Route 33 and Virginia State Route 22, about four miles west of Louisa, and enjoys a humid subtropical climate.",
