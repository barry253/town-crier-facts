  "facts": [
    {
      "id": 1,
      "text": "Pine Grove emerged in the late 19th century as part of a homesteading wave driven by the Homestead Act of 1862.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/pine_grove_wasco_county_oregon"
    },
    {
      "id": 2,
      "text": "Early settlers in Pine Grove faced harsh winters and limited water while establishing livestock and forage crop farming in the dry climate.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/pine_grove_wasco_county_oregon"
    },
    {
      "id": 3,
      "text": "The Dalles-Wapinitia stage line established in 1878 provided Pine Grove with essential connections to the Columbia River trade hub.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/pine_grove_wasco_county_oregon"
    },
    {
      "id": 4,
      "text": "Pine Grove lies near the White River, which joins the Deschutes River just north of the community.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/pine_grove_wasco_county_oregon"
    },
    {
      "id": 5,
      "text": "The Pine Grove schoolhouse, built in 1915, served as both an educational facility and a chapel for religious services.",
      "sourceSentenceIds": [
        29
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/pine_grove_wasco_county_oregon"
    },
    {
      "id": 6,
      "text": "A post office established in 1919 integrated Pine Grove into regional networks for mail and supplies from The Dalles.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/pine_grove_wasco_county_oregon"
