  "facts": [
    {
      "id": 1,
      "text": "Terryville takes its name from Eli Terry Jr., son of pioneering clockmaker Eli Terry Sr., who founded the town’s first clock factory in the early 1800s.",
      "sourceSentenceIds": [
        1,
        2,
        3,
        7,
        15
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Terryville%2C_Connecticut"
    },
    {
      "id": 2,
      "text": "The Lock Museum of America, housed in a historic mill building, showcases the region’s long tradition of lock manufacturing.",
      "sourceSentenceIds": [
        16
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Terryville%2C_Connecticut"
    },
    {
      "id": 3,
      "text": "A historic water wheel in downtown Terryville honors Eli Terry Jr., whose clockmaking innovations powered the town’s early industry.",
      "sourceSentenceIds": [
        17
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Terryville%2C_Connecticut"
    },
    {
      "id": 4,
      "text": "The Pequabuck River, a tributary of the Farmington River, winds through Terryville’s center, shaping its early mill sites.",
      "sourceSentenceIds": [
        20
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Terryville%2C_Connecticut"
    },
    {
      "id": 5,
      "text": "Buttermilk Falls, a 90‑foot drop on the Pequabuck River, sits within a Nature Conservancy preserve that opened in the 1970s.",
      "sourceSentenceIds": [
