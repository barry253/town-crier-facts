  "facts": [
    {
      "id": 1,
      "text": "Port Tobacco was the seat of Charles County from 1727 until 1895, and its history began with precolonial Native American villages.",
      "sourceSentenceIds": [
        21
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.explorecharlescounty.com/see-do/history-and-heritage/historic-port-tobacco-village/"
    },
    {
      "id": 2,
      "text": "The town’s decline began when the Port Tobacco River silted, cutting off river traffic and silting the tobacco trade.",
      "sourceSentenceIds": [
        25,
        26
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://midatlanticdaytrips.com/2024/07/historic-port-tobacco/"
    },
    {
      "id": 3,
      "text": "Stagg Hall, built by merchant Thomas Howe Ridgate, now opens Thursday–Sunday and offers guided tours of the historic home.",
      "sourceSentenceIds": [
        23,
        20
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.explorecharlescounty.com/see-do/history-and-heritage/historic-port-tobacco-village/"
    },
    {
      "id": 4,
      "text": "The former 1819 courthouse now serves as a historical museum, preserving artifacts from the town’s long civic life.",
      "sourceSentenceIds": [
        11
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Port_Tobacco_Village%2C_Maryland"
    },
    {
      "id": 5,
      "text": "Port Tobacco hosts the Thomas Stone National Historic Site, where signer of the Declaration of Independence built Habre de Venture in 1771.",
      "sourceSentenceIds": [
        24
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://midatlanticdaytrips.com/2024/07/historic-port-tobacco/"
    },
    {
      "id": 6,
      "text": "The area is one of the richest archaeological sites in Southern Maryland, preserving layers of Native, colonial, and enslaved African history.",
