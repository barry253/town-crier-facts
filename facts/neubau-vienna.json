  "facts": [
    {
      "id": 1,
      "text": "Neubau’s name comes from a ‘new building’ erected outside Vienna’s medieval walls, marking the area’s early expansion.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://connectingvienna.com/vienna/district/7-neubau/"
    },
    {
      "id": 2,
      "text": "In the 18th century, Neubau housed Vienna’s silk factories, making it a textile hub before the city’s modern era.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Neubau"
    },
    {
      "id": 3,
      "text": "The Volkstheater Wien, founded between 1887 and 1889, remains one of Vienna’s largest mainstream theatres in Neubau.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Neubau"
    },
    {
      "id": 4,
      "text": "The MuseumsQuartier in Neubau hosts the Leopold Collection and the Austrian Ministry of Justice, blending art with civic life.",
      "sourceSentenceIds": [
        17
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Neubau"
    },
    {
      "id": 5,
      "text": "U2/U3’s Volkstheater station drops you at the MQ, while Neubaugasse U3 serves the nearby shopping streets.",
      "sourceSentenceIds": [
        10,
        11
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://visitcity.travel/en/vienna/district/neubau"
    },
    {
      "id": 6,
      "text": "Leopold Museum, alongside the Museum of Art History, ranks among Vienna’s most important art museums, showcasing modern masterpieces.",
      "sourceSentenceIds": [
        9
      ],
