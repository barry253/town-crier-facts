  "facts": [
    {
      "id": 1,
      "text": "Tuxedo Park is a gated village in Orange County, NY, founded in 1885 by Pierre Lorillard IV as a private hunting reserve.",
      "sourceSentenceIds": [
        15,
        28,
        29
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Tuxedo_Park%2C_New_York",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The village’s name comes from a Lenape word meaning “round foot” or “Wolf Clan”, reflecting indigenous heritage.",
      "sourceSentenceIds": [
        17,
        18
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Tuxedo_Park%2C_New_York",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The Tuxedo Train Station, a Metro-North stop, and the historic library designed by Bruce Price are among the village’s preserved landmarks.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Tuxedo_Park%2C_New_York",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Three churches, a train station, a library, and a post office built in the 1880s still stand, with the Tuxedo Historical Society housed in one of the churches.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.tuxedopark-ny.gov/overview",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The village’s original cottages, built by Lorillard IV, were rented or sold to friends and family, setting a pattern of exclusive residential development.",
      "sourceSentenceIds": [
