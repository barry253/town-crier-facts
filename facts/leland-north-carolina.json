  "facts": [
    {
      "id": 1,
      "text": "Leland began as an unnamed crossroads settlement in the mid‑1890s where Village Road met the Wilmington‑Columbia‑Augusta Railroad.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.townofleland.com/history",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town’s early growth hinged on its position along the Brunswick River, making it a key transportation hub for river travelers.",
      "sourceSentenceIds": [
        14
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Leland%2C_North_Carolina",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Leland was officially incorporated on September 5, 1989, after a decisive town charter vote of 472 to 42.",
      "sourceSentenceIds": [
        15
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Leland%2C_North_Carolina",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Founders Park, Leland’s first public park, was originally called Municipal Park before receiving its current name.",
      "sourceSentenceIds": [
        27
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Leland%2C_North_Carolina",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "In 2005, Mr. Kirby Sullivan donated the land that became Cypress Cove Park, a 27‑acre wetland and 1.2‑acre upland preserve.",
      "sourceSentenceIds": [
        28,
        29
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Leland%2C_North_Carolina",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The town sits just five miles west of downtown Wilmington, placing it within easy reach of the coastal city.",
      "sourceSentenceIds": [
        12
