    {
      "id": 1,
      "text": "Lincoln Village’s original layout called for 9 miles of streets, a pumping station, and a million‑gallon water pump.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
