    },
    {
      "id": 2,
      "text": "Every September, Edgerton hosts the Sterling North Book and Film Festival, drawing authors and filmmakers to its historic downtown.",
      "sourceSentenceIds": [
        2,
        16
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Edgerton%2C_Wisconsin"
    },
    {
      "id": 3,
      "text": "A log cabin and the original Pauline Pottery building still stand in Edgerton, echoing the town’s early artistic heritage.",
      "sourceSentenceIds": [
        6,
        11,
        20
      ],
      "sourceLabels": [
