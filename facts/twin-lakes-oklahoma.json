  "facts": [
    {
      "id": 1,
      "text": "Twin Lakes was once part of the Unassigned Lands opened to non-Native settlement during the Land Run of April 22, 1889.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/twin_lakes_oklahoma"
    },
    {
      "id": 2,
      "text": "Archaeological evidence suggests that Native Americans lived in and traveled through the Twin Lakes region thousands of years ago.",
      "sourceSentenceIds": [
        21,
        22
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://twinlakesconservancy.org/history"
    },
    {
      "id": 3,
      "text": "Retreating ice left behind depressions that filled with water, creating the natural beauty seen today at Twin Lakes.",
      "sourceSentenceIds": [
        23
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://twinlakesconservancy.org/history"
    },
    {
      "id": 4,
      "text": "Immigrants from England, Scotland, and Germany began settling the Twin Lakes area by the mid-1800s, building homes from logs.",
      "sourceSentenceIds": [
        27,
