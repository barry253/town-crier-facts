  "facts": [
    {
      "id": 1,
      "text": "Butte was once the largest city west of the Mississippi between Chicago and San Francisco, earning the title “Montana’s most historic city.”.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://co.silverbow.mt.us/481/History-Culture",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "In 1881 Marcus Daly bought the Anaconda mine, sparking the rise of the Anaconda Copper Mining Company that dominated the town for decades.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Butte%2C_Montana",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Martial law ruled Butte from 1914 to 1921, the longest military occupation in U.S. history, amid fierce labor strikes.",
      "sourceSentenceIds": [
        16
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://co.silverbow.mt.us/481/History-Culture",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The Berkeley Pit, a former open‑pit copper mine, now sits as the largest Superfund site in the nation, draining the Clark Fork River.",
      "sourceSentenceIds": [
        19
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Butte%2C_Montana",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Uptown Butte’s Victorian homes and Queen Anne cottages, built on steep hills, form one of the country’s largest National Historic Landmark Districts with nearly 6,000 properties.",
      "sourceSentenceIds": [
        13
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Butte%2C_Montana",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "In 2007 Butte hosted the National Folk Festival for three years, earning it the nickname “The Festival City” before switching to the annual Montana Folk Festival.",
      "sourceSentenceIds": [
        17
