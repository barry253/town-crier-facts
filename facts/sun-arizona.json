  "facts": [
    {
      "id": 1,
      "text": "Sun City opened January 1, 1960 with five home models, a shopping center, a recreation center, and a golf course.",
      "sourceSentenceIds": [
        19
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Sun_City%2C_Arizona",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The opening weekend drew 100,000 people, ten times more than expected, and earned a Time magazine cover story.",
      "sourceSentenceIds": [
        20
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Sun_City%2C_Arizona",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "After a nationwide naming contest where the winner received a house, Del Webb chose the name Sun City for the former ghost town of Marinette.",
      "sourceSentenceIds": [
        22
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Sun_City%2C_Arizona",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Sun City West, built in the late 1970s, is Sun City’s adjacent sister community founded in 1978.",
      "sourceSentenceIds": [
        13,
        24
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Sun_City%2C_Arizona",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Del Webb’s Sun City became a blueprint for modern retirement living, inspiring similar age‑restricted communities across the Sun Belt.",
      "sourceSentenceIds": [
        10,
        3
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/Sun_City%2C_Arizona",
      "category": "culture",
      "quality": "good",
      "qualityReason": "vague"
    },
    {
      "id": 6,
      "text": "The community’s street network consists largely of concentric circles in four main pinwheels, a design unique to Sun City.",
