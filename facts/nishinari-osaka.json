  "facts": [
    {
      "id": 1,
      "text": "Nishinari‑ku is one of Osaka's 24 wards and has long been known as one of Japan's poorest territories.",
      "sourceSentenceIds": [
        17
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Nishinari-ku%2C_Osaka",
      "category": "people",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The ward sits just south of the Namba transport hub and stretches toward Sumiyoshi Park.",
      "sourceSentenceIds": [
        18
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Nishinari-ku%2C_Osaka",
      "category": "other",
      "quality": "poor",
      "qualityReason": "location_description"
    },
    {
      "id": 3,
      "text": "In the 1980s and 1990s, yakuza groups like Sakaume‑gumi and Azuma‑gumi were active in Nishinari, influencing local real estate.",
      "sourceSentenceIds": [
        3,
        4,
        22
      ],
      "sourceLabels": [
        "Web source 1",
        "Wikipedia"
      ],
      "source": "https://article.bespes-jt.com/en/article/nishinari/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The area is famous for its doya, budget inns that once housed day laborers and now attract backpackers.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://japanmapper.com/area-guide/osaka/nishinari",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Shinsekai, next to Nishinari, once hosted Luna Park, a 1912 amusement park with a mechanical ropeway and spa.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://japanmapper.com/area-guide/osaka/nishinari",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Kamagasaki in Nishinari hosts many day‑laborers and is home to most of Osaka's homeless population.",
