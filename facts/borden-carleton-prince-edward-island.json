  "facts": [
    {
      "id": 1,
      "text": "Borden‑Carleton sits on Prince Edward Island’s south shore fronting the Northumberland Strait.",
      "sourceSentenceIds": [
        15,
        21
      ],
      "sourceLabels": [
        "Web source 1",
        "Wikipedia"
      ],
      "source": "https://www.borden-carleton.ca/history",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town’s name honors former Prime Minister Sir Robert Borden, renamed in 1916 from Carleton Point.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.britannica.com/place/Borden-Prince-Edward-Island",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "In 1917, the new Carleton Point port opened, allowing the SS Prince Edward Island to run year‑round ferry service.",
      "sourceSentenceIds": [
        27,
        30
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Borden-Carleton",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The Confederation Bridge opened May 31, 1997, ending 70 years of daily ferry operations from Borden.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Borden-Carleton",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "After the bridge, the former ferry wharves were decommissioned and the site became the Gateway Village shopping complex.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Borden-Carleton",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The town incorporated as a community on April 12, 1995, then became a town on July 31, 2012.",
