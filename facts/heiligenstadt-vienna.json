  "facts": [
    {
      "id": 1,
      "text": "Heiligenstadt, whose name means 'holy city,' first appears as Sanctum Locum in late‑12th‑century documents, hinting at a pre‑Christian sacred site.",
      "sourceSentenceIds": [
        18,
        21
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Heiligenstadt%2C_Vienna",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Roman excavations revealed a limes tower wall and a cemetery near Jakobskirche, proving the area once hosted an empire frontier fort.",
      "sourceSentenceIds": [
        24,
        25,
        26
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Heiligenstadt%2C_Vienna",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Otto Wagner’s 1898 Heiligenstadt station linked the Emperor Franz Joseph Railway, the Stadtbahn, and the Vorortelinie, becoming a pivotal transfer point.",
      "sourceSentenceIds": [
        13
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Heiligenstadt%2C_Vienna",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Today the same station serves as a major bus hub, connecting Vienna commuters and routes heading toward Klosterneuburg.",
      "sourceSentenceIds": [
        14
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Heiligenstadt%2C_Vienna",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Heiligenstadt’s industrial era began in the late 18th century with factories such as Barawitzka parquet, Heinrich machine works, and Just‑Leitern‑AG.",
      "sourceSentenceIds": [
        1,
        5
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Heiligenstadt%2C_Vienna",
      "category": "history",
      "quality": "good"
    },
    {
