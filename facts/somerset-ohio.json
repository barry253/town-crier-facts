  "facts": [
    {
      "id": 1,
      "text": "Founded in 1807 by settlers from Somerset, Pennsylvania, the village sits on historic Zane's Trace.",
      "sourceSentenceIds": [
        6,
        12
      ],
      "sourceLabels": [
        "Web source 1",
        "Wikipedia"
      ],
      "source": "https://www.somersetohio.org/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Somerset’s first courthouse began as a resident’s home, then became a purpose‑built hall in 1819, and a permanent square courthouse in 1829.",
      "sourceSentenceIds": [
        2,
        3,
        13,
        14
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Somerset%2C_Ohio",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The village once held Perry County’s seat, a title it lost and regained during a 19th‑century legal tug‑of‑war.",
      "sourceSentenceIds": [
        4,
        16
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Somerset%2C_Ohio",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The 1829 federal courthouse, still standing, is the oldest public building in continuous service in the Northwest Territory.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.achp.gov/preserve-america/community/somerset-ohio",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Saint Joseph Church, Ohio’s oldest Catholic church, sits just outside Somerset on State Route 383.",
      "sourceSentenceIds": [
        11
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Somerset%2C_Ohio",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The Perry County Historical Society hosts lectures on Civil War topics, from the Underground Railroad to medical advances.",
