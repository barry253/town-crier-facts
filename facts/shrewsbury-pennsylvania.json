    },
    {
      "id": 2,
      "text": "The borough officially formed on August 9, 1834, when the General Assembly incorporated Shrewsbury.",
      "sourceSentenceIds": [
        14
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Shrewsbury%2C_Pennsylvania"
    },
    {
      "id": 3,
      "text": "In 1984, Shrewsbury Historic District earned a spot on the National Register of Historic Places.",
      "sourceSentenceIds": [
        17
