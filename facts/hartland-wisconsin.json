  "facts": [
    {
      "id": 1,
      "text": "Hartland is a village along the Bark River in Waukesha County, a suburb of Milwaukee.",
      "sourceSentenceIds": [
        19
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Hartland%2C_Wisconsin"
    },
    {
      "id": 2,
      "text": "The village got its name from the Native word “Shabaquanake” after the railroad arrived in 1854.",
      "sourceSentenceIds": [
        16
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://hartland-wi.org/about/about-hartland/"
    },
    {
      "id": 3,
      "text": "The Local History Room in Hartland Public Library houses old plat maps from 1873 to 1930 and a state‑of‑the‑art microfilm reader.",
      "sourceSentenceIds": [
        13,
        17
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.villageofhartland.wi.gov/268/Hartland-History"
    },
    {
      "id": 4,
      "text": "A 1842 grist mill built by Christian Hershey led to the village briefly being called Hersheyville.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://hartland-wi.org/about/about-hartland/"
    },
    {
      "id": 5,
      "text": "Hartland’s historic churches include the Danish Evangelical Lutheran Kirke and the First Baptist Church, both listed on the National Register of Historic Places.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Hartland%2C_Wisconsin"
    },
    {
      "id": 6,
      "text": "The village’s Local History Room also displays early Wisconsin and Waukesha histories and artifacts in two display cases near its entrance.",
