  "facts": [
    {
      "id": 1,
      "text": "Niles was founded in 1806 by James Heaton, who ran one of Ohio’s first iron‑ore processing plants.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Niles%2C_Ohio",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town’s original name was Heaton’s Furnace, later renamed Niles in 1843 after editor Hezekiah Niles of the Weekly Register.",
      "sourceSentenceIds": [
        1,
        2
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 2"
      ],
      "source": "https://en.wikipedia.org/wiki/Niles%2C_Ohio",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Niles grew into a steel, iron, and glass production hub after discovering high‑grade black band iron ore in Mineral Ridge.",
      "sourceSentenceIds": [
        22,
        28
      ],
      "sourceLabels": [
        "Web source 2",
        "Wikipedia"
      ],
      "source": "https://nilescommunity.weebly.com/history.html",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The Ward‑Thomas Museum, housed in a historic firebrick building, preserves the city’s industrial and civic heritage.",
      "sourceSentenceIds": [
        15,
        10
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Niles%2C_Ohio",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Niles is the birthplace of President William McKinley, honored by the National McKinley Birthplace Memorial Library and Museum.",
      "sourceSentenceIds": [
        25,
        27
      ],
      "sourceLabels": [
        "Wikipedia",
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Niles%2C_Ohio",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The Niles Car and Manufacturing Company once built streetcars and interurban cars that traveled across the nation.",
      "sourceSentenceIds": [
        14
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
