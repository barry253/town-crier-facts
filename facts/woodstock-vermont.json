      "id": 1,
      "text": "Woodstock was chartered in 1761, fifteen years before the Declaration of Independence.",
      "sourceSentenceIds": [
        15,
        30
      ],
      "sourceLabels": [
        "Web source 1",
        "Wikipedia"
      ],
