  "facts": [
    {
      "id": 1,
      "text": "Historic Third Ward was once a tight Italian‑American enclave with 29 saloons, 45 groceries, an Italian bank and two spaghetti factories by 1915.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Historic_Third_Ward_(Milwaukee)",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The 1960s I‑794 construction displaced most of that community and demolished the Blessed Virgin of Pompeii Catholic Church, Milwaukee’s first architectural landmark.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Historic_Third_Ward_(Milwaukee)",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "In the 1990s warehouses were converted into market‑rate housing, sometimes displacing former tenants, marking a rapid redevelopment era.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Historic_Third_Ward_(Milwaukee)",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The neighborhood anchors Milwaukee’s public market, a striking industrial‑style space that hosts local vendors and fresh eats.",
      "sourceSentenceIds": [
        26
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.visitmilwaukee.org/plan-a-visit/areas-to-explore/historic-third-ward/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The Marshall Building, a former warehouse, now houses 19 independent galleries across multiple floors, showcasing contemporary art.",
      "sourceSentenceIds": [
        16
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.visitmilwaukee.org/plan-a-visit/areas-to-explore/historic-third-ward/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Historic Third Ward sits just south of downtown along the Milwaukee River, making it one of Milwaukee’s most walkable neighborhoods.",
