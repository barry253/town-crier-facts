  "facts": [
    {
      "id": 1,
      "text": "Farmington sits where the San Juan, Animas, and La Plata rivers converge, a spot the Navajo called Tóta'—'where three rivers meet'.",
      "sourceSentenceIds": [
        17,
        23
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Farmington%2C_New_Mexico",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Farmington was incorporated in 1901 as Junction City, a name honoring its river junction, and then renamed Farmington.",
      "sourceSentenceIds": [
        28,
        5
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Farmington%2C_New_Mexico",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "By 1905 a railroad connected Farmington to Durango, Colorado, opening the city to trade and encouraging rapid settlement.",
      "sourceSentenceIds": [
        6,
        7
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Farmington%2C_New_Mexico",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Oil and gas exploration boomed in the 1920s, yet production stayed low until the 1950s when the San Juan Basin pipeline opened.",
      "sourceSentenceIds": [
