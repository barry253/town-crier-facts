  "facts": [
    {
      "id": 1,
      "text": "Butler‑Tarkington takes its name from Butler University and the celebrated author Booth Tarkington, who once called the area home.",
      "sourceSentenceIds": [
        28
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Butler%E2%80%93Tarkington%2C_Indianapolis",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The neighborhood began as a 1840s farming settlement near what is now 38th Street and Illinois Street.",
      "sourceSentenceIds": [
        15
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Butler%E2%80%93Tarkington%2C_Indianapolis",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "By the 1860s, the area linked to Indianapolis’s railway system, opening doors for growth.",
      "sourceSentenceIds": [
        17
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Butler%E2%80%93Tarkington%2C_Indianapolis",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "In 1890, an electric streetcar line ran through Butler‑Tarkington, connecting it to downtown.",
      "sourceSentenceIds": [
        18
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Butler%E2%80%93Tarkington%2C_Indianapolis",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The Butler‑Tarkington Neighborhood Association formed in 1956 to ease tensions during the neighborhood’s racial integration.",
      "sourceSentenceIds": [
        23
      ],
      "sourceLabels": [
