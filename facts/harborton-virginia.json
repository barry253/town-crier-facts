  "facts": [
    {
      "id": 1,
      "text": "Harborton was founded in 1880, yet activity on Pungoteague Creek dates back to 1667.",
      "sourceSentenceIds": [
        17
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://harbortonhistmuseum.wixsite.com/harborton-histmuseum"
    },
    {
      "id": 2,
      "text": "The town once hosted a menhaden fish factory, a high school, multiple general stores, and was one of the Eastern Shore’s largest steamboat ports.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://harbortonhistmuseum.wixsite.com/harborton-histmuseum"
    },
    {
      "id": 3,
      "text": "During the War of 1812, Pungoteague Creek saw a skirmish between British Navy forces from Tangier Island and local militia.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://harbortonhistmuseum.wixsite.com/harborton-histmuseum"
    },
    {
      "id": 4,
      "text": "The Harborton History Museum opened June 4, 2016 in the former post office building that served the town from 1974 to 2005.",
      "sourceSentenceIds": [
        15
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://harbortonhistmuseum.wixsite.com/harborton-histmuseum"
    },
    {
      "id": 5,
      "text": "Founded in late 2010, the museum preserves artifacts and stories from Harborton’s past for future generations.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://harbortonhistmuseum.wixsite.com/harborton-histmuseum"
    },
    {
      "id": 6,
      "text": "Harborton’s high school operated on the same grounds from 1907 to 1944, later becoming part of the museum’s location.",
      "sourceSentenceIds": [
        16
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://harbortonhistmuseum.wixsite.com/harborton-histmuseum"
    }
  ]
