      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The Union Hotel, built in 1855, stands as one of the oldest surviving structures in La Porte and is a California Historical Landmark.",
      "sourceSentenceIds": [
        8,
        3
      ],
      "sourceLabels": [
        "Web source 2",
