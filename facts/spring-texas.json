  "facts": [
    {
      "id": 1,
      "text": "Old Town Spring, the heart of the city, dates back to the 18th‑century farming community that later became a 19th‑century railroad hub.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://springhistoricalmuseum.org/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Spring was founded in 1838, originally centered around what is now Old Town Spring.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.springtx.com/about/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "In 2019 the Spring Historical Museum was refurbished with a bright yellow façade, becoming a prominent landmark in Old Town Spring.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://springhistoricalmuseum.org/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The town’s name honors Baldwin Boettcher, a German settler who helped establish the early community.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Spring%2C_Texas",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Before European settlement, the Orcoquiza Native Americans inhabited the area that is now Spring, Texas.",
