  "facts": [
    {
      "id": 1,
      "text": "Hume was originally called Barbee's Crossroads after Joseph Barbee who leased the land in 1787.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Hume%2C_Virginia",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The village served as a medical stop during the Civil War, where wounded from the First and Second Battles of Bull Run were brought.",
      "sourceSentenceIds": [
        11
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Hume%2C_Virginia",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The Hume Historic District, listed on the National Register in 2008, preserves a crossroads village with intact 18th‑century commercial buildings.",
      "sourceSentenceIds": [
        18,
        19
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Hume%2C_Virginia",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "A 1875 white public school and two African‑American schools, the oldest built around 1906, mark Hume’s early educational history.",
      "sourceSentenceIds": [
        22
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.dhr.virginia.gov/historic-registers/030-5158/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The local Hume family gave the town its name after the Barbee era, replacing the earlier name in the late 19th century.",
      "sourceSentenceIds": [
        1,
        5
      ],
      "sourceLabels": [
        "Web source 1",
        "Wikipedia"
      ],
      "source": "https://www.dhr.virginia.gov/historic-registers/030-5158/",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Hume sits just east of the Rappahannock County line along Virginia State Route 688, five miles south of I‑66 Exit 18.",
      "sourceSentenceIds": [
