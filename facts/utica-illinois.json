  "facts": [
    {
      "id": 1,
      "text": "Utica grew along the Illinois River near the historic Kaskaskia village, then moved north when flooding and the canal reshaped the area.",
      "sourceSentenceIds": [
        18,
        23
      ],
      "sourceLabels": [
        "Web source 2",
        "Wikipedia"
      ],
      "source": "https://jamiesoutpost.com/blog-post-2/"
    },
    {
      "id": 2,
      "text": "Before the canal, Utica was briefly named Science, Illinois, before residents relocated closer to the new waterway.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://jamiesoutpost.com/blog-post-2/"
    },
    {
      "id": 3,
      "text": "The LaSalle County Historical Museum sits in a former I&M Canal warehouse at Mill & Canal Streets, right in downtown Utica.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://jamiesoutpost.com/blog-post-2/"
    },
    {
      "id": 4,
      "text": "Utica Public Library, a community hub, is located at Mill and Grove Streets in the heart of downtown.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://jamiesoutpost.com/blog-post-2/"
    },
    {
      "id": 5,
      "text": "The Burgoo Festival, a fundraising event, is hosted annually by the LaSalle County Historical Society each summer.",
      "sourceSentenceIds": [
        5,
        19
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 2"
      ],
      "source": "https://en.wikipedia.org/wiki/North_Utica%2C_Illinois"
    },
    {
      "id": 6,
      "text": "Wild Bill Hickok Days, held May 30‑31, celebrates the famed frontiersman who was born in Utica.",
      "sourceSentenceIds": [
        14
      ],
