  "facts": [
    {
      "id": 1,
      "text": "Parishville was named after financier David Parish, who bought the land in 1810, and the town was officially organized on March 18, 1814.",
      "sourceSentenceIds": [
        1,
        3
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/parishville_cdp_new_york",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "In the early 19th century, Parishville boasted 14 mills powered by the Gorge along the St. Regis River, making it an industrial hub.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/parishville_cdp_new_york",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "David Parish, a German‑born banker, acquired roughly 200,000 acres of wilderness in 1808, laying the groundwork for the town’s development.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/parishville_cdp_new_york",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The West Branch of the St. Regis River runs through the community, joining the main river near Winthrop.",
      "sourceSentenceIds": [
        15,
        17
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Parishville_(CDP)%2C_New_York",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "A dam in the center of Parishville drops the Regis River 130 feet in less than a mile, creating a dramatic waterfall at Allen Falls Reservoir.",
      "sourceSentenceIds": [
        16
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Parishville_(CDP)%2C_New_York",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Parishville sits in the northern foothills of the Adirondack Park, offering lush forests, vibrant fall colors, and snowy winter landscapes.",
      "sourceSentenceIds": [
        25
      ],
      "sourceLabels": [
        "Web source 1"
      ],
