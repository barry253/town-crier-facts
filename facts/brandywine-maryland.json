      ],
      "source": "https://grokipedia.com/page/Brandywine,_Maryland",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Originally a cluster of colonial farms, Brandywine centered on a crossroads of an old stagecoach road and Indian Head Road.",
      "sourceSentenceIds": [
        13
      ],
      "sourceLabels": [
        "Web source 2"
      ],
