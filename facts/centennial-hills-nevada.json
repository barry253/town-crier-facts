    },
    {
      "id": 2,
      "text": "The neighborhood centers on a historic inverted riverbed, the last surviving channel from an ancient network that once covered the area.",
      "sourceSentenceIds": [
        3,
        13
      ],
      "sourceLabels": [
        "Web source 1",
        "Wikipedia"
      ],
      "source": "https://www.lasvegasnevada.gov/Residents/Parks-Facilities/Centennial-hills-park"
    },
    {
      "id": 3,
      "text": "Centennial Hills Park hosts a 3,000‑seat amphitheater and ice‑age fossil‑themed trails that trace the region’s prehistoric past.",
      "sourceSentenceIds": [
        4,
        13
      ],
      "sourceLabels": [
        "Web source 1",
        "Wikipedia"
      ],
      "source": "https://www.lasvegasnevada.gov/Residents/Parks-Facilities/Centennial-hills-park"
    },
    {
      "id": 4,
      "text": "Tule Springs Fossil Beds National Monument lies just north of the neighborhood, reachable via Moccasin Road and Durango Drive.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Centennial_Hills%2C_Las_Vegas"
    },
    {
      "id": 5,
      "text": "In 2008, Centennial Hills Hospital opened as Nevada’s first tobacco‑free campus, offering 226 beds across 354,000 square feet.",
