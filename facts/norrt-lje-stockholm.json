  "facts": [
    {
      "id": 1,
      "text": "First mentioned in 1219 as Tälje, the town later adopted the name Norrtälje to avoid confusion with Södertälje.",
      "sourceSentenceIds": [
        6,
        14
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Norrt%C3%A4lje",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "King Gustav II Adolf founded Norrtälje in 1622, part of a wave of new towns after the Thirty Years' War.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Norrt%C3%A4lje",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The Pythagoras Mechanical Workshop Museum showcases Norrtälje’s industrial heritage inside a former hot bulb engine factory.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Norrt%C3%A4lje",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Norrtälje’s stone church was finished in 1726, four years after the city hall was completed.",
      "sourceSentenceIds": [
        16
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Norrt%C3%A4lje",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The town’s railway station operated on the narrow gauge Roslagsbanan from 1884 until 1969, linking it to Stockholm.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
