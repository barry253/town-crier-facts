      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The Jesse Chew House, built in 1772 from Jersey sandstone, sits on Mantua‑Sewell Road and is listed on the National Register of Historic Places.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/Sewell,_New_Jersey",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Sewell hosts the Inversand marl pit, the world’s last operational greensand mine, a relic of the region’s mining past.",
      "sourceSentenceIds": [
        15
      ],
      "sourceLabels": [
        "Wikipedia"
