      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Rowan College of South Jersey’s Sewell campus, opened in 2022, offers osteopathic medical training at 1474 Tanyard Road.",
      "sourceSentenceIds": [
