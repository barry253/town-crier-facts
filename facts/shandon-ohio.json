  "facts": [
    {
      "id": 1,
      "text": "Shandon, once called Paddy's Run, has cycled through more than a dozen names—including Cambria, Glendower, and Bagdad—over its 200‑year history.",
      "sourceSentenceIds": [
        5,
        6,
        29
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Shandon%2C_Ohio",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The first Welsh settlement in Ohio began in 1801 when William and Morgan Gwilym purchased land in what is now Morgan Township.",
      "sourceSentenceIds": [
        23
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Shandon%2C_Ohio",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "A brick Meetinghouse built in 1824 still stands and is now being restored as the Community House, echoing Shandon’s early religious architecture.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Shandon%2C_Ohio",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Founded in 1976, the Morgan Township Historical Society preserves Shandon’s heritage in a former general store museum and a research library open by appointment.",
      "sourceSentenceIds": [
        1,
        15,
        21
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://museumsdatabase.com/museums/view/24554",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Shandon lies on Paddy's Run, a tributary of the Great Miami River, about four miles west of Ross at the junction of State Routes 126 and 748.",
