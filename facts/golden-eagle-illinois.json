  "facts": [
    {
      "id": 1,
      "text": "Golden Eagle is an unincorporated community in southern Calhoun County, Illinois, 5 miles south of Brussels at the county's southern tip.",
      "sourceSentenceIds": [
        14,
        15
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Golden_Eagle%2C_Illinois"
    },
    {
      "id": 2,
      "text": "The community sits on bluffs overlooking the Mississippi River, formed by wind‑deposited loess over bedrock.",
      "sourceSentenceIds": [
        16,
        26
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/golden_eagle_illinois"
    },
    {
      "id": 3,
      "text": "Golden Eagle Ferry provides year‑round vehicle and passenger crossings to Portage des Sioux, Missouri, operating daily with extended weekend hours.",
      "sourceSentenceIds": [
        17
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/golden_eagle_illinois"
    },
    {
      "id": 4,
      "text": "The ferry charges $9 one‑way for vehicles, $17 round‑trip, and accepts cash only, running from 5 a.m. each day.",
      "sourceSentenceIds": [
        18,
        19
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/golden_eagle_illinois"
    },
    {
      "id": 5,
      "text": "The area’s climate features hot, humid summers with 34 days over 90°F and cold winters averaging 21°F lows.",
      "sourceSentenceIds": [
        29,
        30
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/golden_eagle_illinois"
    },
    {
      "id": 6,
      "text": "Historical records trace early settlement to 1811 when pioneer Talton O'Neal established a homestead upstream from the current ferry site.",
