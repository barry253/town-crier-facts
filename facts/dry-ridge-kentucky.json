  "facts": [
    {
      "id": 1,
      "text": "Dry Ridge takes its name from a ridge that lacked natural water, making it a landmark for stock drivers heading to Cincinnati markets in the early 1800s.",
      "sourceSentenceIds": [
        9,
        20
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/Dry_Ridge,_Kentucky",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Dry Ridge was incorporated as a city in 1920 and became a station on the Cincinnati Southern Railroad, spurring agricultural growth.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/Dry_Ridge,_Kentucky",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "From 1910 to 1960, Dry Ridge’s economy revolved around mineral water wells believed to have healing properties.",
      "sourceSentenceIds": [
        14
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Dry_Ridge%2C_Kentucky",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The 1892 church building, originally Baptist, later joined the Presbyterian Church in 1975, remains a historic landmark in Dry Ridge.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 2"
      ],
