    },
    {
      "id": 2,
      "text": "The historic Fidelis School was built in 1925 and earned a spot on the National Register of Historic Places in 2021.",
      "sourceSentenceIds": [
        2,
        11
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Fidelis%2C_Florida"
    },
    {
      "id": 3,
      "text": "Fidelis historically relied on an agricultural economy featuring numerous farms, several gristmills, and Noah Hopkin's Cotton Gin.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Fidelis%2C_Florida"
    },
    {
      "id": 4,
      "text": "The community of Fidelis was also home to the McLean Sawmill during its early development.",
      "sourceSentenceIds": [
        14
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Fidelis%2C_Florida"
    },
    {
      "id": 5,
      "text": "Fidelis is positioned near the Blackwater River and is surrounded by forested landscapes of pine flatwoods and hardwood hammocks.",
      "sourceSentenceIds": [
        20
