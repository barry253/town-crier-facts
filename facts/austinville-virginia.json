  "facts": [
    {
      "id": 1,
      "text": "Austinville was founded in 1789 when Moses Austin and his brother revitalized an abandoned lead mine along the New River.",
      "sourceSentenceIds": [
        4,
        12
      ],
      "sourceLabels": [
        "Web source 2",
        "Web source 1"
      ],
      "source": "https://storiesofappalachia.com/?p=3283",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town sits on the historic site of lead mines that once served as the seat of former Fincastle County.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Austinville%2C_Virginia",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Stephen F. Austin, born November 3 1793 in Austinville, earned the nickname “Father of Texas” for leading settlers to Tejas.",
      "sourceSentenceIds": [
        11,
        5
      ],
      "sourceLabels": [
        "Web source 1",
        "Web source 2"
      ],
      "source": "https://www.vaco.org/county-connections/visit-wythe-county-and-the-stephen-f-austin-memorial-park/",
      "category": "people",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "A marble monument on the New River commemorates Stephen F. Austin, erected by Wythe County citizens with Texas donors.",
      "sourceSentenceIds": [
        26
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.vaco.org/county-connections/visit-wythe-county-and-the-stephen-f-austin-memorial-park/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Moses Austin met Spanish officials in 1820 to propose an American colony in Mexican Tejas, foreshadowing Texas independence.",
      "sourceSentenceIds": [
        30
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://storiesofappalachia.com/?p=3283",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Wythe County plans to restore the monument and develop Poplar Camp near Austinville, aiming to brand the community nationally.",
      "sourceSentenceIds": [
        28
      ],
