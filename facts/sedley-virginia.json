  "facts": [
    {
      "id": 1,
      "text": "Sedley was founded in 1907 as a company town by the Surry Lumber Company along the Virginian Railway.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/sedley_virginia"
    },
    {
      "id": 2,
      "text": "The town’s economy shifted to peanut farming after the lumber boom, with the Hubbard Peanut Company starting in 1954.",
      "sourceSentenceIds": [
        4,
        14
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Sedley%2C_Virginia"
    },
    {
      "id": 3,
      "text": "Daily locomotive hauls of 25‑30 carloads of logs peaked in the 1920s before the company’s decline.",
      "sourceSentenceIds": [
        15
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/sedley_virginia"
    },
    {
      "id": 4,
      "text": "Sedley sits at an elevation of 89 feet, typical of the low‑lying plains of Southampton County.",
      "sourceSentenceIds": [
        17
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Sedley%2C_Virginia"
    },
    {
      "id": 5,
      "text": "The town’s early history traces back to indigenous Cheroenhaka and Meherrin tribes who settled along nearby rivers before European colonization.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/sedley_virginia"
    },
    {
      "id": 6,
      "text": "In 2023, the Hubbard Peanut Company celebrated its 70th anniversary, marking seven decades of local peanut production.",
