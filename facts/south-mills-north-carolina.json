      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Three sites in South Mills—the William Riley Abbott House, the Dismal Swamp Canal, and the Morgan House—are listed on the National Register of Historic Places.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Wikipedia"
