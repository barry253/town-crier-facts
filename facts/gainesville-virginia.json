  "facts": [
    {
      "id": 1,
      "text": "Gainesville earned its name when Thomas Brawner Gaines insisted that the Manassas Gap Railroad stop there and called the station after his family.",
      "sourceSentenceIds": [
        7,
        18
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 2"
      ],
      "source": "https://en.wikipedia.org/wiki/Gainesville%2C_Virginia",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The village once carried two other names, New Stable and Beckhamsville, before settling on Gainesville in the 1850s.",
      "sourceSentenceIds": [
        20,
        5
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 2"
      ],
      "source": "https://en.wikipedia.org/wiki/Gainesville%2C_Virginia",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Gainesville’s first townhome community, Crossroads, broke ground in 1994, marking the town’s first major residential development in modern times.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Gainesville%2C_Virginia",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The Mount Pleasant Baptist Church, founded by local residents, served as a central meeting place for over a century and remains a historic landmark.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Gainesville%2C_Virginia",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Jiffy Lube Live, an outdoor amphitheater originally called the Nissan Pavilion, hosts concerts and events that draw crowds from across the region.",
