      ],
      "source": "https://issuu.com/sunflower_publishing/docs/leawood23fawi-singles/s/36861427",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "2003 saw Oxford School move to Ironwoods Park, where it now hosts a living‑history program about early 20th‑century life.",
