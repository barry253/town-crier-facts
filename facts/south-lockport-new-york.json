  "facts": [
    {
      "id": 1,
      "text": "South Lockport first settled in the early 1800s as settlers moved northward along the soon‑to‑be Erie Canal.",
      "sourceSentenceIds": [
        2,
        4
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/south_lockport_new_york",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "South Lockport sits on a 60‑foot rise of the Niagara Escarpment, where the Erie Canal’s Flight of Five locks were built.",
      "sourceSentenceIds": [
        20,
        25
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/south_lockport_new_york",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Transit Road, an 800‑foot wide corridor opened in 1798, became South Lockport’s main artery for moving farm goods to markets.",
      "sourceSentenceIds": [
        24,
        18
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/south_lockport_new_york",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "In the 1820s, mills like Otis Hathaway’s grain mill and Spalding’s flour mill harnessed canal water to process local wheat and fruits.",
      "sourceSentenceIds": [
        26
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/south_lockport_new_york",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "By the early 1900s, South Lockport evolved from a rural hamlet into a suburban community as transportation links improved.",
      "sourceSentenceIds": [
        29
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/south_lockport_new_york",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The Harrison Radiator Division of General Motors opened a plant near South Lockport in the 1950s, boosting regional employment.",
      "sourceSentenceIds": [
