  "facts": [
    {
      "id": 1,
      "text": "Murrayville was named for John Patrick Murray, who ran an inn that served travelers heading to Dahlonega’s gold fields.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.usacitiesonline.com/gacountymurrayville.htm"
    },
    {
      "id": 2,
      "text": "The town sits on the shores of Lake Sidney Lanier, about 50 miles from Atlanta.",
      "sourceSentenceIds": [
        14
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.usacitiesonline.com/gacountymurrayville.htm"
    },
    {
      "id": 3,
      "text": "Murrayville’s elevation is roughly 1,500 feet above sea level, giving it a mild mountain climate.",
      "sourceSentenceIds": [
        11
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.usacitiesonline.com/gacountymurrayville.htm"
    },
    {
      "id": 4,
      "text": "Every year the community hosts the Murrayville Gathering, drawing hundreds of visitors from across northern Georgia.",
      "sourceSentenceIds": [
        18
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.usacitiesonline.com/gacountymurrayville.htm"
    },
    {
      "id": 5,
      "text": "Murrayville lies along Georgia State Route 60, just under ten miles north of Gainesville.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Murrayville%2C_Georgia"
    },
    {
      "id": 6,
      "text": "As an unincorporated community in Hall County, Murrayville does not have its own municipal government.",
