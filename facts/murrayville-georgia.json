      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town sits on the shores of Lake Sidney Lanier, about 50 miles from Atlanta.",
      "sourceSentenceIds": [
        14
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.usacitiesonline.com/gacountymurrayville.htm",
      "category": "other",
      "quality": "poor",
      "qualityReason": "location_description"
    },
    {
      "id": 3,
      "text": "Every year the community hosts the Murrayville Gathering, drawing hundreds of visitors from across northern Georgia.",
      "sourceSentenceIds": [
        18
