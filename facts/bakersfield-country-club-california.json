    },
    {
      "id": 2,
      "text": "The club’s 18‑hole layout, designed by William P. Bell, stretches 6,822 yards across the San Joaquin Valley foothills.",
      "sourceSentenceIds": [
        6,
        24
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Bakersfield_Country_Club"
    },
    {
      "id": 3,
      "text": "Unlike many coastal California clubs, Bakersfield Country Club has never chased celebrity status, instead fostering multi‑generational ties among local business families.",
      "sourceSentenceIds": [
        19,
        20
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.theprivateclubs.com/editorial/bakersfield-country-club-bakersfield-history"
    },
    {
      "id": 4,
      "text": "The course’s strategic design rewards precision over power, a philosophy that has kept it a respected amateur test for decades.",
      "sourceSentenceIds": [
        25,
        27
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.theprivateclubs.com/editorial/bakersfield-country-club-bakersfield-history"
    },
    {
      "id": 5,
      "text": "Bakersfield Country Club hosted the Bakersfield Open Invitational, a PGA Tour event, in 1961 and 1962.",
