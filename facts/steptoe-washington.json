  "facts": [
    {
      "id": 1,
      "text": "Steptoe is named after Colonel Edward Steptoe, who led a 1858 expedition that fought near the town’s namesake battle.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Steptoe%2C_Washington",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The community sits beside Steptoe Butte, a quartzite peak that rises over 1,000 feet above the Palouse grasslands.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Steptoe%2C_Washington",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Steptoe Butte’s quartzite was once a sandy beach, later metamorphosed and uplifted, making it a type locality for that geology.",
      "sourceSentenceIds": [
        13,
        15,
        17
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://parks.wa.gov/about/news-center/field-guide-blog/steptoe-butte-state-park-heritage-site-history",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The Cashup Hotel once crowned Steptoe Butte’s summit from 1888 to 1908, adding a human layer to the ancient landscape.",
      "sourceSentenceIds": [
        2,
        8
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://explorewashingtonstate.com/state-parks/steptoe-butte-state-park-heritage-site/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Interpretive panels explain how Ice Age floods deposited loess that now feeds the world‑renowned Palouse farms.",
      "sourceSentenceIds": [
        23
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://parks.wa.gov/about/news-center/field-guide-blog/steptoe-butte-state-park-heritage-site-history",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Steptoe Butte State Park is a National Natural Landmark, showcasing over 400‑million‑year‑old formations older than the Columbia River basalts.",
      "sourceSentenceIds": [
        6
      ],
