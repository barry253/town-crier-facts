  "facts": [
    {
      "id": 1,
      "text": "Rush Center was originally called Walnut City and was laid out in 1871 before becoming the county seat.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Rush_Center%2C_Kansas",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town became the first county seat of Rush County when the county was organized in the early pioneer days.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://rushcounty.org/history_rushcenter.html",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "In 1886 the Atchison, Topeka & Santa Fe Railroad arrived, bringing prosperity and a Harvey House hotel with 50 rooms.",
      "sourceSentenceIds": [
        9,
        10
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://legendsofkansas.com/rush-center-kansas/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The Harvey House also featured a passenger depot for the city bus line and a wrap‑around porch.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://legendsofkansas.com/rush-center-kansas/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Rush Center’s name honors Captain Alexander Rush, a 2nd Kansas Colored Infantry officer killed at Jenkins’ Ferry during the Civil War.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://legendsofkansas.com/rush-center-kansas/",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The fertile Walnut Valley bottomlands promised bountiful crops, inspiring early residents to make Rush Center a regional trade hub.",
      "sourceSentenceIds": [
        30
