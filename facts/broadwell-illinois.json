      ],
      "source": "https://www.theroute-66.com/broadwell.html",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The village once hosted the well‑known “Pig Hip” Restaurant, operated by Ernest “Ernie” Edwards from 1937 to 1991.",
      "sourceSentenceIds": [
        28,
