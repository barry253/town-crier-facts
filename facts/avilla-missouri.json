  "facts": [
    {
      "id": 1,
      "text": "Avilla was founded in 1856 and officially platted on July 23, 1858 by Andrew L. Love and David S. Holman.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Avilla%2C_Missouri",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town’s name comes from Avilla, Indiana, chosen by settlers who liked the Spanish word “villa” meaning village.",
      "sourceSentenceIds": [
        15
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.theroute-66.com/avilla.html",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Avilla’s first school was a one‑room log cabin called White Oak School built in the 1840s, about 1.5 miles southeast of town.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Avilla%2C_Missouri",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "A 1915 building that once housed the town’s bank now serves as the historic Avilla Post Office.",
      "sourceSentenceIds": [
        29
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.theroute-66.com/avilla.html",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "During the Civil War, Union supporters in Avilla organized a local company to defend homes against bushwhackers.",
      "sourceSentenceIds": [
        20
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Avilla%2C_Missouri",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The Bank of Avilla earned a spot on the National Register of Historic Places in 2022, preserving its early 20th‑century architecture.",
