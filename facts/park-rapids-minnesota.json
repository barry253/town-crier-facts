  "facts": [
    {
      "id": 1,
      "text": "Park Rapids was founded in 1890 beside the Fish Hook River rapids, where prairie meets pine forest, becoming a key supply depot for farmers and lumber.",
      "sourceSentenceIds": [
        2,
        22
      ],
      "sourceLabels": [
