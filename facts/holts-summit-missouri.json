  "facts": [
    {
      "id": 1,
      "text": "Holts Summit earned its name because it sits at the highest point between the town and the Missouri River.",
      "sourceSentenceIds": [
        5,
        9
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 2"
      ],
      "source": "https://en.wikipedia.org/wiki/Holts_Summit%2C_Missouri",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town’s first train depot, Hibernia Station, once stood across from the current North School on Summit Drive.",
      "sourceSentenceIds": [
        17,
        18
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Holts_Summit%2C_Missouri",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "In 1870, Timothy Holt plotted Holts Summit around a general store his father James had built, laying out the town’s core.",
      "sourceSentenceIds": [
        25,
        8
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Holts_Summit%2C_Missouri",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Holts Summit’s first city park, Hibernia Station Park, opened recently, honoring the historic depot that once served the town.",
      "sourceSentenceIds": [
        2,
        17
      ],
      "sourceLabels": [
        "Web source 1",
        "Wikipedia"
      ],
      "source": "https://holtssummit.gov/history",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Summit Lake Winery, founded in 2002, links Holts Summit to the Missouri Rhineland, a stretch of vineyards along the river.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Holts_Summit%2C_Missouri",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Abner Holt, the town’s founder, arrived from Virginia in 1819 and settled in Callaway County, where his family built the first house in the area.",
