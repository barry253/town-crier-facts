  "facts": [
    {
      "id": 1,
      "text": "Historic Strawberry Mansion was built in 1789 by abolitionist Judge William Lewis as a summer home along the Schuylkill River.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.wikidelphia.org/Historic_Strawberry_Mansion"
    },
    {
      "id": 2,
      "text": "In 1930 a group of public‑spirited women restored the mansion, and it opened to the public as a house museum the next year.",
      "sourceSentenceIds": [
        11
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.wikidelphia.org/Historic_Strawberry_Mansion"
    },
    {
      "id": 3,
      "text": "The mansion is the largest of Philadelphia’s Fairmount Park historic houses, drawing visitors to its 18th‑ and 19th‑century antiques.",
      "sourceSentenceIds": [
        2,
        10
      ],
      "sourceLabels": [
        "Web source 2",
        "Web source 1"
      ],
      "source": "https://www.wikidelphia.org/Historic_Strawberry_Mansion"
    },
    {
      "id": 4,
      "text": "Strawberry Mansion High School opened its doors in 1965, serving the local community for more than five decades.",
      "sourceSentenceIds": [
        14
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Strawberry_Mansion_High_School"
    },
    {
      "id": 5,
      "text": "After a 50‑year break, the high school’s varsity football team began practicing again in August 2015, winning its first game that season.",
      "sourceSentenceIds": [
        21,
        22
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Strawberry_Mansion_High_School"
    },
