  "facts": [
    {
      "id": 1,
      "text": "Indian Springs State Park, named in 1927, holds the title of Georgia’s oldest state park.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://gastateparks.org/IndianSprings/History"
    },
    {
      "id": 2,
      "text": "For centuries, Creek Indians collected the spring’s mineral water for its healing qualities.",
      "sourceSentenceIds": [
        24
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://gadnr.org/IndianSprings"
    },
    {
      "id": 3,
      "text": "In the 1800s, Indian Springs blossomed into a bustling resort town, drawing visitors to its mineral waters.",
      "sourceSentenceIds": [
        24
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://gadnr.org/IndianSprings"
    },
    {
      "id": 4,
      "text": "A small museum, open seasonally, showcases Creek Indians, the resort era, and the Civilian Conservation Corps’ legacy.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://gadnr.org/IndianSprings"
    },
    {
      "id": 5,
      "text": "The stone Spring House, built by the CCC during the Great Depression, still lets guests sample the spring’s flowing water.",
      "sourceSentenceIds": [
        25
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://gadnr.org/IndianSprings"
    },
    {
      "id": 6,
      "text": "Idlewilde and the Indian Springs Hotel, both on the National Register of Historic Places, echo the town’s historic charm.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://gastateparks.org/IndianSprings/History"
    }
  ]
