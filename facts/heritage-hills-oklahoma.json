  "facts": [
    {
      "id": 1,
      "text": "Heritage Hills is Oklahoma City's first historic preservation district, established after neighborhood associations formed a commission to oppose a widening plan.",
      "sourceSentenceIds": [
        17,
        20
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
