  "facts": [
    {
      "id": 1,
      "text": "Shamokin’s name comes from the Saponi word “Schahamokink,” meaning “place of eels,” reflecting its Native American roots.",
      "sourceSentenceIds": [
        3,
        27
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Shamokin%2C_Pennsylvania"
    },
    {
      "id": 2,
      "text": "Founded in 1835 by coal speculators, Shamokin grew into a 19th‑century industrial hub with coal mines, silk mills, and ironworks.",
      "sourceSentenceIds": [
        4,
        9
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Shamokin%2C_Pennsylvania"
    },
    {
      "id": 3,
      "text": "The 1877 Shamokin uprising was part of the Great Railroad Strike, when miners and railroad workers protested wage cuts by the B&O Railroad.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Shamokin%2C_Pennsylvania"
    },
    {
      "id": 4,
      "text": "The Victoria Theatre, a historic downtown venue, earned a spot on the National Register of Historic Places.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Shamokin%2C_Pennsylvania"
    },
    {
      "id": 5,
      "text": "Every spring, the Northumberland County Council for the Arts & Humanities hosts the Anthracite Heritage Festival of the Arts, featuring train rides and local crafts.",
      "sourceSentenceIds": [
        18
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.visitcentralpa.org/plan-your-trip-today/towns-and-countrysides/shamokin/"
    },
    {
      "id": 6,
      "text": "In 1883, the Shamokin power generating station on Independence Street began operation, marking the town’s early adoption of electric power.",
