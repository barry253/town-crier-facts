  "facts": [
    {
      "id": 1,
      "text": "Amboy first appeared as a 1858 mining camp, then grew into a railroad town when it was officially founded in 1883.",
      "sourceSentenceIds": [
        1,
        11
      ],
      "sourceLabels": [
        "Web source 2",
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/Amboy,_California"
    },
    {
      "id": 2,
      "text": "Engineer Lewis Kingman named Amboy after New Jersey's town, making it the first alphabetical station west of Needles on the Atlantic‑Pacific line.",
      "sourceSentenceIds": [
        2,
        5
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 2"
      ],
      "source": "https://en.wikipedia.org/wiki/Amboy%2C_California"
    },
    {
      "id": 3,
      "text": "Roy's Motel and Café, opened in 1938, remains a Route 66 landmark offering gas, souvenirs, and prepackaged food to passing motorists.",
      "sourceSentenceIds": [
        9,
        12
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Amboy%2C_California"
    },
    {
      "id": 4,
      "text": "After Route 66 was designated in 1926, Amboy boomed as a stop for motorists, spawning garages, service stations, and motor courts.",
      "sourceSentenceIds": [
        14,
        26
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/Amboy,_California"
    },
    {
      "id": 5,
      "text": "When Interstate 40 bypassed Route 66 in 1972, traffic left Amboy, triggering the closure of most local businesses.",
      "sourceSentenceIds": [
        17
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/Amboy,_California"
    },
    {
      "id": 6,
      "text": "Amboy lies beside the dramatic Amboy Crater and the Bullion Mountains, offering striking desert scenery for travelers.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
