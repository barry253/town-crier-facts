  "facts": [
    {
      "id": 1,
      "text": "Williamsfield was named after General Joseph Williams, one of the first owners of the land that became the town.",
      "sourceSentenceIds": [
        1,
        3
      ],
      "sourceLabels": [
        "Web source 1",
        "Wikipedia"
      ],
      "source": "https://kids.kiddle.co/Williamsfield,_Ohio",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "In 1799, Joseph Williams bought roughly three‑fifths of the eastern half of the township from the Connecticut Land Company.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://conneautohio.us/Ashtaco_ConneautHistory_1924_hist/Ashtaco_ConneautHistory_xxxix.htm",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The town boasted two railroad stations on separate lines, serving travelers on both sides of Williamsfield.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://conneautohio.us/Ashtaco_ConneautHistory_1924_hist/Ashtaco_ConneautHistory_xxxix.htm",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "When Williamsfield became an independent township, its first officers included trustees Gilbert Palmer, Samuel Tuttle, and Samuel Morse.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://conneautohio.us/Ashtaco_ConneautHistory_1924_hist/Ashtaco_ConneautHistory_xxxix.htm",
      "category": "people",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Before the township formed, Jonathan Tuttle served as justice of the peace, later succeeded by Samuel Morse.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://conneautohio.us/Ashtaco_ConneautHistory_1924_hist/Ashtaco_ConneautHistory_xxxix.htm",
      "category": "people",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Williamsfield sits where U.S. Route 322 meets State Route 7, a crossroads that defines its layout.",
      "sourceSentenceIds": [
        17,
        18
