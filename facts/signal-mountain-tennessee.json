  "facts": [
    {
      "id": 1,
      "text": "Signal Mountain takes its name from Signal Point, a promontory used by Native Americans and Union troops to send fire and smoke signals.",
      "sourceSentenceIds": [
        7,
        14,
        24
      ],
      "sourceLabels": [
        "Web source 1",
        "Web source 1",
        "Wikipedia"
      ],
      "source": "https://signalmountaintn.gov/visitors/about_signal_mountain/history.php"
    },
    {
      "id": 2,
      "text": "During the Civil War, Signal Point served as a relay station linking Chattanooga to Bridgeport, Alabama, and then to the North via telegraph.",
      "sourceSentenceIds": [
        15
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.nps.gov/chch/learn/historyculture/signal-point.htm"
    },
    {
      "id": 3,
      "text": "In 1913, a 12‑mile streetcar line connected Chattanooga to Signal Mountain, turning the mountain into a commuter suburb before cars.",
      "sourceSentenceIds": [
        29
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Signal_Mountain%2C_Tennessee"
    },
    {
      "id": 4,
      "text": "The Tennessee Legislature chartered the Town of Signal Mountain on April 4, 1919, formalizing its municipal status.",
      "sourceSentenceIds": [
        30
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Signal_Mountain%2C_Tennessee"
    },
    {
      "id": 5,
      "text": "Signal Mountain overlooks the Tennessee River Valley from 1,000 feet above, offering sweeping views of Chattanooga below.",
      "sourceSentenceIds": [
        21
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Signal_Mountain%2C_Tennessee"
    },
    {
      "id": 6,
      "text": "Situated on Walden Ridge, the southern end of the Cumberland Plateau, Signal Mountain borders Chattanooga to the south.",
