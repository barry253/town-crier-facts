  "facts": [
    {
      "id": 2,
      "text": "The ancient Paa-ko Pueblo, a large Classic Ancestral site, sits just west of San Pedro Creek and was first occupied around AD 1200.",
      "sourceSentenceIds": [
        21
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://galisteo.nmarchaeology.org/sites/paa-ko.html",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Paa-ko was abandoned in the latter half of the 1600s due to warfare and Athapaskan attacks.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://galisteo.nmarchaeology.org/sites/paa-ko.html",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The pueblo ruins contain several hundred rooms, with circular and square kivas, and a historic plaza dating to the 1600s.",
      "sourceSentenceIds": [
        7,
        8,
        23
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://galisteo.nmarchaeology.org/sites/paa-ko.html",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Paa-Ko lies on the west side of the San Pedro Creek valley, a north‑flowing tributary of the Rio Grande.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Paa-Ko%2C_New_Mexico",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The San Pedro Grant, a historic land allotment, encompasses the Paa-Ko site and its surrounding basin.",
      "sourceSentenceIds": [
        19
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://galisteo.nmarchaeology.org/sites/paa-ko.html"
    }
