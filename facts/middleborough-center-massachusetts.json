    {
      "id": 1,
      "text": "The historic Oliver Estate, built in the 1700s by Judge Peter Oliver, hosts a colonial reenactment that lets visitors step back into 18th‑century life.",
      "sourceSentenceIds": [
        15,
        13
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.discovermiddleborough.com/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "During the reenactment, actors demonstrate colonial military drills, musket firing, and hands‑on spinning, weaving, and cooking, while children play colonial‑themed games.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.discovermiddleborough.com/",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Middleborough was first settled by Europeans in 1661, originally called Nemasket before adopting the name Middleborough in 1669.",
      "sourceSentenceIds": [
        6,
        2
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.middleboroughma.gov/304/History",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The Oliver Estate’s deep ties to the American Revolution make it a perfect backdrop for living‑history events that highlight the town’s patriotic past.",
      "sourceSentenceIds": [
