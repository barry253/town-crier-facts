  "facts": [
    {
      "id": 1,
      "text": "Mimico takes its name from the extinct passenger pigeon, once flocks that roamed the area.",
      "sourceSentenceIds": [
        5,
        13,
        17
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Mimico"
    },
    {
      "id": 2,
      "text": "The first Mimico railway station opened in 1855 beside Christ Church, turning the town into an early rail hub.",
      "sourceSentenceIds": [
        26
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Mimico"
    },
    {
      "id": 3,
      "text": "Just three years later, a post office opened south of the station on Church Street, anchoring Mimico’s growing community.",
      "sourceSentenceIds": [
        27
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Mimico"
    },
    {
      "id": 4,
      "text": "Mimico became the smallest community to receive a Carnegie Library, a rare honor for such a modest town.",
      "sourceSentenceIds": [
        29
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Mimico"
    },
    {
      "id": 5,
      "text": "The Conservation Authority established Humber Bay Park and Mimico Linear Park, two wetlands that now shelter diverse bird species.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://mimicoresidents.ca/about-mimico/"
    },
    {
      "id": 6,
      "text": "Mimico Beach’s post office, set up in 1858, served the lakeshore community and highlighted the town’s early beach culture.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Mimico"
    }
  ]
