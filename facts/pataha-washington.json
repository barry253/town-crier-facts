      "id": 1,
      "text": "Pataha’s historic Houser Mill, built in 1879, still operates as a working water‑powered flour mill.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Pataha%2C_Washington",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The mill remains one of the last fully intact water‑powered mills, complete with original pulleys and machinery.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://patahaflourmills.com/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Visitors can enjoy lunch and guided tours of the mill every Thursday and Friday from 11 AM to 2 PM.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://patahaflourmills.com/",
      "category": "other",
      "quality": "poor",
      "qualityReason": "editorial_filler"
    },
    {
      "id": 4,
      "text": "A historic retreat house, once the millwright’s residence, is currently being refurbished to restore its original charm.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
