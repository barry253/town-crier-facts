  "facts": [
    {
      "id": 1,
      "text": "Wilmot got its name from the railroad surveyor who laid out the town, and the Bartholomew post office moved there on April 7, 1892.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/wilmot_arkansas",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "After Arkansas joined the Union in 1836, pioneer families like the Wilhites, Eatmans, Whites, and Gaines settled west of Bayou Bartholomew, forming Wilmot's early community.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/wilmot_arkansas",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Wilmot's fertile alluvial soils supported cotton, corn, and cypress, with steamboats ferrying produce from Lake Enterprise and Bayou Bartholomew to distant markets.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/wilmot_arkansas",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Lake Enterprise borders Wilmot, offering locals a popular spot for fishing and watersports amid the surrounding delta wetlands.",
      "sourceSentenceIds": [
        14
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Wilmot%2C_Arkansas",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Today, Wilmot's economy centers on farming, forestry, fishing, and hunting, employing about 101 people and reflecting a median household income of $27,500.",
      "sourceSentenceIds": [
        23
      ],
      "sourceLabels": [
        "Web source 1"
      ],
