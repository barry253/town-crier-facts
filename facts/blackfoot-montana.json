  "facts": [
    {
      "id": 1,
      "text": "Blackfoot grew from a 1889 general store into a Great Northern Railway division point in 1893, sparking its rapid development.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.mtmemory.org/nodes/view/127509",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town began as a placer gold‑mining camp on Ophir Creek in 1865, drawing prospectors to the rugged Montana landscape.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.mtmemory.org/nodes/view/127510",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Named after the nearby Blackfoot River, Blackfoot’s first year boasted seven mercantiles, two doctors, two blacksmiths, a carpenter‑coffin maker, a Chinese laundry, and several whiskey dealers.",
      "sourceSentenceIds": [
        11
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.mtmemory.org/nodes/view/127510",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Ranchers shipped tens of thousands of cattle from Blackfoot’s corrals to Chicago stockyards, turning the town into a key livestock hub.",
      "sourceSentenceIds": [
        13
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.mtmemory.org/nodes/view/127509",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Today only a handful of log cabins remain, echoing the once‑famous boomtown that sprang up during Montana’s gold rush.",
      "sourceSentenceIds": [
        21
      ],
      "sourceLabels": [
        "Web source 2"
      ],
