  "facts": [
    {
      "id": 1,
      "text": "Okolona’s name evolved from Lone Oak after a nearby town claimed that name for its post office, a change noted in the late 19th century.",
      "sourceSentenceIds": [
        20,
        21
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Okolona%2C_Louisville%2C_Kentucky",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The Mobile and Ohio Railroad’s arrival in 1848 turned Okolona into a commercial hub, with the railroad quickly becoming the town’s driving factor.",
      "sourceSentenceIds": [
        3,
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://okolonachambermainstreet.org/content.aspx?page_id=22&club_id=16050&module_id=749527",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Despite being 10 miles from the Ohio River, Okolona sits at the same elevation as downtown Louisville, making it one of the city’s most flood‑prone areas.",
      "sourceSentenceIds": [
        23
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Okolona%2C_Louisville%2C_Kentucky",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "In 2003, when Jefferson County merged with Louisville, Okolona residents automatically became citizens of Louisville Metro.",
      "sourceSentenceIds": [
        17
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Okolona%2C_Louisville%2C_Kentucky",
      "category": "other",
      "quality": "poor",
      "qualityReason": "vague"
    },
    {
      "id": 5,
      "text": "The Okolona Historic District showcases a collection of 19th‑ and early 20th‑century buildings, especially its historic churches and public structures.",
