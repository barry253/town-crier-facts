  "facts": [
    {
      "id": 1,
      "text": "Okolona’s name evolved from Lone Oak after a nearby town claimed that name for its post office, a change noted in the late 19th century.",
      "sourceSentenceIds": [
        20,
        21
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
