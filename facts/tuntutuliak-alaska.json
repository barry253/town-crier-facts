  "facts": [
    {
      "id": 1,
      "text": "Tuntutuliak means \"the land of many caribou\" in Yup'ik, reflecting the area's wildlife heritage.",
      "sourceSentenceIds": [
        13
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Tuntutuliak%2C_Alaska",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Yup'ik is the first language spoken by children in Tuntutuliak, while English is taught later at Lewis Angapak Memorial School.",
      "sourceSentenceIds": [
        10,
        12
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Tuntutuliak%2C_Alaska",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "A state-owned gravel runway and a public seaplane base on the Qinaq River connect Tuntutuliak to the outside world.",
      "sourceSentenceIds": [
        18
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://akenergygateway.alaska.edu/explore/communities/tuntutuliak",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Goods arrive by barge roughly six times a year, making river transport a vital supply line for the community.",
      "sourceSentenceIds": [
        19
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://akenergygateway.alaska.edu/explore/communities/tuntutuliak",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "During winter, marked trails link Tuntutuliak to Kipnuk, Toundra, and Kongiganak, covering 77, 60, and 29 miles respectively.",
      "sourceSentenceIds": [
        21
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://akenergygateway.alaska.edu/explore/communities/tuntutuliak",
      "category": "other",
      "quality": "poor",
      "qualityReason": "editorial_filler"
    },
    {
      "id": 6,
      "text": "The original settlement, Qinaq, now leaves only graves and a bear home called Avcuamciq, split by the river.",
      "sourceSentenceIds": [
        14
      ],
      "sourceLabels": [
