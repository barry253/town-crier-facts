  "facts": [
    {
      "id": 1,
      "text": "Skyline began in 1934 as a cooperative farming experiment called Cumberland Farms, part of President Franklin Roosevelt's New Deal resettlement effort.",
      "sourceSentenceIds": [
        18,
        7
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Skyline%2C_Alabama",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "In 1935 the project was renamed Skyline Farms to distinguish it from a similarly named Tennessee project after FERA became the Resettlement Administration.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/skyline_alabama",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The Skyline Commissary, a sandstone building erected in 1935, served as the colony’s central store and social hub.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/skyline_alabama",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The Skyline Farms Band performed traditional music and dance for President Franklin D. Roosevelt, the first ensemble to do so at the White House.",
      "sourceSentenceIds": [
        8,
        15
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/skyline_alabama",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The original colony school, now listed on the Alabama Register of Historic Places, remains a tangible remnant of the New Deal experiment.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/skyline_alabama",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Today the Skyline Farms Heritage Association operates a museum that houses 1930s artifacts and offers guided tours of the cooperative history.",
      "sourceSentenceIds": [
        11
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/skyline_alabama",
      "category": "culture",
      "quality": "good"
    }
