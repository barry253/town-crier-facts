  "facts": [
    {
      "id": 1,
      "text": "Lamkin was named for George Lamkin, who donated the land that became the townsite.",
      "sourceSentenceIds": [
        4,
        5
      ],
      "sourceLabels": [
        "Web source 2",
        "Web source 1"
      ],
      "source": "https://atlas.thc.texas.gov/Details/5093003020"
    },
    {
      "id": 2,
      "text": "The original settlement sat on the Leon River until a 1908 flood forced it to relocate one‑half mile north to its current spot.",
      "sourceSentenceIds": [
        22,
        23
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.tshaonline.org/handbook/entries/lamkin-tx"
    },
    {
      "id": 3,
      "text": "Two years after the town was founded, the Cotton Belt Railroad arrived, turning Lamkin into a regional shipping hub for farmers and ranchers.",
      "sourceSentenceIds": [
        15
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://atlas.thc.texas.gov/Details/5093003020"
    },
    {
      "id": 4,
      "text": "A devastating fire in 1922 destroyed most of Lamkin’s businesses, and the town never fully recovered afterward.",
      "sourceSentenceIds": [
        26
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.tshaonline.org/handbook/entries/lamkin-tx"
    },
    {
      "id": 5,
      "text": "A Texas Historical Commission marker, erected in 1967, commemorates Lamkin’s founding and early history on the south city limits along SH 36.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://atlas.thc.texas.gov/Details/5093003020"
    },
    {
      "id": 6,
      "text": "The Leon River, part of the Brazos watershed, forms Lamkin’s eastern boundary and has shaped its geography since the 19th century.",
      "sourceSentenceIds": [
        19
