      "id": 1,
      "text": "Dawson Creek takes its name from the creek surveyed by George Mercer Dawson in August 1879, who had the watercourse labeled with his name.",
      "sourceSentenceIds": [
        3,
        4
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
