  "facts": [
    {
      "id": 1,
      "text": "Crystal Downs Country Club sits on a narrow strip of sandy, rolling land between Lake Michigan and Crystal Lake, offering expansive lake views and constant winds.",
      "sourceSentenceIds": [
        13
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.crystaldowns.org/Default.aspx?p=DynamicModule&pageid=14&ssid=100037&vnf=1",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The club’s name was given by Benjamin Merrick, a Grand Rapids lawyer who first visited the site in 1926 and was inspired by the English‑style downs he saw from the hilltop.",
      "sourceSentenceIds": [
        15,
        16,
        17
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.crystaldowns.org/Default.aspx?p=DynamicModule&pageid=14&ssid=100037&vnf=1",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Alister MacKenzie and Perry Maxwell designed the eighteen‑hole layout in about ten days, creating a course that remains essentially unchanged today.",
      "sourceSentenceIds": [
        24,
        29,
        30
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.crystaldowns.org/Default.aspx?p=DynamicModule&pageid=14&ssid=100037&vnf=1",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The course was originally a nine‑hole layout that opened in mid‑1927 before MacKenzie expanded it to the full eighteen holes.",
      "sourceSentenceIds": [
        17,
        18
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.crystaldowns.org/Default.aspx?p=DynamicModule&pageid=14&ssid=100037&vnf=1",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Crystal Downs is located within Lake Township on the shores of Lake Michigan, just east of the Sleeping Bear Dunes National Lakeshore.",
      "sourceSentenceIds": [
        8,
        10
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Crystal_Downs_Country_Club%2C_Michigan",
      "category": "other",
      "quality": "poor",
      "qualityReason": "location_description"
    },
    {
      "id": 6,
      "text": "The club’s design features rounded bunkers and wildly rolling fairways, echoing Maxwell’s work at Southern Hills and distinguishing it from Cypress Point.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 2"
      ],
