    {
      "id": 1,
      "text": "Founded in 1903 as a logging community, Frederic grew over seventy years into a retail and service hub for the region.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.fredericwi.com/resident"
    },
    {
      "id": 2,
      "text": "Frederic is characterized by a landscape of farms, forests, open land, and many lakes.",
      "sourceSentenceIds": [
        22
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.fredericwi.com/resident"
    },
    {
      "id": 3,
      "text": "The village of Frederic features over forty acres of public parklands and a twenty-acre public lake with docks for use.",
      "sourceSentenceIds": [
        23
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.fredericwi.com/resident"
    },
    {
      "id": 4,
      "text": "Frederic converted its old theater building into a six-thousand-square-foot public library, the second largest in the county.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.fredericwi.com/resident"
    },
    {
      "id": 5,
      "text": "The community dedicated the renovated original Soo Line depot as the Frederic area museum in the year 2000.",
      "sourceSentenceIds": [
        26
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.fredericwi.com/resident"
    },
    {
