    },
    {
      "id": 3,
      "text": "Hartford sits at the northeastern tip of the Great Smoky Mountains, surrounded by Snowbird Mountain to the east and Mount Cammerer to the south.",
      "sourceSentenceIds": [
        22
      ],
      "sourceLabels": [
        "Wikipedia"
