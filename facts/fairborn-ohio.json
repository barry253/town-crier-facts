      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "In the early 1920s, about 200 historic houses from Osborn were relocated by mules and tractors into Fairborn’s Historic Osborn District.",
      "sourceSentenceIds": [
        6,
        19
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
