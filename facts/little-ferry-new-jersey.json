  "facts": [
    {
      "id": 1,
      "text": "Little Ferry was named after the rope‑drawn ferry that crossed the Hackensack River between 1659 and 1826.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.littleferrynj.org/content/117/default.aspx",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The borough’s first train station, built in 1875 by the New York and Long Branch Railroad, earned a spot on the National Register of Historic Places in 1984.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Little_Silver%2C_New_Jersey",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Early Little Ferry was a lively mix of resort, farm, and fishing town before evolving into a residential community.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Little_Silver%2C_New_Jersey",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "When NJ Transit trains stop at the historic station, they block one of two grade crossings, often causing brief traffic backups.",
      "sourceSentenceIds": [
        11
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Little_Silver%2C_New_Jersey",
      "category": "other",
      "quality": "poor",
      "qualityReason": "editorial_filler"
    },
    {
      "id": 5,
      "text": "The original Parker Homestead, dating to 1725, is one of New Jersey’s oldest houses and is now undergoing renovation by the borough.",
      "sourceSentenceIds": [
        18
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Little_Silver%2C_New_Jersey",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Today Little Ferry’s streets are lined with a variety of housing styles, from ranches to capes, reflecting its transition from farms and nurseries to a primarily residential area.",
      "sourceSentenceIds": [
        26
      ],
      "sourceLabels": [
