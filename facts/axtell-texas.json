      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Axtell sits in a humid subtropical zone, with hot, humid summers and mild winters that swing wide in temperature.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 2"
      ],
