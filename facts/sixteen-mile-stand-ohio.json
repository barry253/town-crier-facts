  "facts": [
    {
      "id": 1,
      "text": "Sixteen Mile Stand earned its name by sitting exactly sixteen miles from Cincinnati on the historic Montgomery Pike, once a busy stagecoach route.",
      "sourceSentenceIds": [
        5,
        22,
        11
      ],
      "sourceLabels": [
        "Web source 1",
        "Wikipedia"
      ],
      "source": "https://grokipedia.com/page/sixteen_mile_stand_ohio",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Associate Reformed Presbyterians settled the area in 1795, building the Sycamore United Presbyterian Church in 1848, which still stands today.",
      "sourceSentenceIds": [
        1,
        4
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/sixteen_mile_stand_ohio",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The Little Miami Railroad reached Sixteen Mile Stand in 1842, diverting stagecoach traffic and slowly sparking modest agricultural trade.",
      "sourceSentenceIds": [
        7,
        8
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/sixteen_mile_stand_ohio",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "A tollgate at the stand charged two cents per mile for horse rigs and one cent for pedestrians until 1907 when Hamilton County made the road free.",
      "sourceSentenceIds": [
        23
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/sixteen_mile_stand_ohio",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "In 1885, the Sixteen Mile Stand Horse Rangers formed to curb horse theft, supplementing township constables in the rural community.",
      "sourceSentenceIds": [
        24
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/sixteen_mile_stand_ohio",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The hamlet emerged from Judge John Cleves Symmes’s 1788 land grant, part of a 300,000‑acre Northwest Ordinance purchase that drew Revolutionary veterans to the area.",
