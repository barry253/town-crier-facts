  "facts": [
    {
      "id": 1,
      "text": "Carrollton’s real‑estate boom in the 1850s was sparked by the Jefferson and Lake Pontchartrain Railroad, which linked the town to New Orleans and the lake.",
      "sourceSentenceIds": [
        13,
        14
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://crna-nola.org/about/",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The 1855 Greek Revival Carrollton Parish Courthouse still stands, a rare surviving example of mid‑19th‑century civic architecture in the area.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://crna-nola.org/about/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The riverfront section of Carrollton, known as the Black Pearl, produced gospel legend Mahalia Jackson, the “Queen of Gospel music.”.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Carrollton%2C_New_Orleans",
      "category": "people",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "In 1988 the Carrollton Historic District was added to the National Register of Historic Places, preserving its unique 19th‑century streetscape.",
      "sourceSentenceIds": [
        19
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://prcno.org/help-for-homeowners/historic-districts-neighborhoods/carrollton/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The Nix Branch Library, operated by the New Orleans Public Library, has been a community hub since its opening and was praised by local journalist Robert Morris as a “popular little” library.",
      "sourceSentenceIds": [
        20,
        21
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Carrollton%2C_New_Orleans",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Carrollton was incorporated in 1845, then annexed by New Orleans in 1874, becoming the city’s 16th and 17th wards while keeping a distinct neighborhood feel.",
      "sourceSentenceIds": [
        8,
