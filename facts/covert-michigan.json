  "facts": [
    {
      "id": 1,
      "text": "Covert Township was originally part of Lafayette and became its own township in 1837.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Covert_Township%2C_Michigan",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The township’s name changed to Covert in 1877, honoring a local family.",
      "sourceSentenceIds": [
        17
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Covert_Township%2C_Michigan",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Covert was a rare example of racial integration from the 1860s, electing Black officials starting in 1868.",
      "sourceSentenceIds": [
        18,
        19
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Covert_Township%2C_Michigan",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The Covert Historical Museum, founded in 1976 by Pearl Sarno, occupies a former post‑Civil War general store.",
      "sourceSentenceIds": [
        1,
        2
      ],
      "sourceLabels": [
        "Web source 1",
        "Web source 2"
      ],
      "source": "https://coverttwp.com/historical-society/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The museum’s mission is to preserve artifacts and share stories that highlight Covert’s unique history for future generations.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://coverttwp.com/historical-society/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Visitors learn about indigenous culture and early racial integration through exhibits that span from native artifacts to Civil War veterans.",
      "sourceSentenceIds": [
        28
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://coverttwp.com/historical-society/",
