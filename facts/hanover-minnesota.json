  "facts": [
    {
      "id": 1,
      "text": "Hanover was laid out in 1877 and named after Hanover, Germany, the native land of some early settlers.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Hanover%2C_Minnesota"
    },
    {
      "id": 2,
      "text": "The 1885 Hanover Bridge, an iron Pratt through truss, is listed on the National Register of Historic Places.",
      "sourceSentenceIds": [
        4,
        6
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 2"
      ],
      "source": "https://en.wikipedia.org/wiki/Hanover%2C_Minnesota"
    },
    {
      "id": 3,
      "text": "The bridge now serves as a pedestrian walkway and backdrop for Hanover’s annual Caroling at the Historic Bridge event and a 5K run.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.hanoverhistoricalsociety.org/history"
    },
    {
      "id": 4,
      "text": "Bob Dylan once owned a ranch near Hanover in Hennepin County, linking the town to the legendary musician.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Hanover%2C_Minnesota"
    },
    {
      "id": 5,
      "text": "Hanover sits along the Crow River, a defining geographic feature that shaped its early settlement and development.",
      "sourceSentenceIds": [
        15
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Hanover%2C_Minnesota"
    },
    {
      "id": 6,
      "text": "Though partly in Hennepin County, Hanover is not governed by the Twin Cities Metropolitan Council.",
