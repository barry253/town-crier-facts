  "facts": [
    {
      "id": 1,
      "text": "Barnesville was chartered in 1811 and named after its earliest settler, Williams Barnes.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Barnesville%2C_Maryland"
    },
    {
      "id": 2,
      "text": "Barnesville lies on land first surveyed for Jeremiah Hays in 1749, placing it at the heart of the Agricultural Reserve.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.barnesvillemd.org/history"
    },
    {
      "id": 3,
      "text": "The town’s character endures thanks to the Agricultural Reserve’s restrictive zoning and Barnesville’s own zoning authority.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.barnesvillemd.org/history"
    },
    {
      "id": 4,
      "text": "Barnesville officially incorporated in 1888, solidifying its status as a small‑town community.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Barnesville%2C_Maryland"
    },
    {
      "id": 5,
      "text": "Barnesville Baptist Church, founded in 1871, still meets in its original frame building on the town’s east side.",
      "sourceSentenceIds": [
        14
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Barnesville%2C_Maryland"
    },
    {
      "id": 6,
      "text": "A former gas metering station from Rockville was relocated to Barnesville in 1977, now serving as a historic landmark.",
