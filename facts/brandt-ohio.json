    },
    {
      "id": 2,
      "text": "A toll gate once stood at the east end of Brandt where U.S. 40 and State Route 201 intersect today.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Brandt%2C_Ohio"
    },
    {
      "id": 3,
      "text": "The historic Brandt School, built in 1890, still stands on Third Street in the village.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Brandt%2C_Ohio"
    },
    {
      "id": 4,
      "text": "Brandt sits in southeastern Miami County, within Bethel Township, and is part of the Dayton Metropolitan Statistical Area.",
      "sourceSentenceIds": [
        8,
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Brandt%2C_Ohio"
    },
    {
      "id": 5,
      "text": "Route 40 cuts through Brandt’s center, leading east to Springfield and west to Vandalia.",
