  "facts": [
    {
      "id": 1,
      "text": "Sonyea was once a Shaker settlement founded in 1836 on a 1,700‑acre farm.",
      "sourceSentenceIds": [
        26
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Groveland%2C_New_York",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The Shakers sold the property in 1892, and it became the Craig Colony for Epileptics in 1896, now part of the Groveland Correctional Facility.",
      "sourceSentenceIds": [
        27,
        28
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Groveland%2C_New_York",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The colony was named after Oscar Craig, former president of the NY State Board of Charities.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.livingstoncountyny.gov/1703/Craig-Colony",
      "category": "people",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "In 1963, the Main Line over Dansville Hill from Groveland to Wayland was abandoned, ending a key rail link that once served Sonyea.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Groveland%2C_New_York",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The town of Groveland, where Sonyea lies, was formed in 1789 as part of Ontario County before becoming part of Livingston County in 1821.",
      "sourceSentenceIds": [
        24
      ],
