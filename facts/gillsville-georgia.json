  "facts": [
    {
      "id": 1,
      "text": "Gillsville was named after the local Gills family, who were early settlers in the area.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Gillsville%2C_Georgia",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town, originally called Stonethrow, is the oldest settlement in Hall County, first inhabited in 1784.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://gillsvillega.com/history.html",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Gillsville’s folk pottery tradition, centered around the Hewell family, has attracted worldwide attention since the 1880s.",
      "sourceSentenceIds": [
        1,
        19,
        21
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://gillsvillega.com/history.html",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The town was officially chartered in 1901, welcoming 249 residents and hosting 15 businesses across its one square mile.",
      "sourceSentenceIds": [
        24
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://gillsvillega.com/history.html",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "In 1900 a great fire destroyed most of Gillsville, burning four of six stores and the post office.",
      "sourceSentenceIds": [
        13,
        14
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://gillsvillega.com/history.html",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Nestled in the foothills of the Blue Ridge Mountains, Gillsville offers a scenic backdrop for its historic streets.",
