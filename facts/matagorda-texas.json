  "facts": [
    {
      "id": 1,
      "text": "Founded in 1827 by Stephen F. Austin, Matagorda is the third‑oldest Anglo‑American town in Texas.",
      "sourceSentenceIds": [
        1,
        24,
        25
      ],
      "sourceLabels": [
        "Web source 2",
        "Wikipedia"
      ],
      "source": "https://matagordachamber.org/about-the-community",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Matagorda sits where the Colorado River meets the Gulf of Mexico, offering 23 miles of beach accessible by car and an extra 35 miles only by boat.",
      "sourceSentenceIds": [
        20,
        23
      ],
      "sourceLabels": [
        "Web source 2",
        "Wikipedia"
      ],
      "source": "https://matagordachamber.org/about-the-community",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The town once thrived as a port; until 1894 it handled cotton, cattle, and fruit, supported by river transport and factories.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.tshaonline.org/handbook/entries/matagorda-tx",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "In 1901 the Cane Belt Railroad reached Matagorda, linking it to the wider rail network.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.tshaonline.org/handbook/entries/matagorda-tx",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Seasonal events, historic landmarks, and eco‑tourism keep outdoor enthusiasts and families drawn to Matagorda’s resilient charm.",
      "sourceSentenceIds": [
        3,
        19
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://matagordachamber.org/about-the-community",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Matagorda’s name comes from Spanish settlers who noted the dense foliage that grew near the coast.",
