  "facts": [
    {
      "id": 1,
      "text": "The 20th’s hilly terrain kept heavy industry out, so textile and food workshops sprouted instead of big factories.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/20th_arrondissement_of_Paris",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "From rural hamlets in the 19th century, the 20th evolved into a manual‑labor hub that later nurtured Belleville’s street‑art and music scenes.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/20th_arrondissement_of_Paris",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Today the former industrial belt hosts Parc André‑Citroën, the Georges Pompidou European Hospital, and several large office towers.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/15th_arrondissement_of_Paris",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The area that became the 20th was annexed to Paris in 1860, joining the city’s expanding boundaries.",
      "sourceSentenceIds": [
        21
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/15th_arrondissement_of_Paris",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Its early geography favored wine‑making and quarrying, supplying stone for monuments like the École Militaire.",
      "sourceSentenceIds": [
        25
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/15th_arrondissement_of_Paris",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The territory that is now the 20th consisted of independent rural villages and hamlets beyond the medieval walls, mainly farming and viticulture.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/20th_arrondissement_of_Paris",
