  "facts": [
    {
      "id": 1,
      "text": "Milledgeville was Georgia’s fourth capital, serving from 1807 to 1868 while its grid layout reflected early 19th‑century planning.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://legacylorega.org/milledgeville-georgia-a-town-where-history-and-culture-thrive/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Founded in 1803 along the Oconee River, Milledgeville became the state capital in 1804 and hosted the first state legislature after the capital moved from Augusta.",
      "sourceSentenceIds": [
        3,
        4
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Milledgeville%2C_Georgia",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The town’s historic walking tour lets visitors stroll past antebellum homes, wrought‑iron details, and churches that whisper stories of the past.",
      "sourceSentenceIds": [
        1,
        23
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://legacylorega.org/milledgeville-georgia-a-town-where-history-and-culture-thrive/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Oglethorpe University, founded in 1838, is one of Georgia’s earliest chartered colleges and still sits in a historic campus in Milledgeville.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Milledgeville%2C_Georgia",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "During the Civil War, Milledgeville supplied troops and goods to the Confederacy, yet the town endured shortages, inflation, and a regional food riot.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Milledgeville%2C_Georgia",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Lake Sinclair, created in 1953 by the Georgia Power Company, opened a new recreational era and helped revitalize downtown Milledgeville in the 1980s and 1990s.",
      "sourceSentenceIds": [
        14
      ],
