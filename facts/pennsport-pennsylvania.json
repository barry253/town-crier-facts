      "category": "culture",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Pennsport’s historic rowhouses and the former Abigail Vare School are listed on the National Register of Historic Places.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Pennsport%2C_Philadelphia",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The historic synagogue Congregation Shivtei Yeshuron‑Ezras Israel was highlighted in the 2013 Hidden City Philadelphia festival.",
