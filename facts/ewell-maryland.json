  "facts": [
    {
      "id": 1,
      "text": "Ewell sits at the heart of Smith Island, the largest village on the 9.4‑square‑mile marshland community in Somerset County.",
      "sourceSentenceIds": [
        4,
        6
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/ewell_maryland",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The village first appeared in 1657 when English settlers arrived, but permanent families only settled in 1686, founding a community that still thrives today.",
      "sourceSentenceIds": [
        22,
        23
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/ewell_maryland",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Ewell’s only way in or out is by passenger ferry from Crisfield, Maryland, a 12‑mile ride across the Chesapeake Bay that keeps the island isolated.",
      "sourceSentenceIds": [
        4,
        9
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/ewell_maryland",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Sea‑level rise and erosion have cut Smith Island’s habitable land to about 900 acres, threatening Ewell’s future despite ongoing marsh‑restoration projects.",
      "sourceSentenceIds": [
        5,
        18,
        20,
        21
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/ewell_maryland",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Ewell’s economy once buzzed with 19th‑century oystering, as local watermen harvested Chesapeake oysters that fed markets across the bay.",
      "sourceSentenceIds": [
        29
      ],
      "sourceLabels": [
        "Web source 1"
