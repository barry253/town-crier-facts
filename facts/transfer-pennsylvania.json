  "facts": [
    {
      "id": 1,
      "text": "Transfer earned its name from being a break‑of‑gauge point where the 6‑foot Erie Railroad met the 4‑10‑inch Erie & Pittsburgh line, forcing cargo to be moved between cars.",
      "sourceSentenceIds": [
        7,
        10,
        9
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/transfer_pennsylvania",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town’s first post office opened in 1866, a milestone that helped turn scattered farms into a connected community.",
      "sourceSentenceIds": [
        28
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/transfer_pennsylvania",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Transfer’s early settlers cleared land for grain, fruit, and livestock on the fertile Shenango Valley, a boom that began after the 1795 Treaty of Greenville.",
      "sourceSentenceIds": [
        18,
        21
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/transfer_pennsylvania",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "A 1825 Transfer Presbyterian Church still stands, reflecting the Scotch‑Irish, German, and Irish roots of the village’s pioneers.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/transfer_pennsylvania",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The Meadville Line, now owned by Norfolk Southern, runs through Transfer, linking the village to larger markets in Pittsburgh, Erie, and Ohio.",
      "sourceSentenceIds": [
        16,
        30
      ],
