  "facts": [
    {
      "id": 1,
      "text": "Griffintown was founded by Mary Griffin, a businesswoman who leased land and subdivided streets starting in 1804.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.mtl.org/en/experience/need-know-about-griffintown",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Robert Griffin, Mary’s husband, ran a soap factory and became the first clerk of the Bank of Montreal in 1817.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Griffintown",
      "category": "people",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The neighborhood once called “the city below the hill” was a hub for Irish immigrants and helped industrialize Montreal.",
      "sourceSentenceIds": [
        15
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.tfcg.ca/history-of-griffintown",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "In 1843, a strike by Griffintown workers over wages of two shillings a day marked Canada’s first major labor protest.",
      "sourceSentenceIds": [
        17
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.tfcg.ca/history-of-griffintown",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The 1859 Victoria Bridge and railroad tracks along the Lachine Canal turned Griffintown into a key transportation corridor.",
      "sourceSentenceIds": [
        18
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.tfcg.ca/history-of-griffintown",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Today, Lowney Lofts repurposes a historic chocolate factory, blending Griffintown’s industrial past with modern condos.",
