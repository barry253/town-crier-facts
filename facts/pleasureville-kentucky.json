  "facts": [
    {
      "id": 1,
      "text": "Pleasureville’s 1858 L&N Railroad Depot, situated a mile south of the original town, became the community’s lifeline and hub of activity.",
      "sourceSentenceIds": [
        7,
        14
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Pleasureville%2C_Kentucky",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Pleasureville was named for Patrick Henry, who served as Virginia’s governor, and the town has evolved through many changes since its late 1800s construction.",
      "sourceSentenceIds": [
        5,
        1
      ],
      "sourceLabels": [
        "Web source 2",
        "Web source 1"
      ],
      "source": "https://www.wkyt.com/2026/03/13/off-beaten-path-telling-stories-small-kentucky-towns/",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "In February, Jenny Stark and her husband Chad opened the restaurant All Porked Out inside Pleasureville’s historic depot, honoring the town’s past.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.wkyt.com/2026/03/13/off-beaten-path-telling-stories-small-kentucky-towns/",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Pleasureville’s historical society preserves Mike Grimes’ books and records that trace the town’s story back to the late 1700s.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.wkyt.com/2026/03/13/off-beaten-path-telling-stories-small-kentucky-towns/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Mike Grimes, who retired in 2011, has written 13 books on small-town history, collaborating closely with Pleasureville families.",
