  "facts": [
    {
      "id": 1,
      "text": "Harmony was founded in 1804 by Johann Georg Rapp’s Harmony Society, a group of German Lutheran separatists seeking religious freedom.",
      "sourceSentenceIds": [
        3,
        4,
        15
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1",
        "Web source 2"
      ],
      "source": "https://en.wikipedia.org/wiki/Harmony%2C_Pennsylvania"
    },
    {
      "id": 2,
      "text": "The Harmony Museum, run by Historic Harmony, Inc., preserves the town’s unique pietist heritage.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Harmony%2C_Pennsylvania"
    },
    {
      "id": 3,
      "text": "Early Harmony boasted a thriving economy with a clothing factory, sawmill, tannery, vineyards, and a distillery.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Harmony%2C_Pennsylvania"
    },
    {
      "id": 4,
      "text": "Members of the Harmony Society helped construct the Pittsburgh and Lake Erie Railroad and founded the Economy Savings Institution.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Harmony%2C_Pennsylvania"
    },
    {
      "id": 5,
      "text": "In 1974, Harmony’s downtown was designated a National Historic Landmark District, showcasing its well‑preserved brick and log architecture.",
      "sourceSentenceIds": [
        10,
        16
      ],
      "sourceLabels": [
        "Web source 1",
        "Web source 2"
      ],
      "source": "https://www.experiencebutler.com/cities-and-towns/harmony/"
    },
    {
      "id": 6,
      "text": "Every year, the Harmony Silvester 5K Race celebrates the town’s German heritage with a family‑friendly run through historic streets.",
