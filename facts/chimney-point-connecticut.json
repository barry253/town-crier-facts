  "facts": [
    {
      "id": 1,
      "text": "Chimney Point State Historic Site showcases a 1785 tavern that dominates the landscape, echoing the area's early American heritage.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://northerndepartment.org/site/chimney-point/"
    },
    {
      "id": 2,
      "text": "The historic site sits on a former French settlement founded in 1731, marking early colonial presence in the Champlain Valley.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://northerndepartment.org/site/chimney-point/"
    },
    {
      "id": 3,
      "text": "Opposite Crown Point, New York, Chimney Point served as a strategic Revolutionary War site used by both American and British forces between 1775 and 1777.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://northerndepartment.org/site/chimney-point/"
    },
    {
      "id": 4,
      "text": "Chimney Point lies just north of Candlewood Lake Club, placing it near Connecticut's largest inland lake.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Chimney_Point%2C_Connecticut"
    },
    {
      "id": 5,
      "text": "The community's coordinates are 41.5026° N latitude and 73.4408° W longitude, locating it in Western Connecticut County.",
