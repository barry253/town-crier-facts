  "facts": [
    {
      "id": 1,
      "text": "Glenarden became Maryland's third predominantly Black incorporated town when its charter was granted on March 30, 1939.",
      "sourceSentenceIds": [
        17
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Glenarden%2C_Maryland",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town began in 1919 when W. Smith purchased land east of Washington and founded a 15‑person community.",
      "sourceSentenceIds": [
        14,
        15
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Glenarden%2C_Maryland",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "A 1921 parcel across the railroad was platted as Ardwick Park, later renamed Glenarden Woods.",
      "sourceSentenceIds": [
        1,
        6
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://cityofglenarden.org/community/history_of_glenarden.php",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The Washington Commerce Center and Carrollton Station subdivisions were annexed in 1983, enlarging Glenarden's limits.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://cityofglenarden.org/community/history_of_glenarden.php",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "A 1978 HUD‑funded project expanded the municipal center and added a local library branch designed by resident architect Anthony Johns.",
      "sourceSentenceIds": [
        11
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://cityofglenarden.org/community/history_of_glenarden.php",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Glenarden lies near New Carrollton and Landover Metro stations, both on Washington Metro's Orange Line.",
