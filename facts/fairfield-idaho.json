  "facts": [
    {
      "id": 2,
      "text": "The Oregon Short Line Railroad arrived in 1911, turning Fairfield and Hill City into prairie hubs and briefly making the region the sheep‑shipping capital of the world.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://sunvalleymag.com/articles/little-town-on-the-prairie/",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "A 19th‑century emigrant group hired explorer Tim Goodale to guide them along a shortcut from Fort Hall to Boise, passing through what would become Fairfield.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://sunvalleymag.com/articles/little-town-on-the-prairie/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Historic Sanborn maps from 1915 to 1931 show Fairfield’s downtown blocks, schools, hotels, factories, churches, and storefronts, revealing everyday life over a century ago.",
      "sourceSentenceIds": [
        1,
        5,
        12,
        10
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://hometownhistorymaps.com/pages/history-of-fairfield-idaho",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "These real old maps let visitors see Fairfield exactly as it looked more than a century ago, bringing local history to life in ways books cannot.",
      "sourceSentenceIds": [
        10,
        12,
        11
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://hometownhistorymaps.com/pages/history-of-fairfield-idaho",
      "category": "other",
      "quality": "poor",
      "qualityReason": "editorial_filler"
    },
    {
      "id": 6,
      "text": "Families use Fairfield’s historic maps to reconnect with ancestry, remember hometowns, or give personal gifts tied to meaningful places.",
