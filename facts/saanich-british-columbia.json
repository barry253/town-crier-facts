      ],
      "source": "https://www.comeexplorecanada.com/british-columbia/saanich",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Covering 103.44 square kilometres, Saanich is the largest municipality in Greater Victoria.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Saanich%2C_British_Columbia",
