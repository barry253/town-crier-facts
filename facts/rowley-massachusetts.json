  "facts": [
    {
      "id": 1,
      "text": "Rowley, Massachusetts, was settled by English colonists in the early 17th century, making it one of the region’s oldest towns.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://historyofmassachusetts.org/rowley-ma-history/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Rowley incorporated on September 4, 1639, encompassing parts of what are now Byfield, Groveland, Georgetown, and Haverhill.",
      "sourceSentenceIds": [
        27
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Rowley%2C_Massachusetts",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Rowley was named after its English namesake in Yorkshire, where Reverend Ezekiel Rogers preached for twenty years before his Puritan‑inspired suspension.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Rowley%2C_Massachusetts",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "In 1643 and 1645, Rowley built a fulling mill and a grist mill, fueling early industry.",
      "sourceSentenceIds": [
        29
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Rowley%2C_Massachusetts",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The Rowley Historical Society, founded in 1918, preserves the town’s first‑period homes and its rich heritage.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.legendsofamerica.com/rowley-massachusetts/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The 2019 film Sound of Metal filmed scenes in Rowley’s salt marshes and at the Agawam Diner.",
