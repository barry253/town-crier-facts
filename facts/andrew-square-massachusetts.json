  "facts": [
    {
      "id": 1,
      "text": "Andrew Square was renamed in 1870 to honor Massachusetts’ 25th Governor John Albion Andrew, replacing its former name Washington Village.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://caughtinsouthie.com/features/history-lesson-andrew-square/",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The Old Colony Railroad cut through Andrew Square during the mid‑19th‑century boom, linking Boston’s suburbs to the city center.",
      "sourceSentenceIds": [
        21
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://web.mit.edu/thecity/archive/projects13/hip_to_be_square_sarahmcm/as3.html",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "At Andrew Square’s heart stands the historic Harvard Square Subway Kiosk, formerly an Out of Town News newsstand.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Harvard_Square",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "A streetcar tunnel beneath Andrew Square, built for streetcars until 1958, now carries trackless trolleys and buses.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Harvard_Square",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Governor Andrew’s legacy includes not enforcing Prohibition, supporting Catholics, and founding what became the Massachusetts State Police.",
