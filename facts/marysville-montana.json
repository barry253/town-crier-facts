  "facts": [
    {
      "id": 1,
      "text": "Marysville was founded by Thomas Cruse, who named the site Drumlummon after his Irish birthplace.",
      "sourceSentenceIds": [
        1,
        5
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Marysville%2C_Montana",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "During the 1880s and 1890s, Marysville produced about $50 million in gold, briefly becoming the world's leading gold producer.",
      "sourceSentenceIds": [
        2,
        18
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://roamingmontana.com/marysville-ghost-town-montana/",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Marysville still hosts the Pioneer Memorial Building, hand‑hewn log homes, and the Methodist‑Episcopal Church, all listed on the National Register.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://helenamt.com/explore-marysville/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "At its peak, Marysville boasted 3,000 residents, 27 saloons, two railroads, and a baseball field with wooden bleachers.",
      "sourceSentenceIds": [
        18
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://roamingmontana.com/marysville-ghost-town-montana/",
      "category": "people",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Today Marysville is a semi‑ghost town where a handful of residents keep history alive among preserved historic buildings.",
      "sourceSentenceIds": [
        12,
        13
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://helenamt.com/explore-marysville/",
      "category": "other",
      "quality": "poor",
      "qualityReason": "vague"
    },
    {
      "id": 6,
      "text": "Marysville sits at 5,413 feet in the valley of Silver Creek, which flows east into the Missouri River.",
