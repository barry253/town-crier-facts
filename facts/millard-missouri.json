  "facts": [
    {
      "id": 1,
      "text": "Millard was laid out in 1872 and was probably named after Maggie A. Miller, one of its early settlers.",
      "sourceSentenceIds": [
        1,
        3
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Millard%2C_Missouri",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "A post office opened in 1870, before the village was formally laid out, linking scattered farmsteads across Pettis Township.",
      "sourceSentenceIds": [
        2,
        13
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/millard_missouri",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Millard lies roughly eight miles south of Kirksville along the former Wabash Railroad line that once crisscrossed the county.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/millard_missouri",
      "category": "other",
      "quality": "poor",
      "qualityReason": "location_description"
    },
    {
      "id": 4,
      "text": "The village’s roots trace back to the mid‑19th century when pioneers claimed land through federal entries and earlier purchases.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/millard_missouri",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The Millard post office remained in operation until 1942, serving the community for over seven decades.",
      "sourceSentenceIds": [
        13
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
