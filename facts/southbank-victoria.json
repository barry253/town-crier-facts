      "quality": "good"
    },
    {
      "id": 4,
      "text": "The Melbourne Convention and Exhibition Centre, a key venue for international events, stands as a testament to Southbank’s modern development.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
