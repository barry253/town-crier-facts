  "facts": [
    {
      "id": 1,
      "text": "Martinsville was founded in 1790 by Revolutionary War General Joseph Martin, a frontiersman and statesman.",
      "sourceSentenceIds": [
        3,
        5,
        11
      ],
      "sourceLabels": [
        "Web source 1",
        "Wikipedia"
      ],
      "source": "https://www.martinsville-va.gov/547/History-of-Martinsville"
    },
    {
      "id": 2,
      "text": "In 1883 the Danville & Western Railroad arrived, followed by the Norfolk and Western in 1892, sparking a boom that turned Martinsville into a textile hub.",
      "sourceSentenceIds": [
        27
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.dhr.virginia.gov/historic-registers/120-5001/"
    },
    {
      "id": 3,
      "text": "The city sits in the Eastern foothills of the Blue Ridge Mountains, giving it a scenic backdrop that locals call “the Blue Ridge Gateway.”.",
      "sourceSentenceIds": [
        25
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.martinsville-va.gov/547/History-of-Martinsville"
    },
    {
      "id": 4,
      "text": "Martinsville’s historic district, with buildings dating from the 1820s to post‑World War II, is listed on the National Register of Historic Places.",
      "sourceSentenceIds": [
        26,
        15
      ],
      "sourceLabels": [
        "Web source 2",
        "Wikipedia"
      ],
      "source": "https://www.dhr.virginia.gov/historic-registers/120-5001/"
    },
    {
      "id": 5,
      "text": "The Martinsville Novelty Corporation Factory, a 20th‑century toy‑making landmark, earned a spot on the National Register in 2008.",
      "sourceSentenceIds": [
        15
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Martinsville%2C_Virginia"
    },
    {
      "id": 6,
      "text": "The city’s name honors its founder, General Joseph Martin, whose legacy lives on in the town’s annual “Martin’s Day” celebrations.",
      "sourceSentenceIds": [
        3,
        5
      ],
