  "facts": [
    {
      "id": 1,
      "text": "North Vacherie's name comes from the French word 'vacherie,' meaning cattle ranch, reflecting its early livestock‑herding roots that fed New Orleans.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/Vacherie,_Louisiana",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "North Vacherie grew into a sugarcane hub during the antebellum era, with large plantations relying on enslaved labor.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/Vacherie,_Louisiana",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Oak Alley Plantation, a National Historic Landmark, showcases a Greek Revival mansion built 1837‑1839 and accessed via a quarter‑mile avenue of 300‑year‑old live oaks.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/Vacherie,_Louisiana",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "North Vacherie experiences a humid subtropical climate with hot, humid summers averaging 92°F and mild winters around 42–45°F.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/Vacherie,_Louisiana",
      "category": "other",
      "quality": "poor",
      "qualityReason": "vague"
    },
    {
      "id": 5,
      "text": "The area receives about 63–66 inches of rain annually, spread evenly but peaking during the summer convective season.",
      "sourceSentenceIds": [
