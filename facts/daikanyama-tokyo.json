    {
      "id": 1,
      "text": "Daikanyama’s name literally translates to “Magistrate’s Hill,” nodding to its historical roots.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://jw-webmagazine.com/tips/daikanyama-guide/",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Tsutaya Books Daikanyama, known as T‑Site, opened in 2011 and was designed by Klein Dytham Architecture as a “library in the woods.”.",
      "sourceSentenceIds": [
        4,
        6,
        13,
        10
      ],
      "sourceLabels": [
        "Wikipedia",
        "Wikipedia",
        "Wikipedia",
        "Web source 2"
      ],
      "source": "https://en.wikipedia.org/wiki/Tsutaya_Books_Daikanyama",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The three interconnected T‑Site buildings house six book departments, including Western titles and vintage editions, and feature a café where visitors can read.",
      "sourceSentenceIds": [
        8,
        23
      ],
      "sourceLabels": [
        "Web source 1",
        "Web source 1"
      ],
      "source": "https://www.gotokyo.org/en/destinations/western-tokyo/daikanyama/index.html",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Daikanyama’s leafy streets host high‑end boutiques and hip cafés, making it a favorite spot for fashionistas to stroll and people‑watch.",
      "sourceSentenceIds": [
        18,
        19,
        20
      ],
      "sourceLabels": [
        "Web source 1",
        "Web source 1",
        "Web source 1"
      ],
      "source": "https://www.gotokyo.org/en/destinations/western-tokyo/daikanyama/index.html",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "From Tokyo Station, a quick ride on the JR Yamanote Line to Shibuya followed by the Tokyu‑Toyoko Line brings you straight to Daikanyama Station.",
      "sourceSentenceIds": [
        7
      ],
