  "facts": [
    {
      "id": 1,
      "text": "Frank Parker’s joke on the Amos 'n' Andy radio show sparked the name Weber City, and he even put a “Welcome to Weber City” sign on US 23.",
      "sourceSentenceIds": [
        13
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Weber_City%2C_Virginia"
    },
    {
      "id": 2,
      "text": "Although Weber City was officially incorporated in 1954, the surrounding land traces back to the long history of Big Moccasin Gap and the Wilderness Road.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://appalachianhistorian.org/weber-city-scott-county-frank-parker-moccasin-gap-and-the-name-that-stuck/"
    },
    {
      "id": 3,
      "text": "County historians call Big Moccasin Gap the most important natural feature, because early development and trade routes centered there before the railroad.",
      "sourceSentenceIds": [
        3,
        4
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://appalachianhistorian.org/weber-city-scott-county-frank-parker-moccasin-gap-and-the-name-that-stuck/"
    },
    {
      "id": 4,
      "text": "Weber City lies on the southern side of Moccasin Gap, a natural break in the mountains carved by Big Moccasin Creek.",
      "sourceSentenceIds": [
        20
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Weber_City%2C_Virginia"
    },
    {
      "id": 5,
      "text": "US 23, the main north–south artery through western Virginia, cuts straight through Moccasin Gap and the heart of Weber City.",
      "sourceSentenceIds": [
        22
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Weber_City%2C_Virginia"
    },
    {
      "id": 6,
      "text": "The town’s mid‑century growth is most clearly seen in the legal history of the Weber City Sanitation Commission.",
