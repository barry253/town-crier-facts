  "facts": [
    {
      "id": 1,
      "text": "Norwich was founded in 1659 by settlers from Saybrook Colony led by Major John Mason, James Fitch, and Lieutenant Francis Griswold.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Norwich%2C_Connecticut",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town’s historic Norwichtown Green hosts the Daniel Lathrop Schoolhouse and a Colonial Meeting House Rock, reflecting 17th‑century architecture.",
      "sourceSentenceIds": [
        11,
        15
      ],
      "sourceLabels": [
        "Web source 1",
        "Web source 2"
      ],
      "source": "https://ctvisit.com/listings/norwich-heritage-and-regional-visitors%E2%80%99-center",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The Discover Norwich exhibit on the Green offers a 10‑panel journey through the city’s history from the 17th to the 20th century.",
      "sourceSentenceIds": [
        12,
        13,
        14
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://ctvisit.com/listings/norwich-heritage-and-regional-visitors%E2%80%99-center",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Norwich’s rivers—Yantic, Shetucket, and Quinebaug—converge to form the Thames River, which empties into Long Island Sound.",
      "sourceSentenceIds": [
        21
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Norwich%2C_Connecticut",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The Ponemah Mill in Taftville was the largest mill built at the falls, fueling Norwich’s early industrial boom.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Norwich%2C_Connecticut",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Dodd Stadium, once home to the Connecticut Tigers, was featured in the ESPN mini‑series “The Bronx Is Burning.”.",
