  "facts": [
    {
      "id": 1,
      "text": "Farmers Branch was renamed from Mustang Branch to reflect its rich soil and farmland.",
      "sourceSentenceIds": [
        28
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Farmers_Branch%2C_Texas"
    },
    {
      "id": 2,
      "text": "The town was the first location of the Texan Land and Emigration Company, also known as the Peters Colony, in 1845.",
      "sourceSentenceIds": [
        29
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Farmers_Branch%2C_Texas"
    },
    {
      "id": 3,
      "text": "A replica village at the 27‑acre Farmers Branch Historical Park brings the Peters Colony history to life.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://texastimetravel.com/cities/farmers-branch/"
    },
    {
      "id": 4,
      "text": "The historical park preserves an 1840s log cabin, a 1877 depot, a 1891 Methodist church, and a 1900 one‑room schoolhouse.",
      "sourceSentenceIds": [
        17
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://texastimetravel.com/cities/farmers-branch/"
    },
    {
      "id": 5,
      "text": "The Burlington Northern and Missouri–Kansas–Texas railroads served the city, linking it to regional growth.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.tshaonline.org/handbook/entries/farmers-branch-tx"
    },
    {
      "id": 6,
      "text": "The Farmers Branch Historical Park also fields a vintage baseball team that plays using 19th‑century rules.",
      "sourceSentenceIds": [
