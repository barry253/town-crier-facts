  "facts": [
    {
      "id": 1,
      "text": "Lewisville was founded in 1882 by Mormon pioneers from Utah, who turned a sagebrush desert into a farming settlement along the Dry Bed River.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/lewisville_idaho"
    },
    {
      "id": 2,
      "text": "The town was named Lewisville in honor of the Lewis and Clark Expedition.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/lewisville_idaho"
    },
    {
      "id": 3,
      "text": "Lewisville grew quickly thanks to the Oregon Short Line Railroad, which ran through the town and linked it to markets.",
      "sourceSentenceIds": [
        6,
        8
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/lewisville_idaho"
    },
    {
      "id": 4,
      "text": "In 1960, Lewisville became the corporate headquarters of Idahoan Foods, a company born from local potato growers.",
      "sourceSentenceIds": [
        14,
        15
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Lewisville%2C_Idaho"
    },
    {
      "id": 5,
      "text": "Before settlers, the valley was home to Shoshone and Bannock tribes who relied on salmon runs and pine nuts.",
      "sourceSentenceIds": [
