      ],
      "source": "https://en.wikipedia.org/wiki/Unionville%2C_Missouri",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Historic maps of Unionville are archived in the Sanborn Maps collection at the University of Missouri.",
