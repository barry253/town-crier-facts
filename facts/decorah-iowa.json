  "facts": [
    {
      "id": 1,
      "text": "Decorah takes its name from Ho‑Chunk leader Waukon Decorah, whose influence helped settle the area in the mid‑1800s.",
      "sourceSentenceIds": [
        17,
        18
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Decorah%2C_Iowa",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "About 470 million years ago, a city‑block‑sized meteorite struck the land that is now Decorah, creating an underground crater.",
      "sourceSentenceIds": [
        29,
        30
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Decorah%2C_Iowa",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Since 1861, Luther College has stood in Decorah, offering a private liberal arts education tied to the Evangelical Lutheran Church.",
      "sourceSentenceIds": [
        22
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Decorah%2C_Iowa",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Decorah hosts the Vesterheim Norwegian‑American Museum, the largest collection of Norwegian heritage outside Norway.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Decorah%2C_Iowa",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Every July, Decorah erupts into a Nordic Fest, featuring traditional dancing, food, and music that celebrate Norwegian culture.",
