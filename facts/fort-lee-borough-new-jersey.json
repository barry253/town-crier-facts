      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Fort_Lee%2C_New_Jersey",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The Fort Lee Battle Monument marks the site of the abandoned fort after Washington's failed 1776 attempt to block the British fleet.",
