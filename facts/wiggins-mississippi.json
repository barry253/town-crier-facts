  "facts": [
    {
      "id": 1,
      "text": "Wiggins named after Wiggins Hatten, father of early homesteader Madison Hatten, in the 19th century.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Wiggins%2C_Stone_County%2C_Mississippi"
    },
    {
      "id": 2,
      "text": "A Gulf and Ship Island Railroad cut through the town in the late 1800s, turning Wiggins into a rail hub.",
      "sourceSentenceIds": [
        2,
        13,
        14
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.cityofwiggins.gov/210/Our-History"
    },
    {
      "id": 3,
      "text": "The town once served as headquarters for the Finkbine Lumber Company, fueling a timber boom in the early 1900s.",
      "sourceSentenceIds": [
        28,
        27
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Wiggins%2C_Stone_County%2C_Mississippi"
    },
    {
      "id": 4,
      "text": "Wiggins was home to the world’s largest pickle processing plant at one time, cementing its reputation for pickles.",
      "sourceSentenceIds": [
        30
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Wiggins%2C_Stone_County%2C_Mississippi"
    },
    {
      "id": 5,
      "text": "In 1912, the American Pickle and Canning Company, linked to Finkbine Lumber, began operations; by 1923 it produced only pickles and returned its office to Wiggins.",
      "sourceSentenceIds": [
        6,
        9
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.cityofwiggins.gov/210/Our-History"
    },
    {
      "id": 6,
      "text": "The Widlar Company of Cleveland bought the pickle factory and all salting stations in 1926, expanding the local pickle industry.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.cityofwiggins.gov/210/Our-History"
    }
  ]
