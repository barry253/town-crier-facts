  "facts": [
    {
      "id": 1,
      "text": "Warren was named for Revolutionary War patriot General Joseph Warren, killed at Bunker Hill.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Warren_Township%2C_New_Jersey",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Warren’s historic landmarks include Mount Bethel Baptist Meetinghouse, Baker–Duderstadt Farm, and Kirch–Ford House, all on the National Register.",
      "sourceSentenceIds": [
        1,
        11
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Warren_Township%2C_New_Jersey",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Warren County, where Warren sits, is New Jersey’s northernmost county, known for rolling hills and fertile farmland.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://newjersey.wiki/a/Warren_County",
      "category": "other",
      "quality": "poor",
      "qualityReason": "location_description"
    },
    {
      "id": 4,
      "text": "In 2025, Warren County will host a self‑guided history trail with 16 historic sites, including Millbrook Village and Rutherfurd Hall.",
      "sourceSentenceIds": [
        4,
        19
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.warrenhistorytrail.org/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The township was incorporated March 5, 1806, from parts of Bernards and Bridgewater Townships.",
      "sourceSentenceIds": [
        27
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Warren_Township%2C_New_Jersey",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The area was originally inhabited by Lenape Native Americans before European farmers settled in the 1720s.",
