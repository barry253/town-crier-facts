  "facts": [
    {
      "id": 1,
      "text": "Hobart is named for Bishop John Henry Hobart of New York, who sent missionaries to the Oneida people in Wisconsin.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Hobart%2C_Wisconsin"
    },
    {
      "id": 2,
      "text": "The region encompassing present-day Hobart was originally part of the ancestral territory of the Menominee Indian Tribe.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/hobart_wisconsin"
    },
    {
      "id": 3,
      "text": "Oneida tribal members relocated from New York helped establish the Town of Hobart in 1908 for local roads and schools.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/hobart_wisconsin"
    },
    {
      "id": 4,
      "text": "The village of Hobart is located entirely within the treaty boundaries of the Oneida Nation of Wisconsin.",
      "sourceSentenceIds": [
        13
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Hobart%2C_Wisconsin"
    },
    {
      "id": 5,
      "text": "Hobart incorporated as a village on May 13, 2002, to manage residential growth on the outskirts of Green Bay.",
      "sourceSentenceIds": [
        7,
        14
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Hobart%2C_Wisconsin"
    },
    {
      "id": 6,
      "text": "Hobart spent nearly one million dollars in litigation costs between 2011 and 2020 due to sovereignty clashes with the Oneida Nation.",
      "sourceSentenceIds": [
        15,
        21
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Hobart%2C_Wisconsin"
    }
  ]
