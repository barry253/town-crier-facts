  "facts": [
    {
      "id": 1,
      "text": "Alma sprang to life in 1900 as a stop on the Atlantic Coast Line Railroad.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Alma%2C_Georgia",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town’s name honors either Alma Sheridan, a traveling salesman’s wife, or the initials of Georgia’s first four capitals.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Alma%2C_Georgia",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Alma proudly calls itself Georgia’s blueberry capital and hosts a lively Blueberry Festival every June.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Alma%2C_Georgia",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The Historical Center of Alma museum showcases the rich history and culture of Bacon County.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://museumsdatabase.com/museums/view/7583",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Four Alma landmarks—Alma Depot, Bacon County Courthouse, Bacon County School, and the Rabinowitz Building—are listed on the National Register of Historic Places.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Alma%2C_Georgia",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Alma was incorporated as a city in 1906 and became the seat of the newly formed Bacon County in 1914.",
