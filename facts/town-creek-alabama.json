      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The Goode‑Hall House, a historic mansion built in 1824, sits north of town and is listed on the National Register of Historic Places.",
      "sourceSentenceIds": [
        11,
        12
      ],
      "sourceLabels": [
        "Wikipedia",
