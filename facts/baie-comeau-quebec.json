  "facts": [
    {
      "id": 1,
      "text": "Baie‑Comeau’s name honors Napoléon‑Alexandre Comeau, but the original name came from his father Antoine‑Alexandre, an HBC employee.",
      "sourceSentenceIds": [
        1,
        4
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Baie-Comeau",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Baie‑Comeau was founded in 1936 when a paper mill was built, and the town was incorporated a year later in 1937.",
      "sourceSentenceIds": [
        6,
        17
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Baie-Comeau",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The 1952 Chutes‑aux‑Outardes hydro‑electric station marked the start of large‑scale power projects on the Manicouagan and Outardes rivers.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Baie-Comeau",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "In 1959, Baie‑Comeau opened Canada’s largest grain warehouses, a testament to its role in regional agriculture.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Baie-Comeau",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Baie‑Comeau is the birthplace of former Canadian prime minister Brian Mulroney in Canada.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Baie-Comeau",
      "category": "people",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Five rivers—Manicouagan, Amédée, Petit‑Bras, Chasse, and English—course through Baie‑Comeau, feeding around thirty lakes.",
