      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Perched on White Mesa near Blue Mountain, Blanding reflects the legacies of Ute, Navajo, European pioneer, and Spanish cultures.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Web source 2"
