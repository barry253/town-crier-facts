    },
    {
      "id": 2,
      "text": "The town of Gypsum first saw settlers in 1881 and officially became a city in 1911.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.townofgypsum.com/history"
    },
    {
      "id": 3,
      "text": "A railroad line that crossed the valley was key to Gypsum’s survival and helped the town grow in the early 20th century.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.townofgypsum.com/history"
    },
    {
      "id": 4,
      "text": "Today Gypsum hosts an American Gypsum drywall plant and mine, keeping the mineral legacy alive in modern industry.",
      "sourceSentenceIds": [
        11
