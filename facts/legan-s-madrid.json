  "facts": [
    {
      "id": 1,
      "text": "Founded in 1280 as Legamar, Leganés became a Madrid village in 1345 under Alfonso X’s reign.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Legan%C3%A9s"
    },
    {
      "id": 2,
      "text": "Leganés Central station opened on 20 June 1876, originally serving the Madrid‑to‑Cáceres line of a now‑defunct railway company.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Legan%C3%A9s"
    },
    {
      "id": 3,
      "text": "The former Santa Isabel Psychiatric Hospital, opened in 1851, was one of Spain’s first asylums and now houses cultural events.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Legan%C3%A9s"
    },
    {
      "id": 4,
      "text": "Cyclist Daniel Yuste was Leganés’s first Olympic representative, competing in the 1968 Mexico City Games.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Legan%C3%A9s"
    },
    {
      "id": 5,
      "text": "In 1988, Leganés natives José María Sánchez Élez and José Sanabria earned silver medals in taekwondo at Seoul, when the sport was a demo event.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Legan%C3%A9s"
    },
    {
      "id": 6,
      "text": "The Polvoranca Hermitage, a Baroque shrine with a Churriguera altarpiece, stands as a key ecclesiastical landmark in Leganés.",
      "sourceSentenceIds": [
