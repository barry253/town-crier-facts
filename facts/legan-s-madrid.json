  "facts": [
    {
      "id": 1,
      "text": "Leganés was founded in 1280 as \"Legamar\" during Alfonso X's reign and became a Madrid village in 1345.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Legan%C3%A9s",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The Leganés Central railway station opened on 20 June 1876, originally serving the Madrid‑to‑Cáceres line.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Legan%C3%A9s",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The former Santa Isabel Psychiatric Hospital, opened in 1851, was one of Spain's first asylums and now houses part of the Charles III University.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Legan%C3%A9s",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The Polvoranca Hermitage and a Baroque altarpiece by José de Churriguera are key ecclesiastical treasures in Leganés.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Legan%C3%A9s",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Leganés' streets are named after European countries, Latin American nations, and even Don Quixote characters, reflecting a playful naming tradition.",
      "sourceSentenceIds": [
        13,
        14,
        19
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Legan%C3%A9s",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Leganés produced Olympic athletes: cyclist Daniel Yuste in 1968 and taekwondo silver medalists José María Sánchez Élez and José Sanabria in 1988.",
      "sourceSentenceIds": [
        2,
        3
      ],
