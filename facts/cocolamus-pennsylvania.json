      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Cocolamus is a small village in Juniata County, Pennsylvania, United States, situated along the bank of the Cocolamus Creek.",
      "sourceSentenceIds": [
