  "facts": [
    {
      "id": 1,
      "text": "Bad Axe got its name when 1861 surveyors found a badly damaged axe on the road to Huron County.",
      "sourceSentenceIds": [
        29
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Bad_Axe%2C_Michigan"
    },
    {
      "id": 2,
      "text": "The 1882 arrival of the railroad on the Port Austin line gave Bad Axe a new push toward growth.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://thumbwind.com/2026/05/09/history-of-bad-axe-michigan/"
    },
    {
      "id": 3,
      "text": "Grand Trunk’s depot turned Bad Axe into more than a local stop, linking it to larger trade and travel routes.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://thumbwind.com/2026/05/09/history-of-bad-axe-michigan/"
    },
    {
      "id": 4,
      "text": "The Bad Axe Historical Society operates two museums: the Local History Museum and the Pioneer Log Village.",
      "sourceSentenceIds": [
        14,
        18
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.thehchs.org/badaxe"
    },
    {
      "id": 5,
      "text": "Pioneer Log Village houses Michigan’s largest collection of authentically restored pioneer log buildings.",
      "sourceSentenceIds": [
        18
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.thehchs.org/badaxe"
    },
    {
      "id": 6,
      "text": "Bad Axe was officially incorporated as a city in 1905 after decades of growth.",
