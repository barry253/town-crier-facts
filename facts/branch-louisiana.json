  "facts": [
    {
      "id": 1,
      "text": "Branch, Louisiana, was renamed in the mid‑1800s after constable Branch Hayes, replacing its original name Plaquemine Brûlée.",
      "sourceSentenceIds": [
        1,
        10
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/branch_louisiana",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Founded in 1818 as Plaquemine Brûlée, Branch is the oldest settlement in Acadia Parish.",
      "sourceSentenceIds": [
        6,
        10
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/branch_louisiana",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Branch enjoys a humid subtropical climate, with July highs near 92°F and January lows around 42°F.",
      "sourceSentenceIds": [
        16,
        17
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/branch_louisiana",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Rice farming took off in the 1870s when German settlers, led by Joseph Fabacher, brought the first rice‑threshing machine to Branch.",
      "sourceSentenceIds": [
        25,
        26
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/branch_louisiana",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "During the Civil War, the nearby 1863 Battle of Bayou Bourbeux drew Confederate conscripts from Branch.",
