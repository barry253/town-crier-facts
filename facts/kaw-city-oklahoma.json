  "facts": [
    {
      "id": 1,
      "text": "Kaw City was named for the Kanza Indians, who are called the Kaw by local residents.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Kaw_City%2C_Oklahoma"
    },
    {
      "id": 2,
      "text": "Kaw City sits on a peninsula extending into the Kaw Lake impoundment of the Arkansas River.",
      "sourceSentenceIds": [
        27
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Kaw_City%2C_Oklahoma"
    },
    {
      "id": 3,
      "text": "The original Kaw City was founded in 1902 as a farming community in a fertile oxbow bend of the river.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Kaw_City%2C_Oklahoma"
    },
    {
      "id": 4,
      "text": "The old town site was permanently submerged in 1976 after the gates of the Kaw Dam closed.",
      "sourceSentenceIds": [
        22
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Kaw_City%2C_Oklahoma"
    },
    {
      "id": 5,
      "text": "The Kaw City Museum is housed in a 1902 train depot that was moved to higher ground to avoid flooding.",
      "sourceSentenceIds": [
        5,
        6
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Kaw_City%2C_Oklahoma"
    },
    {
      "id": 6,
      "text": "The Kanza Museum and Education Resource Center showcases tribal art and historical artifacts of the Kaw Nation.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Kaw_City%2C_Oklahoma"
