  "facts": [
    {
      "id": 1,
      "text": "Cokesbury takes its name from a combination of two prominent Methodist Episcopal Church bishops, Thomas Coke and Francis Asbury.",
      "sourceSentenceIds": [
        2,
        19
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Cokesbury%2C_South_Carolina"
    },
    {
      "id": 2,
      "text": "Cokesbury was first known as Mount Ariel in 1824, making it one of the earliest planned communities in South Carolina.",
      "sourceSentenceIds": [
        18
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.sciway.net/city/cokesbury.html"
    },
    {
      "id": 3,
      "text": "The historic village of Cokesbury and the former Cokesbury Conference School are listed together on the National Register of Historic Places.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Cokesbury%2C_South_Carolina"
    },
    {
      "id": 4,
      "text": "Cokesbury was home to the Masonic Female College of South Carolina, which was a progressive experiment in higher education for women.",
      "sourceSentenceIds": [
        16
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.sciway.net/city/cokesbury.html"
    },
    {
      "id": 5,
      "text": "Cokesbury is located in northern Greenwood County at the junction of South Carolina highways 246 and 254.",
      "sourceSentenceIds": [
        4,
        15
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Cokesbury%2C_South_Carolina"
    },
    {
      "id": 6,
      "text": "The property of the Masonic Female College operated as part of the public school system from 1918 until 1954.",
