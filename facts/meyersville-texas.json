  "facts": [
    {
      "id": 1,
      "text": "Meyersville was founded in 1846 by German immigrant Adolph Meyer and his sister on the north side of Twelve Mile Coleto Creek.",
      "sourceSentenceIds": [
        19,
        24,
        29
      ],
      "sourceLabels": [
        "Web source 2",
        "Wikipedia"
      ],
      "source": "https://grokipedia.com/page/meyersville_texas",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town was officially named Meyersville in 1847 to honor Adolph Meyer after the Fritz Hausmann family arrived shortly thereafter.",
      "sourceSentenceIds": [
        6,
        1,
        29
      ],
      "sourceLabels": [
        "Web source 2",
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/meyersville_texas",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Early settlers built log homes along the creek, hauling supplies from Victoria over a three‑day, twenty‑mile trip.",
      "sourceSentenceIds": [
        21,
        30
      ],
      "sourceLabels": [
        "Web source 2",
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/meyersville_texas",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Historically, Meyersville’s economy centered on cotton, supported by horse‑powered gins, gristmills, and a brewery.",
      "sourceSentenceIds": [
        18
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/meyersville_texas",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Meyersville is DeWitt County’s second oldest German community, following the first settlement founded earlier.",
      "sourceSentenceIds": [
        28
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.tshaonline.org/handbook/entries/meyersville-tx",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The Pakebusch Family Reunion, held each first Saturday in August, celebrates Meyersville’s German heritage.",
      "sourceSentenceIds": [
        26
      ],
