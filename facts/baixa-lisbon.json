  "facts": [
    {
      "id": 1,
      "text": "Baixa, literally “lower town”, sits between Lisbon’s historic hills and was rebuilt after the 1755 earthquake.",
      "sourceSentenceIds": [
        8,
        17,
        18
      ],
      "sourceLabels": [
        "Web source 1",
        "Wikipedia"
      ],
      "source": "https://lisbonlisticles.com/2025/06/16/lisbons-neighborhood-baixa-a-complete-guide/",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The Pombaline grid of Baixa was one of the first earthquake‑resistant constructions, tested by marching troops around mock buildings.",
      "sourceSentenceIds": [
        18,
        19
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Lisbon_Baixa",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Praça do Comércio, the heart of Baixa, faces the Tagus River and hosts a statue of King José I, a popular photo spot.",
      "sourceSentenceIds": [
        10,
        13
      ],
      "sourceLabels": [
        "Web source 1",
        "Web source 2"
      ],
      "source": "https://lisbonlisticles.com/2025/06/16/lisbons-neighborhood-baixa-a-complete-guide/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The neoclassical Teatro Nacional de São Carlos on the north side of Praça do Comércio overlooks two baroque fountains and a monument to King Pedro IV.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.lisbonportugaltourism.com/guide/baixa.html",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Igreja da Conceição Velha’s Manueline portal was originally a Jewish temple, making it one of Lisbon’s finest examples of Portuguese Gothic.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.lisbonportugaltourism.com/guide/baixa.html",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Baixa’s wide, black‑and‑white mosaic streets lead directly to the triumphal Arco da Rua Augusta, a landmark for street performers.",
      "sourceSentenceIds": [
        16
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://lisbonlisticles.com/2025/06/16/lisbons-neighborhood-baixa-a-complete-guide/",
