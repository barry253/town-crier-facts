  "facts": [
    {
      "id": 1,
      "text": "Birchwood was originally part of Grant Township and joined Lincoln Township in 1918.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.wchsmn.org/birchwood/"
    },
    {
      "id": 2,
      "text": "The village sits on the south and east shore of White Bear Lake.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Birchwood_Village%2C_Minnesota"
    },
    {
      "id": 3,
      "text": "Birchwood began as a summer cottage community built by Saint Paul residents in the early 1900s.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Birchwood_Village%2C_Minnesota"
    },
    {
      "id": 4,
      "text": "The Twin City Lines streetcar once ran through Birchwood, connecting Saint Paul to White Bear Lake and Mahtomedi.",
      "sourceSentenceIds": [
        11
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Birchwood_Village%2C_Minnesota"
    },
    {
      "id": 5,
      "text": "In 1932, the streetcar company received permission to abandon its line through Birchwood.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.wchsmn.org/birchwood/"
    },
    {
      "id": 6,
      "text": "Birchwood incorporated as a village in 1921, later becoming a City of the Fourth Class, but residents insisted on keeping 'Village' in the name.",
