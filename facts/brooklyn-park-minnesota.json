  "facts": [
    {
      "id": 1,
      "text": "In 1858, settlers from Michigan formally organized Brooklyn Park’s town government, naming it after their hometown of Brooklyn, Michigan.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Brooklyn_Park%2C_Minnesota"
    },
    {
      "id": 2,
      "text": "The first town meeting took place in Hanscom’s house on May 11, 1858, where township officers were elected.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.brooklynpark.org/our-history/"
    },
    {
      "id": 3,
      "text": "Brooklyn Township once covered a larger area, but in 1860 its southern sections split to create Brooklyn Center and Crystal Lake.",
      "sourceSentenceIds": [
        4,
        5
      ],
      "sourceLabels": [
        "Web source 1",
        "Web source 2"
      ],
      "source": "https://www.brooklynpark.org/our-history/"
    },
    {
      "id": 4,
      "text": "Brooklyn Park transitioned from a village in 1954 to an incorporated city by 1969.",
      "sourceSentenceIds": [
        28
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Brooklyn_Park%2C_Minnesota"
    },
    {
      "id": 5,
      "text": "The Mississippi River borders Brooklyn Park’s east side, separating it from Coon Rapids and Fridley across the water.",
      "sourceSentenceIds": [
        29
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Brooklyn_Park%2C_Minnesota"
    },
    {
      "id": 6,
      "text": "The 1900s-era Eidem Homestead remains a working farm that draws families and school groups for field trips.",
