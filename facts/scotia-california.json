  "facts": [
    {
      "id": 1,
      "text": "Scotia began as a company town called Forestville in 1863, built by the Pacific Lumber Company to house its redwood workers.",
      "sourceSentenceIds": [
        2,
        3
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Scotia%2C_California",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "In 1888 the town was renamed Scotia to avoid confusion with another Forestville, a change that reflected its many New Brunswick and Nova Scotia residents.",
      "sourceSentenceIds": [
        4,
        25
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Scotia%2C_California",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "A railroad built in 1885 linked Scotia to the Humboldt Bay and Eel River lines, eventually becoming part of the national network by 1914.",
      "sourceSentenceIds": [
        9,
        10
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Scotia%2C_California",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The Scotia Museum preserves the town’s history, showcasing photographs from the Neill Photo Album that document daily life from 1908 to 1913.",
      "sourceSentenceIds": [
        12,
        27,
        28
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.visitredwoods.com/listing/scotia-the-company-town/396/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Julia “Butterfly” Hill spent two years living in the ancient redwood Luna, a gesture that helped protect the tree from being cut down.",
      "sourceSentenceIds": [
        5,
        6
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.latimes.com/california/story/2026-01-02/scotia-battles-to-survive-as-californias-last-company-town",
      "category": "people",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "After Pacific Lumber declared bankruptcy in 2008, Scotia transitioned from a wholly company-owned town to a community where former workers can buy and sell individual homes.",
      "sourceSentenceIds": [
        20,
