    },
    {
      "id": 2,
      "text": "Bear Butte Creek formed Boulder Canyon, which drains northeast from the Black Hills toward the Great Plains.",
      "sourceSentenceIds": [
        6,
        14
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Boulder_Canyon%2C_South_Dakota"
    },
    {
      "id": 3,
      "text": "The Boulder Canyon Site contains archaeological evidence of Paleo-Indian hunter-gatherers who used the area as a seasonal encampment.",
      "sourceSentenceIds": [
        1,
        25
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/boulder_canyon_south_dakota"
    },
    {
      "id": 4,
      "text": "Excavations at Boulder Canyon revealed stone tools and hearths from the Plano culture dating back to between 10,000 and 8,000 BCE.",
      "sourceSentenceIds": [
        24
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/boulder_canyon_south_dakota"
    },
    {
      "id": 5,
      "text": "Forests in Boulder Canyon provide a rich habitat for white-tailed deer, wild turkeys, and over 300 different bird species.",
      "sourceSentenceIds": [
        20
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/boulder_canyon_south_dakota"
    },
