      "id": 1,
      "text": "Boulder Canyon is celebrated for its dramatic granite cliffs, needle-like spires, and sweeping vistas within the Black Hills.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 1"
      ],
