  "facts": [
    {
      "id": 1,
      "text": "Pelham Gardens was developed by Italian‑immigrant builder John Altieri on land between Clay and Washington Avenues.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://pelhamtownhistorian.com/pelham-gardens",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Altieri hired architect Robert Kilmartin to design each Tudor‑style home uniquely, so no two houses look alike.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://pelhamtownhistorian.com/pelham-gardens",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The neighborhood’s name traces back to Thomas Pell, who bought the land from the Siwanoy in 1654.",
      "sourceSentenceIds": [
        13
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Pelham_Gardens%2C_Bronx",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The Baychester Post Office at 1525 East Gun Hill Road serves Pelham Gardens, a legacy of the town’s early postal history.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Pelham_Gardens%2C_Bronx",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Pelham Gardens sits on a gently rolling valley between Eastchester Road and Laconia Avenue, a remnant of glacial activity.",
