      "id": 1,
      "text": "Fieldston was named after Fieldston Hall in Yorkshire by Joseph Delafield, who wanted the Bronx enclave to echo his ancestral English estate.",
      "sourceSentenceIds": [
        4,
        6
      ],
      "sourceLabels": [
        "Web source 1",
