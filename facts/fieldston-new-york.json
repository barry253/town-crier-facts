      ],
      "source": "https://fieldstonthebronxneighborhood.org/fieldston-a-timeless-tapestry-of-history-and-heritage-in-the-bronx/",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "In 2006 the New York City Landmarks Preservation Commission declared Fieldston a Historic District, protecting more than 250 buildings in the neighborhood.",
      "sourceSentenceIds": [
        12,
        18
      ],
      "sourceLabels": [
        "Web source 1",
