      ],
      "source": "https://fieldstonthebronxneighborhood.org/fieldston-a-timeless-tapestry-of-history-and-heritage-in-the-bronx/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The Ethical Culture Fieldston School, founded in 1928 on Fieldston Road, remains a flagship of progressive education in New York City.",
      "sourceSentenceIds": [
        5,
        24
      ],
      "sourceLabels": [
        "Web source 1",
        "Wikipedia"
      ],
      "source": "https://fieldstonthebronxneighborhood.org/fieldston-a-timeless-tapestry-of-history-and-heritage-in-the-bronx/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Fieldston began as a 1909 garden suburb, planned by the Delafield Estate Company to create an exclusive, architecturally controlled residential community.",
      "sourceSentenceIds": [
        7,
        23
      ],
      "sourceLabels": [
        "Web source 2",
        "Web source 2"
      ],
      "source": "https://www.cityneighborhoods.nyc/fieldston",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "A century‑old tree canopy now forms a dense green vault that shades the narrow lanes where historic homes stand in near‑original condition.",
      "sourceSentenceIds": [
        19
      ],
      "sourceLabels": [
        "Web source 2"
      ],
