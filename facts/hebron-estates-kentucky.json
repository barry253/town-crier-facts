  "facts": [
    {
      "id": 1,
      "text": "Hebron Estates is a home rule-class city located in northern Bullitt County, about seventeen miles south of downtown Louisville.",
      "sourceSentenceIds": [
        6,
        7
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Hebron_Estates%2C_Kentucky"
    },
    {
      "id": 2,
      "text": "The area around Hebron Estates was initially settled as farmland during the early nineteenth century following the organization of Bullitt County.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/hebron_estates_kentucky"
    },
    {
      "id": 3,
      "text": "Revolutionary War veteran John Beckwith helped establish the community by donating land for a brick schoolhouse around 1833.",
      "sourceSentenceIds": [
        24
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/hebron_estates_kentucky"
    },
    {
      "id": 4,
      "text": "The name Hebron Estates comes from the biblical city of Hebron, symbolizing society, friendship, and union for the early settlers.",
      "sourceSentenceIds": [
        25
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/hebron_estates_kentucky"
    },
    {
      "id": 5,
      "text": "Hebron Lane began as a dirt wagon trail leading to the church before being rebuilt for vehicles in the 1930s.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/hebron_estates_kentucky"
    },
    {
      "id": 6,
      "text": "Hebron Estates incorporated in 1984 to assert local control and resist annexation by neighboring cities like Hillview and Pioneer Village.",
