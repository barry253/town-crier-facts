  "facts": [
    {
      "id": 1,
      "text": "Bryn Athyn was founded as a religious community by members of the New Church in the late 19th century.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.bahistoricdistrict.org/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The Bryn Athyn Historic District, a National Historic Landmark, includes four buildings, including Cairnwood Estate built for industrialist John Pitcairn.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Bryn_Athyn%2C_Pennsylvania",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Bryn Athyn Cathedral, financed by John Pitcairn and supervised by his son Raymond, is renowned for its Arts and Crafts stained glass.",
      "sourceSentenceIds": [
        28,
        29
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Bryn_Athyn%2C_Pennsylvania",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The town’s name means “Hill of Unity,” combining Welsh “bryn” for hill with a word from a 1889 dictionary.",
      "sourceSentenceIds": [
        17,
        18
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Bryn_Athyn%2C_Pennsylvania",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "In 1916, Bryn Athyn separated from Moreland Township to become an independent borough, a move petitioned to the Commonwealth.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.brynathynboro.org/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The historic Fetters Mill Bridge, built in 1883 as a Pratt Through Truss, still stands over the creek in Bryn Athyn.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.brynathynboro.org/",
      "category": "landmark",
      "quality": "good"
