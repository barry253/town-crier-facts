  "facts": [
    {
      "id": 1,
      "text": "Rockaway Beach’s name comes from the Algonquian word Reckowacky, meaning “place of sands,” echoing its tidal shoreline.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.cityneighborhoods.nyc/rockaway-beach",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "It hosts the largest urban beach in the U.S., stretching from Beach 3rd to Beach 153rd Streets.",
      "sourceSentenceIds": [
