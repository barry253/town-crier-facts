  "facts": [
    {
      "id": 1,
      "text": "Founded in 1981, the Newtown Square Historical Society was created by civic‑minded residents to preserve the township’s rich past.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://nshistory.org/"
    },
    {
      "id": 2,
      "text": "The Paper Mill House, built in 1770 and restored in the 1980s, now serves as the society’s museum and opens Saturdays 12‑4 p.m.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.newtowntownship.org/346/Newtown-Square-Historical-Society"
    },
    {
      "id": 3,
      "text": "David’s Church, founded in 1715, is Delaware County’s oldest non‑Quaker church and is listed on the National Register of Historic Places.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Newtown_Township%2C_Delaware_County%2C_Pennsylvania"
    },
    {
      "id": 4,
      "text": "The Newtown Square Railroad Museum, located in the former Pennsylvania Railroad station, showcases a vintage steam locomotive and a model‑train layout.",
      "sourceSentenceIds": [
        11
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Newtown_Township%2C_Delaware_County%2C_Pennsylvania"
    },
    {
      "id": 5,
      "text": "Since 1995, the society’s annual Historic Newtown Square Day has raised funds that support school tours, scholarships, and museum operations.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.newtowntownship.org/346/Newtown-Square-Historical-Society"
    },
    {
      "id": 6,
      "text": "Benjamin West, the father of American painting, once resided at the Square Tavern during colonial times.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Web source 2"
      ],
