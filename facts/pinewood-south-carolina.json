    },
    {
      "id": 2,
      "text": "Millford Plantation, built in 1839, is listed on the National Register of Historic Places and offers guided tours to the public.",
      "sourceSentenceIds": [
        3,
        21
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.sciway.net/city/pinewood.html"
    },
    {
      "id": 3,
      "text": "Some early residents called Millford Plantation Manning's Folly because it was such a grand home in a remote location.",
      "sourceSentenceIds": [
        23
      ],
      "sourceLabels": [
