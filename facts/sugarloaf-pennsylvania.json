  "facts": [
    {
      "id": 1,
      "text": "Sugarloaf Township takes its name from Sugarloaf Mountain, first called “Sugarloaf Hill” by surveyor William Gray in 1787.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.sugarloaftwp.org/history/",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "In April 1809, Sugarloaf Township split from Nescopeck, becoming Luzerne County’s 14th township.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.sugarloaftwp.org/history/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "By 1839, Butler and Hazle Townships broke away from Sugarloaf, and in 1848 Black Creek Township joined the split.",
      "sourceSentenceIds": [
        22,
        23
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.sugarloaftwp.org/history/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Judge A.L.H. Wheaton declared the Village of Conyngham a borough in 1901, removing it from Sugarloaf Township’s jurisdiction.",
      "sourceSentenceIds": [
        24
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.sugarloaftwp.org/history/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The Brainerd Church, erected in 1853, stands as a restored 19th‑century landmark within Sugarloaf Township.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.sugarloaftwp.org/history/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Two monasteries—Holy Annunciation Byzantine Carmelite Nuns and Holy Dormition—call Sugarloaf Township home.",
      "sourceSentenceIds": [
        30
