  "facts": [
    {
      "id": 1,
      "text": "Shouson Hill takes its name from Sir Shouson Chow, a prominent early‑20th‑century Hong Kong businessman and philanthropist.",
      "sourceSentenceIds": [
        1,
        5
      ],
      "sourceLabels": [
        "Web source 1",
        "Web source 2"
      ],
      "source": "https://www.trawellino.com/destinations/hong-kong/southern_shouson-hill"
    },
    {
      "id": 2,
      "text": "During World War II, the hill hosted a series of concrete pillboxes that once guarded the coast against Japanese air attacks.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.traveldojo.com/shouson-hill/"
    },
    {
      "id": 3,
      "text": "The hill’s northern slopes are home to an exclusive residential enclave, centered around Shouson Hill Road and its quiet side streets.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Shouson_Hill"
    },
    {
      "id": 4,
      "text": "Heavy rain can trigger landslides on Shouson Hill’s steep slopes, sometimes forcing temporary road closures.",
      "sourceSentenceIds": [
        13
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Shouson_Hill"
    },
    {
      "id": 5,
      "text": "Nearly three‑quarters of Shouson Hill is covered in vegetation, from mandarin shrubs to mangrove and palm trees.",
      "sourceSentenceIds": [
        14
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Shouson_Hill"
    },
    {
      "id": 6,
      "text": "Birdwatchers spot black kites and estuary birds nesting among the hill’s trees, while snakes and lizards roam the understory.",
      "sourceSentenceIds": [
        15
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Shouson_Hill"
    }
  ]
}
