  "facts": [
    {
      "id": 1,
      "text": "Rockford was founded in 1815 by French‑Indian trader Anthony Madore and was originally called Shanesville.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Rockford%2C_Ohio",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "In 1820, Anthony Shane filed a plot and the town grew to 42 lots on the south side of the river.",
      "sourceSentenceIds": [
        18
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Rockford%2C_Ohio",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Shanesville became Shane’s Crossing and was renamed Rockford by a Post Office Department decree.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Rockford%2C_Ohio",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Fort Adams, built in 1794 by General Anthony Wayne as a temporary relay station, now exists only as an archaeological preserve.",
      "sourceSentenceIds": [
        11,
        6
      ],
      "sourceLabels": [
        "Wikipedia",
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Rockford%2C_Ohio",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The Rockford Historical Museum at 151 Columbia St. displays artifacts that trace the village’s early trading post era.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://rockfordalive.com/schs/village-history/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Rockford hosts a Bicentennial Barn Quilt Trail and a Veterans Memorial at Hedges Park, celebrating local heritage and service.",
      "sourceSentenceIds": [
        4
