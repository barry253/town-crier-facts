  "facts": [
    {
      "id": 1,
      "text": "Poulsbo, known as Little Norway, was founded in the 1880s by Norwegian immigrant Jørgen Eliason and other Scandinavians who saw the fjord‑like scenery as a home.",
      "sourceSentenceIds": [
        4,
        5,
        7
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Poulsbo%2C_Washington",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town’s name came from Iver Brynildsen Moe’s suggestion of “Paulsbo,” a misspelling of his hometown Paus in Norway, which stuck after the post office opened.",
      "sourceSentenceIds": [
        6,
        29,
        30
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Poulsbo%2C_Washington",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Liberty Bay, originally called Dog Fish Bay, and the snow‑peaked Olympic Mountains drew the first settlers, who relied on water travel to reach the new community.",
      "sourceSentenceIds": [
        2,
        7
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://poulsbo.gov/",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Downtown Poulsbo today preserves its Scandinavian heritage with a boardwalk, historic churches, and a public library that echoes the town’s Norwegian roots.",
      "sourceSentenceIds": [
        3,
        9,
        10
      ],
      "sourceLabels": [
        "Web source 1",
        "Wikipedia"
      ],
      "source": "https://poulsbo.gov/",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Poulsbo Bread, baked at Sluys Bakery, once shipped internationally, showcasing the town’s culinary reach beyond its borders.",
      "sourceSentenceIds": [
        15
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
