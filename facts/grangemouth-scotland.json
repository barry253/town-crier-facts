  "facts": [
    {
      "id": 1,
      "text": "Sir Lawrence Dundas founded Grangemouth in 1768, building it beside the new Forth and Clyde Canal.",
      "sourceSentenceIds": [
        3,
        5
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Grangemouth",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town’s name evolved from Sealock to Grangeburnmouth and finally to Grangemouth, marking its mouth on the Grange Burn.",
      "sourceSentenceIds": [
        9,
        10
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Grangemouth",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The Scottish Co‑operative Wholesale Society opened a large soap and glycerine factory in Grangemouth in 1897.",
      "sourceSentenceIds": [
        6,
        14
      ],
      "sourceLabels": [
        "Web source 1",
        "Web source 2"
      ],
      "source": "https://www.scotland.org.uk/guide/places/grangemouth-visitor-guide",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Today Grangemouth hosts one of Europe’s largest petrochemical complexes, including an Ineos oil refinery.",
      "sourceSentenceIds": [
        22
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Grangemouth",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Grangemouth grew into a bustling 18th‑century port thanks to its position on the Firth of Forth and the Forth and Clyde Canal.",
