      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The Milltown Historical Society, founded by dedicated volunteers, collects and shares stories that trace the borough’s rich past and immigrant experiences.",
      "sourceSentenceIds": [
