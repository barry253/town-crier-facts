  "facts": [
    {
      "id": 1,
      "text": "Summerville was platted on September 20, 1873, along Ruckle Road by William H. Patten.",
      "sourceSentenceIds": [
        20
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Summerville%2C_Oregon"
    },
    {
      "id": 2,
      "text": "William H. Patten operated a freight depot along Ruckle Road, which was a popular route over the Blue Mountains until 1884.",
      "sourceSentenceIds": [
        21
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Summerville%2C_Oregon"
    },
    {
      "id": 3,
      "text": "An 1888 Sanborn map of Summerville shows the city once featured an opera hall, bank, livery, and drugstore.",
      "sourceSentenceIds": [
        23
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Summerville%2C_Oregon"
    },
    {
      "id": 4,
      "text": "Half of the main street buildings in Summerville were destroyed in a fire in 1888 but were rebuilt soon after.",
      "sourceSentenceIds": [
        24
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Summerville%2C_Oregon"
    },
    {
      "id": 5,
      "text": "Summerville lies in the northern Grande Ronde Valley, where Mill Creek flows through the city.",
      "sourceSentenceIds": [
        26,
        28
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Summerville%2C_Oregon"
    },
    {
      "id": 6,
      "text": "Summerville experiences warm and dry summers, with average monthly temperatures that stay below 71.6 degrees Fahrenheit.",
