    {
      "id": 1,
      "text": "Argyroupoli means 'silver city,' a name Queen Olga of Greece gave it when the suburb was developed in the early 20th century.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 2"
      ],
