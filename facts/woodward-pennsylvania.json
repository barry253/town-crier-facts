  "facts": [
    {
      "id": 1,
      "text": "Woodward Township was carved out of Decatur Township in 1846 and named for Judge George W. Woodward.",
      "sourceSentenceIds": [
        3,
        29
      ],
      "sourceLabels": [
        "Web source 2",
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/woodward_township_clearfield_county_pennsylvania",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The township’s early economy was driven by lumber rafting on Moshannon Creek and sawmills like the first at Houtzville in 1854.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/woodward_township_clearfield_county_pennsylvania",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "A boom in bituminous coal followed when the Moshannon Branch Railroad reached the area in 1869, linking mines to broader markets.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/woodward_township_clearfield_county_pennsylvania",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Woodward sits in the rugged Appalachian Mountains, with valleys carved by Clearfield and Moshannon Creeks.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/woodward_township_clearfield_county_pennsylvania",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The State Correctional Institution – Houtzdale, housing about 2,300 inmates, sits within Woodward Township’s borders.",
      "sourceSentenceIds": [
        14
      ],
