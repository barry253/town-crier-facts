  "facts": [
    {
      "id": 1,
      "text": "Bayshore Gardens began in 1955 when a New York syndicate bought the land for about $2 million, the largest purchase in the area since the 1920s.",
      "sourceSentenceIds": [
        8,
        9,
        11
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Bayshore_Gardens%2C_Florida",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "By 1956, four model homes stood and seven designs—Seagrape, Gladiola, and Bird of Paradise—were ready for buyers.",
      "sourceSentenceIds": [
        13
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Bayshore_Gardens%2C_Florida",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The first home sold in July 1956 to Jennie and Samuel Gibson was a Hibiscus‑style house.",
      "sourceSentenceIds": [
        15
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Bayshore_Gardens%2C_Florida",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "In 1959, the Bayshore Gardens Shopping Center opened with a Publix, a beauty shop, and a movie theater.",
      "sourceSentenceIds": [
        19,
        21
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Bayshore_Gardens%2C_Florida",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Bayshore Gardens borders Sarasota Bay to the southwest and Bowlees Creek to the southeast, offering waterfront views.",
      "sourceSentenceIds": [
        22
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Bayshore_Gardens%2C_Florida",
      "category": "nature",
      "quality": "good"
    },
    {
