  "facts": [
    {
      "id": 1,
      "text": "Apple Canyon Lake was born in the late 1960s when the Branigar Organization of Medinah built a dam that created a 400‑acre reservoir.",
      "sourceSentenceIds": [
        2,
        8
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Apple_Canyon_Lake%2C_Illinois",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The original developers bought about 2,700 acres of steep, rocky pasture in Jo Daviess County, a land many farmers thought unusable.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Apple_Canyon_Lake%2C_Illinois",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Eighty‑five percent of the lake’s 15 miles of shoreline remains unsubdivided, preserving green space for future generations.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Apple_Canyon_Lake%2C_Illinois",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Each of the 2,200 vacation lots sold in 1969 ranged from half an acre to two acres, all with underground electric and phone service.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Apple_Canyon_Lake%2C_Illinois",
      "category": "other",
      "quality": "poor",
      "qualityReason": "vague"
    },
    {
      "id": 5,
      "text": "The lake’s surface covers roughly 480 acres, and its maximum depth reaches about 70 feet, making it one of the deeper reservoirs in northern Illinois.",
      "sourceSentenceIds": [
        21,
        22
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://lakefronthomefinder.com/lakes/apple-canyon-lake-il-2/",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Apple Canyon Lake was designed as a vacation community, a concept the Branigar Organization had already tested with Dutch Hollow Lake and Lake Redstone in Wisconsin.",
