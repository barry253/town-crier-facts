  "facts": [
    {
      "id": 1,
      "text": "Upper Marlboro was founded in 1706 as Marlborough Town, named after John Churchill, 1st Duke of Marlborough, whose arms appear on the town seal.",
      "sourceSentenceIds": [
        20
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Upper_Marlboro%2C_Maryland",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town’s original layout centered on the Western Branch of the Patuxent River, making it a key tobacco port in colonial Maryland.",
      "sourceSentenceIds": [
        11
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.tumhc.com/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Darnall’s Chance, a historic estate owned by Colonel Henry Darnall, later became the town’s first museum, opening to the public in 1988.",
      "sourceSentenceIds": [
        5,
        13
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Upper_Marlboro%2C_Maryland",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "In 1742, merchant James Wardrop purchased land from Eleanor Darnall Carroll, helping expand the early settlement that would become Upper Marlboro.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Upper_Marlboro%2C_Maryland",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The spelling shift from Upper Marlborough to Upper Marlboro began in the late 19th century, driven by a postal clerk’s practical concerns over stamp space.",
      "sourceSentenceIds": [
        21,
        22
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Upper_Marlboro%2C_Maryland",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Upper Marlboro’s historic district, covering about 100 acres, was listed on the National Register of Historic Places for its collection of fine 18th‑ and 19th‑century homes.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Web source 1"
      ],
