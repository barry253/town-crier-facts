  "facts": [
    {
      "id": 1,
      "text": "Callands takes its name from Samuel Calland, a Scottish immigrant whose 18th‑century general store became the town’s first gathering spot.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Callands%2C_Virginia",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The original one‑room brick store was restored by the Pittsylvania Historical Society, earning Virginia Landmark status in 1981.",
      "sourceSentenceIds": [
        2,
        3
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.pittsylvaniahistory.org/historical-sites",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Callands served as Pittsylvania County’s seat until 1776, with a courthouse likely built in 1772 on the site of the old store.",
      "sourceSentenceIds": [
        11,
        14
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Callands%2C_Virginia",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Before the Revolution, Callands was the seat of Antrim Parish, later Camden Parish, of Virginia’s established Church of England.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Callands%2C_Virginia",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The Callands Festival, an Autumn Potpourri celebration, drew visitors each October until it paused in 2019.",
      "sourceSentenceIds": [
        16
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Callands%2C_Virginia",
