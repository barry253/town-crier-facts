  "facts": [
    {
      "id": 1,
      "text": "Strabane was named after a town in Ireland to honor the Irish settlers who first arrived here.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://northstrabanetwp.com/224/History"
    },
    {
      "id": 2,
      "text": "Strabane Township was officially established on March 28, 1781, making it the twelfth of Washington County’s original townships.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://northstrabanetwp.com/224/History"
    },
    {
      "id": 3,
      "text": "In 1831 the original Strabane Township split into North and South Strabane, a division that still shapes local boundaries today.",
      "sourceSentenceIds": [
        13
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://northstrabanetwp.com/224/History"
    },
    {
      "id": 4,
      "text": "The first settlement in the area was likely John Froman’s mill at present‑day Linden, once called Beck’s Mills.",
      "sourceSentenceIds": [
        14
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://northstrabanetwp.com/224/History"
    },
    {
      "id": 5,
      "text": "John Morgan, a prominent early landowner, received a 600‑acre grant that included parts of what is now Strabane Township.",
      "sourceSentenceIds": [
        16
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://northstrabanetwp.com/224/History"
    },
    {
      "id": 6,
      "text": "A monument to Colonel George Morgan, an Indian agent and witness to Aaron Burr’s conspiracy, stands on the former George Joseph property at Murray Hill.",
      "sourceSentenceIds": [
        20
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://northstrabanetwp.com/224/History"
    }
  ]
