  "facts": [
    {
      "id": 1,
      "text": "Cuthbert was founded in 1831 as the seat of the newly formed Randolph County after the Indian Removal of local tribes.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Cuthbert%2C_Georgia",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The city is named for Colonel John Alfred Cuthbert, a Georgia congressman and judge who served in the U.S. House in the early 1800s.",
      "sourceSentenceIds": [
        9,
        27,
        28
      ],
      "sourceLabels": [
        "Web source 2",
        "Wikipedia"
      ],
      "source": "https://www.randolphcountyga.com/cuthbert",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Cuthbert is the birthplace of boxing legend Larry Holmes, who went on to become a world heavyweight champion.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.randolphcountyga.com/cuthbert",
      "category": "people",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The Randolph County Courthouse, built in 1898, sits in the historic downtown and is listed on the National Register of Historic Places.",
      "sourceSentenceIds": [
        16
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.cuthbertga.org/visit.cfm",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Andrew College’s Old Main, constructed in 1856, is one of the oldest academic buildings in Georgia and a centerpiece of the campus.",
      "sourceSentenceIds": [
        17
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.cuthbertga.org/visit.cfm",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "A museum dedicated to jazz pioneer Fletcher Henderson is being established in Cuthbert, honoring the musician’s ties to the town.",
      "sourceSentenceIds": [
        10
