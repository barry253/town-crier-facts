  "facts": [
    {
      "id": 1,
      "text": "Riverside is the first planned suburb in the United States, designed in 1869 by landscape architects Calvert Vaux and Frederick Law Olmsted.",
      "sourceSentenceIds": [
        28
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Riverside%2C_Illinois",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The Riverside Landscape Architecture District, bounded by 26th Street, Harlem and Ogden avenues, the Des Plaines River, and Golf Road, earned National Historic Landmark status in 1970.",
      "sourceSentenceIds": [
        8,
        9
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Riverside%2C_Illinois",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "A new historical plaque from the Illinois State Historical Society was unveiled in 2025, detailing Riverside’s origins as one of America’s first planned suburbs.",
      "sourceSentenceIds": [
        3,
        4,
        15
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.rblandmark.com/2025/12/16/riverside-recognized-historical-plaque/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The Riverside train station, former Henninger’s Pharmacy, and the Sidney Allen home at 84 Riverside Road served as filming locations for the movie The Lake House.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Riverside%2C_Illinois",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Riverside’s early civic life featured the 1893 Golf Club, the 1895 Chateauesque Township Hall, and the 1901 Burlington line train station.",
      "sourceSentenceIds": [
        25
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Riverside%2C_Illinois",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The village of Riverside was officially incorporated in 1875, just six years after its founding.",
      "sourceSentenceIds": [
        29
      ],
