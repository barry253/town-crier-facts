  "facts": [
    {
      "id": 1,
      "text": "Emden first appeared on maps as Dennison's Corner, a small settlement that sprang up in the late 1880s.",
      "sourceSentenceIds": [
        10,
        16
      ],
      "sourceLabels": [
        "Web source 1",
        "Web source 2"
      ],
      "source": "https://alchetron.com/Emden%2C-Missouri"
    },
    {
      "id": 2,
      "text": "In the early 1900s the community adopted the name Emden, after the German city of the same name.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Emden"
    },
    {
      "id": 3,
      "text": "Many of Emden's early settlers were German immigrants, a heritage that shaped the town’s culture.",
      "sourceSentenceIds": [
        11
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://kids.kiddle.co/Emden,_Missouri"
    },
    {
      "id": 4,
      "text": "The town’s renaming reflects a common American practice of honoring European hometowns.",
      "sourceSentenceIds": [
        11
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://kids.kiddle.co/Emden,_Missouri"
    },
    {
      "id": 5,
      "text": "Emden’s history mirrors the broader pattern of Midwestern towns founded by immigrant communities in the late 19th century.",
      "sourceSentenceIds": [
        11
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://kids.kiddle.co/Emden,_Missouri"
    },
    {
      "id": 6,
      "text": "Today, Emden remains a quiet Missouri community that preserves its German roots in local traditions.",
