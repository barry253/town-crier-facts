      "id": 1,
      "text": "Daphne earned the nickname “The Jubilee City” because it hosts one of Mobile Bay’s historic jubilee celebrations.",
      "sourceSentenceIds": [
        25
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
