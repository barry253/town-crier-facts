      "id": 1,
      "text": "Arlington began as the 1635 village of Menotomy, a Cambridge offshoot that later became its own town.",
      "sourceSentenceIds": [
        5,
        14
      ],
      "sourceLabels": [
        "Web source 1",
        "Web source 2"
      ],
      "source": "https://www.arlingtonma.gov/i-want-to/learn-about/arlington-history-facts",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town was renamed Arlington on April 30, 1867, honoring those buried in Arlington National Cemetery.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Arlington%2C_Massachusetts",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Arlington hosts the oldest continuously operated free children's library in the country, the Robbins Library.",
      "sourceSentenceIds": [
        30
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Arlington%2C_Massachusetts",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The historic Regent Theatre, built in 1916 for vaudeville, still hosts live performances and films.",
      "sourceSentenceIds": [
        19,
        25
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Arlington%2C_Massachusetts",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Arlington’s Mill Brook historically powered local mills, and the mill‑museum is on the National Register of Historic Places since 1971.",
      "sourceSentenceIds": [
