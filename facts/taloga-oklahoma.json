  "facts": [
    {
      "id": 1,
      "text": "Taloga incorporated as a community in 1906 and serves as the seat of Dewey County.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.okhistory.org/publications/enc/entry?entry=TA009"
    },
    {
      "id": 2,
      "text": "Taloga managed to remain the county seat despite never having had railroad access.",
      "sourceSentenceIds": [
        11
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.okhistory.org/publications/enc/entry?entry=TA009"
    },
    {
      "id": 3,
      "text": "The Dewey County courthouse building in Taloga, erected in 1925, is listed in the National Register of Historic Places.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.okhistory.org/publications/enc/entry?entry=TA009"
    },
    {
      "id": 4,
      "text": "Federal surveyors originally laid out the Taloga townsite on 320 acres before the town opened.",
      "sourceSentenceIds": [
        30
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.okhistory.org/publications/enc/entry?entry=TA009"
    },
    {
      "id": 5,
      "text": "Historic Sanborn fire insurance maps from 1907 and 1916 provide a visual record of early businesses in Taloga.",
      "sourceSentenceIds": [
        23
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://hometownhistorymaps.com/pages/history-of-taloga-oklahoma"
    },
    {
      "id": 6,
      "text": "Early commerce in Taloga included the Riggs General Store, which operated around 1908.",
