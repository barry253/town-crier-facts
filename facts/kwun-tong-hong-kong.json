  "facts": [
    {
      "id": 1,
      "text": "Kwun Tong’s original name, 官塘, literally means 'Mandarin Pond' and dates back to the Song dynasty salt‑yard era.",
      "sourceSentenceIds": [
        1,
        22
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Kwun_Tong"
    },
    {
      "id": 2,
      "text": "Since the 1950s, Kwun Tong has been a pioneer industrial district, hosting factories that shaped Hong Kong’s manufacturing boom.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Kwun_Tong"
    },
    {
      "id": 3,
      "text": "Between the 1970s and mid‑1980s, the south side of Kwun Tong Road became the city’s largest industrial area, churning out hardware, garments, electronics, plastics, wigs and household goods.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://had18.huluhk.org/article-history.php?region=17&lang=en"
    },
    {
      "id": 4,
      "text": "Devil’s Peak, once called Black Hill, now hosts historic ruins and is a favorite seafood spot along Lei Yue Mun.",
      "sourceSentenceIds": [
        4,
        8
      ],
      "sourceLabels": [
        "Web source 2",
        "Web source 1"
      ],
      "source": "https://had18.huluhk.org/article-history.php?region=17&lang=en"
    },
    {
      "id": 5,
      "text": "The Shui Wo Street Complex in Kwun Tong houses an indoor market, a public library and a sports hall, serving the local community.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Kwun_Tong"
    },
    {
      "id": 6,
      "text": "Kwun Tong MTR station sits directly above the road, making it a central transit hub for the district.",
