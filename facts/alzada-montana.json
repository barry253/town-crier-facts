  "facts": [
    {
      "id": 1,
      "text": "Alzada got its name from pioneer Laura Alzada Shelden when Stoneville officially became Alzada in 1885.",
      "sourceSentenceIds": [
        4,
        27
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Alzada%2C_Montana",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town began as a Little Missouri River telegraph station in 1877, staffed by soldiers of the 7th U.S. Cavalry.",
      "sourceSentenceIds": [
        15,
        16
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Alzada%2C_Montana",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Alzada served as a stagecoach stop between Deadwood and Miles City, linking frontier towns across the plains.",
      "sourceSentenceIds": [
        22
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Alzada%2C_Montana",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "In 1884, Alzada was the site of a gun battle between local authorities and the Axleby gang of rustlers.",
      "sourceSentenceIds": [
        14
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Alzada%2C_Montana",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The first saloon opened in 1877, built by settler M. Stone, who also ran the town’s first store.",
      "sourceSentenceIds": [
        16
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.mtmemory.org/nodes/view/127425",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Alzada lies on the Little Missouri River, which flows northward just west of the community.",
