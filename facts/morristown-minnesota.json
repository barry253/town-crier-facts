      "id": 1,
      "text": "Morristown was platted in 1855 and named for pioneer settler Walter Morris.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Morristown%2C_Minnesota"
    },
    {
      "id": 2,
      "text": "The Morristown Historical Society, founded in 1989, preserves local stories and artifacts.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.ci.morristown.mn.us/historical-society"
    },
    {
      "id": 3,
      "text": "In 2019, the Morristown Feed Mill earned a spot on the National Register of Historic Places.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.ci.morristown.mn.us/historical-society"
    },
    {
      "id": 4,
      "text": "The town sits on the southern bank of the Cannon River, shaping its early economy.",
      "sourceSentenceIds": [
        15
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Morristown%2C_Minnesota"
    },
    {
      "id": 5,
      "text": "A one-room schoolhouse, gifted to the Historical Society in 2010, now serves as a museum.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.ci.morristown.mn.us/historical-society"
    },
    {
