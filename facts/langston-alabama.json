  "facts": [
    {
      "id": 1,
      "text": "Langston got its name from early settler Langston Coffee, who served as the town’s first postmaster.",
      "sourceSentenceIds": [
        3,
        18
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Langston%2C_Alabama",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "In 1810 white settlers founded a township that would later be called Coffeetown after the Coffee brothers.",
      "sourceSentenceIds": [
        4,
        17
      ],
      "sourceLabels": [
        "Web source 1",
        "Wikipedia"
      ],
      "source": "https://encyclopediaofalabama.org/article/langston/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Langston once thrived as a bustling river port on the Tennessee River, boasting nine stores and a blacksmith.",
      "sourceSentenceIds": [
        20
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Langston%2C_Alabama",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The arrival of railroads and automobiles in the late 19th and early 20th centuries ended river trade and spurred Langston’s decline.",
      "sourceSentenceIds": [
        5,
        7
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Langston%2C_Alabama",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The historic Captain Jackson-Bottomlee House in Langston is listed on the Alabama Register of Landmarks and Heritage.",
      "sourceSentenceIds": [
        14
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.atlasalabama.gov/municipalities/langston/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Langston sits on the eastern shore of the Tennessee River, just upstream of Guntersville Lake formed by the dam.",
