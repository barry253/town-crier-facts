      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Northborough’s public library, founded in 1868, has served residents for over 150 years and still offers a wide range of digital and physical resources.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
