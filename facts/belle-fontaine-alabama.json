    },
    {
      "id": 2,
      "text": "Belle Fontaine first appeared on maps in 1814 and 1850, with variant spellings like “Belfont,” reflecting early survey challenges.",
      "sourceSentenceIds": [
        9,
        10,
        11
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/belle_fontaine_baldwin_county_alabama"
    },
    {
      "id": 3,
      "text": "The town is a ghost site with no formal boundaries, its historical extent loosely tied to rural lands near Bay Minette and Gateswood.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/belle_fontaine_baldwin_county_alabama"
    },
    {
      "id": 4,
      "text": "Belle Fontaine lies at 30°42′32″N 87°33′13″W, placing it in northeastern Baldwin County within the Central Time Zone.",
      "sourceSentenceIds": [
        21,
