  "facts": [
    {
      "id": 1,
      "text": "Lancaster, Virginia, became the county seat in 1742, and its courthouse green still echoes that early colonial layout.",
      "sourceSentenceIds": [
        20
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.virginiasriverrealm.com/places/lancaster-virginia-historical-society/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The Lancaster Virginia Historical Society, founded in 1958, was originally called the Mary Ball Washington Museum & Library.",
      "sourceSentenceIds": [
        1,
        9
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.virginiasriverrealm.com/places/lancaster-virginia-historical-society/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The 1797 Clerk of Court Office and the 1820s Old Jail are part of the museum complex that showcases Lancaster’s early civic life.",
      "sourceSentenceIds": [
        19
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.virginiasriverrealm.com/places/lancaster-virginia-historical-society/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Belle Isle and the Lancaster Court House Historic District earned spots on the National Register of Historic Places, preserving the town’s architectural heritage.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Lancaster%2C_Virginia",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Lancaster lies along Virginia State Route 3, about 7 miles northwest of Kilmarnock, the county’s largest community.",
      "sourceSentenceIds": [
        11
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Lancaster%2C_Virginia",
