  "facts": [
    {
      "id": 1,
      "text": "Oak Island sits eight miles south of Anahuac, between the east and west forks of the Double Bayou in central Chambers County.",
      "sourceSentenceIds": [
        2,
        6,
        20,
        21
      ],
      "sourceLabels": [
        "Web source 1",
        "Web source 2",
        "Wikipedia"
      ],
      "source": "https://www.tshaonline.org/handbook/entries/oak-island-tx-chambers-county"
    },
    {
      "id": 2,
      "text": "The community’s name comes from an island of oak trees near the bayou’s mouth, a feature that once marked the area.",
      "sourceSentenceIds": [
        2,
        6
      ],
      "sourceLabels": [
        "Web source 1",
        "Web source 2"
      ],
      "source": "https://www.tshaonline.org/handbook/entries/oak-island-tx-chambers-county"
    },
    {
      "id": 3,
      "text": "In 1880 Joshua Harmon moved a cotton gin across the bay, a move that later helped shape the area’s early economy.",
      "sourceSentenceIds": [
        4,
        7
      ],
      "sourceLabels": [
        "Web source 1",
        "Web source 2"
      ],
      "source": "https://www.tshaonline.org/handbook/entries/oak-island-tx-chambers-county"
    },
    {
      "id": 4,
      "text": "Oak Island was officially founded in 1951 by real‑estate developers Charles Troy and R., marking its transition from a fishing camp to a planned community.",
      "sourceSentenceIds": [
        4,
        7
      ],
      "sourceLabels": [
        "Web source 1",
        "Web source 2"
      ],
      "source": "https://www.tshaonline.org/handbook/entries/oak-island-tx-chambers-county"
    },
    {
      "id": 5,
      "text": "A municipal water system arrived in 1966, providing residents with reliable water after decades of relying on wells and cisterns.",
      "sourceSentenceIds": [
        28
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.tshaonline.org/handbook/entries/oak-island-tx-chambers-county"
    },
    {
      "id": 6,
      "text": "Hurricane Ike in 2008 devastated Oak Island, rendering about 90 % of homes uninhabitable and prompting a major rebuilding effort.",
      "sourceSentenceIds": [
        22
      ],
