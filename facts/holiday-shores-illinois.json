  "facts": [
    {
      "id": 1,
      "text": "Holiday Shores surrounds a 430‑acre man‑made lake with 17 miles of shoreline, built to offer residents a private waterway.",
      "sourceSentenceIds": [
        19
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.holidayshores.us/"
    },
    {
      "id": 2,
      "text": "The lake’s dam stretches 900 feet long and rises 45 feet, holding back the reservoir that defines the community.",
      "sourceSentenceIds": [
        20
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.holidayshores.us/"
    },
    {
      "id": 3,
      "text": "The development includes roughly 1,900 lots and nearly 27 miles of roads winding through the wooded landscape.",
      "sourceSentenceIds": [
        21
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.holidayshores.us/"
    },
    {
      "id": 4,
      "text": "All electricity, water, and natural gas lines run underground, a design choice meant to keep the area’s natural beauty intact.",
      "sourceSentenceIds": [
        22
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.holidayshores.us/"
    },
    {
      "id": 5,
      "text": "Holiday Shores sits at latitude 38.922 and longitude –89.9407, placing it in northern Madison County, Illinois.",
      "sourceSentenceIds": [
        24
      ],
      "sourceLabels": [
        "Web source 2"
      ],
