  "facts": [
    {
      "id": 1,
      "text": "Paris, Texas was named after Paris, France by employee Thomas Poteet in the mid‑19th century.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://visitparis-tx.com/history"
    },
    {
      "id": 2,
      "text": "In 1993 the town erected a 65‑foot replica of the Eiffel Tower, topped with a red cowboy hat, on the Love Civic Center site.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Paris%2C_Texas"
    },
    {
      "id": 3,
      "text": "The city was founded in 1840 when the Fifth Congress created Lamar County, and Paris became its county seat.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Paris%2C_Texas"
    },
    {
      "id": 4,
      "text": "Paris became a railroad hub in the late 19th century, with the Texas and Pacific arriving in 1876 and the Frisco in 1887.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Paris%2C_Texas"
    },
    {
      "id": 5,
      "text": "The 1985 film “Paris, Texas” directed by Wim Wenders brought national attention to the town.",
      "sourceSentenceIds": [
        29
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://visitparistexas.com/about-paris-texas/"
    },
    {
      "id": 6,
      "text": "The downtown square, called The Plaza, has long been the center of community life since the town’s early days.",
      "sourceSentenceIds": [
