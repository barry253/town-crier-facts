    {
      "id": 1,
      "text": "Mannsville grew around a salt lick first discovered by Revolutionary War veteran Moses Mann, giving the town its original name, Manns Lick.",
      "sourceSentenceIds": [
        8,
        25
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
