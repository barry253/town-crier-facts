      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The Mann brothers settled the area before 1800, making Mannsville one of Taylor County’s earliest permanent communities.",
      "sourceSentenceIds": [
        1,
        11
      ],
      "sourceLabels": [
        "Web source 2",
        "Web source 1"
      ],
      "source": "https://kyatlas.com/ky-mannsville.html",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The town experiences a humid subtropical climate, averaging 48 inches of rain yearly with hot, humid summers.",
      "sourceSentenceIds": [
        18,
        20
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/mannsville_kentucky",
