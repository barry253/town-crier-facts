  "facts": [
    {
      "id": 1,
      "text": "Henderson takes its name from 18th‑century pioneer Richard Henderson, a land speculator who helped shape early Kentucky.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Henderson%2C_Kentucky"
    },
    {
      "id": 2,
      "text": "The city sits where the Green and Ohio rivers meet, a historic confluence that helped its early growth.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Henderson%2C_Kentucky"
    },
    {
      "id": 3,
      "text": "Metzger's Tavern, founded in 1887, remains Kentucky’s oldest continuously operating tavern, a living slice of frontier hospitality.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Henderson%2C_Kentucky"
    },
    {
      "id": 4,
      "text": "Henderson’s first bank opened in 1818, followed by the Old Union Church in 1825, marking the town’s early civic life.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.hendersonky.gov/141/History-of-Henderson"
    },
    {
      "id": 5,
      "text": "Four Kentucky governors once called Henderson home, underscoring the city’s early political significance.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.hendersonky.gov/141/History-of-Henderson"
    },
    {
      "id": 6,
      "text": "In 1991, scenes from the film A League of Their Own were shot on Main Street, giving Henderson a Hollywood moment.",
