  "facts": [
    {
      "id": 1,
      "text": "Chappell Hill was founded in 1849 by Mary Elizabeth Haller on 100 acres she purchased, opening a post office two years earlier.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Chappell_Hill%2C_Texas",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town was named after Mary Haller’s maternal grandfather, Robert Wooding Chappell, an early settler.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.tshaonline.org/handbook/entries/chappell-hill-tx",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "In 1859 the Washington County Railroad reached Chappell Hill, turning it into a regional distribution center.",
      "sourceSentenceIds": [
        17
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.tshaonline.org/handbook/entries/chappell-hill-tx",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The Chappell Hill Historical Society, founded in 1964, preserves the town’s heritage and operates a museum.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.tshaonline.org/handbook/entries/chappell-hill-tx",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Every July, Chappell Hill hosts Texas’s biggest small‑town parade, drawing crowds to its historic downtown.",
