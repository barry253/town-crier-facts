  "facts": [
    {
      "id": 1,
      "text": "Arthurdale was named for Richard Arthur, the former landowner who sold the property to the federal government under a tax default.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Arthurdale%2C_West_Virginia"
    },
    {
      "id": 2,
      "text": "First Lady Eleanor Roosevelt used her influence to win government approval for the creation of the Arthurdale community in 1933.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Arthurdale%2C_West_Virginia"
    },
    {
      "id": 3,
      "text": "Arthurdale began as a Great Depression social experiment to provide opportunities for unemployed local miners and farmers to become self-sufficient.",
      "sourceSentenceIds": [
        27,
        28
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Arthurdale%2C_West_Virginia"
    },
    {
      "id": 4,
      "text": "The project is generally remembered as a failure due to a clash of ideologies regarding professional governance and community needs.",
      "sourceSentenceIds": [
        29,
        30
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Arthurdale%2C_West_Virginia"
    },
    {
      "id": 5,
      "text": "Sterling Faucet company was the only industry to maintain a long-term presence in the community after other manufacturers failed.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
