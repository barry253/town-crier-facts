  "facts": [
    {
      "id": 1,
      "text": "Green Brook Township became an official municipality on November 8, 1932, after a local referendum replaced North Plainfield Township.",
      "sourceSentenceIds": [
        23
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Green_Brook_Township%2C_New_Jersey",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The township takes its name from the Green Brook stream that rises in the Watchung Mountains and travels 15 miles south‑west.",
      "sourceSentenceIds": [
        30
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Green_Brook_Township%2C_New_Jersey",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The Green Brook Historical Society collects and archives documents, photographs, and artifacts to educate residents about the township’s rich past.",
      "sourceSentenceIds": [
        2,
        3
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.gbhsnj.org/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The planned Green Brook History Trail will connect two Revolutionary War beacon sites, Washington Rock State Park, and a pre‑revolutionary copper mine.",
      "sourceSentenceIds": [
        15,
        16,
        17
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.gbhsnj.org/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The Vail‑Trust House on Greenbrook Road, listed on the National and State Register of Historic Places, is currently being restored by a preservation project.",
      "sourceSentenceIds": [
        7,
        9,
        10
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.gbhsnj.org/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Locally dubbed the “Emerald City,” Green Brook markets itself with the slogan “Small Enough to Know You, Large Enough to Get Things Done.”.",
      "sourceSentenceIds": [
        18,
        24
      ],
