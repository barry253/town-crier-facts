  "facts": [
    {
      "id": 1,
      "text": "Oakley was established around 1900 as a company-owned coal camp to support underground mining for the Union Pacific Railroad.",
      "sourceSentenceIds": [
        2,
        9
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/oakley_wyoming"
    },
    {
      "id": 2,
      "text": "Mine superintendent Thomas Sneddon named Oakley after his birthplace in Oakley, Fifeshire, Scotland.",
      "sourceSentenceIds": [
        1,
        3
      ],
      "sourceLabels": [
        "Web source 1",
        "Web source 2"
      ],
      "source": "https://www.wyomingtalesandtrails.com/oakley.html"
    },
    {
      "id": 3,
      "text": "Japanese miners were a significant part of the workforce in Oakley and other nearby coal camps during the early 1900s.",
      "sourceSentenceIds": [
        2,
        26,
        27
      ],
      "sourceLabels": [
        "Web source 1",
        "Web source 2"
      ],
      "source": "https://www.wyomingtalesandtrails.com/oakley.html"
    },
    {
      "id": 4,
      "text": "Oakley is situated along Ham's Fork, a tributary of the Green River that supports sparse vegetation in the semi-arid landscape.",
      "sourceSentenceIds": [
        6,
        9
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/oakley_wyoming"
    },
    {
      "id": 5,
      "text": "Early Japanese immigrants in Oakley lived in separate sections of the mining camps and were initially excluded from local unions.",
      "sourceSentenceIds": [
