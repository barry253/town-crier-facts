  "facts": [
    {
      "id": 1,
      "text": "Lake Dalecarlia was created in 1928 by damming Cedar Creek over 2,100 acres of farmland, becoming a reservoir.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/lake_dalecarlia_indiana"
    },
    {
      "id": 2,
      "text": "The lake’s name honors Sweden’s Dalarna province, chosen by Swedish immigrant stockholders in a 1929 vote.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/lake_dalecarlia_indiana"
    },
    {
      "id": 3,
      "text": "The reservoir sits on Cedar Creek, a south‑flowing tributary of the Kankakee River, part of the Illinois River watershed.",
      "sourceSentenceIds": [
        13
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Lake_Dalecarlia%2C_Indiana"
    },
    {
      "id": 4,
      "text": "The area was originally inhabited by the Potawatomi people before European‑American settlement.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/lake_dalecarlia_indiana"
    },
    {
      "id": 5,
      "text": "The lake’s water is fed by natural springs, surface runoff from the surrounding moraine, and Cedar Creek inflows, with a dam regulating outflow.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/lake_dalecarlia_indiana"
    },
    {
      "id": 6,
      "text": "The entire property is private; all water, parks, drives, and playgrounds are reserved for Lake Dalecarlia property owners.",
      "sourceSentenceIds": [
        7
