  "facts": [
    {
      "id": 1,
      "text": "Jacksonville was founded during the gold rush of 1851 following the discovery of gold deposits in the area.",
      "sourceSentenceIds": [
        2,
        24
      ],
      "sourceLabels": [
        "Web source 2",
        "Wikipedia"
      ],
      "source": "https://jacksonvilleoregon.org/about-jacksonville-oregon/"
    },
    {
      "id": 2,
      "text": "Jacksonville was originally named Table Rock City because of the view of two mesas about ten miles away.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://jacksonvilleoregon.org/history/"
    },
    {
      "id": 3,
      "text": "Jacksonville is home to the first Chinatown in Oregon, which was founded by immigrants from San Francisco.",
      "sourceSentenceIds": [
        25
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Jacksonville%2C_Oregon"
    },
    {
      "id": 4,
      "text": "Jacksonville was designated a National Historic Landmark in 1966 as an intact example of a late 1800s gold-boom town.",
      "sourceSentenceIds": [
        22
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://jacksonvilleoregon.org/about-jacksonville-oregon/"
    },
    {
      "id": 5,
      "text": "The town of Jacksonville was preserved in a quiet period after the railroad bypassed the community.",
      "sourceSentenceIds": [
