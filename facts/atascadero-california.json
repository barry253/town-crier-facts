  "facts": [
    {
      "id": 1,
      "text": "Founded in 1913 by magazine publisher Edward Gardner Lewis, Atascadero was planned as a utopian colony.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Atascadero%2C_California",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The historic City Hall, built 1914‑1918 with local clay bricks, features a 40‑foot dome that once housed the library.",
      "sourceSentenceIds": [
        2,
        3
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Atascadero%2C_California",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Atascadero’s City Hall was used as a film set in 1990’s “My Blue Heaven,” where Steve Martin’s character signed paperwork.",
      "sourceSentenceIds": [
        17
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Atascadero%2C_California",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The Union Pacific Coast Line runs through town, carrying Amtrak’s Coast Starlight and connecting Atascadero to San Luis Obispo and Paso Robles.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Atascadero%2C_California",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The city’s name comes from Spanish “atascadero,” meaning “mire,” reflecting the area’s wetland history.",
      "sourceSentenceIds": [
        24
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Atascadero%2C_California",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "In 2003, a 6.6‑meter San Simeon earthquake damaged the historic City Hall, prompting restoration efforts.",
