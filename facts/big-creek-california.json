      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town’s only school serves kindergarten through eighth grade, reflecting its small, close‑knit community.",
      "sourceSentenceIds": [
        16
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Big_Creek%2C_California",
