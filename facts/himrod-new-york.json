  "facts": [
    {
      "id": 1,
      "text": "Wilhemus Himrod opened the first store at a four‑corner intersection in the early 1800s, and the community was renamed Himrod’s Corners in his honor.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/himrod_new_york",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Himrod sits at 797 feet on Seneca Lake’s western shore, where the lake’s thermal mass moderates local temperatures and shapes microclimates for farming.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/himrod_new_york",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The area encompassing modern‑day Himrod was originally part of the territory inhabited by the Seneca Nation, a member of the Haudenosaunee Confederacy.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/himrod_new_york",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Himrod’s economy centers on estate wineries, u‑pick orchards, and tourism along Route 14, the historic Warrior’s Path, where visitors enjoy boating and hiking.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/himrod_new_york",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The Northern Central Railroad arrived mid‑century, boosting connectivity and allowing Himrod farmers to ship goods farther.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/himrod_new_york",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Grove Mount and Himrod Pioneer Cemeteries, founded in 1876 and 1798 respectively, showcase the hamlet’s pioneer heritage and early settler families.",
      "sourceSentenceIds": [
        15
      ],
      "sourceLabels": [
        "Web source 1"
      ],
