        24
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.cityneighborhoods.nyc/westchester-square",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Westchester Creek and nearby parks have been reclaimed, restoring a waterfront identity that echoes the neighborhood’s colonial origins.",
      "sourceSentenceIds": [
        25
      ],
      "sourceLabels": [
