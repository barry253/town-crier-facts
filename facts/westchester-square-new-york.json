      ],
      "source": "https://www.cityneighborhoods.nyc/westchester-square",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The Huntington Free Library, a non‑circulating private library at 9 Westchester Square, houses a rich collection of local history.",
      "sourceSentenceIds": [
        20
