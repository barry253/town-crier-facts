  "facts": [
    {
      "id": 1,
      "text": "Pyrmont was named after a cold‑water spring in Bad Pyrmont, Germany, because early settlers found a similar spring on the peninsula.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Wikipedia"
