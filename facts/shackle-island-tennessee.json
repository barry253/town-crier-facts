  "facts": [
    {
      "id": 1,
      "text": "Shackle Island earned its name in 1797 when surveyor William Lytle noted a sweet gum, honey locust, and elm standing on an island in Drake's Creek.",
      "sourceSentenceIds": [
        6,
        7,
        8,
        9
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Shackle_Island%2C_Tennessee",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The island was formed when Drake's Creek split into two channels, creating a small landmass that later recombined, leaving only a faint eastern branch today.",
      "sourceSentenceIds": [
        12,
        13,
        14,
        15
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Shackle_Island%2C_Tennessee",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Pioneer settlers, many Revolutionary War veterans, crossed the Cumberland Mountains via creeks like Drakes and Manskers to reach the Cumberland River and farm Shackle Island.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/shackle_island_tennessee",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "A 19th‑century distillery operated beside a farm, sawmill, and gristmill on Shackle Island, supplying medicinal whiskey to settlers.",
      "sourceSentenceIds": [
        18,
        19,
        20
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Shackle_Island%2C_Tennessee",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Today, Shackle Island balances its agrarian roots with modern housing and a county school while preserving open farmlands and historic sites amid Nashville’s growth.",
      "sourceSentenceIds": [
        1
      ],
