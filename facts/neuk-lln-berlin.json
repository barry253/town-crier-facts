  "facts": [
    {
      "id": 1,
      "text": "Neukölln’s nightlife roots trace back to the 16th‑century Rollkrug tavern near Hermannplatz, a launchpad for the district’s corner‑pub scene.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Neuk%C3%B6lln_(locality)",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Neukölln hosts a large number of Sunni mosques, most originally founded for the district’s Turkish Muslim community.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Neuk%C3%B6lln_(locality)",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The beer hall Neue Welt, founded as a garden in 1865, became today’s Huxleys Neue Welt concert venue on Hasenheide near Hermannplatz.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Neuk%C3%B6lln_(locality)",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The historic Neukölln Water Tower, built in 1928 on the Rollberg hill, now serves as a landmark overlooking the district’s eastern edge.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Neuk%C3%B6lln_(locality)",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Neukölln’s three historic cinemas—Neues Off, Passage, and Rollberg Kinos—trace their roots back to a 1919 vaudeville theater, a 1910 movie house, and a 1996 revival.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Neuk%C3%B6lln_(locality)",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The Neukölln–Mittenwald railroad, a single‑track line, still operates north of Berlin for industrial transport, linking the district to the city’s outskirts.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Neuk%C3%B6lln_(locality)",
