  "facts": [
    {
      "id": 1,
      "text": "New Salem was first settled around 1871 in Richland Township after the Osage Indian Reservation was reduced, opening southern Kansas to white settlers.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/new_salem_kansas",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town grew into a rural hub when the Atchison, Topeka & Santa Fe Railroad ran through it, offering express and telegraph services in the late 1800s.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/new_salem_kansas",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "A post office opened in New Salem in 1872 and stayed in operation until it closed in 1972, marking a century of community service.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/New_Salem%2C_Kansas",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The community’s name comes from the biblical city of Salem, chosen to symbolize peace for its early settlers.",
      "sourceSentenceIds": [
        27
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/new_salem_kansas",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "New Salem experiences a humid subtropical climate, with July highs around 92°F and January lows near 26°F, creating a wide temperature swing.",
      "sourceSentenceIds": [
