  "facts": [
    {
      "id": 1,
      "text": "Garner began when the North Carolina Railroad arrived in 1847, turning a rural area into a growing settlement.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.garnernc.gov/about-us/overview-of-town-history",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town was officially incorporated as Garner’s Station in 1883 after a post office opened in 1878, and later renamed Garner in 1905 when the depot was built.",
      "sourceSentenceIds": [
        2,
        11,
        14,
        30
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.garnernc.gov/about-us/overview-of-town-history",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Henry Fort, an African‑American cabinetmaker, bought 52 acres north of the tracks in 1874 and later sold parcels to other Black families, helping shape early Garner neighborhoods.",
      "sourceSentenceIds": [
        12,
        13
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.garnernc.gov/about-us/overview-of-town-history",
      "category": "people",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The historic Garner Depot, now a museum, is home to a red caboose that the community is restoring as part of its heritage preservation.",
      "sourceSentenceIds": [
