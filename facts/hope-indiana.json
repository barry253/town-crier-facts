  "facts": [
    {
      "id": 1,
      "text": "Hope was originally named Goshen after the Biblical land, but a 1834 post office forced a change to Hope because another Indiana town already had that name.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Hope%2C_Indiana",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town’s Yellow Trail Museum, opened in 1975, preserves artifacts donated by residents and chronicles Hope’s Moravian roots dating back to 1830.",
      "sourceSentenceIds": [
        3,
        19
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 2"
      ],
      "source": "https://en.wikipedia.org/wiki/Hope%2C_Indiana",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Hope’s town square hosts a bandstand, a historic library designed by Deborah Berke, and a community museum that showcases local history.",
      "sourceSentenceIds": [
        8,
        25
      ],
      "sourceLabels": [
        "Web source 1",
        "Web source 1"
      ],
      "source": "https://comeseecolumbus.com/things-to-do/hope-indiana/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Every September, Hope celebrates Heritage Days on the last full weekend, featuring reenactments at the one‑room Simmons School built in 1879.",
      "sourceSentenceIds": [
        15,
        16
      ],
      "sourceLabels": [
        "Wikipedia",
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Hope%2C_Indiana",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The town’s annual Old‑Fashioned Fourth of July parade includes a display of barn quilts, a Pennsylvania Dutch folk art tradition brought to Hope by early settlers.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Hope%2C_Indiana",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Hope’s Actors Studio of Hope stages dinner theater productions in the Willow Leaves venue, a café that doubles as a cultural hub on the town square.",
      "sourceSentenceIds": [
        10,
