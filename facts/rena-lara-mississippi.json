  "facts": [
    {
      "id": 1,
      "text": "Rena Lara began as Renalara in 1895, renamed Rena Lara in 1940, and its post office still operates.",
      "sourceSentenceIds": [
        1,
        3
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/rena_lara_mississippi",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Rena Lara sat on the Riverside Division of the Yazoo and Mississippi Valley Railroad, a line that linked the Delta to Memphis.",
      "sourceSentenceIds": [
        5,
        6,
        8,
        9,
        10
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Rena_Lara%2C_Mississippi",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Founded amid the late‑19th‑century cotton boom, Rena Lara grew as planters cleared the Delta’s fertile soils, owning over 546,000 acres by 1892.",
      "sourceSentenceIds": [
        7,
        11,
        25
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/rena_lara_mississippi",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Floods prompted the 1928 Flood Control Act, leading to levee construction that turned swamplands into cotton fields, though breaches still plagued the area.",
      "sourceSentenceIds": [
        14,
        26,
        27,
        28
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/rena_lara_mississippi",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "After WWII, the Y&MV merged into the Illinois Central, ending passenger service and shifting freight to trucks.",
      "sourceSentenceIds": [
        15
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/rena_lara_mississippi",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The Mississippi River’s flood‑prone lowlands forced early settlers to build on higher levees, shaping Rena Lara’s layout.",
      "sourceSentenceIds": [
        16
      ],
