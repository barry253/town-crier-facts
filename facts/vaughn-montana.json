  "facts": [
    {
      "id": 1,
      "text": "Vaughn is named for Welsh pioneer Robert Vaughn, who filed the first homestead in Chouteau County in 1869.",
      "sourceSentenceIds": [
        3,
        4,
        16,
        17,
        18,
        19
      ],
      "sourceLabels": [
        "Web source 2",
        "Wikipedia"
      ],
      "source": "https://roamingmontana.com/vaughn/",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Robert Vaughn was born June 5, 1836 in the Welsh village of Dinas Mawddwy, Merionethshire.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://roamingmontana.com/vaughn/"
    },
    {
      "id": 3,
      "text": "In 1890, Captain Thomas Couch bought Vaughn's ranch and in 1910 he platted a town that would become Vaughn.",
      "sourceSentenceIds": [
        23,
        9
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Vaughn%2C_Montana",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The Great Falls & Canada Railway, a 3‑foot narrow‑gauge line built in 1890, ran from the Canada‑US border to a terminus beside the Vaughn Ranch.",
      "sourceSentenceIds": [
        24
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Vaughn%2C_Montana",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The Sun River passes just south of Vaughn, meeting the Missouri roughly nine miles downstream.",
      "sourceSentenceIds": [
