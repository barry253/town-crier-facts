  "facts": [
    {
      "id": 1,
      "text": "Deer Creek was founded on March 14, 1898, when the Gulf Railroad built a line between Medford and Blackwell that passed through the new town.",
      "sourceSentenceIds": [
        24,
        11
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.okhistory.org/publications/enc/entry?entry=DE005",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town’s name comes from a nearby tributary of the Salt Fork of the Arkansas River, which flows just north of the community.",
      "sourceSentenceIds": [
        23,
        24
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Deer_Creek%2C_Oklahoma",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The Deer Creek General Merchandise Store, erected in the early 1900s, earned a spot on the National Register of Historic Places for its well‑preserved architecture.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.okhistory.org/publications/enc/entry?entry=DE005",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "In the 1950s Deer Creek boasted a lumberyard, an automobile dealer and garage, three gasoline stations, and two grain elevators, a bustling hub for the surrounding farms.",
      "sourceSentenceIds": [
        22
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.okhistory.org/publications/enc/entry?entry=DE005",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Mennonites organized in Deer Creek on August 27, 1899, and opened their church in 1902, adding a distinctive religious tradition to the town’s early history.",
      "sourceSentenceIds": [
        28
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Deer_Creek%2C_Oklahoma",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "By 1909 both Christian and Methodist churches were standing in Deer Creek, reflecting the community’s early religious diversity.",
