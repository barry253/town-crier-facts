      "id": 1,
      "text": "Cooperstown sprang to life in 1882 when settlers laid out the town on October 26, right before the railroad arrived.",
      "sourceSentenceIds": [
        1,
        2
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
