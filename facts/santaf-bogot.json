  "facts": [
    {
      "id": 1,
      "text": "Santafé was founded on 6 August 1538 as Nuestra Señora de la Esperanza by conquistador Gonzalo Jiménez de Quesada.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Bogot%C3%A1",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Before colonization, the Muisca called the area where Santafé now stands “Thybzaca,” meaning Old Town.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Bogot%C3%A1",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The flag of Santafé traces back to the 1810 insurgency, when rebels wore yellow‑red armbands mirroring the Spanish flag of the New Kingdom of Granada.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Bogot%C3%A1",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The Founders and New Kingdom of Granada room in Santafé displays rich iconography of liberators and Spanish authorities, plus oils that chronicle Colombia’s painting history.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://en.wikivoyage.org/wiki/Bogot%C3%A1/Santa_F%C3%A9-Los_M%C3%A1rtires",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "In 2007, Santafé earned the title World Book Capital from UNESCO, highlighting its literary heritage.",
      "sourceSentenceIds": [
        14
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Bogot%C3%A1",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The Central University, founded in 1867, was the first state school in Santafé and the precursor to today’s National University.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Bogot%C3%A1",
