  "facts": [
    {
      "id": 1,
      "text": "Lemmon Valley takes its name from Fielding Lemmon, an early settler who founded a ranch there in the 1860s.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/lemmon_valley_nevada",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The valley’s original Peavine Ranch, later called the Fielding‑Hixson‑Anderson Ranch, was listed on the National Register of Historic Places in 2000.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/lemmon_valley_nevada",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "In 1862, Lemmon transformed the Peavine Ranch into a key stop for emigrants traveling along western routes.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/lemmon_valley_nevada",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "During Nevada’s territorial era, Lemmon Valley extended ranching north of Reno, contributing to Washoe County’s agricultural history.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/lemmon_valley_nevada",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Lemmon Valley sits about 10 miles north of downtown Reno, within the Reno–Sparks Metropolitan Statistical Area.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Lemmon_Valley%2C_Nevada",
      "category": "other",
      "quality": "poor",
      "qualityReason": "location_description"
    },
    {
      "id": 6,
      "text": "Lemmon Valley offers a quiet retreat while still giving easy access to Reno’s amenities, making it a peaceful northern suburb.",
      "sourceSentenceIds": [
        17
      ],
