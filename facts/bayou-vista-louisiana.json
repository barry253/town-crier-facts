    {
      "id": 1,
      "text": "Acadian exiles settled the area in the late 1700s, naming it Bayou Vista after the surrounding bayous.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 2"
      ],
