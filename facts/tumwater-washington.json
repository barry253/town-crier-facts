  "facts": [
    {
      "id": 1,
      "text": "Tumwater’s name comes from the Chinook Jargon word “tumwata,” meaning waterfall, a nod to the town’s iconic falls.",
      "sourceSentenceIds": [
        2,
        30
      ],
      "sourceLabels": [
        "Web source 2",
        "Wikipedia"
      ],
      "source": "https://www.experienceolympia.com/our-communities/tumwater/",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The city was founded in 1845 and originally called New Market by early settlers.",
      "sourceSentenceIds": [
        1,
        7
      ],
      "sourceLabels": [
        "Web source 1",
        "Wikipedia"
      ],
      "source": "https://www.ci.tumwater.wa.us/visitors/our-history",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Tumwater is the oldest permanent Anglo‑American settlement on Puget Sound, dating back to the mid‑1800s.",
      "sourceSentenceIds": [
        13,
        28
      ],
      "sourceLabels": [
        "Web source 1",
        "Wikipedia"
      ],
      "source": "https://www.ci.tumwater.wa.us/visitors/our-history",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Tumwater Falls has shaped the town’s history, powering a thriving brewery and drawing visitors to Brewery Park.",
      "sourceSentenceIds": [
        14,
        21
      ],
      "sourceLabels": [
        "Web source 1",
        "Web source 2"
      ],
      "source": "https://www.ci.tumwater.wa.us/visitors/our-history",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The Olympia Brewing Company, founded in Tumwater, once operated a landmark six‑story brewhouse that opened in 1905.",
      "sourceSentenceIds": [
        3,
        15
      ],
      "sourceLabels": [
        "Web source 1"
