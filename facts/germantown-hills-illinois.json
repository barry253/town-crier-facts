  "facts": [
    {
      "id": 1,
      "text": "Germantown Hills was first settled in the 1830s by German immigrants who named the area after their homeland and the rolling hills of the region.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.trawellino.com/destinations/united-states/illinois_germantown-hills",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Located northeast of Peoria on the east bluffs of the Illinois River, Germantown Hills sits on a landscape that once hosted a Union House tavern, grocery, and saloon.",
      "sourceSentenceIds": [
        3,
        5
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://germantownhillsillinois.org/history/",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Agriculture ruled Germantown Hills until 1954, when it incorporated as a village and began evolving into a bedroom community for the Peoria metropolitan area.",
      "sourceSentenceIds": [
        8,
        14
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Germantown_Hills%2C_Illinois",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "A 1860 steam sawmill and a 1890s Union House tavern marked the early industrial and social life of the village, reflecting its growth from a rural settlement.",
      "sourceSentenceIds": [
        13
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Germantown_Hills%2C_Illinois",
