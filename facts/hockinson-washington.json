  "facts": [
    {
      "id": 1,
      "text": "Hockinson was renamed from Eureka in the 1880s to honor first postmaster Ambrosius Hakanson.",
      "sourceSentenceIds": [
        14
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.hocksd.org/o/hsd/page/take-a-trip-through-historic-hockinson"
    },
    {
      "id": 2,
      "text": "The town’s mascot, the Hawk, reflects the hawks that roam the fields of Hockinson and Brush Prairie.",
      "sourceSentenceIds": [
        15
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.hocksd.org/o/hsd/page/take-a-trip-through-historic-hockinson"
    },
    {
      "id": 3,
      "text": "The historic Chelatchie Prairie Railroad, originally built in 1887, now runs through Hockinson’s golf course and is owned by Clark County.",
      "sourceSentenceIds": [
        23,
        24
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.hocksd.org/o/hsd/page/take-a-trip-through-historic-hockinson"
    },
    {
      "id": 4,
      "text": "Hockinson Market, constructed in 1928, once housed the Hockinson Co‑op Association of local dairy farmers.",
      "sourceSentenceIds": [
        18
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.hocksd.org/o/hsd/page/take-a-trip-through-historic-hockinson"
    },
    {
      "id": 5,
      "text": "The Orchards Mural and Clock stands as a historic landmark that celebrates the community’s artistic heritage.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://beckdc.com/historical-places-in-hockinson/"
    },
    {
      "id": 6,
      "text": "The Clark County Historical Museum in Hockinson offers exhibits on regional history, including pioneer cabins and Finnish cemeteries.",
      "sourceSentenceIds": [
