  "facts": [
    {
      "id": 1,
      "text": "South Hill’s Visitor Center sits in a historic train depot, where a model railroad museum showcases panoramic displays of local history.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.southhillchamber.com/discover-south-hill"
    },
    {
      "id": 2,
      "text": "The Colonial Theatre earned a spot on the National Register of Historic Places in 2003, preserving South Hill’s early 20th‑century entertainment heritage.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/South_Hill%2C_Virginia"
    },
    {
      "id": 3,
      "text": "Whittle’s Mill Historic Site and Park lets visitors stroll beside the Meherrin River and explore an 18th‑century grist mill.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.southhillchamber.com/discover-south-hill"
    },
    {
      "id": 4,
      "text": "Kerr Lake, a large reservoir southwest of town, draws boaters and fishermen to its clear waters.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/South_Hill%2C_Virginia"
    },
    {
      "id": 5,
      "text": "Founded in 1901, South Hill envisions a dynamic community where innovation thrives and every resident has tools to succeed.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.southhillva.org/about.php"
    },
    {
      "id": 6,
      "text": "Kerr Dam and Reservoir, locally called Buggs Island Lake, is a key feature of the region’s waterway system.",
