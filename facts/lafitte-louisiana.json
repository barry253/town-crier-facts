  "facts": [
    {
      "id": 1,
      "text": "The 6,000‑square‑foot Barataria Museum tells the 200‑year‑old story of the Town of Jean Lafitte, a historic fishing village 20 miles southwest of New Orleans.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://townofjeanlafitte.com/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Jean Lafitte sits within the Barataria‑Terrebonne Estuary, one of the most biologically productive estuaries in the world.",
      "sourceSentenceIds": [
        14
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://townofjeanlafitte.com/explore/",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The Louisiana Wetlands Educational Center opened recently, offering hands‑on learning about the region’s unique ecosystems.",
      "sourceSentenceIds": [
        22
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://townofjeanlafitte.com/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Bayou culture in Jean Lafitte feels like a world apart, with dark waters hiding silent alligators and pirate lore.",
      "sourceSentenceIds": [
        23
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://townofjeanlafitte.com/",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Every May, the Jean Lafitte Seafood Festival draws visitors for three days of Louisiana seafood, live music, and authentic Creole cuisine.",
      "sourceSentenceIds": [
        27
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://townofjeanlafitte.com/",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Named after the notorious pirate Jean Lafitte, the town’s history intertwines with tales of smuggling and maritime adventure.",
      "sourceSentenceIds": [
        23
      ],
      "sourceLabels": [
