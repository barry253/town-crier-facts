  "facts": [
    {
      "id": 1,
      "text": "Isle Saint George is the only community on North Bass Island, the northernmost U.S. island in Lake Erie.",
      "sourceSentenceIds": [
        8,
        17
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Isle_Saint_George%2C_Ohio"
    },
    {
      "id": 2,
      "text": "The island’s post office opened in 1864, renamed Isle Saint George in 1874, and still serves the small community.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Isle_Saint_George%2C_Ohio"
    },
    {
      "id": 3,
      "text": "Isle Saint George once covered more than half its 688 acres with vineyards, producing wines under the “Isle St. George” label.",
      "sourceSentenceIds": [
        14,
        15
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/isle_saint_george_ohio"
    },
    {
      "id": 4,
      "text": "The island’s geology dates to Devonian coral reefs formed 400 million years ago, later reshaped by glaciers.",
      "sourceSentenceIds": [
        20
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/isle_saint_george_ohio"
    },
    {
      "id": 5,
      "text": "Isle Saint George sits about 18 miles northeast of Ohio’s mainland and less than two miles south of Canada’s border.",
      "sourceSentenceIds": [
        12,
        18
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/isle_saint_george_ohio"
    },
    {
      "id": 6,
      "text": "The island’s humid continental climate is moderated by Lake Erie, keeping summer highs around 80°F and winter lows near 20°F.",
