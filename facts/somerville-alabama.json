      ],
      "source": "https://encyclopediaofalabama.org/article/somerville/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Known as the 'River City,' Somerville began as a river crossing for settlers moving west of the Appalachians.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 1"
      ],
