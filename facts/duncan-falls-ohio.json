  "facts": [
    {
      "id": 1,
      "text": "Duncan Falls was named after Major Duncan, a Virginia hunter who settled near the Muskingum River falls in the 1790s.",
      "sourceSentenceIds": [
        1,
        5
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Duncan_Falls%2C_Ohio"
    },
    {
      "id": 2,
      "text": "James Taylor opened the town’s first store in 1825, later building a ferry and a dam to attract millers to the area.",
      "sourceSentenceIds": [
        11,
        14,
        15
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Duncan_Falls%2C_Ohio"
    },
    {
      "id": 3,
      "text": "A four‑story flour mill appeared in 1838, and by the 1840s a dam and lock system hid the falls from steamboats.",
      "sourceSentenceIds": [
        16,
        18
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Duncan_Falls%2C_Ohio"
    },
    {
      "id": 4,
      "text": "Steamboats once ferried flour, pork, and salt along the Muskingum, but railroads in the 1870s and the 1920s saw river commerce decline.",
      "sourceSentenceIds": [
        6,
        27
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/duncan_falls_ohio"
    },
    {
      "id": 5,
      "text": "The Ohio Ferro Alloys Corporation factory in nearby Philo, completed in 1927, and the Philo Power Plant in 1924, supplied much of Duncan Falls’ early 20th‑century economy.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Duncan_Falls%2C_Ohio"
    },
    {
      "id": 6,
      "text": "Duncan Falls hosts a branch of the Muskingum County Library System, keeping the town connected to regional knowledge.",
      "sourceSentenceIds": [
        7
