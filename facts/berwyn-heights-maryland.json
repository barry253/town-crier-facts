  "facts": [
    {
      "id": 1,
      "text": "Berwyn Heights started as Charlton Heights in the late 1800s, when the Charlton Heights Improvement Company laid out the first subdivision.",
      "sourceSentenceIds": [
        4,
        5,
        15
      ],
      "sourceLabels": [
        "Web source 1",
        "Wikipedia"
      ],
      "source": "https://www.berwyn-heights.com/exploring-the-history-of-berwyn-heights-from-charlton-heights-to-modern-day/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town’s early growth hinged on its location along the B&O Railroad, giving residents quick access to Washington, D.C.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.berwyn-heights.com/exploring-the-history-of-berwyn-heights-from-charlton-heights-to-modern-day/",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The O'Dea House, erected in 1888, now sits on the National Register of Historic Places as a prime example of Charlton Heights homes.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Berwyn_Heights%2C_Maryland",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Berwyn Heights became the seventh incorporated municipality in Prince George's County in 1896, marking its formal civic status.",
      "sourceSentenceIds": [
        19
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Berwyn_Heights%2C_Maryland",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "In 1967 the town adopted a seal featuring three acorns, a symbol chosen to represent growth and community roots.",
      "sourceSentenceIds": [
        20
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Berwyn_Heights%2C_Maryland",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Berwyn Heights earned the Tree City USA title in 1986, underscoring its long‑standing commitment to urban forestry.",
