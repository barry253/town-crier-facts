  "facts": [
    {
      "id": 1,
      "text": "Hermosa was founded on June 14th, 1886, as a survey crew crossed Battle Creek near the Battle River Stage Station.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.hermosasd.com/about-1"
    },
    {
      "id": 2,
      "text": "The name Hermosa is Spanish for beautiful, chosen for the town's views of the Black Hills and the grasslands.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Hermosa%2C_South_Dakota"
    },
    {
      "id": 3,
      "text": "Gutzon Borglum, the sculptor of Mount Rushmore, once lived on a ranch in Hermosa while working on the monument.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Hermosa%2C_South_Dakota"
    },
    {
      "id": 4,
      "text": "The Council Oak Tree, the largest Burr Oak in South Dakota, stands on the banks of Battle Creek in Hermosa.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.hermosasd.com/about-1"
    },
    {
      "id": 5,
      "text": "Hermosa served as a railhead for cattle ranching and a shipping point for tin mined in the surrounding area.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Hermosa%2C_South_Dakota"
    },
