  "facts": [
    {
      "id": 1,
      "text": "Youngsville was named after Scotsman Matthew Young, who arrived in 1796 and laid out many of its streets.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.youngsvilleboro.org/history/",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The first white settlers were lumbermen drawn by the forests and the easy water transport that let them move lumber downriver.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.youngsvilleboro.org/history/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Early sawmills in Youngsville ran on waterwheels, built beside streams to power the milling machinery.",
      "sourceSentenceIds": [
        18,
        19
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.youngsvilleboro.org/history/",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "By the late 1800s, Youngsville had become the largest settlement in Brokenstraw Township.",
      "sourceSentenceIds": [
        20
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.youngsvilleboro.org/history/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Buckaloons Recreation Area hosts the Seneca Interpretive Trail, named for the Seneca tribe that once lived nearby.",
      "sourceSentenceIds": [
        4
