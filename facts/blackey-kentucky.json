  "facts": [
    {
      "id": 1,
      "text": "Blackey got its name from Blackey Brown, a local resident whose brother inspired the post office name.",
      "sourceSentenceIds": [
        1,
        15
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Blackey%2C_Kentucky"
    },
    {
      "id": 2,
      "text": "Blackey's post office opened in 1908 on Elk Creek, and the town was chartered in 1912 before incorporating in 1915.",
      "sourceSentenceIds": [
        3,
        17
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Blackey%2C_Kentucky"
    },
    {
      "id": 3,
      "text": "A Lexington and Eastern Railroad line ran through Blackey in 1912, and later the Louisville and Nashville Railroad served the town.",
      "sourceSentenceIds": [
        4,
        9
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Blackey%2C_Kentucky"
    },
    {
      "id": 4,
      "text": "The Caudill Store & History Center, once a general store run by Joe and Gaynell Begley, now preserves Blackey's local history.",
      "sourceSentenceIds": [
        6,
        7,
        8
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Blackey%2C_Kentucky"
    },
    {
      "id": 5,
      "text": "Blackey Coal Company, founded in 1917, built thirty houses and employed eighty miners, marking the town's early industrial boom.",
      "sourceSentenceIds": [
        19,
        20
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Blackey%2C_Kentucky"
    },
    {
      "id": 6,
      "text": "Recent revitalization in Blackey includes a new water system, a Head Start program, and a branch of the Letcher County Library.",
