    },
    {
      "id": 2,
      "text": "On its 70th anniversary, the village unveiled plans for a new history museum to celebrate its heritage.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://rosemont.com/village-of-rosemont-kicks-off-70th-anniversary-celebration-with-unveiling-of-rosemont-history-museum-site-plans/"
    },
    {
      "id": 3,
      "text": "The Stephens Rosemont History Museum, opening summer 2026, will sit inside the recently opened Village Hall at 9501 Technology Blvd.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://rosemont.com/village-of-rosemont-kicks-off-70th-anniversary-celebration-with-unveiling-of-rosemont-history-museum-site-plans/"
    },
    {
      "id": 4,
      "text": "The 4,300‑square‑foot museum will guide visitors through Rosemont’s past, present, and future with interactive displays.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://rosemont.com/village-of-rosemont-kicks-off-70th-anniversary-celebration-with-unveiling-of-rosemont-history-museum-site-plans/"
    },
    {
      "id": 5,
      "text": "Albert Einstein Middle School, the village’s only middle school, serves students in the central part of Rosemont.",
