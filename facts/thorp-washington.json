  "facts": [
    {
      "id": 1,
      "text": "Thorp was named for Fielden Mortimer Thorp, the first permanent white settler in the Kittitas Valley.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Thorp%2C_Washington"
    },
    {
      "id": 2,
      "text": "The Northern Pacific Railroad reached Thorp in 1887, building a sidetrack one mile west and naming the town after pioneer Fielden Mortimer Thorp.",
      "sourceSentenceIds": [
        1,
        11
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Thorp%2C_Washington"
    },
    {
      "id": 3,
      "text": "The historic Thorp Mill, one of Kittitas County’s oldest landmarks, is listed on the National Register of Historic Places and shows early milling life.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Thorp%2C_Washington"
    },
    {
      "id": 4,
      "text": "Volunteers work year‑round restoring the nationally designated Thorp Mill site, keeping the landmark alive for future generations.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.thorp.org/"
    },
    {
      "id": 5,
      "text": "Thorp was founded in 1890 as a farming town of about 200 residents, nine miles northwest of Ellensburg.",
      "sourceSentenceIds": [
