  "facts": [
    {
      "id": 1,
      "text": "Grand Ronde takes its name from a French phrase that may refer to the valley's shape or a large round-up of people.",
      "sourceSentenceIds": [
        19
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Grand_Ronde%2C_Oregon"
    },
    {
      "id": 2,
      "text": "The Confederated Tribes of Grand Ronde comprise over thirty different tribes and bands from western Oregon, northern California, and southwest Washington.",
      "sourceSentenceIds": [
        14
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.grandronde.org/culture-history/"
    },
    {
      "id": 3,
      "text": "The Grand Ronde Indian Reservation was established in 1857, covering sixty thousand acres across Polk and Yamhill counties.",
      "sourceSentenceIds": [
        21
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Grand_Ronde%2C_Oregon"
    },
    {
      "id": 4,
      "text": "A short railroad built in 1922 helped the timber industry flourish and allowed lumber mills to dominate the local economy.",
      "sourceSentenceIds": [
        7,
        9
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Grand_Ronde%2C_Oregon"
    },
    {
      "id": 5,
      "text": "Spirit Mountain Casino is operated by the Confederated Tribes of Grand Ronde and serves as a major employer for the area.",
      "sourceSentenceIds": [
        25
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Grand_Ronde%2C_Oregon"
    },
    {
      "id": 6,
      "text": "Grand Ronde features the Chachalu Tribal Museum and Cultural Center, which preserves the history of the local indigenous people.",
