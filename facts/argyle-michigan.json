  "facts": [
    {
      "id": 1,
      "text": "Argyle Township was organized in 1872 and named after Argyle, Scotland, by Scots settlers from Ontario.",
      "sourceSentenceIds": [
        1,
        13,
        3
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Argyle_Township%2C_Michigan",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The first permanent settler was Jacob Sitter, later known as Seder, who bought 320 acres in 1861 and built a two‑story barn and house.",
      "sourceSentenceIds": [
        11,
        16,
        17
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Argyle_Township%2C_Michigan",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The unincorporated community of Argyle sits at the intersection of M‑19/Ubly Road and Argyle Road, a historic crossroads in the township.",
      "sourceSentenceIds": [
        14
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Argyle_Township%2C_Michigan",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Laing, a nearby historical settlement, lies along M‑19/Ubly Road and Deckerville Road, marking another early community within Argyle Township.",
