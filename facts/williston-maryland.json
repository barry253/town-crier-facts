  "facts": [
    {
      "id": 1,
      "text": "Williston was originally called Potter's Landing after sea captain Zabdiel Potter who built a wharf and brick house around 1730.",
      "sourceSentenceIds": [
        2,
        23
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 2"
      ],
      "source": "https://en.wikipedia.org/wiki/Williston%2C_Maryland"
    },
    {
      "id": 2,
      "text": "Potter Hall, the town’s namesake, is a Georgian brick house rebuilt in 1808 and listed on the National Register in 1982.",
      "sourceSentenceIds": [
        1,
        3,
        28
      ],
      "sourceLabels": [
        "Web source 2",
        "Wikipedia"
      ],
      "source": "https://carolinehistory.org/crh-inventory/upper-sites/potters-hall/"
    },
    {
      "id": 3,
      "text": "In the early 19th century, Williston’s waterfront became the leading shipping port in Caroline County, handling tobacco exports to Baltimore.",
      "sourceSentenceIds": [
        1,
        24
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://carolinehistory.org/crh-inventory/upper-sites/potters-hall/"
    },
    {
      "id": 4,
      "text": "From 1898 to 1921, steamboats docked at Williston Landing, making it a bustling steamboat hub on the Choptank River.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://carolinehistory.org/crh-inventory/upper-sites/potters-hall/"
    },
    {
      "id": 5,
      "text": "The town sits between Maryland Route 16 on its eastern edge and the Choptank River on its west, placing it right on the river’s edge.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Williston%2C_Maryland"
    },
    {
      "id": 6,
      "text": "A dance pavilion extended over the water in the early 1920s, operated by Gilbert Hignutt, offering waterfront entertainment.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://carolinehistory.org/crh-inventory/upper-sites/potters-hall/"
    }
  ]
