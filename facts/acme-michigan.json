      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "In 1892, the Chicago and West Michigan Railway extended through Acme, linking the community to Traverse City and Petoskey.",
      "sourceSentenceIds": [
        18
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Acme%2C_Michigan",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The tallest building in Grand Traverse County, the tower at the Grand Traverse Resort & Spa, opened in Acme in 1986.",
      "sourceSentenceIds": [
        21
      ],
      "sourceLabels": [
