  "facts": [
    {
      "id": 1,
      "text": "When the railroad reached Bethesda in 1852, the Central Ohio Railroad built a station called Burr's Mills in honor of Merrick S. Burr.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Bethesda%2C_Ohio",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Bethesda has had three names—Burrs Mills, Fairmount, and Bethesda—reflecting its evolving identity over time.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Bethesda%2C_Ohio",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "In 1920, a town clock was installed atop the Orrison Cigar Co. building on Main Street, dedicated to Bethesda’s World War I veterans.",
      "sourceSentenceIds": [
        16,
        17
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Bethesda%2C_Ohio",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The clock was restored in 2017 and placed in the Murray Family Memorial Plaza, honoring veterans from all services.",
      "sourceSentenceIds": [
        19,
        20
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Bethesda%2C_Ohio",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Bethesda Public Library, located at 112 N. Main Street, serves the community with a range of historical and contemporary resources.",
