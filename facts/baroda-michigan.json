  "facts": [
    {
      "id": 1,
      "text": "Baroda was founded in the 1830s by Michael Houser, who negotiated a railway station on his land with the Indiana and Lake Michigan Railway Company.",
      "sourceSentenceIds": [
        3,
        5
      ],
      "sourceLabels": [
        "Web source 2",
        "Wikipedia"
      ],
      "source": "https://swmichigan.org/plan-and-stay/towns/baroda",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The village’s name honors Baroda in Gujarat, India, reflecting Houser’s admiration for the Indian city.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Baroda%2C_Michigan",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Baroda incorporated as a village in 1907, a milestone that marked its growth from a rural settlement to an organized community.",
      "sourceSentenceIds": [
        11
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Baroda%2C_Michigan",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The Baroda Post Office opened on January 1, 1891, serving as a key communication hub for early residents.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
