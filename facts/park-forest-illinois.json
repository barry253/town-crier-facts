  "facts": [
    {
      "id": 1,
      "text": "Designed by Loebl Schlossman & Bennett, Park Forest sprang to life between 1947 and 1949 as a planned community for World War II veterans.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Park_Forest%2C_Illinois",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Park Forest Plaza, the village’s first outdoor shopping center, once housed Sears, Marshall Fields, and Goldblatt’s, drawing shoppers from the region.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Park_Forest%2C_Illinois",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The Elgin, Joliet and Eastern Railway—now part of Canadian National—runs a double‑track main line that bisects Park Forest.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Park_Forest%2C_Illinois",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The Park Forest Historical Society Archive holds photographs, newspapers, and oral histories from 1946 onward, preserving the village’s postwar story.",
      "sourceSentenceIds": [
        23,
        24,
        25
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.enjoyillinois.com/explore/listing/park-forest-historical-society-archive/",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "After starting in the public library, the historical society moved to downtown Park Forest in 1999, marking a shift in the village’s cultural hub.",
      "sourceSentenceIds": [
        26
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Park_Forest%2C_Illinois",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "In 2008, Park Forest shortened its annual race to five miles and renamed it the Scenic Five to welcome more local runners.",
