      "id": 1,
      "text": "St. Helens was founded in 1845 by Captain Henry Montgomery Knighton as the town of Plymouth.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/St._Helens%2C_Oregon",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town grew into a river port on the Columbia River during the 1840s, serving steamboats traveling to the Pacific.",
      "sourceSentenceIds": [
        24
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/St._Helens%2C_Oregon",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Lewis and Clark camped in the area that is now St. Helens on their 1805 expedition to the Pacific Ocean.",
      "sourceSentenceIds": [
        21
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/St._Helens%2C_Oregon",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Every fall, St. Helens hosts the Spirit of Halloweentown festival, celebrating the town’s connection to a popular Disney movie filmed there.",
      "sourceSentenceIds": [
        10,
        11
      ],
      "sourceLabels": [
        "Web source 2"
      ],
