  "facts": [
    {
      "id": 1,
      "text": "Saguache is the county seat of Saguache County, founded in 1866.",
      "sourceSentenceIds": [
        2,
        16
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Saguache%2C_Colorado",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town’s name comes from a Ute word meaning “blue water,” a nod to the nearby Saguache Creek.",
      "sourceSentenceIds": [
        10,
        17
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Saguache%2C_Colorado",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Otto Mears founded Saguache in 1867, building a wheat thresher, grist mill, and the first newspaper, the Saguache Chronicle.",
      "sourceSentenceIds": [
        3,
        21,
        23
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Saguache%2C_Colorado",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "In 1874 the Saguache Town Company turned the settlement into a booming supply town for nearby mines during the Colorado mining boom.",
      "sourceSentenceIds": [
        22
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Saguache%2C_Colorado",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The historic Ute Theater still operates today, offering community events that echo the town’s early cultural life.",
      "sourceSentenceIds": [
        14
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.uncovercolorado.com/towns/saguache/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Saguache Creek, rising high in the San Juan Mountains, flows through the town and has been a vital water source for centuries.",
      "sourceSentenceIds": [
