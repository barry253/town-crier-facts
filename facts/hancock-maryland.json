  "facts": [
    {
      "id": 1,
      "text": "Hancock was originally called William's Town after settler William McClary in the 18th century.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Hancock%2C_Maryland",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The Chesapeake and Ohio Canal reached Hancock in 1839, turning it into a bustling commercial hub and attracting Irish and Welsh workers.",
      "sourceSentenceIds": [
        2,
        3
      ],
      "sourceLabels": [
        "Web source 1",
        "Web source 2"
      ],
      "source": "https://townofhancock.org/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Hancock sits at Maryland's narrowest point, only 1.8 miles between Pennsylvania and West Virginia borders.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Hancock%2C_Maryland",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The town's name honors Edward Joseph Hancock Jr., a Revolutionary War soldier who fought beside George Washington.",
      "sourceSentenceIds": [
        13
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Hancock%2C_Maryland",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "During the Civil War, Stonewall Jackson attempted a siege of Hancock on January 5, 1862, but was halted by bad weather.",
      "sourceSentenceIds": [
        15
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Hancock%2C_Maryland",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Hancock hosts an active arts council that sponsors concerts, galleries, and a unique veterans memorial, showcasing local culture.",
