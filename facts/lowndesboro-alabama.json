  "facts": [
    {
      "id": 1,
      "text": "Lowndesboro was originally called McGill's Hill, settled by Presbyterians from the Carolinas after the Creek War.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://encyclopediaofalabama.org/article/lowndesboro/"
    },
    {
      "id": 2,
      "text": "In 1830 the town merged with Loch Ranza and was renamed Lowndesborough in honor of congressman William Lowndes, after whom the county is named.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://encyclopediaofalabama.org/article/lowndesboro/"
    },
    {
      "id": 3,
      "text": "The town’s historic district preserves many antebellum homes because federal troops occupied it during Wilson's Raid with little destruction.",
      "sourceSentenceIds": [
        26
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Lowndesboro%2C_Alabama"
    },
    {
      "id": 4,
      "text": "Lowndesboro was listed on the National Register of Historic Places in 1973, recognizing its well‑preserved 19th‑century architecture.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://townoflowndesboro.org/our-history"
    },
    {
      "id": 5,
      "text": "The town is known for the Dicksonia Plantation ruins, a notable historic site within the district.",
      "sourceSentenceIds": [
        30
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Lowndesboro%2C_Alabama"
    },
    {
