  "facts": [
    {
      "id": 1,
      "text": "Prehistoric habitation by the Jornada Mogollon culture dates back over 1,000 years, leaving evidence in the Nogal area.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/nogal_new_mexico"
    },
    {
      "id": 2,
      "text": "Nogal was originally called Dry Gulch, founded after a placer gold discovery in 1865 and lode claims in 1868.",
      "sourceSentenceIds": [
        13,
        16
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/nogal_new_mexico"
    },
    {
      "id": 3,
      "text": "The town grew into a boomtown in the 1880s, with telephone lines reaching remote mines by 1902.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/nogal_new_mexico"
    },
    {
      "id": 4,
      "text": "A railroad connection via the El Paso and Southwestern line arrived around 1900, electrification followed in 1915, supporting peak production until 1926.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/nogal_new_mexico"
    },
    {
      "id": 5,
      "text": "Nogal’s mining heritage is preserved on the National Register of Historic Places, with remnants of adits, waste dumps, and milling foundations.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/nogal_new_mexico"
    },
    {
      "id": 6,
      "text": "The community sits in the valley of Nogal Creek at the north end of the Sierra Blanca range in southwestern Lincoln County.",
      "sourceSentenceIds": [
        11
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
