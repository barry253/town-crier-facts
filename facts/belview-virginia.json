  "facts": [
    {
      "id": 1,
      "text": "Belview is located in the hilly reaches of Montgomery County, Virginia.",
      "sourceSentenceIds": [
        2,
        15
      ],
      "sourceLabels": [
        "Web source 1",
        "Web source 2"
      ],
      "source": "https://virginia.hometownlocator.com/va/montgomery/belview.cfm"
    },
    {
      "id": 2,
      "text": "The historic Belleview home is a handsome specimen of provincial Federal architecture built in the late eighteenth century.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.dhr.virginia.gov/historic-registers/044-0002/"
    },
    {
      "id": 3,
      "text": "Pioneer settler John Redd built the Belleview estate after participating in frontier actions during the American Revolution.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.dhr.virginia.gov/historic-registers/044-0002/"
    },
    {
      "id": 4,
      "text": "Belleview features a graceful two-level Ionic portico that is original to the house.",
      "sourceSentenceIds": [
        17
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.dhr.virginia.gov/historic-registers/044-0002/"
    },
    {
      "id": 5,
      "text": "The interior of the Belleview home is noted for its robust woodwork based on pattern-book illustrations.",
      "sourceSentenceIds": [
        16
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.dhr.virginia.gov/historic-registers/044-0002/"
    },
    {
      "id": 6,
      "text": "Belleview was officially listed on the National Register of Historic Places in June of 1974.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.dhr.virginia.gov/historic-registers/044-0002/"
