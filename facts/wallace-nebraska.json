  "facts": [
    {
      "id": 1,
      "text": "Wallace, Nebraska earned its name from early homesteader Frank Wallace, who organized the area's first school.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/wallace_nebraska",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Platted in 1887 when the Union Pacific Railroad reached the area, Wallace moved to its current spot at the junction of Highways 23 and 25.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/wallace_nebraska",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Wallace’s early press scene featured the Wallace Herald in 1889 and the Wallace Star in 1891, while the town’s oldest building is the 1888 Methodist Episcopal Church.",
      "sourceSentenceIds": [
        30
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/wallace_nebraska",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Covering just 0.7 square miles at 3,110 feet, Wallace enjoys a semi‑arid climate with about 21 inches of rain and 25 inches of snow each year.",
      "sourceSentenceIds": [
        29
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/wallace_nebraska",
      "category": "other",
      "quality": "poor",
      "qualityReason": "vague"
    },
    {
      "id": 5,
      "text": "Wallace is a small rural village in Lincoln County, serving as a farming community in the North Platte Micropolitan Statistical Area.",
