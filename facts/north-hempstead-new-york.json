  "facts": [
    {
      "id": 1,
      "text": "Long before European arrival, the Matinecock Nation inhabited the area now known as North Hempstead.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/North_Hempstead%2C_New_York",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Dutch navigator Adriaen Block first charted the Long Island Sound in 1614, marking the region’s earliest European sighting.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://northhempsteadny.gov/community/about_the_town/history/index.php",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "In 1643, a group of 30 settlers established the area as part of the larger Town of Hempstead.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://northhempsteadny.gov/community/about_the_town/index.php",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "A 1784 New York Legislature act formally established North Hempstead as its own town, separating it from Hempstead.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://northhempsteadny.gov/community/about_the_town/index.php",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The town’s name reflects its position north of Hempstead, which was once called South Hempstead.",
      "sourceSentenceIds": [
        20
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/North_Hempstead%2C_New_York",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "North Hempstead’s prosperity surged after the Long Island Rail Road reached Great Neck and steamboat service from Manhattan began in 1836.",
