  "facts": [
    {
      "id": 1,
      "text": "Guion is a small town in Izard County, located on the east bank of the White River at an elevation of 308 feet.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/guion_arkansas"
    },
    {
      "id": 2,
      "text": "Originally settled around 1810, Guion was first known as Wild Haws Landing because of the area's abundant bushes.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/guion_arkansas"
    },
    {
      "id": 3,
      "text": "The community was renamed Guion on April 24, 1903, likely in honor of a railroad official.",
      "sourceSentenceIds": [
        1,
        4
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/guion_arkansas"
    },
    {
      "id": 4,
      "text": "At its height, Guion hosted diverse industries including stave mills, hickory mills, marble quarries, and even a golf club factory.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/guion_arkansas"
    },
    {
      "id": 5,
      "text": "Early innovations in the town included the introduction of running water in 1912 and electricity in 1942.",
      "sourceSentenceIds": [
        29
      ],
      "sourceLabels": [
        "Web source 1"
      ],
