  "facts": [
    {
      "id": 1,
      "text": "Lloydminster straddles the Alberta–Saskatchewan border, with its main street, Meridian Avenue, literally bisecting the city.",
      "sourceSentenceIds": [
        8,
        25,
        27
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Lloydminster",
      "category": "other",
      "quality": "poor",
      "qualityReason": "other"
    },
    {
      "id": 2,
      "text": "The town was founded in 1903 by the Barr Colonists, a British utopian group that insisted on sobriety for its first years.",
      "sourceSentenceIds": [
        1,
        15
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Lloydminster",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "In 1905 the Fourth Meridian became the provincial line, cutting Lloydminster right down the middle of its main street.",
      "sourceSentenceIds": [
        18
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Lloydminster",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "A 30‑metre monument of survey markers was erected in 1994 to celebrate the city’s unique bi‑provincial status.",
      "sourceSentenceIds": [
        22
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Lloydminster",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Lloydminster’s health services come from both Alberta Health Services and the Saskatchewan Health Authority, reflecting its dual provincial ties.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Lloydminster",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The city’s first train arrived July 28, 1905, and the Lloydminster Daily Times began publishing the same year, marking rapid early growth.",
