  "facts": [
    {
      "id": 1,
      "text": "Napoleon, Indiana, was named in honor of French Emperor Napoleon Bonaparte in the early 19th century.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Napoleon%2C_Indiana",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town’s Central House and Elias Conwell House, both listed on the National Register of Historic Places, showcase its preserved 19th‑century architecture.",
      "sourceSentenceIds": [
        4,
        5
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Napoleon%2C_Indiana",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "A cellar beneath some local buildings still bears evidence of the Underground Railroad, hinting at the town’s role in the fight for freedom.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.ripleycountytourism.com/napoleon/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Visitors can explore the Ripley County Historical Society Museum, which meticulously preserves regional stories and artifacts from Napoleon’s early days.",
      "sourceSentenceIds": [
        20
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://allthingsusa.blog/napoleon-indiana-hidden-gems-history",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Napoleon was laid out in 1820, and its post office has been operating continuously since 1821.",
      "sourceSentenceIds": [
        23,
        24
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Napoleon%2C_Indiana",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The town sits at the crossroads of US 421 and SR 229, blending historic charm with modern connectivity.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.ripleycountytourism.com/napoleon/",
