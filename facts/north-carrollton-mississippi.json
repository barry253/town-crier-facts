  "facts": [
    {
      "id": 1,
      "text": "North Carrollton, incorporated in 1899 and once called Rathbone, grew around a Georgia Pacific Railway depot built in 1889 that became a commerce hub.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/north_carrollton_mississippi",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town sits just north of Carrollton, with Big Sand Creek—a Yalobusha River tributary—forming the natural boundary between them.",
      "sourceSentenceIds": [
        16
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/North_Carrollton%2C_Mississippi",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "During the 1930s, the WPA hired local workers to build the Carrollton Community House, a project completed in 1936 south of North Carrollton.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/north_carrollton_mississippi",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Carroll County, where North Carrollton lies, is famed for its music heritage that helped shape Mississippi’s cultural identity.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://visitcarroll.org/",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Every year, the town hosts the Pilgrimage & Pioneer Day Festival, celebrating local history and hospitality with music, food, and crafts.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://visitcarroll.org/",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "North Carrollton is part of the Greenwood, Mississippi micropolitan area, linking it to a broader regional economy.",
