  "facts": [
    {
      "id": 1,
      "text": "Benton began as Maull's Landing in 1832 on land owned by James Maull, a riverfront spot that later grew into the town.",
      "sourceSentenceIds": [
        3,
        6
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Benton%2C_Alabama",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "In 1834 the town was renamed Benton after Senator Thomas Hart Benton, a South Carolinian who led the 39th U.S. Infantry.",
      "sourceSentenceIds": [
        4,
        5
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Benton%2C_Alabama",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "During the steamboat era, Benton became a major trading stop along the Alabama River, drawing commerce from the region.",
      "sourceSentenceIds": [
        12,
        28
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Benton%2C_Alabama",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "In 1855, Edward Maull auctioned 200 lots, expanding Benton dramatically as the town incorporated these new parcels.",
      "sourceSentenceIds": [
        13,
        29
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Benton%2C_Alabama",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The town’s incorporation lapsed in the early twentieth century but was reinstated in 1964, restoring its municipal status.",
      "sourceSentenceIds": [
        30
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://encyclopediaofalabama.org/article/benton/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Genealogists often confuse Benton with Calhoun County, which was called Benton County from 1832 to 1858 before renaming due to the senator’s anti‑slavery stance.",
      "sourceSentenceIds": [
