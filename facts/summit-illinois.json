  "facts": [
    {
      "id": 1,
      "text": "Summit's name comes from the highest point on the Chicago Portage between Chicago River and Des Plaines River.",
      "sourceSentenceIds": [
        23
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Summit%2C_Illinois"
    },
    {
      "id": 2,
      "text": "The town grew around the Illinois and Michigan Canal; first settlers arrived during its construction.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.loc.gov/item/il0579/"
    },
    {
      "id": 3,
      "text": "In 1856, the Joliet and Chicago Railroad built a line along the south bank of the canal, linking Summit to Chicago.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Summit%2C_Illinois"
    },
    {
      "id": 4,
      "text": "Summit annexed the nearby factory town of Argo in 1911, merging two distinct communities.",
      "sourceSentenceIds": [
        24
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Summit%2C_Illinois"
    },
    {
      "id": 5,
      "text": "The Chicago Sanitary Canal opened in 1900, replacing the Illinois and Michigan Canal that once served Summit.",
