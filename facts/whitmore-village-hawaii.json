  "facts": [
    {
      "id": 1,
      "text": "The Oʻahu Railway and Land Company extended its line to Wahiawā in 1906, enabling efficient transport of pineapple crops, roads such as Clark and Kellogg Streets connected homesteads.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/whitmore_village_hawaii",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Whitmore Village was planned in 1947 by the Hawaiian Pineapple Company to consolidate worker camps into a unified residential area for plantation laborers and their families.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/whitmore_village_hawaii",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Whitmore Village traces its roots to land reforms after the 1893 overthrow of the Hawaiian Kingdom, which divided former crown and government lands for agriculture.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/whitmore_village_hawaii",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "In the 2000s and 2010s, military families from Schofield Barracks moved into Whitmore Village, spurring suburban growth and historic preservation of plantation-era structures.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/whitmore_village_hawaii",
      "category": "history",
      "quality": "good"
    }
