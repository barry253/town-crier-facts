  "facts": [
    {
      "id": 1,
      "text": "Govans was originally granted to shipowner William Govane in 1755 by Frederick Calvert, the sixth Lord Baltimore.",
      "sourceSentenceIds": [
        2,
        7
      ],
      "sourceLabels": [
        "Web source 1",
        "Wikipedia"
      ],
      "source": "https://alchetron.com/Govans%2C-Baltimore"
    },
    {
      "id": 2,
      "text": "The neighborhood’s oldest building, the former Govanstown Hotel, dates to 1840 and once hosted travelers on the York‑town Turnpike.",
      "sourceSentenceIds": [
        8,
        12,
        26
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Govans%2C_Baltimore"
    },
    {
      "id": 3,
      "text": "In 1808 the York‑town Turnpike, following a historic Indian route, ran through Govans, making it a key rest stop for Pennsylvania farmers.",
      "sourceSentenceIds": [
        12,
        13,
        26
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Govans%2C_Baltimore"
    },
    {
      "id": 4,
      "text": "Govans’ name evolved from Govanstown to Govans after the Govane estate was divided post‑1807, yet the family name endured.",
      "sourceSentenceIds": [
        25
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Govans%2C_Baltimore"
    },
    {
      "id": 5,
      "text": "The 1920 Baltimore Sun advertised houses in Govans’ Kenilworth Park as “highly restricted,” reflecting pre‑Fair Housing Act racial covenants.",
      "sourceSentenceIds": [
        28,
        27
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Govans%2C_Baltimore"
    },
    {
      "id": 6,
      "text": "A 2021 guide to the Govans history collection at Loyola Notre Dame Library preserves documents from 1919‑1962 that chronicle the neighborhood’s evolution.",
