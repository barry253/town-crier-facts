  "facts": [
    {
      "id": 1,
      "text": "Bass Lake is Ohio’s eighth largest natural lake, covering about 170 acres with an average depth of just four and a half feet.",
      "sourceSentenceIds": [
        13
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.geaugamapleleaf.com/news/park-biologist-shares-fascinating-history-of-county-gem/"
    },
    {
      "id": 2,
      "text": "The lake’s shallow waters are a rare remnant of glacial times, estimated to be thousands of years old.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.geaugamapleleaf.com/news/park-biologist-shares-fascinating-history-of-county-gem/"
    },
    {
      "id": 3,
      "text": "In the 1870s a hotel opened on the shore, and by the 1890s the resort boasted a ballroom and billiard hall for guests arriving by stagecoach.",
      "sourceSentenceIds": [
        19
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.geaugamapleleaf.com/news/park-biologist-shares-fascinating-history-of-county-gem/"
    },
    {
      "id": 4,
      "text": "Early Native American hunters camped around Bass Lake, leaving archaeological evidence of seasonal use that dates back thousands of years.",
      "sourceSentenceIds": [
        16
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.geaugamapleleaf.com/news/park-biologist-shares-fascinating-history-of-county-gem/"
    },
    {
      "id": 5,
      "text": "The lake’s wetlands were drained in the 1800s for celery and onion farming, a practice known as muck farming that altered the natural peat deposits.",
      "sourceSentenceIds": [
        21
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.geaugamapleleaf.com/news/park-biologist-shares-fascinating-history-of-county-gem/"
    },
    {
      "id": 6,
      "text": "In 2003 the Geauga Park District opened Bass Lake to the public after the Trust for Public Lands transferred ownership from the Chagrin River Land Conservancy.",
