    },
    {
      "id": 3,
      "text": "Newkirk was established during the Cherokee Strip Land Run on September 16, 1893, after Congress authorized the land purchase.",
      "sourceSentenceIds": [
        15
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Newkirk%2C_Oklahoma"
    },
    {
      "id": 4,
      "text": "The town was named Newkirk on November 8, 1893, after a nearby Santa Fe Railroad cattle-shipping station.",
      "sourceSentenceIds": [
        4,
        5
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Newkirk%2C_Oklahoma"
    },
    {
      "id": 5,
      "text": "Newkirk served as the name of the town in the drive-in movie scene from the film Twister.",
