  "facts": [
    {
      "id": 1,
      "text": "Cayuga’s name traces back to Cayuga County, New York, and Cayuga Lake, echoing the hometown of early settler John Groenendyke.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Cayuga%2C_Indiana",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Cayuga sits where Indiana State Road 63 meets State Road 234, near the Vermillion and Wabash rivers’ confluence.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Cayuga%2C_Indiana",
      "category": "transport",
      "quality": "poor",
      "qualityReason": "route_only"
    },
    {
      "id": 3,
      "text": "The town was first laid out on September 20, 1827, originally called Eugene Station and also known as Osonimon after a local chief.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Cayuga%2C_Indiana",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Cayuga’s post office has been serving residents continuously since 1886.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Cayuga%2C_Indiana",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Town of Cayuga prides itself on small‑town values, guided growth, and preserving its historical, cultural, and natural heritage.",
