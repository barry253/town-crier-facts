    },
    {
      "id": 3,
      "text": "The area that became Pleasant Valley was first settled by Dutch colonists in the 1700s, forming the historic hamlet core that defines the CDP today.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 2"
