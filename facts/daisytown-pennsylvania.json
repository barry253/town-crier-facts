  "facts": [
    {
      "id": 1,
      "text": "Daisytown’s roots trace back to the mid‑1700s frontier, where settlers met the Lenape and Shawnee tribes of the Conemaugh Valley.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/daisytown_pennsylvania",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Its closeness to early Johnstown helped trade, yet the area stayed largely self‑sufficient farms until the mid‑1800s.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/daisytown_pennsylvania",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "By the late 1800s Daisytown joined the region’s coal and steel boom, only to become a quiet, owner‑occupied suburb today.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/daisytown_pennsylvania",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The borough sits atop a hill roughly 600 feet higher than downtown Johnstown, offering a panoramic view of the valley.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Daisytown%2C_Pennsylvania",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Officially incorporated as a borough, Daisytown is part of Cambria County in Pennsylvania.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
