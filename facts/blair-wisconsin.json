  "facts": [
    {
      "id": 1,
      "text": "Blair was originally called Porterville until 1873, when it was renamed after railroad investor John Insley Blair.",
      "sourceSentenceIds": [
        3,
        4
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Blair%2C_Wisconsin"
    },
    {
      "id": 2,
      "text": "Blair sits in the Driftless Area, a region of rolling hills that was undisturbed by the last great glacial flow.",
      "sourceSentenceIds": [
        18,
        19
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Blair%2C_Wisconsin"
    },
    {
      "id": 3,
      "text": "The Trempealeau River near Blair was dammed to create Lake Henry, which was named after one of the first settlers.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Blair%2C_Wisconsin"
    },
    {
      "id": 4,
      "text": "Norwegian heritage in Blair is celebrated through a love of polka music and annual lefse and lutefisk suppers.",
      "sourceSentenceIds": [
