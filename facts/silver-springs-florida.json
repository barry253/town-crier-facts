  "facts": [
    {
      "id": 1,
      "text": "Silver Springs was founded in 1852, making it one of Florida's oldest tourist attractions.",
      "sourceSentenceIds": [
        1,
        4
      ],
      "sourceLabels": [
        "Web source 2",
        "Wikipedia"
      ],
      "source": "https://www.florida-backroads-travel.com/silver-springs-florida.html",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The 1934 \"Princess Donna\" remains the only operational glass‑bottom boat from the original era, still guiding visitors through the springs.",
      "sourceSentenceIds": [
        28
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Silver_Springs%2C_Florida",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Hollywood filmed six Tarzan movies here in the 1930s, plus scenes from \"Moonraker\" and \"Creature from the Black Lagoon.\".",
      "sourceSentenceIds": [
        2,
        17
      ],
      "sourceLabels": [
        "Web source 2",
        "Web source 1"
      ],
      "source": "https://www.florida-backroads-travel.com/silver-springs-florida.html",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Ross Allen opened the Silver Springs Reptile Institute in the early 1930s, making it a snake‑expert attraction.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.florida-backroads-travel.com/silver-springs-florida.html",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "During segregation, a separate park called Paradise Park operated one mile away, reflecting racial divisions.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.florida-backroads-travel.com/silver-springs-florida.html",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Today, glass‑bottom boats are named after Seminole tribe leaders, honoring the region’s indigenous heritage.",
      "sourceSentenceIds": [
        6
