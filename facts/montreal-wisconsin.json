  "facts": [
    {
      "id": 1,
      "text": "Montreal is the only planned company mining town in Wisconsin and is listed on the National Register of Historic Places.",
      "sourceSentenceIds": [
        2,
        8
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.travelwisconsin.com/things-to-do/culture-arts/architecture/montreal-company-mining-town"
    },
    {
      "id": 2,
      "text": "Montreal was named for the Montreal Mining Company, which took its own name from the nearby Montreal River.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Montreal%2C_Wisconsin"
    },
    {
      "id": 3,
      "text": "Montreal was originally incorporated as the Village of Hamilton around 1917, making it the first village formed in Iron County.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Montreal%2C_Wisconsin"
    },
    {
      "id": 4,
      "text": "The Montreal Company Location Historic District features pre-fabricated homes rented to miners to encourage them to stay in the area.",
      "sourceSentenceIds": [
        13,
        14
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Montreal%2C_Wisconsin"
    },
    {
      "id": 5,
      "text": "An iron mine in Montreal operated by Oglebay Norton Corporation was the deepest iron mine in the world when it closed in 1962.",
      "sourceSentenceIds": [
        15
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Montreal%2C_Wisconsin"
    },
    {
      "id": 6,
      "text": "Montreal originally developed as a sawmill village before becoming a center for the iron ore mining industry.",
      "sourceSentenceIds": [
