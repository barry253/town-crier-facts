  "facts": [
    {
      "id": 1,
      "text": "Oakville was originally called Pleasant Hill and was laid out by John Holsinger in December 1873.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Oakville%2C_Indiana",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town adopted the name Oakville around 1880 to avoid confusion with Pleasant Mills in Adams County.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Oakville%2C_Indiana",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Oakville’s growth hinged on the Lake Erie and Western railroad arriving in 1872, making it a railway hub.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Oakville%2C_Indiana",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "In 1884 an F5 tornado nearly obliterated Oakville, leaving only four houses standing and causing multiple fatalities.",
      "sourceSentenceIds": [
        28,
        29,
        30
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Oakville%2C_Indiana",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The Oakville Band, formed in 1906, entertained locals at parades and fairs until it disbanded around 1911.",
      "sourceSentenceIds": [
        10,
        11
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Oakville%2C_Indiana",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The Oakville Historical Society hosts walking tours, educational evenings, and seasonal events like the Thomas House pioneer home tours.",
      "sourceSentenceIds": [
        1,
        15
