  "facts": [
    {
      "id": 1,
      "text": "Inglefield was originally called Sandersville, renamed on November 17, 1869, after the town’s founder’s family name.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Inglefield%2C_Indiana",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town began as a railroad stop on the Evansville and Crawfordsville line, later known as Ingles, then Inglefield on the E&THR and Chicago & Iowa railroads.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Inglefield%2C_Indiana",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "John Ingle Sr ran the post office on his farm for 45 years, keeping the community connected through the 19th century.",
      "sourceSentenceIds": [
        14
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Inglefield%2C_Indiana",
      "category": "people",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "By 1830 most houses were gone, leaving only the post office, illustrating the town’s early abandonment.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Inglefield%2C_Indiana",
      "category": "other",
      "quality": "poor",
      "qualityReason": "vague"
    },
    {
      "id": 5,
      "text": "Inglefield’s coal mining company, founded in 1866, produced 50,000 long tons of coal per year by the late 19th century.",
      "sourceSentenceIds": [
        21
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Inglefield%2C_Indiana",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Dr. Thomas Runcie, an Irish immigrant, practiced medicine in Inglefield from 1849 until his death in 1867.",
      "sourceSentenceIds": [
