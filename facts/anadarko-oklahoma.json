  "facts": [
    {
      "id": 1,
      "text": "Anadarko got its name from the Nadaco, a Caddo band, when the post office opened in 1873, the added 'A' was a clerical error.",
      "sourceSentenceIds": [
        1,
        22,
        23
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Anadarko%2C_Oklahoma",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town’s post office showcases 16 murals by Kiowa Five artist Stephen Mopope, a living testament to Oklahoma’s Native American art.",
      "sourceSentenceIds": [
        11,
        12
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.travelok.com/Anadarko",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Anadarko was once a bustling rail hub, served by the Union Pacific, originally the Chicago, Rock Island and Pacific Railway.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.okhistory.org/publications/enc/entry?entry=AN002",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The Washita Valley’s fertile soil has made agriculture the backbone of Anadarko’s economy since the early 1900s.",
      "sourceSentenceIds": [
        30
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Anadarko%2C_Oklahoma",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Anadarko serves as the county seat of Caddo County, anchoring the region’s administrative and cultural life.",
