  "facts": [
    {
      "id": 1,
      "text": "Don Mills takes its name from the Don River and the mills that once powered the valley in the 19th century.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://toronto-city-builders.org/maps/don-mills/",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The 1950s planners drew on Ebenezer Howard’s Garden City and Radburn’s American model to shape Don Mills’ streets and parks.",
      "sourceSentenceIds": [
        11
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Don_Mills",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Don Mills was built as a self‑supporting \"new town\" between 1952 and 1965, a rare experiment outside Toronto proper.",
      "sourceSentenceIds": [
        13
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Don_Mills",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "By 1960, most of Don Mills’ apartments were finished, sparking a rapid influx of residents in the late 1950s.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.dmri.ca/history/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Don Mills became a blueprint for postwar suburban development across Toronto, inspiring neighborhoods like Bridlewood and Erin Mills.",
      "sourceSentenceIds": [
        14
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Don_Mills",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The Don Mills branch of the Toronto Public Library serves the community with a collection tailored to local history and culture.",
