    {
      "id": 2,
      "text": "Fort Deseret was built in 1865 during the Black Hawk War to protect settlers from Ute attacks.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://exploreforts.com/forts/fort-deseret-ut"
    },
    {
      "id": 3,
      "text": "Ninety-eight men built Fort Deseret in just eighteen days, making it the only adobe fort still standing in Utah.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://exploreforts.com/forts/fort-deseret-ut"
    },
    {
      "id": 4,
      "text": "Fort Deseret's ten-foot adobe walls were made of mud and straw mixed by oxen on a stone foundation.",
      "sourceSentenceIds": [
        13
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://exploreforts.com/forts/fort-deseret-ut"
    },
    {
      "id": 5,
      "text": "Security at Fort Deseret allowed for a peaceful settlement to be negotiated when Black Hawk appeared in 1866.",
      "sourceSentenceIds": [
        14
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://exploreforts.com/forts/fort-deseret-ut"
    },
    {
      "id": 6,
      "text": "The site of Fort Deseret was listed on the National Register of Historic Places in 1970.",
