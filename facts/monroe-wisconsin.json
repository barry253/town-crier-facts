    },
    {
      "id": 3,
      "text": "Twining Park in Monroe’s historic Square houses a Swiss bandshell that echoes the town’s heritage.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Monroe%2C_Wisconsin"
    },
    {
      "id": 4,
      "text": "The Monroe Public Library’s Kundert Special Collections preserve a treasure trove of local history books and artifacts.",
