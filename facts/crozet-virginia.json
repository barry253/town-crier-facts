  "facts": [
    {
      "id": 1,
      "text": "Crozet was originally called Wayland's Crossing, renamed in 1870 after Colonel Claudius Crozet, the engineer who built the Blue Ridge Tunnel.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Crozet%2C_Virginia",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The Blue Ridge Tunnel, completed in 1858, was the longest railroad tunnel in the U.S. at the time and remains a landmark in Crozet.",
      "sourceSentenceIds": [
        19
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.thevuecrozet.com/exploring-the-historic-sites-of-crozet-virginia/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Crozet’s small‑town charm sits at the foot of the Blue Ridge Mountains, offering farm‑to‑table dining and award‑winning wineries like Stinson Vineyards.",
      "sourceSentenceIds": [
        13,
        15
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.visitcharlottesville.org/places-to-go/crozet/",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "In 2015, the former depot became home to a collective of artists, turning the space into a vibrant arts hub for Crozet and Central Virginia.",
