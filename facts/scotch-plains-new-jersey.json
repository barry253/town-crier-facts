  "facts": [
    {
      "id": 1,
      "text": "Scotch Plains was first settled in 1684 and still preserves several Revolutionary War landmarks.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://scotchplainsnj.jimdoweb.com/government/history/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "A stray cannonball that struck the Osborn‑Cannonball House during Washington’s retreat after the Battle of Short Hills now houses a museum.",
      "sourceSentenceIds": [
        13,
        3
      ],
      "sourceLabels": [
        "Web source 2",
        "Wikipedia"
      ],
      "source": "https://historicalsocietyspfnj.org/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Originally incorporated as Fanwood Township in 1878, the community voted to rename itself Scotch Plains in 1917.",
      "sourceSentenceIds": [
        12,
        8
      ],
      "sourceLabels": [
        "Wikipedia",
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Scotch_Plains%2C_New_Jersey",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Shackamaxon Country Club, founded in 1916, offers golf, swimming, and tennis on Shackamaxon Drive.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Scotch_Plains%2C_New_Jersey",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The Raritan Valley Line, once the mainline of the Central Railroad of New Jersey, still runs through Scotch Plains to Newark Penn Station.",
      "sourceSentenceIds": [
        17,
        28
      ],
      "sourceLabels": [
        "Wikipedia",
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Scotch_Plains%2C_New_Jersey",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Founded in 1972, the Historical Society of Scotch Plains and Fanwood operates the Osborn‑Cannonball House museum and hosts monthly lectures.",
