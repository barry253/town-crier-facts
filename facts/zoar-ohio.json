  "facts": [
    {
      "id": 1,
      "text": "Zoar was founded in 1817 by Radical Pietist German dissenters seeking a utopian Christian community.",
      "sourceSentenceIds": [
        3,
        4,
        27
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Zoar%2C_Ohio",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The village’s name comes from the Biblical town where Lot and his family fled Sodom.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Zoar%2C_Ohio",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "In the 1850s, Zoar’s society owned over 10,000 acres and was worth about $1 million, its peak prosperity.",
      "sourceSentenceIds": [
        24
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Zoar%2C_Ohio",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Most of Zoar’s historic core was listed on the National Register in 1969 and became a National Historic Landmark District in 2016.",
      "sourceSentenceIds": [
        11
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Zoar%2C_Ohio",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Today, ten restored buildings, many German‑style, form the Zoar Village State Memorial, a living museum of its utopian past.",
      "sourceSentenceIds": [
        25,
        26,
        1
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Zoar%2C_Ohio",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The community’s original communal ownership model meant all property was shared, with farms, shops, and factories run by elected trustees.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
