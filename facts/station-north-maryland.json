  "facts": [
    {
      "id": 1,
      "text": "Station North started as a 19th‑century factory district when the Crown Cork & Seal Company moved to Guilford Avenue in 1897, becoming Copycat, Cork Factory, and Design School.",
      "sourceSentenceIds": [
        11
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://baltimoreheritage.org/programs/station-north/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The Copycat building, once a factory, now houses over 40 artist studios and a tool library, making it a hub for creatives.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.stationnorth.org/district-history",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "In 1895 the new North Avenue Bridge carried the avenue high over the Jones Falls and the railroad tracks, reshaping the area’s connectivity.",
      "sourceSentenceIds": [
        19
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://baltimoreheritage.org/programs/station-north/",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Station North’s renewal includes a growing arts scene; the Cork Factory warehouse at 1601 Guilford Avenue hosted artist and resident interviews from 2012‑2013.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.stationnorth.org/district-history",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The neighborhood once hosted Baltimore’s first unofficial Koreatown, centered around Charles North, reflecting its diverse cultural roots.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 1"
      ],
