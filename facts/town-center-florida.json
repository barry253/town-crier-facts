  "facts": [
    {
      "id": 1,
      "text": "Town Center opened in 1979 with a Mediterranean Revival design, featuring a round black station clock and living vegetation beneath its atriums.",
      "sourceSentenceIds": [
        27
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Town_Center_at_Boca_Raton",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The original one‑story mall was anchored by Burdines, which opened in June 1979, a year before the rest of the complex.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Town_Center_at_Boca_Raton",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Jordan Marsh joined the mall as a second anchor in 1980, followed by Sears on October 29 of the same year.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Town_Center_at_Boca_Raton",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Sears, Bloomingdale’s, and Nordstrom have remained the same anchors throughout most of Town Center’s history.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Town_Center_at_Boca_Raton",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The mall’s original design included distinctive wishing fountains that have become a local landmark.",
      "sourceSentenceIds": [
        27
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Town_Center_at_Boca_Raton",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Town Center’s Mediterranean theme was chosen to echo the architectural style popular in Florida’s early 20th‑century resort towns.",
