  "facts": [
    {
      "id": 1,
      "text": "The Washoe Tribe has lived along the Lake Tahoe shoreline for at least 9,000 years, leaving behind grinding stones and obsidian tools.",
      "sourceSentenceIds": [
        2,
        19
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/skyland_nevada",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "In 1844, John C. Frémont and Kit Carson were the first Europeans to see Lake Tahoe, initially calling it Lake Bonpland.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/skyland_nevada",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Carson & Tahoe Lumber and Fluming Company, founded in 1870, harvested about 750 million board feet of timber from Tahoe pines before ceasing operations in 1890.",
      "sourceSentenceIds": [
        27,
        30
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/skyland_nevada",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Logs were hauled by oxen to Glenbrook, then moved by the Lake Tahoe Railroad to Spooner Summit before a 12‑mile V‑flume carried them to a lumberyard Carson City.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/skyland_nevada",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Skyland got its name in the early 1900s, with the oldest surviving building—a 1924 stone fireplace from a WWI veterans’ rehabilitation center—still standing.",
      "sourceSentenceIds": [
        15
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/skyland_nevada",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "In 1957, George Whittell sold an 87‑acre lakefront tract to developer John Cheney, and Stockton Garden Homes began building homes in 1958.",
      "sourceSentenceIds": [
        16,
