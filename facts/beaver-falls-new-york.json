  "facts": [
    {
      "id": 1,
      "text": "Beaver Falls began as Rohr's Mills, a water‑powered settlement that drew French, German, Swiss, and Irish settlers in the mid‑1800s.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
