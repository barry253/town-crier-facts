  "facts": [
    {
      "id": 1,
      "text": "Armstrong was platted in 1878 and named after a railroad promoter who helped bring the line through the area.",
      "sourceSentenceIds": [
        5,
        7
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Armstrong%2C_Missouri",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Historic Sanborn Fire Insurance Maps from 1917 and 1928 reveal Armstrong’s downtown layout, labeled businesses, schools, and hotels.",
      "sourceSentenceIds": [
        6,
        15
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 2"
      ],
      "source": "https://en.wikipedia.org/wiki/Armstrong%2C_Missouri",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The 1917 and 1928 maps are part of a small collection of only two historic maps available for Armstrong, offering a rare glimpse into the town’s early 20th‑century streetscape.",
      "sourceSentenceIds": [
        3,
        15
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://hometownhistorymaps.com/pages/history-of-armstrong-missouri",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Local history enthusiasts can turn these old maps into wall art, preserving Armstrong’s past in a visual format.",
      "sourceSentenceIds": [
        1,
        9
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://hometownhistorymaps.com/pages/history-of-armstrong-missouri",
      "category": "culture",
      "quality": "poor",
      "qualityReason": "other"
    },
    {
      "id": 5,
      "text": "Armstrong sits within Howard County, Missouri, and relies on county authorities for services such as construction permits and code enforcement.",
