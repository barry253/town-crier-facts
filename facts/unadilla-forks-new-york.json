  "facts": [
    {
      "id": 1,
      "text": "Unadilla’s name comes from an Iroquois word meaning “Place of Meeting,” reflecting its original spot where the Unadilla and Susquehanna Rivers meet.",
      "sourceSentenceIds": [
        13
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://villageofunadilla.com/",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "In 1851 the Albany and Susquehanna Railroad opened, giving Unadilla fast access to eastern markets and replacing the canal as the main transport route.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://villageofunadilla.com/village-information/history",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The historic Unadilla Forks School earned a spot on the National Register of Historic Places in 1998, preserving its early 20th‑century architecture.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Unadilla_Forks%2C_New_York",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "In the early 1900s, the Tie Company moved from Sidney to Unadilla, and Hanford Wagon Works began on the site that now houses the Ames Handle Company.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://villageofunadilla.com/village-information/history",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Unadilla was incorporated as a village in 1828 and again in 1889, marking its formal establishment and later re‑incorporation.",
      "sourceSentenceIds": [
        21
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://villageofunadilla.com/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The town of Unadilla celebrated its bicentennial in 2001, commemorating 200 years since the 1801 division of Otsego County into present towns.",
      "sourceSentenceIds": [
        20
      ],
      "sourceLabels": [
        "Web source 1"
      ],
