      "id": 1,
      "text": "Potter earned its name from General Joseph S. Potter, a railroad shareholder who helped bring the Union Pacific line through the area.",
      "sourceSentenceIds": [
        1,
        3
      ],
      "sourceLabels": [
        "Wikipedia",
