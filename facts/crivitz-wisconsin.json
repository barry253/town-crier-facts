  "facts": [
    {
      "id": 1,
      "text": "German immigrant Frederick John Bartels founded Crivitz in 1883, naming the settlement after his hometown in Mecklenburg, Germany.",
      "sourceSentenceIds": [
        1,
        5
      ],
      "sourceLabels": [
        "Web source 2",
        "Wikipedia"
      ],
      "source": "https://grokipedia.com/page/Crivitz,_Wisconsin"
    },
    {
      "id": 2,
      "text": "Crivitz developed a strong Polish heritage after entrepreneur Hieronymus Zech marketed land to immigrants from Milwaukee and Chicago in the 1890s.",
      "sourceSentenceIds": [
        9,
        20
      ],
      "sourceLabels": [
        "Web source 2",
        "Wikipedia"
      ],
      "source": "https://grokipedia.com/page/Crivitz,_Wisconsin"
    },
    {
      "id": 3,
      "text": "The Escanaba and Lake Superior Railroad bolstered early development in 1897 by transporting lumber and agricultural goods to broader markets.",
      "sourceSentenceIds": [
        14
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/Crivitz,_Wisconsin"
    },
    {
      "id": 4,
      "text": "Crivitz was incorporated as a village in 1913, disincorporated in 1927, and finally re-incorporated as a village again in 1974.",
      "sourceSentenceIds": [
        22,
        25,
        28
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Crivitz%2C_Wisconsin"
    },
    {
      "id": 5,
      "text": "A ski hill called Winterset was developed in Crivitz in 1961.",
