  "facts": [
    {
      "id": 1,
      "text": "Whidbey Island Station sits on Ault Field, the former World War II naval airfield that first welcomed a single‑engine trainer on August 5, 1942.",
      "sourceSentenceIds": [
        21,
        30
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Naval_Air_Station_Whidbey_Island",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The station’s search‑and‑rescue unit flies Sikorsky MH‑60S Nighthawk helicopters, offering 24‑hour maritime and mountain rescue for the Pacific Northwest.",
      "sourceSentenceIds": [
        28
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Naval_Air_Station_Whidbey_Island",
      "category": "other",
      "quality": "poor",
      "qualityReason": "other"
    },
    {
      "id": 3,
      "text": "Whidbey Island Station is part of the only national historical reserve in the U.S., Ebey’s Landing, which preserves the island’s rural heritage and rare plant life.",
      "sourceSentenceIds": [
        4,
        15
      ],
      "sourceLabels": [
        "Web source 1",
        "Web source 2"
      ],
      "source": "https://whidbeyisland.us/all-about-whidbey-island/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The island’s name honors Joseph Whidbey, who circumnavigated it in 1792 and earned the honor of having the island named after him by Vancouver.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://whidbeyisland.us/all-about-whidbey-island/",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Fort Ebey, established in 1942 northwest of Coupeville, was built to defend the island’s western flank during World War II.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://whidbeyisland.us/all-about-whidbey-island/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Whidbey Island Station’s northern economy is tightly linked to the naval base, which occupies two separate land parcels near Oak Harbor.",
