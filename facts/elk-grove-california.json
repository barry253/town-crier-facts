  "facts": [
    {
      "id": 1,
      "text": "Elk Grove sprang to life in 1850 when James Hall opened a brick hotel that served as a stage stop for travelers between Sacramento and the Bay Area.",
      "sourceSentenceIds": [
        1,
        6
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Elk_Grove%2C_California",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "In 1868 the Central Pacific Railroad finished its line from Sacramento to Stockton, bringing a train a mile east of Elk Grove and reshaping the town’s future.",
      "sourceSentenceIds": [
        4,
        10
      ],
      "sourceLabels": [
        "Web source 2",
        "Wikipedia"
      ],
      "source": "https://elkgrovehistoricalsociety.com/history-town-of-elk-grove/",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Elk Grove Public Library was California’s first free public library branch, opening in 1905 and serving as a cultural cornerstone for the community.",
      "sourceSentenceIds": [
        18
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Elk_Grove%2C_California",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "James Hall named the area Elk Grove after finding elk horns in nearby tree groves, a nod to the wildlife that once roamed the valley.",
      "sourceSentenceIds": [
        20
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Elk_Grove%2C_California",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Although Elk Grove has expanded, locals still regard Old Town as the true heart of the city, preserving its historic streets and early buildings.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://elkgrovehistoricalsociety.com/history-town-of-elk-grove/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The Elk Grove Public Library is part of the larger Sacramento Public Library system, linking the city to a statewide network of resources.",
