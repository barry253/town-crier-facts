  "facts": [
    {
      "id": 1,
      "text": "Pratt was originally called Clifton and Dego before being renamed after Charles Pratt, owner of the Charles Pratt Coal Company.",
      "sourceSentenceIds": [
        1,
        2,
        17
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Pratt%2C_West_Virginia"
    },
    {
      "id": 2,
      "text": "Pratt's recorded history dates back to 1792 when Revolutionary War veteran John Jones took out a patent for the land.",
      "sourceSentenceIds": [
        14
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://local.wv.gov/Pratt/Pages/about.aspx"
    },
    {
      "id": 3,
      "text": "The Pratt Historic District is listed on the National Register of Historic Places and features elegant buildings from the settlement era.",
      "sourceSentenceIds": [
        11,
        16
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 2"
      ],
      "source": "https://en.wikipedia.org/wiki/Pratt%2C_West_Virginia"
    },
    {
      "id": 4,
      "text": "Pratt gained national notoriety during the Mine Wars of 1912 and 1913, a major conflict between labor and coal company management.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.livingplaces.com/WV/Kanawha_County/Pratt_Town/Pratt_Historic_District.html"
    },
    {
      "id": 5,
      "text": "The historic Old Town Hall in Pratt was built on the town square in 1875 and still hosts town activities.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://local.wv.gov/Pratt/Pages/about.aspx"
    },
    {
      "id": 6,
      "text": "Pratt is located along the Kanawha River in Kanawha County, West Virginia.",
