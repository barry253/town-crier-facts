      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "From 1920 until the mid‑1980s, Stephen Birch and his family ran Otay Ranch, turning it into a prominent local farm.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://oac.cdlib.org/findaid/ark:/13030/kt1r29q7z1",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Otay Ranch High School opened in 2000 to relieve overcrowding at nearby San Ysidro and Eastlake High Schools.",
