      "id": 1,
      "text": "Darlington was originally called Center and was formally organized on April 3, 1849 before being renamed in 1869 after benefactor Joshua Darling.",
      "sourceSentenceIds": [
        2,
        8
      ],
      "sourceLabels": [
        "Web source 2"
      ],
