  "facts": [
    {
      "id": 1,
      "text": "Pine Knoll Shores was developed in the 1970s by the Roosevelt family, who preserved the island's native maritime forest instead of clearing it.",
      "sourceSentenceIds": [
        27
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://pineknollshores.org/about/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town sits on Bogue Banks, a 26‑mile barrier island that stretches along North Carolina's Crystal Coast.",
      "sourceSentenceIds": [
        26
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://pineknollshores.org/about/",
      "category": "other",
      "quality": "poor",
      "qualityReason": "location_description"
    },
    {
      "id": 3,
      "text": "Pine Knoll Shores is home to the North Carolina Aquarium at Pine Knoll Shores, one of the state’s three public aquariums and the most‑visited attraction on Bogue Banks.",
      "sourceSentenceIds": [
        30
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://pineknollshores.org/about/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Live oaks, loblolly pines, and wax myrtles grow right up to neighborhood edges, giving the town a shaded, natural feel unlike any other beach town on the island.",
      "sourceSentenceIds": [
        28
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://pineknollshores.org/about/",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The town is bordered by Indian Beach to the west and Atlantic Beach to the east, with Bogue Sound to the north and Atlantic Ocean to the south.",
      "sourceSentenceIds": [
        5,
        6
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Pine_Knoll_Shores%2C_North_Carolina",
      "category": "other",
      "quality": "poor",
      "qualityReason": "location_description"
    },
    {
      "id": 6,
      "text": "Pine Knoll Shores is located in southwestern Carteret County on Bogue Banks, a barrier island along the Atlantic Ocean.",
