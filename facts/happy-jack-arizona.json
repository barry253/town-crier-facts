  "facts": [
    {
      "id": 1,
      "text": "Happy Jack earned its name from a cheerful lumberjack legend, or possibly a happy-go-lucky employee named Jack, according to local lore.",
      "sourceSentenceIds": [
        4,
        6
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 2"
      ],
      "source": "https://en.wikipedia.org/wiki/Happy_Jack%2C_Arizona",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Founded in 1947, Happy Jack began as a Saginaw and Manistee Lumber Company logging camp that once housed up to 500 workers.",
      "sourceSentenceIds": [
        3,
        7
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Happy_Jack%2C_Arizona",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Logs from the camp traveled by Central Arizona Railroad until 1967, when truck transport replaced the rail line.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/Happy_Jack,_Arizona",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "At about 7,500 feet on the Mogollon Rim, Happy Jack experiences a cold, semi‑arid continental climate with sharp seasonal swings.",
      "sourceSentenceIds": [
        18
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/Happy_Jack,_Arizona",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The Lowell Discovery Telescope, a modern astronomical observatory, sits on the hills above Happy Jack.",
