    {
      "id": 1,
      "text": "Founded in 1904, Orcutt began as a railroad siding for oil workers and grew into a small community along the Pacific Coast Railway.",
      "sourceSentenceIds": [
        1,
        8
      ],
      "sourceLabels": [
        "Wikipedia",
