  "facts": [
    {
      "id": 1,
      "text": "Stanton originated as Housel's, named after Johannes Housel's 18th‑century farm on Dreahook Road.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Stanton%2C_New_Jersey",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "After William Housel died in 1809, the community became Waggoner's Hill, honoring landowner William Waggoner.",
      "sourceSentenceIds": [
        15
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/stanton_new_jersey",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "In the early 19th century, Stanton grew into a crossroads village with a Reformed church built in 1834, a post office, and a schoolhouse.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/stanton_new_jersey",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Stanton lies along the historic King's Road, an 18th‑century trade route linking the Delaware River to New Brunswick.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/stanton_new_jersey",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The South Branch Raritan River skirts Stanton, contributing up to half of Piedmont streamflow and supporting local agriculture.",
      "sourceSentenceIds": [
        23
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/stanton_new_jersey",
      "category": "nature",
      "quality": "good"
    }
  ],
