    {
      "id": 1,
      "text": "Newborn’s name comes from a 19th‑century preacher’s sermon that inspired leaders to choose a name meaning “born again.”.",
      "sourceSentenceIds": [
        7,
        17
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 2"
      ],
      "source": "https://en.wikipedia.org/wiki/Newborn%2C_Georgia",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The Georgia General Assembly incorporated Newborn as a town in 1894, thirty years after General Sherman marched through it.",
      "sourceSentenceIds": [
        8,
        18
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 2"
      ],
      "source": "https://en.wikipedia.org/wiki/Newborn%2C_Georgia",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The circa‑1923 Newborn Schoolhouse, now an event center, sits at the heart of the town’s historic core.",
      "sourceSentenceIds": [
        4,
        20
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://thenewtoncommunity.com/features/newborn-a-town-full-of-characters/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Despite covering just 1.6 square miles, Newborn boasts a post office, town hall, park, tiny library, and even a traffic light.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://thenewtoncommunity.com/features/newborn-a-town-full-of-characters/",
      "category": "other",
      "quality": "poor",
      "qualityReason": "vague"
    },
    {
      "id": 5,
      "text": "Every April, residents gather at the Schoolhouse for the quirky Hornyhead Fish Festival, celebrating a diminutive local fish.",
      "sourceSentenceIds": [
        19
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://thenewtoncommunity.com/features/newborn-a-town-full-of-characters/",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Pickin’ in the Park is a regular bluegrass gathering where local musicians bring acoustic instruments and play together.",
