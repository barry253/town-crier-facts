  "facts": [
    {
      "id": 1,
      "text": "Lisle, Illinois, was founded in 1832 by James and Luther Hatch, who named it after Lisle, New York.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.britannica.com/place/Lisle",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Lisle became a Chicago, Burlington and Quincy Railroad station in the 1860s, and its depot was rebuilt after a 1874 fire.",
      "sourceSentenceIds": [
        9,
        8
      ],
      "sourceLabels": [
        "Web source 2",
        "Wikipedia"
      ],
      "source": "https://www.britannica.com/place/Lisle",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "In 1885 Bohemian Benedictines founded Procopius Abbey, and Benedictine University moved to Lisle in 1901.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.britannica.com/place/Lisle",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The Depot Museum, alongside the 1830s‑era Beaubien Tavern, preserves Lisle’s early history for visitors.",
      "sourceSentenceIds": [
        11
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.britannica.com/place/Lisle",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Lisle Library District opened its first public library in 1965, beginning a long tradition of local history resources.",
      "sourceSentenceIds": [
        12
