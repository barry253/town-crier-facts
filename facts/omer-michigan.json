  "facts": [
    {
      "id": 1,
      "text": "Omer was founded in 1866 by George Gorie and George Carscallen who set up a sawmill along the Rifle River.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Omer%2C_Michigan",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town’s name evolved from Rifle River Mills to Omer after postmaster Carscallen dropped the leading H from Homer.",
      "sourceSentenceIds": [
        2,
        21
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Omer%2C_Michigan",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "A 100‑foot railroad bridge over the Rifle River still spans the water, a relic of the Detroit and Mackinac Railroad that once served Omer.",
      "sourceSentenceIds": [
        1,
        9
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.cityofomer.com/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "In 1903 Omer became Michigan’s smallest city, a title it still holds today.",
      "sourceSentenceIds": [
        5,
        7,
        23
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.cityofomer.com/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "A 1914 fire destroyed 40 buildings, and a 1916 flood washed out the local dam, nearly halting Omer’s recovery.",
      "sourceSentenceIds": [
