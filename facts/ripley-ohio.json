  "facts": [
    {
      "id": 1,
      "text": "Ripley was renamed in 1816 to honor General Eleazar Wheelock Ripley, a War of 1812 officer.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Ripley%2C_Ohio",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The John Rankin House, built 1825, is a National Historic Landmark where abolitionist John Rankin sheltered escaping slaves.",
      "sourceSentenceIds": [
        1,
        2,
        20
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 2"
      ],
      "source": "https://en.wikipedia.org/wiki/Ripley%2C_Ohio",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "John Parker, a former slave, lived in the Parker House from 1853 until his death and organized many rescue attempts from Kentucky.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.ripley-ohio.com/visit/history",
      "category": "people",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Ripley’s location on the Ohio River made it a key stop on the Underground Railroad, helping slaves flee from Kentucky.",
      "sourceSentenceIds": [
        6,
        17
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Ripley%2C_Ohio",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The town sits on a bend of the Ohio River, surrounded by steep hills, Red Oak Creek, and the river itself.",
