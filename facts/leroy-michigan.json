  "facts": [
    {
      "id": 1,
      "text": "LeRoy got its name from LeRoy Carr, a federal land agent who helped settle the area.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/LeRoy%2C_Michigan",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The first train rolled into LeRoy in late November 1871, after a railroad agent had been stationed there in 1864.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://leroytwposceola.org/about/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "LeRoy Township was officially created on April 4, 1870, marking the first formal governance of the community.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://leroytwposceola.org/about/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "LeRoy’s 1973 centennial sparked the first effort to build a museum that preserves the village’s pioneer history.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.leroymi.org/leroy-area-historical-society/",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "In 1986, Harold and Alberta Nelson donated the 1901 LeRoy Exchange Bank building to house the permanent community museum.",
      "sourceSentenceIds": [
        30
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.leroymi.org/leroy-area-historical-society/",
      "category": "landmark",
      "quality": "good"
    },
    {
