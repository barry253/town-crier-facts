  "facts": [
    {
      "id": 1,
      "text": "Ballard was founded in 1880 as the Santa Ynez Valley’s first township, originally a Wells Fargo stage line station named after William Ballard.",
      "sourceSentenceIds": [
        1,
        2
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 2"
      ],
      "source": "https://en.wikipedia.org/wiki/Ballard%2C_California",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town’s one‑room Little Red Schoolhouse, built in 1883 for $1,000, still stands as a living museum of 19th‑century education.",
      "sourceSentenceIds": [
        6,
        7,
        15
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Ballard%2C_California",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Ballard’s historic core includes the 1889 Santa Ynez Valley Presbyterian Church, now a Santa Barbara County Historical Landmark.",
      "sourceSentenceIds": [
        6,
        11
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Ballard%2C_California",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The town grew around a stagecoach stop called Ballard’s Station on the Overland Mail route between San Luis Obispo and Santa Barbara, making it the oldest settlement in the valley.",
      "sourceSentenceIds": [
        18,
        19
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/ballard_california",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Ballard’s scenic vineyards and Mediterranean climate earned a spot in the Academy Award‑nominated film Sideways, spotlighting the region’s wine culture.",
      "sourceSentenceIds": [
        17
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Ballard%2C_California",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Today, Ballard preserves its 19th‑century character through landmarks like the Ballard School and the charming Ballard Country Church, both central to community life.",
      "sourceSentenceIds": [
        4,
