  "facts": [
    {
      "id": 1,
      "text": "Oasis was founded in the early 20th century as a railroad water stop for the Southern Pacific Railroad, a key refueling point in the Colorado Desert.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.trawellino.com/destinations/united-states/california_oasis"
    },
    {
      "id": 2,
      "text": "The town sits in the Coachella Valley near the Salton Sea and is famous for its date farms that thrive on irrigation from the Coachella Canal.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.trawellino.com/destinations/united-states/california_oasis"
    },
    {
      "id": 3,
      "text": "Oasis experiences a hot desert climate, with scorching summers, minimal rainfall, and a dry air that can feel almost parched.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.trawellino.com/destinations/united-states/california_oasis"
    },
    {
      "id": 4,
      "text": "Despite its name, Oasis is a quiet, rural community where farming and local businesses dominate the landscape.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.trawellino.com/destinations/united-states/california_oasis"
    },
    {
      "id": 5,
      "text": "The area receives only about 3 inches of rain per year, making it one of California’s driest spots.",
      "sourceSentenceIds": [
        29
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.trawellino.com/destinations/united-states/california_oasis"
    },
    {
      "id": 6,
      "text": "Emergency services are limited, so visitors should know the location of the nearest hospital or police station before arriving.",
