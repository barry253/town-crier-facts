  "facts": [
    {
      "id": 1,
      "text": "Gardiner takes its name from Johnson Gardner, a fur trapper who operated in the area during the early eighteen thirties.",
      "sourceSentenceIds": [
        20
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Gardiner%2C_Montana"
    },
    {
      "id": 2,
      "text": "Evidence shows that Native Americans have lived and hunted in the Gardiner area since at least eleven thousand years ago.",
      "sourceSentenceIds": [
        27
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Gardiner%2C_Montana"
    },
    {
      "id": 3,
      "text": "Gardiner sits at the confluence of the Gardiner and Yellowstone Rivers in the breathtaking Paradise Valley.",
      "sourceSentenceIds": [
        8,
        12
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Gardiner%2C_Montana"
    },
    {
      "id": 4,
      "text": "The town of Gardiner was officially founded in eighteen eighty after prospectors and entrepreneurs settled the area for gold and hot springs.",
      "sourceSentenceIds": [
        3,
        7
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Gardiner%2C_Montana"
    },
    {
      "id": 5,
      "text": "Gardiner has served as a main entrance to Yellowstone National Park since the park was created in eighteen seventy-two.",
      "sourceSentenceIds": [
        17
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Gardiner%2C_Montana"
    },
    {
      "id": 6,
      "text": "The Yellowstone National Park Heritage and Research Center in Gardiner houses National Park Service archives and museum collections.",
