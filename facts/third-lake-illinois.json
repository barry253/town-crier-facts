      ],
      "source": "https://www.thirdlakevillage.com/history",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The Alexander Druce family, early settlers in 1861, owned both Druce Lake and the land that became Third Lake.",
      "sourceSentenceIds": [
