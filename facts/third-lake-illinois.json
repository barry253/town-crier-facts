      "quality": "good"
    },
    {
      "id": 2,
      "text": "The village’s name changed to Third Lake in 1954, replacing the earlier Chittendon Lake designation.",
      "sourceSentenceIds": [
        4,
        7
      ],
      "sourceLabels": [
        "Web source 1",
        "Web source 2"
