  "facts": [
    {
      "id": 1,
      "text": "Maltby takes its name from early settler Robert Maltby, who bought land in 1890 and subdivided it, prompting the post office to adopt the name in 1893.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Maltby%2C_Washington",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town began as a logging camp called Earl, founded by Thomas Earle & Company, and later renamed Yew as the railroad expanded.",
      "sourceSentenceIds": [
        2,
        3
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.historylink.org/File/11149",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The historic Maltby Café, still standing, is a local landmark that dates back to the town’s early days.",
      "sourceSentenceIds": [
        18
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.trawellino.com/destinations/united-states/washington_maltby",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Maltby sits north of Woodinville and south of Snohomish at the junction of State Route 522 and 524, serving as a semi‑rural residential hub near tech centers like Redmond.",
