  "facts": [
    {
      "id": 1,
      "text": "Nashua’s name, derived from the Nashaway people, means “beautiful stream with a pebbly bottom” in the Penacook language.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Nashua%2C_New_Hampshire",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The city sits where the Nashua and Merrimack rivers meet, a spot first settled in 1654 as a fur‑trading town.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Nashua%2C_New_Hampshire",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Nashua once thrived as New Hampshire’s trolley hub, with six rail lines crossing the mill town.",
      "sourceSentenceIds": [
        16
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Nashua%2C_New_Hampshire",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Founded in 1870, the Nashua Historical Society is a volunteer‑run, independent nonprofit that preserves the city’s past.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.nashuahistoricalsociety.org/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "A former Digital Equipment Corporation campus now houses Nashua Technology Park, a modern business hub.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Nashua%2C_New_Hampshire",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Nashua shares Hillsborough County’s seat with Manchester, making it one of New Hampshire’s two county capitals.",
