      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Unlike nearby towns, Memphis was bypassed by the railroad, which instead ran through Aliceville.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://encyclopediaofalabama.org/article/memphis/",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The historic Snagboat Montgomery, a steam-powered sternwheeler, is moored in Memphis at the Tom Bevill Lock and Dam.",
      "sourceSentenceIds": [
        17,
        23
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://encyclopediaofalabama.org/article/memphis/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "A ferry named Memphis once operated here, with Jackson's Landing serving as the busiest river crossing.",
      "sourceSentenceIds": [
