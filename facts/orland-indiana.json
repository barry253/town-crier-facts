  "facts": [
    {
      "id": 1,
      "text": "Orland was the first settlement in Steuben County, founded in 1834 by Vermont immigrants who called it Vermont Settlement.",
      "sourceSentenceIds": [
        2,
        6
      ],
      "sourceLabels": [
        "Web source 1",
        "Wikipedia"
      ],
      "source": "https://www.in.gov/towns/orland/history/"
    },
    {
      "id": 2,
      "text": "John Stocker, a Vermont prospector, led the initial group that settled Orland in 1834, choosing the land for its rich burr‑oak openings.",
      "sourceSentenceIds": [
        3,
        21
      ],
      "sourceLabels": [
        "Wikipedia",
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Orland%2C_Indiana"
    },
    {
      "id": 3,
      "text": "During the Civil War, Orland served as a secret stop on the Underground Railroad, hiding runaway slaves in homes like the Butler and Brown residences.",
      "sourceSentenceIds": [
        8,
        15,
        18
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 2",
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Orland%2C_Indiana"
    },
    {
      "id": 4,
      "text": "The town’s name honors Angola, New York, where many of its earliest settlers originated.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.co.steuben.in.us/about_us/index.php"
    },
    {
      "id": 5,
      "text": "Each July, Orland celebrates its Vermont roots with the Vermont Settlement Festival, a community event that highlights local history and culture.",
      "sourceSentenceIds": [
        20
