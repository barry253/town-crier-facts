  "facts": [
    {
      "id": 1,
      "text": "Pilot Station sits on the northern bank of the lower Yukon River, about eighty miles from the Bering Sea.",
      "sourceSentenceIds": [
        20
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Pilot_Station%2C_Alaska"
    },
    {
      "id": 2,
      "text": "The community of Pilot Station originally began as a Yup'ik seasonal camp for hunting and fishing called Anqcik.",
      "sourceSentenceIds": [
        1,
        13
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.kupi.com/en/explore/united-states/pilot-station/history"
    },
    {
      "id": 3,
      "text": "Pilot Station takes its name from its history as a designated stop where riverboat pilots were picked up to navigate the Yukon Delta.",
      "sourceSentenceIds": [
        17,
        29
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.kupi.com/en/explore/united-states/pilot-station"
    },
    {
      "id": 4,
      "text": "Local oral history suggests the area was occupied during conflicts between the Yukon River Yup'ik people and the Coastal Eskimos.",
      "sourceSentenceIds": [
        11
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.kupi.com/en/explore/united-states/pilot-station"
    },
    {
      "id": 5,
      "text": "River transport allowed Pilot Station residents to exchange furs and fish for European goods and tools.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.kupi.com/en/explore/united-states/pilot-station/history"
    },
    {
      "id": 6,
      "text": "Most residents of Pilot Station continue to honor their traditions and their belonging to the Yup'ik people.",
      "sourceSentenceIds": [
        14
      ],
      "sourceLabels": [
        "Web source 1"
      ],
