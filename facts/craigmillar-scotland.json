  "facts": [
    {
      "id": 1,
      "text": "Craigmillar Castle began as a simple tower house in the late 14th century built by Simon Preston after the king granted lands.",
      "sourceSentenceIds": [
        24
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.historyhit.com/locations/craigmillar-castle/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The four‑storey keep originally stood alone before the castle expanded into a complex of rooms and gardens.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Craigmillar_Castle",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "In 1566 a pact known as the Craigmillar Bond was signed at the castle, plotting the removal of Mary Queen of Scots’ husband, Lord Darnley.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Craigmillar_Castle",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The castle has been in state care since 1946 and is now maintained by Historic Environment Scotland.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Craigmillar_Castle",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The grounds include veteran trees and are listed on the Inventory of Gardens and Designed Landscapes.",
      "sourceSentenceIds": [
        20
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.historicenvironment.scot/visit-a-place/places/craigmillar-castle/history/",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Craigmillar Castle is a scheduled ancient monument and open to the public, offering a glimpse into Edinburgh’s medieval past.",
