  "facts": [
    {
      "id": 1,
      "text": "Georgetown was founded August 7 1849 by sailor George Phipps and his party during the Gold Rush.",
      "sourceSentenceIds": [
        5,
        10
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/Georgetown,_California",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town earned the nickname \"Growlersburg\" because gold‑laden quartz rocks made a growling noise in miners’ pans.",
      "sourceSentenceIds": [
        1,
        2
      ],
      "sourceLabels": [
        "Web source 1",
        "Wikipedia"
      ],
      "source": "https://grokipedia.com/page/Georgetown,_California",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "After a 1852 fire, Main Street was rebuilt 100 feet wide, a unique design for a 19th‑century mining town.",
      "sourceSentenceIds": [
        19
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Georgetown%2C_California",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Georgetown is California Historical Landmark #484, commemorating its Gold Rush heritage.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Georgetown%2C_California",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The original fire station bell still rings, a relic preserved as part of the town’s historic architecture.",
      "sourceSentenceIds": [
        4
      ],
