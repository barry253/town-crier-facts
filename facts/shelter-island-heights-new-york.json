  "facts": [
    {
      "id": 1,
      "text": "Shelter Island Heights began as a late‑19th‑century Methodist summer retreat, making it one of the East End’s most distinctive historic destinations.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.longislandguide.com/visit/shelter-island-heights/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Shelter Island Heights was listed on both the U.S. and New York State Registers of Historic Places in 1993, preserving its 1872‑era landscape.",
      "sourceSentenceIds": [
        15
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://siheights.com/historic",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The hamlet’s marina culture and ferry links make it a quiet coastal spot between Long Island’s North Fork and South Fork.",
      "sourceSentenceIds": [
        16
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.longislandguide.com/visit/shelter-island-heights/",
      "category": "other",
      "quality": "poor",
      "qualityReason": "vague"
    },
    {
      "id": 4,
      "text": "Shelter Island Heights is best known for its Victorian‑era homes, cottages, inns, and tree‑lined streets that echo its historic charm.",
      "sourceSentenceIds": [
        18
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.longislandguide.com/visit/shelter-island-heights/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Historic preservation, marina culture, ferry access, and coastal scenery keep Shelter Island Heights a distinctive destination on eastern Long Island.",
      "sourceSentenceIds": [
        22
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.longislandguide.com/visit/shelter-island-heights/",
      "category": "culture",
      "quality": "good"
