  "facts": [
    {
      "id": 1,
      "text": "Lachenaie, founded in 1683 by Lord Charles Aubert de Lachenaye, is the oldest of the three towns that merged into Terrebonne.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Terrebonne%2C_Quebec"
    },
    {
      "id": 2,
      "text": "La Plaine emerged in 1830 from parts of Mascouche, Sainte-Anne-des-Plaines, Saint-Lin, and Terrebonne, becoming a distinct sector.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Terrebonne%2C_Quebec"
    },
    {
      "id": 3,
      "text": "The Saint-Louis-de-France Church in Old Terrebonne, built in 1878, sits beside the historic Île-des-moulins, where the parish began in 1723.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Terrebonne%2C_Quebec"
    },
    {
      "id": 4,
      "text": "Rail service launched in 1877 spurred growth, leading to the village of Saint-Joachim, later renamed La Plaine in 1920.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.comeexplorecanada.com/quebec/terrebonne"
    },
    {
      "id": 5,
      "text": "In 1973, Quebec classified Île-des-moulins as a national historic site, preserving its 18th‑century heritage.",
      "sourceSentenceIds": [
        11
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Terrebonne%2C_Quebec"
    },
    {
      "id": 6,
      "text": "Terrebonne lies on Quebec’s North Shore, an off‑island suburb of Montreal just north of Laval across the Rivière des Mille‑Îles.",
