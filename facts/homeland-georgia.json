      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Founders chose a spot near the Waycross/Jacksonville rail line, allowing travelers from the North to arrive in under two days.",
      "sourceSentenceIds": [
        26,
        28
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.charltoncountyhistoricalsociety.org/homeland",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "George Washington Moore, a Madison County financier, co‑founded the Homeland Colony Company and died in 1908 when a boiler exploded at his sawmill.",
      "sourceSentenceIds": [
        13,
        16,
        17
      ],
      "sourceLabels": [
        "Web source 1"
      ],
