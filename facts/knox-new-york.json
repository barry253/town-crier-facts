      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town sits in the Helderberg Mountains and offers rural living close to Albany, Schenectady, and Troy.",
      "sourceSentenceIds": [
        25
      ],
      "sourceLabels": [
        "Web source 1"
      ],
