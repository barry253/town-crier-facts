      "category": "nature",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Knox’s hamlet of Knox lies at the junction of State Route 156 and County Road 252, where Beaverdam Creek flows nearby.",
      "sourceSentenceIds": [
        19,
        20
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Knox%2C_New_York",
      "category": "other",
      "quality": "poor",
      "qualityReason": "location_description"
    },
    {
      "id": 4,
      "text": "The western town line borders Schoharie County and the northern line borders Schenectady County.",
      "sourceSentenceIds": [
