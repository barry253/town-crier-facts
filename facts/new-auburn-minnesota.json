  "facts": [
    {
      "id": 1,
      "text": "New Auburn was platted in 1856 and named after Auburn, New York.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/New_Auburn%2C_Minnesota",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town incorporated as a village on June 6, 1895, reflecting settlers from Auburn, New York, who arrived around 1856.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/new_auburn_minnesota",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "A post office has operated in New Auburn since 1857, marking its early communication link.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/New_Auburn%2C_Minnesota",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "No major railroads served New Auburn, keeping its growth agrarian and localized compared to rail-connected towns.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/new_auburn_minnesota",
      "category": "transport",
      "quality": "poor",
      "qualityReason": "route_only"
    },
    {
      "id": 5,
      "text": "New Auburn’s core values emphasize small‑town character, guided growth, and preservation of historical, cultural, and natural heritage.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.newauburnmn.com/",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The city emerged during Minnesota Territory’s rapid expansion in the mid‑19th century, drawn by fertile prairie, timber, and lakes.",
      "sourceSentenceIds": [
        5
