  "facts": [
    {
      "id": 1,
      "text": "Flatwoods incorporated 1902 but existed as early as 1873; the first church was built in 1830.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Flatwoods%2C_West_Virginia",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Flatwoods was named for the level uplands at the heads of Granny Creek, Salt Lick Creek, and Flatwoods Run.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://wvexplorer.com/communities/cities-towns/flatwoods-west-virginia/",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Flatwoods sat midway on the B&O Railroad’s Clarksburg‑Richwood branch, roughly 62.6 miles from Clarksburg.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Flatwoods%2C_West_Virginia",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Flatwoods became nationally known for the 1952 Flatwoods monster UFO incident that occurred on September 12.",
      "sourceSentenceIds": [
