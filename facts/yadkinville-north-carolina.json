    },
    {
      "id": 2,
      "text": "The town’s first courthouse, a two‑story brick building, was erected in 1853 by William White, who hand‑made the bricks on a nearby farm.",
      "sourceSentenceIds": [
        11,
        12
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Yadkinville%2C_North_Carolina"
    },
    {
      "id": 3,
      "text": "Originally called Wilson after a Mexican‑War legislator, the town was renamed Yadkinville in 1852 when another Wilson, North Carolina, already existed.",
      "sourceSentenceIds": [
        6,
        7,
        8
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Yadkinville%2C_North_Carolina"
    },
    {
      "id": 4,
      "text": "Every year, Yadkinville celebrates its local vineyards with a Harvest Festival and a Grape Festival that honor the Yadkin Valley Vineyards and nearby growers.",
      "sourceSentenceIds": [
        27
      ],
      "sourceLabels": [
        "Wikipedia"
