  "facts": [
    {
      "id": 1,
      "text": "Haugan was named after H.G., the railroad’s land commissioner and comptroller who secured the line’s rights‑of‑way.",
      "sourceSentenceIds": [
        1,
        16
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/haugan_montana",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Established around 1908, Haugan served as a critical pusher station, attaching extra steam locomotives to help trains climb the 2.2% grades of the Bitterroot Range.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/haugan_montana",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The Savenac Nursery Historic District, founded in 1907, once produced up to 12 million seedlings annually for national forests before closing.",
      "sourceSentenceIds": [
        15,
        23
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/haugan_montana",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "When the Milwaukee Road electrified its Pacific Extension in 1919, Haugan’s role as a steam helper station faded, leading to its gradual decline.",
      "sourceSentenceIds": [
        21,
        22
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/haugan_montana",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Haugan was one of several towns destroyed during the Great Fire of 1910, a blaze that reshaped Montana’s western forests.",
      "sourceSentenceIds": [
        26
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Haugan%2C_Montana",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Haugan sits amid the Lolo National Forest, where the Regis River winds through the community’s scenic valley.",
      "sourceSentenceIds": [
        24,
        30
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Haugan%2C_Montana",
