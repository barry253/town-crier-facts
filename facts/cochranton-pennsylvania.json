      "id": 1,
      "text": "Cochranton takes its name from the original land grants of John Adams and Thomas Cochran, who helped found the village.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.frenchcreekconservancy.org/cochranton/",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "First settled in the early 1800s, the town sits where French and Sugar Creeks meet.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.frenchcreekconservancy.org/cochranton/",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "A railroad once ran through Cochranton, bringing new facilities that boosted the town’s growth.",
