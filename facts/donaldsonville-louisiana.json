      ],
      "source": "https://www.donaldsonville-la.gov/history",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Palo Alto Plantation, a historic landmark, showcases antebellum architecture and is listed on the National Register.",
