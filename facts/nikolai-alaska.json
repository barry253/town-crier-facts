  "facts": [
    {
      "id": 1,
      "text": "Nikolai takes its name from Chief Nikolai, a late‑19th‑century leader who settled the area and guided its early community.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/nikolai_alaska",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "In the 1830s, Peter Kolmakov opened a temporary trading post near present‑day Aniak, trading tobacco and cloth for beaver pelts.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/nikolai_alaska",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Nikolai officially incorporated as a city on July 9, 1970, marking its formal municipal status.",
      "sourceSentenceIds": [
        19
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Nikolai%2C_Alaska",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The current site of Nikolai was established around 1918 near a historic trading post and roadhouse on the Rainy Pass Trail during the gold rush era.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/nikolai_alaska",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Nicholas Orthodox Church, built in Nikolai, serves as a central community and cultural landmark for residents.",
      "sourceSentenceIds": [
        11
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/nikolai_alaska",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The Upper Kuskokwim Athabascan people, known as Dichinanek’ Hwt’ana, inhabited the Nikolai region with a semi‑nomadic hunter‑gatherer lifestyle adapted to the boreal forest and riverine environment.",
      "sourceSentenceIds": [
