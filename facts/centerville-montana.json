  "facts": [
    {
      "id": 1,
      "text": "Centerville sits at an elevation of 3,468 feet, placing it high above the surrounding valley and giving it a crisp mountain air.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.mtmemory.org/nodes/view/127820",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Located in east‑central Silver Bow County, Centerville lies in the Cottonwood Creek valley where it meets Sand Coulee Creek, a tributary of the Missouri River.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Centerville%2C_Montana",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Centerville’s name comes from its position halfway between the coal towns of Stockett and Sand Coulee.",
      "sourceSentenceIds": [
        30
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.mtmemory.org/nodes/view/127820",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "In 1905 the Stainsby‑Latham Coal Mine opened, and in 1914 the Lockray Mine was bought by the Anaconda Company to fuel its smelter in Anaconda.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.mtmemory.org/nodes/view/127820",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Centerville began outside Butte’s limits but is now a neighborhood within the city of Butte.",
      "sourceSentenceIds": [
        23
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.mtmemory.org/nodes/view/19384",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Archival photographs from the University of Montana show 19th‑ and 20th‑century mining buildings, dwellings, and churches in Centerville.",
      "sourceSentenceIds": [
        6
      ],
