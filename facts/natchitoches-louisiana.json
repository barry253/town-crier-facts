  "facts": [
    {
      "id": 1,
      "text": "Natchitoches was founded as a French outpost on the Red River for trade with Spanish‑controlled Mexico, with settlers arriving as early as 1699.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Natchitoches%2C_Louisiana",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The city’s name comes from the nearby Natchitoches Indians, whose village the French post was built beside.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Natchitoches%2C_Louisiana",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Established in 1714, Natchitoches is the oldest permanent settlement in the Louisiana Purchase.",
      "sourceSentenceIds": [
        25
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.natchitochesla.gov/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The Magnolia plantation in Natchitoches served as a filming location for the 2013 movie 12 Years a Slave.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
