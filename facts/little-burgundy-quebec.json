  "facts": [
    {
      "id": 1,
      "text": "Little Burgundy grew around 1887 when Montreal’s railway industry drew Black workers from the U.S., Caribbean, and Maritimes.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.historymuseum.ca/teachers-zone/early-black-communities/st-antoine-little-burgundy-montreal-quebec/"
    },
    {
      "id": 2,
      "text": "The neighborhood’s jazz heritage produced legends like Oscar Peterson, who rose to fame during the 1920s music scene.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.afroheritage.ca/communities/little-burgundy/"
    },
    {
      "id": 3,
      "text": "In the 1920s, nightclubs such as Rockhead’s Paradise entertained local and international performers, boosting Little Burgundy’s nightlife.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Little_Burgundy"
    },
    {
      "id": 4,
      "text": "The Negro Community Centre, founded in 1927, remains a historic hub for Black Montrealers and is listed among the neighborhood’s key sites.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Little_Burgundy"
    },
    {
      "id": 5,
      "text": "Little Burgundy’s boundaries stretch from Atwater Avenue west to the Lachine Canal south, with Guy Street marking its eastern edge.",
      "sourceSentenceIds": [
        29
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Little_Burgundy"
    },
    {
      "id": 6,
      "text": "The area was briefly renamed Quartier Georges‑Vnier in the 1980s to shed a low‑income stigma, but the original name persisted.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
