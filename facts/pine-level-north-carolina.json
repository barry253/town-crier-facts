  "facts": [
    {
      "id": 1,
      "text": "Pine Level earned its name from the flat pine forests that surrounded the town when the Oliver brothers set up a turpentine distillery in 1868.",
      "sourceSentenceIds": [
        5,
        6
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.johnstonnc.com/content.cfm?id=1388",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town’s first post office opened in 1886, with Thomas Hinnant as the inaugural postmaster, marking Pine Level’s growing importance in the region.",
      "sourceSentenceIds": [
        12,
        13
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.johnstonnc.com/content.cfm?id=1388",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "A Southern Railroad stop in Pine Level allowed turpentine dealers to ship their product by train, turning the town into a key trading hub for early settlers.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.johnstonnc.com/content.cfm?id=1388",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Pine Level incorporated as a municipality in 1874, becoming the third oldest town in Johnston County.",
      "sourceSentenceIds": [
        20
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.johnstoncountync.org/listing/town-of-pine-level/1892/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The Oliver Store, once a bustling supply shop for turpentine workers, still stands today and is now used as a workshop by a great‑grandson of the original owner.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.johnstonnc.com/content.cfm?id=1388",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "In the early 1900s, Pine Level’s residents celebrated the arrival of a modern water system, a milestone that helped the town keep pace with rapid growth.",
      "sourceSentenceIds": [
        18
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.johnstonnc.com/content.cfm?id=1388",
