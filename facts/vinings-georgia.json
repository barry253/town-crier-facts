  "facts": [
    {
      "id": 1,
      "text": "Vinings began as Crossroads, then Paces, named after Hardy Pace who operated a ferry across the Chattahoochee River.",
      "sourceSentenceIds": [
        21,
        22
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Vinings%2C_Georgia"
    },
    {
      "id": 2,
      "text": "In 1839, the Western & Atlantic Railroad started laying tracks through the area, turning it into a construction hub.",
      "sourceSentenceIds": [
        14
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://vinings.org/vinings-history/"
    },
    {
      "id": 3,
      "text": "Vinings was officially recognized in 1904 when a one‑lane bridge was built across the Chattahoochee River.",
      "sourceSentenceIds": [
        25
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Vinings%2C_Georgia"
    },
    {
      "id": 4,
      "text": "Vinings Historic Preservation Society keeps the town’s 13,000‑year history alive through tours and preservation of historic sites.",
      "sourceSentenceIds": [
        3,
        4
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 2"
      ],
      "source": "https://en.wikipedia.org/wiki/Vinings%2C_Georgia"
    },
    {
      "id": 5,
      "text": "Paces Ferry Road remains the main east–west artery through Vinings, echoing its early ferry heritage.",
