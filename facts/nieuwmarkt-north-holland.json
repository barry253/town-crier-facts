    {
      "id": 1,
      "text": "Nieuwmarkt sits on the site of Amsterdam’s original city gate, once used to weigh goods as ships entered the city walls.",
      "sourceSentenceIds": [
        30
      ],
      "sourceLabels": [
        "Web source 1"
      ],
