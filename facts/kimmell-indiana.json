  "facts": [
    {
      "id": 1,
      "text": "Kimmell was founded in 1831 and named after the Kimmell family of settlers.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Kimmell%2C_Indiana",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The historic Kimmell House, a 4,000‑sq‑ft brick home built in 1876 by Orlando and Jane Kimmell, still features original woodwork and indoor plumbing.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/kimmell_indiana",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The Kimmell House has operated as a bed‑and‑breakfast since 2002 and is eligible for the National Register of Historic Places.",
      "sourceSentenceIds": [
        15
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/kimmell_indiana",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "A post office has served Kimmell continuously since 1888, marking over a century of local mail service.",
      "sourceSentenceIds": [
        17
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Kimmell%2C_Indiana",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Kimmell sits on the Baltimore & Ohio Railroad line, linking it to larger towns like Ligonier and Cromwell.",
      "sourceSentenceIds": [
        14
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/kimmell_indiana",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The community covers about 0.96 square miles of rural land, reflecting its agricultural heritage.",
