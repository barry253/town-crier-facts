      ],
      "source": "https://aptoschamber.com/history-aptos/",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The Santa Cruz Railroad, built by Hihn and Spreckels, ran through Aptos and prompted the town to relocate east of Aptos Creek in 1876.",
      "sourceSentenceIds": [
        12,
