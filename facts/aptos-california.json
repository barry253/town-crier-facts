      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The Aptos History Museum, founded in the 1980s, opened its expanded facility on May 24, 2006, and now displays exhibits in the local library.",
      "sourceSentenceIds": [
