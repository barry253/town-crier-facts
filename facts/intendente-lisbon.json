      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The historic Viúva Lamego ceramic factory, still standing since the 19th century, boasts one of the city’s most stunning tiled facades.",
      "sourceSentenceIds": [
        1,
        4,
        5
      ],
      "sourceLabels": [
