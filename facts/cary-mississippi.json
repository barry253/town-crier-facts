  "facts": [
    {
      "id": 1,
      "text": "Cary was named for former Mississippi governor William L., reflecting the county’s early 19th‑century political heritage.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/cary_mississippi",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Cary emerged in the late 19th century when Sharkey County was formed in 1876 from parts of neighboring counties.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/cary_mississippi",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Cary grew into a cotton‑shipping hub after becoming a station on the Yazoo and Mississippi Valley Railroad in the 1880s.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/cary_mississippi",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The town’s Cary Mounds, a Late Mississippian platform mound, survive today protected by the Archaeological Conservancy on private land south of Deer Creek.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/cary_mississippi",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Cary sits on flat alluvial plains at about 97 feet elevation, making it ideal for cotton and soybean farming.",
      "sourceSentenceIds": [
        19
