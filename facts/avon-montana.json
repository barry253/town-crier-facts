  "facts": [
    {
      "id": 1,
      "text": "Avon, Montana, takes its name from the Welsh word for river, reflecting the Little Blackfoot River that flows through the valley.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Avon%2C_Montana",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "In 1884, Bill Cramer returned with homesteaders, founded Avon, and became its first postmaster.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://southwestmt.com/communities/avon/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The Anderson Phosphate Mine, later called Cominco, operated in the early 1940s and employed up to 150 workers before closing in the 1970s.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://southwestmt.com/communities/avon/",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Avon grew into a supply and shipping hub for ranchers, homesteaders, and miners after the transcontinental road linked the town to the rail network.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://southwestmt.com/communities/avon/",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The Community Hall in Avon remains a living historic building where congregations still gather and laughter echoes through its walls.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://southwestmt.com/communities/avon/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Avon's Fitzpatrick Ranch Historic District is listed on the National Register of Historic Places, preserving its 19th-century ranching heritage.",
      "sourceSentenceIds": [
        15
      ],
