  "facts": [
    {
      "id": 1,
      "text": "Hollywood Theatre opened July 17 1926 with 1,491 seats, originally a vaudeville and silent movie venue.",
      "sourceSentenceIds": [
        20
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Hollywood_Theatre_(Portland%2C_Oregon)",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "In 1961 the theatre became a Cinerama house, showing ultra‑wide 70‑mm films until 1963.",
      "sourceSentenceIds": [
        21
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Hollywood_Theatre_(Portland%2C_Oregon)",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The neighborhood earned its name from the theatre, which was once called Hollyrood after Scotland’s Holyrood.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://hollywoodpdx.org/our-neighborhood/",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The Hollywood Boosters, founded in 1934 by 52 merchants, were the first organized business district association in Portland.",
      "sourceSentenceIds": [
        16
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.hollywoodboosters.com/hollywood-district",
      "category": "people",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Stanley Kubrick’s 2001: A Space Odyssey premiered at the theatre on June 13 1968 and ran for over ten months.",
      "sourceSentenceIds": [
        22
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Hollywood_Theatre_(Portland%2C_Oregon)",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The theatre’s main auditorium features a 50‑foot screen and 384 seats, while two smaller upstairs rooms each hold 111.",
