  "facts": [
    {
      "id": 1,
      "text": "Gainesville was founded in 1850 on a 40‑acre plot donated by Mary E. Clark, a gesture that set the town’s early growth in motion.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Gainesville%2C_Texas",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town’s name honors General Edmund Pendleton Gaines, suggested by Colonel William Fitzhugh, a nod to Texas frontier history.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Gainesville%2C_Texas",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Railroads reshaped Gainesville in the late 1870s, with the Denison and Pacific Railway arriving in 1879 and the Gulf, Colorado & Santa Fe in 1887.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Gainesville%2C_Texas",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Gainesville is the birthplace of Gene Austin, a celebrated singer‑songwriter whose 1930s hits made him a national star.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Gainesville%2C_Texas",
      "category": "people",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The city once housed a large outlet mall, the Gainesville Factory Shops, which drew shoppers from North Texas and southern Oklahoma.",
