      "id": 1,
      "text": "Gainesville was founded in 1850 on a 40‑acre plot donated by Mary E., a gesture that set the town’s early growth in motion.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Wikipedia"
