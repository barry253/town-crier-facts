  "facts": [
    {
      "id": 1,
      "text": "Yonkers was named after Adriaen van der Donck's 1646 land patent, the estate called Colen Donck.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.yonkersny.gov/746/Rich-History",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The Otis Elevator Company, founded by Elisha Otis in 1867, built the first safety elevator factory on the Hudson near present‑day Vark Street.",
      "sourceSentenceIds": [
        17
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.yonkersny.gov/746/Rich-History",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "In 1888, Scottish‑born John Reid opened Saint Andrew’s Golf Club, the first golf course in the United States.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Yonkers%2C_New_York",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Yonkers’ historic Philipse Manor Hall State Historic Site sits near the former Van der Donck mill and hosts a museum of the 18th‑century estate.",
      "sourceSentenceIds": [
        25
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Yonkers%2C_New_York",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The city’s 2015 Yonkers Brewing Company opened in the former Otis Trolley Barn, a National Register‑listed rail station.",
      "sourceSentenceIds": [
        11
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Yonkers%2C_New_York",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Yonkers’ 2007 documentary “Brick by Brick: A Civil Rights Story” chronicles the city’s history of racial discrimination and housing segregation.",
      "sourceSentenceIds": [
