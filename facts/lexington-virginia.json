  "facts": [
    {
      "id": 1,
      "text": "Lexington was founded in 1778 and named after Lexington, Massachusetts, the site of the first shot of the American Revolution.",
      "sourceSentenceIds": [
        4,
        5
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Lexington%2C_Virginia",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The city is home to the Virginia Military Institute, where the Battle of New Market was fought and later filmed in movies like Field of Lost Shoes.",
      "sourceSentenceIds": [
        18,
        12,
        13
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Lexington%2C_Virginia",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Stonewall Jackson and Robert E. Lee are buried in Lexington, and the city hosts a museum in the only house Jackson ever owned.",
      "sourceSentenceIds": [
        20,
        21
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Lexington%2C_Virginia",
      "category": "people",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Cyrus McCormick invented the horse‑drawn mechanical reaper on his family farm in nearby Rockbridge County, and a statue of him stands on Washington and Lee University’s campus.",
      "sourceSentenceIds": [
        22
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Lexington%2C_Virginia",
      "category": "people",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Lexington sits in the Shenandoah Valley, about 50 miles north of Roanoke and 57 miles east of the West Virginia border, overlooking the Maury River.",
      "sourceSentenceIds": [
        17,
        24
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Lexington%2C_Virginia",
