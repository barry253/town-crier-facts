  "facts": [
    {
      "id": 1,
      "text": "Cochituate means 'place of swift water' in Algonquian, named for the brook that flows from Lake Cochituate.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/cochituate_massachusetts",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Lake Cochituate, a 625‑acre Great Pond, sits at the heart of Cochituate, divided into North, Middle, and South basins.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/cochituate_massachusetts",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The Cochituate Branch Library opened in 1871 as a modest reading room funded by mill owners, later evolving into a cultural hub.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/cochituate_massachusetts",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Factories along Cochituate’s waterways produced boots and shoes, attracting Irish, Italian, and French‑Canadian workers and turning the village into a bustling industrial hamlet by the 1870s.",
      "sourceSentenceIds": [
        2,
        3
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/cochituate_massachusetts",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "By 1895, Cochituate boasted its own post office and railroad service, linking residents to regional trade networks.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://roadsidethoughts.com/ma/cochituate-xx-middlesex-profile.htm",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Lake Cochituate lies within the Sudbury River Basin, part of the larger Merrimack River watershed that drains into the Atlantic.",
