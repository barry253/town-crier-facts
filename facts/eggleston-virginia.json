  "facts": [
    {
      "id": 1,
      "text": "In 1755, Adam Harmon met Mary Ingles—who had escaped Shawnee captivity—near Eggleston, a moment that echoes Virginia frontier lore.",
      "sourceSentenceIds": [
        1,
        21
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/eggleston_virginia",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Construction of the New River Extension of the Norfolk and Western Railway began in 1881, reaching Eggleston by 1883 and opening the valley to travelers.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/eggleston_virginia",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The Giles County Historical Museum complex in Eggleston houses four buildings, including the Andrew Johnston House and a research library that preserves local genealogy.",
      "sourceSentenceIds": [
        3,
        4
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://visitswva.org/attractions/giles-county-historical-museum/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "In 1867, Captain William Eggleston renamed the local hot‑spring resort Eggleston Springs, cementing the town’s health‑focused identity.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/eggleston_virginia",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Today, Eggleston’s stretch of the New River is a celebrated canoe route, offering Class III rapids and sightings of great blue herons and wood ducks.",
      "sourceSentenceIds": [
        23,
        24,
        25
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/eggleston_virginia",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The first permanent European settlement in Giles County began around 1745 when German immigrant Adam Harmon established a post at Gunpowder Springs along the New River.",
