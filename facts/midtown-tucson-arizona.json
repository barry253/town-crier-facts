  "facts": [
    {
      "id": 1,
      "text": "Midtown Tucson sits on land that was first farmed by the Hohokam Indians for about 4,000 years before Spanish missionaries arrived.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.visittucson.org/plan-your-visit/about-tucson/history/"
    },
    {
      "id": 2,
      "text": "The city of Tucson was founded on August 20, 1775, a date still celebrated each year with the La Fiesta de San Agustín birthday party.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.visittucson.org/plan-your-visit/about-tucson/history/"
    },
    {
      "id": 3,
      "text": "Tucson became an incorporated city in 1877, making it the oldest city in Arizona.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.visittucson.org/plan-your-visit/about-tucson/history/"
    },
    {
      "id": 4,
      "text": "The arrival of the Southern Pacific Railroad in 1880 helped Tucson grow into a multicultural hub of Tohono Oʼodham, Mexican, and early settler traditions.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.visittucson.org/plan-your-visit/about-tucson/history/"
    },
    {
      "id": 5,
      "text": "In 1854, the Gadsden Purchase transferred the Tucson region from Mexico to the United States, officially adding it to U.S. territory.",
      "sourceSentenceIds": [
        11
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.visittucson.org/plan-your-visit/about-tucson/history/"
    },
    {
      "id": 6,
      "text": "Mission San Xavier del Bac, built in the late 1600s, remains one of Tucson’s most historic and photographed landmarks.",
