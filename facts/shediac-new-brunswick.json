  "facts": [
    {
      "id": 1,
      "text": "Shediac’s name comes from the Mi'kmaq word Esedeiik, meaning \"which comes from far away,\" hinting at its bay’s reach.",
      "sourceSentenceIds": [
        18
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Shediac",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Shediac proudly calls itself the Lobster Capital of the World and hosts a July festival celebrating its fishing heritage.",
      "sourceSentenceIds": [
        14,
        15
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Shediac",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The first passenger railway line in the Maritimes began in Shediac, making it a transportation pioneer.",
      "sourceSentenceIds": [
        11
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://shediac.ca/en/my-town/discover/history",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Shediac Bay Yacht Club’s century‑old wharf is listed on Canada’s Historic Places, a testament to the town’s maritime roots.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Shediac",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Before becoming Shediac, the area was called La Batture and the Mi'kmaq called it Esedev'ik, reflecting its early settlement.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://archives.gnb.ca/en-ca/communities/westmorland/shediac/shediac",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "William Blizzard, a Shediac resident, pioneered the lobster processing industry, shaping the town’s culinary reputation.",
