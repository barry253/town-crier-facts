  "facts": [
    {
      "id": 1,
      "text": "Whiteman Air Force Base was originally called Sedalia Glider Base, renamed after 2nd Lt George Whiteman killed at Pearl Harbor.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Whiteman_Air_Force_Base"
    },
    {
      "id": 2,
      "text": "In 1942, the Army Air Corps chose the site for a glider training field, opening the base on August 6, 1942.",
      "sourceSentenceIds": [
        25,
        26
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Whiteman_Air_Force_Base"
    },
    {
      "id": 3,
      "text": "The railroad spur built by Missouri Pacific Railroad cut through the “Blue Flats,” a local name for the area's distinctive soil color.",
      "sourceSentenceIds": [
        6,
        7
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Whiteman_Air_Force_Base"
    },
    {
      "id": 4,
      "text": "During the Cold War, 150 Minuteman ICBMs were stationed near the base, later dismantled under arms reductions.",
      "sourceSentenceIds": [
        23
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Whiteman_Air_Force_Base"
    },
    {
      "id": 5,
      "text": "Whiteman became home to the B‑2 Spirit stealth bomber in the 1990s, hosting the first operational B‑2 unit after relocating from Pease AFB.",
      "sourceSentenceIds": [
        15,
        16
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Whiteman_Air_Force_Base"
    },
    {
      "id": 6,
      "text": "The base’s 509th Bomb Wing traces its roots to the 509th Composite Group that dropped the first atomic bomb on Hiroshima in 1945.",
