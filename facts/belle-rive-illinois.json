  "facts": [
    {
      "id": 1,
      "text": "Belle Rive was founded in 1871, the same year the St. Louis and Evansville railroad line opened nearby.",
      "sourceSentenceIds": [
        3,
        16
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Belle_Rive%2C_Illinois"
    },
    {
      "id": 2,
      "text": "The village’s name honors Louis Groston de Saint-Ange de Bellerive, who surrendered Illinois to the British in 1765.",
      "sourceSentenceIds": [
        20
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Belle_Rive%2C_Illinois"
    },
    {
      "id": 3,
      "text": "Belle Rive sits in southeastern Jefferson County, just 11 miles southeast of the county seat, Mount Vernon.",
      "sourceSentenceIds": [
        23,
        12
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Belle_Rive%2C_Illinois"
    },
    {
      "id": 4,
      "text": "Illinois Route 142 cuts through Belle Rive, linking the village to Mount Vernon and McLeansboro.",
      "sourceSentenceIds": [
        24
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Belle_Rive%2C_Illinois"
    },
    {
      "id": 5,
      "text": "The village drains into Auxier Creek, a tributary of the Little Wabash River watershed.",
      "sourceSentenceIds": [
        25
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Belle_Rive%2C_Illinois"
    },
    {
      "id": 6,
      "text": "Early land speculator John Grant bought 480 acres of federal land that would become Belle Rive before his death in 1863.",
