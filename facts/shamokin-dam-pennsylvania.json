  "facts": [
    {
      "id": 1,
      "text": "Shamokin Dam sits on the western bank of the Susquehanna River, just south of where the river’s west and north branches meet.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Shamokin_Dam%2C_Pennsylvania",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The borough’s name means “place of eels” in Delaware and also comes from a 10‑foot dam built across the river in the 19th century.",
      "sourceSentenceIds": [
        17
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Shamokin_Dam%2C_Pennsylvania",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "From 1772 until 1907, steamboat ferries ran across the Susquehanna, linking Shamokin Dam with Sunbury on the opposite bank.",
      "sourceSentenceIds": [
        18,
        19,
        20
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Shamokin_Dam%2C_Pennsylvania",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The Norfolk Southern Railway cuts through the borough, running between Old Trail Road and the river, a relic of the region’s rail history.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Shamokin_Dam%2C_Pennsylvania",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Shamokin Dam was founded in the early 19th century, long after the original Indian settlement of Shamokin, one of Pennsylvania’s largest in the 1700s.",
      "sourceSentenceIds": [
        6,
        11
      ],
