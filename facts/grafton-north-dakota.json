      "id": 1,
      "text": "Grafton was founded in 1881 and became the county seat of Walsh County the same year.",
      "sourceSentenceIds": [
        2,
        27
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Grafton%2C_North_Dakota",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town was named after Grafton County, New Hampshire, reflecting the origins of many early settlers.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Grafton%2C_North_Dakota",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The Great Northern Railroad arrived in December 1881, sparking rapid growth and making Grafton a key rail hub.",
      "sourceSentenceIds": [
        13,
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://visitgraftonnd.com/our-history/",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Grafton's Carnegie Regional Library opened in 1897, the first public library in North Dakota.",
      "sourceSentenceIds": [
        16,
        18
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Grafton%2C_North_Dakota",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The Grafton State School, a historic home for the developmentally disabled, is listed on the National Register of Historic Places.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Grafton%2C_North_Dakota",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The Grafton Winter Sports Arena was the site of North Dakota's first indoor hockey arena.",
