  "facts": [
    {
      "id": 1,
      "text": "Snyder was named after merchant and buffalo hunter William Henry “Pete” Snyder, who opened a trading post on Deep Creek in 1878.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Snyder%2C_Texas",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "In 1907 Snyder received its city charter and the Roscoe, Snyder and Pacific Railway began construction, linking the town to regional trade.",
      "sourceSentenceIds": [
        10,
        21
      ],
      "sourceLabels": [
        "Web source 1",
        "Wikipedia"
      ],
      "source": "https://www.snydertx.gov/325/About-Snyder",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Oil struck the Canyon Reef area north of Snyder in 1948, turning the town into one of Texas’s leading oil producers for decades.",
      "sourceSentenceIds": [
        24,
        25,
        26
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Snyder%2C_Texas",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Today the Scurry County Courthouse features a statue of an albino buffalo, honoring Snyder’s origins as a buffalo‑trading post.",
