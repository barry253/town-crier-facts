  "facts": [
    {
      "id": 1,
      "text": "Tokeland was named after Chief Toke of the Shoalwater Bay Tribe, who first met a ship in 1788.",
      "sourceSentenceIds": [
        1,
        12
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Tokeland%2C_Washington"
    },
    {
      "id": 2,
      "text": "The town’s oldest hotel, the Tokeland Hotel, began as the Kindred Inn in 1899 and sits on the National Register of Historic Places.",
      "sourceSentenceIds": [
        5,
        6
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Tokeland%2C_Washington"
    },
    {
      "id": 3,
      "text": "Tokeland sits on the north rim of Willapa Bay, near the mouth of the Cedar River, and was a summer home for Chief Toke’s family.",
      "sourceSentenceIds": [
        11,
        25,
        12
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Tokeland%2C_Washington"
    },
    {
      "id": 4,
      "text": "The town’s first post office opened in 1894, operated by the Kindreds for 17 years, reflecting early community life.",
      "sourceSentenceIds": [
        15
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Tokeland%2C_Washington"
    },
    {
      "id": 5,
      "text": "Tokeland’s economy revived in the 1950s when recreational boating, fishing, and a resurgence of oyster harvests boosted local businesses.",
