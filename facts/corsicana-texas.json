      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://visitcorsicana.com/history-in-corsicana/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The Corsicana YMCA, founded in 1884, grew with patron funding and remains a community hub.",
