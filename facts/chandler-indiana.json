  "facts": [
    {
      "id": 1,
      "text": "Chandler began as the settlement of Lee in early 19th century before becoming Chandler in 1874.",
      "sourceSentenceIds": [
        4,
        17
      ],
      "sourceLabels": [
        "Web source 1",
        "Wikipedia"
      ],
      "source": "https://www.townofchandler.org/about/history/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town’s name changed from Lee to Chandler when the railroad arrived, marking its growth as a coal‑mining hub.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Chandler%2C_Indiana",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Chandler’s canal history is visible today on Tow Path Road, a remnant of the unfinished Wabash‑and‑Erie Canal.",
      "sourceSentenceIds": [
        5,
        8
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Chandler%2C_Indiana",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The Erie Canal/Air Line Mine operated for 40 years before closing in 1937, one of only three mines active at a time.",
      "sourceSentenceIds": [
        7,
        10
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Chandler%2C_Indiana",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Chandler’s public library is a branch of the Ohio Township Public Library System, serving the community’s reading needs.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Chandler%2C_Indiana",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "In 1953 Chandler incorporated, electing three trustees and a clerk‑treasurer to guide the town’s development.",
