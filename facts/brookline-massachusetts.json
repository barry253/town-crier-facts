  "facts": [
    {
      "id": 1,
      "text": "Frederick Law Olmsted’s former estate, now the Frederick Law Olmsted National Historic Site, sits on 7 acres of landscaped grounds in Brookline.",
      "sourceSentenceIds": [
        26
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Brookline%2C_Massachusetts",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Brookline houses the Kennedy National Historic Site, the birthplace of President John F. Kennedy, listed on the National Register of Historic Places.",
      "sourceSentenceIds": [
        10,
        24,
        25
      ],
      "sourceLabels": [
        "Web source 2",
        "Wikipedia"
      ],
      "source": "https://travelingtulls.com/things-to-do-brookline-ma/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The Highland branch of the Boston and Albany Railroad, built in 1847, linked Brookline Village to Kenmore Square and extended into Newton by 1852.",
      "sourceSentenceIds": [
        21
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Brookline%2C_Massachusetts",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Brookline’s historic Blake Park neighborhood was laid out by banker Arthur Welland Blake with Frederick Law Olmsted’s subdivision plans in 1880.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.brooklinema.gov/795/Places-to-Visit",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Brookline Village blends local commerce with historic landmarks such as the Old Lincoln School and the charming Linden Park.",
