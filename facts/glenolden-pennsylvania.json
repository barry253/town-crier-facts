  "facts": [
    {
      "id": 1,
      "text": "Glenolden’s name comes from the Glen Olden Mills, originally written as two words, honoring mill owner Ephriam Ridgeway’s mother.",
      "sourceSentenceIds": [
        1,
        2
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://delawarecountyhistory.com/glenoldenborough.html",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The borough was incorporated on November 15, 1894, separating from both Ridley and Darby Townships.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://delawarecountyhistory.com/glenoldenborough.html",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Glenolden Station, a stop on SEPTA’s Wilmington/Newark Line, keeps the borough connected to Philadelphia’s rail network.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Glenolden%2C_Pennsylvania",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The local public schools, collectively called Glenolden School, serve elementary and middle‑grade students in the borough.",
      "sourceSentenceIds": [
        20
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Glenolden%2C_Pennsylvania",
      "category": "landmark",
      "quality": "poor",
      "qualityReason": "other"
    },
    {
      "id": 5,
      "text": "Vince Papale, the former Philadelphia Eagles player whose story inspired the film Invincible, was born in Glenolden.",
      "sourceSentenceIds": [
        21
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Glenolden%2C_Pennsylvania",
      "category": "people",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Chester Pike, the main thoroughfare through Glenolden, runs northeast to downtown Philadelphia and southwest to Chester.",
