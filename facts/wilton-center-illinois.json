  "facts": [
    {
      "id": 1,
      "text": "Wilton Center sits on flat land 10 miles northeast of Wilmington, 5 miles south of Manhattan, and 8 miles west of Peotone.",
      "sourceSentenceIds": [
        24
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Wilton_Center%2C_Illinois",
      "category": "other",
      "quality": "poor",
      "qualityReason": "location_description"
    },
    {
      "id": 2,
      "text": "The town was officially organized in 1860 at the south end of the Twelve Mile Grove, noting two general stores, two wagon shops, two churches, several homes, and a school.",
      "sourceSentenceIds": [
        28
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Wilton_Center%2C_Illinois",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The area that became Wilton Center was once called the Twelve Mile Grove, named for a 10‑mile stretch of forest that early settlers logged.",
      "sourceSentenceIds": [
        26
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Wilton_Center%2C_Illinois",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "In 1832, Potawatomi leaders Ce‑nag‑e‑wine and Joseph Laughton were granted reservations along Forked Creek, which later became part of Wilton Center.",
      "sourceSentenceIds": [
        25
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Wilton_Center%2C_Illinois",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "A 2016 survey catalogued 124 farmsteads in Wilton Township, with 16 sites deemed eligible for Will County Historic Landmark status.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://docslib.org/doc/6027946/rural-historic-structural-survey-of-wilton-township-will-county-illinois",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The only existing county landmark in Wilton Township is the historic Twelve Mile Grove Cemetery.",
