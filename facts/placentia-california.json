  "facts": [
    {
      "id": 1,
      "text": "Legend says Sarah Jane McFadden, wife of early settler William, named Placentia in 1879, though the exact inspiration remains a mystery.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.orangecounty.net/cities/Placentia_history.html",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Placentia grew into a major Santa Fe Railroad stop in 1910 when settlers persuaded the line to reroute through the town for orange shipments.",
      "sourceSentenceIds": [
        13,
        19,
        20
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Placentia%2C_California",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "In 2007, Placentia became the first city to create a quiet zone, letting trains pass without sounding the warning whistle.",
      "sourceSentenceIds": [
        17
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Placentia%2C_California",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The Placentia Library celebrated its centennial in 2018 with a $2.3 million renovation that modernized its 102,000‑item collection.",
