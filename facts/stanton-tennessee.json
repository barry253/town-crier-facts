  "facts": [
    {
      "id": 1,
      "text": "Stanton grew around the Memphis & Ohio Railroad, which arrived in the 1830s on land bought by Joseph Blackwell Stanton.",
      "sourceSentenceIds": [
        1,
        13
      ],
      "sourceLabels": [
        "Web source 2",
        "Wikipedia"
      ],
      "source": "https://stantontn.gov/our-community/our-history/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town’s first charter appeared in the 1880s but was quickly revoked, leaving Stanton without formal municipal status for many years.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://stantontn.gov/our-community/our-history/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "A 1871 Masonic Lodge served both as a meeting hall and a school on its lower floor, reflecting the town’s early blend of civic and educational life.",
      "sourceSentenceIds": [
        23
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Stanton%2C_Tennessee",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Stanton’s Presbyterian church, built in 1872, stands as one of the town’s oldest religious structures, predating the 1952 Church of Christ.",
      "sourceSentenceIds": [
        22
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Stanton%2C_Tennessee",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The town’s historic downtown once housed a hotel and a Baptist church that also served as the first school, showcasing its early community hubs.",
      "sourceSentenceIds": [
        18,
        19
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Stanton%2C_Tennessee",
