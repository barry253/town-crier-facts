  "facts": [
    {
      "id": 1,
      "text": "Renfrew was founded in 1882 by David Renfrew, a Scottish‑descended miller and schoolteacher, on a 600‑acre farm near Connoquenessing Creek.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/renfrew_pennsylvania",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The village began as a company town, then exploded into an oil and coal hub once railroads linked it to Pittsburgh markets.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/renfrew_pennsylvania",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "A rare surviving steel derrick, the circa‑1900 David Renfrew Oil Rig, stands today as a historic engineering landmark.",
      "sourceSentenceIds": [
        15
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/renfrew_pennsylvania",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Renfrew’s original Methodist church, built in the 1880s, still guards the town and reflects its early religious life.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.experiencebutler.com/cities-and-towns/renfrew/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Today, alpaca farms and blueberry picking at Bowser’s Blueberries offer a quiet rural escape while the town keeps its historic charm.",
