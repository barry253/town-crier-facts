  "facts": [
    {
      "id": 1,
      "text": "Douglas City was renamed in 1859 after Stephen Douglas, the Illinois senator famous for the 1858 Lincoln–Douglas debates.",
      "sourceSentenceIds": [
        2,
        5
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Douglas_City%2C_California",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town began as Kanaka Bar in 1848, a mining camp taken over by Oregon prospectors before moving a quarter mile to become Douglas City.",
      "sourceSentenceIds": [
        4,
        5
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://westernmininghistory.com/towns/california/douglas-city/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "In 1863, about 60 volunteers marched to defend Douglas City from a band of Indians, but the group escaped without direct confrontation.",
      "sourceSentenceIds": [
        1,
        12
      ],
      "sourceLabels": [
        "Web source 2",
        "Web source 1"
      ],
      "source": "https://westernmininghistory.com/towns/california/douglas-city/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Indigenous Wintun people, called Tien-Tien meaning \"friends,\" inhabited the area long before gold seekers disrupted their lands.",
      "sourceSentenceIds": [
        8,
        6
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Douglas_City%2C_California",
      "category": "people",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Douglas City sits at 2,152 feet along the Trinity River, one of the earliest European‑American settlements after gold was found in 1848.",
      "sourceSentenceIds": [
        19,
        10
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Douglas_City%2C_California",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The town’s early economy relied on placer mining, later shifting to timber and cannabis, reflecting Trinity County’s broader economic swings.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/douglas_city_california",
