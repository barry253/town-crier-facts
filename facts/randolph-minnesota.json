  "facts": [
    {
      "id": 1,
      "text": "Randolph’s railroad heyday began in 1882, with the Cannon Valley Line and the Chicago Great Western and Minneapolis, Northfield & Southern railroads, until the last train ran in 1976.",
      "sourceSentenceIds": [
        10,
        12,
        14,
        1
