  "facts": [
    {
      "id": 1,
      "text": "Cordova was originally called Hunkins, named after pioneer Benjamin Hunkins, and was platted in 1887 when the Fremont, Elkhorn and Missouri Valley Railroad reached it.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Cordova%2C_Nebraska",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town’s name changed to Cordova after Cordova, Spain, to avoid confusion with another Nebraska post office.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Cordova%2C_Nebraska",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "A post office has operated in Cordova continuously since 1888, serving as a longstanding community hub.",
