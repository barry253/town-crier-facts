      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "In the 1890s Kennedy shipped over 3,600 cotton bales each year, but by the mid‑20th century factories replaced cotton as the main employer.",
      "sourceSentenceIds": [
        6,
        17
      ],
      "sourceLabels": [
