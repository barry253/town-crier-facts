      "id": 1,
      "text": "Como got its name from settlers who came from Como, Mississippi, prompting a 1894 name change to avoid confusion with nearby Carrollton.",
      "sourceSentenceIds": [
        22
      ],
      "sourceLabels": [
        "Web source 1"
      ],
