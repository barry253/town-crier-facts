      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "A post office named Portland Station opened September 14, 1871, giving the village its early name.",
      "sourceSentenceIds": [
        2,
        15
      ],
      "sourceLabels": [
        "Web source 1",
        "Wikipedia"
      ],
      "source": "https://grokipedia.com/page/rayland_ohio",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The village sits on the Ohio River floodplain, its low elevation shaped by the river’s floodplain characteristics.",
      "sourceSentenceIds": [
        6
      ],
