  "facts": [
    {
      "id": 1,
      "text": "Alice Acres was named after Alice Gertrudis King Kleberg, the wife of Robert Justus Kleberg, honoring her legacy.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.tshaonline.org/handbook/entries/alice-tx"
    },
    {
      "id": 2,
      "text": "In 1883 a depot called Bandana opened at the junction of the Corpus Christi, San Diego and Rio Grande Railway, after locals resisted railroad land sales.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.tshaonline.org/handbook/entries/alice-tx"
    },
    {
      "id": 3,
      "text": "Every May, Alice Acres hosts the Fiesta Bandana, a local celebration that showcases regional music and culture.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.tshaonline.org/handbook/entries/alice-tx"
    },
    {
      "id": 4,
      "text": "A historical marker unveiled on August 28, 1993 commemorates Alice Acres' centennial, celebrating a century of community life.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.tshaonline.org/handbook/entries/alice-tx"
    },
    {
      "id": 5,
      "text": "The town opened its first public library in 1935, providing residents access to books during the Great Depression.",
      "sourceSentenceIds": [
        11
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.tshaonline.org/handbook/entries/alice-tx"
    },
    {
      "id": 6,
      "text": "By 1966, Alice Acres boasted 429 businesses, including nineteen manufacturers, twenty churches, and a hospital, reflecting robust local growth.",
      "sourceSentenceIds": [
