    },
    {
      "id": 2,
      "text": "The West River Railroad reached its northern terminus in South Londonderry when the last rail was laid in 1880.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.londonderryvt.gov/community/history.php"
    },
    {
      "id": 3,
      "text": "South Londonderry sits on both sides of the West River, which is a southeast-flowing tributary of the Connecticut River.",
      "sourceSentenceIds": [
        13
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/South_Londonderry%2C_Vermont"
    },
    {
      "id": 4,
      "text": "The South Londonderry Village Historic District protects many old buildings that show what the village looked like long ago.",
      "sourceSentenceIds": [
        18
