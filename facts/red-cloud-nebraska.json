  "facts": [
    {
      "id": 1,
      "text": "Red Cloud was founded in 1871 on homestead land filed by Silas Garber and company, and became the county seat that same year.",
      "sourceSentenceIds": [
        1,
        7,
        25
      ],
      "sourceLabels": [
        "Web source 1",
        "Web source 2",
        "Wikipedia"
      ],
      "source": "https://www.visitredcloud.com/about/history-red-cloud"
    },
    {
      "id": 2,
      "text": "The town was named after Oglala Sioux Chief Red Cloud, honoring his legacy while the area was traditionally Pawnee territory.",
      "sourceSentenceIds": [
        2,
        8,
        9
      ],
      "sourceLabels": [
        "Web source 1",
        "Web source 2"
      ],
      "source": "https://www.visitredcloud.com/about/history-red-cloud"
    },
    {
      "id": 3,
      "text": "Willa Cather spent her childhood in Red Cloud, and the town preserves her childhood home as part of the National Willa Cather Center.",
      "sourceSentenceIds": [
        3,
        13,
        15,
        24,
        26
      ],
      "sourceLabels": [
        "Web source 1",
        "Wikipedia"
      ],
      "source": "https://www.visitredcloud.com/about/history-red-cloud"
    },
    {
      "id": 4,
      "text": "Red Cloud’s historic downtown still features brick streets, the refurbished Opera House, and the Moon Block, all part of the National Willa Cather Center.",
      "sourceSentenceIds": [
        13
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.visitredcloud.com/about/history-red-cloud"
    },
    {
      "id": 5,
      "text": "In the 1880s, Red Cloud served as a division center for the railroad, a role that helped shape its early growth.",
      "sourceSentenceIds": [
        12,
        18
      ],
      "sourceLabels": [
        "Web source 1",
        "Web source 2"
      ],
      "source": "https://www.visitredcloud.com/about/history-red-cloud"
    },
    {
      "id": 6,
      "text": "The town hosts two National Historic Landmarks: the Pike-Pawnee Village and the Willa Cather Childhood Home, among only 20 in Nebraska.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.visitredcloud.com/about/history-red-cloud"
    }
