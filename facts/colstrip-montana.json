  "facts": [
    {
      "id": 1,
      "text": "Colstrip was founded in 1924 by the Northern Pacific Railway to supply coal for its steam locomotives.",
      "sourceSentenceIds": [
        18,
        1
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 2"
      ],
      "source": "https://en.wikipedia.org/wiki/Colstrip%2C_Montana",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town’s original schoolhouse, built in 1924, now serves as a visitor center, art gallery, and mine‑tour venue from May to October.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.visitmt.com/cities-towns/colstrip",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Castle Rock Lake, a 150‑acre reservoir completed in 1974, delivers water for Colstrip’s steam plants through a 30‑mile underground pipe from the Yellowstone River.",
      "sourceSentenceIds": [
        26,
        28
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Colstrip%2C_Montana",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Colstrip’s four coal‑fired plants opened in 1975, 1976, 1984, and 1986; the first two shut in 2020, leaving two still operating without modern pollution controls.",
      "sourceSentenceIds": [
        15,
        16,
        17
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Colstrip%2C_Montana",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "During World War II, Colstrip mine was deemed strategically vital, supplying coal for Northern Pacific trains hauling military equipment, and workers were guarded and forbidden from quitting.",
      "sourceSentenceIds": [
        20,
        21
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Colstrip%2C_Montana",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Deer Medicine Rocks, a National Historic Landmark, sits 23 miles south of Colstrip.",
      "sourceSentenceIds": [
        2
