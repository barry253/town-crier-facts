  "facts": [
    {
      "id": 1,
      "text": "Land in the area now known as Perry was first claimed in 1851 by Orrin Porter Rockwell and his brother Merritt.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Perry%2C_Utah"
    },
    {
      "id": 2,
      "text": "Settlement by LDS pioneers began in 1853 when William Plummer Tippets built a cabin at a location known as Three Mile Creek.",
      "sourceSentenceIds": [
        11
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Perry%2C_Utah"
    },
    {
      "id": 3,
      "text": "The community was renamed Perry in 1898 after Gustavus Adolphus Perry and his family, who were among the early settlers.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Perry%2C_Utah"
    },
    {
      "id": 4,
      "text": "When the railroad arrived in the late 1860s, residents earned revenue by hauling timber and telegraph poles from the canyon.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://onlineutah.us/perry_history.shtml"
    },
    {
      "id": 5,
      "text": "Perry has historically been a rural agricultural hub consisting of family dairies, cattle farms, and fruit orchards.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Perry%2C_Utah"
    },
    {
      "id": 6,
      "text": "The east side of Perry is bordered by the Cache National Forest at the northern end of the Wasatch Range.",
