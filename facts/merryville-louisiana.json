  "facts": [
    {
      "id": 1,
      "text": "Merryville sprang up in the early 1900s as a timber town, with the Kansas City Southern Railway bringing lumber mills to the pine forests near the Sabine River.",
      "sourceSentenceIds": [
        1,
        3
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/Merryville,_Louisiana",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "In 1912, the Brotherhood of Timber Workers sparked a strike at Merryville's American Lumber Company mill, rallying over 1,300 black, white, and Native American workers for better conditions.",
      "sourceSentenceIds": [
        5,
        10
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/Merryville,_Louisiana",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Every March, Merryville hosts the Pioneer Heritage Festival, a two‑day celebration featuring parades, old‑west reenactments, live music, and a petting zoo.",
      "sourceSentenceIds": [
        27,
        28,
        29
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.beauregardtourism.com/merryville.html",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Singer Solar and other packaging projects have modestly boosted Merryville’s economy, keeping its rural, service‑oriented character.",
