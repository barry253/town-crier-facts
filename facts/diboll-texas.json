  "facts": [
    {
      "id": 1,
      "text": "Diboll was founded in 1894 and named after J.C. Temple, a local timber salesman.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.east-texas.com/diboll-texas.htm"
    },
    {
      "id": 2,
      "text": "The town grew around a railroad station and lumber company offices that marked its early industrial heart.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.tshaonline.org/handbook/entries/diboll-tx"
    },
    {
      "id": 3,
      "text": "Temple used his influence to sell company houses to residents, encouraging private home building.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.tshaonline.org/handbook/entries/diboll-tx"
    },
    {
      "id": 4,
      "text": "In the 1950s a new shopping center replaced the old commissary, a bank opened, schools improved, a radio station began broadcasting, and a library was built.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.tshaonline.org/handbook/entries/diboll-tx"
    },
    {
      "id": 5,
      "text": "The Temple Memorial Library and the Lorties & Author Temple Civic Center are key cultural hubs today.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.east-texas.com/diboll-texas.htm"
    },
    {
      "id": 6,
      "text": "Temple Industries, founded by J.C. Temple, became a major forest products manufacturer known as Temple‑Inland.",
      "sourceSentenceIds": [
