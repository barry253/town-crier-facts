  "facts": [
    {
      "id": 1,
      "text": "Oroville earned its name from the Spanish word for gold, a lure for prospectors, and was renamed Oroville in 1909 to avoid confusion with another town.",
      "sourceSentenceIds": [
        2,
        3
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Oroville%2C_Washington"
    },
    {
      "id": 2,
      "text": "The Cascade and Columbia River Railroad ends at Oroville, making it the northern terminus of this short‑line line.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Oroville%2C_Washington"
    },
    {
      "id": 3,
      "text": "During its mining heyday, Oroville boasted saloons, restaurants, shops, and even a drive‑in movie theater.",
      "sourceSentenceIds": [
        18
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Oroville%2C_Washington"
    },
    {
      "id": 4,
      "text": "Oroville sits at the south end of Osoyoos Lake, where the lake feeds the Okanogan River and the Similkameen River borders the west.",
      "sourceSentenceIds": [
        13
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Oroville%2C_Washington"
    },
    {
      "id": 5,
      "text": "U.S. Route 97 cuts through Oroville, linking it to neighboring towns along the Okanogan Valley.",
