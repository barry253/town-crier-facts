      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/New_Riegel%2C_Ohio",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The village’s Catholic roots trace back to German immigrants who formed a mission community under Saint Boniface.",
      "sourceSentenceIds": [
