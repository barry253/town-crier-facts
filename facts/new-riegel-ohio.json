      ],
      "source": "https://en.wikipedia.org/wiki/New_Riegel%2C_Ohio",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Precious Blood Missionaries served New Riegel for over 150 years, starting in 1844, and their sisters ran the local school from 1845.",
      "sourceSentenceIds": [
        8,
        9
      ],
      "sourceLabels": [
        "Wikipedia"
