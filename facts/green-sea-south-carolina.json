  "facts": [
    {
      "id": 1,
      "text": "The region of Green Sea was originally inhabited by the Waccamaw Siouan Indians before European arrival.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/green_sea_south_carolina"
    },
    {
      "id": 2,
      "text": "Green Sea was first known as Norton's Crossroads after William Norton received a land grant here in 1784.",
      "sourceSentenceIds": [
        4,
        18,
        25
      ],
      "sourceLabels": [
        "Web source 1",
        "Web source 2"
      ],
      "source": "https://www.horrycountysc.gov/news/articles/latest-horry-county-historic-marker-unveiled-in-green-sea/"
    },
    {
      "id": 3,
      "text": "Settler Joseph Henry Derham reportedly named Green Sea around 1858 because the landscape reminded him of Ireland.",
      "sourceSentenceIds": [
        27
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/green_sea_south_carolina"
    },
    {
      "id": 4,
      "text": "Green Sea was established as one of Horry County's eleven original townships around 1868.",
      "sourceSentenceIds": [
        26
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/green_sea_south_carolina"
    },
    {
      "id": 5,
      "text": "The historic Derham House in Green Sea is listed on the National Register of Historic Places.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Green_Sea%2C_South_Carolina"
    },
    {
      "id": 6,
      "text": "Horry County recently unveiled a historic marker at the corner of Green Sea and Mitchell Sea Roads to commemorate the community's heritage.",
