  "facts": [
    {
      "id": 1,
      "text": "Glenville was named after Alexander Lindsay Glen, a Scottish landowner who settled in the area in the 1650s.",
      "sourceSentenceIds": [
        1,
        7
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Glenville%2C_New_York"
    },
    {
      "id": 2,
      "text": "The town incorporated in 1821, separating from the larger town of Schenectady.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Glenville%2C_New_York"
    },
    {
      "id": 3,
      "text": "Stoodley Corners, known as the town center, sits at the crossroads of Route 50 and Glenridge Road.",
      "sourceSentenceIds": [
        23
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Glenville%2C_New_York"
    },
    {
      "id": 4,
      "text": "The Seeley Farmhouse, Swart House and Tavern, and Bishop Family Lustron House are all listed on the National Register of Historic Places.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Glenville%2C_New_York"
    },
    {
      "id": 5,
      "text": "The village of Scotia lies in the southern part of Glenville and hosts a historic manor called Glen Sanders Mansion.",
      "sourceSentenceIds": [
        2,
        22
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Glenville%2C_New_York"
    },
    {
