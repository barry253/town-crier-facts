    {
      "id": 2,
      "text": "Hitchcock was named for Ethan Allen Hitchcock, who served as the secretary of the interior from 1899 to 1907.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.okhistory.org/publications/enc/entry?entry=HI019"
    },
    {
      "id": 3,
      "text": "The Hitchcock Townsite Company established the town along the Enid and Anadarko Railway line.",
      "sourceSentenceIds": [
        29
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.okhistory.org/publications/enc/entry?entry=HI019"
    },
    {
      "id": 4,
      "text": "Land sales in Hitchcock began on August 23, 1901, with twenty-six hundred dollars worth of lots sold by that evening.",
      "sourceSentenceIds": [
        30
