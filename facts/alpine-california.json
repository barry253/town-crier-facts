    },
    {
      "id": 2,
      "text": "The community’s name once appeared as “Alphine Village” before settling on Alpine Village in the late 19th century.",
      "sourceSentenceIds": [
        23
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/alpine_village_california"
    },
    {
      "id": 3,
      "text": "Alpine Village’s climate is a cold, humid continental type, shaped by its high Sierra Nevada elevation.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/alpine_village_california"
    },
    {
      "id": 4,
      "text": "The town lies just five miles north of Markleeville, the Alpine County seat, and close to Hope Valley’s recreational sites.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/alpine_village_california"
    },
    {
      "id": 5,
      "text": "Surrounded by steep slopes and coniferous forests, Alpine Village is a gateway to the Humboldt–Toiyabe National Forest.",
      "sourceSentenceIds": [
        29,
        30
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/alpine_village_california"
    },
    {
      "id": 6,
      "text": "Alpine Village covers 4.08 square miles of land, with no incorporated water bodies within its compact footprint.",
