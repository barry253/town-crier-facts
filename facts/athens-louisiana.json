  "facts": [
    {
      "id": 1,
      "text": "Athens, Louisiana, takes its name from the ancient Greek capital, echoing the classical city in its own way.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Athens%2C_Louisiana",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Long before settlers, the Caddo Indians farmed maize, beans, pumpkins, and sunflowers along with hunting and trading salt.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/athens_louisiana",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "In 1846, Athens became Claiborne Parish’s seat after moving from malarial Overton, thanks to John Wilson’s donated land and schoolhouse.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/athens_louisiana",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The town shifted two miles east in 1887 to meet the Louisiana and Northwest Railroad, setting the stage for its 1901 incorporation.",
      "sourceSentenceIds": [
        11
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/athens_louisiana",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "A 1922 Sanborn Fire Insurance map of Athens shows the downtown layout, labeling businesses and schools of the era.",
