  "facts": [
    {
      "id": 1,
      "text": "Lewiston was founded in 1892 by the Michelson & Hanson Lumber Company, becoming a village when the company platted it.",
      "sourceSentenceIds": [
        1,
        2
      ],
      "sourceLabels": [
        "Web source 1",
        "Web source 2"
      ],
      "source": "https://www.lewistonhistoricalsociety.com/history-of-lewiston"
    },
    {
      "id": 2,
      "text": "The town was named for Lewis Jensen, an early lumber investor, and grew around two sawmills on East Twin Lake.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://alberttwpmi.gov/index.php/about-us/"
    },
    {
      "id": 3,
      "text": "Lewiston’s post office opened April 25, 1892, and the original post office building now houses the Lewiston Area Historical Society Museum.",
      "sourceSentenceIds": [
        12,
        5
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Lewiston%2C_Michigan"
    },
    {
      "id": 4,
      "text": "When the lumber era faded, the railroad that served Lewiston shut down in 1933, shifting the community toward agriculture and tourism that still define the area.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://alberttwpmi.gov/index.php/about-us/"
    },
    {
      "id": 5,
      "text": "Lewiston sits on the north side of East Twin Lake, which, along with West Twin Lake, drains into the Au Sable River watershed leading to Lake Huron.",
      "sourceSentenceIds": [
        19,
        20
      ],
      "sourceLabels": [
