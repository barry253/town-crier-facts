  "facts": [
    {
      "id": 1,
      "text": "Howardsville, Virginia, was founded by freed slaves and named after Jacob and Sophia Howard, among the county’s first black landowners.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.wusa9.com/article/news/history/signs-loudoun-county-history-village-howardsville/65-19367d97-9bf3-4d47-8fa8-2f68a7c084c1"
    },
    {
      "id": 2,
      "text": "Eight of the village’s fourteen lots remain in families that can trace their roots back to the original settlers.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.wusa9.com/article/news/history/signs-loudoun-county-history-village-howardsville/65-19367d97-9bf3-4d47-8fa8-2f68a7c084c1"
    },
    {
      "id": 3,
      "text": "Loudoun County recently installed green street signs to honor Howardsville as a historic freed‑slave community.",
      "sourceSentenceIds": [
        2,
        3
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.wusa9.com/article/news/history/signs-loudoun-county-history-village-howardsville/65-19367d97-9bf3-4d47-8fa8-2f68a7c084c1"
    },
    {
      "id": 4,
      "text": "The village’s geology features rocks from ancient basin sediments and cobbles that are about 200 million years old.",
      "sourceSentenceIds": [
        15,
        16
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://nelsoncounty.com/locations/howardsville"
    },
    {
      "id": 5,
      "text": "Howardsville sits quietly in the foothills of the Blue Ridge Mountains, offering a rural setting that reflects its early 19th‑century roots.",
      "sourceSentenceIds": [
        17
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://nelsoncounty.com/locations/howardsville"
    },
    {
      "id": 6,
      "text": "A new historic marker in Howardsville acknowledges the community’s legacy and contributions to the county’s diverse heritage.",
