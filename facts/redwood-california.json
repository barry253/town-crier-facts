  "facts": [
    {
      "id": 1,
      "text": "Redwood City earned the nickname “Chrysanthemum Center of the World” in 1926, a title that faded after World War II internment disrupted the local flower industry.",
      "sourceSentenceIds": [
        15
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Redwood_City%2C_California",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The city’s roots stretch back to the Ohlone people, later becoming a bustling lumber port that shipped goods across San Francisco Bay.",
      "sourceSentenceIds": [
        17
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Redwood_City%2C_California",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "In 1999, the San Mateo County History Museum opened inside the historic courthouse downtown, preserving Redwood City’s 19th‑century heritage.",
      "sourceSentenceIds": [
        18
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Redwood_City%2C_California",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Redwood City’s public library began in 1865; a Carnegie grant in 1904 funded a new building that survived the 1906 earthquake thanks to a second donation.",
      "sourceSentenceIds": [
        23,
        24
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Redwood_City%2C_California",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The Port of Redwood City is the only deep‑water harbor south of San Francisco, a legacy of the city’s early maritime trade.",
      "sourceSentenceIds": [
        28
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Redwood_City%2C_California",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Today, Redwood City hosts headquarters for global tech firms like Oracle, Electronic Arts, and Evernote, anchoring its place in Silicon Valley’s innovation hub.",
      "sourceSentenceIds": [
