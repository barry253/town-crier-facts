  "facts": [
    {
      "id": 1,
      "text": "McRae was incorporated on March 3, 1874, named after Daniel McRae, a local landowner.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.thegagenweb.com/gatelfair/mcrae.html",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "On January 1, 2015, McRae and Helena merged into McRae‑Helena after Helena could no longer manage its wastewater, a decision signed by Governor Nathan Deal.",
      "sourceSentenceIds": [
        13,
        14,
        15,
        16,
        17
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/McRae%E2%80%93Helena%2C_Georgia",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "McRae began as Station No. 11 on the Macon and Brunswick Railroad in 1870, linking the town to regional trade.",
      "sourceSentenceIds": [
        2,
        9,
        11
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.thegagenweb.com/gatelfair/mcrae.html",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The Talmadge Home, once occupied by Georgia governors Eugene and Herman Talmadge, stands as a landmark in McRae‑Helena.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/McRae%E2%80%93Helena%2C_Georgia",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Liberty Square in downtown hosts a one‑tenth‑scale Statue of Liberty replica, a Liberty Bell replica, and a marble memorial to fallen soldiers.",
      "sourceSentenceIds": [
        22,
        23
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/McRae%E2%80%93Helena%2C_Georgia",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The Little Ocmulgee River skirts the city’s northeast, while Sugar Creek crosses the southwest border.",
