  "facts": [
    {
      "id": 1,
      "text": "Westford was chartered on June 8, 1763, as a New Hampshire grant by Governor Benning Wentworth.",
      "sourceSentenceIds": [
        14,
        21
      ],
      "sourceLabels": [
        "Web source 2",
        "Wikipedia"
      ],
      "source": "https://westfordvt.us/about/town-history/"
    },
    {
      "id": 2,
      "text": "The land in Westford originally fell within the traditional territories of the Sokoki, Missisquoi, and Cowasuck bands of the Western Abenaki tribes.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Westford%2C_Vermont"
    },
    {
      "id": 3,
      "text": "Westford's Town Common was donated to the town in 1819 and serves as the community's historic gathering place.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://westfordvt.us/explore-westford/"
    },
    {
      "id": 4,
      "text": "The Westford Public Library resides in the historical town hall and was first started in 1895.",
      "sourceSentenceIds": [
        7,
        18
      ],
      "sourceLabels": [
        "Web source 1",
        "Web source 2"
      ],
      "source": "https://westfordvt.us/explore-westford/"
    },
    {
      "id": 5,
      "text": "At the turn of the 20th century, the Brookside area of Westford featured a post office, cheese plant, and cheese box factory.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Westford%2C_Vermont"
    },
    {
      "id": 6,
      "text": "Some of Westford's hills, like Number Eleven Hill, kept their original lot numbers because owners were dissatisfied with the land quality.",
