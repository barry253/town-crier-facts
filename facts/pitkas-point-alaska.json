    {
      "id": 2,
      "text": "Pitkas Point sits at 62°2′8″N 163°15′39″W, placing it on Alaska's western tundra coast.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Wikipedia"
