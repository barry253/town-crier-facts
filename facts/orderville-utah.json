  "facts": [
    {
      "id": 1,
      "text": "Orderville was established in 1875 under the direction of Brigham Young to practice a communal form of living called the United Order.",
      "sourceSentenceIds": [
        2,
        20
      ],
      "sourceLabels": [
        "Web source 1",
        "Wikipedia"
      ],
      "source": "https://orderville.utah.gov/our-history"
    },
    {
      "id": 2,
      "text": "Under the United Order, no person in Orderville could own private property, as all land was considered to belong to God.",
      "sourceSentenceIds": [
        29
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Orderville%2C_Utah"
    },
    {
      "id": 3,
      "text": "A communal dining hall in Orderville began operating in 1875, preparing meals for more than eighty families at scheduled times.",
      "sourceSentenceIds": [
        26
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Orderville%2C_Utah"
    },
    {
      "id": 4,
      "text": "Orderville was primarily settled by destitute refugees who had come from failed settlements on the Muddy River in Nevada.",
      "sourceSentenceIds": [
        21
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Orderville%2C_Utah"
    },
    {
      "id": 5,
      "text": "The youth of Orderville once influenced economic change through a movement known as the Pants Rebellion.",
      "sourceSentenceIds": [
        16
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Orderville%2C_Utah"
    },
    {
      "id": 6,
      "text": "The Daughters of Utah Pioneer Museum preserves the unique history of the Mormon settlers who founded Orderville.",
      "sourceSentenceIds": [
