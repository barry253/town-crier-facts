  "facts": [
    {
      "id": 1,
      "text": "Founded in 1808 as Carlin's Settlement, Franklin was renamed for Benjamin Franklin, became the parish seat in 1811, and incorporated in 1820.",
      "sourceSentenceIds": [
        1,
        2,
        3,
        4
      ],
      "sourceLabels": [
        "Web source 1",
        "Wikipedia",
        "Web source 2"
      ],
      "source": "https://www.franklin-la.com/category/subcategory.php?categoryid=9"
    },
    {
      "id": 2,
      "text": "With the arrival of the railroad, Franklin evolved into a bustling sawmill town.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Franklin%2C_Louisiana"
    },
    {
      "id": 3,
      "text": "Franklin’s historic district, listed on the National Register in 1982, boasts over 420 buildings that showcase antebellum and Victorian architecture.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/Franklin,_Louisiana"
    },
    {
      "id": 4,
      "text": "Sugar trade via steamboats gave way to lumber processing, with eleven sawmills by 1869, and today the city produces oil, gas, carbon black, salt, seafood, and sugar.",
      "sourceSentenceIds": [
        11
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/Franklin,_Louisiana"
    },
    {
      "id": 5,
      "text": "Former President Theodore Roosevelt visited Franklin, and the 1969 film Easy Rider shot scenes on Main Street.",
      "sourceSentenceIds": [
        14
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.franklin-la.com/category/subcategory.php?categoryid=9"
    },
    {
      "id": 6,
      "text": "Franklin’s First United Methodist Church, founded in 1806, was the first Protestant church established in Louisiana.",
