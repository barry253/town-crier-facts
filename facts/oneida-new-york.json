  "facts": [
    {
      "id": 1,
      "text": "Founded in 1834 by Sands Higinbotham, Oneida grew as a depot for the Utica‑Syracuse Railroad, honoring the local Oneida people.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.britannica.com/place/Oneida-New-York",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The Oneida Community Mansion House, a National Historic Landmark, preserves the 19th‑century communal experiment that once occupied the site.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Oneida%2C_New_York",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "John Humphrey Noyes founded the Oneida Community in 1848; by 1881 it had become a silverware company.",
      "sourceSentenceIds": [
        4,
        5
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.britannica.com/place/Oneida-New-York",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Fort Schuyler, rebuilt by the Continental Army in 1776 and later renamed Fort Stanwiel, sits near Oneida.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://oneidacountyny.gov/about/history/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Oneida County, often called “America’s County,” connects history from the Great Pass of the 18th century to 21st‑century space exploration.",
      "sourceSentenceIds": [
