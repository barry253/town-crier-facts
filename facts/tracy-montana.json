  "facts": [
    {
      "id": 1,
      "text": "Tracy was established in 1882 as a coal mining settlement after Nat McGiffen discovered coal deposits in the area.",
      "sourceSentenceIds": [
        1,
        9
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/tracy_montana"
    },
    {
      "id": 2,
      "text": "The community of Tracy was named after Don Tracy, who took over the local mines following Nat McGiffen's departure.",
      "sourceSentenceIds": [
        1,
        30
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/tracy_montana"
    },
    {
      "id": 3,
      "text": "Tracy is located in the valley of Sand Coulee Creek, a north-flowing tributary of the Missouri River.",
      "sourceSentenceIds": [
        14
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Tracy%2C_Montana"
    },
    {
      "id": 4,
      "text": "The Montana Central Railway's Sand Coulee Branch provided essential connectivity for Tracy, enabling coal transport to Great Falls starting in 1888.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/tracy_montana"
    },
    {
      "id": 5,
      "text": "Mining in Tracy ceased in the 1920s when the Anaconda Company smelter in Great Falls transitioned to natural gas.",
      "sourceSentenceIds": [
        18,
        22
      ],
      "sourceLabels": [
        "Web source 1",
        "Web source 2"
      ],
      "source": "https://www.mtmemory.org/nodes/view/128409"
    },
    {
      "id": 6,
      "text": "During the 1930s and 1940s, the majority of the homes in Tracy were moved to Great Falls.",
      "sourceSentenceIds": [
        19,
        23
      ],
      "sourceLabels": [
        "Web source 1",
        "Web source 2"
      ],
      "source": "https://www.mtmemory.org/nodes/view/128409"
    }
  ]
}
