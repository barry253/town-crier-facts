  "facts": [
    {
      "id": 1,
      "text": "Oak Bluffs earned its name in 1907 when the town re‑incorporated, honoring the oak grove that once shaded the bluffs overlooking Nantucket Sound.",
      "sourceSentenceIds": [
        15
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Oak_Bluffs%2C_Massachusetts",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The campground’s gingerbread cottages, famed for their whimsical design, are both cherished historic landmarks and among the most expensive real estate on the island.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Oak_Bluffs%2C_Massachusetts",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "In 1978 the cottages and the Tabernacle joined the National Register of Historic Places, later earning National Historic Landmark status in 2005.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Oak_Bluffs%2C_Massachusetts",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The Flying Horses, a historic amusement park, was also declared a National Historic Landmark by the Secretary of the Interior in 2005.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Oak_Bluffs%2C_Massachusetts",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Oak Bluffs has served as a pivotal center of African American culture since the 18th century, drawing artists, musicians, and activists.",
      "sourceSentenceIds": [
        21
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Oak_Bluffs%2C_Massachusetts",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "In the 1800s, steamer tourists arriving from the mainland could stroll along seaside promenades, dine in restaurants, or enjoy band concerts on the bluffs.",
      "sourceSentenceIds": [
        22
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
