  "facts": [
    {
      "id": 1,
      "text": "Idana sprang up in 1882 beside the Union Pacific Railroad, built by early homesteaders who saw a chance to serve rail travelers.",
      "sourceSentenceIds": [
        1,
        3
      ],
      "sourceLabels": [
        "Web source 1",
        "Web source 2"
      ],
      "source": "https://legendsofkansas.com/idana-kansas/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town’s name blends Ida Howland’s and Anna Broughton’s first names, honoring the settlers’ spouses.",
      "sourceSentenceIds": [
        5,
        15
      ],
      "sourceLabels": [
        "Web source 2",
        "Wikipedia"
      ],
      "source": "https://grokipedia.com/page/idana_kansas",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Idana’s first church, the Presbyterian congregation, opened in 1887, becoming a community gathering spot.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://legendsofkansas.com/idana-kansas/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Nestled in the Republican River valley, Idana sits amid the limestone‑covered prairie of the Flint Hills ecoregion.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/idana_kansas",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "A post office moved from nearby Chapmanville to Idana in 1882 and stayed open until 1980.",
      "sourceSentenceIds": [
        26
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://legendsofkansas.com/idana-kansas/",
      "category": "history",
      "quality": "good"
    },
    {
