  "facts": [
    {
      "id": 1,
      "text": "El Morro Valley's iconic cliff, known to the Zuni as A'ts'ina, holds a thousand years of rock‑etched history.",
      "sourceSentenceIds": [
        6,
        10
      ],
      "sourceLabels": [
        "Web source 2",
        "Wikipedia"
      ],
      "source": "https://www.nps.gov/articles/000/getaway-elmo.htm",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The self‑guided Inscription Loop lets visitors trace marks left by Spanish explorers, early Puebloans, and later railroad surveyors.",
      "sourceSentenceIds": [
        3,
        4
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.nps.gov/articles/000/getaway-elmo.htm",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "In 1859, the U.S. Army Camel Corps marched past El Morro, adding its own camel‑carried inscriptions to the rock.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.nps.gov/articles/000/getaway-elmo.htm",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "El Morro Valley's climate swings dramatically, with daytime highs reaching 100°F and nighttime lows dropping to -38°F.",
      "sourceSentenceIds": [
        17
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/El_Morro_Valley%2C_New_Mexico",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The valley’s artist community thrives on the Ancient Way, hosting galleries, a trading post, and a healing arts center.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/El_Morro_Valley%2C_New_Mexico",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "El Morro National Monument offers a free campground with nine sites, first‑come, first‑served, ideal for overnight stays.",
