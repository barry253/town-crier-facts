  "facts": [
    {
      "id": 1,
      "text": "Saylorville traces its roots to the mid‑19th century when the Saylor family settled the area, farming the land amid early coal mining and railroad growth.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/saylorville_iowa",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town’s name honors its founder, John B. Saylor, who laid out the community in 1850.",
      "sourceSentenceIds": [
        2,
        12
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Saylorville%2C_Iowa",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The Des Moines River forms Saylorville’s eastern boundary, shaping the local hydrology and influencing the surrounding valley.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/saylorville_iowa",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Saylorville Lake, a 5,950‑acre reservoir on the Des Moines River, was built by the U.S. Army Corps of Engineers for flood control and recreation.",
      "sourceSentenceIds": [
        29,
        30
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/saylorville_iowa",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "An earthen dam 6,750 ft long and 105 ft high has withstood major floods in 1984, 1991, and 1993, protecting central Iowa.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/saylorville_iowa",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The area’s vegetation blends urban‑suburban development with remnants of tallgrass prairie, bottomland forests along the river, and managed wetlands around the lake.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Web source 1"
