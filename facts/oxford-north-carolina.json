  "facts": [
    {
      "id": 1,
      "text": "Oxford was founded in 1761 when Samuel Benton built a plantation home named Oxford, and the legislature made it the county seat of Granville County.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Oxford%2C_North_Carolina",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town was officially incorporated in 1816 after the Assembly authorized buying land around the courthouse in 1811 and selling lots in 1812.",
      "sourceSentenceIds": [
        17
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.oxfordnc.org/community/history.php",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Oxford hosts the first Masonic orphanage in the U.S., opened in 1851 as the Oxford Orphans Asylum, now the Masonic Home for Children.",
      "sourceSentenceIds": [
        23,
        25
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Oxford%2C_North_Carolina",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "In 2018 Oxford earned accreditation from the National Main Street Program, a recognition by the National Trust for Historic Preservation.",
      "sourceSentenceIds": [
        13
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://visitdowntownoxfordnc.org/about/",
      "category": "other",
      "quality": "poor",
      "qualityReason": "editorial_filler"
    },
    {
      "id": 5,
      "text": "OxForward, a 501(c)(3) organization, leads downtown revitalization while preserving historic character, guiding new upper‑story development in historic buildings.",
      "sourceSentenceIds": [
        12,
        16,
        19,
        20
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://visitdowntownoxfordnc.org/about/",
