  "facts": [
    {
      "id": 1,
      "text": "Oak Park began as Sol, Georgia in 1880, briefly became Horace, and settled on its current name in 1904.",
      "sourceSentenceIds": [
        1,
        2,
        12,
        29
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Oak_Park%2C_Georgia",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The 1919 Oak Park School House, now a historic museum, was restored by the Oak Park Shiners as the city’s visitor center.",
      "sourceSentenceIds": [
        4,
        5
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://cityofoakparkga.gov/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Roscoe Peoples built the Sinclair Station in 1935, a service station that once hosted the Snake Hunters Club.",
      "sourceSentenceIds": [
        8,
        9
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://cityofoakparkga.gov/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Oak Park’s 1934 election produced Georgia’s first all‑woman government, a milestone dubbed “Petticoat Rule” by national press.",
      "sourceSentenceIds": [
        6,
        20
      ],
      "sourceLabels": [
        "Web source 1",
        "Wikipedia"
      ],
      "source": "https://cityofoakparkga.gov/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The town lies along U.S. Route 1 in southern Emanuel County, with Interstate 16 cutting through its northern edge.",
      "sourceSentenceIds": [
        23,
