  "facts": [
    {
      "id": 1,
      "text": "Cuyamungue means 'pueblo ruin where they threw down the stones,' a Tewa name describing a hill of fallen boulders.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.cuyamungueinstitute.com/the-land/history/"
    },
    {
      "id": 2,
      "text": "Cuyamungue sits about fifteen miles north of Santa Fe, nestled between the Sangre de Cristo and Jemez Mountains.",
      "sourceSentenceIds": [
        19,
        17
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.cuyamungueinstitute.com/the-land/history/"
    },
    {
      "id": 3,
      "text": "The first permanent Spanish settlement in the area dates to 1598, with the Cuyamungueños noted by Coronado’s 1541 expedition.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.cuyamungueinstitute.com/the-land/history/"
    },
    {
      "id": 4,
      "text": "Warriors from Cuyamungue are believed to have joined the 1680 Pueblo Revolt against Spanish rule.",
      "sourceSentenceIds": [
        28
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.cuyamungueinstitute.com/the-land/history/"
    },
    {
      "id": 5,
      "text": "Archaeologists began excavating Cuyamungue Pueblo in 1952, uncovering that its first structures date to around 1300.",
      "sourceSentenceIds": [
        26,
        27
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.cuyamungueinstitute.com/the-land/history/"
    },
    {
      "id": 6,
      "text": "Near San Ildefonso, the Pojoaque River merges into the Rio Tesuque, once called the Rio Cuyamungué.",
      "sourceSentenceIds": [
        18
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.cuyamungueinstitute.com/the-land/history/"
    }
  ]
