  "facts": [
    {
      "id": 1,
      "text": "Frisbee earned its name from a railroad foreman named Frisbee, highlighting the town’s early ties to rail transport.",
      "sourceSentenceIds": [
        1,
        5
      ],
      "sourceLabels": [
        "Web source 1",
        "Wikipedia"
      ],
      "source": "https://grokipedia.com/page/frisbee_missouri"
    },
    {
      "id": 2,
      "text": "A post office opened in 1907 as Frisbee, was renamed Manley in 1908, and closed a decade later in 1918.",
      "sourceSentenceIds": [
        20
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Frisbee%2C_Missouri"
    },
    {
      "id": 3,
      "text": "The town sits near the historic channel of the St. Francis River, which was channelized in the mid‑20th century for flood control.",
      "sourceSentenceIds": [
        6,
        23
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/frisbee_missouri"
    },
    {
      "id": 4,
      "text": "Frisbee lies in northern Dunklin County, roughly 24 miles north of the Arkansas state line within the Missouri Bootheel.",
      "sourceSentenceIds": [
        29
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/frisbee_missouri"
    },
    {
      "id": 5,
      "text": "Its growth mirrors the Bootheel’s early‑1900s drainage projects that converted wetlands into fertile farmland.",
      "sourceSentenceIds": [
        7,
        8
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/frisbee_missouri"
    },
    {
      "id": 6,
      "text": "As a census‑designated place, Frisbee covers 0.80 square miles of all land, with no incorporated water bodies.",
