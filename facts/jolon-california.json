  "facts": [
    {
      "id": 1,
      "text": "Jolon’s name comes from Salinan “Xolon”, meaning “valley of dead trees” today.",
      "sourceSentenceIds": [
        16
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Jolon%2C_California",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town began in 1849 when Antonio Ramírez built an inn on El Camino Real.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Jolon%2C_California",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "That inn later became a major stagecoach station between San Francisco and Los Angeles.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Jolon%2C_California",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Mission San Antonio de Padua, founded 1771, sits in the valley and marks Jolon’s earliest European settlement.",
      "sourceSentenceIds": [
        15
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Jolon%2C_California",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The Dutton Hotel, added a second adobe story, is listed on the National Register of Historic Places.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Jolon%2C_California",
      "category": "landmark",
      "quality": "good"
    },
    {
