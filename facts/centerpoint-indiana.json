  "facts": [
    {
      "id": 1,
      "text": "Center Point was platted in 1856 and named for its location near the geographic center of Clay County.",
      "sourceSentenceIds": [
        20,
        3,
        4
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Center_Point%2C_Indiana"
    },
    {
      "id": 2,
      "text": "The town's early growth hinged on its spot along the main road between Brazil and Bowling Green, with a post office opened in 1854.",
      "sourceSentenceIds": [
        1,
        7,
        4
      ],
      "sourceLabels": [
        "Web source 2",
        "Web source 1"
      ],
      "source": "https://wvcf.org/claycommunitytour2/"
    },
    {
      "id": 3,
      "text": "Arrival of the Terre Haute–Richmond Railroad in 1852 restored daily mail and linked Center Point to larger cities.",
      "sourceSentenceIds": [
        10,
        7
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/center_point_indiana"
    },
    {
      "id": 4,
      "text": "A unique landmark is the Exotic Feline Rescue Center, founded in 1991 on 200 acres, caring for over 120 big cats.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/center_point_indiana"
    },
    {
      "id": 5,
      "text": "Center Point keeps a rural feel with more than 25 local businesses, including an agricultural supply shop that doubles as a historical archive.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/center_point_indiana"
    },
    {
      "id": 6,
      "text": "The town hosts the Center Point Hardware Store, a historic shop that has served residents for generations and now preserves local history.",
      "sourceSentenceIds": [
        12
      ],
