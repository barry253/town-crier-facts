  "facts": [
    {
      "id": 1,
      "text": "Newburg’s origins trace back to 1819 when Thomas Trimble laid out the first plans for the borough.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.newburgborough.com/history"
    },
    {
      "id": 2,
      "text": "By 1845 the settlement had grown enough to be designated a Post Village within Hopewell Township.",
      "sourceSentenceIds": [
        13
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.newburgborough.com/history"
    },
    {
      "id": 3,
      "text": "The community officially became an incorporated borough in 1861, marking a new chapter in its development.",
      "sourceSentenceIds": [
        16
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.newburgborough.com/history"
    },
    {
      "id": 4,
      "text": "At its earliest, Newburg consisted of only three or four houses, one each occupied by Trimble, McCormick, and Carson‑Baer.",
      "sourceSentenceIds": [
        9,
        10,
        11,
        12
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.newburgborough.com/history"
    },
    {
      "id": 5,
      "text": "A central bench marker records Newburg’s elevation at 595 feet, with most of the borough hovering around 600 feet.",
      "sourceSentenceIds": [
        18
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.newburgborough.com/history"
    },
    {
      "id": 6,
      "text": "Historically, Conococheague Creek ran beneath Newburg, once spanned by three covered bridges that linked the town to neighboring areas.",
      "sourceSentenceIds": [
        28
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.newburgborough.com/history"
    }
  ]
