  "facts": [
    {
      "id": 1,
      "text": "Jacob's Creek Bridge designed by James Finley, a local judge, spanned Jacob's Creek south of Mount Pleasant.",
      "sourceSentenceIds": [
        18
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Jacob's_Creek_Bridge_(Pennsylvania)"
    },
    {
      "id": 2,
      "text": "The bridge's two iron chain cables were made of 1‑inch bars wrought into 5‑ to 10‑foot links, anchored to stone piers.",
      "sourceSentenceIds": [
        24,
        25
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Jacob's_Creek_Bridge_(Pennsylvania)"
    },
    {
      "id": 3,
      "text": "Vertical suspenders dropped from the cables kept the wooden deck almost flat, a clever design for the era.",
      "sourceSentenceIds": [
        26,
        27
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Jacob's_Creek_Bridge_(Pennsylvania)"
    },
    {
      "id": 4,
      "text": "Finley guaranteed the bridge would last fifty years, except for the wooden decking.",
      "sourceSentenceIds": [
        28
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Jacob's_Creek_Bridge_(Pennsylvania)"
    },
    {
      "id": 5,
      "text": "The bridge measured 70 feet across and 12.5 feet wide, a sizable span for early 1800s.",
      "sourceSentenceIds": [
        29
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Jacob's_Creek_Bridge_(Pennsylvania)"
    },
    {
      "id": 6,
      "text": "Today, the north side of Jacob's Creek near Route 819 still bears the name 'Iron Bridge,' though the structure is gone.",
      "sourceSentenceIds": [
        19
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Jacob's_Creek_Bridge_(Pennsylvania)"
    }
  ]
