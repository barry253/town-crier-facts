  "facts": [
    {
      "id": 1,
      "text": "Mishawaka’s recorded history began with the discovery of bog iron deposits in the 1830s.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Mishawaka%2C_Indiana"
    },
    {
      "id": 2,
      "text": "The Dodge Manufacturing Company, Perkins Windmills, and Mishawaka Woolen and Rubber Company—later Ball Band and Uniroyal—propelled the city’s growth.",
      "sourceSentenceIds": [
        8,
        19
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Mishawaka%2C_Indiana"
    },
    {
      "id": 3,
      "text": "Ball Band produced rubber garments, endured a 1931 strike, and finally closed in 1997 amid cheaper imports.",
      "sourceSentenceIds": [
        9,
        20
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Mishawaka%2C_Indiana"
    },
    {
      "id": 4,
      "text": "The Mishawaka Historical Museum showcases exhibits on businesses, industries, landmarks, military heritage, railroads, and a working model train set.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://mishawakamuseum.org/"
    },
    {
      "id": 5,
      "text": "Mishawaka’s name comes from Potawatomi and Miami‑Illinois words meaning “swift flowing water” or “heavy timbered rapids.”.",
      "sourceSentenceIds": [
        10,
        12
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Mishawaka%2C_Indiana"
    },
    {
      "id": 6,
      "text": "Battell Park Historic District features a Classical Revival band shell and a WPA‑built terraced rock garden.",
