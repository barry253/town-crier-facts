  "facts": [
    {
      "id": 1,
      "text": "Muscogee Creek settlers named Wetumka after their ancestral town of Wetumpka in Alabama during the 1830s.",
      "sourceSentenceIds": [
        1,
        9
      ],
      "sourceLabels": [
        "Web source 1",
        "Wikipedia"
      ],
      "source": "https://www.okhistory.org/publications/enc/entry?entry=WE022"
    },
    {
      "id": 2,
      "text": "The Levering Mission and the Wetumka National Guard Armory are both listed in the National Register of Historic Places.",
      "sourceSentenceIds": [
        14
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.okhistory.org/publications/enc/entry?entry=WE022"
    },
    {
      "id": 3,
      "text": "A flurry of activity in 1925 led to the construction of a large railroad freight house and a three-story brick hotel.",
      "sourceSentenceIds": [
        13
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.okhistory.org/publications/enc/entry?entry=WE022"
    },
    {
      "id": 4,
      "text": "Wetumka hosts an event featuring arts and crafts, music, and a parade of antique cars, tractors, and horses.",
      "sourceSentenceIds": [
        11
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Wetumka%2C_Oklahoma"
    },
    {
      "id": 5,
      "text": "Historic Sanborn Fire Insurance maps from the early 1900s provide a detailed visual record of how Wetumka once looked.",
