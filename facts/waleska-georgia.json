  "facts": [
    {
      "id": 1,
      "text": "Waleska was named after Warluskee, the daughter of a local Cherokee chief, when the Trail of Tears forced her westward.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Waleska%2C_Georgia",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Reinhardt Academy, founded by the Reinhardt family, educated impoverished Cherokee children in the early 19th‑century Waleska settlement.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Waleska%2C_Georgia",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Reinhardt University, established in 1883, offers undergraduate and graduate degrees and remains Georgia’s oldest university affiliated with the United Methodist Church.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Waleska%2C_Georgia",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The Funk Heritage Center, located on Reinhardt College Campus, displays dioramas and a film that trace 12,000 years of American Indian life in Georgia.",
      "sourceSentenceIds": [
        4,
        6
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.nps.gov/places/funk-heritage-center.htm",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "State Routes 140 and 108 intersect in Waleska’s center, linking the town to Canton, Tate, and Cartersville.",
