  "facts": [
    {
      "id": 1,
      "text": "University Park began in the early 1960s with the Wood Hill subdivision near Western Avenue and Exchange Street.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.university-park-il.com/departments/village_manager/the_history_of_university_park_.php",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Incorporated September 13, 1967 as Park Forest South, the community renamed University Park January 24, 1984 to reflect Governors State University.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/University_Park,_Illinois",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Governors State University opened its doors in the village in 1969.",
      "sourceSentenceIds": [
        16
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/University_Park%2C_Illinois",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The village is one of the region's few planned communities, developed in the 1960s as Wood Hill, then Park Forest South, and finally University Park.",
      "sourceSentenceIds": [
        15
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/University_Park%2C_Illinois",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The Metra Electric line ends at University Park station, while Amtrak services continue south without stopping.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/University_Park%2C_Illinois",
      "category": "transport",
      "quality": "good"
    },
    {
