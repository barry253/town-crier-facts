      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "In 1914 a storm swept the 1,200‑seat Arverne Pier Theater out to sea, marking a dramatic early disaster.",
      "sourceSentenceIds": [
        25
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Arverne%2C_Queens",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "A 1922 fire left about 10,000 people homeless, but the community rebuilt quickly, restoring its summer bungalows.",
      "sourceSentenceIds": [
        26,
        29
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Arverne%2C_Queens",
      "category": "history",
      "quality": "good"
    },
