  "facts": [
    {
      "id": 1,
      "text": "Upton grew around Camp Upton, a U.S. Army training base that operated from 1917 to 1920 and again from 1940 to 1946.",
      "sourceSentenceIds": [
        10,
        11
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Upton%2C_New_York",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "During World War II the camp was rebuilt mainly as an induction center for draftees before becoming a convalescent hospital for wounded soldiers.",
      "sourceSentenceIds": [
        11,
        12
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Upton%2C_New_York",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The hamlet’s name honors Civil War brevet Major General Emory Upton, after whom Camp Upton was named.",
      "sourceSentenceIds": [
        3,
        5
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/Upton,_New_York",
      "category": "people",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Upton hosts the 32‑megawatt Long Island Solar Farm, the largest photovoltaic array in the eastern United States.",
      "sourceSentenceIds": [
        13
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Upton%2C_New_York",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Brookhaven National Laboratory and a National Weather Service Forecast Office sit on Upton’s grounds, making it a hub for scientific research.",
      "sourceSentenceIds": [
