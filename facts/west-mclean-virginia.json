      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The Salona estate, once home to Revolutionary War hero Light‑Horse Harry Lee, still graces the area with mature fields that echo Civil War history.",
      "sourceSentenceIds": [
        2,
        26
      ],
      "sourceLabels": [
