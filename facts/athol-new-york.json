  "facts": [
    {
      "id": 1,
      "text": "Athol was carved out of the original town of Thurman in 1813 when the Hudson River split the area into east and west sections.",
      "sourceSentenceIds": [
        24
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Thurman%2C_New_York",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town’s name honors John Thurman, an early landowner who helped settle the area in 1790 at Elm Hill.",
      "sourceSentenceIds": [
        4,
        21
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Thurman%2C_New_York",
      "category": "people",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Athol became part of the newly formed Warren County on March 12, 1813, a few months after the town split.",
      "sourceSentenceIds": [
        26
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Thurman%2C_New_York",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The John Thurman Historical Society, founded in 1980, preserves Athol’s history from pre‑17th‑century Native American occupation to today.",
      "sourceSentenceIds": [
        1,
        6
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://museumsdatabase.com/museums/view/21450",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The society’s archives hold books, manuscripts, maps, diaries, journals, photographs, and other artifacts that chronicle Athol’s past.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://museumsdatabase.com/museums/view/21450",
      "category": "other",
      "quality": "poor",
      "qualityReason": "other"
    },
    {
      "id": 6,
      "text": "Athol lies entirely within the Adirondack Park, giving it a rugged natural backdrop that shaped early settlement patterns.",
      "sourceSentenceIds": [
        20
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Thurman%2C_New_York",
