      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The Mount Vernon Place Historic District is a National Historic Landmark that preserves the neighborhood’s early 19th‑century architecture.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
