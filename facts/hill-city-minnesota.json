  "facts": [
    {
      "id": 1,
      "text": "Hill City sits on the shore of Hill Lake, a glacial lake about 2 mi long and 0.25 mi wide.",
      "sourceSentenceIds": [
        17
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Hill_City%2C_Minnesota",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Hill Lake, which gives Hill City its name, sits beside the prominent hill locally called Quadna Mountain.",
      "sourceSentenceIds": [
        1,
        2
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Hill_City%2C_Minnesota",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Hill City was officially incorporated on March 8, 1910, after separating from Hill Lake Township.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.hillcity-mn.com/history/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The 1910 National Woodenware Company Superintendent's Residence in Hill City is listed on the National Register of Historic Places.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Hill_City%2C_Minnesota",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The first issue of the Hill City News, published by Gaylord Huntley on May 5, 1910, celebrated the town’s ideal location overlooking Hill Lake and surrounded by hardwood forests.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
