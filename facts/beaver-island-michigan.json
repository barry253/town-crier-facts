  "facts": [
    {
      "id": 1,
      "text": "Beaver Island was called \"amikwag-endaad\" by the Ojibwe, meaning \"where the beavers live\".",
      "sourceSentenceIds": [
        11
      ],
      "sourceLabels": [
        "Web source 2"
      ],
