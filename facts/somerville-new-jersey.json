  "facts": [
    {
      "id": 1,
      "text": "The name 'Somerville' comes from four brothers of the Somerville family, Edward, John, and James, who founded the town in the 1750s.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Somerville%2C_New_Jersey",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Somerville sprang from a sparsely populated farming community into a bustling town after the railroad arrived in the 1840s and water power along the Raritan River developed in the 1850s.",
      "sourceSentenceIds": [
        2,
        5
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 2"
      ],
      "source": "https://en.wikipedia.org/wiki/Somerville%2C_New_Jersey",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Main Street in Somerville keeps most of its historic buildings, now home to boutique specialty shops and second‑hand stores.",
      "sourceSentenceIds": [
        15
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Somerville%2C_New_Jersey",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Somerville’s Somerset Hospital began in 1901 as a modest facility and has grown into a major university medical center.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Somerville%2C_New_Jersey",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The Wallace House in Somerville is listed on the National Register of Historic Places and once served as Washington’s headquarters during the 1778–79 Middlebrook encampment.",
      "sourceSentenceIds": [
        17
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Somerville%2C_New_Jersey",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Somerville has long hosted a vibrant African American community, highlighted by the legacy of Paul Robeson, a celebrated singer and activist.",
