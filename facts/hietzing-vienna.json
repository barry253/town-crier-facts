  "facts": [
    {
      "id": 1,
      "text": "Schönbrunn Palace, Vienna’s most visited cultural treasure, sits in Hietzing, showcasing Baroque architecture and sprawling gardens.",
      "sourceSentenceIds": [
        14
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://connectingvienna.com/vienna/district/13-hietzing/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Gustav Klimt’s last studio, the Klimt Villa, operated in Hietzing from 1911 until his death in 1918 and now serves as a historic site.",
      "sourceSentenceIds": [
        16
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://connectingvienna.com/vienna/district/13-hietzing/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Hietzing’s name likely derives from a settlement of people linked to a person named “Hezzo” or “Hiezo,” hinting at its early origins.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://connectingvienna.com/vienna/district/13-hietzing/",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The district transformed from a rural landscape to an imperial summer residence and now offers a tranquil residential lifestyle close to Vienna’s center.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://connectingvienna.com/vienna/district/13-hietzing/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Within Hietzing lies the Lainzer Tiergarten, a vast Wienerwald park that shelters wild boars and provides a natural escape.",
      "sourceSentenceIds": [
        26
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Hietzing",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Hietzing became Vienna’s 13th district in 1890/1892, merging six former municipalities into one unified area.",
      "sourceSentenceIds": [
        21
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Hietzing",
      "category": "history",
      "quality": "good"
