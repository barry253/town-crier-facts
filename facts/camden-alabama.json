  "facts": [
    {
      "id": 1,
      "text": "Camden was founded in 1833 on land donated by Thomas Dunn to serve as the county seat.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Camden%2C_Alabama"
    },
    {
      "id": 2,
      "text": "Originally named Barboursville after Senator Phillip Barbour, the town was renamed Camden in 1842 for the South Carolina city.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://encyclopediaofalabama.org/article/camden/"
    },
    {
      "id": 3,
      "text": "The Wilcox Female Seminary, founded in 1844, occupies a red‑brick Greek‑Revival building erected between 1845 and 1850.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Camden%2C_Alabama"
    },
    {
      "id": 4,
      "text": "The Wilcox County Courthouse, a red‑brick Greek‑Revival structure, was completed in 1857 and is listed on the National Register.",
      "sourceSentenceIds": [
        11
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Camden%2C_Alabama"
    },
    {
      "id": 5,
      "text": "Dunn’s Federal‑style house, built in 1825, is the oldest documented home in Camden.",
      "sourceSentenceIds": [
        21
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Camden%2C_Alabama"
    },
    {
      "id": 6,
      "text": "Union troops ransacked Camden’s courthouse in 1865, but officials had moved the records to a safe place, legend says they were buried in a coffin.",
