    },
    {
      "id": 2,
      "text": "To the north, Maryland Route 4 borders Queensland; U.S. 301 lies to the south and east, while Marlboro Pike and South Osborne Road run west.",
      "sourceSentenceIds": [
        6,
        7
      ],
      "sourceLabels": [
