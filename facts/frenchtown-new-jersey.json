  "facts": [
    {
      "id": 1,
      "text": "Frenchtown’s name comes from French Huguenot refugees who settled there after fleeing persecution in 1685.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Frenchtown%2C_New_Jersey",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town’s first bridge, a covered wooden span built in 1841, still stands today and once linked Frenchtown to Pennsylvania.",
      "sourceSentenceIds": [
        26
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Frenchtown%2C_New_Jersey",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "When the Belvidere-Delaware Railroad opened through Frenchtown in 1853, the village quickly grew into a thriving industrial hub.",
      "sourceSentenceIds": [
        13,
        17
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 2"
      ],
      "source": "https://en.wikipedia.org/wiki/Frenchtown%2C_New_Jersey",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The Frenchtown Historic District, covering 1795‑1931, was added to the National Register of Historic Places in 1994 for its architecture and transportation history.",
      "sourceSentenceIds": [
        15
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Frenchtown%2C_New_Jersey",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "In the 1860s, wagon‑wheel factories in Frenchtown reached factory scale, making the town a regional center for wheel production.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.livingplaces.com/NJ/Hunterdon_County/Frenchtown_Borough/Frenchtown_Historic_District.html",
