  "facts": [
    {
      "id": 1,
      "text": "Hazleton was named after Gervas Hazleton, the second settler to permanently settle in Gibson County.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Hazleton%2C_Indiana",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town was platted in 1856 by Lucius French, with Fuller building its first frame structure and John Breedlove establishing the blacksmith shop.",
      "sourceSentenceIds": [
        17,
        18
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Hazleton%2C_Indiana",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "In 1897 a passenger train of the Evansville and Terre Haute Railroad derailed near Hazleton when a weakened embankment collapsed, killing about a dozen people.",
      "sourceSentenceIds": [
        6,
        20,
        21
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Hazleton%2C_Indiana",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Hazleton sits on the south bank of the White River, which marks the boundary between Gibson and Knox counties.",
      "sourceSentenceIds": [
        23
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Hazleton%2C_Indiana",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "State Road 56 and Route 41 link Hazleton to the wider region, connecting it to U.S. highways.",
      "sourceSentenceIds": [
        24,
        25
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Hazleton%2C_Indiana",
      "category": "transport",
      "quality": "good"
    },
    {
