  "facts": [
    {
      "id": 1,
      "text": "Le Marais stretches across the 3rd and 4th arrondissements, hosting historic facades that now house boutiques, galleries, and cafés.",
      "sourceSentenceIds": [
        10,
        11
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://franceadventurer.com/le-marais-guide-things-to-do/"
    },
    {
      "id": 2,
      "text": "The neighborhood is home to Paris’s Jewish and LGBTQ+ communities, adding vibrant cultural layers to its historic streets.",
      "sourceSentenceIds": [
        11
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://franceadventurer.com/le-marais-guide-things-to-do/"
    },
    {
      "id": 3,
      "text": "Musée Carnavalet, the top museum in Le Marais, is dedicated entirely to Paris’s history.",
      "sourceSentenceIds": [
        13
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://franceadventurer.com/le-marais-guide-things-to-do/"
    },
    {
      "id": 4,
      "text": "Napoleon was crowned emperor at Notre Dame, and Victor Hugo’s novel sparked the cathedral’s 19th‑century restoration.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://franceadventurer.com/le-marais-guide-things-to-do/"
    },
    {
      "id": 5,
      "text": "Place des Vosges received its name in 1800, honoring the Vosges region that first funded the Revolutionary army.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://franceadventurer.com/le-marais-guide-things-to-do/"
    },
    {
      "id": 6,
      "text": "Le Marais offers a unique architectural journey through time, showcasing France’s history in every stone.",
