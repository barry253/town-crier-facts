      "id": 1,
      "text": "Avery got its name from early settlers Peter, Nancy, and George Avery of Maine, who helped establish the town in the 1850s.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 2"
      ],
