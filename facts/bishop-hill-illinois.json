  "facts": [
    {
      "id": 1,
      "text": "Founded 1846 by Swedish settlers, Bishop Hill is home to the Bishop Hill State Historic Site.",
      "sourceSentenceIds": [
        1,
        3,
        5
      ],
      "sourceLabels": [
        "Web source 1",
        "Wikipedia"
      ],
      "source": "https://www.bishophillil.gov/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The colony’s name honors founder Eric Jansson’s birthplace, Biskopskulla, in Sweden, reflecting its Swedish roots.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Bishop_Hill%2C_Illinois",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Early settlers faced high mortality; many of the first 1,000 colonists died from disease en route to Illinois.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Bishop_Hill%2C_Illinois",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Surviving Janssonist buildings are listed on the National Register of Historic Places, preserving the 19th‑century utopian community.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Bishop_Hill%2C_Illinois",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Bishop Hill’s historic site closed for nearly five months in 2008–2009 due to state budget cuts, reopening in April 2009.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Bishop_Hill%2C_Illinois",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Today, the Bishop Hill Heritage Association maintains the village’s Swedish heritage, restoring historic structures and hosting cultural events.",
      "sourceSentenceIds": [
        12,
        13,
        14
      ],
      "sourceLabels": [
        "Web source 2"
      ],
