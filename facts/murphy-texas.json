  "facts": [
    {
      "id": 1,
      "text": "Murphy was renamed in 1888 after James Murphy, who donated land for the train depot that brought the railroad to town.",
      "sourceSentenceIds": [
        6,
        7
      ],
      "sourceLabels": [
        "Web source 1",
        "Web source 2"
      ],
      "source": "https://murphychamber.org/murphy-history/",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town grew along Maxwell Creek, first settled in 1846 by Comfort and Lydia McMillen and their six children from Arkansas.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://murphychamber.org/murphy-history/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "In 2012 the Old Murphy Schoolhouse reopened as a community center, honoring the town’s early education history.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://murphychamber.org/murphy-history/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Murphy officially incorporated on September 29, 1958, becoming a recognized city within Collin County.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://murphychamber.org/murphy-history/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The Murphy Historical Society meets the fourth Tuesday of each month to preserve and share the town’s rich heritage.",
