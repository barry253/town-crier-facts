  "facts": [
    {
      "id": 1,
      "text": "Ford Heights was originally called East Chicago Heights and changed its name in 1987 while trying to annex the Ford Stamping Plant.",
      "sourceSentenceIds": [
        24
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Ford_Heights%2C_Illinois",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The Ford Motor Company opened a stamping plant adjacent to the village in 1956, providing equal opportunity jobs for minorities and shaping the village into a blue‑collar community.",
      "sourceSentenceIds": [
        20,
        21
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Ford_Heights%2C_Illinois",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "In the late 1840s, settlers turned the area into an onion and fruit farm, marking the earliest agricultural roots before the town became suburban.",
      "sourceSentenceIds": [
        4,
        10
      ],
      "sourceLabels": [
        "Web source 2",
        "Wikipedia"
      ],
      "source": "https://grokipedia.com/page/Ford_Heights,_Illinois",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "During the 1940s, local women organized to raise funds for a new fire truck, leading to the formation of the East Chicago Heights Citizens Association by 1948.",
      "sourceSentenceIds": [
        17,
        18
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Ford_Heights%2C_Illinois",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Ford Heights sits on the edge of the Tinley Moraine, a glacial landform that shapes the local landscape.",
      "sourceSentenceIds": [
        29
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Ford_Heights%2C_Illinois",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The village once served as a stopping point on the Underground Railroad, offering refuge to runaway slaves seeking freedom.",
      "sourceSentenceIds": [
