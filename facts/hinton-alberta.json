      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The town’s weekly newspaper, the Hinton Parklander, ran from 1955 until its final issue in January 2020, documenting local life for 65 years.",
      "sourceSentenceIds": [
