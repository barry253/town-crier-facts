      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The ghost town of Brule, once a bustling community with schools and hospitals, was founded in 1912 and nearly abandoned by 1932.",
      "sourceSentenceIds": [
        1,
        16,
        18
      ],
      "sourceLabels": [
