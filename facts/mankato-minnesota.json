      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Parsons Johnson and Henry Jackson founded Mankato in 1852, and the city was officially organized on May 11, 1858, the same day Minnesota became a state.",
      "sourceSentenceIds": [
        7,
        29,
        30
      ],
