  "facts": [
    {
      "id": 1,
      "text": "Tour Montparnasse and Gare Montparnasse sit side‑by‑side in the 14th arrondissement, right on its edge with the 15th.",
      "sourceSentenceIds": [
        23
      ],
      "sourceLabels": [
        "Wikipedia"
