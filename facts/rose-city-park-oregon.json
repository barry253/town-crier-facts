      "id": 1,
      "text": "Rose City Park was platted in 1907, the same year Portland hosted its first Rose Festival.",
      "sourceSentenceIds": [
        10,
        4
      ],
      "sourceLabels": [
        "Web source 1",
        "Web source 2"
      ],
