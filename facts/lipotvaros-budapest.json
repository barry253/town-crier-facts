  "facts": [
    {
      "id": 1,
      "text": "The Lipótváros Synagogue was a grand design that never materialised, its construction halted by financial constraints.",
      "sourceSentenceIds": [
        7,
        9
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Lip%C3%B3tv%C3%A1ros_Synagogue_(Budapest)"
    },
    {
      "id": 2,
      "text": "When first drafted, the synagogue was to seat 3,800 worshippers, far outnumbering the existing Dohány Street Synagogue.",
      "sourceSentenceIds": [
        8,
        16
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Lip%C3%B3tv%C3%A1ros_Synagogue_(Budapest)"
    },
    {
      "id": 3,
      "text": "Architects Ernő Foerk and Ferenc Schömer won the tender, proposing a building that could have become the world’s largest synagogue.",
      "sourceSentenceIds": [
        20,
        21
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Lip%C3%B3tv%C3%A1ros_Synagogue_(Budapest)"
    },
    {
      "id": 4,
      "text": "After Hungary’s emancipation in the late 19th century, Jews gained significant freedoms, reshaping Budapest’s cultural landscape.",
