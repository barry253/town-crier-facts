      "category": "landmark",
      "quality": "poor",
      "qualityReason": "vague"
    },
    {
      "id": 2,
      "text": "When first drafted, the synagogue was to seat 3,800 worshippers, far outnumbering the existing Dohány Street Synagogue.",
      "sourceSentenceIds": [
        8,
        16
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Lip%C3%B3tv%C3%A1ros_Synagogue_(Budapest)",
      "category": "landmark",
      "quality": "poor",
      "qualityReason": "vague"
    },
    {
      "id": 3,
      "text": "Architects Ernő Foerk and Ferenc Schömer won the tender, proposing a building that could have become the world’s largest synagogue.",
      "sourceSentenceIds": [
        20,
        21
      ],
      "sourceLabels": [
