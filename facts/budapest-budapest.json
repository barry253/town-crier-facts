      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The historic center along the Danube earned UNESCO World Heritage status for its 13th‑century Matthias Church, Buda Castle, and 19th‑century Parliament.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Budapest",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Budapest hosts the world’s second‑largest synagogue, the third‑largest parliament building, over 40 museums, and nearly ten Michelin‑starred restaurants.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Budapest",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "In December 2015, Budapest was named a UNESCO City of Design and has been part of the Creative Cities Network ever since.",
