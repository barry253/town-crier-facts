  "facts": [
    {
      "id": 1,
      "text": "Hickory was founded in the late 1880s within the Chickasaw Nation of Indian Territory.",
      "sourceSentenceIds": [
        1,
        5
      ],
      "sourceLabels": [
        "Web source 1",
        "Web source 2"
      ],
      "source": "https://www.okhistory.org/publications/enc/entry?entry=HI001"
    },
    {
      "id": 2,
      "text": "The town of Hickory takes its name from a grove of hickory trees that grew along Mill Creek.",
      "sourceSentenceIds": [
        1,
        16
      ],
      "sourceLabels": [
        "Web source 1",
        "Web source 2"
      ],
      "source": "https://www.okhistory.org/publications/enc/entry?entry=HI001"
    },
    {
      "id": 3,
      "text": "Hickory experienced modest growth after the Atchison, Topeka and Santa Fe Railway arrived in 1901.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/hickory_oklahoma"
    },
    {
      "id": 4,
      "text": "By 1923, Hickory had become a major cream-shipping center for the regional dairy industry.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/hickory_oklahoma"
    },
    {
      "id": 5,
      "text": "Hickory citizens attempted to open Murray County's first radio station in 1922, but they could not obtain the equipment.",
      "sourceSentenceIds": [
        18,
        19
      ],
      "sourceLabels": [
        "Web source 1",
        "Web source 2"
      ],
      "source": "https://www.okhistory.org/publications/enc/entry?entry=HI001"
    },
    {
      "id": 6,
      "text": "Hickory is located in northeastern Murray County and is drained by tributaries of Mill Creek.",
