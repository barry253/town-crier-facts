  "facts": [
    {
      "id": 1,
      "text": "Steele was named after Joshua Toliver Steele, who bought property from an early homesteader.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://encyclopediaofalabama.org/article/steele/"
    },
    {
      "id": 2,
      "text": "Joshua Steele donated four acres for a railroad depot, becoming the town’s first station agent.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://encyclopediaofalabama.org/article/steele/"
    },
    {
      "id": 3,
      "text": "Steele was originally called Steel’s Station or Steele’s Depot in the late 1800s.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Steele%2C_Alabama"
    },
    {
      "id": 4,
      "text": "A charcoal factory in Steele supplied fuel for nearby iron furnaces during the 19th century.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://encyclopediaofalabama.org/article/steele/"
    },
    {
      "id": 5,
      "text": "Early settlers in Steele included veterans of the Revolutionary War, arriving around 1814.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://encyclopediaofalabama.org/article/steele/"
    },
    {
