  "facts": [
    {
      "id": 1,
      "text": "Cedar Mountain sits at roughly 2,700 feet in the Blue Ridge Mountains, about ten miles south of Brevard and ten miles north of the North Carolina‑South Carolina line.",
      "sourceSentenceIds": [
        23,
        22
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/cedar_mountain_north_carolina",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The 1836 Blue Ridge Baptist Church, founded on land donated by James Burns, became a cornerstone of Cedar Mountain’s early community.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/cedar_mountain_north_carolina",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The McGaha Chapel, completed in 1862, was built to help heal the community’s wounds after the Civil War.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://sherwoodforestnc.com/cedar-mountain/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "DuPont’s silicon and photographic film plant once covered more than 10,000 acres and employed up to 1,500 workers until its 2002 closure.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/cedar_mountain_north_carolina",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Today that former industrial site is DuPont State Recreational Forest, offering 80 miles of trails and drawing over a million visitors annually.",
      "sourceSentenceIds": [
        19
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/cedar_mountain_north_carolina",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Cedar Mountain’s humid subtropical climate is tempered by its elevation, with summer highs around 80°F and winter lows near 30°F.",
      "sourceSentenceIds": [
        26,
        27
      ],
      "sourceLabels": [
        "Web source 1"
      ],
