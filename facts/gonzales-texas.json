  "facts": [
    {
      "id": 1,
      "text": "Gonzales was founded by Green DeWitt in August 1825 as the capital of his colony, later called the DeWitt Colony.",
      "sourceSentenceIds": [
        27,
        28,
        8
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 2"
      ],
      "source": "https://en.wikipedia.org/wiki/Gonzales%2C_Texas",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town earned the nickname “Lexington of Texas” because it hosted the first skirmish of the Texas Revolution, the Battle of Gonzales.",
      "sourceSentenceIds": [
        29,
        25
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Gonzales%2C_Texas",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "In 1831 the Mexican government granted DeWitt a small cannon, which later became the symbol of the “Come and Take It” incident.",
      "sourceSentenceIds": [
        30,
        21
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Gonzales%2C_Texas",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Gonzales County Courthouse, built in 1896, sits on the National Register of Historic Places and was designed by renowned Texas courthouse architect James Riely Gordon.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Gonzales%2C_Texas",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Gonzales remains a living snapshot of early Texas architecture, with over 180 years of preserved homes in Queen Anne, Tudor Revival, Italianate, and Greek Revival styles.",
      "sourceSentenceIds": [
        4,
        10
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Gonzales%2C_Texas",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The town’s historic square hosts guided driving tours led by knowledgeable docents, offering visitors a 180‑year narrative of Texas history.",
