  "facts": [
    {
      "id": 1,
      "text": "Camp Murray was commissioned as a National Guard base in 1889, predating Fort Lewis by a generation.",
      "sourceSentenceIds": [
        11,
        24
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Camp_Murray",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "In 1922, Camp Murray became the Washington National Guard’s state headquarters, housing the Army, Air, and State Guards.",
      "sourceSentenceIds": [
        25,
        10
      ],
      "sourceLabels": [
        "Web source 1",
        "Wikipedia"
      ],
      "source": "https://www.militarybases.us/camp-murray/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The camp’s first permanent building, the Arsenal, was erected in 1903 on 220 acres bought from the Murray family.",
      "sourceSentenceIds": [
        3,
        13
      ],
      "sourceLabels": [
        "Web source 2",
        "Wikipedia"
      ],
      "source": "https://grokipedia.com/page/Camp_Murray",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "In 1950, a clash called the “Battle of Camp Murray” saw former Adjutant General Ensley Llewellyn removed, prompting a Supreme Court ruling on governor authority.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/Camp_Murray",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Camp Murray sits on the shores of American Lake south of Murray Creek, chosen for its lakeside accessibility.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/Camp_Murray",
      "category": "nature",
      "quality": "poor",
      "qualityReason": "coordinates"
    },
    {
      "id": 6,
      "text": "The Old Arsenal Museum at Camp Murray displays a collection from a M‑47 tank to an F‑101 jet fighter, illustrating the camp’s military heritage.",
