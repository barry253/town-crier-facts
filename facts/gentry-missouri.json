  "facts": [
    {
      "id": 1,
      "text": "Gentry County, organized on February 14, 1841, was named for General Richard Gentry, a Missouri militia officer killed in the 1837 Second Seminole War.",
      "sourceSentenceIds": [
        3,
        4
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 2"
      ],
      "source": "https://en.wikipedia.org/wiki/Gentry_County%2C_Missouri",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "After a 1845 courthouse fire, the county seat moved from the extinct town of Tully to the newly platted Albany, originally called Athens.",
      "sourceSentenceIds": [
        13,
        1
      ],
      "sourceLabels": [
        "Web source 2",
        "Web source 2"
      ],
      "source": "https://uscountyhistorybooksdirectoryandlookup.com/states/mo/gentry-county-history/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Albany’s Carnegie Public Library, built in the early 20th century, stands as one of the county’s few historic Carnegie libraries.",
      "sourceSentenceIds": [
        16
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Gentry_County%2C_Missouri",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The Gentry County Library’s main Albany branch houses local history collections, including newspapers on microfilm and published family histories.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://uscountyhistorybooksdirectoryandlookup.com/states/mo/gentry-county-history/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Gentry County’s origins trace back to the Platte Purchase era, when settlers from Kentucky, Tennessee, and Virginia moved westward into the area.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://uscountyhistorybooksdirectoryandlookup.com/states/mo/gentry-county-history/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Unlike many counties, Gentry County reports that 100 percent of its residents live in rural areas, with no urban population.",
