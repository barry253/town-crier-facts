  "facts": [
    {
      "id": 1,
      "text": "On April 26, 1771, Pondtown Plantation was incorporated by the Massachusetts General Court as Winthrop, named for the first colonial governor of Massachusetts, John Winthrop.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Winthrop%2C_Maine",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The village also contains a historic textile mill complex at 149–151 Main Street known as the Winthrop Mills Company.",
      "sourceSentenceIds": [
        16
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Winthrop%2C_Maine",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The Winthrop Woolen & Cotton Manufactory was incorporated in 1809, and in 1814 went into operation.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Winthrop%2C_Maine",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Founded in 1916, the library is located on Bowdoin Street and hosts a range of cultural programming, including lectures, film screenings, and musical performances.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Winthrop%2C_Maine",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The Winthrop History and Heritage Center, housed in the town’s historic society, opens Thursdays and Saturdays for visitors.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://winthropmainehistory.org/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "A recreational area located among lakes, the town includes the villages of Winthrop and East Winthrop, and is the center of the Winthrop Lakes Region.",
