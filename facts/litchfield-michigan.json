  "facts": [
    {
      "id": 1,
      "text": "Platted in 1836 by Hervey and David Smith, Litchfield was originally called Smithsville.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Litchfield%2C_Michigan",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Hervey Smith opened the first post office on February 3, 1837, and the name changed to Litchfield on August 12, 1837.",
      "sourceSentenceIds": [
        4,
        26
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Litchfield%2C_Michigan",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Litchfield became a village in 1877 and later a city in 1970, separating from the surrounding township.",
      "sourceSentenceIds": [
        28,
        29
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Litchfield%2C_Michigan",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Founded in 1979, the Litchfield Area Historical Society preserves local history and hosts walking tours and community celebrations.",
      "sourceSentenceIds": [
        1,
        10
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://museumsdatabase.com/museums/view/15677",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "During Litchfield’s centennial in 1934, the “Bell in the Park” was dedicated to author Rose Hartwick Thorpe.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.hillsdalehistoricalsociety.org/litchfield-mi",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The town’s museum, moved to Mill Street in 1989, showcases antique farm equipment and local industrial history.",
