  "facts": [
    {
      "id": 1,
      "text": "Marietta sits on the Susquehanna River, a 19th‑century industrial hub with canal beds, iron furnaces, and historic streetscapes.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.boroughofmarietta.com/natural_and_historical_resources/index.php"
    },
    {
      "id": 2,
      "text": "The town’s canal trail follows the old Pennsylvania Mainline Canal towpath, still showing abandoned locks and iron furnace remains at Chickies Rock.",
      "sourceSentenceIds": [
        10,
        11
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.boroughofmarietta.com/natural_and_historical_resources/index.php"
    },
    {
      "id": 3,
      "text": "Market Street runs the entire length of Marietta, a historic artery that once carried raft traffic and river trade.",
      "sourceSentenceIds": [
        25
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Marietta%2C_Pennsylvania"
    },
    {
      "id": 4,
      "text": "Marietta’s Old Town Hall houses a local history museum, while the Union Meeting House has recently been restored and landscaped.",
      "sourceSentenceIds": [
        18
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.boroughofmarietta.com/natural_and_historical_resources/index.php"
    },
    {
      "id": 5,
      "text": "The borough’s heritage plan aims to protect its historic homes, river connection, and ecological conservation, turning Marietta into a sustainable cultural destination.",
