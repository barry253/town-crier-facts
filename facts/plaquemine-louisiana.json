  "facts": [
    {
      "id": 1,
      "text": "Plaquemine takes its name from the French word for persimmon, a nod to the area's early settlers in 1775.",
      "sourceSentenceIds": [
        25
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Plaquemine%2C_Louisiana",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Nestled on Bayou Plaquemine, a tributary of the Mississippi, the city lies within a National Heritage River corridor.",
      "sourceSentenceIds": [
        1,
        5
      ],
      "sourceLabels": [
        "Web source 1",
        "Wikipedia"
      ],
      "source": "https://www.plaquemine.org/181/Plaquemine-History",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "When the Union Pacific Railroad arrived in 1881, Plaquemine blossomed into a bustling commercial center with hotels and restaurants.",
      "sourceSentenceIds": [
        15,
        12
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.plaquemine.org/181/Plaquemine-History",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The early 1900s saw construction of the Plaquemine Lock, now listed on the National Register of Historic Places.",
      "sourceSentenceIds": [
        13,
        9
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.plaquemine.org/181/Plaquemine-History",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "COPAC, the City of Plaquemine Activity Center, repurposes a WPA-built high school into a community hub.",
