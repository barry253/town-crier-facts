  "facts": [
    {
      "id": 1,
      "text": "Powers was named in 1914 for Albert Powers, a lumberman from North Carolina who developed the area's timber resources.",
      "sourceSentenceIds": [
        1,
        4,
        5,
        9
      ],
      "sourceLabels": [
        "Web source 2",
        "Web source 1",
        "Wikipedia"
      ],
      "source": "https://grokipedia.com/page/powers_oregon"
    },
    {
      "id": 2,
      "text": "The city of Powers sits deep in the Coast Range at the upper end of the South Fork Coquille River.",
      "sourceSentenceIds": [
        11
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://theoregoncoastguide.com/powers-oregon-history-smith-powers-logging/"
    },
    {
      "id": 3,
      "text": "The South Fork Coquille watershed was the homeland of the Coquille people long before logging camps entered the valley.",
      "sourceSentenceIds": [
        13
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://theoregoncoastguide.com/powers-oregon-history-smith-powers-logging/"
    },
    {
      "id": 4,
      "text": "By 1916, Powers was a bustling base for 600 workers with company housing, a bank, and a baseball field.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/powers_oregon"
    },
    {
      "id": 5,
      "text": "The Wagner House in Powers is thought to be the oldest pioneer dwelling in the entire region.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Powers%2C_Oregon"
    },
    {
      "id": 6,
      "text": "The Glendale–Powers Bike Trail passes through the city, connecting it to the surrounding landscape.",
