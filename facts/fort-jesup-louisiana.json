  "facts": [
    {
      "id": 1,
      "text": "Fort Jesup was founded by Lieutenant Colonel Zachary Taylor in 1822, sitting midway between the Red and Sabine Rivers.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://ftjesup.org/history/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Fort Jesup, originally called Cantonment Jesup, served the U.S. from 1822 until its abandonment in 1846.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Fort_Jesup",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Fort Jesup was constructed to guard the U.S. border with New Spain and restore order to the Neutral Strip.",
      "sourceSentenceIds": [
        14
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Fort_Jesup",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "After its 1846 abandonment, the federal government retained Fort Jesup until the site was privatized in 1869.",
      "sourceSentenceIds": [
        15
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Fort_Jesup",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Fort Jesup was acquired by Louisiana state parks in 1956 and earned National Historic Landmark status in 1961.",
      "sourceSentenceIds": [
        16
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Fort_Jesup",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Today, Fort Jesup’s kitchen has been restored and furnished with historically accurate period furniture.",
      "sourceSentenceIds": [
        17
      ],
      "sourceLabels": [
