  "facts": [
    {
      "id": 1,
      "text": "East Garfield Park began as rural prairie, joined Chicago in 1869, and soon grew around Central Park, renamed for President Garfield in 1881.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.bronzecommhub.com/blog/east-garfield-park-a-tale-of-resilience-and-renewal-on-chicago-s-west-side",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The 184‑acre Garfield Park Conservatory & Park, a glasshouse, remains a landmark of architectural and ecological innovation.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.bronzecommhub.com/blog/east-garfield-park-a-tale-of-resilience-and-renewal-on-chicago-s-west-side",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "After the 1968 riots, East Garfield Park has rebounded with community‑led affordable housing and cultural projects anchored in preserved landmarks.",
      "sourceSentenceIds": [
        11
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.bronzecommhub.com/blog/east-garfield-park-a-tale-of-resilience-and-renewal-on-chicago-s-west-side",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The CTA Blue and Green Lines serve the area, with a Green Line station at Pulaski and a Blue Line stop in the Eisenhower Expressway median.",
      "sourceSentenceIds": [
        13,
        15
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/West_Garfield_Park%2C_Chicago",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The Chicago Tool Library, a unique community resource, is headquartered in East Garfield Park.",
      "sourceSentenceIds": [
        14
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/West_Garfield_Park%2C_Chicago",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "East Garfield Park’s story of growth, decline, and renewal is reflected in its vibrant street‑art scene.",
