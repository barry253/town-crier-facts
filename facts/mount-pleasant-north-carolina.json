  "facts": [
    {
      "id": 1,
      "text": "Mount Pleasant was named for its picturesque location and high elevation between Adams and Buffalo Creeks in the 1830s.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://mtpleasantnc.gov/Community/Town-History",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town’s historic district was added to the National Register of Historic Places in 1986, preserving its 19th‑century streetscape.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.explorecabarrus.com/cities-towns/mt-pleasant/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The Avett Brothers, a folk band, filmed the music video for “February Seven” in Mount Pleasant, making the town a music‑video landmark.",
      "sourceSentenceIds": [
        2,
        4
      ],
      "sourceLabels": [
        "Web source 2",
        "Wikipedia"
      ],
      "source": "https://www.explorecabarrus.com/cities-towns/mt-pleasant/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The former school building, closed in 1933, now houses the Eastern Cabarrus Historical Society Museum, showcasing mid‑1800s to early 1900s life.",
      "sourceSentenceIds": [
        11
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.explorecabarrus.com/cities-towns/mt-pleasant/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Mount Pleasant sits in eastern Cabarrus County within the Charlotte metropolitan region, in the southern Piedmont of North Carolina.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://mtpleasantnc.gov/Community/Town-History",
      "category": "other",
      "quality": "poor",
      "qualityReason": "location_description"
    },
    {
      "id": 6,
      "text": "The town’s early history traces back to a mid‑1700s campsite called “Mount Comfort,” a stop for wagons between Salisbury and Charles Town.",
      "sourceSentenceIds": [
        6
      ],
