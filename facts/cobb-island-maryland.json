  "facts": [
    {
      "id": 1,
      "text": "Cobb Island sits where the Potomac and Wicomico rivers meet, a spot that made it a strategic privateer haven in the 1600s.",
      "sourceSentenceIds": [
        2,
        14
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Cobb_Island_(Maryland)",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The island’s name comes from “cobbs,” smaller coins cut from Spanish treasure that James Neal distributed to Maryland colonists.",
      "sourceSentenceIds": [
        15
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Cobb_Island_(Maryland)",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "On December 23, 1900, Reginald Fessenden transmitted the first intelligible wireless voice between two 50‑foot masts one mile apart on Cobb Island.",
      "sourceSentenceIds": [
        16
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Cobb_Island_(Maryland)",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Today a historical marker commemorates that 1900 experiment, and the IEEE and Smithsonian recognize the site as the birthplace of radiotelephony.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://thebaynet.com/125-years-later-cobb-island-honors-birthplace-of-wireless-voice-communication/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "A 0.11‑mile bridge built in 1923 connects Cobb Island to the mainland, making the island accessible only by that fixed span.",
      "sourceSentenceIds": [
        13
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Cobb_Island_(Maryland)",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Cobb Island hosts two seafood restaurants with marinas—Captain John’s Crab House and Shymansky’s—alongside a seasonal coffee shop and an art gallery that showcase local talent.",
      "sourceSentenceIds": [
        11
      ],
