    {
      "id": 2,
      "text": "Castleton Corners developed as a vibrant community hub along the old turnpike, featuring hotels, blacksmith shops, and agricultural implement manufactories.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
