    {
      "id": 1,
      "text": "Marblemount sits where the Cascade River meets the Skagit River, a natural crossroads for early travelers.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Marblemount%2C_Washington",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Born as a 1890s mining camp, Marblemount now hosts about 250 residents and serves as a gateway to the North Cascades.",
      "sourceSentenceIds": [
        25
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.offbeatpathfinder.com/destinations/marblemount-washington/",
      "category": "people",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Fifteen miles west in Concrete, towering abandoned cement silos once powered a regional plant that fed the early 20th‑century economy.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.offbeatpathfinder.com/destinations/marblemount-washington/",
      "category": "other",
      "quality": "poor",
      "qualityReason": "other"
    },
    {
      "id": 4,
      "text": "In the 1870s Euro‑Americans settled here to supply miners along the Skagit and Cascade River drainages.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Marblemount%2C_Washington",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "A wagon road linking Marblemount to Sauk was completed in 1892, opening the area to more settlers.",
      "sourceSentenceIds": [
        13
