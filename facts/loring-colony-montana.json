  "facts": [
    {
      "id": 1,
      "text": "Loring Colony was founded in 1982 as a branch of the North Harlem Hutterite Colony, belonging to the Dariusleut Anabaptist group.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/loring_colony_montana",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The community sits at an elevation of 2,705 feet above sea level, according to the Montana Historical Society Library.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.mtmemory.org/nodes/view/128526",
      "category": "other",
      "quality": "poor",
      "qualityReason": "vague"
    },
    {
      "id": 3,
      "text": "Loring began as a stop on the Great Northern Railway’s branch line between Saco and Hogelund, a key link in early 20th‑century rail travel.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.mtmemory.org/nodes/view/128526",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The area’s low precipitation shapes local water resources, with streams and groundwater sustaining the surrounding arid plains.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/loring_colony_montana",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The name Loring likely honors Charles M. Loring, a Minneapolis flour‑mill owner whose family helped establish the town.",
