    },
    {
      "id": 3,
      "text": "Piney View became a rural and residential suburb of Beckley during the 1930s.",
      "sourceSentenceIds": [
        15
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://wvexplorer.com/travel/communities/cities-towns/piney-view-west-virginia/"
    },
    {
      "id": 4,
      "text": "Piney View is known for its pleasant upland climate and frequent morning and evening mists that travel west from the gorge.",
      "sourceSentenceIds": [
