  "facts": [
    {
      "id": 1,
      "text": "Roggen began as Blair in 1882 on the Burlington and Missouri River Railroad, renamed in 1883 to avoid confusion with a Nebraska station.",
      "sourceSentenceIds": [
        1,
        2,
        5
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/roggen_colorado",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "A sugar beet dump operated from 1917 to 1975, making Roggen a key hub for processing and shipping the county’s staple crop.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/roggen_colorado",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The Roggen Grain Elevator remains the most notable landmark, symbolizing the community’s long‑standing agrarian heritage.",
      "sourceSentenceIds": [
        30
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/roggen_colorado",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Today, the Prairie Lodge Motel and Gnaidt’s grocery store are among the few surviving businesses amid abandoned buildings along I‑76.",
