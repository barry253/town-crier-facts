  "facts": [
    {
      "id": 1,
      "text": "Batesburg‑Leesville formed in 1992 by merging Batesburg (inc 1877) and Leesville (inc 1875).",
      "sourceSentenceIds": [
        27,
        28
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Batesburg-Leesville%2C_South_Carolina",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town’s name honors Captain Tom Bates, a Civil War captain, and Colonel John W. Lees, a local leader.",
      "sourceSentenceIds": [
        2,
        3
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Batesburg-Leesville%2C_South_Carolina",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "In 1869 the Charlotte, Columbia, and Augusta Railroad built tracks through both villages, establishing a depot that still marks the historic business districts.",
      "sourceSentenceIds": [
        17,
        21,
        22
      ],
      "sourceLabels": [
        "Web source 1",
        "Web source 2"
      ],
      "source": "https://www.scencyclopedia.org/sce/entries/batesburg-leesville/",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "A 1900 census noted Batesburg had thirty‑three stores, a bank, and the cotton mill Middleburg Mills, reflecting early industrial growth.",
      "sourceSentenceIds": [
        11
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.scencyclopedia.org/sce/entries/batesburg-leesville/",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The Frank Yarborough House, a 19th‑century residence, is listed on the National Register of Historic Places, preserving the town’s architectural heritage.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Batesburg-Leesville%2C_South_Carolina",
      "category": "landmark",
      "quality": "good"
    },
    {
