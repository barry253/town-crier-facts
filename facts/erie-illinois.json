      "quality": "good"
    },
    {
      "id": 3,
      "text": "Railroad service began in 1869, running parallel to Main Street, a pattern that continues today.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://villageoferie.com/about-us/",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The first cheese factory opened in Erie in 1873, marking the start of a local dairy tradition.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://villageoferie.com/about-us/",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "In 1908 the Erie Woman’s Club donated a historic cast‑iron fountain that still sits in the downtown triangle.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
