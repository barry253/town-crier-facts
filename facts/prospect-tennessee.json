  "facts": [
    {
      "id": 1,
      "text": "Prospect sits near the Elk River and Richland Creek, about 10 miles southeast of Pulaski, the county seat of Giles County.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 1"
      ],
