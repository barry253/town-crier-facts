  "facts": [
    {
      "id": 1,
      "text": "Rushville was founded in 1808 by Joseph Turner along the historic Zane's Trace road built by Colonel Ebenezer Zane in 1797.",
      "sourceSentenceIds": [
        1,
        2
      ],
      "sourceLabels": [
        "Web source 1",
        "Wikipedia"
      ],
      "source": "https://www.rushville-oh.com/"
    },
    {
      "id": 2,
      "text": "Before the Civil War, Rushville served as a hidden stop on the Underground Railroad, offering refuge to escaping enslaved people.",
      "sourceSentenceIds": [
        3,
        4
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Rushville%2C_Ohio"
    },
    {
      "id": 3,
      "text": "The village’s name comes from Little Rush Creek, a stream that flows between Rushville and neighboring West Rushville.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Rushville%2C_Ohio"
    },
    {
      "id": 4,
      "text": "Much of Rushville’s historic core is listed on the National Register of Historic Places as the Rushville Historic District.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Rushville%2C_Ohio"
    },
    {
      "id": 5,
      "text": "Benjamin Hanby, the composer of the Christmas classic “Up on the House Top,” was born in Rushville in 1838.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Rushville%2C_Ohio"
    },
    {
      "id": 6,
      "text": "The village hosts the annual Pip Stop Events, a community gathering that showcases local crafts and food.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 2"
      ],
