  "facts": [
    {
      "id": 1,
      "text": "Cape Charles was founded in 1884 as a planned community by railroad and ferry interests near Chesapeake Bay mouth.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Cape_Charles%2C_Virginia",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Cape Charles hosts one of the largest concentrations of turn‑of‑the‑century buildings on the East Coast, many listed on the National Register.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://capecharlesvirginiascape.com/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "In 1890 the Army Corps dredged the harbor and built stone jetties, creating a deep‑water basin that once handled 2.5 million tons of freight annually.",
      "sourceSentenceIds": [
        14,
        24
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Cape_Charles%2C_Virginia",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The town served as the terminal for the Little Creek‑Cape Charles Ferry until 1963, ferrying passengers and cars across the Bay to Norfolk and beyond.",
      "sourceSentenceIds": [
        24,
        25
      ],
