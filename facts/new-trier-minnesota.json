  "facts": [
    {
      "id": 1,
      "text": "New Trier’s roots trace back to the mid‑1850s, when German and Luxembourg immigrants settled the area seeking new opportunities in Dakota County.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/new_trier_minnesota",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town was incorporated on March 3, 1874, and named after New Trier, Germany, reflecting the heritage of its early settlers.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/new_trier_minnesota",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Mary's Catholic Church, a long‑standing landmark, was added to the National Register of Historic Places in 1979.",
      "sourceSentenceIds": [
        4,
        7
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/new_trier_minnesota",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "A railroad station built in nearby Hampton bypassed New Trier, diverting commerce and residents and contributing to the town’s decline.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/new_trier_minnesota",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "New Trier’s post office opened in 1867 and remained in operation until it closed in 1933.",
      "sourceSentenceIds": [
        10
      ],
