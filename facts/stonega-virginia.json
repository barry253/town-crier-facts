  "facts": [
    {
      "id": 1,
      "text": "Stonega began in 1895 as a company town for Virginia Coal and Iron Company, then leased to Stonega Coke and Coal Company in 1902.",
      "sourceSentenceIds": [
        2,
        24
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Stonega%2C_Virginia",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town’s name, shortened from Stone Gap, reflects its location near the mountain pass between Virginia and Kentucky, adopted in 1896.",
      "sourceSentenceIds": [
        4,
        22
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Stonega%2C_Virginia",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Stonega Historic District, listed on the National Register in 2004, preserves buildings from 1895‑1952 built with innovative local timber.",
      "sourceSentenceIds": [
        27,
        28
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.dhr.virginia.gov/historic-registers/097-0042/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "A narrow bottomland along Callahan’s Creek hosted the original mine, with railroad tracks linking it to the Louisville and Nashville line at Appalachia.",
      "sourceSentenceIds": [
        5,
        8
      ],
      "sourceLabels": [
        "Web source 1",
        "Wikipedia"
      ],
      "source": "https://www.dhr.virginia.gov/historic-registers/097-0042/",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Red Row, an African‑American neighborhood in the historic district, once housed double houses and a segregated school that served the community.",
      "sourceSentenceIds": [
        10,
        14
      ],
      "sourceLabels": [
        "Web source 1",
        "Web source 2"
      ],
      "source": "https://www.dhr.virginia.gov/historic-registers/097-0042/",
      "category": "people",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The 1960s Wentz operation opened a new coal mine and preparation plant on Stonega’s edge, marking the town’s last major mining expansion.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 2"
      ],
