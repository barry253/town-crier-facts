  "facts": [
    {
      "id": 1,
      "text": "Neville was platted in spring 1808 by land agent Jonathan Taylor, who named the village after General Presley Neville, a Continental Army officer.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/neville_ohio",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "A post office has served Neville since 1816, marking the village’s early administrative organization.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Neville%2C_Ohio",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Neville’s location on the Ohio River made it a key stop for flatboats and steamboats during the early 19th‑century river trade boom.",
      "sourceSentenceIds": [
        27
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/neville_ohio",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The first commercial store opened around 1812, followed by a second merchant shop, reflecting rapid economic growth tied to river commerce.",
      "sourceSentenceIds": [
        29
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/neville_ohio",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "An ox‑powered grain mill operated in the early 1800s, supporting local agriculture before steamboat traffic enhanced connectivity.",
      "sourceSentenceIds": [
        30
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/neville_ohio",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Neville sits along the Ohio River in southwestern Ohio, placing it within the historic Virginia Military District granted to Revolutionary War veterans.",
