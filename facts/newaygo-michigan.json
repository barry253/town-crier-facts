  "facts": [
    {
      "id": 1,
      "text": "Newaygo’s name may come from Ojibwe Chief Nuwagon or an Algonquian word meaning \"much water,\" reflecting the area’s river heritage.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Newaygo%2C_Michigan",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town’s first saw mill was built by brothers at Penoyer Creek, sparking a long‑lasting lumber industry in Newaygo County.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://newaygo.gov/history.php",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The Big Red Mill on the east bank of the Muskegon River survived as a lumber mill, cement plant, and grain storage into the present day.",
      "sourceSentenceIds": [
        4,
        9
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://newaygo.gov/history.php",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The Muskegon River runs through Newaygo, offering popular canoe trips, tubing, and fishing for locals and visitors alike.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Newaygo%2C_Michigan",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "During the late 1800s, the river’s log‑floating system made Newaygo a key hub for transporting lumber to Muskegon’s mills.",
      "sourceSentenceIds": [
        17
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Newaygo%2C_Michigan",
      "category": "transport",
      "quality": "good"
    },
    {
