  "facts": [
    {
      "id": 1,
      "text": "Oak Shores sits on the north side of Lake Nacimiento reservoir in the Santa Lucia Mountains at 1,814 feet.",
      "sourceSentenceIds": [
        4,
        5
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Oak_Shores%2C_California"
    },
    {
      "id": 2,
      "text": "Oak Shores began as a 1970s leisure subdivision for vacation and retirement homes, capped at 1,786 units by the 2014 plan.",
      "sourceSentenceIds": [
        15
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/oak_shores_california"
    },
    {
      "id": 3,
      "text": "Lake Nacimiento, nicknamed \"Dragon Lake\", offers boating, kayaking, paddleboarding, water skiing, and fishing for bass, bluegill, crappie, and catfish.",
      "sourceSentenceIds": [
        17
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/oak_shores_california"
    },
    {
      "id": 4,
      "text": "Oak Shores is surrounded by oak woodlands of coast live oak and valley oak, with chaparral shrublands adapted to dry summers.",
      "sourceSentenceIds": [
        28
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/oak_shores_california"
    },
    {
      "id": 5,
      "text": "The area was originally inhabited by the Salinan people, whose presence dates back thousands of years.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/oak_shores_california"
    },
    {
