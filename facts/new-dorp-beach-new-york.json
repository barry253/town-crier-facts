  "facts": [
    {
      "id": 1,
      "text": "New Dorp Beach gets its name from Dutch settlers, with \"Nieuw Dorp\" meaning \"new village\" in Dutch.",
      "sourceSentenceIds": [
        2,
        10
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 2"
      ],
      "source": "https://en.wikipedia.org/wiki/New_Dorp%2C_Staten_Island",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "English surveyors formalized New Dorp in 1671, expanding lots along the South Shore after resurveying the earlier Dutch settlement of Oude Dorp.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/New_Dorp%2C_Staten_Island",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The Vanderbilt family, whose legacy still echoes in the area, first settled in New Dorp and are buried in the nearby Moravian Cemetery.",
      "sourceSentenceIds": [
        15,
        29
      ],
      "sourceLabels": [
        "Web source 2",
        "Wikipedia"
      ],
      "source": "https://theneighborhoods.substack.com/p/new-dorp-staten-island",
      "category": "people",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The Lane Theater, opened in 1938, is one of Staten Island’s last intact Depression‑era Art Moderne movie interiors and was landmarked in 1988.",
      "sourceSentenceIds": [
        13,
        16
      ],
      "sourceLabels": [
        "Wikipedia",
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/New_Dorp%2C_Staten_Island",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Hurricane Sandy in 2012 reshaped New Dorp Beach’s shoreline, destroying dozens of homes and forcing a dramatic redraw of the coast.",
      "sourceSentenceIds": [
        22
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.cityneighborhoods.nyc/new-dorp-beach",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "New Dorp’s NYPL branch, opened in 1907, is one of Staten Island’s busiest libraries and was established by local residents.",
