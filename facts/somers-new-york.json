  "facts": [
    {
      "id": 1,
      "text": "Somers is known as the 'Cradle of the American Circus' because Hachaliah Bailey bought an African elephant, Old Bet, and toured the Northeast.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.visitwestchesterny.com/discover/communities/northern-westchester/somers/"
    },
    {
      "id": 2,
      "text": "The Elephant Hotel, built to honor Old Bet, now serves as Somers Town Hall and is a National Historic Landmark.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.visitwestchesterny.com/discover/communities/northern-westchester/somers/"
    },
    {
      "id": 3,
      "text": "Somers was renamed in 1808 to honor naval captain Richard Somers, who died in the First Barbary War.",
      "sourceSentenceIds": [
        26
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Somers%2C_New_York"
    },
    {
      "id": 4,
      "text": "The town’s early 19th‑century economy included hat and carriage factories, a milk factory, and an iron mine, reflecting its industrial past.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Somers%2C_New_York"
    },
    {
      "id": 5,
      "text": "Muscoot Farm, a 777‑acre interpretive farm on Route 100, offers historic buildings and trails that showcase Westchester’s agricultural heritage.",
