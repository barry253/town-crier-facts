  "facts": [
    {
      "id": 1,
      "text": "Pottsville was founded in 1824 by Kirkbride Potts, who journeyed from New Jersey to Arkansas, and the town was named after him when it incorporated in 1897.",
      "sourceSentenceIds": [
        2,
        4
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.livelovearkansas.homes/blog/2024/09/16-pottsville-from-settlement-to-thriving-community"
    },
    {
      "id": 2,
      "text": "The Pottsville Historic Commercial District, listed in 2004, houses a rare cattle‑dipping vat behind the Pottsville Citizens' Bank, possibly the only one in a U.S. historic commercial district.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.livelovearkansas.homes/blog/2024/09/16-pottsville-from-settlement-to-thriving-community"
    },
    {
      "id": 3,
      "text": "Potts Inn, now a museum, stands as one of the best‑preserved stagecoach stations on the Butterfield Overland Mail route.",
      "sourceSentenceIds": [
        11
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.livelovearkansas.homes/blog/2024/09/16-pottsville-from-settlement-to-thriving-community"
    },
    {
      "id": 4,
      "text": "A stage route and the Little Rock‑Fort Smith Railroad helped spur Pottsville’s growth in the late 19th century.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.livelovearkansas.homes/blog/2024/09/16-pottsville-from-settlement-to-thriving-community"
    },
    {
      "id": 5,
      "text": "Associate Reformed Presbyterians from the Carolinas arrived in 1851, a key factor in Pottsville’s early expansion.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.livelovearkansas.homes/blog/2024/09/16-pottsville-from-settlement-to-thriving-community"
    },
    {
      "id": 6,
      "text": "Pottsville’s First Methodist Church and New Prospect Baptist Church were both founded in the late 1800s.",
