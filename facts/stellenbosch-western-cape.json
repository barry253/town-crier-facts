  "facts": [
    {
      "id": 1,
      "text": "Founded in 1679 by Governor Simon van der Stel, the town was named after himself – Stellenbosch means '(van der) Stel's Forest'.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
