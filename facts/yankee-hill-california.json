  "facts": [
    {
      "id": 1,
      "text": "Founded in 2003, the Yankee Hill Historical Society is a non‑profit that preserves the town’s heritage and culture.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://museumsdatabase.com/museums/view/2572"
    },
    {
      "id": 2,
      "text": "The society protects historic structures, including the Yankee Hill Schoolhouse, built in the late 1800s and the town’s oldest building.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://museumsdatabase.com/museums/view/2572"
    },
    {
      "id": 3,
      "text": "Its museum displays a collection of artifacts and photographs that chronicle Yankee Hill’s past.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://museumsdatabase.com/museums/view/2572"
    },
    {
      "id": 4,
      "text": "Yankee Hill sits in Tuolumne County at an elevation of about 2,230 feet above sea level.",
      "sourceSentenceIds": [
        20
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://roadsidethoughts.com/ca/yankee-hill-xx-tuolumne-profile.htm"
    },
    {
      "id": 5,
      "text": "Two California communities share the name Yankee Hill; the one in Tuolumne County is the focus of this fact.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://roadsidethoughts.com/ca/yankee-hill-xx-tuolumne-profile.htm"
    },
    {
      "id": 6,
      "text": "Each year the society hosts an annual Yankee Hill Historic Tour, inviting visitors to explore the town’s rich history.",
      "sourceSentenceIds": [
        6
