      "quality": "good"
    },
    {
      "id": 2,
      "text": "Draper was originally called Draperville, honoring William Draper Jr., the first presiding bishop of the local Mormon congregation.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 2"
      ],
