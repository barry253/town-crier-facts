  "facts": [
    {
      "id": 1,
      "text": "Naguabo was founded in 1821 and is nicknamed \"La Ciudad de los Enchumbaos\" because of its frequent rain.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.trawellino.com/destinations/puerto-rico/naguabo_naguabo",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The historic El Castillo Villa Del Mar, a Victorian‑style building at Playa Húcares, is listed on the National Register of Historic Places.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Naguabo%2C_Puerto_Rico",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Fishing has long been a mainstay of Naguabo’s economy, anchoring the local community for generations.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Naguabo%2C_Puerto_Rico",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Naguabo is the birthplace of the pastelillo de chapín, a deep‑fried dough pastry filled with trunkfish, a staple at seaside eateries.",
      "sourceSentenceIds": [
        15,
        16,
        17
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Naguabo%2C_Puerto_Rico",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The municipality’s highest point, Pico del Este in the Sierra de Luquillo, rises to 3,419 feet.",
      "sourceSentenceIds": [
        29
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Naguabo%2C_Puerto_Rico",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The ruins of a historic lighthouse on Naguabo’s coast are maintained by the municipal government.",
