      "quality": "poor",
      "qualityReason": "location_description"
    },
    {
      "id": 2,
      "text": "Mexico earned the nickname 'Mother of Towns' because its original borders eventually became six counties.",
      "sourceSentenceIds": [
        17
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Mexico%2C_New_York",
      "category": "other",
      "quality": "poor",
      "qualityReason": "editorial_filler"
    },
    {
      "id": 3,
      "text": "Early Mexico businesses included sawmills, oil‑mills, gristmills, tanneries, and even a distillery.",
      "sourceSentenceIds": [
        25
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Mexico%2C_New_York",
      "category": "other",
      "quality": "poor",
      "qualityReason": "editorial_filler"
    },
    {
      "id": 4,
      "text": "Inventor Lewis Miller from the area created the spring wagon, a staple of New York transport.",
      "sourceSentenceIds": [
        26
