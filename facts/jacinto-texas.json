      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The city\u2019s name honors the San Jacinto battlefield, the site of Texas\u2019s decisive 1836 victory over Mexico.",
      "sourceSentenceIds": [
        24
      ],
      "sourceLabels": [
        "Web source 2"
