  "facts": [
    {
      "id": 1,
      "text": "South Greensburg began as a coal mining town when Greensburg Coal and Coke Company opened a mine and brickyard on Broad Street in 1881.",
      "sourceSentenceIds": [
        18
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/South_Greensburg%2C_Pennsylvania",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "In 1888, the company built fifty worker houses, marking the town’s rapid growth.",
      "sourceSentenceIds": [
        19
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/South_Greensburg%2C_Pennsylvania",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "A trolley line launched in 1890 ran north along Broad Street into Greensburg, later operated by West Penn Railways until 1952.",
      "sourceSentenceIds": [
        20,
        21
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/South_Greensburg%2C_Pennsylvania",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The borough was incorporated in 1891, officially becoming South Greensburg.",
      "sourceSentenceIds": [
        22
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/South_Greensburg%2C_Pennsylvania",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "During the 1910–1911 Westmoreland County Coal Strike, South Greensburg was a flashpoint for violence between miners and company security.",
      "sourceSentenceIds": [
        23,
        24,
        25,
        26,
        27
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/South_Greensburg%2C_Pennsylvania",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The Rugh family farm, acquired by Michael Rugh in 1780, later became the foundation for the town’s early settlement.",
