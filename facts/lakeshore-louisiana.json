  "facts": [
    {
      "id": 1,
      "text": "Before the 1920s, Lakeshore was marshy swampland along Lake Pontchartrain, dotted with fishing shacks and camps.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/lakeshore_louisiana",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "In 1926, engineers began filling the marshes, building a concrete seawall and raising the land 5–10 feet above lake level.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/lakeshore_louisiana",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The 5–10 foot elevation spared much of Lakeshore from Hurricane Katrina flooding, though Allen Toussaint Boulevard areas still suffered.",
      "sourceSentenceIds": [
        11
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/lakeshore_louisiana",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "West Lakeshore opened in 1951 on the former Lagarde Hospital site, followed by East Lakeshore in 1955 on the former Musser‑Gorden Hospital grounds.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/lakeshore_louisiana",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Lakeshore’s linear streets and strong community associations preserve its historic feel while promoting safety.",
      "sourceSentenceIds": [
        1
      ],
