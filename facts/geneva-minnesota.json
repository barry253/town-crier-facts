    {
      "id": 1,
      "text": "Geneva, Minnesota, was named after Geneva, New York, reflecting a common practice of transplanting familiar place names during mid‑19th‑century westward migration.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 2"
      ],
