  "facts": [
    {
      "id": 1,
      "text": "Toledo was founded in 1853 as the county seat of Tama County.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Toledo%2C_Iowa",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The city’s name comes from Toledo, Ohio, reflecting early settlers’ hometowns.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Toledo%2C_Iowa",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The Tama County Courthouse, built in 1866 for $25,000, sits in downtown Toledo and is listed on the National Register of Historic Places.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.toledoia.com/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The Tama County Historical Museum and Genealogical Library occupies the former county jail, a 1870 building that also houses a restored log cabin.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.toledoia.com/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Every year, the historic stoplight at High Street and Broadway hosts a festival that celebrates Toledo’s unique traffic‑signal heritage.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Toledo%2C_Iowa",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Toledo’s downtown is full of landmarks on the National Register, including the 1866 courthouse and the historic stoplight that inspired the annual festival.",
