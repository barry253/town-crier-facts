      "quality": "good"
    },
    {
      "id": 4,
      "text": "The township’s earliest surveys date back to November 1770, marking it as one of the oldest documented areas in Centre County.",
      "sourceSentenceIds": [
        11
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://centre.pagenweb.org/twpsboros/waltwp1.htm",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Hublersburg is one of several villages in Walker Township, alongside Zion, Snydertown, and Nittany, and the area contains notable iron ore deposits.",
