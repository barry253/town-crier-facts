  "facts": [
    {
      "id": 1,
      "text": "Union City got its name from the 1850 Horner brothers who christened it after their Sacramento River steamship, the Union.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Union_City%2C_California",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "In 1854 Union City merged with New Haven to form Alvarado, honoring former Mexican governor Juan Bautista Alvarado.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Union_City%2C_California",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The first U.S. sugar beet factory, the California Beet Sugar Company, opened in Union City, marking a sweet industrial milestone.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Union_City%2C_California",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Union City’s railroad roots run deep: Decoto, founded in 1870, became a transcontinental rail hub that still bisects the town today.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Union_City%2C_California",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The Union City BART station was rebuilt in 2007, transforming it into a modern intermodal transit hub for the East Bay.",
      "sourceSentenceIds": [
        29
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Union_City%2C_California",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Alvarado’s historic landmark, #503, stands at Dyer and Ratekin, preserving the town’s early 19th‑century heritage.",
