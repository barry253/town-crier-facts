  "facts": [
    {
      "id": 1,
      "text": "Herndon was originally called Pesth, named after Pest, Hungary, reflecting the strong Austrian‑Hungarian immigrant presence.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/herndon_kansas",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Lorenz and Sophia Demmer, immigrants from Austria‑Hungary, first settled the area in May 1876.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/herndon_kansas",
      "category": "people",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The Chicago, Burlington & Quincy Railroad arrived in November 1887, sparking a rapid building boom in Herndon.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://legendsofkansas.com/herndon-kansas/",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "A Catholic school has served Herndon's immigrant community since 1892, reflecting the town's early cultural roots.",
      "sourceSentenceIds": [
        13
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/herndon_kansas",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Herndon was officially incorporated as a city in 1906, marking its transition from a rural settlement to municipal status.",
      "sourceSentenceIds": [
        20
