  "facts": [
    {
      "id": 1,
      "text": "Sauk City was founded in the 1840s by Hungarian pioneer Agoston Haraszthy and his partner Robert Bryant.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Sauk_City%2C_Wisconsin"
    },
    {
      "id": 2,
      "text": "German immigrants established the Sauk City Free Congregation in 1852, one of the earliest non‑religious communities in the state.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Sauk_City%2C_Wisconsin"
    },
    {
      "id": 3,
      "text": "Harper's Weekly called Sauk City \"America's Foremost City\" in a 1914 issue, a rare national accolade for a small village.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Sauk_City%2C_Wisconsin"
    },
    {
      "id": 4,
      "text": "The Great Sauk State Trail opened in 2017, converting a former railroad line into a scenic path for cyclists and hikers.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Sauk_City%2C_Wisconsin"
    },
    {
      "id": 5,
      "text": "Sauk City sits along the Wisconsin River, a feature that shaped its early settlement and continues to define its landscape.",
      "sourceSentenceIds": [
        17
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Sauk_City%2C_Wisconsin"
    },
    {
      "id": 6,
      "text": "Before European settlers, a large Sauk village stood beside the river, noted by explorer Jonathan Carver in 1766 as the \"Great Town of the Saukies\".",
