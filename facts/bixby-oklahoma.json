  "facts": [
    {
      "id": 1,
      "text": "In 1904 the Midland Valley Railroad laid tracks and built a depot half a mile north of the original Bixby, sparking the town’s growth.",
      "sourceSentenceIds": [
        1,
        22
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Bixby%2C_Oklahoma"
    },
    {
      "id": 2,
      "text": "Bixby was named for Tams Bixby, a chairman of the Dawes Commission who helped settle the Muscogee (Creek) Nation in the early 1900s.",
      "sourceSentenceIds": [
        13,
        15
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Bixby%2C_Oklahoma"
    },
    {
      "id": 3,
      "text": "Every June, Bixby celebrates its agrarian roots with the Green Corn Festival, a tradition that honors the town’s farming heritage.",
      "sourceSentenceIds": [
        19
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Bixby%2C_Oklahoma"
    },
    {
      "id": 4,
      "text": "The historic Plummer’s Service Station, built in 1921, now serves as a museum exhibit restored by the Bixby Historical Society.",
      "sourceSentenceIds": [
        14,
        16
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 2"
      ],
      "source": "https://en.wikipedia.org/wiki/Bixby%2C_Oklahoma"
    },
    {
      "id": 5,
      "text": "BTC Broadband, founded in 1914 as Bixby Telephone Company, has supplied local telephone and internet services to the community for over a century.",
      "sourceSentenceIds": [
        20,
        21
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Bixby%2C_Oklahoma"
    },
    {
      "id": 6,
      "text": "Founded in 1983, the Bixby Historical Society preserves local artifacts and offers educational programs about the town’s past.",
