  "facts": [
    {
      "id": 1,
      "text": "Dillon was named for prospector Tom Dillon.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Dillon%2C_Colorado"
    },
    {
      "id": 2,
      "text": "The original town began as a stage stop on the Snake River and was moved twice to stay closer to expanding railroad lines.",
      "sourceSentenceIds": [
        6,
        4
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Dillon%2C_Colorado"
    },
    {
      "id": 3,
      "text": "In 1956 Denver Water ordered residents to relocate because a new dam would flood the old town and create Dillon Reservoir.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Dillon%2C_Colorado"
    },
    {
      "id": 4,
      "text": "Today Dillon sits on the shoreline of Dillon Reservoir, about a mile north and 160 feet higher than the original site.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Dillon%2C_Colorado"
    },
    {
      "id": 5,
      "text": "Dillon Dam and its reservoir, Lake Dillon, are adjacent landmarks that shape the town’s landscape.",
      "sourceSentenceIds": [
        11
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Dillon%2C_Colorado"
    },
    {
      "id": 6,
      "text": "The continental divide lies roughly ten miles east of Dillon, giving the town a distinctive high‑altitude setting.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Dillon%2C_Colorado"
