  "facts": [
    {
      "id": 1,
      "text": "Dunn was founded by a man named Richardson and named for Alonzo T., a local rancher.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.tshaonline.org/handbook/entries/dunn-tx"
    },
    {
      "id": 2,
      "text": "The town sits on State Highway 208, ten miles south of Snyder in south‑central Scurry County.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.tshaonline.org/handbook/entries/dunn-tx"
    },
    {
      "id": 3,
      "text": "Before becoming a town, Dunn was a watering hole for freighters hauling supplies between Colorado City and Lubbock.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.tshaonline.org/handbook/entries/dunn-tx"
    },
    {
      "id": 4,
      "text": "A post office was granted to Dunn in 1890, and the town’s first postmaster was the owner of the Dunn home.",
      "sourceSentenceIds": [
        25
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.tshaonline.org/handbook/entries/dunn-tx"
    },
    {
      "id": 5,
      "text": "The Dunn home served as a way station and mail drop for mail and passenger hacks in the early days.",
      "sourceSentenceIds": [
        25
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.tshaonline.org/handbook/entries/dunn-tx"
    },
    {
      "id": 6,
      "text": "Dunn’s early economy relied heavily on the Texas and Pacific Railway, which brought freighters through the area.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.tshaonline.org/handbook/entries/dunn-tx"
    }
  ]
