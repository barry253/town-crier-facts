      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Yellville%2C_Arkansas",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The Fred Berry Conservation Education Center, founded by a former Yellville teacher, sits on the creek and offers canoe access and walking trails.",
