  "facts": [
    {
      "id": 1,
      "text": "Bayou La Batre was founded in 1786, when French-born Joseph Bouzage (or Bosarge) was awarded a 1,259-acre Spanish land grant on the West Bank of the bayou.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
