  "facts": [
    {
      "id": 1,
      "text": "Jamesville adopted its name around 1810 from the Jamesville Iron and Woolen Factory founded by Stephen Hungerford, first publicized July 4 1810.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/jamesville_new_york",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The hamlet’s first frame house appeared in 1797 and a tavern in 1804, marking its early rural roots and later milling, railroading, and industry heritage.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/jamesville_new_york",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Jamesville’s historic train station and pre‑1950 churches and homes survive, preserving the town’s industrial past.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/jamesville_new_york",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The town sits on rolling hills shaped by retreating ice sheets, giving fertile soils that supported early agriculture along Butternut Creek.",
      "sourceSentenceIds": [
        16
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/jamesville_new_york",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Jamesville Reservoir lies just south of the hamlet, and its county park hosts an annual balloon festival each summer.",
      "sourceSentenceIds": [
        25,
