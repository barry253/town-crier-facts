  "facts": [
    {
      "id": 1,
      "text": "Kendrick was named in May 1890 after Northern Pacific chief engineer John P. Kendrick, thanks to a promise the railroad would extend its track there.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.cityofkendrick.com/",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Thomas Kirby founded the town in 1889, originally calling it Latah or Latah City before it became Kendrick.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.cityofkendrick.com/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "A post office opened on May 24, 1889, with Thomas Kirby serving as the first postmaster.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Kendrick%2C_Idaho",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Kendrick officially incorporated on October 15, 1890, solidifying its status as a city.",
      "sourceSentenceIds": [
        24
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.cityofkendrick.com/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The town sits amid pine, fir, and cedar trees in a 1,500‑foot canyon valley along the Potlatch River.",
      "sourceSentenceIds": [
        21
      ],
      "sourceLabels": [
        "Web source 1"
