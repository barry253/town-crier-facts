    {
      "id": 1,
      "text": "Ann Arbor was founded in 1824 by land speculators John Allen and Elisha Walker Rumsey, who named it after their wives, both named Ann, and the oak groves.",
      "sourceSentenceIds": [
        5,
        6
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
