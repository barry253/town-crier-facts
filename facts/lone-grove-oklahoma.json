  "facts": [
    {
      "id": 1,
      "text": "Lone Grove was founded on February 4, 1885, in the former Chickasaw Nation of Indian Territory.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.okhistory.org/publications/enc/entry?entry=LO007"
    },
    {
      "id": 2,
      "text": "Before becoming Lone Grove, the community was known as Price's Store, named after a local general mercantile owner.",
      "sourceSentenceIds": [
        9,
        11
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Lone_Grove%2C_Oklahoma"
    },
    {
      "id": 3,
      "text": "Lone Grove is built on the site of a former village located near a stand of cedar trees.",
      "sourceSentenceIds": [
        23
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Lone_Grove%2C_Oklahoma"
    },
    {
      "id": 4,
      "text": "During the 1920s, Lone Grove grew with the addition of a Masonic Lodge, a grist mill, and a wagonyard.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Lone_Grove%2C_Oklahoma"
    },
    {
      "id": 5,
      "text": "The Ringling Railroad once served the area before being acquired by the Atchison, Topeka and Santa Fe Railway.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Lone_Grove%2C_Oklahoma"
    },
    {
      "id": 6,
      "text": "Early twentieth-century businesses in Lone Grove included a movie theater, a blacksmith shop, and three grocery stores.",
      "sourceSentenceIds": [
        25
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Lone_Grove%2C_Oklahoma"
