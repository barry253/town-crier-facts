  "facts": [
    {
      "id": 1,
      "text": "Beurys Lake was built by Harvey E. Beury between 1920-1923 by damming Deep Creek, creating a 12-acre man‑made lake.",
      "sourceSentenceIds": [
        3,
        22
      ],
      "sourceLabels": [
        "Web source 1",
        "Wikipedia"
      ],
      "source": "https://grokipedia.com/page/beurys_lake_pennsylvania",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The resort opened as Beury's Grove in 1923, charging ten cents for a day of swimming in a lake that could reach 15 feet deep.",
      "sourceSentenceIds": [
        23,
        8
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Beurys_Lake%2C_Pennsylvania",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "During WWII, the lake offered free entry to uniformed service members and Salvation Army personnel, and the Lone Ranger appeared there in the late 1940s, drawing 3,000 visitors.",
      "sourceSentenceIds": [
        5,
        7
      ],
      "sourceLabels": [
        "Web source 1",
        "Wikipedia"
      ],
      "source": "https://grokipedia.com/page/beurys_lake_pennsylvania",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "In 1962 the resort was sold to Mountain Valley Lake, Inc., later renamed Moon Lake Association, which closed the public resort in 1974 before reopening privately in 1984.",
      "sourceSentenceIds": [
        2,
        25,
        10
      ],
      "sourceLabels": [
        "Web source 1",
        "Wikipedia",
        "Wikipedia"
      ],
      "source": "https://grokipedia.com/page/beurys_lake_pennsylvania",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The community centers around the privately owned lake, now called Moon Lake, and there is no public access.",
      "sourceSentenceIds": [
