  "facts": [
    {
      "id": 1,
      "text": "Kings, Illinois was laid out in June 1876 by Hank King, who built the first hotel and a two‑story corner building that still stands.",
      "sourceSentenceIds": [
        4,
        17
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://ogle.illinoisgenweb.org/kingshistory.htm",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town’s early economy revolved around a grain elevator and a silo that Hank King used to store popcorn and feed cattle.",
      "sourceSentenceIds": [
        6,
        18
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://ogle.illinoisgenweb.org/kingshistory.htm",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Kings Station earned its nickname from the Chicago, Burlington and Quincy Railroad branch that ran through town, built in 1874 from Flagg Center to Rockford.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://ogle.illinoisgenweb.org/kingshistory.htm",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "A post office once operated out of the corner store at Kings Station, moving from White Rock Burg and serving the community for many years.",
      "sourceSentenceIds": [
        13
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://ogle.illinoisgenweb.org/kingshistory.htm",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The village was originally surveyed and plotted by William Henry King and his wife Emeline, whose land ownership helped shape the town’s layout.",
      "sourceSentenceIds": [
        15
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://ogle.illinoisgenweb.org/kingshistory.htm",
      "category": "people",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Kings, Illinois shares its name with two other Illinois communities and twenty‑two other U.S. towns named Kings, but it remains a distinct unincorporated community in Ogle County.",
      "sourceSentenceIds": [
        1,
        2
      ],
