      ],
      "source": "https://greatplacesnj.org/map-location/downtown-dunellen/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The borough’s “Miracle Mile” stretches just 1.06 square miles, offering a compact mix of shops, eateries, and historic sites.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://greatplacesnj.org/map-location/downtown-dunellen/",
      "category": "other",
      "quality": "poor",
      "qualityReason": "vague"
    },
    {
      "id": 3,
      "text": "The historic Dunellen Theatre, a centerpiece of downtown, has entertained residents since the early 20th century.",
      "sourceSentenceIds": [
        11
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://greatplacesnj.org/map-location/downtown-dunellen/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "In 2018, the former brownfield at Dunellen Station was reborn as Nell, a mixed‑use space that revitalized the area.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Web source 2"
      ],
