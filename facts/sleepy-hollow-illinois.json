  "facts": [
    {
      "id": 1,
      "text": "Sleepy Hollow, Illinois takes its name from Washington Irving’s “The Legend of Sleepy Hollow,” though the town has no headless horseman.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://exploreelginarea.com/plan-your-visit/about-explore-elgin-area/communities/sleepy-hollow/"
    },
    {
      "id": 2,
      "text": "The village’s only early commercial spots were the Sleepy Hollow Resort Motel, later the Chateau Louise, and Crichton’s Super Mart.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Sleepy_Hollow%2C_Illinois"
    },
    {
      "id": 3,
      "text": "Remnants of the town’s past linger in well‑preserved barns and farmhouses that line the streets.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://exploreelginarea.com/plan-your-visit/about-explore-elgin-area/communities/sleepy-hollow/"
    },
    {
      "id": 4,
      "text": "The village sits on the former Sleepy Hollow Farm, once owned by J. McNabb, a former chairman of Bell and Howell.",
      "sourceSentenceIds": [
        25,
        26
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Sleepy_Hollow%2C_Illinois"
    },
    {
      "id": 5,
      "text": "The original farm layout featured curving roads without curbs or sidewalks, designed to preserve every tree.",
      "sourceSentenceIds": [
        30
