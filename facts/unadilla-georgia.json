      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Since 2017, Unadilla hosts the Hog Drop, a New Year’s Eve celebration that ends with a pig-shaped sign dropping at midnight.",
      "sourceSentenceIds": [
        23,
