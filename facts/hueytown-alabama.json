  "facts": [
    {
      "id": 1,
      "text": "Hueytown takes its name from the Huey family, early settlers who followed the first land claim by William Brown in 1815.",
      "sourceSentenceIds": [
        4,
        12,
        15
      ],
      "sourceLabels": [
        "Web source 2",
        "Web source 1"
      ],
      "source": "https://encyclopediaofalabama.org/article/hueytown/",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "In 1815, William Brown left Tennessee and founded what later became known as “Possum Valley,” the seed of Hueytown.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.hueytownal.gov/1217/History",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Virginia Mines, opened in 1902, remains one of the first coal mines in Hueytown, with its original buildings still listed on the Alabama Register of Historic Places.",
      "sourceSentenceIds": [
        16
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://encyclopediaofalabama.org/article/hueytown/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "An underground explosion in Hueytown’s mines became one of Alabama’s worst disasters, entombing an entire day crew.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Hueytown%2C_Alabama",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Hueytown Public Library opened in 1969 within a municipal hallway before moving into its own building in 1990.",
      "sourceSentenceIds": [
        21
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://encyclopediaofalabama.org/article/hueytown/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Hueytown High School’s marching band has earned regional prestige, performing alongside the University of Alabama at Birmingham’s symphonic ensembles.",
      "sourceSentenceIds": [
