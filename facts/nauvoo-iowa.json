  "facts": [
    {
      "id": 1,
      "text": "Nauvoo was renamed from Commerce by Joseph Smith on April 21, 1840, as Latter‑day Saints sought refuge from Missouri conflict.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Nauvoo%2C_Illinois",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town began as a Native American village called Quashquame, honoring a Sauk and Meskwaki chief who led nearly 500 lodges.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Nauvoo%2C_Illinois",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "In the 19th century, Nauvoo became the most German‑speaking town in Illinois before World War I, thanks to a large German immigrant population.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://icl.coop/the-allure-of-beautiful-nauvoo/",
      "category": "people",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The Icarians, a utopian community, established a wine‑making business in Nauvoo, but prohibition caused their cellars to fall out of use.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Nauvoo%2C_Illinois",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Historic Nauvoo now hosts dozens of 19th‑century buildings, rebuilt by the Church of Jesus Christ of Latter‑Day Saints, and stretches along the river flats.",
      "sourceSentenceIds": [
        26,
        27
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://icl.coop/the-allure-of-beautiful-nauvoo/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "In 2024, the Church of Jesus Christ of Latter‑Day Saints acquired sites in Nauvoo, including the Joseph Smith Homestead and the Nauvoo House, except the Smith Family Cemetery.",
      "sourceSentenceIds": [
        11
      ],
