  "facts": [
    {
      "id": 1,
      "text": "Cima, Spanish for \"summit,\" sits at 4,175 feet in a mountain pass between the Ivanpah Valley and the Mojave River basin.",
      "sourceSentenceIds": [
        13,
        14
      ],
      "sourceLabels": [
