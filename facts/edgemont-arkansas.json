  "facts": [
    {
      "id": 1,
      "text": "Edgemont began as the 1840s Kinderhook community on the Little Red River, renamed in 1908 when the Missouri and North Arkansas Railroad spurred sawmills and a cotton gin.",
      "sourceSentenceIds": [
        1,
        5
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/edgemont_arkansas"
    },
    {
      "id": 2,
      "text": "The Army Corps of Engineers moved Edgemont northward in the 1950s, submerging Old Edgemont under 60‑80 feet of Greers Ferry Lake.",
      "sourceSentenceIds": [
        22
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/edgemont_arkansas"
    },
    {
      "id": 3,
      "text": "Today, Edgemont sits between Fairfield Bay and Greers Ferry, serving as a lakefront hub for vacationers and retirees.",
      "sourceSentenceIds": [
        23
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/edgemont_arkansas"
    },
    {
      "id": 4,
      "text": "Before European settlement, the Little Red River area that is now Edgemont served as Osage hunting grounds until the early 1800s.",
