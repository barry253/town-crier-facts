  "facts": [
    {
      "id": 1,
      "text": "The Village was founded in 1949 by local store owners to stop the area from being annexed by Oklahoma City.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.britannica.com/place/The-Village-Oklahoma",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Its name comes from a 40‑acre plot bought by a pioneer who called the land “The Village.”.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.thevillageok.gov/157/About-The-Village",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Love’s Travel Stops & Country Stores headquarters sits in The Village, making it a key stop for long‑haul drivers.",
      "sourceSentenceIds": [
        3,
