  "facts": [
    {
      "id": 1,
      "text": "Fate, Texas, got its name from two local men nicknamed 'Fate'—William Lafayette Brown and GW Lafayette Peyton—who lived there in the 1860s.",
      "sourceSentenceIds": [
        1,
        2
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Fate%2C_Texas"
    },
    {
      "id": 2,
      "text": "The town was settled shortly after the Civil War and originally sat 1.5 miles north of its current downtown.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Fate%2C_Texas"
    },
    {
      "id": 3,
      "text": "Land ownership, a post office, and the railroad all helped decide the name Fate for the town.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Fate%2C_Texas"
    },
    {
      "id": 4,
      "text": "Fate became Texas’s first town with a rural mail route on August 1, 1899.",
