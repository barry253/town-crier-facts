  "facts": [
    {
      "id": 1,
      "text": "Fletcher was first settled in 1795 when Samuel Murray moved his family to the mountains of western North Carolina.",
      "sourceSentenceIds": [
        3,
        14
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.fletchernc.org/about-us/history-of-fletcher/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Originally called Murrayville, the town was a key way‑station on the Buncombe Turnpike built in the early 1800s.",
      "sourceSentenceIds": [
        6,
        8
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Fletcher%2C_North_Carolina",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "In 1837 Murrayville was renamed Shufordsville after Postmaster Jacob Rhyne Shuford.",
      "sourceSentenceIds": [
        7,
        9
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Fletcher%2C_North_Carolina",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Fletcher’s Meadows and Rugby Grange are listed on the National Register of Historic Places.",
      "sourceSentenceIds": [
