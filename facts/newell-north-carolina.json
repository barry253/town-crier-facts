  "facts": [
    {
      "id": 1,
      "text": "Newell got its name from William Burns Newell, who bought a 108‑acre farm in 1887 and built the area’s oldest house.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/newell_north_carolina",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The Newell House, a two‑story brick “I” house built with handmade bricks, once served as the community’s hub beside a general store.",
      "sourceSentenceIds": [
        18
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/newell_north_carolina",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Old Concord Road, an east‑west artery, still shapes Newell’s residential layout and echoes its early rural character.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/newell_north_carolina",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Reedy Creek borders Newell to the south, its watershed feeding the larger Catawba River system and supporting local riparian habitats.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/newell_north_carolina",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Newell lies along Charlotte’s northeastern edge, with downtown just seven miles southwest, accessible via North Tryon Street.",
