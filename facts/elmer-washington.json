    },
    {
      "id": 3,
      "text": "Electricity arrived in Elmer City in 1935, a decade before its official incorporation.",
      "sourceSentenceIds": [
        19
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://couleecorridor.com/index.php/trip-planner/attractions/elmer-city"
    },
    {
      "id": 4,
      "text": "Elmer City lies along the Columbia River, just north of Grand Coulee Dam and near the Canadian border.",
      "sourceSentenceIds": [
        26
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.citydirectory.us/town-elmer-city.html"
    },
    {
      "id": 5,
      "text": "The town is part of the larger Columbia River Basin, a key agricultural and hydroelectric corridor.",
