      ],
      "source": "https://en.wikipedia.org/wiki/Elmer_City%2C_Washington"
    },
    {
      "id": 2,
      "text": "The town’s name evolved from Elmerton, honoring homesteader Elmer Seaton, to Elmer City in 1939.",
      "sourceSentenceIds": [
        18
      ],
      "sourceLabels": [
        "Web source 1"
      ],
