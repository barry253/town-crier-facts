      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Shamrock%2C_Texas",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Shamrock sits at the crossroads of Interstate 40 and U.S. Route 83, a spot that earned it the nickname “gateway to the Southwest.”.",
      "sourceSentenceIds": [
        24,
        25
      ],
      "sourceLabels": [
