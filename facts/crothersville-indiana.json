  "facts": [
    {
      "id": 1,
      "text": "Crothersville began as Haysville, but when a railroad superintendent offered a depot, the town changed its name to honor him.",
      "sourceSentenceIds": [
        1,
        2,
        14
      ],
      "sourceLabels": [
        "Web source 1",
        "Web source 2"
      ],
      "source": "https://www.in.gov/towns/crothersville/crothersville-history/",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The original depot, now gone, once stood as a landmark that drew travelers to the growing town.",
      "sourceSentenceIds": [
        3,
        11
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://discoverindianahistory.org/items/show/599",
      "category": "landmark",
      "quality": "poor",
      "qualityReason": "vague"
    },
    {
      "id": 3,
      "text": "Crothersville once operated the state’s largest stave factory, a key supplier for the region’s timber industry.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.in.gov/towns/crothersville/crothersville-history/",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Today, Crothersville’s public library serves residents as a branch of the Jackson County Public Library system.",
      "sourceSentenceIds": [
        20
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Crothersville%2C_Indiana",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The land that became Crothersville originally belonged to Tecumseh, the renowned Shawnee chief.",
