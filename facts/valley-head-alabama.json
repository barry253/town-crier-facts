  "facts": [
    {
      "id": 1,
      "text": "Valley Head is located on top of Sand Mountain in the Lookout Mountain region of northeast Alabama.",
      "sourceSentenceIds": [
        11,
        15
      ],
      "sourceLabels": [
        "Web source 2",
        "Wikipedia"
      ],
      "source": "https://encyclopediaofalabama.org/article/valley-head/"
    },
    {
      "id": 2,
      "text": "Valley Head is known as the coolest place in Alabama, with winter temperatures significantly lower than on the Gulf Coast.",
      "sourceSentenceIds": [
        17
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Valley_Head%2C_Alabama"
    },
    {
      "id": 3,
      "text": "White settlers began arriving in the Valley Head area by the early nineteenth century, establishing a post office in 1837.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://encyclopediaofalabama.org/article/valley-head/"
    },
    {
      "id": 4,
      "text": "Sequoyah Caverns in Valley Head are named after the man who created the Cherokee syllabary.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://encyclopediaofalabama.org/article/valley-head/"
    },
    {
      "id": 5,
      "text": "Many Cherokee Indians used the rolling hills and caverns of Valley Head to avoid the Trail of Tears.",
      "sourceSentenceIds": [
