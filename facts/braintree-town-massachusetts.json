      "id": 1,
      "text": "Braintree was first colonized in 1625 by Captain Wollaston and originally called Mount Wollaston.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://braintreema.gov/461/Historic-Information",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town adopted the name of its English namesake in 1640, after being incorporated from land that later became Quincy and Randolph.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://braintreema.gov/461/Historic-Information",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "William Rosenberg, a Braintree resident, founded Dunkin’ Donuts, opening the first coffee shop in the town in the 1950s.",
