  "facts": [
    {
      "id": 1,
      "text": "Preston was first surveyed by Robert Hoddle in 1837 and named after a town in Sussex, England.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://tomelbourne.com/history-preston-suburb/",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Early European land sales in Preston were tied to John Batman’s claim between the Merri and Darebin Creeks.",
      "sourceSentenceIds": [
        20
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://tomelbourne.com/history-preston-suburb/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The 1860s marked Preston’s industrial boom with a bacon‑curing factory opening in 1862 and a tannery in 1865.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Preston%2C_Victoria",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Post‑war decades brought a wave of Macedonian immigrants, later joined by Asian refugees in the 1980s, shaping Preston’s multicultural identity.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Preston%2C_Victoria",
      "category": "people",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Historic cinema venues in Preston became community landmarks during the golden age of cinema.",
