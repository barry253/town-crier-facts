      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The log canoe Mystery, a 34‑foot vessel built in 1932, races on Chesapeake Bay and is listed on the National Register in 1985.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/kingstown_maryland",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Chester Hall, an 18th‑century farmstead built circa 1790, remains one of Kingstown's preserved agricultural landmarks.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/kingstown_maryland",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The community is largely residential, with 89% owner‑occupied homes and a median value of $282,500, attracting retirees and families.",
