  "facts": [
    {
      "id": 1,
      "text": "Langley sits in the foothills of the Ozark Mountains on the coast of Grand Lake o' the Cherokees.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Langley%2C_Oklahoma"
    },
    {
      "id": 2,
      "text": "The area encompassing present-day Langley was originally part of the Cherokee Nation's lands in Indian Territory.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/langley_oklahoma"
    },
    {
      "id": 3,
      "text": "Langley was named after Oklahoma State Senator Howard Langley, who later became the first chair of the Grand River Dam Authority.",
      "sourceSentenceIds": [
        3,
        6,
        7
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 2"
      ],
      "source": "https://en.wikipedia.org/wiki/Langley%2C_Oklahoma"
    },
    {
      "id": 4,
      "text": "Cliff Bogle established the town in 1937 by dividing his land into lots and holding a public drawing for free plots.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Langley%2C_Oklahoma"
    },
    {
      "id": 5,
      "text": "Construction of the Pensacola Dam began in 1938, changing Langley from a remote ferry site into a planned community.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/langley_oklahoma"
    },
    {
      "id": 6,
      "text": "Langley is bordered to the east by the Grand Lake o' the Cherokees, which is a reservoir on the Neosho River.",
      "sourceSentenceIds": [
        15
