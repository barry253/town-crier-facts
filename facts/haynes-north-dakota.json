  "facts": [
    {
      "id": 1,
      "text": "Haynes was founded as Gadsden in 1906 along the Milwaukee Road's transcontinental Pacific Extension rail line.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Haynes%2C_North_Dakota"
    },
    {
      "id": 2,
      "text": "In 1907 the town was renamed Haynes to honor George B. Haynes, president of the Milwaukee Road.",
      "sourceSentenceIds": [
        20,
        21
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Haynes%2C_North_Dakota"
    },
    {
      "id": 3,
      "text": "The 1980 abandonment of the Milwaukee Road line accelerated Haynes' decline, leaving the town largely deserted.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/haynes_north_dakota"
    },
    {
      "id": 4,
      "text": "Preservation is limited; the Ghosts of North Dakota project documents Haynes' abandoned sites, though it lacks a historic register listing.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/haynes_north_dakota"
    },
    {
      "id": 5,
      "text": "Haynes sits just north of the Grand River National Grassland, a vast prairie protected area.",
      "sourceSentenceIds": [
        22
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Haynes%2C_North_Dakota"
    },
    {
      "id": 6,
      "text": "During the early 1900s, Haynes became a key trade hub for farmers and workers in the surrounding homesteading boom.",
      "sourceSentenceIds": [
