  "facts": [
    {
      "id": 1,
      "text": "Honalo’s western edge is carved by dramatic coastal cliffs and wave‑cut benches that trace the shoreline’s ancient erosion.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/honalo_hawaii",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "When Captain James Cook anchored at Kealakekua Bay in January 1778, he marked the first documented encounter between Hawaiians and Europeans near Honalo.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/honalo_hawaii",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The Daifukuji Soto Zen Mission, built in 1921, stands as Honalo’s oldest surviving religious structure, reflecting early 20th‑century Japanese influence.",
      "sourceSentenceIds": [
        6,
        18
      ],
      "sourceLabels": [
        "Web source 2",
        "Wikipedia"
      ],
      "source": "https://kids.kiddle.co/Honalo,_Hawaii",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Honalo historically functioned as a traditional Hawaiian ahupuaʻa, a self‑sustaining land division that stretched from upland slopes to the sea.",
      "sourceSentenceIds": [
        20
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/honalo_hawaii",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "In the late 19th century, Japanese contract laborers who left sugar plantations settled in Honalo, turning the area into a coffee‑growing community.",
      "sourceSentenceIds": [
        21
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/honalo_hawaii",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Honalo’s fertile volcanic soils, primarily andisols derived from basalt, support its coffee farms by retaining moisture and nutrients over fragmented lava substrates.",
      "sourceSentenceIds": [
        27
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/honalo_hawaii",
      "category": "nature",
      "quality": "good"
