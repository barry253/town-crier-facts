    {
      "id": 1,
      "text": "Davenport grew around a spring that served as a rest stop for traders and settlers in the 1800s.",
      "sourceSentenceIds": [
        10,
        12
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Davenport%2C_Washington",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town was first called Cottonwood Springs before adopting the name Davenport when the settlement moved to higher ground in 1883.",
      "sourceSentenceIds": [
        14,
        15
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Davenport%2C_Washington",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "In 1889 the Northern Pacific Railway reached Davenport, turning it into a regional rail hub.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Davenport%2C_Washington",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The city became Lincoln County’s seat in 1896 after a vote that chose it over Sprague and Harrington.",
      "sourceSentenceIds": [
        16
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Davenport%2C_Washington",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Crystal Spring, which feeds Cottonwood Creek, sits near the town center and is a local landmark.",
      "sourceSentenceIds": [
        26
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Davenport%2C_Washington",
