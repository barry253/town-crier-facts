  "facts": [
    {
      "id": 1,
      "text": "Vienna Township was surveyed in 1798 by Uriel Holmes and the Connecticut Land Company, marking its first official layout.",
      "sourceSentenceIds": [
        20
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Vienna_Center%2C_Ohio",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "On June 20, 1810, a township green was laid out in what would become Vienna Center, later hosting key community buildings.",
      "sourceSentenceIds": [
        24
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Vienna_Center%2C_Ohio",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Vienna’s first church, the Congregational Church, was founded in 1805 by Thomas Robbins and later became Presbyterian in 1854.",
      "sourceSentenceIds": [
        22
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Vienna_Center%2C_Ohio",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The green now shelters Vienna Presbyterian Church, Vienna Methodist Church, the Copper Penny Masonic Lodge, and the Soldiers and Sailors Monument.",
      "sourceSentenceIds": [
        25
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Vienna_Center%2C_Ohio",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Vienna Academy, an early English school for boys, opened in 1825 on the green and served as a community meeting hall.",
      "sourceSentenceIds": [
        26
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Vienna_Center%2C_Ohio",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Between 1812 and the 1830s, Vienna’s clock makers—Lambert W., Thomas Lewis, Phineas Deming, and others—produced tall‑case wooden clocks powered by local streams.",
