  "facts": [
    {
      "id": 1,
      "text": "Jeffrey City began in 1931 as a modest ranching operation called Home on the Range.",
      "sourceSentenceIds": [
        5,
        7
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 2"
      ],
      "source": "https://en.wikipedia.org/wiki/Jeffrey_City%2C_Wyoming"
    },
    {
      "id": 2,
      "text": "The town was renamed Jeffrey City in 1957 as interest in local uranium deposits grew.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/Jeffrey_City,_Wyoming"
    },
    {
      "id": 3,
      "text": "During the Cold War, Jeffrey City flourished as a uranium mining hub with over 4,000 residents.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://unitedstatesghosttowns.com/jeffrey-city-wyoming-ghost-town/"
    },
    {
      "id": 4,
      "text": "At the height of the boom, the town built an Olympic-sized swimming pool and a separate high school.",
      "sourceSentenceIds": [
        19
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Jeffrey_City%2C_Wyoming"
    },
    {
      "id": 5,
      "text": "Jeffrey City became a ghost town after the mine shut down in 1982, causing most residents to leave.",
      "sourceSentenceIds": [
        23
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Jeffrey_City%2C_Wyoming"
    },
    {
      "id": 6,
      "text": "The Split Rock Bar and Cafe remains a community gathering place and historical landmark in Jeffrey City.",
