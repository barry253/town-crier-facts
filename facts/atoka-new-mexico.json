      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town sits in the San Juan Basin, surrounded by high desert and close to the UNESCO‑listed Chaco Culture National Historical Park.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Web source 2"
      ],
