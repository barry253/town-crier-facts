  "facts": [
    {
      "id": 1,
      "text": "Alakanuk was founded by Yup’ik shaman Anguksuar and his family, marking the first permanent settlement in the area.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Alakanuk%2C_Alaska"
    },
    {
      "id": 2,
      "text": "Alakanuk comes from Yup’ik meaning \"the wrong way\" or \"mistake village,\" a name locals embraced as a symbol of resilience.",
      "sourceSentenceIds": [
        15
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://thetundradrums.com/life-in-alakanuk-alaska/"
    },
    {
      "id": 3,
      "text": "In 1951, Catholic priest Segundo Llorente founded a permanent mission and built Alakanuk’s first church.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.kupi.com/en/explore/united-states/alakanuk/history"
    },
    {
      "id": 4,
      "text": "Before the mid‑20th century, residents built semi‑subterranean sod houses and driftwood‑turf shelters that kept heat in.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.kupi.com/en/explore/united-states/alakanuk/history"
    },
    {
      "id": 5,
      "text": "About 25 homes along the riverbank face erosion, a pressing challenge for Alakanuk’s future.",
      "sourceSentenceIds": [
        28
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Alakanuk%2C_Alaska"
    },
    {
      "id": 6,
      "text": "Despite isolation, Alakanuk balances subsistence living with modern amenities like piped water, broadband, and renewable energy.",
