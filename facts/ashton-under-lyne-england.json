  "facts": [
    {
      "id": 1,
      "text": "Ashton‑under‑Lyne evolved from a market town into a mill town during the Industrial Revolution, powered by canals and railways.",
      "sourceSentenceIds": [
        14
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Ashton-under-Lyne"
    },
    {
      "id": 2,
      "text": "The town’s 18th‑century boom was driven by rural migrants flocking to new cotton mills, mirroring regional industrial trends.",
      "sourceSentenceIds": [
        19
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Ashton-under-Lyne"
    },
    {
      "id": 3,
      "text": "West of town, Ashton Moss—a 107‑hectare peat bog—contains evidence of prehistoric activity.",
      "sourceSentenceIds": [
        18,
        27
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Ashton-under-Lyne"
    },
    {
      "id": 4,
      "text": "The Peak Forest Canal, constructed 1794‑1805, was originally planned as a branch of the Ashton Canal.",
      "sourceSentenceIds": [
        21
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Ashton-under-Lyne"
    },
    {
      "id": 5,
      "text": "In 1826, workers formed the Ashton Unity, a sickness and benefits society later renamed the Loyal Order of Ancient Shepherds.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Ashton-under-Lyne"
    },
    {
      "id": 6,
      "text": "From 1822 to 1831, the Christian Israelite Church headquartered its operations in Ashton‑under‑Lyne.",
      "sourceSentenceIds": [
