  "facts": [
    {
      "id": 1,
      "text": "Nisswa’s name comes from the Ojibwe word 'nessawae,' meaning 'in the middle,' a nod to its location between Clark, Nisswa, and Roy Lakes.",
      "sourceSentenceIds": [
        3,
        14
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Nisswa%2C_Minnesota",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Ernest Smiley set up a railroad stop and post office in 1898 on his homestead, now Poplar Avenue, sparking Nisswa’s early growth.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.cityofnisswa.gov/visitors/about_nisswa/index.php",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Nisswa officially became a municipality on December 4, 1946, marking its transition from a village to an incorporated city.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Nisswa%2C_Minnesota",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Nestled amid the Brainerd Lakes Area, Nisswa borders lakes such as Nisswa Lake, Roy Lake, and Gull Lake, offering abundant water recreation.",
