    {
      "id": 1,
      "text": "Charmwood was founded in 1853 by railroad engineer James Pugh Kirkwood as the first planned suburb west of the Mississippi.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://familydestinationsguide.com/missouri-hallmark-movie-town/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The 1893 Kirkwood Train Station, a red‑brick Romanesque landmark, still welcomes Amtrak travelers and sits on the National Register.",
      "sourceSentenceIds": [
        10,
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://familydestinationsguide.com/missouri-hallmark-movie-town/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Downtown Charmwood’s streets were laid out before automobiles, making walking the preferred way to explore the community.",
      "sourceSentenceIds": [
        21
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://familydestinationsguide.com/missouri-hallmark-movie-town/",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Brick facades line Charmwood’s streets, housing an eclectic mix of businesses that resist the homogenization seen elsewhere.",
      "sourceSentenceIds": [
        22
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://familydestinationsguide.com/missouri-hallmark-movie-town/",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Historic Charmwood buildings are not museums; they pulse with contemporary life, hosting businesses that honor their architectural legacy.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://familydestinationsguide.com/missouri-hallmark-movie-town/",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Charmwood lies directly adjacent to the neighboring town of Stanton and shares a close community bond.",
