  "facts": [
    {
      "id": 1,
      "text": "Princeville was originally called Cornwell, then Monica, before settling on its current name in the mid‑1800s.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://peoria.illinoisgenweb.org/town-hist/princeville.html"
    },
    {
      "id": 2,
      "text": "The village sits on the historic Peoria and Rock Island railroad, just twenty‑two miles north of Peoria.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://peoria.illinoisgenweb.org/town-hist/princeville.html"
    },
    {
      "id": 3,
      "text": "A gazebo in downtown Princeville echoes a 1910 bandstand, preserving a piece of early 20th‑century civic life.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://princeville.org/parks-recreation-tourism/"
    },
    {
      "id": 4,
      "text": "The Princeville Heritage Museum spans 30,000 square feet, showcasing local artifacts, antique farm equipment, and a genealogy research area.",
      "sourceSentenceIds": [
        29
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://princeville.org/parks-recreation-tourism/"
    },
    {
      "id": 5,
      "text": "The Akron Townhouse School lets visitors step back into the early 1900s, experiencing a day in a historic classroom.",
      "sourceSentenceIds": [
        30
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://princeville.org/parks-recreation-tourism/"
    },
    {
      "id": 6,
      "text": "Princeville’s layout places it on section 13 of Princeville township, a detail noted in early county histories.",
