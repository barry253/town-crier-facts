  "facts": [
    {
      "id": 1,
      "text": "The borough’s name, inspired by the 1847 Battle of Buena Vista during the Mexican‑American War, reflects its connection to American history.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 1"
      ],
