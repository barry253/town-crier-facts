  "facts": [
    {
      "id": 1,
      "text": "Skamokawa Valley takes its name from Chief Skamokawa, a Wahkiakum leader who met Lewis and Clark during their 1805–06 winter at Fort Clatsop.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Skamokawa_Valley%2C_Washington",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The word Skamokawa means “smoke over the water” in Chinook, a nod to the valley’s frequent foggy mornings.",
      "sourceSentenceIds": [
        11
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Skamokawa_Valley%2C_Washington",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Lewis and Clark camped at what is now Vista Park in Skamokawa, trading with local tribes before heading north.",
      "sourceSentenceIds": [
        28
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.co.wahkiakum.wa.us/389/Wahkiakum-County",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The Skamokawa River Life Center, housed in the historic Central Schoolhouse, showcases photographs and displays that trace the valley’s river‑based heritage.",
      "sourceSentenceIds": [
        1,
        5
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.lewisandclark.travel/listing/skamokawa-river-life-center/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Wahkiakum County, where Skamokawa Valley sits, is Washington’s third‑smallest county, created in 1854 by the territorial legislature.",
      "sourceSentenceIds": [
        4
      ],
