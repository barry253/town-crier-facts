  "facts": [
    {
      "id": 1,
      "text": "Bourbonnais, Illinois, takes its name from François Jace Bourbonnais père, a fur trapper who settled near the Kankakee River around 1830.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Bourbonnais%2C_Illinois"
    },
    {
      "id": 2,
      "text": "The Pottawatomie called the area 'Te-yar-ac-ke,' meaning 'wonderful land,' before French settlers arrived.",
      "sourceSentenceIds": [
        11
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.villageofbourbonnais.com/visitors/history/"
    },
    {
      "id": 3,
      "text": "When the Illinois Central Railroad arrived in the 1850s, it rewired Bourbonnais, turning it into a regional rail hub.",
      "sourceSentenceIds": [
        13
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.bradleyillinois.com/towns/bourbonnais.html"
    },
    {
      "id": 4,
      "text": "In 1853, Illinois split Iroquois County, and Bourbonnais Grove joined the newly formed Kankakee County.",
      "sourceSentenceIds": [
        26
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Bourbonnais%2C_Illinois"
    },
    {
      "id": 5,
      "text": "A 1875 referendum saw Bourbonnais officially incorporate as a village, solidifying its municipal status.",
