  "facts": [
    {
      "id": 1,
      "text": "Ouzinkie was founded in the early 1800s by the Russian-American Company as a retirement community for Russian settlers.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.kupi.com/en/explore/united-states/ouzinkie"
    },
    {
      "id": 2,
      "text": "The village sits on Spruce Island, where Saint Herman of Alaska first settled in 1808, laying a spiritual foundation for the community.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.kupi.com/en/explore/united-states/ouzinkie/history"
    },
    {
      "id": 3,
      "text": "Ouzinkie's harbor, protected from storms, made it an ideal docking spot for small vessels, influencing its early growth.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.kupi.com/en/explore/united-states/ouzinkie/history"
    },
    {
      "id": 4,
      "text": "The Nativity of Our Lord Russian Orthodox Church, built in 1890, now stands as a national historic monument with its iconic onion domes.",
      "sourceSentenceIds": [
        7,
        12
      ],
      "sourceLabels": [
        "Web source 1",
        "Web source 2"
      ],
      "source": "https://www.kupi.com/en/explore/united-states/ouzinkie/history"
    },
    {
      "id": 5,
      "text": "Ouzinkie's cultural fabric blends Native Alutiiq traditions with Russian influences, reflected in everyday life and architecture.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.kupi.com/en/explore/united-states/ouzinkie"
    },
    {
      "id": 6,
      "text": "The hamlet's name appears in both Alutiiq (Uusenkaaq) and Russian (Узинки), highlighting its bilingual heritage.",
