      "quality": "good"
    },
    {
      "id": 2,
      "text": "South Bound Brook, New Jersey, was originally formed as a town within Franklin Township before being incorporated as a borough in 1907.",
      "sourceSentenceIds": [
        2,
        30
      ],
      "sourceLabels": [
        "Wikipedia"
