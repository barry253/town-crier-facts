  "facts": [
    {
      "id": 1,
      "text": "West Stockbridge grew around five villages, with the railroad turning it into the largest due to iron ore and marble transport.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/West_Stockbridge%2C_Massachusetts",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town’s ironworks in Williamsville, founded by Colonel Elijah Williams, left only a furnace smokestack as a relic.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/West_Stockbridge%2C_Massachusetts",
      "category": "landmark",
      "quality": "poor",
      "qualityReason": "vague"
    },
    {
      "id": 3,
      "text": "The historic Red Lion Inn, founded in 1773, once served as a stagecoach stop and pre‑Revolutionary meeting place.",
      "sourceSentenceIds": [
        5,
        7
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://stockbridgechamber.org/visit/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The Mission House, originally on Eden Hill, was moved to Main Street in the 1920s, restored, and opened as a museum in 1930.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://stockbridgechamber.org/visit/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "West Stockbridge’s 1862 Cat and Dog Fountain sits in the triangular park at the crossroads, a public landmark.",
      "sourceSentenceIds": [
        14
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://stockbridgechamber.org/visit/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The town hosts an annual holiday celebration each December, featuring a historic property tour, concert, and Main Street recreation with vintage automobiles.",
