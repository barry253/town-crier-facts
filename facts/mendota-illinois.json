  "facts": [
    {
      "id": 1,
      "text": "Mendota's Union Depot Railroad Museum houses the current Amtrak station and vintage railroad artifacts, including 1930s-40s passenger cars.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Mendota%2C_Illinois",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The Hume-Carnegie Museum, built in 1904 with Andrew Carnegie funds, now displays photographs and documents tracing Mendota’s history.",
      "sourceSentenceIds": [
        10,
        11
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://mendotamuseums.org/museums/hume-carnegie-museum/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Mendota’s original Carnegie library opened in 1905, replacing an 1874 library, and the current Amtrak station sits in a former library building in Veteran's Park.",
      "sourceSentenceIds": [
        13,
        14,
        18
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Mendota%2C_Illinois",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Three Amtrak trains—Illinois Zephyr, Carl Sandburg, and Southwest Chief—stop daily at Mendota, connecting Chicago to Quincy, Kansas City, and Los Angeles.",
      "sourceSentenceIds": [
