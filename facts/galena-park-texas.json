  "facts": [
    {
      "id": 1,
      "text": "Galena Park began as the settlement of Clinton in 1835, founded by Isaac Batterson after buying 1,000 acres from Ezekiel Thomas.",
      "sourceSentenceIds": [
        2,
        3,
        24,
        25,
        26
      ],
      "sourceLabels": [
        "Web source 1",
        "Web source 2"
      ],
      "source": "https://www.cityofgalenapark-tx.gov/2167/History",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "In 1836, General Sam Houston used the floor of Batterson's house to build rafts that ferried his army across Buffalo Bayou.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.cityofgalenapark-tx.gov/2167/History",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The city was incorporated on September 21, 1935, just east of Houston on the north bank of the Houston Ship Channel.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.cityofgalenapark-tx.gov/2167/History",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "By the early 1880s, cotton warehouses and compresses lined the bayou and railroad, turning Clinton into a bustling shipping center.",
      "sourceSentenceIds": [
        11
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.tshaonline.org/handbook/entries/galena-park-tx",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The name changed to Galena Park after the Galena Signal Oil Company built the first refinery there, marking a shift to petrochemical industry in the early 1900s.",
      "sourceSentenceIds": [
        27,
        29
      ],
