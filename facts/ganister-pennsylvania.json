  "facts": [
    {
      "id": 1,
      "text": "Ganister’s earliest name was Franklin Forge, founded by Samuel Royer in 1829 at the confluence of Piney Creek and the Juniata River.",
      "sourceSentenceIds": [
        1,
        2,
        3
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://ganisterpa.com/history/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "In 1843, Samuel Royer sold Franklin Forge to Elias Hoover and Daniel H., marking a shift in the local iron industry.",
      "sourceSentenceIds": [
        24
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://ganisterpa.com/history/",
      "category": "history",
      "quality": "poor",
      "qualityReason": "dropped_surname_no_wiki_source"
    },
    {
      "id": 3,
      "text": "The town’s single‑room brick schoolhouse opened in 1895, described as “substantial and complete” in a 1896 New York Times article.",
      "sourceSentenceIds": [
        26,
        27
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://ganisterpa.com/history/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The Pittsburgh Limestone Company began quarrying in Ganister in 1896, establishing the area’s limestone industry.",
      "sourceSentenceIds": [
        30
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://ganisterpa.com/history/",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Ganister sits in Woodbury Township, bordered by the Frankstown Branch Juniata River to the north and Piney Creek to the west.",
      "sourceSentenceIds": [
        10,
        11
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Ganister%2C_Pennsylvania",
      "category": "other",
      "quality": "poor",
      "qualityReason": "location_description"
    },
    {
      "id": 6,
      "text": "Pennsylvania Route 866 traces Ganister’s northeastern edge, leading two miles southeast to Williamsburg and two miles northwest to U.S. Route 22.",
