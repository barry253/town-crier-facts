  "facts": [
    {
      "id": 1,
      "text": "Chester Hill was incorporated as a borough in 1883, named after Judge Chester Munson, a local judge from the 1840s.",
      "sourceSentenceIds": [
        30
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/chester_hill_pennsylvania",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town grew around lumber, coal, and refractory brick production, with the Harbison‑Walker Refractories Company becoming the main employer by 1911.",
      "sourceSentenceIds": [
        4,
        5
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/chester_hill_pennsylvania",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Railroads drove early growth: the Altoona & Philipsburg Connecting Railroad and a New York Central branch linked Chester Hill to regional markets until the mid‑20th century.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/chester_hill_pennsylvania",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The community sits on the western bank of Moshannon Creek, which forms the boundary with Centre County and separates it from Philipsburg.",
      "sourceSentenceIds": [
        10,
        19
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Chester_Hill%2C_Pennsylvania",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "In the 1840s, lumberman Steiner bought timberland from the Hardman Philips estate and built the first sawmill, sparking settlement.",
      "sourceSentenceIds": [
        23,
        24
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/chester_hill_pennsylvania",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Today, Chester Hill’s workforce is largely in health care, food services, and retail, reflecting a shift from its industrial roots.",
      "sourceSentenceIds": [
        21
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/chester_hill_pennsylvania",
      "category": "economy",
      "quality": "good"
    }
