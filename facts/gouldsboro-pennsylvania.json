    {
      "id": 1,
      "text": "Gouldsboro was named after financier Jay Gould, who built a tannery in the area before rising to national prominence.",
      "sourceSentenceIds": [
        1,
        2,
        4
      ],
      "sourceLabels": [
        "Web source 1",
        "Wikipedia",
        "Web source 2"
      ],
      "source": "https://monroecountypa.com/communities/gouldsboro",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The former Lackawanna Railroad station now houses a museum and welcomes excursion trains from Steamtown National Historic Site.",
      "sourceSentenceIds": [
        3,
        5
      ],
      "sourceLabels": [
        "Web source 1",
        "Wikipedia"
      ],
      "source": "https://monroecountypa.com/communities/gouldsboro",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Nestled in the northern Pocono Mountains, Gouldsboro sits at about 1,900 feet, offering crisp mountain air and scenic views.",
      "sourceSentenceIds": [
        19,
        20,
        27
      ],
      "sourceLabels": [
        "Web source 1",
        "Web source 1",
        "Web source 2"
      ],
      "source": "https://monroecountypa.com/communities/gouldsboro",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Surrounded by forests, lakes such as Gouldsboro Lake and Lake Watawga, and the Lehigh River, the area feels like a natural retreat.",
      "sourceSentenceIds": [
        26,
        27
      ],
      "sourceLabels": [
        "Web source 2",
        "Web source 2"
      ],
      "source": "https://waynecountypa.net/gouldsboro",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The Gouldsboro Historical Society preserves local heritage, operating a museum and organizing events like Memorial Day parades and historical reenactments.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://monroecountypa.com/communities/gouldsboro",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Year‑round homes and vacation properties, many tucked into wooded lots, give Gouldsboro its mix of quiet living and weekend getaway appeal.",
