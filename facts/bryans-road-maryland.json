  "facts": [
    {
      "id": 1,
      "text": "Bryans Road takes its name from 19th‑century farmer Oliver Norris Bryan, who ran Locust Grove Farm near Marshall Hall.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Bryans_Road%2C_Maryland",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Until the 1890s, the area was dominated by tobacco farms, until the Naval Proving Grounds at Indian Head opened.",
      "sourceSentenceIds": [
        15
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Bryans_Road%2C_Maryland",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Bryans Road evolved into a bedroom community for Indian Head and Washington, D.C., by the early 1960s.",
      "sourceSentenceIds": [
        16
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Bryans_Road%2C_Maryland",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Mount Aventine, once the Pomonkey plantation house, is listed on the National Register of Historic Places and now serves as a historic park landmark.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.academia.edu/144346835/A_Black_and_Indigenous_History_of_Bryans_Road_Pomonkey_and_Indian_Head",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The 2023 SubArea Plan officially recognizes Mount Aventine Mansion as a key cultural resource shaping Bryans Road’s identity.",
