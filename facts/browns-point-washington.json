  "facts": [
    {
      "id": 1,
      "text": "Browns Point was originally called Point Harris after sailmaker Alvin Harris of the Wilkes Expedition, but residents renamed it for an early landowner.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Browns_Point%2C_Washington",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The Browns Point Lighthouse, first lit on December 12, 1887, was once fully staffed but is now fully automated.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Browns_Point%2C_Washington",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The local Browns Point Improvement Club owns much of the land beside the lighthouse and is famous for its annual Browns Point Salmon Bake.",
      "sourceSentenceIds": [
        11,
        12
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Browns_Point%2C_Washington",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The Salmon Bake began in the 1940s, founded by pioneer Jerry Meeker, and is held every even‑numbered year during the first weekend of August.",
      "sourceSentenceIds": [
        13
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Browns_Point%2C_Washington",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Browns Point’s community is served by Browns Point Elementary, Meeker Middle, and Stadium High School.",
      "sourceSentenceIds": [
        14
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Browns_Point%2C_Washington",
      "category": "other",
      "quality": "poor",
      "qualityReason": "editorial_filler"
    },
    {
      "id": 6,
      "text": "The Points Northeast Historical Society preserves the area’s heritage and hosts events such as the 1986 Seattle Times feature on the lighthouse’s history.",
