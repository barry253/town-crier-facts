  "facts": [
    {
      "id": 1,
      "text": "Tiburon’s name comes from Mexican land grant “Punta del Tiburón,” meaning Shark Point.",
      "sourceSentenceIds": [
        9,
        10
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.townoftiburon.org/594/Tiburon-History",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town began as a railroad hub in the 1880s when the San Francisco and North Pacific Railroad extended to the peninsula.",
      "sourceSentenceIds": [
        8,
        24
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.marincountyvisitor.com/places-to-go/tiburon-belvedere/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The original St. Joseph church, later deconsecrated, was saved by the Landmarks Society in 1959 and now houses a museum.",
      "sourceSentenceIds": [
        5,
        6
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Tiburon%2C_California",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Hilary’s, a hillside landmark, was once a mission church and now serves as a historic site with a wildflower preserve.",
      "sourceSentenceIds": [
        1,
        6
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Tiburon%2C_California",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The Immigration Station museum chronicles thousands of immigrants passing through Tiburon between 1910 and 1940.",
      "sourceSentenceIds": [
        15
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.marincountyvisitor.com/places-to-go/tiburon-belvedere/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Famous residents include actors Clint Eastwood and Robin Williams, who both lived in Tiburon during the 1970s.",
