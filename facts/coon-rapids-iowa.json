    {
      "id": 1,
      "text": "Coon Rapids was founded in 1863 by Carrollton residents Crocket Ribble and Jacob Cretsinger, who built a saw and gristmill along the Middle Raccoon River.",
      "sourceSentenceIds": [
        5,
        16
      ],
      "sourceLabels": [
        "Web source 1",
        "Wikipedia"
      ],
      "source": "https://www.coonrapids.lib.ia.us/about/city-history",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The post office named Coon Rapids soon became a stop for stagecoach service to Sioux City.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Coon_Rapids%2C_Iowa",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The arrival of the railroad in the 1880s brought jobs and an economic boom, prompting merchants to relocate their buildings into the newly platted town.",
      "sourceSentenceIds": [
        7,
        8
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Coon_Rapids%2C_Iowa",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Coon Rapids hosted a high‑profile stop on Nikita Khrushchev's 1959 U.S. tour, drawing more than 400 journalists to the town.",
      "sourceSentenceIds": [
        11
      ],
      "sourceLabels": [
        "Web source 1"
