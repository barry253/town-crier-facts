  "facts": [
    {
      "id": 1,
      "text": "Medina’s name came from a group of women who suggested the Arabic word “Medina” in 1891 after Dabney’s Landing was briefly called Flordeline.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Medina%2C_Washington",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "In the 1870s and 1880s settlers cleared dense forests on the Lake Washington peninsula, turning the area into berry farms and strawberry orchards.",
      "sourceSentenceIds": [
        6,
        7
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/Medina,_Washington",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Thomas Dabney built a ferry dock in 1890, and the surrounding land quickly became a hub for berry farms and fruit orchards.",
      "sourceSentenceIds": [
        13,
        14
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Medina%2C_Washington",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Since 2006, Medina has been a Tree City USA, protecting large trees with one of the region’s most extensive tree codes.",
      "sourceSentenceIds": [
