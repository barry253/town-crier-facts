  "facts": [
    {
      "id": 1,
      "text": "Fall River was founded in 1879 by settlers drawn to fertile land and abundant water along the riverbanks.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/fall_river_kansas"
    },
    {
      "id": 2,
      "text": "The town’s name honors the nearby Fall River, whose picturesque falls inspired early mills and attracted settlers.",
      "sourceSentenceIds": [
        2,
        6,
        7
      ],
      "sourceLabels": [
        "Web source 2",
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/fall_river_kansas"
    },
    {
      "id": 3,
      "text": "George Bulkley, a key promoter, chose the site during a railroad survey and helped launch the town’s first development.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/fall_river_kansas"
    },
    {
      "id": 4,
      "text": "Fall River was incorporated on November 1, 1879, officially becoming a city in Greenwood County.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/fall_river_kansas"
    },
    {
      "id": 5,
      "text": "Early settlers in the mid‑19th century were pro‑slavery migrants from Mississippi, but permanent growth accelerated after the town’s platting in 1879.",
