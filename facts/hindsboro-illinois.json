      "category": "culture",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The town’s name honors its early settlers, whose deep roots and shared history give Hindsboro a uniquely neighborly spirit.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.wikixm.com/us/il/hindsboro/overview",
      "category": "other",
      "quality": "poor",
      "qualityReason": "other"
    },
    {
