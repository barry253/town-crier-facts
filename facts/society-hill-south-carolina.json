  "facts": [
    {
      "id": 1,
      "text": "Society Hill was founded in 1736 by Welsh Baptist settlers arriving from Pennsylvania and Delaware along the Pee Dee River.",
      "sourceSentenceIds": [
        16,
        26
      ],
      "sourceLabels": [
        "Web source 2",
        "Wikipedia"
      ],
      "source": "https://grokipedia.com/page/society_hill_south_carolina"
    },
    {
      "id": 2,
      "text": "Society Hill is the oldest community in Darlington County and one of the first towns founded in South Carolina.",
      "sourceSentenceIds": [
        3,
        27
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Society_Hill%2C_South_Carolina"
    },
    {
      "id": 3,
      "text": "The town was renamed Society Hill in honor of David's Society, a group of local planters formed in 1777 to promote education.",
      "sourceSentenceIds": [
        5,
        8
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/society_hill_south_carolina"
    },
    {
      "id": 4,
      "text": "Society Hill once served as the intellectual and cultural center of the Pee Dee region during the 18th and early 19th centuries.",
      "sourceSentenceIds": [
        2,
        23,
        28
      ],
      "sourceLabels": [
        "Web source 1",
        "Wikipedia"
      ],
      "source": "https://www.sciway.net/city/societyhill.html"
    },
    {
      "id": 5,
      "text": "The original library in Society Hill, built in 1812, is the second oldest lending library in South Carolina.",
      "sourceSentenceIds": [
        18
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Society_Hill%2C_South_Carolina"
    },
    {
      "id": 6,
      "text": "Society Hill began to decline in the 19th century as rivers became less important as a means of transportation.",
      "sourceSentenceIds": [
