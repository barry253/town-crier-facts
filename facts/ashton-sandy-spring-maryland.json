  "facts": [
    {
      "id": 1,
      "text": "Thanks to a 2019 anonymous donation, the Sandy Spring Museum’s historic archives were digitized and are now freely accessible online.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.sandyspringmuseum.org/a-center-for-cultural-heritage/we-inspire/digital-archives",
      "category": "other",
      "quality": "poor",
      "qualityReason": "editorial_filler"
    },
    {
      "id": 2,
      "text": "Volunteers can now crowd‑source transcriptions of historic documents, uncovering the daily lives of Sandy Spring’s long‑lost residents.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.sandyspringmuseum.org/a-center-for-cultural-heritage/we-inspire/digital-archives",
      "category": "other",
      "quality": "poor",
      "qualityReason": "editorial_filler"
    },
    {
      "id": 3,
      "text": "The museum’s digital collection spans over 190 years of diary entries, 630 personal letters, and half a century of 19th‑century general‑store purchases.",
      "sourceSentenceIds": [
        17
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.sandyspringmuseum.org/a-center-for-cultural-heritage/we-inspire/digital-archives",
      "category": "other",
      "quality": "poor",
      "qualityReason": "editorial_filler"
    },
    {
      "id": 4,
      "text": "Equity in Metadata is a museum initiative that corrects past racially skewed cataloging and brings Black men and women stories to light.",
      "sourceSentenceIds": [
        19
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.sandyspringmuseum.org/a-center-for-cultural-heritage/we-inspire/digital-archives",
      "category": "other",
      "quality": "poor",
      "qualityReason": "editorial_filler"
    },
    {
      "id": 5,
      "text": "Ashton and Sandy Spring are neighboring rural‑suburban communities in eastern Montgomery County, Maryland.",
      "sourceSentenceIds": [
        20
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://montgomeryplanning.org/planning/communities/east-county/sandy-spring-ashton/",
      "category": "other",
      "quality": "poor",
      "qualityReason": "location_description"
    },
    {
