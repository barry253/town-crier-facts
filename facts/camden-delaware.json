      ],
      "source": "https://secretsofphiladelphia.com/2024/10/31/history-along-the-delaware-camden-a-city-through-time/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The Camden‑Wyoming Sewer & Water Authority provides water and sewer services to both Camden and neighboring Wyoming.",
