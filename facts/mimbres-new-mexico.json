  "facts": [
    {
      "id": 1,
      "text": "Mimbres was named after the nearby Mimbres River, a tributary that shaped the valley’s early settlements.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Mimbres%2C_New_Mexico",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The Mimbres people, a subgroup of the Mogollon, are famed for their black‑on‑white pottery, the most distinctive prehistoric ceramics in North America.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://camnnation.org/history/mimbres-culture-heritage-site/",
      "category": "people",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Deming’s first car, the “Rio,” marks the beginning of the town’s transportation history showcased in the local museum’s vintage car exhibit.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://demingmuseum.com/",
      "category": "transport",
      "quality": "poor",
      "qualityReason": "route_only"
    },
    {
      "id": 4,
      "text": "The historic 1916 National Guard Armory houses the Deming Luna Mimbres Museum, where visitors can walk through recreated ranch scenes and early 20th‑century Main Street.",
      "sourceSentenceIds": [
        7,
        14
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://demingmuseum.com/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "A neon sign from the White House Café, once a downtown landmark, is being restored in Deming after a private collector donated it from Minnesota.",
      "sourceSentenceIds": [
        25,
        29,
        30
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://demingmuseum.com/",
      "category": "landmark",
      "quality": "good"
    },
    {
