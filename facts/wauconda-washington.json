      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Wauconda%2C_Washington",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "At its peak, Wauconda supported roughly 1,000 residents and operated a 60‑ton stamp mill with more than 2,000 feet of tunnels.",
      "sourceSentenceIds": [
        27,
        12
      ],
      "sourceLabels": [
