    {
      "id": 1,
      "text": "Crestone sits at the foot of the western slope of the Sangre de Cristo Range, near 14,000‑foot peaks Crestone Peak and Crestone Needle.",
      "sourceSentenceIds": [
        1,
        17
      ],
      "sourceLabels": [
