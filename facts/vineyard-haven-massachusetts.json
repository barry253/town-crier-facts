    {
      "id": 1,
      "text": "Vineyard Haven began as the Wampanoag village of Nobnocket, later called Homes Hole, then Holmes Hole, before adopting its current name in 1871.",
      "sourceSentenceIds": [
        17,
        18,
        19
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Vineyard_Haven%2C_Massachusetts",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The Steamship Authority wharf in Vineyard Haven serves as the island’s main port, docking daily ferries that bring visitors year‑round.",
      "sourceSentenceIds": [
        7,
        10,
        11
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Vineyard_Haven%2C_Massachusetts",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The Martha’s Vineyard Museum, housed in a single building, showcases island history, lighthouse lore, maritime dangers, and Wampanoag culture.",
      "sourceSentenceIds": [
        4,
        5,
        6
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Vineyard_Haven%2C_Massachusetts",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The Martha’s Vineyard Regional Transit Authority runs buses from Vineyard Haven’s Steamship Authority terminal, making island travel easy once you dock.",
      "sourceSentenceIds": [
        8,
        9,
        12
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Vineyard_Haven%2C_Massachusetts",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The MV Film Society screens independent films, classics, documentaries, and world cinema for all ages, offering a rainy‑day cultural fix.",
