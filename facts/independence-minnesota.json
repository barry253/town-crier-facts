  "facts": [
    {
      "id": 1,
      "text": "Independence’s land was first used by Dakota Sioux hunters who relied on its woodlands, lakes, and streams before European settlers arrived.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/independence_minnesota",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town takes its name from Lake Independence, a sizable lake that borders the community on its eastern edge.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Independence%2C_Minnesota",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Settlers organized Independence Township in 1858 after the 1851 Treaty of Traverse des Sioux, which opened the area to settlement.",
      "sourceSentenceIds": [
        3,
        7
      ],
      "sourceLabels": [
        "Web source 1",
        "Wikipedia"
      ],
      "source": "https://grokipedia.com/page/independence_minnesota",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Independence Township became the Village of Independence in 1957 and later the City of Independence in 1974.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Independence%2C_Minnesota",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The city’s landscape is dominated by farmland, dense forests, and a network of lakes that dot the countryside.",
