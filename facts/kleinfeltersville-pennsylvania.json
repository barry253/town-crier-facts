      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Rev. Kleinfelter founded the village in 1824 after buying a 200‑acre farm from his father‑in‑law.",
      "sourceSentenceIds": [
        29,
        4
      ],
      "sourceLabels": [
        "Wikipedia",
