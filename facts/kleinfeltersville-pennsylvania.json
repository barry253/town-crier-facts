      ],
      "source": "https://en.wikipedia.org/wiki/Kleinfeltersville%2C_Pennsylvania",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Jacob Albright, founder of the Evangelical Association, is buried at Albright Memorial Church in Kleinfeltersville.",
      "sourceSentenceIds": [
        25,
