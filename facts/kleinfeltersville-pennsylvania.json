      ],
      "source": "https://en.wikipedia.org/wiki/Kleinfeltersville%2C_Pennsylvania",
      "category": "other",
      "quality": "poor",
      "qualityReason": "other"
    },
    {
      "id": 5,
      "text": "The original hotel burned in 2015 and was replaced by a modern restaurant, preserving the town’s hospitality legacy.",
      "sourceSentenceIds": [
        22,
