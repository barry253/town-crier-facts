      ],
      "source": "https://en.wikipedia.org/wiki/Kleinfeltersville%2C_Pennsylvania",
      "category": "people",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Kleinfeltersville’s name is one of the longest single‑word place names in the U.S., tying with Maine’s Mooselookmeguntic.",
      "sourceSentenceIds": [
        16,
        18
      ],
      "sourceLabels": [
