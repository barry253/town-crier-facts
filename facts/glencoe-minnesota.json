  "facts": [
    {
      "id": 1,
      "text": "Glencoe was laid out in 1855 and named after Glen Coe in Scotland.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Glencoe%2C_Minnesota",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Settlers erected a log schoolhouse in 1856, just a year after Glencoe was founded, to welcome eager children.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://historyofglencoe.blogspot.com/p/glencoe-mn.html",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The town was planned by the railroad, and a nearby gas boom later attracted factories to Glencoe.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://hometownhistorymaps.com/pages/history-of-glencoe-minnesota",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Glencoe serves as the county seat of McLeod County, making it the administrative hub for the region.",
      "sourceSentenceIds": [
        26
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Glencoe%2C_Minnesota",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Historic Sanborn Fire Insurance Maps from 1893 to 1914 capture Glencoe’s downtown layout, showing businesses and schools.",
      "sourceSentenceIds": [
        11
      ],
      "sourceLabels": [
