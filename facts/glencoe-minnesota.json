      ],
      "source": "https://hometownhistorymaps.com/pages/history-of-glencoe-minnesota",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "A post office has operated in Glencoe continuously since 1856, serving residents for over a century and a half.",
