  "facts": [
    {
      "id": 1,
      "text": "Teutopolis, nicknamed \"City of the Teutons,\" was founded in 1839 along the National Road, now U.S. Route 40.",
      "sourceSentenceIds": [
        13
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Teutopolis%2C_Illinois",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "In 1837, a land company called Deutsche Land-Compagnie purchased 10,000 acres at $1.25 per acre, laying the town’s foundation.",
      "sourceSentenceIds": [
        18,
        24
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Teutopolis%2C_Illinois",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The town plan mirrored Cincinnati’s plat, and each $50 contribution earned a garden lot plus extra farmland, totaling 40 acres.",
      "sourceSentenceIds": [
        26,
        28
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Teutopolis%2C_Illinois",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "During World War I, a plain‑clothes agent was stationed in Teutopolis to monitor suspected German sympathizers in what was deemed the most pro‑German town in Illinois.",
      "sourceSentenceIds": [
        11
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://teutopolis.com/our-community/teutopolis-history/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "A 1924 branch of the Cleaver Glove Company opened in Teutopolis, marking the village’s early industrial diversification.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 1"
      ],
