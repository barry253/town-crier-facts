  "facts": [
    {
      "id": 1,
      "text": "Meire Grove was founded around 1858 and became an incorporated village on December 24, 1896, with a post office operating from 1873 to 1905.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.lakesnwoods.com/MeireGrove.htm",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town’s name originated from a misspelling in the 1850s, swapping the ‘y’ for an ‘i’ and adding a ‘re’ that was common in that era.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://wjon.com/meire-grove-history/",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Meire Grove never received a railroad because residents opposed it, a decision that, according to locals, could have added roughly 200 more residents.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://wjon.com/meire-grove-history/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The Meire Grove Band, founded in 1883, is Minnesota’s oldest continuously operating town band, performing several concerts and parades each year.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://wjon.com/meire-grove-history/",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "John the Baptist Catholic Church, established in the 1800s, remains a landmark of Meire Grove’s early religious community.",
      "sourceSentenceIds": [
        28
      ],
      "sourceLabels": [
        "Web source 1"
      ],
