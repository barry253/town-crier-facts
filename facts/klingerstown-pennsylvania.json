  "facts": [
    {
      "id": 1,
      "text": "Klingerstown takes its name from the Klinger family, German settlers Johann Peter Klinger and Catharina Steinbruch, who arrived in the late 1700s.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/klingerstown_pennsylvania"
    },
    {
      "id": 2,
      "text": "The town’s historic Klinger's Church, a union Lutheran‑Reformed congregation, was first built in 1800 and rebuilt in 1894 after the original was razed.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/klingerstown_pennsylvania"
    },
    {
      "id": 3,
      "text": "Klingerstown sits in the Mahantango Valley at 40°39′35″N 76°41′29″W, about 500 feet above sea level.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/klingerstown_pennsylvania"
    },
    {
      "id": 4,
      "text": "Locals call the town “Spread Eagle” after a giant sycamore on Pine Creek carved with an eagle by Native Americans, a landmark until the 1870s.",
      "sourceSentenceIds": [
        11,
        12
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/klingerstown_pennsylvania"
    },
    {
      "id": 5,
      "text": "Each year Klingerstown celebrates with a Fireman’s Parade and Carnival, plus a fishing rodeo that draws regional enthusiasts.",
      "sourceSentenceIds": [
        24
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Klingerstown%2C_Pennsylvania"
    },
    {
      "id": 6,
      "text": "Michael’s Lutheran Church, a cornerstone of the community, recently organized volunteers to repaint houses throughout Klingerstown.",
