  "facts": [
    {
      "id": 1,
      "text": "Downieville-Lawson-Dumont grew from 1859 placer gold finds in Clear Creek Canyon, sparking rapid settlement during Colorado Gold Rush.",
      "sourceSentenceIds": [
        8,
        9
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/downieville_lawson_dumont_colorado"
    },
    {
      "id": 2,
      "text": "Dumont, originally Mill City, was renamed in 1880 to honor Colonel John M.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/downieville_lawson_dumont_colorado"
    },
    {
      "id": 3,
      "text": "The Mill Creek Valley Historical Society, founded by Dumont residents in 1981, preserves historic sites like the 1860 Mill City House.",
      "sourceSentenceIds": [
        1,
        10
      ],
      "sourceLabels": [
        "Web source 2",
        "Web source 1"
      ],
      "source": "https://mcvhs.org/"
    },
    {
      "id": 4,
      "text": "Lawson was founded in 1877 as Free America at the foot of Red Elephant Mountain, where mining claims spurred a post office that same year.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/downieville_lawson_dumont_colorado"
    },
    {
      "id": 5,
      "text": "Dumont once supported about 100 residents, two hotels, a school, and a general store, reflecting its early mining boom.",
      "sourceSentenceIds": [
        25
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/downieville_lawson_dumont_colorado"
    },
    {
      "id": 6,
      "text": "The 1900s saw Dumont gain a railroad depot, joining Clear Creek County’s network of historic train stations.",
      "sourceSentenceIds": [
        13
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://mcvhs.org/"
    }
  ]
