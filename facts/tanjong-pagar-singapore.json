      "quality": "good"
    },
    {
      "id": 3,
      "text": "Tanjong Pagar began as a quiet fishing village in the early 19th century before becoming a bustling commercial hub.",
      "sourceSentenceIds": [
        11
      ],
      "sourceLabels": [
