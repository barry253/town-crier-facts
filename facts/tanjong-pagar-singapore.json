      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The area earned its name from Cantonment Road, named after Indian sepoys stationed there in 1819.",
      "sourceSentenceIds": [
        25
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Tanjong_Pagar",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The neighborhood is home to the Baba House museum, showcasing Peranakan history, architecture, and heritage.",
