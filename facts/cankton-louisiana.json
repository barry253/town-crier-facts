    },
    {
      "id": 2,
      "text": "Cankton was officially incorporated in 1960, following early 1960 incorporation procedures that were finalized in October of that year.",
      "sourceSentenceIds": [
        10,
        19
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Cankton%2C_Louisiana"
    },
    {
      "id": 3,
      "text": "The Cankton City Hall, built in 1979, houses the clerk’s office, police department, and a community center for residents.",
