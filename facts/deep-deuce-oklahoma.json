  "facts": [
    {
      "id": 1,
      "text": "Deep Deuce was once called “Deep Second” and mirrored Harlem in the 1930s, spawning jazz icons like Charlie Christian and Jimmy Rushing.",
      "sourceSentenceIds": [
        10,
        1
      ],
      "sourceLabels": [
        "Web source 1",
        "Wikipedia"
      ],
      "source": "https://www.travelok.com/listings/view.profile/id.2154"
    },
    {
      "id": 2,
      "text": "Randolph’s Drug Store at 331 NE Second Street hosted Oklahoma’s most popular soda fountain and ice cream parlor, drawing musicians and dancers nightly.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://theactivehistorian.com/2025/11/19/history-of-the-deep-deuce-district-okc/"
    },
    {
      "id": 3,
      "text": "The Haywood Building at 331‑1/2 NE 2nd Street, now on the National Register, once housed the famed Oklahoma City Blue Devils jazz band.",
      "sourceSentenceIds": [
        19
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://theactivehistorian.com/2025/11/19/history-of-the-deep-deuce-district-okc/"
    },
    {
      "id": 4,
      "text": "Ralph Ellison, author of Invisible Man, grew up in Deep Deuce and later penned a poem honoring the neighborhood in 1953.",
      "sourceSentenceIds": [
        23,
        24
      ],
      "sourceLabels": [
        "Wikipedia",
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Deep_Deuce"
    },
    {
      "id": 5,
      "text": "Cavalry Baptist Church, added to the National Register in 1978, was the planning site for Oklahoma City’s civil‑rights sit‑ins.",
      "sourceSentenceIds": [
        11,
        14
      ],
      "sourceLabels": [
        "Web source 2",
        "Web source 2"
      ],
      "source": "https://theactivehistorian.com/2025/11/19/history-of-the-deep-deuce-district-okc/"
    },
    {
      "id": 6,
      "text": "In 2019, the Oklahoma City Urban Renewal Authority secured Deep Deuce’s future with a $75,000 grant from the National Trust for Historic Preservation’s African American Cultural Heritage Action Fund.",
