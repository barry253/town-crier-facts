      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The main lake spans 221 acres with 12 miles of shoreline and averages 14 feet deep, reaching 34 feet in spots.",
      "sourceSentenceIds": [
        16,
        17
      ],
      "sourceLabels": [
        "Web source 2"
      ],
