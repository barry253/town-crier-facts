  "facts": [
    {
      "id": 1,
      "text": "Elliott sits on land once inhabited by Choctaw and Chickasaw tribes who used the fertile valleys for hunting, farming, and trade.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/elliott_mississippi",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The arrival of the Illinois Central Railroad in the mid‑1800s turned Elliott into a rail hub, linking it to Chicago and New Orleans.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/elliott_mississippi",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Elliott was officially incorporated as a town on March 1, 1884, during Mississippi’s post‑Reconstruction recovery.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/elliott_mississippi",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Reverend Cyrus Kingsbury founded the Elliott Mission in 1818, the first permanent white settlement in what would become Grenada County.",
      "sourceSentenceIds": [
        23
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/elliott_mississippi",
      "category": "people",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "A post office operated in Elliott from 1860 until 1964, serving as a vital communication hub during the town’s early growth.",
      "sourceSentenceIds": [
        13
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/elliott_mississippi",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Elliott lies in the valley of Batupan Bogue, a northwest‑flowing tributary of the Yalobusha River.",
      "sourceSentenceIds": [
