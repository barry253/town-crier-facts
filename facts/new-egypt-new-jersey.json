  "facts": [
    {
      "id": 1,
      "text": "New Egypt began as Timmon's Mill in the early 1700s, a mill town that grew around a water-powered gristmill on Oakford Lake.",
      "sourceSentenceIds": [
        1,
        2
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/New_Egypt,_New_Jersey",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "In 1845 the settlement was renamed New Egypt to avoid confusion with another town called Egypt, a nod to biblical imagery of “going to Egypt for corn.”.",
      "sourceSentenceIds": [
        8,
        9,
        10
      ],
      "sourceLabels": [
        "Web source 1",
        "Wikipedia"
      ],
      "source": "https://grokipedia.com/page/New_Egypt,_New_Jersey",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The Pemberton & Hightstown Railroad, completed in 1868, ran through New Egypt, turning the village into a brief resort spot in the late 19th and early 20th centuries.",
      "sourceSentenceIds": [
        13,
        14,
        15,
        5
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/New_Egypt,_New_Jersey",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "A former farmhouse on Evergreen Road now houses the New Egypt Historical Society Museum, preserving artifacts that trace the town’s agricultural roots.",
      "sourceSentenceIds": [
        28,
        16
      ],
      "sourceLabels": [
        "Web source 1",
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/New_Egypt,_New_Jersey",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Henry Charlton Beck noted Timmon's Mill as the approximate geographic center of New Jersey in his 1936 book, a claim later marked on a local Christmas tree farm.",
      "sourceSentenceIds": [
        24,
        25
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/New_Egypt%2C_New_Jersey",
      "category": "other",
      "quality": "poor",
      "qualityReason": "editorial_filler"
    },
    {
      "id": 6,
      "text": "New Egypt sits at the junction of Burlington, Monmouth, and Ocean counties, a unique tri‑county point that shapes its local identity.",
