  "facts": [
    {
      "id": 1,
      "text": "Dewey was founded in 1872 when Joseph Vipond built a road through the Pioneer Mountains from the Quartz Hill Mining District.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.mtmemory.org/nodes/view/128854"
    },
    {
      "id": 2,
      "text": "The town sits at 5,490 feet above sea level, perched on the south side of the Big Hole River.",
      "sourceSentenceIds": [
        1,
        5
      ],
      "sourceLabels": [
        "Web source 1",
        "Wikipedia"
      ],
      "source": "https://www.mtmemory.org/nodes/view/128854"
    },
    {
      "id": 3,
      "text": "The town was named after a miner named Dewey, who was its first resident.",
      "sourceSentenceIds": [
        6,
        2
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.mtmemory.org/nodes/view/128854"
    },
    {
      "id": 4,
      "text": "By 1885, the mining boom had built three stamp mills, several charcoal kilns, a hotel, a saloon, and a slaughterhouse in Dewey.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.mtmemory.org/nodes/view/128854"
    },
    {
      "id": 5,
      "text": "Dewey lies in Beaverhead County, just south of the Big Hole River, with Silver Bow County across the river to the north.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Dewey%2C_Montana"
    },
    {
      "id": 6,
      "text": "The town’s geographic coordinates are 45.7771° N latitude and 112.855° W longitude.",
