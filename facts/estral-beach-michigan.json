  "facts": [
    {
      "id": 1,
      "text": "Estral Beach got its name from the Spanish word for \"star,\" reflecting early settlers' admiration for the night sky.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Estral_Beach%2C_Michigan",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The village officially became incorporated in 1925, marking its transition from a small lakeside community to an incorporated municipality.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Estral_Beach%2C_Michigan",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Estral Beach sits on Lake Erie's northwest shore at Swan Creek's mouth, about eight miles south of the Detroit River's mouth.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Estral_Beach%2C_Michigan",
      "category": "other",
      "quality": "poor",
      "qualityReason": "location_description"
    },
    {
      "id": 4,
      "text": "The Strong Unit of the Detroit River International Wildlife Refuge lies within Estral Beach's northern edge, offering protected wetlands for wildlife.",
      "sourceSentenceIds": [
        11
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Estral_Beach%2C_Michigan",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Only two miles southwest of Estral Beach stands the Enrico Fermi Nuclear Generating Station, a key power source for the region.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Estral_Beach%2C_Michigan",
      "category": "other",
      "quality": "poor",
      "qualityReason": "location_description"
    },
    {
      "id": 6,
      "text": "Estral Beach is part of Berlin Charter Township in northeastern Monroe County, placing it within the township's administrative boundaries.",
