  "facts": [
    {
      "id": 1,
      "text": "Cripple Creek earned National Historic Landmark status in 1961, preserving its gold‑mining heritage for future generations.",
      "sourceSentenceIds": [
        1,
        9
      ],
      "sourceLabels": [
        "Web source 1",
        "Wikipedia"
      ],
      "source": "https://www.cityofcripplecreek.com/visit-cripple-creek/page/history",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "In 1890, Bob Womack’s gold find ignited Colorado’s last great gold rush, turning the area into a bustling mining camp.",
      "sourceSentenceIds": [
        8,
        28
      ],
      "sourceLabels": [
        "Web source 2",
        "Wikipedia"
      ],
      "source": "https://www.cripplecreekgov.com/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The Cripple Creek & Victor Narrow Gauge Railroad still roars through ghost towns and old mines, offering a living glimpse of the past.",
      "sourceSentenceIds": [
        14,
        19
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Cripple_Creek%2C_Colorado",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "A 1894 miners’ strike saw the governor deploy the National Guard to protect workers from mine‑owner violence, a rare federal intervention.",
      "sourceSentenceIds": [
        11,
        18
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Cripple_Creek%2C_Colorado",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Many historic downtown buildings now house casinos, blending preserved architecture with modern gaming entertainment.",
      "sourceSentenceIds": [
        1,
        12
      ],
      "sourceLabels": [
        "Web source 1",
        "Wikipedia"
      ],
      "source": "https://www.cityofcripplecreek.com/visit-cripple-creek/page/history",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Cripple Creek’s high valley sits at 9,494 feet, once viewed as a cattle pasture before gold reshaped its destiny.",
