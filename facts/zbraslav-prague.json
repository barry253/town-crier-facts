  "facts": [
    {
      "id": 1,
      "text": "In 1292, King Wenceslaus II founded the Aula Regia Cistercian abbey in Zbraslav, a royal monastery that became a major necropolis.",
      "sourceSentenceIds": [
        4,
        6
      ],
      "sourceLabels": [
