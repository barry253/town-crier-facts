  "facts": [
    {
      "id": 1,
      "text": "Little Sturgeon was the site of Door County's first permanent European-American settlement, established in 1835 by Increase Claflin.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/little_sturgeon_wisconsin"
    },
    {
      "id": 2,
      "text": "Native American tribes, including the Menominee and Potawatomi, originally used the sheltered waters of Little Sturgeon Bay for fishing and trade.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/little_sturgeon_wisconsin"
    },
    {
      "id": 3,
      "text": "During the mid-19th century, Little Sturgeon operated lime kilns that supplied materials for Chicago's reconstruction after the Great Fire of 1871.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/little_sturgeon_wisconsin"
    },
    {
      "id": 4,
      "text": "Little Sturgeon hosted Door County's first baseball club, the Empire Base Ball Club, which was organized in 1869.",
      "sourceSentenceIds": [
        11
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/little_sturgeon_wisconsin"
    },
    {
      "id": 5,
      "text": "Little Sturgeon is located along the western shore of Little Sturgeon Bay, a small inlet extending from Green Bay.",
      "sourceSentenceIds": [
        14
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/little_sturgeon_wisconsin"
    },
    {
      "id": 6,
      "text": "The underlying limestone bedrock of the Niagara Escarpment influences the thin, gravelly soils found around Little Sturgeon.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 1"
      ],
