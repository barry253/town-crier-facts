    },
    {
      "id": 2,
      "text": "In 1975, Fort Sam Houston earned National Historic Landmark status, honoring its long military legacy.",
      "sourceSentenceIds": [
        2,
        3
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Fort_Sam_Houston",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The museum occupies a 1876 National Historic Landmark building, complete with a Clock Tower and resident peafowl and deer.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://history.army.mil/Army-Museum-Enterprise/Find-an-Army-Museum/The-Fort-Sam-Houston-Museum/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Exhibits trace Fort Sam Houston’s journey from its 1845 founding as a supply depot to today’s Joint Base San Antonio.",
      "sourceSentenceIds": [
        7,
        18,
        19,
        20
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Fort_Sam_Houston",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Fort Sam Houston continues to serve as a medical hub, treating wounded warriors from modern conflicts.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.wonderfulmuseums.com/museum/fort-sam-houston-museum/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The Quadrangle, now the museum’s heart, began as a simple supply depot in the mid‑1800s.",
