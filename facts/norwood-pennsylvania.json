  "facts": [
    {
      "id": 1,
      "text": "Norwood was founded in 1873 by realtor John Cochran, who envisioned a suburban residential community.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/norwood_pennsylvania",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Cochran named the development after Henry Ward Beecher's 1868 novel 'Norwood,' evoking an idyllic New England village.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/norwood_pennsylvania",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The first public auction of lots occurred on May 28, 1873, near the Norwood station, selling nearly 50 parcels for about $125 each.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/norwood_pennsylvania",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The Morton Morton House, built around 1750 by Morton Morton, sits at the confluence of Muckinipattis and Darby Creeks and was listed on the National Register in 2000.",
      "sourceSentenceIds": [
        1,
        7,
        10,
        11
      ],
      "sourceLabels": [
        "Web source 2",
        "Wikipedia"
      ],
      "source": "https://grokipedia.com/page/norwood_pennsylvania",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Norwood station serves SEPTA's Wilmington/Newark Line, connecting residents to Center City Philadelphia and to Wilmington and Newark, Delaware.",
      "sourceSentenceIds": [
        13
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Norwood%2C_Pennsylvania",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "SEPTA Route 114 buses stop on Chester Pike in Norwood, linking the borough to Darby and Wawa stations.",
      "sourceSentenceIds": [
        14
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
