  "facts": [
    {
      "id": 1,
      "text": "Arrow Rock was founded in June 1829, originally called Philadelphia.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Arrow_Rock%2C_Missouri"
    },
    {
      "id": 2,
      "text": "The town’s name first appeared on a 1732 French map as “Pierre a Fleche,” meaning “Rock of Arrows.”.",
      "sourceSentenceIds": [
        11
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Arrow_Rock%2C_Missouri"
    },
    {
      "id": 3,
      "text": "Restoring the Huston Tavern in 1923 sparked Missouri’s first historic‑preservation effort.",
      "sourceSentenceIds": [
        6,
        22
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://arrowrock.org/"
    },
    {
      "id": 4,
      "text": "In 1963 the entire village earned National Historic Landmark status for its Westward Expansion legacy.",
      "sourceSentenceIds": [
        7,
        19
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://arrowrock.org/"
    },
    {
      "id": 5,
      "text": "Every October, Arrow Rock hosts the Fall Heritage Festival, showcasing crafts, reenactors, and music.",
      "sourceSentenceIds": [
        15
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Arrow_Rock%2C_Missouri"
    },
    {
      "id": 6,
      "text": "Artist George Caleb Bingham’s home, the Bingham House, stands as a National Historic Landmark in Arrow Rock.",
      "sourceSentenceIds": [
