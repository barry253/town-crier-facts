  "facts": [
    {
      "id": 1,
      "text": "Native Americans named White Lake for the white sand and marl found on the lake bottom.",
      "sourceSentenceIds": [
        3,
        9
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/White_Lake%2C_Wisconsin"
    },
    {
      "id": 2,
      "text": "Pioneer Isaac Farrow tried to drain White Lake in 1876 to create a hay meadow, but the lake's springs stopped him.",
      "sourceSentenceIds": [
        10,
        11
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/White_Lake%2C_Wisconsin"
    },
    {
      "id": 3,
      "text": "White Lake was incorporated as a village in 1926 after the area became more popular than the nearby settlement of Van Ostrand.",
      "sourceSentenceIds": [
        5,
        13
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/White_Lake%2C_Wisconsin"
    },
    {
      "id": 4,
      "text": "The construction of a new lumber mill at the end of 1916 helped accelerate growth in the White Lake area.",
      "sourceSentenceIds": [
        13
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/White_Lake%2C_Wisconsin"
    },
    {
      "id": 5,
      "text": "The Wisconsin Northern railroad moved its depot to White Lake around 1916 as the community grew.",
      "sourceSentenceIds": [
        14
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/White_Lake%2C_Wisconsin"
    },
    {
      "id": 6,
      "text": "A post office called White Lake was established in 1916 and has remained in operation ever since.",
      "sourceSentenceIds": [
        15
      ],
