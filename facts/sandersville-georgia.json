  "facts": [
    {
      "id": 1,
      "text": "Sandersville got its name from Mark Saunders, who ran a trading post at the crossroads of two Creek Indian trails.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.sandersvillega.org/History.cfm"
    },
    {
      "id": 2,
      "text": "Sandersville is dubbed the Kaolin Capital of the World because its hills are rich in fine white clay.",
      "sourceSentenceIds": [
        28
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Sandersville%2C_Georgia"
    },
    {
      "id": 3,
      "text": "The Washington County Courthouse, erected in 1869, was expanded in 1889 and again in 1939, standing as a historic landmark.",
      "sourceSentenceIds": [
        18
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.achp.gov/preserve-america/community/sandersville-georgia"
    },
    {
      "id": 4,
      "text": "A successful Main Street program has revitalized Sandersville, centering its efforts around the courthouse and preserving the town’s historic character.",
