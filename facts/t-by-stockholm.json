  "facts": [
    {
      "id": 1,
      "text": "Täby Municipality lies north of Stockholm, part of Stockholm County, and its seat is the town of Täby.",
      "sourceSentenceIds": [
        6,
        7
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/T%C3%A4by_Municipality",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Täby’s history stretches back to the Svear of the first millennium, with over 37 runestones still visible.",
      "sourceSentenceIds": [
        21,
        22
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/T%C3%A4by_Municipality",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The 11th‑century Jarlabankes bro causeway, a rare medieval bridge, still marks Täby’s northern landscape.",
      "sourceSentenceIds": [
        23
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/T%C3%A4by_Municipality",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "A runestone in Täby’s coat of arms, the Risbylestenen, shows early Christian influence in the area.",
      "sourceSentenceIds": [
        24,
        25
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/T%C3%A4by_Municipality",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Until the 19th century, Täby remained a rural community owned largely by noble families such as the Brahe of Rydboholm.",
      "sourceSentenceIds": [
        27,
        29
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/T%C3%A4by_Municipality",
      "category": "other",
      "quality": "poor",
      "qualityReason": "location_description"
    },
    {
      "id": 6,
      "text": "The narrow‑gauge Roslagsbanan railway stops twelve times within Täby, linking the suburb directly to central Stockholm.",
      "sourceSentenceIds": [
        19
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
