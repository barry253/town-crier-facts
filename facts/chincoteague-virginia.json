      "quality": "poor",
      "qualityReason": "editorial_filler"
    },
    {
      "id": 5,
      "text": "Chincoteague serves as the gateway to the Chincoteague National Wildlife Refuge on Assateague Island, home to the famed Virginia ponies.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
