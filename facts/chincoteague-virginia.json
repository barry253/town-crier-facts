  "facts": [
    {
      "id": 1,
      "text": "The town’s name, Chincoteague, first appeared in U.S. Board on Geographic Names decisions in 1943, though the island’s Native name was Gingoteague.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
