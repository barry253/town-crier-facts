      ],
      "source": "https://en.wikipedia.org/wiki/Chincoteague%2C_Virginia",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "When the Antares rocket launches from nearby Wallops Flight Facility, Chincoteague sees a surge of tourists eager to watch the launch.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Chincoteague%2C_Virginia",
