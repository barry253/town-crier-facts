  "facts": [
    {
      "id": 1,
      "text": "New Hudson began as a railroad station on the Grand Trunk Western Railroad in the mid‑19th century.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://revisionedhome.com/new-hudson-michigan-bridging-history-and-progress/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town’s name honors early settlers Russell Alvord and Daniel Richards, who opened the Old Tavern in 1831, now the historic New Hudson Inn.",
      "sourceSentenceIds": [
        15
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Lyon_Township%2C_Oakland_County%2C_Michigan",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "A stage line post office operated there from 1834, and the federal post office opened in June 1852, marking New Hudson’s growth.",
      "sourceSentenceIds": [
        16,
        17
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Lyon_Township%2C_Oakland_County%2C_Michigan",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The Lyon Township Public Library, housed in the Smith Community Center, serves the New Hudson community with a rich collection.",
