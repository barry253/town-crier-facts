  "facts": [
    {
      "id": 1,
      "text": "Boiling Springs earned its name from a cluster of artesian springs that erupt with a gentle, bubbling flow.",
      "sourceSentenceIds": [
        13
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Boiling_Springs%2C_Pennsylvania",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The springs appear to boil because two ancient basalt dikes trap groundwater, forcing it upward in a subterranean \"V\" shape.",
      "sourceSentenceIds": [
        16,
        17,
        28
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Boiling_Springs%2C_Pennsylvania",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Thirty springs across about two acres discharge roughly 22 million gallons a day, with a median flow of 11,500 gallons per minute.",
      "sourceSentenceIds": [
        15,
        29,
        30
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Boiling_Springs%2C_Pennsylvania",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Boiling Springs hosts a stop on the Underground Railroad, where agent Kaufman helped fugitives between Shippensburg and Harrisburg.",
      "sourceSentenceIds": [
        5,
        3,
        4
      ],
      "sourceLabels": [
