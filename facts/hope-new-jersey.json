  "facts": [
    {
      "id": 1,
      "text": "Hope was founded in 1769 by German Moravians who planned streets, homes, a school, a tavern, and a church before the village even existed.",
      "sourceSentenceIds": [
        15,
        16
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Hope_Township%2C_New_Jersey",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town’s name comes from the Moravians’ “hope of immortality,” a spiritual promise that guided their early community.",
      "sourceSentenceIds": [
        28
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Hope_Township%2C_New_Jersey",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Settlers chose Hope for the reliable water power of Beaver Brook, which they believed would sustain mills and multiple businesses.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.hopetwp-nj.us/history",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "In the 19th century, railroads ran north and south of Hope while the Morris Canal flowed to the south, making the village a transportation hub.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.hopetwp-nj.us/history",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Hope’s Moravian Cemetery and Hartung’s General Store were used as filming locations for two scenes in the horror classic Friday the 13th.",
