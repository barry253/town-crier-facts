  "facts": [
    {
      "id": 1,
      "text": "The name Tashua is believed to derive from a Paugussett term meaning a place of gathering or meeting.",
      "sourceSentenceIds": [
        26
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://tashuaneighborhood.org/tashua-through-time-the-heritage-and-heart-of-one-of-trumbull-s-oldest-neighborhoods/"
    },
    {
      "id": 2,
      "text": "Tashua was originally home to the Paugussett tribe, who fished in the Pequonnock River and foraged in the dense forests.",
      "sourceSentenceIds": [
        25
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://tashuaneighborhood.org/tashua-through-time-the-heritage-and-heart-of-one-of-trumbull-s-oldest-neighborhoods/"
    },
    {
      "id": 3,
      "text": "English settlers established some of the first documented homesteads in the Tashua area around 1705.",
      "sourceSentenceIds": [
        28
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://tashuaneighborhood.org/tashua-through-time-the-heritage-and-heart-of-one-of-trumbull-s-oldest-neighborhoods/"
    },
    {
      "id": 4,
      "text": "Christ Episcopal Church in Tashua was built in 1846 in the Carpenter Gothic style and is listed on the National Register of Historic Places.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/tashua_connecticut"
    },
    {
      "id": 5,
      "text": "Quintessential New England stone walls along Lake Avenue and Tashua Road mark property lines created nearly two centuries ago.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://tashuaneighborhood.org/tashua-through-time-the-heritage-and-heart-of-one-of-trumbull-s-oldest-neighborhoods/"
    },
