  "facts": [
    {
      "id": 1,
      "text": "Ma'alot‑Tarshiha was created in 1963 by merging the Arab town Tarshiha and Jewish town Ma'alot, forming a mixed city.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
