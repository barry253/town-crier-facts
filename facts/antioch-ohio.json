  "facts": [
    {
      "id": 1,
      "text": "Antioch was founded in 1825 by William Mills and about 100 families of Robert Owen followers who sought to recreate New Harmony's utopia.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Yellow_Springs%2C_Ohio"
    },
    {
      "id": 2,
      "text": "Antioch College began in 1850, founded by the Christian Connection, with Horace Mann as its first president starting operations in 1853.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Yellow_Springs%2C_Ohio"
    },
    {
      "id": 3,
      "text": "The college sits in the village of Yellow Springs, a small community in northern Greene County, Ohio.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Yellow_Springs%2C_Ohio"
    },
    {
      "id": 4,
      "text": "When the Little Miami Railroad finished in 1846, it spurred commerce, new residents, and tourism into the Greene County area.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Yellow_Springs%2C_Ohio"
    },
    {
      "id": 5,
      "text": "Ohio hosts two Antiochs; the one in Monroe County is the historic village discussed here, while another lies in Madison County.",
