      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The Missouri Pacific Railroad’s 1870 extension through southern Lancaster County spurred new trade and transport opportunities for Kramer.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/kramer_nebraska",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Kramer’s post office opened in 1889 and operated until 1955, after which mail was routed to Crete.",
      "sourceSentenceIds": [
        11,
        17
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/kramer_nebraska",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "John’s Evangelical Lutheran Church, founded in 1874, switched from German to English services during WWI and was rebuilt in 1911.",
      "sourceSentenceIds": [
        19
      ],
      "sourceLabels": [
