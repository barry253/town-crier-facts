      "quality": "good"
    },
    {
      "id": 2,
      "text": "Its tidy homes sit on streets named after the first 13 U.S. states, beside the historic Village Office on the National Register.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 1"
      ],
