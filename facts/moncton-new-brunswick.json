  "facts": [
    {
      "id": 1,
      "text": "Moncton was officially founded in 1766 when Pennsylvania German immigrants from Philadelphia settled there.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Moncton",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town’s name came from Monckton, but a clerical error at incorporation spelled it Moncton, a mistake that still stands.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Moncton",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The Université de Moncton, founded in 1963, became a cornerstone for Acadian culture in the region.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Moncton",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Moncton earned the nickname “Hub City” because its central inland location made it a railway and land transport hub for the Maritimes.",
      "sourceSentenceIds": [
        18
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Moncton",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The city’s tourism roots trace back to the tidal bore of the Petitcodiac River and the optical illusion of Magnetic Hill.",
      "sourceSentenceIds": [
        21
