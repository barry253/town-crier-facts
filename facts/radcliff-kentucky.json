  "facts": [
    {
      "id": 1,
      "text": "Radcliff was named after Major William Radcliffe, head of the Quartermaster Corps at Camp Henry Knox, in 1919.",
      "sourceSentenceIds": [
        3,
        5
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 2"
      ],
      "source": "https://en.wikipedia.org/wiki/Radcliff%2C_Kentucky",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town grew when Fort Knox expanded in the 1930s, displacing residents from Stithton and New Stithton who moved into Radcliff.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Radcliff%2C_Kentucky",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "During World War II, thousands of soldiers trained at Fort Knox spent leisure hours at the USO in Radcliff.",
      "sourceSentenceIds": [
        26
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Radcliff%2C_Kentucky",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The first map of Kentucky in 1784 labeled the area now Radcliff as the Mill Creek area, reflecting its early settlement.",
      "sourceSentenceIds": [
        12,
        13
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.tiki-toki.com/timeline/entry/1013601/Our-History/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Radcliff incorporated as a sixth‑class city in March 1956 after a 1955 bond sale that funded municipal development.",
      "sourceSentenceIds": [
        27,
        30
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Radcliff%2C_Kentucky",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The Mill Creek Baptist Church, founded in 1782, still stands as a historic community meeting house in Radcliff.",
      "sourceSentenceIds": [
