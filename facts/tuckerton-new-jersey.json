  "facts": [
    {
      "id": 1,
      "text": "Tuckerton got its name when Ebenezer Tucker hosted a feast in March 1789, changing Clamtown to Tuckerton.",
      "sourceSentenceIds": [
        2,
        3,
        10
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Tuckerton%2C_New_Jersey"
    },
    {
      "id": 2,
      "text": "The Tuckerton Methodist Episcopal Church, founded in 1797, is one of the town’s oldest religious buildings.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Tuckerton%2C_New_Jersey"
    },
    {
      "id": 3,
      "text": "Tuckerton Seaport, a working maritime museum, showcases historic vessels and village life right on the Jersey Shore.",
      "sourceSentenceIds": [
        21
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Tuckerton%2C_New_Jersey"
    },
    {
      "id": 4,
      "text": "The Little Egg Harbor Lifesaving Station, built in 1869, still stands as a reminder of the town’s maritime safety heritage.",
      "sourceSentenceIds": [
        11
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Tuckerton%2C_New_Jersey"
    },
    {
      "id": 5,
      "text": "The Tuckerton Railroad, completed in 1871, connected the town to the wider region and marked a shift from stage and vessel travel.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Tuckerton%2C_New_Jersey"
    },
    {
      "id": 6,
      "text": "In 1816, Isaac Jenkins launched the first stage line between Tuckerton and Philadelphia, a two‑day trip that linked the town to the capital.",
      "sourceSentenceIds": [
        30
      ],
