  "facts": [
    {
      "id": 1,
      "text": "Williamson was incorporated in 1905 and became the county seat of Mingo County, West Virginia.",
      "sourceSentenceIds": [
        23,
        15
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Williamson%2C_West_Virginia",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town sits on the Tug Fork River, directly opposite South Williamson, Kentucky, connected by a bridge.",
      "sourceSentenceIds": [
        5,
        18
      ],
      "sourceLabels": [
        "Web source 1",
        "Wikipedia"
      ],
      "source": "https://www.britannica.com/place/Williamson",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "A massive floodwall, finished in 1991 by the Army Corps of Engineers, protects Williamson from the Tug Fork’s floods.",
      "sourceSentenceIds": [
        19,
        20,
        21
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Williamson%2C_West_Virginia",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Williamson’s economy grew around coal mining and the rail yard built by the Norfolk and Western Railroad, now Norfolk Southern.",
      "sourceSentenceIds": [
        6,
        8
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Williamson%2C_West_Virginia",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The historic Coal House, built in 1933, now serves as a museum and is on the National Register of Historic Places.",
      "sourceSentenceIds": [
        9,
        10
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Williamson%2C_West_Virginia",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Southern West Virginia Community and Technical College, located in Williamson, offers vocational programs that support the local workforce.",
