        27
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://villageofbedfordpark.com/community/history.php",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The Bedford Park Improvement Club, founded in 1924, elected Paul Bishop as its first president, starting local governance.",
      "sourceSentenceIds": [
        28,
