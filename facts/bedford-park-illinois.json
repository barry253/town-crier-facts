      "id": 2,
      "text": "In 1906, Corn Products broke ground for a wet‑milling plant on prairie land, sparking Bedford Park’s industrial boom.",
      "sourceSentenceIds": [
        26
      ],
      "sourceLabels": [
        "Web source 1"
      ],
