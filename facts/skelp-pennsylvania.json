  "facts": [
    {
      "id": 1,
      "text": "Skelp has long been tied to agricultural life in Sinking Valley, a fertile area where farming began in the 19th century.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/skelp_pennsylvania",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The village hosted the Sinking Valley Grange #484, the oldest Grange in Blair County, founded in 1875 to unite farmers and strengthen community welfare.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/skelp_pennsylvania",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Before European settlement, Skelp’s surrounding lands served as a sacred hunting ground and trading hub for Lenape, Shawnee, and Iroquois peoples.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/skelp_pennsylvania",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Skelp’s landscape blends valley fields for crops, mountain slopes of mixed hardwood forests, limestone‑influenced woodlands, and riparian zones along streams.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/skelp_pennsylvania",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Skelp sits at the crossroads of Skelp Mountain Road (Route 1008) and Hobbit Hollow Road, right at the foot of Mt. Charma.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Skelp%2C_Pennsylvania",
      "category": "other",
      "quality": "poor",
      "qualityReason": "route_only"
    },
    {
      "id": 6,
      "text": "Elk Run, a modest stream, winds through Skelp, adding gentle water sounds to the rural landscape.",
      "sourceSentenceIds": [
        10
