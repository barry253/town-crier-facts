  "facts": [
    {
      "id": 1,
      "text": "Kungsholmen means 'King's Island' and was renamed in 1672 when the parish split.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Kungsholmen"
    },
    {
      "id": 2,
      "text": "The island once hosted Franciscan monks in the 15th century who farmed cattle and fished.",
      "sourceSentenceIds": [
        24,
        25
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Kungsholmen"
    },
    {
      "id": 3,
      "text": "In 1644 the crown donated the eastern part of the former Munklägret to Stockholm, giving the city its first formal plan.",
      "sourceSentenceIds": [
        15
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Kungsholmen"
    },
    {
      "id": 4,
      "text": "The first bridge to Munklägret appeared in 1635, linking the island to the mainland.",
      "sourceSentenceIds": [
        29
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Kungsholmen"
    },
    {
      "id": 5,
      "text": "Kungsholm Church, a historic sanctuary, reflects the island’s older parish roots and remains a quiet landmark today.",
      "sourceSentenceIds": [
        8,
        13
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.stockholmmuseum.com/stockholm-unveiled/areas/kungsholmen_"
    },
    {
      "id": 6,
      "text": "Stockholm City Hall, located on Kungsholmen, hosts the Nobel Banquet and offers tower views of the city.",
