  "facts": [
    {
      "id": 1,
      "text": "Lower Garden District streets honor the nine Greek muses, from Calliope to Urania, a nod to its classical roots.",
      "sourceSentenceIds": [
        2,
        28
      ],
      "sourceLabels": [
        "Web source 2",
        "Web source 1"
      ],
      "source": "https://www.getlownola.com/history",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "In 1974 residents blocked a second bridge plan, winning the neighborhood’s place on the National Register of Historic Places that same year.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://prcno.org/help-for-homeowners/historic-districts-neighborhoods/lower-garden-district/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Historic churches here rival European cathedrals, and their spires can be seen from Magazine Street’s bustling businesses.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://prcno.org/help-for-homeowners/historic-districts-neighborhoods/lower-garden-district/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Mid‑19th‑century Greek Revival and Italianate homes still line the streets, preserving the district’s 1800s architectural charm.",
      "sourceSentenceIds": [
        28
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://prcno.org/help-for-homeowners/historic-districts-neighborhoods/lower-garden-district/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "German and Irish immigrants began settling the area in the 1840s, shaping its cultural and architectural character.",
      "sourceSentenceIds": [
        29
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://prcno.org/help-for-homeowners/historic-districts-neighborhoods/lower-garden-district/",
      "category": "people",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "During the Great Depression many mansions were converted into boarding houses and apartments, reflecting the era’s economic shift.",
