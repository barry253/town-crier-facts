    },
    {
      "id": 3,
      "text": "Historic churches here rival European cathedrals, and their spires can be seen from Magazine Street’s bustling businesses.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://prcno.org/help-for-homeowners/historic-districts-neighborhoods/lower-garden-district/"
    },
    {
      "id": 4,
      "text": "Mid‑19th‑century Greek Revival and Italianate homes still line the streets, preserving the district’s 1800s architectural charm.",
      "sourceSentenceIds": [
