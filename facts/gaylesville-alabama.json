  "facts": [
    {
      "id": 1,
      "text": "Gaylesville may have been named after John Gayles, an early settler, or Governor John Gayle who served from 1831 to 1835.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://encyclopediaofalabama.org/article/gaylesville/"
    },
    {
      "id": 2,
      "text": "Before becoming Gaylesville, the area was called Sulphur Springs and grew cotton, corn, and hay as its main crops.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://encyclopediaofalabama.org/article/gaylesville/"
    },
    {
      "id": 3,
      "text": "Cornwall Furnace, settled in the early 1830s, sits just before the Cherokee removal and now serves as a historic park.",
      "sourceSentenceIds": [
        6,
        7
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://encyclopediaofalabama.org/article/gaylesville/"
    },
    {
      "id": 4,
      "text": "Near Gaylesville lies Barry Springs, also known as the Fort Likens Site, where a temporary camp was built in 1838 to aid Cherokee removal.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://encyclopediaofalabama.org/article/gaylesville/"
    },
    {
      "id": 5,
      "text": "Gaylesville sits on the north side of the Chattooga River, right where the river feeds into Weiss Lake.",
      "sourceSentenceIds": [
        17
