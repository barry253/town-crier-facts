    {
      "id": 1,
      "text": "Bone Gap earned its name when early settlers in 1830 found a pile of discarded animal bones left by the Piankeshaw, prompting the quirky name.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
