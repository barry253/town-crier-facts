  "facts": [
    {
      "id": 1,
      "text": "Drum Tower, built 1272 as Qizheng Tower, was ordered by Kublai Khan.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.chinaculturetrip.com/beijing-dongcheng-gulou-zhonglou/"
    },
    {
      "id": 2,
      "text": "Bell Tower, also from 1272, began as part of the Waning Temple.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.chinaculturetrip.com/beijing-dongcheng-gulou-zhonglou/"
    },
    {
      "id": 3,
      "text": "The two towers mark the northern tip of Beijing’s central axis, just north of Di'anmen Street.",
      "sourceSentenceIds": [
        26,
        27
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Drum_Tower_and_Bell_Tower_of_Beijing"
    },
    {
      "id": 4,
      "text": "Visitors can climb steep stairs to the second floor for sweeping views of historic hutongs and the modern skyline.",
      "sourceSentenceIds": [
        16
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.chinaculturetrip.com/beijing-dongcheng-gulou-zhonglou/"
    },
    {
      "id": 5,
      "text": "Originally used to announce time, the towers now serve as cultural landmarks and tourist attractions.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Drum_Tower_and_Bell_Tower_of_Beijing"
    },
    {
      "id": 6,
      "text": "In 1924, Feng Yuxiang removed their official status and renamed them the Tower of Clarifying Shame.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Drum_Tower_and_Bell_Tower_of_Beijing"
