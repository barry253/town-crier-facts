  "facts": [
    {
      "id": 1,
      "text": "Endeavor got its name from the Christian Endeavor Society, a national youth movement founded in 1881 that inspired the town’s founders.",
      "sourceSentenceIds": [
        3,
        5
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 2"
      ],
      "source": "https://en.wikipedia.org/wiki/Endeavor%2C_Pennsylvania"
    },
    {
      "id": 2,
      "text": "From 1887 to 1938, Endeavor boasted two massive band mills and an extensive logging railroad that stretched across Warren and Forest Counties.",
      "sourceSentenceIds": [
        1,
        12,
        13
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/endeavor_pennsylvania"
    },
    {
      "id": 3,
      "text": "The town’s Presbyterian Church, photographed for the Historic American Buildings Survey in 1897, showcases Gothic Revival architecture tied to the Christian Endeavor movement.",
      "sourceSentenceIds": [
        2,
        17
      ],
      "sourceLabels": [
        "Web source 2",
        "Wikipedia"
      ],
      "source": "https://grokipedia.com/page/endeavor_pennsylvania"
    },
    {
      "id": 4,
      "text": "Pennsylvania Route 666 once served as the main artery that connected Endeavor’s lumber camps to the wider market.",
      "sourceSentenceIds": [
        14
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/endeavor_pennsylvania"
    },
    {
      "id": 5,
      "text": "Endeavor’s post office opened in 1897, marking the town’s first official federal presence.",
      "sourceSentenceIds": [
        22
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://roadsidethoughts.com/pa/endeavor-xx-forest-profile.htm"
    },
    {
      "id": 6,
      "text": "Perched 1,110 feet above sea level, Endeavor sits within the Allegheny National Forest.",
