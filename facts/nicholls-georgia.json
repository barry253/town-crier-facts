  "facts": [
    {
      "id": 1,
      "text": "Nicholls was founded in 1890 as a railroad stop on the Atlantic and Gulf Railroad, named after a local landowner.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.trawellino.com/destinations/united-states/georgia_nicholls"
    },
    {
      "id": 2,
      "text": "The city’s name honors John C. Nicholls, a prominent local landowner who helped establish the town.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Nicholls%2C_Georgia"
    },
    {
      "id": 3,
      "text": "Nicholls sits on the eastern edge of Coffee County at 31°31′1″N 82°38′16″W, placing it in Georgia’s Wiregrass Region.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Nicholls%2C_Georgia"
    },
    {
      "id": 4,
      "text": "The Wiregrass Arena, a community hub, hosts agricultural shows and the annual Nicholls Founders Day festival.",
      "sourceSentenceIds": [
        26,
        27
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Nicholls%2C_Georgia"
    },
    {
      "id": 5,
      "text": "Georgia State Route 32 runs through Nicholls, connecting it westward to Douglas and eastward to Alma.",
      "sourceSentenceIds": [
        11
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Nicholls%2C_Georgia"
    },
    {
      "id": 6,
      "text": "The town’s public library, the Oohpee Regional Library, is located on Jackson Street and serves as a local cultural center.",
