  "facts": [
    {
      "id": 1,
      "text": "Buckhead got its name when early settler Booth Fitzpatrick shot a buck and hung its head on a tree, calling the spot \"Buckhead\".",
      "sourceSentenceIds": [
        13,
        14,
        15,
        16,
        17,
        18
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://townofbuckhead.org/",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The Georgia Railroad first ran through Buckhead in 1837, using a turntable because it couldn't yet reach Atlanta; by 1845 the line extended to the city.",
      "sourceSentenceIds": [
        2,
        3
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://townofbuckhead.org/",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The Rock House, a 19th‑century log cabin in Buckhead, still stands today and is listed on the National Register of Historic Places.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://townofbuckhead.org/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Early Buckhead settlers included the Fitzpatrick family, Saffold, McWhorter, and others who helped shape the town in the 1800s.",
      "sourceSentenceIds": [
        24
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://townofbuckhead.org/",
      "category": "people",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Buckhead opened its first post office in 1823, long before the town was officially incorporated.",
      "sourceSentenceIds": [
        25
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://townofbuckhead.org/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "In 1824 land was granted in Buckhead for a church and a school, establishing the town’s early community institutions.",
      "sourceSentenceIds": [
        26
      ],
      "sourceLabels": [
        "Web source 1"
      ],
