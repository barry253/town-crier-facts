  "facts": [
    {
      "id": 1,
      "text": "East Bloomfield was carved out of the Phelps and Gorham Purchase in 1789, becoming one of Ontario County’s first towns.",
      "sourceSentenceIds": [
        6,
        15
      ],
      "sourceLabels": [
        "Web source 1",
        "Wikipedia"
      ],
      "source": "https://villageofbloomfieldny.gov/history",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town was originally called Bloomfield, but renamed East Bloomfield in 1833 when West Bloomfield split off.",
      "sourceSentenceIds": [
        16
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/East_Bloomfield%2C_New_York",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "When the railroad arrived in 1854, the eastern end of Main Street morphed into East Bloomfield Station, the town’s commercial heart.",
      "sourceSentenceIds": [
        11,
        12
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://villageofbloomfieldny.gov/history",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "In 1969 the East Bloomfield Historical Society received its charter, preserving the town’s stories for future generations.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://ebhs1838.org/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "East Bloomfield is the birthplace of the famous Northern Spy apple, a tart variety prized by cider makers.",
      "sourceSentenceIds": [
        18
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/East_Bloomfield%2C_New_York",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Ganondagan State Historic Site, once within East Bloomfield’s borders, now lies in neighboring Victor, a reminder of the town’s early boundaries.",
      "sourceSentenceIds": [
        5
      ],
