  "facts": [
    {
      "id": 1,
      "text": "Goessel was named for Captain Kurt von Goessel, a merchant who perished aboard the Elbe in the English Channel.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Goessel%2C_Kansas",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Before becoming Goessel, the village was first called Gnadenfeld, reflecting its early German‑speaking settlers.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.goesselks.com/about-1",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The first public building in Goessel was the Mennonite Brethren church erected in 1890, followed by a creamery station that same year.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Goessel%2C_Kansas",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Goessel proudly displays numerous antique tractors, a nod to its agricultural heritage that draws enthusiasts from across the state.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Goessel%2C_Kansas",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Around 1890 a creamery station opened, and by 1894 a blacksmith shop served the growing community.",
      "sourceSentenceIds": [
        19
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.goesselks.com/about-1",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Today Goessel hosts Keith's Foods, The Goessel Station, and the Branding Iron café, keeping the town’s commercial spirit alive.",
