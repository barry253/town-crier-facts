    {
      "id": 1,
      "text": "Coral Gables takes its name from George Merrick’s family home, built of coral rock, which gave the city its Mediterranean feel.",
      "sourceSentenceIds": [
        6,
        7,
        9
      ],
      "sourceLabels": [
