  "facts": [
    {
      "id": 1,
      "text": "Fayetteville takes its name from Marquis de Lafayette, the French general who fought for the United States during the Revolutionary War.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Fayetteville%2C_Illinois",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The village proudly calls itself the Gateway to the Kaskaskia, a nod to its historic river connection.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Fayetteville%2C_Illinois",
      "category": "other",
      "quality": "poor",
      "qualityReason": "editorial_filler"
    },
    {
      "id": 3,
      "text": "Fayetteville sits on the Kaskaskia River, one of Illinois' oldest waterways and has been a trade route since the 18th century.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Fayetteville%2C_Illinois",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Officially known as the Village of Fayetteville, it maintains a distinct municipal identity within Illinois.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Fayetteville%2C_Illinois",
      "category": "other",
      "quality": "poor",
      "qualityReason": "editorial_filler"
    },
    {
      "id": 6,
      "text": "Fayetteville lies within St. Clair County, the same county that borders the Mississippi River to the west.",
