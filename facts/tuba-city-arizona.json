      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Dinosaur Tracks, just five miles east on US‑60, display theropod footprints that date back 200 to 145 million years.",
      "sourceSentenceIds": [
        7,
        13
      ],
      "sourceLabels": [
        "Web source 1",
