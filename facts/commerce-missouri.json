  "facts": [
    {
      "id": 1,
      "text": "Commerce was founded in 1797 and incorporated in 1834, making it one of Missouri's oldest river villages.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.usacitiesonline.com/mocountycommerce.htm",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town’s name comes from its role as a river‑based trade hub on the Mississippi in the early 19th century.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/commerce_missouri",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "French settlers first occupied the site in 1788, placing Commerce among Missouri’s earliest European settlements after St. Louis and St. Charles.",
      "sourceSentenceIds": [
        11
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Commerce%2C_Missouri",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "During the Civil War, Commerce uniquely kept uninterrupted mail service while guerrilla bands shut down delivery elsewhere in Scott County.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Commerce%2C_Missouri",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "A Methodist congregation dates back to 1825, and the first Baptist church appeared only in 1906, marking a shift in the town’s religious landscape.",
      "sourceSentenceIds": [
        2,
        5
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 2"
      ],
      "source": "https://en.wikipedia.org/wiki/Commerce%2C_Missouri",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The Commerce Historical and Genealogy Society houses its museum in an old church on Missouri Street, open the third full weekend each month.",
