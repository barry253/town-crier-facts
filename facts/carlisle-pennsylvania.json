      ],
      "source": "https://www.carlislepa.org/about_us/about_carlisle_borough/history.php",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town takes its name from Carlisle, England, and its old jailhouse was modeled after the Carlisle Citadel.",
      "sourceSentenceIds": [
        18,
        11
      ],
      "sourceLabels": [
