  "facts": [
    {
      "id": 1,
      "text": "Avondale began as a Southern Pacific Railroad station about 20 miles west of Phoenix, perched on the edge of the Sonoran Desert.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.britannica.com/place/Avondale-Arizona"
    },
    {
      "id": 2,
      "text": "When William Moore settled the area in 1880, he named the settlement Coldwater after the nearby river and a local spring.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Avondale%2C_Arizona"
    },
    {
      "id": 3,
      "text": "In the 1880s, Moore opened the Coldwater Stage Station near the Agua Fria crossing, one of the earliest stage stops between Tucson and California.",
      "sourceSentenceIds": [
        9,
        10
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Avondale%2C_Arizona"
    },
    {
      "id": 4,
      "text": "Avondale incorporated in 1946 and has expanded rapidly since the 1980s, becoming a major bedroom suburb of Phoenix.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Avondale%2C_Arizona"
    },
    {
      "id": 5,
      "text": "The Gila River bisects Avondale’s southern edge, where it meets the Agua Fria River coming from the north.",
      "sourceSentenceIds": [
        23
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Avondale%2C_Arizona"
    },
    {
      "id": 6,
      "text": "Avondale enjoys year‑long sunshine, with summer highs routinely above 100°F and occasional heat waves topping 115°F.",
      "sourceSentenceIds": [
        25,
        28,
        29
      ],
