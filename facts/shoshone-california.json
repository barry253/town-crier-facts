  "facts": [
    {
      "id": 1,
      "text": "Shoshone was founded in 1910 by Ralph Jacobus \"Dad\" Fairbanks, a Death Valley businessman.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Shoshone%2C_California",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town grew around a water stop discovered in 1880 by George Lane, becoming a railroad hub for the Tonopah and Tidewater Railroad until 1940.",
      "sourceSentenceIds": [
        12,
        5
      ],
      "sourceLabels": [
        "Web source 2",
        "Wikipedia"
      ],
      "source": "https://digital-desert.com/blog/history-of-shoshone-california/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Shoshone sits at the junction of California State Route 127 and 178, serving as the last service stop before the Furnace Creek area of Death Valley National Park.",
      "sourceSentenceIds": [
        21,
        18
      ],
      "sourceLabels": [
        "Wikipedia",
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Shoshone%2C_California",
      "category": "other",
      "quality": "poor",
      "qualityReason": "location_description"
    },
    {
      "id": 4,
      "text": "The Amargosa Opera House, a historic hotel, now operates as a nonprofit venue that preserves Shoshone’s original character while offering modern comforts.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://inyocountyvisitor.com/shoshone/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Shoshone’s name may refer to the Shoshone people, linking the town to the indigenous heritage of the region.",
      "sourceSentenceIds": [
        17
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Shoshone%2C_California",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The town’s post office opened in 1915, closed briefly in 1920, and reflects the early communication needs of a remote desert community.",
      "sourceSentenceIds": [
        23
