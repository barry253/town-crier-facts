  "facts": [
    {
      "id": 1,
      "text": "Highland Springs began as a streetcar suburb when Edmund Sewell Read founded it in the 1890s along the Seven Pines Railway electric line.",
      "sourceSentenceIds": [
        2,
        9
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 2"
      ],
      "source": "https://en.wikipedia.org/wiki/Highland_Springs%2C_Virginia",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Read named the new cross streets alphabetically after plants, starting with Ash and ending with Spruce, a quirky touch still visible on the map.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Highland_Springs%2C_Virginia",
      "category": "other",
      "quality": "poor",
      "qualityReason": "other"
    },
    {
      "id": 3,
      "text": "A 1,000‑acre tract bought by Read was subdivided into lots, laying the groundwork for the community’s residential layout.",
      "sourceSentenceIds": [
        15
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Highland_Springs%2C_Virginia",
      "category": "other",
      "quality": "poor",
      "qualityReason": "other"
    },
    {
      "id": 4,
      "text": "The historic Highland Springs Trolley Station, photographed in 2025, marks the spot where the streetcar line once stopped for passengers.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Web source 1"
      ],
