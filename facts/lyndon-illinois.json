      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The village once celebrated a real crow named Rocky the Crow as its official mascot.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Lyndon%2C_Illinois",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Early settlers arrived in 1835 from New York, eager to claim frontier land in Whiteside County.",
      "sourceSentenceIds": [
        28,
        29
      ],
      "sourceLabels": [
