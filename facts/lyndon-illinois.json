      ],
      "source": "https://villageoflyndon.org/things-to-do/lyndon-history/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Clamming once played a vital role in Lyndon's economy, with local shell harvests feeding button factories.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
