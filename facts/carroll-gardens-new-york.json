      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The Carroll Gardens branch of the Brooklyn Public Library, a 14,000‑square‑foot Carnegie building designed by William B., opened in 1901 and remains a community hub.",
      "sourceSentenceIds": [
        6,
        24
      ],
      "sourceLabels": [
