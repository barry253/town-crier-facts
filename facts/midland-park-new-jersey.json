  "facts": [
    {
      "id": 1,
      "text": "Midland Park, New Jersey was incorporated as a borough on September 6, 1894, during a period known as the 'Boroughitis' craze in Bergen County.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Midland_Park%2C_New_Jersey",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The name Midland Park comes from the New Jersey Midland Railway, which operated in the area during the 1870s.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Midland_Park%2C_New_Jersey",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "In 1931, Midland Park acquired additional land from Wyckoff through a referendum, expanding its boundaries.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Midland_Park%2C_New_Jersey",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The borough is divided by Prospect Street, a main road that runs north-south through the center of Midland Park.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Midland_Park%2C_New_Jersey",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Wortendyke, a quieter downtown region of Midland Park, is home to longtime retailers and small businesses.",
      "sourceSentenceIds": [
        13
