  "facts": [
    {
      "id": 1,
      "text": "Victoria was founded in the nineteenth century by planter Robert E. Wilson and named after his sister and daughter, who married Frank Wesson, heir to Smith & Wesson.",
      "sourceSentenceIds": [
        1,
        4,
        5,
        6
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 2"
      ],
      "source": "https://en.wikipedia.org/wiki/Victoria%2C_Arkansas",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town’s economy remains rooted in agriculture, historically tied to Wilson’s model villages like Marie, Wilson, and Armorel.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/victoria_arkansas",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Wilson’s operations transformed the region’s swamplands through lumber harvesting, land drainage, railroad construction, and sharecropping communities.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/victoria_arkansas",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The landscape that now hosts Victoria began as extensive swampland and wetlands, drained to create one of the world’s most agriculturally rich regions.",
      "sourceSentenceIds": [
        11
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/victoria_arkansas",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Victoria was part of a plantation empire that eventually spanned about 50,000 acres across the Arkansas Delta.",
      "sourceSentenceIds": [
        5
      ],
