  "facts": [
    {
      "id": 1,
      "text": "Oak Grove was named after a surveying crew ate lunch in a fine grove of oak trees in the northwest part of the tract.",
      "sourceSentenceIds": [
        10,
        26
      ],
      "sourceLabels": [
        "Web source 1",
        "Wikipedia"
      ],
      "source": "https://www.oakgrovecpo.org/about"
    },
    {
      "id": 2,
      "text": "The Oak Grove town site was first platted in 1890 from original donation land claims dating back to the 1830s and 1840s.",
      "sourceSentenceIds": [
        15
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.oakgrovecpo.org/about"
    },
    {
      "id": 3,
      "text": "Oak Grove is an historic unincorporated community in Clackamas County and part of the greater Portland metropolitan area.",
      "sourceSentenceIds": [
        14
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.oakgrovecpo.org/about"
    },
    {
      "id": 4,
      "text": "The Concord School in Oak Grove is a historic building that once served as a local elementary school.",
      "sourceSentenceIds": [
        13
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Oak_Grove%2C_Oregon"
    },
    {
      "id": 5,
      "text": "The local post office first opened in 1904 as Creighton Station to avoid confusion with a stop on the old trolley line.",
      "sourceSentenceIds": [
        23
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.oakgrovecpo.org/about"
    },
    {
      "id": 6,
      "text": "Oak Grove is bordered to the west by the Willamette River, with the cities of West Linn and Lake Oswego on the opposite shore.",
      "sourceSentenceIds": [
        30
      ],
