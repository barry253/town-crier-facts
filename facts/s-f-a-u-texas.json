  "facts": [
    {
      "id": 1,
      "text": "S F A U was chartered by the Texas legislature in 1917, choosing Nacogdoches as its campus location.",
      "sourceSentenceIds": [
        2,
        21
      ],
      "sourceLabels": [
        "Web source 2",
        "Web source 1"
      ],
      "source": "https://www.tshaonline.org/handbook/entries/stephen-f-austin-state-university"
    },
    {
      "id": 2,
      "text": "The university’s name honors Stephen F. Austin, the “Father of Texas,” whose legacy inspired the state’s early settlers.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.tshaonline.org/handbook/entries/stephen-f-austin-state-university"
    },
    {
      "id": 3,
      "text": "In 1944 Congress established the Stephen F. Austin Experimental Forest on campus, the only U.S. forest research station created by federal law.",
      "sourceSentenceIds": [
        24,
        25
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.sfasu.edu/about-sfa"
    },
    {
      "id": 4,
      "text": "S F A U’s campus sits in historic Nacogdoches, a town that once served as Texas’s first capital.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.sfasu.edu/about-sfa"
    },
    {
      "id": 5,
      "text": "The university’s 1924 Austin Building gave rise to Vista Drive, a scenic route that still frames the campus today.",
      "sourceSentenceIds": [
        22
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.sfasu.edu/about-sfa"
    },
    {
      "id": 6,
      "text": "Since 1969, the university has operated a 477‑acre beef and poultry farm, a 200‑acre dairy, and a forestry field station near Lake Sam Rayburn.",
