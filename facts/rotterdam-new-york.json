  "facts": [
    {
      "id": 1,
      "text": "Rotterdam, New York, was founded in 1661 by Dutch settlers who named it after the Dutch city of Rotterdam.",
      "sourceSentenceIds": [
        1,
        10
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Rotterdam%2C_New_York",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town emerged from Schenectady’s third ward when it was officially created on April 14, 1820.",
      "sourceSentenceIds": [
        3,
        26
      ],
      "sourceLabels": [
        "Web source 1",
        "Wikipedia"
      ],
      "source": "https://www.townofrotterdam.gov/our-town/town-history",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "When the Erie Canal opened in 1825, nearby hamlets such as Rotterdam Junction sprang up along its banks.",
      "sourceSentenceIds": [
        11
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.townofrotterdam.gov/our-town/town-history",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "In 1942 Rotterdam adopted the Old World coat of arms and the motto ‘Sterker door Strijd,’ meaning ‘Stronger through Effort.’",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Rotterdam%2C_New_York",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The Dellemont‑Wemple Farm, a historic Dutch‑style farmstead, was listed on the National Register of Historic Places in 1973.",
      "sourceSentenceIds": [
        4
