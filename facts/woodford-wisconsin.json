  "facts": [
    {
      "id": 1,
      "text": "Woodford sits in a valley on the east side of the East Branch Pecatonica River in eastern Lafayette County.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Woodford%2C_Wisconsin"
    },
    {
      "id": 2,
      "text": "Woodford emerged in the 1840s as an unincorporated community of small-scale mining hamlets and farmsteads in Wiota Township.",
      "sourceSentenceIds": [
        19
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/woodford_wisconsin"
    },
    {
      "id": 3,
      "text": "The community of Woodford was formally established with the opening of its post office on October 3, 1888.",
      "sourceSentenceIds": [
        20
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/woodford_wisconsin"
    },
    {
      "id": 4,
      "text": "The arrival of the Illinois Central Railroad's branch line by 1878 boosted the shipment of grain and livestock from Woodford farms.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/woodford_wisconsin"
    },
    {
      "id": 5,
      "text": "Woodford is located within the unglaciated Driftless Area, which contributes to the region's characteristic rolling landscape.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/woodford_wisconsin"
    },
    {
      "id": 6,
      "text": "Rural electrification in the 1950s and 1960s enabled mechanized farming and improved living standards for the people of Woodford.",
      "sourceSentenceIds": [
        25
