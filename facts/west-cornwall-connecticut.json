  "facts": [
    {
      "id": 1,
      "text": "West Cornwall's Covered Bridge, built in 1864, remains in service and is one of only three surviving covered bridges in Connecticut.",
      "sourceSentenceIds": [
        5,
        11,
        12
      ],
      "sourceLabels": [
        "Web source 2",
        "Web source 1"
      ],
      "source": "https://ctvisit.com/listings/town-cornwall"
    },
    {
      "id": 2,
      "text": "West Cornwall sits in the foothills of the Berkshire Mountains and was named after Cornwall in England.",
      "sourceSentenceIds": [
        9,
        10
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.explorecornwallct.com/"
    },
    {
      "id": 3,
      "text": "The town’s Mohawk State Forest and ski area make it often called the “Greenest Town in Connecticut.”.",
      "sourceSentenceIds": [
        13
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.explorecornwallct.com/"
    },
    {
      "id": 4,
      "text": "Music Mountain, America's oldest continuing summer chamber music festival, occupies 120 acres in West Cornwall and its concert hall is on the National Register of Historic Places.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.explorecornwallct.com/"
    },
    {
      "id": 5,
      "text": "The Cornwall Library hosts a two‑part weekend event featuring a speaker and garden tours, drawing visitors each June.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.explorecornwallct.com/"
    },
    {
      "id": 6,
      "text": "The annual Cornwall Agricultural Fair, held on the village green, has been a staple of West Cornwall since 1933.",
      "sourceSentenceIds": [
