    {
      "id": 1,
      "text": "Kirkpatrick takes its name from the Kirkpatrick family, early settlers who arrived in the 1850s to farm and raise livestock.",
      "sourceSentenceIds": [
        14
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/kirkpatrick_oregon"
    },
    {
      "id": 2,
      "text": "European-American pioneers settled Kirkpatrick in the late 19th century, following the migration patterns of the Oregon Trail.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/kirkpatrick_oregon"
    },
    {
      "id": 3,
      "text": "Kirkpatrick is located within the Columbia Plateau ecoregion, featuring expansive rolling wheat fields and arid lowlands.",
      "sourceSentenceIds": [
        28
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/kirkpatrick_oregon"
    },
    {
      "id": 4,
      "text": "The community of Kirkpatrick shares a border with the Umatilla Indian Reservation to the east.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/kirkpatrick_oregon"
    },
    {
      "id": 5,
      "text": "World War II labor shortages prompted the use of migrant workers to sustain wheat production in rural communities like Kirkpatrick.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/kirkpatrick_oregon"
    },
    {
      "id": 6,
      "text": "Kirkpatrick sits at an elevation of 1,306 feet above sea level in northeastern Oregon.",
