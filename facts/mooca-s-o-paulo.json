  "facts": [
    {
      "id": 1,
      "text": "Mooca is one of São Paulo's oldest boroughs, dating back to the Jesuit mission of 1554.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://en-academic.com/dic.nsf/enwiki/2205927",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The Amácio Mazzaropi museum preserves memories of Mooca's immigrant golden age and honors the comedian born to an Italian father.",
      "sourceSentenceIds": [
        2,
        3
      ],
      "sourceLabels": [
        "Web source 2",
        "Wikipedia"
      ],
      "source": "https://en-academic.com/dic.nsf/enwiki/2205927",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "In 1910, two thirds of Mooca's residents were Italian, reflecting the district's strong immigrant roots.",
      "sourceSentenceIds": [
        23
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Mooca_(district_of_S%C3%A3o_Paulo)",
      "category": "people",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Mooca's industrial boom began in the early 1900s when factories replaced farms, turning the quiet plains into a working‑class hub.",
      "sourceSentenceIds": [
        21
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Mooca_(district_of_S%C3%A3o_Paulo)",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The district hosts four metro stations—Brás, Bresser‑Mooca, Belém, and Vila Prudente—linking it to São Paulo's broader network.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Mooca_(district_of_S%C3%A3o_Paulo)",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Juventus Stadium, home of Clube Atlético Juventus, sits in Mooca and reflects the neighborhood's deep football tradition.",
      "sourceSentenceIds": [
        25
      ],
