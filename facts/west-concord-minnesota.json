  "facts": [
    {
      "id": 1,
      "text": "West Concord was platted on June 1, 1885, by a Reverend, marking the town’s formal founding.",
      "sourceSentenceIds": [
        13,
        19
      ],
      "sourceLabels": [
        "Web source 2",
        "Wikipedia"
      ],
      "source": "https://grokipedia.com/page/west_concord_minnesota",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "West Concord earned its name by lying west of the original Concord and honoring Concord, New Hampshire.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/west_concord_minnesota",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The railroad depot became the town’s nucleus, drawing settlers and goods while roads and homes sprouted across the prairie.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/west_concord_minnesota",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The West Concord Historical Society & Community Center sits in a 1902 schoolhouse that now hosts ten museum display rooms.",
      "sourceSentenceIds": [
        6,
        7,
        11
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://westconcordhistoricalsociety.org/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "On January 19, 2021, West Concord High School was listed on the National Register of Historic Places.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://westconcordhistoricalsociety.org/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "West Concord’s post office has been in continuous operation since 1885, serving the community for over a century.",
