      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Shard End Library, opened in 1967, was the first in Birmingham to issue plastic membership cards instead of traditional cardboard tickets.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Shard_End",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The community centre on Packington Avenue, built on a former petrol station site, now serves as a hub for local events and services.",
      "sourceSentenceIds": [
        11,
        9
      ],
      "sourceLabels": [
        "Wikipedia",
