  "facts": [
    {
      "id": 1,
      "text": "San Luis, Colorado, was founded on April 5 1851 by ten Hispanic settlers from the Taos Valley, making it the state’s oldest continuously occupied town.",
      "sourceSentenceIds": [
        4,
        6
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/San_Luis,_Colorado",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town’s name, San Luis de la Culebra, honors Saint Louis and references the nearby Culebra River, all within the historic Sangre de Cristo Land Grant.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/San_Luis,_Colorado",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "In 1863, San Luis became the county seat of Costilla County after the Colorado Territory was organized in 1861.",
      "sourceSentenceIds": [
        15
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/San_Luis,_Colorado",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The San Luis People’s Ditch, Colorado’s oldest continuously operating irrigation ditch, still channels water to farms that have relied on it since the 1850s.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/San_Luis,_Colorado",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "A 250‑foot mesa above town hosts the Stations of the Cross Shrine, a pilgrimage site that visitors can reach by a half‑mile trail or a short drive.",
      "sourceSentenceIds": [
        21,
        22,
        23
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/San_Luis%2C_Colorado",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "During the autumn of 1851, Ute warriors attacked the settlers while they built the irrigation ditch, killing three men and forcing a temporary winter retreat.",
      "sourceSentenceIds": [
        19
      ],
      "sourceLabels": [
