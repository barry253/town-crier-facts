  "facts": [
    {
      "id": 1,
      "text": "Beech Bottom is a village in Brooke County, West Virginia, situated along the banks of the Ohio River.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Beech_Bottom%2C_West_Virginia"
    },
    {
      "id": 2,
      "text": "The community of Beech Bottom is named for the wide valley that was formerly home to many beech trees.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://wvexplorer.com/travel/communities/cities-towns/beech-bottom-west-virginia/"
    },
    {
      "id": 3,
      "text": "Housing construction for the village of Beech Bottom first began in 1917 on a former three hundred acre farm.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.beechbottomwv.org/?pg=history"
    },
    {
      "id": 4,
      "text": "An early steel company once owned and built the houses, post office, general store, and churches in Beech Bottom.",
      "sourceSentenceIds": [
        26
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.beechbottomwv.org/?pg=history"
    },
    {
      "id": 5,
      "text": "A unique streetcar system once ran along the main road of Beech Bottom, parallel to the Ohio River.",
      "sourceSentenceIds": [
        29
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.beechbottomwv.org/?pg=history"
    },
    {
      "id": 6,
      "text": "In 1922, the main road through Beech Bottom became one of the first four West Virginia state roads to be numbered.",
