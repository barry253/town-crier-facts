    },
    {
      "id": 2,
      "text": "The lake spans 348.1 acres across three distinct basins, making it the third‑largest natural lake in Snohomish County.",
      "sourceSentenceIds": [
        16
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://snohomishcountywa.gov/5385/Roesiger"
    },
    {
      "id": 3,
      "text": "Lake Roesiger sits seven miles east of Lake Stevens, tucked in the foothills of the Cascade Mountains.",
      "sourceSentenceIds": [
        15
