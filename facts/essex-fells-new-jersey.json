      ],
      "source": "https://en.wikipedia.org/wiki/Essex_Fells%2C_New_Jersey",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The borough was incorporated on March 31, 1902, after separating from Caldwell Township, now Fairfield Township.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Essex_Fells%2C_New_Jersey",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Commercial activity is restricted to a single three‑story building that looks like a house and two small workshops.",
