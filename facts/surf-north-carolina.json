    },
    {
      "id": 2,
      "text": "Concrete observation towers from Navy Operation Bumblebee still dot Surf City’s shoreline.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/Surf_City,_North_Carolina"
    },
    {
      "id": 3,
      "text": "When military use ended, private owners reclaimed the island, leaving the towers as enduring symbols.",
