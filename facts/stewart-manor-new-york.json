  "facts": [
    {
      "id": 1,
      "text": "Stewart Manor’s name comes from the nearby LIRR station, itself named after Alexander Turney Stewart, the railroad’s founder.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Stewart_Manor%2C_New_York",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The village’s first major development in 1925 was called Sunrise Gardens, a name that later changed to Stewart Manor after incorporation.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Stewart_Manor%2C_New_York",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Residents fought annexation by New Hyde Park in 1927, and the village incorporated to gain home rule and control its infrastructure.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Stewart_Manor%2C_New_York",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The original municipal building, built in 1936, still houses the village government and firehouse, and it was expanded in 1987 and again in 2002.",
      "sourceSentenceIds": [
        10,
        12,
        13
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Stewart_Manor%2C_New_York",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Stewart Manor sits within the Hook Creek Watershed, part of the larger Long Island Sound/Atlantic Ocean watershed.",
      "sourceSentenceIds": [
        15
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Stewart_Manor%2C_New_York",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The Stewart Manor Country Club, a long‑standing venue for weddings and community events, is a notable local landmark.",
      "sourceSentenceIds": [
        4
      ],
