      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The Laguna Pueblo, home to Seama, traces its Keresan roots back to at least 3000 BCE, with the modern community founded in 1699.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 2"
      ],
