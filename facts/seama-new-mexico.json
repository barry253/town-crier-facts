      "quality": "good"
    },
    {
      "id": 2,
      "text": "Pottery fragments from Punyana and Old Laguna date to the late 13th century, showing Acoma and Mesa Verde black‑on‑white styles.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 2"
      ],
