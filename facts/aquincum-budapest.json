  "facts": [
    {
      "id": 1,
      "text": "Aquincum was originally settled by the Eravisci, a Celtic tribe in the first centuries BCE.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Aquincum",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "A 500‑strong cavalry unit arrived around AD 41–54, and by AD 89 the Roman legion Legio II Adiutrix, 6,000 men, was stationed there.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Aquincum",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Aquincum became the capital of Pannonia Inferior after AD 103 and later earned municipal status under Hadrian and colonia status under Severus.",
      "sourceSentenceIds": [
        7,
        8
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Aquincum",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The city hosted emperors and served as a military base on the limes, protecting the frontier against the Iazyges.",
      "sourceSentenceIds": [
        6,
        9
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Aquincum",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Central heating, public baths, a Mithraeum, and two amphitheatres—civil and military—show Aquincum's advanced Roman architecture.",
      "sourceSentenceIds": [
        17,
        18
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Aquincum",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The Aquincum Museum displays a reconstruction of the ancient hydraulic system and Roman houses, letting visitors see how the city ran.",
      "sourceSentenceIds": [
        19,
        20
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Aquincum",
      "category": "landmark",
      "quality": "good"
    }
