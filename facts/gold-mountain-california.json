  "facts": [
    {
      "id": 1,
      "text": "Empire Mine State Historic Park houses one of California’s oldest, deepest, and richest gold mines, a legacy of the Gold Rush era.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.parks.ca.gov/EmpireMine/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The park’s mine network stretches 367 miles of abandoned and flooded shafts, a vast underground labyrinth beneath the town.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.parks.ca.gov/EmpireMine/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "A 45‑minute guided tour of the historic grounds is included with your entry fee, letting you see the mine’s highlights.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.parks.ca.gov/EmpireMine/",
      "category": "other",
      "quality": "poor",
      "qualityReason": "vague"
    },
    {
      "id": 4,
      "text": "Dogs are welcome on roads and trails within the park, but they cannot enter historic buildings or mine shafts.",
      "sourceSentenceIds": [
        5,
        6
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.parks.ca.gov/EmpireMine/",
      "category": "other",
      "quality": "poor",
      "qualityReason": "vague"
    },
    {
      "id": 5,
      "text": "Bodie State Historic Park, nearby, is celebrated as one of California’s best preserved ghost towns, echoing Gold Rush history.",
      "sourceSentenceIds": [
