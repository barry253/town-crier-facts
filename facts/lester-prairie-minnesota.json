  "facts": [
    {
      "id": 1,
      "text": "Lester Prairie was founded in 1886 when the Great Northern Railroad arrived, and it was named after pioneer Maria Lester, a niece of President John Adams.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/lester_prairie_minnesota",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The city sits along the South Fork of the Crow River, which shapes local hydrology and provides a defining riparian feature amid agricultural surroundings.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/lester_prairie_minnesota",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The earliest recorded settlement in the area was in August 1856 when Maria Lester and family built a log cabin, marking the first permanent homestead.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/lester_prairie_minnesota",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The town was incorporated as a village on September 13, 1888, after initial businesses like a lumberyard and general store opened.",
      "sourceSentenceIds": [
        11
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/lester_prairie_minnesota",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The climate is humid continental (Köppen Dfb), with cold snowy winters and warm humid summers typical of south-central Minnesota.",
      "sourceSentenceIds": [
        6
      ],
