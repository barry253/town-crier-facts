  "facts": [
    {
      "id": 1,
      "text": "Paradise Hill was established in 1954 as a planned residential development on the shores of Tenkiller Ferry Lake.",
      "sourceSentenceIds": [
        8,
        14
      ],
      "sourceLabels": [
        "Web source 2",
        "Wikipedia"
      ],
      "source": "https://grokipedia.com/page/paradise_hill_oklahoma"
    },
    {
      "id": 2,
      "text": "Paradise Hill grew quickly in its early years, with forty-seven permanent homes built by 1962.",
      "sourceSentenceIds": [
        15
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Paradise_Hill%2C_Oklahoma"
    },
    {
      "id": 3,
      "text": "Paradise Hill more than doubled its physical size by 1969 by annexing adjacent land.",
      "sourceSentenceIds": [
        17
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Paradise_Hill%2C_Oklahoma"
    },
    {
      "id": 4,
      "text": "Paradise Hill is located within the Fort Smith, Arkansas-Oklahoma Metropolitan Statistical Area.",
      "sourceSentenceIds": [
        13
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Paradise_Hill%2C_Oklahoma"
    },
    {
      "id": 5,
      "text": "Water services for Paradise Hill are provided through a community-managed entity called the Paradise Hill Water Users Association.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/paradise_hill_oklahoma"
    },
    {
