  "facts": [
    {
      "id": 1,
      "text": "Amesville's Coonskin Library Museum opened in May 1994 in the former cafeteria of the Amesville Grade School.",
      "sourceSentenceIds": [
        11
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Amesville%2C_Ohio",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The library began in 1803 as the first in Athens County, sparked by settlers’ desire for books at a town meeting.",
      "sourceSentenceIds": [
        12,
        19
      ],
      "sourceLabels": [
        "Web source 1",
        "Wikipedia"
      ],
      "source": "https://www.islands.com/2073493/amesville-ohio-hidden-village-peaceful-hill-town-brimming-artisan-crafts-tranquility/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The original book collection was purchased for just $73.50, consisting of 51 titles on religion, travel, biography and history.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Amesville%2C_Ohio",
      "category": "other",
      "quality": "poor",
      "qualityReason": "vague"
    },
    {
      "id": 4,
      "text": "In 1994, the Coonskin Library Museum became a centerpiece celebrating Amesville's history and community pride.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.islands.com/2073493/amesville-ohio-hidden-village-peaceful-hill-town-brimming-artisan-crafts-tranquility/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Amesville was laid out in 1837 and named after Fisher Ames, who helped secure federal support for the Ohio Company of Associates.",
      "sourceSentenceIds": [
        17,
        18
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Amesville%2C_Ohio",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The village hosts events ranging from live performances to artisan craft booths to movie nights, all celebrating local talent and history.",
      "sourceSentenceIds": [
