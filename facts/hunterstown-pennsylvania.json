  "facts": [
    {
      "id": 1,
      "text": "Hunterstown was originally platted in 1749 or 1750 by Irish immigrant Captain David Hunter as Woodstock, later renamed Hunterstown in 1800 to honor him.",
      "sourceSentenceIds": [
        1,
        4
      ],
      "sourceLabels": [
        "Web source 2",
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/hunterstown_pennsylvania",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town sits about 5 to 7 miles northeast of Gettysburg, placing it close to the Gettysburg National Military Park.",
      "sourceSentenceIds": [
        18,
        24
      ],
      "sourceLabels": [
        "Web source 2",
        "Wikipedia"
      ],
      "source": "https://grokipedia.com/page/hunterstown_pennsylvania",
      "category": "other",
      "quality": "poor",
      "qualityReason": "location_description"
    },
    {
      "id": 3,
      "text": "A brief cavalry skirmish during the Battle of Gettysburg in 1863 occurred at Hunterstown, now called the Battle of Hunterstown.",
      "sourceSentenceIds": [
        26
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Hunterstown%2C_Pennsylvania",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The Great Conewago Presbyterian Church and the Hunterstown Historic District are listed on the National Register of Historic Places.",
      "sourceSentenceIds": [
        25
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Hunterstown%2C_Pennsylvania",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Straban Township’s emblem, designed by Robert McIlhenny, features a stylized American Goldfinch, a bird common year‑round in the township’s fields and gardens.",
