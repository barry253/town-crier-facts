    {
      "id": 1,
      "text": "Aguanga’s name comes from the Luiseño word 'awáanga,' which means 'dog place'.",
      "sourceSentenceIds": [
        3,
        22
      ],
      "sourceLabels": [
        "Web source 1",
        "Wikipedia"
      ],
      "source": "https://grokipedia.com/page/Aguanga,_California",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Aguanga was one of Riverside County’s original 40 election precincts when the county formed in 1893.",
      "sourceSentenceIds": [
        1,
        4
      ],
      "sourceLabels": [
        "Web source 1",
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/Aguanga,_California",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The town sits where State Route 79 meets State Route 371, tracing the historic Butterfield Overland Mail path.",
      "sourceSentenceIds": [
        7,
        10
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 2"
      ],
      "source": "https://en.wikipedia.org/wiki/Aguanga%2C_California",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "In 1858 a Butterfield Overland Mail station, first called Tejungo, stood 1.7 miles west of today’s post office.",
      "sourceSentenceIds": [
        15,
        16
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Aguanga%2C_California",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The 1950s saw the dirt road that became State Route 371 paved, linking Aguanga to Route 79 and the wider Southern California network.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/Aguanga,_California",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Early schools dating before 1870 and late‑19th‑century homestead stores illustrate Aguanga’s pioneer settlement pattern.",
