  "facts": [
    {
      "id": 1,
      "text": "Potecasi Creek starts where Ramsey Creek meets Wiccacanee Swamp, about two miles east of Jackson, then flows east into Hertford County to meet the Meherrin River.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Potecasi_Creek",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The creek stretches 41.28 miles, making it a 4th‑order tributary of the Meherrin River.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Potecasi_Creek",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "No other U.S. stream bears the name Potecasi, making it unique nationwide.",
