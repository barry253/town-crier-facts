  "facts": [
    {
      "id": 1,
      "text": "The Nehalem Bay region surrounding Bayside Gardens was inhabited for over twelve thousand years by the Tillamook people.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/bayside_gardens_oregon"
    },
    {
      "id": 2,
      "text": "Bayside Gardens borders Nehalem Bay and sits at the foot of Neahkahnie Mountain.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/bayside_gardens_oregon"
    },
    {
      "id": 3,
      "text": "Early settlers in the mid-nineteenth century cleared dense Douglas fir forests near Bayside Gardens for dairy farms and small mills.",
      "sourceSentenceIds": [
        15
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/bayside_gardens_oregon"
    },
    {
      "id": 4,
      "text": "Logging became a foundational industry in the 1860s, with old-growth trees transported by river rafts to Nehalem Bay.",
      "sourceSentenceIds": [
        16
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/bayside_gardens_oregon"
    },
    {
      "id": 5,
      "text": "Bayside Gardens emerged as a distinct community during the mid-twentieth century, coinciding with post-World War Two suburban expansion.",
      "sourceSentenceIds": [
        17
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/bayside_gardens_oregon"
    },
    {
      "id": 6,
      "text": "The eastern boundary of Bayside Gardens provides direct access to the estuary where the Nehalem River meets the Pacific Ocean.",
      "sourceSentenceIds": [
        28
