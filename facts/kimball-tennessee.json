  "facts": [
    {
      "id": 1,
      "text": "Kimball was founded in 1890 as a planned industrial city by businessman Hannibal Kimball, who envisioned wide streets, parks, and factories to harness the nearby Tennessee River.",
      "sourceSentenceIds": [
        5,
        6
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Kimball%2C_Tennessee",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town’s ambitious plans stalled after the 1893 Panic and Kimball’s death in 1895, leaving the railroad depot the only lasting structure until about 1913.",
      "sourceSentenceIds": [
        3,
        7
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/kimball_tennessee",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Before becoming Kimball, the settlement was called Wallview, a name it held until 1887 when it was renamed to honor its founder.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/kimball_tennessee",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "An EF‑2 tornado struck Kimball on November 14, 2007, damaging buildings along a two‑mile path and injuring nine people.",
      "sourceSentenceIds": [
        24,
        25
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Kimball%2C_Tennessee",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Kimball sits in the Sequatchie Valley of Marion County, a region once a loosely knit farming community before the town’s planned development.",
      "sourceSentenceIds": [
        1
      ],
