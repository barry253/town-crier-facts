  "facts": [
    {
      "id": 1,
      "text": "North Pitcher is a hamlet in the town of Pitcher, Chenango County, New York.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/North_Pitcher%2C_New_York",
      "category": "other",
      "quality": "poor",
      "qualityReason": "other"
    },
    {
      "id": 2,
      "text": "The hamlet sits along New York State Route 26 and the Otselic River, about 16 miles northwest of Norwich.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/north_pitcher_new_york",
      "category": "other",
      "quality": "poor",
      "qualityReason": "location_description"
    },
    {
      "id": 3,
      "text": "The area was first settled in 1791 by pioneers from Dutchess County, Connecticut, Massachusetts, and near Schenectady.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/north_pitcher_new_york",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "North Pitcher developed modest commerce in the 1820s, with the first merchant Kinney opening a store after the War of 1812.",
      "sourceSentenceIds": [
        13
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/north_pitcher_new_york",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The town of Pitcher was formally established on February 13, 1827, carved from German and Lincklaen, and later enlarged in 1833.",
      "sourceSentenceIds": [
        27
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/north_pitcher_new_york",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The hamlet is named after Nathaniel Pitcher, New York’s eighth governor who briefly served after DeWitt Clinton’s death.",
      "sourceSentenceIds": [
        30
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/north_pitcher_new_york",
      "category": "etymology",
      "quality": "good"
    }
