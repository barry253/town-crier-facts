  "facts": [
    {
      "id": 1,
      "text": "Grass Valley was named for the towering grass that first impressed settlers when the post office was founded in 1882.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://crookcountyhistorycenter.org/2025/01/grass-valley-oregon/"
    },
    {
      "id": 2,
      "text": "Early settlers described the grass in Grass Valley as being so tall it stood over a man's head, even on horseback.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.grassvalleyoregon.com/history"
    },
    {
      "id": 3,
      "text": "Grass Valley served as a hub for workers and surveyors during the construction of railroads up the Deschutes River from 1909 to 1911.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://crookcountyhistorycenter.org/2025/01/grass-valley-oregon/"
    },
    {
      "id": 4,
      "text": "Rolling acres of golden wheat surround Grass Valley each summer as a testament to the hard work of early settlers.",
      "sourceSentenceIds": [
        11
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.grassvalleyoregon.com/history"
    },
    {
      "id": 5,
      "text": "Oregon Raceway Park, a dedicated road course for automobile and motorcycle events, is located just east of Grass Valley.",
      "sourceSentenceIds": [
        12
      ],
