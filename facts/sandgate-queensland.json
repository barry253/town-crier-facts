      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town’s railway station, opened 1882, became the heart of Sandgate’s growth and still sits at the trail’s start.",
      "sourceSentenceIds": [
        30,
        11
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Sandgate%2C_Queensland",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "In 1909 the original Sandgate station moved to its current location, a move that reshaped the suburb’s layout.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.brisbane.qld.gov.au/events-arts-and-culture/art-and-culture/heritage-trails/sandgate-heritage-trail",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The Sandgate Museum, run by volunteers, hosts monthly Morning Teas with History and guided walks that keep local stories alive.",
      "sourceSentenceIds": [
        2,
        13
      ],
      "sourceLabels": [
        "Web source 2",
