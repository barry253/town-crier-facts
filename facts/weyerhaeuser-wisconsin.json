  "facts": [
    {
      "id": 1,
      "text": "Weyerhaeuser was named after Frederick Weyerhaeuser, a German-American lumber tycoon whose timber operations shaped the region's economic landscape.",
      "sourceSentenceIds": [
        1,
        7
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 2"
      ],
      "source": "https://en.wikipedia.org/wiki/Weyerhaeuser%2C_Wisconsin"
    },
    {
      "id": 2,
      "text": "The village's origins are rooted in the late nineteenth-century logging boom, when settlers flocked to Rusk County's vast white pine forests.",
      "sourceSentenceIds": [
        3,
        4
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/weyerhaeuser_wisconsin"
    },
    {
      "id": 3,
      "text": "Weyerhaeuser sits beneath the sunny slopes of the Blue Hills and calls itself the biggest small town in the state.",
      "sourceSentenceIds": [
        24
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://ruskcounty.org/?SEC=D2EEB27E-3CA0-422B-BA6D-1AD52BD6E986&DE=56921DBC-75AF-450B-B065-EA07C6B8754A"
    },
    {
      "id": 4,
      "text": "The Weyerhaeuser Depot was first constructed in 1884 along the Soo Line Railroad.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/weyerhaeuser_wisconsin"
    },
    {
      "id": 5,
      "text": "Weyerhaeuser hosts an annual Booster Days celebration during Labor Day weekend, featuring a parade, church dinner, and fireworks.",
      "sourceSentenceIds": [
        25,
