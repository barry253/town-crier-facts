  "facts": [
    {
      "id": 1,
      "text": "Waldoboro’s historic buildings and architecture celebrate a rich shipbuilding past, blending colonial and maritime styles along the Medomak River.",
      "sourceSentenceIds": [
        1,
        3
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://maine.com/waldoboro",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "German settlers founded Waldoboro in the 18th century, and the Old German Church across the Medomak River remains the plainest reminder of that heritage.",
      "sourceSentenceIds": [
        6,
        8
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://maine.com/waldoboro",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "On June 29, 1773, Waldoboro was incorporated as Waldoborough, honoring its original proprietor.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Waldoboro%2C_Maine",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The arrival of the Knox and Lincoln Railroad spurred Waldoboro’s growth, linking the town to regional trade routes.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Waldoboro%2C_Maine",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The Waldoboro Historical Society and Museum showcase the town’s heritage through artifacts and exhibits on its colonial and maritime past.",
      "sourceSentenceIds": [
        13,
        17
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://maine.com/waldoboro",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Waldoboro derives its name from General Samuel Waldo, who acquired the land patent in 1729, renaming it the Waldo Patent.",
      "sourceSentenceIds": [
        25
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Waldoboro%2C_Maine",
      "category": "etymology",
      "quality": "good"
    }
