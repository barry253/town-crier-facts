  "facts": [
    {
      "id": 1,
      "text": "Rustic Acres Colony was established in 2003 as a daughter colony of the Wolf Creek Hutterite Colony.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/rustic_acres_colony_south_dakota"
    },
    {
      "id": 2,
      "text": "Rustic Acres Colony operates as a communal agricultural community belonging to the Schmiedeleut Group 2 of the Hutterian Brethren.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/rustic_acres_colony_south_dakota"
    },
    {
      "id": 3,
      "text": "Residents of Rustic Acres Colony share all resources and hold no private property, following Anabaptist principles of collective ownership.",
      "sourceSentenceIds": [
        29
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/rustic_acres_colony_south_dakota"
    },
    {
      "id": 4,
      "text": "The colony occupies roughly 5,000 acres of farmland dedicated to communal agricultural use in Lake County.",
      "sourceSentenceIds": [
        11
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/rustic_acres_colony_south_dakota"
    },
    {
      "id": 5,
      "text": "Communal living at Rustic Acres Colony includes shared dining halls and apartments clustered centrally without individual kitchens.",
      "sourceSentenceIds": [
        30
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/rustic_acres_colony_south_dakota"
    },
    {
      "id": 6,
      "text": "Rustic Acres Colony has adapted to modern farming by investing in advanced swine production units and livestock facilities.",
      "sourceSentenceIds": [
        20
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/rustic_acres_colony_south_dakota"
