  "facts": [
    {
      "id": 1,
      "text": "Perry Park was named after John Perry, president of the Kansas Pacific Railroad, who bought the 4,000‑acre Pleasant Park.",
      "sourceSentenceIds": [
        1,
        10
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 2"
      ],
      "source": "https://en.wikipedia.org/wiki/Perry_Park%2C_Colorado",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The area was originally inhabited by Ute, Kiowa, Arapaho, and Cheyenne tribes before settlers arrived.",
      "sourceSentenceIds": [
        3,
        8
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 2"
      ],
      "source": "https://en.wikipedia.org/wiki/Perry_Park%2C_Colorado",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "In 1888 investors formed the Red Stone Town, Land & Mining Company to turn Pleasant Park into a resort, building a hotel and Lake Wauconda.",
      "sourceSentenceIds": [
        16,
        17,
        18
      ],
      "sourceLabels": [
        "Wikipedia",
        "Wikipedia",
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Perry_Park%2C_Colorado",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The hotel burned down, but the Roberts Manor House survives as the clubhouse for Perry Park Country Club.",
      "sourceSentenceIds": [
        22,
        20
      ],
      "sourceLabels": [
        "Wikipedia",
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Perry_Park%2C_Colorado",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Perry Park sits at the foot of the Rampart Range, 15 miles southwest of Castle Rock, overlooking the Fountain Formation red sandstone.",
