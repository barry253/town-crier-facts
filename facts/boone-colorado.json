  "facts": [
    {
      "id": 1,
      "text": "Boone began as Booneville during the Pikes Peak Gold Rush, founded by Albert Gallatin Boone, a grandson of the famed explorer Daniel Boone.",
      "sourceSentenceIds": [
        1,
        3,
        27
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Boone%2C_Colorado",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The first post office opened on January 2, 1863, and the name was shortened to Boone on December 5, 1891.",
      "sourceSentenceIds": [
        10,
        13
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Boone%2C_Colorado",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Boone’s town hall now sits in the historic Santa Fe Railroad Depot, a relic of the town’s rail past.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.uncovercolorado.com/towns/boone/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Perched at 4,465 feet on the Arkansas River, Boone lies roughly twenty miles east of Pueblo.",
      "sourceSentenceIds": [
        25,
        28
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.uncovercolorado.com/towns/boone/",
      "category": "other",
      "quality": "poor",
      "qualityReason": "location_description"
    },
    {
      "id": 5,
      "text": "After nearly a century of informal settlement, Boone was officially incorporated on September 22, 1956.",
      "sourceSentenceIds": [
        28,
