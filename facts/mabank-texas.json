  "facts": [
    {
      "id": 1,
      "text": "Mabank was founded when ranchers Mason and Eubank set aside a square mile of land after the Southern Pacific Railroad bypassed nearby Lawndale.",
      "sourceSentenceIds": [
        12,
        11
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.cityofmabanktx.org/172/History",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town’s original name “Lawn City” honored a cotton fabric sold by early merchant Jones before it was renamed Mabank.",
      "sourceSentenceIds": [
        6,
        7
      ],
      "sourceLabels": [
        "Web source 1",
        "Web source 2"
      ],
      "source": "https://www.cityofmabanktx.org/172/History",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Mabank’s local newspaper, the Lawndale Courier, rebranded itself as the Mabank Courier to reflect the new community.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Mabank%2C_Texas",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The town’s early civic life included three churches, a Masonic lodge, a public library, and a baseball club, all founded within the first decade.",
      "sourceSentenceIds": [
        27
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.cityofmabanktx.org/172/History",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Mabank sits in both Henderson and Kaufman counties, a fact noted in its early 1900s history as the town expanded.",
      "sourceSentenceIds": [
        30
