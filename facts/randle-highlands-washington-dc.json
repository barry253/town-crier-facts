  "facts": [
    {
      "id": 1,
      "text": "Colonel Arthur E. Randle founded Randle Highlands in 1890, moving his family into a Greek Revival house at 2909 Pennsylvania Avenue SE.",
      "sourceSentenceIds": [
        27
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://randlehighlands.weebly.com/history.html",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Randle Highlands Elementary, the neighborhood’s only school, was first built in 1911 and rebuilt in 2002.",
      "sourceSentenceIds": [
        16,
        17
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Randle_Highlands",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "East of the Anacostia River, Randle Highlands is bounded by Pennsylvania Avenue SE to the north and Minnesota Avenue to the west.",
      "sourceSentenceIds": [
        13,
        22
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Randle_Highlands",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The historic fire station at 2813 Pennsylvania Avenue SE, now Engine House #19, continues to serve the community.",
      "sourceSentenceIds": [
        5,
        8
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://randlehighlands.weebly.com/history.html",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Potomac Avenue Metrobus lines stop at Potomac Avenue Station, the nearest Metrorail stop about 1.5 miles west of Randle Highlands.",
      "sourceSentenceIds": [
        6,
        7
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Randle_Highlands",
      "category": "transport",
      "quality": "poor",
      "qualityReason": "location_description"
    },
    {
      "id": 6,
      "text": "Randle Highlands earned the nickname “Southeast White House” for its Greek Revival home, echoing the presidential residence 4.5 miles away.",
