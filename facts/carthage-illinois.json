  "facts": [
    {
      "id": 1,
      "text": "Carthage was founded in 1837 as the seat of Hancock County, and its historic downtown center is still called Carthage Square.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://carthage-il.com/local/history/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "In 1844, the Old Carthage Jail became the site of Joseph Smith’s murder, a pivotal moment in Latter Day Saint history.",
      "sourceSentenceIds": [
        5,
        14
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Carthage%2C_Illinois",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The courthouse and surrounding shops were listed on the National Register of Historic Places in 1986, preserving the town’s 19th‑century charm.",
      "sourceSentenceIds": [
        10,
        15
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Carthage%2C_Illinois",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The Kibbe Hancock Heritage Museum, housed in a former bank, showcases local artifacts and celebrates Carthage’s regional history.",
      "sourceSentenceIds": [
        9,
        21
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 2"
      ],
      "source": "https://en.wikipedia.org/wiki/Carthage%2C_Illinois",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "A log cabin built in 1833 served as the first county courthouse when the seat moved from Montebello to Carthage.",
      "sourceSentenceIds": [
        26
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Carthage%2C_Illinois",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Carthage’s name likely derives from Carthage, Tennessee, rather than the ancient North African city.",
      "sourceSentenceIds": [
        6,
        22
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 2"
      ],
      "source": "https://en.wikipedia.org/wiki/Carthage%2C_Illinois",
      "category": "etymology",
      "quality": "good"
    }
