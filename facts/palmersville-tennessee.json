  "facts": [
    {
      "id": 1,
      "text": "Palmersville was founded in 1842 on land owned by Smith Palmer, after whom the town is named.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/palmersville_tennessee",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The settlement grew around a grist and saw mill, general stores, a church, and fraternal societies, reflecting early agricultural roots.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/palmersville_tennessee",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "In 1891, Minida Normal College opened in Palmersville, offering a B.A. degree and marking the town’s first higher‑education institution.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/palmersville_tennessee",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Palmersville’s early 20th‑century economy included a cheese factory, flour and sawmills, a drug store, bank, telephone switchboard, and blacksmith shop, showing diverse small‑scale industry.",
      "sourceSentenceIds": [
        11
