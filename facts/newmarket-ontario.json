  "facts": [
    {
      "id": 1,
      "text": "Newmarket’s historic downtown Main Street once housed two grist-mills, a brewery, a distillery, a tannery, a foundry, a carding machine, and a cloth factory.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Newmarket%2C_Ontario",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "In 1853, the first train pulled into Newmarket on the Toronto, Simcoe & Lake Huron Union Railroad, the first railway in Upper Canada.",
      "sourceSentenceIds": [
        13
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Newmarket%2C_Ontario",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Fairy Lake, a former mill pond on the East Holland River, sits in the center of Newmarket and is managed by the Lake Simcoe Region Conservation Authority.",
      "sourceSentenceIds": [
        27
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Newmarket%2C_Ontario",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The town’s Summerfest on Main was named Best Event in Canada in 2026, earning Newmarket a national award.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.newmarket.ca/",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The historic Yonge-Davis intersection and the Southlake Regional Health Centre are key landmarks in Newmarket’s downtown core.",
