  "facts": [
    {
      "id": 1,
      "text": "Pottsville was founded in 1806 by John Potts after he purchased a furnace, marking the town’s birth in the anthracite region.",
      "sourceSentenceIds": [
        4,
        5
      ],
      "sourceLabels": [
        "Web source 1",
        "Web source 2"
      ],
      "source": "https://www.rediscoverpottsville.com/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The first anthracite coal seam was uncovered in 1790 by hunter Necho Allen, sparking the town’s mining boom.",
      "sourceSentenceIds": [
        11,
        20
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 2"
      ],
      "source": "https://en.wikipedia.org/wiki/Pottsville%2C_Pennsylvania",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "In 1881, the Phillips Van Heusen company was founded in Pottsville, later becoming a nationwide apparel brand.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Pottsville%2C_Pennsylvania",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The Pottsville Formation, a geological layer named after the city, stretches from Alabama to New York and includes coal, sandstone, and conglomerate.",
      "sourceSentenceIds": [
        2,
        3
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Pottsville%2C_Pennsylvania",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The historic Yuengling Brewery, still operating today, is one of the oldest continuously running breweries in the United States.",
      "sourceSentenceIds": [
        18
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.rediscoverpottsville.com/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "In 2011, Pottsville opened the Union Station Intermodal Transit Center, becoming a regional hub for Greyhound, Trailways, and local buses.",
      "sourceSentenceIds": [
        22,
