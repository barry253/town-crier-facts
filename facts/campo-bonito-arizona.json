  "facts": [
    {
      "id": 1,
      "text": "Campo Bonito began as a mining camp when Clark and Fritz Ewe staked an independent‑lode claim on January 29, 1887.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.azentertain.com/arizonagoldrush/campobonito/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town sits within the historic Old Hat Mining District, a hub of 19th‑century gold prospecting in the Santa Catalina Mountains.",
      "sourceSentenceIds": [
        26
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.azentertain.com/arizonagoldrush/campobonito/",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Buffalo Bill Cody poured hundreds of thousands of dollars into a Campo Bonito mine that later supplied tungsten for Thomas Edison’s light bulbs.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.azentertain.com/arizonagoldrush/campobonito/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Campo Bonito’s landscape preserves rich pre‑Columbian archaeology and follows the historic De Anza Trail through the Santa Catalinas.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.pima.gov/229/Attractions-Tourism",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The Arizona Gold Rush of the 1880s, sparked after California’s 1859 gold rush ended, drew prospectors to Campo Bonito and nearby Oracle.",
      "sourceSentenceIds": [
        10,
        11
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.azentertain.com/arizonagoldrush/campobonito/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Located just north of Tucson, Campo Bonito lies in the Santa Catalina Mountains, close to the town of Oracle where early miners first settled.",
