  "facts": [
    {
      "id": 1,
      "text": "Mehama was named for Mehama Smith, the wife of pioneer settler James X. Smith.",
      "sourceSentenceIds": [
        2,
        5
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Mehama%2C_Oregon"
    },
    {
      "id": 2,
      "text": "James X. Smith laid out the townsite and operated a ferry on the North Santiam River.",
      "sourceSentenceIds": [
        13
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Mehama%2C_Oregon"
    },
    {
      "id": 3,
      "text": "Mehama emerged as a pioneer settlement along the North Santiam River, serving as a key crossing point for travelers.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/mehama"
    },
    {
      "id": 4,
      "text": "The region around Mehama was traditionally inhabited by the Santiam Kalapuya people of the Kalapuya tribe.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/mehama"
    },
    {
      "id": 5,
      "text": "Logging became the dominant economic force in Mehama during the early twentieth century following railroad construction.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/mehama"
    },
    {
      "id": 6,
      "text": "Mehama sits on the north side of the North Santiam River and the Linn County line.",
      "sourceSentenceIds": [
        14
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Mehama%2C_Oregon"
    }
  ]
