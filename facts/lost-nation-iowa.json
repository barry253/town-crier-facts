  "facts": [
    {
      "id": 1,
      "text": "Lost Nation’s first train station opened in 1871 on the Sabula, Ackley and Dakota line, sparking early growth.",
      "sourceSentenceIds": [
        1,
        2
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 2"
      ],
      "source": "https://en.wikipedia.org/wiki/Lost_Nation%2C_Iowa",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town’s name, first recorded in 1855, comes from a local legend about a prosperous Native American tribe.",
      "sourceSentenceIds": [
        4,
        5,
        6
      ],
      "sourceLabels": [
        "Web source 1",
        "Web source 2",
        "Web source 2"
      ],
      "source": "https://kids.kiddle.co/Lost_Nation,_Iowa",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Sharon Methodist Episcopal Church, also called Smithtown Church, sits north of town and earned a spot on the National Register of Historic Places.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Lost_Nation%2C_Iowa",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "In 1911, Lost Nation became one of eastern Iowa’s few small towns to receive electric power, lighting homes and a grain elevator.",
      "sourceSentenceIds": [
        7,
        15
      ],
      "sourceLabels": [
        "Web source 2",
        "Wikipedia"
      ],
      "source": "https://grokipedia.com/page/lost_nation_iowa",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Legend says the area once hosted a “Boss Nation” tribe, drawn by abundant deer, bear, turkey, buffalo, antelope, prairie grouse, and river fish.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/lost_nation_iowa",
      "category": "etymology",
      "quality": "poor",
      "qualityReason": "editorial_filler"
    },
    {
