      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Early pioneers faced dry, scorched land; water scarcity made farming hard before Dr. Dwinnell’s irrigation plans.",
      "sourceSentenceIds": [
        1,
        11
      ],
      "sourceLabels": [
        "Web source 2",
