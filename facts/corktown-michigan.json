      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The neighborhood’s historic red brick pavers, laid in the 1890s, still line Michigan Avenue and preserve its early road‑quality efforts.",
      "sourceSentenceIds": [
        1,
        8
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
