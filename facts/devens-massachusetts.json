      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Devens%2C_Massachusetts",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The Fort Devens Museum, located at 94 Jackson Road, showcases the site's history from 1917 to present.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
