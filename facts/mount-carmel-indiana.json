      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "A post office opened in Mount Carmel in 1840 and served the community until 1906.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Mount_Carmel%2C_Indiana",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Mount Carmel sits in Springfield Township, Franklin County, Indiana, and has long been a quiet rural enclave.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Mount_Carmel%2C_Indiana",
