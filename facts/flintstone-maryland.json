  "facts": [
    {
      "id": 1,
      "text": "Flintstone’s name comes from local flint deposits that were quarried in the 1830s.",
      "sourceSentenceIds": [
        11
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/flintstone_maryland"
    },
    {
      "id": 2,
      "text": "The Flintstone Hotel, a 2½‑story brick inn built in 1807, hosted figures like Lafayette, Clay, and Roosevelt.",
      "sourceSentenceIds": [
        13
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/flintstone_maryland"
    },
    {
      "id": 3,
      "text": "The town sits just one mile south of the Mason–Dixon line, between Tussey Mountain and a water gap in Warrior Mountain carved by Flintstone Creek.",
      "sourceSentenceIds": [
        7,
        8,
        17
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Flintstone%2C_Maryland"
    },
    {
      "id": 4,
      "text": "Flintstone emerged in the early 1800s as a key stop on the National Pike, where inns and taverns served stagecoach travelers.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/flintstone_maryland"
    },
    {
      "id": 5,
      "text": "The Breakneck Road Historic District, which includes Flintstone, was added to the National Register of Historic Places in 1980.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Flintstone%2C_Maryland"
    },
    {
      "id": 6,
      "text": "The area’s humid continental climate brings warm summers and cold winters, with average July highs around 86°F and January lows near 21°F.",
