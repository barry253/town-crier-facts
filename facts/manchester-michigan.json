  "facts": [
    {
      "id": 1,
      "text": "Manchester sprang to life in 1833 when John Gilbert built a grist mill on the River Raisin, becoming the town’s first industry.",
      "sourceSentenceIds": [
        26,
        28,
        30
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Manchester%2C_Michigan"
    },
    {
      "id": 2,
      "text": "The town’s name was chosen to honor settlers from Manchester, New York, reflecting their upstate roots.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Manchester%2C_Michigan"
    },
    {
      "id": 3,
      "text": "The KJ House Museum, located in a historic blacksmith shop, opens Saturdays and showcases local history through rotating exhibits.",
      "sourceSentenceIds": [
        13,
        12
      ],
      "sourceLabels": [
        "Web source 2",
        "Web source 1"
      ],
      "source": "https://mahsmi.org/"
    },
    {
      "id": 4,
      "text": "Every summer, the community hosts the Manchester Chicken Broil, a fundraiser that supports schools, parks, and the library.",
      "sourceSentenceIds": [
        20
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.annarbor.org/surrounding-destinations/manchester/"
    },
    {
      "id": 5,
      "text": "The Manchester Area Historical Society preserves the town’s story through interviews, artifacts, and monthly membership meetings.",
