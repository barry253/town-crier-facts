  "facts": [
    {
      "id": 1,
      "text": "Long Lake got its name from the lake itself, with the town's eastern edge sitting right on the water.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Long_Lake%2C_Minnesota"
    },
    {
      "id": 2,
      "text": "The town incorporated in 1906 after residents feared the railroad depot might relocate, keeping the train in place.",
      "sourceSentenceIds": [
        5,
        12
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.longlakeareachamber.com/about-membership/area-information/"
    },
    {
      "id": 3,
      "text": "The West Hennepin History Center, locally called the Pioneer Museum, preserves Long Lake’s early pioneer stories.",
      "sourceSentenceIds": [
        13
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.longlakeareachamber.com/about-membership/area-information/"
    },
    {
      "id": 4,
      "text": "A local legend says the lake formed from a drip of Paul Bunyan’s water barrel, and early maps show it as five parts joined by a narrow neck.",
      "sourceSentenceIds": [
        14
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.longlakeliving.org/about-us/history-of-long-lake/"
    },
    {
      "id": 5,
      "text": "Settlers first arrived in spring 1855, with the Flemings and the Knettle family establishing the first permanent community.",
      "sourceSentenceIds": [
        16,
        18
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Long_Lake%2C_Minnesota"
    },
    {
      "id": 6,
      "text": "The Knettle house hosted Long Lake’s first public religious service between 1855 and 1860, becoming a traveler’s stop.",
      "sourceSentenceIds": [
        20
