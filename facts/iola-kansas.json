  "facts": [
    {
      "id": 1,
      "text": "Iola was named after Iola Colborn, the wife of founder Josiah Colborn, honoring her in the town’s early history.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Iola%2C_Kansas",
      "category": "people",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town site was chosen about two miles north of Cofachique, where Elm Creek meets the Neosho River.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Iola%2C_Kansas",
      "category": "other",
      "quality": "poor",
      "qualityReason": "location_description"
    },
    {
      "id": 3,
      "text": "After incorporating in 1870, Iola secured the Leavenworth, Lawrence and Galveston Railroad, spurring rapid growth for two years.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Iola%2C_Kansas",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Iola boasts the largest downtown square in the United States, surrounded by historic buildings that line eight blocks of shops and restaurants.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.travelks.com/places-to-visit/cities/iola/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The city sits along the Neosho River in southeast Kansas, a key waterway that shaped its early settlement.",
      "sourceSentenceIds": [
        19
      ],
      "sourceLabels": [
