  "facts": [
    {
      "id": 1,
      "text": "The town, like the nearby mountain, was named for Will Study (pronounced “Stoody”), the manager of the Big Bend or Study Butte mercury mine.",
      "sourceSentenceIds": [
        14,
        15
      ],
      "sourceLabels": [
        "Web source 1",
        "Web source 2"
      ],
      "source": "https://www.tshaonline.org/handbook/entries/study-butte-tx",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Like Terlingua, Study Butte owes its existence to the mercury mining industry established in the area around 1900.",
      "sourceSentenceIds": [
        11,
        24
      ],
      "sourceLabels": [
        "Web source 2",
        "Web source 1"
      ],
      "source": "https://www.historictexas.net/city/study-butte-texas",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "A post office operated in Study Butte from 1917 to 1921, with earlier brief service in the early 1900s.",
      "sourceSentenceIds": [
        25
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.tshaonline.org/handbook/entries/study-butte-tx",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The old Study Butte store, an adobe structure still standing in the late 1980s, was scarred by bullet holes from the Mexican Revolution in the early 1900s.",
      "sourceSentenceIds": [
        26
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.tshaonline.org/handbook/entries/study-butte-tx",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Study Butte enjoyed a brief economic resurgence during World War II, but by the late 1940s the mine had closed.",
      "sourceSentenceIds": [
        27
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.tshaonline.org/handbook/entries/study-butte-tx",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "After the Diamond Shamrock Corporation shut down in 1972, Study Butte reinvented itself as a retiree haven and tourist spot on Big Bend National Park’s edge.",
      "sourceSentenceIds": [
