    {
      "id": 2,
      "text": "The town’s name means “Height of Sharon” in Hebrew, reflecting its elevated position on the Sharon plain.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.wisdomlib.org/cities/ramat-hasharon-11702"
    },
    {
      "id": 3,
      "text": "Before becoming a city, Ramat HaSharon was originally called Ir Shalom, meaning “City of Peace.”.",
      "sourceSentenceIds": [
