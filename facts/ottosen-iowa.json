  "facts": [
    {
      "id": 1,
      "text": "Ottosen, Iowa, sprang to life in 1896 when grain dealer Chris Ottosen petitioned the postmaster general for a post office, founding the town.",
      "sourceSentenceIds": [
        4,
        1
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Ottosen%2C_Iowa",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Ottosen’s founder tried to lure the railroad to build a depot, but the company balked because the tracks curved too sharply.",
      "sourceSentenceIds": [
        5,
        9
      ],
      "sourceLabels": [
        "Web source 1",
        "Web source 2"
      ],
      "source": "https://iagenweb.org/humboldt/history/ottosen_history.htm",
      "category": "transport",
      "quality": "poor",
      "qualityReason": "route_only"
    },
    {
      "id": 3,
      "text": "When Ottosen was established, the nearby settlement of Russel Switch was abandoned, consolidating the region’s population into the new town.",
      "sourceSentenceIds": [
        6,
        10
      ],
      "sourceLabels": [
        "Web source 1",
        "Web source 2"
      ],
      "source": "https://iagenweb.org/humboldt/history/ottosen_history.htm",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Ottosen celebrated its 100th anniversary on June 22–23, 1996, with parades, craft shows, a tractor pull, and a barbecue.",
      "sourceSentenceIds": [
        2,
        3
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.usacitiesonline.com/iacountyottosen.htm",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "A mid‑20th‑century fire destroyed much of Ottosen, and the damaged buildings were never rebuilt, leaving a scar on the town’s landscape.",
      "sourceSentenceIds": [
        14
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Ottosen%2C_Iowa",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Ottosen’s name was initially rejected because a similar name existed, so Senator Dolliver resubmitted the application under the name Ottosen.",
      "sourceSentenceIds": [
