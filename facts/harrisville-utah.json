  "facts": [
    {
      "id": 1,
      "text": "Harrisville was named after Martin Harris, a pioneer settler who helped establish the community.",
      "sourceSentenceIds": [
        1,
        13
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Harrisville%2C_Utah"
    },
    {
      "id": 2,
      "text": "The first permanent settlement in Harrisville was established in 1850.",
      "sourceSentenceIds": [
        11
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Harrisville%2C_Utah"
    },
    {
      "id": 3,
      "text": "Settlers briefly abandoned Harrisville in 1858 due to the arrival of Johnston's Army before returning that fall.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://onlineutah.us/harrisville_history_05.shtml"
    },
    {
      "id": 4,
      "text": "Both the Central Pacific and Union Pacific railroads once ran through Harrisville.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://onlineutah.us/harrisville_history_05.shtml"
    },
    {
      "id": 5,
      "text": "A post office in Harrisville operated from 1871 until 1902.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Harrisville%2C_Utah"
    },
    {
      "id": 6,
      "text": "During the 1976 bicentennial, Harrisville bought former Martin Harris family property to create the Martin Henderson Harris Memorial Park.",
      "sourceSentenceIds": [
        4
      ],
