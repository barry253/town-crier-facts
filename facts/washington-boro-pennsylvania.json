  "facts": [
    {
      "id": 1,
      "text": "Washington Boro began in 1810 as the village of Woodstock, was renamed Washington, and officially incorporated in 1827.",
      "sourceSentenceIds": [
        3,
        11
      ],
      "sourceLabels": [
        "Web source 1",
        "Wikipedia"
      ],
      "source": "https://www.lancasterhistory.org/finding-aids/heritage-of-washington-boro-collection/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "In 1718 French‑Canadian trader Martin Chartier established a trading post near the area, making it one of the earliest colonial trade hubs on the Susquehanna.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Washington_Boro%2C_Pennsylvania",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The borough sits on the historic Conejohela Flats, the site of the first colonial animal‑powered ferry—Wright's Ferry—across the Susquehanna River.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Washington_Boro%2C_Pennsylvania",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "A monument erected in 1925 by the Pennsylvania Historical Commission and the Lancaster County Historical Society marks Washington Boro’s long history.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Washington_Boro%2C_Pennsylvania",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Each July the Washington Boro Tomato Festival draws crowds, while the United Methodist Church hosts a Tomato Feast the following month in August.",
      "sourceSentenceIds": [
        22
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Washington_Boro%2C_Pennsylvania",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Founded in 2001, the Washington Boro Society for Susquehanna River Heritage collects relics and restores historic river access along the Susquehanna.",
      "sourceSentenceIds": [
        4
      ],
