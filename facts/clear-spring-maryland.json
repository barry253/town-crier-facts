  "facts": [
    {
      "id": 1,
      "text": "Clear Spring got its name from a clear spring that fed Tom's Run, the only local groundwater source.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Clear_Spring%2C_Maryland",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town was founded in 1821 along the National Pike, a major 19th‑century road that later became US 40.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://clearspringmd.gov/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Four historic buildings—Rufus Wilson Complex, Joseph Fiery House, Wilson School, and Plumb Grove—are all listed on the National Register of Historic Places.",
      "sourceSentenceIds": [
        14
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.hagerstownmag.com/featured-articles-1/2024/10/23-the-high-times-of-clear-spring",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "When the C&O Canal opened in 1850, the National Pike’s traffic slowed, reshaping Clear Spring’s economy for a time.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.hagerstownmag.com/featured-articles-1/2024/10/23-the-high-times-of-clear-spring",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The Wilson School, a one‑room schoolhouse, remains a landmark of Clear Spring’s educational heritage.",
