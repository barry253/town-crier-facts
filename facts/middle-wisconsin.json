  "facts": [
    {
      "id": 1,
      "text": "Middleton was once nicknamed Peatsville after a local peat-harvesting business operated in the area during its early years.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.cityofmiddleton.us/126/History-of-the-City"
    },
    {
      "id": 2,
      "text": "Middleton was established in 1856 after a railroad line was built between the communities of Pheasant Branch and East Middleton.",
      "sourceSentenceIds": [
        6,
        8
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.cityofmiddleton.us/126/History-of-the-City"
    },
    {
      "id": 3,
      "text": "The Middleton area served as a gathering place for Native American tribes, including the Algonquin and later the Ho-Chunk.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.cityofmiddleton.us/126/History-of-the-City"
    },
    {
      "id": 4,
      "text": "Middleton is home to the nationally recognized National Mustard Museum.",
      "sourceSentenceIds": [
        20
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://wi-middleton2.civicplus.com/110/Tourism"
    },
    {
      "id": 5,
      "text": "Early settlers arrived in Middleton during the 1830s, including those connected to a fur-trading post on Lake Mendota.",
