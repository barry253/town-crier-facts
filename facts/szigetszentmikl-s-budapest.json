  "facts": [
    {
      "id": 1,
      "text": "Szigetszentmiklós first appears in 1264 as a settlement on an island in the Danube, later becoming a key agricultural hub for Budapest.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.trawellino.com/destinations/hungary/pest-county_szigetszentmiklos"
    },
    {
      "id": 2,
      "text": "The town lies on Csepel Island, bordered by the Ráckevei-Duna, giving it a unique riverside geography.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Szigetszentmikl%C3%B3s"
    },
    {
      "id": 3,
      "text": "Saint Nicholas, the town’s patron saint, gives Szigetszentmiklós its name, literally meaning 'Saint Nicholas Island'.",
      "sourceSentenceIds": [
        11
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Szigetszentmikl%C3%B3s"
    },
    {
      "id": 4,
      "text": "In 1986, the settlement was officially granted town status, marking a milestone in its modern development.",
      "sourceSentenceIds": [
        15
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Szigetszentmikl%C3%B3s"
    },
    {
      "id": 5,
      "text": "The Ádám Jenő Memorial House on Árpád utca preserves ethnographic exhibits and archaeological finds from the area.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://en.wikivoyage.org/wiki/Szigetszentmikl%C3%B3s"
    },
    {
      "id": 6,
      "text": "The H6 HÉV line stops four times in Szigetszentmiklós, connecting it directly to Budapest’s HÉV network.",
