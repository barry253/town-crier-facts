      "id": 1,
      "text": "Szigetszentmiklós was officially granted town status in January 1986.",
      "sourceSentenceIds": [
        17
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Szigetszentmikl%C3%B3s",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town sits on Csepel Island, just south of Budapest, along the Ráckevei-Duna river.",
      "sourceSentenceIds": [
        11,
        14
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Szigetszentmikl%C3%B3s",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The Local History Collection museum showcases ethnographic displays and archaeological finds from the surrounding area.",
      "sourceSentenceIds": [
        6,
        5
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://en.wikivoyage.org/wiki/Szigetszentmikl%C3%B3s",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Inside the museum’s crypt, a permanent exhibit chronicles the history of the town’s church.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://en.wikivoyage.org/wiki/Szigetszentmikl%C3%B3s",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Jenő Ádám, a Kossuth Prize laureate, is honored in a memorial house beside the Local History Collection.",
      "sourceSentenceIds": [
        2,
        4
      ],
      "sourceLabels": [
        "Web source 1",
        "Web source 2"
      ],
      "source": "https://miklosimuzeum.hu/en/",
      "category": "people",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The former Csepel Automotive Factory, once a major industrial hub, is highlighted in the museum’s permanent exhibitions.",
