  "facts": [
    {
      "id": 1,
      "text": "De Tour Village was organized in 1850 as Warren Township, named after its first postmaster Ebenezer Warren.",
      "sourceSentenceIds": [
        1,
        3
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 2"
      ],
      "source": "https://en.wikipedia.org/wiki/DeTour_Village%2C_Michigan",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The spelling changed to \"DeTour\" in 1953, and the post office became \"DeTour Village\" in 1961.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/DeTour_Village%2C_Michigan",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Long before European settlers, the Mascoutin, Ottawa, and Chippewa peoples established encampments at Pointe De Tour.",
      "sourceSentenceIds": [
        29
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://michigan4you.com/history-of-de-tour-michigan/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The village sits at the extreme eastern tip of Michigan’s Upper Peninsula, where the St. Mary's River meets Lake Huron.",
      "sourceSentenceIds": [
        13,
        14,
        15,
        16
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/DeTour_Village%2C_Michigan",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "In the late 1800s, a lumber boom turned De Tour into a bustling industry hub, eventually leading to its 1899 incorporation.",
      "sourceSentenceIds": [
        9,
        20
      ],
      "sourceLabels": [
        "Web source 2",
        "Wikipedia"
      ],
      "source": "https://michigan4you.com/history-of-de-tour-michigan/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The historic Caribou Lake Railroad once whisked visitors through pine woods, a novelty that left lasting memories.",
