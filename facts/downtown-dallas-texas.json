      ],
      "source": "https://en.wikipedia.org/wiki/Downtown_Dallas",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The Trinity River Project will reshape the river into a natural corridor, adding lakes and two cable‑stayed bridges designed by Santiago Calatrava.",
      "sourceSentenceIds": [
        24,
        25
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Downtown_Dallas",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Union Station’s Amtrak platform connects Downtown Dallas to Chicago and Los Angeles, making it a key rail hub.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Downtown_Dallas",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The free M‑Line Trolley, operated by the McKinney Avenue Transit Authority, loops down St. Paul Avenue for commuters and tourists alike.",
