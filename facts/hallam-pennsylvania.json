  "facts": [
    {
      "id": 1,
      "text": "Hallam Borough officially became a separate municipality in 1908, marking its formal independence from surrounding townships.",
      "sourceSentenceIds": [
        13
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://hallamborough.com/about/history"
    },
    {
      "id": 2,
      "text": "Named after Upper Hallam in England, the town honors Samuel Blunston, the magistrate who first settled the area.",
      "sourceSentenceIds": [
        2,
        3
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Hallam%2C_Pennsylvania"
    },
    {
      "id": 3,
      "text": "Early settlers clustered around the north branch of Kreutz Creek, whose water powered the borough's first industries.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://hallamborough.com/about/history"
    },
    {
      "id": 4,
      "text": "The Pennsylvania Railway Station once stood half a mile from Hallam, just inside today's borough limits on Broad Street.",
      "sourceSentenceIds": [
        18
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://hallamborough.com/about/history"
    },
    {
      "id": 5,
      "text": "In 1993, the Martin Schultz House earned a spot on the National Register of Historic Places, preserving Hallam's heritage.",
      "sourceSentenceIds": [
        11
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Hallam%2C_Pennsylvania"
    },
    {
      "id": 6,
      "text": "A former cigar factory at 277 E. later became a potato chip plant, and today its building houses apartments.",
      "sourceSentenceIds": [
        6,
        7
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://hallamborough.com/about/history"
    }
