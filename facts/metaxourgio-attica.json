      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Avdi Square, the heart of Metaxourgio, hosts theatres and the Municipal Gallery, making it a cultural hub.",
      "sourceSentenceIds": [
        23
