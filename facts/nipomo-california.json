  "facts": [
    {
      "id": 1,
      "text": "Nipomo’s name comes from the Chumash word Nipumuʔ, meaning “place of the big house” or “village”.",
      "sourceSentenceIds": [
        14
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Nipomo%2C_California",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town grew around Rancho Nipomo, a 38,000‑acre Mexican land grant given to Captain Dana in 1837.",
      "sourceSentenceIds": [
        16,
        18
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Nipomo%2C_California",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The Dana Adobe, built in 1839, served as a stagecoach stop and mail exchange on El Camino Real between Mission San Luis Obispo and Mission Santa Barbara.",
      "sourceSentenceIds": [
        19,
        20
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Nipomo%2C_California",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "In 1909, thousands of blue‑gum eucalyptus trees were planted on Nipomo Mesa by the Los Berros Forest Company, a decision that later inspired Dorothea Lange’s “Migrant Mother” photograph.",
      "sourceSentenceIds": [
        29,
        30
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Nipomo%2C_California",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The Pacific Coast Railway reached Nipomo in 1882, bringing trains through town until the Great Depression, when tracks were removed for WWII.",
      "sourceSentenceIds": [
        27,
        28
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Nipomo%2C_California",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The entire Rancho Nipomo area is listed as a California Historical Landmark, preserving its early ranching heritage.",
      "sourceSentenceIds": [
