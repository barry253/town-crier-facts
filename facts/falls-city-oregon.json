  "facts": [
    {
      "id": 1,
      "text": "Falls City is named after Berry Creek Falls in the Little Luckiamute River that passes through the center of town.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Falls_City%2C_Oregon"
    },
    {
      "id": 2,
      "text": "Founded in 1889 and incorporated in 1893, Falls City has a long and rich history.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.fallscityoregon.gov/history"
    },
    {
      "id": 3,
      "text": "Falls City was once a lumbermill town and operated three mills, a bank, a hotel, and a jail.",
      "sourceSentenceIds": [
        18
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Falls_City%2C_Oregon"
    },
    {
      "id": 4,
      "text": "Falls City is located in Polk County, Oregon, and is part of the Salem Metropolitan Statistical Area.",
      "sourceSentenceIds": [
        16,
        17
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Falls_City%2C_Oregon"
    },
    {
      "id": 5,
      "text": "The city of Falls City experiences warm, dry summers and cold, wet winters.",
      "sourceSentenceIds": [
        19
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Falls_City%2C_Oregon"
    },
    {
