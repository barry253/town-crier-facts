  "facts": [
    {
      "id": 1,
      "text": "Wabush was purpose‑built in the 1960s as a planned settlement around iron‑ore mining.",
      "sourceSentenceIds": [
        5,
        30
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.kupi.com/en-ae/explore/canada/wabush/history"
    },
    {
      "id": 2,
      "text": "The town’s architecture reflects a single post‑war modernist era, with no historic palaces, giving it a clean, functional look.",
      "sourceSentenceIds": [
        1,
        8
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.kupi.com/en-ae/explore/canada/wabush/history"
    },
    {
      "id": 3,
      "text": "Wabush sits on the Labrador Trough, home to rich iron‑ore deposits that drove its founding and growth.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.kupi.com/en-ae/explore/canada/wabush/history"
    },
    {
      "id": 4,
      "text": "The Mike Adam Recreation Complex is a bright example of northern public architecture and a social hub for residents.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.kupi.com/en-ae/explore/canada/wabush/history"
    },
    {
      "id": 5,
      "text": "Wabush’s subarctic climate brings more precipitation than typical, making it one of Canada’s rainiest and snowiest northern towns.",
      "sourceSentenceIds": [
        18
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Wabush"
    },
    {
      "id": 6,
      "text": "The town is the twin community of Labrador City, sharing many services and a close relationship across the border.",
      "sourceSentenceIds": [
