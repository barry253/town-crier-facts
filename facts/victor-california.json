  "facts": [
    {
      "id": 1,
      "text": "Victor earned its name when landowner Albert Edgar Morden persuaded the railroad to build a freight depot near his home, naming it after his eldest son.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/victor_california",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The first permanent European‑American settlement in Victor began in 1860 when Methodist minister Jesse Green arrived from Alabama and claimed land east of the Mokelumne River.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/victor_california",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "In 1905 Peter Heil erected Victor’s first packing shed on his 10‑acre Tokay grape vineyard, marking the start of the town’s fruit‑packing industry.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/victor_california",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The 1925 Victor Service Station became a local hub, offering fuel, repairs, and meals to farmers amid the rise of automobile travel.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/victor_california",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Victor sits 75 feet above sea level, a modest elevation that places it comfortably within the San Joaquin Valley’s flat landscape.",
      "sourceSentenceIds": [
        30
