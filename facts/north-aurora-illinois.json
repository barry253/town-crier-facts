  "facts": [
    {
      "id": 1,
      "text": "North Aurora was founded in 1834 when John Peter Schneider built a sawmill on the Fox River.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.illinoislandandhomes.com/north-aurora-illinois-history",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The village’s early name was “Schneider’s Mill” or “Schneider’s Crossing” after the German immigrant who set up the mill.",
      "sourceSentenceIds": [
        11
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/North_Aurora%2C_Illinois",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "In 1868, local businessmen bought the sawmill and started a sash, blind, and door factory that helped grow the town.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.illinoislandandhomes.com/north-aurora-illinois-history",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The Chicago, Burlington and Quincy railroad reached North Aurora in 1850, spurring rapid economic growth.",
      "sourceSentenceIds": [
        13
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.illinoislandandhomes.com/north-aurora-illinois-history",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The Messenger Public Library, the village’s library, recently added a new police station nearby, showing its growing civic center.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.illinoislandandhomes.com/north-aurora-illinois-history",
