  "facts": [
    {
      "id": 1,
      "text": "Local stories suggest Marietta was named after Marie Etta, the wife of early settler Jerry Washington.",
      "sourceSentenceIds": [
        8,
        9
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Marietta%2C_Oklahoma"
    },
    {
      "id": 2,
      "text": "Jerry Washington served as the first postmaster of Marietta when the post office opened in December 1887.",
      "sourceSentenceIds": [
        11
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Marietta%2C_Oklahoma"
    },
    {
      "id": 3,
      "text": "The Bill Washington Ranch House in Marietta was listed in the National Register of Historic Places in 1971.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.okhistory.org/publications/enc/entry?entry=MA024"
    },
    {
      "id": 4,
      "text": "Marietta once supported a diverse local economy featuring a sawmill, a broom factory, a canning plant, and seven cotton gins.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.okhistory.org/publications/enc/entry?entry=MA024"
    },
    {
      "id": 5,
      "text": "The local museum in Marietta is housed inside a historic jailhouse built in 1910.",
      "sourceSentenceIds": [
        14
      ],
      "sourceLabels": [
