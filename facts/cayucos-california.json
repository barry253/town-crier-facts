      "quality": "good"
    },
    {
      "id": 2,
      "text": "Captain James Cass founded Cayucos in 1867, buying 320 acres and building a 900‑foot pier and warehouse to ship cargo to San Francisco.",
      "sourceSentenceIds": [
        6,
        25
      ],
      "sourceLabels": [
        "Wikipedia"
