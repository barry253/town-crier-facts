  "facts": [
    {
      "id": 1,
      "text": "Falkner was named for William Clark Falkner, the great‑grandfather of author William Faulkner.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Falkner%2C_Mississippi",
      "category": "people",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "In 1870 Colonel William Falkner celebrated the completion of his Ripley Railroad branch that ran from New Albany to Middleton.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://falknermsheritage.com/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The Falkner Heritage Museum Project, founded in 2016, aims to preserve the old town beside the tracks and build a future‑ready community center.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://falknermsheritage.com/",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Cooper Hill School House, built between 1856 and 1869, is believed to be the only one‑room, one‑teacher school still standing in Tippah County.",
      "sourceSentenceIds": [
        27,
        29
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://falknermsheritage.com/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "On September 26, 2026, Falkner Heritage Park will host a Founder’s Day Car & Jeep Show featuring classic vehicles, barbecue, and a $20 donation entry.",
