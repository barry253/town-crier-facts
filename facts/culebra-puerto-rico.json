  "facts": [
    {
      "id": 1,
      "text": "Culebra was originally called Isla del Pasaje and Isla de San Ildefonso, later nicknamed Isla Chiquita and Cradle of the Puerto Rican Sun.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Culebra%2C_Puerto_Rico",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Flamenco Beach, on Culebra’s main island, is famed for its crescent shoreline framed by palms, ideal for swimming and snorkeling.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.culebraisland.com/about",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Culebra’s main island, Culebrita, and several cays form a small archipelago about 17 miles northeast of Puerto Rico’s main island.",
      "sourceSentenceIds": [
        17
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Culebra%2C_Puerto_Rico",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "During the 1960s, U.S. Navy exercises peaked in 1969, using Culebra for gunnery and aerial training before deploying to Southeast Asia.",
      "sourceSentenceIds": [
        15
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Culebra%2C_Puerto_Rico",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Christopher Columbus may have first seen Culebra on his second voyage, landing November 19, 1493.",
      "sourceSentenceIds": [
        20
