  "facts": [
    {
      "id": 1,
      "text": "Hilshire Village got its name from a country estate in Hillshire, England, but the founders spelled it with one 'L' to create a unique identity.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Hilshire_Village%2C_Texas",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Hilshire Village officially became a city on April 15, 1955, keeping its boundaries separate from Houston's expanding annexations.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Hilshire_Village%2C_Texas",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The U.S. Postal Service treats all Hilshire Village mail as Houston, so residents must use 'Houston' on their envelopes.",
      "sourceSentenceIds": [
        27
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Hilshire_Village%2C_Texas",
      "category": "other",
      "quality": "poor",
      "qualityReason": "vague"
    },
    {
      "id": 4,
      "text": "Residents of Hilshire Village access the Spring Branch Memorial Branch of Harris County Public Library, located just outside the city in Hedwig Village.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Hilshire_Village%2C_Texas",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The nearest public hospital for Hilshire Village residents is Ben Taub General Hospital, part of the Texas Medical Center.",
      "sourceSentenceIds": [
        28
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Hilshire_Village%2C_Texas",
      "category": "other",
      "quality": "poor",
      "qualityReason": "vague"
    },
    {
      "id": 6,
      "text": "Back in 1895, the area that would become Hilshire Village already had a post office and railroad service, hinting at early connectivity.",
