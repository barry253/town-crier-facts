  "facts": [
    {
      "id": 1,
      "text": "The area of Grantsville was originally inhabited by the Goshute people before attracting Mormon pioneers in the mid-nineteenth century.",
      "sourceSentenceIds": [
        4,
        6
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Grantsville%2C_Utah"
    },
    {
      "id": 2,
      "text": "Grantsville was settled in 1850 by Mormon pioneers, including brothers-in-law James McBride and Harrison Severe and their families.",
      "sourceSentenceIds": [
        16
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Grantsville%2C_Utah"
    },
    {
      "id": 3,
      "text": "Early settlers called the area Twenty Wells for its freshwater springs and Willow Creek for the nearby mountain stream.",
      "sourceSentenceIds": [
        2,
        5
      ],
      "sourceLabels": [
        "Web source 1",
        "Wikipedia"
      ],
      "source": "https://www.grantsvilleut.gov/our_community/about_grantsville.php"
    },
    {
      "id": 4,
      "text": "Grantsville was eventually renamed to honor Colonel George D. Grant, a leader in the Church of Jesus Christ of Latter-day Saints.",
      "sourceSentenceIds": [
        2,
        17,
        18
      ],
      "sourceLabels": [
        "Web source 1",
        "Wikipedia"
      ],
      "source": "https://www.grantsvilleut.gov/our_community/about_grantsville.php"
    },
    {
      "id": 5,
      "text": "Grantsville is bordered by South Mountain to the south, the Stansbury Mountains to the west, and the Oquirrh Mountains to the east.",
      "sourceSentenceIds": [
        20,
        21
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Grantsville%2C_Utah"
    },
    {
      "id": 6,
      "text": "Historic landmarks like the Anderson-Clark Farmstead reflect the agricultural roots and early settlement history of Grantsville.",
