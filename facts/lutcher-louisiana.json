  "facts": [
    {
      "id": 1,
      "text": "Lutcher began as a sawmill town, its name honoring businessman Henry J. Lutcher.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Lutcher%2C_Louisiana",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "In 1870, Captain John Diebert from Ohio scouted vast cypress forests that would later fuel Lutcher’s lumber boom.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.geocities.ws/gee_38/lutch.html",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Within a year the mill employed 300 workers, and by the 1890s Lutcher’s population swelled to 4,500, making it the world’s second‑largest cypress mill.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.geocities.ws/gee_38/lutch.html",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The San Francisco Plantation, an antebellum mansion, still stands in Lutcher and offers guided tours of its historic rooms.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://paradisetrvlr.com/travel-guide/louisiana/lutcher-louisiana-travel-guide",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The Cabin, a restored 1800s cabin, serves as a historic restaurant and bar where locals enjoy regional flavors.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://paradisetrvlr.com/travel-guide/louisiana/lutcher-louisiana-travel-guide",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Every Christmas Eve, residents light bonfires along the Mississippi levee near Lutcher, a tradition said to guide Santa’s sleigh.",
      "sourceSentenceIds": [
        22,
        23
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
