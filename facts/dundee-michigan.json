    },
    {
      "id": 5,
      "text": "Dundee’s historic district, on the National Register, includes the Old Mill Museum and the Macon Reservation of the River Raisin National Battlefield Park.",
      "sourceSentenceIds": [
        17
      ],
      "sourceLabels": [
        "Wikipedia"
