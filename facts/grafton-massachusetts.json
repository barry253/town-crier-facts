  "facts": [
    {
      "id": 1,
      "text": "Grafton was named for Charles FitzRoy, 2nd Duke of Grafton, the illegitimate son of King Charles II.",
      "sourceSentenceIds": [
        7,
        11
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Grafton%2C_Massachusetts",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Hollywood filmmakers built a bandstand on Grafton’s common for the 1930s film Ah, Wilderness!, which was later rebuilt many times.",
      "sourceSentenceIds": [
        6,
        20,
        27
      ],
      "sourceLabels": [
        "Web source 1",
        "Wikipedia"
      ],
      "source": "https://grafton-ma.gov/357/History-of-Grafton",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Grafton State Hospital began as a farm colony off Worcester State Hospital, letting chronically insane patients work and live in a rural setting.",
      "sourceSentenceIds": [
        15
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Grafton%2C_Massachusetts",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The Grafton Historical Society, founded in 1964, houses a museum in the former South Grafton library filled with artifacts from the town’s past.",
      "sourceSentenceIds": [
        3,
        12
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://graftonhistoricalsociety.org/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Grafton Common hosts a collection of historic homes, churches, and buildings that make it one of the most quintessential Blackstone Valley commons.",
      "sourceSentenceIds": [
        21
      ],
      "sourceLabels": [
        "Wikipedia"
