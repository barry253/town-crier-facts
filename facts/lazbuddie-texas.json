  "facts": [
    {
      "id": 1,
      "text": "Lazbuddie was named after Luther “Laz” Green and Andrew “Buddie” Sherley, who opened a general store there in 1924.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Lazbuddie%2C_Texas",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town’s roots trace back to 1902 when Thomas Kelly bought the Red Tower Camp, a 55,000‑acre ranch that became the seed of Lazbuddie.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.tshaonline.org/handbook/entries/lazbuddie-tx",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "A post office and school followed in 1907, marking Lazbuddie’s first steps toward a permanent community.",
      "sourceSentenceIds": [
        30
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.tshaonline.org/handbook/entries/lazbuddie-tx",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Lazbuddie’s economy once boomed around two cotton gins, a grain elevator, and a hardware store that served the surrounding ranching area.",
      "sourceSentenceIds": [
        27
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Lazbuddie%2C_Texas",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The community sits at the junction of Farm Roads 145 and 1172 in southeastern Parmer County, a crossroads that helped it grow in the early 20th century.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.tshaonline.org/handbook/entries/lazbuddie-tx",
      "category": "other",
      "quality": "poor",
      "qualityReason": "location_description"
    },
    {
      "id": 6,
      "text": "In the early 1900s, homesteaders flocked to the land Kelly sold, turning Lazbuddie into a modest but thriving ranching hub.",
      "sourceSentenceIds": [
