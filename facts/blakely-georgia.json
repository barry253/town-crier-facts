  "facts": [
    {
      "id": 1,
      "text": "Blakely was named for Captain Johnston Blakeley, a naval officer in the Quasi‑War and War of 1812.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://cityofblakely.net/blakely-history/",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The city sits on the Chattahoochee River and was a key site in early territorial battles, including one led by Andrew Jackson.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://cityofblakely.net/blakely-history/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Kolomoki Mounds Historic Park, a 1,239‑acre site north of Blakely, is the oldest and largest Woodland Indian site in the Southeast.",
      "sourceSentenceIds": [
        7,
        2
      ],
      "sourceLabels": [
        "Web source 1",
        "Web source 1"
      ],
      "source": "https://www.blakelyearlycountychamber.org/tourism/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Blakely became the county seat of Early County when the town was platted in 1825.",
      "sourceSentenceIds": [
        13
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Blakely%2C_Georgia",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The town’s historic square features a war memorial and marker on its south side, commemorating local military service.",
