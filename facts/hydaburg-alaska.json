  "facts": [
    {
      "id": 1,
      "text": "Hydaburg was founded in 1911 when Haida village elders consolidated to create better educational opportunities.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://everythingalaska.com/eta.hyd.html"
    },
    {
      "id": 2,
      "text": "The name Hydaburg comes from the Haida people and marks the headquarters of the Hydaburg Cooperative Association.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Hydaburg%2C_Alaska"
    },
    {
      "id": 3,
      "text": "Hydaburg is the southernmost city on Prince of Wales Island, anchoring the island’s southern tip.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Hydaburg%2C_Alaska"
    },
    {
      "id": 4,
      "text": "Hydaburg hosts the only port facility and public road access on Cordova Bay, making it a vital maritime hub.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Hydaburg%2C_Alaska"
    },
    {
      "id": 5,
      "text": "In 1938 the Hydaburg Cooperative Association was established, superseding municipal government after the Indian Reorganization Act.",
      "sourceSentenceIds": [
        15
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Hydaburg%2C_Alaska"
    },
    {
      "id": 6,
      "text": "Residents of Hydaburg take pride in harvesting resources traditionally, reflecting deep tribal values tied to land and sea.",
