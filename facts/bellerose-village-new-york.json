  "facts": [
    {
      "id": 1,
      "text": "Bellerose got its name from Helen Marsh, who combined her daughter Belle with the nearby Rose farm to create a euphonious station name.",
      "sourceSentenceIds": [
        1,
        2,
        3,
        7
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 2"
      ],
      "source": "https://en.wikipedia.org/wiki/Bellerose%2C_New_York",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The first Bellerose home was finished in 1910 under Marsh's supervision, marking the start of the village's planned community.",
      "sourceSentenceIds": [
        20
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Bellerose%2C_New_York",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "In 1924 Bellerose incorporated as a village to secure home rule and maintain local governance.",
      "sourceSentenceIds": [
        22
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Bellerose%2C_New_York",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The Bellerose Village Municipal Complex, housing the hall, fire house, and police booth, is listed on both state and national historic registers.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Bellerose%2C_New_York",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The Long Island Rail Road station that sparked the village's growth was originally a private wooden platform owned by the Rose family.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://bccaqueens.org/about/bellerose-history/",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Bellerose borders the New York City borough of Queens to the north, unincorporated Bellerose Terrace to the west, and Floral Park to the south.",
      "sourceSentenceIds": [
        23
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
