      ],
      "source": "https://www.blairstowntownship.org/government/historic_preservation.php",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The historic Blairstown Theater, also known as Roy’s Hall, opened in 1913 as a silent‑movie house.",
