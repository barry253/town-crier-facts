  "facts": [
    {
      "id": 1,
      "text": "Brambleton’s name means “bramble town,” a nod to the thorny shrubs that once covered the area.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.wisdomlib.org/cities/brambleton-20958",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The master‑planned community began over 20 years ago when Anthony Soave envisioned Brambleton as a new residential haven.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://brambleton.com/brambleton-history/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Construction of Brambleton started in 2001 on 2,500 acres that once belonged to Thomas Lewis’s plantation.",
      "sourceSentenceIds": [
        10,
        26
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Brambleton%2C_Virginia",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Brambleton’s Town Center now hosts more than 50 shops, restaurants, and offices, making it the heart of the community.",
      "sourceSentenceIds": [
        29
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Brambleton%2C_Virginia",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The community’s layout plans for over 9,000 homes, a 300,000‑square‑foot retail area, and 200,000 square feet of office space.",
      "sourceSentenceIds": [
        22
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Brambleton%2C_Virginia",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Brambleton sits on the former site of the early 1908 Royville community, which once stood at Belmont Ridge and Creighton Roads.",
      "sourceSentenceIds": [
