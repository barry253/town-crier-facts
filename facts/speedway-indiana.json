  "facts": [
    {
      "id": 1,
      "text": "Speedway was laid out in 1912 as a residential suburb and named after the Indianapolis Motor Speedway built three years earlier.",
      "sourceSentenceIds": [
        13,
        14
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Speedway%2C_Indiana",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town hosts the Indianapolis Motor Speedway, the world’s oldest operating motor speedway, and the surrounding area includes the United States Auto Club headquarters and Dallara factory.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Speedway%2C_Indiana",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The Prest‑O‑Lite Company, owned by Fisher and Allison, opened an acetylene cylinder factory when Speedway City was platted in 1912.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://indyencyclopedia.org/speedway/",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Within a few years, four additional factories—Electric Steel, Allison Engineering, American Art Clay, and Esterline Angus—were built, fueling early industrial growth.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://indyencyclopedia.org/speedway/",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "In 2005, the Speedway Historic District was listed on the National Register of Historic Places, preserving the town’s early 20th‑century character.",
      "sourceSentenceIds": [
        18
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Speedway%2C_Indiana",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Speedway maintains its own independent police department, one of only five Marion County cities excluded from Unigov, reflecting its unique municipal identity.",
      "sourceSentenceIds": [
        19
      ],
