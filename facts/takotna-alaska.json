  "facts": [
    {
      "id": 1,
      "text": "Takotna comes from the Upper Kuskokwim Athabascan word 'Tochotno’, meaning 'open water river'.",
      "sourceSentenceIds": [
        26
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/takotna_alaska",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "In 1908, traders and steamboats turned Takotna into a vital landing for gold prospectors in the Innoko district.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/takotna_alaska",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The Takotna River stays ice‑free from June to October, letting sternwheelers deliver supplies and fuel the town’s early growth.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/takotna_alaska",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "When placer gold was found in 1908, Takotna quickly became the main supply hub for miners chasing Otter and Ophir creeks.",
      "sourceSentenceIds": [
        28
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/takotna_alaska",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "By 1923, Takotna boasted its own radio station and the newspaper The Kusko Times, keeping residents connected during the boom.",
      "sourceSentenceIds": [
        11
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.tananachiefs.org/about/communities/takotna/",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Surrounded by the Kilbuck‑Kuskokwim Mountains, Takotna experiences summer highs up to 80°F and winter lows that can drop to –42°F.",
      "sourceSentenceIds": [
        22
