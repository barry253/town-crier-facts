  "facts": [
    {
      "id": 1,
      "text": "Dolores was founded as a railhead in 1891 for the Rio Grande Southern Railroad, replacing the older town of Big Bend.",
      "sourceSentenceIds": [
        2,
        7,
        8,
        21
      ],
      "sourceLabels": [
        "Web source 1",
        "Wikipedia"
      ],
      "source": "https://grokipedia.com/page/Dolores,_Colorado",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town’s name comes from the Dolores River, originally called “El Río de Nuestra Señora de los Dolores” by Spanish explorers in 1776.",
      "sourceSentenceIds": [
        2,
        11
      ],
      "sourceLabels": [
        "Web source 1",
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/Dolores,_Colorado",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "McPhee Reservoir, created in 1940, now covers the original site of the company town founded by the New Mexico Lumber Company.",
      "sourceSentenceIds": [
        1,
        10
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 2"
      ],
      "source": "https://en.wikipedia.org/wiki/Dolores%2C_Colorado",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The Canyons of the Ancients Visitor Center, listed on the National Register, showcases artifacts from the Ancestral Pueblo people who lived here 600‑1300 CE.",
      "sourceSentenceIds": [
        14,
        4
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Dolores%2C_Colorado",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Dolores sits at the mouth of Dolores Valley and the upper reaches of McPhee Reservoir, about 40 miles from the Four Corners Monument.",
