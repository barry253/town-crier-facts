  "facts": [
    {
      "id": 1,
      "text": "Lakewood Village was incorporated on April 26, 1977, becoming a quiet lakeside community that grew from a planned second‑home area.",
      "sourceSentenceIds": [
        17,
        1
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Lakewood_Village%2C_Texas",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town sits on a peninsula of Lewisville Lake, bordered by water on three sides and offering 3.17 miles of shoreline inside its limits.",
      "sourceSentenceIds": [
        21,
        25
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Lakewood_Village%2C_Texas",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "In 2019, the International Dark‑Sky Association named Lakewood Village the 23rd International Dark Sky Community in the world.",
      "sourceSentenceIds": [
        23
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Lakewood_Village%2C_Texas",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Lakewood Village lies about a mile south of Farm Road 720 and eleven miles southeast of Denton, nestled between I‑35 and the Dallas North Tollway.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.tshaonline.org/handbook/entries/lakewood-village-tx",
      "category": "other",
      "quality": "poor",
      "qualityReason": "location_description"
    },
    {
      "id": 5,
      "text": "The area is a wildlife haven, home to bald eagles, owls, hawks, gray foxes, bobcats, beavers, otters, wild turkeys, deer, coyotes, and even occasional mountain lions.",
      "sourceSentenceIds": [
        26
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Lakewood_Village%2C_Texas",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Lakewood Village’s original plan featured a golf course, two small‑plane runways (now Stowe Lane), and a tennis court before evolving into a relaxed lakeside hometown.",
