  "facts": [
    {
      "id": 1,
      "text": "Buckhannon’s name likely honors Buckongahelas, a Delaware Indian chief, whose name means “Buck-on-ge-ha-non” in the local language.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.britannica.com/place/Buckhannon",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The city was chartered by the Virginia General Assembly in 1852 and stayed part of Virginia until West Virginia’s secession in 1863.",
      "sourceSentenceIds": [
        24
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Buckhannon%2C_West_Virginia",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Buckhannon hosts the annual West Virginia Strawberry Festival each May, drawing visitors to its historic downtown and local strawberry farms.",
      "sourceSentenceIds": [
        14
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Buckhannon%2C_West_Virginia",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "West Virginia Wesleyan College, founded in 1897, sits in Buckhannon and is the state’s only private liberal‑arts college.",
      "sourceSentenceIds": [
        14
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Buckhannon%2C_West_Virginia",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "A bronze statue of Buckongahelas and his son, sculpted by Ross Straight, stands in Jawbone Park, honoring the chief’s legacy.",
