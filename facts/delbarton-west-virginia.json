  "facts": [
    {
      "id": 1,
      "text": "Delbarton is located in the heart of the Williamson Coalfield, the richest coal area in West Virginia.",
      "sourceSentenceIds": [
        22
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Delbarton%2C_West_Virginia"
    },
    {
      "id": 2,
      "text": "The name Delbarton is a portmanteau of the names of Luther Kountze's three children: Delancey, Barclay, and Livingston.",
      "sourceSentenceIds": [
        18
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Delbarton%2C_West_Virginia"
    },
    {
      "id": 3,
      "text": "Before becoming a town, Delbarton was a coal camp built and owned by the United Thacker Land Company.",
      "sourceSentenceIds": [
        19
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Delbarton%2C_West_Virginia"
    },
    {
      "id": 4,
      "text": "Luther Kountze purchased land for the town from Jane Hatfield, a widow of the famous Hatfield-McCoy Feud.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Delbarton%2C_West_Virginia"
    },
    {
      "id": 5,
      "text": "Delbarton was officially incorporated by the Mingo County Circuit Court in September 1946.",
      "sourceSentenceIds": [
        15
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Delbarton%2C_West_Virginia"
    },
    {
      "id": 6,
      "text": "Some former retail and mining administration buildings in Delbarton now serve the growing tourist industry.",
