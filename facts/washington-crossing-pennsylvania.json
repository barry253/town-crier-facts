  "facts": [
    {
      "id": 1,
      "text": "Washington Crossing Historic Park marks the spot where George Washington’s army crossed the Delaware River on the night of December 25‑26, 1776.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Washington_Crossing%2C_Pennsylvania",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The village, once called Taylorsville, was renamed Washington Crossing to honor the historic 1776 crossing.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Washington_Crossing%2C_Pennsylvania",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Every year the park hosts a reenactment of Washington’s nighttime crossing, drawing visitors to relive the daring 1776 raid.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Washington_Crossing%2C_Pennsylvania",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The Delaware Canal’s 60‑mile towpath runs through the park, offering a scenic trail that follows the river’s historic route.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Washington_Crossing%2C_Pennsylvania",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Bowman’s Hill Wildflower Preserve, part of the park, showcases native flora and serves as a living reminder of the area’s natural heritage.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Washington_Crossing%2C_Pennsylvania",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Guided tours of the historic village are available Wednesday through Sunday from 10 AM to 4 PM, letting visitors explore the park’s preserved buildings.",
      "sourceSentenceIds": [
        6,
        7
      ],
      "sourceLabels": [
        "Web source 2"
      ],
