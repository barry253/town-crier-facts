    },
    {
      "id": 2,
      "text": "The community of Beryl Junction emerged around 1909 as a crossroads community in the remote Escalante Valley.",
      "sourceSentenceIds": [
        26
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/beryl_junction_utah"
    },
    {
      "id": 3,
      "text": "Beryl Junction was named for the semi-precious beryl gemstone discovered locally near the railroad siding.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/beryl_junction_utah"
    },
    {
      "id": 4,
      "text": "The New Castle Reclamation Company once built a hotel here to attract buyers for agricultural land development.",
      "sourceSentenceIds": [
