  "facts": [
    {
      "id": 1,
      "text": "Monroe County was created on April 1 1836 from parts of Northampton and Pike Counties and named for President James Monroe.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://monroecountypa.com/history",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Stroudsburg, the county seat, was founded by Jacob Stroud in the late 1700s and incorporated as a borough on February 6 1815.",
      "sourceSentenceIds": [
        7,
        10
      ],
      "sourceLabels": [
        "Web source 1",
        "Web source 2"
      ],
      "source": "https://monroe.brightrtravel.com/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The arrival of the railroad in 1856 sparked new villages and hospitality businesses, reshaping Monroe County’s landscape.",
      "sourceSentenceIds": [
        22,
        23
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://monroecountypa.com/history",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Two of the earliest Pocono resorts—Inn at Buck Hill Falls (1901) and Pocono Manor (1902)—were founded by rival Philadelphia Quaker factions.",
