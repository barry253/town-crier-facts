  "facts": [
    {
      "id": 1,
      "text": "Riviera Beach sits on the southwest shore of the tidal Patapsco River, where the waterway forms Baltimore's harbor.",
      "sourceSentenceIds": [
        13
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Riviera_Beach%2C_Maryland",
      "category": "other",
      "quality": "poor",
      "qualityReason": "location_description"
    },
    {
      "id": 2,
      "text": "The community is bounded by two tidal inlets: Rock Creek to the southeast and Stoney Creek to the northwest.",
      "sourceSentenceIds": [
        14
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Riviera_Beach%2C_Maryland",
      "category": "other",
      "quality": "poor",
      "qualityReason": "vague"
    },
    {
      "id": 3,
      "text": "Rock Creek, the southern border, was named for the rocks at its mouth opposite Bar Harbor and Rock Hill Beach.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://rbia.communitysite.com/p/History-of-the-Beach",
      "category": "other",
      "quality": "poor",
      "qualityReason": "vague"
    },
    {
      "id": 4,
      "text": "In 1928 a Baltimore Sun ad described Riviera Beach as a “refined, restricted” neighborhood, reflecting its early housing covenants.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Riviera_Beach%2C_Maryland",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Riviera Beach offers 10 miles of free public beaches, perfect for swimming, sunbathing, and surfing.",
