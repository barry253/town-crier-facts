  "facts": [
    {
      "id": 1,
      "text": "Park Hill was named after Park Hill, England, reflecting the influence of Moravian missionaries who worked among the Cherokee in the 1800s.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.trawellino.com/destinations/united-states/oklahoma_park-hill"
    },
    {
      "id": 2,
      "text": "Park Hill was once known as the Athens of the Cherokee Nation due to its role as a cultural and educational hub.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.trawellino.com/destinations/united-states/oklahoma_park-hill"
    },
    {
      "id": 3,
      "text": "The Park Hill Mission, founded in 1829, operated one of the earliest printing presses in Oklahoma.",
      "sourceSentenceIds": [
        3,
        17
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Park_Hill%2C_Oklahoma"
    },
    {
      "id": 4,
      "text": "Chief John Ross made his home in Park Hill in 1839 after the Cherokee removal from the southeastern United States.",
      "sourceSentenceIds": [
        2,
        19
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Park_Hill%2C_Oklahoma"
    },
    {
      "id": 5,
      "text": "The Cherokee Heritage Center in Park Hill preserves tribal history and includes a reconstructed nineteenth-century village.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.trawellino.com/destinations/united-states/oklahoma_park-hill"
    },
    {
      "id": 6,
      "text": "The Echota Ceremonial Ground has been located on the north side of Park Hill since 2001.",
      "sourceSentenceIds": [
        25
      ],
