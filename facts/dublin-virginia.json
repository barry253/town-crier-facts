  "facts": [
    {
      "id": 1,
      "text": "Dublin grew around a 1913 Norfolk & Western Railway depot that still marks the heart of the historic district.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.dhr.virginia.gov/historic-registers/210-0004/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town’s name traces back to Dublin, Ireland, and was also linked to the New Dublin Presbyterian Church that adopted the Irish name.",
      "sourceSentenceIds": [
        2,
        3
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Dublin%2C_Virginia",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Dublin’s historic district, listed on the National Register in 1992, centers on the low wooden N&W depot and surrounding 19th‑century buildings.",
      "sourceSentenceIds": [
        7,
        8,
        6
      ],
      "sourceLabels": [
        "Web source 1",
        "Wikipedia"
      ],
      "source": "https://www.dhr.virginia.gov/historic-registers/210-0004/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The Volvo Trucks North America plant just outside Dublin is the world’s largest Volvo truck factory, employing nearly 3,000 people.",
      "sourceSentenceIds": [
        17
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Dublin%2C_Virginia",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "In 2024 the town council will hold a public hearing to restrict large trucks on Giles Avenue and Old Giles Road to protect local traffic.",
      "sourceSentenceIds": [
        5
      ],
