      "id": 1,
      "text": "Piffard was founded by English‑born landowner David Piffard in 1824, originally called Piffardinia before shortening.",
      "sourceSentenceIds": [
        5,
        27
      ],
      "sourceLabels": [
        "Web source 1"
      ],
