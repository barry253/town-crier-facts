  "facts": [
    {
      "id": 1,
      "text": "Northway was renamed in 1942 after Chief Walter Northway, a steamboat captain who ferried miners during the 1908 Chisana gold rush.",
      "sourceSentenceIds": [
        1,
        2,
        3
      ],
      "sourceLabels": [
        "Web source 1",
        "Web source 2"
      ],
      "source": "https://northwayvillagecouncil.org/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Before settlers, semi‑nomadic Dene’ Athabascans hunted, fished, and gathered along the Nabesna, Chisana, and Tanana rivers.",
      "sourceSentenceIds": [
        8,
        9
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/northway_alaska",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The first school opened in 1939 inside Chief Walter Northway’s home, and a log cabin was built the following year.",
      "sourceSentenceIds": [
        23,
        24
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://northwayvillagecouncil.org/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Northway recorded the United States’ highest sea‑level pressure—31.85 inches—on January 31, 1989, a mark only beaten by two Siberian readings.",
      "sourceSentenceIds": [
        11
      ],
      "sourceLabels": [
        "Wikipedia"
