  "facts": [
    {
      "id": 1,
      "text": "Chesterfield was settled by Quakers in 1677 and became one of New Jersey's original 104 townships in 1688, named after England's Earl of Chesterfield.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/chesterfield_new_jersey",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "A cannonball from an 1776–1778 Revolutionary War skirmish remains embedded in the Quaker meeting house in Crosswicks, a key village in the township.",
      "sourceSentenceIds": [
        7,
        11
      ],
      "sourceLabels": [
        "Web source 1",
        "Web source 2"
      ],
      "source": "https://www.chesterfieldtwphistoricalsoc.org/historical-information.html",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The township’s boundaries are informal, centered on a roughly 200‑acre historic village bordered by Black’s Creek, reflecting its rural character.",
      "sourceSentenceIds": [
        20
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/chesterfield_new_jersey",
      "category": "other",
      "quality": "poor",
      "qualityReason": "location_description"
    },
    {
      "id": 4,
      "text": "In 1713 a royal charter re‑formed Chesterfield Township, cementing its status as a colonial settlement in West Jersey.",
      "sourceSentenceIds": [
        14
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/chesterfield_new_jersey",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The Recklesstown Tavern, now the Chesterfield Inn, dates back to the 1700s and was expanded in 1774, making it one of the oldest continuous businesses in the area.",
      "sourceSentenceIds": [
        27,
        28
      ],
