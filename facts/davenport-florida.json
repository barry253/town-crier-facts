  "facts": [
    {
      "id": 1,
      "text": "Davenport began as Fort Davenport in 1838 during the Second Seminole War, about 12 miles north of the city’s present site.",
      "sourceSentenceIds": [
        23,
        24,
        25
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Davenport%2C_Florida",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The settlement was first called Horse Creek, named after a creek noted in an 1849 Army survey that feeds Snell Creek and Lake Hatchineha.",
      "sourceSentenceIds": [
        26
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Davenport%2C_Florida",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "In 1884 the South Florida Railroad reached the area, and a boxcar post office opened on a sidetrack by Horse Creek.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://davenporthistory.org/a-short-history-of-the-city-of-davenport-florida/",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "A 1927 red‑brick schoolhouse, now restored, served four generations of Davenport students and remains a local historic gem.",
