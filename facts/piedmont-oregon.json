  "facts": [
    {
      "id": 1,
      "text": "Piedmont’s roots trace back to 1889 when Edward Quackenbush platted the area, branding it “The Emerald, Portland’s Evergreen Suburb.”.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Piedmont%2C_Portland%2C_Oregon"
    },
    {
      "id": 2,
      "text": "After a 1947 failed attempt to build a Nabisco factory in Rose City Park, the company chose a site along Columbia Boulevard.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Piedmont%2C_Portland%2C_Oregon"
    },
    {
      "id": 3,
      "text": "The neighborhood boasts Peninsula Park, a historic green space surrounded by charming homes that reflect its early development.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.portland.gov/neighborhoods/piedmont"
    },
    {
      "id": 4,
      "text": "Piedmont sits in Portland’s north and northeast sections, making it one of the city’s most residentially focused neighborhoods.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Piedmont%2C_Portland%2C_Oregon"
    },
    {
      "id": 5,
      "text": "Every month, the Piedmont Neighborhood Association gathers on the third Thursday to discuss community plans and events.",
      "sourceSentenceIds": [
        15
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.portland.gov/neighborhoods/piedmont"
    },
    {
      "id": 6,
      "text": "Historic Piedmont now overlaps parts of the Humboldt and King neighborhoods, linking it to the broader early Portland expansion.",
