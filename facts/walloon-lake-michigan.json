  "facts": [
    {
      "id": 1,
      "text": "Walloon Lake got its name in 1900, replacing the old Bear Lake title to honor Belgian Walloon settlers who arrived in the area.",
      "sourceSentenceIds": [
        1,
        7
      ],
      "sourceLabels": [
        "Web source 2",
        "Wikipedia"
      ],
      "source": "https://michigan4you.com/history-of-walloon-lake/"
    },
    {
      "id": 2,
      "text": "Ernest Hemingway spent his summers here, and the town now marks his legacy with a Michigan State Historic Site and a dual‑sided marker.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Walloon_Lake%2C_Michigan"
    },
    {
      "id": 3,
      "text": "The village grew around a railroad depot and steamboat landing, turning the lakeside into a bustling resort in the late 1800s.",
      "sourceSentenceIds": [
        1,
        23
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://michigan4you.com/history-of-walloon-lake/"
    },
    {
      "id": 4,
      "text": "A family cottage on the lake was listed in 1968 as a National Historic Landmark, one of only 43 such sites in Michigan.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Walloon_Lake%2C_Michigan"
    },
    {
      "id": 5,
      "text": "Long before resorts, the Anishinaabe called the water Muqua Nebis, and the area remained home to their peoples for centuries.",
