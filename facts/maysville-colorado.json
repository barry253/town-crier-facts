  "facts": [
    {
      "id": 1,
      "text": "Maysville sits at 9,504 feet, high above the Arkansas River valley, and was once a bustling mining community in Chaffee County.",
      "sourceSentenceIds": [
        13
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.uncovercolorado.com/towns/maysville/"
    },
    {
      "id": 2,
      "text": "The town lies on the historic route up Monarch Pass, just west of Poncha Springs and Salida, a favorite drive for mountain bikers and hikers.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.uncovercolorado.com/towns/maysville/"
    },
    {
      "id": 3,
      "text": "Maysville covers 7,957 acres, a sprawling area that once hosted a thriving 19th‑century settlement.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Maysville%2C_Colorado"
    },
    {
      "id": 4,
      "text": "A post office opened in Maysville in 1879, marking the town’s brief but notable role in Colorado’s mining boom.",
      "sourceSentenceIds": [
        20
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://roadsidethoughts.com/co/maysville-xx-chaffee-profile.htm"
    },
    {
      "id": 5,
      "text": "Today Maysville is considered a historic ghost town, with no remaining structures and only a few scattered foundations.",
      "sourceSentenceIds": [
        3,
        6
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://roadsidethoughts.com/co/maysville-xx-chaffee-profile.htm"
    },
    {
      "id": 6,
      "text": "The community’s elevation is about 1½ miles above sea level, placing it among Colorado’s highest former settlements.",
      "sourceSentenceIds": [
        21,
