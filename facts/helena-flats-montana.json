      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The Conrad Mansion Museum offers exhibits on local history and culture, housed in a beautifully preserved 19th‑century home.",
      "sourceSentenceIds": [
        5,
