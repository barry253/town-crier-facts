      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town’s original settlement was abandoned in 1827 after Indian raids, then resettled successfully in 1834.",
      "sourceSentenceIds": [
        4,
        14
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Anton_Chico%2C_New_Mexico",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The 1822 Anton Chico Land Grant covered 378,537 acres, petitioned by Salvador Tapia and 36 others.",
      "sourceSentenceIds": [
        11,
        12
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Anton_Chico%2C_New_Mexico",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Early adobe houses in Anton Chico had no windows or floors, a modest design typical of Hispano settlements.",
      "sourceSentenceIds": [
        17,
        18,
        19
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Anton_Chico%2C_New_Mexico",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Anton Chico’s location along the Pecos River made it a launch point for Ciboleros and Comancheros in the 19th century.",
      "sourceSentenceIds": [
        19
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Anton_Chico%2C_New_Mexico",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The rerouting of Route 66 before 1937, which once crossed the Pecos River near Anton Chico, contributed to the town’s decline.",
