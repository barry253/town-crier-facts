  "facts": [
    {
      "id": 1,
      "text": "Lowell was founded in 1831 by Daniel Marsac as a trading post beside the Grand River.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Lowell%2C_Michigan",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town’s name came from the post office established in 1851, which was renamed after the township.",
      "sourceSentenceIds": [
        3,
        4
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Lowell%2C_Michigan",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "From 1932 to 1977, Lowell hosted two‑hour minstrel shows on the showboat Robert E., featuring musicians and blackface performers until 1967.",
      "sourceSentenceIds": [
        5,
        6
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Lowell%2C_Michigan",
      "category": "culture",
      "quality": "poor",
      "qualityReason": "unverified=['two-hour']"
    },
    {
      "id": 4,
      "text": "The historic 1873 Graham Home, now the Lowell Area Historical Museum, is listed on the National Register of Historic Places and showcases the area’s fur trade and industry.",
      "sourceSentenceIds": [
        11,
        12
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.experiencegr.com/articles/post/lowell/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The Old Theater, originally built in 1928 as The Strand Theater, served as a movie house with vaudeville acts until 1985.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.experiencegr.com/articles/post/lowell/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Downtown Lowell spans six walkable blocks along the Flat River, offering parks, trails, and outdoor recreation.",
