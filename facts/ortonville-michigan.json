  "facts": [
    {
      "id": 1,
      "text": "Amos Orton founded Ortonville in 1848, building a dam on Kearsley Creek to power his gristmill.",
      "sourceSentenceIds": [
        1,
        6
      ],
      "sourceLabels": [
        "Web source 1",
        "Wikipedia"
      ],
      "source": "https://www.ortonvillevillage.com/community/history.php",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "In the 1920s the Ortonville Mill briefly supplied electric power to the village, an early example of local electrification.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://thumbwind.com/2026/02/12/history-of-ortonville-michigan/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "When the railroad chose Holly instead of Ortonville, the village’s founder became despondent, but the town still grew around its mill.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.ortonvillevillage.com/community/history.php",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The Ortonville Community Historical Society now houses a museum in the 1968‑donated mill, preserving the village’s early industrial heritage.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.ortonvillevillage.com/community/history.php",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The Downtown Development Authority and Village Council work together to keep Ortonville’s historic charm while welcoming new businesses.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.ortonvillevillage.com/community/history.php",
      "category": "other",
      "quality": "poor",
      "qualityReason": "editorial_filler"
    },
    {
      "id": 6,
      "text": "Ortonville sits roughly 41 miles north of downtown Detroit, midway between Pontiac and Flint in northern Oakland County.",
