      "quality": "good"
    },
    {
      "id": 2,
      "text": "Route 40, first paved in the 1810s, opened Moscow to traders and settlers moving through Allegany County’s remote valleys.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
