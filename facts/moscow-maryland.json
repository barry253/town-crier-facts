      "quality": "poor",
      "qualityReason": "location_description"
    },
    {
      "id": 4,
      "text": "Native American tribes such as the Shawnee and Delaware once used the area for villages, hunting, and seasonal camps before European arrival.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/moscow_maryland",
      "category": "people",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Legacy of coal mining still shows up today, with acid mine drainage lowering stream pH to as low as 3.0 and raising iron levels up to 15 mg/L.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/moscow_maryland",
