  "facts": [
    {
      "id": 1,
      "text": "Flatlands got its name from the Dutch Nieuw Amersfoort, which the English renamed after conquering the area in 1664.",
      "sourceSentenceIds": [
        4,
        6
      ],
      "sourceLabels": [
        "Web source 1",
        "Web source 2"
      ],
      "source": "https://www.cityneighborhoods.nyc/flatlands",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The Flatlands Reformed Church, a Greek‑Revival white clapboard building with a tall spire, was erected in 1848.",
      "sourceSentenceIds": [
        2,
        16
      ],
      "sourceLabels": [
        "Web source 2",
        "Web source 2"
      ],
      "source": "https://brooklyneagle.com/327549/flatlands-history/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The church’s congregation began in 1654, but its first dual worship space and parsonage appeared nine years later.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://brooklyneagle.com/327549/flatlands-history/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Flatlands joined the City of Brooklyn in 1896, ending its status as an independent town.",
      "sourceSentenceIds": [
        7,
        30
      ],
      "sourceLabels": [
        "Wikipedia",
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Flatlands%2C_Brooklyn",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The Flatlands branch of the Brooklyn Public Library, opened in 1941, remains a cornerstone of neighborhood identity.",
      "sourceSentenceIds": [
        20
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.cityneighborhoods.nyc/flatlands",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "18th‑century homes like the Stoothoff‑Baxter‑Kouwenhaven and Joost Van Nuyse houses still line Flatlands streets.",
