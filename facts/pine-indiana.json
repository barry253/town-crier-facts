  "facts": [
    {
      "id": 1,
      "text": "Pine Village earned its name from a lone pine tree that once stood on a bluff overlooking Pine Creek.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Pine_Village%2C_Indiana",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Isaac and John R. Metsker laid out Pine Village in 1851, with a plat map drawn by surveyor Perrin Kent.",
      "sourceSentenceIds": [
        14,
        15
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Pine_Village%2C_Indiana",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Rail service arrived in the 1870s, and by 1883 the Chicago and Great Southern Railway connected Pine Village to Attica and Fair Oaks.",
      "sourceSentenceIds": [
        18,
        19
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Pine_Village%2C_Indiana",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Pine Village sits where State Road 55 meets State Road 26, just north of Big Pine Creek.",
      "sourceSentenceIds": [
        24
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Pine_Village%2C_Indiana",
