  "facts": [
    {
      "id": 1,
      "text": "Borrego Springs sits on the floor of the Borrego Valley, the western edge of the Sonoran Desert ecoregion.",
      "sourceSentenceIds": [
        17
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
