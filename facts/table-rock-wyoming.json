    },
    {
      "id": 2,
      "text": "Table Rock began in the late 1800s as a small railroad depot along the Union Pacific line.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/table_rock_wyoming"
    },
    {
      "id": 3,
      "text": "Early history at Table Rock includes an association with the infamous Diamond Hoax scam of 1872.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/table_rock_wyoming"
    },
    {
      "id": 4,
      "text": "Colorado Interstate Gas built Table Rock in the late 1970s as a company town to house natural gas workers.",
      "sourceSentenceIds": [
        26
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Table_Rock%2C_Wyoming"
    },
    {
      "id": 5,
      "text": "Table Rock provided employees with free three- or four-bedroom homes and a community center during the energy boom.",
      "sourceSentenceIds": [
        28
