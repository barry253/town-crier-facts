  "facts": [
    {
      "id": 1,
      "text": "Turley was once called Alcatraz in early 1900s records, a name tied to its early settlers at the San Juan and Los Pinos Rivers.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/turley_new_mexico"
    },
    {
      "id": 2,
      "text": "Early Hispano families founded Turley in the 1870s, drawn by fertile river lands amid the expanding wagon road network.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/turley_new_mexico"
    },
    {
      "id": 3,
      "text": "Turley sits on the southeast side of the San Juan River, in northeastern San Juan County.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Turley%2C_New_Mexico"
    },
    {
      "id": 4,
      "text": "The town experiences a semi‑arid desert climate, with July highs around 92°F and winter lows near 20°F.",
      "sourceSentenceIds": [
        26
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/turley_new_mexico"
    },
    {
      "id": 5,
      "text": "Because Turley lies in the San Juan floodplain, heavy rains or snowmelt can inundate about 60% of properties over the next three decades.",
      "sourceSentenceIds": [
        23
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/turley_new_mexico"
    },
    {
      "id": 6,
      "text": "1950s surveys before Navajo Dam built uncovered early farmsteads in Turley, complete with jacal, adobe walls, storage pits, hornos, and acequias.",
      "sourceSentenceIds": [
