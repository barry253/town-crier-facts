  "facts": [
    {
      "id": 1,
      "text": "Laredo was christened by Great Northern Railway officials in 1912 after a Spanish town, giving the Montana community a European name.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.mtmemory.org/nodes/view/128638",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "In 1912, Laredo emerged as a rural siding, becoming a modest hub for grain shipment and local trade amid sparse settlement.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/laredo_montana",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "By 1915, the little town boasted 12 businesses, all lined in a single row along the tracks.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.mtmemory.org/nodes/view/128638",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Tractor use on Montana farms rose from 36% in 1930 to 47.6% by 1940, spurred by federal loans and labor shortages.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/laredo_montana",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "During the New Deal, local farmers in Laredo secured Farm Security Administration loans to buy purebred Hereford cattle and boost ranching.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/laredo_montana",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Laredo experiences a semi‑arid continental climate, with harsh January lows around 8°F and July highs near 85°F.",
      "sourceSentenceIds": [
