  "facts": [
    {
      "id": 1,
      "text": "Brickerville takes its name from Peter Bricker, a Mennonite pioneer who arrived from Germany in 1732 and received land grants in 1733.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/brickerville_pennsylvania",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The Brickerville House, a sandstone tavern built in 1797 by Prussian immigrant John Bricker, served stagecoach passengers and teamsters.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/brickerville_pennsylvania",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "During the American Revolution and the Civil War, Brickerville furnaces forged cannonballs and gun blocks, supplying wartime metalwork to the nation.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/brickerville_pennsylvania",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Brickerville sits on a ridge that drains northeast to Furnace Run and south to Hammer Creek, both feeding the Conestoga River watershed.",
      "sourceSentenceIds": [
        17,
        18
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Brickerville%2C_Pennsylvania",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "A Pennsylvania Keystone historical marker in Elizabeth Township notes Brickerville’s 1741 founding and honors Peter Bricker as the pioneer settler.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/brickerville_pennsylvania",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "In the 20th century, Brickerville shifted from heavy industry to a quiet agricultural community, preserving iron‑era ruins as historical sites.",
      "sourceSentenceIds": [
