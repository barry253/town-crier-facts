  "facts": [
    {
      "id": 1,
      "text": "Salcha was originally home to Athabascan people and became a key stop for gold prospectors during the early 1900s Alaska Gold Rush.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 2"
