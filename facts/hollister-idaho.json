      ],
      "source": "https://grokipedia.com/page/hollister_idaho",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Early settlers on the Oregon Trail crossed Hollister’s arid sagebrush, stopping at water sources like Rock Creek and Salmon Falls Creek.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 1"
