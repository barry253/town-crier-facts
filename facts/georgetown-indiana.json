  "facts": [
    {
      "id": 1,
      "text": "Georgetown was platted in 1833 by George Waltz, after whom the town is named, and a post office opened in 1837.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/georgetown_historic_district_georgetown_indiana"
    },
    {
      "id": 2,
      "text": "The town’s main road, originally called Whiskey Run Road because of local distilleries, later became State Road 64 and made Georgetown a key stagecoach stop.",
      "sourceSentenceIds": [
        1,
        5
      ],
      "sourceLabels": [
        "Web source 1",
        "Web source 2"
      ],
      "source": "https://destinationgeorgetownin.org/about-georgetown/"
    },
    {
      "id": 3,
      "text": "Georgetown’s historic district, listed on the National Register in 2013, contains 163 contributing buildings and the Georgetown Trestle railroad bridge.",
      "sourceSentenceIds": [
        13
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/georgetown_historic_district_georgetown_indiana"
    },
    {
      "id": 4,
      "text": "The Wolfe Hotel, opened in 1835, served as a stagecoach inn for travelers passing through Georgetown.",
      "sourceSentenceIds": [
        30
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://destinationgeorgetownin.org/about-georgetown/"
    },
    {
      "id": 5,
      "text": "Patrick Shields, a Virginian who built the first sawmill in 1805, marked Georgetown’s first permanent settlement.",
      "sourceSentenceIds": [
        18
      ],
      "sourceLabels": [
        "Web source 2"
      ],
