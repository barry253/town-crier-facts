      "id": 1,
      "text": "Ilioupoli’s name means “City of the Sun,” inspired by ancient Heliopolis where founder Pavlos Drandakis studied.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 2"
      ],
