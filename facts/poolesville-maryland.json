  "facts": [
    {
      "id": 1,
      "text": "Poolesville was incorporated in 1867 and named after John Poole, Jr., who built a log store on a 15‑acre tract he inherited from his father.",
      "sourceSentenceIds": [
        12,
        19,
        20
      ],
      "sourceLabels": [
        "Web source 1",
        "Wikipedia"
      ],
      "source": "https://msa.maryland.gov/msa/mdmanual/37mun/poolesville/html/p.html"
    },
    {
      "id": 2,
      "text": "During the Civil War, Union troops used the 1826 Methodist Church as a signal post and hospital while the town served as a temporary headquarters for the 1863 march to Gettysburg.",
      "sourceSentenceIds": [
        16
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://marylandroadtrips.com/history-arts-drinks-and-eats-all-in-a-days-trip-to-poolesville/"
    },
    {
      "id": 3,
      "text": "A historic lockhouse at Edwards Ferry lets visitors stay in a building where Union soldiers crossed the Potomac River en route to Gettysburg.",
      "sourceSentenceIds": [
        17
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://marylandroadtrips.com/history-arts-drinks-and-eats-all-in-a-days-trip-to-poolesville/"
    },
    {
      "id": 4,
      "text": "White's Ferry, a Potomac River crossing west of Poolesville, stopped operating in December 2020 after a legal dispute over riverbank land with Rockland Farm.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Poolesville%2C_Maryland"
    },
    {
      "id": 5,
      "text": "Actor Tony Lo Bianco, famed for The French Connection, owned a horse farm in Poolesville where he spent his final years.",
