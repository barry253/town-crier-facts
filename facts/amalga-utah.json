      "id": 1,
      "text": "Latter-Day Saint settler Hans Jorgensen first settled Amalga in 1869, with other pioneers arriving by 1891.",
      "sourceSentenceIds": [
        13,
        14,
        30
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Amalga%2C_Utah"
    },
    {
      "id": 2,
      "text": "Amalga took its name from the Amalgamated Sugar Company, which agreed to build a factory in town in 1916.",
      "sourceSentenceIds": [
        2,
        3
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Amalga%2C_Utah"
    },
    {
      "id": 3,
      "text": "A sugar beet blight forced the town's sugar plant to close in 1929, leading to the removal of the local railroad.",
      "sourceSentenceIds": [
        5,
        9
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Amalga%2C_Utah"
    },
    {
      "id": 4,
      "text": "The Cache Valley Dairy Association purchased the former sugar beet plant in 1941 to process milk into Swiss cheese.",
      "sourceSentenceIds": [
        20
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Amalga%2C_Utah"
    },
    {
      "id": 5,
      "text": "Amalga is currently home to the Schreiber Foods plant.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Amalga%2C_Utah"
    },
    {
      "id": 6,
      "text": "Early residents of Amalga used a local schoolhouse for both social gatherings and church meetings starting in 1891.",
