  "facts": [
    {
      "id": 1,
      "text": "Pardes Hanna was named after Hannah Primrose de Rothschild, a generous benefactor honored by many Israeli towns.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Pardes_Hanna-Karkur",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The Founders' House, once the town’s first kindergarten, now archives the shared history of Pardes Hanna and Karkur.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://shimur.org/sites/founders-house-pardes-hanna-karkur/?lang=en",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Pardes Hanna was founded in 1929 by the Palestine Jewish Colonisation Association just east of Karkur.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Pardes_Hanna-Karkur",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "In 1969, the two towns united, creating the single municipal authority of Pardes Hanna-Karkur.",
      "sourceSentenceIds": [
        29
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Pardes_Hanna-Karkur",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Pardes Hanna-Karkur is linked to the Caesarea-Pardes Hanna railway station and Egged and Kavim bus lines.",
      "sourceSentenceIds": [
        16
