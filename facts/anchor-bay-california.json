  "facts": [
    {
      "id": 1,
      "text": "Anchor Bay began as the 1850s doghole port Fish Rock, where shallow‑draft schooners unloaded redwood and tanbark.",
      "sourceSentenceIds": [
        1,
        26
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/anchor_bay_california",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Around 1900, store owner Dave Berry Jr. carved a wooden anchor sign, giving the area its name.",
      "sourceSentenceIds": [
        18,
        28
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/anchor_bay_california",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "By the 1920s, Anchor Bay shifted from lumber to tourism, with entrepreneurs opening cabins, a restaurant, and a dance hall.",
      "sourceSentenceIds": [
        20,
        30
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/anchor_bay_california",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The 1976 California Coastal Act helped protect Anchor Bay’s shoreline, limiting development near sensitive habitats.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/anchor_bay_california",
      "category": "other",
      "quality": "poor",
      "qualityReason": "vague"
    },
    {
      "id": 5,
      "text": "Long before settlers, the Northern Pomo people sustained communities in Anchor Bay, harvesting shellfish, fish, and seaweed.",
      "sourceSentenceIds": [
        4,
        22
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/anchor_bay_california",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Anchor Bay enjoys a Mediterranean climate, with warm, dry summers that can exceed 78°F and mild, rainy winters.",
