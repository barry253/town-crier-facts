  "facts": [
    {
      "id": 1,
      "text": "Founded in 1670 by Jean‑Baptiste Le Gardeur, son of seigneur Pierre Le Gardeur, Repentigny began as a small agricultural settlement.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Repentigny",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Repentigny sits north of Montreal on the lower L'Assomption River, right where the river meets the Saint Lawrence.",
      "sourceSentenceIds": [
        3,
        4
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Repentigny",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The town was the western terminus of the historic Chemin du Roy, a road that once stretched eastward to Quebec City.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Repentigny",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "In 2002, Repentigny merged with the neighboring city of Le Gardeur, forming the modern municipality we see today.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Repentigny",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Every late August, Repentigny hosts the National Bank Junior Tennis Internationals of Canada, the country’s largest junior tennis event.",
      "sourceSentenceIds": [
        21
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Repentigny",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "During winter, the Festival de Feu et de Glace lights up Repentigny with fire and ice displays that draw visitors from across the region.",
      "sourceSentenceIds": [
        16
      ],
      "sourceLabels": [
