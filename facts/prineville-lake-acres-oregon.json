  "facts": [
    {
      "id": 1,
      "text": "Prineville Lake Acres is a census-designated place located in western Crook County, about twelve miles southeast of Prineville.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Prineville_Lake_Acres%2C_Oregon"
    },
    {
      "id": 2,
      "text": "Barney Prine founded the nearby town of Prineville in 1868 and operated a blacksmith shop and general store there.",
      "sourceSentenceIds": [
        1,
        20
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://welcometoprineville.com/prineville-historical-matters/"
    },
    {
      "id": 3,
      "text": "Monroe Hodges helped found Prineville by laying out the town two years after Barney Prine first established the area.",
      "sourceSentenceIds": [
        21
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://welcometoprineville.com/prineville-historical-matters/"
    },
    {
      "id": 4,
      "text": "Prineville is the oldest incorporated city in Central Oregon and established its first post office in 1871.",
      "sourceSentenceIds": [
        6,
        22
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://welcometoprineville.com/prineville-historical-matters/"
    },
    {
      "id": 5,
      "text": "Prineville is known as the Cowboy Capitol and the Land of Discovery within the region of Central Oregon.",
      "sourceSentenceIds": [
        24
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://welcometoprineville.com/"
    },
    {
      "id": 6,
      "text": "The local economy of the Prineville area was originally founded on the farming and timber industries.",
      "sourceSentenceIds": [
        4
