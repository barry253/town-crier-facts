      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The Chicago and Eastern Illinois Railroad arrived in 1898, laying tracks a mile northeast and reshaping the town’s layout.",
      "sourceSentenceIds": [
        7,
        10,
        11
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Goreville%2C_Illinois",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The Goreville Telephone Company, founded by William Guy Pearson Terry, gave the village its first wired connection.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
