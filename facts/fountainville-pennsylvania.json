  "facts": [
    {
      "id": 1,
      "text": "Fountainville sits at the crossroads of PA Route 313 and Ferry Road, the tripoint of Doylestown, New Britain, and Plumstead townships.",
      "sourceSentenceIds": [
        5,
        7
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Fountainville%2C_Pennsylvania"
    },
    {
      "id": 2,
      "text": "Fountainville’s name comes from artesian wells that once burst like fountains, giving Fountainville its nickname.",
      "sourceSentenceIds": [
        18
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://pennsylvaniagenealogy.org/bucks/fountainville-pennsylvania.htm"
    },
    {
      "id": 3,
      "text": "A post office opened on January 5, 1875, with John L. Kramer, a future Doylestown councilman, as its first postmaster.",
      "sourceSentenceIds": [
        8,
        9
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://pennsylvaniagenealogy.org/bucks/fountainville-pennsylvania.htm"
    },
    {
      "id": 4,
      "text": "An old graveyard southeast of Fountainville holds a German‑inscribed marble stone honoring Abraham Fried, who died in 1772.",
      "sourceSentenceIds": [
        13,
        14,
        15
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://pennsylvaniagenealogy.org/bucks/fountainville-pennsylvania.htm"
    },
    {
      "id": 5,
      "text": "Before 1835, a building in Fountainville served as a public house, later becoming a private home after 1857.",
      "sourceSentenceIds": [
        17
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://pennsylvaniagenealogy.org/bucks/fountainville-pennsylvania.htm"
    },
    {
      "id": 6,
      "text": "Fountainville is an unincorporated community, meaning it has no separate local government and is governed by the surrounding townships.",
