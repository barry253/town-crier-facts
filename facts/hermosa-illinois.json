  "facts": [
    {
      "id": 1,
      "text": "Hermosa got its name in 1885 to avoid duplicate post office names, linked to Kenney's rail station.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Hermosa%2C_Chicago",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The original Schwinn Bicycle Company headquarters operated on Kostner Avenue from the early 1900s until the early 1980s, making Hermosa a hub of American manufacturing.",
      "sourceSentenceIds": [
        16,
        20
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.bronzecommhub.com/blog/hermosa-chicago-s-hidden-corner-of-industry-culture-and-legacy",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "During World War II, Schwinn employed African American laborers under a federal desegregation order, marking a quiet step toward racial integration.",
      "sourceSentenceIds": [
        15,
        22
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.bronzecommhub.com/blog/hermosa-chicago-s-hidden-corner-of-industry-culture-and-legacy",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "In 2018, the Hermosa Bungalow Historic District was added to the National Register of Historic Places, preserving the area north of Diversey.",
      "sourceSentenceIds": [
        11
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.hermosachi.com/about-hermosa-chicago",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The name “Hermosa” comes from Spanish for “beautiful,” reflecting the modest homes, tidy gardens, and tree‑lined streets that characterize the neighborhood.",
