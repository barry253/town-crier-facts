  "facts": [
    {
      "id": 1,
      "text": "Five Points was founded in the 1860s as a residential suburb and quickly attracted African Americans seeking better lives after the Civil War.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.britannica.com/place/Five-Points",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "In 2002, Five Points was designated a cultural historic district, honoring its pivotal role in Denver’s African‑American history.",
      "sourceSentenceIds": [
        16
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Five_Points%2C_Denver",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The historic Rossonian Hotel, once a hub for jazz legends, still stands as a reminder of the neighborhood’s musical legacy.",
      "sourceSentenceIds": [
        13
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.britannica.com/place/Five-Points",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Zion Baptist Church, established in 1865, is Colorado’s oldest African‑American congregation and first met in a log building at 20th and Arapahoe.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://history.denverlibrary.org/neighborhood-history-guide/five-points-whittier-neighborhood-history",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The first Denver street railroad, the Denver Horse Railroad Company, linked Five Points to downtown in 1871, sparking early growth.",
      "sourceSentenceIds": [
        23
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://history.denverlibrary.org/neighborhood-history-guide/five-points-whittier-neighborhood-history",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Curtis Park, founded in 1868 on a 2½‑acre parcel named for Samuel Curtis, became Denver’s first public park and a community gathering spot.",
      "sourceSentenceIds": [
        6
      ],
