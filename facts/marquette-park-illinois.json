  "facts": [
    {
      "id": 1,
      "text": "Marquette Park takes its name from Father Jacques Marquette, the 17th‑century French Jesuit missionary who explored the region.",
      "sourceSentenceIds": [
        8,
        16
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Marquette_Park_(Chicago)",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The park’s memorial features three oversized brick steles that illustrate the neighborhood’s past, present, and hopeful future.",
      "sourceSentenceIds": [
        13,
        29
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Marquette_Park_(Chicago)",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "A bench in the memorial holds nearly 300 tiles, each painted by Chicago residents to spell “Home” in languages spoken by the community.",
      "sourceSentenceIds": [
        14,
        30
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Marquette_Park_(Chicago)",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Spanning 323 acres, Marquette Park is the largest park on Chicago’s southwest side and the city’s biggest neighborhood park.",
      "sourceSentenceIds": [
        20,
        22
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Marquette_Park_(Chicago)",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "In 1935 the Chicago Park District cut the original 18‑hole golf course to nine holes, freeing land for new recreational facilities.",
      "sourceSentenceIds": [
        18
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.chicagoparkdistrict.com/parks-facilities/marquette-jacques-park",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "A remnant of the historic Ashburn prairie survives within Marquette Park, offering a rare glimpse of the area’s pre‑urban landscape.",
      "sourceSentenceIds": [
