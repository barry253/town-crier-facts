  "facts": [
    {
      "id": 1,
      "text": "Rohrsburg's name comes from Prussian Frederick Rohr, who acquired the site in 1825 from Samuel Sherts.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Rohrsburg%2C_Pennsylvania",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "In 1826, Rohrsburg began as a single wheelwright's shop before growing into a small community with a sawmill, carding mill, and pottery by the late 1800s.",
      "sourceSentenceIds": [
        11,
        12
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Rohrsburg%2C_Pennsylvania",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The Susquehanna, Bloomsburg, and Berwick Railroad once stopped in Rohrsburg, linking the town to regional trade in the late 19th and early 20th centuries.",
      "sourceSentenceIds": [
        1,
        3
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Rohrsburg%2C_Pennsylvania",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Little Green Creek runs through Rohrsburg, joining Green Creek and eventually Fishing Creek, shaping the local farmland landscape.",
      "sourceSentenceIds": [
        15
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Rohrsburg%2C_Pennsylvania",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The town’s climate swings from an average January high of 34°F to a July high of 84°F, with record extremes of 106°F and –20°F.",
