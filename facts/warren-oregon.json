  "facts": [
    {
      "id": 1,
      "text": "James Gill named Warren after his hometown of Warren, Massachusetts, when the local post office was established in 1885.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Warren%2C_Oregon"
    },
    {
      "id": 2,
      "text": "Warren was established in the early twentieth century as one of the last Swedish settlements in the United States.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/warren_oregon"
    },
    {
      "id": 3,
      "text": "About forty Swedish-speaking families founded Warren as an agricultural enclave focused on farming, dairy production, and lumber work.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/warren_oregon"
    },
    {
      "id": 4,
      "text": "The development of Warren occurred alongside the extension of the Northern Pacific Railroad line to the area.",
      "sourceSentenceIds": [
        14
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/warren_oregon"
    },
    {
      "id": 5,
      "text": "Before European American settlement, the area now known as Warren was part of the traditional territory of Chinookan-speaking peoples.",
      "sourceSentenceIds": [
        15
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/warren_oregon"
    },
    {
      "id": 6,
      "text": "Warren is an unincorporated community, meaning it has no municipal government.",
      "sourceSentenceIds": [
        30
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Warren%2C_Oregon"
    }
  ]
}
