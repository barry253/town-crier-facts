      ],
      "source": "https://en.wikipedia.org/wiki/Hampton%2C_Tennessee",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The Doe River Covered Bridge, built in the 1800s, is a historic landmark that showcases 19th‑century craftsmanship.",
      "sourceSentenceIds": [
        2,
