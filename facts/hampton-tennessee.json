      ],
      "source": "https://en.wikipedia.org/wiki/Hampton%2C_Tennessee",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town sits in a broad valley around the Doe River, surrounded by the Unaka Mountains.",
      "sourceSentenceIds": [
        27,
        22
      ],
      "sourceLabels": [
