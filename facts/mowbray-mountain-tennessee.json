  "facts": [
    {
      "id": 1,
      "text": "Mowbray Mountain’s history stretches back thousands of years, from prehistoric Paleo Indians to 19th‑century settlers, 20th‑century loggers, and Civilian Conservation Corps enrollees.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.nps.gov/grsm/learn/historyculture/index.htm",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Sunrise on Mowbray Mountain is at 07:23 and sunset at 19:08, giving drivers an 11‑hour‑45‑minute day to explore.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.trawellino.com/destinations/united-states/tennessee_mowbray-mountain",
      "category": "other",
      "quality": "poor",
      "qualityReason": "vague"
    },
    {
      "id": 3,
      "text": "The park works to protect historic structures, landscapes, and artifacts that tell the varied stories of people who once called these mountains home.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.nps.gov/grsm/learn/historyculture/index.htm",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Great Smoky Mountains National Park preserves a rich cultural tapestry of Southern Appalachian history, and Mowbray Mountain is a key part of that legacy.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.nps.gov/grsm/learn/historyculture/index.htm",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Mowbray Mountain is located within the boundaries of Great Smoky Mountains National Park.",
      "sourceSentenceIds": [
