  "facts": [
    {
      "id": 1,
      "text": "In 1962 the council renamed the rural area to Oud Osdorp to avoid confusion with the new garden city of Osdorp.",
      "sourceSentenceIds": [
        9,
        21,
        22
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://slotenoudosdorp.nl/over-oostdorp-later-osdorp-en-sinds-1962-oud-osdorp/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Around 1100 the land that is now Oud Osdorp was an uninhabitable peat bog with winding water channels.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://slotenoudosdorp.nl/over-oostdorp-later-osdorp-en-sinds-1962-oud-osdorp/",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The Osdorp Church stands as a striking architectural landmark, drawing history lovers to its historic nave.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://amsterdamcitycard.com/osdorp-amsterdam-read-this-before-your-visit/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Oud Osdorp was once part of the municipality of Sloten, which celebrated its 750th anniversary in 2024.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://slotenoudosdorp.nl/over-oostdorp-later-osdorp-en-sinds-1962-oud-osdorp/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "After Amsterdam annexed Sloten in 1921, the area was redesigned as a garden city, a plan unveiled by Cornelis van Eesteren in 1934.",
      "sourceSentenceIds": [
        17,
        18,
        19
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://slotenoudosdorp.nl/over-oostdorp-later-osdorp-en-sinds-1962-oud-osdorp/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Today, Osdorp hosts several eco‑friendly projects, including community gardens and recycling programs that reflect its residents’ sustainability values.",
