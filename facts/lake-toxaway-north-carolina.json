  "facts": [
    {
      "id": 1,
      "text": "In 1903, visionaries dammed the Toxaway River to create Lake Toxaway, then built a five‑story Toxaway Inn, sparking a resort era.",
      "sourceSentenceIds": [
        23
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://laketoxaway.com/"
    },
    {
      "id": 2,
      "text": "The original Greystone Inn mansion was built in 1915 by Lucy and George Armstrong, a Savannah socialite couple.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://laketoxawaycommunity.net/our-storied-history/"
    },
    {
      "id": 3,
      "text": "The Greystone Inn opened to guests on July 15, 1985, after being renamed for its distinctive stonework.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://laketoxawaycommunity.net/our-storied-history/"
    },
    {
      "id": 4,
      "text": "A flood‑dam burst in the 1910s caused the lake and its tourists to vanish, but the dam was rebuilt in 1960 by Reg Heinitsh and investors.",
      "sourceSentenceIds": [
        24,
        25,
        26
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://laketoxaway.com/"
    },
    {
      "id": 5,
      "text": "Lake Toxaway covers 640 acres and sits at a constant 3,010‑foot elevation, keeping its water level steady year‑round.",
      "sourceSentenceIds": [
        28,
        29
      ],
