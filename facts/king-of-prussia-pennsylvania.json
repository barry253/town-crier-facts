  "facts": [
    {
      "id": 1,
      "text": "King of Prussia got its name from a 1769 tavern that honored King Frederick II of Prussia, the 18th‑century monarch who opposed Britain.",
      "sourceSentenceIds": [
        3,
        9,
        11,
        14,
        15
      ],
      "sourceLabels": [
        "Web source 1",
        "Wikipedia"
      ],
