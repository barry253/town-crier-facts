      "qualityReason": "location_description"
    },
    {
      "id": 2,
      "text": "In 1970, a Toledo, Peoria and Western Railroad train derailed in downtown Crescent City, rupturing a propane tank car and sparking fires that gutted the town center.",
      "sourceSentenceIds": [
        4,
        10
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Crescent_City%2C_Illinois",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The disaster was later spotlighted on Discovery Channel’s “Destroyed in Seconds” episode 124.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Crescent_City%2C_Illinois",
      "category": "other",
      "quality": "poor",
      "qualityReason": "other"
    },
    {
      "id": 4,
      "text": "In 2009, Crescent-Iroquois High School closed, sending its students to neighboring schools and later repurposing the building for special education until 2019.",
      "sourceSentenceIds": [
        13,
        15
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Crescent_City%2C_Illinois",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Illinois Route 24 runs through Crescent City’s center, linking the village east to Watseka and west to Gilman near I‑57.",
