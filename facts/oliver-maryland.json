    {
      "id": 1,
      "text": "Oliver grew from a bustling market town in the early 1800s into a thriving commercial hub.",
      "sourceSentenceIds": [
        23
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.myoliver.org/oliver-history",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Between 1868 and 1873, builders filled Chase Street with elegant three‑story Italianate houses that still line the block today.",
      "sourceSentenceIds": [
        24
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.myoliver.org/oliver-history",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The Oliver Multi‑Purpose Center now occupies the former public grammar school built in 1890, complete with a 1931 annex.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.myoliver.org/oliver-history",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Saint Francis Xavier Catholic Church in Oliver holds the distinction of being the first African‑American Catholic church in the United States.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.myoliver.org/oliver-history",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Oliver was originally part of Jones Town, one of Baltimore’s earliest settlements, and joined the city in 1745.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.myoliver.org/oliver-history",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "From 1968 to 1972, the Baltimore Black Panther Chapter operated in Oliver, founded by Warren Hart before expanding beyond the town.",
