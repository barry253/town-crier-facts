  "facts": [
    {
      "id": 1,
      "text": "Huntersville received its name because it served as a rendezvous for trappers and hunters who came to trade pelts for supplies.",
      "sourceSentenceIds": [
        18
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Huntersville%2C_West_Virginia"
    },
    {
      "id": 2,
      "text": "Huntersville served as the first county seat of Pocahontas County before West Virginia even became a state.",
      "sourceSentenceIds": [
        23
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://pocahontastimes.com/history-comes-alive-at-huntersville/"
    },
    {
      "id": 3,
      "text": "The Huntersville Presbyterian Church was listed on the National Register of Historic Places in 1978.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Huntersville%2C_West_Virginia"
    },
    {
      "id": 4,
      "text": "Hunting remains a strong tradition in Huntersville due to the vast stretches of Monongahela National Forest bordering the town.",
      "sourceSentenceIds": [
        22
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Huntersville%2C_West_Virginia"
    },
    {
      "id": 5,
      "text": "Native brook trout streams are tucked away in quiet places close to the town of Huntersville.",
