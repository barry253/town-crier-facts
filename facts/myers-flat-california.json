  "facts": [
    {
      "id": 1,
      "text": "Myers Flat was founded by the Myers family in the mid‑19th century.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Myers_Flat%2C_California",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The name “Flat” was added to distinguish Myers from Meyers in El Dorado County.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Myers_Flat%2C_California",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The town’s first federal service arrived when a post office opened in 1949.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Myers_Flat%2C_California",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Before the railroad, Myers Flat was a coach stop for travelers bound for San Francisco.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Myers_Flat%2C_California",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "A mill operated there until the mid‑1980s, and its former site is now part of Riverbend Cellars vineyards.",
      "sourceSentenceIds": [
        11,
        12
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Myers_Flat%2C_California",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The 1964 Christmas flood destroyed much of Myers Flat, and the town now lies below the 100‑year flood line.",
      "sourceSentenceIds": [
