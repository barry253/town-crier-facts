      "quality": "poor",
      "qualityReason": "location_description"
    },
    {
      "id": 3,
      "text": "Landen Lake, officially Landen Farm Drainage Lake, sits in the middle of the town’s homes and was created by damming Simpson’s Creek for flood control.",
      "sourceSentenceIds": [
        4,
        5,
        27,
        28
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Landen%2C_Ohio",
      "category": "other",
      "quality": "poor",
      "qualityReason": "location_description"
    },
    {
      "id": 4,
      "text": "In 2008 a dredging project removed 184,000 cubic yards of sediment from the lake, boosting its flood‑protection capacity.",
      "sourceSentenceIds": [
        10,
        30
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Landen%2C_Ohio",
      "category": "other",
      "quality": "poor",
      "qualityReason": "vague"
    },
    {
      "id": 5,
      "text": "Deerfield Park, a 95‑acre green space off U.S., offers eight baseball fields, two playgrounds, a fishing lake, and hiking trails.",
      "sourceSentenceIds": [
        12,
        13
      ],
      "sourceLabels": [
