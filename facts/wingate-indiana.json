  "facts": [
    {
      "id": 1,
      "text": "Wingate began as Pleasant Hill, a 1832 plat by Christian Bever, before adopting its current name.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Wingate%2C_Indiana",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town changed its name from Pleasant Hill to Wingate to avoid confusion with another rail‑line town of the same name.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Wingate%2C_Indiana",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "In the late 1890s and early 1900s, maps briefly labeled the town as Whitlock.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Wingate%2C_Indiana",
      "category": "other",
      "quality": "poor",
      "qualityReason": "other"
    },
    {
      "id": 4,
      "text": "Wingate pioneered the first electric basketball scoreboard in 1935, invented by local men Lee Haxton and Roy Meharry.",
      "sourceSentenceIds": [
        11
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Wingate%2C_Indiana",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Five Wingate natives—Homer Stonebraker, Jesse Wood, Lee Thorn, Alonzo Goldsberry, and Forest Crane—have been inducted into the Indiana Basketball Hall of Fame.",
      "sourceSentenceIds": [
        9,
        10
      ],
      "sourceLabels": [
