  "facts": [
    {
      "id": 1,
      "text": "Fulford was named for Arthur H. Fulford, an early settler whose mining claim sparked the town’s founding.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Fulford%2C_Colorado",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "In 1887 two prospectors discovered gold along a side drainage of Brush Creek, sparking the first mining boom in Fulford.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://4x4explore.com/rds/o_rds/old_fulford.html",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The town’s original camps, Nolan’s Camp and Polar City, merged after Arthur’s death to become Upper and Lower Fulford.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://4x4explore.com/rds/o_rds/old_fulford.html",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "A 1976 purchase by Rich and Jane Perske of four lots on Fifth Street led to a cabin overlooking Porphyry Mountain, preserving local history.",
      "sourceSentenceIds": [
        13
      ],
      "sourceLabels": [
        "Web source 2"
      ],
