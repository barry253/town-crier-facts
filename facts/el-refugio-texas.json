  "facts": [
    {
      "id": 1,
      "text": "El Refugio’s name comes from the Spanish mission Nuestra Señora del Refugio, founded in 1793 to serve the Karankawa Indians.",
      "sourceSentenceIds": [
        25,
        26
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://refugiocountytx.org/community/history-facts"
    },
    {
      "id": 2,
      "text": "The mission moved to the Mission River in 1793 and stayed active until 1830, long before the town was officially founded.",
      "sourceSentenceIds": [
        26,
        27
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://refugiocountytx.org/community/history-facts"
    },
    {
      "id": 3,
      "text": "In the 1850s, Refugio County became a regional hub for hide and tallow factories, fueling early economic growth.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://refugiocountytx.org/community/history-facts"
    },
    {
      "id": 4,
      "text": "Town leaders paid the railroad $18,000 and half of common lands to secure a 1905 depot just a mile from downtown.",
      "sourceSentenceIds": [
        5,
        6
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.tshaonline.org/handbook/entries/refugio-tx"
    },
    {
      "id": 5,
      "text": "The area that is now El Refugio was originally a Karankawa camping ground, noted for its nomadic lifestyle.",
      "sourceSentenceIds": [
        1
