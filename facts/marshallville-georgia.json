      "category": "people",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The town played a historic role in developing Georgia's peach industry, once being the largest peach grower in the U.S.",
      "sourceSentenceIds": [
        8,
        9,
        23
      ],
      "sourceLabels": [
        "Web source 1",
