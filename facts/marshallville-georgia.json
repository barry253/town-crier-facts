      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Samuel Rumph, known as the father of the Georgia peach industry, created the Elberta peach in his Marshallville orchards, naming it after his wife.",
      "sourceSentenceIds": [
        4,
        5,
        24
      ],
