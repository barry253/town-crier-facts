  "facts": [
    {
      "id": 1,
      "text": "South Beach once called Graham Beach, began as a summer colony of bungalows and tents.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/South_Beach%2C_Staten_Island",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The neighborhood’s main street, originally Seaside Boulevard, ran parallel to the shore and was later renamed Father Capodanno Boulevard.",
      "sourceSentenceIds": [
        1,
        2
      ],
      "sourceLabels": [
        "Wikipedia",
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/South_Beach%2C_Staten_Island",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "South Beach’s boardwalk, built in the 1880s, once stretched 1,700 feet and featured a carousel and Noah’s Ark ride.",
      "sourceSentenceIds": [
        20
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/South_Beach%2C_Staten_Island",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The area suffered two major fires in 1896 and 1902 that destroyed large portions of the boardwalk and hotels.",
      "sourceSentenceIds": [
        23,
        26
      ],
      "sourceLabels": [
        "Wikipedia",
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/South_Beach%2C_Staten_Island",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "South Beach’s railroad history lives on in the Robin Road Trestle, the only remaining piece of the old Railroad Avenue.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/South_Beach%2C_Staten_Island",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The neighborhood’s library branch, located at 21–25 Robin Road, serves as a community hub near Ocean Avenue and Father Capodanno Boulevard.",
