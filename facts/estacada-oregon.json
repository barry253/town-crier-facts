  "facts": [
    {
      "id": 1,
      "text": "Estacada was founded over a century ago as a timber town and a home for workers at the Cazadero Hydroelectric Dam.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.cityofestacada.org/community-visitors/history-community-profile/"
    },
    {
      "id": 2,
      "text": "The origin of the name Estacada is disputed, though some suggest it was named after a civic leader's daughters, Esther and Katie.",
      "sourceSentenceIds": [
        4,
        30
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 2"
      ],
      "source": "https://en.wikipedia.org/wiki/Estacada%2C_Oregon"
    },
    {
      "id": 3,
      "text": "Native American tribes, including the Clackamas and Molalla people, originally inhabited the area along the Clackamas River.",
      "sourceSentenceIds": [
        11
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.visitoregon.com/cities/estacada-oregon/"
    },
    {
      "id": 4,
      "text": "An interurban trolley line once connected Estacada with downtown Portland in the early twentieth century.",
      "sourceSentenceIds": [
        28
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Estacada%2C_Oregon"
    },
    {
      "id": 5,
      "text": "More than one hundred artists and artisans, including painters, sculptors, and musicians, call Estacada home.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.cityofestacada.org/community-visitors/history-community-profile/"
    },
    {
      "id": 6,
      "text": "The construction of the Hotel Estacada once made the town a weekend destination for residents of Portland via the railroad.",
