  "facts": [
    {
      "id": 1,
      "text": "Lakeview North is a small residential community situated in the North Platte River valley of eastern Wyoming.",
      "sourceSentenceIds": [
        20
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/lakeview_north_wyoming"
    },
    {
      "id": 2,
      "text": "The region takes its name from the North Platte River, which French fur traders dubbed Platte in the 1790s.",
      "sourceSentenceIds": [
        28
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/lakeview_north_wyoming"
    },
    {
      "id": 3,
      "text": "Indigenous peoples, including the Shoshone, Arapaho, Cheyenne, and Lakota Sioux, long inhabited the river valley for hunting and migration.",
      "sourceSentenceIds": [
        29
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/lakeview_north_wyoming"
    },
    {
      "id": 4,
      "text": "Emigrants and fur traders followed the North Platte River route through this vicinity as part of the Oregon Trail network.",
      "sourceSentenceIds": [
        30
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/lakeview_north_wyoming"
    },
    {
      "id": 5,
      "text": "Lakeview North features a semi-arid climate with significant seasonal temperature variations and an average annual precipitation of 14 inches.",
      "sourceSentenceIds": [
        22,
        23
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/lakeview_north_wyoming"
    },
    {
      "id": 6,
      "text": "The terrain of Lakeview North consists of flat to gently rolling plains with elevations averaging around 4,750 feet.",
