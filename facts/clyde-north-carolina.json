    {
      "id": 1,
      "text": "Clyde, North Carolina, was founded in 1890, marking the start of a mountain community.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Clyde%2C_North_Carolina",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town was named Clyde after a small settlement on the Pigeon River.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.clydenc.us/about",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Clyde’s town seal displays a 50‑mm anti‑aircraft gun, honoring veterans from World War I, II, Korea, and Vietnam.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 1"
      ],
