      "quality": "poor",
      "qualityReason": "location_description"
    },
    {
      "id": 5,
      "text": "Before European settlers, the Cherokee and other Indigenous peoples inhabited the area that is now Clyde for thousands of years.",
      "sourceSentenceIds": [
        16
