      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Just 20 miles west of Asheville, Clyde has long welcomed Appalachian travelers with Southern hospitality and historic inns.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://visithaywood.com/mountain-towns/clyde/",
