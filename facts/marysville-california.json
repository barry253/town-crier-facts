  "facts": [
    {
      "id": 1,
      "text": "Marysville was founded in 1850 at the junction of the Feather and Yuba rivers, becoming a key supply hub for Gold Rush operations.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://secretsanfrancisco.com/marysville-california-oldest-little-city/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The city’s name honors Donner Party survivor Mary Murphy Covillaud, giving it a unique historical origin.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://secretsanfrancisco.com/marysville-california-oldest-little-city/",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Historic downtown still hosts Gold Rush‑era landmarks, and marching bands, fire trucks, antique cars, floats, and dance groups parade through its streets.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Marysville%2C_California",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Marysville’s old brick and mortar library, the only one in Yuba County, reflects the town’s commitment to preserving its literary heritage.",
      "sourceSentenceIds": [
        23
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Marysville%2C_California",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The Candy Box, a local favorite since 1954, is famous for gooey chocolate turtles, a sweet slice of Marysville’s culinary tradition.",
      "sourceSentenceIds": [
