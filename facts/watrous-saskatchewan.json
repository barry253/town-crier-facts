      "category": "transport",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Watrous hosts the Jubilee Drive‑In Theatre in nearby Manitou Beach, one of Saskatchewan’s few still operating drive‑ins.",
      "sourceSentenceIds": [
        13,
        14
      ],
      "sourceLabels": [
        "Wikipedia"
