      ],
      "source": "https://www.watrousheritage.ca/watrous-brief-history/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The town sits on the Canadian National Railway mainline, a key route that once linked Saskatoon, Regina, and Prince Albert.",
      "sourceSentenceIds": [
        28
      ],
      "sourceLabels": [
        "Web source 1"
      ],
