  "facts": [
    {
      "id": 1,
      "text": "Venice, originally called the “Venice of America,” was founded by Abbot Kinney in 1905 as a beach resort town.",
      "sourceSentenceIds": [
        1,
        7
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Venice%2C_Los_Angeles",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The name “Venice of America” reflects Kinney’s vision to model the city after Venice, Italy, with canals and Italian‑style architecture.",
      "sourceSentenceIds": [
        1,
        11
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Venice%2C_Los_Angeles",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Venice is the birthplace of modern progressive skateboarding, celebrated in the documentary *Dogtown and Z‑Boys* and the film *The Lords of Dogtown*.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://venicechamber.net/visitors/about-venice/",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The Venice Beach boardwalk is famous for its murals, including Rip Cronk’s 1990 piece *Venice Beach* and the 2012 work *Touch of Venice* by Jonas.",
      "sourceSentenceIds": [
        15
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Venice%2C_Los_Angeles",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The legendary rock band The Doors formed in Venice in 1965, with members Ray Manzarek and Jim Morrison hailing from the area.",
      "sourceSentenceIds": [
        22
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Venice%2C_Los_Angeles",
      "category": "people",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Venice Beach will host the triathlon, marathon start, and road cycling events during the 2028 Summer Olympics.",
