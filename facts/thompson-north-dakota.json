  "facts": [
    {
      "id": 1,
      "text": "Thompson, a small North Dakota city, was founded in 1881 during the westward expansion of the United States.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Thompson%2C_North_Dakota"
    },
    {
      "id": 2,
      "text": "The town was originally called Norton because its first buildings sat on land owned by George Norton.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Thompson%2C_North_Dakota"
    },
    {
      "id": 3,
      "text": "The name changed to Thompson to honor Albert Thompson, a general store co‑owner who became the town’s first postmaster.",
      "sourceSentenceIds": [
        9,
        10
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Thompson%2C_North_Dakota"
    },
    {
      "id": 4,
      "text": "Thompson sits on the border of Allendale and Walle townships, with Walle to the east and Allendale to the west.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Thompson%2C_North_Dakota"
    },
    {
      "id": 5,
      "text": "Amtrak’s Empire Builder runs through Thompson on BNSF tracks, yet the train never stops there.",
      "sourceSentenceIds": [
        30
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Thompson%2C_North_Dakota"
    },
    {
      "id": 6,
      "text": "The first residents were businessmen who came to support new settlers in the area.",
