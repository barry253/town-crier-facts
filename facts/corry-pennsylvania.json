      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "In the late 1800s, Corry became a hub for Climax locomotive production, and a museum still displays one of these logging engines.",
      "sourceSentenceIds": [
        25,
        29,
        30
      ],
      "sourceLabels": [
        "Wikipedia",
