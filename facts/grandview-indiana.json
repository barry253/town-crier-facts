    {
      "id": 1,
      "text": "Grandview was laid out in 1851, and its name comes from the grand view of the Ohio River.",
      "sourceSentenceIds": [
        9,
        10
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Grandview%2C_Indiana",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "A post office has been operating in Grandview since 1854, keeping the town connected for over a century.",
      "sourceSentenceIds": [
        11
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Grandview%2C_Indiana",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Grandview sits along the Ohio River at river mile 742, just upstream from Rockport and downstream from Lewisport.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Grandview%2C_Indiana",
      "category": "other",
      "quality": "poor",
      "qualityReason": "location_description"
    },
    {
      "id": 4,
      "text": "The Rockport Generating Station lies just west of Grandview, a reminder of the town’s industrial past.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Grandview%2C_Indiana",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Grandview hosts a branch of the Spencer County Public Library, offering residents access to regional collections.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Grandview%2C_Indiana",
      "category": "landmark",
      "quality": "good"
    },
    {
