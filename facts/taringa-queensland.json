  "facts": [
    {
      "id": 1,
      "text": "Taringa’s name blends Aboriginal words tarau (stones) and nga, meaning “place of stones”.",
      "sourceSentenceIds": [
        17,
        18
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Taringa%2C_Queensland"
    },
    {
      "id": 2,
      "text": "The Main Line railway opened 14 June 1875, and Taringa station, originally West Milton, opened the same year.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Taringa%2C_Queensland"
    },
    {
      "id": 3,
      "text": "In 1890 the Taringa Divisional Board was established under the Divisional Boards Act 1887, giving the suburb local governance.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://heritage.brisbane.qld.gov.au/heritage-places/2506"
    },
    {
      "id": 4,
      "text": "Edge Hill, a historic home built by the Phillips family in 1912, hosted mid‑twentieth‑century social events and reflects Taringa’s residential evolution.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://heritage.brisbane.qld.gov.au/heritage-places/2506"
    },
    {
      "id": 5,
      "text": "Large tracts of land were owned by pioneers like Thomas Lodge Murray Prior, James Henderson, Richard Gailey and Robert Cribb until the 1870s, when subdivision began.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://heritage.brisbane.qld.gov.au/heritage-places/2506"
    },
    {
      "id": 6,
      "text": "The suburb sits on a ridge along Swann Road, with steep slopes on either side, shaping its residential layout.",
