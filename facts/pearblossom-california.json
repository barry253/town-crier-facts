  "facts": [
    {
      "id": 1,
      "text": "Pearblossom got its name from the many pear farms that bloomed on the southern ridge of Antelope Valley.",
      "sourceSentenceIds": [
        15,
        25,
        26
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Pearblossom%2C_California",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town sits in the Mojave Desert’s Antelope Valley and was first settled by Kitanemuk and Serrano tribes before European-American homesteaders arrived in the mid‑1800s.",
      "sourceSentenceIds": [
        1,
        8,
        23
      ],
      "sourceLabels": [
        "Web source 2",
        "Web source 1"
      ],
      "source": "https://digital-desert.com/pearblossom-ca/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Pearblossom’s quiet agricultural roots are still visible in the abandoned farms that have returned to desert or been replaced by small‑scale housing.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Pearblossom%2C_California",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The town’s main street, Route 138, is notorious for being one of the most dangerous roads in the U.S., a fact that locals joke about while driving.",
      "sourceSentenceIds": [
        17
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Pearblossom%2C_California",
      "category": "culture",
      "quality": "poor",
      "qualityReason": "editorial_filler"
    },
    {
      "id": 5,
      "text": "Pearblossom was the setting for the 1993 film “Body Bags” segment “The Gas Station,” showing the town’s quirky place in Hollywood history.",
