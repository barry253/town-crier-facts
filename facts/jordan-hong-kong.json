  "facts": [
    {
      "id": 1,
      "text": "Jordan is named after Sir Jordan, a 19th‑century British naval officer, making it one of Hong Kong’s earliest developed areas outside the CBD.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.trawellino.com/destinations/hong-kong/yau-tsim-mong_jordan"
    },
    {
      "id": 2,
      "text": "The Jordan MTR station, on the Tsuen Wan line, opened in 1979 and still serves as the main transit hub for the neighborhood.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Jordan%2C_Hong_Kong"
    },
    {
      "id": 3,
      "text": "Tin Hau Temple, a historic shrine to the sea‑deity, sits in Jordan and draws devotees from across Kowloon.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.trawellino.com/destinations/hong-kong/yau-tsim-mong_jordan"
    },
    {
      "id": 4,
      "text": "Jordan’s streets—Jordan Road and Nathan Road—intersect at a busy junction that has been a commercial crossroads since the early 20th century.",
      "sourceSentenceIds": [
        21
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Jordan%2C_Hong_Kong"
    },
    {
      "id": 5,
      "text": "The area hosts a vibrant mix of South Asian eateries, reflecting Jordan’s large Indian, Pakistani, and Nepalese communities.",
      "sourceSentenceIds": [
        18
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Jordan%2C_Hong_Kong"
    },
    {
      "id": 6,
      "text": "Union Square, a modern commercial complex, anchors Jordan’s skyline and contrasts sharply with the neighborhood’s traditional market vibe.",
