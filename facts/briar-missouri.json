  "facts": [
    {
      "id": 1,
      "text": "Briar earned its name from Briar Creek, named for the green briar vines that grow along its banks.",
      "sourceSentenceIds": [
        1,
        4,
        26
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 2",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Briar%2C_Missouri",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Settlers arriving in the mid‑1800s were mainly Scots‑Irish, moving west from states like Pennsylvania and Tennessee to farm the fertile Ozark streams.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/briar_missouri",
      "category": "people",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Briar sits on the Ozark Plateau, where elevations range from about 950 feet in uplands to 280 feet near river lowlands.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/briar_missouri",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The surrounding forest is dominated by second‑growth oak‑hickory stands, with white oak, black oak, and shagbark hickory forming dense canopies.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/briar_missouri",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Route 160 passes through Briar, placing the community roughly seven miles west of Doniphan, the county seat.",
