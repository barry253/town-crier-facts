  "facts": [
    {
      "id": 1,
      "text": "Booneville was originally named Moore's Station before being renamed to honor the American frontiersman Daniel Boone.",
      "sourceSentenceIds": [
        1,
        2
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Booneville%2C_Kentucky"
    },
    {
      "id": 2,
      "text": "Booneville grew along the South Fork of the Kentucky River and became the seat of Owsley County in 1843.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://boonevilleky.com/"
    },
    {
      "id": 3,
      "text": "Baseball Hall of Famer Earle Combs grew up in Owsley County and was born in Booneville.",
      "sourceSentenceIds": [
        11
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://boonevilleky.com/"
    },
    {
      "id": 4,
      "text": "The Moyers Building in Booneville was added to the National Register of Historic Places in 1982.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Booneville%2C_Kentucky"
    },
    {
      "id": 5,
      "text": "Booneville served as a crossroads for Union and Confederate regiments during the Civil War but avoided the destruction of other county seats.",
      "sourceSentenceIds": [
