  "facts": [
    {
      "id": 1,
      "text": "Represa sits within Folsom, a city founded by Joseph Libbey Folsom who named it Granite City before it became Folsom.",
      "sourceSentenceIds": [
        18,
        4
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Folsom%2C_California",
      "category": "other",
      "quality": "poor",
      "qualityReason": "editorial_filler"
    },
    {
      "id": 2,
      "text": "The Folsom Powerhouse, a National Historic Landmark, opened after the town realized running water could power a sawmill, supplying electricity to Sacramento.",
      "sourceSentenceIds": [
        2,
        24,
        25
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Folsom%2C_California",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Folsom Lake, created by the 1956 Folsom Dam, stretches nearly 5 miles and offers recreational opportunities that define the area’s outdoor culture.",
      "sourceSentenceIds": [
        27,
        28
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Folsom%2C_California",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The Johnny Cash Trail, completed in 2017, includes a bridge over Folsom Lake Crossing and honors the singer who once lived in the city.",
      "sourceSentenceIds": [
        6,
        5
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Folsom%2C_California",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Folsom’s historic downtown district and the Folsom Public Library, housed in the Georgia Murray Building, reflect the town’s commitment to preserving its heritage.",
