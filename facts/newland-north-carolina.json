  "facts": [
    {
      "id": 1,
      "text": "Newland became the county seat when Avery County was formed in 1911, and the town was renamed after Lieutenant Governor William C.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Newland%2C_North_Carolina",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town’s post office opened in 1912, followed by the Avery County Courthouse and Jail in 1913, both now on the National Register of Historic Places.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Newland%2C_North_Carolina",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "In 1914 the East Tennessee and Western North Carolina Railroad built a depot in Newland, which burned in 1921 but was rebuilt and operated until 1940.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Newland%2C_North_Carolina",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Newland sits at the highest county seat east of the Mississippi River, perched on the Blue Ridge Mountains.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Newland%2C_North_Carolina",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The Avery County Historical Museum and nearby Waterfall Park are in Newland, offering a glimpse into the town’s heritage and natural beauty.",
