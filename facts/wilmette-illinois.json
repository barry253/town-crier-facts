      ],
      "source": "https://en.wikipedia.org/wiki/Wilmette%2C_Illinois",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "In 1912 the Northwestern Elevated Railroad extended service into Wilmette, bringing the Purple Line to the village.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Wilmette%2C_Illinois",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The original Linden Station, built in 1913, was preserved as a retail space and later became a local historical landmark.",
      "sourceSentenceIds": [
        1,
        4
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Wilmette%2C_Illinois",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "On January 5, 2002, the Olympic Torch passed through downtown Wilmette during the 2002 Winter Olympics torch relay.",
