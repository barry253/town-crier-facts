  "facts": [
    {
      "id": 1,
      "text": "Settlers from the Wilson post office area moved to the Turkey Creek valley in the late 1890s to found Foss.",
      "sourceSentenceIds": [
        15
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Foss%2C_Oklahoma"
    },
    {
      "id": 2,
      "text": "Foss was originally called Maharg, which was an anagram of the name of the town's first postmaster, Graham.",
      "sourceSentenceIds": [
        4,
        10
      ],
      "sourceLabels": [
        "Web source 2",
        "Wikipedia"
      ],
      "source": "https://unitedstatesghosttowns.com/foss-oklahoma-ghost-town/"
    },
    {
      "id": 3,
      "text": "The arrival of the Choctaw, Oklahoma and Gulf Railroad in 1902 helped Foss grow into a bustling regional trade hub.",
      "sourceSentenceIds": [
        2,
        25
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://unitedstatesghosttowns.com/foss-oklahoma-ghost-town/"
    },
    {
      "id": 4,
      "text": "By 1908, Foss supported a diverse economy including two banks, four cotton gins, a flour mill, and a broom factory.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.okhistory.org/publications/enc/entry?entry=FO051"
    },
    {
      "id": 5,
      "text": "Foss rebuilt on higher ground above the floodplain after a devastating flood destroyed much of the town in 1902.",
      "sourceSentenceIds": [
        11,
        19
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Foss%2C_Oklahoma"
    },
    {
      "id": 6,
      "text": "Remaining historic structures in Foss include the 1894 Baptist Church and the Kobel's Place Service Station.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://unitedstatesghosttowns.com/foss-oklahoma-ghost-town/"
