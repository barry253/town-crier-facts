    },
    {
      "id": 2,
      "text": "The Popponesset Spit extends into Nantucket Sound, separating the community from Popponesset Bay.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
