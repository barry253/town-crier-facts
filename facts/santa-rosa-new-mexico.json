  "facts": [
    {
      "id": 1,
      "text": "Santa Rosa’s Route 66 stretch is immortalized in Steinbeck’s Grapes of Wrath, where a freight train steams over the Pecos River bridge.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.newmexico.org/places-to-visit/regions/northeast/santa-rosa/",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "In 1890, the town was renamed Santa Rosa—Spanish for “Saint Rose”—after Don Celso Baca built a chapel for his mother Rosa and the saint.",
      "sourceSentenceIds": [
        4,
        5
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Santa_Rosa%2C_New_Mexico",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The Chicago, Rock Island & Pacific Railroad arrived in 1901, turning Santa Rosa into a transcontinental rail hub, soon joined by the El Paso and Northeastern Railway in 1902.",
      "sourceSentenceIds": [
        6,
        7
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Santa_Rosa%2C_New_Mexico",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Santa Rosa is Rudolfo Anaya’s childhood home, and his novel Bless Me, Ultima is set in the fictional town of Guadalupe, modeled after Santa Rosa.",
      "sourceSentenceIds": [
        15
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Santa_Rosa%2C_New_Mexico",
      "category": "people",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The Pecos River cuts through Santa Rosa, where several sinkhole lakes exist, notably Blue Hole—a 81‑foot‑deep, 61‑degree‑F lake popular with divers.",
      "sourceSentenceIds": [
        27,
        28,
        29
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Santa_Rosa%2C_New_Mexico",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Santa Rosa’s historic district showcases stone buildings and the grand Guadalupe County Courthouse, while the downtown plaza lies along the Route 66 corridor.",
