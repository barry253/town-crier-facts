  "facts": [
    {
      "id": 1,
      "text": "Tilghmanton evolved from farmland into a rural neighborhood featuring farm and ranch homes on half‑acre lots.",
      "sourceSentenceIds": [
        1,
        8,
        9
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.homes.com/local-guide/hagerstown-md/tilghmanton-neighborhood/",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The Potomac River’s canal towpath runs nearby, offering walkers and bikers a scenic route through the countryside.",
      "sourceSentenceIds": [
        2,
        24
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.homes.com/local-guide/hagerstown-md/tilghmanton-neighborhood/",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Just 5 miles south, Antietam National Battlefield remembers the deadliest one‑day battle in American history.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.homes.com/local-guide/hagerstown-md/tilghmanton-neighborhood/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Devil’s Backbone County Park, about 3 miles away, lets anglers fish stocked trout and launch jon boats from its landing.",
      "sourceSentenceIds": [
        21,
        22,
        23
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.homes.com/local-guide/hagerstown-md/tilghmanton-neighborhood/",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The Tilghman Watermen’s Museum on Tilghman Island preserves and shares the island’s maritime traditions.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.tilghmanmuseum.org/",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The 185‑mile C&O Canal Towpath can be accessed from Tilghmanton at Taylor’s Landing or C&O Canal Park for long hikes or bike rides.",
