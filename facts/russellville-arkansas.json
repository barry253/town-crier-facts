      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town’s first newspaper, the Herald, began publishing in 1870, marking the start of local journalism.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Russellville%2C_Arkansas",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Arkansas Tech University, founded in 1909, sits in Russellville and has been a central part of the town’s identity for over a century.",
      "sourceSentenceIds": [
        21
      ],
      "sourceLabels": [
        "Wikipedia"
