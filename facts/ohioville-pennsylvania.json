      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The borough’s name honors the nearby Ohio River, a vital waterway that once powered early ferry traffic and bituminous oil springs.",
      "sourceSentenceIds": [
        5,
        16
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
