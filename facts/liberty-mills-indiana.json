  "facts": [
    {
      "id": 1,
      "text": "One of the early mills was called \"Liberty,\" a name that stuck and gave Liberty Mills its identity.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://kids.kiddle.co/Liberty_Mills,_Indiana",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Before settlers, Potawatomi and Miami tribes hunted and farmed along the Eel River near what is now Liberty Mills.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/liberty_mills_indiana",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "In 1871, John Comstock lobbied to bring the Detroit, Eel River & Illinois Railroad through Liberty Mills, sparking growth.",
      "sourceSentenceIds": [
        13,
        30
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 2"
      ],
      "source": "https://en.wikipedia.org/wiki/Liberty_Mills%2C_Indiana",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "A historic covered bridge over the Eel River, built in 1873 and replaced in 1954, still marks the town’s river crossing.",
      "sourceSentenceIds": [
        25
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/liberty_mills_indiana",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Liberty Mills first school began as a subscription school in 1838‑1839, before a brick graded school opened in 1872.",
      "sourceSentenceIds": [
        25
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/liberty_mills_indiana",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "In 1818, the Potawatomi ceded northern Indiana lands, including the area around Liberty Mills, to the U.S. government.",
