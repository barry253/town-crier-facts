  "facts": [
    {
      "id": 1,
      "text": "Miller Colony was founded in 1949 as a division from the O.K.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/miller_colony_montana"
    },
    {
      "id": 2,
      "text": "Miller Colony is a Hutterite community of the Lehrerleut group, practicing communal agriculture near Choteau.",
      "sourceSentenceIds": [
        7,
        12
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/miller_colony_montana"
    },
    {
      "id": 3,
      "text": "The colony has spawned daughter colonies such as Sage Creek, Kingsbury, and Midway, reflecting Hutterite growth patterns.",
      "sourceSentenceIds": [
        9,
        18
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/miller_colony_montana"
    },
    {
      "id": 4,
      "text": "The semi‑arid continental climate brings cold, snowy winters and warm, dry summers, with about 15 inches of rain and 47 inches of snow annually.",
      "sourceSentenceIds": [
        28,
        29,
        30
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/miller_colony_montana"
    },
    {
      "id": 5,
      "text": "Located in the Rocky Mountain Front, the eastern foothills of the Rockies meet expansive plains ideal for farming.",
      "sourceSentenceIds": [
        26
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/miller_colony_montana"
    },
    {
      "id": 6,
      "text": "Hutterite colonies typically split every 10‑15 years when reaching 120‑150 members, a rule that guided Miller Colony’s growth.",
      "sourceSentenceIds": [
