  "facts": [
    {
      "id": 1,
      "text": "Colbert was originally called Five Forks when incorporated in 1899, renamed in 1909 after settler James Fletcher Colbert.",
      "sourceSentenceIds": [
        4,
        11,
        30
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Colbert%2C_Georgia",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town’s growth began when the railroad arrived in 1891, a depot built in 1892 later became City Hall until 2020.",
      "sourceSentenceIds": [
        2,
        8
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/colbert_georgia",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Colbert’s July 4th Celebration and Barbeque started in 1970 and has become a major local tradition, celebrating its 50th year in 2020.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/colbert_georgia",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The historic Colbert Depot now stands as a preserved landmark, while the current City Hall occupies the former Colbert School building at 60 West First Avenue.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/colbert_georgia",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Colbert lies along Georgia State Route 72, just 12 miles northeast of Athens and 5 miles southwest of Comer.",
