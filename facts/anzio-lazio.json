  "facts": [
    {
      "id": 1,
      "text": "Founded in 1857 as Porto d'Anzio, the town adopted its current name in 1885.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Anzio"
    },
    {
      "id": 2,
      "text": "About 51 km south of Rome, Anzio is a fishing port, seaside resort, and ferry hub to the Pontine Islands.",
      "sourceSentenceIds": [
        8,
        9
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Anzio"
    },
    {
      "id": 3,
      "text": "Anzio was the landing site of Operation Shingle, a crucial Allied amphibious assault during World War II.",
      "sourceSentenceIds": [
        10,
        21
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Anzio"
    },
    {
      "id": 4,
      "text": "In 1925 Anzio opened the first submarine telegraph cable station linking Italy directly to New York, later extending to Argentina, Brazil, and Uruguay.",
      "sourceSentenceIds": [
        5,
        6,
        19
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Anzio"
    },
    {
      "id": 5,
      "text": "The railway line stops at Anzio and nearby stations such as Padiglione and Lido di Lavinio.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Anzio"
    },
    {
      "id": 6,
      "text": "The town’s symbol is the goddess Fortuna, echoing its ancient Antium heritage.",
      "sourceSentenceIds": [
