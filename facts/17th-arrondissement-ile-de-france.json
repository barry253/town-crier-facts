  "facts": [
    {
      "id": 1,
      "text": "The 17th arrondissement, officially Batignolles‑Monceau, sits on Paris’s right bank beside the Seine.",
      "sourceSentenceIds": [
        11
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/17th_arrondissement_of_Paris",
      "category": "other",
      "quality": "poor",
      "qualityReason": "location_description"
    },
    {
      "id": 2,
      "text": "Around Parc Monceau, Haussmannian homes command €12,000‑€14,000 per square metre, reflecting the area’s upscale character.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/17th_arrondissement_of_Paris",
      "category": "other",
      "quality": "poor",
      "qualityReason": "other"
    },
    {
      "id": 3,
      "text": "The Clichy‑Batignolles project has turned former village‑like Batignolles into modern housing mixed with new green spaces.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/17th_arrondissement_of_Paris",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Palais des Congrès hosts major exhibitions, while the adjacent Hyatt Regency Paris Étoile stands as the city’s tallest hotel.",
      "sourceSentenceIds": [
        17
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/17th_arrondissement_of_Paris",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Founded in 1919, the École Normale de Musique draws students worldwide to study performance and composition.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/17th_arrondissement_of_Paris",
      "category": "people",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The arrondissement’s terrain rises gently around Parc Monceau, with slight elevations that echo the nearby Bois de Boulogne’s edge.",
