  "facts": [
    {
      "id": 1,
      "text": "Olton was founded in 1908 by the Soash Land Company and became the first county seat of Lamb County that same year.",
      "sourceSentenceIds": [
        3,
        26
      ],
      "sourceLabels": [
        "Web source 1",
        "Wikipedia"
      ],
      "source": "https://www.kcbd.com/2023/07/17/community-coverage-look-history-olton-its-small-town-success/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town was named after Walter Olton Powell, whose grandson inspired the name when the post office was moved to the new site.",
      "sourceSentenceIds": [
        5,
        6
      ],
      "sourceLabels": [
        "Web source 1",
        "Web source 2"
      ],
      "source": "https://www.kcbd.com/2023/07/17/community-coverage-look-history-olton-its-small-town-success/",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "A pioneer store and post office first opened in Powell’s home three miles from where Olton now stands, marking the community’s early commercial roots.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.tshaonline.org/handbook/entries/olton-tx",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Olton lost its status as county seat in 1946 when the county government moved to Littlefield, ending a nearly four‑decade tenure.",
      "sourceSentenceIds": [
        28
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Olton%2C_Texas",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Granbery Park, dedicated in 1977, sits in the southwest part of town and serves as a local gathering spot for residents and visitors alike.",
