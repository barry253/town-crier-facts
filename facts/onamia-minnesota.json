  "facts": [
    {
      "id": 1,
      "text": "Onamia takes its name from Lake Onamia, whose Ojibwe word onaman means red ochre.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Onamia%2C_Minnesota",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The city of Onamia formed when the villages of Onamia and Ericksonville merged.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Onamia%2C_Minnesota",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The Soo Line Railroad arrived in the early 1900s, opening the area to timber trade and new settlers.",
      "sourceSentenceIds": [
        6,
        7
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/onamia_minnesota",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The historic Soo Line Depot now houses the public library, while Municipal Hall stands on the National Register.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/onamia_minnesota",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "More than 250 years ago, the Mille Lacs Band of Ojibwe settled here, hunting, fishing, gathering wild rice, and sugaring maple.",
      "sourceSentenceIds": [
