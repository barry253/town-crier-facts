  "facts": [
    {
      "id": 1,
      "text": "Wedowee means 'old water' in the Creek language and was named after a Muscogee Creek chief.",
      "sourceSentenceIds": [
        5,
        7
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Wedowee%2C_Alabama"
    },
    {
      "id": 2,
      "text": "Settled in the early 1830s, Wedowee became the county seat of Randolph County by 1835.",
      "sourceSentenceIds": [
        7,
        23
      ],
      "sourceLabels": [
        "Web source 1",
        "Wikipedia"
      ],
      "source": "https://encyclopediaofalabama.org/article/wedowee/"
    },
    {
      "id": 3,
      "text": "The First Cemetery, listed on Alabama's Register of Landmarks and Heritage in 1837, contains graves of Wedowee's founding residents.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://encyclopediaofalabama.org/article/wedowee/"
    },
    {
      "id": 4,
      "text": "A railroad reached the area in 1906, crossing the river on the opposite side of Wedowee.",
      "sourceSentenceIds": [
        17
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://randolphcountyal.com/randolph-county/history/"
    },
    {
      "id": 5,
      "text": "Lake Wedowee was formed in the late 20th century by damming the Tallapoosa River, drawing thousands of visitors each year.",
      "sourceSentenceIds": [
        25,
        27
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Wedowee%2C_Alabama"
    },
    {
      "id": 6,
      "text": "Wedowee sits on the Piedmont plateau in the foothills of the Appalachian Mountains.",
