  "facts": [
    {
      "id": 1,
      "text": "Trenton began as the settlement of Salem around 1830 before becoming Dade County’s seat.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/Trenton,_Georgia"
    },
    {
      "id": 2,
      "text": "In 1840 the legislature renamed Salem Trenton, probably honoring New Jersey’s capital.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/Trenton,_Georgia"
    },
    {
      "id": 3,
      "text": "By 1854 Trenton was officially incorporated, solidifying its status in the region.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/Trenton,_Georgia"
    },
    {
      "id": 4,
      "text": "The 1870 Southern Railway line connected Trenton to Chattanooga and Birmingham, exporting coal.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/Trenton,_Georgia"
    },
    {
      "id": 5,
      "text": "Trenton flies the historic Blood‑Stained Banner of the Confederacy in its city park.",
      "sourceSentenceIds": [
        11
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Trenton%2C_Georgia"
    },
    {
      "id": 6,
      "text": "The city lies in a valley between Lookout Mountain and Sand Mountain, part of the Chattanooga metro area.",
      "sourceSentenceIds": [
        8
      ],
