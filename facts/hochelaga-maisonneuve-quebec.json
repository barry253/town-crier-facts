  "facts": [
    {
      "id": 1,
      "text": "Hochelaga‑Maisonneuve was founded as a suburban village in 1863 and annexed to Montreal in 1883.",
      "sourceSentenceIds": [
        6,
        28
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Hochelaga-Maisonneuve",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The neighborhood’s name honors the Iroquois village visited by Jacques Cartier in 1534.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Hochelaga-Maisonneuve",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Maisonneuve Park, opened in the 1930s, now hosts the Montreal Botanical Garden and the Maurice Richard Arena.",
      "sourceSentenceIds": [
        11
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Hochelaga-Maisonneuve",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The 1976 Summer Olympics left the Olympic Stadium, Biodome, and Olympic Pool within Hochelaga‑Maisonneuve’s borders.",
      "sourceSentenceIds": [
        1,
        24,
        3
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 2"
      ],
      "source": "https://en.wikipedia.org/wiki/Hochelaga-Maisonneuve",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "In the early 20th century, Hochelaga‑Maisonneuve became Canada’s fifth‑most industrialized center with over 100 factories.",
      "sourceSentenceIds": [
        17
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/Hochelaga-Maisonneuve",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The Green Line’s Préfontaine, Joliette, Pie‑IX, and Viau stations connect the neighborhood to downtown Montreal.",
