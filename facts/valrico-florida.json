  "facts": [
    {
      "id": 1,
      "text": "Valrico’s name means “rich valley” in Spanish, chosen by William G. Tousey in the 1880s to reflect the area’s fertile lands.",
      "sourceSentenceIds": [
        4,
        5
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Valrico%2C_Florida",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The Florida Central and Peninsular Railroad reached the area in 1890, sparking an influx of settlers and the town’s early growth.",
      "sourceSentenceIds": [
        2,
        9
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Valrico%2C_Florida",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "In 1912, Lovett Brandon opened Valrico’s first general store, a landmark that still echoes the town’s early entrepreneurial spirit.",
      "sourceSentenceIds": [
        20
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Valrico%2C_Florida",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The town’s civic heart, the James McCabe Theater, began as the Valrico Civic Center in 1914 and was funded by a $3,500 donation from the Valrico Improvement Association.",
      "sourceSentenceIds": [
        19
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Valrico%2C_Florida",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Valrico’s mid‑1950s revival came when State Road 60 connected the town to Tampa’s Adamo Drive, placing it on a major Florida thoroughfare.",
      "sourceSentenceIds": [
        22
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Valrico%2C_Florida",
      "category": "history",
      "quality": "good"
    }
