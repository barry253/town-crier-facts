  "facts": [
    {
      "id": 1,
      "text": "Norwood was first laid out in 1904 between Fox Street and Namayo Avenue, and between Norwood Boulevard and Alberta Avenue.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Alberta_Avenue%2C_Edmonton",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The area north of Alberta Avenue was called Alberta Avenue, while the south was Norwood, and the city officially named the whole neighbourhood Alberta Avenue in the 1980s.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Alberta_Avenue%2C_Edmonton",
      "category": "other",
      "quality": "poor",
      "qualityReason": "vague"
    },
    {
      "id": 3,
      "text": "Norwood once housed the Great Western Garment Company and the Norwood Foundry, key employers during World War I.",
      "sourceSentenceIds": [
        30
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Alberta_Avenue%2C_Edmonton",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Today, Norwood residents enjoy the nearby Commonwealth Recreation Centre and Sprucewood Library, anchors of the community.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Alberta_Avenue%2C_Edmonton",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Norwood is experiencing a revival thanks to its close proximity to downtown Edmonton, affordable homes, and easy transit access.",
      "sourceSentenceIds": [
        26
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Alberta_Avenue%2C_Edmonton",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The Alberta Avenue History Project, launched by Rat Creek Press, celebrates Norwood’s rich past with community events and research.",
