  "facts": [
    {
      "id": 1,
      "text": "East Schodack’s town hall houses a collection of historic photographs of the Albany Southern Railroad, an interurban line that once crossed the area.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.schodack.gov/1209/Historian",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town’s historian office keeps the files of the Historical Society of Esquatak, preserving local records for researchers.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.schodack.gov/1209/Historian",
      "category": "other",
      "quality": "poor",
      "qualityReason": "vague"
    },
    {
      "id": 3,
      "text": "Visitors can browse a wide range of books covering East Schodack, the county, and other regional historic topics at the historian’s office.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.schodack.gov/1209/Historian",
      "category": "other",
      "quality": "poor",
      "qualityReason": "vague"
    },
    {
      "id": 4,
      "text": "A 52‑page booklet titled 'A Historical Record of the Town of Schodack, Rensselaer County, NY' is sold for $5 at the Town Clerk’s office.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.schodack.gov/1209/Historian",
      "category": "other",
      "quality": "poor",
      "qualityReason": "vague"
    },
    {
      "id": 5,
      "text": "That booklet includes brief histories of every hamlet in the town, plus a short account of Castleton‑on‑Hudson, the only village in Schodack.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.schodack.gov/1209/Historian",
      "category": "other",
      "quality": "poor",
      "qualityReason": "vague"
    },
    {
      "id": 6,
      "text": "The town hall’s meeting room doubles as a courtroom and displays historic photographs from East Schodack, South Schodack, and other nearby localities.",
