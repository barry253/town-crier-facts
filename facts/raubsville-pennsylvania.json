      "quality": "good"
    },
    {
      "id": 2,
      "text": "The hamlet sits on the west bank of the Delaware River along PA Route 611.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Raubsville%2C_Pennsylvania",
