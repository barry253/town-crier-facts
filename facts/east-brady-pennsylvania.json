  "facts": [
    {
      "id": 1,
      "text": "East Brady takes its name from Captain Samuel Brady, who in 1782 led a daring raid to rescue captives from Native American warriors.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/east_brady_pennsylvania",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The Allegheny Valley Railroad reached East Brady in 1867, turning the borough into a key midway station between Pittsburgh and Oil City by 1869.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/east_brady_pennsylvania",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "East Brady grew around the Brady's Bend Iron Works, founded in 1839 by the Great Western Iron Company on the west bank of the Allegheny River.",
      "sourceSentenceIds": [
        13
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/east_brady_pennsylvania",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The borough sits on the eastern side of the Allegheny River, opposite the historic Brady's Bend that gives the area its dramatic loop.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 1"
      ],
