  "facts": [
    {
      "id": 1,
      "text": "Van Horn was founded in 1881 when the Texas and Pacific Railroad reached the area, becoming a key watering and shipping point.",
      "sourceSentenceIds": [
        9,
        17
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://vanhorntexas.org/2178/Van-Horn-History",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town’s name honors Lieutenant James Judson Van Horn, who commanded an army garrison at Van Horn Wells in 1859 before the post fell to Confederates.",
      "sourceSentenceIds": [
        2,
        16
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Van_Horn%2C_Texas",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Van Horn sits at the same longitude as Cheyenne, Wyoming, making it the westernmost incorporated U.S. town that still observes Central Time.",
      "sourceSentenceIds": [
        13
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Van_Horn%2C_Texas",
      "category": "other",
      "quality": "poor",
      "qualityReason": "location_description"
    },
    {
      "id": 4,
      "text": "The First Presbyterian Church, built in 1901, now serves as Primera Iglesia Bautista and is listed on the National Register of Historic Places.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Van_Horn%2C_Texas",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Guadalupe Mountains National Park and Fort Davis National Historic Site lie nearby, giving Van Horn a gateway role for outdoor adventures.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://texastimetravel.com/directory/van-horn-tour/",
      "category": "nature",
      "quality": "good"
    },
    {
