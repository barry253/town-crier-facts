  "facts": [
    {
      "id": 1,
      "text": "Happy Valley was founded by Christian and Matilda Deardorff who received 640 acres under the Donation Land Claim Act of 1850.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Happy_Valley%2C_Oregon",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The city’s name evolved from Deardorff Valley to Christilla Valley, a blend of “Chris” and “Tilla.”.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Happy_Valley%2C_Oregon",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Mount Scott, an extinct volcano in the Boring Lava Field, rises to 1,050 feet and is the highest point in Happy Valley.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Happy_Valley%2C_Oregon",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Happy Valley sits just 13 miles southeast of downtown Portland, making it a quick suburban escape within the metro area.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Happy_Valley%2C_Oregon",
      "category": "other",
      "quality": "poor",
      "qualityReason": "location_description"
    },
    {
      "id": 5,
      "text": "The area was originally inhabited by the Clackamas people, part of the larger Chinookan tribe, long before European settlers arrived.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.visitoregon.com/cities/happy-valley-oregon/",
      "category": "people",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "In 1965 Happy Valley incorporated, and by the late 1990s it became one of Oregon’s fastest‑growing cities.",
