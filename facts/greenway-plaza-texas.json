      ],
      "source": "https://en.wikipedia.org/wiki/Greenway_Plaza",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "In 2005, Lakewood Church purchased the former arena, turning the historic sports venue into a megachurch hub while preserving the building’s iconic dome.",
      "sourceSentenceIds": [
        16,
        7
      ],
      "sourceLabels": [
        "Wikipedia",
