      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Greenway Plaza’s ten office towers are linked by an extensive skyway system, tunnels, and underground parking, creating a self‑contained “second downtown.”.",
      "sourceSentenceIds": [
        14,
        24
      ],
      "sourceLabels": [
