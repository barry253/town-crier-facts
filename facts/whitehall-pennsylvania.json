  "facts": [
    {
      "id": 1,
      "text": "The name Whitehall sprang from Lynford Lardner's hunting lodge that was painted whitewash.",
      "sourceSentenceIds": [
        23
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.whitehalltownship.org/history.html"
    },
    {
      "id": 2,
      "text": "German Palatinate immigrants, led by Jacob Kohler in 1728, first settled the area now known as Whitehall.",
      "sourceSentenceIds": [
        14
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.whitehalltownship.org/history.html"
    },
    {
      "id": 3,
      "text": "Railroad builders uncovered Whitehall's Jacksonburg limestone, nicknamed 'cement rock,' while cutting through bedrock.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.whitehalltownship.org/history.html"
    },
    {
      "id": 4,
      "text": "Whitehall hosted Pennsylvania's first blast iron furnace in Hokendauqua in 1854, sparking local industrial growth.",
      "sourceSentenceIds": [
        30
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.whitehalltownship.org/history.html"
    },
    {
      "id": 5,
      "text": "The Whitehall Historical Preservation Society keeps the original town hall open as a local history museum.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.whitehalltownship.org/history.html"
    },
    {
      "id": 6,
      "text": "Completion of the Lehigh Canal in 1829 opened new trade routes, accelerating Whitehall's growth.",
      "sourceSentenceIds": [
        29
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.whitehalltownship.org/history.html"
