      "quality": "good"
    },
    {
      "id": 2,
      "text": "Early 1800s settlers from South Carolina, such as the Kellers and Whitakers, cleared land along Redwood Creek in Wilson, building log cabins and trading pelts.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 2"
