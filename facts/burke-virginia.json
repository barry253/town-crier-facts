  "facts": [
    {
      "id": 1,
      "text": "Burke takes its name from Silas Burke, who built a house on a hill overlooking Pohick Creek in 1824.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Burke%2C_Virginia",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "When the Orange and Alexandria Railroad arrived in the 1840s, the station at the hill’s base was christened Burke’s Station.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Burke%2C_Virginia",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The original Burke Station building still stands today, though it has been rotated 90 degrees from its original footprint.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Burke%2C_Virginia",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "During the Civil War, Union troops garrisoned Burke Station, only to have it raided by Confederate General J.E.B. Stuart.",
      "sourceSentenceIds": [
        21,
        22
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
