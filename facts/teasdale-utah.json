  "facts": [
    {
      "id": 1,
      "text": "Teasdale sits at an elevation of over seven thousand feet at the foothills of Boulder Mountain, overlooking Capitol Reef National Park.",
      "sourceSentenceIds": [
        21
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://capitolreefcountry.com/cities-towns/teasdale/"
    },
    {
      "id": 2,
      "text": "LDS settlers founded the town in the late 1870s, originally calling the settlement Bullberry after the adjacent creek.",
      "sourceSentenceIds": [
        1,
        4,
        5
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Teasdale%2C_Utah"
    },
    {
      "id": 3,
      "text": "Teasdale was renamed in the early 1900s for George Teasdale, a member of the Quorum of the Twelve Apostles of the LDS Church.",
      "sourceSentenceIds": [
        6,
        7
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Teasdale%2C_Utah"
    },
    {
      "id": 4,
      "text": "The local Cultural Hall was built in 1917 using red rock and was modeled after the Temple Square Tabernacle in Salt Lake City.",
      "sourceSentenceIds": [
        15
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://capitolreefcountry.com/cities-towns/teasdale/"
    },
    {
      "id": 5,
      "text": "Early families in Teasdale relied on the waters of Bullberry Creek to power the historic Nielson Grist Mill.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://capitolreefcountry.com/cities-towns/teasdale/"
    },
    {
      "id": 6,
      "text": "The Teasdale Historical Society works to preserve the local Amusement Hall, a century-old structure also known as the Dance Hall.",
      "sourceSentenceIds": [
        3,
        16
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.teasdalehistoricalsociety.org/"
    }
  ]
