      ],
      "source": "https://en.wikipedia.org/wiki/Sharps_Chapel%2C_Tennessee"
    },
    {
      "id": 3,
      "text": "Henry Sharp, an American Revolutionary War veteran, received a 700‑acre land grant from President George Washington and settled the area.",
      "sourceSentenceIds": [
        17,
        4
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 2"
      ],
      "source": "https://en.wikipedia.org/wiki/Sharps_Chapel%2C_Tennessee"
    },
    {
      "id": 4,
      "text": "Sharps Chapel sits on a peninsula surrounded by the Clinch and Powell arms of Norris Lake, making it a waterfront community.",
      "sourceSentenceIds": [
        23,
        26
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Sharps_Chapel%2C_Tennessee"
    },
    {
