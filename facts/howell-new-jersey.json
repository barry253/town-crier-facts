  "facts": [
    {
      "id": 1,
      "text": "Howell Township was incorporated in 1801 and named after Richard Howell, the third governor of New Jersey.",
      "sourceSentenceIds": [
        10,
        12
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Howell_Township%2C_New_Jersey",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town’s early economy featured a screw factory, blacksmith shop, and a boarding house, reflecting its 19th‑century industrial roots.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.twp.howell.nj.us/244/History-of-Howell-Township",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The MacKenzie House, built around 1807, now houses the Howell Heritage and Historical Society and preserves the township’s cultural records.",
      "sourceSentenceIds": [
        23
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.jerseyshoreonline.com/howell/how-well-do-you-know-howell-history/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "A Methodist church society founded in the 1760s held its first meetings in a barn, marking Howell’s earliest European settlement.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.twp.howell.nj.us/244/History-of-Howell-Township",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The former town hall, once a tuberculosis Preventorium, remains a historic landmark that drew local historians after rumors of demolition.",
      "sourceSentenceIds": [
        21,
        22
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.jerseyshoreonline.com/howell/how-well-do-you-know-howell-history/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Howell’s Manasquan River location has supported human habitation since prehistoric times, evidenced by projectile points and other ancient artifacts.",
      "sourceSentenceIds": [
        17,
        18
      ],
