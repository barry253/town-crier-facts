  "facts": [
    {
      "id": 1,
      "text": "Helmville got its name from pioneer Henry Helm, who petitioned the federal government for a post office and secured the town’s name in 1872.",
      "sourceSentenceIds": [
        2,
        26,
        27
      ],
      "sourceLabels": [
        "Web source 1",
        "Web source 2"
      ],
      "source": "https://www.visitmt.com/cities-towns/helmville",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Helmville sits in Nevada Creek’s pastoral valley, below the Garnet Mountains, near where the creek meets the Blackfoot River, just nine miles downstream of the dam.",
      "sourceSentenceIds": [
        3,
        4
      ],
      "sourceLabels": [
        "Web source 2",
        "Wikipedia"
      ],
      "source": "https://southwestmt.com/communities/helmville/",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The Helmville Labor Day Rodeo, Montana’s biggest little rodeo, showcases bareback riders on Sunday, saddle bronc talent on Monday, and ends with a community dance.",
      "sourceSentenceIds": [
        13,
        17,
        18,
        19
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.visitmt.com/cities-towns/helmville",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Placer gold in Nevada Creek drew settlers, and in 1887 Washington Stapleton struck the first claims, prompting a ditch to bring water to the mines.",
      "sourceSentenceIds": [
        28,
        29,
        30
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://southwestmt.com/communities/helmville/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Before European settlement, the Kootenai, Salish, Nez Perce, Blackfeet, and Pen d’ Oreille tribes traversed Helmville’s valley.",
      "sourceSentenceIds": [
        23
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://southwestmt.com/communities/helmville/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Early Irish settlers founded Helmville, and as the town grew, families brought relatives from across Europe.",
      "sourceSentenceIds": [
        24
      ],
