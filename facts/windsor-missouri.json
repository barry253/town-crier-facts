      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town’s name changed to Windsor in 1859 after Windsor Castle in England.",
      "sourceSentenceIds": [
        22
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Windsor%2C_Missouri",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The Windsor Historical Museum sits in the former Missouri–Kansas–Texas Railroad depot, a brick building that once served as a bustling transit hub.",
      "sourceSentenceIds": [
        4,
        10
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://roofedbyroyal.com/best-historical-sites-windsor-henry-county/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Antioch Cemetery just outside Windsor holds graves of Union and Confederate soldiers from border skirmishes, offering a quiet look at 19th‑century burial practices.",
      "sourceSentenceIds": [
        11,
        12
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://roofedbyroyal.com/best-historical-sites-windsor-henry-county/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The downtown courthouse square, listed on the National Register, hosts farmers markets and historic walking tours, keeping civic history alive.",
