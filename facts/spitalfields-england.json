  "facts": [
    {
      "id": 1,
      "text": "Spitalfields began as a 12th‑century priory called St Mary Spital, founded in 1197 by Walter Brunus and his wife Roisia.",
      "sourceSentenceIds": [
        3,
        6,
        7
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1",
        "Web source 2"
      ],
      "source": "https://en.wikipedia.org/wiki/Spitalfields",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The area’s silk industry was launched by Huguenot refugees fleeing France after 1685, turning Spitalfields into a textile hub.",
      "sourceSentenceIds": [
        18
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Spitalfields",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "In 1669 the landmark Truman’s Brewery opened, and by 1682 King Charles II granted a royal charter for a market on Thursdays and Saturdays near Spital Square.",
      "sourceSentenceIds": [
        30
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.spitalfields.co.uk/spitalfields-history/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Spitalfields Market, the historic Old Spitalfields Market, Brick Lane Market and Petticoat Lane Market still thrive, echoing the area’s long‑standing trading heritage.",
      "sourceSentenceIds": [
        16
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Spitalfields",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The late 20th century saw a shift from a Jewish community to a Bangladeshi influx, making Brick Lane the curry capital of London.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Spitalfields",
      "category": "people",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Dennis Severs’ House on Folgate Street preserves the life of a Huguenot silk weaver family in a “still‑life drama” that transports visitors back to the 18th century.",
      "sourceSentenceIds": [
