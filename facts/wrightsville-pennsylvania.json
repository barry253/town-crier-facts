  "facts": [
    {
      "id": 1,
      "text": "Wrightsville was a vital Civil War transportation hub, and today you can walk the Civil War Trails that trace its historic routes.",
      "sourceSentenceIds": [
        1,
        10,
        11
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://historicwrightsvillepa.org/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Wrightsville once hosted the world’s longest covered bridge, 5,600 feet long, that stretched from this town to Columbia in Lancaster County.",
      "sourceSentenceIds": [
        26
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Wrightsville%2C_Pennsylvania",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "During the Civil War, Confederate troops set fire to the bridge in a desperate attempt to block Union forces, a dramatic moment still remembered in local lore.",
      "sourceSentenceIds": [
        28
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Wrightsville%2C_Pennsylvania",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Historic Wrightsville, Inc. was organized in 1975 to celebrate America’s 200th anniversary and now preserves the town’s Civil War heritage.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://historicwrightsvillepa.org/",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Fire protection in Wrightsville dates back to the early 1800s, but the first organized steam engine company formed in 1887 as Station 41.",
      "sourceSentenceIds": [
        22
