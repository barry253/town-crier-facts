      "id": 1,
      "text": "Madelia was founded in 1857 and renamed within a year to honor Philander Hartshorn’s daughter, Madelia.",
      "sourceSentenceIds": [
        1,
        2
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Madelia%2C_Minnesota",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Historic markers in Madelia commemorate Fort Cox, Fort Slocum, Fort Hill, and the Ashippum Post Office.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.madeliamn.com/history/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The Watonwan County Historical Center in Madelia houses a 1857 cabin, covered wagon, and pioneer artifacts.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.madeliamn.com/history/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Madelia’s Warren Truss Bridge is believed to be the oldest of its type in Minnesota.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.madeliamn.com/history/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Near Madelia, the last members of the James-Younger Gang were captured after the Northfield robbery.",
