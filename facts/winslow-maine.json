      "category": "nature",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The town honors Major General John Winslow of Marshfield, Massachusetts, who oversaw Fort Halifax’s 1754 construction.",
      "sourceSentenceIds": [
        6,
        8,
        9,
        10
      ],
      "sourceLabels": [
