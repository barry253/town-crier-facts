  "facts": [
    {
      "id": 1,
      "text": "Perryopolis was laid out in 1814 by Samuel Shreve and named for Oliver Hazard Perry after his Lake Erie victory.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Perryopolis%2C_Pennsylvania"
    },
    {
      "id": 2,
      "text": "The town sits on land once owned by George Washington, who bought 1,644 acres and praised its meadow and mill seat in 1770.",
      "sourceSentenceIds": [
        6,
        11,
        12
      ],
      "sourceLabels": [
        "Web source 1",
        "Wikipedia"
      ],
      "source": "https://www.perryopolisborough.org/"
    },
    {
      "id": 3,
      "text": "The Perryopolis Area History Museum occupies the former Youghiogheny Bank of Pennsylvania building, a historic bank on Liberty Street.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://pittsburghmuseums.org/southwestern-pennsylvania/fayette/perryopolis"
    },
    {
      "id": 4,
      "text": "Coal mining powered the area until the 1950s, with the Washington Run branch of the P&LE Railroad serving the town.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Perryopolis%2C_Pennsylvania"
    },
    {
      "id": 5,
      "text": "The Karolcik Building and Searight's Fulling Mill are listed on the National Register of Historic Places.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Perryopolis%2C_Pennsylvania"
    },
    {
      "id": 6,
      "text": "Perryopolis Borough was officially established in 1953, though its roots trace back to the 18th‑century mill.",
