  "facts": [
    {
      "id": 1,
      "text": "Harrisonburg earned its name from the Harrison family of Virginia, whose influence helped shape the village's early identity.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Harrisonburg%2C_Louisiana",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "A fur trading outpost as early as 1712–1714 makes Harrisonburg one of Louisiana's oldest settlements, possibly the third oldest after Natchitoches and Montgomery.",
      "sourceSentenceIds": [
        1,
        15
      ],
      "sourceLabels": [
        "Web source 2",
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/harrisonburg_louisiana",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "During the Civil War, Fort Beauregard on the Ouachita River repelled four Union gunboats in 1863, preserving Harrisonburg with minimal damage.",
      "sourceSentenceIds": [
        3,
        26,
        27
      ],
      "sourceLabels": [
        "Web source 2",
        "Wikipedia",
        "Wikipedia"
      ],
      "source": "https://grokipedia.com/page/harrisonburg_louisiana",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Harrisonburg sits at a historic crossroads, linking the El Camino Real, Natchez Trace, and the Old Natchitoches–Natchez Road.",
      "sourceSentenceIds": [
        16
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://villageofharrisonburg.com/about-the-village/",
      "category": "transport",
      "quality": "poor",
      "qualityReason": "route_only"
    },
    {
      "id": 5,
      "text": "The village borders two ancient Indian mounds—one from around AD 200 and another older than 500 BC—highlighting its deep indigenous roots.",
      "sourceSentenceIds": [
        24
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/harrisonburg_louisiana",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "In 1819 the steamboat James Monroe became one of the first to navigate into the Ouachita River, marking Harrisonburg's rise as a river port.",
      "sourceSentenceIds": [
        17
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://villageofharrisonburg.com/about-the-village/",
