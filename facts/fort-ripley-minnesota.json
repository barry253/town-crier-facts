  "facts": [
    {
      "id": 1,
      "text": "Fort Ripley got its name in 1850, after Brigadier General Eleazar W. Ripley, following brief renamings as Fort Marcy and Fort Gaines.",
      "sourceSentenceIds": [
        1,
        3
      ],
      "sourceLabels": [
        "Web source 1",
        "Web source 2"
      ],
      "source": "https://exploreforts.com/forts/fort-ripley-mn",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Fort Ripley operated as a U.S. military post from 1849 until its decommissioning in 1877.",
      "sourceSentenceIds": [
        27
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Fort_Ripley%2C_Minnesota",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Today visitors can see the stone gunpowder magazine ruins that were built between 1848 and 1849.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://exploreforts.com/forts/fort-ripley-mn",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "During the 1862 Dakota War, Fort Ripley served as a key staging point for Union forces.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://exploreforts.com/forts/fort-ripley-mn",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The fort’s location on the upper Mississippi River placed it near Ho‑Chunk and Ojibwe government agencies during the Indian Wars.",
