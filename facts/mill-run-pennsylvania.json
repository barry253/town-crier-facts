  "facts": [
    {
      "id": 1,
      "text": "Mill Run is an urban tributary to French Creek, home to 89 fish species and 27 mussels, making it one of Pennsylvania’s most biodiverse streams.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.arcofcrawfordcounty.org/mill-run-stories",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The stream begins at Tamarack Lake, a flood‑control reservoir in West Mead Township, before winding through the city of Meadville.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.arcofcrawfordcounty.org/mill-run-stories",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Mill Run spans just 3.75 miles but serves three main roles: beautifying the urban landscape, supporting native wildlife, and fostering community interaction.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.arcofcrawfordcounty.org/mill-run-stories",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Located in Crawford County, Mill Run sits in Northwestern Pennsylvania, a region known for its rich natural waterways.",
      "sourceSentenceIds": [
