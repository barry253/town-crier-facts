  "facts": [
    {
      "id": 1,
      "text": "Highland Beach was founded in 1893 by Charles Remond Douglass, who bought 40 acres with 500 feet of Chesapeake Bay beachfront.",
      "sourceSentenceIds": [
        7,
        19
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.fdmcc.org/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town began as a summer retreat for affluent African Americans from Washington, D.C., and Baltimore, seeking a private escape on the bay.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Highland_Beach%2C_Maryland",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Highland Beach remains a residential community that forbids commercial establishments, keeping its streets quiet and family‑focused.",
      "sourceSentenceIds": [
        5,
        6
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Highland_Beach%2C_Maryland",
      "category": "other",
      "quality": "poor",
      "qualityReason": "other"
    },
    {
      "id": 4,
      "text": "Streets named Crummell, Dunbar, Henson, Augusta, Douglass, Langston, and Washington honor prominent African American figures.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Highland_Beach%2C_Maryland",
      "category": "people",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The Douglass Summer House, built for Frederick Douglass, has been listed on the National Register of Historic Places since 1992.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Highland_Beach%2C_Maryland",
