  "facts": [
    {
      "id": 1,
      "text": "Old Montreal was founded in 1642 as Fort Ville-Marie by French settlers.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Old_Montreal",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The original settlement was a fur‑trading post established by Samuel de Champlain in 1605 at Place Royale.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Old_Montreal",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "In 1643 Paul Chomedey de Maisonneuve built a fort that became the headquarters of Société Notre-Dame de Montréal, aiming to convert First Nations.",
      "sourceSentenceIds": [
        30
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Old_Montreal",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The name Montreal evolved from Ville-Marie to Montreal in the early 18th century, reflecting the mountain Mont‑Royal.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Old_Montreal",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Old Montreal was declared a historic district in 1964 by Quebec’s Ministry of Cultural Affairs, preserving its colonial architecture.",
      "sourceSentenceIds": [
        27
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Old_Montreal",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The neighborhood borders the Saint Lawrence River to the south, McGill Street to the west, and Rue Saint‑André to the east, framing its historic core.",
      "sourceSentenceIds": [
        25
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
