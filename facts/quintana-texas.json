      "quality": "good"
    },
    {
      "id": 2,
      "text": "Quintana once hosted the only shipyard west of New Orleans before the Civil War.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.tshaonline.org/handbook/entries/quintana-tx",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Founded as a port town in the early 1800s, Quintana now boasts sandy beaches and abundant wildlife.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://quintanatx.org/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Historic homes and an interpretive center line Quintana’s pedestrian‑only beach, complete with palapas for relaxing.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://quintanatx.org/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The Brazos River Harbor channel separates Quintana from Surfside, placing it on the west side of the river’s mouth.",
      "sourceSentenceIds": [
        13
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.tshaonline.org/handbook/entries/quintana-tx",
      "category": "nature",
      "quality": "good"
    },
    {
