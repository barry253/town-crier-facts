  "facts": [
    {
      "id": 1,
      "text": "Arenas Valley got its name from the Rio de Arenas, a dry arroyo that locals once called Whiskey Creek after a flood carried whiskey barrels down it.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Arenas_Valley%2C_New_Mexico",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Near Arenas Valley lies the Santa Rita del Cobre mine, one of the oldest copper mines in the U.S., operating since the early 1800s.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.trawellino.com/destinations/united-states/new-mexico_arenas-valley",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Before European arrival, the Apache people used the Arenas Valley area for hunting, gathering, and seasonal movement across the Southwest.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/arenas_valley_new_mexico",
      "category": "people",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Although mining activity has faded, the legacy remains in local landmarks, shaping Arenas Valley’s quiet residential identity amid desert landscapes.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/arenas_valley_new_mexico",
      "category": "other",
      "quality": "poor",
      "qualityReason": "vague"
    },
    {
      "id": 5,
      "text": "Arenas Valley sits within the Gila National Forest, giving residents easy access to the world’s first designated wilderness area, the Gila Wilderness.",
      "sourceSentenceIds": [
        30
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.trawellino.com/destinations/united-states/new-mexico_arenas-valley",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "In 1800, an Apache guide showed Spanish officer José Manuel Carrasco the Santa Rita copper mines, sparking early European interest in the area.",
