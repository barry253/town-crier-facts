      "quality": "good"
    },
    {
      "id": 2,
      "text": "The island stretches 1.25 miles long and half a mile wide, sitting in Case Inlet about three miles west of Lakebay.",
      "sourceSentenceIds": [
        23,
        11
      ],
      "sourceLabels": [
        "Wikipedia",
