  "facts": [
    {
      "id": 1,
      "text": "Mill Village grew along Mill Run, a stream that feeds French Creek, and its early economy centered on grazing, milk, and cheese production.",
      "sourceSentenceIds": [
        4,
        28
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://millvillageboro.org/history/",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "In 1862 the Atlantic and Great Western Railroad laid tracks through Mill Village, prompting a depot that became a hub for trade and traffic.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://millvillageboro.org/history/",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The first commercially successful oil well in the world was drilled near Mill Village, marking the town as a pioneer in the oil industry.",
      "sourceSentenceIds": [
        30
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://millvillageboro.org/history/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "A historic hotel once stood on the southeast corner of Mill Village’s main intersection, reflecting the town’s early hospitality scene.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://millvillageboro.org/history/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Mill Village is part of the Erie Metropolitan Statistical Area and lies just 19 miles south of Erie, connecting it to a larger urban center.",
      "sourceSentenceIds": [
        14,
        18
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Mill_Village%2C_Pennsylvania",
      "category": "other",
      "quality": "poor",
      "qualityReason": "location_description"
    },
    {
      "id": 6,
      "text": "The town’s name evolved from Milltown to Mill Village after regional events, illustrating how local history shapes identity.",
