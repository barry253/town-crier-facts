  "facts": [
    {
      "id": 1,
      "text": "Marlboro hosts the Gomez Mill House, built 1714 by Sephardic Jewish merchant Luis Moses Gomez, the oldest surviving Jewish dwelling in North America.",
      "sourceSentenceIds": [
        6,
        8,
        5
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/Marlboro,_New_York",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The Chapel Hill Bible Church, a mid‑19th‑century Gothic Revival wooden church relocated in 1905, is listed on the National Register of Historic Places.",
      "sourceSentenceIds": [
        1,
        4
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/Marlboro,_New_York",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The Dubois‑Sarles Octagon House, built 1850, is one of New York’s few surviving octagon houses and reflects Orson Squire Fowler’s design ideas.",
      "sourceSentenceIds": [
        14
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/Marlboro,_New_York",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Marlboro’s early growth was spurred by the arrival of the West Shore Railroad in the 1880s, linking it to broader markets.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/Marlboro,_New_York",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The town’s first paper mill, established in the 18th century, marked Marlboro as Ulster County’s pioneer in paper manufacturing.",
      "sourceSentenceIds": [
        16
      ],
