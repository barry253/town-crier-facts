  "facts": [
    {
      "id": 1,
      "text": "Reuterkiez takes its name from 19th‑century writer Fritz Reuter, who lived nearby and inspired the neighborhood’s nickname.",
      "sourceSentenceIds": [
        7,
        20
      ],
      "sourceLabels": [
        "Web source 2",
        "Web source 1"
      ],
      "source": "https://travel-buddies.com/berlin-neukolln-reuterkiez-often-called-kreuzkolln/",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The historic beer hall Neue Welt, now Huxleys Neue Welt, opened as a beer garden in 1865 and became a concert venue in 1902.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Neuk%C3%B6lln_(locality)",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Körnerpark, built in 1910, showcases neobaroque design with fountains, an orangerie, and exhibition rooms.",
      "sourceSentenceIds": [
        16
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Neuk%C3%B6lln_(locality)",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Reuterkiez hosts one of Berlin’s oldest Sunni mosques, founded to serve the local Turkish community.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Neuk%C3%B6lln_(locality)",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The area once housed the 1887 Franz Weeren Eisenwerk ironworks, an industrial villa still visible on Glasower Straße.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Neuk%C3%B6lln_(locality)",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Gentrification since the 2000s has reshaped Reuterkiez, turning former working‑class housing into trendy cafés and nightlife spots.",
      "sourceSentenceIds": [
        21
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Neuk%C3%B6lln_(locality)",
      "category": "culture",
      "quality": "good"
    }
