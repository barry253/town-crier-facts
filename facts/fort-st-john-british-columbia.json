    {
      "id": 1,
      "text": "Fort St. John began as Rocky Mountain Fort in 1794, a trading post for Hudson's Bay Company and local First Nations.",
      "sourceSentenceIds": [
        5,
        21
      ],
      "sourceLabels": [
        "Web source 1",
        "Wikipedia"
      ],
      "source": "https://www.fortstjohn.ca/community-and-culture/visit-fort-st-john",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "In 1823, a clash with Northern Athapaskans ended the original fort, marking a tense chapter in early BC history.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Fort_St._John%2C_British_Columbia",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The city’s name honors John McLeod, a Hudson's Bay Company clerk, whose first name was used when the post opened on Saint Jean Baptiste Day.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.fortstjohn.ca/community-and-culture/visit-fort-st-john",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Fort St. John’s Pomeroy Sport Centre houses Canada’s newest Olympic‑sized indoor speed‑skating oval, the only one of its kind in the province.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.fortstjohn.ca/community-and-culture/visit-fort-st-john",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The historic Fort D'Epinette, once a trading post on the Peace River, lies just south of Fort St. John and echoes the region’s fur‑trade past.",
      "sourceSentenceIds": [
        14
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://fortstjohn.com/tourism-sightseeing",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Fort St. John became the oldest European‑established settlement in present‑day British Columbia when it was founded in 1794.",
