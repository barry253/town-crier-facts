  "facts": [
    {
      "id": 1,
      "text": "Provencal takes its name from the local Provencal Indians, a Native American group tied to the Kisatchie Forest area.",
      "sourceSentenceIds": [
        2,
        29
      ],
      "sourceLabels": [
        "Web source 1",
        "Web source 2"
      ],
      "source": "https://www.explorenatchitoches.com/rural-communities/provencal/",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Before settlers arrived, the area that is now Provencal was home to the Kichai, a subgroup of the Caddo Confederacy.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/provencal_louisiana",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Provencal sprang up in the 1880s as a railroad camp for the Vicksburg, Shreveport and Pacific Railroad, growing around trading posts and saloons.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/provencal_louisiana",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The village was officially incorporated in the 1890s as the Provencal Land Grant Corporation, giving it formal village status.",
      "sourceSentenceIds": [
        3,
        25
      ],
      "sourceLabels": [
        "Web source 2",
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/provencal_louisiana",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "A powerful tornado struck Provencal on March 13, 1913, destroying much of the village; the current town was rebuilt afterward.",
      "sourceSentenceIds": [
