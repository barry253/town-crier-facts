  "facts": [
    {
      "id": 1,
      "text": "Pacific grew around the Pacific Railroad, which laid tracks in 1853 and opened the town that same year.",
      "sourceSentenceIds": [
        5,
        12
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 2"
      ],
      "source": "https://en.wikipedia.org/wiki/Pacific%2C_Missouri",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "A new depot opened in 1882, and the historic downtown buildings from the late 1800s have been restored and now house new businesses.",
      "sourceSentenceIds": [
        7,
        10
      ],
      "sourceLabels": [
        "Wikipedia",
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Pacific%2C_Missouri",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The Gustav Grauer Farm, about 4 miles north, was listed on the National Register of Historic Places in 1984.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Pacific%2C_Missouri",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Pacific’s public library is a branch of the Scenic Regional Library system, serving the community since the 19th century.",
      "sourceSentenceIds": [
        19
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Pacific%2C_Missouri",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Route 66 was commissioned in 1926 but originally bypassed Pacific; it was rerouted in 1933 to pass through the town.",
