  "facts": [
    {
      "id": 1,
      "text": "Menoken Village earned National Historic Landmark status in 1964, thanks to its ties to some of the earliest European explorations.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.history.nd.gov/historicsites/menoken/index.html",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The historic village once hosted roughly 30 oval‑shaped, earth‑covered houses and a prominent fortification system.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.history.nd.gov/historicsites/menoken/index.html",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The original fortification ditch measured about five feet deep and twenty feet wide.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.history.nd.gov/historicsites/menoken/menokenhistory.html",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Renamed Menoken in 1883, the town’s railroad station was renamed Burleigh in 1891 after the Northern Pacific Railroad disliked the new name.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Menoken%2C_North_Dakota",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Archaeologists find the settlement was built by Late Plains Woodland peoples, hunters and gatherers rather than farmers.",
      "sourceSentenceIds": [
        30
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.history.nd.gov/historicsites/menoken/index.html",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Radiocarbon dating places Menoken Village around AD 1200, making it older than earlier estimates.",
      "sourceSentenceIds": [
        29
      ],
      "sourceLabels": [
        "Web source 1"
      ],
