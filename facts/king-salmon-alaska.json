  "facts": [
    {
      "id": 1,
      "text": "King Salmon sits on the north bank of the Naknek River, about 16 miles upriver from Naknek and near Naknek Lake.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/King_Salmon%2C_Alaska",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town’s name honors the abundant sockeye salmon that early Central Yup'ik peoples fished along the river.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/King_Salmon,_Alaska",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "During WWII an airfield built in 1931 became King Salmon Air Force Station, later converted into the civilian airport we use today.",
      "sourceSentenceIds": [
        1,
        7
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/King_Salmon,_Alaska",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Subarctic winters can plunge to −48 °F, while July highs have reached 89 °F, a wide swing for a place at 58° N.",
      "sourceSentenceIds": [
        18
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/King_Salmon%2C_Alaska",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "King Salmon functions as a regional hub for transportation, administration, and support services, especially during the seasonal fishing and tourism rush.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/King_Salmon,_Alaska",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Just below the southern edge of sporadic permafrost, the town is shielded from the wet Aleutian Low, keeping winters milder than some inland U.S. towns.",
      "sourceSentenceIds": [
        15
      ],
