      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Frederick Douglass launched the abolitionist newspaper The North Star in Rochester in 1847, making the city a hub for civil rights.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Rochester%2C_New_York",
