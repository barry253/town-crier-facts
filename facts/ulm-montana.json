  "facts": [
    {
      "id": 1,
      "text": "Ulm takes its name from William Ulm, an Indiana cattleman who owned a large ranch that became the town’s foundation.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Ulm%2C_Montana"
    },
    {
      "id": 2,
      "text": "In the early 1880s, William “Billy” Ulm and his brothers Wilson and Lake settled the area, turning the ranch into a community.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.mtmemory.org/nodes/view/128191"
    },
    {
      "id": 3,
      "text": "Ulm became a stop on the Montana Central Railway in 1887, linking it to the growing rail network.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Ulm%2C_Montana"
    },
    {
      "id": 4,
      "text": "A Missouri River bridge was constructed in 1914, giving farmers a direct route to ship grain to Ulm elevators.",
      "sourceSentenceIds": [
        10,
        29
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 2"
      ],
      "source": "https://en.wikipedia.org/wiki/Ulm%2C_Montana"
    },
    {
      "id": 5,
      "text": "The Smith River, a premier fly‑fishing stream, joins the Missouri at Ulm, offering anglers and boaters two rivers to explore.",
      "sourceSentenceIds": [
        22
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://centralmontana.com/communities/ulm/"
    },
    {
      "id": 6,
      "text": "Northeast of Ulm lies Benton Lake National Wildlife Refuge, a 5,000‑acre glacial basin that shelters diverse wildlife and migratory waterfowl.",
      "sourceSentenceIds": [
        23,
        24,
        25
      ],
      "sourceLabels": [
