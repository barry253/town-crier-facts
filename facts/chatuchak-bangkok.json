  "facts": [
    {
      "id": 1,
      "text": "Chatuchak Market, also called JJ Market, opened in 1942 and grew to Thailand's largest market by 2019 with 15,000 stalls.",
      "sourceSentenceIds": [
        10,
        11,
        14
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Chatuchak_Weekend_Market",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Since its 1982 start as a weekend gathering, Chatuchak has evolved into a commercial phenomenon attracting over 200,000 visitors weekly.",
      "sourceSentenceIds": [
        2,
        3
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://go2-thailand.com/blog/chatuchak-market-bangkok-guide/",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Chatuchak sits on Kamphaeng Phet 2 Road and is served by the MRT Blue Line at Chatuchak Park and the BTS Sukhumvit Line at Mo Chit.",
      "sourceSentenceIds": [
        7,
        8
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Chatuchak_Weekend_Market",
      "category": "transport",
      "quality": "poor",
      "qualityReason": "vague"
    },
    {
      "id": 4,
      "text": "The market offers everything from fresh produce to antiques, making it the world's largest and most diverse weekend market.",
      "sourceSentenceIds": [
        12,
        13
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Chatuchak_Weekend_Market",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "In 1987, the market was renamed Chatuchak to honor King Bhumibol Adulyadej's 60th birthday, a joint effort by Thai-Chinese merchants.",
      "sourceSentenceIds": [
        26
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Chatuchak_Weekend_Market",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "A 1948 policy by Prime Minister Plaek Phibunsongkhram required every province to have a market, leading Bangkok to select Sanam Luang as Chatuchak's site.",
