  "facts": [
    {
      "id": 1,
      "text": "Tabernacle Township was incorporated March 22, 1901, carved from Shamong, Southampton, and Woodland Townships.",
      "sourceSentenceIds": [
        24
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Tabernacle_Township%2C_New_Jersey",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The township’s name comes from a tabernacle built by missionaries David and John Brainerd, who also founded a log church.",
      "sourceSentenceIds": [
        3,
        5
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Tabernacle_Township%2C_New_Jersey",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "A sawmill operated in the Friendship area in the early 1700s, and by 1860 Gilbert Knight built the Knight‑Pepper House near the town hall.",
      "sourceSentenceIds": [
        30
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Tabernacle_Township%2C_New_Jersey",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The Tabernacle Historical Society, founded in 1975 by ten local residents, preserves the town’s heritage and runs an auto tour of historic sites.",
      "sourceSentenceIds": [
        10,
        16
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://tabernaclehistoricalsociety.org/",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "In 1803, William Wilkins sold land for Tabernacle Cemetery, which sits beside the original church that also served as a schoolhouse.",
      "sourceSentenceIds": [
        28,
        29
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Tabernacle_Township%2C_New_Jersey",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The Carranza Memorial, funded by Mexican schoolchildren, honors a local figure and led to the renaming of Hampton Gates Road to Carranza Road.",
      "sourceSentenceIds": [
        4
      ],
