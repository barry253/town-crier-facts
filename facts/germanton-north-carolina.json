  "facts": [
    {
      "id": 1,
      "text": "Germanton was founded in 1790 by German immigrants who received land incentives for fighting in the American Revolution.",
      "sourceSentenceIds": [
        1,
        12,
        18
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Germanton%2C_North_Carolina",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town’s original 23 acres were part of a 700‑acre grant given to Jacob Lash in 1762, later deeded by brothers Michael and Henry Frey.",
      "sourceSentenceIds": [
        12,
        13,
        30
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Germanton%2C_North_Carolina",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Germanton served as Stokes County’s seat until Forsyth County split off, after which it remained a historic center of the county.",
      "sourceSentenceIds": [
        9,
        10
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Germanton%2C_North_Carolina",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Philip’s Episcopal Church in Germanton earned a spot on the National Register of Historic Places, highlighting the town’s 18th‑century heritage.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Germanton%2C_North_Carolina",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The Germanton Vineyard & Winery, founded in 1981, produces French‑American hybrid grapes and showcases local art by over 80 artists.",
      "sourceSentenceIds": [
        24,
        25,
        27
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.carolana.com/NC/Towns/Germantown_NC.html",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Located seven miles north of Winston‑Salem, Germanton sits in the foothills of the Blue Ridge Mountains, offering rich soil and clean air for grape cultivation.",
      "sourceSentenceIds": [
        6,
        23
      ],
