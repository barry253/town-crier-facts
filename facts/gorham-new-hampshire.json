  "facts": [
    {
      "id": 1,
      "text": "Gorham was named after Lot Davis, a resident of Gorham, Maine, who suggested the name when the town was chartered.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Gorham%2C_New_Hampshire",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Railroads arrived in 1851, turning Gorham into a major locomotive yard and repair hub halfway between Montreal and the New England seacoast.",
      "sourceSentenceIds": [
        7,
        8
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Gorham%2C_New_Hampshire",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "In 1861, travelers first climbed the 8‑mile Mount Washington Carriage Road, an engineering marvel dubbed the 'Road to the Sky'.",
      "sourceSentenceIds": [
        25,
        26
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Gorham%2C_New_Hampshire",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The 1918 Gorham Town Hall, still standing, has served as the town’s political and cultural center for over a century.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.gorhamnh.gov/pages/about-us",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Known as the 'Gateway to the White Mountains,' Gorham has welcomed hikers, skiers, and hunters for more than a hundred years.",
      "sourceSentenceIds": [
        13
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://gorhamnhoutdoors.com/welcome/about-gorham/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The Gorham Historical Society rescued the old town hall, preserving its yellow birch and maple floors, and now operates it as a museum.",
      "sourceSentenceIds": [
        16
