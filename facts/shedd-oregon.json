  "facts": [
    {
      "id": 1,
      "text": "Shedd originated as a settlement called Boston in 1858, located about one and a half miles east of the current town site.",
      "sourceSentenceIds": [
        17,
        28
      ],
      "sourceLabels": [
        "Web source 1",
        "Wikipedia"
      ],
      "source": "https://grokipedia.com/page/shedd_oregon"
    },
    {
      "id": 2,
      "text": "The town of Shedd formed in 1871 after the railroad bypassed the original community of Boston, causing residents to move west.",
      "sourceSentenceIds": [
        1,
        2
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/shedd_oregon"
    },
    {
      "id": 3,
      "text": "The Boston Flour Mill near Shedd is Oregon's oldest continuously operating water-powered mill and is listed on the National Register of Historic Places.",
      "sourceSentenceIds": [
        13
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Shedd%2C_Oregon"
    },
    {
      "id": 4,
      "text": "Shedd remains a quiet rural community in the heart of the Willamette Valley, characterized by its agriculture and preserved historical legacy.",
