  "facts": [
    {
      "id": 1,
      "text": "Eastern Market started as a farmer's market in 1841 at Cadillac Square before relocating to its current site.",
      "sourceSentenceIds": [
        27
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Eastern_Market%2C_Detroit",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The market sits on land that once housed a city cemetery and a correctional facility before its construction.",
      "sourceSentenceIds": [
        30
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Eastern_Market%2C_Detroit",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Six historic sheds line the market, with Shed 2 added in 1898 and Shed 6 completed in 1966.",
      "sourceSentenceIds": [
        29
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Eastern_Market%2C_Detroit",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "When the 1965 freeway interchange razed Detroit’s western market, Eastern Market survived as the city’s only remaining historic market.",
      "sourceSentenceIds": [
        28
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Eastern_Market%2C_Detroit",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Eastern Market is the largest historic public market district in the United States, and its farmers’ distribution center is the biggest open‑air flowerbed market.",
      "sourceSentenceIds": [
        24
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Eastern_Market%2C_Detroit",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "In 2006, the city transferred Eastern Market’s management to a public‑private partnership that now operates the Eastern Market Corporation.",
