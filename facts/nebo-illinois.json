  "facts": [
    {
      "id": 1,
      "text": "Nebo sprang up in the early 1870s when the Chicago and Alton Railway laid a line through Pike County, turning the spot into a railroad town.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.greatriverroad.com/nebo",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The historic Vin Fiz Flyer touched down just north of Nebo in 1911, marking the town’s place in aviation history.",
      "sourceSentenceIds": [
        21
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Nebo%2C_Illinois",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "In honor of that landing, Pike County renamed the main road from Pearl to Pleasant Hill the Vin Fiz Highway and hosts an annual festival each August.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.greatriverroad.com/nebo",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Within Nebo’s limits sit three churches, each serving as a quiet reminder of the village’s long‑standing community spirit.",
      "sourceSentenceIds": [
        14
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Nebo%2C_Illinois",
      "category": "other",
      "quality": "poor",
      "qualityReason": "other"
    },
    {
      "id": 5,
      "text": "The first settlement in the area began in 1832 when Silas Wilson claimed a parcel north of what is now the town.",
      "sourceSentenceIds": [
        15
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Nebo%2C_Illinois",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "A post office opened in Nebo in December 1852, becoming the first federal service in the growing community.",
      "sourceSentenceIds": [
        18
