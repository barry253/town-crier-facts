  "facts": [
    {
      "id": 1,
      "text": "Camas, Montana, takes its name from the camas lily bulbs harvested by Salish and Kootenai tribes, and early settlers arrived in the late 1800s for ranching.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/camas_montana",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Camas lies in the open grasslands of the Camas Prairie, just west of the Clark Fork River valley.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/camas_montana",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Ancient glacial ripples up to 30 feet high mark the prairie, remnants of Ice Age floods that shaped the landscape.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/camas_montana",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The area averages 22 inches of precipitation, mostly rain in spring and fall, with 48 inches of snow in winter.",
      "sourceSentenceIds": [
        18
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/camas_montana",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Native grasses like rough fescue and bluebunch wheatgrass, along with camas lilies, support deer and a diverse bird community.",
      "sourceSentenceIds": [
        21,
        23
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/camas_montana",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Over a century of fire suppression has built up fuels, raising the risk of high‑intensity burns in the Camas region.",
