  "facts": [
    {
      "id": 1,
      "text": "Merom was founded by Stinnett Gettinger in 1817, and its log courthouse served as Sullivan County's first seat.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Merom%2C_Indiana",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town's name commemorates the Battle of the Waters of Merom in the Hebrew Bible.",
      "sourceSentenceIds": [
        26
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Merom%2C_Indiana",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Merom received the smallest Carnegie library in the U.S., built in 1915 for under $10,000, now part of the county library system.",
      "sourceSentenceIds": [
        15,
        14,
        10,
        11,
        12
      ],
      "sourceLabels": [
        "Web source 1",
        "Wikipedia"
      ],
      "source": "https://wvcf.org/sullivan-community-tour-1/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The Merom–Gill Township Carnegie Library now hosts a community garden tended by ten families, feeding locals and patrons.",
      "sourceSentenceIds": [
        17,
        18
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://wvcf.org/sullivan-community-tour-1/",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Merom’s generating station powers a 1,500‑acre Turtle Creek Reservoir, a public lake popular for fishing.",
      "sourceSentenceIds": [
        22
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://wvcf.org/sullivan-community-tour-1/",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The town’s post office has operated continuously since 1818, a testament to its long‑standing community.",
