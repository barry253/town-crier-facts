      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "In 1879, the village became the county seat of Sanilac County after a dispute with Lexington, its original location.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 1"
      ],
