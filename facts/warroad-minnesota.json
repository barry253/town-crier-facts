  "facts": [
    {
      "id": 1,
      "text": "Warroad takes its name from the historic “War Road” trail once used by Ojibwe and Sioux tribes during their conflicts.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.warroadmn.org/?SEC=534BE7F6-C52B-4180-928C-8D5918D0186D",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Once one of the largest Ojibwe villages on Lake of the Woods, Warroad was a major indigenous settlement.",
      "sourceSentenceIds": [
        28
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Warroad%2C_Minnesota",
      "category": "people",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The Canadian National Depot first opened in 1900, saw a bridge built in 1901, and earned state historical site status in 1980 before joining the National Register in 1982.",
      "sourceSentenceIds": [
        17,
        18,
        19,
        20
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.warroadmn.org/index.asp?SEC=534BE7F6-C52B-4180-928C-8D5918D0186D&DE=CA70DC6B-5DE7-4C17-966D-B64976361D8B",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Dubbed “Hockeytown USA,” Warroad has produced elite players and hosted the Warroad Lakers amateur team from 1947 to 1997.",
      "sourceSentenceIds": [
        14,
        13
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.warroadmn.org/?SEC=534BE7F6-C52B-4180-928C-8D5918D0186D",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The original station’s baggage room became the public library, the upstairs quarters turned into a museum, and the waiting room was remodeled into City Council Chambers.",
      "sourceSentenceIds": [
        25
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.warroadmn.org/index.asp?SEC=534BE7F6-C52B-4180-928C-8D5918D0186D&DE=CA70DC6B-5DE7-4C17-966D-B64976361D8B",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The last passenger train stopped in Warroad in July 1977, after which the station closed in 1978.",
