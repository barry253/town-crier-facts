  "facts": [
    {
      "id": 1,
      "text": "Bridgeport was originally called Nya Stockholm, founded around 1650 by Swedish and Finnish settlers.",
      "sourceSentenceIds": [
        1,
        2
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Bridgeport%2C_New_Jersey",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The community grew into a shipping point on Raccoon Creek, first called Raccoon Lower Bridge, renamed Bridgeport in 1836.",
      "sourceSentenceIds": [
        3,
        5
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/Bridgeport,_New_Jersey",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Bridgeport lies along the Delaware River at the mouth of Raccoon Creek, a key geographic spot.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Bridgeport%2C_New_Jersey",
      "category": "nature",
      "quality": "good",
      "qualityReason": "location_description"
    },
    {
      "id": 4,
      "text": "The Chester-Bridgeport Ferry operated from 1930 to 1974, carrying dozens of vehicles per trip across the Delaware.",
      "sourceSentenceIds": [
        20
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/Bridgeport,_New_Jersey",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The Commodore Barry Bridge, a cantilever span opened in 1974, replaced the ferry and connects Bridgeport to Chester, PA.",
      "sourceSentenceIds": [
        21
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/Bridgeport,_New_Jersey",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Bridgeport Motorsports Park, a local racing venue, sits within the community.",
