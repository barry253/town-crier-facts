  "facts": [
    {
      "id": 1,
      "text": "Wartrace earned the nickname \"cradle of the Tennessee Walking Horse\" because it hosts the annual Wartrace Horse Show since 1906.",
      "sourceSentenceIds": [
        4,
        5,
        27
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Wartrace%2C_Tennessee",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town began as Wartrace Depot in the 1850s, a stop on the Nashville and Chattanooga Railroad that later became the Walking Horse and Eastern Railroad.",
      "sourceSentenceIds": [
        10,
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Wartrace%2C_Tennessee",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "During the Civil War, Wartrace served as the winter headquarters for Confederate General William J. Hardee, and a skirmish occurred there in 1862.",
      "sourceSentenceIds": [
        29,
        30
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Wartrace%2C_Tennessee",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The downtown area is listed on the National Register of Historic Places as the Wartrace Historic District, preserving its 19th‑century architecture.",
      "sourceSentenceIds": [
        26
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Wartrace%2C_Tennessee",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The Tennessee Walking Horse National Museum, founded in 2012, is headquartered in downtown Wartrace, showcasing the breed’s heritage.",
      "sourceSentenceIds": [
