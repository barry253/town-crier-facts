  "facts": [
    {
      "id": 1,
      "text": "Lapa got its name from a Portuguese resident who built a shrine to Nossa Senhora, creating a grotto that became the neighborhood's namesake.",
      "sourceSentenceIds": [
        26,
        27
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.encontralapa.com.br/lapa/historia-da-lapa.shtml",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "In the late 19th century, Lapa attracted more than five nationalities, making it a multicultural enclave before industrialization.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://saopaulosecreto.com/en/what-to-do-in-the-lapa-district-en/",
      "category": "people",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The São Paulo Railway’s arrival turned Lapa into an industrial hub, and today it boasts one of the city’s infrastructures with shops, a train station, and cultural centers.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://saopaulosecreto.com/en/what-to-do-in-the-lapa-district-en/",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The municipal theater Cacilda Becker, opened in 1988, hosts free performances that anyone can attend by picking up a ticket an hour before the show.",
      "sourceSentenceIds": [
        11,
        12
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://saopaulosecreto.com/en/what-to-do-in-the-lapa-district-en/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The Lapa Municipal Market, opened in 1954, still draws locals with about 100 stalls selling fresh produce, fish, and grains.",
      "sourceSentenceIds": [
        7,
        8
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://saopaulosecreto.com/en/what-to-do-in-the-lapa-district-en/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The historic Bar Valadares, operating since 1962, offers traditional São Paulo boteco snacks like coxinha and chorizo in a cozy setting.",
