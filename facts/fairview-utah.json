  "facts": [
    {
      "id": 1,
      "text": "Fairview was founded in 1859 after settlers gathered wild hay and asked Brigham Young for permission to establish a new community.",
      "sourceSentenceIds": [
        1,
        17
      ],
      "sourceLabels": [
        "Web source 1",
        "Wikipedia"
      ],
      "source": "https://www.sanpetecountyutah.gov/fairview.html",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town was originally called North Bend before 1864 when residents renamed it Fairview for its sweeping valley view.",
      "sourceSentenceIds": [
        24
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Fairview%2C_Utah",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "In 1864 Fairview secured a post office and, by 1866, built a ten‑foot‑high rock wall fort to protect against Black Hawk War skirmishes.",
      "sourceSentenceIds": [
        24,
        27
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Fairview%2C_Utah",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The arrival of the Rio Grande Western Railroad in the 1890s helped Fairview export livestock and grow economically like other Sanpete towns.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Fairview%2C_Utah",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Fairview’s historic downtown once housed a public library, creamery, harness shop, and two hotels by 1900, reflecting its rapid growth.",
      "sourceSentenceIds": [
        15
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Fairview%2C_Utah",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Livestock raising—from beef and sheep to chickens and turkeys—has been a constant in Fairview’s economy since its early days.",
      "sourceSentenceIds": [
        8
