        9
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Halbur%2C_Iowa",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Summers, especially July, bring warmest conditions with average highs around 84°F and lows of 63°F, while winters average 28°F highs and 10°F lows.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
