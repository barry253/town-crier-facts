      "id": 1,
      "text": "Adel was originally called Penoach and became the county seat in 1847 before adopting its current name in 1849.",
      "sourceSentenceIds": [
        6,
        7
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
