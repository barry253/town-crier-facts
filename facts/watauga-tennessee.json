    {
      "id": 1,
      "text": "In the 1850s, the East Tennessee and Virginia Railroad built Carter's Depot, a stop with a trestle that carried tracks over the Watauga River.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
