  "facts": [
    {
      "id": 1,
      "text": "Valley Park is located in southwestern Rogers County and was originally part of the Cherokee Nation's territory.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/valley_park_oklahoma"
    },
    {
      "id": 2,
      "text": "Western Cherokee bands moved into the Valley Park region in 1828 after the Osage ceded the land to the United States.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/valley_park_oklahoma"
    },
    {
      "id": 3,
      "text": "Valley Park officially incorporated on March 1, 1970, as surrounding towns began annexing large sections of nearby land.",
      "sourceSentenceIds": [
        27
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.okhistory.org/publications/enc/entry?entry=VA002"
    },
    {
      "id": 4,
      "text": "The corporate boundaries of Valley Park encompass two and a half square miles across two discontiguous areas.",
      "sourceSentenceIds": [
        26
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.okhistory.org/publications/enc/entry?entry=VA002"
    },
    {
      "id": 5,
      "text": "Sixty percent of the residents in Valley Park are employed in professional jobs, and most are college graduates.",
      "sourceSentenceIds": [
        28
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.okhistory.org/publications/enc/entry?entry=VA002"
    },
    {
      "id": 6,
      "text": "Every single resident of Valley Park lives in a rural area rather than an urban setting.",
      "sourceSentenceIds": [
        15
      ],
