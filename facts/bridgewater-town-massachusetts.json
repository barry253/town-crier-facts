  "facts": [
    {
      "id": 1,
      "text": "Bridgewater was chartered June 3, 1656, originally thriving as an industrial and agricultural hub in Plymouth County.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://seeplymouth.com/town/bridgewater/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town’s iron industry left a legacy: the historic Bridgewater Iron Works, now a registered historical site, was largely torn down in 1994 and turned into Ironworks Park.",
      "sourceSentenceIds": [
        2,
        9
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Bridgewater%2C_Massachusetts",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Bridgewater State University, founded as a normal school in 1840, remains a key educational landmark and was once championed by Horace Mann.",
      "sourceSentenceIds": [
        6,
        7
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Bridgewater%2C_Massachusetts",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "In the mid‑1800s, railroad expansion brought immigrant labor that fueled a booming shoe‑manufacturing sector, with the White Shoe Company becoming the largest employer by 1914.",
      "sourceSentenceIds": [
        4,
        15,
        16
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/Bridgewater,_Massachusetts",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The town’s “Bridgewater Triangle” is a small area noted for strange reports of UFOs, Bigfoot, and other mysterious encounters, a name coined by author Loren Coleman.",
      "sourceSentenceIds": [
        21
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Bridgewater%2C_Massachusetts",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Bridgewater’s historic center sits about 25 miles south of Boston and 35 miles east of Providence, keeping it within easy reach of both cities while preserving its heritage.",
      "sourceSentenceIds": [
        17
      ],
