  "facts": [
    {
      "id": 1,
      "text": "Middletown was chartered on May 4 1796, marking its formal founding in the late 18th century.",
      "sourceSentenceIds": [
        20
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Middletown%2C_Virginia",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The Wayside Inn, dating to the 1790s, claims to be America’s longest continuously running inn.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.dhr.virginia.gov/historic-registers/260-5001/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The Valley Pike helped grow Middletown, with the Wayside Inn originally serving as a tavern for travelers.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.dhr.virginia.gov/historic-registers/260-5001/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Middletown hosted the Civil War’s Battle of Cedar Creek, fought just south of the town.",
      "sourceSentenceIds": [
        23
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Middletown%2C_Virginia",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Thomas Chapel, built 1836, is listed on both the Virginia Landmarks Register and the National Register of Historic Places.",
      "sourceSentenceIds": [
        5
