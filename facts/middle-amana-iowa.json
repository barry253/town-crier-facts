  "facts": [
    {
      "id": 1,
      "text": "Middle Amana, founded by German immigrants in 1855, is the largest of the seven villages that together form a National Historic Landmark.",
      "sourceSentenceIds": [
        1,
        2
      ],
      "sourceLabels": [
        "Web source 1",
        "Wikipedia"
      ],
      "source": "https://www.traveliowa.com/cities/middle-amana-iowa/980/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "In 1881, Middle Amana boasted a woolen mill, starch factory, machine shop, wagon shop, blacksmith shop, book printing and bindery, brick yard, general store, school, and meeting house.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Middle_Amana%2C_Iowa",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Hanh's Hearth Oven Bakery, a traditional German recipe bakery, once supplied bread and other baked goods to the communal kitchens of the Colonies.",
      "sourceSentenceIds": [
        4,
        28
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.nps.gov/subjects/travelamanacolonies/middle-amana.htm",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The Amana Elementary School remains in Middle Amana, while the former Clear Creek–Amana Middle School once operated there before moving to Tiffin.",
      "sourceSentenceIds": [
        12,
        15
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Middle_Amana%2C_Iowa",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The Ruedy Kitchen House, beside the Coopershop Museum, was one of fifty kitchens that fed residents during the Colonies' communal era.",
      "sourceSentenceIds": [
        28
      ],
