      "id": 1,
      "text": "Sunset Beach first appeared as an unincorporated community on September 8, 1904, after the Sunset Beach Company filed for incorporation in 1903.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 2"
      ],
