  "facts": [
    {
      "id": 1,
      "text": "William Knowles, the pioneer founder, built the first log cabin in the area in winter 1815.",
      "sourceSentenceIds": [
        18,
        19
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://greenerpasture.com/Places/Details/2253"
    },
    {
      "id": 2,
      "text": "The first schoolhouse, a log structure, opened in 1817 north of the future brick schoolhouse on the west side of the street.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://greenerpasture.com/Places/Details/2253"
    },
    {
      "id": 3,
      "text": "A post office opened in Knowlesville in 1826, prompting residents to rename the village from Portville to Knowlesville.",
      "sourceSentenceIds": [
        28,
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://greenerpasture.com/Places/Details/2253"
    },
    {
      "id": 4,
      "text": "Knowlesville sits along the Erie Canal, just 4.1 miles east‑northeast of Medina.",
      "sourceSentenceIds": [
        13
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Knowlesville%2C_New_York"
    },
    {
      "id": 5,
      "text": "The village owes its very existence to the Erie Canal, which spurred early settlement and growth.",
      "sourceSentenceIds": [
        16
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://greenerpasture.com/Places/Details/2253"
    },
    {
      "id": 6,
      "text": "Early settlers cleared the land in 1815, with the first tree felled that March, marking the start of Knowlesville’s development.",
