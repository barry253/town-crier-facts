  "facts": [
    {
      "id": 1,
      "text": "Cross Village was founded after French Jesuit Father Jacques Marquette placed a large white cross on a bluff in 1675.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.awesomemitten.com/cross-village-michigan/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The village’s name comes from that white cross overlooking Lake Michigan, a landmark still marked in the grassy park.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.crossvillagetownship.org/cross-village-walking-tour/",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The historic Walking Tour includes ten sites, one of which is the Holy Cross Catholic Church, originally a schoolhouse moved to its current spot.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.crossvillagetownship.org/cross-village-walking-tour/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Legs Inn, the most famous landmark, sits on Brady Street and has been a local gathering spot for generations.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.crossvillagetownship.org/cross-village-walking-tour/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "In the 1830s Cross Village was a lumber and fishing hub thanks to its waterfront location on Lake Michigan.",
      "sourceSentenceIds": [
        17
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.awesomemitten.com/cross-village-michigan/",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The Old School Bell marker commemorates the bell from the original Holy Cross Church, now housed in the lower level of the museum.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
