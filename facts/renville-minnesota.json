      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "In 1972 the Southern Minnesota Beet Sugar Cooperative opened a massive extraction plant in Renville, producing up to 1 billion pounds of sugar each year.",
      "sourceSentenceIds": [
