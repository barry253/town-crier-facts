  "facts": [
    {
      "id": 1,
      "text": "Roslyn was originally Hempstead Harbor, renamed in 1844 to avoid postal confusion with other Long Island Hempsteads.",
      "sourceSentenceIds": [
        7,
        15
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 2"
      ],
      "source": "https://en.wikipedia.org/wiki/Roslyn%2C_New_York",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The Long Island Railroad first reached Roslyn in 1864, linking the village to the wider rail network.",
      "sourceSentenceIds": [
        17
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://roslynchamber.org/about-roslyn-chamber-of-commerce/history-of-roslyn/",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Roslyn’s first fire company started in 1852, and the village cemetery was founded a year later in 1861.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://roslynchamber.org/about-roslyn-chamber-of-commerce/history-of-roslyn/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Roslyn’s Main Street Historic District showcases beautifully restored houses and a vibrant downtown that attracts visitors year‑round.",
      "sourceSentenceIds": [
        10,
        11
      ],
      "sourceLabels": [
