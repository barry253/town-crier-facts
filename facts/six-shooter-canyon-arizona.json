  "facts": [
    {
      "id": 1,
      "text": "Six Shooter Canyon earned its name after a deadly 1880s gunfight between Apache warriors and settlers, leaving six bullet‑riddled bodies in its rugged terrain.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.trawellino.com/destinations/united-states/arizona_six-shooter-canyon"
    },
    {
      "id": 2,
      "text": "The canyon sits inside the Gila Box Riparian National Conservation Area, a protected desert waterway home to endangered species like the Southwestern willow flycatcher.",
      "sourceSentenceIds": [
        28
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.trawellino.com/destinations/united-states/arizona_six-shooter-canyon"
    },
    {
      "id": 3,
      "text": "Because of minimal light pollution, Six Shooter Canyon offers some of Arizona’s darkest skies, making it a quiet hotspot for stargazing.",
      "sourceSentenceIds": [
        29
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.trawellino.com/destinations/united-states/arizona_six-shooter-canyon"
    },
    {
      "id": 4,
      "text": "Pinal Creek drains the canyon, flowing north through Globe before joining the Salt River near Theodore Roosevelt Lake.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Six_Shooter_Canyon%2C_Arizona"
    },
    {
      "id": 5,
      "text": "The Gila Pueblo campus of Eastern Arizona College is located in Six Shooter Canyon, providing higher‑education opportunities in a rural setting.",
