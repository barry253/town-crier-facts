  "facts": [
    {
      "id": 1,
      "text": "Kollwitzplatz was christened on 7 October 1947 after Käthe Kollwitz, the graphic artist who lived nearby until her death.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Kollwitzplatz",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "A bronze sculpture of Kollwitz, based on her self‑portrait, was erected in the square’s center in 1961 and remains a popular climbing spot for children.",
      "sourceSentenceIds": [
        27,
        28,
        29
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Kollwitzplatz",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "During Berlin’s 750th‑anniversary celebrations in 1987, surrounding streets were rebuilt to match their historic appearance as part of a redevelopment plan.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Kollwitzplatz",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The 2016 action‑thriller *Jason Bourne* filmed a key scene on Kollwitzplatz, though the Berlin exterior shots were actually shot in Kreuzberg.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Kollwitzplatz",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Residents successfully opposed a planned demolition of the area until the fall of the Berlin Wall, preserving the neighborhood’s historic character.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.pankow-weissensee-prenzlauerberg.berlin/en/kollwitzplatz",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Kollwitzplatz sits at the heart of the so‑called “Kollwitzkiez,” a neighborhood that has become one of Prenzlauer Berg’s most sought‑after residential areas.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
