      "category": "culture",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The Madison Historical Society sits in Lee’s Academy on 14 Meetinghouse Lane, open Wednesday through Friday from 10 a.m. to 2 p.m.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.madisonhistory.org/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Madison Center lies at the crossroads of U.S. Route 1 and Connecticut Route 79, anchoring the town’s historic core.",
      "sourceSentenceIds": [
        7,
        8
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Madison_Center%2C_Connecticut",
