  "facts": [
    {
      "id": 1,
      "text": "Minden was founded in 1836 by Charles Veeder and named after the German city of Minden.",
      "sourceSentenceIds": [
        28,
        29
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Minden%2C_Louisiana",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "German settlers founded a utopian community in the 1830s seeking religious freedom, now a museum.",
      "sourceSentenceIds": [
        7,
        5
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://mindenstays.com/minden-louisiana-a-walk-through-time/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The Louisiana and Arkansas Railroad made Minden its headquarters, and the town once housed one of the world's largest lumber mills.",
      "sourceSentenceIds": [
        10,
        11
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Minden%2C_Louisiana",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The Dorcheat Historical Museum preserves artifacts from the Civil War era, where Minden played a significant role.",
      "sourceSentenceIds": [
        2,
        18,
        16
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://mindenstays.com/minden-louisiana-a-walk-through-time/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Minden’s Main Street district is listed on the National Register of Historic Places and is a Louisiana Main Street Community.",
