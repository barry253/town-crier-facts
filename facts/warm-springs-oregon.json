    },
    {
      "id": 2,
      "text": "The Confederated Tribes of Warm Springs formed from three bands of Indigenous people who lived in harmony for hundreds of years.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://traveloregon.com/things-to-do/culture-history/oregon-tribal-spotlight-warm-springs/"
    },
    {
      "id": 3,
      "text": "Sahaptian speakers of Warm Springs referred to the local river as Nch’i-Wàna, which means Great River.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Web source 2"
      ],
