  "facts": [
    {
      "id": 1,
      "text": "Arnegard was founded in 1906 and named after brothers Evan and Oscar Arnegard, the area's first homesteaders.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Arnegard%2C_North_Dakota",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town incorporated in 1913 when the Great Northern Railroad extended its line past Watford City to Arnegard.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Arnegard%2C_North_Dakota",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "In 1914 Arnegard built a one‑story, four‑room school for grades 1 through 12, which opened on January 29, 1915.",
      "sourceSentenceIds": [
        15,
        16
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Arnegard%2C_North_Dakota",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "After a 1998 renovation, the historic school building became the Old School Bed & Breakfast, later featured on HGTV’s “If Walls Could Talk.”.",
      "sourceSentenceIds": [
        23,
        24
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Arnegard%2C_North_Dakota",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Arnegard’s Main Street suffered a devastating fire in January 1959, a second blaze in March, but most structures were rebuilt by 1961.",
      "sourceSentenceIds": [
        26,
        27,
        28
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Arnegard%2C_North_Dakota",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The town’s first place of worship was a one‑room log‑cabin church, the Wilmington Lutheran Church.",
      "sourceSentenceIds": [
        13
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
