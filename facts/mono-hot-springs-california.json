  "facts": [
    {
      "id": 1,
      "text": "Mono Hot Springs opened to the public in 1927 after rugged road construction nicknamed “Cheap and Nasty.”.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.monohotsprings.com/history-mono-hot-springs-resort-historic-cabins-california/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The resort’s historic cabins were built in 1935, a few years after the Kaiser Pass Road was finished for the Big Creek Hydroelectric Project.",
      "sourceSentenceIds": [
        17
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Mono_Hot_Springs",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Six hot springs rise here, the hottest reaching 112 °F (44.4 °C), located on a hillside across the South Fork of the San Joaquin River.",
      "sourceSentenceIds": [
        19,
        20
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Mono_Hot_Springs",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Mono Hot Springs sits at 6,562 ft (2,000 m) in the central Sierra Nevada, overlooking Florence Lake and Lake Thomas A. Edison reservoirs.",
      "sourceSentenceIds": [
        18,
        21
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Mono_Hot_Springs",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The area was first accessed by horseback along old Indian trails before the 1920s, making it a remote retreat until the 1930s.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.monohotsprings.com/history-mono-hot-springs-resort-historic-cabins-california/",
      "category": "other",
      "quality": "poor",
      "qualityReason": "vague"
    },
    {
