  "facts": [
    {
      "id": 1,
      "text": "Middlebury was founded by settlers from Vermont in 1832, who chose the area because the rolling hills reminded them of their home state.",
      "sourceSentenceIds": [
        12,
        13
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Middlebury%2C_Indiana",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town’s name honors those settlers’ Vermont hometown, linking Middlebury, Indiana, to Middlebury, Vermont.",
      "sourceSentenceIds": [
        12,
        13
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Middlebury%2C_Indiana",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "In 1841, Amish families from Pennsylvania arrived, establishing the area as part of Northern Indiana’s Amish country.",
      "sourceSentenceIds": [
        14,
        9
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Middlebury%2C_Indiana",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The Little Elkhart River runs through Middlebury, winding among rolling hills and farmland.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Middlebury%2C_Indiana",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The railroad reached Middlebury in 1888, diversifying its economy from pure farming to include manufacturing.",
