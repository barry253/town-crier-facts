      "id": 1,
      "text": "Middlebury was founded by settlers from Vermont in 1832, who chose the area because the rolling hills reminded them of their home state.",
      "sourceSentenceIds": [
        12,
        13
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
