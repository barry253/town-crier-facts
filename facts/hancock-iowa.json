  "facts": [
    {
      "id": 1,
      "text": "Hancock, Iowa sits in Hancock County, which was founded on January 15, 1851, and named after Revolutionary War figure John Hancock.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Hancock_County%2C_Iowa",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The county seat, Garner, is home to a courthouse that earned a spot on the National Register of Historic Places.",
      "sourceSentenceIds": [
        2,
        5
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Hancock_County%2C_Iowa",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Hancock County was officially created on June 28, 1858, after a county-wide election.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Hancock_County%2C_Iowa",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "When the county was formed, the townships of Avery and Madison were also established.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Hancock_County%2C_Iowa",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The courthouse in Garner was built soon after the county’s founding and still serves as the center of county government.",
