  "facts": [
    {
      "id": 1,
      "text": "Lemon Cove got its name from a local citrus farmer, though the post office later changed the spelling to “Lemoncove” to avoid confusion with Lemon Grove.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.yoresequoia.org/blog/lemon-cove-narrative/",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The arrival of the Visalia and Tulare Railroad in the late 1880s turned Lemon Cove from an isolated valley into a fruit shipping hub.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.wisdomlib.org/cities/lemon-cove-190037",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The Pogue Hotel, built in 1879 as “The Cottonwoods,” still stands today and now houses the Lemon Cove Women’s Club, a National Register site.",
      "sourceSentenceIds": [
        5,
        8,
        13
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.yoresequoia.org/blog/lemon-cove-narrative/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Lemon Cove enjoys a hot-summer Mediterranean climate, with scorching dry summers and cool wet winters typical of the Sierra foothills.",
