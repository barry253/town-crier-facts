  "facts": [
    {
      "id": 1,
      "text": "Landusky takes its name from Powell 'Pike' Landusky, a prospector whose story was dramatized on Death Valley Days.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Landusky%2C_Montana"
    },
    {
      "id": 2,
      "text": "Gold placer deposits found in 1884 sparked a rush that turned the Little Rocky Mountains into a mining hotspot.",
      "sourceSentenceIds": [
        14
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://unitedstatesghosttowns.com/landusky-montana-ghost-town/"
    },
    {
      "id": 3,
      "text": "The town sits in the valley of Rock Creek, tucked between Mill Gulch to the northeast and Montana Gulch to the northwest.",
      "sourceSentenceIds": [
        19
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Landusky%2C_Montana"
    },
    {
      "id": 4,
      "text": "Log cabins, saloons, and mining operations lined the streets until fires, economic hardship, and World War II pushed the community into abandonment.",
      "sourceSentenceIds": [
        13
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://unitedstatesghosttowns.com/landusky-montana-ghost-town/"
    },
    {
      "id": 5,
      "text": "The community is served by the Zortman post office, located less than five miles northeast across the Little Rockies.",
