      ],
      "source": "https://newjersey.wiki/a/Beach_Haven_New_Jersey_Complete_Guide",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Every summer, the Beach Haven Arts Festival gathers local artists, musicians, and craftspeople to celebrate the community’s creative spirit.",
      "sourceSentenceIds": [
