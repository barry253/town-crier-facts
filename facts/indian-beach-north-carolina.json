      "quality": "poor",
      "qualityReason": "location_description"
    },
    {
      "id": 2,
      "text": "To the north, Bogue Sound separates Indian Beach from the mainland, while the Atlantic lies to the south.",
      "sourceSentenceIds": [
        4
