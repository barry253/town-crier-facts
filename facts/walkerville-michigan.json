    },
    {
      "id": 2,
      "text": "The Walker family built a rail line in 1882 connecting Walkerville to Essex County, later expanding to Kingsville, Leamington, London, and Port Stanley.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Web source 2"
