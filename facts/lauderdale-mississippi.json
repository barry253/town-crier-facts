  "facts": [
    {
      "id": 1,
      "text": "Lauderdale got its name from James Lauderdale, one of the first European settlers guided by Samuel Dale in 1800.",
      "sourceSentenceIds": [
        13
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Lauderdale%2C_Mississippi",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "A 300‑foot, two‑story hotel and cottages once lined Lauderdale Springs, turning the town into a 19th‑century mineral‑spring resort.",
      "sourceSentenceIds": [
        16
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Lauderdale%2C_Mississippi",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Lauderdale incorporated on March 12, 1856, the same day the Mobile and Ohio Railroad reached the springs.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Lauderdale%2C_Mississippi",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "During the Civil War, the resort’s grand hotel was converted into a Confederate hospital that served soldiers until the war’s end.",
      "sourceSentenceIds": [
        19
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Lauderdale%2C_Mississippi",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The town’s post office began as Mingo Houma in 1800, became Springs Depot in 1856, then Lauderdale Springs until 1894, and finally Lauderdale.",
      "sourceSentenceIds": [
        15,
        18,
        25
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Lauderdale%2C_Mississippi",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Lauderdale sits in the valley of Possum Creek, just south of its confluence with Ponta Creek, a tributary of the Tombigbee River.",
