  "facts": [
    {
      "id": 1,
      "text": "Edmund Eugene Hunter founded Veneta in 1912 and named the settlement after his five-year-old daughter, Veneta Elvira.",
      "sourceSentenceIds": [
        1,
        2
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 2"
      ],
      "source": "https://en.wikipedia.org/wiki/Veneta%2C_Oregon"
    },
    {
      "id": 2,
      "text": "The area that is now Veneta was originally inhabited by the Kalapuya Native American tribe.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.visitoregon.com/cities/veneta-oregon/"
    },
    {
      "id": 3,
      "text": "Veneta has been the site of the annual Oregon Country Fair since 1970.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Veneta%2C_Oregon"
    },
    {
      "id": 4,
      "text": "The Grateful Dead played a concert called the first Field Trip at the Oregon Country Fair site on August 27, 1972.",
      "sourceSentenceIds": [
        16
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Veneta%2C_Oregon"
    },
    {
      "id": 5,
      "text": "Veneta is located adjacent to the Fern Ridge Reservoir, which is used for water sports, kayaking, and fishing.",
      "sourceSentenceIds": [
        22,
        23
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Veneta%2C_Oregon"
    },
    {
      "id": 6,
      "text": "The Fern Ridge Wildlife Area surrounding the reservoir is known for bird watching and contains several hiking trails.",
