  "facts": [
    {
      "id": 1,
      "text": "Oak Grove’s post office opened in 1904 as “Creighton Station” before adopting the neighborhood’s name in 1907.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
