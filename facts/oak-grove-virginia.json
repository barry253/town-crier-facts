      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Oak Grove Elementary School, founded in 1913, has served the community for over a century.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.oakgroverva.org/history",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "In 1914, Oak Grove was annexed into the City of Richmond, just a year after its school was built.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.oakgroverva.org/history",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The James River Branch Trail is being developed along an abandoned railroad corridor that once ran through Oak Grove.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.oakgroverva.org/history",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "An old tobacco factory in Oak Grove has been converted into luxury apartments, illustrating the area’s revitalization.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.oakgroverva.org/history",
      "category": "landmark",
      "quality": "good"
    },
    {
