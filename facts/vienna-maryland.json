      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town sits on the Nanticoke River, which was named after the powerful Nanticoke Indian Confederacy that once thrived along its banks.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 1"
      ],
