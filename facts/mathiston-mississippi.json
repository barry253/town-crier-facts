      "id": 1,
      "text": "Mathiston got its name when William Gideon Mathis donated land for a depot and organized a community meal, prayer service, and lot sale in his honor.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
