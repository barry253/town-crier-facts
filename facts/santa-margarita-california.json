  "facts": [
    {
      "id": 1,
      "text": "Santa Margarita was founded in 1889 near Cuesta Peak along today's State Route 58.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Santa_Margarita%2C_California",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town’s name honors the 13th‑century Italian saint, Margaret of Cortona, whose asistencia was established around 1775.",
      "sourceSentenceIds": [
        2,
        7
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Santa_Margarita%2C_California",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "In 1889 the Southern Pacific Railroad reached Santa Margarita, making it a temporary terminus while the Cuesta Grade was built.",
      "sourceSentenceIds": [
        11,
        12
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Santa_Margarita%2C_California",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The historic Santa Margarita de Cortona Asistencia, founded circa 1775, sits in the town and reflects early mission-era history.",
      "sourceSentenceIds": [
        2,
        27
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Santa_Margarita%2C_California",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Santa Margarita’s vineyards benefit from a cooling marine influence and a long growing season across five soil types, producing diverse wines.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Web source 2"
      ],
