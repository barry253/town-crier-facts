  "facts": [
    {
      "id": 1,
      "text": "Lake Nebagamon derives its name from a Chippewa phrase meaning a place to hunt deer by fire on the water.",
      "sourceSentenceIds": [
        4,
        18
      ],
      "sourceLabels": [
        "Web source 1",
        "Wikipedia"
      ],
      "source": "https://villagelakenebagamon.wi.gov/"
    },
    {
      "id": 2,
      "text": "The village is home to Camp Nebagamon, a boys' overnight camp founded in 1929 on former Weyerhauser Paper Company land.",
      "sourceSentenceIds": [
        2,
        9
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Lake_Nebagamon%2C_Wisconsin"
    },
    {
      "id": 3,
      "text": "Lake Nebagamon's growth began in 1882 when the Duluth, South Shore and Atlantic Railroad constructed a line across northern Wisconsin.",
      "sourceSentenceIds": [
        12,
        13
      ],
      "sourceLabels": [
        "Web source 1",
        "Web source 2"
      ],
      "source": "https://villagelakenebagamon.wi.gov/"
    },
    {
      "id": 4,
      "text": "The Lake Nebagamon Village Auditorium is listed on the National Register of Historic Places because of its unique log construction.",
      "sourceSentenceIds": [
        11,
        14
      ],
      "sourceLabels": [
        "Web source 1",
        "Web source 2"
      ],
      "source": "https://villagelakenebagamon.wi.gov/"
    },
    {
      "id": 5,
      "text": "Count Guilio Bolognesi established the Stella Cheese Company in Lake Nebagamon in 1917 after purchasing one thousand acres of land.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://campnebagamon.com/keylog/54849-in-29-facts/"
    },
    {
      "id": 6,
      "text": "Every early July, the town hosts the Dragin' Tail Run, a five-mile race that takes contestants through the entire community.",
