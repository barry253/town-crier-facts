  "facts": [
    {
      "id": 1,
      "text": "Wellborn began in 1867 as a railroad construction camp for the Houston and Texas Central Railroad, located on Farm Road 2154.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.tshaonline.org/handbook/entries/wellborn-tx",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town’s name comes from a well at the construction camp and a foreman named E.W., a local legend.",
      "sourceSentenceIds": [
        8,
        11
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 2"
      ],
      "source": "https://en.wikipedia.org/wiki/Wellborn%2C_Texas",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The Wellborn Cemetery, dating to the early 1870s, is a state historic landmark that preserves the town’s earliest burials.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Wellborn%2C_Texas",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Wellborn sits on gently rolling terrain with creeks that historically supplied fresh water to settlers and supported early travel.",
      "sourceSentenceIds": [
        16
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://wiki.wellbornarchives.org/wiki/Wellborn,_Texas",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "In 2009, the Citizens for Wellborn Committee formed a non‑profit to explore incorporation, reflecting the community’s ongoing desire for self‑governance.",
