  "facts": [
    {
      "id": 1,
      "text": "In the 1880s, Gordon was renamed after Dan Gordon, a Henry County probate judge who served from 1880 to 1907.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://encyclopediaofalabama.org/article/gordon/",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "White settlers first arrived in the Gordon area as early as 1819, long before the town’s official founding.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://encyclopediaofalabama.org/article/gordon/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The first steamboats began sailing the Chattahoochee River in 1828, turning Gordon into a bustling port with three landings.",
      "sourceSentenceIds": [
        24,
        25
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://encyclopediaofalabama.org/article/gordon/",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "When the Alabama Midland Railroad built a track through Gordon in 1890, the town’s river‑port prominence faded.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://encyclopediaofalabama.org/article/gordon/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Cotton from surrounding plantations became Gordon’s main cargo, while riverboats brought in goods for local merchants.",
      "sourceSentenceIds": [
        26
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://encyclopediaofalabama.org/article/gordon/",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "During the Civil War, federal blockades of the Chattahoochee River slowed traffic and depressed Gordon’s economy.",
      "sourceSentenceIds": [
        29
      ],
      "sourceLabels": [
        "Web source 1"
      ],
