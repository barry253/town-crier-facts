  "facts": [
    {
      "id": 1,
      "text": "Garden Farms was developed in 1918 on land purchased from Rancho Santa Margarita by Edward Gardner Lewis, who planned the farms to supply produce to Atascadero.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Garden_Farms%2C_California",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Lewis envisioned Garden Farms as a series of small parcels where owners could live off the land, beginning at the south gate of the Atascadero Colony.",
      "sourceSentenceIds": [
        25
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://santamargaritahistoricalsociety.org/garden-farms",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The first house in Garden Farms was a small white frame structure built by Ike Winget of Deadwood, South Dakota, and he later helped build many other homes.",
      "sourceSentenceIds": [
        27,
        28
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://santamargaritahistoricalsociety.org/garden-farms",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Garden Farms sits at an elevation of 955 feet (291 m) between Santa Margarita and Atascadero.",
      "sourceSentenceIds": [
        8,
        9
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Garden_Farms%2C_California",
      "category": "nature",
      "quality": "good",
      "qualityReason": "location_description"
    },
    {
      "id": 5,
      "text": "The historic Santa Margarita rancho was granted to Joaquin Estrada in 1841, and later Edward Gardner Lewis bought land from it in 1918.",
      "sourceSentenceIds": [
        5,
        10
      ],
      "sourceLabels": [
        "Web source 1",
        "Wikipedia"
      ],
      "source": "https://santamargaritahistoricalsociety.org/garden-farms",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Garden Farms never expanded beyond the area south of Atascadero’s city limits, remaining linked to Lewis’s model community vision.",
      "sourceSentenceIds": [
        6
      ],
