  "facts": [
    {
      "id": 1,
      "text": "Baxley was named for Wilson Baxley, a North Carolinian who arrived in Appling County during the 1820s.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.georgiaencyclopedia.org/articles/counties-cities-neighborhoods/baxley/",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town began as Station Number 7 on the Macon and Brunswick Railroad, later renamed Baxley when the line opened in 1870.",
      "sourceSentenceIds": [
        6,
        9
      ],
      "sourceLabels": [
        "Web source 1",
        "Wikipedia"
      ],
      "source": "https://www.georgiaencyclopedia.org/articles/counties-cities-neighborhoods/baxley/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Major League Baseball star Byron Buxton was born in Baxley and graduated from Appling County High School.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Baxley%2C_Georgia",
      "category": "people",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Caroline Miller, winner of the 1934 Pulitzer Prize for Lamb in His Bosom, lived in Baxley while writing the novel.",
      "sourceSentenceIds": [
        13
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.georgiaencyclopedia.org/articles/counties-cities-neighborhoods/baxley/",
      "category": "people",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Baxley's early economy thrived on timber rafting and naval stores, dominating southeastern Georgia in the late nineteenth and early twentieth centuries.",
      "sourceSentenceIds": [
        30
      ],
      "sourceLabels": [
        "Web source 1"
