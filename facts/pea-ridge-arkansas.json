  "facts": [
    {
      "id": 1,
      "text": "Pea Ridge’s streets are named after Battle of Pea Ridge participants, with east‑west streets honoring Confederates and north‑south streets honoring Union soldiers.",
      "sourceSentenceIds": [
        2,
        3
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://cityofpearidgear.gov/",
      "category": "people",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The Battle of Pea Ridge, a pivotal Civil War engagement, took place about 5 miles east of town.",
      "sourceSentenceIds": [
        15
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Pea_Ridge%2C_Arkansas",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The battle site is preserved as Pea Ridge National Military Park.",
      "sourceSentenceIds": [
        16
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Pea_Ridge%2C_Arkansas",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Pea Ridge’s downtown business district, largely 19th‑century commercial structures, is on the National Register of Historic Places.",
      "sourceSentenceIds": [
        17
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Pea_Ridge%2C_Arkansas",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The 20‑by‑40‑foot cement building that once served as City Hall now houses the Pea Ridge Community Library.",
