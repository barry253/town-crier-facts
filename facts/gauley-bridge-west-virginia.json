  "facts": [
    {
      "id": 1,
      "text": "The Kanawha River is formed at Gauley Bridge by the confluence of the New and Gauley Rivers.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Gauley_Bridge%2C_West_Virginia"
    },
    {
      "id": 2,
      "text": "Gauley Bridge takes its name from a wooden covered bridge built in the early 1820s to carry a turnpike across the river.",
      "sourceSentenceIds": [
        1,
        26
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Gauley_Bridge%2C_West_Virginia"
    },
    {
      "id": 3,
      "text": "Gauley Bridge was of strategic significance during the Civil War because it commanded entry into the Kanawha Valley.",
      "sourceSentenceIds": [
        27
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.wvencyclopedia.org/entries/2034"
    },
    {
      "id": 4,
      "text": "Possession of Gauley Bridge was hotly contested during the Civil War, and the town saw heavy fighting early in the conflict.",
      "sourceSentenceIds": [
        28
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.wvencyclopedia.org/entries/2034"
    },
    {
      "id": 5,
      "text": "During 1861 and 1862, Gauley Bridge was taken and retaken three times, and its wooden bridge was burned and rebuilt repeatedly.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.wvencyclopedia.org/entries/2034"
    },
    {
      "id": 6,
      "text": "Despite its long history, Gauley Bridge did not become an incorporated municipality until 1978.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.wvencyclopedia.org/entries/2034"
    }
  ]
