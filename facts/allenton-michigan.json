    {
      "id": 1,
      "text": "Allenton began as Smith's Corners, founded around 1844 by innkeeper Kerkimer Smith who ran a stage line to Detroit.",
      "sourceSentenceIds": [
        3,
        6
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Berlin_Township%2C_St._Clair_County%2C_Michigan"
    },
    {
      "id": 2,
      "text": "A railroad stop named Smith appeared on the Almont branch of the Pere Marquette Railway, linking the community to regional trade.",
      "sourceSentenceIds": [
        1,
        2
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Berlin_Township%2C_St._Clair_County%2C_Michigan"
    },
    {
      "id": 3,
      "text": "The post office opened in April 1883 and was renamed Allenton in March 1910 after civic leaders Darius and Jesse Allen.",
      "sourceSentenceIds": [
        4,
        7
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Berlin_Township%2C_St._Clair_County%2C_Michigan"
    },
    {
      "id": 4,
      "text": "The community’s early growth was spurred by speculators who began buying land in 1835, with settlement kicking off by 1840.",
      "sourceSentenceIds": [
        25
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Berlin_Township%2C_St._Clair_County%2C_Michigan"
    },
    {
      "id": 5,
      "text": "A post office operated in the area from February 1862 until July 1962, marking over a century of continuous service.",
