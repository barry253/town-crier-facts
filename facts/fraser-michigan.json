  "facts": [
    {
      "id": 1,
      "text": "Fraser was named after Alexander J. Fraser, a Detroit lawyer, when the village was founded.",
      "sourceSentenceIds": [
        4,
        5
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Fraser%2C_Michigan",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The village grew around a railroad depot built by the Chicago, Detroit and Canada Grand Trunk Junction Railroad in 1858, making it a crossroads community.",
      "sourceSentenceIds": [
        14,
        7
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.frasercitymi.gov/309/History-of-Fraser",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "In the late 1700s, Fraser Township land was part of French and English Indian Reserve before becoming Bay County.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://frasertownship.org/about.php",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The early economy featured a Knorr and Steffens woodworking mill, considered one of southern Michigan's finest in 1882.",
      "sourceSentenceIds": [
        15
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.frasercitymi.gov/309/History-of-Fraser",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Fraser’s forests and proximity to Saginaw Bay drove early settlement and continue to support farming today.",
      "sourceSentenceIds": [
        9,
        10
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://frasertownship.org/about.php",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The city’s boundaries are roughly a square bounded by 15 Mile Road, Kelly Road, 13 Mile Road, and Hayes Road.",
