  "facts": [
    {
      "id": 1,
      "text": "Lebanon was founded in 1802, just a year before Ohio became a state, and was laid out by Ichabod Corwin, a relative of future governor Thomas Corwin.",
      "sourceSentenceIds": [
        5,
        6
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.lebanonchamber.org/historical-lebanon/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The city’s name comes from the Biblical Lebanon, inspired by the many juniper or Eastern Red cedar trees that once lined the area.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Lebanon%2C_Ohio",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The Warren County Historical Society, founded in 1940, preserves Lebanon’s past and owns the Glendower State Memorial, built in 1836 for merchant John Milton Williams.",
      "sourceSentenceIds": [
        2,
        4
      ],
      "sourceLabels": [
        "Web source 2",
        "Wikipedia"
      ],
      "source": "https://www.lebanonchamber.org/historical-lebanon/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Lebanon hosts the Lebanon Mason Monroe Railroad, where passengers ride a scenic stagecoach route along the former Cincinnati, Lebanon and Northern Railway right‑of‑way.",
      "sourceSentenceIds": [
        14
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Lebanon%2C_Ohio",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "In the 1900s, philanthropists William Harmon and Jedediah Tingle helped shape the city, with Harmon Hall now housing a museum that spans prehistoric to mid‑20th‑century artifacts.",
      "sourceSentenceIds": [
        11,
        13
      ],
      "sourceLabels": [
        "Web source 1",
        "Wikipedia"
      ],
      "source": "https://www.lebanonohio.gov/visitors/history_of_the_city.php",
      "category": "people",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The Shakers were among the earliest settlers in the Lebanon area, leaving a lasting religious and cultural influence on the community.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.lebanonohio.gov/visitors/history_of_the_city.php",
