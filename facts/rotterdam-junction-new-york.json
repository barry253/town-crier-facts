  "facts": [
    {
      "id": 1,
      "text": "Rotterdam Junction was founded in 1661 by Dutch settlers who named it after Rotterdam in the Netherlands, the first European foothold in the area.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Rotterdam%2C_New_York",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "In 1820, legislation created the town of Rotterdam, separating it from Schenectady’s third ward after a 1819 council recommendation.",
      "sourceSentenceIds": [
        23
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Rotterdam%2C_New_York",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Rotterdam Junction’s location along the Erie Canal and the Hudson River helped shape its 19th‑century growth.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://relocationgenius.net/location/Rotterdam%20Junction/NY/",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The Dellemont‑Wemple Farm, added to the National Register of Historic Places in 1973, sits near the canal.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Rotterdam%2C_New_York",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The Mabee House, the oldest surviving house in the Mohawk Valley, was listed on the National Register in 1978.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Rotterdam%2C_New_York",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Every Wednesday, a food truck event hosted by the town, DEC, and the library brings locals together.",
