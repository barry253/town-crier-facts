      "id": 1,
      "text": "Whitethorn, once called Thorn, opened its post office in 1888, closed in 1923, reopened in 1951, and renamed Whitethorn in 1961.",
      "sourceSentenceIds": [
        11
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
