  "facts": [
    {
      "id": 1,
      "text": "Hickman began as Heckman, a town platted in 1872 by Reverend Heckman and Samuel Egger when the Atchison and Nebraska Railroad accepted a station there.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Hickman%2C_Nebraska",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "A misspelling during the plat filing turned Heckman into Hickman, giving the town its current name.",
      "sourceSentenceIds": [
        15
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Hickman%2C_Nebraska",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The town incorporated as Hickman in 1885, officially becoming a city in Lancaster County.",
      "sourceSentenceIds": [
        16
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Hickman%2C_Nebraska",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "In the 1880s, a new school, a Legion Hall, and a library were dedicated, marking early civic growth.",
