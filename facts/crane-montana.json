  "facts": [
    {
      "id": 1,
      "text": "Crane was named after trapper Jimmy Crain—spelled \"Crane\" when the post office opened in 1910.",
      "sourceSentenceIds": [
        1,
        4
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 2"
      ],
      "source": "https://en.wikipedia.org/wiki/Crane%2C_Montana"
    },
    {
      "id": 2,
      "text": "Trapper Jimmy Crain and partner \"French Joe\" Seymore built a cabin near Fox Creek in 1876.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.mtmemory.org/nodes/view/127647"
    },
    {
      "id": 3,
      "text": "Crain Ranch, a stage stop and hotel, became a clearinghouse for settlers before selling to John O’Brien in 1888.",
      "sourceSentenceIds": [
        15,
        16,
        17
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.mtmemory.org/nodes/view/127647"
    },
    {
      "id": 4,
      "text": "When the Northern Pacific Railway line opened in 1912, Crane vied with Sidney for valley dominance, but Sidney’s businessmen bought lots to curb Crane’s growth.",
      "sourceSentenceIds": [
        18,
        19
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.mtmemory.org/nodes/view/127647"
    },
    {
      "id": 5,
      "text": "Crane sits along the Yellowstone River, the last free‑flowing river in the lower 48, where anglers float and hunt for Montana agates.",
      "sourceSentenceIds": [
        3,
        10,
        11,
        12,
        13
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://data.visitmt.com/data/cities/MT/CRANE"
    },
    {
      "id": 6,
      "text": "Crane’s semi‑arid climate, classified BSk, means hot summers and cold winters with limited precipitation.",
