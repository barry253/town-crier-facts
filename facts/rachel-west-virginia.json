    },
    {
      "id": 2,
      "text": "The community took the name Rachel by the mid-1920s, named after the daughter of a local mine official.",
      "sourceSentenceIds": [
        8,
        9
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Rachel%2C_West_Virginia"
    },
    {
      "id": 3,
      "text": "Rachel is located along Buffalo Creek, just two miles east-southeast of Mannington.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Rachel%2C_West_Virginia"
    },
    {
      "id": 4,
      "text": "The first trolley arrived in the area on March 24, 1909, bringing passengers to the local Downs stop.",
