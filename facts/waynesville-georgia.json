  "facts": [
    {
      "id": 1,
      "text": "Waynesville was named after Revolutionary War hero General “Mad” Anthony Wayne, honoring his legacy in the early 19th‑century settlement.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.thegagenweb.com/gabrantley/places/waynesville/waynesville-home.html"
    },
    {
      "id": 2,
      "text": "In 1829, Waynesville became the first county seat of Wayne County before the seat moved to Jesup in 1873.",
      "sourceSentenceIds": [
        21,
        22
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.thegagenweb.com/gabrantley/places/waynesville/waynesville-home.html"
    },
    {
      "id": 3,
      "text": "The town sits on the old Post Road, the historic boundary between Brantley and Glynn counties.",
      "sourceSentenceIds": [
        15,
        18
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Waynesville%2C_Georgia"
    },
    {
      "id": 4,
      "text": "Waynesville’s local history is preserved by the Waynesville Historical Society, located at 117 Mineral Springs Road.",
      "sourceSentenceIds": [
        3,
        7
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.localoffices.org/historical-society/georgia/brantley-county"
    },
    {
      "id": 5,
      "text": "The Historical Society collects and displays artifacts, photographs, and personal stories that document Waynesville’s past.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.localoffices.org/historical-society/georgia/brantley-county"
    },
    {
      "id": 6,
      "text": "Waynesville is part of the Brunswick, Georgia metropolitan statistical area, linking it to the larger coastal region.",
