  "facts": [
    {
      "id": 1,
      "text": "Betsy Layne takes its name from Elizabeth 'Betsy' Layne, a local pioneer whose homestead once stood nearby.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/betsy_layne_kentucky"
    },
    {
      "id": 2,
      "text": "The community was founded in 1875 along the Levisa Fork, beginning as a modest agricultural settlement owned by the Layne family.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/betsy_layne_kentucky"
    },
    {
      "id": 3,
      "text": "The Chesapeake and Ohio Railroad reached Betsy Layne around 1908, spurring growth in the region’s coal mining industry.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.kyatlas.com/ky-betsy-layne.html"
    },
    {
      "id": 4,
      "text": "Betsy Layne sits at 671 feet above sea level, roughly 13 miles southeast of Prestonsburg along the Levisa Fork.",
      "sourceSentenceIds": [
        22
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/betsy_layne_kentucky"
    },
    {
      "id": 5,
      "text": "The town experiences a humid subtropical climate, with hot, humid summers and mild winters typical of eastern Kentucky.",
      "sourceSentenceIds": [
        24
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/betsy_layne_kentucky"
    },
