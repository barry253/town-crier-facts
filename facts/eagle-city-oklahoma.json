  "facts": [
    {
      "id": 1,
      "text": "Eagle City was originally established as a planned community in the Oklahoma Territory around 1900.",
      "sourceSentenceIds": [
        5,
        14
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/eagle_city_oklahoma"
    },
    {
      "id": 2,
      "text": "The town's post office opened in 1902 under the name Dillon before being renamed Eagle City in 1909.",
      "sourceSentenceIds": [
        4,
        6,
        18
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 2"
      ],
      "source": "https://en.wikipedia.org/wiki/Eagle_City%2C_Oklahoma"
    },
    {
      "id": 3,
      "text": "Eagle City flourished as a frontier settlement with bustling saloons and dance halls before declining between 1930 and 1960.",
      "sourceSentenceIds": [
        28
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://unitedstatesghosttowns.com/eagle-city-oklahoma-ghost-town/"
    },
    {
      "id": 4,
      "text": "Economic impacts from the 1929 stock market crash and the Dust Bowl of the 1930s devastated local agriculture.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/eagle_city_oklahoma"
    },
    {
      "id": 5,
      "text": "The Eagle City Community Building was constructed in 1936 with funding from the Works Progress Administration to serve as a social hub.",
      "sourceSentenceIds": [
        17
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/eagle_city_oklahoma"
    },
    {
      "id": 6,
      "text": "Nearly 350 abandoned home sites and a deteriorating church remain today to tell the story of Eagle City.",
      "sourceSentenceIds": [
        9,
