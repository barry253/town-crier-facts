  "facts": [
    {
      "id": 1,
      "text": "Cottage City got its name from the early \"Highlands\" development, where developers marketed large lots and a streetcar line that never materialized.",
      "sourceSentenceIds": [
        16
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Cottage_City%2C_Maryland",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Before European settlers, the area that is now Cottage City was home to several Potomac River Indian tribes, as early records show.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Cottage_City%2C_Maryland",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The former Bladensburg Dueling Grounds, once called the Dark and Bloody Grounds, sat along Dueling Creek and now borders Cottage City.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Cottage_City%2C_Maryland",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "A trolley called the Washington, Spa Spring and Gretta Railroad ran through Cottage City until 1923, when competition from other rail lines ended service.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Cottage_City%2C_Maryland",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "In 1999, Cottage City joined Bladensburg and Colmar Manor in a joint effort that earned praise from the Joint Center for Sustainable Communities for revitalizing the Port Towns.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Cottage_City%2C_Maryland",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Cottage City’s early economy thrived on Harrison’s Landing, a deep‑water Anacostia River port that once hosted Moyer’s Grist Mill, the first of its kind between Baltimore and Alexandria.",
