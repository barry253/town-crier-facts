      "quality": "good"
    },
    {
      "id": 3,
      "text": "The settlement sits near the western end of Diamond Avenue on Indiana 66, about 10 miles northwest of Evansville.",
      "sourceSentenceIds": [
        10,
        23,
        26
      ],
      "sourceLabels": [
        "Wikipedia",
