  "facts": [
    {
      "id": 1,
      "text": "Seven Mile Ford takes its name from a river crossing seven miles from the historic Royal Oak Fort in Marion.",
      "sourceSentenceIds": [
        28
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Seven_Mile_Ford%2C_Virginia",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The Preston‑Crockett House, built in 1842 by John Montgomery Preston, once served as a tavern on Interstate 81.",
      "sourceSentenceIds": [
        4,
        16
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://icatchshadows.com/photo-and-history-of-the-preston-crockett-house-in-southwestern-virginia/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Aspenvale Cemetery, the final resting place of many early settlers, earned a spot on the National Register of Historic Places in 1980.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Seven_Mile_Ford%2C_Virginia",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Route 11 cuts through the heart of Seven Mile Ford, placing the town just four miles from Chilhowie.",
      "sourceSentenceIds": [
        29
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Seven_Mile_Ford%2C_Virginia",
      "category": "transport",
      "quality": "poor",
      "qualityReason": "route_only"
    },
    {
      "id": 5,
      "text": "In 2022, local officials approved a truck‑stop and retail center on the historic Preston‑Crockett House site, threatening its survival.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://icatchshadows.com/photo-and-history-of-the-preston-crockett-house-in-southwestern-virginia/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Author Lucy Herndon Crockett called the Preston House home from 1947 until her death in 2002, writing several popular books there.",
