  "facts": [
    {
      "id": 1,
      "text": "Weston was named after local blacksmith and postmaster Bert Weston, who helped establish the town in the late 1800s.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.usacitiesonline.com/cocountyweston.htm",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "In 1988, Weston earned National Forest Byway status, highlighting its scenic route through the Purgatoire River Valley.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.usacitiesonline.com/cocountyweston.htm",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Our Lady of Guadalupe Church and Medina Cemetery were added to the National Register of Historic Places in 2019.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Weston%2C_Colorado",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The Weston Post Office has been serving the community since 1889, a testament to its long‑standing heritage.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Weston%2C_Colorado",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Weston sits on the north side of the Purgatoire River, near where the South Fork joins the main stem.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Weston%2C_Colorado",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "An 1866 church and its adjoining cemetery at Medina Plaza lie about three miles east of downtown Weston.",
