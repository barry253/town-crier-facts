  "facts": [
    {
      "id": 1,
      "text": "Fredericton sprang to life in 1783 when United Empire Loyalists from New England settled along the Wolastoq.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Fredericton"
    },
    {
      "id": 2,
      "text": "The city’s name honors Frederick, son of King George III, and it was first called Fredericstown.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Fredericton"
    },
    {
      "id": 3,
      "text": "From 1784 to 1869 Fredericton functioned as a British garrison town, and its military compound now stands as a National Historic Site.",
      "sourceSentenceIds": [
        9,
        16
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 2"
      ],
      "source": "https://en.wikipedia.org/wiki/Fredericton"
    },
    {
      "id": 4,
      "text": "The Saint John River, known to Indigenous peoples as Wolastoq, cuts through Fredericton and has shaped its development.",
      "sourceSentenceIds": [
        22,
        15
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Fredericton"
    },
    {
      "id": 5,
      "text": "Every summer, Fredericton hosts the Harvest Jazz & Blues Festival, attracting musicians from across Canada and beyond.",
      "sourceSentenceIds": [
        27
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Fredericton"
    },
    {
      "id": 6,
      "text": "In 1945 the former community of Devon—originally called Gibson—was merged into Fredericton, enlarging the city.",
      "sourceSentenceIds": [
