      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.riveroakstx.com/history"
    },
    {
      "id": 3,
      "text": "River Oaks opened its first playground on September 6, 1947, originally called Thurston Park.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.riveroakstx.com/history"
    },
    {
      "id": 4,
      "text": "River Oaks grew as a bedroom community for Carswell Air Force Base, later a Joint Reserve Base in 1994.",
      "sourceSentenceIds": [
        5
      ],
