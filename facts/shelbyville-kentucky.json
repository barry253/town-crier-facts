      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Shelby College, originally the Shelbyville Academy, moved to College Street in 1836 and closed in 1871 after a brief revival as James College.",
      "sourceSentenceIds": [
