  "facts": [
    {
      "id": 1,
      "text": "Borrego Pass gets its name from the Spanish word for 'yearling lamb,' echoing the Navajo name meaning 'ascending lamb trail.'.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://ehillerman.unm.edu/2910"
    },
    {
      "id": 2,
      "text": "The community sprang up around a trading post opened in 1927 by Ben and Anna Harvey, later run by Bill and Jean Cousins.",
      "sourceSentenceIds": [
        2,
        4
      ],
      "sourceLabels": [
        "Web source 1",
        "Wikipedia"
      ],
      "source": "https://kids.kiddle.co/Borrego_Pass,_New_Mexico"
    },
    {
      "id": 3,
      "text": "In 1939, Don and Fern Smouse bought the trading post and ran it for more than forty years.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Borrego_Pass%2C_New_Mexico"
    },
    {
      "id": 4,
      "text": "Borrego Pass is an ancient water gap that cuts through the Dutton Plateau, crossing the Continental Divide.",
      "sourceSentenceIds": [
        3,
        25,
        26
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Borrego_Pass%2C_New_Mexico"
    },
    {
      "id": 5,
      "text": "The Borrego Pass School, founded in the early 1950s, became one of the first Bureau of Indian Affairs contract schools in 1972.",
      "sourceSentenceIds": [
        11,
        12,
        30
      ],
      "sourceLabels": [
