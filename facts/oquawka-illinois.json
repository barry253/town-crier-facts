  "facts": [
    {
      "id": 1,
      "text": "Oquawka’s name comes from the Sauk and Meskwaki word Oquawkiek, meaning “yellow banks,” a nod to the river bluff’s hue.",
      "sourceSentenceIds": [
        10,
        19,
        20
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/Oquawka_Illinois",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Stephen Sumner Phelps and his brother Alexis founded the village, originally called Yellow Banks, in the early 19th century.",
      "sourceSentenceIds": [
        5,
        20,
        21
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/Oquawka_Illinois",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "When voters rejected a rail line in 1851, the Chicago Burlington and Quincy Railroad bypassed Oquawka in 1855, draining its river trade.",
      "sourceSentenceIds": [
        13,
