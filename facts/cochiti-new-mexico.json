  "facts": [
    {
      "id": 1,
      "text": "Cochiti Pueblo, originally called ‘ko‑tyīt’ in Keresan, has been on the National Register of Historic Places since the early 1970s.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://cochiti.org/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "In the early 21st century, Cochiti opened the Keres Children’s Learning Center, an immersion school preserving its language and culture.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Cochiti%2C_New_Mexico",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The San Buenaventura Mission, built by Spanish Catholic missionaries, stands in Cochiti as a reminder of colonial religious pressure.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.nmhealthcouncils.org/land-acknowledgment-toolkit/cochiti-pueblo",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Because Cochiti has no written language, storytelling and pottery figurines have long carried its history.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.nmhealthcouncils.org/land-acknowledgment-toolkit/cochiti-pueblo",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Every July 14, Cochiti celebrates San Buenaventura’s feast day with music, dance, and traditional food.",
      "sourceSentenceIds": [
        21
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Cochiti%2C_New_Mexico",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Cochiti’s reservation borders Kasha‑Katuwe Tent Rocks National Monument, a unique volcanic landscape managed with the BLM.",
      "sourceSentenceIds": [
        20
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
