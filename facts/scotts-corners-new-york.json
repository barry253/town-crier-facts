      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Before European settlement, the area that is now Scotts Corners belonged to the Wappinger Confederacy, the indigenous people of northern Westchester County.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Web source 2"
      ],
