      "id": 1,
      "text": "Witmer’s Bridge, completed in 1800, stretched 540 feet across the Susquehanna and was only 19 feet wide.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 1"
      ],
