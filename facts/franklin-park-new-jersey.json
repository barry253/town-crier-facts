  "facts": [
    {
      "id": 1,
      "text": "Franklin Park was originally called Six Mile Run, named after a tributary of the Millstone River that appeared around 1710.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Franklin_Park%2C_New_Jersey"
    },
    {
      "id": 2,
      "text": "From 1714 to 1737, Franklin Park hosted New Jersey’s first Somerset County courthouse and jail before a fire moved the seat to Millstone.",
      "sourceSentenceIds": [
        11
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Franklin_Park%2C_New_Jersey"
    },
    {
      "id": 3,
      "text": "John Quincy Adams and Andrew Jackson both stopped at Gifford’s Tavern while traveling through Franklin Park in the 1800s.",
      "sourceSentenceIds": [
        14
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Franklin_Park%2C_New_Jersey"
    },
    {
      "id": 4,
      "text": "The town’s first post office opened in 1826, marking the beginning of formal communication for the community.",
      "sourceSentenceIds": [
        16
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Franklin_Park%2C_New_Jersey"
    },
    {
      "id": 5,
      "text": "In 1874, Gifford’s Tavern was replaced by the 26‑room Beekman’s Hotel, later known as Franklin House, which burned down in 1929.",
      "sourceSentenceIds": [
        15
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Franklin_Park%2C_New_Jersey"
    },
    {
      "id": 6,
      "text": "The current Franklin Park School building, a ten‑room structure erected in 1957, sits between Hillview and Central Avenue.",
      "sourceSentenceIds": [
        20
      ],
