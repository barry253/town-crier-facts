    },
    {
      "id": 3,
      "text": "The town of Bearden is old enough to appear on a 1911 Rand McNally map of the county.",
      "sourceSentenceIds": [
        14
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Bearden%2C_Oklahoma"
    },
    {
      "id": 4,
      "text": "Bearden once sustained a bank, a cotton gin, a blacksmith shop, and two automobile repair garages.",
      "sourceSentenceIds": [
