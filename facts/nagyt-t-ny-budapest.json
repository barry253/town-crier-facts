  "facts": [
    {
      "id": 1,
      "text": "Nagytétény Castle, a late Baroque mansion, exemplifies the Grassalkovich style that flourished in Hungary during the 18th century.",
      "sourceSentenceIds": [],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.imm.hu/en/contents/kastelytortenet",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The Museum of Applied Arts in Nagytétény was housed in the former Száraz‑Rudnyánszky mansion, a landmark of Hungarian late Baroque architecture.",
      "sourceSentenceIds": [],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.imm.hu/en/contents/kastelytortenet",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Since 2010, the museum’s entrance hall has been restored, and a 2011 reconstruction plan preserved its historic façade.",
      "sourceSentenceIds": [],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.imm.hu/en/contents/kastelytortenet",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The museum’s collections span ceramics, glass, contemporary design, and metalwork, offering a comprehensive view of applied arts.",
      "sourceSentenceIds": [],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.imm.hu/en/contents/kastelytortenet",
      "category": "other",
      "quality": "poor",
      "qualityReason": "vague"
    },
    {
      "id": 5,
      "text": "Virtual tours of the Nagytétény mansion allow visitors to explore its interior without leaving their car.",
      "sourceSentenceIds": [],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.imm.hu/en/contents/kastelytortenet",
      "category": "other",
      "quality": "poor",
      "qualityReason": "vague"
    },
    {
      "id": 6,
      "text": "The museum participates in the Danube Interreg project, aiming to strengthen cultural identity across the Danube region.",
      "sourceSentenceIds": [],
      "sourceLabels": [
