  "facts": [
    {
      "id": 1,
      "text": "Mico’s name comes from the Medina Irrigation Company, whose acronym MICO became the town’s original spelling.",
      "sourceSentenceIds": [
        2,
        6
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Mico%2C_Texas",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The post office opened as Mico in 1911, switched to Medina Lake in 1916, and returned to Mico in 1923.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.tshaonline.org/handbook/entries/mico-tx",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Mico began as a workers’ camp for the 1,500 Mexican laborers who built Medina Dam in the early 1900s.",
      "sourceSentenceIds": [
        6,
        7
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 2"
      ],
      "source": "https://en.wikipedia.org/wiki/Mico%2C_Texas",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Medina Dam, completed in 1913, is listed on the National Register of Historic Places for its engineering significance.",
      "sourceSentenceIds": [
        8,
        28
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Mico%2C_Texas",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Today Mico is a fishing resort located just east of the dam on County Road 271, overlooking Medina Lake.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.tshaonline.org/handbook/entries/mico-tx",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Mico is part of the San Antonio Metropolitan Statistical Area, linking it to the larger regional economy.",
      "sourceSentenceIds": [
        27
