      "quality": "good"
    },
    {
      "id": 2,
      "text": "A 1909 map titled “Vinita Park – The Next Reach” was produced by the Davis Realty Development Company and is archived in the Library of Congress.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Wikipedia"
