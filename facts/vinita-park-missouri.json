      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The Vinita Park subdivision was first laid out in 1905 by A.C. Stewart before being marketed by Everett Davis of the Davis Realty Development Company.",
      "sourceSentenceIds": [
        28,
        29
      ],
      "sourceLabels": [
