    },
    {
      "id": 2,
      "text": "In 1974 the mall became fully enclosed, turning its open‑air layout into the indoor, single‑level center that exists today.",
      "sourceSentenceIds": [
        12,
        2
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 2"
      ],
      "source": "https://en.wikipedia.org/wiki/Bassett_Place"
    },
    {
      "id": 3,
      "text": "The original tenants included White House Department Store, Popular Dry Goods, and Kresge, before Popular became Dillard’s in 1995.",
      "sourceSentenceIds": [
        13,
        14
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Bassett_Place"
    },
    {
      "id": 4,
      "text": "A 2003 addition replaced the old Popular space with Costco, which opened on November 13, 2003.",
      "sourceSentenceIds": [
