    {
      "id": 1,
      "text": "Barker Ten Mile got its name from the nearby Barker Methodist Church and the winding Ten Mile Swamp that feeds into the Lumber River.",
      "sourceSentenceIds": [
        3,
        10,
        12
      ],
      "sourceLabels": [
        "Web source 1",
        "Web source 2",
        "Wikipedia"
      ],
