      "id": 1,
      "text": "Clarendon was founded in 1878 as a Methodist clergyman's 'sobriety settlement' and named after founder's wife Clara.",
      "sourceSentenceIds": [
        1,
        25
      ],
      "sourceLabels": [
        "Web source 1",
        "Wikipedia"
      ],
