  "facts": [
    {
      "id": 1,
      "text": "Bang Khen’s name blends the Thai word for market, talat, with the historic area Bang Khen, hinting at its origins as a bustling marketplace.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/talat_bang_khen",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Once a rural district famed for fruit orchards and canals, Bang Khen was absorbed into Bangkok’s urban sprawl during the 20th century.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.trawellino.com/destinations/thailand/bangkok_bang-khen",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The 1872 completion of the Prem Prachakon Canal marked Bang Khen’s shift from agricultural fields to a more urbanized community.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/talat_bang_khen",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "In October 1933, Bang Khen became a battleground during the Boworadet Rebellion, pitting royalist troops against the government.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Bang_Khen_district",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Wat Lak Si Temple, located near Lak Si Circle, serves as a cultural hub where guided community tours showcase local traditions.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/talat_bang_khen",
