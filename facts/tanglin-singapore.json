  "facts": [
    {
      "id": 1,
      "text": "Tanglin’s name comes from the Teochew “Twa Tang Leng,” meaning “great east hill peaks,” reflecting the surrounding hills.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Tanglin",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The Singapore Botanic Gardens, a UNESCO World Heritage Site founded in 1859, lies within Tanglin and is the city’s oldest garden.",
      "sourceSentenceIds": [
        22,
        23
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Tanglin",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Dempsey Hill, once a British military barracks, now hosts upscale restaurants and galleries, illustrating Tanglin’s military‑to‑lifestyle conversion.",
      "sourceSentenceIds": [
        25
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Tanglin",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Tanglin hosts the headquarters of Singapore’s Ministry of Foreign Affairs and Interpol’s regional office, giving the area a diplomatic gravitas.",
      "sourceSentenceIds": [
        29
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Tanglin",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The Museum of Ice Cream opened in 2021 on Loewen Road, adding a quirky cultural spot to Tanglin’s lineup.",
      "sourceSentenceIds": [
        26
      ],
      "sourceLabels": [
