    },
    {
      "id": 2,
      "text": "Sutcliffe is located on the western banks of Pyramid Lake, a remnant of the prehistoric Lake Lahontan.",
      "sourceSentenceIds": [
        14,
        25
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Sutcliffe%2C_Nevada"
    },
    {
      "id": 3,
      "text": "The Southern Pacific Railroad established a station and water stop in Sutcliffe in 1912 to support ranchers and suppliers.",
      "sourceSentenceIds": [
        5,
        8,
        9
      ],
      "sourceLabels": [
        "Web source 1",
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/sutcliffe_nevada"
    },
    {
      "id": 4,
      "text": "Northern Paiute people, specifically the cui-ui eaters band, inhabited the Pyramid Lake region for thousands of years before European contact.",
      "sourceSentenceIds": [
