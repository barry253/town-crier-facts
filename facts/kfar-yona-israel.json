  "facts": [
    {
      "id": 1,
      "text": "Kfar Yona was founded on Tu Bishvat, January 23 1932, by Morris Fischer and originally called Gan Yona.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Kfar_Yona"
    },
    {
      "id": 2,
      "text": "The town’s land was legally purchased in 1932 from Mustafa Bushnaq and the Shanti family and named for Jean (Yona) Fischer.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Kfar_Yona"
    },
    {
      "id": 3,
      "text": "During the 1948 Arab‑Israeli War, Kfar Yona stood on the front lines where defenders faced an Iraqi army that tried to split Jewish forces.",
      "sourceSentenceIds": [
        25
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Kfar_Yona"
    },
    {
      "id": 4,
      "text": "The Historical Museum of Kfar Yona, best visited in spring or autumn, chronicles the town’s growth through unique artifacts and exhibits.",
