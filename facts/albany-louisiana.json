  "facts": [
    {
      "id": 1,
      "text": "The town’s name comes from the Choctaw word abani, meaning “to cook over a fire.”.",
      "sourceSentenceIds": [
        19
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Albany%2C_Louisiana",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Between 1896 and 1920, hundreds of Hungarian immigrants settled in Albany, naming the community Árpádhon, the largest rural Hungarian settlement in the U.S. at the time.",
      "sourceSentenceIds": [
        2,
        24
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Albany%2C_Louisiana",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The Hungarian Settlement School in Albany was listed on the National Register of Historic Places in 2001.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Albany%2C_Louisiana",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The old school building now houses the Hungarian Settlement Museum, which opened its doors in September 2017.",
      "sourceSentenceIds": [
        28
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Albany%2C_Louisiana",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Before railroads changed everything, Albany’s economy thrived on timber, agricultural products, and manufactured goods, making it an indispensable link in Louisiana’s commercial network.",
      "sourceSentenceIds": [
        11
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://unitedstatesghosttowns.com/albany-louisiana-ghost-town/",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The abandoned town site now draws cultural tourists and ghost hunters, drawn by its historical significance and reported paranormal activity.",
