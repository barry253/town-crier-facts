  "facts": [
    {
      "id": 1,
      "text": "Old Forge was named after the region's oldest forge, the original iron forge that gave the town its name.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://oldforgeborough.com/",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The borough sits on the Lackawanna River, whose acid mine drainage from a borehole in Old Forge is the point source of pollution in the Chesapeake Bay watershed.",
      "sourceSentenceIds": [
        21
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Old_Forge%2C_Lackawanna_County%2C_Pennsylvania",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "In 2017, Winter Storm Stella dumped 23 inches of snow on Old Forge, one of the largest snowfall totals in the town's history.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Old_Forge%2C_Lackawanna_County%2C_Pennsylvania",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Old Forge’s warmest month averages 83°F in July, while January averages a chilly 34°F, reflecting its humid continental climate.",
      "sourceSentenceIds": [
        24
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Old_Forge%2C_Lackawanna_County%2C_Pennsylvania",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The Maxson Corporation once operated an electronics factory in Old Forge that employed up to 1,000 workers in the 1950s.",
      "sourceSentenceIds": [
