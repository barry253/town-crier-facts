  "facts": [
    {
      "id": 1,
      "text": "Ida Grove was incorporated on May 31, 1878, and its name honors Mount Ida in Greece through the county’s namesake.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Ida_Grove%2C_Iowa",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "When the railroad cut through the area in 1877, the town moved south of the Maple River to sit beside the tracks.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Ida_Grove%2C_Iowa",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Since 1982, Ida Grove hosts Gomaco Trolley, a firm that restores historic streetcars and builds replicas for transit operators across North America.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Ida_Grove%2C_Iowa",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The 1883 Moorehead House Museum showcases period furnishings, Ida County history, and a veteran’s display inside a preserved Victorian home.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.traveliowa.com/cities/ida-grove-iowa/445/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The historic Stagecoach Inn once served as Ida County’s first courthouse, hospital, and church before the town’s growth.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.traveliowa.com/cities/ida-grove-iowa/445/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Inside the Ida Grove post office hangs an oil‑on‑linen mural titled Preparation for the First County Fair, painted in 1940 by Andrene Kauffman.",
