  "facts": [
    {
      "id": 1,
      "text": "Candler Park is named after Asa Griggs Candler, co‑founder of Coca‑Cola, who donated land for the park in 1922.",
      "sourceSentenceIds": [
        18
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/candler_park",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The park opened a nine‑hole golf course in 1927, and today it hosts tennis courts, a basketball court, a pool, playgrounds, and wetlands that attract beavers and hawks.",
      "sourceSentenceIds": [
        18
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/candler_park",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Before becoming a park, area was community of Edgewood, founded in 1870s along the Georgia Railroad and annexed by Atlanta in 1908, sparking Craftsman and Queen Anne homes.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/candler_park",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "In the late 1860s and 1870s, an African‑American community called Rose Hill emerged within early Edgewood, centered along what is now Candler Park Drive.",
      "sourceSentenceIds": [
        22
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/candler_park",
      "category": "people",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Mid‑20th century saw suburban expansion in Candler Park, with modest American Small Houses built in the 1940s and multi‑family dwellings that drew working‑class residents during and after WWII.",
      "sourceSentenceIds": [
        24
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/candler_park",
      "category": "history",
      "quality": "good"
    }
  ],
