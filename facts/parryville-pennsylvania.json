      "quality": "poor",
      "qualityReason": "location_description"
    },
    {
      "id": 3,
      "text": "In 1836 the Beaver Meadow Railroad turned Parryville into a bustling shipping terminus.",
      "sourceSentenceIds": [
        4,
        10
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Parryville%2C_Pennsylvania",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The Pine Forest Lumber Company established its headquarters in Parryville in 1836, building sawmills and a lathe facility by the creek.",
      "sourceSentenceIds": [
        23
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Parryville%2C_Pennsylvania",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Around 1855 a blast furnace powered by Pohopoco Creek operated in Parryville before the Carbon Iron Company switched it to steam.",
