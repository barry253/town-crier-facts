  "facts": [
    {
      "id": 1,
      "text": "Parryville earned its name from Daniel Parry, the borough’s first president, when it was first called Parrysville.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Parryville%2C_Pennsylvania",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town lies just north of the confluence where Pohopoco Creek meets the Lehigh River.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Parryville%2C_Pennsylvania",
