  "facts": [
    {
      "id": 1,
      "text": "Lowell was founded by Oregon pioneer Amos Damon Hyland of Illinois in the late 1800s as a logging town.",
      "sourceSentenceIds": [
        2,
        6
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 2"
      ],
      "source": "https://en.wikipedia.org/wiki/Lowell%2C_Oregon"
    },
    {
      "id": 2,
      "text": "Amos Hyland named the city of Lowell after his home town of Lowell, Maine.",
      "sourceSentenceIds": [
        1,
        4
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Lowell%2C_Oregon"
    },
    {
      "id": 3,
      "text": "Amos Hyland platted the center of his property as a town to entice the railroad to locate in Lowell.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.lowelloregon.gov/community/page/history"
    },
    {
      "id": 4,
      "text": "Lowell is situated on the north shore of Dexter Reservoir on the Middle Fork Willamette River.",
      "sourceSentenceIds": [
        17
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Lowell%2C_Oregon"
    },
    {
      "id": 5,
      "text": "The Lowell Covered Bridge was built in 1945 and is one of the last remaining covered bridges in the area.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://nearbylens.com/cities/usa/or/lowell/"
    },
    {
