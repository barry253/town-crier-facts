  "facts": [
    {
      "id": 1,
      "text": "Superstition Springs Center was named by 1800s farmers after the Akimel O'odham oral history, honoring the indigenous roots of the area.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.visitphoenix.com/sonoran-desert/parks/superstition-mountains/",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The White Mountain Apache once believed the Superstitions thundered because the mountains were home to thunder gods, a legend still told today.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.visitphoenix.com/sonoran-desert/parks/superstition-mountains/",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Before the mall, the site hosted Goldfield, a bustling mining town of the late 1800s that drew prospectors and cowboys to the Superstition Mountains.",
      "sourceSentenceIds": [
        18
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.visitphoenix.com/sonoran-desert/parks/superstition-mountains/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "When the mall first opened, the lower level featured a miniature golf course called Lunar Mini Golf, later replaced by the Phoenix Sofa Factory.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Superstition_Springs_Center",
      "category": "landmark",
      "quality": "poor",
      "qualityReason": "editorial_filler"
    },
    {
      "id": 5,
      "text": "In 2002, Superstition Springs Center added new tenants like Ross Dress For Less and Ulta Beauty to revive its retail mix after earlier struggles.",
