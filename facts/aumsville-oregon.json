  "facts": [
    {
      "id": 1,
      "text": "Aumsville is located on the site of a pioneer farm owned by Henry L. Davis, who was known as Aumus.",
      "sourceSentenceIds": [
        10,
        11
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Aumsville%2C_Oregon"
    },
    {
      "id": 2,
      "text": "The land that is now Aumsville was originally home to the Kalapuya people of the larger Kalapuyan Native American tribe.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.visitoregon.com/cities/aumsville-oregon/"
    },
    {
      "id": 3,
      "text": "Aumsville was officially incorporated as a city on August 3, 1911.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Aumsville%2C_Oregon"
    },
    {
      "id": 4,
      "text": "Mill Creek forms the southern border of Aumsville and flows northwest toward the Willamette River in Salem.",
      "sourceSentenceIds": [
        18
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Aumsville%2C_Oregon"
    },
    {
      "id": 5,
      "text": "Beaver Creek, a tributary of Mill Creek, crosses through the northern end of Aumsville.",
      "sourceSentenceIds": [
        19
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Aumsville%2C_Oregon"
    },
    {
      "id": 6,
      "text": "The Old Wooden School operated in Aumsville from 1893 until it was replaced by the Amos Davis School in 1922.",
