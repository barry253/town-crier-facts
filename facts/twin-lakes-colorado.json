  "facts": [
    {
      "id": 1,
      "text": "Twin Lakes sits at 9,200 feet, perched at the base of Colorado’s highest peak, Mount Elbert.",
      "sourceSentenceIds": [
        25,
        15
      ],
      "sourceLabels": [
        "Web source 2",
        "Web source 1"
      ],
      "source": "https://www.uncovercolorado.com/towns/twin-lakes/",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town’s name comes from the naturally formed glacial lakes that are Colorado’s largest, surrounded by 13,000‑foot peaks.",
      "sourceSentenceIds": [
        20
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://visittwinlakes.com/",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "In 1908 a resort was abandoned, and its historic buildings were moved in 1962 to keep them from being swallowed by the reservoir.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.uncovercolorado.com/towns/twin-lakes/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Twin Lakes once served as a major transportation hub between gold‑rush Leadville and Aspen, helping move goods and people across the Rockies.",
      "sourceSentenceIds": [
        28,
        29
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.uncovercolorado.com/towns/twin-lakes/",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The town’s historic village welcomes visitors along the Top of the Rockies Scenic Byway, the eastern gateway to Independence Pass.",
      "sourceSentenceIds": [
        17
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://visittwinlakes.com/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "During the Leadville 100 marathon, runners stop at Twin Lakes Aid Station at mile marker 40, a tradition that began in 2006.",
