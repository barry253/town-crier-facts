  "facts": [
    {
      "id": 1,
      "text": "John Green founded Dayton in 1829, bringing settlers from Ohio to the Fox River rapids where they built the first mill.",
      "sourceSentenceIds": [
        19,
        21,
        22
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.one-place-studies.org/all-studies/in-depth-reports/in-depth-dayton/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The woolen mill dominated Dayton’s economy, but the village also housed horse‑collar, paper, brick, grist, and saw mills.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.one-place-studies.org/all-studies/in-depth-reports/in-depth-dayton/",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Dayton’s original village cemetery became a family‑intermarried burial ground, a focus of the genealogical study begun by a great‑aunt’s archives.",
      "sourceSentenceIds": [
        4,
        5,
        7
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.one-place-studies.org/all-studies/in-depth-reports/in-depth-dayton/",
      "category": "other",
      "quality": "poor",
      "qualityReason": "editorial_filler"
    },
    {
      "id": 4,
      "text": "Since 1895, Dayton School has hosted a literary society with a circulating library, and the Musical Union held regular concerts.",
      "sourceSentenceIds": [
        14,
        15
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.one-place-studies.org/all-studies/in-depth-reports/in-depth-dayton/",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "During the 1832 Black Hawk War, a May 21 attack on Indian Creek killed fifteen settlers, prompting the village to flee to Ottawa’s fort.",
      "sourceSentenceIds": [
        8,
        28,
        29
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.one-place-studies.org/all-studies/in-depth-reports/in-depth-dayton/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "When the railroad arrived, electricity by 1880 made Dayton’s water‑powered mills obsolete, causing a sharp economic drop by 1900.",
      "sourceSentenceIds": [
        27
