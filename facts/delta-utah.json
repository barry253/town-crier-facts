  "facts": [
    {
      "id": 1,
      "text": "Delta started as a railroad switch called Aiken, then Melville, Burtner, and finally Delta in 1911 because the area was a delta of the Sevier River.",
      "sourceSentenceIds": [
        2,
        3,
        24,
        25
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Delta%2C_Utah",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town sits on the ancient delta of Lake Bonneville, making it a base camp for exploring the West Desert and the Great Basin National Historic Area.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.visitutah.com/places-to-go/cities-and-towns/delta",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The Great Basin Museum preserves Delta’s history with historic objects and photos that tell the town’s story.",
      "sourceSentenceIds": [
        8,
        9
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Delta%2C_Utah",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "A Japanese‑American incarceration camp, the Central Utah Relocation Center, was near Delta during WWII, and the Topaz Museum now preserves that history.",
      "sourceSentenceIds": [
        26,
        27,
        7
      ],
      "sourceLabels": [
        "Wikipedia",
        "Wikipedia",
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Delta%2C_Utah",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Gunnison Bend Reservoir, named for explorer John Williams Gunnison, was part of early irrigation plans that helped shape Delta’s growth.",
      "sourceSentenceIds": [
        4,
        3
      ],
      "sourceLabels": [
        "Wikipedia",
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Delta%2C_Utah",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "An early power plant in Delta was designed for four units, but only two were built, reflecting the town’s industrial ambitions.",
