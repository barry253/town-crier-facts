  "facts": [
    {
      "id": 1,
      "text": "Arcadia began as a citrus grove community, with farmers planting oranges, lemons, and grapefruits from 1919 until the mid‑1950s.",
      "sourceSentenceIds": [
        2,
        12
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Arcadia_(Phoenix)"
    },
    {
      "id": 2,
      "text": "Early zoning rules capped development at one house per five acres, preserving Arcadia’s spacious, low‑density character.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.acmna.org/arcadia-history"
    },
    {
      "id": 3,
      "text": "The Arcadia Water Company, founded in 1919, brought water from the Arizona Canal to the budding neighborhood.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Arcadia_(Phoenix)"
    },
    {
      "id": 4,
      "text": "By 1924, the company had installed 15 miles of concrete pipe and several pumping stations to irrigate the area.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Arcadia_(Phoenix)"
    },
    {
      "id": 5,
      "text": "Arcadia lies at Camelback Mountain’s south foot, stretching from 44th to 68th Streets and from Camelback Road to the canal.",
      "sourceSentenceIds": [
        9,
        10
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Arcadia_(Phoenix)"
    },
    {
      "id": 6,
      "text": "The 2010 comedy Everything Must Go, starring Will Ferrell, filmed several scenes right in Arcadia’s streets.",
