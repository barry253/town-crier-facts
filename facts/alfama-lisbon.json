  "facts": [
    {
      "id": 1,
      "text": "Alfama is Lisbon's oldest neighborhood, rising from the riverbank to the castle hill.",
      "sourceSentenceIds": [
        15
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Alfama"
    },
    {
      "id": 2,
      "text": "The name Alfama comes from Arabic al-hamma, meaning hot springs, hinting at Moorish baths that once existed.",
      "sourceSentenceIds": [
        16
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Alfama"
    },
    {
      "id": 3,
      "text": "The 1755 earthquake spared Alfama, preserving its maze of narrow streets that still echo medieval layout.",
      "sourceSentenceIds": [
        23
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Alfama"
    },
    {
      "id": 4,
      "text": "Overlooking Alfama, the medieval São Jorge Castle once served as a royal residence until the early 16th century.",
      "sourceSentenceIds": [
        25
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Alfama"
    },
    {
      "id": 5,
      "text": "Alfama hosts the Miradouro de Santa Luzia, a viewpoint perched above the church and remnants of Moorish walls.",
      "sourceSentenceIds": [
        26
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Alfama"
    },
    {
      "id": 6,
      "text": "Fado houses in Alfama are intimate rooms where local singers perform unannounced, a tradition traced back to the 19th century.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 2"
      ],
