  "facts": [
    {
      "id": 1,
      "text": "Du Pont began as the settlement of Lawton around 1856 before being renamed in 1874 after the naval officer Samuel Francis Du Pont.",
      "sourceSentenceIds": [
        1,
        3
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Du_Pont%2C_Georgia",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town officially became a city in 1889, solidifying its status within Clinch County.",
      "sourceSentenceIds": [
        7,
        11
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Du_Pont%2C_Georgia",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Du Pont’s origins trace back to the Atlantic and Gulf Railroad, where it sat on the newly chartered line that crossed the county.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Du_Pont%2C_Georgia",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "During the Civil War, a branch line from Lawton to Live Oak, Florida, was completed in 1865 to aid Confederate troop movements.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Du_Pont%2C_Georgia",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "State Route 84 cuts through Du Pont’s center, linking the town eastward to Homerville and westward to Stockton.",
