  "facts": [
    {
      "id": 1,
      "text": "Frank Young, a nephew of Brigham Young, named Leamington after a town in England.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://leamingtontown.gov/leamington-history/"
    },
    {
      "id": 2,
      "text": "Leamington was settled in 1871 by Thomas Morgan, who later organized the town's LDS Church branch in 1876.",
      "sourceSentenceIds": [
        15,
        16
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Leamington%2C_Utah"
    },
    {
      "id": 3,
      "text": "Unlike many other Utah settlements, the early pioneers of Leamington were not sent by Church authorities.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://leamingtontown.gov/leamington-history/"
    },
    {
      "id": 4,
      "text": "Leamington developed as a string town with one principal street running parallel to the railroad tracks.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://leamingtontown.gov/leamington-history/"
    },
    {
      "id": 5,
      "text": "Early Leamington settlers built their first homes from logs, including a unique cedar post house built by Harry Millet.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://leamingtontown.gov/leamington-history/"
    },
    {
      "id": 6,
      "text": "The riverbanks around Leamington were originally covered in such thick grass and brush that flood waters could not wash gullies into the ground.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://leamingtontown.gov/leamington-history/"
    }
  ]
