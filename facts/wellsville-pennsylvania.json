  "facts": [
    {
      "id": 1,
      "text": "Founded in 1737 and officially incorporated in 1892, Wellsville has kept its 19th‑century charm through the ages.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://wellsvilleborough.com/home/"
    },
    {
      "id": 2,
      "text": "The borough’s name honors its founder, Abram Wells, whose legacy lives in every street name.",
      "sourceSentenceIds": [
        22
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://wellsvilleborough.com/home/"
    },
    {
      "id": 3,
      "text": "In 1977, nearly the entire borough was listed on the National Register as the Wellsville Historic District.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Wellsville%2C_Pennsylvania"
    },
    {
      "id": 4,
      "text": "The old Wellsville‑Addison & Galeton railroad right‑of‑way has been transformed into a scenic recreational trail.",
      "sourceSentenceIds": [
        17
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.wellsvillevillageny.gov/history.html"
    },
    {
      "id": 5,
      "text": "The Sinclair Refinery, once one of Pennsylvania’s largest oil refineries, operated in Wellsville until the 1950s.",
      "sourceSentenceIds": [
        19
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.wellsvillevillageny.gov/history.html"
    },
    {
      "id": 6,
      "text": "Wellsville’s historic core includes an 1850s Methodist church and the 1870s Wellsville House, now a museum and restaurant.",
