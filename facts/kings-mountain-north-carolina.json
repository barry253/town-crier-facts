  "facts": [
    {
      "id": 1,
      "text": "Kings Mountain was renamed from White Plains in 1874 to honor the nearby 1780 Battle of Kings Mountain, a turning point in the Revolution.",
      "sourceSentenceIds": [
        5,
        14
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Kings_Mountain%2C_North_Carolina"
    },
    {
      "id": 2,
      "text": "The downtown core hosts the Kings Mountain Historical Museum, the Mauney Memorial Library, and the city police station, all within a few blocks.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Kings_Mountain%2C_North_Carolina"
    },
    {
      "id": 3,
      "text": "The museum preserves two historic houses behind the post office and hosts rotating exhibits that celebrate local history.",
      "sourceSentenceIds": [
        20
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.kingsmountainmuseum.org/"
    },
    {
      "id": 4,
      "text": "Mauney Memorial Library and Teacher's Home, the Southern Railway Company Overhead Bridge, and the West End Historic District are all listed on the National Register of Historic Places.",
