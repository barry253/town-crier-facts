      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Its riverside location near the Yukon–Koyukuk confluence turned Nulato into a key transport hub for steamboats during the late 19th century.",
      "sourceSentenceIds": [
        2,
        13
      ],
      "sourceLabels": [
