      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Fort Washington Park, Highbridge Park, and Fort Tryon Park provide green space, each featuring historic landmarks like the Little Red Lighthouse and the High Bridge Water Tower.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Wikipedia"
