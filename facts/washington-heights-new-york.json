      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Audubon Terrace, a National Historic Landmark, shelters the Hispanic Society of America, the American Academy of Arts and Letters, and Boricua College.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Wikipedia"
