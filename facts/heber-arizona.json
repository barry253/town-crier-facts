  "facts": [
    {
      "id": 1,
      "text": "Heber was founded in 1883 by LDS settlers and named after Heber J. Grant, while nearby Overgaard took its name from Danish sawmill owner Mogens Overgaard.",
      "sourceSentenceIds": [
        2,
        10
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 2"
      ],
      "source": "https://en.wikipedia.org/wiki/Heber%E2%80%93Overgaard%2C_Arizona",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Heber–Overgaard’s early economy relied on dry farming and ranching, but today tourism, retirement, and timbering drive the local industry.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Heber%E2%80%93Overgaard%2C_Arizona",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Perched atop the Mogollon Rim, Heber–Overgaard sits at 6,627 feet, offering panoramic mountain views.",
      "sourceSentenceIds": [
        30
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Heber%E2%80%93Overgaard%2C_Arizona",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Heber–Overgaard experiences a warm-summer Mediterranean climate, with dry early summer and heavy monsoon thunderstorms later.",
      "sourceSentenceIds": [
        22
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Heber%E2%80%93Overgaard%2C_Arizona",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The Apache-Sitgreaves Observatory, opened in 2017, houses Arizona’s largest dedicated public telescope for night‑sky viewing.",
      "sourceSentenceIds": [
        27
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Heber%E2%80%93Overgaard%2C_Arizona",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "In 2002, the Rodeo‑Chediski Fire threatened Heber‑Overgaard, prompting community resilience and reforestation efforts.",
