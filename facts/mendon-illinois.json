  "facts": [
    {
      "id": 1,
      "text": "Mendon was originally platted as Fairfield in 1833 but renamed Mendon after the Massachusetts town to avoid duplication.",
      "sourceSentenceIds": [
        23,
        24,
        5
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Mendon%2C_Illinois",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The village’s heritage lives on in the North Adams Historical Society museum, founded in 1961 on the 1856 North Adams Hall grounds.",
      "sourceSentenceIds": [
        2,
        4
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://museumsdatabase.com/museums/view/8691",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "In 1870 the arrival of the Quincy and Warsaw Railroad spurred Mendon’s commerce and made it a regional rail hub.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.mendonillinois.com/history-of-mendon--slideshow.html",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The Salem Evangelical Lutheran Church, founded in 1853, still stands on South State Street and is one of Mendon’s oldest buildings.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.mendonillinois.com/history-of-mendon--slideshow.html",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Mendon’s community center, Chittenden Park, hosts local events and preserves historic churches, keeping the village’s social life vibrant.",
      "sourceSentenceIds": [
        13
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.mendonillinois.com/history-of-mendon--slideshow.html",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The North Adams Hall, built in 1856, features a dome roof that earned it a spot on the National Register of Historic Places.",
      "sourceSentenceIds": [
        11
