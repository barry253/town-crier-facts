        21
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://tourist.eu/en/netherlands/north-holland/city/amsterdam",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The illuminated Zuiderkerk bell tower pierces the skyline, a gentle reminder of the city's rich history.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://tourist.eu/en/netherlands/north-holland/city/amsterdam",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Historic buildings line the waterways, warm light spilling onto the water, while bobbing boats add charming everyday life.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://tourist.eu/en/netherlands/north-holland/city/amsterdam",
