  "facts": [
    {
      "id": 1,
      "text": "Foster‑Powell is a triangular neighborhood in Southeast Portland, bounded by Powell Boulevard, Foster Road, and 82nd Avenue.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Foster-Powell%2C_Portland%2C_Oregon",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The neighborhood’s growth followed Portland’s original electric streetcar line built in the 1890s.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Foster-Powell%2C_Portland%2C_Oregon",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Sidewalks throughout Foster‑Powell were constructed in 1912, a first for the area.",
      "sourceSentenceIds": [
        7
      ],
