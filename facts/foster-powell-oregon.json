    },
    {
      "id": 2,
      "text": "The neighborhood’s growth followed Portland’s original electric streetcar line built in the 1890s.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Foster-Powell%2C_Portland%2C_Oregon"
    },
    {
      "id": 3,
      "text": "Sidewalks throughout Foster‑Powell were constructed in 1912, a first for the area.",
