  "facts": [
    {
      "id": 1,
      "text": "Creve Coeur’s name comes from French 'crève-cœur', meaning heartbreak, named after a Dutch fort La Salle built in 1680.",
      "sourceSentenceIds": [
        4,
        5
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.theroute-66.com/creve-coeur.html",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The city preserves the Tappmeyer Homestead, its only historic property still owned and maintained by Creve Coeur.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.crevecoeurmo.gov/220/History",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "French trappers explored the area in the mid‑1700s, coming from Canada and naming it Louisiana after King Louis XIV.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.theroute-66.com/creve-coeur.html",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "During the Civil War, Creve Coeur men served both sides, though most were southern sympathizers.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Creve_Coeur%2C_Missouri",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "A streetcar once ran from University City to Creve Coeur Lake, making drivers feel like they were in deep country.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.crevecoeurmo.gov/220/History",
