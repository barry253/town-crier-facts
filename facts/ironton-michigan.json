  "facts": [
    {
      "id": 1,
      "text": "Ironton sits on a narrow strip of Lake Charlevoix, where the historic Ironton Ferry still carries people across the water.",
      "sourceSentenceIds": [
        6,
        14
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Ironton%2C_Michigan"
    },
    {
      "id": 2,
      "text": "The town’s name comes from Robert Cherry, who settled there in 1879 and built an iron plant that opened in 1881.",
      "sourceSentenceIds": [
        7,
        8
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Ironton%2C_Michigan"
    },
    {
      "id": 3,
      "text": "That iron plant turned ore shipped by barge from the Upper Peninsula into pig iron, fueling the local economy for a decade.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Ironton%2C_Michigan"
    },
    {
      "id": 4,
      "text": "A post office opened in Ironton on January 31, 1881, and the community was officially platted in 1884.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Ironton%2C_Michigan"
    },
    {
      "id": 5,
      "text": "The iron operation failed in 1893, yet the town survived and grew around the ferry and lake scenery.",
      "sourceSentenceIds": [
        11
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Ironton%2C_Michigan"
    },
    {
      "id": 6,
      "text": "M‑66 runs north‑south through Ironton, linking it to the rest of northern Michigan’s scenic routes.",
      "sourceSentenceIds": [
        15
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Ironton%2C_Michigan"
    }
  ]
}
