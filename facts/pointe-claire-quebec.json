  "facts": [
    {
      "id": 1,
      "text": "Pointe‑Claire was first described by Nicolas Perrot in 1669 and appears on a map as early as 1686.",
      "sourceSentenceIds": [
        20
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Pointe-Claire",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The Grand Trunk Railway built a line through Pointe‑Claire in 1855, linking the town to Montreal.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Pointe-Claire",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "In 1701 the Great Peace of Montreal opened the Chemin du Roy, now Lakeshore Road, through Pointe‑Claire.",
      "sourceSentenceIds": [
        29
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Pointe-Claire",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "After the Great Peace, the Sulpician Order began developing their seigneury on Lac Saint‑Louis, founding Pointe‑Claire.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://patrimoinepointeclaire.org/pointe-claire-history/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The name Pointe‑Claire refers to the peninsula where the windmill, convent, and Saint‑Joachim de Pointe‑Claire Church sit.",
      "sourceSentenceIds": [
        18
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Pointe-Claire",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Pointe‑Claire station on Exo’s Vaudreuil‑Hudson line serves the town, while a new REM station opens in 2026.",
