    {
      "id": 1,
      "text": "Graham sits in Pierce County’s foothills just east of Mount Rainier, a quiet town with a rich history.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://beckdc.com/historical-places-in-graham/"
    },
    {
      "id": 2,
      "text": "What began as a railroad stop in the 1880s quickly turned Graham into a bustling hub for agriculture and commerce.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://touristplaces.guide/graham-travel-guide-top-10-must-visit-tourist-places/"
    },
    {
      "id": 3,
      "text": "The 1850 Chambers Creek Mill Site, still standing, dates back to the mid‑century and shows early milling in the area.",
      "sourceSentenceIds": [
        9,
        10
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://beckdc.com/historical-places-in-graham/"
    },
    {
      "id": 4,
      "text": "Built in the late 1800s, the Bates House once housed Graham’s first post office and now stands as a historic landmark.",
      "sourceSentenceIds": [
        11,
        12,
        16
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://beckdc.com/historical-places-in-graham/"
    },
    {
      "id": 5,
      "text": "The Stevens‑Van Trump Monument commemorates the first documented ascent of Mount Rainier in 1870 by the pioneering party.",
