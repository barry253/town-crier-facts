  "facts": [
    {
      "id": 1,
      "text": "Underwood‑Petersville earned its name after the Civil War when prominent settler families claimed land and built homesteads amid the region’s recovery.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/underwood_petersville_alabama",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "After the 1816 Treaty of Chickasaw cession, European‑American settlers began moving into the area that would become Underwood‑Petersville.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/underwood_petersville_alabama",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The community’s roots trace back to the historic Cloverdale Road, which linked the rural farming hubs of Underwood and Petersville to southern Tennessee.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/underwood_petersville_alabama",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The 1930s and 1940s TVA projects, including Wheeler Dam on the Tennessee River, electrified and flood‑controlled the area, boosting agriculture and industry.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/underwood_petersville_alabama",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Coffee Road, built in 1831, served as an early farm‑to‑market artery that helped the area grow as an agricultural outskirt of Florence.",
      "sourceSentenceIds": [
        30
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/underwood_petersville_alabama",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "A road intersecting the historic Natchez Trace once carried farm goods from Underwood‑Petersville to Florence and farther markets.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/underwood_petersville_alabama",
      "category": "transport",
      "quality": "good"
    }
