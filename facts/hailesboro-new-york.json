  "facts": [
    {
      "id": 1,
      "text": "Hailesboro was named after Brigadier General James Haile, who settled the area in 1807 and built the first sawmill that same year.",
      "sourceSentenceIds": [
        10,
        13,
        18
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/hailesboro_new_york",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The hamlet’s first post office opened in 1858 as Hailesborough, later shortened to Hailesboro in 1893, linking the remote community to the wider world.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/hailesboro_new_york",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "A flood in 1809 destroyed Haile’s mills, but they were rebuilt that same year, and a more advanced grist mill was erected in 1844.",
      "sourceSentenceIds": [
        4,
        11
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/hailesboro_new_york",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "By the early 1900s, Hailesboro became a talc‑mining hub, with water‑powered mills processing large quantities of talc daily.",
      "sourceSentenceIds": [
        20
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/hailesboro_new_york",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The Oswegatchie River drops 84 feet over half a mile near Hailesboro, providing the water power that drove its early mills.",
      "sourceSentenceIds": [
        14
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/hailesboro_new_york",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Hailesboro sits within the town of Fowler in Lawrence County, a region that grew after the War of 1812 when settlers sought timber and fertile land.",
      "sourceSentenceIds": [
        13,
        17
      ],
      "sourceLabels": [
