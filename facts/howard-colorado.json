      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Howard%2C_Colorado",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The Howard post office has been serving residents since 1882, a testament to the town’s long‑standing roots.",
      "sourceSentenceIds": [
