      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Nestled on the banks of the Arkansas River, Howard sits between Salida and Cañon City in southwestern Fremont County.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.uncovercolorado.com/towns/howard/",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Route 50 cuts through Howard, linking it 13 miles northwest to Salida and 46 miles east to Cañon City.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Howard%2C_Colorado",
