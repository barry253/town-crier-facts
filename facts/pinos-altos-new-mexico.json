  "facts": [
    {
      "id": 1,
      "text": "Pinos Altos sprang to life in May 1860 when three 49ers—Thomas Birch, Colonel Snively, and James Hicks—discovered gold at Bear Creek.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.newmexico.org/places-to-visit/ghost-towns/pinos-altos/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town later adopted the Spanish name Pinos Altos, meaning 'tall pines,' because of the dense conifers that surrounded it.",
      "sourceSentenceIds": [
        22
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Pinos_Altos%2C_New_Mexico",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "On September 27, 1861, the Battle of Pinos Altos saw Arizona Guards clash with Apache warriors led by Mangas Coloradas and Cochise.",
      "sourceSentenceIds": [
        25
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Pinos_Altos%2C_New_Mexico",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "A 2‑foot narrow‑gauge railroad ran through Pinos Altos from 1906 to 1907, linking the town to the Silver City smelter.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Pinos_Altos%2C_New_Mexico",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Roy Bean, later famed as Judge Roy Bean, once ran a mercantile and saloon on Main Street in Pinos Altos.",
      "sourceSentenceIds": [
        28
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Pinos_Altos%2C_New_Mexico",
      "category": "people",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "At about 7,000 feet, Pinos Altos enjoys a cold semi‑arid climate with winter temperatures averaging 18°F and snowfall around 8–9 inches per month.",
      "sourceSentenceIds": [
        20
