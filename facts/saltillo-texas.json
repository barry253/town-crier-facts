  "facts": [
    {
      "id": 1,
      "text": "Saltillo, Texas was founded in 1577 by Conquistador Alberto del Canto and Spanish colonists.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://mexicanroutes.com/saltillo/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Saltillo, Texas once served as the capital of the Mexican state of Coahuila and Texas, founded in 1586 near a mission established in 1582.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.tshaonline.org/handbook/entries/saltillo-coahuila-mexico",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "In 1824 Saltillo became the capital of Coahuila and Texas, remaining the seat of government until March 1833.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.tshaonline.org/handbook/entries/saltillo-coahuila-mexico",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The town’s name was briefly changed to Leona Vicario in 1827 to honor a heroine of the Mexican War of Independence, then reverted to Saltillo in 1831.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.tshaonline.org/handbook/entries/saltillo-coahuila-mexico",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Saltillo’s streets still showcase colonial architecture, and the city hosts workshops and exhibitions that preserve its architectural and social history.",
      "sourceSentenceIds": [
        16,
        19
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://mexicanroutes.com/saltillo/",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Saltillo lies 16 miles east of Sulphur Springs at the intersection of US 67 and FM 900.",
      "sourceSentenceIds": [
        26
