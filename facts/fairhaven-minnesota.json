  "facts": [
    {
      "id": 1,
      "text": "Partridge named the town after noticing the river’s calm beauty, exclaiming, “This looks like a fair haven,” which stuck as Fairhaven.",
      "sourceSentenceIds": [
        23
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/fairhaven_minnesota"
    },
    {
      "id": 2,
      "text": "Fairhaven’s first settlers arrived in spring 1856 from Ohio, led by Thomas C. Partridge, who staked the first land claims.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/fairhaven_minnesota"
    },
    {
      "id": 3,
      "text": "The town grew around the Clearwater River, whose water power fueled early mills and shaped Fairhaven’s industrial roots.",
      "sourceSentenceIds": [
        14
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/fairhaven_minnesota"
    },
    {
      "id": 4,
      "text": "During the 1862 U.S.-Dakota War, settlers built Fort Fair Haven—a stockade around a log hotel—to shelter against attacks.",
      "sourceSentenceIds": [
        19
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/fairhaven_minnesota"
    },
    {
      "id": 5,
      "text": "The 1867 Fair Haven Flour Mill, the state’s third-oldest wood‑frame water‑powered gristmill, earned a National Register spot in 1977.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/fairhaven_minnesota"
    },
    {
      "id": 6,
      "text": "Today, Fairhaven Mill Park spans five acres, jointly managed by Wright and Stearns Counties, preserving the historic mill and dam.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
