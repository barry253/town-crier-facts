  "facts": [
    {
      "id": 1,
      "text": "Cassville was founded in July 1833 as the seat of justice for Cass County and quickly became a trade hub in the Cherokee Nation.",
      "sourceSentenceIds": [
        13,
        23,
        24
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.georgiahistory.com/ghmi_marker_updated/town-of-cassville/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town’s name honors General Lewis Cass, a Michigan statesman and Secretary of War under President Andrew Jackson.",
      "sourceSentenceIds": [
        4,
        6
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Cassville%2C_Georgia",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "In 1864 Union General William T. Sherman burned Cassville, and the town never fully recovered.",
      "sourceSentenceIds": [
        27,
        28
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Cassville%2C_Georgia",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Cassville once hosted a Confederate hospital that treated soldiers from late 1861 until May 18, 1864, when patients were moved south.",
      "sourceSentenceIds": [
        30
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Cassville%2C_Georgia",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The Cassville Historical Society preserves the town’s legacy and its museum sits on the National Register of Landmarks.",
      "sourceSentenceIds": [
        10,
        9
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.cassvillehistoricalsociety.com/history/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Cassville’s railroad fate: the Western and Atlantic line built two miles west in the 1840s, causing the town to lose its trading prominence.",
