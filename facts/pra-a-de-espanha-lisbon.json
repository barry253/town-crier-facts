  "facts": [
    {
      "id": 1,
      "text": "Praça de Espanha is a square in Lisbon from which vehicles can proceed to the south bank of the river Tejo.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Pra%C3%A7a_de_Espanha%2C_Lisbon"
    },
    {
      "id": 2,
      "text": "The square also hosts a metro station, Praça de Espanha, linking commuters to the city’s underground network.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Pra%C3%A7a_de_Espanha%2C_Lisbon"
    },
    {
      "id": 3,
      "text": "The square was fully reconstructed in 1998, giving it a modern layout while preserving its historic role.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Pra%C3%A7a_de_Espanha%2C_Lisbon"
    },
    {
      "id": 4,
      "text": "The Praça de Espanha metro station, formerly Palhavã, opened in 1959 as part of Lisbon’s first metro phase.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.metrolisboa.pt/viver/arte-nas-estacoes-2/praca-de-espanha/"
    },
    {
      "id": 5,
      "text": "Architecturally, the station follows the 1950s program, featuring simple yellow tiles and a subtle gray line pattern.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.metrolisboa.pt/viver/arte-nas-estacoes-2/praca-de-espanha/"
    },
    {
      "id": 6,
      "text": "Artist Maria Keil painted the station’s tiles to create a three‑dimensional illusion using white, yellow, green, and gray, playing with light and shadow.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Web source 1"
      ],
