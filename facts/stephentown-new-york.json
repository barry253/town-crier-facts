  "facts": [
    {
      "id": 1,
      "text": "Stephentown was renamed for Stephen Van Rensselaer, a prominent landowner in the area.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Stephentown%2C_New_York"
    },
    {
      "id": 2,
      "text": "The town’s first settlers arrived around 1765, establishing a community that would grow into modern Stephentown.",
      "sourceSentenceIds": [
        16
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Stephentown%2C_New_York"
    },
    {
      "id": 3,
      "text": "Early pioneers came mainly from New England, especially Rhode Island and Connecticut, bringing their traditions to the town.",
      "sourceSentenceIds": [
        17
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Stephentown%2C_New_York"
    },
    {
      "id": 4,
      "text": "Stephentown’s southern border meets Columbia County, while its eastern edge touches Massachusetts, making it a crossroads of two states.",
      "sourceSentenceIds": [
        18
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Stephentown%2C_New_York"
    },
    {
      "id": 5,
      "text": "The western and central portions of Stephentown sit on the Rensselaer Plateau, a distinctive highland area in the region.",
      "sourceSentenceIds": [
        19
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Stephentown%2C_New_York"
    },
    {
      "id": 6,
      "text": "Every June, the town hosts a Strawberry Festival that draws locals and visitors to celebrate the region’s harvest.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.stephentown-historical.org/"
    }
  ]
