  "facts": [
    {
      "id": 1,
      "text": "Ridgway was founded in 1824 by Philadelphia shipping merchant Jacob Ridgway and his associate James Gillis.",
      "sourceSentenceIds": [
        3,
        16
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Ridgway%2C_Pennsylvania",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The borough’s name honors Jacob Ridgway, whose wealth from Philadelphia and London investments funded the town’s early growth.",
      "sourceSentenceIds": [
        13,
        14
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Ridgway%2C_Pennsylvania",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Ridgway’s historic core, the Ridgway Historic District, was added to the National Register of Historic Places in 2003.",
      "sourceSentenceIds": [
        18
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Ridgway%2C_Pennsylvania",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Grant House and the Ridgway Armory, both key 19th‑century structures, also sit on the National Register of Historic Places.",
      "sourceSentenceIds": [
        8,
        10
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Ridgway%2C_Pennsylvania",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "At the turn of the 20th century, Ridgway boasted more millionaires per capita than any other U.S. town, thanks to its booming lumber industry.",
      "sourceSentenceIds": [
        19
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Ridgway%2C_Pennsylvania",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The borough lies in the valley where the Clarion River meets Elk Creek, a geographic feature that helped attract early settlers.",
      "sourceSentenceIds": [
        22
