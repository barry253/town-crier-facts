  "facts": [
    {
      "id": 1,
      "text": "Galestown began as Nanticoke Indian land, later part of the 1714 Harpers Delight deed, and was named after an early family.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.galestown.com/",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Wheatley's Methodist Episcopal Church, built in the 19th century, still serves Galestown’s community today.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.galestown.com/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The town’s roots trace back to Gales Creek and the historic Galestown Millpond, central to early industry.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.galestown.com/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Every quarter, residents gather for a town meeting at the community center, with the next one on June 9, 2026.",
