  "facts": [
    {
      "id": 1,
      "text": "Slidell was named for John Slidell, a Confederate diplomat honored by early settlers in the 19th century.",
      "sourceSentenceIds": [
        1,
        2,
        4
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1",
        "Web source 2"
      ],
      "source": "https://en.wikipedia.org/wiki/Slidell%2C_Texas"
    },
    {
      "id": 2,
      "text": "The community sits on Hickory Creek, twenty miles from Decatur in northeastern Wise County.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.tshaonline.org/handbook/entries/slidell-tx"
    },
    {
      "id": 3,
      "text": "Early settlers faced horse thieves, Comanche raids, and outlaws like Sam Bass, who hid two miles northwest at Cove Hollow.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.tshaonline.org/handbook/entries/slidell-tx"
    },
    {
      "id": 4,
      "text": "In 1884 a post office and several businesses moved to lots on Hickory Creek donated by local landowners.",
      "sourceSentenceIds": [
        30
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.tshaonline.org/handbook/entries/slidell-tx"
    },
    {
      "id": 5,
      "text": "Between 1867 and 1887 thousands of cattle crossed the area on the Chisholm Trail heading north to Kansas markets.",
      "sourceSentenceIds": [
        28
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.tshaonline.org/handbook/entries/slidell-tx"
    },
    {
      "id": 6,
      "text": "Before becoming Slidell, the site was called Hackberry Grove, a gathering spot for picnics and revivals in the late 1800s.",
      "sourceSentenceIds": [
        29
      ],
