      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The Ringstraße, a grand boulevard built in the late 19th century, surrounds Vienna’s historic centre and showcases Baroque palaces and monumental buildings.",
      "sourceSentenceIds": [
