  "facts": [
    {
      "id": 1,
      "text": "Lake LeAnn was created in the early 1960s by building two man‑made lakes on former farm land.",
      "sourceSentenceIds": [
        19
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.lakeleann.org/history.html",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The community sits on 1,250 acres and offers about 9 miles of shoreline across its two basins.",
      "sourceSentenceIds": [
        17
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.lakeleann.org/history.html",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Lake LeAnn supplies the headwaters of Michigan’s longest river, the 260‑mile Grand River.",
      "sourceSentenceIds": [
        20
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.lakeleann.org/history.html",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The area was once part of the traditional territory of the Potawatomi, Ottawa, and Chippewa before European settlement.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/lake_leann_michigan",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The lake is eutrophic, with occasional algal blooms from phosphorus runoff, affecting water clarity.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/lake_leann_michigan",
