  "facts": [
    {
      "id": 1,
      "text": "Ypsilanti was named after its Michigan namesake by founder William Hartley Colby, who platted the town in the late 1800s.",
      "sourceSentenceIds": [
        1,
        10
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Ypsilanti%2C_North_Dakota",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town’s first post office opened in Theodore Doughty’s home, half a mile north, and also served as a stagecoach stop.",
      "sourceSentenceIds": [
        11
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Ypsilanti%2C_North_Dakota",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "In 1882 the post office moved into Ypsilanti proper, later shifting to the Spaulding Store, then Lee Ferguson Store, before a dedicated building opened in 1967.",
      "sourceSentenceIds": [
        12,
        13,
        14
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Ypsilanti%2C_North_Dakota",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Ypsilanti Park’s WPA-built dam, completed in 1931‑32, sits on land donated by Ed Whitney, with early fireplaces crafted by James Crouch.",
      "sourceSentenceIds": [
        15,
        17
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Ypsilanti%2C_North_Dakota",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The town’s core land was granted to the Northern Pacific Railway, forming Ypsilanti Township and the surrounding townsite.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Ypsilanti%2C_North_Dakota",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The Ypsilanti Historical Society preserves over 200 years of local heritage inside a 19th‑century home, offering museum displays and archives.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 1"
      ],
