  "facts": [
    {
      "id": 1,
      "text": "Oregon’s history began at a crossroad still present today, just south of the village at Rome Corners.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Oregon%2C_Wisconsin",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The Chicago and North Western Railroad crossed Oregon in 1864, making it a key rail link between Chicago and Minneapolis.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Oregon%2C_Wisconsin",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "From 1880 to 1950 the line was double‑tracked, but most was abandoned in 1996, then reactivated in 2014 for the Lycon Concrete Plant.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Oregon%2C_Wisconsin",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Runey’s Tavern, opened in 1843, hosted Oregon’s first marriage and early Methodist services, becoming the village’s first gathering place.",
      "sourceSentenceIds": [
        18,
        19,
        20
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Oregon%2C_Wisconsin",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Oregon’s downtown still features historic buildings like the Netherwood Block, the Badger Cycle Company building, and the original water tower on Janesville Street.",
      "sourceSentenceIds": [
        22
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Oregon%2C_Wisconsin",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The Red Brick School, built in 1922, stands north of downtown as a distinctive landmark of Oregon’s educational heritage.",
      "sourceSentenceIds": [
        23
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Oregon%2C_Wisconsin",
