        5
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://heritagesquaremuseum.com/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The museum’s 10 historic buildings include a log cabin, one‑room schoolhouse, blacksmith shop, and a train station.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.waynecountytourism.com/directory-wc/listing/heritage-square-museum/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The First Presbyterian Church of Ontario Center earned a spot on the National Register of Historic Places in 1998.",
