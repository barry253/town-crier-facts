  "facts": [
    {
      "id": 1,
      "text": "Lewis’s Hitchcock House, built in 1856, sheltered enslaved people in its basement while aiding their northward escape.",
      "sourceSentenceIds": [
        1,
        4
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/lewis_iowa",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Founded in 1853, Lewis briefly served as Cass County’s seat until 1869 and was a stop on stagecoach routes and Mormon handcart trails.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/lewis_iowa",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The Cass County Freedom Rock, a 15,000‑pound boulder in East Park, commemorates local Civil War history and the 23rd Iowa Volunteer Regiment.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/lewis_iowa",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Lewis’s 104‑acre Cold Springs Park features a lake, swimming area, picnic spots, and conservation offices, making it a quiet, history‑rich retreat.",
      "sourceSentenceIds": [
        17
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/lewis_iowa",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Lewis was named for Lewis Cass, a Michigan senator and 1848 Democratic presidential nominee, chosen for its strategic location.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/lewis_iowa",
      "category": "people",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Lewis sits along the East Nishnabotna River, a tributary that shapes the town’s fertile agricultural surroundings.",
