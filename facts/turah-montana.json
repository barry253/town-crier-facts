  "facts": [
    {
      "id": 1,
      "text": "Turah was founded in 1883 and named after Keturah, the daughter of a local pioneer.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.mtmemory.org/nodes/view/128181"
    },
    {
      "id": 2,
      "text": "Turah once served as a stagecoach stop on the historic Mullan Road and later became a Northern Pacific Railroad station.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.mtmemory.org/nodes/view/128181"
    },
    {
      "id": 3,
      "text": "Turah sits in eastern Missoula County, nestled in the valley carved by the Clark Fork River.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Turah%2C_Montana"
    },
    {
      "id": 4,
      "text": "Turah Creek, a tributary of the Clark Fork, marks the community’s southeastern edge.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Turah%2C_Montana"
    },
    {
      "id": 5,
      "text": "Turah sits at an elevation of 3,323 feet, offering a high‑altitude view of the surrounding valley.",
