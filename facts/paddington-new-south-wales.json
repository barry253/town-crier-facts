  "facts": [
    {
      "id": 1,
      "text": "Long before European settlement, the Gadigal people of the Eora Nation used the ridge that is now Oxford Street as a walking track.",
      "sourceSentenceIds": [
        3,
        12,
        13
      ],
      "sourceLabels": [
        "Web source 1",
        "Web source 2"
      ],
      "source": "https://www.visitpaddington.com/about",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "In 1831, the construction of New South Head Road prompted the renaming of the old route to Old South Head Road, improving access to South Head.",
      "sourceSentenceIds": [
        6,
        8,
        19
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 2"
      ],
      "source": "https://en.wikipedia.org/wiki/Paddington%2C_New_South_Wales",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The Paddington Library, opened in 1826 by a group of Sydney gentlemen, is part of the historic Australian Subscription Library.",
      "sourceSentenceIds": [
        5,
        25
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://dictionaryofsydney.org/entry/paddington",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Paddington Town Hall, built in 1890, now houses radio studios, a cinema, the library, and serves as a venue for private functions.",
      "sourceSentenceIds": [
        22
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Paddington%2C_New_South_Wales",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Trumper Park Oval, located at the corner of Glenmore Road and Hampden Street, is named in honour of famed Australian test cricketer Victor Trumper.",
      "sourceSentenceIds": [
        23
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Paddington%2C_New_South_Wales",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Founded in 1964, the Paddington Society became a catalyst for preserving the suburb’s historic terrace houses and unique architectural character.",
      "sourceSentenceIds": [
        7
