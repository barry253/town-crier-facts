  "facts": [
    {
      "id": 1,
      "text": "Barberville hosts the Pioneer Settlement for Creative Arts, a living history village that recreates late‑19th‑early‑20th‑century Florida life.",
      "sourceSentenceIds": [
        3,
        18
      ],
      "sourceLabels": [
        "Web source 1",
        "Web source 2"
      ],
      "source": "https://www.barberville.net/barberville.htm",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The settlement’s 19 historic structures sit in a moss‑draped oak hammock, giving the village a truly authentic rural feel.",
      "sourceSentenceIds": [
        18
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.daytonabeach.com/listings/barberville-pioneer-settlement/919/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Every first weekend of November, Barberville stages the 38th Annual Fall Country Jamboree, a festival that brings back pioneer music and crafts.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.barberville.net/barberville.htm",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "During the Jamboree, more than 100 demonstrators, reenactors, and artisans perform on six stages while 150 Florida musicians play continuously.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.barberville.net/barberville.htm",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The settlement’s juried arts and crafts show showcases handmade work from over 80 vendors, highlighting local creativity.",
      "sourceSentenceIds": [
        13
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.barberville.net/barberville.htm",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Barberville’s historic high school, now part of the settlement, was once the community’s central educational hub and is still used for guided tours.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
