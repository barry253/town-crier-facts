  "facts": [
    {
      "id": 1,
      "text": "Mansfield was founded in 1808 on a fork of the Mohican River, becoming a manufacturing hub thanks to its many railroad lines.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Mansfield%2C_Ohio",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The city was named after Colonel Jared Mansfield, the U.S. Surveyor General who directed its planning.",
      "sourceSentenceIds": [
        3,
        10
      ],
      "sourceLabels": [
        "Web source 2",
        "Wikipedia"
      ],
      "source": "https://destinationmansfield.com/history/",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The downtown Mansfield Playhouse, opened in 1929, is Ohio's second‑oldest community theatre.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Mansfield%2C_Ohio",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The historic Renaissance Theatre, built in 1927, hosts the Miss Ohio Pageant and the Mansfield Symphony.",
      "sourceSentenceIds": [
        28
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Mansfield%2C_Ohio",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The Ohio State Reformatory in Mansfield, where The Shawshank Redemption was filmed, offers ghost hunts and tours.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://mansfieldohio.gov/visitors/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "After the Civil War, Mansfield grew into an industrial city producing buggies, steel, steam tractors, stoves, pumps and later major appliances.",
      "sourceSentenceIds": [
        19
