  "facts": [
    {
      "id": 1,
      "text": "Polvadera began as a farming settlement in the 1620s, when Spanish colonists under Juan de Oñate moved north and settled among the Piro Pueblo Indians.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Polvadera%2C_New_Mexico",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town’s name likely comes from a Piro word, but was changed to Polvadera because the Spanish word polvareda means dusty.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://alchetron.com/Polvadera%2C-New-Mexico",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Polvadera’s church, dedicated to San Lorenzo, celebrates its feast day on August 10, the town’s annual fiesta.",
      "sourceSentenceIds": [
        17
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Polvadera%2C_New_Mexico",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The Santa Fe Railroad reached Polvadera in 1882, and a post office opened the following year in 1895.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Polvadera%2C_New_Mexico",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Polvadera has faced repeated Rio Grande floods, with major deluges in 1898, 1929, and 1937.",
