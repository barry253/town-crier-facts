  "facts": [
    {
      "id": 1,
      "text": "Sheldon was established in 1906 by Wisconsin Central Railway employees who were constructing a new railroad line through the dense northern forests.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://villageofsheldonwi.gov/history/"
    },
    {
      "id": 2,
      "text": "Early pioneers relocated to Sheldon from a nearby settlement called Fern to establish logging operations in the vast virgin pine forests.",
      "sourceSentenceIds": [
        7,
        9
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://villageofsheldonwi.gov/history/"
    },
    {
      "id": 3,
      "text": "Small family farms primarily focused on dairy production became common in Sheldon during the 1910s and 1920s as the forests were cleared.",
      "sourceSentenceIds": [
        3,
        11
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://villageofsheldonwi.gov/history/"
    },
    {
      "id": 4,
      "text": "Residents of Sheldon survived the Great Depression by growing their own food and bartering goods like eggs for flour.",
      "sourceSentenceIds": [
        14,
        15
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://villageofsheldonwi.gov/history/"
    },
    {
      "id": 5,
      "text": "Amish families settled on the outskirts of Sheldon at the turn of the century, reviving underused land and boosting the local economy.",
      "sourceSentenceIds": [
        27,
