  "facts": [
    {
      "id": 1,
      "text": "McGee Creek is named after Alney “Allie” McGee, a pioneer from Tennessee who settled the area in the 1800s.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://scenic395.com/towns/mcgee-creek/how-mcgee-creek-got-its-name/",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The creek rises at McGee Lakes northeast of Red and White Mountain and flows out of the Sierra Nevada.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/McGee_Creek%2C_California",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "McGee Creek sits at the eastern base of the Sierra Nevada in southwestern Mono County.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/McGee_Creek%2C_California",
