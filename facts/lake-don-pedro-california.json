  "facts": [
    {
      "id": 1,
      "text": "Lake Don Pedro was named after Pierre \"Don Pedro\" Sainsevain, a French immigrant winemaker who ran a store and bar during the Gold Rush.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Lake_Don_Pedro%2C_California"
    },
    {
      "id": 2,
      "text": "The original Don Pedro Dam was finished in 1923, creating the first reservoir that later expanded with a new dam in 1971.",
      "sourceSentenceIds": [
        8,
        9
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Lake_Don_Pedro%2C_California"
    },
    {
      "id": 3,
      "text": "The new dam built in 1971 is located about 1.5 miles downstream from the original, doubling the lake’s size.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Lake_Don_Pedro%2C_California"
    },
    {
      "id": 4,
      "text": "The area around the lake sits in rolling oak‑studded foothills at elevations between 800 and 1,500 feet, typical of the western Sierra Nevada.",
      "sourceSentenceIds": [
        11
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Lake_Don_Pedro%2C_California"
    },
    {
      "id": 5,
      "text": "Lake Don Pedro’s climate is hot‑summer Mediterranean, with July and August highs often over 90°F.",
      "sourceSentenceIds": [
        14,
        15
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Lake_Don_Pedro%2C_California"
    },
    {
      "id": 6,
      "text": "The lake supports a range of water sports, including boating, fishing, swimming, waterskiing, windsurfing, sailing, and houseboating.",
