  "facts": [
    {
      "id": 1,
      "text": "Pathum Wan, literally 'lotus forest' from Pali paduma plus vana, was named after a royal villa erected there.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Pathum_Wan_district",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Next to the palace, a royal villa and the temple Wat Pathumwanaram were constructed, anchoring the district's early royal heritage.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Pathum_Wan_district",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "During King Mongkut's reign, royal paddy fields between Khlong Phadung Krung Kasem and Ban Khrua were transformed into lotus‑laden ponds for leisure.",
      "sourceSentenceIds": [
        24,
        26
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Pathum_Wan_district",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "When the BTS Skytrain launched in 1999, Siam station became Pathum Wan's central interchange, solidifying its status as Bangkok's modern heart.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Pathum_Wan_district",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Hua Lamphong, Bangkok's main railway station built in 1916, occupies Pathum Wan's southwestern corner and once served as the city's main terminus.",
      "sourceSentenceIds": [
        11,
        13
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Pathum_Wan_district",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The Jim Thompson House Museum in Pathum Wan preserves Thai silk history and was once the home of the American entrepreneur who revived the industry.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.cleverthai.com/guide-to-pathum-wan-bangkok/",
      "category": "landmark",
      "quality": "good"
    }
