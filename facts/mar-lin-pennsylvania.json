      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Mar Lin grew during the late 19th and early 20th centuries as European immigrants—Poles, Lithuanians, Slovaks, Ukrainians, and others—moved to work in Schuylkill County’s anthracite mines.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/marlin_pennsylvania",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Situated near Pottsville, the county seat, Mar Lin lies in the historic anthracite coal region of eastern Pennsylvania.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Web source 2"
      ],
