    {
      "id": 1,
      "text": "Eufaula is the county seat of McIntosh County and sits within the jurisdiction of the federally recognized Muscogee Nation.",
      "sourceSentenceIds": [
        17,
        20
      ],
      "sourceLabels": [
        "Wikipedia"
