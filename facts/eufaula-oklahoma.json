    },
    {
      "id": 2,
      "text": "The name Eufaula comes from the Muscogee Creek people, specifically after an earlier tribal town located in Alabama.",
      "sourceSentenceIds": [
        19,
        29
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Eufaula%2C_Oklahoma"
    },
    {
      "id": 3,
      "text": "Creek leaders persuaded the Missouri-Kansas-Texas Railway to establish a station here in 1872, attracting many European American settlers.",
      "sourceSentenceIds": [
        3,
        14
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Eufaula%2C_Oklahoma"
    },
    {
      "id": 4,
      "text": "Eufaula served as an early center for the Creek people, who frequently held pow-wows and Indian conferences in the area.",
      "sourceSentenceIds": [
        27,
        28
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Eufaula%2C_Oklahoma"
    },
    {
      "id": 5,
      "text": "The twenty-block downtown area of Eufaula is listed on the National Register of Historic Places.",
