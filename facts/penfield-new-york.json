  "facts": [
    {
      "id": 1,
      "text": "Penfield was incorporated in 1810 by Revolutionary War veteran Daniel Penfield, who had begun buying land there in 1795.",
      "sourceSentenceIds": [
        18,
        25
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Penfield%2C_New_York",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town’s early economy thrived on mills powered by Irondequoit Creek, which drops 90 feet through the area.",
      "sourceSentenceIds": [
        20,
        9
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Penfield%2C_New_York",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The original Penfield town hall, built in 1895, was declared a town landmark in 1981.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Penfield%2C_New_York",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Penfield’s historic Four Corners district remains a focal point for preservation, with parks like Philbrick and Harris Whalen honoring early settlement hubs.",
      "sourceSentenceIds": [
        11
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/Penfield,_New_York",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "In the late 20th century, Penfield’s growth slowed after a mid‑century boom, yet the town retained much of its rural character through controlled zoning.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/Penfield,_New_York",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The town’s library, once housed in the town hall’s basement, now occupies the Baird Road Community Center.",
      "sourceSentenceIds": [
