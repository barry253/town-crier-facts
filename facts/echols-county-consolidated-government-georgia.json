  "facts": [
    {
      "id": 1,
      "text": "Echols County was carved from Clinch and Lowndes counties in 1858 and named after Robert M. Echols.",
      "sourceSentenceIds": [
        1,
        8
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.georgiaencyclopedia.org/articles/counties-cities-neighborhoods/echols-county/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The Langdale Forest Products Company, founded in 1894 by John Wesley Langdale, became the county’s economic backbone.",
      "sourceSentenceIds": [
        2,
        9
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.georgiaencyclopedia.org/articles/counties-cities-neighborhoods/echols-county/",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "In 1910 the Statenville Railway linked Statenville to Haylow, but the line shut down in 1924.",
      "sourceSentenceIds": [
        15
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.georgiaencyclopedia.org/articles/counties-cities-neighborhoods/echols-county/",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Agriculture and forestry have sustained Echols County’s rural economy since its founding.",
      "sourceSentenceIds": [
        14,
        17
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.georgiaencyclopedia.org/articles/counties-cities-neighborhoods/echols-county/",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Echols County operates as a consolidated city‑county, merging city and county governments into one jurisdiction.",
      "sourceSentenceIds": [
        24
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Consolidated_city-county",
