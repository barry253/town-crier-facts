  "facts": [
    {
      "id": 1,
      "text": "Pacifica was officially incorporated in 1957, merging nine small coastal communities into one city.",
      "sourceSentenceIds": [
        7,
        8
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Pacifica%2C_California",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The city’s roots trace back to the 1769 Portolà expedition, which first sighted San Francisco Bay from Sweeney Ridge.",
      "sourceSentenceIds": [
        30
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Pacifica%2C_California",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "During World War II, the area now known as Sharp Park housed a detention station that processed Japanese Americans and other foreign nationals.",
      "sourceSentenceIds": [
        23
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Pacifica%2C_California",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The Pacifica Historical Society runs the Coastside Museum, where visitors can see a working model of the short‑lived Ocean Shore Railroad.",
      "sourceSentenceIds": [
        2,
        15
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://pacificahistory.org/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Pacifica’s cultural scene thrives around the Pacifica Arts Center, which partners with the Historical Society to promote local arts and heritage.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://discoverpacifica.com/history",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The city’s name, meaning “peaceful” in Spanish, reflects its calm coastal setting between San Francisco and Half Moon Bay.",
      "sourceSentenceIds": [
        27
