  "facts": [
    {
      "id": 1,
      "text": "Ansted was named after David Thomas Ansted, an English geologist who recognized the area's wealth of hardwood timber and coal.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.townofansted.com/"
    },
    {
      "id": 2,
      "text": "Before being known as Ansted, this area was called Mountain Cove and was also known as Woodville, New Haven, and Westlake.",
      "sourceSentenceIds": [
        27,
        28
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Ansted%2C_West_Virginia"
    },
    {
      "id": 3,
      "text": "Ansted was originally settled by a group of Baptists around 1790 who did not hold legal title to the land.",
      "sourceSentenceIds": [
        25
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Ansted%2C_West_Virginia"
    },
    {
      "id": 4,
      "text": "During the winter of 1861 to 1862, the Union Army's Chicago Gray Dragoons established their headquarters in Ansted.",
      "sourceSentenceIds": [
        30
      ],
      "sourceLabels": [
