      "quality": "good"
    },
    {
      "id": 2,
      "text": "Concrete observation towers from Navy Operation Bumblebee still dot Surf City's shoreline, relics of early rocket testing.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 1"
      ],
