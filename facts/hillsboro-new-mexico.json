  "facts": [
    {
      "id": 1,
      "text": "Hillsboro sprang to life in April 1877 after two prospectors uncovered gold deposits along Percha Creek on the Black Range.",
      "sourceSentenceIds": [
        1,
        4
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 2"
      ],
      "source": "https://en.wikipedia.org/wiki/Hillsboro%2C_New_Mexico",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town was named Hillsborough by prospectors in December 1877, but later shortened to Hillsboro.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Hillsboro%2C_New_Mexico",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The community was the county seat of Sierra County from 1884 until 1936, when Hot Springs (now called Truth or Consequences) became the county seat.",
      "sourceSentenceIds": [
        11
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Hillsboro%2C_New_Mexico",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Hillsboro’s walkable ‘downtown’ invites visitors to soak up the adobe ambiance of the historic homes, churches and the Black Range Museum.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.newmexico.org/places-to-visit/ghost-towns/hillsboro/",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The community hosts the popular Apple Festival, Christmas in the Foothills, and monthly music events.",
