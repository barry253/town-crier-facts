  "facts": [
    {
      "id": 1,
      "text": "Choccolocco’s name comes from Creek words meaning “big shoals” or “big house,” reflecting the river’s prominent features.",
      "sourceSentenceIds": [
        15
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Choccolocco%2C_Alabama",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Archaeologists find evidence of human activity in the Choccolocco Valley dating back nearly 12,000 years, from Paleoindian to Mississippian cultures.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/choccolocco_alabama",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The 1832 Treaty of Cusseta divided Creek lands, sparking the 1836 Creek War and the Trail of Tears that forced over 23,000 Creeks westward.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/choccolocco_alabama",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "After the Creek removal, white settlers transformed the fertile valley into thriving cotton farms during the antebellum era.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/choccolocco_alabama",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "During the Civil War, local iron furnaces supplied the Confederacy, shipping high‑quality iron to Selma before modernizing post‑war.",
      "sourceSentenceIds": [
        27
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/choccolocco_alabama",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "In 2001, The Daily Show highlighted a local legend called the Choccolocco Monster, later revealed to be prankster Neal Williamson.",
