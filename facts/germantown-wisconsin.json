  "facts": [
    {
      "id": 1,
      "text": "Germantown was named after German immigrants from Bavaria, Hessen, Rheinland, Pommern, and Prussia who settled there in the 1840s.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Germantown%2C_Wisconsin",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The village’s historic center, Dheinsville, grew around Christ Evangelical Church founded by Philip Dhein in 1842 and housed Wisconsin’s first mutual insurance company.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://emke.uwm.edu/entry/germantown/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Germantown’s rural landscape once featured small cheese manufactories, wheat farms, and potato fields that defined its early economy.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://emke.uwm.edu/entry/germantown/",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Dairy farming and cheese production have long been the backbone of Germantown’s agricultural output, a tradition still celebrated today.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://emke.uwm.edu/entry/germantown/",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The Town of Germantown, established January 21, 1846, was the first settlement in Washington County and the original “Town Nine” of the Wisconsin Territory.",
      "sourceSentenceIds": [
        5,
        30
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Germantown%2C_Wisconsin",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The Potawatomi ceded the land that became Germantown to the U.S. in the 1833 Treaty of Chicago, prompting their forced removal by 1838.",
      "sourceSentenceIds": [
        27
