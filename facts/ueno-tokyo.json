  "facts": [
    {
      "id": 1,
      "text": "Ueno Station was historically the terminus for long‑distance trains to northern Japan, including the Blue trains and the Shinkansen.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Ueno",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Ueno Park, right next to the station, houses Japan’s oldest zoo, a large boating pond, and a shrine with a five‑story pagoda.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.gotokyo.org/en/destinations/northern-tokyo/ueno/index.html",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The park’s East Garden features Gorilla Woods, Tiger Forest, Elephant Forest, and a historic five‑storied pagoda with a ceremonial teahouse called Kankan‑tei.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.gotokyo.org/en/destinations/northern-tokyo/ueno/index.html",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Ameyoko, a bustling market street just a short walk from Ueno Station, is famous for vendor calls and a wide range of goods from clothes to fresh fish.",
      "sourceSentenceIds": [
        13,
        14
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.gotokyo.org/en/destinations/northern-tokyo/ueno/index.html",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Ueno Park contains several major museums, including the Tokyo National Museum, the National Museum of Western Art, and the National Museum of Nature and Science.",
      "sourceSentenceIds": [
        20
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Ueno",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The Kan'ei‑ji temple, once a major Tokugawa shōgun temple, now sits within Ueno Zoo’s grounds and was a focal point during the 1868 Battle of Ueno.",
      "sourceSentenceIds": [
        21,
        23
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Ueno",
      "category": "landmark",
      "quality": "good"
    }
  ],
