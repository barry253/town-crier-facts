  "facts": [
    {
      "id": 1,
      "text": "Southold was founded in 1640 by Puritans from the New Haven Colony, making it the oldest English town in New York State.",
      "sourceSentenceIds": [
        9,
        13,
        20
      ],
      "sourceLabels": [
        "Web source 1",
        "Web source 1",
        "Web source 1"
      ],
      "source": "https://www.southoldtownny.gov/159/History-of-Southold",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town celebrated its 350th birthday in 1990 and planned to light 375 candles on its cake in 2015.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.southoldtownny.gov/159/History-of-Southold",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Southold Historical Museum, originally founded in 1960, changed its name in 2021 to reflect its broader mission of preserving regional history.",
      "sourceSentenceIds": [
        1,
        26
      ],
      "sourceLabels": [
        "Web source 2",
        "Web source 2"
      ],
      "source": "https://www.southoldhistorical.org/",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The museum hosts year‑round events, from educational lectures to family fun and craft fairs, keeping Southold’s heritage alive.",
      "sourceSentenceIds": [
        21,
        22
      ],
      "sourceLabels": [
        "Web source 2",
        "Web source 2"
      ],
      "source": "https://www.southoldhistorical.org/",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "New York State Route 25, known locally as Main Road, runs east‑west through Southold and even has two truck routes.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
