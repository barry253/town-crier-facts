    },
    {
      "id": 2,
      "text": "Dubbed the “Immigrant City,” Lawrence has welcomed waves of workers from Ireland, Lithuania, and later the Dominican Republic.",
      "sourceSentenceIds": [
        4,
        18
      ],
      "sourceLabels": [
        "Wikipedia",
        "Wikipedia"
      ],
