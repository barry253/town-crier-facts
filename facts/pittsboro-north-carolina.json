  "facts": [
    {
      "id": 1,
      "text": "Pittsboro was founded in 1785 as the county seat of newly formed Chatham County.",
      "sourceSentenceIds": [
        12,
        15
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Pittsboro%2C_North_Carolina",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town’s name honors William Pitt the Younger, son of the Earl of Chatham, after whom the county is named.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Pittsboro%2C_North_Carolina",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "In 1881 a new courthouse and jail were built, and the historic traffic circle around the courthouse still marks the town center.",
      "sourceSentenceIds": [
        23,
        5
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Pittsboro%2C_North_Carolina",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Route 64 Business runs through Pittsboro as West and East Streets, intersecting US 15/501 at the courthouse traffic circle.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Pittsboro%2C_North_Carolina",
      "category": "transport",
      "quality": "poor",
      "qualityReason": "route_only"
    },
    {
      "id": 5,
      "text": "Pittsboro’s downtown features a family‑owned bakery that began as a bakeshop run by Willmeta “Willy” Miriam Sprague Jacomet’s descendants, now staffed by people with autism or former military.",
      "sourceSentenceIds": [
        3
      ],
