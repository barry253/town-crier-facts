  "facts": [
    {
      "id": 1,
      "text": "Mass City was founded in 1848 by Noel Johnson, an escaped slave from Missouri who discovered copper deposits.",
      "sourceSentenceIds": [
        10,
        22,
        23,
        24
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Mass_City%2C_Michigan"
    },
    {
      "id": 2,
      "text": "The village’s name comes from the “mass” of copper found there, inspiring the Mass Mining Company formed in 1855.",
      "sourceSentenceIds": [
        2,
        25
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Mass_City%2C_Michigan"
    },
    {
      "id": 3,
      "text": "In 1899 Abram and Nellie Mathews platted a new village a mile and a half east of the original site, which was abandoned that same year.",
      "sourceSentenceIds": [
        4,
        5
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Mass_City%2C_Michigan"
    },
    {
      "id": 4,
      "text": "Mass City sits within Greenland Township in the foothills of the Porcupine Mountains, surrounded by dense forests and wildlife.",
      "sourceSentenceIds": [
        13
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Mass_City%2C_Michigan"
    },
    {
      "id": 5,
      "text": "A post office opened on June 15, 1899, with Anderson as its first postmaster, marking the town’s formal recognition.",
      "sourceSentenceIds": [
        11,
        12
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Mass_City%2C_Michigan"
    },
    {
      "id": 6,
      "text": "Today, Mass City serves as a gateway to outdoor adventures, from snowmobiling in winter to hiking trails that reveal Porcupine Mountain vistas.",
