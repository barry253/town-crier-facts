  "facts": [
    {
      "id": 1,
      "text": "Quispamsis means \"little lake in the woods\" in Wolastoqey, likely referring to present‑day Ritchie Lake.",
      "sourceSentenceIds": [
        13
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Quispamsis",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The Gondola Point Ferry, the world’s first underwater cable ferry, links Quispamsis with the Kingston Peninsula and was installed by William Pitt.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Quispamsis",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The Kennebecasis River has shaped Quispamsis, driving historical lumber transport and today offering popular recreational activities.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.quispamsis.ca/home-streets-and-utilities/living-in-quispamsis/history-of-quispamsis/",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Quispamsis was originally inhabited by the Maliseet First Nation, members of the Wabanaki Confederacy.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.quispamsis.ca/home-streets-and-utilities/living-in-quispamsis/history-of-quispamsis/",
      "category": "people",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "In 1689, during the French colonial era, a seigniory was granted to Pierre Chesnet sieur de Breuil.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.quispamsis.ca/home-streets-and-utilities/living-in-quispamsis/history-of-quispamsis/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Quispamsis was granted town status in December 1982, then the largest village in New Brunswick.",
