  "facts": [
    {
      "id": 1,
      "text": "Lovingston was founded in 1807 and became Nelson County’s seat two years later when the courthouse was built.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Lovingston%2C_Virginia",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town’s grid centers on a courthouse that still dominates the square, a design by Shelton Crosthwait blending colonial and Jeffersonian styles.",
      "sourceSentenceIds": [
        13,
        21,
        22
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Lovingston%2C_Virginia",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Lovingston’s Historic District contains 134 contributing buildings spread over 225 acres, listed on the National Register since 2005.",
      "sourceSentenceIds": [
        3,
        11
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Lovingston%2C_Virginia",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Bright Hope Baptist Church stands as Lovingston’s most historic African‑American landmark, reflecting the town’s diverse heritage.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Lovingston%2C_Virginia",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "During the 1969 Hurricane Camille, Lovingston served as the hub for rescue and recovery, coordinating efforts across the county.",
      "sourceSentenceIds": [
        27
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Lovingston%2C_Virginia",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The town’s original 30‑acre parcel was donated by the influential Loving family, giving the town its name and early growth.",
