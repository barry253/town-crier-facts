  "facts": [
    {
      "id": 1,
      "text": "Thornton began as Yellow House, named after a 1750 inn on Glen Mills Road that served travelers between Philadelphia and the south.",
      "sourceSentenceIds": [
        1,
        2,
        4,
        16
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/thornton_pennsylvania",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The Yellow House became a field hospital for Continental soldiers after the 1777 Battle of Brandywine, per local markers.",
      "sourceSentenceIds": [
        13
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/thornton_pennsylvania",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "In 1829, the inn housed one of the nation's oldest continuously operating post offices, with John King as first postmaster.",
      "sourceSentenceIds": [
        19,
        29
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/thornton_pennsylvania",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The Thornton Village Historic District, with buildings from 1750‑1855, was added to the National Register of Historic Places in 2006.",
      "sourceSentenceIds": [
        9,
        18
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/thornton_pennsylvania",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Thornton sits about 20 miles west of Philadelphia, blending preserved history with modern residential development along Chester Creek.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/thornton_pennsylvania",
      "category": "other",
      "quality": "poor",
      "qualityReason": "location_description"
    },
    {
      "id": 6,
      "text": "The community spans Thornbury, Concord, and Middletown Townships, and its postal address hosts Hill Correctional Facility.",
      "sourceSentenceIds": [
        14,
