  "facts": [
    {
      "id": 1,
      "text": "Somersworth was originally called \"Summersworth\" meaning \"summer town\" because ministers preached there in summer.",
      "sourceSentenceIds": [
        18
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Somersworth%2C_New_Hampshire",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "A clerical error at incorporation turned \"Summersworth\" into \"Somersworth\".",
      "sourceSentenceIds": [
        20
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Somersworth%2C_New_Hampshire",
      "category": "other",
      "quality": "poor",
      "qualityReason": "other"
    },
    {
      "id": 3,
      "text": "The Salmon Falls River drops 100 feet, powering gristmills and sawmills that made Somersworth a mill town.",
      "sourceSentenceIds": [
        22
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Somersworth%2C_New_Hampshire",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "In 1822, Isaac and Jacob Wendell bought a gristmill at the Great Falls and founded the Great Falls Manufacturing Company, a textile mill that grew to three buildings.",
      "sourceSentenceIds": [
        23,
        24
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Somersworth%2C_New_Hampshire",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The Boston and Maine Railroad arrived in 1843, sparking shoe manufacturing and other industries in Somersworth.",
      "sourceSentenceIds": [
        11
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.britannica.com/place/Somersworth",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Somersworth was incorporated as a city in 1893, after previously being known as \"Great Falls\".",
