  "facts": [
    {
      "id": 1,
      "text": "Douglas was originally known as Parches Cove but became known as Union Grove after federal troops camped there during the Civil War.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://encyclopediaofalabama.org/article/douglas/"
    },
    {
      "id": 2,
      "text": "First settled in the mid-nineteenth century, Douglas was primarily a farming community for most of its history.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://encyclopediaofalabama.org/article/douglas/"
    },
    {
      "id": 3,
      "text": "Its first school was built in 1898, and the Douglas Academy was built in 1909.",
      "sourceSentenceIds": [
        25
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://encyclopediaofalabama.org/article/douglas/"
    },
    {
      "id": 4,
      "text": "Its first water system was built in 1966, and the town incorporated in 1978.",
      "sourceSentenceIds": [
        27
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://encyclopediaofalabama.org/article/douglas/"
    },
    {
      "id": 5,
      "text": "Every March, Douglas hosts a Community Festival that brings residents together for music, food, and local crafts.",
      "sourceSentenceIds": [
        29
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://encyclopediaofalabama.org/article/douglas/"
    },
    {
      "id": 6,
      "text": "Douglas sits 940 feet above sea level on the southwest end of Sand Mountain, near the Locust Fork of the Black Warrior River.",
      "sourceSentenceIds": [
