  "facts": [
    {
      "id": 1,
      "text": "Founded in 1915 as a neighborhood team, the Staten Island Stapletons joined the NFL from 1929 to 1932.",
      "sourceSentenceIds": [
        1,
        4
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Staten_Island_Stapletons",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Jack Shapiro, the team’s blocking back, was the shortest player in NFL history, weighing just 119–126 pounds and standing barely over five feet tall.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Staten_Island_Stapletons",
      "category": "people",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "In 1928 the Stapes posted a 10–1–1 record, the best season in their history, yet they never achieved a winning season in the NFL.",
      "sourceSentenceIds": [
        11,
        15
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Staten_Island_Stapletons",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The neighborhood’s Tappen Park gives Stapleton a town‑square feel and hosts a mix of American diners, a gastropub, and Sri Lankan, Mexican, and Italian eateries.",
      "sourceSentenceIds": [
        22
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://experience.downtownsi.nyc/collections/stapleton",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Stapleton sits only a mile from the Staten Island Ferry and is just around the corner from the Stapleton train station, making it a quick hop to Manhattan.",
      "sourceSentenceIds": [
        25
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://experience.downtownsi.nyc/collections/stapleton",
      "category": "other",
      "quality": "poor",
      "qualityReason": "location_description"
    },
    {
