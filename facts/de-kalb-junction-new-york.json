  "facts": [
    {
      "id": 1,
      "text": "De Kalb Junction takes its name from American general Baron de Kalb, a German officer who served under George Washington.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.townofdekalb.com/"
    },
    {
      "id": 2,
      "text": "The Town of De Kalb Historical Association occupies a former church that became a museum in 1974.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://museumsdatabase.com/museums/view/21733"
    },
    {
      "id": 3,
      "text": "Beyond its museum, the association hosts lectures, tours, and community festivals while maintaining a library of regional history.",
      "sourceSentenceIds": [
        2,
        6
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://museumsdatabase.com/museums/view/21733"
    },
    {
      "id": 4,
      "text": "The first settlers arrived in June 1803, led by Judge William Cooper from Cooperstown.",
      "sourceSentenceIds": [
        19
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.townofdekalb.com/"
    },
    {
      "id": 5,
      "text": "De Kalb Junction was officially organized as a town in 1806, one of Lawrence County’s original ten towns.",
      "sourceSentenceIds": [
        20
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.townofdekalb.com/"
    },
    {
      "id": 6,
      "text": "New York State Route 11 cuts through De Kalb Junction, linking it to the broader region.",
      "sourceSentenceIds": [
        16
