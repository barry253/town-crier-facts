  "facts": [
    {
      "id": 1,
      "text": "Westport Country Playhouse, originally Kemper's Tannery, has hosted productions of novels, plays, and movies, drawing actors, writers, and artists to the town.",
      "sourceSentenceIds": [
        1,
        3
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.westportct.gov/about",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "In 1648, five original \"Bankside Farmers\" settled Green's Farms, laying the foundation for Westport's rural roots before it evolved into a cultural hub.",
      "sourceSentenceIds": [
        24
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.westportct.gov/about",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The town's early economy centered on onion farming and coastal shipping, shaping its development before the arrival of the railroad.",
      "sourceSentenceIds": [
        15
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.westportct.gov/about",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Archaeological evidence shows indigenous habitation in the Westport area dating back over 10,000 years, long before European settlement.",
      "sourceSentenceIds": [
        11
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.westportct.gov/about",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The original land purchased for Westport was called Uncoway, named after the Uncawa tribe, and included what is now most of Westport.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 2"
      ],
