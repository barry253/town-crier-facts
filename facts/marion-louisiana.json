      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Founded in 1832, Marion is one of Union Parish’s oldest towns, reflecting early settlement patterns along the Ouachita River.",
      "sourceSentenceIds": [
        22
      ],
      "sourceLabels": [
        "Web source 1"
      ],
