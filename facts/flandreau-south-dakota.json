  "facts": [
    {
      "id": 1,
      "text": "Flandreau was first settled in 1857 and named after Charles Eugene Flandrau, a judge who helped protect settlers during the Sioux conflicts.",
      "sourceSentenceIds": [
        1,
        5,
        9
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Flandreau%2C_South_Dakota",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town sits on the Big Sioux River, a key waterway that shaped early settlement patterns in eastern South Dakota.",
      "sourceSentenceIds": [
        23
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Flandreau%2C_South_Dakota",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "In January 1880, the Milwaukee Railroad’s Southern Minnesota line ran its first train into Flandreau, linking the town to the wider region.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://southdakota.com/cities/flandreau-sd/",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The Moody County Museum in Flandreau focuses on the local prairie past, offering hands‑on exhibits that bring South Dakota history to life.",
      "sourceSentenceIds": [
        13,
        16,
        17,
        18,
        20
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.wonderfulmuseums.com/museum/moody-county-museum/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "A dedicated military history wing honors Moody County’s servicemen and women with artifacts and stories from various conflicts.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.wonderfulmuseums.com/museum/moody-county-museum/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The original school in Flandreau, known as the Riggs Institute, opened in 1892 after federal authorization and became a community cornerstone.",
