  "facts": [
    {
      "id": 1,
      "text": "Sunnybrook Colony was founded in 2012 as a daughter colony divided from the Riverview Hutterite Colony near Chester, Montana.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/sunnybrook_colony_montana"
    },
    {
      "id": 2,
      "text": "Sunnybrook Colony experiences a semi-arid continental climate, BSk, with cold snowy winters and warm dry summers typical of northern Montana.",
      "sourceSentenceIds": [
        11
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/sunnybrook_colony_montana"
    },
    {
      "id": 3,
      "text": "Since 2000, Sunnybrook Colony has turned 957 acres of dryland into irrigated fields using water from the Marias River.",
      "sourceSentenceIds": [
        21
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/sunnybrook_colony_montana"
    },
    {
      "id": 4,
      "text": "Sunnybrook Colony participates in Montana’s Block Management Program, opening 15,462 acres for public hunting while protecting local habitats.",
      "sourceSentenceIds": [
        14
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/sunnybrook_colony_montana"
    },
    {
      "id": 5,
      "text": "Ben Wipf has led Sunnybrook Colony as minister since 2018, while Abraham Waldner has managed the community since 2022.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/sunnybrook_colony_montana"
    },
    {
      "id": 6,
      "text": "Sunnybrook Colony sits at 48°09′29″N latitude and 110°43′54″W longitude, right in northern Chouteau County.",
