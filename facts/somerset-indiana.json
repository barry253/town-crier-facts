  "facts": [
    {
      "id": 1,
      "text": "Somerset was originally platted as Springfield in 1843, renamed Somerset around 1846–1847, and grew around a key Mississinewa River crossing with mills and churches.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/somerset_indiana",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town was relocated one mile east in the early 1960s to avoid submersion by the Mississinewa Reservoir, leaving the original \"Old Somerset\" underwater.",
      "sourceSentenceIds": [
        16,
        17,
        15
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/somerset_indiana",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The Mississinewa Dam, completed in 1967, created the reservoir that now borders Somerset and provides flood control and recreation.",
      "sourceSentenceIds": [
        30,
        4
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/somerset_indiana",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Somerset hosts two parks with playgrounds, picnic areas, sports courts, and a community building that hosts local events and gatherings.",
      "sourceSentenceIds": [
        19
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/somerset_indiana",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The Somerset Lions Club, chartered in 1950, and the Izaak Walton League chapter, formed in 1951, are long‑standing local organizations focused on service and conservation.",
      "sourceSentenceIds": [
        19
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/somerset_indiana",
      "category": "people",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The community sits at about 787 feet above sea level on gently rolling terrain shaped by glacial deposits, typical of the Wabash River valley.",
      "sourceSentenceIds": [
        23,
        22
      ],
      "sourceLabels": [
        "Web source 1"
      ],
