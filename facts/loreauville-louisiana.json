  "facts": [
    {
      "id": 1,
      "text": "Loreauville was founded in the early 19th century and originally called Picouville after the Picou family.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.villageofloreauville.com/your-village",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "In 1871 the village renamed Loreauville to honor Ozaire Loreau, who donated land for the Catholic church and cemetery.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.villageofloreauville.com/your-village",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "French was widely spoken in Loreauville for much of its history, and today Cajun culture still shapes local festivals, music, and community life.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.villageofloreauville.com/your-village",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The Heritage Village museum on Main Street once showcased Acadian and Cajun history with period clothing, housewares, and 19th‑century relics.",
      "sourceSentenceIds": [
        9,
        11
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Loreauville%2C_Louisiana",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Clifton Chenier, a celebrated zydeco musician, was born in Opelousas but is buried in All Souls Cemetery in Loreauville.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Loreauville%2C_Louisiana",
      "category": "people",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Loreauville sits on the east side of Bayou Teche in northern Iberia Parish, offering a glimpse into Cajun country’s historic lifestyle.",
