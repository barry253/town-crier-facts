  "facts": [
    {
      "id": 1,
      "text": "Springfield Township borders Lake Erie to the north, Girard Township east, Conneaut Township south, and the city of Conneaut, Ohio, west.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Springfield_Township%2C_Erie_County%2C_Pennsylvania",
      "category": "other",
      "quality": "poor",
      "qualityReason": "location_description"
    },
    {
      "id": 2,
      "text": "The township’s early growth tied to New York’s Erie Canal, sparking commerce in the early 19th century.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Springfield_Township%2C_Erie_County%2C_Pennsylvania",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "William Blakely Holliday, who bought land from Native Americans in 1806, helped shape the township’s boundaries and development.",
      "sourceSentenceIds": [
        9,
        10,
        11
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Springfield_Township%2C_Erie_County%2C_Pennsylvania",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The Holliday family still resides in North Springfield today, linking present residents to the township’s founding lineage.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Springfield_Township%2C_Erie_County%2C_Pennsylvania",
      "category": "people",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "West Springfield appears in both the FIPS‑55 and GNIS geographic databases, confirming its official recognition.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Springfield_Township%2C_Erie_County%2C_Pennsylvania",
      "category": "other",
      "quality": "poor",
      "qualityReason": "other"
    },
    {
      "id": 6,
      "text": "West Springfield shares its name with five other U.S. communities, including ones in Massachusetts, New Hampshire, Ohio, Vermont, and Virginia.",
