  "facts": [
    {
      "id": 1,
      "text": "Mammoth earned its name from the Mammoth Mine it served in the 19th century.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.mtmemory.org/nodes/view/128677",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Mammoth sits in the valley of the South Boulder River within the northern Tobacco Root Mountains.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Mammoth%2C_Montana",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Perched at 6,319 feet, Mammoth exploded into a boomtown of over 1,000 residents after silver strikes in 1877.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://unitedstatesghosttowns.com/mammoth-montana-ghost-town/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The Mammoth Mining Company built 18,000 feet of tunnels and a 20‑stamp mill before the 1893 silver crash emptied the town.",
      "sourceSentenceIds": [
        13
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://unitedstatesghosttowns.com/mammoth-montana-ghost-town/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Today, weathered ruins and abandoned mine structures stand as a preserved testament to Montana’s mining heritage.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://unitedstatesghosttowns.com/mammoth-montana-ghost-town/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Railroad connections once hauled valuable silver, copper, and gold ore from Mammoth to distant markets.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://unitedstatesghosttowns.com/mammoth-montana-ghost-town/",
      "category": "transport",
      "quality": "good"
    }
