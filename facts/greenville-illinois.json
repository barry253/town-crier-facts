  "facts": [
    {
      "id": 1,
      "text": "Greenville was founded in 1815 by George Davidson, who bought 160 acres overlooking Little Shoal Creek in the Illinois Territory.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Greenville%2C_Illinois",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Some say Greenville was named after Greenville, North Carolina, honoring Revolutionary War general Nathanael Greene, while others claim the name came from the town’s green scenery.",
      "sourceSentenceIds": [
        4,
        5
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Greenville%2C_Illinois",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Greenville University began as Almira College, a women’s college, in 1855 before evolving into a co‑educational university.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Greenville%2C_Illinois",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The Greenville Public Library, a Carnegie‑era building, sits on the National Register of Historic Places and has served the community since 1912.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Greenville%2C_Illinois",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "DeMoulin Brothers, founded in 1892, remains the world’s oldest and largest manufacturer of band uniforms, a proud Greenville industry.",
