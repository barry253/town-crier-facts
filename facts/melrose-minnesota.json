  "facts": [
    {
      "id": 1,
      "text": "Founded in 1857 by Moses Adley and Robert Wheeler, Melrose was named after the Scottish town of Melrose because of the settlers' heritage.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/melrose_minnesota",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The Melrose Area Historical Society, formed in 1987, preserves artifacts and runs a museum that showcases pioneer life.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.melrosemnhistory.com/",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "In 1872 the Paul and Pacific Railroad turned scattered cabins into a structured village, making Melrose a regional grain hub.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/melrose_minnesota",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The 1860s and 1870s saw Catholic immigrants arrive, largely thanks to Father Francis Xavier Pierz who recruited German and Austrian settlers.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/melrose_minnesota",
      "category": "people",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "August Lindbergh, grandfather of famed aviator Charles Lindbergh, once lived in Melrose, linking the town to aviation history.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/melrose_minnesota",
      "category": "people",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Early settlers built a dam and mill on local water power, establishing Melrose’s first industrial infrastructure.",
