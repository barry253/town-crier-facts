  "facts": [
    {
      "id": 1,
      "text": "Granger was founded in 1902 and named after Walter Granger, superintendent of the Washington Irrigation Company who also laid out Zillah and Sunnyside.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Granger%2C_Washington",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town incorporated on September 28, 1909, and grew rapidly with mills, railroads, and blacksmith shops that laid the foundation for a vibrant economy.",
      "sourceSentenceIds": [
        20,
        10
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 2"
      ],
      "source": "https://en.wikipedia.org/wiki/Granger%2C_Washington",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "In 1979, the Latin radio station Radio KDNA was built in Granger, becoming an activist hub that educated farm workers and offered Spanish programs.",
      "sourceSentenceIds": [
        13,
        14
      ],
      "sourceLabels": [
        "Wikipedia",
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Granger%2C_Washington",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Granger’s first post office operated out of a corner shop that later became the city’s first market and service station, a legacy of George Anast’s family business.",
      "sourceSentenceIds": [
        17,
        16
      ],
      "sourceLabels": [
        "Web source 1",
        "Web source 2"
      ],
      "source": "https://www.grangerchamber.net/history-of-granger/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The Granger Farm Workers Camp opened in 1941 north of town, housing Dust Bowl refugees and later Mexican American workers during World War II.",
