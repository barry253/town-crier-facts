  "facts": [
    {
      "id": 1,
      "text": "Valley Stream was named by the Pagan family in 1853, and their historic house now sits on the National Register of Historic Places.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.gothamcenter.org/long-island-archives-3/valley-stream-historical-society",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The first Methodist congregation in Valley Stream began when a minister stopped at the Pagan home.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Valley_Stream%2C_New_York",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "When the South Side Railroad started stopping in Valley Stream in 1869, the new line and Merrick Road together sparked rapid community growth.",
      "sourceSentenceIds": [
        7,
        8
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Valley_Stream%2C_New_York",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The Valley Stream Historical Society, founded in 1973, preserves local history and operates a restoration museum open to the public for exhibits and tours.",
      "sourceSentenceIds": [
        1,
        9
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.gothamcenter.org/long-island-archives-3/valley-stream-historical-society",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The Valley Stream LIRR station, located in the village center, offers quick access to Manhattan while keeping a quieter suburban feel.",
      "sourceSentenceIds": [
        19
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.longislandguide.com/visit/valley-stream/",
      "category": "other",
      "quality": "poor",
      "qualityReason": "other"
    },
    {
      "id": 6,
      "text": "Several films, including Goodfellas and The Lords of Flatbush, shot scenes in Valley Stream, making it a hidden Hollywood backdrop.",
