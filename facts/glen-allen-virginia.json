  "facts": [
    {
      "id": 1,
      "text": "Glen Allen grew from a 19th‑century crossroads called Mountain Road Crossing, where farmers traded corn and tobacco along the old Mountain Road.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/Glen_Allen,_Virginia",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The arrival of the Richmond, Fredericksburg and Potomac Railroad in 1836 turned the area into a rail stop, sparking early settlement and commerce.",
      "sourceSentenceIds": [
        20
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/Glen_Allen,_Virginia",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Benjamin Allen, after whom the community is named, ran a small post office and the locale was once called Allen’s Crossing.",
      "sourceSentenceIds": [
        6,
        18
      ],
      "sourceLabels": [
        "Web source 1",
        "Web source 2"
      ],
      "source": "https://glenallencdp.wixsite.com/glenallen/historicalsites",
      "category": "people",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "During the Civil War, Confederate soldiers used Mrs. Cussons’ homestead as a landmark, and later Captain John Cussons built the Forest Lodge resort hotel beside the tracks.",
      "sourceSentenceIds": [
        23,
        24,
        16
      ],
      "sourceLabels": [
        "Web source 2",
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/Glen_Allen,_Virginia",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Meadow Farm, listed on the National Register in 1974, now serves as a living‑history museum that showcases 1800s rural Southern life.",
      "sourceSentenceIds": [
        4,
        15
      ],
      "sourceLabels": [
        "Web source 1",
        "Web source 1"
      ],
      "source": "https://glenallencdp.wixsite.com/glenallen/historicalsites",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The first Glen Allen School opened in 1886 inside Elizabeth Jane Holladay’s home, marking the town’s early commitment to education.",
