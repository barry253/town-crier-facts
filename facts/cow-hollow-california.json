  "facts": [
    {
      "id": 1,
      "text": "Cow Hollow earned its name from the early dairies that dotted the low‑lying hollow, supplying milk to a growing San Francisco in the 1800s.",
      "sourceSentenceIds": [
        9,
        10,
        22
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://sanfrancisco.wiki/a/Cow_Hollow_%E2%80%94_Deep_Dive",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The Vedanta Society of Northern California, founded by Swami Vivekananda in 1900, built the first Hindu temple in the Western Hemisphere right in Cow Hollow.",
      "sourceSentenceIds": [
        3,
        4,
        12,
        14,
        15
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Vedanta_Society_of_Northern_California",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "After the 1906 earthquake, the temple survived the fires that devastated much of the neighborhood, standing as a rare stone witness to the disaster.",
      "sourceSentenceIds": [
        25,
        16
      ],
      "sourceLabels": [
        "Web source 1",
        "Wikipedia"
      ],
      "source": "https://sanfrancisco.wiki/a/Cow_Hollow_%E2%80%94_Deep_Dive",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Union Street, Cow Hollow’s main commercial spine, stretches east‑west through Victorian storefronts that once housed streetcar stops built in the 1870s.",
      "sourceSentenceIds": [
        21,
        24
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://sanfrancisco.wiki/a/Cow_Hollow_%E2%80%94_Deep_Dive",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Cow Hollow’s geography—a natural depression between Pacific Heights and the Presidio—creates a microclimate that keeps the area cooler and foggier than inland neighborhoods.",
      "sourceSentenceIds": [
        28,
        29
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://sanfrancisco.wiki/a/Cow_Hollow_%E2%80%94_Deep_Dive",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "During the 1960s and 1970s, Cow Hollow absorbed a touch of San Francisco’s counterculture while maintaining its predominantly residential feel.",
      "sourceSentenceIds": [
