      "id": 1,
      "text": "Wheeler takes its name from Royall Tyler Wheeler, a former Chief Justice of the Texas Supreme Court.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Wheeler%2C_Texas",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town’s origins trace back to 1904 when ranchers Robert B. and his partner founded Wheeler.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.wheelertexas.org/",
      "category": "history",
      "quality": "poor",
      "qualityReason": "dropped_surname_no_wiki_source"
    },
    {
      "id": 3,
      "text": "Wheeler serves as the county seat of Wheeler County, sitting on the eastern edge of the Texas Panhandle.",
      "sourceSentenceIds": [
        23
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Wheeler%2C_Texas",
      "category": "other",
      "quality": "poor",
      "qualityReason": "location_description"
    },
    {
      "id": 4,
      "text": "The town lies three miles northwest of the county center, 100 miles east of Amarillo, and 12 miles west of the Oklahoma line.",
      "sourceSentenceIds": [
        24
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Wheeler%2C_Texas",
      "category": "other",
      "quality": "poor",
      "qualityReason": "location_description"
    },
    {
