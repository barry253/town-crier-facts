  "facts": [
    {
      "id": 1,
      "text": "Fetters Hot Springs was founded in 1908 by George and Emma Fetters, who bought a ranch a mile north of the Boyes property.",
      "sourceSentenceIds": [
        5,
        14
      ],
      "sourceLabels": [
        "Web source 1",
        "Wikipedia"
      ],
      "source": "https://springsmuseum.org/category/fetters-hot-springs/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The resort’s original hotel, swimming pavilion, and theater were built by the Fetters, and a nearby depot served the Northwest Pacific Railroad.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://springsmuseum.org/category/fetters-hot-springs/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "In 1907 the same couple that founded the resort also purchased the old Halstead ranch, positioning the springs just north of the Boyes Hot Springs area.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://springsmuseum.org/category/fetters-hot-springs/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The name Agua Caliente, meaning “hot water” in Spanish, reflects the historic hot springs that drew Indigenous peoples to the area long before settlers arrived.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Fetters_Hot_Springs-Agua_Caliente%2C_California",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The area that is now Fetters Hot Springs was once part of a 50,000‑acre Mexican land grant called Rancho Agua Caliente, granted in 1840.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
