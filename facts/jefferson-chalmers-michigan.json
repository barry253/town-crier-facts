  "facts": [
    {
      "id": 1,
      "text": "Jefferson–Chalmers Historic Business District is the only continuously intact commercial district along East Jefferson Avenue, listed on the National Register of Historic Places in 2004.",
      "sourceSentenceIds": [
        25
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Jefferson%E2%80%93Chalmers_Historic_Business_District",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Jefferson–Chalmers earned the nickname “Venice of Detroit” for its canal‑lined streets, mature trees, waterfront parks, and big old homes.",
      "sourceSentenceIds": [
        19
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://detroitisit.com/the-venice-of-detroit-in-a-neighborhood/",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "East Jefferson Avenue began as an Indian trail running along the Detroit River.",
      "sourceSentenceIds": [
        5
