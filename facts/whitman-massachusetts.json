  "facts": [
    {
      "id": 1,
      "text": "Whitman is the birthplace of the chocolate chip cookie, invented by Ruth Graves Wakefield at the historic Toll House Inn.",
      "sourceSentenceIds": [
        24
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Whitman%2C_Massachusetts",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town adopted the name Whitman after a 1886 vote, honoring local lawyer Jared Whitman.",
      "sourceSentenceIds": [
        4,
        29
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Whitman%2C_Massachusetts",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Before becoming Whitman, the area was known as Little Comfort, a section of Bridgewater settled around 1675.",
      "sourceSentenceIds": [
        7,
        25
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.whitman-ma.gov/171/1892/Town-History",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Whitman was incorporated as a separate town on March 4, 1875, having previously been the parish of South Abington.",
      "sourceSentenceIds": [
        8,
        28
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.whitman-ma.gov/171/1892/Town-History",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "In 1864 the Dunbar, Hobart, and Whidden Tack factory opened, becoming the largest factory of its kind in the world at the time.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
