  "facts": [
    {
      "id": 1,
      "text": "Thomas Lingle founded Linglestown in 1765, originally naming the settlement The Town of St. Thomas after the Christian apostle.",
      "sourceSentenceIds": [
        7,
        21,
        22
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Linglestown%2C_Pennsylvania"
    },
    {
      "id": 2,
      "text": "The original plan for Linglestown still exists on a sheepskin document, detailing the village's plots, street names, and alleyways.",
      "sourceSentenceIds": [
        23
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Linglestown%2C_Pennsylvania"
    },
    {
      "id": 3,
      "text": "Linglestown evolved from a hub for local agriculture and trade into a residential area known for its historical charm.",
      "sourceSentenceIds": [
        5,
        12
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/linglestown_pennsylvania"
    },
    {
      "id": 4,
      "text": "Thomas United Church of Christ is the oldest denomination in the village and serves as the final resting place for Thomas Lingle.",
      "sourceSentenceIds": [
        15,
        28
      ],
      "sourceLabels": [
        "Web source 2",
        "Wikipedia"
      ],
      "source": "https://grokipedia.com/page/linglestown_pennsylvania"
    },
    {
      "id": 5,
      "text": "The Church of God denomination established its first structure, cemetery, and world beginning right here in Linglestown.",
      "sourceSentenceIds": [
        29
      ],
      "sourceLabels": [
