  "facts": [
    {
      "id": 1,
      "text": "Cal‑Nev‑Ari was founded in 1965 by pilots Nancy and Everette \"Slim\" Kidwell, who wanted a community where pilots could live near their aircraft.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 2"
