      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Gotanda transformed from a rural rice‑farming district into a bustling suburb after Gotanda Station opened on the Yamanote Line in 1911.",
      "sourceSentenceIds": [
