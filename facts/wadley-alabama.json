      "id": 1,
      "text": "Settlers resided in the area that now encompasses Wadley from the 1830s, but the town itself was not founded until 1906.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 1"
      ],
