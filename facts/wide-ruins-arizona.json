  "facts": [
    {
      "id": 1,
      "text": "Wide Ruins, Arizona, dates back to the late 13th century when the Pueblo people built the large Kin tiel, meaning 'Broad House' in Navajo.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Wide_Ruins%2C_Arizona",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The site sits inside the Navajo Nation, surrounded by mesas, canyons, and other ancient ruins that paint a dramatic landscape.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.wideruinsdoc.com/",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "A trading post opened within the ruins' walls in 1938, later run by Bill and Sallie Wagner Lippincott until 1949.",
      "sourceSentenceIds": [
        17
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Wide_Ruins%2C_Arizona",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Legendary figure Jilhaal is credited with helping build fortifications north and south of Wide Ruins in the early 18th century.",
      "sourceSentenceIds": [
        19
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Wide_Ruins%2C_Arizona",
      "category": "people",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The fortress atop Wide Ruins served as a citadel and refuge whenever enemies were spotted in the surrounding area.",
      "sourceSentenceIds": [
        26
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Wide_Ruins%2C_Arizona",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Defensive walls, four stones thick, protected the settlement from Utes and White Mountain Apaches during the 18th century.",
      "sourceSentenceIds": [
        30
      ],
