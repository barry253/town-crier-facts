  "facts": [
    {
      "id": 1,
      "text": "Mora was founded in 1882 by pioneer Myron Kent and named after Mora, Sweden, echoing its Scandinavian roots.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://moramn.com/mora-chamber/city-of-mora/"
    },
    {
      "id": 2,
      "text": "The stately Romanesque Kanabec County Courthouse, built in 1894, stands as a National Register landmark in downtown Mora.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://moramn.com/mora-chamber/city-of-mora/"
    },
    {
      "id": 3,
      "text": "Mora hosts the largest Dala horse in the U.S., a 25‑foot‑high statue that crowns the town’s skyline.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://moramn.com/mora-chamber/visitors-guide/"
    },
    {
      "id": 4,
      "text": "The Ogilvie Tower, added to the National Register in 1980, offers a glimpse into Mora’s early 20th‑century architecture.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://moramn.com/mora-chamber/visitors-guide/"
    },
    {
      "id": 5,
      "text": "Downtown Mora’s historic Union Street features the nostalgic Paradise Theatre and the lively Crystal Bar & Grill, anchoring the town’s cultural scene.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://moramn.com/mora-chamber/city-of-mora/"
    },
    {
      "id": 6,
      "text": "Every summer, Mora celebrates its Swedish heritage with the Vasaloppet USA, a marathon inspired by the famous Swedish ski race.",
      "sourceSentenceIds": [
        11
      ],
      "sourceLabels": [
        "Web source 2"
      ],
