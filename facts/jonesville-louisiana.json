  "facts": [
    {
      "id": 1,
      "text": "Jonesville, Louisiana's largest town in Catahoula Parish, sits where the Ouachita, Tensas, and Little rivers meet.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Jonesville%2C_Louisiana",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "North of Jonesville, the Ouachita and Tensas rivers merge to create the Black River, just 0.4 miles from town limits.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Jonesville%2C_Louisiana",
      "category": "nature",
      "quality": "poor",
      "qualityReason": "route_only"
    },
    {
      "id": 3,
      "text": "Long before the town, Native Americans built the Troyville Earthworks near Jonesville between 100 BCE and 700 CE.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Jonesville%2C_Louisiana",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The Great Mound, once 82 feet high, was Louisiana’s tallest mound and the U.S.’s second tallest until bridge builders leveled it in 1931.",
