  "facts": [
    {
      "id": 1,
      "text": "Stoneham was first settled by colonists in 1634, originally part of Charlestown before becoming its own town.",
      "sourceSentenceIds": [
        11
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Stoneham%2C_Massachusetts",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town is the birthplace of Olympic figure‑skating medalist Nancy Kerrigan, who grew up in Stoneham before competing in 1992 and 1994.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Stoneham%2C_Massachusetts",
      "category": "people",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Stoneham’s historic shoe‑manufacturing, tanneries, and box factories are celebrated in the town seal, a nod to its industrial past.",
      "sourceSentenceIds": [
        14
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.stoneham-ma.gov/354/About-Stoneham",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The Stoneham Historical Society, founded in 1922, operates a museum that houses artifacts chronicling nearly a century of local history.",
      "sourceSentenceIds": [
        2,
        5
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://museumsdatabase.com/museums/view/14577",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Stoneham is home to the Stone Zoo, a small but popular wildlife park that attracts visitors from the greater Boston area.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Stoneham%2C_Massachusetts",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The town’s first meetinghouse and Burying Ground were both erected in 1726, with the cemetery later listed on the National Register of Historic Places.",
      "sourceSentenceIds": [
