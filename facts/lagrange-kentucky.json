  "facts": [
    {
      "id": 1,
      "text": "La Grange was founded in 1827 when Oldham County’s seat moved from Westport at Major William Berry Taylor’s suggestion.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/La_Grange%2C_Kentucky",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town was named after Château de la Grange‑Bléneau, the French estate of Marquis de Lafayette, who visited in 1824.",
      "sourceSentenceIds": [
        11
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/La_Grange%2C_Kentucky",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Main Street in La Grange carries a CSX street‑running mainline where freight trains share the road with local traffic.",
      "sourceSentenceIds": [
        12,
        28
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/La_Grange%2C_Kentucky",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The La Grange Railroad Museum sits beside the active tracks, showcasing vintage cars, a dining car, and a caboose once owned by the Louisville & Nashville Railroad.",
      "sourceSentenceIds": [
        5,
        6,
        14
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://visitlagrangeky.com/history/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The Oldham County History Center near Springs Park offers guided tours that explore the area’s Civil War significance and early settler stories.",
      "sourceSentenceIds": [
        16
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://visitlagrangeky.com/history/",
      "category": "history",
