      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Brigham Street runs through Kirtland, featuring a historic Mormon meetinghouse and a seminary building that sits opposite Kirtland Central High School.",
      "sourceSentenceIds": [
