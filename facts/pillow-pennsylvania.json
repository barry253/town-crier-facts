  "facts": [
    {
      "id": 1,
      "text": "Pillow was founded in 1818 as Snydertown by John Snyder, a land developer from Mercer County.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Pillow%2C_Pennsylvania",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The borough adopted the name Pillow in 1847 after General Gideon Pillow, famed for Mexican–American War victories.",
      "sourceSentenceIds": [
        22
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Pillow%2C_Pennsylvania",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "During the late 19th and early 20th centuries, Pillow boasted a cotton mill, a burial vault manufacturer, a brickworks, and a potato chip factory.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Pillow%2C_Pennsylvania",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Today, the only major industry remaining in Pillow is the Codi case factory.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Pillow%2C_Pennsylvania",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The Pillow Historical Society, founded in 1986, preserves local history and operates a museum in a former early‑1900s general store.",
      "sourceSentenceIds": [
        1,
        10
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://museumsdatabase.com/museums/view/26673",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The museum showcases exhibits on coal mining, farming, the railroad, and notable residents of Pillow.",
      "sourceSentenceIds": [
        11
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://museumsdatabase.com/museums/view/26673",
      "category": "culture",
      "quality": "good"
    }
