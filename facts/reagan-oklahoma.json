    },
    {
      "id": 2,
      "text": "Reagan was established around 1894 within the lands of the Chickasaw Nation before Oklahoma became a state in 1907.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/reagan_oklahoma"
    },
    {
      "id": 3,
      "text": "A local post office served as a central communication hub for the rural community from 1894 until 1931.",
      "sourceSentenceIds": [
        10,
        28
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Reagan%2C_Oklahoma"
    },
    {
      "id": 4,
      "text": "The St. Louis and San Francisco Railway helped Reagan grow by transporting cotton, corn, and livestock to distant markets.",
      "sourceSentenceIds": [
