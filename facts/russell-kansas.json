  "facts": [
    {
      "id": 1,
      "text": "Russell’s early rail history began with a 1865 Butterfield Overland Despatch station called Fossil Creek, followed by a Kansas Pacific Railway station in 1867.",
      "sourceSentenceIds": [
        1,
        2
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Russell%2C_Kansas",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Russell became the permanent county seat of Russell County in 1874 after a two‑year dispute with neighboring Bunker Hill.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Russell%2C_Kansas",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The Russell County Historical Society Museum occupies a 1907 post‑rock limestone former sheriff’s office and jail, a fortress‑like structure.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Russell%2C_Kansas",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The museum also preserves two early limestone homes, the Gernon House and the Heym‑Oliver House, showcasing 19th‑century architecture.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Russell%2C_Kansas",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Every June, Russell hosts a festival with a parade, carnival rides, live music, arts and crafts, and a historical pageant.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Russell%2C_Kansas",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Downtown Russell’s brick streets and historic facades, highlighted by a mural celebrating the town’s past, paint a nostalgic scene under the blue Kansas sky.",
