  "facts": [
    {
      "id": 1,
      "text": "In 2001, Daxing was upgraded from a county to a district, preserving its administrative roots that trace back to the Tang Dynasty.",
      "sourceSentenceIds": [
        21
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://ruqintravel.com/china-destination-guides/beijing-daxing-district-travel-guide/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Daxing once hosted the imperial hunting grounds of the Ming and Qing dynasties, known as Nanyuan, a key piece of its royal heritage.",
      "sourceSentenceIds": [
        22
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://ruqintravel.com/china-destination-guides/beijing-daxing-district-travel-guide/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The Longquan Temple in Daxing is celebrated for its tranquil atmosphere and deep historical significance.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.china-travelnote.com/attractions/5359.html",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Daxing’s history stretches back over 2,400 years, founded in the pre‑Qin period.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.china-travelnote.com/attractions/5359.html",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Daxing blends historic charm with modern pastoral landscapes, creating a unique “vegetable farm + cultural tourism” experience.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://ruqintravel.com/china-destination-guides/beijing-daxing-district-travel-guide/",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Daxing enjoys a humid continental climate, with July as the wettest month, January the coldest, and an average annual temperature of 12.9 °C.",
