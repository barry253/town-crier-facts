  "facts": [
    {
      "id": 1,
      "text": "DeBerry, once called Evergreen before the Civil War, was renamed for local legislator Alfred Wesley De Berry.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/DeBerry%2C_Texas",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "A post office opened in 1874, and by 1885 the community counted 150 residents.",
      "sourceSentenceIds": [
        11
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/DeBerry%2C_Texas",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The town originated in 1878, founded by Captain Alfred De Berry, who later served as Texas’s first Secretary of State after the war.",
      "sourceSentenceIds": [
        18,
        22
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.historictexas.net/city/deberry-texas",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "DeBerry’s population peaked at about 250 in 1929 before falling to 233 a decade later.",
      "sourceSentenceIds": [
        12,
        13
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/DeBerry%2C_Texas",
      "category": "people",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The town sits at the historic crossroads of U.S. Highways 59 and 69, once a tough wagon route because of the nearby Sabine River.",
      "sourceSentenceIds": [
        9,
        3
      ],
      "sourceLabels": [
        "Wikipedia",
