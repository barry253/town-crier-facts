  "facts": [
    {
      "id": 1,
      "text": "Hallock named after Charles Hallock, a New York naturalist and writer, who dubbed the area a \"Sportsman’s Paradise\" and inspired the Hotel Hallock built in 1880.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.brooklynparkcityhall.com/2025/05/city-of-hallock-mn.html"
    },
    {
      "id": 2,
      "text": "Hallock was platted in 1879 and incorporated as a city in 1887 today.",
      "sourceSentenceIds": [
        8,
        11
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.brooklynparkcityhall.com/2025/05/city-of-hallock-mn.html"
    },
    {
      "id": 3,
      "text": "Hallock’s local history is displayed at the Marshall County Historical Society’s museum in Warren, featuring artifacts from early settlers.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.mchistoricalsociety.com/local-history-exhibits/hallock-mn"
    },
    {
      "id": 4,
      "text": "Hallock is celebrated for outdoor adventures and a relaxed lifestyle, attracting visitors seeking simplicity.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.brooklynparkcityhall.com/2025/05/city-of-hallock-mn.html"
    },
    {
      "id": 5,
      "text": "The region’s Indigenous peoples—Cree, Assiniboine, Lakota, and Ojibwe—traversed the land that is now Hallock for centuries.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.brooklynparkcityhall.com/2025/05/city-of-hallock-mn.html"
    },
