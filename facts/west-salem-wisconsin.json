  "facts": [
    {
      "id": 1,
      "text": "West Salem was founded by Thomas Leonard in 1851 and is home to Pulitzer Prize‑winning author Hamlin Garland.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://westsalemwi.gov/",
      "category": "people",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The village added “West” to its name when mail was confused with another Salem in Wisconsin.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/West_Salem%2C_Wisconsin",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Two octagon homes and Thomas Leonard’s colonial‑style house are listed as historic points of interest in West Salem.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://westsalemwi.gov/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The West Salem Historical Society preserves the Garland Homestead, Palmer‑Gullickson Octagon House, and Palmer‑Lewis Home.",
      "sourceSentenceIds": [
        11
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://westsalemhistoricalsociety.org/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "A station on the original Milwaukee and La Crosse Railway was built in West Salem, linking the village to regional trade.",
      "sourceSentenceIds": [
        19
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/West_Salem%2C_Wisconsin",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "West Salem sits along the La Crosse River in La Crosse County, part of the La Crosse‑Onalaska metropolitan area.",
