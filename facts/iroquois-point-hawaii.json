  "facts": [
    {
      "id": 1,
      "text": "Iroquois Point, once called Keahi Point, sits in the historic Puʻuloa district of ʻEwa moku, prized for its natural resources before European arrival.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/iroquois_point_hawaii",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Iroquois Point was part of the 43,000‑acre Honouliuli Ahupuaʻa, famed for fishponds, pearl oyster gathering, and salt pans.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/iroquois_point_hawaii",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Iroquois Point takes its name from the USS Iroquois, a U.S. Navy ship that served twice in the fleet.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.liquisearch.com/iroquois_point_hawaii/history",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Iroquois Point’s Kapilina Beach Homes began as mid‑century military family housing and now serves active‑duty personnel, veterans, and civilians.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/iroquois_point_hawaii",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Iroquois Point hosts a firing range, a Navy Exchange shoppette, a gas station, and Iroquois Point Elementary School.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Iroquois_Point%2C_Hawaii",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Iroquois Point spans 1.14 sq mi, with 0.33 sq mi water, positioned along West Loch, a branch of historic Puʻuloa Lagoon.",
      "sourceSentenceIds": [
