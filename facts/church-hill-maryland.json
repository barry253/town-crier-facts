      ],
      "source": "https://grokipedia.com/page/church_hill_maryland",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town was officially incorporated by the Maryland General Assembly in 1876, cementing its role in the county’s agrarian history.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/church_hill_maryland",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The historic Church Hill Theatre, an Art Deco‑era building, remains the only active indoor venue for live performances in the county.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/church_hill_maryland",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Luke’s Church, a colonial-era landmark, is listed on the National Register of Historic Places.",
