      "id": 1,
      "text": "Oxley Creek was named by explorer John Oxley in December 1823 after his survey of the area.",
      "sourceSentenceIds": [
        3,
        9,
        11
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1",
