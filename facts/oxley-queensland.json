    },
    {
      "id": 2,
      "text": "In 1869 a floating sugar mill called the Walrus operated on Oxley Creek, a rare mobile processing plant of the era.",
      "sourceSentenceIds": [
        5,
        12
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 2"
      ],
      "source": "https://en.wikipedia.org/wiki/Oxley%2C_Queensland"
    },
    {
      "id": 3,
      "text": "The first hotel in Oxley opened in 1860 near Oxley Creek on a rise close to Factory Road.",
      "sourceSentenceIds": [
        15
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Oxley%2C_Queensland"
    },
    {
      "id": 4,
      "text": "Oxley railway station opened in 1874 on the Main Line, sparking a second subdivision called the Township of Oxley in 1876.",
