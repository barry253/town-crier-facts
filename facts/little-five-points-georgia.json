  "facts": [
    {
      "id": 1,
      "text": "Named after the five‑point trolley car intersection that sparked its growth, Little Five Points was already a bustling retail hub by the 1890s.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://pacificanetwork.org/were-a-neighborhood-of-a-lot-of-firsts-wrfg-and-the-little-five-points-l5p-business-association-launch-the-little-five-points-oral-history-project-and-celebrate-the-people-whose-work-has-kept-th/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "In 2024, WRFG and the L5P Business Association launched the Little Five Points Oral History Project to celebrate and protect the neighborhood’s unique heritage.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://pacificanetwork.org/were-a-neighborhood-of-a-lot-of-firsts-wrfg-and-the-little-five-points-l5p-business-association-launch-the-little-five-points-oral-history-project-and-celebrate-the-people-whose-work-has-kept-th/",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The original fifth point was Seminole Avenue, but it was later converted to a plaza, leaving no true five‑point intersection today.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Little_Five_Points",
      "category": "other",
      "quality": "poor",
      "qualityReason": "editorial_filler"
    },
    {
      "id": 4,
      "text": "Little Five Fest, held each summer, showcases 50 to 100 local bands across multiple venues, making it a cornerstone of the neighborhood’s music scene.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Little_Five_Points",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "In 1981, local merchants formed the Little Five Points Partnership to restore and expand the retail area, turning a former gas station into a strip‑mall‑style hub.",
      "sourceSentenceIds": [
        18
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Little_Five_Points",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Little Five Points has earned a reputation as Atlanta’s Haight‑Ashbury, a melting pot of sub‑cultures and the bohemian heart of the South.",
      "sourceSentenceIds": [
        26
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
