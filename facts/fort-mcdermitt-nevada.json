  "facts": [
    {
      "id": 1,
      "text": "Fort McDermitt opened on August 14, 1865, first named Quinn River Camp #33 before honoring Lt. Charles McDermitt.",
      "sourceSentenceIds": [
        1,
        8,
        16
      ],
      "sourceLabels": [
        "Web source 1",
        "Web source 2"
      ],
      "source": "https://exploreforts.com/forts/fort-mcdermit-nv",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "It was Nevada's longest active Army fort, operating for 24 years before closing in 1889.",
      "sourceSentenceIds": [
        14,
        19,
        26
      ],
      "sourceLabels": [
        "Web source 1",
        "Web source 2"
      ],
      "source": "https://exploreforts.com/forts/fort-mcdermit-nv",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The fort protected the stagecoach line between Winnemucca, Nevada, and Silver City, Idaho Territory.",
      "sourceSentenceIds": [
        17
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://exploreforts.com/forts/fort-mcdermit-nv",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Soldiers at Fort McDermitt fought in the Snake War, Bannock War, and Modoc War against Native tribes.",
      "sourceSentenceIds": [
        7,
        3
      ],
      "sourceLabels": [
        "Web source 1",
        "Web source 2"
      ],
      "source": "https://exploreforts.com/forts/fort-mcdermit-nv",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "In 1870, Sarah Winnemucca brought 500 starving Paiute to the fort's hospital, where she helped care for them.",
      "sourceSentenceIds": [
        20
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://exploreforts.com/forts/fort-mcdermit-nv",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "After closing, the fort became an Indian Service post and later a reservation school; two original buildings now serve the tribe.",
