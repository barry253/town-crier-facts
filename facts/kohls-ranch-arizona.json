  "facts": [
    {
      "id": 1,
      "text": "In 1917 the Kohl family bought a ranch that had been homesteaded in 1896.",
      "sourceSentenceIds": [
        1,
        3
      ],
      "sourceLabels": [
        "Web source 1",
        "Web source 2"
      ],
      "source": "https://www.krcommunity.org/history.html",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The ranch house stood where the current Kohl's Ranch Lodge is now located.",
      "sourceSentenceIds": [
        17
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.krcommunity.org/history.html",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "In the early 1930s the family converted the ranch into a resort, and cabins were built on both sides of Tonto Creek.",
      "sourceSentenceIds": [
        18,
        19
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.krcommunity.org/history.html",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "A fire destroyed the ranch house in 1941, prompting the family to sell the resort portion in 1940.",
      "sourceSentenceIds": [
        24,
        21
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.krcommunity.org/history.html",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The third pasture and surrounding land were sold to Arizona State University in 1951, becoming Camp Tontozona.",
      "sourceSentenceIds": [
        25,
        26
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.krcommunity.org/history.html",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Michael Mikol bought the resort in 1952, built a new lodge, and subdivided much of the land into residential lots.",
      "sourceSentenceIds": [
        27,
        29
      ],
      "sourceLabels": [
        "Web source 1"
      ],
