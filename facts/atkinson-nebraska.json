  "facts": [
    {
      "id": 1,
      "text": "Fort Atkinson, founded in 1819, was the first U.S. Army post west of the Missouri River in the Louisiana Purchase.",
      "sourceSentenceIds": [
        22
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Fort_Atkinson_(Nebraska)",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The fort’s name honors Colonel Henry Atkinson, who led the Yellowstone Expedition that established the post.",
      "sourceSentenceIds": [
        27
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Fort_Atkinson_(Nebraska)",
      "category": "people",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Today the site is a National Historic Landmark and state historical park, featuring a replica fort built in the 1980s–1990s.",
      "sourceSentenceIds": [
        1,
        23
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Fort_Atkinson_(Nebraska)",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Living‑history reenactors portray the Sixth Infantry and First Rifle Regiments each month, bringing the 1820s frontier to life.",
      "sourceSentenceIds": [
        10,
        16
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Fort_Atkinson_(Nebraska)",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The original fort sat atop Council Bluff, a high bluff overlooking the Missouri River chosen by William Clark for its strategic view.",
      "sourceSentenceIds": [
        4,
        26
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Fort_Atkinson_(Nebraska)",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The town’s library, opened in 2000, offers free internet and a microfilm reader, reflecting Atkinson’s commitment to community learning.",
