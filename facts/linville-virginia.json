  "facts": [
    {
      "id": 1,
      "text": "Linville’s name comes from William Linvell, who received 15,000 acres in the area before 1739.",
      "sourceSentenceIds": [
        11
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Linville%2C_Virginia",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Six miles north of Harrisonburg, Linville sits quietly in Rockingham County’s Shenandoah Valley.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Linville%2C_Virginia",
      "category": "other",
      "quality": "poor",
      "qualityReason": "location_description"
    },
    {
      "id": 3,
      "text": "During the antebellum era, Linville served as a key Underground Railroad stop, guiding runaway slaves through Brock’s Gap to Pendleton.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Linville%2C_Virginia",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "President Abraham Lincoln’s great-grandparents settled along Linville Creek in 1768, and his great-uncle Jacob built the Lincoln Homestead circa 1800.",
      "sourceSentenceIds": [
        18,
        20
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Linville%2C_Virginia",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Northwest of Linville, the Linville Mound—also called Bowman Mound—stands as a burial site on the floodplain of Linville Creek.",
      "sourceSentenceIds": [
        22
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
