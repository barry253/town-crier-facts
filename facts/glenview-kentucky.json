  "facts": [
    {
      "id": 1,
      "text": "Glenview is known for its old estate homes situated on high bluffs overlooking the Ohio River.",
      "sourceSentenceIds": [
        14
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Glenview%2C_Kentucky"
    },
    {
      "id": 2,
      "text": "The name Glenview likely comes from a local farm named for the views from the bluffs over the Ohio River.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.kyatlas.com/ky-glenview.html"
    },
    {
      "id": 3,
      "text": "Early residents of Glenview helped open the Louisville, Harrods Creek and Westport Railroad in 1877 as a commuter line.",
      "sourceSentenceIds": [
        11
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Glenview%2C_Kentucky"
    },
    {
      "id": 4,
      "text": "Many houses in Glenview are part of the Glenview Historic District, which is listed on the National Register of Historic Places.",
      "sourceSentenceIds": [
        22
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Glenview%2C_Kentucky"
    },
    {
      "id": 5,
      "text": "Louisville attempted to annex Glenview in 1983, prompting residents to seek separate incorporation from the state legislature.",
      "sourceSentenceIds": [
        21
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Glenview%2C_Kentucky"
    },
    {
      "id": 6,
      "text": "Several buildings in Glenview are individually listed on the National Register of Historic Places, including the Ballard School, Boxhill and Lincliff.",
