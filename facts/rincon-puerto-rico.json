    {
      "id": 1,
      "text": "Rincón, whose name means 'nook' in Spanish, crowns Puerto Rico's westernmost tip.",
      "sourceSentenceIds": [
        20,
        21
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Rinc%C3%B3n%2C_Puerto_Rico",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Founded in 1771 by Don Luis de Añasco, who also founded Añasco in 1733, Rincón grew into a seaside town.",
      "sourceSentenceIds": [
        2,
        3
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Rinc%C3%B3n%2C_Puerto_Rico",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The Punta Higuera Lighthouse, also known as El Faro, soars 100 feet above the Atlantic, guiding ships since the 19th century.",
      "sourceSentenceIds": [
        11
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.visit-caribbean.com/rincon-puerto-rico-a-complete-travel-guide/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Every April, filmmakers converge on Rincón for the International Film Festival, showcasing independent cinema.",
      "sourceSentenceIds": [
        14
