  "facts": [
    {
      "id": 1,
      "text": "Texanna originated in the mid-19th century as a settlement for Cherokee groups relocated from Texas after the Battle of Neches.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/texanna_oklahoma"
    },
    {
      "id": 2,
      "text": "The name Texanna reflects the town's association with the Texas Cherokees and its position between Texas and Oklahoma influences.",
      "sourceSentenceIds": [
        5,
        8,
        9
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1",
        "Web source 2"
      ],
      "source": "https://en.wikipedia.org/wiki/Texanna%2C_Oklahoma"
    },
    {
      "id": 3,
      "text": "Texanna is located on the north shore of Lake Eufaula, which is the largest-capacity reservoir in Oklahoma.",
      "sourceSentenceIds": [
        10,
        26
      ],
      "sourceLabels": [
        "Web source 2",
        "Wikipedia"
      ],
      "source": "https://grokipedia.com/page/texanna_oklahoma"
    },
    {
      "id": 4,
      "text": "The creation of Lake Eufaula flooded significant portions of the original Texanna settlement and submerged many of its historic sites.",
      "sourceSentenceIds": [
        22
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/texanna_oklahoma"
    },
    {
      "id": 5,
      "text": "Early economic growth in Texanna was driven by the arrival of railroads and the development of Route 66.",
      "sourceSentenceIds": [
        15,
        17
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://unitedstatesghosttowns.com/texanna-oklahoma-ghost-town/"
    },
    {
      "id": 6,
      "text": "Texanna gradually became a ghost town as urbanization and changing economic conditions led to the abandonment of its infrastructure.",
      "sourceSentenceIds": [
        7,
        18
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://unitedstatesghosttowns.com/texanna-oklahoma-ghost-town/"
