  "facts": [
    {
      "id": 1,
      "text": "Caberfae takes its name from the Scottish Gaelic cabar‑fèidh, meaning antler or stag’s head, a title given to an ancestor of the MacKenzies in 1255.",
      "sourceSentenceIds": [
        2,
        5
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Caberfae%2C_Michigan",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Caberfae Peaks, Michigan’s first destination ski area, opened in the 1930s when local enthusiasts and the U.S. Forest Service built the first ski run with a Ford Model A‑powered rope tow.",
      "sourceSentenceIds": [
        24,
        25,
        27
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/caberfae_michigan",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The Civilian Conservation Corps erected Caberfae’s inaugural ski run, “Number One,” on North Peak during 1936–1937, marking the start of the resort’s lift‑served legacy.",
      "sourceSentenceIds": [
        27
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/caberfae_michigan",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Today Caberfae Peaks also hosts a nine‑hole golf course that winds through forested slopes and spans ten bridges.",
      "sourceSentenceIds": [
        29
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/caberfae_michigan",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "After the Great Depression, the ranch sold to the U.S., became part of Manistee National Forest, and now sits on mixed public and private land.",
      "sourceSentenceIds": [
