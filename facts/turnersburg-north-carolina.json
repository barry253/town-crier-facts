      "qualityReason": "route_only"
    },
    {
      "id": 3,
      "text": "Turnersburg was established in 1858, giving it a history that stretches back over a century and a half.",
      "sourceSentenceIds": [
        1,
        6
      ],
      "sourceLabels": [
        "Web source 2",
        "Wikipedia"
      ],
      "source": "https://kids.kiddle.co/Turnersburg,_North_Carolina",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Since 1868, the community has been part of Olin Township, created to align with North Carolina’s constitutional requirements.",
      "sourceSentenceIds": [
        7,
        25,
        26,
        27
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 2"
      ],
      "source": "https://en.wikipedia.org/wiki/Turnersburg%2C_North_Carolina",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "An adjacent area shares its name: Turnersburg Township lies east of Olin Township, separate from the community itself.",
      "sourceSentenceIds": [
        8,
        28
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 2"
      ],
      "source": "https://en.wikipedia.org/wiki/Turnersburg%2C_North_Carolina",
      "category": "other",
      "quality": "poor",
      "qualityReason": "vague"
    },
    {
      "id": 6,
      "text": "Because it is unincorporated, Turnersburg is governed directly by Iredell County rather than having its own municipal government.",
