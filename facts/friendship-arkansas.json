  "facts": [
    {
      "id": 1,
      "text": "Friendship sits about four miles northeast of where the Ouachita and Caddo rivers meet.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/friendship_arkansas",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town’s high ground lies just half a mile north of the Ouachita River, giving it a modest elevation advantage.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/friendship_arkansas",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Hammons from Hot Springs County cleared land and built the first structures during the post-statehood pioneer rush.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/friendship_arkansas",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Archaeologists have found Caddo tribe mounds, pottery, and stone tools along the Ouachita River, proving the area was inhabited long before Europeans.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/friendship_arkansas",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "In 1804, William Dunbar and George Hunter surveyed the area as part of the Louisiana Purchase expeditions, noting stops near present-day Arkadelphia.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/friendship_arkansas",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Friendship’s only comprehensive high school, Ouachita High School, serves the town’s students.",
