    },
    {
      "id": 2,
      "text": "Founded in 1845, Pilot Point predates Denton County by two years, making it one of the region’s earliest settlements.",
      "sourceSentenceIds": [
        5,
        11
      ],
      "sourceLabels": [
        "Web source 1",
