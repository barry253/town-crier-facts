  "facts": [
    {
      "id": 1,
      "text": "Sedalia is home to the Palmer Memorial Institute, a pioneering African‑American preparatory school founded in 1902 by Charlotte Hawkins Brown.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/sedalia_north_carolina",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The institute grew from a single classroom in a blacksmith shop to a nationally recognized academy covering over 300 acres with 14 buildings by mid‑20th century.",
      "sourceSentenceIds": [
        1,
        3
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/sedalia_north_carolina",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The Palmer Memorial Institute closed in 1971 amid desegregation and a destructive fire, but its legacy lives on as the Charlotte Hawkins Brown Museum, a state historic site.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/sedalia_north_carolina",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Sedalia sits on gently rolling Piedmont terrain, with elevations between 663 and 702 feet, shaping local drainage patterns.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/sedalia_north_carolina",
      "category": "nature",
      "quality": "poor",
      "qualityReason": "vague"
    },
    {
      "id": 5,
      "text": "Route 70, known locally as Burlington Road, cuts through Sedalia’s center, linking the town east to Burlington and west to Greensboro.",
      "sourceSentenceIds": [
        19
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Sedalia%2C_North_Carolina",
      "category": "transport",
      "quality": "poor",
      "qualityReason": "route_only"
    },
    {
      "id": 6,
      "text": "The town’s name honors Alice Freeman Palmer, the benefactor of the Palmer Memorial Institute, whose influence helped establish the school’s mission.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
