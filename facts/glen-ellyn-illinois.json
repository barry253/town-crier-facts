  "facts": [
    {
      "id": 1,
      "text": "Glen Ellyn grew around Newton Station after a landowner offered land for a depot in 1849, shifting the village center a mile south of the original railroad line.",
      "sourceSentenceIds": [
        6,
        8,
        11,
        7
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Glen_Ellyn%2C_Illinois",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The village’s first inn, Stacy's Tavern, opened in 1846 as a halfway stop between Chicago and the Fox River Valley for stagecoaches.",
      "sourceSentenceIds": [
        25,
        5
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Glen_Ellyn%2C_Illinois",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Glen Ellyn’s name blends Glen and Lombard, reflecting its proximity to the neighboring town of Lombard.",
      "sourceSentenceIds": [
        14
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Glen_Ellyn%2C_Illinois",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The Glen Oak Country Club opened in 1922, the same year the first Glenbard high school was built, serving both Glen Ellyn and Oak Park.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Glen_Ellyn%2C_Illinois",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The original settlement was called Babcock's Grove after the Babcock brothers who claimed the land in 1833.",
      "sourceSentenceIds": [
        16,
        20
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Glen_Ellyn%2C_Illinois",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Newton Station, the historic depot built by Lewey Quitterfield Newton, became the focal point of Glen Ellyn, moving the community toward the station area.",
