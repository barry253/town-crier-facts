  "facts": [
    {
      "id": 1,
      "text": "Atkinson Mills is located in Mifflin County, Pennsylvania, sitting at an elevation of seven hundred eighty feet above sea level.",
      "sourceSentenceIds": [
        12,
        14
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://roadsidethoughts.com/pa/atkinson-mills-xx-mifflin-profile.htm"
    },
    {
      "id": 2,
      "text": "The land around Atkinson Mills was originally part of the traditional homelands of the Algonquian-speaking Lenni Lenape people.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/atkinson_mills_pennsylvania"
    },
    {
      "id": 3,
      "text": "Wayne Township, where Atkinson Mills is situated, was named for Revolutionary War hero General Anthony Wayne.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/atkinson_mills_pennsylvania"
    },
    {
      "id": 4,
      "text": "Early industrial activities in the area included the Matilda Furnace for iron production and quarries for glass manufacturing.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/atkinson_mills_pennsylvania"
    },
    {
      "id": 5,
      "text": "The earliest known mention of Atkinson Mills appears in a book dated eighteen ninety-five.",
      "sourceSentenceIds": [
        13
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://roadsidethoughts.com/pa/atkinson-mills-xx-mifflin-profile.htm"
    },
    {
      "id": 6,
      "text": "European encroachment in the mid-eighteenth century led to the gradual westward displacement of the Lenape people from this region.",
      "sourceSentenceIds": [
        5
