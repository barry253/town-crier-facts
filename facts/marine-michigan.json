  "facts": [
    {
      "id": 1,
      "text": "Founded by French ribbon farms, Marine City grew from a modest riverfront settlement into a bustling 19th‑century lumber and shipbuilding hub.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://marinecity.gov/history"
    },
    {
      "id": 2,
      "text": "Perched on the west bank of the St. Clair River, Marine City sits at the river’s confluence with the Detroit River.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Marine_City%2C_Michigan"
    },
    {
      "id": 3,
      "text": "In the late 1800s, wooden shipyards in Marine City built dozens of Great Lakes steamers that ferried passengers between towns.",
      "sourceSentenceIds": [
        9,
        27,
        28
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Marine_City%2C_Michigan"
    },
    {
      "id": 4,
      "text": "The village incorporated as Marine City in 1865 and became a city in June 1887 after rapid growth in lumber and shipping.",
      "sourceSentenceIds": [
        22,
        23
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Marine_City%2C_Michigan"
    },
    {
      "id": 5,
      "text": "From 1974 to 2014, the Bluewater Ferry operated across the St. Clair River, linking Marine City with Sombra, Ontario.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Marine_City%2C_Michigan"
    },
    {
      "id": 6,
      "text": "The first Catholic Church in the area was built by French Catholics at Catholic Point before the United States was formed.",
      "sourceSentenceIds": [
