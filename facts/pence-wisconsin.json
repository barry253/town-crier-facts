  "facts": [
    {
      "id": 1,
      "text": "Pence is a historic community rooted in the Gogebic Iron Range and defined by its mining heritage.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.co.iron.wi.gov/176/Town-of-Pence"
    },
    {
      "id": 2,
      "text": "The Town of Pence is home to the Plumer Mine Headframe, the last remaining iron mining headframe in Wisconsin.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.co.iron.wi.gov/176/Town-of-Pence"
    },
    {
      "id": 3,
      "text": "Pence boasts the largest concentration of historic log buildings for a town of its size in the state of Wisconsin.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.co.iron.wi.gov/176/Town-of-Pence"
    },
    {
      "id": 4,
      "text": "Italian and Corsican immigrants settled Pence in 1923 to work in the local forests and iron mines.",
      "sourceSentenceIds": [
        15
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.co.iron.wi.gov/176/Town-of-Pence"
    },
    {
      "id": 5,
      "text": "Pence was originally created on May 7, 1923, under the name Town of Clement.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Pence%2C_Wisconsin"
    },
    {
