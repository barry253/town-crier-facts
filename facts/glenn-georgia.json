  "facts": [
    {
      "id": 1,
      "text": "Glenn takes its name from George Glenn, an early settler who deeded land for the local Methodist church in 1874.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/glenn_georgia"
    },
    {
      "id": 2,
      "text": "The town’s post office opened in 1887 inside the Whitley Country Store, with DeLoach as its first postmaster.",
      "sourceSentenceIds": [
        16,
        18
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Glenn%2C_Georgia"
    },
    {
      "id": 3,
      "text": "Glenn sits about 15 miles southwest of Franklin, the county seat, surrounded by farmland and wooded hills.",
      "sourceSentenceIds": [
        21
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/glenn_georgia"
    },
    {
      "id": 4,
      "text": "At 820 feet above sea level, Glenn lies in Georgia’s Piedmont region between the Blue Ridge Mountains and the Upper Coastal Plain.",
      "sourceSentenceIds": [
        13,
        22
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Glenn%2C_Georgia"
    },
    {
      "id": 5,
      "text": "The area averages 62°F yearly, with July highs near 90°F, January lows around 35°F, 52 inches of rain, and occasional spring tornadoes.",
      "sourceSentenceIds": [
        24,
        25,
        26
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/glenn_georgia"
    },
    {
      "id": 6,
      "text": "Mid‑1830s settlers arrived via state land lotteries, choosing the gently rolling terrain for small‑scale farming rather than large plantations.",
