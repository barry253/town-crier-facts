  "facts": [
    {
      "id": 1,
      "text": "Shohola Township was legally formed on September 26, 1852, covering 45 square miles from the Delaware River to Route 6.",
      "sourceSentenceIds": [
        1,
        20
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.pikehistorical.org/shohola-township",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The name Shohola means “peace and tranquility,” a translation of the Native American word applied to the calm Shohola Creek.",
      "sourceSentenceIds": [
        2,
        26
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.shoholatwp.org/history/",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The Erie Railroad arrived in 1848, sparking growth from a handful of farms to a thriving community.",
      "sourceSentenceIds": [
        3,
        8
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.pikehistorical.org/shohola-township",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The village of Shohola was first settled in 1772, long before the township’s official creation.",
      "sourceSentenceIds": [
        12,
        7
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.pikehistorical.org/shohola-township",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Shohola hosts the historic Roheman's Pub, a two‑and‑a‑half‑story banked L‑shaped building with a cross‑gable roof.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.pikehistorical.org/shohola-township",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The township contains a waterfall, four lakes, and extensive Delaware State Forest and game lands, offering a peaceful retreat.",
