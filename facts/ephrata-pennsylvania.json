  "facts": [
    {
      "id": 1,
      "text": "Founded in 1732 by Johann Conrad Beissel, Ephrata began as a communal religious society.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Ephrata%2C_Pennsylvania",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "America’s first communal religious society, the Ephrata Cloister, still stands as a national landmark.",
      "sourceSentenceIds": [
        2,
        16
      ],
      "sourceLabels": [
        "Web source 2",
        "Web source 1"
      ],
      "source": "https://mainspringofephrata.org/visitor/history-heritage/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "In the 19th century, Ephrata hosted the Mountain Springs Resort and the Mount Vernon Hotel, making it a regional resort hub.",
      "sourceSentenceIds": [
        19
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://mainspringofephrata.org/visitor/history-heritage/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The Reading & Columbia Railroad served downtown passengers until 1952, and its former line now powers a rail trail.",
      "sourceSentenceIds": [
        11,
        12,
        22
      ],
      "sourceLabels": [
        "Wikipedia",
        "Wikipedia",
