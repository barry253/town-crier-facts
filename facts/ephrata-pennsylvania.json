      ],
      "source": "https://en.wikipedia.org/wiki/Ephrata%2C_Pennsylvania",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Eicher Arts Center occupies the historic Eicher House, the original home of founder Johann Conrad Beissel.",
      "sourceSentenceIds": [
