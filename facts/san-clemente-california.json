  "facts": [
    {
      "id": 1,
      "text": "San Clemente was founded by Ole Hanson in 1925 as a \"Spanish Village by the Sea\" and incorporated in 1928.",
      "sourceSentenceIds": [
        14,
        30
      ],
      "sourceLabels": [
        "Web source 1",
        "Web source 2"
      ],
      "source": "https://www.sanclemente.gov/315/City-Information"
    },
    {
      "id": 2,
      "text": "The town’s name comes from San Clemente Island, named by Spanish explorer Sebastián Vizcaino in 1602 after Saint Clement.",
      "sourceSentenceIds": [
        4,
        9,
        7
      ],
      "sourceLabels": [
        "Web source 2",
        "Wikipedia"
      ],
      "source": "https://www.sanclementehistoricalsociety.org/history/"
    },
    {
      "id": 3,
      "text": "San Clemente is a designated venue city for the 2028 Los Angeles Summer Olympics.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/San_Clemente%2C_California"
    },
    {
      "id": 4,
      "text": "The historic North Beach district houses the Miramar Theatre, Casino Building, and Ole Hanson Beach Club, all renovated in the 2010s.",
      "sourceSentenceIds": [
        21,
        24
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/San_Clemente%2C_California"
    },
    {
      "id": 5,
      "text": "San Clemente’s coastline hosts Trestles, one of the West Coast’s premier surfing spots, just north of San Onofre.",
      "sourceSentenceIds": [
        19
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/San_Clemente%2C_California"
    },
    {
      "id": 6,
      "text": "The city boasts 203 registered historic structures, including 22 landmarks and 5 on the National Register of Historic Places.",
