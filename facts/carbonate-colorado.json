  "facts": [
    {
      "id": 1,
      "text": "Carbonate was founded as a silver camp in 1879 and briefly served as Garfield County's original seat before moving to Glenwood Springs later that year.",
      "sourceSentenceIds": [
        2,
        1,
        12,
        15
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Carbonate%2C_Colorado",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town sits over 10,800 feet high in the Flat Tops Wilderness, where harsh winters and limited mining yields caused it to become a ghost town by the late 1880s.",
      "sourceSentenceIds": [
        3,
        5,
        14,
        18
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/Carbonate,_Colorado",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "A post office opened on April 13, 1883, and closed just three years later on November 15, 1886, reflecting the town’s rapid decline.",
      "sourceSentenceIds": [
        11,
        17,
        25
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Carbonate%2C_Colorado",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Despite its abandonment, Carbonate was reincorporated as a statutory town in 2015, keeping legal status even with no permanent residents.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/Carbonate,_Colorado",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Remnants of the original settlement include two cabins that still stand amid the alpine landscape, accessible via Forest Road 600 from I‑70 near Dotsero.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/Carbonate,_Colorado",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The town’s name honors the carbonate ore deposits that attracted prospectors from Leadville in the late 1870s, sparking a brief high‑altitude mining boom.",
      "sourceSentenceIds": [
        3,
        9,
        22
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/Carbonate,_Colorado",
      "category": "etymology",
      "quality": "good"
    }
  ],
