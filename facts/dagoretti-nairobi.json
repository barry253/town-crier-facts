  "facts": [
    {
      "id": 1,
      "text": "Dagoretti got its name from a Kikuyu mispronunciation of 'ndagurite', meaning 'I had bought', which locals laughed at when a European claimed land.",
      "sourceSentenceIds": [
        13,
        14,
        15
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Dagoretti",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Dagoretti railway station sits on Kenya's main national line, linking the suburb to Nairobi's core.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Dagoretti",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "In the 1970s, Dagoretti moved from Kiambu County Council into Nairobi City Commission as the city expanded.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Dagoretti",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Some say Dagoretti derives from the Maasai word for the local weed 'entiakuleti', a plant common there.",
      "sourceSentenceIds": [
        11
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Dagoretti",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Dagoretti straddles the Nairobi–Kiambu boundary, with the Dagoretti Road Reserve marking the psychological border heading north.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Dagoretti",
      "category": "other",
      "quality": "poor",
      "qualityReason": "other"
    },
    {
      "id": 6,
      "text": "Administratively, Dagoretti is one of Nairobi's eight divisions, each overseeing local services and community development.",
