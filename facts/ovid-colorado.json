  "facts": [
    {
      "id": 1,
      "text": "Ovid was named after Newton Ovid, a local resident who helped found the town.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Ovid%2C_Colorado"
    },
    {
      "id": 2,
      "text": "In 1925 the Great Western Sugar Company built a massive sugar beet plant that brought Ovid its peak population.",
      "sourceSentenceIds": [
        14
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.uncovercolorado.com/towns/ovid/"
    },
    {
      "id": 3,
      "text": "A deserted factory’s steam‑powered locomotive was rescued and now rides in Ovid Park for curious visitors.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.uncovercolorado.com/towns/ovid/"
    },
    {
      "id": 4,
      "text": "The Depot Museum, housed in an old Union Pacific depot, displays artifacts from the Pony Express and Native American history.",
      "sourceSentenceIds": [
        5,
        6
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.uncovercolorado.com/towns/ovid/"
    },
    {
      "id": 5,
      "text": "Ovid lies in Colorado’s far northeastern corner, just a stone’s throw from the Wyoming and Nebraska borders.",
      "sourceSentenceIds": [
        13
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.uncovercolorado.com/towns/ovid/"
    },
    {
      "id": 6,
      "text": "The South Platte River Trail Scenic Byway, which begins in Julesburg, winds through Ovid, echoing pioneer history.",
      "sourceSentenceIds": [
        8
