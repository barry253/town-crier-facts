  "facts": [
    {
      "id": 1,
      "text": "Colorado City was originally called Greenhorn, named after an 18th‑century Comanche chief, before settlers renamed it in 1859.",
      "sourceSentenceIds": [
        9,
        1
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 2"
      ],
      "source": "https://en.wikipedia.org/wiki/Colorado_City%2C_Colorado",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town’s first trading post, founded by mountain man John Brown in 1845, sat where the Trapper’s Trail crossed Greenhorn Creek.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Colorado_City%2C_Colorado",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Because Colorado Springs was founded as a dry town, Colorado City thrived on alcohol sales and became known for its saloons and brothels in the late 1800s.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://occhs.org/Old-Colorado-City-History",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "In 1914, residents pushed for prohibition, closing the town’s saloons and marking a shift toward a more respectable community.",
