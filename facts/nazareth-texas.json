  "facts": [
    {
      "id": 1,
      "text": "Nazareth was founded in 1902 by Catholic priest Joseph Reisdorff, who named the town after the biblical Nazareth.",
      "sourceSentenceIds": [
        2,
        3,
        5
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1",
        "Web source 2"
      ],
      "source": "https://en.wikipedia.org/wiki/Nazareth%2C_Texas"
    },
    {
      "id": 2,
      "text": "A post office opened in 1903, and that same year the first Catholic church was completed in the new settlement.",
      "sourceSentenceIds": [
        23
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Nazareth%2C_Texas"
    },
    {
      "id": 3,
      "text": "By 1906 the community consecrated its own cemetery, becoming the only Catholic cemetery in the area.",
      "sourceSentenceIds": [
        25
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Nazareth%2C_Texas"
    },
    {
      "id": 4,
      "text": "During the Dust Bowl of the 1930s, a massive dust storm in 1933 left Nazareth with only about fifty residents.",
      "sourceSentenceIds": [
        28
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Nazareth%2C_Texas"
    },
    {
      "id": 5,
      "text": "Agriculture rebounded in the 1940s, and by 1941 the town’s population had risen to roughly two hundred people.",
      "sourceSentenceIds": [
        29
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Nazareth%2C_Texas"
    },
    {
      "id": 6,
      "text": "In the mid‑1980s, about eighty‑five percent of Nazareth’s residents were Catholic, and church activities helped bind the community together.",
      "sourceSentenceIds": [
        30
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
