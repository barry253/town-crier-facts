  "facts": [
    {
      "id": 1,
      "text": "Suwanee grew around the Georgia Air Line Railroad built in 1871, with the Rhodes House hotel opening in 1880 to host passengers.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Suwanee%2C_Georgia",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "In 2003 Suwanee earned the title City of Excellence from the Georgia Municipal Association and Trend Magazine.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Suwanee%2C_Georgia",
      "category": "other",
      "quality": "poor",
      "qualityReason": "editorial_filler"
    },
    {
      "id": 3,
      "text": "The town once had a second small station called Shadow Brook on the south side of the tracks at Lawrenceville‑Suwanee Road.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.suwanee.com/explore-suwanee/about-suwanee/history",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Suwanee was twice named one of America’s Best Places to Live by Money Magazine and a top town for families by Family Circle.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.exploregwinnett.org/cities/suwanee/",
      "category": "other",
      "quality": "poor",
      "qualityReason": "editorial_filler"
    },
    {
      "id": 5,
      "text": "The historic downtown still mirrors its early 20th‑century look, with Pierce’s Corner built in 1910 still standing today.",
      "sourceSentenceIds": [
        13,
        14
      ],
      "sourceLabels": [
        "Web source 1"
      ],
