  "facts": [
    {
      "id": 1,
      "text": "Lupton City began in the 1920s as a planned mill town built around the Dixie Spinning Mills thread mill.",
      "sourceSentenceIds": [
        11,
        13,
        14,
        15
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Lupton_City%2C_Chattanooga"
    },
    {
      "id": 2,
      "text": "By 1925 the mill’s spindles had tripled from 12,000 to 30,000, powering a growing workforce.",
      "sourceSentenceIds": [
        15
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Lupton_City%2C_Chattanooga"
    },
    {
      "id": 3,
      "text": "The town kept its own post office until July 18 2009, when the last mailbox was retired.",
      "sourceSentenceIds": [
        18
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Lupton_City%2C_Chattanooga"
    },
    {
      "id": 4,
      "text": "Chattanooga now owns the former mill site and will plant a native‑species meadow there by 2026.",
      "sourceSentenceIds": [
        22,
        23
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Lupton_City%2C_Chattanooga"
    },
    {
      "id": 5,
      "text": "Lupton City sits north of the Tennessee River, outside the original city limits before annexation.",
      "sourceSentenceIds": [
        14
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Lupton_City%2C_Chattanooga"
    },
    {
      "id": 6,
      "text": "The community was named for businessman John T. Lupton, who founded the Dixie Mercerizing Company in 1920.",
