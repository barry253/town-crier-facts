  "facts": [
    {
      "id": 1,
      "text": "Dawson’s origins trace to the Pittsburgh and Connellsville Railroad, where Dawson's Station opened when the line ran through the area.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Dawson%2C_Pennsylvania",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The First National Bank building, erected in 1897, once housed both a bank and offices for regional coal and coke businesses.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Dawson%2C_Pennsylvania",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Linden Hall, a 1913 mansion built for Sarah Cochran, stands as a fine example of early 20th‑century residential architecture.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://coalcampusa.com/westpa/connellsville/dawson-pennsylvania/dawson-pennsylvania.htm",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The Greater Tri‑Town Area Historical Society, founded in 1975, preserves Dawson’s heritage through its museum and historic sites like Dawson Station.",
      "sourceSentenceIds": [
        14,
        8
      ],
      "sourceLabels": [
        "Web source 2"
