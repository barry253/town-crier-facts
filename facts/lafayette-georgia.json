  "facts": [
    {
      "id": 1,
      "text": "LaFayette began as Chattooga in 1835 and was renamed in 1836 after the French Marquis de Lafayette.",
      "sourceSentenceIds": [
        3,
        5,
        6
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/LaFayette%2C_Georgia"
    },
    {
      "id": 2,
      "text": "The city proudly owns the historic Chattooga Academy, one of Walker County’s most cherished landmarks.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://mycityoflafayettega.org/community/welcome_to_lafayette.php"
    },
    {
      "id": 3,
      "text": "In 1864, cannonballs were stacked into a pyramid at the Battle of Lafayette site, now marked by a historic monument.",
      "sourceSentenceIds": [
        13
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.southernoutings.com/lafayette-georgia-historic-places/"
    },
    {
      "id": 4,
      "text": "Three buildings in LaFayette are listed on the National Register of Historic Places, highlighting its rich architectural heritage.",
      "sourceSentenceIds": [
        11
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.southernoutings.com/lafayette-georgia-historic-places/"
    },
    {
      "id": 5,
      "text": "LaFayette serves as the county seat of Walker County, anchoring the region’s administrative and historical life.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://mycityoflafayettega.org/community/welcome_to_lafayette.php"
    },
    {
      "id": 6,
      "text": "The town sits about 20 miles south of Chattanooga and 14 miles south of Chickamauga National Military Park, making it a convenient historic stop.",
