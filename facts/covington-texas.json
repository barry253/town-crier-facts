  "facts": [
    {
      "id": 1,
      "text": "Covington was founded in 1852 by Colonel James J. Gathings, who named the town after his wife Martha Wall Covington.",
      "sourceSentenceIds": [
        1,
        5,
        6,
        7
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1",
        "Web source 2"
      ],
      "source": "https://en.wikipedia.org/wiki/Covington%2C_Texas"
    },
    {
      "id": 2,
      "text": "Gathings set aside 100 acres of his ranch, originally worked by slave labor, to create the town’s nucleus.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.tshaonline.org/handbook/entries/covington-tx"
    },
    {
      "id": 3,
      "text": "The Texas and Brazos Valley Railroad reached Covington around 1904, but the line vanished in the early 1930s.",
      "sourceSentenceIds": [
        15,
        16
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://covingtontx.net/history"
    },
    {
      "id": 4,
      "text": "In the early 1860s, brothers James and Philip Gathings founded Gathings College in the town.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Covington%2C_Texas"
    },
    {
      "id": 5,
      "text": "Although the original town building no longer stands, a historical placard now marks its site.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Covington%2C_Texas"
    },
    {
      "id": 6,
      "text": "Covington lies about five miles from the Johnson County line in northwestern Hill County.",
