  "facts": [
    {
      "id": 1,
      "text": "Kapaa’s name means \"the solid one\" in Hawaiian, combining ka (the) and pa'a (solid).",
      "sourceSentenceIds": [
        23,
        24
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Kapa%CA%BBa%2C_Hawaii"
    },
    {
      "id": 2,
      "text": "The town’s historic Seto Building (1929) and Hee Fat Building (1924) were added to the National Register in 1979.",
      "sourceSentenceIds": [
        5,
        9
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://thingstodohawaii.com/islands/kauai/regions/east-side/kapaa-town/history-culture/"
    },
    {
      "id": 3,
      "text": "Kapaa’s Olympic Café occupies the former rice‑processing space of the Hee Fat Building, letting diners taste a space once humming with early industry.",
      "sourceSentenceIds": [
        2,
        20
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://thingstodohawaii.com/islands/kauai/regions/east-side/kapaa-town/history-culture/"
    },
    {
      "id": 4,
      "text": "A self‑guided walking tour through Kapaa’s Old Town showcases a blend of Chinese, Portuguese, Japanese, and American architecture, telling the town’s cultural story.",
      "sourceSentenceIds": [
        1,
        4
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://thingstodohawaii.com/islands/kauai/regions/east-side/kapaa-town/history-culture/"
    },
    {
      "id": 5,
      "text": "Kapaa’s annual Art Walk brings local artisans and musicians together, reflecting the island’s rich cultural scene.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.hawaiiactivities.com/travelguide/kapaa/"
    },
    {
      "id": 6,
      "text": "The Kapaʻa Public Library, part of the Hawaii State Public Library System, serves the community’s educational needs.",
