        29
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://vanburenmaine.com/about_our_town/index.php",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Van Buren’s growth was driven by lumber and railroad industries that shaped its early economy.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
