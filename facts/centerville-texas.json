  "facts": [
    {
      "id": 1,
      "text": "Centerville earned its name because it sits near the geographic center of Leon County.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Centerville%2C_Texas",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town became Leon County’s seat in 1850 after the old seat was deemed too far from the center.",
      "sourceSentenceIds": [
        5,
        9
      ],
      "sourceLabels": [
        "Web source 2",
        "Web source 1"
      ],
      "source": "https://www.tshaonline.org/handbook/entries/centerville-tx-leon-county",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Since 1937, Centerville has celebrated an annual Black‑Eyed Pea Festival that draws locals and visitors alike.",
      "sourceSentenceIds": [
        25
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Centerville%2C_Texas",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The town’s climate swings from scorching 111°F in 1948 to a record low of –1°F in 2022.",
      "sourceSentenceIds": [
        27
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Centerville%2C_Texas",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Centerville was bypassed by the International‑Great Northern Railroad in 1872, a blow that slowed its growth.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.tshaonline.org/handbook/entries/centerville-tx-leon-county",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The original 1850s festival tradition has evolved into a modern event featuring food, crafts, games, and fireworks.",
