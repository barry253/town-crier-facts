  "facts": [
    {
      "id": 1,
      "text": "Kingdom City originated when US Route 40 was built in 1925, becoming a crossroads that later grew into the village.",
      "sourceSentenceIds": [
        15
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Kingdom_City%2C_Missouri",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town’s name reflects Callaway County’s nickname, “Kingdom of Callaway,” chosen by Bernard Parker Beamer in the 1920s.",
      "sourceSentenceIds": [
        18
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Kingdom_City%2C_Missouri",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "In 1965, Gasper’s Truck Plaza, Motel and Restaurant opened, later becoming a local landmark that still draws travelers.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.callawaymohistory.org/mccredie-and-kingdom-city",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The Chicago and Alton Branch Railroad, laid in 1872, made McCredie a major stock‑yard and mule‑shipping hub, setting the stage for Kingdom City’s boom.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.callawaymohistory.org/mccredie-and-kingdom-city",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "A 2019 Firefighters’ Memorial building now houses an Educational and Historical Preservation Center, preserving the town’s heritage.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.callawaymohistory.org/mccredie-and-kingdom-city",
      "category": "landmark",
      "quality": "good"
    },
    {
