  "facts": [
    {
      "id": 1,
      "text": "Milnerton was founded in 1902 on the former farm Janbiesjeskraal and named after Sir Alfred Milner, the Cape Governor from 1897 to 1901.",
      "sourceSentenceIds": [
        5,
        6,
        7
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.vernonchalmers.photography/2025/08/history-of-milnerton-and-woodbridge.html"
    },
    {
      "id": 2,
      "text": "The Milnerton Lighthouse, a 21‑metre cylindrical tower, was completed in 1960 and stands on Woodbridge Island overlooking Table Bay.",
      "sourceSentenceIds": [
        12,
        10
      ],
      "sourceLabels": [
        "Web source 1",
        "Wikipedia"
      ],
      "source": "https://southafrica.co.za/history-milnerton.html"
    },
    {
      "id": 3,
      "text": "During the South African War, British troops built a wooden bridge in 1901 to defend Woodbridge Island against Boer guerrilla attacks.",
      "sourceSentenceIds": [
        11,
        21
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://southafrica.co.za/history-milnerton.html"
    },
    {
      "id": 4,
      "text": "Milnerton lies 11 kilometres north of Cape Town’s centre, on the Blaauwberg Coast of Table Bay, and is bordered by Goodwood to the south and Blouberg to the north.",
      "sourceSentenceIds": [
        27,
        28,
        30
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Milnerton"
    },
    {
      "id": 5,
      "text": "The suburb’s early growth was spurred by a rail line from Milnerton Junction that linked it directly to Cape Town’s urban core.",
