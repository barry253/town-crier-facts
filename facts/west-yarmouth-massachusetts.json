      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Old Yarmouth once encompassed lands now belonging to Chatham, Harwich, Brewster, Dennis, and Cummaquid.",
      "sourceSentenceIds": [
