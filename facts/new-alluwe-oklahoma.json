    {
      "id": 2,
      "text": "The community was originally established in January 1878 by John and Emma Campbell.",
      "sourceSentenceIds": [
        6,
        9
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://unitedstatesghosttowns.com/alluwe-oklahoma-ghost-town/"
    },
    {
      "id": 3,
      "text": "Before becoming Alluwe, the settlement was known as Lightning Creek, named after a nearby tributary of the Verdigris River.",
      "sourceSentenceIds": [
        7,
        22
      ],
      "sourceLabels": [
        "Web source 1",
        "Web source 2"
      ],
      "source": "https://www.okhistory.org/publications/enc/entry?entry=NE005"
    },
    {
      "id": 4,
      "text": "New Alluwe was established in the mid-twentieth century after the original townsite was relocated.",
      "sourceSentenceIds": [
        27
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/New_Alluwe%2C_Oklahoma"
    },
    {
      "id": 5,
      "text": "The original town of Alluwe is now a ghost town that lies at the bottom of Oologah Lake.",
      "sourceSentenceIds": [
        26,
        28
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/New_Alluwe%2C_Oklahoma"
    },
    {
      "id": 6,
      "text": "Oologah Lake was created in the 1950s after the Army Corps of Engineers built a dam across the Verdigris River.",
      "sourceSentenceIds": [
        20,
