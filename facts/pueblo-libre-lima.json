  "facts": [
    {
      "id": 1,
      "text": "Founded in 1557 as Magdalena Vieja, Pueblo Libre was renamed Pueblo de los Libres in 1821 by José de San Martín.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Pueblo_Libre_District%2C_Lima"
    },
    {
      "id": 2,
      "text": "The colonial mansion Palacio de la Magdalena now houses Peru’s National Museum of Archaeology, Anthropology and History.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Pueblo_Libre_District%2C_Lima"
    },
    {
      "id": 3,
      "text": "Plaza de la Bandera, also called Flag Square, is a monumental square dedicated to the Peruvian flag.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Pueblo_Libre_District%2C_Lima"
    },
    {
      "id": 4,
      "text": "La Cruz del Viajero, one of Pueblo Libre's oldest attractions, stands as a historic landmark.",
      "sourceSentenceIds": [
        30
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Pueblo_Libre_District%2C_Lima"
    },
    {
      "id": 5,
      "text": "The historic Quinta de los Libertadores, also known as Magdalena Palace, welcomed Simón Bolívar and José de San Martín.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://pueblolibrelima.com/"
    },
    {
