  "facts": [
    {
      "id": 1,
      "text": "During 1914‑1918, Katowice escaped the devastation of World War I, a rare calm for a city in the industrial heart of Silesia.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.katowice.eu/en/en/katowice-city/history",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "In the early 20th century, Katowice welcomed consulates from 12 countries, alongside steelworks, mines, factories and banks that fueled its growth.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.katowice.eu/en/en/katowice-city/history",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Rapid industrial investment turned the village of Katowice into a bustling city, a transformation highlighted by Web source 2.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://portal.katowice.pl/portal-katowice-in-english",
      "category": "history",
      "quality": "poor",
      "qualityReason": "other"
    },
    {
      "id": 4,
      "text": "The city’s early 20th‑century skyline grew with a new railway station, Neo‑Gothic Church of Saints Peter and Paul, and a City Theatre.",
      "sourceSentenceIds": [
        14
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.katowice.eu/en/en/katowice-city/history",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "After Poland’s 1918 independence, Katowice’s future hinged on the Silesian Uprisings and a 1919‑1921 plebiscite.",
      "sourceSentenceIds": [
        15
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.katowice.eu/en/en/katowice-city/history",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "World War actions bypassed Katowice, yet the city’s mining and metallurgy sectors surged, driven by wartime demand.",
      "sourceSentenceIds": [
        16
      ],
