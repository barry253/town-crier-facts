  "facts": [
    {
      "id": 1,
      "text": "Venus got its name from Venus Housby, the daughter of a local physician, when the town was founded in the late 1880s.",
      "sourceSentenceIds": [
        3,
        9
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Venus%2C_Texas",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town sprang up when Jabe Smyth laid out eighty acres of abandoned cornfields in 1888, turning a quiet railroad stop into a bustling community.",
      "sourceSentenceIds": [
        8,
        23
      ],
      "sourceLabels": [
        "Web source 1",
        "Wikipedia"
      ],
      "source": "https://www.mansfieldtexas.gov/1406/Venus",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The Venus Express newspaper began in 1901, and the town officially incorporated in 1903 after three banks and a thriving local economy emerged.",
      "sourceSentenceIds": [
        21
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.texasalmanac.com/places/venus",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "During the Great Depression the town’s growth stalled, and many residents moved north into the expanding Dallas–Fort Worth metroplex for work.",
      "sourceSentenceIds": [
        24,
        25
      ],
      "sourceLabels": [
        "Wikipedia",
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Venus%2C_Texas",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Venus sits in northeastern Johnson County, about 31 miles south of Dallas and 31 miles southeast of Fort Worth, placing it within easy reach of both cities.",
