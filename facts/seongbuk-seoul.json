  "facts": [
    {
      "id": 1,
      "text": "Seongbuk derives its name from Korean meaning \"north of the capital,\" referring to the area north of the old city walls.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Seongbuk_District",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Hyehwamun gate, once called Honghwamun, is a well‑preserved auxiliary gate of Seoul’s ancient city wall.",
      "sourceSentenceIds": [
        1,
        11
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Seongbuk_District",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Gilsangsa temple blends modern history with Buddhist tradition, originally a high‑end restaurant before becoming a meditation center.",
      "sourceSentenceIds": [
        12,
        24
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Seongbuk_District",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Jangchungdan Park marks the spot where King Gojong proclaimed Korea’s independence from Japan in 1897.",
      "sourceSentenceIds": [
        15
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.koreatripguide.com/destinations/historical-landmarks-and-sightseeing-around-seongbuk-gu-seoul",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Seongbuk hosts the Seongbuk Culture Festival each October, showcasing performances, exhibitions, and hands‑on experiences celebrating local heritage.",
      "sourceSentenceIds": [
        16
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.koreatripguide.com/destinations/historical-landmarks-and-sightseeing-around-seongbuk-gu-seoul",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The district is home to the burial sites of Joseon royalty, including Uireung for King Gyeongjong and Jeongneung for Queen Sindeok.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
