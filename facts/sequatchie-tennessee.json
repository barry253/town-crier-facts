  "facts": [
    {
      "id": 1,
      "text": "Sequatchie is an unincorporated community in Marion County, Tennessee, tucked into the southwestern Sequatchie Valley at the foot of the Cumberland Plateau.",
      "sourceSentenceIds": [
        17,
        18
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Sequatchie%2C_Tennessee",
      "category": "other",
      "quality": "poor",
      "qualityReason": "location_description"
    },
    {
      "id": 2,
      "text": "The Little Sequatchie River skirts the north and east of the community, lending its name to the valley.",
      "sourceSentenceIds": [
        19
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Sequatchie%2C_Tennessee",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Valley View Road runs through Sequatchie, linking it to Whitwell to the northeast and Jasper to the southwest.",
      "sourceSentenceIds": [
        20
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Sequatchie%2C_Tennessee",
      "category": "transport",
      "quality": "poor",
      "qualityReason": "route_only"
    },
    {
      "id": 4,
      "text": "Sequatchie County was created in 1857 from parts of Hamilton and Marion counties, with Dunlap chosen as the county seat.",
      "sourceSentenceIds": [
        21,
        16
      ],
      "sourceLabels": [
        "Web source 1",
        "Web source 2"
      ],
      "source": "https://sos.tn.gov/tsla/pages/genealogical-fact-sheets-about-sequatchie-county",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Anderson Pike, built in 1852, carried farmers’ livestock out of the valley to the Western and Atlantic Railroad, opening larger markets.",
