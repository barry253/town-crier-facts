  "facts": [
    {
      "id": 1,
      "text": "Dillingham sits where the Wood and Nushagak rivers meet, a spot chosen for its strategic access to Bristol Bay.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.kupi.com/en-ae/explore/united-states/dillingham/history",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "In 1818 Russian explorer Alexander Baranov founded the Alexandrovsk Redoubt at the Nushagak mouth, sparking trade with fur hunters.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/Dillingham,_Alaska",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The town’s name honors U.S. Senator William Paul Dillingham, who investigated Alaska after the 1898 gold rush.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Dillingham%2C_Alaska",
      "category": "people",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Dillingham’s economy thrives on the Bristol Bay sockeye salmon fishery, which supports thousands of seasonal jobs and multi‑million‑dollar harvests.",
      "sourceSentenceIds": [
        24
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/Dillingham,_Alaska",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The city’s geography places it at the northern end of Nushagak Bay, where the Nushagak and Wood Rivers form a large estuary.",
      "sourceSentenceIds": [
        13
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/Dillingham,_Alaska",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "A Russian Orthodox mission established in 1837 and the first salmon cannery opened in 1884 marked Dillingham’s early industrial growth.",
      "sourceSentenceIds": [
        24
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/Dillingham,_Alaska",
