  "facts": [
    {
      "id": 1,
      "text": "Junction City grew around the meeting point of two important railroad lines, the Soo Line and the Milwaukee Road.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.junctioncitywisconsin.gov/"
    },
    {
      "id": 2,
      "text": "A post office was established in 1874 under the name Junction, and the community incorporated as Junction City in 1911.",
      "sourceSentenceIds": [
        2,
        15
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Junction_City%2C_Wisconsin"
    },
    {
      "id": 3,
      "text": "Early growth in Junction City was rapid, jumping from two log shanties to several mills and hotels by 1876.",
      "sourceSentenceIds": [
        16,
        17
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Junction_City%2C_Wisconsin"
    },
    {
      "id": 4,
      "text": "Graphite was discovered in the area during the 1890s and processed in a crushing mill northwest of Junction City.",
      "sourceSentenceIds": [
        23,
        24
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Junction_City%2C_Wisconsin"
    },
    {
      "id": 5,
      "text": "Junction City once operated four potato warehouses to serve the farmers in the surrounding Town of Carson.",
      "sourceSentenceIds": [
        27
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Junction_City%2C_Wisconsin"
    },
    {
