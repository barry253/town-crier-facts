  "facts": [
    {
      "id": 1,
      "text": "Polonia was established in the 1850s and is recognized as the first sizable Polish agricultural settlement in Wisconsin.",
      "sourceSentenceIds": [
        1,
        8
      ],
      "sourceLabels": [
        "Web source 1",
        "Wikipedia"
      ],
      "source": "https://grokipedia.com/page/polonia_wisconsin"
    },
    {
      "id": 2,
      "text": "Father Joseph Dabrowski named the settlement Polonia to recognize its Polish heritage during the relocation of the local parish.",
      "sourceSentenceIds": [
        2,
        10
      ],
      "sourceLabels": [
        "Web source 1",
        "Wikipedia"
      ],
      "source": "https://grokipedia.com/page/polonia_wisconsin"
    },
    {
      "id": 3,
      "text": "The community's church was relocated to a hilltop site in 1871 to escape disruptions from local saloons.",
      "sourceSentenceIds": [
        30
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/polonia_wisconsin"
    },
    {
      "id": 4,
      "text": "Five Felician Sisters from Kraków, Poland, arrived in 1874 to staff a new church school in Polonia.",
      "sourceSentenceIds": [
        11
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Polonia%2C_Wisconsin"
    },
    {
      "id": 5,
      "text": "Sacred Heart Parish serves as a central focal point for community events and worship in Polonia today.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/polonia_wisconsin"
    },
    {
      "id": 6,
      "text": "Rolling terrain and fertile loamy soils make the landscape around Polonia well-suited for farming.",
      "sourceSentenceIds": [
