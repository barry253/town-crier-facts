    },
    {
      "id": 2,
      "text": "The 1909 Egleston Square substation, built by the Boston Elevated Railway, converted AC power to DC for streetcars and elevated trains.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
