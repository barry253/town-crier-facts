  "facts": [
    {
      "id": 1,
      "text": "Natchez, Louisiana, is one of the oldest communities in the Louisiana Purchase territory and sits on Isle Brevelle.",
      "sourceSentenceIds": [
        17,
        16
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Natchez%2C_Louisiana"
    },
    {
      "id": 2,
      "text": "The village’s oldest church, founded in 1803 by Augustin Métoyer and his wife, has held services continuously since then.",
      "sourceSentenceIds": [
        20,
        21
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Natchez%2C_Louisiana"
    },
    {
      "id": 3,
      "text": "Natchez emerged as a refuge for Natchez people displaced from the Mississippi River after conflicts with European colonists seeking tobacco plantations.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/natchez_louisiana"
    },
    {
      "id": 4,
      "text": "The village lies along the Texas and Pacific Railroad line and serves as a gateway to the Cane River National Heritage Area.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/natchez_louisiana"
    },
    {
      "id": 5,
      "text": "Cherokee Plantation, owned by Charles Emile Sompayrac by 1839, was named for the abundant Cherokee roses on the property.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/natchez_louisiana"
    },
    {
      "id": 6,
      "text": "Magnolia Plantation, founded in 1835 by Ambrose LeComte II and Julia Buard, became one of the area’s premier operations.",
      "sourceSentenceIds": [
        9
      ],
