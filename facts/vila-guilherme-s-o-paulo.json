  "facts": [
    {
      "id": 1,
      "text": "Vila Guilherme was founded in 1917 when Guilherme Praun da Silva acquired 115 acres from the barão de Ramalho and named streets after his family and friends.",
      "sourceSentenceIds": [
        14,
        15
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://prefeitura.sp.gov.br/web/vila_maria_vila_guilherme/w/historico/389"
    },
    {
      "id": 2,
      "text": "Between the 1930s and 1970s, Portuguese immigrants made up about 70% of Vila Guilherme’s population, turning it into a traditional Portuguese enclave.",
      "sourceSentenceIds": [
        16,
        20
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://prefeitura.sp.gov.br/web/vila_maria_vila_guilherme/w/historico/389"
    },
    {
      "id": 3,
      "text": "The first wooden bridge over the Tietê River in Vila Guilherme opened in 1918, ending the era of boat-only crossings.",
      "sourceSentenceIds": [
        9,
        10
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://prefeitura.sp.gov.br/web/vila_maria_vila_guilherme/w/historico/389"
    },
    {
      "id": 4,
      "text": "Vila Guilherme is home to two universities—UNIBAN and UNIP—making it a notable academic hub in São Paulo.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.encontravilaguilherme.com.br/vila-guilherme/"
    },
    {
      "id": 5,
      "text": "The Sociedade Paulista do Trote, founded by Portuguese settlers, once attracted 10,000 spectators in the 1970s and even fielded a football team.",
      "sourceSentenceIds": [
        28,
        29
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://prefeitura.sp.gov.br/web/vila_maria_vila_guilherme/w/historico/389"
    },
    {
      "id": 6,
      "text": "Before becoming Vila Guilherme, the land was known as “Tapera” and was granted as a sesmaria to Salvador Pires de Almeida in the 18th century.",
