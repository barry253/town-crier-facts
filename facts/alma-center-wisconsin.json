    },
    {
      "id": 2,
      "text": "Pioneers including Peter Hall and the Warren brothers first settled Alma Center around 1850, establishing early lumber mills along Hall's Creek.",
      "sourceSentenceIds": [
        1,
        28
      ],
      "sourceLabels": [
        "Web source 1"
