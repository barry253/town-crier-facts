  "facts": [
    {
      "id": 1,
      "text": "Fort Mitchell earned its name from a popular woman surnamed Mitchell, with locals jokingly asking, \"Who is holding the fort now?\".",
      "sourceSentenceIds": [
        1,
        2
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/fort_mitchell_virginia"
    },
    {
      "id": 2,
      "text": "The town sprang up around a railroad depot built in 1875, becoming the only surviving station in Lunenburg County after a once‑extensive network of seven depots.",
      "sourceSentenceIds": [
        1,
        11
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/fort_mitchell_virginia"
    },
    {
      "id": 3,
      "text": "Zion Baptist Church, erected in 1835 on land owned by John Gregory, stands as one of the oldest religious structures in the area.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/fort_mitchell_virginia"
    },
    {
      "id": 4,
      "text": "Fort Mitchell’s historic core, now a candidate for the National Register, showcases vernacular architecture from the Reconstruction era through the 1920s.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/fort_mitchell_virginia"
    },
    {
      "id": 5,
      "text": "Located at 36°55′5.30″N 78°29′9.99″W, Fort Mitchell sits just east of U.S. Route 360 in the rural western part of Lunenburg County.",
      "sourceSentenceIds": [
