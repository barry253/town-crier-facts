    },
    {
      "id": 2,
      "text": "Kimberly emerged as a modest community during the industrialization of West Virginia's southern coalfields in the late 19th and early 20th centuries.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 1"
      ],
