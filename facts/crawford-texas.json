  "facts": [
    {
      "id": 1,
      "text": "Crawford was probably named for Nelson Crawford, who graded the river crossing that gave the town its early name.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.tshaonline.org/handbook/entries/crawford-tx",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "By 1890 the railroad had shifted the community’s focus, and Crawford boasted steam flour and corn mills, a cotton gin, and four churches.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.tshaonline.org/handbook/entries/crawford-tx",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The town incorporated on August 12, 1897, marking its formal start as a municipality in western McLennan County.",
      "sourceSentenceIds": [
        19
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Crawford%2C_Texas",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Crawford is best known as the home of the 43rd U.S. president, George W. Bush, who spends part of his time at the nearby Prairie Chapel Ranch.",
      "sourceSentenceIds": [
        20,
        21
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Crawford%2C_Texas",
      "category": "people",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "A 2008 documentary film titled *Crawford* chronicles the town’s transformation after President Bush’s arrival.",
      "sourceSentenceIds": [
        14
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Crawford%2C_Texas",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Crawford lies within the Waco Metropolitan Statistical Area, linking it to the larger regional economy and culture.",
