  "facts": [
    {
      "id": 1,
      "text": "Joseph City was founded in 1876 by a group of 73 Latter‑Day Saints pioneers led by Captain William C.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Joseph_City%2C_Arizona"
    },
    {
      "id": 2,
      "text": "The town was named to honor Joseph Smith, founder of the Latter‑Day Saint movement.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://earthsmajesticlandscapes.com/discoveries/joseph-city/"
    },
    {
      "id": 3,
      "text": "Joseph City was one of four Little Colorado River colonies, the others being Brigham City, Sunset, and Obed.",
      "sourceSentenceIds": [
        11,
        12
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Joseph_City%2C_Arizona"
    },
    {
      "id": 4,
      "text": "Today, Joseph City is the only remaining colony from that original group.",
      "sourceSentenceIds": [
        13
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Joseph_City%2C_Arizona"
    },
    {
      "id": 5,
      "text": "Colonists built eleven dams on the Little Colorado River, the first in 1876 and the last surviving one still directs water today.",
      "sourceSentenceIds": [
        16,
        20
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Joseph_City%2C_Arizona"
    },
    {
      "id": 6,
      "text": "The town sits in a semi‑arid climate zone, with cold winters that rarely bring measurable snowfall.",
