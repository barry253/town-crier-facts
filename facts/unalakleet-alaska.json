  "facts": [
    {
      "id": 1,
      "text": "Unalakleet in Alaska comes from the Iñupiaq word 'Una-la-thliq', meaning 'from the southern side'.",
      "sourceSentenceIds": [
        14
      ],
      "sourceLabels": [
        "Wikipedia"
