  "facts": [
    {
      "id": 1,
      "text": "Whitefish Bay became Milwaukee County’s first incorporated village in 1886, marking the start of its formal civic life.",
      "sourceSentenceIds": [
        25
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Whitefish_Bay%2C_Wisconsin",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "In 1889, Frederick Pabst purchased land here and opened the Pabst Whitefish Bay Resort, complete with a hotel, beer garden, and bandshell.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Whitefish_Bay%2C_Wisconsin",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "At its peak, the resort welcomed up to 15,000 visitors each weekend and even hosted President Theodore Roosevelt.",
      "sourceSentenceIds": [
        23
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Whitefish_Bay%2C_Wisconsin",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "A steam-powered tram, the Milwaukee & Whitefish Bay Railroad, began running in 1886, later replaced by electric streetcars in 1898.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Whitefish_Bay%2C_Wisconsin",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "After the resort closed in 1914, the lakeshore was divided into seventeen residential lots, including the Herman Uihlein Mansion now on the National Register.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Whitefish_Bay%2C_Wisconsin",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The 1908 Whitefish Bay Armory trained soldiers for the Mexican border war, World Wars I and II, and the Korean War.",
      "sourceSentenceIds": [
        8,
        9
      ],
