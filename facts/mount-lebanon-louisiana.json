    {
      "id": 1,
      "text": "Mount Lebanon was probably the first permanent settlement in what is now Bienville Parish.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Mount_Lebanon%2C_Louisiana",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Baptists from South Carolina founded the town, quickly building a church and school.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Mount_Lebanon%2C_Louisiana",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The town’s early school became Mount Lebanon University in 1853, then served as a Confederate hospital during the Civil War.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Mount_Lebanon%2C_Louisiana",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The Mount Lebanon Baptist Church, organized in 1837, still stands; its sanctuary once divided men and women, with a balcony for slaves.",
      "sourceSentenceIds": [
        10,
        13,
        14
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Mount_Lebanon%2C_Louisiana",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Eight historic buildings, including a former stagecoach stop and hotel, are listed on the National Register of Historic Places.",
      "sourceSentenceIds": [
