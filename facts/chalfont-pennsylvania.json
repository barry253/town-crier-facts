  "facts": [
    {
      "id": 1,
      "text": "Chalfont takes its name from Chalfont St Giles in Buckinghamshire, England.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Chalfont%2C_Pennsylvania",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "In 1720, Simon Butler bought over 150 acres that included the Village of Chalfont, sparking the borough’s growth.",
      "sourceSentenceIds": [
        1,
        28
      ],
      "sourceLabels": [
        "Web source 1",
        "Wikipedia"
      ],
      "source": "https://chalfontborough.com/history/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "A 1855 train station on the Doylestown Branch sparked a Victorian‑era boom, prompting many historic homes.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Chalfont%2C_Pennsylvania",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Simon Butler not only built the Butler Mill but also laid out Butler Pike, the main road through early Chalfont.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://chalfontborough.com/history/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "In 1869 the North Penn Railroad renamed the station to Chalfont, cementing the town’s identity.",
      "sourceSentenceIds": [
        20
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Chalfont%2C_Pennsylvania",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Even today, the historic district’s facades reveal layers of Chalfont’s past, from colonial to Victorian.",
      "sourceSentenceIds": [
        13
      ],
      "sourceLabels": [
