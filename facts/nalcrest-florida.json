  "facts": [
    {
      "id": 1,
      "text": "Nalcrest’s name is an acronym for National Association of Letter Carriers Retirement, Education, Security and Training, reflecting its roots in the postal union.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Nalcrest%2C_Florida",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "William Doherty, president of the National Association of Letter Carriers from 1941 to 1962, conceived Nalcrest as a retirement haven for mail carriers.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.floridaforboomers.com/nalcrest/",
      "category": "people",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Construction kicked off in July 1962, and Nalcrest welcomed its first residents the following year in 1963.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Nalcrest%2C_Florida",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "After the community paid off its mortgage in 2002, HUD restrictions lifted, limiting residency to NALC retirees in good standing.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Nalcrest%2C_Florida",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Nalcrest spans 253 acres, with 500 garden‑style apartments developed on 153 acres and a 15‑acre manmade lake.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Nalcrest%2C_Florida",
      "category": "nature",
      "quality": "good"
    },
    {
