  "facts": [
    {
      "id": 1,
      "text": "Originally named Warren after Revolutionary War hero Joseph Warren, the town was renamed Dundee by stationmaster G. when the post office opened in 1879.",
      "sourceSentenceIds": [
        1,
        2,
        3,
        4
      ],
      "sourceLabels": [
        "Web source 1",
        "Wikipedia"
      ],
      "source": "https://grokipedia.com/page/dundee_minnesota",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town was surveyed and platted in July 1879, and a depot construction began August 13.",
      "sourceSentenceIds": [
        17
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Dundee%2C_Minnesota",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The Paul and Sioux City Railway Company built a Heron Lake & Black Hills Railroad branch that linked rural southwest Minnesota to larger markets and moved grain.",
      "sourceSentenceIds": [
        7,
        10
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Dundee%2C_Minnesota",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The town's early settlement was sparse before 1879, with subsistence farming on Dakota Sioux lands ceded by the 1851 Traverse des Sioux treaty and the 1862 Homestead Act.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/dundee_minnesota",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Dundee was incorporated on January 4, 1898, after citizens petitioned and county commissioners granted the request.",
