  "facts": [
    {
      "id": 1,
      "text": "Elkton was founded in 1820 by Major John Gray and officially chartered by the state assembly.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Elkton%2C_Kentucky"
    },
    {
      "id": 2,
      "text": "The town’s name comes from the Elk Fork of the Red River, where elk once roamed.",
      "sourceSentenceIds": [
        2,
        9
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://kyatlas.com/ky-elkton.html"
    },
    {
      "id": 3,
      "text": "Elkton’s original site on Elk Fork was founded in 1817 but moved half a mile west in 1820 after the county formed.",
      "sourceSentenceIds": [
        29
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://kyatlas.com/ky-elkton.html"
    },
    {
      "id": 4,
      "text": "Downtown Elkton boasts a well‑preserved historic district that houses the Todd County Welcome Center.",
      "sourceSentenceIds": [
