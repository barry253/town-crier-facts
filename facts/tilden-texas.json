      "id": 1,
      "text": "Tilden was founded in 1858 at the mouth of Leoncita Creek on the Frio River, one of McMullen County’s first settlements.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 1"
      ],
