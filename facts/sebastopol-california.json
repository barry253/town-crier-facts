      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Horticulturist Luther Burbank once ran an 18‑acre Gold Ridge Experiment Farm right in Sebastopol, turning the town into a botanical laboratory.",
      "sourceSentenceIds": [
        2,
        5,
        27
      ],
      "sourceLabels": [
