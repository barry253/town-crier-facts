  "facts": [
    {
      "id": 1,
      "text": "Trucksville named after founder William Trucks, a Connecticut-born millwright who settled there in 1796.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/trucksville_pennsylvania",
      "category": "people",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "William Trucks built the first log grist and saw mills on Toby Creek by 1804, sparking early settlement.",
      "sourceSentenceIds": [
        23
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/trucksville_pennsylvania",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "In the late 19th century, Trucksville became a railroad stop on the Lehigh Valley Railroad's Harveys Lake branch, supporting local slaughterhouses and stores.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/trucksville_pennsylvania",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The Trucksville United Methodist Church, founded in 1844, has hosted community events for over a century.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/trucksville_pennsylvania",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The township that surrounds Trucksville was officially formed in 1790 and gained Home Rule status in 1976, preserving its rural character.",
      "sourceSentenceIds": [
        15
      ],
      "sourceLabels": [
        "Web source 1"
