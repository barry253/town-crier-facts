  "facts": [
    {
      "id": 1,
      "text": "Villa Heights was built in 1820 for Lt. Elijah McClanahan, a War of 1812 veteran who owned most of the land that became the town.",
      "sourceSentenceIds": [
        4,
        6
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.dhr.virginia.gov/historic-registers/128-0012/"
    },
    {
      "id": 2,
      "text": "McClanahan was one of the largest landholders in Roanoke County and helped found Salem Presbyterian Church.",
      "sourceSentenceIds": [
        12,
        13
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.dhr.virginia.gov/historic-registers/128-0012/"
    },
    {
      "id": 3,
      "text": "The original house was a two‑story Federal style dwelling with a single‑pile floor plan and a center passage.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.dhr.virginia.gov/historic-registers/128-0012/"
    },
    {
      "id": 4,
      "text": "In the early 1900s the house received Classical Revival updates, adding interior trim and exterior columns that echo the era’s taste.",
      "sourceSentenceIds": [
        8,
        10
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.dhr.virginia.gov/historic-registers/128-0012/"
    },
    {
      "id": 5,
      "text": "Its façade features a dramatic portico with Doric columns, fluted pilasters, a fanlight, and sidelights at the main entrance.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.dhr.virginia.gov/historic-registers/128-0012/"
    },
    {
      "id": 6,
      "text": "Villa Heights was officially listed on the National Register of Historic Places on June 4, 2018.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.dhr.virginia.gov/historic-registers/128-0012/"
    }
  ]
}
