      "id": 1,
      "text": "Gresham was founded in 1851 as Campground, a small agricultural community.",
      "sourceSentenceIds": [
        11
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.visitoregon.com/cities/gresham-oregon/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The city was renamed Gresham in 1905 to honor Walter Quinton Gresham, former Postmaster General.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.visitoregon.com/cities/gresham-oregon/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The Gresham Carnegie Library, built in 1913, began as a small book collection in a general store.",
      "sourceSentenceIds": [
        29
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Gresham%2C_Oregon",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The Zimmerman House, a farmhouse built by German‑American settlers in 1874, is listed on the National Register of Historic Places.",
      "sourceSentenceIds": [
        19,
        15
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Gresham%2C_Oregon",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The Gresham Historical Society preserves the town’s heritage through exhibits, while the Gresham Center for the Arts showcases local artists.",
