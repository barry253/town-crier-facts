  "facts": [
    {
      "id": 1,
      "text": "Gate City earned its name in 1886 when Attorney General Rufus A. Ayers noted its position as the “Gate Way to the West” near Big Moccasin Gap.",
      "sourceSentenceIds": [
        26,
        27
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Gate_City%2C_Virginia"
    },
    {
      "id": 2,
      "text": "The town’s historic district spans five blocks and houses the 1829 Scott County Courthouse, a centerpiece of early 19‑century architecture.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.islands.com/1997963/gate-city-virginia-gateway-west-blends-downtown-shops-inns-trails-cave-adventures/"
    },
    {
      "id": 3,
      "text": "In 1958, Pilot Flying J, the largest North American travel‑center network, was founded in Gate City, linking the town to a national brand.",
      "sourceSentenceIds": [
        13
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Gate_City%2C_Virginia"
    },
    {
      "id": 4,
      "text": "Gate City sits on the old Wilderness Road, laid out in 1815, and was a key stop for settlers heading west along the Daniel Boone Trail.",
      "sourceSentenceIds": [
        4,
        5
      ],
      "sourceLabels": [
        "Web source 1",
        "Web source 2"
      ],
      "source": "https://www.dhr.virginia.gov/historic-registers/221-5010/"
    },
    {
      "id": 5,
      "text": "The town’s main street once honored Andrew Jackson, the future president, highlighting its early patriotic spirit.",
