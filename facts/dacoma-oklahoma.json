    {
      "id": 1,
      "text": "Dacoma is a rural town located in Woods County, Oklahoma.",
      "sourceSentenceIds": [
        10,
        15
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Dacoma%2C_Oklahoma"
    },
    {
      "id": 2,
      "text": "The community of Dacoma is located on land originally homesteaded by two African Americans, Nathan Dedman and Frank Kinberling.",
      "sourceSentenceIds": [
        26
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.okhistory.org/publications/enc/entry?entry=DA001"
    },
    {
      "id": 3,
      "text": "Dacoma was platted in August 1904, with a locust tree used to mark the corner of each block.",
      "sourceSentenceIds": [
        27
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.okhistory.org/publications/enc/entry?entry=DA001"
    },
    {
      "id": 4,
      "text": "The name Dacoma is a combination of Dakota and Oklahoma, replacing the town's original post office name of Zula.",
      "sourceSentenceIds": [
        28
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.okhistory.org/publications/enc/entry?entry=DA001"
    },
    {
      "id": 5,
      "text": "Postal officials used a letter c instead of the proposed k when officially naming Dacoma in October 1904.",
      "sourceSentenceIds": [
        29
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.okhistory.org/publications/enc/entry?entry=DA001"
    },
    {
      "id": 6,
      "text": "Numerous business establishments once served the needs of homesteaders in the early days of Dacoma.",
      "sourceSentenceIds": [
        30
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.okhistory.org/publications/enc/entry?entry=DA001"
