      "id": 1,
      "text": "Chesapeake Ranch Estates was founded in 1958 and is governed by the Property Owner's Association of the Chesapeake Ranch Estates (POACRE).",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
