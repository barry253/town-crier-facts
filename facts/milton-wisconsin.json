      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Milton House Museum, an 1844 stagecoach inn, is a National Historic Landmark and authentic Underground Railroad stop that sheltered fugitives.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.visitmilton.com/Visit-Milton",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Every May, Milton hosts Civil War Living History Days, where reenactors demonstrate cannon fire and visitors meet a replica of Abraham Lincoln.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.visitmilton.com/Visit-Milton",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The Seventh Day Baptist Church, built in 1934, earned a spot on the National Register of Historic Places in 2016.",
