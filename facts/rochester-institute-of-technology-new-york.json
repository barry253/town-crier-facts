  "facts": [
    {
      "id": 1,
      "text": "RIT began when the Rochester Athenaeum, a literary society founded in 1829, merged with the Mechanics Institute, a technical school started in 1885.",
      "sourceSentenceIds": [
        1,
        2,
        16,
        19
      ],
      "sourceLabels": [
        "Web source 1",
        "Wikipedia"
      ],
      "source": "https://www.rit.edu/history-rit",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "In 1961, a $3.27 million donation from Grace Watson let RIT buy a 1,300‑acre campus south of Rochester along the Genesee River.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Rochester_Institute_of_Technology",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "RIT became the first U.S. college to host the National Technical Institute for the Deaf in 1966, a pioneering program for deaf students.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Rochester_Institute_of_Technology",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The campus’s Field House, opened in 2004, was named after Lucius “Bob” Gordon and his wife Marie and hosts concerts, graduations, and sports.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Rochester_Institute_of_Technology",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "In 2009, RIT earned the title “Campus Sustainability Leader” from the Sustainable Endowments Institute for its green initiatives.",
