    {
      "id": 1,
      "text": "Lake Dunlap was created in 1928 when the Guadalupe River was dammed to generate hydroelectric power and provide recreation.",
      "sourceSentenceIds": [
        14
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.trawellino.com/destinations/united-states/texas_lake-dunlap",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The reservoir lies nine miles northwest of Seguin along the Guadalupe River, roughly eight miles from the city center.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.tshaonline.org/handbook/entries/lake-dunlap",
      "category": "other",
      "quality": "poor",
      "qualityReason": "location_description"
    },
    {
      "id": 3,
      "text": "A dam failure in 2019 drained Lake Dunlap, but repairs finished in August 2023 and the lake was fully restored by October.",
      "sourceSentenceIds": [
        22,
        23
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Lake_Dunlap%2C_Texas",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Residential development around Lake Dunlap began in the 1970s, shaping the lakeside community into the suburb seen today.",
      "sourceSentenceIds": [
        26
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Lake_Dunlap%2C_Texas",
      "category": "people",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Lake Dunlap is part of the San Antonio–New Braunfels metropolitan area, linking it to a larger regional economy.",
      "sourceSentenceIds": [
        21
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Lake_Dunlap%2C_Texas",
      "category": "economy",
      "quality": "good",
      "qualityReason": "vague"
    },
    {
