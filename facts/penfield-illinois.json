  "facts": [
    {
      "id": 1,
      "text": "Penfield was laid out in 1876 and named after John Penfield of Rantoul.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Penfield%2C_Illinois",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The Havana, Rantoul and Eastern Railroad crossed the area in 1875, and the town was surveyed in 1876 on its tracks.",
      "sourceSentenceIds": [
        11,
        14
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://champaign.illinoisgenweb.org/documents/C107226ED7757F4F23D07FEC37E95C88BB678B27.html",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "A tile factory opened in 1880 by Ben Gifford marked Penfield’s early industrial growth.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://champaign.illinoisgenweb.org/documents/C107226ED7757F4F23D07FEC37E95C88BB678B27.html",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The creek that flows through the original Buck Grove area is now called Buck Creek, feeding the Middlefork of the Vermillion River.",
      "sourceSentenceIds": [
        2,
        3
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://champaign.illinoisgenweb.org/documents/C107226ED7757F4F23D07FEC37E95C88BB678B27.html",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Penfield’s early settlers came from Ohio and Vermont, seeking better lives westward in the 1830s.",
