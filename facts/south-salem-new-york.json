  "facts": [
    {
      "id": 1,
      "text": "Long before settlers, South Salem's woodlands were hunted and fished by the Kitchawank, Saugatuck, Siwanoy, and Wecquasgeek peoples.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/South_Salem,_New_York",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "South Salem still echoes its colonial past with the 18th‑century Presbyterian Church Graveyard and the Federal‑style Homestead on Mead Street.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/South_Salem,_New_York",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Renamed Lower Salem in 1783, the hamlet became South Salem in 1806 before adopting the name Lewisboro in 1840 after John Lewis's $10,000 school donation.",
      "sourceSentenceIds": [
        5,
        8
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/South_Salem,_New_York",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The Osborn‑Bouton‑Mead House, a Federal‑style landmark, earned a spot on the National Register of Historic Places in 2004.",
      "sourceSentenceIds": [
        10,
        15
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/South_Salem%2C_New_York",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "South Salem’s quiet streets host a modest commercial core along Route 123, while the nearby Golden’s Bridge Metro‑North station links residents to Manhattan.",
      "sourceSentenceIds": [
        17
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/South_Salem,_New_York",
      "category": "transport",
      "quality": "good",
      "qualityReason": "editorial_filler"
    },
    {
      "id": 6,
      "text": "During the Revolutionary War, a local home in South Salem briefly served as a prison for British spy Major John André in 1780.",
      "sourceSentenceIds": [
        23
