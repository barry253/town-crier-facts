  "facts": [
    {
      "id": 1,
      "text": "Diagonal earned its name because two major railroads crossed at a diagonal angle just north of the town site.",
      "sourceSentenceIds": [
        2,
        3
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Diagonal%2C_Iowa",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Before becoming Diagonal, the settlement was informally called Hak‑a‑dady, then renamed Morton in February 1889, and finally adopted the name Diagonal in March 1889.",
      "sourceSentenceIds": [
        1,
        6,
        7
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://iagenweb.org/ringgold/history/diagonal/hist-diagonal.html",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The town’s first building, relocated in 1889, sparked a rapid influx of lodging, meals, and livery services for travelers.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/diagonal_iowa",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The Grand River skirts the town’s eastern edge, shaping local waterways and occasional floods.",
      "sourceSentenceIds": [
        26
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Diagonal%2C_Iowa",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Buck Polygonal Barn, a rare multi‑gabled structure, earned a spot on the National Register of Historic Places.",
