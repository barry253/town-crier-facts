  "facts": [
    {
      "id": 1,
      "text": "Woodcock was originally called Rockville, laid out in 1819 by Henry Minium, and renamed Woodcock upon incorporation in 1844.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/woodcock_pennsylvania",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The borough sits in the valley of Gravel Run, which flows into French Creek, a tributary of the Allegheny River.",
      "sourceSentenceIds": [
        15
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Woodcock%2C_Pennsylvania",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Pennsylvania Route 86 runs through Woodcock, connecting it to Cambridge Springs and Meadville.",
      "sourceSentenceIds": [
        16
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Woodcock%2C_Pennsylvania",
      "category": "transport",
      "quality": "poor",
      "qualityReason": "route_only"
    },
    {
      "id": 4,
      "text": "The New York, Pennsylvania & Ohio Railroad ran within a mile of Woodcock in the 1870s, but its peripheral routing limited growth.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/woodcock_pennsylvania",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Early industries in Woodcock included mills, blacksmith shops, and general stores, forming a self‑sustaining rural economy.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/woodcock_pennsylvania",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Woodcock Creek defined early settlement boundaries, separating townships and guiding farm and mill placement.",
