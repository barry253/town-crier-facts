      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.historictexas.net/city/west-point-texas",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Graves of veterans from the Texas Revolution are interred in West Point’s historic cemetery, honoring early military service.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 2"
      ],
