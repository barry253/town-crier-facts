      "id": 1,
      "text": "West Point, Texas was founded in the 1880s at the junction of the Missouri, Kansas and Texas and the Texas and New Orleans railroads.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
