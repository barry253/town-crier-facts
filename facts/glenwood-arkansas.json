  "facts": [
    {
      "id": 1,
      "text": "Glenwood sprang up as a boomtown when the Gurdon and Fort Smith Railroad reached the area, sparking timber and local industry growth.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Glenwood%2C_Arkansas",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Glenwood’s Caddo River runs through the west side of the city, flowing southeast to join the Ouachita River north of Arkadelphia.",
      "sourceSentenceIds": [
        20
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Glenwood%2C_Arkansas",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Every summer, Glenwood hosts a canoe race festival where canoes are pushed up the main street, drawing regional crowds.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Glenwood%2C_Arkansas",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The town’s post office opened after a lumber mill was established, and Glenwood officially incorporated in April 1909.",
      "sourceSentenceIds": [
        15
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Glenwood%2C_Arkansas",
      "category": "history",
      "quality": "good"
    },
    {
