  "facts": [
    {
      "id": 1,
      "text": "Mechanicsburg’s name comes from the word 'mechanic,' honoring the artisans who were expected to settle there.",
      "sourceSentenceIds": [
        22
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/mechanicsburg_virginia"
    },
    {
      "id": 2,
      "text": "The town was laid out around 1830‑32, with James Hoge building the first house on the newly surveyed lots.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/mechanicsburg_virginia"
    },
    {
      "id": 3,
      "text": "Between 1837 and 1839 the Cumberland Valley Railroad opened a line through Mechanicsburg, turning it into a rail hub.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.mechanicsburgmuseum.org/our-history"
    },
    {
      "id": 4,
      "text": "During the Civil War, Confederate troops occupied Mechanicsburg in 1862‑63, staging a brief skirmish before withdrawing.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.mechanicsburgmuseum.org/our-history"
    },
    {
      "id": 5,
      "text": "A historic public fountain once stood proudly in Mechanicsburg’s town square, its dedication celebrated in 1907.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.mechanicsburgmuseum.org/our-history"
    },
    {
      "id": 6,
      "text": "Today, the Mechanicsburg Cannery processes homegrown produce every Tuesday and Thursday, keeping the town’s agricultural roots alive.",
      "sourceSentenceIds": [
        18
      ],
      "sourceLabels": [
        "Web source 2"
      ],
