  "facts": [
    {
      "id": 1,
      "text": "Reklaw’s name comes from Margaret Walker, who donated the land, but the town spelled her name backward because another Walker, Texas already existed.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Reklaw%2C_Texas",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Reklaw sprang to life in 1902 when the Texas and New Orleans Railroad cut through the area, prompting a townsite on Margaret L. Walker’s land.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.tshaonline.org/handbook/entries/reklaw-tx",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Before the Civil War, several sawmills dotted the Reklaw area, hinting at early timber industry activity.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.tshaonline.org/handbook/entries/reklaw-tx",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Reklaw straddles Cherokee and Rusk counties, with most of the town in Cherokee and a sliver spilling into Rusk.",
      "sourceSentenceIds": [
        22,
        23
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Reklaw%2C_Texas",
      "category": "other",
      "quality": "poor",
      "qualityReason": "location_description"
    },
    {
      "id": 5,
      "text": "Reklaw experiences hot, humid summers and generally mild to cool winters, typical of eastern Texas.",
      "sourceSentenceIds": [
        24
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Reklaw%2C_Texas",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Reklaw is entirely rural, with 100% of its residents living outside urban areas.",
