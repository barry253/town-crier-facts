  "facts": [
    {
      "id": 1,
      "text": "Algonquin was settled in 1834 and officially incorporated in 1890, spanning both Kane and McHenry counties.",
      "sourceSentenceIds": [
        19
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.algonquin.org/eGov/apps/document/center.egov?view=item;id=16"
    },
    {
      "id": 2,
      "text": "The village’s name, chosen after a local contest, reflects the Potawatomi word for “wild onion.”.",
      "sourceSentenceIds": [
        2,
        10
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.algonquin.org/eGov/apps/document/center.egov?view=item;id=16"
    },
    {
      "id": 3,
      "text": "When the railroad arrived in 1855, farmers could ship dairy and crops straight to Chicago markets.",
      "sourceSentenceIds": [
        15
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Algonquin%2C_Illinois"
    },
    {
      "id": 4,
      "text": "Algonquin’s Hill Climb Race, a classic car event that ran from 1906 to 1913, still draws enthusiasts.",
      "sourceSentenceIds": [
        21
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.algonquin.org/eGov/apps/document/center.egov?view=item;id=16"
    },
    {
      "id": 5,
      "text": "The Village Hall, erected in 1907 at 2 South Main Street, remains a historic landmark and community hub.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Algonquin%2C_Illinois"
    },
    {
      "id": 6,
      "text": "The former Borden Milk Factory, once a major dairy producer, stands as a reminder of Algonquin’s industrial past.",
