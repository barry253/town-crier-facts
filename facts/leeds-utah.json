  "facts": [
    {
      "id": 1,
      "text": "Leeds was renamed in honor of Leeds in England, where many of the town's original settlers came from.",
      "sourceSentenceIds": [
        1,
        28
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 2"
      ],
      "source": "https://en.wikipedia.org/wiki/Leeds%2C_Utah"
    },
    {
      "id": 2,
      "text": "Formerly known as Bennington, Leeds was formed after residents moved to the area in 1867 due to flooding in Harrisburg.",
      "sourceSentenceIds": [
        6,
        7,
        29
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 2"
      ],
      "source": "https://en.wikipedia.org/wiki/Leeds%2C_Utah"
    },
    {
      "id": 3,
      "text": "The Red Cliffs Desert Reserve borders the town of Leeds.",
      "sourceSentenceIds": [
        13
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Leeds%2C_Utah"
    },
    {
      "id": 4,
      "text": "Leeds is known for having the longest growing season in Utah and was once noted for its abundant fruit and sorghum.",
      "sourceSentenceIds": [
        22
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://leeds.utah.gov/"
    },
    {
      "id": 5,
      "text": "Main Street in Leeds features numerous buildings dating from the 1800s, including fifteen houses built before 1900.",
      "sourceSentenceIds": [
        23,
        24
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://leeds.utah.gov/"
    },
    {
      "id": 6,
      "text": "Proximity to Zion National Park and the Pine Valley Mountains shifted the economic base of Leeds from agriculture to tourism.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Leeds%2C_Utah"
