  "facts": [
    {
      "id": 1,
      "text": "Chevy Chase Village traces its name to the “chaces,” or hunting grounds, in the Scottish‑English border’s Cheviot Hills.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.chevychasehistory.org/index.php/chevychase/about-chevy-chase-0",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "In the late 1800s, Newlands and Stewart developed the area into a streetcar suburb that let Washington, D.C. residents live farther from work.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.chevychasehistory.org/index.php/chevychase/about-chevy-chase-0",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The village officially incorporated in 1951 after residents sought state sanction as a special taxing area in 1914.",
      "sourceSentenceIds": [
        24,
        25
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Chevy_Chase_Village%2C_Maryland",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Chevy Chase Village was originally created as an all‑white community and remains overwhelmingly so more than a century later.",
      "sourceSentenceIds": [
        26
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Chevy_Chase_Village%2C_Maryland",
      "category": "people",
      "quality": "poor",
      "qualityReason": "editorial_filler"
    },
    {
      "id": 5,
      "text": "The Chevy Chase Historical Society curates exhibitions that showcase the most interesting people, places, and events in the town’s history.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.chevychasehistory.org/index.php/chevychase/about-chevy-chase-0",
      "category": "culture",
      "quality": "good"
    },
    {
