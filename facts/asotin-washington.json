  "facts": [
    {
      "id": 1,
      "text": "Asotin’s name comes from the Nez Perce word for “eel creek,” meaning the place of the big fish.",
      "sourceSentenceIds": [
        8,
        10
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 2"
      ],
      "source": "https://en.wikipedia.org/wiki/Asotin%2C_Washington"
    },
    {
      "id": 2,
      "text": "Alexander Sumpster founded Asotin in 1878 as a river‑ferry settlement on the Snake River.",
      "sourceSentenceIds": [
        8,
        9
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Asotin%2C_Washington"
    },
    {
      "id": 3,
      "text": "The Carpenter‑Gothic Full Gospel Church, completed in 1908, stands as Asotin’s historic church on the National Register.",
      "sourceSentenceIds": [
        5,
        6
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.visitasotin.com/"
    },
    {
      "id": 4,
      "text": "The Asotin Historical Society Museum, housed in a charming early‑20th‑century brick building, lets visitors step into the town’s pioneer past.",
      "sourceSentenceIds": [
        19,
        20
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.visitasotin.com/"
    },
    {
      "id": 5,
      "text": "Stroll along the Snake River at Chief Looking Glass Park, where riverfront paths meet historic landmarks.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.visitasotin.com/"
    },
    {
      "id": 6,
      "text": "Buffalo Eddy near Asotin contains petroglyphs that may date back 4,500 years, a testament to the area’s ancient Nez Perce roots.",
      "sourceSentenceIds": [
        22,
        23
      ],
      "sourceLabels": [
