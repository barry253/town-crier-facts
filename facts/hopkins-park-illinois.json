      "quality": "good"
    },
    {
      "id": 3,
      "text": "Founded before the Emancipation Proclamation, Hopkins Park traces its origins to runaway slave Pap Tetter, a courageous pioneer.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 2"
