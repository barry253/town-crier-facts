      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "During the Underground Railroad era, Hopkins Park served as a terminal, offering refuge to those seeking freedom.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
