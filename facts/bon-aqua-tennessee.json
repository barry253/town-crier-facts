  "facts": [
    {
      "id": 1,
      "text": "Bon Aqua was named for the 'good water' of a nearby mineral spring.",
      "sourceSentenceIds": [
        13
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Bon_Aqua%2C_Tennessee"
    },
    {
      "id": 2,
      "text": "The Bon Aqua Springs Resort once hosted a September gathering of two thousand Confederate veterans and their families in 1885.",
      "sourceSentenceIds": [
        26
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://tennesseeencyclopedia.net/entries/bon-aqua-springs-resort/"
    },
    {
      "id": 3,
      "text": "In 1888 a fire destroyed the resort hotel, and a new 101‑room hotel opened in 1901 for five hundred guests.",
      "sourceSentenceIds": [
        27
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://tennesseeencyclopedia.net/entries/bon-aqua-springs-resort/"
    },
    {
      "id": 4,
      "text": "The resort’s mineral springs were believed to treat ailments from iron‑poor blood to yellow fever, offering temperate days and cool nights.",
      "sourceSentenceIds": [
        19
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://tennesseeencyclopedia.net/entries/bon-aqua-springs-resort/"
    },
    {
      "id": 5,
      "text": "The Tennessee Bar Association was organized at Bon Aqua Springs in 1881, holding its first annual convention the next year.",
      "sourceSentenceIds": [
        25
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://tennesseeencyclopedia.net/entries/bon-aqua-springs-resort/"
    },
    {
      "id": 6,
      "text": "Remnants of the former resort are preserved as the Bon Aqua Springs Historic District, listed on the National Register of Historic Places.",
      "sourceSentenceIds": [
        17
      ],
