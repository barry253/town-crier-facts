  "facts": [
    {
      "id": 1,
      "text": "Victoria was founded as Fort Victoria in 1843, renamed in honor of Queen Victoria a few months later.",
      "sourceSentenceIds": [
        12,
        13,
        14
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
