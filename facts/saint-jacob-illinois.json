  "facts": [
    {
      "id": 1,
      "text": "Saint Jacob, Illinois, takes its name from Jacob Schutz, who ran a store, saloon, and tavern in the mid‑1800s.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/St._Jacob%2C_Illinois",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The village sits in southeastern Madison County, just east of the historic Silver Creek watershed.",
      "sourceSentenceIds": [
        7,
        11
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/St._Jacob%2C_Illinois",
      "category": "other",
      "quality": "poor",
      "qualityReason": "location_description"
    },
    {
      "id": 3,
      "text": "Route 40 skirts the northern edge of Saint Jacob, linking it to Highland and Troy about six miles away.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/St._Jacob%2C_Illinois",
      "category": "transport",
      "quality": "poor",
      "qualityReason": "route_only"
    },
    {
      "id": 4,
      "text": "Saint Jacob covers 0.85 square miles, with only 0.01 square miles—about 0.8%—being water.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/St._Jacob%2C_Illinois",
      "category": "other",
      "quality": "poor",
      "qualityReason": "vague"
    },
    {
      "id": 5,
      "text": "Water from the village drains westward into tributaries of Silver Creek, a south‑flowing branch of the Kaskaskia River.",
      "sourceSentenceIds": [
        11
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/St._Jacob%2C_Illinois",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Saint Jacob is officially classified as a village within Madison County, Illinois, reflecting its small‑town governance structure.",
      "sourceSentenceIds": [
