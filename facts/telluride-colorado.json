      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Telluride%2C_Colorado"
    },
    {
      "id": 3,
      "text": "In 1961, Telluride’s historic core was declared a National Historic Landmark District, preserving its 19th‑century mining architecture.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 1"
      ],
