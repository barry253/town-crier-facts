  "facts": [
    {
      "id": 1,
      "text": "Little Falls is a historic mill village on the Presumpscot River, with sawmills and pulp mills dating back before the American Revolution.",
      "sourceSentenceIds": [
        4,
        16
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://winslowmaine.org/unveiling-the-hidden-gem-exploring-the-charms-of-little-falls-maine"
    },
    {
      "id": 2,
      "text": "For more than two centuries, Little Falls has turned the Presumpscot River's falls into work, powering sawmills and pulp mills.",
      "sourceSentenceIds": [
        10,
        11
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://winslowmaine.org/unveiling-the-hidden-gem-exploring-the-charms-of-little-falls-maine"
    },
    {
      "id": 3,
      "text": "Workers' homes in Little Falls were painted a distinctive red, earning the neighborhood the nickname 'Red City'.",
      "sourceSentenceIds": [
        26
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://winslowmaine.org/unveiling-the-hidden-gem-exploring-the-charms-of-little-falls-maine"
    },
    {
      "id": 4,
      "text": "In 1899, New York businessman Robert Gair—credited with inventing the mass‑produced cardboard carton—purchased the mill property in Little Falls.",
      "sourceSentenceIds": [
        23
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://winslowmaine.org/unveiling-the-hidden-gem-exploring-the-charms-of-little-falls-maine"
    },
    {
      "id": 5,
      "text": "Today the Presumpscot River in Little Falls is celebrated for its scenery and offers paddling, fishing, and riverside trails.",
      "sourceSentenceIds": [
        28
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://winslowmaine.org/unveiling-the-hidden-gem-exploring-the-charms-of-little-falls-maine"
    },
    {
      "id": 6,
      "text": "Little Falls sits just a short drive northwest of Portland, shaped for centuries by the Presumpscot River and its falls.",
      "sourceSentenceIds": [
        15,
