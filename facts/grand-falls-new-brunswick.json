  "facts": [
    {
      "id": 1,
      "text": "Grand Falls gets its name from a 23‑metre waterfall formed by rock ledges on the Saint John River.",
      "sourceSentenceIds": [
        15,
        16
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Grand_Falls%2C_New_Brunswick",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "In 1686, Monsignor de Saint‑Vallier was the first to write about the falls, calling them “Grand Sault.”.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Grand_Falls%2C_New_Brunswick",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "A hydroelectric dam completed in 1931 harnesses the falls, supplying 66 MW through four Francis turbines.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Grand_Falls%2C_New_Brunswick",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The Grand Falls Public Library began as a literary club founded by Senator Muriel McQueen Fergusson and now sits on Pleasant Street.",
      "sourceSentenceIds": [
        1,
        10,
        13
      ],
      "sourceLabels": [
