      "id": 1,
      "text": "Bloomfield was laid out in 1824 when Greene County needed a new county seat because Burlington lacked a reliable water source.",
      "sourceSentenceIds": [
        27
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
