  "facts": [
    {
      "id": 1,
      "text": "The Glasgow Railroad Bridge, built in 1891, was the world's first all‑steel bridge, a landmark in engineering history.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.visitglasgowmo.org/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Historic Glasgow houses mansions such as the BoscoBel‑Shackelford, Earickson, Harrison, and Karbelle, each a preserved slice of 19th‑century life.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.visitglasgowmo.org/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Karbelle’s Scenic Driving Tour invites visitors to explore Missouri’s past, showcasing the region’s communities and people through historic sites.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.visitglasgowmo.org/",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The local museum curates artifacts that chronicle Glasgow’s Civil War involvement and the broader history of Howard County.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.karbellemansion.com/tourist-information/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Old architecture in Glasgow tells stories of the Civil War, reflecting the town’s role in that pivotal era.",
      "sourceSentenceIds": [
        11
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.karbellemansion.com/tourist-information/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "When events are on, residents and visitors alike gather to enjoy historic tours and the vibrant local culture that defines Glasgow.",
