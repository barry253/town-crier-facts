  "facts": [
    {
      "id": 1,
      "text": "Reading was originally called Voorhees‑Town, platted in 1798 but only recorded in 1804.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Reading%2C_Ohio",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town was renamed Reading in 1804 after Henry Redinbo’s hometown, echoing Reading, Pennsylvania.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/Reading,_Ohio",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Reading grew into Ohio’s largest village between 1830 and 1880, driven by clothing manufacturing linked to Cincinnati’s rail lines.",
      "sourceSentenceIds": [
        23,
        13
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 2"
      ],
      "source": "https://en.wikipedia.org/wiki/Reading%2C_Ohio",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The Benson Street Bridge, built in 1901, was Ohio’s first concrete rainbow arch bridge and spans Mill Creek on the city limit with Lockland.",
      "sourceSentenceIds": [
        26,
        27
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Reading%2C_Ohio",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "In 1903, Reading’s village council imposed a nightly curfew on youths under 16, reflecting the era’s social norms.",
      "sourceSentenceIds": [
        30
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Reading%2C_Ohio",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Reading’s early economy boasted four breweries, a vinegar and woolen mills, a yeast factory, and a rope factory, illustrating diverse 19th‑century industry.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 1"
      ],
