      "quality": "poor",
      "qualityReason": "other"
    },
    {
      "id": 3,
      "text": "Drakesville is a historic site on the Mormon Pioneer National Historic Trail, with interpretive exhibits at the Drakesville Oval.",
      "sourceSentenceIds": [
