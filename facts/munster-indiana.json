  "facts": [
    {
      "id": 1,
      "text": "Munster got its name from Jacob Munster’s general store, where the town’s first post office opened.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Munster%2C_Indiana"
    },
    {
      "id": 2,
      "text": "The railroad’s arrival in the 19th century sparked Munster’s early development and population growth.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.munster.org/category/subcategory.php?categoryid=16"
    },
    {
      "id": 3,
      "text": "Founded in the mid‑1800s, Munster began as an agricultural hub thanks to fertile soil and the Little Calumet River.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://talktoannie.com/discover-munster-indiana-a-hidden-gem-with-rich-history-and-vibrant-living/"
    },
    {
      "id": 4,
      "text": "Ice Age‑era dunes once covered the area, leaving a distinctive landscape that still marks Munster’s terrain.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://talktoannie.com/discover-munster-indiana-a-hidden-gem-with-rich-history-and-vibrant-living/"
    },
    {
      "id": 5,
      "text": "The Ibach House and Stallbohm‑Barn‑Kaske House, both 19th‑century farmsteads, are listed on the National Register of Historic Places.",
      "sourceSentenceIds": [
        11
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Munster%2C_Indiana"
    },
    {
      "id": 6,
      "text": "Since 1976, the Munster Historical Society has preserved the town’s heritage and runs a museum in the town hall.",
      "sourceSentenceIds": [
        8,
        16
      ],
