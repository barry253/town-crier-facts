  "facts": [
    {
      "id": 1,
      "text": "Cramerton was founded in 1906 as Mayesworth by J.H. Cramer, a textile engineer who later invented the Cramer System of Air Conditioning.",
      "sourceSentenceIds": [
        1,
        4,
        30
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Cramerton%2C_North_Carolina",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town’s name changed from Mayesworth to Cramerton in honor of its founder, Stuart Warren Cramer, who owned the local mill.",
      "sourceSentenceIds": [
        1,
        30
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Cramerton%2C_North_Carolina",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Cramerton sits on the South Fork Catawba River, which makes a sharp S‑curve through the town’s center.",
      "sourceSentenceIds": [
        25
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Cramerton%2C_North_Carolina",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The historic Mayworth School, built in 1906, is listed on the National Register of Historic Places.",
      "sourceSentenceIds": [
        9,
        12
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Cramerton%2C_North_Carolina",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The Southern Railroad once ran directly through Cramerton, linking Charlotte and Atlanta.",
      "sourceSentenceIds": [
        13
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.cramerton.org/about_cramerton/town_history.php",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Cramer Mountain hosts an 18‑hole golf course and a gated community, a legacy of the town’s founder.",
