  "facts": [
    {
      "id": 1,
      "text": "Villanueva was founded in 1808 as La Cuesta by settlers Mariano Baros and Jose Filipe Madrid on land from the 1794 San Miguel del Vado Land Grant.",
      "sourceSentenceIds": [
        2,
        10
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/villanueva_new_mexico",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The name Villanueva, meaning 'new town,' was adopted around 1890 to replace La Cuesta.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/villanueva_new_mexico",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "During its early years, Villanueva served as a buffer settlement against Comanche and Kiowa incursions in the Pecos River Valley.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/villanueva_new_mexico",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Villanueva briefly prospered from Santa Fe Trail commerce but declined after the Atchison, Topeka and Santa Fe Railway bypassed it in 1879–1880.",
      "sourceSentenceIds": [
        29
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/villanueva_new_mexico",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Villanueva experiences a semi-arid steppe climate with most precipitation falling between May and October and an average of 23 inches of snow each winter.",
      "sourceSentenceIds": [
        26
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
