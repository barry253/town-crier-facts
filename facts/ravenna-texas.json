  "facts": [
    {
      "id": 1,
      "text": "Ravenna was originally called Willow Point before settlers renamed it because of the many ravines in the area.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.fannincountyhistory.org/ravenna"
    },
    {
      "id": 2,
      "text": "The town sits on Farm Roads 274 and 1753, about five miles northwest of Bonham and six miles south of the Red River.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.tshaonline.org/handbook/entries/ravenna-tx"
    },
    {
      "id": 3,
      "text": "When the railroad rerouted in 1929 to pass through Bonham, Ravenna’s growth stalled and the town entered a slow decline.",
      "sourceSentenceIds": [
        15
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.fannincountyhistory.org/ravenna"
    },
    {
      "id": 4,
      "text": "By 1925 Ravenna boasted five service stations, a garage, several grocery stores, churches, a blacksmith shop, a gin, and a post office.",
      "sourceSentenceIds": [
        20
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.fannincountyhistory.org/ravenna"
    },
    {
      "id": 5,
      "text": "Today the town hosts a single service‑station grocery store, a post office, a beauty shop, and two churches.",
      "sourceSentenceIds": [
        21
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.fannincountyhistory.org/ravenna"
    },
    {
      "id": 6,
      "text": "Ravenna lies just 5 miles southeast of the Red River, the natural border between Texas and Oklahoma.",
      "sourceSentenceIds": [
        26
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Ravenna%2C_Texas"
    }
  ]
