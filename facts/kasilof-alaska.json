  "facts": [
    {
      "id": 1,
      "text": "The Kasilof Museum stands as a pivotal historical institution on Alaska’s Kenai Peninsula, preserving and interpreting the region’s unique heritage.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.wonderfulmuseums.com/museum/kasilof-museum/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Its exhibits chronicle Native Alaskan roots, Russian influence, pioneering homesteaders, the commercial fishing boom, and early community development.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.wonderfulmuseums.com/museum/kasilof-museum/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Before Russian traders arrived, the Dena'ina Athabascan people—especially the K'ech'atnu band—lived along the Kasilof River.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.wonderfulmuseums.com/museum/kasilof-museum/",
      "category": "people",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The Kasilof Historical Society runs the museum, safeguarding the town’s heritage for future generations.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.wonderfulmuseums.com/museum/kasilof-museum/",
      "category": "people",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "In 1786, a Russian detachment of the Lebedev-Lastochkin Company built a fishing artel at the site that would become modern Kasilof.",
      "sourceSentenceIds": [
        30
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Kasilof%2C_Alaska",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Kasilof first appeared on the 1880 U.S. Census, marking its emergence as a recognized community.",
