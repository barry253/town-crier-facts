  "facts": [
    {
      "id": 1,
      "text": "Moncure was founded in 1881 by Thomas Jefferson Moncure and others in southeastern Chatham County.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Moncure%2C_North_Carolina",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Moncure once served as North Carolina’s westernmost inland port, linked to the Atlantic by 200 miles of Cape Fear River.",
      "sourceSentenceIds": [
        6,
        28,
        10
      ],
      "sourceLabels": [
        "Web source 1",
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://chapelboro.com/town-square/local-lore/local-lore-port-200-miles-upriver",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The town sits at the confluence of the Deep and Haw rivers, where they form the Cape Fear River.",
      "sourceSentenceIds": [
        9,
        10
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Moncure%2C_North_Carolina",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Thomas Moncure, one of the founders, was an engineer for the Seaboard Air Line Railroad, which later spurred local industry.",
      "sourceSentenceIds": [
        13,
        23
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 2"
      ],
      "source": "https://en.wikipedia.org/wiki/Moncure%2C_North_Carolina",
      "category": "people",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The Newkirk State and Lockville Dam, Canal and Powerhouse nearby are listed on the National Register of Historic Places.",
      "sourceSentenceIds": [
        14
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Moncure%2C_North_Carolina",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Moncure’s early growth hinged on steamship travel; the first steamship to navigate inland waterways, the Norfolk, set sail in 1818.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Web source 1"
      ],
