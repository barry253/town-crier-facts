  "facts": [
    {
      "id": 1,
      "text": "Ellsinore earned its name from Elsinore Castle in Denmark, Shakespeare's Hamlet, but a postal typo added the extra \"l\".",
      "sourceSentenceIds": [
        1,
        8
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Ellsinore%2C_Missouri",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Charles Hearin laid out Ellsinore in 1888, built a depot on the south side of the creek, and secured a railroad right of way.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Ellsinore%2C_Missouri",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The Ellsinore Pioneer Museum, founded in 1986, preserves pioneer life through hands‑on crafts like basket making and sourdough baking.",
      "sourceSentenceIds": [
        2,
        13
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.ozarksalive.com/stories/ellsinore-pioneer-museum-a-small-team-with-big-ozarks-preservation-potential",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Ellsinore hosts a branch of the Carter County Library, offering residents a lending collection in a historic town setting.",
      "sourceSentenceIds": [
        19
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Ellsinore%2C_Missouri",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Ellsinore's first school opened in 1891, starting as a one‑room building before expanding to a two‑room L‑shaped structure.",
      "sourceSentenceIds": [
        29,
        30
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Ellsinore%2C_Missouri",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Two historic bridges span Ellsinore’s Main Street and connect County Road 330 to the town, reflecting early 20th‑century engineering.",
