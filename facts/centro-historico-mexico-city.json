  "facts": [
    {
      "id": 1,
      "text": "Centro Historico sits on the former Aztec city of Tenochtitlan founded around 1325.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Historic_center_of_Mexico_City",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The Zócalo, the heart of Centro Historico, has hosted cultural events since Aztec times.",
      "sourceSentenceIds": [
        23
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Historic_center_of_Mexico_City",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The Palacio Nacional borders the Zócalo and houses presidential offices and a mural that chronicles Mexico’s history.",
      "sourceSentenceIds": [
        24
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Historic_center_of_Mexico_City",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The historic center contains 9,000 buildings, 1,550 of which are declared historically important.",
      "sourceSentenceIds": [
        19
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Historic_center_of_Mexico_City",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The area was once divided into four calpullis, each linked by main roads leading to Tepeyac, Iztapalapa, Tacuba, and a lake dike.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Historic_center_of_Mexico_City",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The first monasteries in Centro Historico were San Francisco, Santo Domingo, and San Agustín, founded shortly after the Spanish arrival.",
      "sourceSentenceIds": [
        13
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
