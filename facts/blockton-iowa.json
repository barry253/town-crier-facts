  "facts": [
    {
      "id": 1,
      "text": "Blockton was founded in 1861 by a dozen Cutlerite Mormon families led by Alpheus Cutler, who moved from Manti in Fremont County.",
      "sourceSentenceIds": [
        11
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/blockton_iowa",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town was originally called Mormontown; a post office opened in 1872, and the name changed to Blockton in 1887 after the Mormons departed.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Blockton%2C_Iowa",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Blockton was officially incorporated as a city on March 28, 1890, following its renaming and growth as the largest village in Jefferson Township.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/blockton_iowa",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Two mills built by the Mormon pioneers powered early local industry, but the mills vanished after the settlers returned to Manti by 1865.",
      "sourceSentenceIds": [
        5,
        6
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/blockton_iowa",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The Blockton News, founded in 1887, chronicled the town’s expansion and railway influence until its final issue in 1944.",
      "sourceSentenceIds": [
        7
      ],
