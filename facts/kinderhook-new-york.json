  "facts": [
    {
      "id": 1,
      "text": "Kinderhook’s name, first recorded as “Kinderhoek” in 1614, means “children’s corner” in Dutch and is one of New York’s oldest Dutch‑derived place names.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.villageofkinderhook.org/community/history/index.php",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "In 1809 Washington Irving stayed in Kinderhook for eight weeks, writing parts of his history of New York while visiting the town’s Dutch colonial homes.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Kinderhook%2C_New_York",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The Luykas Van Alen House, built around 1737, inspired Irving’s “Van Tassel” family farm in *The Legend of Sleepy Hollow* and is a National Historic Landmark.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Kinderhook%2C_New_York",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The town’s Columbia County Historical Society owns four historic properties, including the 1819 James Vanderpoel House, the 1850 Ichabod Crane Schoolhouse, and the 1915 museum building.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Kinderhook%2C_New_York",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Martin Van Buren’s former home, Lindenwald, sits in the southwestern part of the town and now serves as a National Historic Site.",
      "sourceSentenceIds": [
        19
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Kinderhook%2C_New_York",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Kinderhook’s historic center hosts the James Vanderpoel House and the CCHS Museum & Library, while the Luykas Van Alen House and Ichabod Crane Schoolhouse lie just outside the village limits.",
      "sourceSentenceIds": [
        14
      ],
