      ],
      "source": "https://edenmill.org/",
      "category": "other",
      "quality": "poor",
      "qualityReason": "editorial_filler"
    },
    {
      "id": 4,
      "text": "Adult volunteers guide 2‑hour canoe trips on Deer Creek, with equipment and training provided by the center.",
