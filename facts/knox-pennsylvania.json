    },
    {
      "id": 2,
      "text": "Quaker farmer Mendenhall bought 160 acres in what is now Elk Township, naming the area Eden for its sheltered ridge under Canoe Creek.",
      "sourceSentenceIds": [
        2,
        3
      ],
      "sourceLabels": [
        "Web source 2",
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/knox_pennsylvania"
    },
    {
      "id": 3,
      "text": "Mendenhall opened the Eden Inn, an early inn and entertainment spot that served travelers at this rural crossroads.",
