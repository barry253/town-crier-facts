  "facts": [
    {
      "id": 1,
      "text": "Grassland Colony was founded in the early 1990s as a division from the Long Lake Hutterite Colony.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/grassland_colony_south_dakota"
    },
    {
      "id": 2,
      "text": "Grassland Colony follows Anabaptist traditions that emphasize shared property, pacifism, and separation from worldly society.",
      "sourceSentenceIds": [
        24
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/grassland_colony_south_dakota"
    },
    {
      "id": 3,
      "text": "The community is situated in the rolling prairies of north-central South Dakota within the Drift Prairie region.",
      "sourceSentenceIds": [
        14
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/grassland_colony_south_dakota"
    },
    {
      "id": 4,
      "text": "Grassland Colony established the Boulder Hutterite Colony in 2016 to accommodate growth while maintaining communal living principles.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/grassland_colony_south_dakota"
    },
    {
      "id": 5,
      "text": "Fertile loess deposits from glacial outwash support intensive farming of corn, soybeans, and alfalfa at Grassland Colony.",
      "sourceSentenceIds": [
        16,
        20
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/grassland_colony_south_dakota"
    },
    {
      "id": 6,
      "text": "Colony infrastructure includes clustered family residences, a central dining hall, a church, and a schoolhouse to facilitate communal labor.",
      "sourceSentenceIds": [
        26
      ],
      "sourceLabels": [
        "Web source 1"
      ],
