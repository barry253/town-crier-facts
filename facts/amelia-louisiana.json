    },
    {
      "id": 2,
      "text": "The town was named after Amelia Dupuis, the first postmaster’s fiancée who died before their wedding.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Amelia%2C_Louisiana"
    },
    {
      "id": 3,
      "text": "Amelia first appeared as an unincorporated place in the 1970 U.S. Census.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Amelia%2C_Louisiana"
    },
    {
      "id": 4,
      "text": "Amelia lies at 29°40′24″N 91°6′11″W, placing it in the heart of southern Louisiana.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Amelia%2C_Louisiana"
    },
    {
      "id": 5,
      "text": "Amelia is part of the Morgan City Micropolitan Statistical Area, about 8 miles east of Morgan City.",
      "sourceSentenceIds": [
