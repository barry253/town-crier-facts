      "id": 1,
      "text": "Amelia was founded in the late 19th century as a shipping point on the Atchafalaya River, later becoming a key oil and gas hub.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 2"
      ],
