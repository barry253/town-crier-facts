  "facts": [
    {
      "id": 1,
      "text": "Whitestone Logging Camp emerged in the early 1980s as a satellite site for regional pulp demands, founded by Whitestone Logging Company, the successor to Tyler Brothers Logging.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/whitestone_logging_camp_alaska",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Known to the Tlingit as Yan Kashada Tináa, meaning 'On Top of the Head Copper,' the area was a traditional subsistence site before logging.",
      "sourceSentenceIds": [
        21
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/whitestone_logging_camp_alaska",
      "category": "people",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Early 1950s surveys by Alaska Pulp Corporation secured a 50‑year timber sale contract in 1956, supplying spruce and hemlock to a Sitka pulp mill that opened in 1959.",
      "sourceSentenceIds": [
        29
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/whitestone_logging_camp_alaska",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Summer highs at Whitestone Logging Camp typically reach 50‑65°F, while winter lows average 20‑40°F, a moderated climate shaped by the Pacific Ocean.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/whitestone_logging_camp_alaska",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The camp sits 276 feet above sea level amid the Tongass National Forest's coastal temperate rainforest on Chichagof Island.",
      "sourceSentenceIds": [
        20
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/whitestone_logging_camp_alaska",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "High humidity and frequent storms cause mold growth and infrastructure wear, while occasional gale‑force winds can trigger localized flooding at Whitestone Logging Camp.",
      "sourceSentenceIds": [
        27
