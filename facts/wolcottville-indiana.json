  "facts": [
    {
      "id": 1,
      "text": "Wolcottville was named for George Wolcott, who started a sawmill there in 1838.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Wolcottville%2C_Indiana",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town’s early economy boomed with a tannery, rake factory, foundry, planing mill, cooper shop, and carriage factory after the railroad arrived.",
      "sourceSentenceIds": [
        5,
        15
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.wolcottville.com/history",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Wolcottville sits amid the Indian Lakes chain, including Dallas, Witmer, Westler, Atwood, Messick, and Hackenburg.",
      "sourceSentenceIds": [
        18
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.wolcottville.com/history",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The historic Wolcott House, built by the town’s founder, now sits on the National Register of Historic Places and is preserved by Indiana Landmarks.",
      "sourceSentenceIds": [
        10,
        13
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.wolcottville.com/history",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "A commemorative stone marker at Wolcott Park honors George Wolcott and the early pioneers of the town.",
      "sourceSentenceIds": [
        21
      ],
      "sourceLabels": [
        "Web source 1"
      ],
