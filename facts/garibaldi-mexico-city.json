  "facts": [
    {
      "id": 1,
      "text": "Plaza Garibaldi sits where Centro Histórico, Colonia Guerrero, La Lagunilla, and Tepito meet.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://mexicocity.cdmx.gob.mx/venues/garibaldi-plaza/?lang=en",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The square began as Plazuela de Jardín in the 19th century before becoming a garden space amid post-independence growth.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/Plaza_Garibaldi",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "In 1871 it was renamed Plaza del Baratillo after a bustling Sunday flea market that drew vendors and crowds.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/Plaza_Garibaldi",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "By the late 1920s, Garibaldi had become the de facto epicenter of mariachi, with dozens of groups performing nightly.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/Plaza_Garibaldi",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The plaza’s open layout let patrons summon bands on site, making it an informal employment market for mariachi during economic shifts.",
      "sourceSentenceIds": [
        14
      ],
      "sourceLabels": [
        "Web source 2"
      ],
