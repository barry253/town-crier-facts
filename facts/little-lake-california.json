  "facts": [
    {
      "id": 1,
      "text": "Little Lake was a seasonal home for Native American groups long before roads, serving as a desert oasis.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://desertgazette.com/blog/from-ancient-oasis-to-desert-stage-stop/",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "In 1910 the Southern Pacific Railroad extended tracks across the marsh on wooden trestles, bringing workers and travelers.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://desertgazette.com/blog/from-ancient-oasis-to-desert-stage-stop/",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "A stone station built to water horses and rest travelers served ore, mail, and supplies for over a decade.",
      "sourceSentenceIds": [
        15
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://desertgazette.com/blog/from-ancient-oasis-to-desert-stage-stop/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "William Bramlette opened a Desert Resort in the early 1920s, adding a café, general store, service station, and cabins.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://desertgazette.com/blog/from-ancient-oasis-to-desert-stage-stop/",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Archaeological finds show humans camped here as far back as 10,000 years, with petroglyphs depicting atlatls and mountain sheep.",
      "sourceSentenceIds": [
        25,
        26
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://desertgazette.com/blog/from-ancient-oasis-to-desert-stage-stop/",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The “Pinto Man” burial near the lake, found with a stone point, is one of California’s oldest human remains.",
      "sourceSentenceIds": [
        30
