      "id": 1,
      "text": "Steubenville’s name comes from Fort Steuben, a 1786 fort named for Prussian officer Baron von Steuben, who never visited the site.",
      "sourceSentenceIds": [
        4,
        5,
        13
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
