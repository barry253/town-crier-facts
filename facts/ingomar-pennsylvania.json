  "facts": [
    {
      "id": 1,
      "text": "Ingomar was founded in 1851 as Taylor Township in the hills of Allegheny County.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/McCandless%2C_Pennsylvania"
    },
    {
      "id": 2,
      "text": "In 1857 it became McCandless Township, named for Judge Wilson McCandless in honor of his judicial service.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/McCandless%2C_Pennsylvania"
    },
    {
      "id": 3,
      "text": "A 1753 visit by George Washington and guide Christopher Gist marked early European interest.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/McCandless%2C_Pennsylvania"
    },
    {
      "id": 4,
      "text": "The area grew with an oil boom, centered on Highland and Ingomar rail stations.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/McCandless%2C_Pennsylvania"
    },
    {
      "id": 5,
      "text": "Native American artifacts, mainly Iroquois, have been found throughout the township since the 18th century.",
      "sourceSentenceIds": [
        14
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/McCandless%2C_Pennsylvania"
    },
    {
      "id": 6,
      "text": "North Park, established in 1927 by Allegheny County, occupies about 15% of McCandless.",
