    },
    {
      "id": 2,
      "text": "The name 'Choptank' comes from the Algonquian word tshapetank, meaning 'river of the people'.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Choptank%2C_Maryland"
    },
    {
      "id": 3,
      "text": "The tidal Choptank River empties into Chesapeake Bay, shaping the local shoreline.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Choptank%2C_Maryland"
    },
    {
      "id": 4,
      "text": "From Choptank, the river travels 11 miles southwest to Cambridge and 25 miles to Chesapeake Bay.",
      "sourceSentenceIds": [
