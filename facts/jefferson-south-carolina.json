      ],
      "source": "https://en.wikipedia.org/wiki/Jefferson%2C_South_Carolina"
    },
    {
      "id": 2,
      "text": "Jefferson was incorporated in 1901 and named in honor of Thomas Jefferson.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
