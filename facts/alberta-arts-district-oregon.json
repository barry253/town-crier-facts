      "category": "culture",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The historic Alberta Rose Theatre, dating back to 1926, still hosts comedy, live music, and film screenings today.",
      "sourceSentenceIds": [
        14,
        16
      ],
      "sourceLabels": [
        "Web source 1"
