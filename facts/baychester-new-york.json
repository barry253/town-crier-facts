  "facts": [
    {
      "id": 1,
      "text": "Baychester’s name blends “Bay,” hinting at the nearby Eastchester Bay, with “Chester,” echoing the colonial Town of Eastchester.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.cityneighborhoods.nyc/baychester"
    },
    {
      "id": 2,
      "text": "Known as “The Valley,” Baychester sits in a gentle basin between Boston Road and the New England Thruway that once collected runoff.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.cityneighborhoods.nyc/baychester"
    },
    {
      "id": 3,
      "text": "Freedomland U.S.A., an amusement park that opened in 1959, once occupied the site now home to Co‑op City.",
      "sourceSentenceIds": [
        17
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Baychester%2C_Bronx"
    },
    {
      "id": 4,
      "text": "The Eastchester branch of the New York Public Library sits at 1385 East Gun Hill Road, serving Baychester residents.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Baychester%2C_Bronx"
    },
    {
      "id": 5,
      "text": "Baychester stretches from East 222nd Street in the northeast to the New England Thruway on the east, with Gun Hill Road to the southwest.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Baychester%2C_Bronx"
    },
    {
      "id": 6,
      "text": "The neighborhood falls under Bronx Community Board 12, which oversees local planning and community services.",
