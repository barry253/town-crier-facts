  "facts": [
    {
      "id": 1,
      "text": "Kykotsmovi, spelled Kiqötsmovi in Hopi, means \"mound of ruined houses\" and reflects the village's ancient roots.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Kykotsmovi_Village%2C_Arizona"
    },
    {
      "id": 2,
      "text": "The village sprang in 1906 after an internal Hopi dispute in Oraibi over how to engage missionaries and federal agents.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Kykotsmovi_Village%2C_Arizona"
    },
    {
      "id": 3,
      "text": "Hopi settlers founded Kykotsmovi near a spring at the base of Third Mesa, where water sustains the community.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Kykotsmovi_Village%2C_Arizona"
    },
    {
      "id": 4,
      "text": "Kykotsmovi serves as the seat of the Hopi Reservation's tribal government, a sovereign nation in northeastern Arizona.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Kykotsmovi_Village%2C_Arizona"
    },
    {
      "id": 5,
      "text": "The village hosts the offices of the Hopi Tribal Council, where decisions shape the reservation's future.",
      "sourceSentenceIds": [
        20
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Kykotsmovi_Village%2C_Arizona"
    },
    {
      "id": 6,
      "text": "Kykotsmovi is one of twelve villages that make up Third Mesa, a cluster of Hopi communities on the mesa's rim.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Kykotsmovi_Village%2C_Arizona"
    }
