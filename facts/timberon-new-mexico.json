      "id": 1,
      "text": "Judge Paul Moss bought the land that became Timberon from the State of New Mexico in 1933, turning a hunting lodge into a community.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Timberon%2C_New_Mexico",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "In 1976 a missile from White Sands Missile Range veered off course and landed right in the middle of Timberon.",
      "sourceSentenceIds": [
        16
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Timberon%2C_New_Mexico",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The main road into Timberon was paved in 2005, finally connecting the valley to the rest of the state.",
      "sourceSentenceIds": [
        17
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Timberon%2C_New_Mexico",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Timberon's elevation ranges from 6,900 to 7,200 feet, placing it high in the Sacramento Mountains.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Timberon%2C_New_Mexico",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Nestled in Sacramento Canyon, Timberon sits on the southern slopes of the Sacramento Mountains, surrounded by forested valleys.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
