  "facts": [
    {
      "id": 1,
      "text": "American Falls began as a key Oregon Trail stop where pioneers crossed the Snake River before the town was founded in 1888.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.trawellino.com/destinations/united-states/idaho_american-falls",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town’s name comes from a waterfall on the Snake River where a party of American trappers’ boat went over the falls.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/American_Falls%2C_Idaho",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The original settlement was established in 1800 on the west bank of the Snake River, opposite the current town site.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://cityofamericanfalls.com/history/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "In 1925 the town was relocated when the Snake River was dammed, creating the American Falls Reservoir.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://cityofamericanfalls.com/history/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The high school mascot, the Beetdiggers, honors the area’s historic sugar beet farming industry.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.trawellino.com/destinations/united-states/idaho_american-falls",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Power plants first sprang up at American Falls in 1901, marking the town’s early industrial growth.",
      "sourceSentenceIds": [
        21
      ],
