  "facts": [
    {
      "id": 1,
      "text": "Waldorf was named in the fall of 1907 when the Federal Post Office opened, but the town was officially dedicated on July 29, 1908.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://cityofwaldorf.com/history/"
    },
    {
      "id": 2,
      "text": "The town’s first major industry began in 1895 with the construction of the Plum Valley Creamery and a butter‑maker’s house a block north.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://cityofwaldorf.com/history/"
    },
    {
      "id": 3,
      "text": "In 1907 the Alphabet Railroad ran through Waldorf, passing a block south of the original Plum Valley site.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://cityofwaldorf.com/history/"
    },
    {
      "id": 4,
      "text": "The first post office in Waldorf opened in 1908 and has operated continuously since that year.",
      "sourceSentenceIds": [
        26
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Waldorf%2C_Minnesota"
    },
    {
      "id": 5,
      "text": "A general merchandise and hardware store opened in 1895, later becoming the Plum Valley Post Office under Mr. Tangeman.",
