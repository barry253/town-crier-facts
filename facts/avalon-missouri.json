  "facts": [
    {
      "id": 1,
      "text": "Avalon was laid out on November 12, 1869, by David Carpenter, who named it after Avallon, France, for its 15‑mile view from the hill.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/avalon_missouri",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Wesley Scott first claimed the land that would become Avalon on August 9, 1845, building a log cabin on what locals called Scott’s Mound.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/avalon_missouri",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "In 1869, the Avalon Academy was founded, marking the town’s early commitment to education.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.livcolib.org/History/County/1981/1981avalon.htm",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Avalon’s post office operated from 1872 until 1985, serving the community for over a century.",
      "sourceSentenceIds": [
        16
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Avalon%2C_Missouri",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The town sits on a hill that commands views of the surrounding country for 10 to 15 miles on clear days.",
      "sourceSentenceIds": [
        26
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.livcolib.org/History/County/1981/1981avalon.htm",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Avalon’s climate swings from July highs of 88°F to January lows averaging 20°F, reflecting its continental weather patterns.",
      "sourceSentenceIds": [
        5
