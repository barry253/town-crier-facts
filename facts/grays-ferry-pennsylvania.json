  "facts": [
    {
      "id": 1,
      "text": "Grays Ferry got its name from George Gray's ferry that crossed the Schuylkill River in the colonial era.",
      "sourceSentenceIds": [
        8,
        9
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://philadelphia.wiki/a/Grays_Ferry"
    },
    {
      "id": 2,
      "text": "In the 18th century, Gray's Ferry was the southernmost of three ferries that crossed the Schuylkill River to Philadelphia.",
      "sourceSentenceIds": [
        15
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Grays_Ferry%2C_Philadelphia"
    },
    {
      "id": 3,
      "text": "The neighborhood sits along the Schuylkill River, with the Grays Ferry Bridge now spanning the water where the original ferry once operated.",
      "sourceSentenceIds": [
        16,
        14
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Grays_Ferry%2C_Philadelphia"
    },
    {
      "id": 4,
      "text": "The area once housed the Schuylkill Arsenal, a military installation that played a role during the Revolutionary War.",
      "sourceSentenceIds": [
        19
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Grays_Ferry%2C_Philadelphia"
    },
    {
      "id": 5,
      "text": "Grays Ferry’s historic core includes the Audenried Junior High School, which is listed on the National Register of Historic Places.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Grays_Ferry%2C_Philadelphia"
    },
    {
      "id": 6,
      "text": "The neighborhood’s boundaries are roughly 25th Street east, the Schuylkill River west, Vare Avenue south, and Grays Ferry Avenue north.",
