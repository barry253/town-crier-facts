  "facts": [
    {
      "id": 1,
      "text": "Croton‑on‑Hudson’s train station, now Croton‑Harmon, was built by the New York Central Railroad after a land donation tied to a naming condition.",
      "sourceSentenceIds": [
        1,
        6,
        7,
        8,
        9,
        23
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Croton-on-Hudson%2C_New_York",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Van Cortlandt Manor, a National Historic Landmark, sits at the mouth of the Croton River where the Hudson meets the Tappan Zee.",
      "sourceSentenceIds": [
        2,
        3
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Croton-on-Hudson%2C_New_York",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The village’s history is preserved by the Croton Historical Society, founded in 1972, which shares exhibits, books, and DVDs about local heritage.",
      "sourceSentenceIds": [
        5,
        13
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.crotonhistoricalsociety.org/",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "In 1906 the station became a major service hub, later becoming the key transfer point where electric trains swapped to steam engines in 1913.",
      "sourceSentenceIds": [
        8,
        23
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Croton-on-Hudson%2C_New_York",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The annual Harry Chapin Run Against Hunger, a 10k race started in 1981, draws runners to celebrate the village’s community spirit.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Croton-on-Hudson%2C_New_York",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The Blaze pumpkin‑carving contest, launched in 2005 at Van Cortlandt Manor, showcases local creativity each fall.",
