  "facts": [
    {
      "id": 1,
      "text": "Maple Ridge was named after pioneer Judge William Smith when the township organized in 1821.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/maple_ridge_ohio"
    },
    {
      "id": 2,
      "text": "Early settlers arrived in the 1800s from Pennsylvania, Virginia, and New Jersey, drawn by fertile soils for wheat and corn.",
      "sourceSentenceIds": [
        19
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/maple_ridge_ohio"
    },
    {
      "id": 3,
      "text": "Quaker settlers built the township’s first log Friends meeting house in 1829, which also served as the community’s first school.",
      "sourceSentenceIds": [
        22
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/maple_ridge_ohio"
    },
    {
      "id": 4,
      "text": "The Votaw family operated the first mill on Island Creek in 1823, marking Maple Ridge’s early industrial activity.",
      "sourceSentenceIds": [
        20
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/maple_ridge_ohio"
    },
    {
      "id": 5,
      "text": "State approvals in the 1920s paved the way for road upgrades across Mahoning County, linking Maple Ridge to nearby manufacturing hubs.",
      "sourceSentenceIds": [
        24
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/maple_ridge_ohio"
    },
    {
      "id": 6,
      "text": "Maple Ridge sits on the glaciated Allegheny Plateau, featuring gently rolling hills and hummocky terrain formed by glacial deposits.",
      "sourceSentenceIds": [
        30
      ],
