  "facts": [
    {
      "id": 1,
      "text": "St. Paris was founded in 1831 by David Huffman, who first called it New Paris after France’s capital before adding “Saint” to avoid mail confusion.",
      "sourceSentenceIds": [
        1,
        10,
        6
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/St._Paris%2C_Ohio"
    },
    {
      "id": 2,
      "text": "The Columbus & Piqua Railroad cut through St. Paris in 1846, turning the village into a key rail hub for farmers and travelers.",
      "sourceSentenceIds": [
        5,
        13,
        10
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/St._Paris%2C_Ohio"
    },
    {
      "id": 3,
      "text": "The historic Monitor House in St. Paris earned a spot on the National Register of Historic Places for its unique architecture.",
      "sourceSentenceIds": [
        11
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/St._Paris%2C_Ohio"
    },
    {
      "id": 4,
      "text": "Every summer, St. Paris hosts a festival that features a car show, a 5‑K run, and a tractor pull, drawing visitors from across the region.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://museumsdatabase.com/museums/view/25054"
    },
    {
      "id": 5,
      "text": "St. Paris incorporated as a village in 1858, solidifying its status as a self‑governed community.",
      "sourceSentenceIds": [
        18
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/St._Paris%2C_Ohio"
    },
    {
      "id": 6,
      "text": "Today the village straddles the boundary between Johnson and Jackson Townships, reflecting its growth beyond its original limits.",
