    {
      "id": 1,
      "text": "Leisure Village East was founded in 1970 by Leisure Technology Inc., becoming the second community in the Leisure Village series.",
      "sourceSentenceIds": [
        1,
        28
      ],
      "sourceLabels": [
        "Web source 1"
