  "facts": [
    {
      "id": 1,
      "text": "Alpha was named after the first letter of the Greek alphabet because founder Anson Calkins saw it as the beginning of a great city.",
      "sourceSentenceIds": [
        1,
        13
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Alpha%2C_Illinois"
    },
    {
      "id": 2,
      "text": "Alpha grew around a railroad junction that replaced the nearby town of Oxford, which sat three miles west.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Alpha%2C_Illinois"
    },
    {
      "id": 3,
      "text": "The village sits where a north–south Chicago, Burlington, and Quincy line meets an abandoned east–west line.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Alpha%2C_Illinois"
    },
    {
      "id": 4,
      "text": "Today the north–south track is part of BNSF’s Barstow Subdivision, still carrying freight.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Alpha%2C_Illinois"
    },
    {
      "id": 5,
      "text": "Alpha lies about 20 miles southeast of Moline and 30 miles northwest of Galesburg, between Interstates 74 and 80.",
