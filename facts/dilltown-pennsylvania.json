  "facts": [
    {
      "id": 1,
      "text": "Dilltown originated on the Stephens farm, initially called Franklin, and grew around sawmills and gristmills built in the 1840s.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/dilltown_pennsylvania",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The community sits along Blacklick Creek, a waterway that drains the watershed and feeds into the Conemaugh River.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/dilltown_pennsylvania",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Dilltown is a trailhead for the Ghost Town Trail, a 46‑mile rail‑trail that winds through former mining ghost towns in the Black Lick Valley.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/dilltown_pennsylvania",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The Blacklick Valley Natural Area, a 713‑acre protected expanse, lies just north of Dilltown and includes the historic Parker Tract.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/dilltown_pennsylvania",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Colonel Matthew Dill, who arrived around 1770, gave the valley its name and helped spark early settlement before the Revolutionary War.",
      "sourceSentenceIds": [
        19
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/dilltown_pennsylvania",
      "category": "people",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "William Stephens and civil engineer James C. laid out Dilltown in 1850, formalizing the town that had begun as a pioneer homestead.",
      "sourceSentenceIds": [
        27
      ],
      "sourceLabels": [
        "Web source 1"
      ],
