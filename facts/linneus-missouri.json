  "facts": [
    {
      "id": 1,
      "text": "Linneus was originally called Linnville and renamed in 1840 to honor botanist Carl Linnaeus.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Linneus%2C_Missouri",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town’s first settler was Colonel John Holland, who claimed land where the courthouse now stands in 1834.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.linnr1.k12.mo.us/vnews/display.v/ART/4cfe514f2453a",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "In 1839 Linneus was designated the county seat of Linn County, a status it still holds today.",
      "sourceSentenceIds": [
        18,
        19
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Linneus%2C_Missouri",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The historic Linn County Courthouse and Jail, built in 1871, are listed on the National Register of Historic Places.",
      "sourceSentenceIds": [
        5,
        6
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Linneus%2C_Missouri",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "A unique 1871 opera house once hosted traveling drama shows and local performances, a rare feature for a small 1800s town.",
      "sourceSentenceIds": [
        13
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.linnr1.k12.mo.us/vnews/display.v/ART/4cfe514f2453a",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The first public schoolhouse in Linneus appeared in 1847, just a few years after the railroad would later pass through the town.",
      "sourceSentenceIds": [
        12
      ],
