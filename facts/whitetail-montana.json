  "facts": [
    {
      "id": 1,
      "text": "Whitetail, Montana, began in the 1880s as a cattle‑driving camp along Whitetail Creek, named after the abundant local whitetail deer.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/whitetail_montana",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The arrival of the Soo Line Railroad in 1913 profoundly transformed Whitetail, Montana, from a sparse ranching outpost into a vital transportation hub.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/whitetail_montana",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "In the late 1930s, the Schlecter Brothers invented the power‑take‑off grain blower in Whitetail, a device that soon powered nearly every farm truck in the region.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/whitetail_montana",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The Soo Line was planned to reach Glacier National Park, but World War I halted construction, leaving Whitetail as its final stop.",
      "sourceSentenceIds": [
        23
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Whitetail%2C_Montana",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Today, Whitetail still shows historic grain elevators, a 1920s schoolhouse with a bell cupola, a church, a post office, and abandoned theater and gas station ruins.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/whitetail_montana",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The town's chief industry was the manufacture of silo blowers from 1940, but the plant closed, followed by Whitetail High School in 1940 and the grade school in 1973.",
      "sourceSentenceIds": [
        25
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Whitetail%2C_Montana",
