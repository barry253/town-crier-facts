  "facts": [
    {
      "id": 1,
      "text": "West Pelzer was born from a disagreement over gambling, liquor, and dogs on the other side of the railroad tracks.",
      "sourceSentenceIds": [
        29
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.andersonobserver.com/news/west-pelzers-origin-story-a-tale-of-dogs-drinking-and-gambling"
    },
    {
      "id": 2,
      "text": "John Franks founded a new municipality called Frankville after growing tired of the restrictions imposed by the local mill village.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.andersonobserver.com/news/west-pelzers-origin-story-a-tale-of-dogs-drinking-and-gambling"
    },
    {
      "id": 3,
      "text": "Frankville was renamed West Pelzer by 1918 and evolved into a thriving community of churches, schools, and small businesses.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://westpelzer.com/about-us/"
    },
    {
      "id": 4,
      "text": "West Pelzer is located in northeast Anderson County and is bordered to the east by the Saluda River.",
      "sourceSentenceIds": [
        12,
        13
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/West_Pelzer%2C_South_Carolina"
    },
    {
      "id": 5,
      "text": "Early mill workers in West Pelzer lived in company houses and were often paid in mill coin instead of standard currency.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.andersonobserver.com/news/west-pelzers-origin-story-a-tale-of-dogs-drinking-and-gambling"
    },
    {
      "id": 6,
      "text": "The creation of Frankville was settled by a local vote of twenty-five in favor and eleven against.",
