      "id": 1,
      "text": "Cullomburg began as the settlement of Redemption, later renamed Cullom, and finally settled on the name Cullomburg.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 1"
      ],
