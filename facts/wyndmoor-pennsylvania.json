  "facts": [
    {
      "id": 1,
      "text": "Wyndmoor’s name may come from the Heebner family who donated land for the Reading Railroad station or from Randal Morgan’s early 1900s estate.",
      "sourceSentenceIds": [
        1,
        2
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Wyndmoor%2C_Pennsylvania",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "This suburban enclave sits on the border of Northwest Philadelphia and Springfield Township, blending city proximity with a quiet residential feel.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://philadelphia.wiki/a/Wyndmoor",
      "category": "other",
      "quality": "poor",
      "qualityReason": "other"
    },
    {
      "id": 3,
      "text": "Whitemarsh Hall once covered 300 acres as Edward T.’s country estate, but its demolition is remembered as a great architectural loss in Montgomery County.",
      "sourceSentenceIds": [
        28,
        8,
        9
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 2"
      ],
      "source": "https://en.wikipedia.org/wiki/Wyndmoor%2C_Pennsylvania",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Wyndmoor Station on the Chestnut Hill East line and nearby Oreland Station on the Lansdale/Doylestown line keep residents connected to Philadelphia.",
      "sourceSentenceIds": [
        10,
        11,
        12
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Wyndmoor%2C_Pennsylvania",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The Stotesbury Club House and John Welsh House, both listed on the National Register of Historic Places, are key historic landmarks in Wyndmoor.",
      "sourceSentenceIds": [
        6,
        7
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Wyndmoor%2C_Pennsylvania",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "William Penn originally gifted Springfield Township to his wife, Gulielma, making Wyndmoor part of that early colonial estate.",
