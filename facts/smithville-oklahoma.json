    {
      "id": 2,
      "text": "Smithville was originally a Choctaw dispersed settlement called Hatobi, which established a post office in September 1886.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.okhistory.org/publications/enc/entry?entry=SM010"
    },
    {
      "id": 3,
      "text": "The community was renamed Smithville on May 1, 1890, when a new post office was established at the site.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.okhistory.org/publications/enc/entry?entry=SM010"
    },
    {
      "id": 4,
      "text": "Smithville is located in northern McCurtain County, just north of the Mountain Fork River.",
