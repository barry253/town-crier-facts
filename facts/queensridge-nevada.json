  "facts": [
    {
      "id": 1,
      "text": "Construction of Queensridge's twin 18‑story towers began in April 2005, marking the start of what would become One Queensridge Place.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/One_Queensridge_Place",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The two towers rise 233.5 feet, offering residents sweeping views of the Las Vegas Strip and distant Red Rock Canyon.",
      "sourceSentenceIds": [
        8,
        10
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/One_Queensridge_Place",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Designed by JMA Architecture Studios, the project was built by Perini Building Company under the development of Peccole Nevada.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/One_Queensridge_Place",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Singer Pia Zadora bought a $2 million condo at One Queensridge Place in May 2010, adding celebrity flair to the community.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/One_Queensridge_Place",
      "category": "people",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Originally dubbed Versailles in 1998, the project was planned on 14.5 acres beside Summerlin's Badlands Golf Course near Rampart Boulevard.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/One_Queensridge_Place",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The development began as a trio of 18‑story towers and a 14‑story tower, totaling 385 units, before settling on two 18‑story buildings.",
      "sourceSentenceIds": [
        17,
        18
      ],
      "sourceLabels": [
