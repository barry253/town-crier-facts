  "facts": [
    {
      "id": 1,
      "text": "Lloyd was carved out of New Paltz on April 15, 1845, and its first town meeting followed on May 6.",
      "sourceSentenceIds": [
        12,
        13
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Lloyd%2C_New_York",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Illinois Mountain, the town’s highest point at 1,125 feet, rises within the Marlboro Mountains that split Lloyd from north to south.",
      "sourceSentenceIds": [
        19,
        20
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Lloyd%2C_New_York",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The Hudson River marks Lloyd’s eastern border, and the Mid‑Hudson Bridge and Walkway over the Hudson link it to Poughkeepsie.",
      "sourceSentenceIds": [
        11,
        16
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Lloyd%2C_New_York",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Clintondale Station is a hamlet in Lloyd’s southwestern corner, situated along what is now Station Road.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Lloyd%2C_New_York",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Centerville once lay near Pancake Hollow Road and New Paltz Road, close to Chodikee Lake on the town’s northern edge.",
      "sourceSentenceIds": [
        30
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Lloyd%2C_New_York",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Lloyd’s eastern line is the Hudson River, while Swarte Kill demarcates its western boundary, separating it from New Paltz.",
      "sourceSentenceIds": [
