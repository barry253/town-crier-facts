  "facts": [
    {
      "id": 1,
      "text": "South Pittsburg was christened to mirror Pittsburgh, earning the nickname “Pittsburgh of the South”.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://historicsouthpittsburgtn.com/",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The Dixie Portland Cement Company, founded in 1906, built its plant on land between South Pittsburg and the Alabama line.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://historicsouthpittsburgtn.com/",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "In 1939, locals founded the Sequachee Valley Electric Cooperative, still supplying power and internet to four counties.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://historicsouthpittsburgtn.com/",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The first coal mine opened in 1868 near Whitacre Point, sparking mining in the Sequachee Valley.",
      "sourceSentenceIds": [
        19
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.historicsouthpittsburgtn.org/SPHistory1.html",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The Jasper Branch Railroad, chartered in 1860, reached South Pittsburg in 1868, moving coal to market.",
      "sourceSentenceIds": [
        15,
        17
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.historicsouthpittsburgtn.org/SPHistory1.html",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The National Cornbread Festival, launched in 1996 after community meetings, celebrates South Pittsburg’s culinary heritage.",
