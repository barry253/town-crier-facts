  "facts": [
    {
      "id": 1,
      "text": "Gaithersburg was named after Benjamin Gaither, who built a house there in 1802 where the famous Forest Oak tree once stood.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.gaithersburgmd.gov/about-us/city-history",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town officially became Gaithersburg when it incorporated on April 5 1878, after the post office had been called Forest Oak since 1850.",
      "sourceSentenceIds": [
        6,
        2
      ],
      "sourceLabels": [
        "Web source 1",
        "Wikipedia"
      ],
      "source": "https://www.gaithersburgmd.gov/about-us/city-history",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "In 1873 the Baltimore and Ohio Railroad built a station in Gaithersburg, designed by Ephraim Francis Baldwin, sparking the town’s growth.",
      "sourceSentenceIds": [
        4,
        10,
        21
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Gaithersburg%2C_Maryland",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The International Latitude Observatory, built in 1899, made Gaithersburg one of only six global sites chosen to measure Earth’s wobble; it remains a National Historic Landmark.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Gaithersburg%2C_Maryland",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The National Institute of Standards and Technology headquarters sits just west of I‑270 in Gaithersburg, anchoring the city’s role in scientific research.",
      "sourceSentenceIds": [
        29
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Gaithersburg%2C_Maryland",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Parts of the 2007 film “Body of Lies” were shot at a building on 100 Edison Park Drive, now the Montgomery County Police Department headquarters.",
