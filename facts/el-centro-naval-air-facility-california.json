  "facts": [
    {
      "id": 1,
      "text": "Founded in 1946 as Naval Air Station El Centro, the site was previously a World War II Marine Corps Air Station.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Naval_Air_Facility_El_Centro"
    },
    {
      "id": 2,
      "text": "On May 1 1946 the Navy commissioned the facility as a Naval Air Station, later redesignated a Naval Air Facility in 1979.",
      "sourceSentenceIds": [
        2,
        9,
        21
      ],
      "sourceLabels": [
        "Web source 2",
        "Wikipedia"
      ],
      "source": "https://installations.militaryonesource.mil/in-depth-overview/naval-air-facility-el-centro"
    },
    {
      "id": 3,
      "text": "The base began as a Marine Corps Air Station in 1943, training sixteen squadrons of fighters, bombers, and transports during WWII.",
      "sourceSentenceIds": [
        27,
        15
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Naval_Air_Facility_El_Centro"
    },
    {
      "id": 4,
      "text": "In 1947 the Parachute Experimental Division moved from Lakehurst to El Centro, turning the airfield into a national parachute test range.",
      "sourceSentenceIds": [
        11,
        10
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 2"
      ],
      "source": "https://en.wikipedia.org/wiki/Naval_Air_Facility_El_Centro"
    },
    {
      "id": 5,
      "text": "The Blue Angels kick off their season with an air show at El Centro, a tradition that started when the base hosted their first show.",
