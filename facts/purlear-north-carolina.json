  "facts": [
    {
      "id": 1,
      "text": "Purlear named after Isaac Parlier, who settled along Purlear Creek in the 1770s.",
      "sourceSentenceIds": [
        2,
        6
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/purlear_north_carolina",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The community sits about 2.7 miles west of Millers Creek, nestled in Wilkes County’s rolling Brushy Mountains.",
      "sourceSentenceIds": [
        12,
        29
      ],
      "sourceLabels": [
        "Web source 1",
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/purlear_north_carolina",
