      "quality": "poor",
      "qualityReason": "location_description"
    },
    {
      "id": 3,
      "text": "Purlear Creek’s water quality improved after a 2006 restoration that added 2,600 feet of native plantings and in‑stream structures.",
      "sourceSentenceIds": [
        21
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/purlear_north_carolina",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "In 1884, Purlear opened its first post office, marking its growth from a rural crossroads to a recognized community.",
      "sourceSentenceIds": [
        28
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/purlear_north_carolina",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The area was once Cherokee territory, with villages and trails along the Yadkin River valley before European settlers arrived.",
      "sourceSentenceIds": [
        1,
        5
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/purlear_north_carolina",
      "category": "history",
      "quality": "good"
    },
    {
