      "quality": "good"
    },
    {
      "id": 3,
      "text": "Gosselies airfield hosted Belgium’s first flight school in 1919, launching the region’s aeronautical heritage.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
