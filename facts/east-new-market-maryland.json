  "facts": [
    {
      "id": 1,
      "text": "East New Market earned its name when a 1776 land patent granted James Sulivane the title 'New Market,' just before the Declaration of Independence.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/East_New_Market%2C_Maryland",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Settled in the 1600s, East New Market grew into a bustling trading post where Native Americans and European settlers exchanged goods.",
      "sourceSentenceIds": [
        2,
        15
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://townofeastnewmarket.com/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "A Greek‑revival Trinity Church, built around 1848, replaced the older Union Chapel and reflects the town’s 19th‑century religious architecture.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/East_New_Market%2C_Maryland",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "East New Market sits about six miles northeast of Cambridge, the Dorchester County seat, placing it within easy reach of four county capitals.",
      "sourceSentenceIds": [
        27
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/East_New_Market%2C_Maryland",
      "category": "other",
      "quality": "poor",
      "qualityReason": "location_description"
    },
    {
      "id": 5,
      "text": "Many 17th‑century buildings survive in East New Market because economic hardship during the Great Depression halted new construction.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/East_New_Market%2C_Maryland",
      "category": "history",
      "quality": "good"
    },
    {
