  "facts": [
    {
      "id": 1,
      "text": "Ikuno‑ku’s narrow streets embody a “shitamachi” atmosphere, with aging wooden buildings, street vendors, and public baths that evoke a gritty, nostalgic vibe.",
      "sourceSentenceIds": [
        19
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.lawrencetravelstories.com/eng-the-palimpsest-of-osaka-walking-through-1-600-years-of-history-in-ikuno-ku/",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The ward’s name, Ikuno, means “field” in Japanese and has long attracted a sizable Korean community, giving the area a distinct Korea Town identity.",
      "sourceSentenceIds": [
        22,
        24
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Ikuno-ku%2C_Osaka",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "In 1921, Koyo Seiko (now JTEKT) opened its bearing factory on marshland once drained by Emperor Nintoku, sparking Ikuno’s modern industrial era.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.lawrencetravelstories.com/eng-the-palimpsest-of-osaka-walking-through-1-600-years-of-history-in-ikuno-ku/",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "A 1,500‑year‑old drainage system laid the groundwork for Ikuno’s 20th‑century factories, literally turning tide‑tamed marshes into industrial land.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.lawrencetravelstories.com/eng-the-palimpsest-of-osaka-walking-through-1-600-years-of-history-in-ikuno-ku/",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The maze of shotengai near Tsuruhashi Station is one of Osaka’s most bustling traditional shopping arcades, still thriving today.",
      "sourceSentenceIds": [
        17
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.osaka.com/wards/ikuno/ikuno-ward-past-present-and-future/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Minami‑Ikuno Onsen, an old‑school bathhouse near Teradacho station, offers a classic bathing experience that locals cherish.",
