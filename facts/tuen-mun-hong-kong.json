  "facts": [
    {
      "id": 1,
      "text": "The name Tuen Mun comes from the To clan, who migrated from Jiangxi and founded a village called Tuen Mun Tsuen in the Yuan dynasty.",
      "sourceSentenceIds": [
        18,
        19
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Tuen_Mun",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Archaeological digs show Tuen Mun was one of Hong Kong’s earliest settlements, dating back to the Neolithic period.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Tuen_Mun",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "In the past, Tuen Mun was a hub for Tanka fishermen who gathered at Castle Peak Bay for their daily catch.",
      "sourceSentenceIds": [
        13
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Tuen_Mun",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The modern Tuen Mun New Town began construction in 1970 on reclaimed land from former Castle Peak Bay, reshaping the area.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Tuen_Mun",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Tuen Mun Town Hall, a multi‑story theatre and concert venue, serves as the cultural heart of the town centre.",
