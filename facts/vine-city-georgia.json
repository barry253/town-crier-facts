  "facts": [
    {
      "id": 1,
      "text": "Vine City grew around the Western and Atlantic Railroad, whose tracks were laid through the area in the 1840s.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Vinings%2C_Georgia",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Originally called Western Heights, the neighborhood was founded in 1891 as a white working‑class enclave before becoming a thriving Black middle‑class community in the mid‑century.",
      "sourceSentenceIds": [
        11,
        9
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://atldowntownwest.com/2025/08/19/vine-city-english-avenue-a-tale-of-two-neighborhoods/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Paschal’s Restaurant opened on English Avenue in 1947 and served as a key civil rights hub for the community.",
      "sourceSentenceIds": [
        4,
        2
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://atldowntownwest.com/2025/08/19/vine-city-english-avenue-a-tale-of-two-neighborhoods/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The English Avenue School was listed on the National Register of Historic Places in 2020 and is planned to be converted into a community center.",
      "sourceSentenceIds": [
        25,
        4
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://atldowntownwest.com/2025/08/19/vine-city-english-avenue-a-tale-of-two-neighborhoods/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The Alliance at Cook Park preserves Vine City’s history and hosts community events that celebrate the neighborhood’s heritage.",
      "sourceSentenceIds": [
        17
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.theallianceatcookpark.org/vinecity",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Lindsay Street Park opened in 2015 as Vine City’s first public park, later expanded into Kathryn Johnston Memorial Park in 2019 to honor the community’s resilience.",
      "sourceSentenceIds": [
        4
      ],
