      "id": 1,
      "text": "Bluffton earned the nickname 'Parlor City' because its early paved streets were as clean as a parlor during the gas boom.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
