  "facts": [
    {
      "id": 1,
      "text": "Rixeyville takes its name from the Rixey family, who arrived in the early 1800s from Fauquier County.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://culpepermuseum.com/rixeyville/"
    },
    {
      "id": 2,
      "text": "The community lies on Virginia State Route 229, roughly 7.4 miles north of the town of Culpeper.",
      "sourceSentenceIds": [
        19,
        20
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Rixeyville%2C_Virginia"
    },
    {
      "id": 3,
      "text": "Revolutionary War veteran Richard Rixey and his four sons purchased thousands of acres from the Pendleton family in the early 1800s.",
      "sourceSentenceIds": [
        22
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://culpepermuseum.com/rixeyville/"
    },
    {
      "id": 4,
      "text": "Rixeyville’s first post office opened in 1818 inside a log cabin, marking the town’s first official postal service.",
      "sourceSentenceIds": [
        23
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://culpepermuseum.com/rixeyville/"
    },
    {
      "id": 5,
      "text": "From the 1870s until 1994, the local post office operated out of the “Maw and Paws” store before moving to its present location.",
      "sourceSentenceIds": [
        24
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://culpepermuseum.com/rixeyville/"
    },
    {
      "id": 6,
      "text": "In June 2024, a historical marker honoring the Rixey family was unveiled next to Ma & Pa’s Country Mall.",
      "sourceSentenceIds": [
        2,
        3,
        28
      ],
      "sourceLabels": [
        "Web source 2"
      ],
