  "facts": [
    {
      "id": 1,
      "text": "Bielany’s name comes from the white habits of the Camaldolese monks who founded the local priory.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/bielany_lipsko_county"
    },
    {
      "id": 2,
      "text": "In the first half of the 17th century, King Władysław IV Vasa invited Camaldolese monks to build a hermitage in Bielany.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://biveros.com/bielany-warsaw-poland/"
    },
    {
      "id": 3,
      "text": "The campus of the Józef Piłsudski University of Physical Education stands as a prominent landmark in Bielany.",
      "sourceSentenceIds": [
        13
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://biveros.com/bielany-warsaw-poland/"
    },
    {
      "id": 4,
      "text": "Bielany’s northeastern border follows the Vistula River, while its northwestern edge meets Warsaw’s city limits.",
      "sourceSentenceIds": [
        16
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Bielany"
    },
    {
      "id": 5,
      "text": "The 2.06‑km² village has no major roads; the nearest provincial road, No. 747, lies about ten kilometres away.",
      "sourceSentenceIds": [
        22,
        23
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/bielany_lipsko_county"
    },
    {
      "id": 6,
      "text": "During the Kingdom of Poland era, Bielany belonged to Radom Land, an agricultural region surrounded by wetlands and forests.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/bielany_lipsko_county"
    }
  ]
