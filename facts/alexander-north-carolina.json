      ],
      "source": "https://alexandercountync.gov/explore/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The Alexander Railroad Company runs a short‑line rail between Taylorsville and Statesville, linking to Norfolk Southern.",
      "sourceSentenceIds": [
