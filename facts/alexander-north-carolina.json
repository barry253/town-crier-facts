      ],
      "source": "https://alexandercountync.gov/explore/",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Since 2013, the Alexander County Visitor Center has been housed in the historic Lucas Mansion, thanks to a partnership with Hiddenite Arts & Heritage Center.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
