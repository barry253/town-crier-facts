  "facts": [
    {
      "id": 1,
      "text": "Vado was founded in 1920 by Francis “Frank” Marion Boyer and his wife Ella Louise after their earlier settlement Blackdom failed because of water well problems.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Vado%2C_New_Mexico",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Boyer and his wife established Vado as New Mexico’s first all‑African‑American settlement, a milestone in the state’s civil‑rights history.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.nps.gov/places/vado-new-mexico.htm",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The Paul Lawrence Dunbar School, named after the 19th‑century Black poet, opened in 1926 as a segregated school that still stands today.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.nps.gov/articles/000/vado-new-mexico.htm",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "In 2017 the Dunbar School earned a National Register of Historic Places designation, and a plaque now adorns its main façade.",
      "sourceSentenceIds": [
        4,
        5,
        7,
        8
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.nps.gov/articles/000/vado-new-mexico.htm",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Vado sits along the historic El Camino Real de Tierra Adentro National Historic Trail, a 15‑mile stretch south of Las Cruces.",
      "sourceSentenceIds": [
        13
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.nps.gov/places/vado-new-mexico.htm",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The Boyers are buried in Vado Riverview Cemetery, a quiet reminder of the town’s founding family.",
      "sourceSentenceIds": [
        11
      ],
      "sourceLabels": [
        "Web source 2"
      ],
