  "facts": [
    {
      "id": 1,
      "text": "Butte City takes its name from the prominent buttes that rise across the Snake River Plain, landmarks that guided early pioneers and trappers.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/butte_city_idaho",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town officially incorporated after 1950, evolving from a modest settlement tied to agriculture and ranching near the Craters of the Moon.",
      "sourceSentenceIds": [
        24
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/butte_city_idaho",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Perched at 5,315 feet, Butte City sits high above the Snake River Plain, giving it a cooler, wind‑shaped climate.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/butte_city_idaho",
      "category": "other",
      "quality": "poor",
      "qualityReason": "other"
    },
    {
      "id": 5,
      "text": "Butte City experiences a cold semi‑arid climate (Köppen BSk), with chilly winters, warm summers, and low overall moisture.",
      "sourceSentenceIds": [
        30
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/butte_city_idaho",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The Pioneer Mountains and Lost River Range rise to the north, creating a dramatic granite skyline that contrasts with the basaltic lowlands.",
      "sourceSentenceIds": [
        27
