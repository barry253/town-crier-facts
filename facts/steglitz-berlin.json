  "facts": [
    {
      "id": 1,
      "text": "Steglitz’s name comes from the Slavic word for the European goldfinch, echoing the German 'Stieglitz'.",
      "sourceSentenceIds": [
        14
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Steglitz"
    },
    {
      "id": 2,
      "text": "The first written record of Steglitz appears in a 1375 land register of Emperor Charles IV.",
      "sourceSentenceIds": [
        18
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Steglitz"
    },
    {
      "id": 3,
      "text": "In 1838 the Prussian state railways opened the Stammbahn line, boosting Steglitz’s growth.",
      "sourceSentenceIds": [
        21
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Steglitz"
    },
    {
      "id": 4,
      "text": "The late 19th‑century saw Lichterfelde and Dahlem develop luxurious villas, drawing wealthy Berliners to Steglitz.",
      "sourceSentenceIds": [
        22
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Steglitz"
    },
    {
      "id": 5,
      "text": "Steglitz’s Rathaus, a neo‑Gothic building from 1898, still houses the town hall and a U‑bahn station.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Steglitz"
    },
    {
      "id": 6,
      "text": "The 1951 opening of the first Berlin International Film Festival took place in Steglitz, marking a cultural milestone.",
