  "facts": [
    {
      "id": 1,
      "text": "Plano’s name comes from the Spanish word for “level,” chosen to describe its flat prairie setting after the town was renamed in 1882.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 2"
      ],
