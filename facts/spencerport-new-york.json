  "facts": [
    {
      "id": 1,
      "text": "Spencerport grew from a farm bought by Daniel Spencer in 1804, later becoming the first village lots when the Erie Canal opened.",
      "sourceSentenceIds": [
        16,
        17
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Spencerport%2C_New_York",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The village’s name evolved from 'Spencer's Basin' to Spencerport as the canal turned the area into a bustling port.",
      "sourceSentenceIds": [
        18
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Spencerport%2C_New_York",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The Spencerport Depot & Canal Museum sits in a restored 1900s trolley station, offering interactive exhibits on the canal’s history.",
      "sourceSentenceIds": [
        12,
        10
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://daytrippingroc.com/explore-spencerport-ny/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The Spencerport Methodist Church, listed on the National Register of Historic Places in 2008, stands as a landmark of the village’s religious heritage.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Spencerport%2C_New_York",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "A historic fruit‑press manufacturer and a sash & blind factory once operated in Spencerport, reflecting its early industrial diversity.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://spencerport.gov/history/",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Spencerport’s Erie Canal heritage is celebrated in Pineway Ponds Park, which hosts a large playground and multi‑use recreation facility.",
      "sourceSentenceIds": [
        11
      ],
