  "facts": [
    {
      "id": 1,
      "text": "Belvedere Palace, built as Prince Eugene of Savoy's summer residence, was completed in the early 18th century by architect Johann Lukas von Hildebrandt.",
      "sourceSentenceIds": [
        25
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Belvedere%2C_Vienna",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "In 1781 the Upper Belvedere opened as one of the first museums worldwide, showcasing the Imperial Picture Gallery to the public.",
      "sourceSentenceIds": [
        13
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://belvederepalace.org/history",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The complex includes two Baroque palaces, an Orangery, stables, and a formal garden that together form a UNESCO World Heritage Site.",
      "sourceSentenceIds": [
        23,
        4
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Belvedere%2C_Vienna",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The Belvedere gardens were added to the World Monuments Fund Watch List in 1996, highlighting their need for restoration.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Belvedere%2C_Vienna",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Since 2019 the museum has hosted Queering the Belvedere, a Pride Month programme that examines its collection from queer perspectives.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Belvedere%2C_Vienna",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The Belvedere’s public programming features guided tours, community outreach, and film events at the Blickle Kino, linking art with local culture.",
      "sourceSentenceIds": [
        19
      ],
