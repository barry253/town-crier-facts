  "facts": [
    {
      "id": 1,
      "text": "Mormon pioneers Parley Pratt and Samuel Snyder explored the grassy basin of Snyderville in 1848 and grazed cattle there by 1853.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.summitcountyutah.gov/208/Snyderville"
    },
    {
      "id": 2,
      "text": "Snyderville was settled in 1865 by J. Snyder, who developed a sawmill and mine holdings in the area.",
      "sourceSentenceIds": [
        18,
        19
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://onlineutah.us/snydervillehistory.shtml"
    },
    {
      "id": 3,
      "text": "The community of Snyderville is located in the western part of the Snyderville Basin.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Snyderville%2C_Utah"
    },
    {
      "id": 4,
      "text": "Snyderville was originally known as Snyders Station after the Overland Stage began running through the area.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://onlineutah.us/snydervillehistory.shtml"
    },
    {
      "id": 5,
      "text": "The Kimball Hotel was built in 1862 at an Overland Stage Station and hosted Mark Twain, Walt Whitman, and Horace Greeley.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.summitcountyutah.gov/208/Snyderville"
    },
    {
      "id": 6,
      "text": "Grassy meadows that once supported cattle are now seeing more homes being built across Snyderville.",
      "sourceSentenceIds": [
        16
      ],
