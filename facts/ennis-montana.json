      ],
      "source": "https://discoveringmontana.com/towns/ennis/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Ennis's public library, the Madison Valley Public Library, serves as a community hub for history and learning.",
      "sourceSentenceIds": [
        14
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Ennis%2C_Montana",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Approximately 12 miles north, the Madison Dam creates Ennis Lake at the head of Bear Trap Canyon.",
      "sourceSentenceIds": [
        29
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Ennis%2C_Montana",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The town is flanked by the Tobacco Root Mountains to the northwest, the Gravelly Range to the southwest, and the Madison Range to the east.",
