      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Ennis sits along the Madison River, one of the Missouri River's headwater tributaries.",
      "sourceSentenceIds": [
        30
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Ennis%2C_Montana",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The Madison Valley History Museum in Ennis showcases artifacts from the American West, including a stuffed mystery creature.",
      "sourceSentenceIds": [
        10,
        11,
        20,
        21
      ],
      "sourceLabels": [
