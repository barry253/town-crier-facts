      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The Santiago General Cemetery, a sprawling outdoor museum, sits within Recoleta’s northwest corner of the Metropolitan Park.",
      "sourceSentenceIds": [
        8,
        16
      ],
      "sourceLabels": [
        "Wikipedia",
