  "facts": [
    {
      "id": 1,
      "text": "Lima’s historic core began on 18 January 1535 when Francisco Pizarro mapped the City of Kings, now the Plaza de Armas.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://freewalkingtoursperu.com/en/blog/historic-center-of-lima-peru/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The Cathedral of Lima, one of the city’s oldest buildings, houses the tomb of conqueror Francisco Pizarro.",
      "sourceSentenceIds": [
        24,
        25
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.chullostravelperu.com/blog/en/centro-historico-de-lima",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The Convent of San Francisco, famous for its colonial architecture, hides underground catacombs that reveal early Lima’s religious life.",
      "sourceSentenceIds": [
        27
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.chullostravelperu.com/blog/en/centro-historico-de-lima",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "A promenade along the Rímac River, named after singer Chabuca Granda, celebrates Peruvian music with songs like “La flor de la canel a.”.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://freewalkingtoursperu.com/en/blog/historic-center-of-lima-peru/",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "In 1988 UNESCO declared Lima’s Historic Centre a World Heritage Site for its preserved colonial architecture and urban layout.",
      "sourceSentenceIds": [
        21
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.chullostravelperu.com/blog/en/centro-historico-de-lima",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The historic centre’s narrow streets and balconies, a defining feature of Lima, each hold stories of the city’s colonial and republican past.",
      "sourceSentenceIds": [
        17
