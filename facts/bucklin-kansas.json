  "facts": [
    {
      "id": 1,
      "text": "Bucklin was originally called Corbitt when it was laid out about 1885.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Bucklin%2C_Kansas"
    },
    {
      "id": 2,
      "text": "In 1887 the town was renamed Bucklin after a civil engineer from the Rock Island division.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://fordcountyhistory.org/ford-county/cities/a-history-of-bucklin-kansas/"
    },
    {
      "id": 3,
      "text": "By July 1887 citizens organized a school and levied a two‑mill tax to support it, showing early community investment.",
      "sourceSentenceIds": [
        15
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://fordcountyhistory.org/ford-county/cities/a-history-of-bucklin-kansas/"
    },
    {
      "id": 4,
      "text": "A public library was organized in 1908, reflecting Bucklin’s early commitment to education and culture.",
      "sourceSentenceIds": [
        19
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://fordcountyhistory.org/ford-county/cities/a-history-of-bucklin-kansas/"
    },
    {
      "id": 5,
      "text": "At its peak in 1902, about 25 railroad crews worked out of Bucklin, highlighting the town’s role as a rail hub.",
      "sourceSentenceIds": [
        20
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://fordcountyhistory.org/ford-county/cities/a-history-of-bucklin-kansas/"
    },
    {
      "id": 6,
      "text": "The town’s early economy boasted 31 buildings, including general stores, a blacksmith, and a butter factory, illustrating rapid growth.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Web source 2"
      ],
