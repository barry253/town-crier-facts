  "facts": [
    {
      "id": 1,
      "text": "Woodland was incorporated as a town on March 5, 1880, its name chosen to describe the area’s abundant forests.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.woodlandto.com/history/"
    },
    {
      "id": 2,
      "text": "The first survey of the area, completed in 1859 by Lore Alford of Old Town, parceled the land into 160‑acre lots.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.woodlandto.com/history/"
    },
    {
      "id": 3,
      "text": "A later survey on November 28, 1877 mapped the township’s limits, noting an area of 34,102 square miles.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.woodlandto.com/history/"
    },
    {
      "id": 4,
      "text": "Woodland’s borders lie with New Sweden to the north, Caribou to the east, Washburn to the south, and Perham to the west.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.woodlandto.com/history/"
    },
    {
      "id": 5,
      "text": "When the first clearing was made, neighboring Perham and New Sweden were still wilderness townships not yet lotted for settlement.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.woodlandto.com/history/"
    },
    {
      "id": 6,
      "text": "Before becoming a town, Woodland was known as Township No. 14 Range 3.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.woodlandto.com/history/"
    }
  ]
