  "facts": [
    {
      "id": 1,
      "text": "Perry was named after Robert Perry, who built the first bridge across the Vermilion River in the 1820s.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/perry_louisiana"
    },
    {
      "id": 2,
      "text": "After Vermilion Parish formed in 1844, Perry briefly became the provisional parish seat, holding early court sessions in Robert Perry's store.",
      "sourceSentenceIds": [
        14
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/perry_louisiana"
    },
    {
      "id": 3,
      "text": "Today, Perry is known for its aerial lift bridge over the Vermilion River, which lets cars and boats cross side by side.",
      "sourceSentenceIds": [
        15
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/perry_louisiana"
    },
    {
      "id": 4,
      "text": "Perry sits just 7 feet above sea level, typical of Louisiana's Gulf Coastal Plain.",
      "sourceSentenceIds": [
        17
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/perry_louisiana"
    },
    {
      "id": 5,
      "text": "Perry enjoys a humid subtropical climate, averaging 69°F yearly and receiving about 60 inches of rain.",
      "sourceSentenceIds": [
        26
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/perry_louisiana"
    },
    {
      "id": 6,
      "text": "Alluvial soils from periodic flooding in Perry support staple crops like rice and soybeans.",
      "sourceSentenceIds": [
        23
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/perry_louisiana"
    }
  ]
