  "facts": [
    {
      "id": 1,
      "text": "Gwynn Oak takes its name from the nearby Gwynns Falls, named for Welsh settler Richard Gwinn who opened a trading post there in 1672.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/gwynn_oak_maryland",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The community\u2019s most famous landmark was Gwynn Oak Amusement Park, founded in 1893 as a trolley park to boost ridership on Baltimore\u2019s electric railway.",
      "sourceSentenceIds": [
        27
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/gwynn_oak_maryland",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "In July 1963, non\u2011violent protests at the park ended segregation, allowing the first African\u2011American child to ride the carousel on August 28, the same day as the March on Washington.",
      "sourceSentenceIds": [
        14
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/gwynn_oak_maryland",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Gwynn Oak sits about 7 miles northwest of downtown Baltimore, within the Baltimore\u2013Washington metropolitan area and near the Gwynns Falls valley.",
      "sourceSentenceIds": [
        17,
        18
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/gwynn_oak_maryland",
      "category": "other",
      "quality": "poor",
      "qualityReason": "location_description"
    },
    {
      "id": 5,
      "text": "The area\u2019s elevation ranges from 250 to 350 feet, shaping local drainage and contributing to historic flooding when Gwynns Falls overflows during heavy rain.",
      "sourceSentenceIds": [
        4,
        20
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/gwynn_oak_maryland",
      "category": "nature",
      "quality": "poor",
      "qualityReason": "vague"
    },
    {
      "id": 6,
      "text": "Early 20th\u2011century suburban growth in Gwynn Oak began as farmland was subdivided for workers drawn by Baltimore\u2019s industrial boom and new trolley lines.",
      "sourceSentenceIds": [
        25,
