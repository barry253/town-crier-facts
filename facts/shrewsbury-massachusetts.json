    },
    {
      "id": 3,
      "text": "The 1830 brick schoolhouse west of the church now houses town offices and the historical society.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.shrewsburyhistoricalsociety.org/1"
    },
    {
      "id": 4,
      "text": "The Shrewsbury Public Library, built in 1903, opened a new 42,000‑sq‑ft building in 2016.",
      "sourceSentenceIds": [
        12,
