  "facts": [
    {
      "id": 1,
      "text": "Pullman was built in the 1880s by George Pullman as workers' housing for his railroad car company.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Pullman%2C_Chicago",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town’s original architect, Solon Spencer Beman, designed the rowhouses and the Hotel Florence, the first non‑industrial building.",
      "sourceSentenceIds": [
        10,
        11
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://home.nps.gov/pull/learn/historyculture/the-town-of-pullman.htm",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "In 1969 Pullman became a National Historic Landmark District, protecting its 900 original rowhouses and public buildings.",
      "sourceSentenceIds": [
        19,
        20
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Pullman%2C_Chicago",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The Pullman State Historic Site, operated by the Illinois Department of Natural Resources, sits in the former factory grounds.",
      "sourceSentenceIds": [
        27
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://home.nps.gov/pull/learn/historyculture/the-town-of-pullman.htm",
      "category": "landmark",
      "quality": "good"
    },
    {
