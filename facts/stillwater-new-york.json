      ],
      "source": "https://villageofstillwaterny.gov/historian/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Saratoga National Historical Park, inside Stillwater, preserves the battlefield where the 1777 Battle of Saratoga turned the tide of the Revolution.",
      "sourceSentenceIds": [
        5,
