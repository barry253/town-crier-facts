  "facts": [
    {
      "id": 1,
      "text": "Germfask’s name comes from the first letters of eight original settlers’ surnames—Grant, Edge, Robinson, Mead, French, Ackley, Sheppard, and Knaggs.",
      "sourceSentenceIds": [
        13,
        14
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Germfask_Township%2C_Michigan"
    },
    {
      "id": 2,
      "text": "Founded in 1881, Germfask grew from a handful of pioneers who called the Upper Peninsula their new home.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://northernmichiganhistory.com/germfask-michigan/"
    },
    {
      "id": 3,
      "text": "The town once hosted a station on the Manistique Railway, linking it to regional trade in the late 1800s.",
      "sourceSentenceIds": [
        11,
        3
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Germfask_Township%2C_Michigan"
    },
    {
      "id": 4,
      "text": "Germfask sits amid the vast Hiawatha National Forest, a backdrop of pine and wildlife for residents and visitors.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://northernmichiganhistory.com/germfask-michigan/"
    },
    {
      "id": 5,
      "text": "From 1933 to 1942, a Civilian Conservation Corps camp operated in Germfask, employing young men in forest work.",
      "sourceSentenceIds": [
        22,
        23,
        24
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://northernmichiganhistory.com/germfask-michigan/"
    },
    {
      "id": 6,
      "text": "The community lies where the Manistique River crosses M‑77, just east of the Seney National Wildlife Refuge.",
