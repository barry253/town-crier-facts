  "facts": [
    {
      "id": 1,
      "text": "Witikon was incorporated into the city of Zürich in 1934, ending its status as an independent municipality.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Witikon"
    },
    {
      "id": 2,
      "text": "The neighborhood sits between the southwestern flank of the Adlisberg and the western flank of the Öschbrig, giving it a unique hilltop position.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Witikon"
    },
    {
      "id": 3,
      "text": "From its hilltop, residents enjoy panoramic views of the Swiss Alps and surrounding valleys.",
      "sourceSentenceIds": [
        10,
        14
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://swissglorious.com/towns-and-cities/witikon"
    },
    {
      "id": 4,
      "text": "The Witikon Tower, a local landmark, provides sweeping vistas of the city and surrounding landscape.",
      "sourceSentenceIds": [
        22
