  "facts": [
    {
      "id": 1,
      "text": "Camptonville was a bustling Gold Rush stage‑stop of 1,500 people on the route between Marysville and Downieville.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.camptonville.net/p/history.html"
    },
    {
      "id": 2,
      "text": "Gold was discovered in 1850, and the town was first called Gold Ridge before adopting the name Camptonville in 1854.",
      "sourceSentenceIds": [
        17,
        18,
        19
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Camptonville%2C_California"
    },
    {
      "id": 3,
      "text": "The Camptonville Historical Society, founded in 1975, preserves artifacts, photographs, and documents that tell the town’s mining and timber heritage.",
      "sourceSentenceIds": [
        1,
        2,
        14
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://museumsdatabase.com/museums/view/2200"
    },
    {
      "id": 4,
      "text": "Camptonville sits on a ridge between the North Fork and Middle Fork of the Yuba River, near the New Bullards Bar Dam Reservoir.",
      "sourceSentenceIds": [
        15
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Camptonville%2C_California"
    },
    {
      "id": 5,
      "text": "In the 1850s and 1860s, Henness Pass Road made Camptonville a key stop for travelers crossing the Sierra Nevada.",
      "sourceSentenceIds": [
        20
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Camptonville%2C_California"
    },
    {
      "id": 6,
      "text": "A local plaque notes that at its peak, Camptonville hosted over fifty saloons, brothels, and even a bowling alley.",
      "sourceSentenceIds": [
        21
