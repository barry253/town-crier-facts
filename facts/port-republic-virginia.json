  "facts": [
    {
      "id": 1,
      "text": "Port Republic was chartered as a town in 1802 where the North and South Rivers meet to form the South Fork of the Shenandoah River.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Port_Republic%2C_Virginia",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The village became a bustling river port in the 1800s, shipping agricultural goods until the railroad bypassed it in the 1890s.",
      "sourceSentenceIds": [
        14
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.dhr.virginia.gov/historic-registers/082-0123/",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "During the Civil War, the Battle of Port Republic took place here, making the town a key strategic point on the Shenandoah Valley.",
      "sourceSentenceIds": [
        16
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Port_Republic%2C_Virginia",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The Port Republic Historic District, listed on the National Register of Historic Places in 1980, preserves the grid‑plan layout of the original 1802 village.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.dhr.virginia.gov/historic-registers/082-0123/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The Port Republic Museum, founded by the local historical society, houses artifacts from the town’s founding and a 1776 gundalow model of the USS Philadelphia.",
      "sourceSentenceIds": [
        1,
        7,
        8
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.portrepublicmuseum.org/history",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "In 1992, the community raised funds to buy the historic Frank Kemper House, also known as the Turner Ashby House, preserving a landmark of the town’s early era.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.portrepublicmuseum.org/history",
      "category": "history",
      "quality": "good"
    }
