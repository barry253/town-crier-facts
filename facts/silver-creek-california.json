  "facts": [
    {
      "id": 1,
      "text": "Silver Creek was the largest Chinese settlement in Plumas County, housing over 500 residents from about 1855 to the 1920s.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Silver_Creek%2C_California",
      "category": "people",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The community built the only Joss House in Plumas County by the 1860s, serving as a spiritual center for its Chinese residents.",
      "sourceSentenceIds": [
        22,
        23
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://exploreapaheritage.com/index_php/sites/silver-creek/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Silver Creek’s Chinese miners re‑worked placer gold diggings with great success, turning the area into a thriving mining hub in the mid‑1800s.",
      "sourceSentenceIds": [
        15,
        16
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://exploreapaheritage.com/index_php/sites/silver-creek/",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "A mule‑packing business from Silver Creek supplied fresh vegetables and meat to surrounding mining camps, supporting the regional economy.",
      "sourceSentenceIds": [
        19
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://exploreapaheritage.com/index_php/sites/silver-creek/",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The town’s Chinese cemetery, located near the settlement, remains one of the few physical remnants after the 1929 fire that largely destroyed Silver Creek.",
      "sourceSentenceIds": [
        24,
