  "facts": [
    {
      "id": 1,
      "text": "The town was renamed Weiner in 1881 when the Louis and Southwestern Railroad built a station, honoring a St. Louis railroad official.",
      "sourceSentenceIds": [
        1,
        2,
        8
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/weiner_arkansas",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "A post office named West Prairie opened in 1874, and by 1884, it was renamed Weiner; the town incorporated on December 2, 1907.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/weiner_arkansas",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Between 1870 and 1880, the West Prairie area saw a notable influx of new settlers, including several families of German origin drawn by reports of fertile land.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/weiner_arkansas",
      "category": "people",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Originally featuring a prairie landscape surrounded by forests, the topography around Weiner consists of rolling to flat plains that were largely cleared for farmland by the mid-20th century.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Web source 2"
      ],
