  "facts": [
    {
      "id": 1,
      "text": "Rineyville takes its name from Zachariah Riney, the first school teacher of a young Abraham Lincoln.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Rineyville%2C_Kentucky"
    },
    {
      "id": 2,
      "text": "In 1874, Sylvester Riney donated land for the Illinois Central Railroad, anchoring the town’s growth.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://history.ky.gov/markers/rineyville-named"
    },
    {
      "id": 3,
      "text": "Zachariah Riney built a double‑log house in Rineyville in 1830, later expanding it into a clapboarded home.",
      "sourceSentenceIds": [
        24
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://history.ky.gov/markers/rineyville-named"
    },
    {
      "id": 4,
      "text": "Mancil G., Zachariah Riney’s grandson, became Rineyville’s first postmaster, serving the fledgling community.",
      "sourceSentenceIds": [
        26
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://history.ky.gov/markers/rineyville-named"
    },
    {
      "id": 5,
      "text": "Rineyville remains unincorporated; a magistrate elected to the Hardin County Fiscal Court represents the community.",
