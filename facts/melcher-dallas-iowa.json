  "facts": [
    {
      "id": 1,
      "text": "Melcher was platted in 1913 south of Dallas and named after a Rock Island Railroad executive, underscoring rail's role in its founding.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/melcher_dallas_iowa",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The city of Melcher-Dallas emerged in 1986 when the neighboring towns of Dallas and Melcher merged, a union celebrated each May as Merger Day.",
      "sourceSentenceIds": [
        5,
        6
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/melcher_dallas_iowa",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The Consolidated Indiana Coal Company began mining in 1912 southeast of Dallas, sinking the first major shaft and building concrete-lined shafts and power houses.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/melcher_dallas_iowa",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Melcher-Dallas’s community enrichment efforts are led by a 501(c)(3) nonprofit founded in 2023, building on earlier groups like the Coal Miners Committee.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/melcher_dallas_iowa",
      "category": "other",
      "quality": "poor",
      "qualityReason": "other"
    },
    {
      "id": 5,
      "text": "The town’s name traces back to Dallas, founded in 1845 and originally called Ohio after many settlers’ home state.",
