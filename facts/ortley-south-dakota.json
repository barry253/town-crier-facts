  "facts": [
    {
      "id": 1,
      "text": "Ortley was established in 1906 as a planned town on land from the Sisseton Wahpeton Indian Reservation.",
      "sourceSentenceIds": [
        1,
        10
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/ortley_south_dakota"
    },
    {
      "id": 2,
      "text": "The town was originally called Anderson Townsite before being renamed Ortley to align with the surrounding township.",
      "sourceSentenceIds": [
        3,
        17,
        19
      ],
      "sourceLabels": [
        "Web source 2",
        "Wikipedia"
      ],
      "source": "https://grokipedia.com/page/ortley_south_dakota"
    },
    {
      "id": 3,
      "text": "Ortley's layout follows a characteristic T-plan typical of railroad towns, with streets oriented around the former rail line.",
      "sourceSentenceIds": [
        9,
        11
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/ortley_south_dakota"
    },
    {
      "id": 4,
      "text": "Historically, Ortley's economy centered on farming, livestock raising, and dairying to support the fertile prairies of Roberts County.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
