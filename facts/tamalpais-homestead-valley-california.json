  "facts": [
    {
      "id": 1,
      "text": "Tamalpais‑Homestead Valley’s name comes from the Coast Miwok word for 'sea‑by‑the‑bay,' pointing to its view of the Pacific and San Francisco Bay.",
      "sourceSentenceIds": [
        21
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.wisdomlib.org/cities/tamalpais-homestead-valley-35267",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The community sits on the southern slopes of Mount Tamalpais, giving residents sweeping views of the Golden Gate and the Pacific.",
      "sourceSentenceIds": [
        23
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.wisdomlib.org/cities/tamalpais-homestead-valley-35267",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Just a short drive away, Muir Woods National Monument and the Marin Headlands offer redwood hikes and panoramic ocean vistas.",
      "sourceSentenceIds": [
        24
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.wisdomlib.org/cities/tamalpais-homestead-valley-35267",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Tamalpais‑Homestead Valley is an unincorporated area within Marin County, California, governed directly by the county rather than a city council.",
      "sourceSentenceIds": [
        22
      ],
      "sourceLabels": [
        "Web source 1"
