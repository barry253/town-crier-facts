      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Webster Park spans 550 acres along the Lake Ontario waterfront, offering one of the largest green spaces in the region.",
      "sourceSentenceIds": [
        27
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Webster%2C_New_York",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The town was originally part of North Penfield before residents petitioned for separate town status in the early 19th century.",
      "sourceSentenceIds": [
        7,
        8
      ],
      "sourceLabels": [
        "Web source 1",
