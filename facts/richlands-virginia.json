      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town’s formal layout appeared in 1890 when the Norfolk and Western Railroad arrived, turning a sparse farm area into a planned community.",
      "sourceSentenceIds": [
        11
      ],
      "sourceLabels": [
        "Web source 2"
      ],
