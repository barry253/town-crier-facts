      "id": 1,
      "text": "Niederwald was founded by German pioneers in the 1890s and incorporated as a city in 1987.",
      "sourceSentenceIds": [
        25,
        27
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.niederwald.texas.gov/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town’s name means “low wood” and refers to mesquite trees that grew where the Germans settled.",
      "sourceSentenceIds": [
        26
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.niederwald.texas.gov/",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Niederwald sits on the border of Hays and Caldwell counties in Central Texas.",
      "sourceSentenceIds": [
        3,
        6
      ],
      "sourceLabels": [
