  "facts": [
    {
      "id": 1,
      "text": "Holiday Island began as Bandy's Bend, where pioneer Hugh Bandy settled near a bend in the White River.",
      "sourceSentenceIds": [
        4,
        5,
        2
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.visitholidayisland.com/city-history"
    },
    {
      "id": 2,
      "text": "In 1958, the Table Rock Dam created Table Rock Lake, turning the quiet river bend into a 53,000‑acre recreational lake.",
      "sourceSentenceIds": [
        6,
        30
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.visitholidayisland.com/city-history"
    },
    {
      "id": 3,
      "text": "Holiday Island incorporated as a town in December 2020 and was elevated to a second‑class city in March 2021.",
      "sourceSentenceIds": [
        24,
        25,
        19
      ],
      "sourceLabels": [
        "Web source 1",
        "Wikipedia"
      ],
      "source": "https://www.visitholidayisland.com/city-history"
    },
    {
      "id": 4,
      "text": "Holiday Island sits on the northern edge of the Ozark Mountains, overlooking the shores of Table Rock Lake.",
      "sourceSentenceIds": [
        27,
        12
      ],
      "sourceLabels": [
        "Web source 1",
        "Wikipedia"
      ],
      "source": "https://www.visitholidayisland.com/city-history"
    },
    {
      "id": 5,
      "text": "Before settlers, the area was part of the Osage Nation’s ancestral hunting grounds, traversed by seasonal travelers.",
      "sourceSentenceIds": [
        28,
        29
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.visitholidayisland.com/city-history"
    },
    {
      "id": 6,
      "text": "Today, Holiday Island boasts golf courses, a marina, and retail hubs that anchor its growing community.",
      "sourceSentenceIds": [
