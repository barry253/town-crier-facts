  "facts": [
    {
      "id": 1,
      "text": "Nob Hill was named after San Francisco's Nob Hill to evoke a fashionable image, per developer Sellers.",
      "sourceSentenceIds": [
        2,
        3
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Nob_Hill%2C_Albuquerque%2C_New_Mexico"
    },
    {
      "id": 2,
      "text": "The neighborhood first developed in the mid‑1920s, with Route 66 connections, historic homes, and bright neon lights.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://albuquerque.com/exploring-albuquerques-historic-nob-hill/"
    },
    {
      "id": 3,
      "text": "Six early‑20th‑century subdivisions were built between 1916 and 1945, three of which now sit on state and national historic registers.",
      "sourceSentenceIds": [
        12,
        18
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://albuquerque.com/exploring-albuquerques-historic-nob-hill/"
    },
    {
      "id": 4,
      "text": "In 1947, Robert Waggoman opened Albuquerque’s first modern shopping center, the Nob Hill Business Center, at Central and Carlisle.",
      "sourceSentenceIds": [
        19
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Nob_Hill%2C_Albuquerque%2C_New_Mexico"
    },
    {
      "id": 5,
      "text": "The Art Moderne building at 3222 Central Ave, designed by Tom Danahy, served as Ralph Jones car dealership and was the most modern service station in the West.",
      "sourceSentenceIds": [
        23,
        24
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://albuquerque.com/exploring-albuquerques-historic-nob-hill/"
    },
    {
      "id": 6,
      "text": "Route 66’s alignment along Central Avenue in 1939 brought the first Conoco service station to Nob Hill, marking the area’s early automotive heritage.",
      "sourceSentenceIds": [
        25
      ],
