  "facts": [
    {
      "id": 1,
      "text": "Montezuma sits at the great bend of the Seneca River in Cayuga County, named after the Aztec chieftain.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://montezumahistoricalsociety.wordpress.com/history/town-history/",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town’s history museum, housed in a converted 1837 schoolhouse, opened in 1975 and showcases artifacts from early settlers and the Underground Railroad.",
      "sourceSentenceIds": [
        1,
        11
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://museumsdatabase.com/museums/view/21968",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Mentz Church, founded by early settlers, was listed on the National Register of Historic Places in 2004.",
      "sourceSentenceIds": [
        3,
        6
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Montezuma%2C_New_York",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "In 1965, Montezuma secured funding to acquire 136 acres of canal land, preserving rich natural and historic resources.",
      "sourceSentenceIds": [
        18
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://montezumahistoricalsociety.wordpress.com/history/town-history/",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The Montezuma Historical Society, established in 1960, operates out of the historic schoolhouse and hosts lectures, workshops, and guided tours each year.",
      "sourceSentenceIds": [
        10,
