  "facts": [
    {
      "id": 1,
      "text": "Quitman’s town was first called Tobanana after the nearby creek before adopting its current name in 1836.",
      "sourceSentenceIds": [
        15
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Georgetown%2C_Quitman_County%2C_Georgia",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Quitman County hosts the Mule Train Cultural Trail, highlighted by the annual Mules and Blues Fest that celebrates the Poor People’s Campaign.",
      "sourceSentenceIds": [
        4,
        6,
        14
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://discoverqc.org/tourism/",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Historic landmarks in Quitman include the Eudora AME Zion Church, the Illinois Central Coaling Tower, and the Rosenwald School.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://discoverqc.org/tourism/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The last march organized by Martin Luther King Jr. in Quitman sparked the first Poor People’s Campaign in Washington, D.C.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://discoverqc.org/tourism/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "In 1903 a fire razed almost every building in Quitman, leaving only the post office and three houses standing.",
      "sourceSentenceIds": [
        24
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Georgetown%2C_Quitman_County%2C_Georgia",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Georgetown was designated the county seat of Quitman County in 1859 and laid out by the Inferior Court.",
