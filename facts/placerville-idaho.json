  "facts": [
    {
      "id": 1,
      "text": "Founded during the 1862 gold rush, it quickly grew to house thousands of miners, with 90 buildings including hotels and saloons.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://unitedstatesghosttowns.com/placerville-idaho-ghost-town/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Placerville received its name because of placer mining near the surrounding rivers.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Placerville%2C_Idaho",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Placerville was unusual in that it even had a street grid and a town square, known locally as the 'plaza.'.",
      "sourceSentenceIds": [
        20
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Placerville%2C_Idaho",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The fire that is most remembered is the 1899 fire, which practically destroyed the town.",
      "sourceSentenceIds": [
        26
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Placerville%2C_Idaho",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Today, about 53 people maintain this former boomtown's heritage, where gold-panning tourists and abandoned buildings tell tales of the American West.",
