  "facts": [
    {
      "id": 1,
      "text": "Hooper Bay was originally called Naparyarmiut, meaning \"people of Naparyaraq slough\" in Central Yup'ik.",
      "sourceSentenceIds": [
        11
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/Hooper_Bay,_Alaska"
    },
    {
      "id": 2,
      "text": "In the early 20th century, a Catholic mission was founded in Hooper Bay, sparking early Western influence.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.kupi.com/en/explore/united-states/hooper-bay/history"
    },
    {
      "id": 3,
      "text": "The 1906 Alaska Native Allotment Act let Hooper Bay residents claim up to 160 acres for personal use and village growth.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/Hooper_Bay,_Alaska"
    },
    {
      "id": 4,
      "text": "Hooper Bay sits on the Yukon‑Kuskokwim Delta, hugging the Bering Sea coast.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.kupi.com/en/explore/united-states/hooper-bay/history"
    },
    {
      "id": 5,
      "text": "Early settlers built semi‑subterranean houses and communal \"qasgiq\" from driftwood and sod to withstand tundra conditions.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.kupi.com/en/explore/united-states/hooper-bay/history"
    },
    {
      "id": 6,
      "text": "Yup'ik ancestors in Hooper Bay fought the Bow and Arrow Wars until Russian explorers arrived in the 1840s.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 2"
      ],
