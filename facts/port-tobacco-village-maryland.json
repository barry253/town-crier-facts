  "facts": [
    {
      "id": 1,
      "text": "Port Tobacco Village was the seat of Charles County from 1727 until 1895, serving as a bustling port on the Potomac River.",
      "sourceSentenceIds": [
        21
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.explorecharlescounty.com/see-do/history-and-heritage/historic-port-tobacco-village/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Stagg Hall, built by merchant Thomas Howe Ridgate, now houses a historic home museum open Thursday–Sunday.",
      "sourceSentenceIds": [
        23
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.explorecharlescounty.com/see-do/history-and-heritage/historic-port-tobacco-village/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The town’s decline began when the Port Tobacco River silted, cutting off river traffic and silting the tobacco trade.",
      "sourceSentenceIds": [
        25,
        26
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://midatlanticdaytrips.com/2024/07/historic-port-tobacco/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The former 1819 courthouse now operates as a historical museum, preserving artifacts from the town’s colonial era.",
      "sourceSentenceIds": [
        11
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Port_Tobacco_Village%2C_Maryland",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Port Tobacco hosts the Thomas Stone National Historic Site, where signer of the Declaration of Independence built Habre de Venture in 1771.",
      "sourceSentenceIds": [
        24
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://midatlanticdaytrips.com/2024/07/historic-port-tobacco/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The area is one of the richest archaeological sites in Southern Maryland, revealing layers of Native American, colonial, and enslaved African history.",
