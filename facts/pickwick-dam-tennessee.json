  "facts": [
    {
      "id": 1,
      "text": "Built by the Tennessee Valley Authority between 1935 and 1938, Pickwick Dam was a New Deal project that opened a continuous navigation channel on the Tennessee River.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://livingnewdeal.org/sites/pickwick-landing-dam-pickwick-dam-tn/"
    },
    {
      "id": 2,
      "text": "The dam holds back 43,100 acres of Pickwick Lake, whose tailwaters flow into Kentucky Lake downstream.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://livingnewdeal.org/sites/pickwick-landing-dam-pickwick-dam-tn/"
    },
    {
      "id": 3,
      "text": "During the Great Depression, the site was selected for a dam that would offer recreation, jobs, and cheap electricity to the region.",
      "sourceSentenceIds": [
        7,
        8,
        9
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.tourhardincounty.org/pickwick/"
    },
    {
      "id": 4,
      "text": "After the dam finished, Pickwick became one of the first all‑electric cities in the United States.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.tourhardincounty.org/pickwick/"
    },
    {
      "id": 5,
      "text": "In 1969, the former worker housing area was turned into Pickwick Landing State Park by the state of Tennessee.",
      "sourceSentenceIds": [
        29
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.tourhardincounty.org/pickwick/"
    },
    {
      "id": 6,
      "text": "Pickwick Landing Dam takes its name from Charles Dickens’ novel The Pickwick Papers, reflecting the riverboat stop that once thrived there.",
      "sourceSentenceIds": [
