      "id": 1,
      "text": "Staatsburg State Historic Site is the elegant country home of Ogden Mills and Ruth Livingston Mills.",
      "sourceSentenceIds": [
        6,
        15,
        18
      ],
      "sourceLabels": [
        "Web source 1",
