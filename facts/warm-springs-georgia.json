  "facts": [
    {
      "id": 1,
      "text": "Warm Springs was originally called Bullochville, named after the Bulloch family that settled there in 1806.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Warm_Springs%2C_Georgia"
    },
    {
      "id": 2,
      "text": "The town’s mineral springs flow at about 90 °F, attracting visitors in the 19th century who sought a spa experience.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Warm_Springs%2C_Georgia"
    },
    {
      "id": 3,
      "text": "Franklin D. Roosevelt first visited in October 1924, bathing in a permanent 88 °F spring to recover from polio.",
      "sourceSentenceIds": [
        13,
        14,
        15,
        16
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Warm_Springs%2C_Georgia"
    },
    {
      "id": 4,
      "text": "Roosevelt built the Little White House in 1932, a cottage that became his presidential vacation home and later a museum.",
      "sourceSentenceIds": [
        17,
        18
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Warm_Springs%2C_Georgia"
    },
    {
      "id": 5,
      "text": "The Roosevelt Warm Springs Institute for Rehabilitation, founded in the town, remains a world‑renowned center for polio recovery.",
      "sourceSentenceIds": [
        19
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Warm_Springs%2C_Georgia"
    },
    {
      "id": 6,
      "text": "Warm Springs is a National Historic Landmark District, preserving its historic spa town character and the Little White House.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.nps.gov/places/georgia-warm-springs-historic-district.htm"
