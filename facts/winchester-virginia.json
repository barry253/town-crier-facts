  "facts": [
    {
      "id": 1,
      "text": "Winchester, founded in 1744 by Colonel James Wood, is the oldest city west of the Blue Ridge Mountains in Virginia.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.winchesterva.gov/News-Happenings/About/History"
    },
    {
      "id": 2,
      "text": "In 1752 the Virginia House of Burgesses granted Winchester its fourth city charter, renaming it after Colonel Wood’s birthplace in England.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Winchester%2C_Virginia"
    },
    {
      "id": 3,
      "text": "The town once served as a strategic hub for troops raiding the Baltimore‑to‑Ohio railroad, removing 56 locomotives in 1861.",
      "sourceSentenceIds": [
        11,
        12
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Winchester%2C_Virginia"
    },
    {
      "id": 4,
      "text": "Winchester’s Handley Library, opened in 1913, stands as a fine example of Beaux‑Arts architecture in Virginia.",
      "sourceSentenceIds": [
        19
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.winchesterva.gov/News-Happenings/About/History"
    },
    {
      "id": 5,
      "text": "The Winchester‑Frederick County Historical Society, formed in 1930, now operates three museums in historic homes, including Stonewall Jackson’s headquarters.",
      "sourceSentenceIds": [
        16
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.winchesterva.gov/News-Happenings/About/History"
    },
    {
      "id": 6,
      "text": "Shenandoah University, located in Winchester, shares the town’s name with the surrounding valley and is a key educational landmark.",
      "sourceSentenceIds": [
        23
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Winchester%2C_Virginia"
    }
  ]
