  "facts": [
    {
      "id": 1,
      "text": "Cerrillos became an independent commune in 1991 after a decade of planning that began in the early 1980s.",
      "sourceSentenceIds": [
        25,
        29
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://lavozdemaipu.cl/cerrillos-celebra-sus-34-anos-de-existencia/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The name Cerrillos, meaning “little hills,” reflects the commune’s gently rolling terrain in Santiago’s southwest.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Cerrillos%2C_Chile",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "A local music legend, Banda Don Orione, originated in Cerrillos and remains a cultural touchstone for residents.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://lavozdemaipu.cl/cerrillos-celebra-sus-34-anos-de-existencia/",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The book *Cerrillos: Vida de Barrios* chronicles the area’s evolution from a Maipú suburb to a self‑governed commune.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://lavozdemaipu.cl/cerrillos-celebra-sus-34-anos-de-existencia/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Cerrillos’ municipal council is headed by an alcalde elected every four years, a structure common to Chile’s third‑level divisions.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Cerrillos%2C_Chile",
      "category": "other",
      "quality": "poor",
      "qualityReason": "other"
    },
    {
      "id": 6,
      "text": "The 1991 decree that granted Cerrillos autonomy was part of a broader effort during Chile’s return to democracy to decentralize municipal power.",
      "sourceSentenceIds": [
        29
