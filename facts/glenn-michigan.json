  "facts": [
    {
      "id": 1,
      "text": "Glenn earned the nickname \"Pancake Town\" after a 1937 snowstorm stranded travelers who could only eat pancakes at a local restaurant.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Ganges_Township%2C_Michigan"
    },
    {
      "id": 2,
      "text": "Glenn lies within Ganges Township, a civil township established in 1847 in Allegan County, Michigan.",
      "sourceSentenceIds": [
        7,
        13
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Ganges_Township%2C_Michigan"
    },
    {
      "id": 3,
      "text": "The community includes unincorporated spots such as Belknap, located at 66th Street and 116th Avenue in the township’s southern part.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Ganges_Township%2C_Michigan"
    },
    {
      "id": 4,
      "text": "Grange Corners sits in northern Glenn at 66th Street and 122nd Avenue, a historic crossroads of the township.",
      "sourceSentenceIds": [
        11
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Ganges_Township%2C_Michigan"
    },
    {
      "id": 5,
      "text": "Plummerville is found in the northwest corner of Glenn at Lake Shore Drive and 121st Avenue, another local landmark.",
      "sourceSentenceIds": [
