  "facts": [
    {
      "id": 1,
      "text": "Ben Avon Heights sits on a hill above the Ohio River nine miles from Pittsburgh, offering sweeping views of the river valley.",
      "sourceSentenceIds": [
        7,
        18
      ],
      "sourceLabels": [
        "Web source 1",
        "Wikipedia"
      ],
      "source": "https://benavonheightsborough.com/borough/borough-history.html",
      "category": "other",
      "quality": "poor",
      "qualityReason": "location_description"
    },
    {
      "id": 2,
      "text": "The borough was incorporated in 1913 after the Ben Avon Country Club closed, and its former land was subdivided into residential lots.",
      "sourceSentenceIds": [
        23,
        24
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Ben_Avon_Heights%2C_Pennsylvania",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The Shannopin Country Club, the only commercial property in the borough, opened in 1920 with a clubhouse in Ben Avon Heights and a golf course in neighboring Kilbuck.",
      "sourceSentenceIds": [
        25
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Ben_Avon_Heights%2C_Pennsylvania",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The Ben Avon Area Historical Association, founded in 1976, preserves the history of Ben Avon Heights and the surrounding communities through lectures, tours, and events.",
      "sourceSentenceIds": [
        11,
        12,
        14,
        15
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://museumsdatabase.com/museums/view/27510",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "McMillin II Memorial Park, named in 1983 after a local benefactor, sits on land that was once part of the Ben Avon Country Club.",
      "sourceSentenceIds": [
        4,
        5
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://benavonheightsborough.com/borough/borough-history.html",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "In 1910, Walter Pringle Fraser bought 84 acres from the former Taylor farm, using forty acres to build the Ben Avon Country Club and its golf course.",
      "sourceSentenceIds": [
        21
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
