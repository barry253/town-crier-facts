  "facts": [
    {
      "id": 1,
      "text": "Ladysmith was founded in the late 19th century as a logging town along the Flambeau River.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://en.wikivoyage.org/wiki/Ladysmith_(Wisconsin)"
    },
    {
      "id": 2,
      "text": "Originally called Flambeau Falls, Ladysmith was renamed in 1900 after the wife of a railroad official.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://en.wikivoyage.org/wiki/Ladysmith_(Wisconsin)"
    },
    {
      "id": 3,
      "text": "Native Americans called the area that would become Ladysmith Gakaabikijiwanan, meaning waterfalls overflowing the rocks.",
      "sourceSentenceIds": [
        25
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Ladysmith%2C_Wisconsin"
    },
    {
      "id": 4,
      "text": "The city of Ladysmith received a Carnegie grant in 1907 to help build a new public library that still stands today.",
      "sourceSentenceIds": [
        17
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Ladysmith%2C_Wisconsin"
    },
    {
      "id": 5,
      "text": "Ladysmith transitioned from a logging economy in the 1800s to one dominated by manufacturing, healthcare, and retail.",
      "sourceSentenceIds": [
        21
