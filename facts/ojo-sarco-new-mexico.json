  "facts": [
    {
      "id": 1,
      "text": "Ojo Sarco was founded by settlers on the Las Trampas Land Grant, which dates back to 1751.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Ojo_Sarco%2C_New_Mexico"
    },
    {
      "id": 2,
      "text": "The community’s name comes from a historic thermal spring called Ojo Sarco Spring, where “ojo” means “spring” or “eye” in Spanish.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/ojo_sarco_new_mexico"
    },
    {
      "id": 3,
      "text": "Ojo Sarco sits in the Sangre de Cristo Mountains, about a mile south of State Road 76 and 1.5 miles west-southwest of Las Trampas.",
      "sourceSentenceIds": [
        10,
        18
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Ojo_Sarco%2C_New_Mexico"
    },
    {
      "id": 4,
      "text": "The area experiences a semi‑arid highland climate, with cold winters dropping below freezing and mild summers moderated by its 7,400‑foot elevation.",
      "sourceSentenceIds": [
        8,
        20,
        21
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/ojo_sarco_new_mexico"
    },
    {
      "id": 5,
      "text": "By the late 19th century, the Las Trampas Land Grant supported about 1,500 residents, but early 20th‑century disputes led to selling communal lands to lumber companies.",
      "sourceSentenceIds": [
        13
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/ojo_sarco_new_mexico"
    },
    {
      "id": 6,
      "text": "Ojo Sarco had its own post office until June 8, 1996, after which mail services were consolidated with nearby towns.",
      "sourceSentenceIds": [
        11
      ],
      "sourceLabels": [
