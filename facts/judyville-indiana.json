  "facts": [
    {
      "id": 1,
      "text": "John Finley Judy founded Judyville in 1903 after moving from Ohio for the first time.",
      "sourceSentenceIds": [
        12,
        18
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Judyville%2C_Indiana",
      "category": "people",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Judy convinced Chicago and Eastern Illinois Railroad to build an eight-mile line from Vermilion County, Illinois, linking his farm to the main line.",
      "sourceSentenceIds": [
        4,
        6,
        7
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Judyville%2C_Indiana",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The town’s post office opened on October 1, 1903, with John’s son Ole Ruppert Judy as first postmaster, and closed January 6, 1961.",
      "sourceSentenceIds": [
        19,
        20
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Judyville%2C_Indiana",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Judyville sits on a gentle rise about 770 feet high, 7 miles northwest of Williamsport, near Spring Branch creek to the north and Fall Creek to the south.",
      "sourceSentenceIds": [
        25,
        26
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Judyville%2C_Indiana",
      "category": "other",
      "quality": "poor",
      "qualityReason": "location_description"
    },
    {
      "id": 5,
      "text": "By the early 1900s, Judyville boasted six barns, a hotel, an office building, and a grain elevator, making it an industrial village.",
      "sourceSentenceIds": [
        16
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Judyville%2C_Indiana",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The community’s name comes from John Judy, whose surname was anglicized from the German Tschudi.",
      "sourceSentenceIds": [
        13
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Judyville%2C_Indiana",
      "category": "etymology",
      "quality": "good"
    }
