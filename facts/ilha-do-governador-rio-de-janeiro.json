      "id": 1,
      "text": "Ilha do Governador earned its name in 1567 when Governor‑General Mem de Sá donated half the island to his nephew Salvador Correia de Sá.",
      "sourceSentenceIds": [
        22
      ],
      "sourceLabels": [
        "Web source 2"
      ],
