      "quality": "good"
    },
    {
      "id": 2,
      "text": "The area grew around the Osaka Electric Railway opening in 1914, linking it to Osaka's expansion.",
      "sourceSentenceIds": [
        11
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://article.bespes-jt.com/en/article/tsuruhashi/",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Tsuruhashi is famed for its dense concentration of Korean-style yakiniku restaurants, a culinary tradition rooted in the local Zainichi Korean community.",
      "sourceSentenceIds": [
        16
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://article.bespes-jt.com/en/article/tsuruhashi/",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The Miyuki-dori Shopping Street, about 10 minutes from Tsuruhashi Station, hosts roughly 150 shops lining narrow alleys, reflecting the area's Korean heritage.",
      "sourceSentenceIds": [
        15
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://article.bespes-jt.com/en/article/tsuruhashi/",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Ikuno Koreatown, part of Tsuruhashi, is one of Osaka's largest Korean communities, with about 20% of residents of foreign nationality as of 2024.",
