      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The Kenoza Hall restaurant serves comfort‑tavern food, highlighted by a cheese‑foam‑topped French onion soup.",
      "sourceSentenceIds": [
