      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Kenoza Hall, a historic farmhouse turned boutique hotel, restaurant, and spa, offers kayaking, bonfires, and hiking trails on the lake.",
      "sourceSentenceIds": [
        21,
        22
      ],
      "sourceLabels": [
