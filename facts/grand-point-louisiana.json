  "facts": [
    {
      "id": 1,
      "text": "Grand Point traces its roots to the Acadian Coast, where French‑speaking settlers arrived after 1765 following their expulsion from Nova Scotia.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Grand_Point%2C_Louisiana",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Perique tobacco, a rare variety cultivated by Choctaw and Chickasaw peoples, still thrives in Grand Point thanks to a pressure‑curing technique learned by Pierre Chenet in the 1790s.",
      "sourceSentenceIds": [
        2,
        12
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Grand_Point%2C_Louisiana",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Grand Point Plantation, a sugarcane plantation, served as a key economic hub during the late 19th and early 20th centuries.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/grand_point_louisiana",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "A Catholic chapel, donated land by Michel Martin in 1874 and rebuilt in 1911, served the community until 1929.",
      "sourceSentenceIds": [
        14,
        15,
        16,
        17
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Grand_Point%2C_Louisiana",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Situated in the low‑lying Mississippi River Delta, Grand Point sits on fertile alluvial soils and a network of natural levees and bayous.",
      "sourceSentenceIds": [
        22
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Grand_Point%2C_Louisiana",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "With an elevation of just 7 feet above sea level, Grand Point is vulnerable to flooding during high river stages and tropical weather events.",
      "sourceSentenceIds": [
        23
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
