  "facts": [
    {
      "id": 1,
      "text": "Harmony, Indiana, was founded in 1814 by the Harmony Society under George Rapp's leadership.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/New_Harmony%2C_Indiana",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "By 1819 New Harmony boasted a steam‑powered wool carding factory, brewery, distillery, vineyards, and a winery.",
      "sourceSentenceIds": [
        16
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/New_Harmony%2C_Indiana",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "In 1824 a group of Harmonists departed New Harmony by steamboat to found Economy, now Ambridge, Pennsylvania.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/New_Harmony%2C_Indiana",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "In January 1825 the town was purchased and renamed the New Harmony Community of Equality.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/New_Harmony%2C_Indiana",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "More than 30 original Harmonist and Owenite buildings survive in New Harmony’s National Historic Landmark district.",
      "sourceSentenceIds": [
        26
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/New_Harmony%2C_Indiana",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Architect Richard Meier designed New Harmony’s Atheneum, the Visitors Center that showcases the town’s history.",
      "sourceSentenceIds": [
        19
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
