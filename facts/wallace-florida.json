      "id": 1,
      "text": "Wallace’s roots trace back to the Lower Muscogee (Creek) people who lived in the area long before European settlers arrived.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
