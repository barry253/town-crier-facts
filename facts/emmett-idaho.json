      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Originally called Martinsville, the town became Emmett after a post office named for Emmett Cahalan, son of early settler Tom Cahalan.",
      "sourceSentenceIds": [
        1,
        3,
        26,
        27
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
