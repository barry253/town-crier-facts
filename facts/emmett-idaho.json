      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "In March 1902 the Idaho Northern Railroad arrived, linking Emmett to regional markets and boosting farming and timber.",
      "sourceSentenceIds": [
        8,
        20
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Emmett%2C_Idaho",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Downtown Emmett’s Gem County Historical Society and Village Museum showcases pioneer life, Native American history, and agricultural traditions.",
      "sourceSentenceIds": [
        15,
        16
      ],
      "sourceLabels": [
        "Web source 1"
      ],
