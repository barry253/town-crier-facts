      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Myakka_City%2C_Florida"
    },
    {
      "id": 3,
      "text": "The original Myakka City School House, built in 1914, served as a “strawberry school” for agricultural students.",
      "sourceSentenceIds": [
        15,
        16
      ],
      "sourceLabels": [
        "Web source 1"
      ],
