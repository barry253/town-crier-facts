  "facts": [
    {
      "id": 1,
      "text": "Lafayette Hill was renamed in 1883 after the French General Marquis de Lafayette, who camped there during the American Revolution.",
      "sourceSentenceIds": [
        11,
        24
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Lafayette_Hill%2C_Pennsylvania",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "During the Fall of 1777, General Washington and 11,000 troops guarded the Wissahickon Valley from British redcoats while stationed in Lafayette Hill.",
      "sourceSentenceIds": [
        20
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.whitemarshtwp.org/229/History",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Thomas Fitzwater discovered vast lime deposits on his land, leading to early limekiln activity that helped shape the township’s economy.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.whitemarshtwp.org/229/History",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The historic Limekiln Pike, one of the first roads in the area, still exists today and traces the early transportation routes of Lafayette Hill.",
      "sourceSentenceIds": [
