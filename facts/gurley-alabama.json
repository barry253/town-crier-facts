  "facts": [
    {
      "id": 1,
      "text": "Gurley grew around a water and coaling stop on the Memphis & Charleston Railroad, originally called Gurley's Tank.",
      "sourceSentenceIds": [
        3,
        1
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Gurley%2C_Alabama",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town’s name honors early settler John Gurley, who helped establish the first homesteads in 1830.",
      "sourceSentenceIds": [
        10,
        5
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://encyclopediaofalabama.org/article/gurley/",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Cedar trees supplied the town’s early industry, spawning sawmills, a bucket factory, a stave and hoop plant, and a pencil mill.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://encyclopediaofalabama.org/article/gurley/",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Gurley’s historic district and the Cumberland Presbyterian Church sit on Alabama’s Register of Landmarks and Heritage.",
      "sourceSentenceIds": [
        13
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://encyclopediaofalabama.org/article/gurley/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The town was once called Gurley's Place in the Woods, reflecting its forested surroundings.",
