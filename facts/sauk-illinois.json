  "facts": [
    {
      "id": 1,
      "text": "Sauk Village’s name means “village of the Sauk people,” honoring the Native American tribe that once inhabited the area.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.wisdomlib.org/cities/sauk-village-41697",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The land that is now Sauk Village was part of the high ground of the Valparaiso Moraine, a glacial ridge surrounding Lake Michigan.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Sauk_Village%2C_Illinois",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "In 2012 voters chose to abandon the village’s well water system in favor of Lake Michigan Water, a historic shift for local utilities.",
      "sourceSentenceIds": [
        14
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Sauk_Village%2C_Illinois",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Agnes Theodore served 25 years as Village Clerk from 1960 to 1985, the longest tenure of any elected official in Sauk Village history.",
      "sourceSentenceIds": [
        15
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Sauk_Village%2C_Illinois",
      "category": "people",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Harriet Kaminski became the first woman elected as a Village Trustee in 1965, marking a milestone in Sauk Village’s political history.",
