      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The Lexington Mennonite Church, founded on land bought by four members in 1752, now hosts 825 marked graves in its cemetery.",
      "sourceSentenceIds": [
        17,
        18
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://pennsylvaniagenealogy.org/bucks/line-lexington-pennsylvania.htm",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Line Lexington straddles three townships—Hilltown, New Britain, and Hatfield—making it one of the few villages split between three jurisdictions.",
      "sourceSentenceIds": [
        11,
        12
      ],
      "sourceLabels": [
