  "facts": [
    {
      "id": 1,
      "text": "Winchester was named after Winchester rifles, a story dramatized in Death Valley Days episode “The Thirty-Caliber Town.”.",
      "sourceSentenceIds": [
        6,
        12
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Winchester%2C_Idaho",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town began as a mill pond built in 1910 by damming Lapwai Creek, which now sits on the northern shore of Lapwai Lake.",
      "sourceSentenceIds": [
        2,
        16
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Winchester%2C_Idaho",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Timber trestles of the former Camas Prairie Railroad still crisscross the area, echoing the town’s early rail heritage.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Winchester%2C_Idaho",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Winchester sits within the Nez Perce Indian Reservation, a land opened for white settlement in 1895 by a proclamation signed by President Cleveland.",
      "sourceSentenceIds": [
        9,
        10,
        11
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Winchester%2C_Idaho",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The sawmill that powered the town closed in 1965 after the surrounding timber was exhausted, marking the end of an era.",
      "sourceSentenceIds": [
        13
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Winchester%2C_Idaho",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "A 1964 fire destroyed much of downtown Winchester, leading to the mill’s final years under Boise Cascade before its closure.",
      "sourceSentenceIds": [
