  "facts": [
    {
      "id": 1,
      "text": "Tea’s name was chosen for its brevity, with no special meaning, after the town’s original name Byron was rejected by postal officials.",
      "sourceSentenceIds": [
        3,
        15
      ],
      "sourceLabels": [
        "Web source 1",
        "Web source 2"
      ],
      "source": "https://www.teasd.com/history-of-tea",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The arrival of the Great Northern Railroad in 1880 spurred Tea’s founding, prompting the town to seek a post office soon after the line opened.",
      "sourceSentenceIds": [
        4,
        9
      ],
      "sourceLabels": [
        "Web source 1",
        "Web source 1"
      ],
      "source": "https://www.teasd.com/history-of-tea",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "In 1900 Tea was plotted and officially incorporated in 1906, solidifying its status as a South Dakota community.",
      "sourceSentenceIds": [
        16
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://southdakota.com/cities/tea-sd/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "At one time Tea housed a cheese factory operated by Charlie Blanche, reflecting the town’s early agricultural roots.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.teasd.com/history-of-tea",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The first gas station in Tea was built by John Harms Wheelhouse and later sold to John Buus, marking the town’s early automotive era.",
      "sourceSentenceIds": [
        17
