      ],
      "source": "https://en.wikipedia.org/wiki/Carey%2C_Ohio",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Each year, Carey hosts a pilgrimage honoring Our Lady, Consoler of the Afflicted, celebrating its Luxembourg immigrant heritage.",
      "sourceSentenceIds": [
