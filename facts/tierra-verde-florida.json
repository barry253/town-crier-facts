      ],
      "source": "https://grokipedia.com/page/Tierra_Verde,_Florida",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Tierra Verde sits on an island just outside Tampa Bay’s mouth, linked to the mainland by the Pinellas Bayway bridges.",
      "sourceSentenceIds": [
        15
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
