  "facts": [
    {
      "id": 1,
      "text": "Graingers grew around Jesse Grainger’s plantation after a railroad station opened in the late 1800s, anchoring the town’s early growth.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/graingers_north_carolina",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The Grainger family arrived from Wilmington in 1758, helping lay the agricultural roots that defined the area for generations.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/graingers_north_carolina",
      "category": "people",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "In the early 1900s, Graingers became a rural hub, leading to the merger of local schools into Contentnea School.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/graingers_north_carolina",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "A post office began serving Graingers in 1893, marking its official recognition as a community.",
      "sourceSentenceIds": [
        16
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://roadsidethoughts.com/nc/graingers-xx-lenoir-profile.htm",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "A four‑lane freeway segment near Grainger Station Road was built to redirect traffic from older routes, modernizing the area’s connectivity.",
