  "facts": [
    {
      "id": 1,
      "text": "Chunchula’s name comes from the Choctaw word 'chun‑chula,' meaning 'thy fox,' reflecting the area’s Native American heritage.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/chunchula_alabama",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The Chunchula United Methodist Church, founded in 1899, stands as one of the town’s oldest historic churches.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://nearbylens.com/cities/usa/al/chunchula/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Chunchula School, a one‑room building from 1909, is listed on the Alabama Register of Landmarks and Heritage.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Chunchula%2C_Alabama",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "No passenger or freight trains run through Chunchula today, though the old Mobile & Ohio Railroad tracks once crossed the area.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/chunchula_alabama",
      "category": "transport",
      "quality": "poor",
      "qualityReason": "route_only"
    },
    {
      "id": 5,
      "text": "Chunchula’s post office opened in 1873, marking the community’s first official recognition and boosting communication for its farmers and loggers.",
      "sourceSentenceIds": [
        21
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/chunchula_alabama",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The village emerged in 1847, shortly after the removal of Native American tribes from Mobile County, as settlers pushed into the area.",
