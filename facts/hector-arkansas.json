  "facts": [
    {
      "id": 1,
      "text": "Hector was named after President Grover Cleveland's dog, chosen by the President when postal officials were frustrated by residents' indecision over Avondale or The Plain.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Hector%2C_Arkansas",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Settled in the 1830s as Boiling Springs, the town hosted Methodist camp meetings led by the Bewley family, with a log church and school built by 1832.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/hector_arkansas",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "This national forest setting influences the local terrain, promoting activities like trail exploration in areas with steep, winding paths and scenic vistas.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/hector_arkansas",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The town's economy historically revolved around cotton farming, with additional industries including a tannery, a federal whiskey distillery, and general stores.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/hector_arkansas",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The town covers an area of 2.3 square miles and was officially incorporated on March 2, 1965.",
      "sourceSentenceIds": [
        23
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/hector_arkansas",
