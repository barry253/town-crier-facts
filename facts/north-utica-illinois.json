  "facts": [
    {
      "id": 1,
      "text": "North Utica, often called Utica, sits on the Illinois River and grew after the I&M Canal moved the original village north.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/North_Utica%2C_Illinois",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The annual Burgoo Festival, held each October, has drawn thousands for over 50 years and is hosted by the LaSalle County Historical Society.",
      "sourceSentenceIds": [
        2,
        26
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/North_Utica%2C_Illinois",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The LaSalle County Historical Museum, housed in a former I&M Canal warehouse, offers a look at local history and is located downtown.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.illinoisriverroad.org/communities/united-states/illinois/north-utica/community/utica/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "A series of artworks by Utica Township and Country Village Studio celebrates the town’s legacy, displayed in local venues.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.ivaced.org/list/member/village-of-north-utica-785",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "North Utica’s heritage is celebrated in festivals like the Craft Beer Festival, Vintage Wine Festival, and the largest Veteran’s Parade in the state.",
      "sourceSentenceIds": [
        24,
        25
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.illinoisriverroad.org/communities/united-states/illinois/north-utica/community/utica/",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Official signs and local residents still refer to the village simply as Utica, even though its legal name is North Utica.",
      "sourceSentenceIds": [
