  "facts": [
    {
      "id": 1,
      "text": "Riverboat pilot Thomas Tunstall founded Jacksonport in the early 1830s, opening its first store and platting the town that became the county seat in 1853.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/jacksonport_arkansas",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Jacksonport sits where the White River meets the Black River, anchoring the town on Arkansas's river network.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Jacksonport%2C_Arkansas",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Its year‑round depth made the confluence a vital steamboat hub, linking Jacksonport to Memphis, New Orleans, and beyond.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/jacksonport_arkansas",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "In 1886 the Batesville and Brinkley Railroad, later the White and Black River Valley Railway, reached Jacksonport as its terminus.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Jacksonport%2C_Arkansas",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "During the Civil War, Jacksonport served as a transportation hub for Confederate forces.",
      "sourceSentenceIds": [
        13
      ],
      "sourceLabels": [
