  "facts": [
    {
      "id": 1,
      "text": "Ronald, Washington, was named after Alexander Ronald, a former superintendent of the Northwestern Improvement Company.",
      "sourceSentenceIds": [
        2,
        3
      ],
      "sourceLabels": [
        "Web source 2",
        "Web source 1"
      ],
      "source": "https://centralwashingtonoutdoor.com/love-local/love-local-ronald/",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town sprang up in the late 1880s as a supply center for miners working at the nearby Roslyn‑Cascade Coal Mine.",
      "sourceSentenceIds": [
        9,
        11
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://digitalcommons.cwu.edu/ellensburg_history/75/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "A devastating fire on August 17, 1928, started when a moonshine still exploded, reshaping Ronald’s early streets.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://digitalcommons.cwu.edu/ellensburg_history/75/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Ronald sits along the north side of the Cle Elum River valley, a gateway to outdoor adventures in western Kittitas County.",
      "sourceSentenceIds": [
        14,
        24
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://centralwashingtonoutdoor.com/love-local/love-local-ronald/",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The community’s historic downtown still hosts family‑friendly dining and a sports bar that has been a local favorite for decades.",
      "sourceSentenceIds": [
        6,
        17
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://centralwashingtonoutdoor.com/love-local/love-local-ronald/",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Ronald’s early photographs, archived by the Ellensburg Public Library, capture the town’s original coal‑mining streets and homes built on N.W.I. land.",
      "sourceSentenceIds": [
        1,
        10
      ],
