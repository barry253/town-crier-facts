      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Platted in 1882, incorporated in 1888, and annexed to Denver in 1902, Valverde is one of the city’s oldest neighborhoods.",
      "sourceSentenceIds": [
        28,
        29,
        22,
        23
      ],
      "sourceLabels": [
