      "id": 1,
      "text": "Valverde means \"green valley\" in Spanish, a name settlers gave to the lush river bluff that borders the neighborhood.",
      "sourceSentenceIds": [
        27
      ],
      "sourceLabels": [
        "Web source 1"
      ],
