  "facts": [
    {
      "id": 1,
      "text": "Coquille shares its name with the river running through town and the Coquille Indian Tribe whose ancestors lived along its banks.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Coquille%2C_Oregon"
    },
    {
      "id": 2,
      "text": "Coquille became the Coos County seat because it was reachable within a day's ride on horseback from any point in the county.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Coquille%2C_Oregon"
    },
    {
      "id": 3,
      "text": "Steam-powered sternwheelers once carried passengers and freight between Coquille and other river settlements before the arrival of wagon roads.",
      "sourceSentenceIds": [
        5,
        12
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Coquille%2C_Oregon"
    },
    {
      "id": 4,
      "text": "The Coquille Valley Museum preserves the city's heritage and was established by the Coquille Valley Historical Society in 2005.",
      "sourceSentenceIds": [
        4,
        10
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 2"
      ],
      "source": "https://en.wikipedia.org/wiki/Coquille%2C_Oregon"
    },
    {
      "id": 5,
      "text": "Coquille's economy has historically been driven by the timber, agriculture, and fishing industries.",
      "sourceSentenceIds": [
        26
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.visitoregon.com/cities/coquille-oregon/"
    },
    {
      "id": 6,
      "text": "Local culture in Coquille includes unique community events like the Coquille Gay 90s Celebration and the Coquille Valley Art Walk.",
