  "facts": [
    {
      "id": 1,
      "text": "Tazewell was incorporated as Jeffersonville in 1866 and renamed Tazewell on February 29, 1892.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/Tazewell,_Tennessee"
    },
    {
      "id": 2,
      "text": "The town became the county seat in 1804, chosen partly because of John Hunt's influence, and a courthouse was later built.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Tazewell%2C_Tennessee"
    },
    {
      "id": 3,
      "text": "During the Civil War, Confederate troops occupied Tazewell, and a devastating fire in November 1862 destroyed much of the town.",
      "sourceSentenceIds": [
        1,
        30
      ],
      "sourceLabels": [
        "Web source 2",
        "Wikipedia"
      ],
      "source": "https://grokipedia.com/page/Tazewell,_Tennessee"
    },
    {
      "id": 4,
      "text": "The historic Graham‑Kivett House, built around 1810 by Irish immigrant William Graham, is now being restored as the Claiborne Heritage Center.",
      "sourceSentenceIds": [
        16
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/Tazewell,_Tennessee"
    },
    {
      "id": 5,
      "text": "Tazewell sits near the Cumberland Gap, a historic pass at the tri‑state border, and serves as a gateway to Appalachian outdoor recreation.",
      "sourceSentenceIds": [
        24
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/Tazewell,_Tennessee"
    },
    {
      "id": 6,
      "text": "Locals protested a planned Knoxville–Cumberland Gap railroad, so the line bypassed Tazewell by about two miles.",
      "sourceSentenceIds": [
        17,
        18
      ],
      "sourceLabels": [
        "Web source 2"
      ],
