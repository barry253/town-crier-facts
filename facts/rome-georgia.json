  "facts": [
    {
      "id": 1,
      "text": "Rome was founded in 1834 after Congress passed the Indian Removal Act, marking the start of European settlement in the area.",
      "sourceSentenceIds": [
        4,
        6
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Rome%2C_Georgia",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The city sits where the Etowah and Oostanaula rivers meet, forming the Coosa River and giving Rome its early trade‑center status.",
      "sourceSentenceIds": [
        11,
        12,
        13
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Rome%2C_Georgia",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Rome’s historic downtown now enjoys a 98‑percent occupancy rate, a testament to its revitalization and recognition as a Great American Main Street City in 2003.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.achp.gov/preserve-america/community/rome-georgia",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The Martha Berry Museum honors the founder of Berry College, while the Chieftains Museum preserves Cherokee history, both reflecting Rome’s diverse cultural heritage.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Rome%2C_Georgia",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "In 1954, General Electric opened a factory in Rome to build medium transformers, adding a notable industrial chapter to the city’s economy.",
      "sourceSentenceIds": [
        14
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Rome%2C_Georgia",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Rome’s Historic Preservation Ordinance, adopted in 1979, is overseen by a dedicated commission that protects the city’s architectural legacy.",
      "sourceSentenceIds": [
        27
      ],
