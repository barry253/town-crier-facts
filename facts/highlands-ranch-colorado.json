  "facts": [
    {
      "id": 1,
      "text": "Highlands Ranch was officially founded in 1981, yet settlers had built homes there more than a century earlier.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.highlandsranch.org/government/about-highlands-ranch/history",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The historic Highlands Ranch Mansion, originally 22,000 square feet, now showcases pioneer life and sits on the original ranch land.",
      "sourceSentenceIds": [
        16,
        22
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.highlandsranch.org/government/about-highlands-ranch/history",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "In 1920, Waite Phillips—whose brothers founded Phillips Petroleum—purchased the mansion, linking the town to Colorado’s oil legacy.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.highlandsranch.org/government/about-highlands-ranch/history",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The town’s name derives from the ranch that the Phipps family renamed Highlands Ranch after acquiring the property.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.highlandsranch.org/government/about-highlands-ranch/history",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "A historic windmill still stands on the ranch property, a rare glimpse of early ranch infrastructure.",
      "sourceSentenceIds": [
        19
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.highlandsranch.org/government/about-highlands-ranch/history",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The Highlands Ranch Historical Society curates the area’s past and hosts an online photo album for history enthusiasts.",
