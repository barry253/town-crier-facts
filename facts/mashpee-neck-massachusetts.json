  "facts": [
    {
      "id": 1,
      "text": "Mashpee Neck occupies the land between tidal Mashpee River and Shoestring Bay.",
      "sourceSentenceIds": [
        19
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Mashpee_Neck%2C_Massachusetts",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The Mashpee Wampanoag Tribal Museum, housed in the historic Bourne-Avant house, opened in 1999 and is the only museum dedicated solely to Wampanoag history.",
      "sourceSentenceIds": [
        10,
        13,
        7
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://mashpeewampanoagtribe-nsn.gov/museum",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The town’s name honors the Mashpee Tribe of Wampanoag, the original Native Americans of Cape Cod before the Pilgrims.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.capecodchamber.org/explore/regions/upper-cape/mashpee/",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The Bourne-Avant house, built around 1793 by Sherjashub Bourne, is one of the oldest homesteads near Mashpee’s historic center.",
      "sourceSentenceIds": [
        4,
        11
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://mashpeewampanoagtribe-nsn.gov/museum",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The museum’s exhibits trace Wampanoag culture from the Stone Age to today, curated by the Tribal Historic Preservation Office.",
      "sourceSentenceIds": [
        6,
        8
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://mashpeewampanoagtribe-nsn.gov/museum",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Mashpee Neck’s sandy beaches and freshwater ponds earned it a spot among Coastal Living’s best coastal towns in 2019.",
      "sourceSentenceIds": [
        2
      ],
