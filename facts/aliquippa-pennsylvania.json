  "facts": [
    {
      "id": 1,
      "text": "Aliquippa’s name comes from an 18th‑century Seneca leader, Queen Aliquippa, chosen by the Pittsburgh and Lake Erie Railroad in 1878.",
      "sourceSentenceIds": [
        3,
        6,
        8,
        15
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Aliquippa%2C_Pennsylvania",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The city was founded in 1894 as a company town for the Jones and Laughlin Steel Company.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Aliquippa%2C_Pennsylvania",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Jones Memorial Library, built in 1927 with funds from Jones’ daughter, now sits on the National Register of Historic Places.",
      "sourceSentenceIds": [
        1,
        4,
        5
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Aliquippa%2C_Pennsylvania",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Aliquippa station, erected in 1911, is also listed on the National Register.",
      "sourceSentenceIds": [
        20
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Aliquippa%2C_Pennsylvania",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The Jones and Laughlin Steel Company opened its first mill in Aliquippa in 1905, anchoring the city’s steel‑making legacy.",
      "sourceSentenceIds": [
        28
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Aliquippa%2C_Pennsylvania",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "After most large employers closed in the 1980s, Aliquippa entered a period of economic distress that still shapes the community today.",
