  "facts": [
    {
      "id": 1,
      "text": "Manchester was founded in 1765 when Captain Richard Richards received a 67‑acre grant called New Market next to German Churche.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Manchester%2C_Maryland"
    },
    {
      "id": 2,
      "text": "The town’s seal shows a church steeple and a leaf‑less tree, with “Founded 1765 Incorporated 1834” etched around it.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Manchester%2C_Maryland"
    },
    {
      "id": 3,
      "text": "Immanuel Evangelical Lutheran Church, the direct descendant of the original church, was founded in 1862 on Church Street.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://manchestermd.gov/history1/"
    },
    {
      "id": 4,
      "text": "Manchester’s first iron mine near Melrose prompted a spur railroad, a rare industrial venture for a small town.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://manchestermd.gov/history1/"
    },
    {
      "id": 5,
      "text": "The town’s name originally was Manchester Germantown, reflecting its early German settlers before 1833 incorporation.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Manchester%2C_Maryland"
    },
    {
      "id": 6,
      "text": "Manchester lies just south of the Pennsylvania line and north of Baltimore, making it a rural commuter town for both metros.",
      "sourceSentenceIds": [
        15
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Manchester%2C_Maryland"
    }
  ]
