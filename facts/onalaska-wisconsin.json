    {
      "id": 1,
      "text": "Onalaska was founded in 1851 by Thomas Rowe and John C. Laird, originally a lumber mill town on the Black River.",
      "sourceSentenceIds": [
        22,
        23,
        25
      ],
      "sourceLabels": [
