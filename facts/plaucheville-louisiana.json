  "facts": [
    {
      "id": 1,
      "text": "Plaucheville was first incorporated in 1803 by three brothers, Etienne, François, and Martin Visitant, during a rowing expedition along several bayous.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Plaucheville%2C_Louisiana",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The expedition ended at the intersection of Bayou Choupique and Bayou Jauques, now the site of Ward 8 in Plaucheville.",
      "sourceSentenceIds": [
        13
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Plaucheville%2C_Louisiana",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Judge Joseph Alexander Plauché, the village’s first resident and a Major General at the Battle of New Orleans, helped name all local roads.",
      "sourceSentenceIds": [
        14,
        15
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Plaucheville%2C_Louisiana",
      "category": "people",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Plaucheville’s town hall sits at 146 Gin St, P.O. Box 10, and can be reached at (318) 922‑3111.",
      "sourceSentenceIds": [
        22,
        23
      ],
      "sourceLabels": [
