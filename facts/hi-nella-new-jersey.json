  "facts": [
    {
      "id": 1,
      "text": "Hi‑Nella’s name comes from a Native American term meaning “high rolling knoll” or “high ground,” though some say it honors Nella Parker.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Hi-Nella%2C_New_Jersey",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The borough was officially created on April 23, 1929, carved from portions of the former Clementon Township alongside four other new municipalities.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Hi-Nella%2C_New_Jersey",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Hi‑Nella ranks as New Jersey’s ninth‑smallest municipality, a fact that highlights its tight‑knit community feel.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Hi-Nella%2C_New_Jersey",
      "category": "other",
      "quality": "poor",
      "qualityReason": "editorial_filler"
    },
    {
      "id": 4,
      "text": "Like most New Jersey towns, Hi‑Nella operates under the borough form of government, the state’s most common municipal structure.",
      "sourceSentenceIds": [
        22
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Hi-Nella%2C_New_Jersey",
      "category": "other",
      "quality": "poor",
      "qualityReason": "editorial_filler"
    },
    {
      "id": 5,
      "text": "The borough shares borders with Gloucester Township, Somerdale, and Stratford, situating it amid a cluster of Camden County communities.",
