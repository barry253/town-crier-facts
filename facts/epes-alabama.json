  "facts": [
    {
      "id": 1,
      "text": "Epes was incorporated in 1899, originally called Epes Station, and became a growing community along the Tombigbee River.",
      "sourceSentenceIds": [
        17
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Epes%2C_Alabama",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town sits on Jones Bluff, the former site of the French‑built Fort Tombecbe from 1735.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://encyclopediaofalabama.org/article/epes/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "In 1870, Epes sold land for a depot to the Great Southern Railroad, boosting its role as a shipping hub.",
      "sourceSentenceIds": [
        13
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://encyclopediaofalabama.org/article/epes/",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Fort Tombecbe, built 1735‑1737 by French troops under Jean‑Baptiste Le Moyne de Bienville, lies just north of Epes and is on the National Register of Historic Places.",
      "sourceSentenceIds": [
        15
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://encyclopediaofalabama.org/article/epes/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The second stockyard in Alabama opened in Epes in 1936, marking a significant livestock industry milestone.",
