  "facts": [
    {
      "id": 1,
      "text": "The Ahtna Athabascan people have long considered the Slana area part of their traditional territory, spanning the Copper River Basin.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/slana_alaska",
      "category": "people",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "In Ahtna, Slana is called 'Stl'ana,' meaning the mouth of the Slana River, highlighting its geographic importance.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/slana_alaska",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The 1898 Klondike Gold Rush brought non‑Native prospectors through Slana, where they bartered with Ahtna guides and supplies.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/slana_alaska",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Slana hosts the ranger station for Wrangell‑St. Elias National Park, the largest national park in the U.S., supporting limited tourism and subsistence.",
      "sourceSentenceIds": [
        8,
        9
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/slana_alaska",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The Nabesna Mine opened in 1923 near Slana and at its peak employed about 60 workers extracting gold and other minerals.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Slana%2C_Alaska",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Temperatures in Slana swing from a record low of −57°F to a high of 93°F, reflecting its continental subarctic climate.",
      "sourceSentenceIds": [
        20
      ],
