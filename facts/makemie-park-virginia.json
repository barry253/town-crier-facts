  "facts": [
    {
      "id": 1,
      "text": "Makemie Park was renamed in 1908 to honor Rev. Francis Makemie, founder of Presbyterianism in America.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Makemie_Park%2C_Virginia",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The park hosts the Makemie Memorial Monument, a granite statue dedicated to Rev. Makemie, set within a three‑acre plot owned by the Presbyterian Historical Society.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://genealogytrails.com/vir/accomack/church_makemie.html",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The monument was unveiled in a May ceremony attended by over a hundred members of the Presbyterian Historical Society traveling from Philadelphia aboard a special train.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://genealogytrails.com/vir/accomack/church_makemie.html",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Makemie Park sits on Holdens Creek near Sanford, Virginia, where Makemie's former home once stood and is now an archaeological site.",
      "sourceSentenceIds": [
        17,
        18
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://visitesva.com/things-to-do/listings/makemie-monument-park/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The park’s shaded picnic area makes it a kid‑ and pet‑friendly spot for families exploring the Eastern Shore.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://visitesva.com/things-to-do/listings/makemie-monument-park/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The park’s location on the Eastern Shore places it within a flat, sandy landscape of red‑clover blossoms and sweet‑potato farms that travelers historically crossed by train and carriage.",
      "sourceSentenceIds": [
        24
      ],
      "sourceLabels": [
        "Web source 2"
      ],
