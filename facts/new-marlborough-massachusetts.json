  "facts": [
    {
      "id": 1,
      "text": "The New Marlborough Historical Society, a 501(c)(3) nonprofit formed in the 1970s, preserves the town’s heritage through restoration and education.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.nmhistoricalsociety.org/about/",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "In 1735 the Massachusetts General Court opened four towns, including New Marlborough, as part of the Boston‑to‑Albany road.",
      "sourceSentenceIds": [
        15
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.nmhistoricalsociety.org/about/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "New Marlborough was laid out as a 6‑mile‑square town, each lot measuring 60 acres.",
      "sourceSentenceIds": [
        15
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.nmhistoricalsociety.org/about/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The original plan allotted 63 house lots, a total of 3,780 acres for early settlers.",
      "sourceSentenceIds": [
        15
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.nmhistoricalsociety.org/about/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The town sits between Westfield and Sheffield, following the historic Nashua Trail and Connecticut Path.",
      "sourceSentenceIds": [
        15
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.nmhistoricalsociety.org/about/",
      "category": "other",
      "quality": "poor",
      "qualityReason": "location_description"
    },
    {
      "id": 6,
      "text": "New Marlborough’s name honors Marlborough, Massachusetts, itself named after the English market town in Wiltshire.",
      "sourceSentenceIds": [
        15
      ],
      "sourceLabels": [
