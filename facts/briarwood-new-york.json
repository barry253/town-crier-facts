    },
    {
      "id": 2,
      "text": "The Briarwood–Van Wyck subway station opened in 1937, solidifying the neighborhood’s identity as a true commuter suburb.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.cityneighborhoods.nyc/briarwood"
    },
    {
      "id": 3,
      "text": "Briarwood sits on one of Queens’ highest points, offering a rare hilltop view in the borough.",
