      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town grew into a railroad hub in 1882 when the line was extended through the area, sparking a population influx.",
      "sourceSentenceIds": [
        1,
        11
      ],
      "sourceLabels": [
