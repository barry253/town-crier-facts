  "facts": [
    {
      "id": 1,
      "text": "Greenpoint's east–west streets were alphabetically ordered from north to south by founder Neziah Bliss.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Greenpoint%2C_Brooklyn",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The neighborhood once hosted the Union Porcelain Works factory at 300 Eckford Street, operating 1862-1922.",
      "sourceSentenceIds": [
        15
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Greenpoint%2C_Brooklyn",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Eberhard Faber's pencil factory, once the largest U.S. lead pencil maker, operated on West Street from 1872 to 1956.",
      "sourceSentenceIds": [
        16
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Greenpoint%2C_Brooklyn",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Greenpoint Avenue, a main thoroughfare, was formerly named Lincoln Street in the early 20th century.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Greenpoint%2C_Brooklyn",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "A small playground called Right Angle Park sits on a right‑triangle block at Commercial, Dupont, and Franklin Streets.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Greenpoint%2C_Brooklyn",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Greenpoint’s industrial past included shipyards that built the USS Monitor, the first ironclad warship, in 1862.",
