  "facts": [
    {
      "id": 1,
      "text": "Cole Camp was named after pioneer Captain Stephen Cole, who opened a post office and christened it after his home parish in Kentucky.",
      "sourceSentenceIds": [
        1,
        2
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 2"
      ],
      "source": "https://en.wikipedia.org/wiki/Cole_Camp%2C_Missouri"
    },
    {
      "id": 2,
      "text": "The town sits at the historic crossroads of the old Military Road, Duroc Road, Jefferson City Road, and Boonville Road.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.colecampmo.com/general-infohistory.html"
    },
    {
      "id": 3,
      "text": "Cole Camp celebrates its strong German roots with annual festivals that showcase traditional music, food, and crafts.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://visitbentoncomo.com/about/"
    },
    {
      "id": 4,
      "text": "Downtown Cole Camp features several pre‑Civil War buildings and is listed on the National Register of Historic Places.",
      "sourceSentenceIds": [
        12,
        19
      ],
      "sourceLabels": [
        "Web source 1",
        "Web source 2"
      ],
      "source": "https://visitbentoncomo.com/about/"
    },
    {
      "id": 5,
      "text": "Because of its Civil War history, Cole Camp participates in Missouri’s Civil War Passport Program, offering guided historical tours.",
      "sourceSentenceIds": [
        13
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://visitbentoncomo.com/about/"
    },
    {
      "id": 6,
      "text": "During the 1860s railroads arrived, sparking a boom that brought new businesses and a rowdy, wild‑west atmosphere to Cole Camp.",
      "sourceSentenceIds": [
        23
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.colecampmo.com/general-infohistory.html"
    }
  ]
