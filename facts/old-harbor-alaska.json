  "facts": [
    {
      "id": 1,
      "text": "Old Harbor’s name comes from nearby Three Saints Bay, where Grigory Shelikhov established the first permanent Russian settlement in North America in 1784.",
      "sourceSentenceIds": [
        18
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.kupi.com/en/explore/united-states/old-harbor/history",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "An airstrip runs through Old Harbor, woven into the town’s layout and linking it to the outside world.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.kupi.com/en/explore/united-states/old-harbor/history",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The village’s blue domes and traditional buildings showcase the lasting influence of the Russian era on local culture.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.kupi.com/en/explore/united-states/old-harbor",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Old Harbor’s protected bay offers safe anchorage for ships and kayaks, shielding them from the Gulf of Alaska’s harsh storms.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.kupi.com/en/explore/united-states/old-harbor/history",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "After the 1964 tsunami, residents rebuilt Old Harbor on higher ground to safeguard the community for future generations.",
      "sourceSentenceIds": [
        14
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.kupi.com/en/explore/united-states/old-harbor",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Old Harbor’s roots trace back to the era of Russian conquest, blending indigenous Alutiiq traditions with Russian influence.",
