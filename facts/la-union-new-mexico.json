      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Communities moved to higher ground to escape Rio Grande flooding, creating the name La Unión to reflect their unity.",
      "sourceSentenceIds": [
        15
      ],
      "sourceLabels": [
