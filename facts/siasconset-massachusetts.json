  "facts": [
    {
      "id": 1,
      "text": "Siasconset’s name comes from the Wampanoag word meaning “place of great bones,” a nod to the whale bones seen along its shore.",
      "sourceSentenceIds": [
        17
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/Siasconset,_Massachusetts"
    },
    {
      "id": 2,
      "text": "Perched about 50 feet above sea level, Siasconset was settled as a fishing village with a whaling station by 1676.",
      "sourceSentenceIds": [
        21
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/Siasconset,_Massachusetts"
    },
    {
      "id": 3,
      "text": "In 1901 a Marconi wireless station opened in Siasconset, and in 1912 it received the Titanic’s distress signal.",
      "sourceSentenceIds": [
        22
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/Siasconset,_Massachusetts"
    },
    {
      "id": 4,
      "text": "When New York theaters closed for summer, actors fled to Siasconset, pooling $3,000 in 1899 to build the Sconset Casino, a hall of amusement.",
      "sourceSentenceIds": [
        14,
        15,
        26
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.siasconsetcivicassociation.org/History"
    },
    {
      "id": 5,
      "text": "The Nantucket Central Railroad, built in 1881, linked Siasconset to Nantucket and served as its headquarters until 1918.",
      "sourceSentenceIds": [
        16
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/Siasconset,_Massachusetts"
    },
    {
      "id": 6,
      "text": "Bill Belichick has called Siasconset home during the NFL off‑season since 1979, owning several properties worth more than $10 million.",
