    {
      "id": 1,
      "text": "Amsterdam’s Grachtengordel earned UNESCO World Heritage status in 2010, celebrating its 17th‑century canal architecture.",
      "sourceSentenceIds": [
        20
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
