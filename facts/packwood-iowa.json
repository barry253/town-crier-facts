  "facts": [
    {
      "id": 1,
      "text": "Packwood was founded in the 1870s by Samuel Packwood, who platted the town on his Polk Township farm.",
      "sourceSentenceIds": [
        3,
        6,
        8,
        9
      ],
      "sourceLabels": [
        "Web source 1",
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/packwood_iowa",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The Burlington and Western Railway arrived in late 1882, prompting rapid growth and the donation of four acres for a depot and stockyard.",
      "sourceSentenceIds": [
        3,
        15
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/packwood_iowa",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "In 1910 the Chicago, Burlington & Quincy converted the narrow-gauge tracks to standard gauge, boosting freight and passenger capacity.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/packwood_iowa",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Packwood celebrated its centennial in 1983 and hosted the RAGBRAI Great Bicycle Ride in 1979 and 1983, showcasing rural charm.",
      "sourceSentenceIds": [
        13
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/packwood_iowa",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The town once housed a brick and tile factory that operated from 1886 until the 1930s, reflecting its early industrial activity.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/packwood_iowa",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Packwood’s economy today includes a savings bank founded in 1888, a meat locker, lumber supply, and seed corn production, alongside modern services.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/packwood_iowa"
    }
  ],
