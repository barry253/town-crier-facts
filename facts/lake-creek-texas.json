      "id": 1,
      "text": "Lake Creek began as Odd's Creek, first settled in March 1848, and the post office adopted the new name in 1885.",
      "sourceSentenceIds": [
        14,
        25
      ],
      "sourceLabels": [
        "Web source 2",
        "Web source 1"
      ],
