  "facts": [
    {
      "id": 1,
      "text": "Kings Mills began as a company town in 1884, built to house workers for the King Powder Company and the Peters Cartridge Company.",
      "sourceSentenceIds": [
        14
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Kings_Mills%2C_Ohio",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town’s name comes from Ahimaaz King, who founded the Great Western Powder Works in 1877 and later the King Powder Company.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.wchsmuseum.org/blog/local-history-kings-mills",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "A wooden dam diverted water from the Little Miami River into a canal that powered the powder mills, a key engineering feat of the era.",
      "sourceSentenceIds": [
        20
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.wchsmuseum.org/blog/local-history-kings-mills",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "In 1890, a rail car accident at the local station caused an explosion that killed twelve, a tragic event that still echoes in local memory.",
      "sourceSentenceIds": [
        11
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.wchsmuseum.org/blog/local-history-kings-mills",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Kings Mills once hosted the College Football Hall of Fame before it moved to South Bend, Indiana, in 1995.",
      "sourceSentenceIds": [
