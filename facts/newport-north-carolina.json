  "facts": [
    {
      "id": 1,
      "text": "Newport earned its name either as “New Port” to set it apart from Beaufort’s “Old Port” or from Quaker settlers who honored their Rhode Island hometown.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Newport%2C_North_Carolina",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The 1858 completion of the Atlantic and North Carolina Railroad linked Newport to Goldsboro and Beaufort, turning the town into a regional rail hub.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Newport%2C_North_Carolina",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Back in the 18th century, the Newport River ran all the way to Old Topsail Inlet, giving the town a vital Atlantic outlet.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Newport%2C_North_Carolina",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Newport’s Primitive Baptist Church, founded in 1778, remains one of the county’s oldest churches and a testament to early religious life.",
      "sourceSentenceIds": [
        22
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Newport%2C_North_Carolina",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Today, Newport’s waterfront draws boaters and anglers to the Newport River, where fishing and kayaking thrive beside historic sites.",
