    },
    {
      "id": 2,
      "text": "The original Cross Keys hotel probably opened around 1743‑44, though the first recorded license was issued to Alexander Brown in 1758.",
      "sourceSentenceIds": [
        19,
        21
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://pennsylvaniagenealogy.org/bucks/cross-keys-pennsylvania.htm"
    },
    {
      "id": 3,
      "text": "A preserved sign‑board of the Cross Keys tavern, photographed many times, now hangs in the Bucks County Historical Society museum.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://pennsylvaniagenealogy.org/bucks/cross-keys-pennsylvania.htm"
    },
    {
      "id": 4,
      "text": "Cross Keys is located in Bucks County, Pennsylvania, not in Juniata County as some online maps mistakenly suggest.",
