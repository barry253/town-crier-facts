      "id": 1,
      "text": "Cross Keys earned its name from a tavern sign of crossed keys, a common colonial custom for inns and towns.",
      "sourceSentenceIds": [
        12,
        13,
        14
      ],
      "sourceLabels": [
        "Web source 1"
      ],
