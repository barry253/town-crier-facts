  "facts": [
    {
      "id": 1,
      "text": "Ten Sleep got its name because the location was ten sleeps, or nights, between historical Sioux campsites.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://wtschamber.org/History-of-Ten-Sleep"
    },
    {
      "id": 2,
      "text": "The yellowish-gray to white sandstone of Ten Sleep Canyon is known as the Tensleep Formation and dominates the Bighorn Mountains.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://wtschamber.org/History-of-Ten-Sleep"
    },
    {
      "id": 3,
      "text": "Dinosaur fossils, plants, and sea-life specimens are prolific throughout the region, including the public exploration area of Big Cedar Ridge.",
      "sourceSentenceIds": [
        6,
        29,
        30
      ],
      "sourceLabels": [
        "Web source 1",
        "Wikipedia"
      ],
      "source": "https://wtschamber.org/History-of-Ten-Sleep"
    },
    {
      "id": 4,
      "text": "Ten Sleep was the site of the Spring Creek Raid, one of the last feuds of the Sheep and Cattlemen's War.",
      "sourceSentenceIds": [
        28
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Ten_Sleep%2C_Wyoming"
    },
    {
      "id": 5,
      "text": "Ten Sleep Mercantile is a typical small-town general store and has been a focal point of the town since 1905.",
      "sourceSentenceIds": [
        15,
        16
      ],
      "sourceLabels": [
        "Wikipedia"
