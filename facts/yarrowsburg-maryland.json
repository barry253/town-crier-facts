  "facts": [
    {
      "id": 1,
      "text": "Yarrowsburg takes its name from Aquila and Polly Yarrow, free African Americans who bought a log house there in 1825.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Yarrowsburg%2C_Maryland",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The village lies at the foot of Elk Ridge, stretching along Reed, Kaetzel and Yarrowsburg roads in southeastern Washington County.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Yarrowsburg%2C_Maryland",
      "category": "nature",
      "quality": "poor",
      "qualityReason": "vague"
    },
    {
      "id": 3,
      "text": "Solomon's Gap, the only historical pass through Elk Ridge, was a key point in Civil War battle strategies.",
      "sourceSentenceIds": [
        2,
        17
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Yarrowsburg%2C_Maryland",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The road that crossed Solomon's Gap fell out of use in the early 1900s and is no longer a through route.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Yarrowsburg%2C_Maryland",
      "category": "other",
      "quality": "poor",
      "qualityReason": "vague"
    },
    {
      "id": 5,
      "text": "Elk Ridge once belonged entirely to the Antietam Iron Works, whose furnaces burned charcoal harvested from the forest.",
      "sourceSentenceIds": [
        10,
        11
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Yarrowsburg%2C_Maryland",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "After the iron works went bankrupt in the 1850s, the mountain land was parceled into multi‑acre lots that now form many Yarrowsburg homes.",
      "sourceSentenceIds": [
        12,
        13
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
