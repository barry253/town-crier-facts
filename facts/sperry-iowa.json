  "facts": [
    {
      "id": 1,
      "text": "Sperry was named after landowner John M. Sperry, who laid out the town in 1869.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/sperry_iowa"
    },
    {
      "id": 2,
      "text": "Sperry began as a station stop on the Burlington, Cedar Rapids and Northern Railway, whose construction started in 1869.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Sperry%2C_Iowa"
    },
    {
      "id": 3,
      "text": "The town’s first post office opened on February 5, 1871, with George W. Sperry as postmaster.",
      "sourceSentenceIds": [
        28
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/sperry_iowa"
    },
    {
      "id": 4,
      "text": "In 1874, John M. Sperry donated land for a public park with a circular drive and over 650 trees.",
      "sourceSentenceIds": [
        27
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/sperry_iowa"
    },
    {
      "id": 5,
      "text": "Early settlers focused on agriculture, creating a stable, agriculture-centered community that defined Sperry’s initial decades.",
      "sourceSentenceIds": [
        4
      ],
