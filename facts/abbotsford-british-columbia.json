  "facts": [
    {
      "id": 1,
      "text": "Abbotsford was named after Harry Abbott, the Western Superintendent of the Canadian Pacific Railway.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://downtownabbotsford.ca/about/history/",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The city’s historic downtown sits on S’ólh téméxw, the unceded territory of the Semá:th and Mathxwí First Nations.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://downtownabbotsford.ca/about/history/",
      "category": "other",
      "quality": "poor",
      "qualityReason": "editorial_filler"
    },
    {
      "id": 3,
      "text": "In 1892, the CPR built a station that made Abbotsford a central hub linking Vancouver, Seattle, Victoria, and the Interior.",
      "sourceSentenceIds": [
        24,
        25
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://downtownabbotsford.ca/about/history/",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Abbotsford’s Gur Sikh Temple, a National Historic Site, has stood for over 110 years in central Abbotsford.",
      "sourceSentenceIds": [
        13
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Abbotsford%2C_British_Columbia",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The city has been named Canada’s most generous city in charitable giving for nine straight years, according to Statistics Canada.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Abbotsford%2C_British_Columbia",
      "category": "other",
      "quality": "poor",
      "qualityReason": "editorial_filler"
    },
    {
      "id": 6,
      "text": "The Reach Gallery Museum houses the Mennonite Historical Society’s library and archives, preserving the region’s cultural heritage.",
