  "facts": [
    {
      "id": 1,
      "text": "Cudahy was originally called the Buckhorn Settlement before Patrick Cudahy bought 700 acres to build his meatpacking plant in the late 1800s.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Cudahy%2C_Wisconsin",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The city sits on the shore of Lake Michigan, offering three miles of coastline and over 800 acres of parkland, including historic Sheridan Park.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.cudahy-wi.gov/visitors/index.php",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Warnimont Golf Course, a local favorite, sits beside swimming and wading pools and plenty of space for picnics, biking, and tennis.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.cudahy-wi.gov/visitors/index.php",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Cudahy lies just south of Milwaukee, forming part of the larger Milwaukee metropolitan area along the lake.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Cudahy%2C_Wisconsin",
