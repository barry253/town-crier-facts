  "facts": [
    {
      "id": 1,
      "text": "Geistown’s first settlers, the Adams family, arrived in 1769 before official permission, setting the stage for the borough’s early frontier life.",
      "sourceSentenceIds": [
        24
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.geistownborough.com/history",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The Slick family’s 1812 farm, later called Slicksville, housed the first Methodist church in Geistown when it opened on December 25, 1829.",
      "sourceSentenceIds": [
        26,
        28
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.geistownborough.com/history",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "A hidden stop on the Underground Railroad, the Slick farm and tannery helped free enslaved people travel northward from Geistown.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.geistownborough.com/history",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Early Geistown entrepreneurs saw the automobile’s promise and opened gasoline stations, making the town a roadside service hub in the early 20th century.",
