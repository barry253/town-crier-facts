  "facts": [
    {
      "id": 1,
      "text": "Otisco was laid out in 1854 when the Jeffersonville, Madison and Indianapolis Railroad reached the spot, turning a farm area into a rail hub.",
      "sourceSentenceIds": [
        1,
        5,
        8
      ],
      "sourceLabels": [
        "Web source 2",
        "Wikipedia"
      ],
      "source": "https://grokipedia.com/page/otisco_indiana",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town’s name may come from Otisco Lake in New York, a nod to settlers who carried familiar place names westward.",
      "sourceSentenceIds": [
        17
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://kids.kiddle.co/Otisco,_Indiana",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "A post office opened in 1870, and by the late 1800s postmasters Edward Covert and Louis Badger kept the community connected to the wider world.",
      "sourceSentenceIds": [
        12,
        4
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 2"
      ],
      "source": "https://en.wikipedia.org/wiki/Otisco%2C_Indiana",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Otisco’s early economy boomed with a flour mill that ran from 1896 until a fire in 1905, and a tomato canning factory that started in 1902.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/otisco_indiana",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Local fraternal groups like the Modern Woodmen of America, Knights of Pythias, and Odd Fellows formed in the early 1900s, showing a strong sense of community spirit.",
