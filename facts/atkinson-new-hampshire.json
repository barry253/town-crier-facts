      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The Kimball House Museum sits in a 1772 building originally owned by Reverend Stephen Peabody, now a historic landmark.",
      "sourceSentenceIds": [
        17
      ],
      "sourceLabels": [
