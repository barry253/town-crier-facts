  "facts": [
    {
      "id": 1,
      "text": "Sumner was founded in 1870 by Chauncey Carpenter, who platted the town on land he owned in Section 11 of Sumner Township.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/sumner_iowa"
    },
    {
      "id": 2,
      "text": "The town was named after Charles Sumner, the Massachusetts U.S. senator known for his civil rights advocacy.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Sumner%2C_Iowa"
    },
    {
      "id": 3,
      "text": "The Iowa Pacific Railroad branch line arrived in 1875, spurring growth and connecting Sumner to regional trade.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/sumner_iowa"
    },
    {
      "id": 4,
      "text": "Sumner’s 1897 clock tower, restored by the Rotary Club for $25,000, stands as a Victorian‑era landmark.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/sumner_iowa"
    },
    {
      "id": 5,
      "text": "Ten Wasp Brewing, opened in 2024, sits on Sumner’s historic main street and offers local craft beers.",
