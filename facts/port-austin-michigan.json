  "facts": [
    {
      "id": 1,
      "text": "Port Austin sits at the tip of Michigan's Thumb, where the distinctive Turnip Rock rises on Point Aux Barques.",
      "sourceSentenceIds": [
        14,
        15
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Port_Austin%2C_Michigan",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The Port Austin History Center, run by volunteers, showcases the village’s lumber, salt, grindstone, and maritime heritage.",
      "sourceSentenceIds": [
        1,
        5
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://portaustinhistory.org/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Its grounds feature a log cabin, a 19th‑century Grindstone City house, and a 1950s barbershop.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.portaustinarea.com/history-center",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Stroll the wooded trails and explore exhibits on vintage hats, household tasks, and local landmarks like the air base and lighthouses.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.portaustinarea.com/history-center",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The village’s mission is to collect, preserve, and present the history of the Greater Port Austin area.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://portaustinhistory.org/",
