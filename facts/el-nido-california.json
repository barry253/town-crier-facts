  "facts": [
    {
      "id": 1,
      "text": "El Nido means \"the nest\" in Spanish and was named in 1915 when the Union Colonization Company settled the area.",
      "sourceSentenceIds": [
        2,
        10
      ],
      "sourceLabels": [
        "Web source 1",
