  "facts": [
    {
      "id": 1,
      "text": "Founded in 1981 as a daughter colony of Miller Hutterite Colony, Kingsbury Colony began its journey in rural Montana.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/kingsbury_colony_montana",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "As part of the Lehrerleut branch, Kingsbury Colony follows conservative Anabaptist traditions of communal living and pacifism.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/kingsbury_colony_montana",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The colony’s economy thrives on large‑scale communal farming, producing wheat, barley, canola, lentils, vegetables, and raising a 600‑sow hog unit, dairy and beef cattle, and chickens.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/kingsbury_colony_montana",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Daily life centers on collective farming, shared meals, and religious practice, with residents speaking a Hutterite German dialect and children attending a one‑room schoolhouse up to eighth grade.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/kingsbury_colony_montana",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Water comes from a shallow aquifer that supplies both homes and fields, requiring no treatment because its quality consistently meets state standards.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/kingsbury_colony_montana",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Since 1999, Kingsbury Colony has kept stable leadership, with Joseph Wurz as manager and Mike Kleinsasser as minister, roles unchanged through 2024.",
      "sourceSentenceIds": [
        10,
