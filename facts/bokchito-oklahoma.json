    },
    {
      "id": 2,
      "text": "Bokchito was platted and incorporated by the federal government as a town within the Choctaw Nation in 1901.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Bokchito%2C_Oklahoma"
    },
    {
      "id": 3,
      "text": "Bokchito has been known as The Biggest Little Town in Oklahoma since the 1970s.",
