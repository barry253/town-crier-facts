    {
      "id": 1,
      "text": "Indian Village began in 1925 as Fort Wayne’s Super-Subdivision, a wide‑boulevard, smoke‑free community marketed as a quiet escape from city factories.",
      "sourceSentenceIds": [
        3,
        4,
        5,
        8
