  "facts": [
    {
      "id": 1,
      "text": "Shelby Park began in 1847 when German working‑class settlers first populated the area bounded by Kentucky, Preston, Bergman, and Logan Streets.",
      "sourceSentenceIds": [
        23
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://history.ky.gov/markers/shelby-park-neighborhood",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "In 1908, the 17‑acre Shelby Park was established at the neighborhood’s center, later becoming a civic gathering spot.",
      "sourceSentenceIds": [
        29
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://recollectionky.org/shelby-park/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The park’s layout was designed by the renowned Olmsted Firm, the same architects behind many U.S. national parks.",
      "sourceSentenceIds": [
        30
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://recollectionky.org/shelby-park/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "A Carnegie‑endowed library opened in 1911 on Oak Street; its Second Renaissance Revival style was crafted by Arthur Loomis.",
      "sourceSentenceIds": [
        15,
        16
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://recollectionky.org/shelby-park/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The Jefferson County Public School system once wanted to build a school on the park, but the neighborhood association saved the space as the heart of Shelby Park.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://recollectionky.org/shelby-park/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Shelby Park was named for Kentucky’s first governor, Isaac Shelby, whose legacy dates back to the state’s founding.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://history.ky.gov/markers/shelby-park-neighborhood",
      "category": "etymology",
      "quality": "good"
    }
