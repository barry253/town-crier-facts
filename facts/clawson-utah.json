  "facts": [
    {
      "id": 1,
      "text": "Clawson was originally settled in 1897 and first called Kingsville after one of the original settlers, Guy King.",
      "sourceSentenceIds": [
        2,
        7
      ],
      "sourceLabels": [
        "Web source 1",
        "Wikipedia"
      ],
      "source": "https://emery.utah.gov/home/residents/cities-towns/clawson/"
    },
    {
      "id": 2,
      "text": "The community was renamed Clawson in 1904 to honor Rudger Clawson, an apostle of the LDS Church.",
      "sourceSentenceIds": [
        1,
        15,
        16,
        29
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Clawson%2C_Utah"
    },
    {
      "id": 3,
      "text": "Before the town was settled, the surrounding area was known as North Flat.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Clawson%2C_Utah"
    },
    {
      "id": 4,
      "text": "The first school in Clawson opened in 1898, where the teacher rode fourteen miles on horseback every day.",
      "sourceSentenceIds": [
        8,
        9
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Clawson%2C_Utah"
    },
    {
      "id": 5,
      "text": "Early settlers once moved their log cabins two miles west to avoid a location that might become swampy.",
      "sourceSentenceIds": [
        13,
        14
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Clawson%2C_Utah"
    },
    {
      "id": 6,
      "text": "Clawson existed as an unincorporated community for many decades before officially incorporating as a town in 1981.",
