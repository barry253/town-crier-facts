    {
      "id": 1,
      "text": "Wellington was named for the Duke of Wellington after a relative of the Earl of Aberdeen, who owned the Rocking Chair ranch, had served with the duke at Waterloo.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.tshaonline.org/handbook/entries/wellington-tx"
    },
    {
      "id": 2,
      "text": "Wellington became the county seat of Collingsworth County in 1890, and its courthouse construction began in 1893.",
      "sourceSentenceIds": [
        14,
        11
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.tshaonline.org/handbook/entries/wellington-tx"
    },
    {
      "id": 3,
      "text": "The Wellington Ritz Theatre, a restored 1929 movie house, now hosts films and live music performances.",
      "sourceSentenceIds": [
        24
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://texastimetravel.com/cities/wellington/"
    },
    {
      "id": 4,
      "text": "A state historical marker in Wellington remembers Bonnie Parker and Clyde Barrow crashing their car into the river.",
