  "facts": [
    {
      "id": 1,
      "text": "Hodges was named after Major General George Washington Hodges, who served as the commander of all South Carolina's militia.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Hodges%2C_South_Carolina"
    },
    {
      "id": 2,
      "text": "The land in Hodges was originally owned by Francis Salvador, a Jewish Revolutionary War patriot.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/hodges_south_carolina"
    },
    {
      "id": 3,
      "text": "Hodges began as a planned community centered around a group of Methodist church educators.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://discovergreenwood.com/things-to-do/explore-the-area/hodges/"
    },
    {
      "id": 4,
      "text": "The arrival of the railroad earned Hodges nicknames like Sin City and Hell Hole due to its lively entertainments.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://discovergreenwood.com/things-to-do/explore-the-area/hodges/"
    },
    {
      "id": 5,
      "text": "Initially known as Cokesbury Junction, the community was formally incorporated as Hodges on January 17, 1901.",
      "sourceSentenceIds": [
        11
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/hodges_south_carolina"
    },
    {
      "id": 6,
      "text": "Hodges features the restored Cokebury College, which served as a precursor to one of the region's first Black colleges.",
