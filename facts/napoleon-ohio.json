  "facts": [
    {
      "id": 1,
      "text": "Napoleon, Ohio was founded in 1832 and named after French emperor Napoleon Bonaparte.",
      "sourceSentenceIds": [
        1,
        2
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Napoleon%2C_Ohio",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town sits on land that was once part of the 25‑mile‑wide Great Black Swamp, a dense forest and wetland that slowed early settlement.",
      "sourceSentenceIds": [
        5,
        16
      ],
      "sourceLabels": [
        "Web source 1",
        "Wikipedia"
      ],
      "source": "https://www.buckeyetrail.org/towns/napoleon",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Napoleon grew rapidly thanks to the Miami and Erie Canal and two railroads that crossed the town in the mid‑1800s.",
      "sourceSentenceIds": [
        10,
        18
      ],
      "sourceLabels": [
        "Web source 2",
        "Wikipedia"
      ],
      "source": "https://www.napoleonohio.com/about-us",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The Henry County courthouse and the adjacent sheriff’s house and jail are listed on the National Register of Historic Places.",
      "sourceSentenceIds": [
        4,
        7
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Napoleon%2C_Ohio",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The Henry County Fairgrounds host a historic complex with a 1860s log home, a 1897 one‑room schoolhouse, and a 1910 gazebo.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.buckeyetrail.org/towns/napoleon",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Napoleon’s main public library serves the community as the city’s central library branch.",
