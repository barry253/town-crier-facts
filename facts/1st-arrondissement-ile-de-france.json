  "facts": [
    {
      "id": 1,
      "text": "The 1st arrondissement, also called the Louvre district, sits on the right bank of the Seine and includes the historic Île de la Cité.",
      "sourceSentenceIds": [
        22,
        23
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/1st_arrondissement_of_Paris",
      "category": "other",
      "quality": "poor",
      "qualityReason": "location_description"
    },
    {
      "id": 2,
      "text": "Jardin des Tuileries, a green expanse between the Louvre and Place de la Concorde, was once the site of a tile factory.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.solosophie.com/1st-arrondissement/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The Palais-Royal, founded in 1629 by architect Jacques Lemercier, now hosts cafés, shops, and gardens that echo Parisian history.",
      "sourceSentenceIds": [
        11,
        12
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.solosophie.com/1st-arrondissement/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The Louvre Museum, occupying a former royal palace, houses the famous Musée de l'Orangerie, where Monet’s waterlily paintings reside.",
      "sourceSentenceIds": [
        1,
        6
      ],
      "sourceLabels": [
        "Web source 1",
        "Wikipedia"
      ],
      "source": "https://www.solosophie.com/1st-arrondissement/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Pont Neuf, the oldest standing bridge in Paris, crosses the western tip of Île de la Cité and overlooks Notre Dame.",
      "sourceSentenceIds": [
        16
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://franceadventurer.com/1st-arrondissement-guide-things-to-do/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The Forum des Halles, once a medieval market, now stands as Paris’s largest shopping mall and a hub of modern commerce.",
      "sourceSentenceIds": [
        27
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/1st_arrondissement_of_Paris",
