  "facts": [
    {
      "id": 1,
      "text": "Maple City began in 1866 when William Parks and J. White built a shoe peg factory, originally called Peg Town.",
      "sourceSentenceIds": [
        5,
        8
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 2"
      ],
      "source": "https://en.wikipedia.org/wiki/Maple_City%2C_Michigan",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The post office opened March 9, 1875, and the name 'Maple City' was chosen, replacing the original Peg Town.",
      "sourceSentenceIds": [
        5,
        25
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 2"
      ],
      "source": "https://en.wikipedia.org/wiki/Maple_City%2C_Michigan",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "A sawmill built by Crowell in 1882 operated until 1916, following the factory’s 1880 fire.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Maple_City%2C_Michigan",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The village sits in Kasson Township, about 13 miles northwest of Traverse City, surrounded by hilly farmland and orchards.",
      "sourceSentenceIds": [
        11,
        22
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 2"
      ],
      "source": "https://en.wikipedia.org/wiki/Maple_City%2C_Michigan",
      "category": "nature",
      "quality": "poor",
      "qualityReason": "location_description"
    },
    {
      "id": 5,
      "text": "The community’s early settlers were drawn by the Homestead Act of 1862, which allowed claim of 160 acres if they built a house and farmed.",
