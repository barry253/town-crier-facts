  "facts": [
    {
      "id": 1,
      "text": "Blythe began as a farming outpost around Sam Tarver’s 1832 homestead, growing when a narrow‑gauge railroad arrived in 1883 and a post office opened in 1885.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/blythe_georgia",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town officially adopted the name Blythe in 1885, chosen by V.J. after other options like Murrow were rejected.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/blythe_georgia",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Blythe Elementary School, the town’s only public school, opened its doors in 1977.",
      "sourceSentenceIds": [
        27
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/blythe_georgia",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Behind the county fire station sits Blythe’s Community Center, a space available for parties and meetings.",
      "sourceSentenceIds": [
        26,
        28
      ],
      "sourceLabels": [
        "Web source 1",
        "Web source 2"
      ],
      "source": "https://cityofblythega.com/history-of-blythe-georgia/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Mack’s Country Store, located on the curve of Highway 88 near Highway 1, remains the town’s closest gas station and general store.",
