  "facts": [
    {
      "id": 1,
      "text": "Founded 1825 by Isaac Swan, who named it after Canton, China, believing the two towns were antipodes.",
      "sourceSentenceIds": [
        1,
        3
      ],
      "sourceLabels": [
        "Web source 1",
        "Wikipedia"
      ],
      "source": "https://www.britannica.com/place/Canton-Illinois",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Swan built a sawmill that sparked Canton’s early economy, later turning the town into a hub for cigar and farm tool manufacturing.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.britannica.com/place/Canton-Illinois",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The old International Harvester plant, now part of Navistar International, remains a landmark where Canton once produced farm implements.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.britannica.com/place/Canton-Illinois",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "In 2008 Cook Medical opened a new factory on the former International Harvester site, bringing modern medical device production to Canton.",
      "sourceSentenceIds": [
        5,
        6,
        7
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Canton%2C_Illinois",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Dickson Mounds State Museum, just outside Canton, showcases artifacts from ancient Native American peoples who lived along the Illinois River.",
      "sourceSentenceIds": [
        13
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://fultoncountyil.gov/visit-here/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Canton’s daily newspaper, The Daily Ledger, has been reporting local news for generations, alongside three radio stations WBYS, WPZA, and WILP.",
