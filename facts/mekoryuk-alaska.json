    },
    {
      "id": 2,
      "text": "The construction of a permanent school and church in the 1930s prompted residents from seasonal camps to settle in one location.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.kupi.com/en/explore/united-states/mekoryuk/history"
    },
    {
      "id": 3,
      "text": "Reindeer herding began in 1920 when an Eskimo‑Russian trader introduced the animals to Mekoryuk.",
      "sourceSentenceIds": [
        23
