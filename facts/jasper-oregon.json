  "facts": [
    {
      "id": 1,
      "text": "Jasper was named for a local resident, Jasper B. Hills, whose father settled in the area in 1846.",
      "sourceSentenceIds": [
        1,
        16
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Jasper%2C_Oregon"
    },
    {
      "id": 2,
      "text": "The area now known as Jasper was historically inhabited by the Kalapuya peoples before European contact.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/jasper_oregon"
    },
    {
      "id": 3,
      "text": "Jasper sits at the confluence of Hills Creek and the Middle Fork Willamette River.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Jasper%2C_Oregon"
    },
    {
      "id": 4,
      "text": "The Jasper post office was established in 1884.",
      "sourceSentenceIds": [
        17
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Jasper%2C_Oregon"
    },
    {
      "id": 5,
      "text": "Jasper once featured a railroad siding on the Southern Pacific Cascade Line, which is now part of the Union Pacific Railroad.",
      "sourceSentenceIds": [
