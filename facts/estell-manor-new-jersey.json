  "facts": [
    {
      "id": 1,
      "text": "In 1832, Joseph West built a sandstone manor house for his sister Maria West and her husband Daniel Estell, giving the town its name.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://shorelocalnews.com/exploring-the-history-of-estell-manor-park/",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "During World War I, the U.S. government selected part of Estell Manor in 1918 for the Bethlehem Loading Company munitions plant.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://shorelocalnews.com/exploring-the-history-of-estell-manor-park/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Today, Estell Manor Park is managed by Atlantic County’s Division of Parks and Recreation, which maintains trails, picnic areas and a Nature Center.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://shorelocalnews.com/exploring-the-history-of-estell-manor-park/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Estell Manor Park ranks among Atlantic County’s most significant historic and recreational sites, blending natural beauty with industrial heritage.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://shorelocalnews.com/exploring-the-history-of-estell-manor-park/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Fox Nature Center houses the ruins of a glassmaking village, a World War I munitions plant, and several historic cemeteries.",
      "sourceSentenceIds": [
        6
      ],
