  "facts": [
    {
      "id": 1,
      "text": "Curwensville was named for John Curwen in 1799.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Curwensville%2C_Pennsylvania"
    },
    {
      "id": 2,
      "text": "The Curwensville Area Historical Society now calls the Korb House its home, a building donated by the Mildred Korb Houser family in 1989.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://curwensvilleareahistoricalsociety.org/"
    },
    {
      "id": 3,
      "text": "Since 1989, the society has been located at 846 State Street, turning the historic Korb House into a museum of local heritage.",
      "sourceSentenceIds": [
        15
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://curwensvilleareahistoricalsociety.org/"
    },
    {
      "id": 4,
      "text": "North American Refractories Company once operated a brick plant in Curwensville, reflecting the town’s industrial past.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Curwensville%2C_Pennsylvania"
    },
    {
      "id": 5,
      "text": "The Curwensville-Pike Township Historical Society, founded in 1965, archives the region’s history and offers educational programs like a summer camp for children.",
      "sourceSentenceIds": [
        25,
        27
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://museumsdatabase.com/museums/view/27562"
    },
    {
      "id": 6,
      "text": "Some historians believe the Korb House may have served as a stop on the Underground Railroad, hinting at a hidden chapter of abolitionist activity.",
      "sourceSentenceIds": [
        20
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://curwensvilleareahistoricalsociety.org/"
    }
  ]
