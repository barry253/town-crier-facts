        1,
        14
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Resaca%2C_Georgia"
    },
    {
      "id": 2,
      "text": "The Battle of Resaca, part of the Atlanta Campaign, raged around the town in May 1864.",
      "sourceSentenceIds": [
        15
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Resaca%2C_Georgia"
    },
    {
      "id": 3,
      "text": "Resaca hosts Georgia’s first Confederate cemetery, established after the 1864 battle.",
      "sourceSentenceIds": [
        16
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Resaca%2C_Georgia"
    },
    {
      "id": 4,
      "text": "The Oostanaula River winds through Resaca, giving the town its scenic river setting.",
      "sourceSentenceIds": [
