      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The South Side of Seven Lakes has no lakes for recreation, yet it still boasts an 18‑hole golf course that draws players from the area.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
