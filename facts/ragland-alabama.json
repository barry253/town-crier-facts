      "id": 1,
      "text": "Ragland began as the coal‑mining community of Trout Creek before the Civil War.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://encyclopediaofalabama.org/article/ragland/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town grew around a railroad stop that served George Ragland’s mines, with the line arriving in 1882.",
      "sourceSentenceIds": [
        4,
        5
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://encyclopediaofalabama.org/article/ragland/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "A monument near Ragland honors Fort Strother, a 1813 supply camp built by Andrew Jackson during the Indian Wars.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.stclairco.com/298/Ragland",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The 1910 Ragland Bank Building now serves as an art studio after renovation.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.stclairco.com/298/Ragland",
      "category": "landmark",
      "quality": "good"
    },
    {
