  "facts": [
    {
      "id": 1,
      "text": "Boles Acres takes its name from rancher Luther C., whose legacy helped shape the community.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/boles_acres_new_mexico",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Before settlers, the Mescalero Apache hunted and gathered across the Tularosa Basin that now hosts Boles Acres.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/boles_acres_new_mexico",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Railroads in the early 20th century turned the arid basin into ranching land, despite low rainfall and alkali soils.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/boles_acres_new_mexico",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "A one-room schoolhouse built in 1909 served 20–25 pupils before closing around 1919, reflecting the transient agrarian life.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/boles_acres_new_mexico",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Route 54 was partially condemned in 1956 for missile range purposes, prompting land subdivision and new community services by the late 1950s.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/boles_acres_new_mexico",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Boles Acres sits near the Lincoln National Forest, giving residents easy access to outdoor recreation in the Tularosa Basin.",
