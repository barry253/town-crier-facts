      ],
      "source": "https://en.wikipedia.org/wiki/Vashon%2C_Washington",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Since 1989 the Vashon Island Chorale, originally called the Island Singers, has performed classical and contemporary works for the community.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
