  "facts": [
    {
      "id": 1,
      "text": "Wilmington Island takes its name from Wilmington, North Carolina, honoring the many migrants who moved there in the late 1800s and early 1900s.",
      "sourceSentenceIds": [
        17
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.city-usa.top/state-georgia-city-wilmington-island",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The island’s settlement began to solidify in the early 20th century as the Savannah River expanded and new residential areas were needed.",
      "sourceSentenceIds": [
        16
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.city-usa.top/state-georgia-city-wilmington-island",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Before development, Wilmington Island was mostly farmland and undeveloped marshland, a landscape that still shapes its character.",
      "sourceSentenceIds": [
        18
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.city-usa.top/state-georgia-city-wilmington-island",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The Talley-Ho Bridge, built in the 20th century, opened the island to residential growth by linking it to mainland Savannah.",
      "sourceSentenceIds": [
        19
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.city-usa.top/state-georgia-city-wilmington-island",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "During World II, the island served as a training ground for amphibious landings, showcasing its strategic coastal position.",
      "sourceSentenceIds": [
        20
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.city-usa.top/state-georgia-city-wilmington-island",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Surrounded by the Intracoastal Waterway to the west and the Vernon River to the east, Wilmington Island feels like a distinct enclave.",
