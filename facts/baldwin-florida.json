  "facts": [
    {
      "id": 1,
      "text": "Baldwin was originally called Thigpen, named after a tavern owner who served stagecoach travelers at the crossroads.",
      "sourceSentenceIds": [
        20,
        21
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Baldwin%2C_Florida",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "In 1857 the first railroad line reached Thigpen, and a second crossing appeared in 1859, linking the town to Jacksonville.",
      "sourceSentenceIds": [
        4,
        10
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Baldwin%2C_Florida",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "During the Civil War, Federal troops captured Baldwin in 1864, burning the town after a brief skirmish with Confederate forces.",
      "sourceSentenceIds": [
        25,
        29
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Baldwin%2C_Florida",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Baldwin remains part of the Jacksonville Metropolitan Statistical Area but does not operate its own police force, relying on the Jacksonville Sheriff's Office.",
      "sourceSentenceIds": [
