  "facts": [
    {
      "id": 1,
      "text": "Luxor is an unincorporated coal town in Hempfield Township, Westmoreland County, Pennsylvania.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Luxor%2C_Pennsylvania"
    },
    {
      "id": 2,
      "text": "The town grew around Jamison's underground bituminous coal mine, known locally as Luxor or No. 1 Mine, which began operations in the 1890s.",
      "sourceSentenceIds": [
        7,
        8
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Luxor%2C_Pennsylvania"
    },
    {
      "id": 3,
      "text": "By 1910 Luxor’s mining complex boasted over 400 coking ovens, a testament to its industrial boom.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Luxor%2C_Pennsylvania"
    },
    {
      "id": 4,
      "text": "The Pennsylvania Railroad’s Alexandria branch served Luxor, transporting coal and helping the town thrive.",
      "sourceSentenceIds": [
        3,
        5
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Luxor%2C_Pennsylvania"
    },
    {
      "id": 5,
      "text": "Coal mining in Luxor ended in 1972, marking the end of an era for the community.",
      "sourceSentenceIds": [
        11
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Luxor%2C_Pennsylvania"
    },
    {
      "id": 6,
      "text": "In May 2022 a Luxor resident was rescued after falling 25 feet into an abandoned mine shaft, highlighting lingering mine hazards.",
      "sourceSentenceIds": [
