  "facts": [
    {
      "id": 1,
      "text": "Aspendale railway station opened in April 1891 as Aspendale Park Race‑Course and was renamed Aspendale in 1905.",
      "sourceSentenceIds": [
        1,
        16
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 2"
      ],
      "source": "https://en.wikipedia.org/wiki/Aspendale%2C_Victoria",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The suburb’s name comes from a mare; the first race meeting was held in 1891 at the Aspendale racecourse.",
      "sourceSentenceIds": [
        3,
        16
      ],
      "sourceLabels": [
        "Web source 1",
        "Web source 2"
      ],
      "source": "https://victorianplaces.com.au/aspendale",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Aspendale Life Saving Club began in 1926 and is currently being rebuilt with state funding.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Aspendale%2C_Victoria",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Aspendale borders Port Phillip to the west, with a picturesque gravel track leading to the Edithvale wetlands.",
      "sourceSentenceIds": [
        17,
        22
      ],
      "sourceLabels": [
        "Wikipedia",
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Aspendale%2C_Victoria",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The CSIRO Marine and Atmospheric Research facility in Aspendale houses a wind tunnel and labs studying air pollution and climate change.",
      "sourceSentenceIds": [
        28
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Aspendale%2C_Victoria",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "In conjunction with neighbouring Edithvale, Aspendale fields the Edithvale‑Aspendale Australian Rules football team that competes in the Mornington Peninsula Nepean Football League.",
      "sourceSentenceIds": [
        23
      ],
      "sourceLabels": [
