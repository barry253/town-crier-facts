  "facts": [
    {
      "id": 1,
      "text": "Sandia was founded in 1907 by Fennell Dibrell and Max Starcke after Dibrell divided and sold the land.",
      "sourceSentenceIds": [
        3,
        4,
        6
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Sandia%2C_Texas",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town’s name comes from Spanish “sandía,” meaning watermelon, named for the many watermelons grown locally.",
      "sourceSentenceIds": [
        24
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Sandia%2C_Texas",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "In 1936 Sandia was a bustling stop on the Texas and New Orleans Railroad, hosting three businesses, two churches, and several farm units.",
      "sourceSentenceIds": [
        7,
        8,
        17
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Sandia%2C_Texas",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The original lots sold within eight months, sparking a rapid boom that brought a lumberyard, hardware store, two grocery stores, a meat market, a boardinghouse, and a barbershop.",
      "sourceSentenceIds": [
        25
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Sandia%2C_Texas",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Sandia sits on high ground one mile south of Lake Corpus Christi, an impoundment on the Nueces River.",
      "sourceSentenceIds": [
        29
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Sandia%2C_Texas",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "By 1914 the town had grown to 150 residents, a bank, two general stores, and a cotton gin, reflecting its early economic diversity.",
      "sourceSentenceIds": [
        26
      ],
      "sourceLabels": [
