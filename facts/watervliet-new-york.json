  "facts": [
    {
      "id": 1,
      "text": "Watervliet was founded in 1788, originally encompassing all of present‑day Albany County except the city of Albany.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Watervliet%2C_New_York",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town’s name comes from Dutch “watervliet,” meaning “flats by the water,” and it became a city in 1896.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.britannica.com/place/Watervliet",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "In 1813 the War of 1812 prompted the creation of the Watervliet Arsenal, the only U.S. facility that still manufactures large‑caliber cannon.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Watervliet%2C_New_York",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The North Reformed Dutch Church, built in 1839, now houses the Watervliet Historical Society and Museum at 1501 First Avenue.",
      "sourceSentenceIds": [
        16
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.watervliethistory.org/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The Albany and Northern Railway linked Watervliet to Albany in 1852, with a depot originally on Genesee Street before moving to Canal Street.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Watervliet%2C_New_York",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "During the Revolutionary War, a ferry operated from Bleeker Farm across the Hudson to Troy, used by troops in 1777 en route to Saratoga.",
      "sourceSentenceIds": [
        29
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
