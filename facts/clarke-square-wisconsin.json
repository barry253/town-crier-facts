  "facts": [
    {
      "id": 1,
      "text": "Clarke Square takes its name from Norman and Lydia Clarke, who donated 2.1 acres that became the park in 1890.",
      "sourceSentenceIds": [
        7,
        8
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://emke.uwm.edu/entry/clarke-square/",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The square is bounded by Menomonee Valley, Cesar Chavez Drive, Greenfield Avenue, and Layton Boulevard, framing a historic neighborhood.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://emke.uwm.edu/entry/clarke-square/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Community services in the area began in the late 1960s with Journey House and Milwaukee Christian Center, later joined by the Southside Organizing Committee in 1990.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://emke.uwm.edu/entry/clarke-square/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The neighborhood’s mission, outlined in the Quality of Life Plan, aims to build safe streets, diverse homes, and a thriving business community.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://clarkesquare.org/about-us/",
      "category": "other",
      "quality": "poor",
      "qualityReason": "other"
    },
    {
      "id": 5,
      "text": "Layton Boulevard West Neighbors, founded by long‑time resident Francis in 1995, continues to advocate for local residents.",
