  "facts": [
    {
      "id": 1,
      "text": "Fuenlabrada’s name comes from the Spanish phrase “Fuente Labrada,” meaning a carved fountain.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Fuenlabrada",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Archaeologists have found evidence of human activity in the area dating back to the Paleolithic and Bronze Age.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Fuenlabrada",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "During the Upper Middle Ages, nearby settlements such as Loranca, Albas and Fregacedos were already part of the municipality’s territory.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Fuenlabrada",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The first documented mention of Fuenlabrada appears in the 16th‑century Topographic Relations of Philip II.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Fuenlabrada",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "By the late 19th century, Fuenlabrada was famous for its handmade rosquillas and buns, a local culinary specialty.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Fuenlabrada",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "After suffering serious damage in the Spanish Civil War, the municipality received rebuilding aid from the Dirección General de Regiones Devastadas in the 1940s and 1950s.",
      "sourceSentenceIds": [
        9
