  "facts": [
    {
      "id": 1,
      "text": "Founded 28 Feb 1904 as Sport Lisboa, Benfica has never been relegated from Primeira Liga, joining Sporting CP and FC Porto as one of Portugal's 'Big Three'.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/S.L._Benfica",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The club’s crest features an eagle symbolizing independence, authority, and nobility, atop a shield of red and white that represents bravery and peace, with the motto \"E pluribus unum\".",
      "sourceSentenceIds": [
        19
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/S.L._Benfica",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "In 2008 Benfica launched Benfica TV, the first sports channel owned by a Portuguese club, and has been broadcasting club content ever since.",
      "sourceSentenceIds": [
        20
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/S.L._Benfica",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The Estádio da Luz, officially named Estádio do Sport Lisboa e Benfica, opened in 1954 and was rebuilt in 2003 to become the club’s modern home.",
      "sourceSentenceIds": [
        6,
        24
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/S.L._Benfica",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Benfica’s anthem \"Ser Benfiquista\" celebrates supporters called benfiquistas, reflecting the club’s deep fan culture that spans over a century.",
      "sourceSentenceIds": [
        27
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/S.L._Benfica",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The club’s motto \"E pluribus unum\" means \"Out of many, one\" and underscores the unity that brought Sport Lisboa and Benfica together in 1904.",
      "sourceSentenceIds": [
        8,
        19
      ],
