    },
    {
      "id": 2,
      "text": "The city sits at the south end of Lake Menomin, a reservoir on the Red Cedar River that ultimately feeds the Mississippi.",
      "sourceSentenceIds": [
        24
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Menomonie%2C_Wisconsin"
    },
    {
      "id": 3,
      "text": "A weekly newspaper began publishing in Menomonie in 1856 and remains owned by Lee Enterprises today.",
      "sourceSentenceIds": [
