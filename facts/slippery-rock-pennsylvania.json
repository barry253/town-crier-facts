  "facts": [
    {
      "id": 1,
      "text": "Slippery Rock was incorporated as a borough in 1896, having previously been called Centreville since 1841.",
      "sourceSentenceIds": [
        14
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Slippery_Rock%2C_Pennsylvania",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The borough’s name comes from Slippery Rock Creek, whose rocky banks were described as “slippery” by early settlers.",
      "sourceSentenceIds": [
        16
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Slippery_Rock%2C_Pennsylvania",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "A post office opened in 1826 in the Ginger Hill area, long before the borough’s official founding.",
      "sourceSentenceIds": [
        13
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Slippery_Rock%2C_Pennsylvania",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The town’s railroad history includes a depot on the Pittsburgh, Shenango and Lake Erie line, now part of Canadian National Railway.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.butlereagle.com/20230711/tales-of-2-slippery-rocks-are-linked-by-long-histories-of-community-spirit/",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The terrain around Slippery Rock is hilly and has seen coal strip‑mining, yet the area remains largely agricultural.",
      "sourceSentenceIds": [
        17
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Slippery_Rock%2C_Pennsylvania",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Historic plaques now mark buildings that once served as a lumber yard, post office, and general store in the 1895 Butler County history.",
