  "facts": [
    {
      "id": 1,
      "text": "Bluffton was founded in 1852 by Billy Davis on the west bank of the Colorado River.",
      "sourceSentenceIds": [
        30
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.tshaonline.org/handbook/entries/bluffton-tx"
    },
    {
      "id": 2,
      "text": "The town was named after Maxwell’s hometown of Bluffton, Arkansas, because of the bluffs overlooking the Colorado River.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.tshaonline.org/handbook/entries/bluffton-tx"
    },
    {
      "id": 3,
      "text": "When Buchanan Dam finished in 1937, the original Bluffton site was flooded and the community moved five miles west.",
      "sourceSentenceIds": [
        6,
        27
      ],
      "sourceLabels": [
        "Web source 1",
        "Wikipedia"
      ],
      "source": "https://www.tshaonline.org/handbook/entries/bluffton-tx"
    },
    {
      "id": 4,
      "text": "The relocated Bluffton lies on Farm Road 2241 near Lake Buchanan’s western shore, twelve miles northeast of Llano.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.tshaonline.org/handbook/entries/bluffton-tx"
    },
    {
      "id": 5,
      "text": "In 2011 a severe drought lowered Lake Buchanan’s water, briefly exposing the submerged original town site.",
      "sourceSentenceIds": [
        29
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Bluffton%2C_Texas"
    },
    {
      "id": 6,
      "text": "Bluffton once outpaced Llano in prosperity before the railroad bypassed it, causing a decline.",
      "sourceSentenceIds": [
        10,
        21
      ],
      "sourceLabels": [
        "Web source 1",
        "Web source 2"
      ],
