  "facts": [
    {
      "id": 1,
      "text": "Tel Mond was founded on 16 June 1929 by Alfred Mond, 1st Baron Melchett, a British industrialist and Zionist leader.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Tel_Mond",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town’s name honors Alfred Mond, whose Palestine Plantations Company planted citrus orchards that employed Jewish laborers.",
      "sourceSentenceIds": [
        4,
        14
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Tel_Mond",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The former home of Lord Melchett has been converted into a museum called the House of the Lord, featuring a statue by Batya Lishansky.",
      "sourceSentenceIds": [
        7,
        22
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Tel_Mond",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "In 1936, the nearby moshav Kfar Ziv was established by Baron Sieff, who followed Lord Melchett and settled in Tel Mond with his wife.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Tel_Mond",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The town sits near the Sharon Plain, an area renowned for citrus groves and agricultural innovation.",
      "sourceSentenceIds": [
        8
      ],
