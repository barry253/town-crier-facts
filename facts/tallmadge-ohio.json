  "facts": [
    {
      "id": 1,
      "text": "Tallmadge was founded in 1807 by Reverend David Bacon, who laid out a square road center modeled after New England designs.",
      "sourceSentenceIds": [
        1,
        8
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Tallmadge%2C_Ohio"
    },
    {
      "id": 2,
      "text": "The town was named after Benjamin Tallmadge, a Revolutionary War figure and local landowner.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Tallmadge%2C_Ohio"
    },
    {
      "id": 3,
      "text": "Tallmadge Circle, a traffic circle at the town center, remains the best‑preserved example of New England town planning in Ohio.",
      "sourceSentenceIds": [
        11,
        12
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Tallmadge%2C_Ohio"
    },
    {
      "id": 4,
      "text": "The historic Tallmadge Church, built in 1825, was featured on the cover of Life magazine in 1944.",
      "sourceSentenceIds": [
        15
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Tallmadge%2C_Ohio"
    },
    {
      "id": 5,
      "text": "Tallmadge lies mostly in Summit County but a small eastern portion extends into Portage County due to annexation of Brimfield.",
      "sourceSentenceIds": [
        26,
