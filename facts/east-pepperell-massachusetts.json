  "facts": [
    {
      "id": 1,
      "text": "East Pepperell was named after Sir William Pepperrell, the colonial soldier who captured Louisbourg during King George's War.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/East_Pepperell%2C_Massachusetts",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The Nashua River split East Pepperell from the main village, becoming a natural boundary that helped the area grow its own identity.",
      "sourceSentenceIds": [
        13,
        30
      ],
      "sourceLabels": [
        "Web source 2",
        "Wikipedia"
      ],
      "source": "https://grokipedia.com/page/east_pepperell_massachusetts",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Paper mills and shoe factories sprang up along the Nashua and Nissitissit Rivers in the 1830s, turning the village into a 19th‑century industrial hub.",
      "sourceSentenceIds": [
        1,
        6
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/east_pepperell_massachusetts",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The Worcester and Nashua Railroad arrived in 1848, linking East Pepperell to Boston by 1898 and boosting its manufacturing trade.",
      "sourceSentenceIds": [
        12,
        14
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/east_pepperell_massachusetts",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "In 1874 the town hall was built in Victorian Gothic style, while the Lawrence Library, gifted in 1901, became a cultural anchor with its Beaux‑Arts design.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/east_pepperell_massachusetts",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "During World War II, wartime production briefly steadied local factories, but post‑war competition from southern mills led to the decline of East Pepperell’s shoe and paper industries.",
      "sourceSentenceIds": [
        8
      ],
