    },
    {
      "id": 2,
      "text": "The town sits along the Tygart Valley River, a tributary that shapes the local landscape.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Mill_Creek%2C_West_Virginia"
    },
    {
      "id": 3,
      "text": "The Tygart Valley Homestead, built in 1935 during the Great Depression, is listed on the National Register of Historic Places.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://elkinsrandolphwv.com/place/mill-creek-west-virginia/"
    },
    {
      "id": 4,
      "text": "Local schools include Tygarts Valley Middle/High School and George Ward Elementary School, serving the community.",
