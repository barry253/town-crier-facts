  "facts": [
    {
      "id": 1,
      "text": "Red Rock got its name from a red rock used in the chimney of early settler James Brewer’s house in the 1850s.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.tshaonline.org/handbook/entries/red-rock-tx-bastrop-county",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "In 1890 the Missouri, Kansas and Texas Railroad built a line a mile east of town, prompting residents to relocate their homes and businesses there.",
      "sourceSentenceIds": [
        5,
        14,
        15
      ],
      "sourceLabels": [
        "Web source 1",
        "Web source 2"
      ],
      "source": "https://www.tshaonline.org/handbook/entries/red-rock-tx-bastrop-county",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "A post office opened in Red Rock in 1870, marking the town’s first federal presence.",
      "sourceSentenceIds": [
        27
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.tshaonline.org/handbook/entries/red-rock-tx-bastrop-county",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Red Rock Elementary School remains the only public school serving the community today.",
      "sourceSentenceIds": [
        21
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Red_Rock%2C_Texas",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The Old Red Rock Cemetery contains graves of military veterans and long‑time residents, linking the site to the town’s heritage.",
      "sourceSentenceIds": [
        16
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.historictexas.net/city/red-rock-texas",
      "category": "landmark",
      "quality": "good"
    },
    {
