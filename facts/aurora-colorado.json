  "facts": [
    {
      "id": 1,
      "text": "Aurora originated as the town of Fletcher in 1890, named after Denver businessman Donald Fletcher, and was renamed Aurora in 1907.",
      "sourceSentenceIds": [
        28,
        9,
        10
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 2"
      ],
      "source": "https://en.wikipedia.org/wiki/Aurora%2C_Colorado",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "In 1942, the Army Air Corps built Buckley Field near Aurora, which later became Buckley Space Force Base.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Aurora%2C_Colorado",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The Aurora History Museum showcases a permanent exhibit on local history and rotating galleries on decorative arts.",
      "sourceSentenceIds": [
        15
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Aurora%2C_Colorado",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The Aurora Fox Theatre & Arts Center, a 245‑seat venue on East Colfax Avenue, is a historic landmark in the Cultural Arts District.",
      "sourceSentenceIds": [
        14
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Aurora%2C_Colorado",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "During World War I, Army General Hospital #21—later Fitzsimons Army Hospital—was constructed east of Aurora, marking the city’s first building boom.",
      "sourceSentenceIds": [
        7,
        11
      ],
      "sourceLabels": [
