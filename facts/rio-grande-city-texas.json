  "facts": [
    {
      "id": 1,
      "text": "Rio Grande City was founded in 1848 as a border settlement that quickly became a major trade hub between Texas and Mexico until 1883.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Rio_Grande_City%2C_Texas",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The city sits on the Rio Grande, directly opposite Camargo, Tamaulipas, and is linked by the Rio Grande City–Camargo International Bridge.",
      "sourceSentenceIds": [
        27
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Rio_Grande_City%2C_Texas",
      "category": "other",
      "quality": "poor",
      "qualityReason": "location_description"
    },
    {
      "id": 3,
      "text": "Fort Ringgold, one of the city’s historic structures, stands as a reminder of its military significance during the Civil War era.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.tshaonline.org/handbook/entries/rio-grande-city-tx",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The Rio Grande Herald newspaper, preserved in the Portal to Texas History, documents nearly forty years of the city’s heritage.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://texashistory.unt.edu/explore/collections/RGHD/",
      "category": "other",
      "quality": "poor",
      "qualityReason": "vague"
    },
    {
      "id": 5,
      "text": "Wealthy heiress Hilaria de la Garza Falcon and her husband Henry Clay Davis plotted the town’s layout, turning her land into a formal city.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://texashistory.unt.edu/explore/collections/RGHD/",
      "category": "people",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "From its early days as a supply transfer point for General Zachary Taylor’s campaign, the city has long served as a strategic military hub.",
      "sourceSentenceIds": [
