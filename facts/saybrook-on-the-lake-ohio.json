  "facts": [
    {
      "id": 1,
      "text": "Saybrook-on-the-Lake earned its name from the Connecticut Saybrook Colony, making it the only Saybrook Township in Ohio.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.saybrooktownship.org/Home.html",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Lake Erie borders Saybrook-on-the-Lake to the north, while Geneva Township lies to its west and Ohio State Route 45 to the east.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Saybrook-on-the-Lake%2C_Ohio",
      "category": "other",
      "quality": "poor",
      "qualityReason": "location_description"
    },
    {
      "id": 3,
      "text": "State Route 531 runs along the lakeshore through Saybrook-on-the-Lake, heading east-northeast five miles to Ashtabula Harbour and west-southwest four miles to Geneva-on-the-Lake.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Saybrook-on-the-Lake%2C_Ohio",
      "category": "transport",
      "quality": "poor",
      "qualityReason": "route_only"
    },
    {
      "id": 4,
      "text": "In 1816, Saybrook Township officially separated from Austinburg Township, becoming an independent township for the first time.",
      "sourceSentenceIds": [
        17
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.saybrooktownship.org/Home.html",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "George Webster, a New Yorker, became the first settler in Saybrook Township when he arrived in 1810.",
