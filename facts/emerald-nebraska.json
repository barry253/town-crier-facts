  "facts": [
    {
      "id": 1,
      "text": "Emerald earned its name because early settlers said its landscape was as green as an emerald.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Emerald%2C_Nebraska"
    },
    {
      "id": 2,
      "text": "Emerald sprang to life around 1880 when the Lincoln & Northwest Railroad extended tracks west of Lincoln, turning it into a rural stop.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/emerald_nebraska"
    },
    {
      "id": 3,
      "text": "Throughout the 20th century, Emerald evolved from a remote outpost into a peripheral suburb as Lincoln’s urban sprawl pushed westward.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/emerald_nebraska"
    },
    {
      "id": 4,
      "text": "A post office opened in Emerald in 1884 and stayed open until 1943, serving the community for 59 years.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Emerald%2C_Nebraska"
    },
    {
      "id": 5,
      "text": "Emerald sits about 1,200 feet above sea level, giving it a modest elevation within the Nebraska plains.",
