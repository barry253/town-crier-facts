  "facts": [
    {
      "id": 1,
      "text": "Taylortown, originally called Old Settlement, was renamed to honor its founder Demus Taylor.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.taylortownnc.gov/history",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "On July 13, 1987, Taylortown became an official municipality.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.irememberourhistory.org/communities/taylortown%2C-moore-county%2C-north-carolina",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Robert Taylor, Demus’s son, founded a school for Taylortown children.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.irememberourhistory.org/communities/taylortown%2C-moore-county%2C-north-carolina",
      "category": "people",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Each year, Taylortown Day and Parade celebrates the town’s history, culture, and community.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.taylortownnc.gov/history",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "In 1963, the Taylortown Sanitary District was founded to provide the town’s first water service and streetlights.",
      "sourceSentenceIds": [
        11
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.irememberourhistory.org/communities/taylortown%2C-moore-county%2C-north-carolina",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The town is drained by Joes Fork, a tributary of Nicks Creek that feeds the Little River watershed.",
      "sourceSentenceIds": [
        16
      ],
