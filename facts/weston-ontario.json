  "facts": [
    {
      "id": 1,
      "text": "Weston was founded in 1790 and quickly grew into a major commerce and manufacturing hub.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.doorsopenontario.on.ca/toronto/weston-historical-society-headquarters-and-archive"
    },
    {
      "id": 2,
      "text": "Settlers named the community Weston after their ancestral home in Weston-super-Mare, Somerset, England.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.neighbourhoodguide.com/toronto/york-crosstown/weston/"
    },
    {
      "id": 3,
      "text": "The town’s bicycle outline symbol was inspired by the old CCM factory on Lawrence Avenue.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Weston%2C_Toronto"
    },
    {
      "id": 4,
      "text": "The 1856 arrival of the Grand Trunk Railway sparked growth on Weston’s east side, then part of York Township.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Weston%2C_Toronto"
    },
    {
      "id": 5,
      "text": "The Weston Historical Society headquarters displays artifacts that chronicle the community’s evolution over more than two centuries.",
      "sourceSentenceIds": [
        17
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.doorsopenontario.on.ca/toronto/weston-historical-society-headquarters-and-archive"
    },
    {
      "id": 6,
      "text": "Weston Public Library began as a 1914 Carnegie library, following a Mechanics' Institute opened in 1858.",
