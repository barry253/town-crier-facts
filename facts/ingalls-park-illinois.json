  "facts": [
    {
      "id": 1,
      "text": "Ingalls Park was named after railroad executive Melvin Ingalls, who helped develop the area during the early 20th‑century expansion of the Chicago & Eastern Illinois Railroad.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.trawellino.com/destinations/united-states/illinois_ingalls-park",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Ingalls Park sits just north of Joliet’s Pilcher Park and east of Interstate 80, forming a compact neighborhood.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Ingalls_Park%2C_Illinois",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The town is the nearest community to Chicagoland Speedway, which hosted NASCAR Cup Series races from 2001 to 2019.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Ingalls_Park%2C_Illinois",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Pace bus Route 508 connects Ingalls Park directly to downtown Joliet, offering a convenient public transit link.",
