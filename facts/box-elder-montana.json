  "facts": [
    {
      "id": 1,
      "text": "Box Elder was named for the creek that runs through it, which itself was named after the box elder trees lining its banks.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.visitmt.com/cities-towns/box-elder",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town began as a stage stop on the Fort Assinniboine–Helena line, later becoming a freight station on the St. Paul, Minneapolis & Manitoba Railway.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.mtmemory.org/nodes/view/127522",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "In 1887, four homesteaders—Robert Corcoran, John “Dutch” Henry, Dave Adams, and Clem Sailor—founded Box Elder on the flats of Box Elder Creek.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.mtmemory.org/nodes/view/127522",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Box Elder serves as the headquarters of the Chippewa-Cree tribe, a role solidified after the 1916 creation of Rocky Boy’s Indian Reservation.",
      "sourceSentenceIds": [
        30
      ],
      "sourceLabels": [
        "Web source 2"
      ],
