  "facts": [
    {
      "id": 1,
      "text": "Haverford College, founded in 1833, sits on a 200‑acre campus filled with historic buildings and heritage trees.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://discoverhaverford.org/deep-roots"
    },
    {
      "id": 2,
      "text": "The Haverford Township Historical Society, established in 1939, works to protect and share the town’s rich past.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://haverfordhistoricalsociety.org/"
    },
    {
      "id": 3,
      "text": "The Society has restored Lawrence Cabin, built between 1690 and 1710, and now opens it to the public in Powder Mill Valley Park.",
      "sourceSentenceIds": [
        15,
        19
      ],
      "sourceLabels": [
        "Web source 1",
        "Web source 2"
      ],
      "source": "https://discoverhaverford.org/deep-roots"
    },
    {
      "id": 4,
      "text": "Haverford Station opened in 1880 as part of the Pennsylvania Railroad’s Main Line, linking the town to Philadelphia.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Haverford%2C_Pennsylvania"
    },
    {
      "id": 5,
      "text": "Haverford’s name comes from Haverfordwest, a town in Wales, reflecting the area’s early Welsh settlers.",
      "sourceSentenceIds": [
        28
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Haverford%2C_Pennsylvania"
    },
    {
      "id": 6,
      "text": "Every June, the town celebrates its heritage with a festival on Karakung Drive, drawing locals and visitors alike.",
      "sourceSentenceIds": [
