    },
    {
      "id": 2,
      "text": "The town of Parksville was formally named and incorporated in 1884 to honor Richard Parks.",
      "sourceSentenceIds": [
        1,
        25
      ],
      "sourceLabels": [
        "Web source 2",
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/parksville_south_carolina"
    },
    {
      "id": 3,
      "text": "Arrival of the Augusta and Knoxville Railroad in 1882 accelerated the growth of Parksville.",
      "sourceSentenceIds": [
        1,
        7
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/parksville_south_carolina"
    },
    {
      "id": 4,
      "text": "Parksville is situated on the northern shore of Lake Thurmond, the largest reservoir in South Carolina by surface area.",
      "sourceSentenceIds": [
        27,
        28
      ],
      "sourceLabels": [
        "Web source 2"
