  "facts": [
    {
      "id": 1,
      "text": "Ogilvie was named after local landowner Oric Ogilvie Whited, who helped bring the railroad and sawmill to the area.",
      "sourceSentenceIds": [
        2,
        5,
        7
      ],
      "sourceLabels": [
        "Web source 2",
        "Wikipedia"
      ],
      "source": "https://grokipedia.com/page/ogilvie_minnesota"
    },
    {
      "id": 2,
      "text": "The city incorporated in 1899, shortly after a post office opened that same year.",
      "sourceSentenceIds": [
        2,
        30
      ],
      "sourceLabels": [
        "Web source 2",
        "Wikipedia"
      ],
      "source": "https://grokipedia.com/page/ogilvie_minnesota"
    },
    {
      "id": 3,
      "text": "Ogilvie’s 1918 concrete water tower, listed on the National Register in 1980, stands as a testament to early 20th‑century municipal engineering.",
      "sourceSentenceIds": [
        3,
        12
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/ogilvie_minnesota"
    },
    {
      "id": 4,
      "text": "Back to the Tower Days, an annual festival, celebrates the town’s water tower and local heritage each summer.",
      "sourceSentenceIds": [
        13,
        14
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://moramn.com/mora-chamber/city-of-ogilvie/"
    },
    {
      "id": 5,
      "text": "Ogilvie retains a small‑town feel while welcoming growth, reflecting its long‑standing community spirit.",
