    {
      "id": 1,
      "text": "Oxford's name origin is unclear, possibly from ox tracks near a stream, not a direct British reference.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/oxford_idaho",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Oxford was founded in 1864 by LDS pioneers, part of Cache Valley colonization.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/oxford_idaho",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "By the 1870s, Oxford was a freighting hub, shipping 40,000 sacks of flour to Montana mines.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/oxford_idaho",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The Utah Northern Railroad made Oxford its northern terminus in 1879, sparking a boom.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/oxford_idaho",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "LDS ward activities, dances, brass bands, baseball, roller skating, and Fourth‑of‑July parades shaped Oxford's social scene.",
      "sourceSentenceIds": [
        5
      ],
