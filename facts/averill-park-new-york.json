  "facts": [
    {
      "id": 1,
      "text": "Averill Park got its name in 1880 from the Averill family, then added 'Park' in 1882 to boost summer‑resort appeal.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Averill_Park%2C_New_York",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "19th‑century watermills on the Wynants Kill turned Averill Park into a wool and cotton textile hub before a 1891 flood wiped out the mills.",
      "sourceSentenceIds": [
        1,
        9
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Averill_Park%2C_New_York",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The Faith Knitting Company, founded in 1897, revived the town’s mills by rehiring local workers.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Averill_Park%2C_New_York",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "A planned trolley line from Troy to Averill Park never reached completion, but an electric trolley arrived in 1895, linking the town to regional rail.",
      "sourceSentenceIds": [
        3,
        19
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Averill_Park%2C_New_York",
      "category": "transport",
      "quality": "poor",
      "qualityReason": "route_only"
    },
    {
      "id": 5,
      "text": "Arts Letters & Numbers, a nonprofit arts center on Burden Lake Road, occupies the former Sand Lake Cotton Factory, once owned by Arnolds, Hunt & Co.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Averill_Park%2C_New_York",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The Sand Lake Baptist Church, standing in Averill Park, earned a spot on the National Register of Historic Places in 2004.",
