  "facts": [
    {
      "id": 1,
      "text": "Colony was named for the Seger Colony, founded in 1886 to teach modern agricultural techniques to the Arapaho and Cheyenne tribes.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Colony%2C_Oklahoma"
    },
    {
      "id": 2,
      "text": "John Seger, a Union veteran and mason, established a colony for Native Americans that grew to over 500 inhabitants by 1887.",
      "sourceSentenceIds": [
        19,
        20,
        21
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Colony%2C_Oklahoma"
    },
    {
      "id": 3,
      "text": "The town of Colony served as a staging point for over 2,000 settlers during the land rush of 1892.",
      "sourceSentenceIds": [
        16
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/colony_oklahoma"
    },
    {
      "id": 4,
      "text": "A Dutch Reformed Church founded a mission in Colony in 1895, which remained active until 1912.",
      "sourceSentenceIds": [
        6,
        26
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Colony%2C_Oklahoma"
    },
    {
      "id": 5,
      "text": "The Seger Indian School operated in Colony until 1932 and still retains a historic water tower today.",
      "sourceSentenceIds": [
        12,
        26
      ],
      "sourceLabels": [
        "Web source 1",
        "Wikipedia"
      ],
      "source": "https://grokipedia.com/page/colony_oklahoma"
    },
    {
      "id": 6,
      "text": "Cheyenne and Arapaho tribes have held Pow Wows in Colony since the late 1930s.",
