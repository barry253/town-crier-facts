  "facts": [
    {
      "id": 1,
      "text": "West Stockholm was originally called Bicknellville after Amos Bicknell, who built the first sawmill and gristmill in 1811.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/west_stockholm_new_york",
      "category": "people",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The hamlet’s name changed to West Stockholm in 1811, reflecting its position in the western part of Stockholm town.",
      "sourceSentenceIds": [
        11
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.livingplaces.com/NY/St_Lawrence_County/Stockholm_Town/West_Stockholm_Historic_District.html",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "A rare 1883 pony truss bridge, the West Stockholm Bridge, carries County Route 57 over the Regis River and was rehabilitated in 2000.",
      "sourceSentenceIds": [
        25
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/west_stockholm_new_york",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "By 1878 West Stockholm housed a woolen mill, foundry, two blacksmith shops, and three general stores, making it a bustling 19th‑century crossroads.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.livingplaces.com/NY/St_Lawrence_County/Stockholm_Town/West_Stockholm_Historic_District.html",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The West Stockholm Historic District preserves the original mills, factories, and cluster of residences that tell the village’s industrial past.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.livingplaces.com/NY/St_Lawrence_County/Stockholm_Town/West_Stockholm_Historic_District.html",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The Regis River, flowing through West Stockholm, provided water power for early mills and still defines the hamlet’s scenic landscape.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/west_stockholm_new_york",
      "category": "nature",
      "quality": "good"
    }
