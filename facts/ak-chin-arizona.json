    {
      "id": 1,
      "text": "Ak‑Chin Village first appeared on the 1990 U.S. Census as a census‑designated place.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Ak-Chin_Village%2C_Arizona"
    },
    {
      "id": 2,
      "text": "The O’odham word Ak‑Chin means “mouth of the wash” or “place where the wash loses itself in the sand.”.",
      "sourceSentenceIds": [
        15
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://ak-chin.nsn.us/"
    },
    {
      "id": 3,
      "text": "The community lies 35 miles south of Phoenix in the northwestern part of Pinal County.",
      "sourceSentenceIds": [
        14
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://ak-chin.nsn.us/"
    },
    {
      "id": 4,
      "text": "Ak‑Chin’s land base now covers just over 22,000 acres, down from the original 47,600‑acre reservation.",
      "sourceSentenceIds": [
        2,
        15
      ],
      "sourceLabels": [
        "Web source 2",
        "Web source 1"
      ],
      "source": "https://naair.arizona.edu/ak-chin-indian-community"
    },
    {
      "id": 5,
      "text": "Agriculture remains the mainstay of Ak‑Chin, with enterprises that enhance members’ lives and support the local economy.",
      "sourceSentenceIds": [
        18
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://ak-chin.nsn.us/"
    },
    {
      "id": 6,
      "text": "The Ak‑Chin O’odham Runner newspaper debuted in 1987 and is published on the first and third Friday of each month.",
