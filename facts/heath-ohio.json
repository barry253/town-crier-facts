      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Hopewell Indians once inhabited the area, building massive earthworks that now survive as burial mounds in Moundbuilders State Memorial.",
      "sourceSentenceIds": [
        7,
        8
      ],
      "sourceLabels": [
        "Wikipedia",
