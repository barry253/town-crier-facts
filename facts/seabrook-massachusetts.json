  "facts": [
    {
      "id": 1,
      "text": "Seabrook’s oldest building, the 1763 Seabrook Meetinghouse on Old Parish Lane, once served as church, school, and town hall.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://seabrookneighborhood.org/seabrook-a-tapestry-of-history-and-heart-in-cape-cod-s-hidden-gem/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The Seabrook Railroad Depot, built in 1909 and closed in 1958, now hosts seasonal arts fairs and farmers’ markets in its red‑brick building.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://seabrookneighborhood.org/seabrook-a-tapestry-of-history-and-heart-in-cape-cod-s-hidden-gem/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Seabrook got its name from a freshwater brook that flows from Long Pond into tidal shallows near Maple Marsh, a mix of fresh and briny waters.",
      "sourceSentenceIds": [
        29
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://seabrookneighborhood.org/seabrook-a-tapestry-of-history-and-heart-in-cape-cod-s-hidden-gem/",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Before European settlers, the Wampanoag people used Seabrook’s tidal creeks for seasonal fishing, shellfish gathering, and temporary camps.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/seabrook_massachusetts",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Glacial activity carved Cape Cod’s curves, leaving sandy soils from glacial till and outwash that make Seabrook’s landscape prone to seasonal water table shifts.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/seabrook_massachusetts",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Early 1700s English settlers claimed land along Bayberry Avenue and Seabrook Road, building modest saltbox homes and weathered barns that sometimes resurface during modern landscaping.",
