  "facts": [
    {
      "id": 1,
      "text": "Lake Colorado City is an artificial lake on Morgan Creek located in the Colorado River basin of central Mitchell County.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.tshaonline.org/handbook/entries/lake-colorado-city"
    },
    {
      "id": 2,
      "text": "General contractor Harry Campbell completed the construction of Lake Colorado City in September 1949.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.tshaonline.org/handbook/entries/lake-colorado-city"
    },
    {
      "id": 3,
      "text": "The Lake Colorado City Dam is an earthfill structure eighty-one feet high and is popularly known as the Morgan Creek Dam.",
      "sourceSentenceIds": [
        14,
        16
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.tshaonline.org/handbook/entries/lake-colorado-city"
    },
    {
      "id": 4,
      "text": "Water is pumped from Champion Creek Reservoir to maintain a satisfactory operating level when Lake Colorado City's water level is low.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.tshaonline.org/handbook/entries/lake-colorado-city"
    },
    {
      "id": 5,
      "text": "The Texas Electric Service Company owns and operates the reservoir, which has a surface area of over sixteen hundred acres.",
      "sourceSentenceIds": [
        15
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.tshaonline.org/handbook/entries/lake-colorado-city"
    },
    {
      "id": 6,
      "text": "By the 1960s, six power plants used water from Lake Colorado City to generate eight hundred thirty-three thousand kilowatts of power.",
      "sourceSentenceIds": [
        19
