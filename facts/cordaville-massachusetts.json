  "facts": [
    {
      "id": 1,
      "text": "Cordaville’s Alden House Historic Site hosts Liberty Pole Day, a living‑history celebration on May 2 that draws crowds to the 17th‑century homestead.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://seeplymouth.com/"
    },
    {
      "id": 2,
      "text": "Cordaville feels like a history lover’s paradise, where walking tours reveal sunlit vistas and stories of early settlers.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://seeplymouth.com/"
    },
    {
      "id": 3,
      "text": "At Alden House, visitors can watch a reenactment of Duxbury’s 1775 Council of War, complete with fife and drum music.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://seeplymouth.com/"
    },
    {
      "id": 4,
      "text": "The town’s streets are lined with a mix of historic and modern homes, reflecting its evolution from colonial roots to contemporary life.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.trawellino.com/destinations/united-states/massachusetts_cordaville"
    },
    {
      "id": 5,
      "text": "Sunrise in Cordaville lights up at 8:21 am, while sunset falls around 8:41 pm, giving drivers a 12‑hour‑20‑minute day.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.trawellino.com/destinations/united-states/massachusetts_cordaville"
    },
    {
      "id": 6,
      "text": "Cordaville sits at 42°16′12″N 71°31′37″W, placing it just west of Plymouth in Massachusetts’ South Shore.",
