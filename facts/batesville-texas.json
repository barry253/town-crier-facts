  "facts": [
    {
      "id": 1,
      "text": "Batesville grew around the Bates family ranch founded by Elijah, Felix, and Finis Bates in 1869.",
      "sourceSentenceIds": [
        27,
        28
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.tshaonline.org/handbook/entries/batesville-tx-zavala-county",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Elijah Anderson Bates chartered the Comanche Irrigation Company in 1876, damming the Leona River to irrigate 500 acres.",
      "sourceSentenceIds": [
        29,
        30
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.tshaonline.org/handbook/entries/batesville-tx-zavala-county",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The town’s first school opened in 1884, serving local children before high school students moved to Uvalde in 1949.",
      "sourceSentenceIds": [
        23,
        24
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Batesville%2C_Texas",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Today, Batesville students attend the local K‑6 Batesville School, then continue at Morales Junior High and Uvalde High.",
      "sourceSentenceIds": [
        22
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Batesville%2C_Texas",
      "category": "other",
      "quality": "poor",
      "qualityReason": "other"
    },
    {
      "id": 5,
      "text": "Batesville sits on the Leona River at the intersection of U.S. Highway 277 and Farm‑to‑Market Road 100.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.tshaonline.org/handbook/entries/batesville-tx-zavala-county",
      "category": "other",
      "quality": "poor",
      "qualityReason": "location_description"
    },
    {
      "id": 6,
      "text": "The community’s name honors the original Bates ranchers who settled the area in the late 1860s.",
