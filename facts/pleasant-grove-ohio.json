  "facts": [
    {
      "id": 1,
      "text": "Pleasant Grove sits near the geographic center of Muskingum County, at the southern edge of Washington Township.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Pleasant_Grove%2C_Ohio",
      "category": "other",
      "quality": "poor",
      "qualityReason": "location_description"
    },
    {
      "id": 2,
      "text": "The community lies just south of I‑70, where Routes 40 and 22 run together as East Pike.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Pleasant_Grove%2C_Ohio",
      "category": "other",
      "quality": "poor",
      "qualityReason": "location_description"
    },
    {
      "id": 3,
      "text": "Mill Run and a Boggs Creek tributary drain the area, both feeding the Muskingum River.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Pleasant_Grove%2C_Ohio",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Pleasant Grove borders Wayne Township to the south and the city of Zanesville, the county seat, to the southwest.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Pleasant_Grove%2C_Ohio",
      "category": "other",
      "quality": "poor",
      "qualityReason": "location_description"
    },
    {
      "id": 5,
      "text": "The town’s name appears in a list of over 100 Pleasant Grove communities across the U.S., with three in Ohio alone.",
