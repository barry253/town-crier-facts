  "facts": [
    {
      "id": 1,
      "text": "Yakutat’s name comes from the Eyak word diyaʼqudaʼt, blended with the Tlingit yaakw, meaning ‘the place where canoes rest’.",
      "sourceSentenceIds": [
        20,
        23
      ],
