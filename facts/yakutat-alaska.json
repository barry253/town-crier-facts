    },
    {
      "id": 2,
      "text": "In 1796, the Russian-American Company founded the fortified settlement of New Russia near modern Yakutat.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.kupi.com/en/explore/united-states/yakutat/history"
    },
    {
      "id": 3,
      "text": "The Yakutat and Southern Railroad was completed in 1904 to ferry fish from the docks straight to the cannery.",
      "sourceSentenceIds": [
        15
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.kupi.com/en/explore/united-states/yakutat/history"
    },
    {
      "id": 4,
      "text": "During World War II, the U.S. Army Air Forces built a paved runway near Yakutat for military aviation.",
