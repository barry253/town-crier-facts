  "facts": [
    {
      "id": 1,
      "text": "Yakutat’s name comes from the Eyak word diyaʼqudaʼt, blended with the Tlingit yaakw, meaning ‘the place where canoes rest’.",
      "sourceSentenceIds": [
        20,
        23
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Yakutat%2C_Alaska",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "In 1796, the Russian-American Company founded the fortified settlement of New Russia near modern Yakutat.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.kupi.com/en/explore/united-states/yakutat/history",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The Yakutat and Southern Railroad was completed in 1904 to ferry fish from the docks straight to the cannery.",
      "sourceSentenceIds": [
        15
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.kupi.com/en/explore/united-states/yakutat/history",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "During World War II, the U.S. Army Air Forces built a paved runway near Yakutat for military aviation.",
      "sourceSentenceIds": [
        19
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Yakutat%2C_Alaska",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Before European arrival, the region was home to Eyak people, who were later assimilated into the Tlingit tribe.",
      "sourceSentenceIds": [
        5,
        27,
        28
      ],
      "sourceLabels": [
        "Web source 1",
        "Wikipedia"
      ],
      "source": "https://www.kupi.com/en/explore/united-states/yakutat/history",
      "category": "history",
      "quality": "good"
    },
    {
