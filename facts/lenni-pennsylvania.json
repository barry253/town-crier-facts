  "facts": [
    {
      "id": 1,
      "text": "Lenni began as a mill town when Thomas Griffith sold land to paper maker John Lungren in 1797, who built a mill the next year.",
      "sourceSentenceIds": [
        2,
        12,
        18
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Lenni%2C_Pennsylvania",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "After 1877, Union Army General Robert Patterson leased Lenni’s mills, linking the community to the Civil War era.",
      "sourceSentenceIds": [
        13,
        20,
        21
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Lenni%2C_Pennsylvania",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Lenni’s train station, once a local hub, closed in September 1986 as tracks deteriorated and Chester County expanded Exton Station on SEPTA’s Paoli/Thorndale Line.",
      "sourceSentenceIds": [
        5,
        6,
        7,
        8,
        9
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Lenni%2C_Pennsylvania",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The community sits where Lenni Road meets Lungren Road, just northeast of Chester Creek, defining its historic crossroads location.",
      "sourceSentenceIds": [
        10,
        11,
        16
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Lenni%2C_Pennsylvania",
      "category": "other",
      "quality": "poor",
      "qualityReason": "location_description"
    },
    {
      "id": 5,
      "text": "Lenni is an unincorporated community, meaning residents live there without a separate municipal government.",
      "sourceSentenceIds": [
        14,
        15
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://kids.kiddle.co/Lenni,_Pennsylvania",
      "category": "other",
      "quality": "poor",
      "qualityReason": "other"
    },
    {
      "id": 6,
      "text": "The name Lenni honors John Lungren, whose paper mill helped shape the area’s early economy.",
