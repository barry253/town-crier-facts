  "facts": [
    {
      "id": 1,
      "text": "Brookston was founded in 1870 as part of the Zachariah Westfall survey and became a temporary terminus for the Texas and Pacific Railway during the 1873 panic.",
      "sourceSentenceIds": [
        8,
        9
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.tshaonline.org/handbook/entries/brookston-tx",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Brookston’s early economy boomed with a steam‑powered cotton gin, a corn mill, and a Western Union telegraph office, making it a regional trade hub.",
      "sourceSentenceIds": [
        22
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.tshaonline.org/handbook/entries/brookston-tx",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "By the early 1900s, three churches had been built and a telephone exchange was installed, signaling Brookston’s growing community life.",
      "sourceSentenceIds": [
        25
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.tshaonline.org/handbook/entries/brookston-tx",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The post office, established in the town’s early years, was named after the original landowner, Brooks, honoring his contribution to the area.",
      "sourceSentenceIds": [
        21
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.tshaonline.org/handbook/entries/brookston-tx",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Brookston’s historical records are preserved by the Texas State Historical Association, which maintains a digital library of the town’s founding documents.",
      "sourceSentenceIds": [
