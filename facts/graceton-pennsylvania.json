  "facts": [
    {
      "id": 1,
      "text": "Graceton began as a coal town when George Mikesell built 12 beehive coke ovens in 1887, producing the first coke in Indiana County.",
      "sourceSentenceIds": [
        19
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://homercenterhistori.wixsite.com/website/graceton-coral",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "After the Pennsylvania Railroad opened a line, locals renamed the station Ranson to Graceton, though the name’s exact origin—possibly a McCreary family member—remains unclear.",
      "sourceSentenceIds": [
        4,
        5,
        6
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://homercenterhistori.wixsite.com/website/graceton-coral",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "In 1890 the original 12 ovens grew to 202, and the McCreary brothers formed the Graceton Coke Company after purchasing the plant.",
      "sourceSentenceIds": [
        3,
        26,
        27,
        28
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://homercenterhistori.wixsite.com/website/graceton-coral",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Graceton lies less than a mile from Coral, a neighboring CDP that was once called “Oklahoma” before adopting its current name in 1902.",
      "sourceSentenceIds": [
        16,
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://homercenterhistori.wixsite.com/website/graceton-coral",
      "category": "other",
      "quality": "poor",
      "qualityReason": "editorial_filler"
    },
    {
      "id": 5,
      "text": "Early Graceton featured a company store and housing that could accommodate 200 families, a classic example of a 19th‑century company town.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://homercenterhistori.wixsite.com/website/graceton-coral",
      "category": "economy",
      "quality": "good",
      "qualityReason": "other"
    },
    {
      "id": 6,
      "text": "Graceton observes Eastern Time and switches to daylight saving, a detail noted in local gazetteers.",
      "sourceSentenceIds": [
        13
