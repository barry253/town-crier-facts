  "facts": [
    {
      "id": 1,
      "text": "Numa was laid out in 1871, establishing the town that would become a coal mining hub in Iowa.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Numa%2C_Iowa",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "In 1907 a fire destroyed the surface equipment of the Numa Block mine, whose 150‑foot shaft accessed a 30‑inch coal seam.",
      "sourceSentenceIds": [
        10,
        11
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Numa%2C_Iowa",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "By 1914 the Numa Block Coal Company produced over 100,000 tons of coal, ranking among Iowa’s top 24 producers.",
      "sourceSentenceIds": [
        21
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Numa%2C_Iowa",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The company town of Martinstown, platted in 1913, grew to about 40 houses that locals nicknamed Shantytown.",
      "sourceSentenceIds": [
        17,
        18
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Numa%2C_Iowa",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The mine closed in 1937 after undermining 96 acres, leaving only a slag pile that still marks the site.",
      "sourceSentenceIds": [
        19,
        20
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Numa%2C_Iowa",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The Numa Block Coal Company also owned mines in Seymour, located roughly eight miles west of the town.",
      "sourceSentenceIds": [
