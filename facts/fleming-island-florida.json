  "facts": [
    {
      "id": 1,
      "text": "Fleming Island takes its name from Irish immigrant George Fleming, who received a 1,000‑acre land grant in 1760 for military service.",
      "sourceSentenceIds": [
        11
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Fleming_Island%2C_Florida",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "During World War II, the U.S. Navy built four asphalt runways on the island, creating NOLF Fleming Island, an auxiliary field for Naval Air Station Jacksonville.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Fleming_Island%2C_Florida",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The Clay County Public Library headquarters sits on Fleming Island, making it a regional hub for books and community events.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Fleming_Island%2C_Florida",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "An 8‑foot‑wide sidewalk snakes the length of Fleming Island, offering roughly 7 miles of walking, jogging, and biking along the waterfront.",
      "sourceSentenceIds": [
        19
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Fleming_Island%2C_Florida",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Black Creek Park on the south end of the island borders Black Creek and provides bikers and hikers with nature trails that wind through wetlands.",
      "sourceSentenceIds": [
        20
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Fleming_Island%2C_Florida",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Fleming Island High School opened in 2003, becoming the island’s only high school and a focal point for local sports and community gatherings.",
