      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The Awatovi Ruins are preserved by the Hopi Reservation and are not open to the public for conservation reasons.",
      "sourceSentenceIds": [
        27
      ],
      "sourceLabels": [
        "Web source 1"
      ],
