  "facts": [
    {
      "id": 1,
      "text": "The area now called Ridgecrest was first settled by Seminole Indians who migrated from Georgia and Alabama around 1750, establishing small towns along the peninsula.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/ridgecrest_florida",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Ridgecrest began as a quintessential post‑World War II neighborhood, the sixth of the original six neighborhoods that formed before Shoreline became a city.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.ridgecrestneighborhood.org/about-ridgecrest/ridgecrest-history",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Dansville, a Ridgecrest neighborhood, was named after Dan Henry, who applied for a liquor license, and a 2021 historical marker now honors him.",
      "sourceSentenceIds": [
        2,
        6
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/ridgecrest_florida",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The western edge of Ridgecrest was sliced by a major freeway, creating a large swath that now separates the neighborhood from the rest of the city.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.ridgecrestneighborhood.org/about-ridgecrest/ridgecrest-history",
      "category": "other",
      "quality": "poor",
      "qualityReason": "other"
    },
    {
      "id": 5,
      "text": "Since 2014, Pinellas County has led revitalization projects in Ridgecrest, aiming to improve connectivity, housing, and green spaces amid vacant lots and traffic barriers.",
      "sourceSentenceIds": [
        25
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/ridgecrest_florida",
      "category": "other",
      "quality": "poor",
      "qualityReason": "other"
    },
    {
      "id": 6,
      "text": "During the Second Seminole War, Fort Harrison was established at nearby Clearwater Harbor in 1841 as a base against the Seminoles, but it was abandoned the following year.",
