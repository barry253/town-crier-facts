  "facts": [
    {
      "id": 1,
      "text": "Brentwood was incorporated in 1922 and named after the Brentwood estate built in 1817 by Robert Brent in Northeast Washington, D.C.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Brentwood%2C_Maryland",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town grew around the Highland Station of the Washington Branch of the Baltimore and Ohio Railroad and the Columbia and Maryland Railway starting in the 1890s.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Brentwood%2C_Maryland",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Growth continued through the 1940s and 1950s, fueled by an influx of government workers.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Brentwood%2C_Maryland",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Brentwood sits within one mile of Washington, D.C., making it a close suburb of the capital.",
      "sourceSentenceIds": [
        11
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Brentwood%2C_Maryland",
      "category": "other",
      "quality": "poor",
      "qualityReason": "location_description"
    },
    {
      "id": 5,
      "text": "The town’s early streets were lit first by kerosene lamps in 1917 and then by electric lights in 1920.",
