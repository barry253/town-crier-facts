  "facts": [
    {
      "id": 1,
      "text": "North Plymouth grew around Cordage Park, where the Plymouth Cordage Company once produced rope for the age of sail, employing up to 2,000 workers.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/north_plymouth_massachusetts",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town’s name traces back to the 1620 Plymouth Colony, founded by Mayflower Pilgrims who landed at Plymouth Rock and sought land beyond the rocky center.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/north_plymouth_massachusetts",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "In 1845 the Old Colony Railroad reached North Plymouth, linking it to Boston and sparking industrial growth that saw a 900‑foot ropewalk built by 1924.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/north_plymouth_massachusetts",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Before Europeans, the area that became North Plymouth was part of Wampanoag territory, with native planting grounds along the Eel River noted by 17th‑century explorers.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/north_plymouth_massachusetts",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The Plymouth Cordage Company’s factory town featured worker housing, schools, and a 58‑hour work‑week limit law, creating a self‑contained community along the harbor.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/north_plymouth_massachusetts",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Today, Cordage Commerce Center occupies the former Cordage Park site, offering offices and stores where once rope‑making dominated the landscape.",
      "sourceSentenceIds": [
        14
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/North_Plymouth%2C_Massachusetts",
