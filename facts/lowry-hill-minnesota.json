  "facts": [
    {
      "id": 1,
      "text": "Lowry Hill takes its name from Thomas Lowry, the streetcar magnate who built his mansion there in the 1870s.",
      "sourceSentenceIds": [
        1,
        4
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 2"
      ],
      "source": "https://en.wikipedia.org/wiki/Lowry_Hill%2C_Minneapolis",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The Walker Art Center sits atop Lowry Hill, surrounded by historic mansions that line the streets below.",
      "sourceSentenceIds": [
        9,
        10
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://mplswithlove.com/neighborhoods/lowry-hill",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Before European settlers, the hill was a Dakota homeland, later a swampy forest that early farmers cleared in the mid‑1800s.",
      "sourceSentenceIds": [
        16,
        17,
        25
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Lowry_Hill%2C_Minneapolis",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The electric streetcar extension along Hennepin and Douglas in the 1890s sparked a real‑estate boom that shaped Lowry Hill’s streetscape.",
      "sourceSentenceIds": [
        27
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.lowryhillneighborhood.org/history",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "In 1946 residents formed Lowry Hill Home Owners Inc. to protect their homes from deterioration.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.lowryhillneighborhood.org/history",
      "category": "people",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Victorian, Colonial, Mediterranean, Tudor, Romanesque, Rambler, and Prairie styles mingle in Lowry Hill’s homes, many built after the neighborhood’s founding.",
