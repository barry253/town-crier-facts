  "facts": [
    {
      "id": 1,
      "text": "El Granada got its name when a postal clerk misspelled Granada, Spain, in 1909.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/El_Granada%2C_California"
    },
    {
      "id": 2,
      "text": "The town’s concentric‑circular streets were designed by famed planner Daniel Burnham.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/El_Granada%2C_California"
    },
    {
      "id": 3,
      "text": "Burnham’s plan was commissioned by the Ocean Shore Railroad to turn El Granada into a seaside resort for San Francisco travelers.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/El_Granada%2C_California"
    },
    {
      "id": 4,
      "text": "On the hills above El Granada, you’ll spot domed structures that once housed the Pillar Point Air Force Station.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://strategicshoppingnetwork.com/discovering-el-granada-what-to-expect-when-you-visit/"
    },
    {
      "id": 5,
      "text": "That station still tracks satellite launches from the nearby launch pad.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://strategicshoppingnetwork.com/discovering-el-granada-what-to-expect-when-you-visit/"
    },
    {
      "id": 6,
      "text": "SamTrans route 117 connects El Granada to Pacifica and Half Moon Bay, keeping the town linked to the Bay Area.",
