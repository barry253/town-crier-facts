  "facts": [
    {
      "id": 1,
      "text": "LeDroit Park was founded in 1873 by Amzi Barber, a businessman linked to Howard University.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/LeDroit_Park",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The neighborhood’s name comes from Barber’s father‑in‑law, LeDroict Langdon, with the final “c” dropped.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/LeDroit_Park",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Walter Washington, DC’s first mayor elected under home rule, lived at 326 T Street, a National Historic Landmark.",
      "sourceSentenceIds": [
        22
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/LeDroit_Park",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The historic district’s architecture was designed by James McGill and built mainly between 1873 and 1877, earning National Register status in 1974.",
      "sourceSentenceIds": [
        15,
        17
      ],
      "sourceLabels": [
        "Web source 1",
        "Wikipedia"
      ],
      "source": "https://home.nps.gov/places/ledroit-park-historic-district.htm",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "LeDroit Park once enforced a white‑only policy, even installing a fence and guards at its gates.",
      "sourceSentenceIds": [
        26
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://home.nps.gov/places/ledroit-park-historic-district.htm",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The neighborhood hosts a 90‑minute walking tour with 16 signs that trace its history and diverse residents.",
      "sourceSentenceIds": [
        18
      ],
