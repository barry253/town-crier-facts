    },
    {
      "id": 2,
      "text": "The borough was named after Stiles Township, itself named for early landowner John Stiles, whose descendants no longer live here.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.trawellino.com/destinations/united-states/pennsylvania_stiles"
    },
    {
      "id": 3,
      "text": "In the 19th century, Stiles thrived as an iron‑production hub, supplying furnaces that fed the growing railroad industry.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.trawellino.com/destinations/united-states/pennsylvania_stiles"
    },
    {
      "id": 4,
      "text": "Coplay Creek marks Stiles’ western edge and flows southeast into the Lehigh River.",
