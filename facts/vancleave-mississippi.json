  "facts": [
    {
      "id": 1,
      "text": "Vancleave first appeared on maps as Bluff Creek before 1870, when former slave Hector Fairley renamed it after merchant Robert Adrian Van Cleave.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://msgulfcoastheritage.ms.gov/downtowns/vancleave/",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "French settlers established a small community near the creek around 1721, laying the groundwork for what would become Vancleave.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/Vancleave,_Mississippi",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Despite nearby Gulf Coast growth, Vancleave has stayed rural, resisting suburban sprawl even as petrochemical and casino industries expanded.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/Vancleave,_Mississippi",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The area is traditionally associated with the Choctaw people, who once called the region the Vancleave Indians or Vancleave Creoles.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Vancleave%2C_Mississippi",
      "category": "people",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The town’s post office, established in 1870, cemented Vancleave’s identity and connected the community to the wider world.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/Vancleave,_Mississippi",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Early French colonists in the area tried to grow tobacco and indigo, but harsh conditions and disease limited their success.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/Vancleave,_Mississippi",
