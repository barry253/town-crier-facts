  "facts": [
    {
      "id": 1,
      "text": "Wright is named after Robert Wright, Dodge City’s former mayor and entrepreneur who owned the Santa Fe line stockyards that gave the town its name.",
      "sourceSentenceIds": [
        13
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://fordcountyhistory.org/ford-county/communities/wright-kansas-its-past-and-present/",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Before it was officially founded, the site served as a stagecoach stop on the old Stage Coach Line, seven miles northeast of Dodge City.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://legendsofkansas.com/wright-kansas/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "William Hunt, a New Jersey native, helped charter Wright in 1887—originally Ridgeway—by investing $200 each with partners to form a town company.",
      "sourceSentenceIds": [
        4,
        24
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://fordcountyhistory.org/ford-county/communities/wright-kansas-its-past-and-present/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "By 1905 a new train station rose, and Wright grew to host a newspaper, grain‑shipping firm, general store, and other businesses.",
      "sourceSentenceIds": [
        15,
        12
      ],
      "sourceLabels": [
        "Web source 1",
        "Web source 2"
      ],
      "source": "https://fordcountyhistory.org/ford-county/communities/wright-kansas-its-past-and-present/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "In 1915 farmers Frank (Casey) Jones and Ed Brown formed a cooperative by buying a private elevator on the Santa Fe railroad line.",
      "sourceSentenceIds": [
        9
      ],
