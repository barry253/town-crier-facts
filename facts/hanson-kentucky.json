  "facts": [
    {
      "id": 1,
      "text": "Hanson was founded in 1869 to serve as a stop on the Evansville, Henderson, and Nashville Railroad.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Hanson%2C_Kentucky"
    },
    {
      "id": 2,
      "text": "The town is named for Henry B. Hanson, the civil engineer who planned the community.",
      "sourceSentenceIds": [
        4,
        5,
        6
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Hanson%2C_Kentucky"
    },
    {
      "id": 3,
      "text": "Hanson is a home rule-class city located in northern Hopkins County, Kentucky.",
      "sourceSentenceIds": [
        15,
        23
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Hanson%2C_Kentucky"
    },
    {
      "id": 4,
      "text": "The community received its first post office on December 7, 1869, and was incorporated in 1873.",
      "sourceSentenceIds": [
        18
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Hanson%2C_Kentucky"
    },
    {
      "id": 5,
      "text": "A major fire in 1889 destroyed much of the city, leading to the creation of the present historic district.",
      "sourceSentenceIds": [
        21
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Hanson%2C_Kentucky"
    },
    {
      "id": 6,
      "text": "CSX Transportation currently operates a siding track in Hanson as part of the former L&N network.",
      "sourceSentenceIds": [
