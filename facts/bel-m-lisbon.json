  "facts": [
    {
      "id": 1,
      "text": "Belém Tower, built between 1515 and 1520 by King Manuel I, was erected to guard the Tagus entrance and protect Lisbon’s harbor.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Bel%C3%A9m%2C_Lisbon",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Jerónimos Monastery, first erected for pilgrims in 1501, became a royal retreat for the House of Aviz and a sanctuary for sailors before and after Vasco da Gama’s voyage.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Bel%C3%A9m%2C_Lisbon",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Until 2012, the area that is now Belém operated as its own historic parish, called Santa Maria de Belém, before merging with Lisbon.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Bel%C3%A9m%2C_Lisbon",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Belém’s industrial boom brought tanneries, metal stampers, glassmakers, earthenware and textile factories, even a rope‑making plant that supplied ships along the Tagus.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Bel%C3%A9m%2C_Lisbon",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Inside Jerónimos Monastery, the National Archaeological Museum and the Maritime Museum display artifacts that chronicle Portugal’s age of discovery.",
      "sourceSentenceIds": [
        14
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Bel%C3%A9m%2C_Lisbon",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Belém Tower, a UNESCO World Heritage landmark, stands on the Tagus and today serves as a museum showcasing maritime history.",
      "sourceSentenceIds": [
        30
