  "facts": [
    {
      "id": 1,
      "text": "Pine Creek earned its name from the towering pine trees lining its banks, a favorite spot for fly fishers and hikers.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.mtmemory.org/nodes/view/128166",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "By 1898, homesteaders in Pine Creek had built a one‑room schoolhouse, marking the community’s first organized education.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/pine_creek_montana",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The Northern Pacific Railway’s arrival after 1883 spurred Pine Creek’s growth, transforming it from a reservation land to a thriving settlement.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/pine_creek_montana",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "During the 1970s and 80s, Pine Creek hosted the Montana Gang, a gathering of writers and musicians who inspired Montana’s literary scene.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/pine_creek_montana",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The 1946 Pine Creek Lodge, built by Wayne Crosby, remains a rustic stone venue for live music, dining, and mountain‑view lodging.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/pine_creek_montana",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Pine Creek lies where the creek meets the Yellowstone River, a point where waters from the Absaroka Mountains enter the valley.",
