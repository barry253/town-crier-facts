  "facts": [
    {
      "id": 1,
      "text": "Marietta sits on the Susquehanna River, a community that has grown along its shore for over two centuries.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.mariettarestoration.org/history/",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "In 1913, Italian immigrant Samuel Acri opened one of the country’s earliest movie theaters on Market Street, later renamed the Historic Marietta Theatre.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.mariettarestoration.org/history/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The Marietta Restoration Associates, founded in 1965, bought the Sultzbach/Rinehart House in 1967 to preserve historic properties and later returned them to private owners.",
      "sourceSentenceIds": [
        5,
        6
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.mariettarestoration.org/history/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "In 1978, the U.S. placed part of Marietta on the National Register of Historic Places, recognizing it as a well‑preserved mid‑19th‑century town.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.mariettarestoration.org/history/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The town’s historic Market House was erected in 1816, with the Union Meeting House completed in 1818, marking early civic and religious life.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.mariettarestoration.org/history/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Marietta’s town hall, still standing, was used for the 1912 centennial celebrations and remains a focal point for local governance.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.mariettarestoration.org/history/",
      "category": "landmark",
      "quality": "good"
    }
