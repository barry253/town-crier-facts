  "facts": [
    {
      "id": 1,
      "text": "Forest City grew from a lumber mill founded by William Pentecost in 1864 to over 6,000 residents by the 1920s.",
      "sourceSentenceIds": [
        14
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.visitforestcitypa.com/history",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town's name changed from 'Pentecost' to Forest City in 1886 when the post office was renamed, and the borough formed two years later.",
      "sourceSentenceIds": [
        4,
        23
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Forest_City%2C_Pennsylvania",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "A railroad spur built by the D&H Canal Company between 1866 and 1871 linked Forest Mills to the wider region, boosting lumber transport.",
      "sourceSentenceIds": [
        8,
        16
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 2"
      ],
      "source": "https://en.wikipedia.org/wiki/Forest_City%2C_Pennsylvania",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The Forest City Area Historical Society, housed in the former Methodist Church, preserves the town’s mining and lumber heritage.",
      "sourceSentenceIds": [
        13,
        19
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Forest_City%2C_Pennsylvania",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The town’s first library branch sits on the first floor of the Borough Building, a historic civic center.",
      "sourceSentenceIds": [
