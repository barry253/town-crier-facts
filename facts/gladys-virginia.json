  "facts": [
    {
      "id": 1,
      "text": "Gladys was renamed after the daughter of a railroad executive, reflecting the town’s ties to the rail industry.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.co.campbell.va.us/810/Historical-Resources",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Before becoming Gladys, the settlement was called Pigeon Run, named for the flocks of passenger pigeons that once roosted in its forests.",
      "sourceSentenceIds": [
        21
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.co.campbell.va.us/810/Historical-Resources",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The village’s historic courthouse, built in 1848, still stands and is listed on the National Register of Historic Places.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.co.campbell.va.us/810/Historical-Resources",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The nearby Kanawa Canal lock remains, a quiet reminder of the canal’s role in 19th‑century commerce and transportation.",
      "sourceSentenceIds": [
        11
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.co.campbell.va.us/810/Historical-Resources",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Gladys lies 10.6 miles northwest of Brookneal along Route 501, a stretch that traces the historic path of early settlers.",
      "sourceSentenceIds": [
        17
