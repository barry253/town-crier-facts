    {
      "id": 1,
      "text": "Norcross sprang up in 1870 as a railroad town when the Richmond‑Danville line pushed out of Atlanta.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.norcrosstours.com/history/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Norcross Methodist Church traces its roots back to 1818, when a small group formed Medlock’s Chapel just southeast of the future town.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.norcrosstours.com/history/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The first public library in Gwinnett County opened in Norcross on July 1, 1907, housed in a schoolroom before moving to a dedicated building in 1921.",
      "sourceSentenceIds": [
        26,
        29
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.norcrosstours.com/history/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Thrasher Park, chartered in 1870 by JJ “Cousin John” Thrasher, was named for his friend Jonathan Norcross, the 1851 mayor of Atlanta.",
      "sourceSentenceIds": [
        24
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.norcrosstours.com/history/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The original Norcross depot served both freight and passengers, featuring a warehouse, offices, a waiting area, and a ticket counter.",
      "sourceSentenceIds": [
