  "facts": [
    {
      "id": 1,
      "text": "Brandon never had a post office, so it never appeared on official maps, yet it still operated as a bustling mining community.",
      "sourceSentenceIds": [
        3,
        18
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://treasurestate.com/ghost-towns/brandon/",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "In 1864 prospectors from Alder Gulch found gold along Mill Creek, sparking Brandon's founding at the base of the Tobacco Root Mountains.",
      "sourceSentenceIds": [
        15,
        11
      ],
      "sourceLabels": [
        "Web source 1",
        "Wikipedia"
      ],
      "source": "https://treasurestate.com/ghost-towns/brandon/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The miners even entered Brandon into the 1874 territorial capital vote, losing to Helena by a single vote.",
      "sourceSentenceIds": [
        13
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://treasurestate.com/ghost-towns/brandon/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "By 1904 Edgar Fletcher installed a hydroelectric plant on Mill Creek, powering his mine and a small mill.",
      "sourceSentenceIds": [
        24
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://treasurestate.com/ghost-towns/brandon/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Alex Walker established a permanent camp of thirty log cabins in 1931, nicknamed Smuggler City, after reviving the Emma B claim.",
      "sourceSentenceIds": [
        26,
        29
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://treasurestate.com/ghost-towns/brandon/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The abandoned Tamarack and Toledo mines still leave visible scars on the hillsides north of Brandon.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 1"
      ],
