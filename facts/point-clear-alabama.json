    {
      "id": 1,
      "text": "Point Clear attracted settlers in the early 1800s, becoming a 1830s resort for Mobile and New Orleans elites around the Grand Hotel built in 1847.",
      "sourceSentenceIds": [
        12,
        24
      ],
      "sourceLabels": [
        "Web source 2",
        "Web source 1"
      ],
      "source": "https://stanislauscountyhomesales.com/point-clear-history-a-look-at-alabamas-coastal-gem/"
    },
    {
      "id": 2,
      "text": "The Grand Hotel, still operating today, blends its 1847 historic architecture with modern luxury amenities and championship golf courses.",
      "sourceSentenceIds": [
        13
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://stanislauscountyhomesales.com/point-clear-history-a-look-at-alabamas-coastal-gem/"
    },
    {
      "id": 3,
      "text": "Point Clear’s climate is humid subtropical, featuring hot, humid summers, mild winters, and Gulf breezes that cool the shoreline daily.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/point_clear"
    },
    {
      "id": 4,
      "text": "Older Point Clear homes were built with wrap‑around porches and windows designed to capture the refreshing bay breezes before air conditioning.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/point_clear"
    },
    {
      "id": 5,
      "text": "The town’s culture blends Southern elegance, coastal casualness, and deep hospitality, creating a uniquely relaxed yet refined atmosphere.",
