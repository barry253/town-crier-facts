  "facts": [
    {
      "id": 1,
      "text": "Founded by English shipbuilder William Fell in 1726, Fells Point grew into Baltimore’s deep‑water port and shipbuilding hub.",
      "sourceSentenceIds": [
        25
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.nps.gov/places/fells-point.htm",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The neighborhood’s name comes from the Fell family, whose wealth passed to William’s son Edward, who helped shape the area in the 1760s.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://fellspoint.com/history/",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "In 1763, Fells Point was officially established along the north shore of Baltimore Harbor, marking the start of a bustling waterfront community.",
      "sourceSentenceIds": [
        15
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Fells_Point",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "During the War of 1812, British forces targeted Baltimore because of its commercial importance, and Fells Point’s docks were a key strategic point.",
      "sourceSentenceIds": [
        26
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.nps.gov/places/fells-point.htm",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The annual Fell’s Point Privateer Festival, held each April, celebrates the area’s maritime heritage and attracts visitors to historic waterfront streets.",
      "sourceSentenceIds": [
        24
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Fells_Point",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The neighborhood once housed a diverse mix of immigrants—Irish, Germans, Jews, Poles, Ukrainians, Russians, Czechs, and Slovaks—who built homes and businesses along the harbor.",
      "sourceSentenceIds": [
        16
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Fells_Point",
      "category": "people",
      "quality": "good"
    }
