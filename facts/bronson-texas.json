  "facts": [
    {
      "id": 1,
      "text": "Bronson was named for Samuel Bronson Cooper, the businessman who founded the Kirby Lumber Company that drove the town’s early growth.",
      "sourceSentenceIds": [
        3,
        7
      ],
      "sourceLabels": [
        "Web source 1",
        "Web source 2"
      ],
      "source": "https://www.tshaonline.org/handbook/entries/bronson-tx"
    },
    {
      "id": 2,
      "text": "In spring 1902 the town was platted on 200 acres along the Gulf, Beaumont and Great Northern Railway, sparking a timber boom.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.tshaonline.org/handbook/entries/bronson-tx"
    },
    {
      "id": 3,
      "text": "The Kirby Lumber Company’s sawmill began operating in 1902, turning Bronson into a bustling lumber hub for East Texas pinelands.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/bronson_texas"
    },
    {
      "id": 4,
      "text": "A post office and the weekly Bronson Bulletin newspaper were both established in 1902, serving the growing community.",
      "sourceSentenceIds": [
        24
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Bronson%2C_Texas"
    },
    {
      "id": 5,
      "text": "Bronson remains an unincorporated community in west‑central Sabine County, Texas, reflecting its modest but steady heritage.",
