  "facts": [
    {
      "id": 1,
      "text": "Kensington started as Knowles Station, a farming community that later became a summer refuge for Washington residents.",
      "sourceSentenceIds": [
        6,
        17
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Kensington%2C_Maryland",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "In the 1890s, developer Brainard Warner bought land south of Knowles Station and built a planned Victorian community with church, library, and newspaper.",
      "sourceSentenceIds": [
        18
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Kensington%2C_Maryland",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Warner named his subdivision Kensington Park, the tenth and largest in the area, giving the town its name.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Kensington%2C_Maryland",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The B&O Railroad’s Metropolitan Branch reached Kensington in 1873, shifting the area from agriculture to a rail hub.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Kensington%2C_Maryland",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Kensington station, the county’s second‑oldest active station, still serves MARC Brunswick Line trains to Washington, D.C.",
      "sourceSentenceIds": [
        22,
        30
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Kensington%2C_Maryland",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The Noyes Library for Young Children, Montgomery County’s oldest public library, sits in Kensington’s historic Old Town.",
