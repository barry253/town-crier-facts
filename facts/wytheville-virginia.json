  "facts": [
    {
      "id": 1,
      "text": "Wytheville was founded in 1792 as Evansham, renamed after a 1839 fire to honor George Wythe.",
      "sourceSentenceIds": [
        1,
        8,
        9
      ],
      "sourceLabels": [
        "Web source 2",
        "Wikipedia"
      ],
      "source": "https://americannomadtraveler.com/2025/05/05/wytheville/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Edith Bolling Wilson, First Lady Edith, was born in Wytheville in 1872, and her home now serves as a museum.",
      "sourceSentenceIds": [
        27,
        28,
        2
      ],
      "sourceLabels": [
        "Web source 2",
        "Web source 1"
      ],
      "source": "https://americannomadtraveler.com/2025/05/05/wytheville/",
      "category": "people",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The historic Bolling-Wilson Hotel, originally the George Wythe Hotel built in 1927, still operates as a landmark downtown.",
      "sourceSentenceIds": [
        16,
        25
      ],
      "sourceLabels": [
        "Web source 2",
        "Web source 1"
      ],
      "source": "https://americannomadtraveler.com/2025/05/05/wytheville/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Main Street’s brick facades and historic markers tell stories from the town’s early days, offering a walk through Virginia’s heritage.",
      "sourceSentenceIds": [
        3,
        18
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://visitswva.org/wytheville/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Wytheville sits where I‑77 and I‑81 converge, a crossroads that shaped its growth, though not a major commuter hub.",
      "sourceSentenceIds": [
        12
      ],
