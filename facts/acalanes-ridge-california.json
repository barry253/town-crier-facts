  "facts": [
    {
      "id": 1,
      "text": "Acalanes Ridge takes its name from the Saclanes, the Native American tribe that once lived in the surrounding Lafayette and Walnut Creek area.",
      "sourceSentenceIds": [
        1,
        2
      ],
      "sourceLabels": [
        "Web source 2",
        "Wikipedia"
      ],
      "source": "https://www.trawellino.com/destinations/united-states/california_acalanes-ridge",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The ridge rises to 499 feet, offering a modest but scenic elevation above the San Francisco Bay Area.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Acalanes_Ridge%2C_California",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Acalanes Ridge serves as a greenbelt, keeping the urban sprawl of Walnut Creek and Lafayette in check.",
      "sourceSentenceIds": [
        18
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.walnutcreekca.gov/Home/Components/FacilityDirectory/FacilityDirectory/8/664",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "From its ridgeline, drivers can spot the Carquinez Strait and Mount Diablo in a single sweeping 360‑degree view.",
      "sourceSentenceIds": [
        19
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.walnutcreekca.gov/Home/Components/FacilityDirectory/FacilityDirectory/8/664",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Short hikes here reveal a hidden sylvan creek and spring wildflowers that bloom just before the summer heat.",
      "sourceSentenceIds": [
        20
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.walnutcreekca.gov/Home/Components/FacilityDirectory/FacilityDirectory/8/664",
      "category": "nature",
      "quality": "good"
    },
    {
