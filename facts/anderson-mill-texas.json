  "facts": [
    {
      "id": 1,
      "text": "Anderson Mill is a working water‑powered grist mill and museum in central Texas.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.andersonsmill.org/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Named after Thomas Anderson, who moved from Virginia to Texas in the 1850s, the mill carries his legacy.",
      "sourceSentenceIds": [
        3,
        4,
        25
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Anderson_Mill%2C_Austin%2C_Texas",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "During the 1860s Anderson built the mill to produce gunpowder for the Confederate Army, then turned it into a gristmill after the war.",
      "sourceSentenceIds": [
        26,
        27
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.tshaonline.org/handbook/entries/anderson-mill-tx",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "A historical marker was placed near the mill site in 1936 to honor its early history.",
      "sourceSentenceIds": [
        7,
        9
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Anderson_Mill%2C_Austin%2C_Texas",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The mill sits on Cypress Creek, roughly sixteen miles northwest of Austin in northwestern Travis County.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.tshaonline.org/handbook/entries/anderson-mill-tx",
      "category": "other",
      "quality": "poor",
      "qualityReason": "location_description"
    },
    {
      "id": 6,
      "text": "After the area joined a municipal utility district in 1973, the mill was revived as part of Austin’s suburban growth.",
      "sourceSentenceIds": [
