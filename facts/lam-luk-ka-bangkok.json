  "facts": [
    {
      "id": 1,
      "text": "Lam Luk Ka began as a vast grassland dotted with wetlands, providing a natural habitat for diverse wildlife.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Lam_Luk_Ka_district",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Before 1904, the area was called Thung Luang, meaning 'great field' in Thai.",
      "sourceSentenceIds": [
        14
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Lam_Luk_Ka_district",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "When the government created amphoe Lam Luk Ka in 1904, the prefix Bueng—meaning marsh—was dropped.",
      "sourceSentenceIds": [
        15
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Lam_Luk_Ka_district",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Lam Luk Ka was once a rural district famed for floating markets that date back to the Ayutthaya period, when canals were the main transport routes.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.trawellino.com/destinations/thailand/pathum-thani_lam-luk-ka",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The district lies along the Chao Phraya River, where rice farming and local fisheries thrive.",
      "sourceSentenceIds": [
        17
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.trawellino.com/destinations/thailand/pathum-thani_lam-luk-ka",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "In Ban Lam Luk Ka, the historic Khu Khot area showcases unique architecture and a lively atmosphere.",
      "sourceSentenceIds": [
        2
      ],
