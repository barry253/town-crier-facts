  "facts": [
    {
      "id": 1,
      "text": "Belle Haven began as “Bell’s Oven,” a roadside bakery built by a man named Bell who sold goods to passing travelers.",
      "sourceSentenceIds": [
        2,
        20
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.co.northampton.va.us/residents/our_towns/belle_haven",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town straddles the county line, with most of its area in Accomack County and a smaller portion in Northampton County.",
      "sourceSentenceIds": [
        7,
        8
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.co.northampton.va.us/residents/our_towns/belle_haven",
      "category": "other",
      "quality": "poor",
      "qualityReason": "location_description"
    },
    {
      "id": 3,
      "text": "Although bypassed by the 1855 railroad, Belle Haven flourished after the 1884 Eastern Shore Railroad and steamboat traffic linked it to the Chesapeake Bay.",
      "sourceSentenceIds": [
        21
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.co.northampton.va.us/residents/our_towns/belle_haven",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Historic structures in Belle Haven were mainly built between the mid‑nineteenth and mid‑twentieth centuries, showcasing its growth era.",
      "sourceSentenceIds": [
        23
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.co.northampton.va.us/residents/our_towns/belle_haven",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Belle Haven’s town hall sits at Box 238, and residents can reach out there or to county offices for building permits and inspections.",
