  "facts": [
    {
      "id": 1,
      "text": "Alva’s founder, Captain Peter Nelson, bought the homestead in 1883 and named the town after the Alva Flower.",
      "sourceSentenceIds": [
        1,
        3,
        4
      ],
      "sourceLabels": [
        "Web source 1",
        "Web source 2"
      ],
      "source": "https://www.visitfortmyers.com/listing/alva-library-and-museum/69205",
      "category": "people",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The Alva Library, built in 1909, was the first public lending library in Lee County and later became a museum.",
      "sourceSentenceIds": [
        14,
        8,
        15
      ],
      "sourceLabels": [
        "Web source 1",
        "Wikipedia"
      ],
      "source": "https://www.visitfortmyers.com/listing/alva-library-and-museum/69205",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "In 1974 the Alva Garden Club converted the former library into a museum, preserving artifacts from the town’s founding families.",
      "sourceSentenceIds": [
        11
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Alva%2C_Florida",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Alva sits on the Caloosahatchee River, which flows westward through the community toward the Gulf of Mexico.",
      "sourceSentenceIds": [
        19
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Alva%2C_Florida",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The town’s historic chapel, opened in 1901, now houses the nonprofit museum alongside the library.",
      "sourceSentenceIds": [
        7,
        12
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Alva%2C_Florida",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Alva lies just 11 miles east of I‑75 on State Road 80, placing it between Fort Myers and LaBelle.",
