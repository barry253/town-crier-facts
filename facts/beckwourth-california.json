  "facts": [
    {
      "id": 1,
      "text": "Beckwourth was named for James P. Beckwourth, the mountain man who mapped the area in the mid‑1800s.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Beckwourth%2C_California"
    },
    {
      "id": 2,
      "text": "In 1850 Jim Beckwourth discovered a low pass that would later become the fastest route into California.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.nps.gov/places/jim-beckwourth-cabin-museum.htm"
    },
    {
      "id": 3,
      "text": "The Jim Beckwourth Cabin Museum, a certified National Historic California Landmark, preserves the explorer’s original log cabin.",
      "sourceSentenceIds": [
        1,
        26
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.nps.gov/places/jim-beckwourth-cabin-museum.htm"
    },
    {
      "id": 4,
      "text": "Beckwourth sits on the Middle Fork Feather River, just five miles east of Portola.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Beckwourth%2C_California"
    },
    {
      "id": 5,
      "text": "Beckwourth Pass, the low mountain route first charted by Beckwourth, is now part of State Route 70.",
      "sourceSentenceIds": [
        24
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Beckwourth%2C_California"
    },
    {
