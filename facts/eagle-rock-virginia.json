  "facts": [
    {
      "id": 1,
      "text": "Eagle Rock was the railroad crossroads where the Richmond‑Alleghany line met the Craig Valley Line, later part of the Chesapeake and Ohio Railway.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Eagle_Rock%2C_Virginia",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town’s original ford, called “The Free Stone Ford,” let mule‑drawn wagons cross the river before bridges appeared.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Eagle_Rock%2C_Virginia",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "In 1996, the Eagle Rock Community Cultural Center—now the Center for the Arts—was chartered after refurbishing the historic building.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.eaglerockhistory.org/historical-history-60-years/",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The first Eagle Rock Valley Historical Society meeting took place at the Women’s Twentieth Century Clubhouse on October 25, 1961.",
      "sourceSentenceIds": [
        13
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.eaglerockhistory.org/historical-history-60-years/",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The society’s inaugural preservation project declared Eagle Rock City Hall a Historical Cultural Monument, preserving the town’s civic heart.",
      "sourceSentenceIds": [
        17
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.eaglerockhistory.org/historical-history-60-years/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Eagle Rock hosted the last lock of the historic James River and Kanawha Canal, a relic of 19th‑century water transport.",
      "sourceSentenceIds": [
        30
