  "facts": [
    {
      "id": 1,
      "text": "Seba Dalkai means 'Sand Blowing up the Butte' in Navajo, describing winds lifting sand over a local butte.",
      "sourceSentenceIds": [
        7,
        9
      ],
      "sourceLabels": [
        "Web source 1",
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/seba_dalkai_arizona",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "A day school founded in the 1930s grew into a 30‑acre boarding campus, becoming the heart of community life.",
      "sourceSentenceIds": [
        2,
        28
      ],
      "sourceLabels": [
        "Web source 1",
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/seba_dalkai_arizona",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The community sits high in the Navajo Nation, where sparse population and high elevation shape traditional livelihoods.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.wisdomlib.org/cities/seba-dalkai-87607",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Seba Dalkai experiences a cold semi‑arid climate, with hot summers and chilly winters due to its high‑desert setting.",
      "sourceSentenceIds": [
        15
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/seba_dalkai_arizona",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "European‑American contact began in the 1800s with Spanish explorers, later followed by military expeditions during the Navajo Wars.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/seba_dalkai_arizona",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Non‑Navajo settlement appeared only in the early 20th century, after the day school emerged around the 1930s‑40s.",
