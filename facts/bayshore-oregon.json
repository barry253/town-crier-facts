  "facts": [
    {
      "id": 1,
      "text": "Bayshore sits on a peninsula along the Central Oregon Coast, bordered by the Pacific Ocean, Alsea Bay, and the Alsea River.",
      "sourceSentenceIds": [
        7,
        8
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/bayshore_oregon"
    },
    {
      "id": 2,
      "text": "The Alsea people inhabited the area around Bayshore and Alsea Bay for thousands of years prior to European arrival.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/bayshore_oregon"
    },
    {
      "id": 3,
      "text": "Bayshore's protected wetlands and estuaries provide critical habitats for salmon runs, including coho, Chinook, and steelhead.",
      "sourceSentenceIds": [
        16
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/bayshore_oregon"
    },
    {
      "id": 4,
      "text": "Early non-Native settlement in Bayshore emerged in the 1850s following the Donation Land Act of 1850.",
      "sourceSentenceIds": [
        25,
        26
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/bayshore_oregon"
    },
    {
      "id": 5,
      "text": "Bayshore experiences a mild maritime climate with an average annual temperature of 52 degrees Fahrenheit.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/bayshore_oregon"
    },
    {
      "id": 6,
      "text": "Coastal erosion driven by winter storms and El Niño events poses ongoing environmental challenges to the Bayshore shoreline.",
