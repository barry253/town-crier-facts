    {
      "id": 2,
      "text": "The town was once called Kitzmillerville and its settlement dates back before the Civil War.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.visitdeepcreek.com/kitzmiller/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The arrival of the railroad in the 1880s sparked a lumber boom, and coal mining became the mainstay around 1900.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.visitdeepcreek.com/kitzmiller/",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The only remaining historic commercial building is the one‑story Kitzmiller Library with a false front and plate glass windows.",
