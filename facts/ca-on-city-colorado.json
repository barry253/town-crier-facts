  "facts": [
    {
      "id": 1,
      "text": "Cañon City was laid out in 1859 during the Pike's Peak Gold Rush, with its first building erected in February 1860.",
      "sourceSentenceIds": [
        30
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Ca%C3%B1on_City%2C_Colorado",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Originally intended as a commercial hub for mining in South Park and the upper Arkansas River, Cañon City grew around ore deposits.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Ca%C3%B1on_City%2C_Colorado",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Skyline Drive, a scenic route overlooking the city, was built by inmates of the Territorial Prison.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Ca%C3%B1on_City%2C_Colorado",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The tourist line Cañon City and Royal Gorge Railroad still operates on the historic Denver & Rio Grande Western track.",
      "sourceSentenceIds": [
        13
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Ca%C3%B1on_City%2C_Colorado",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "In 1884, William DeWeese discovered the largest known Diplodocus longus skeleton while hunting near Cañon City.",
      "sourceSentenceIds": [
        19
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.canoncity.gov/629/History",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "In 1994, the U.S. Board on Geographic Names officially added the tilde to Cañon City, correcting its spelling.",
