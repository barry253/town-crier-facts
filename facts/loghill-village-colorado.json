  "facts": [
    {
      "id": 1,
      "text": "In 1881, the Ute people were forced to leave Log Hill Mesa, a 350‑mile journey taking them to Utah's Uintah and Ouray Reservation.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/loghill_village_colorado",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "For centuries, the Uncompahgre Ute, also called the Tabeguache, called Log Hill Mesa home before European settlers arrived.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/loghill_village_colorado",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Loghill Village sits atop Log Hill Mesa, about 1,000 feet higher than Ridgway, offering sweeping views of the San Juan Mountains.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Loghill_Village%2C_Colorado",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The mesa is dominated by towering Ponderosa pines, piñon pines, and hardy juniper trees that thrive in its dry climate.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Loghill_Village%2C_Colorado",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "After World War II, developers turned Log Hill Mesa into a residential community, and by 1976 protective covenants guided its growth.",
      "sourceSentenceIds": [
        30
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/loghill_village_colorado",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Residents maintain volunteer‑built, motor‑free paths that link neighborhoods while the community monitors weather and promotes wildfire preparedness.",
      "sourceSentenceIds": [
        21
      ],
      "sourceLabels": [
        "Web source 1"
      ],
