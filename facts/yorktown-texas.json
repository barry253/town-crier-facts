  "facts": [
    {
      "id": 1,
      "text": "Yorktown was founded by Captain John York and Charles Eckhardt and named in honor of York, a noted Indian fighter, in 1854.",
      "sourceSentenceIds": [
        1,
        7
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 2"
      ],
      "source": "https://en.wikipedia.org/wiki/Yorktown%2C_Texas",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town’s historic 1871 Charles Eckhardt store, fully restored, now houses the Yorktown Historical Museum and is listed on the National Register of Historic Places.",
      "sourceSentenceIds": [
        20
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.tshaonline.org/handbook/entries/yorktown-tx",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "By its hundredth anniversary in 1948, Yorktown boasted a small city park complete with a homemade Ferris wheel, tennis court, library, and fire station.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.yorktowntx.com/history/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Yorktown once served as an important relay station for freighters, prairie schooners, and stagecoaches, shortening the former route by twenty miles.",
      "sourceSentenceIds": [
        30
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Yorktown%2C_Texas",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "A historical marker marks the grave of Captain John York, located just seven miles east of town.",
      "sourceSentenceIds": [
        16
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.yorktowntx.com/history/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Yorktown’s Lithuanian community, though assimilated with German immigrants, has attracted researchers from both the United States and Lithuania for its unique cultural heritage.",
