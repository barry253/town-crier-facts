    {
      "id": 1,
      "text": "Lost River earned its name from the nearby Big Lost River that drains the valley.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Lost_River%2C_Idaho"
    },
    {
      "id": 2,
      "text": "The Lost River Valley is flanked by the Lost River Range, a fault‑block chain with escarpments rising over 7,000 feet above the valley floor.",
      "sourceSentenceIds": [
        27
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/lost_river_idaho"
    },
    {
      "id": 3,
      "text": "Borah Peak, Idaho’s highest summit at 12,662 feet, dominates the Lost River Range just west of the town.",
      "sourceSentenceIds": [
        28
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/lost_river_idaho"
    },
    {
      "id": 4,
      "text": "The Big Lost River, born in the Pioneer Mountains, flows north through Lost River, irrigating wetlands along its path.",
      "sourceSentenceIds": [
        29
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/lost_river_idaho"
    },
    {
