  "facts": [
    {
      "id": 1,
      "text": "Fox Chapel’s name comes from early fox sightings and a small chapel that once stood in the area.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.wisdomlib.org/cities/fox-chapel-96977",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The borough officially became independent in 1951, separating from the larger O’Hara Township.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.wisdomlib.org/cities/fox-chapel-96977",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Fox Chapel sits just 6 miles northeast of downtown Pittsburgh, making it a close‑knit suburb.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Fox_Chapel%2C_Pennsylvania",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "In 1915 the historic Pittsburgh Field Club moved to Fox Chapel, and the Fox Chapel Golf Club opened the next year.",
      "sourceSentenceIds": [
        21
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Fox_Chapel%2C_Pennsylvania",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The borough borders Indiana Township, Harmar Township, parts of O’Hara Township, and the Pittsburgh neighborhood of Lincoln–Lemington–Belmar.",
      "sourceSentenceIds": [
        24
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Fox_Chapel%2C_Pennsylvania",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Fox Chapel is known as the wealthiest suburb in Pennsylvania, a title it has held for decades.",
      "sourceSentenceIds": [
