  "facts": [
    {
      "id": 1,
      "text": "Locust Point was renamed in 1846 after the locust trees that lined the peninsula.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Locust_Point%2C_Baltimore",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The peninsula became a coal‑shipping hub when the B&O Railroad built its Locust Point branch line and deep‑water terminal in 1845.",
      "sourceSentenceIds": [
        22
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.tclf.org/locust-point-historic-district",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Fort McHenry, at Locust Point’s tip, was originally called Whetstone Point and served as a port of entry in 1706.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://mylocustpoint.org/history/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "From 1868 to 1914, an immigration station on Andre Street welcomed steamers from Bremen, bringing diverse European families to Baltimore.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://mylocustpoint.org/history/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The German Reformed Church, built in 1887, remains a prominent landmark in Locust Point’s historic district.",
      "sourceSentenceIds": [
        24
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.tclf.org/locust-point-historic-district",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "In 1942, Rallo’s Restaurant opened just outside Fort McHenry’s gates and has been a neighborhood staple ever since.",
      "sourceSentenceIds": [
        12
