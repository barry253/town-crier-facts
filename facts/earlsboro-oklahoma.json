  "facts": [
    {
      "id": 1,
      "text": "Earlsboro is named for James Earls, a local African American barber who served as an orderly during the Civil War.",
      "sourceSentenceIds": [
        5,
        6
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Earlsboro%2C_Oklahoma"
    },
    {
      "id": 2,
      "text": "The town of Earlsboro began in 1891 when the Choctaw Coal and Railway built a line west from the Seminole Nation.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Earlsboro%2C_Oklahoma"
    },
    {
      "id": 3,
      "text": "Earlsboro was once described as the town that whisky built and oil broke.",
      "sourceSentenceIds": [
        23
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Earlsboro%2C_Oklahoma"
    },
    {
      "id": 4,
      "text": "Early Earlsboro boomed because it was located in Oklahoma Territory, where liquor was legal, unlike the neighboring Indian Territory.",
      "sourceSentenceIds": [
        26,
        28
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Earlsboro%2C_Oklahoma"
    },
    {
      "id": 5,
      "text": "The first three businesses established in Earlsboro were saloons, and ninety percent of early merchants sold liquor.",
      "sourceSentenceIds": [
        27
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Earlsboro%2C_Oklahoma"
    },
    {
      "id": 6,
      "text": "Earlsboro once featured a grand theater with one thousand seats and a hotel admired as Oklahoma's fanciest.",
      "sourceSentenceIds": [
        19
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.okhistory.org/publications/enc/entry?entry=EA002"
