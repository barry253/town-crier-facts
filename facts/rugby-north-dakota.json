  "facts": [
    {
      "id": 1,
      "text": "Rugby was founded in 1886 at a junction where a Great Northern spur to Bottineau met the main line.",
      "sourceSentenceIds": [
        5,
        7
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Rugby%2C_North_Dakota"
    },
    {
      "id": 2,
      "text": "The town was originally called Rugby Junction, named after Rugby in Warwickshire, England, to attract settlers.",
      "sourceSentenceIds": [
        1,
        9
      ],
      "sourceLabels": [
        "Web source 1",
        "Wikipedia"
      ],
      "source": "https://www.cityofrugbynd.com/about-us"
    },
    {
      "id": 3,
      "text": "The 1886 Great Northern Railroad Depot now houses the Prairie Village Museum, preserving the city’s earliest buildings.",
      "sourceSentenceIds": [
        2,
        3
      ],
      "sourceLabels": [
        "Wikipedia",
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Rugby%2C_North_Dakota"
    },
    {
      "id": 4,
      "text": "Rugby proudly claims the geographic center of North America, marked by a 15‑foot obelisk erected in 1931.",
      "sourceSentenceIds": [
        20,
        24
      ],
      "sourceLabels": [
        "Wikipedia",
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Rugby%2C_North_Dakota"
    },
    {
      "id": 5,
      "text": "The Victorian Dress Museum building is listed on the National Register of Historic Places, showcasing 19th‑century fashion.",
      "sourceSentenceIds": [
        11
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Rugby%2C_North_Dakota"
    },
    {
      "id": 6,
      "text": "Rugby’s downtown features a historic courthouse built in 1908, also on the National Register of Historic Places.",
