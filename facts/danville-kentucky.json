      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Danville%2C_Kentucky",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Centre College, a historic liberal‑arts institution, was established in Danville in 1819.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Danville%2C_Kentucky",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Danville Theological Seminary began in 1853 and merged with Louisville Presbyterian Theological Seminary in 1901.",
