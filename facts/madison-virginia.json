      "id": 1,
      "text": "Madison was founded in 1793 when the General Assembly formed Madison County from Culpeper County.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.townofmadisonva.com/history",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town is named after James Madison, a key figure in drafting the U.S. Constitution.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.townofmadisonva.com/history",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Madison’s historic courthouse and the Hebron Lutheran Church are listed on the National Register of Historic Places.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Madison%2C_Virginia",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The annual “Taste of the Mountains” festival began in 2008, showcasing local artisans, music, and food.",
