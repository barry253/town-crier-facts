      ],
      "source": "https://www.townofmadisonva.com/history",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "A popular walking tour led by the Madison Historical Society lets visitors explore plaques and stories of the town’s past.",
      "sourceSentenceIds": [
