  "facts": [
    {
      "id": 1,
      "text": "Russell Springs grew around a chalybeate spring resort, and the town was named after Colonel William Russell, the Revolutionary War veteran after whom the county was named.",
      "sourceSentenceIds": [
        1,
        16
      ],
      "sourceLabels": [
        "Web source 2",
        "Wikipedia"
      ],
      "source": "https://grokipedia.com/page/Russell_Springs,_Kentucky",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Samuel Patterson settled the area in the mid‑1800s, and by 1850 the community was known as Big Boiling Springs because of its bubbling mineral waters.",
      "sourceSentenceIds": [
        7,
        5,
        11
      ],
      "sourceLabels": [
        "Web source 1",
        "Web source 2"
      ],
      "source": "https://russellsprings.net/7668-2/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Russell Springs lies just north of Lake Cumberland, a massive man‑made lake created by the Wolf Creek Dam.",
      "sourceSentenceIds": [
        15,
