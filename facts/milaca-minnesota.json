      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Milaca’s name comes from a shortened form of Mille Lacs Lake, the nearby large lake that gives the county’s name.",
      "sourceSentenceIds": [
        18
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
