  "facts": [
    {
      "id": 1,
      "text": "Willis Wharf is famous for whimbrels that pass through on their way to and from southern wintering grounds.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://dwr.virginia.gov/vbwt/sites/willis-wharf/"
    },
    {
      "id": 2,
      "text": "These shorebirds stop for several weeks during migrations in spring (April–May) and fall (July–September).",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://dwr.virginia.gov/vbwt/sites/willis-wharf/"
    },
    {
      "id": 3,
      "text": "At the peak of migration, flocks of several hundred birds may be seen on the tidal flats.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://dwr.virginia.gov/vbwt/sites/willis-wharf/"
    },
    {
      "id": 4,
      "text": "Semipalmated sandpipers are abundant here during their migratory passages, joining the whimbrels and other waders.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://dwr.virginia.gov/vbwt/sites/willis-wharf/"
    },
    {
      "id": 5,
      "text": "For the best birding experience, visit at low tide—starting at least two hours before high tide.",
      "sourceSentenceIds": [
        11
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://dwr.virginia.gov/vbwt/sites/willis-wharf/"
    },
    {
      "id": 6,
      "text": "To date, 217 species have been reported at Willis Wharf, making it a hotspot for birdwatchers.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://dwr.virginia.gov/vbwt/sites/willis-wharf/"
