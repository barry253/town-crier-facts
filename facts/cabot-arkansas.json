    {
      "id": 1,
      "text": "Cabot began in 1873 as a water stop on the Cairo & Fulton Railroad, later becoming the county’s largest city.",
      "sourceSentenceIds": [
        4,
        15,
        6
      ],
      "sourceLabels": [
        "Web source 1",
        "Wikipedia"
      ],
      "source": "https://www.cabotar.gov/465/Cabots-History-and-the-Future",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "A 1976 tornado devastated Cabot’s historic core, but the city rebuilt its downtown and now hosts an annual festival each October.",
      "sourceSentenceIds": [
        17,
        19
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.cabotar.gov/465/Cabots-History-and-the-Future",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The former Central Fire Station, once Cabot City Hall in the 1950s, still stands proudly on Main Street.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.cabotar.gov/465/Cabots-History-and-the-Future",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Cabot’s historic cemetery, one of Arkansas’s few all‑Confederate sites, was moved to Camp Nelson in 1907 and is on the National Register.",
      "sourceSentenceIds": [
        14,
        23
      ],
      "sourceLabels": [
        "Web source 1"
