      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "New industries like breweries, malt factories, and bleaching works fueled Antwerp's rise in the 19th century.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 1"
      ],
