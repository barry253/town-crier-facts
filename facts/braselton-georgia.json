      "id": 1,
      "text": "Braselton takes its name from Harrison Braselton, a modest farmer who married into a wealthy plantation family in the late 1800s.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
