      "id": 1,
      "text": "Fruitland was founded in 1886, its name chosen to honor the apple orchards that soon dotted the valley.",
      "sourceSentenceIds": [
        2,
        18,
        11
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/fruitland_washington",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Moses Peltier opened a general store and blacksmith in 1886, sparking the town’s first post office the next year.",
      "sourceSentenceIds": [
        18
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/fruitland_washington",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Long before Europeans arrived, the Colville, Lake, and Spokane tribes had lived here for thousands of years.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/fruitland_washington",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Fruitland sits along Washington State Route 25, about 26 miles north of Davenport, overlooking the Columbia River.",
      "sourceSentenceIds": [
        14
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/fruitland_washington",
