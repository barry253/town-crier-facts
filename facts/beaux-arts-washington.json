  "facts": [
    {
      "id": 1,
      "text": "Beaux Arts Village began in 1908 as an artists' colony founded by Alfred Renfro, Frank Calvert, and Finn Frolich.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.beauxarts-wa.gov/history",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The first Beaux Arts School opened in 1911 inside a one‑room house just south of the village.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.beauxarts-wa.gov/history",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "A second school followed in 1913, a four‑room house north of the village now housing Enatai Elementary.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.beauxarts-wa.gov/history",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Sailboat racing began in 1967, later becoming the B.A.R.F. club that still races on Lake Washington.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.beauxarts-wa.gov/history",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The town officially incorporated in 1954, becoming one of King County’s smallest municipalities.",
      "sourceSentenceIds": [
        15
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Beaux_Arts_Village%2C_Washington",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "All of Beaux Arts Village’s shoreline belongs to the Western Academy, reserving the Lake Washington beach for residents and guests.",
