  "facts": [
    {
      "id": 1,
      "text": "Fort Totten was named for Brigadier General Joseph Gilbert Totten, the Chief Engineer of the U.S. Army during the Civil War.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://npplan.com/parks-by-state/washington-d-c-national-parks/civil-war-defenses-of-washington-park-at-a-glance/civil-war-defenses-of-washington-fort-totten/",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Construction began in August 1861 and finished by 1863, placing the fort three miles north of the Capitol.",
      "sourceSentenceIds": [
        27,
        30
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.nps.gov/places/fort-totten.htm",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The earthworks still show a 100‑pounder Parrott gun and the walls of two magazines inside the fort.",
      "sourceSentenceIds": [
        4,
        19
      ],
      "sourceLabels": [
        "Web source 2",
        "Wikipedia"
      ],
      "source": "https://npplan.com/parks-by-state/washington-d-c-national-parks/civil-war-defenses-of-washington-park-at-a-glance/civil-war-defenses-of-washington-fort-totten/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "A smaller Totten Battery lies about 1,000 feet north, connected by rifle trenches that are still visible today.",
