  "facts": [
    {
      "id": 1,
      "text": "Barnes began as Elm Grove in 1870 before being renamed in 1876 after A.S. Barnes, a stockholder of the Central Branch Union Pacific Railroad.",
      "sourceSentenceIds": [
        1,
        3,
        4,
        6
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 2"
      ],
      "source": "https://en.wikipedia.org/wiki/Barnes%2C_Kansas",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "In 1939 the WPA built Kansas’s smallest band shell in Barnes’s park, a quirky roadside landmark still visible today.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://washingtoncountyks.gov/our-county/barnes/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Sunflower Mercantile, housed in a 1910 hardware store, has served the community for decades and is open seven days a week by volunteers.",
      "sourceSentenceIds": [
        9,
        10
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://washingtoncountyks.gov/our-county/barnes/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Henry Ober’s first store evolved into a grocery, post office, church, dance hall, and home, reflecting Barnes’s early entrepreneurial spirit.",
      "sourceSentenceIds": [
        15
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://legendsofkansas.com/barnes-kansas/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The Hometown Cafe occupies a historic building that once housed Mike’s Cafe, preserving a slice of Barnes’s culinary heritage.",
