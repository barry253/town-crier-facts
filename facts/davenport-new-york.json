  "facts": [
    {
      "id": 1,
      "text": "Davenport was named after early settler John Davenport, who became the town's first supervisor.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Davenport%2C_New_York"
    },
    {
      "id": 2,
      "text": "The town was formed in 1817 from parts of Kortright and Meredith.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Davenport%2C_New_York"
    },
    {
      "id": 3,
      "text": "The northern town line borders Otsego County in New York state today.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Davenport%2C_New_York"
    },
    {
      "id": 4,
      "text": "Davenport contains four hamlets: Davenport, Davenport Center, West Davenport, and Fergusonville within its borders.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Davenport%2C_New_York"
    },
    {
      "id": 5,
      "text": "Fergusonville sits just north of Davenport village and is noted for its historic roots.",
      "sourceSentenceIds": [
