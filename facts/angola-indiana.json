  "facts": [
    {
      "id": 1,
      "text": "Angola was founded on June 28, 1838 by Thomas Gale and Cornelius Gilmore and became the seat of Steuben County.",
      "sourceSentenceIds": [
        5,
        6
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Angola%2C_Indiana"
    },
    {
      "id": 2,
      "text": "The town’s name comes from Angola, New York, where early settlers had lived before moving west.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Angola%2C_Indiana"
    },
    {
      "id": 3,
      "text": "Angola’s historic core, including the Steuben County Courthouse and Jail, is listed on the National Register of Historic Places.",
      "sourceSentenceIds": [
        22
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Angola%2C_Indiana"
    },
    {
      "id": 4,
      "text": "Lake James and Snow Lake lie just north of town, offering scenic views and popular fishing spots for locals and visitors alike.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://touristplaces.guide/top-10-places-to-visit-in-angola-nature-adventure-and-history/"
    },
    {
      "id": 5,
      "text": "The arrival of the railroad in the late 1800s turned Angola into a regional trade hub and spurred rapid growth.",
      "sourceSentenceIds": [
        13,
        16
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://touristplaces.guide/top-10-places-to-visit-in-angola-nature-adventure-and-history/"
    },
    {
      "id": 6,
      "text": "Angola hosts the annual Steuben County Fair, a long‑standing event that showcases local agriculture and crafts.",
      "sourceSentenceIds": [
