  "facts": [
    {
      "id": 1,
      "text": "Dawn was founded in 1887 by rancher Jim Moore, who built a dugout in the area.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://thebullamarillo.com/dawn-texas/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Jim Parrish opened a general store in 1889 and helped name the area Dawn of Civilization; the name Dawn stuck when the post office opened.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://thebullamarillo.com/dawn-texas/",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "James Askren opened the first school in Dawn in 1891 while also running a broom factory out of a barn.",
      "sourceSentenceIds": [
        5,
        6
      ],
      "sourceLabels": [
        "Web source 1",
        "Web source 2"
      ],
      "source": "https://www.tshaonline.org/handbook/entries/dawn-tx",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "By 1917 Dawn had a lumber company, a community church that later became a Baptist church, and a hotel where a small band played.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.tshaonline.org/handbook/entries/dawn-tx",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Paved roads and better transportation eventually took some of Dawn's older businesses, including its hotel, bank, railroad depot, lumberyard, and flour mill.",
      "sourceSentenceIds": [
        11
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.tshaonline.org/handbook/entries/dawn-tx",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Dawn was the setting for the 1999 direct‑to‑video film “From Dusk Till Dawn 2: Texas Blood Money,” released March 16, 1999.",
