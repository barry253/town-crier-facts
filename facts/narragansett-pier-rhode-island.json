    },
    {
      "id": 2,
      "text": "The Narragansett Pier Railroad opened in 1876, connecting the area to major cities like New York, Boston, and Providence.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Web source 1"
      ],
