      ],
      "source": "https://www.tshaonline.org/handbook/entries/pecan-grove-tx-coryell-county",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Today, Pecan Grove is an affluent residential community in northeastern Fort Bend County, known for its quiet streets and tree‑shaded boulevards.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Web source 1"
      ],
