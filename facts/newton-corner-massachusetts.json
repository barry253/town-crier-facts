  "facts": [
    {
      "id": 1,
      "text": "Newton Corner got its name when the Boston and Worcester Railroad arrived in 1834, and the stop was called Newton Corner.",
      "sourceSentenceIds": [
        13
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.newtonma.gov/government/historic-newton/research/newton-history/villages/newton-corner",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The Meteor, the first train, made the inaugural Boston‑Newton trip at six miles per hour, marking the start of suburban growth.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.newtonma.gov/government/historic-newton/research/newton-history/villages/newton-corner",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "In 1865 Alexander Rice Esty built the Newton Free Library, a landmark that signaled the village’s rising importance.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.newtonma.gov/government/historic-newton/research/newton-history/villages/newton-corner",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The village’s early 1800s saw a surprising number of fledgling factories pop up amid residential streets, showing a mix of industry and transport.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.newtonma.gov/government/historic-newton/research/newton-history/villages/newton-corner",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The Durant‑Kenrick house, built in 1732, and the Jackson Homestead, built in 1760, now serve as historical museums preserving pre‑industrial life.",
      "sourceSentenceIds": [
        26
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.newtoncornerneighborhood.com/newton-history",
      "category": "landmark",
      "quality": "good"
    }
