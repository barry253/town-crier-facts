  "facts": [
    {
      "id": 1,
      "text": "Randlett was named for James Randlett, who served as an Indian agent for the Kiowa and Comanche tribes.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.okhistory.org/publications/enc/entry?entry=RA015"
    },
    {
      "id": 2,
      "text": "Randlett is the only surviving community of the five original townsites established during the 1906 Big Pasture Opening.",
      "sourceSentenceIds": [
        9,
        10
      ],
      "sourceLabels": [
        "Web source 1",
        "Web source 2"
      ],
      "source": "https://www.okhistory.org/publications/enc/entry?entry=RA015"
    },
    {
      "id": 3,
      "text": "The landscape around Randlett consists of flat to gently rolling plains characteristic of southern Oklahoma's Great Plains transition zone.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/randlett_oklahoma"
    },
    {
      "id": 4,
      "text": "Randlett prospered as an agricultural hub despite failing to secure a railroad connection, though a roadbed was graded in the early 1900s.",
      "sourceSentenceIds": [
        6,
        14
      ],
      "sourceLabels": [
        "Web source 1",
        "Web source 2"
      ],
      "source": "https://www.okhistory.org/publications/enc/entry?entry=RA015"
    },
    {
      "id": 5,
      "text": "A brief oil and gas drilling boom occurred in Randlett during the 1910s and 1920s.",
      "sourceSentenceIds": [
        25
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Randlett%2C_Oklahoma"
    },
    {
      "id": 6,
      "text": "Lots in Randlett were sold at a public auction on May 13, 1907, to approximately 4,500 buyers.",
