    },
    {
      "id": 3,
      "text": "Before Arkansas statehood, Bee Branch was called Crossroads and grew from early 19th‑century settlements in the Greasy Valley, famed for its bees and wildlife.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 1"
