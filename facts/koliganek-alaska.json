  "facts": [
    {
      "id": 1,
      "text": "Koliganek is the third village to carry its name along the Nushagak River, founded in the late 19th century.",
      "sourceSentenceIds": [
        6,
        7
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Koliganek%2C_Alaska"
    },
    {
      "id": 2,
      "text": "In 1965 residents moved four miles downstream to the current site, leaving the former village abandoned.",
      "sourceSentenceIds": [
        9,
        3
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Koliganek%2C_Alaska"
    },
    {
      "id": 3,
      "text": "A cemetery and ruins of the old Koliganek still dot the riverbank, echoing its past.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Koliganek%2C_Alaska"
    },
    {
      "id": 4,
      "text": "Koliganek sits on the right shore of the Nushagak River, about 10 to 12 miles from the Nukakuk River.",
      "sourceSentenceIds": [
        23
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.alaska.org/detail/village-of-koliganek"
    },
    {
      "id": 5,
      "text": "A new airstrip lies just one mile east of the village, providing a landing spot for small aircraft.",
