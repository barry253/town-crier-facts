    },
    {
      "id": 3,
      "text": "In 1885 the railroad was put through Temperanceville, ending the era of horse‑carried mail between Pocomoke and Cape Charles.",
      "sourceSentenceIds": [
        4,
        5
      ],
      "sourceLabels": [
        "Web source 1"
