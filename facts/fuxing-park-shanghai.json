      "id": 1,
      "text": "Fuxing Park opened in 1909 as Gujiazhai Park, later known as the French Park, and is Shanghai's only garden preserved in classical French style.",
      "sourceSentenceIds": [
        18,
        17,
        5
      ],
      "sourceLabels": [
        "Web source 1",
        "Web source 1",
        "Web source 2"
      ],
