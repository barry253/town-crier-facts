  "facts": [
    {
      "id": 1,
      "text": "Tanana sits where the Tanana and Yukon Rivers meet, a historic trading spot for Koyukon and Tanana Athabascans before Europeans arrived.",
      "sourceSentenceIds": [
        2,
        6,
        7
      ],
      "sourceLabels": [
