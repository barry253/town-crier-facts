  "facts": [
    {
      "id": 1,
      "text": "Cedar Mills got its name from nearby Cedar Lake, a large body of water just two miles east of town.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Cedar_Mills%2C_Minnesota",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Cedar Mills Township was organized on January 25, 1870, after the village had been founded a decade earlier in 1860.",
      "sourceSentenceIds": [
        1,
        4
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.lakesnwoods.com/CedarMills.htm",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The Cedar Mills post office opened in 1870, shifted from Renville to Meeker County in 1872, closed in 1904, reopened in 1927, and became a rural branch in 1955.",
      "sourceSentenceIds": [
        3,
        14
      ],
      "sourceLabels": [
        "Web source 1",
        "Wikipedia"
      ],
      "source": "https://www.lakesnwoods.com/CedarMills.htm",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The 63‑mile Luce Line State Trail, a former railroad grade, winds through Cedar Mills and offers biking, hiking, and snowmobiling.",
      "sourceSentenceIds": [
        10,
        17
      ],
      "sourceLabels": [
        "Web source 1",
        "Wikipedia"
      ],
      "source": "https://www.lakesnwoods.com/CedarMills.htm",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The South Fork of the Crow River traces Cedar Mills’ southwest edge, flowing southeast toward Hutchinson.",
