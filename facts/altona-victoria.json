  "facts": [
    {
      "id": 1,
      "text": "Altona in Victoria was named by German settler Frederick Taegtow after his hometown Altona, then an independent town outside Hamburg.",
      "sourceSentenceIds": [
        4,
        28
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Altona%2C_Victoria"
    },
    {
      "id": 2,
      "text": "Altona’s first permanent settlement began in 1842 when Alfred Langhorne built The Homestead, marking the town’s birth.",
      "sourceSentenceIds": [
        30
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Altona%2C_Victoria"
    },
    {
      "id": 3,
      "text": "In 1890 a syndicate laid out Altona, built a pier, and extended the railway from Williamstown racecourse, sparking rapid growth.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://alhs.com.au/local-history/timeline/"
    },
    {
      "id": 4,
      "text": "Melbourne & Altona Colliery opened in 1908, and by 1920 the mine ceased, leaving a legacy of brick and tile works.",
      "sourceSentenceIds": [
        1,
        6
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://alhs.com.au/local-history/timeline/"
    },
    {
      "id": 5,
      "text": "Altona Beach is one of only two swimming beaches in Melbourne’s western suburbs, offering a rare coastal escape amid industrial surroundings.",
      "sourceSentenceIds": [
        27
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Altona%2C_Victoria"
    },
    {
      "id": 6,
      "text": "The Altona Public Library, opened in 1965, houses the Environmental Resources Centre, a hub for local ecological research.",
