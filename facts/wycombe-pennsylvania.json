  "facts": [
    {
      "id": 1,
      "text": "Wycombe began in the 1890s when the Pennsylvania Northeastern Railroad opened a line through the area, originally called Lingohocken.",
      "sourceSentenceIds": [
        2,
        1
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Wycombe%2C_Pennsylvania",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town’s post office was renamed Wycombe to avoid confusion with Wingohocken, keeping the historic name Lingohocken for the local fire company.",
      "sourceSentenceIds": [
        4,
        21,
        30
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Wycombe%2C_Pennsylvania",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Wycombe is an unincorporated community mainly in Wrightstown Township, with a small part in Buckingham Township, Bucks County.",
      "sourceSentenceIds": [
        20,
        27
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Wycombe%2C_Pennsylvania",
      "category": "other",
      "quality": "poor",
      "qualityReason": "other"
    },
    {
      "id": 4,
      "text": "Several sites in and around Wycombe, including the John Lacey Homestead and the Wycombe Village Historic District, are listed on the National Register of Historic Places.",
      "sourceSentenceIds": [
        24,
        10
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Wycombe%2C_Pennsylvania",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Wycombe’s historic streets and preserved architecture give the village a timeless, small‑town charm that attracts families and real‑estate seekers alike.",
