  "facts": [
    {
      "id": 1,
      "text": "Cornwall was founded by Peter Grubb in 1734 after he found iron ore, leading to the first Cornwall Iron Furnace in 1742.",
      "sourceSentenceIds": [
        15,
        2,
        25
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Cornwall%2C_Pennsylvania"
    },
    {
      "id": 2,
      "text": "The Cornwall Iron Mine operated for 236 years, closing June 30, 1973, making it one of the longest continuous open‑pit mines worldwide.",
      "sourceSentenceIds": [
        20,
        21
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Cornwall%2C_Pennsylvania"
    },
    {
      "id": 3,
      "text": "In 1932 the Coleman family deeded the Cornwall Iron Furnace to Pennsylvania, and it now stands as a National Historic Landmark open to visitors.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Cornwall%2C_Pennsylvania"
    },
    {
      "id": 4,
      "text": "A railroad was built to haul Cornwall’s iron to the Union Canal, and today the former rail line is the Lebanon Valley Rail Trail.",
      "sourceSentenceIds": [
        8,
        9
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://visitlebanonvalley.com/cornwall/"
    },
    {
      "id": 5,
      "text": "Cornwall incorporated as a borough on October 11, 1926, after shifting between Lancaster, Dauphin, and Lebanon counties.",
      "sourceSentenceIds": [
        27
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Cornwall%2C_Pennsylvania"
    },
    {
      "id": 6,
      "text": "The town’s name honors Peter Grubb’s English birthplace, Cornwall, reflecting his heritage in the 18th‑century settlement.",
      "sourceSentenceIds": [
        2
