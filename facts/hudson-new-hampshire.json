    {
      "id": 1,
      "text": "Hudson’s Hills Memorial Library, a National Register landmark, closed in 2009 and now sits empty while its books travel to the Rodgers Memorial Library.",
      "sourceSentenceIds": [
        1,
        6
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Hudson%2C_New_Hampshire",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The Hudson Historical Society calls the Alvirne Hills House on Derry Road its home, a National Register building that once served as a family vacation spot.",
      "sourceSentenceIds": [
        8,
        20,
        21
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://hudsonnhhistorical.com/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Hudson once had two historic centers, with the original village on Library Street and Hudson Center at a five‑way junction of Route 111 and Greeley Street.",
      "sourceSentenceIds": [
        9,
        10
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Hudson%2C_New_Hampshire",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Hudson’s Town Hall still stands, even though the main police station has moved to an industrial park off Route 111.",
      "sourceSentenceIds": [
        26
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Hudson%2C_New_Hampshire",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Every Christmas, Hudson’s Town Common displays large toy soldiers and other festive decorations at the intersection of Derry, Ferry, and Library streets.",
      "sourceSentenceIds": [
        27
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Hudson%2C_New_Hampshire",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The Kimball Webster School, once a classroom hub, now houses the town superintendent’s office while the Library Street School continues its educational role.",
