  "facts": [
    {
      "id": 1,
      "text": "Walkerville was named after the Walker brothers—Joseph, Samuel, Matthew, and David—who bought the Alice silver mine in 1876.",
      "sourceSentenceIds": [
        1,
        6
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 2"
      ],
      "source": "https://en.wikipedia.org/wiki/Walkerville%2C_Montana"
    },
    {
      "id": 2,
      "text": "Rollo Butcher built Walkerville’s first house in 1877, becoming the town’s first permanent resident.",
      "sourceSentenceIds": [
        2,
        4
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Walkerville%2C_Montana"
    },
    {
      "id": 3,
      "text": "Daly Street honors Marcus Daly, the former manager of the Alice Mine who led the town’s early mining boom.",
      "sourceSentenceIds": [
        4,
        8
      ],
      "sourceLabels": [
        "Web source 1",
        "Web source 2"
      ],
      "source": "https://www.mtmemory.org/nodes/view/128312"
    },
    {
      "id": 4,
      "text": "Walkerville sits at 6,309 feet above sea level, making it Montana’s highest incorporated town.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.mtmemory.org/nodes/view/128312"
    },
    {
      "id": 5,
      "text": "Walkerville lies within the Butte‑Anaconda National Historic Landmark District, a testament to the region’s mining heritage.",
      "sourceSentenceIds": [
        14
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://roamingmontana.com/walkerville/"
    },
    {
      "id": 6,
      "text": "In 1878, workers at the Alice Mine staged a protest that restored their wages, marking the first union victory in Butte’s history.",
