      "id": 1,
      "text": "Westboro’s name was selected by railroad officials when the town was established in the late 19th century.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Westboro%2C_Missouri",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Westboro was laid out in 1881, officially incorporated in 1882, and quickly became a local hub for travelers.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Westboro%2C_Missouri",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "A post office has been in operation at Westboro since 1881, serving the community for over a century.",
      "sourceSentenceIds": [
        11
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Westboro%2C_Missouri",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Missouri Routes C and O run through Westboro, with Middle Tarkio Creek flowing east of town.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Westboro%2C_Missouri",
      "category": "transport",
      "quality": "poor",
      "qualityReason": "route_only"
    },
    {
      "id": 5,
      "text": "Westboro sits in Lincoln Township within Atchison County, placing it in the northernmost part of Missouri.",
