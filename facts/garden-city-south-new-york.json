        10
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Garden_City_South%2C_New_York",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The area is an unincorporated community governed directly by the Town of Hempstead, whose seat is in the Village of Hempstead.",
      "sourceSentenceIds": [
        18
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Garden_City_South%2C_New_York",
      "category": "other",
      "quality": "poor",
      "qualityReason": "other"
    },
    {
      "id": 3,
      "text": "Textile merchant Alexander Turney Stewart bought 7,000 acres in 1869 to create one of the nation's first planned communities.",
      "sourceSentenceIds": [
        30
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.britannica.com/place/Garden-City-New-York",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Adelphi University, founded in Brooklyn in 1896, moved its campus to Garden City in 1929.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.britannica.com/place/Garden-City-New-York",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Nassau Community College, established in 1959, is part of the State University of New York system and sits in Garden City.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.britannica.com/place/Garden-City-New-York",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The Garden City Historical Society, founded in 1975, preserves the town's heritage and hosts annual scholarship awards for local students.",
