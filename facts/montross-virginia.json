  "facts": [
    {
      "id": 1,
      "text": "Until 1752, Montross was known as Westmoreland Courthouse, a name that honored the county it serves.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.townofmontross.org/"
    },
    {
      "id": 2,
      "text": "The Westmoreland County Museum, opened in 1941, was the first museum to open regularly on Virginia’s Northern Neck.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.westmorelandcountymuseum.org/the-original-museum"
    },
    {
      "id": 3,
      "text": "Stratford Hall, a National Historic Landmark, preserves the Lee family legacy and sits just outside Montross.",
      "sourceSentenceIds": [
        5,
        6
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Montross%2C_Virginia"
    },
    {
      "id": 4,
      "text": "In 1774 a resolution at Montross’s courthouse pledged aid to Boston during the British blockade, linking the town to the Revolution.",
      "sourceSentenceIds": [
        16
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Montross%2C_Virginia"
    },
    {
      "id": 5,
      "text": "Montross, the county seat, houses the historic Old Westmoreland Court House where the 1775 gunpowder seizure plan was forged.",
      "sourceSentenceIds": [
        19,
        22,
        23
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Montross%2C_Virginia"
    },
    {
      "id": 6,
      "text": "The town’s slogan, “Return to the Village,” echoes its commitment to preserving historic charm.",
