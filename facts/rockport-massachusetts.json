  "facts": [
    {
      "id": 1,
      "text": "Rockport is a seaside town in Essex County, located about 40 miles northeast of Boston at the tip of Cape Ann peninsula.",
      "sourceSentenceIds": [
        23,
        24
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Rockport%2C_Massachusetts",
      "category": "other",
      "quality": "poor",
      "qualityReason": "location_description"
    },
    {
      "id": 2,
      "text": "The town’s granite quarries once supplied stone for ships and later became a hub for immigrant workers, including Finns who fought for rights in the 1890s.",
      "sourceSentenceIds": [
        30,
        7,
        12
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Rockport%2C_Massachusetts",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "In 1605, Samuel de Champlain named the peninsula 'Cap Aux Isles,' and his expedition may have briefly landed there.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Rockport%2C_Massachusetts",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Rockport’s art colony, founded in 1921, is one of the oldest in America and hosts over thirty galleries today.",
      "sourceSentenceIds": [
        5,
        15
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Rockport%2C_Massachusetts",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The historic Dogtown Common, an abandoned inland settlement on Cape Ann, is now protected in perpetuity.",
      "sourceSentenceIds": [
        13
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Rockport%2C_Massachusetts",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "In 1933, Rockport won first place in a float competition among 200 floats, a local tradition that still echoes in community celebrations.",
