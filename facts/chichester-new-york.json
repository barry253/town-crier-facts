  "facts": [
    {
      "id": 1,
      "text": "Chichester was founded in 1863 by brothers Frank and Lemuel Chichester, sons of contractor Samuel Chichester.",
      "sourceSentenceIds": [
        3,
        12,
        13
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Chichester%2C_New_York"
    },
    {
      "id": 2,
      "text": "The hamlet grew around a chair factory that produced chairs and cradles exported worldwide before closing in 1939.",
      "sourceSentenceIds": [
        1,
        6,
        19
      ],
      "sourceLabels": [
        "Web source 1",
        "Wikipedia"
      ],
      "source": "https://grokipedia.com/page/chichester_new_york"
    },
    {
      "id": 3,
      "text": "A narrow‑gauge Stony Clove and Catskill Mountain Railroad was built in 1881 to move timber and finished furniture, linking Chichester to the Ulster and Delaware Railroad.",
      "sourceSentenceIds": [
        7,
        8
      ],
      "sourceLabels": [
        "Web source 1",
        "Wikipedia"
      ],
      "source": "https://grokipedia.com/page/chichester_new_york"
    },
    {
      "id": 4,
      "text": "Workers lived in company‑built houses and were paid with scrip redeemable only at the factory’s general store.",
      "sourceSentenceIds": [
        16,
        23
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Chichester%2C_New_York"
    },
    {
      "id": 5,
      "text": "The factory was later bought by William O. Schwarzwaelder, who sold the entire village in 1939, ending the company town era.",
      "sourceSentenceIds": [
        17,
        24,
        26
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Chichester%2C_New_York"
    },
    {
      "id": 6,
      "text": "The name Chichester is pronounced with an “eye” sound, not like “chip,” a quirk noted by locals.",
