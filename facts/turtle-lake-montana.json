  "facts": [
    {
      "id": 1,
      "text": "Turtle Lake’s name comes from the Salish word čɫqq̓liʔ, meaning 'turtle,' a symbol of longevity and protection in local tribal lore.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/turtle_lake_montana",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The 49‑acre reservoir, created by the 1931‑32 Turtle Lake Dam, holds 899 acre‑feet of water for the Flathead Irrigation Project.",
      "sourceSentenceIds": [
        23
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/turtle_lake_montana",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "At 3,097 feet elevation, the lake supports a Montana Fish, Wildlife & Parks fishery that stocks native westslope cutthroat trout.",
      "sourceSentenceIds": [
        19
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/turtle_lake_montana",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Seasonal wetlands around Turtle Lake create diverse habitats, boosting local biodiversity with aquatic and avian species across the Flathead Valley.",
      "sourceSentenceIds": [
        29
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/turtle_lake_montana",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Average temperatures swing from 18°F in January to 84°F in July, with nearby Flathead Lake moderating extremes.",
      "sourceSentenceIds": [
        27
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/turtle_lake_montana",
