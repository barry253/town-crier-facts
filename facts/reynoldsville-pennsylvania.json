  "facts": [
    {
      "id": 1,
      "text": "Reynoldsville was originally called Winslow Township and was renamed after local postmaster Thomas Reynolds in 1850.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Reynoldsville%2C_Pennsylvania",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The Herpel Brothers Foundry and Machine Shop, a historic industrial site, earned a spot on the National Register of Historic Places in 2004.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Reynoldsville%2C_Pennsylvania",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The Reynoldsville Historical Society, located on Main Street, preserves the borough’s industrial heritage through a museum and archival collections.",
      "sourceSentenceIds": [
        2,
        7,
        9
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://lumberheritage.org/resources/historical-societies/reynoldsville-historical-society/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Reynoldsville sits in the valley of Sandy Lick Creek, where the creek meets Soldier Run, and the watershed eventually feeds the Ohio River.",
      "sourceSentenceIds": [
        15,
        18
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Reynoldsville%2C_Pennsylvania",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Route 322, known locally as Main Street, runs through Reynoldsville and connects it to Brookville and Luthersburg, reflecting its historic role as a trade corridor.",
      "sourceSentenceIds": [
        16
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
