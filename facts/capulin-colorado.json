    },
    {
      "id": 2,
      "text": "The town’s name comes from the Spanish word for chokecherry, a local fruit.",
      "sourceSentenceIds": [
        10,
        18
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Capulin%2C_Colorado"
    },
    {
      "id": 3,
      "text": "Capulin Volcano National Monument sits just south of town, its crater visible from the highway.",
      "sourceSentenceIds": [
        7,
        8
      ],
      "sourceLabels": [
        "Web source 2",
        "Web source 2"
      ],
      "source": "https://home.nps.gov/cavo/learn/historyculture/index.htm"
    },
    {
      "id": 4,
      "text": "In the 19th century, the Santa Fe Trail was rerouted to skirt Capulin Volcano, creating a military freight route to Fort Union.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://home.nps.gov/cavo/learn/historyculture/index.htm"
    },
    {
      "id": 5,
      "text": "The Capulin post office opened on August 10, 1881, marking the town’s growing permanence.",
      "sourceSentenceIds": [
        11
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Capulin%2C_Colorado"
    },
    {
      "id": 6,
      "text": "Paleoindians hunted bison near Capulin Volcano as early as ten thousand years ago, evidenced by the Folsom Man site.",
