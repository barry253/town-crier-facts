  "facts": [
    {
      "id": 1,
      "text": "Kasaan’s name comes from the Tlingit word Kasaʼaan, meaning 'pretty town' in the local language.",
      "sourceSentenceIds": [
        13
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Kasaan%2C_Alaska",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "In 1901, Kasaan leaders moved the village closer to a copper mine after being persuaded by the Kasaan Bay Mining Company.",
      "sourceSentenceIds": [
        23
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Kasaan%2C_Alaska",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Old Kasaan was abandoned by 1904, and its remains were partly destroyed by fire in 1915.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Kasaan%2C_Alaska",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "In 1938, five historic and three replica totem poles were moved to New Kasaan.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Kasaan%2C_Alaska",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Old Kasaan was declared a national monument in 1916 but was later removed from the National Park System in 1955.",
      "sourceSentenceIds": [
        26,
        27
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Kasaan%2C_Alaska",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Kasaan is the northernmost Haida settlement and a main historical community of the Kaigani Haida.",
