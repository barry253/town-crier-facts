  "facts": [
    {
      "id": 1,
      "text": "Hydetown was first settled by Peter Titus in 1793 and officially incorporated in 1868.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.hydetownboroughpa.org/"
    },
    {
      "id": 2,
      "text": "The borough’s name changed from Oil Creek Borough to Hydetown after early settlers like the Titus brothers chose the area.",
      "sourceSentenceIds": [
        29
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.hydetownboroughpa.org/"
    },
    {
      "id": 3,
      "text": "Hydetown sits just south of the southern terminal moraine, marking the edge of glaciation in northwestern Pennsylvania.",
      "sourceSentenceIds": [
        13
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Hydetown%2C_Pennsylvania"
    },
    {
      "id": 4,
      "text": "Oil Creek, a tributary of the Allegheny River, drains the borough and flows south out of Hydetown at its lowest point.",
      "sourceSentenceIds": [
        14
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Hydetown%2C_Pennsylvania"
    },
    {
      "id": 5,
      "text": "In 1846, Elijah Hyde and his sons opened the town’s first store after purchasing Titus Mills.",
      "sourceSentenceIds": [
        28
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.hydetownboroughpa.org/"
    },
    {
      "id": 6,
      "text": "Hydetown became a Pennsylvania Broadband Development Authority designated Broadband Ready Community in February 2025.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.hydetownboroughpa.org/"
    }
  ]
