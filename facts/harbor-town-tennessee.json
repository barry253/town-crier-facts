  "facts": [
    {
      "id": 1,
      "text": "Harbor Town sits atop 132 acres on a sandbar in the Mississippi River known as Mud Island.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Harbor_Town%2C_Memphis",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Developed in 1989 by Henry Turley, RTKL, and Looney Ricks Kiss, Harbor Town was built to emphasize people over cars.",
      "sourceSentenceIds": [
        3,
        4
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Harbor_Town%2C_Memphis",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Before 1988, the area was an undeveloped sandbar; Memphis once planned to extend I‑240 there, but the developer opposed it.",
      "sourceSentenceIds": [
        5,
        6
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Harbor_Town%2C_Memphis",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "In May 2011, a 5‑foot emergency levee was erected after the river rose to 48 feet, protecting Harbor Town from flooding.",
      "sourceSentenceIds": [
        9,
        10
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Harbor_Town%2C_Memphis",
      "category": "other",
      "quality": "poor",
      "qualityReason": "vague"
    },
    {
      "id": 5,
      "text": "Harbor Town’s tree‑lined streets connect residents to paved trails, public parks, and playgrounds, making it a walkable community ideal for neighbor interaction.",
      "sourceSentenceIds": [
        28
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://memphis.stjude.org/neighborhoods/downtown/harbor-town.html",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Harbor Town now hosts over 3,000 residents, many working at St. Jude Children’s Research Hospital, and serves as a national New Urbanism case study.",
