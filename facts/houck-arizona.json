  "facts": [
    {
      "id": 1,
      "text": "Houck was founded by a mail carrier who worked the route from Prescott to Fort Wingate.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Houck%2C_Arizona",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town grew when the Atlantic & Pacific Railroad extended tracks along the Rio Puerco in the early 1880s, bringing more settlers.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.theroute-66.com/houck.html",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "A replica of the 1960s TV series F‑Troop, called Fort Courage, once drew tourists along Route 66.",
      "sourceSentenceIds": [
        13,
        14
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 2"
      ],
      "source": "https://en.wikipedia.org/wiki/Houck%2C_Arizona",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Houck hosts the Native American Baha'i Institute, a unique cultural center that celebrates spiritual diversity.",
      "sourceSentenceIds": [
        18
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Houck%2C_Arizona",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Just south of Houck lies the Allentown Bridge, listed on the National Register of Historic Places.",
      "sourceSentenceIds": [
        11,
        12
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.legendsofamerica.com/houck-arizona/",
      "category": "landmark",
      "quality": "good"
    },
    {
