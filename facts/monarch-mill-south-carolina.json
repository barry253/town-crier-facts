  "facts": [
    {
      "id": 1,
      "text": "John A. Fant founded Monarch Mill in 1900 as a planned cotton textile mill village just east of Union.",
      "sourceSentenceIds": [
        23,
        24
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/monarch_mill_south_carolina"
    },
    {
      "id": 2,
      "text": "Monarch Mill originally featured a self-contained village with core mill buildings and modest housing for its workforce.",
      "sourceSentenceIds": [
        25
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/monarch_mill_south_carolina"
    },
    {
      "id": 3,
      "text": "In 1918, the mill merged with Lockhart Cotton Mills to form the Monarch Mills corporation to streamline regional operations.",
      "sourceSentenceIds": [
        28
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/monarch_mill_south_carolina"
    },
    {
      "id": 4,
      "text": "The textile sector in this region reached its peak during the 1920s and 1940s due to World War Two demands.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/monarch_mill_south_carolina"
    },
    {
      "id": 5,
      "text": "Monarch Mill later became part of the major textile firm Milliken and Company under the ownership of Roger Milliken.",
      "sourceSentenceIds": [
        30
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/monarch_mill_south_carolina"
    },
    {
      "id": 6,
      "text": "Monarch Mill now maintains a quiet, suburban character in the rolling hills of the Southeast.",
      "sourceSentenceIds": [
        17
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/monarch_mill_south_carolina"
