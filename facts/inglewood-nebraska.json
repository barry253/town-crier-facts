  "facts": [
    {
      "id": 1,
      "text": "Inglewood was platted in 1918 and named after Inglewood, California, by early settlers.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Inglewood%2C_Nebraska"
    },
    {
      "id": 2,
      "text": "The village's fertile soil once supported truck farming of watermelons, cantaloupes, asparagus, and sweet potatoes shipped to larger markets.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/inglewood_nebraska"
    },
    {
      "id": 3,
      "text": "A protective dike built in 1912 after frequent floods now marks Inglewood's southern boundary.",
      "sourceSentenceIds": [
        30
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/inglewood_nebraska"
    },
    {
      "id": 4,
      "text": "Before modern roads, wagons crossed the Platte River using horse‑powered cables, a two‑day journey.",
      "sourceSentenceIds": [
        29
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/inglewood_nebraska"
    },
    {
      "id": 5,
      "text": "Haurigan, an early resident, capitalized on the region's agriculture by shipping produce via rail to larger markets.",
      "sourceSentenceIds": [
        28
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/inglewood_nebraska"
    },
    {
      "id": 6,
      "text": "Inglewood spans just 0.31 square miles and sits at an elevation of about 1,115 feet.",
