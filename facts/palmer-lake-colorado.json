      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town’s name honors its founder, a Civil War veteran who also started the Denver & Rio Grande Railroad.",
      "sourceSentenceIds": [
        20
      ],
      "sourceLabels": [
