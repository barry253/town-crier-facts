  "facts": [
    {
      "id": 1,
      "text": "Moxee Valley’s original name, MOOK-SEE, comes from the Yakama word meaning “land of the tules.”.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://cityofmoxee.us/living-in-moxee/history-of-moxee/",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Hops first arrived in the valley in the late 1800s, and a metal hop sculpture now stands in Moxee City Park to honor that legacy.",
      "sourceSentenceIds": [
        10,
        14
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://cityofmoxee.us/living-in-moxee/history-of-moxee/",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The Moxee Hop Festival, celebrating hop farming, has been held every year since 1923.",
      "sourceSentenceIds": [
        20
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://beckdc.com/historical-places-in-moxee/",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The historic Carbonneau Mansion, a social hub since the early 1900s, remains a landmark in Moxee.",
      "sourceSentenceIds": [
        4,
        17
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://beckdc.com/historical-places-in-moxee/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Moxee School, a brick building erected in the early 1900s, has served the community for generations.",
      "sourceSentenceIds": [
        21
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://beckdc.com/historical-places-in-moxee/",
      "category": "landmark",
      "quality": "good"
    },
    {
