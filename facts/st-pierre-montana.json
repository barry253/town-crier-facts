  "facts": [
    {
      "id": 1,
      "text": "St. Pierre grew from 1888 encampments of Cree refugees and landless Chippewa who fled treaties, forming the community that now sits on former Fort Assiniboine.",
      "sourceSentenceIds": [
        4,
        30
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/st_pierre_montana",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The community celebrates Chippewa Cree heritage each year with the Rocky Boy's Pow Wow, drawing visitors from across the reservation.",
      "sourceSentenceIds": [
        29
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/st_pierre_montana"
    },
    {
      "id": 4,
      "text": "St. Pierre’s economy relies on tribal government services, agriculture, livestock, and modest natural resource projects, with jobs from the Bureau of Indian Affairs and local schools.",
      "sourceSentenceIds": [
        27
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/st_pierre_montana"
    },
    {
      "id": 5,
      "text": "The town’s site was chosen after Indian Affairs investigated and recommended settling landless Chippewa Cree at the abandoned Fort Assiniboine in the Bear Paw Mountains.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/st_pierre_montana"
    },
    {
      "id": 6,
      "text": "About 88% of adults in St. Pierre hold a high school diploma, while only 12% have a bachelor’s degree, reflecting the community’s educational challenges.",
      "sourceSentenceIds": [
        26
