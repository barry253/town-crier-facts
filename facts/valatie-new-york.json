  "facts": [
    {
      "id": 1,
      "text": "Valatie’s name comes from the Dutch word “Vaaltje,” meaning little falls, a nod to the waterfalls that once powered nine cotton mills.",
      "sourceSentenceIds": [
        1,
        3,
        23
      ],
      "sourceLabels": [
        "Web source 1",
        "Wikipedia"
      ],
      "source": "https://www.valatievillage.com/history",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The village’s first post office opened in 1832, marking the start of Valatie’s long‑standing role as a local hub.",
      "sourceSentenceIds": [
        22
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Valatie%2C_New_York",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Valatie’s Main Street is famous for its three waterfalls—Valatie Kill Falls, Beaver Mill Falls, and Kinderhook Creek—each a historic landmark.",
      "sourceSentenceIds": [
        30
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Valatie%2C_New_York",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "In 1946, fifteen village veterans founded the first Santa Claus Club in the United States, a tradition that still brings holiday cheer to Valatie.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Valatie%2C_New_York",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The village’s Opera House began as a Presbyterian church in 1835 before becoming a public hall, reflecting Valatie’s adaptive reuse of historic buildings.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.valatievillage.com/history",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Harry Houdini filmed scenes of his last movie, “Haldane of the Secret Service,” at the base of Beaver Kill Falls in 1921, linking Valatie to early Hollywood history.",
      "sourceSentenceIds": [
