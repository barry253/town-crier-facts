  "facts": [
    {
      "id": 1,
      "text": "Fish Springs gets its name from natural springs in Fish Spring Flat, a high‑desert valley at about 5,200 feet elevation.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/fish_springs_nevada"
    },
    {
      "id": 2,
      "text": "The original spring near cottonwood trees east of the fire station supplied steady water, sustaining fish and early settlers.",
      "sourceSentenceIds": [
        11
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/fish_springs_nevada"
    },
    {
      "id": 3,
      "text": "Fish Springs sits 7 miles east of Minden on the east side of Carson Valley, surrounded by rolling hills and the Pine Nut Mountains.",
      "sourceSentenceIds": [
        5,
        19
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Fish_Springs%2C_Nevada"
    },
    {
      "id": 4,
      "text": "Basque sheepherders were key in early 20th‑century ranching, grazing flocks across the high‑desert valley of Fish Springs.",
      "sourceSentenceIds": [
        13
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/fish_springs_nevada"
    },
    {
      "id": 5,
      "text": "Today Fish Springs is known for its tight‑knit rural lifestyle, horse properties, and stunning mountain views, preserving open spaces.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/fish_springs_nevada"
    },
    {
      "id": 6,
      "text": "Fish Springs hosts a small herd of wild horses, managed by the U.S. Forest Service.",
