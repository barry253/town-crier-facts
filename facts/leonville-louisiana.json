  "facts": [
    {
      "id": 1,
      "text": "Leonville was named after its first pastor, Father Leon Mailluchet, who built the town’s first church in 1898.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://cajuntravel.com/destinations/leonville/"
    },
    {
      "id": 2,
      "text": "Leonville was founded as a settlement of free men of color, or gens de couleur libres, along Bayou Teche.",
      "sourceSentenceIds": [
        21
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://cajuntravel.com/destinations/leonville/"
    },
    {
      "id": 3,
      "text": "The town’s distinctive church tower was built by Father Eugene Livorel between 1907 and 1916.",
      "sourceSentenceIds": [
        22
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://cajuntravel.com/destinations/leonville/"
    },
    {
      "id": 4,
      "text": "The church’s attic still features stained‑glass panels from its time as a house‑church.",
      "sourceSentenceIds": [
        23
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://cajuntravel.com/destinations/leonville/"
    },
    {
      "id": 5,
      "text": "Leonville is famed for its boudin and one of Acadiana’s best king cakes.",
      "sourceSentenceIds": [
        24
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://cajuntravel.com/destinations/leonville/"
    },
    {
      "id": 6,
      "text": "Leonville hosts zydeco trail rides, a weekend festival of music, food, camping, and horsemanship.",
      "sourceSentenceIds": [
        26
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://cajuntravel.com/destinations/leonville/"
    }
  ]
