  "facts": [
    {
      "id": 1,
      "text": "Greenbelt was officially named in 1936 when the Resettlement Administration began construction, about eight miles north of Washington.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Greenbelt%2C_Maryland",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Greenbelt’s original core, called Old Greenbelt, earned National Historic Landmark District status in 1997, preserving its New Deal architecture.",
      "sourceSentenceIds": [
        9,
        11
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Greenbelt%2C_Maryland",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The city’s Roosevelt Center houses the historic Old Greenbelt Theatre and the Greenbelt Arts Center, a former bowling alley turned gallery.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Greenbelt%2C_Maryland",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Greenbelt was the prototype for later planned communities like Reston and Columbia, earning a spot in urban‑planning history.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Greenbelt%2C_Maryland",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Applicants for the 1930s community had to be married couples earning $800–$2,200 a year, with the husband employed, to qualify for residency.",
      "sourceSentenceIds": [
        17
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.greenbeltmuseum.org/greenbelt-history",
      "category": "other",
      "quality": "poor",
      "qualityReason": "vague"
    },
    {
      "id": 6,
      "text": "The 1939 documentary “The City” captured Greenbelt’s New Deal experiment, making it one of the first filmed planned towns.",
      "sourceSentenceIds": [
        23
