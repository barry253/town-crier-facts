      "category": "nature",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The village’s waterfront homes and boating culture draw anglers, kayakers, and festival‑goers every season.",
      "sourceSentenceIds": [
        18
      ],
      "sourceLabels": [
        "Web source 1"
      ],
