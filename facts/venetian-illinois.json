      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Four lakes—Sand Lake, Slough Lake, Miltmore Lake, and Fourth Lake—border the village, giving it a true waterfront feel.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
