  "facts": [
    {
      "id": 1,
      "text": "Castleton Corners takes its name from Thomas Dongan’s Irish hometown Cassiltowne, echoing the original town name Castleton.",
      "sourceSentenceIds": [
        11,
        18
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/castleton_corners_staten_island",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The neighborhood’s “Corners” refers to the historic intersection of Victory Boulevard, Manor Road, and Slosson Avenue, a key crossroads since the 19th century.",
      "sourceSentenceIds": [
        5,
        6,
        16
      ],
      "sourceLabels": [
        "Web source 1",
        "Web source 2"
      ],
      "source": "https://www.cityneighborhoods.nyc/castleton-corners",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Teresa’s Roman Catholic Church, founded in 1926, boasts a bell tower visible from the surrounding hills.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.cityneighborhoods.nyc/castleton-corners",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The New York State Armory at 321 Manor Road, built 1926‑27, sits on the former estate of a Civil War hero.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/castleton_corners_staten_island",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "In the 18th century, Castleton Corners was fertile farmland, with inns and taverns serving travelers along the Richmond Turnpike.",
