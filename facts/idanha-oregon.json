    },
    {
      "id": 2,
      "text": "The North Santiam River corridor was used by the Santiam Kalapuya for travel, food gathering, and trade.",
      "sourceSentenceIds": [
        3,
        28
      ],
      "sourceLabels": [
        "Wikipedia",
