  "facts": [
    {
      "id": 1,
      "text": "Soldiers Grove was first settled in 1856 by Joseph Brightman, who established a sawmill to process logs from the Kickapoo River.",
      "sourceSentenceIds": [
        10,
        11
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Soldiers_Grove%2C_Wisconsin"
    },
    {
      "id": 2,
      "text": "Originally called Pine Grove, the village was renamed Soldiers Grove to honor troops who camped here during the Black Hawk War.",
      "sourceSentenceIds": [
        2,
        12
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Soldiers_Grove%2C_Wisconsin"
    },
    {
      "id": 3,
      "text": "The arrival of the railroad in 1892 brought a depot, stock yards, and a tobacco warehouse to the community.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://soldiersgrove.municipalimpact.com/the-early-years"
    },
    {
      "id": 4,
      "text": "Frequent flooding along the Kickapoo River eventually led the village to relocate its downtown area to a new site.",
      "sourceSentenceIds": [
        14,
        24
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Soldiers_Grove%2C_Wisconsin"
    },
    {
      "id": 5,
      "text": "Soldiers Grove once required all new commercial buildings to obtain at least fifty percent of their heat from solar energy.",
      "sourceSentenceIds": [
        28
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Soldiers_Grove%2C_Wisconsin"
    },
    {
      "id": 6,
      "text": "A local ordinance in Soldiers Grove prohibited any new structure from blocking sunlight to another building to support solar heating.",
      "sourceSentenceIds": [
        29
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Soldiers_Grove%2C_Wisconsin"
    }
  ]
