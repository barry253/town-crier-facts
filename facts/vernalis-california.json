  "facts": [
    {
      "id": 1,
      "text": "Vernalis was founded in the 1880s by local ranchers as a farming settlement and served as a stop on the Southern Pacific Railroad.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/vernalis_california",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town’s name comes from the Latin word for “springlike,” inspired by a prominent local spring and the daughters of early ranchers, Verna and Alice.",
      "sourceSentenceIds": [
        2,
        30
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Vernalis%2C_California",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "During World War II, Vernalis hosted a Naval Auxiliary Air Station and an Army prisoner‑of‑war camp that later supported the Bracero Program for Mexican farm laborers.",
      "sourceSentenceIds": [
        4,
        10
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Vernalis%2C_California",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Vernalis sits at the intersection of State Routes 33 and 132, just 10.5 miles southeast of Tracy and near the San Joaquin River.",
      "sourceSentenceIds": [
        6,
        8,
        14
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Vernalis%2C_California",
      "category": "other",
      "quality": "poor",
      "qualityReason": "location_description"
    },
    {
      "id": 5,
      "text": "The Vernalis gas field, discovered in 1941, produces dry natural gas from subsurface formations on the west side of the Great Valley.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/vernalis_california",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The area’s flat alluvial plains are prone to dense tule fog in winter, often reducing visibility for days during calm conditions.",
      "sourceSentenceIds": [
        19
