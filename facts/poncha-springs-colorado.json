    },
    {
      "id": 3,
      "text": "The 1883 Poncha Springs Schoolhouse served as town hall until a new purpose‑built town hall opened beside it in 2017, leaving the historic building vacant.",
      "sourceSentenceIds": [
        5,
        6
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Poncha_Springs%2C_Colorado"
    },
    {
      "id": 4,
      "text": "Named after the Spanish word for “to pour,” Poncha Springs reflects the hot springs first noted by Zebulon Pike in 1806.",
      "sourceSentenceIds": [
        3,
        29
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Poncha_Springs%2C_Colorado"
    },
    {
      "id": 5,
      "text": "A Tesla supercharger station in Poncha Springs lets electric‑vehicle drivers recharge while exploring the Rockies.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Poncha_Springs%2C_Colorado"
    },
    {
