  "facts": [
    {
      "id": 1,
      "text": "Richwood began as a wooded tract settled in the late 19th century by sharecroppers who cleared land and built a rudimentary school that became the town’s early hub.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/richwood_louisiana",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town officially incorporated on December 31, 1974, under Louisiana Revised Statute 33:52.",
      "sourceSentenceIds": [
        24
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/richwood_louisiana",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Richwood’s climate is humid subtropical, with hot, humid summers and mild, wet winters influenced by Gulf of Mexico moisture.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/richwood_louisiana",
      "category": "other",
      "quality": "poor",
      "qualityReason": "vague"
    },
    {
      "id": 4,
      "text": "In 1940, a donation of two acres by Napoleon Brown Sr. enabled the first dedicated school building, formalizing Richwood’s educational infrastructure.",
      "sourceSentenceIds": [
        22
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/richwood_louisiana",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "After incorporation, Richwood evolved from a rural enclave into a suburban community, largely residential, adjacent to Monroe.",
      "sourceSentenceIds": [
        25
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/richwood_louisiana",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The town hosts a privately operated correctional center, a notable institution that has drawn attention for its operational challenges.",
      "sourceSentenceIds": [
