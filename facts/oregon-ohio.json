  "facts": [
    {
      "id": 1,
      "text": "Oregon earned its name from Pierre M., who secured the town’s designation while representing Astor’s fur interests east of the Maumee River.",
      "sourceSentenceIds": [
        2,
        3
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Oregon%2C_Ohio",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The city’s roots trace back to the Great Black Swamp, a vast wetland once dominated by oak, hickory, and maple trees.",
      "sourceSentenceIds": [
        25,
        26
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Oregon%2C_Ohio",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Early settlers carved out sawmills that turned the swamp’s rich timber into fertile farmland, sparking Oregon’s first wave of development.",
      "sourceSentenceIds": [
        27
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Oregon%2C_Ohio",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Major ditches, built along old Indian trails, still channel stormwater into Maumee Bay, a legacy of the city’s historic drainage efforts.",
      "sourceSentenceIds": [
        29,
        30
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Oregon%2C_Ohio",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Oregon hosts a public library on Dustin Road, part of the Toledo‑Lucas County Public Library system, serving as a community knowledge hub.",
      "sourceSentenceIds": [
        18
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Oregon%2C_Ohio",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Cardinal Stritch Catholic High School, founded in 1960, remains a prominent educational institution within Oregon’s city limits.",
