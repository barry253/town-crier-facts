  "facts": [
    {
      "id": 1,
      "text": "Dundalk was named after the Irish town of Dundalk (Dún Dealgan) by Henry McShane when he asked the railroad to name the foundry depot.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Dundalk%2C_Maryland",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The first deed in Baltimore County was a 1,150‑acre purchase by Thomas Todd in 1664, and his house “Todd’s Inheritance” still stands as a historic landmark.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.gdcoc.org/about-greater-dundalk/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "In 1917, Dundalk proper opened with just 62 houses, two stores, a post office, and a telephone exchange, the seed of a future steel town.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Dundalk%2C_Maryland",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Bethlehem Steel’s 1,000‑acre farm purchase in 1916 sparked a planned community with streets named “Shipway,” “Northship,” and “Flagship,” mirroring a naval theme.",
      "sourceSentenceIds": [
        23,
        25
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Dundalk%2C_Maryland",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "During World War I, white workers flooded into Dundalk for steel jobs, pushing black workers into the nearby Turner Station community.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Dundalk%2C_Maryland",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The town’s early 20th‑century housing ads advertised homes as racially “restricted,” reflecting pre‑1968 Fair Housing Act practices.",
      "sourceSentenceIds": [
