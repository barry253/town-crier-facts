  "facts": [
    {
      "id": 1,
      "text": "Millington began in fall 1834 when George Markley and Samuel Jackson staked a claim and built a log cabin on the Fox River bank.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Millington%2C_Illinois",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The village straddles the Kendall–LaSalle county line, with the Kendall side part of the Chicago metro and the LaSalle side in the Ottawa micropolitan area.",
      "sourceSentenceIds": [
        3,
        8
      ],
      "sourceLabels": [
        "Web source 1",
        "Wikipedia"
      ],
      "source": "https://kendallkin.org/county-history/town-histories/millington.html",
      "category": "other",
      "quality": "poor",
      "qualityReason": "other"
    },
    {
      "id": 3,
      "text": "A dam was erected the following spring to power a sawmill, the first industrial facility in the town, located on the south side of the river.",
      "sourceSentenceIds": [
        10,
        11
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Millington%2C_Illinois",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The Millington–Newark Cemetery sits on Church Street overlooking the village center and contains more than 3,000 graves, including a Revolutionary War veteran.",
      "sourceSentenceIds": [
        14,
        15
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Millington%2C_Illinois",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Millington lies just 2 miles north of Newark, 7 miles south of Sandwich, and 11 miles southwest of Yorkville, placing it near several historic Illinois towns.",
      "sourceSentenceIds": [
        22
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Millington%2C_Illinois",
      "category": "other",
      "quality": "poor",
      "qualityReason": "location_description"
    },
    {
      "id": 6,
      "text": "The village’s name honors its early settlers, with the first frame house built by Jesse Jackson in 1836 after he bought out Markley’s interest.",
      "sourceSentenceIds": [
        16,
        17
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Millington%2C_Illinois",
