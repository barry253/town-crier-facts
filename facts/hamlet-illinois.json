  "facts": [
    {
      "id": 1,
      "text": "Hamlet was named after early settler Hamlet Cooper, who arrived from England in the 1840s and claimed land near Camp Creek.",
      "sourceSentenceIds": [
        2,
        3
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/hamlet_illinois",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The community emerged as a small rural hub in Perryton Township, organized in 1855 after the Black Hawk War.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/hamlet_illinois",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Hamlet’s post office opened in 1854, marking the town’s first formal federal service.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://roadsidethoughts.com/il/hamlet-xx-mercer-profile.htm",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Located on Illinois Route 94, Hamlet sits 3.5 miles west-southwest of Reynolds in Mercer County.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Hamlet%2C_Illinois",
