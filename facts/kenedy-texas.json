  "facts": [
    {
      "id": 1,
      "text": "Kenedy, Texas, was founded by rancher Mifflin Kenedy, who bought 400,000 acres to build a town that would carry his name.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
