  "facts": [
    {
      "id": 1,
      "text": "Blackwater’s identity is tied to a salt lick that drew hunters, travelers, and settlers, making it a focal point of early frontier life.",
      "sourceSentenceIds": [
        29,
        30
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://appalachianhistorian.org/blackwater-lee-county-blackwater-creek-the-salt-lick-and-big-door-church/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town’s name first appeared in land grant claims in 1775, showing its early recognition by settlers from Virginia and North Carolina.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/blackwater_lee_county_virginia",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Blackwater Creek and the nearby salt lick were central to the community, with families settling along the forks of the creek and roads following the water and ridges.",
      "sourceSentenceIds": [
        27,
        26
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://appalachianhistorian.org/blackwater-lee-county-blackwater-creek-the-salt-lick-and-big-door-church/",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "A 1913 postal stationery cover from Blackwater is a rare surviving artifact of the town’s post office, illustrating its communication history.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://appalachianhistorian.org/blackwater-lee-county-blackwater-creek-the-salt-lick-and-big-door-church/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The area sits at 1,217 feet elevation at the intersection of historic trails used by long hunters and traders between the Cumberland River and the Cherokee Nation.",
      "sourceSentenceIds": [
        15
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/blackwater_lee_county_virginia",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Early land records describe land on the forks of Blackwater near Powell Mountain, the buffalo lick, and Newman’s Ridge, highlighting the region’s geographic features.",
