  "facts": [
    {
      "id": 1,
      "text": "Channel Lake is the northernmost link in the Fox Chain O'Lakes, a 40‑mile waterway that connects to the Fox River.",
      "sourceSentenceIds": [
        25,
        26
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/channel_lake_illinois",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The lake spans 371 acres and averages 14 feet deep, making it a modest but popular spot for fishing and boating.",
      "sourceSentenceIds": [
        1,
        25
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://foxchainolakes.com/lake-information/channel-lake/",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "In the 1890s, Fox and Grass Lakes were famed for lotus viewing, earning the nickname “Egyptian Lotus Beds” and drawing early tourists.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://foxchainolakes.com/lake-information/channel-lake/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The Chicago and North Western Railway reached Lake County in the 1850s, turning Channel Lake into a vacation destination for Chicagoans escaping city life.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/channel_lake_illinois",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The area was originally inhabited by the Potawatomi and other Algonquin‑speaking tribes, who used the lakes for hunting and seasonal villages.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/channel_lake_illinois",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The lake’s watershed covers 12,582 acres across Illinois and Wisconsin, fed by upstream lakes like Peat Lake and Center Lake.",
