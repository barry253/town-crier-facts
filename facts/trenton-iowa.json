  "facts": [
    {
      "id": 1,
      "text": "Trenton was founded in 1836 by Michael Crane, who first called the site Lancaster before it was renamed Trenton in 1837 by new owners.",
      "sourceSentenceIds": [
        1,
        2
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/trenton_iowa",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Joel Turney opened the Charter Oak Wagon Factory in 1848, and by 1887 it was producing more than 500 wagons a year for farmers and westward settlers.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/trenton_iowa",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "When the Charter Oak factory moved to Fairfield in 1888 and no railroad ever reached Trenton, the town’s economy began to wane.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/trenton_iowa",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "In 1869 George Miller erected the Henry County Institute of Science, a building that still houses an auditorium, library, and museum.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/trenton_iowa",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Trenton sits on gently rolling hills of the Southern Iowa Drift Plain, where ancient glacial deposits and loess soils create fertile prairie land.",
      "sourceSentenceIds": [
        30
      ],
      "sourceLabels": [
        "Web source 1"
