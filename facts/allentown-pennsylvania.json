      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The Lehigh Canal, completed in 1829, let anthracite coal travel from Allentown to New York and Philadelphia, sparking regional growth.",
      "sourceSentenceIds": [
        2,
        29
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Allentown%2C_Pennsylvania",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Allentown Band, founded in 1828, is the nation's oldest civilian concert band and still performs in the city.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Allentown%2C_Pennsylvania",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Allentown’s Triple‑A baseball team, the IronPigs, calls Coca‑Cola Park on the east side home.",
      "sourceSentenceIds": [
        7,
        8
      ],
      "sourceLabels": [
        "Wikipedia",
