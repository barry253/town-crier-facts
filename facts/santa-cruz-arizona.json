  "facts": [
    {
      "id": 1,
      "text": "Santa Cruz County takes its name from the Santa Cruz River, which Father Eusebio Kino christened “holy cross” in the 1690s.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Santa_Cruz_County%2C_Arizona"
    },
    {
      "id": 2,
      "text": "Formed on March 15 1899 from part of Pima County, Santa Cruz County became a new Arizona county that same year.",
      "sourceSentenceIds": [
        5,
        29
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Santa_Cruz_County%2C_Arizona"
    },
    {
      "id": 3,
      "text": "Kino established several missions along the Santa Cruz River, including San Cayetano del Tumacácori, San Gabriel de Guevavi, and Los Reyes de Sonoita.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Santa_Cruz_County%2C_Arizona"
    },
    {
      "id": 4,
      "text": "The ruins of those missions are now protected within Tumacácori National Historical Park, preserving a 17th‑century heritage.",
      "sourceSentenceIds": [
        11
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Santa_Cruz_County%2C_Arizona"
    },
    {
      "id": 5,
      "text": "Santa Cruz County borders Pima to the north and west, Cochise to the east, and the Mexican state of Sonora to the south.",
      "sourceSentenceIds": [
        30
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Santa_Cruz_County%2C_Arizona"
    },
    {
      "id": 6,
      "text": "Historic sites in Santa Cruz County are listed on the National Register of Historic Places, highlighting its rich architectural legacy.",
      "sourceSentenceIds": [
        13
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
