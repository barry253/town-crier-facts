  "facts": [
    {
      "id": 1,
      "text": "The name Sparrow Bush comes from Henry L. Sparrow's land, once called Sparrow's Bosk, meaning a wooded slope.",
      "sourceSentenceIds": [
        7,
        13,
        15
      ],
      "sourceLabels": [
        "Web source 1",
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/sparrow_bush_new_york",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "A post office opened in Sparrow Bush in 1827, signaling organized settlement amid the Delaware and Hudson Canal’s influence.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/sparrow_bush_new_york",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Early 1800s lumber from Sparrow Bush’s forests, including ship‑knees, was rafted down the Delaware River to Philadelphia shipyards.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/sparrow_bush_new_york",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The 1868 Monticello & Port Jervis Railroad replaced the canal, linking Sparrow Bush to broader markets and boosting milk shipments and tourism.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/sparrow_bush_new_york",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Route 97, part of the Upper Delaware Scenic Byway, offers Hawk’s Nest overlook with sweeping views of the river valley and Shawangunk Mountains.",
      "sourceSentenceIds": [
        16
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/sparrow_bush_new_york",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Sparrow Bush’s historic hamlets include the Sparrowbush Fire House and United Methodist Church, landmarks that echo its 19th‑century roots.",
