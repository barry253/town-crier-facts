  "facts": [
    {
      "id": 1,
      "text": "Orcas Island, nestled between Washington’s mainland and Vancouver Island, is often called the most beautiful of the San Juan Islands.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://orcasislandchamber.com/",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The island’s main gateway is the Washington State Ferry that departs daily from Anacortes, a route famous among locals and visitors alike.",
      "sourceSentenceIds": [
        21
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://orcasislandchamber.com/",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Orcas Village is the island’s historic community hub, where residents gather for markets, festivals, and waterfront strolls.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Orcas%2C_Washington",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The Orcas Island Chamber of Commerce & Visitor Information Center, located on 65 N. Main, offers maps, event calendars, and local tips to travelers.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.visitsanjuans.com/account/orcas-island-chamber-of-commerce-visitor-information-center",
      "category": "other",
      "quality": "poor",
      "qualityReason": "editorial_filler"
    },
    {
      "id": 5,
      "text": "Every summer, the island hosts Orcas Fest, a week‑long celebration featuring music, art, food, and family‑friendly activities.",
      "sourceSentenceIds": [
        11
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://orcasislandchamber.com/",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Whale watching is a must‑do on Orcas Island, where visitors can spot humpbacks, orcas, and other marine life from the shore or a boat.",
      "sourceSentenceIds": [
        23
