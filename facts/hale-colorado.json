  "facts": [
    {
      "id": 1,
      "text": "Named after General Irving Hale, the camp’s title honors the officer who pioneered U.S. mountain warfare tactics.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Camp_Hale",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "During World War II, the 10th Mountain Division trained here in alpine climbing, skiing, and cold‑weather survival before heading to Europe.",
      "sourceSentenceIds": [
        28,
        30
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Camp_Hale",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Hollywood filmed two wartime movies at Camp Hale—\"Mountain Fighters\" (1943) and \"I Love a Soldier\" (1944)—capturing the camp’s rugged scenery.",
      "sourceSentenceIds": [
        17,
        19
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 2"
      ],
      "source": "https://en.wikipedia.org/wiki/Camp_Hale",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "In 1992, Camp Hale became a national historic site, and in 2019 it was proposed as Colorado’s first National Historic Landscape under the CORE Act.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Camp_Hale",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Veteran Pete Seibert, who trained at Camp Hale, founded Vail Ski Resort in 1962, turning the area into a world‑class ski destination.",
      "sourceSentenceIds": [
        23
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Camp_Hale",
      "category": "people",
      "quality": "good"
    }
