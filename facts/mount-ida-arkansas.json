  "facts": [
    {
      "id": 1,
      "text": "Founded in 1842, Mount Ida grew during a silver boom in the 1880s that spurred early prosperity.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Mount_Ida%2C_Arkansas",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Mount Ida earned the nickname quartz crystal capital of the U.S., thanks to abundant quartz deposits mined since the 1800s.",
      "sourceSentenceIds": [
        12,
        13
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Mount_Ida%2C_Arkansas",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The town sits on the south bank of the South Fork of the Ouachita River, overlooking Lake Ouachita.",
      "sourceSentenceIds": [
        16
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Mount_Ida%2C_Arkansas",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Incorporated on May 30, 1890, Mount Ida became the county seat of Montgomery County.",
      "sourceSentenceIds": [
        14
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Mount_Ida%2C_Arkansas",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Quartz mining and timber shaped Mount Ida’s early settlement, while the Ouachita Mountains provided a backdrop for crystal digging and cabin retreats.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.mountidaarkansas.org/",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Mount Ida’s modern economy relies on ranching, poultry farming, silviculture, and tourism around Lake Ouachita.",
      "sourceSentenceIds": [
        11
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
