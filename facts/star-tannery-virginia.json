  "facts": [
    {
      "id": 1,
      "text": "Star Tannery got its name from Thomas Cover, who linked his leather business to Baltimore’s Star Shoe Company.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://royalexaminer.com/thomas-covers-folly-and-all-you-need-to-know-about-star-tannery-va/",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town sits on Star Tannery Road, off Wardensville Pike, beside Cedar Creek, 13 miles northwest of Strasburg.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://royalexaminer.com/thomas-covers-folly-and-all-you-need-to-know-about-star-tannery-va/",
      "category": "other",
      "quality": "poor",
      "qualityReason": "location_description"
    },
    {
      "id": 3,
      "text": "Star Tannery lies in the rugged Cedar Creek Valley right on the Shenandoah County line.",
      "sourceSentenceIds": [
        17
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://royalexaminer.com/thomas-covers-folly-and-all-you-need-to-know-about-star-tannery-va/",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Early settlers were English and Scotch‑Irish farmers from southwestern Virginia, bringing agrarian roots to the area.",
      "sourceSentenceIds": [
        18
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://royalexaminer.com/thomas-covers-folly-and-all-you-need-to-know-about-star-tannery-va/",
      "category": "people",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Gravel Springs Lutheran Church, built 1849, became the community hub, while its cemetery, fenced in 1907, reflects Thomas Cover’s legacy.",
      "sourceSentenceIds": [
        8,
        24,
        25
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://royalexaminer.com/thomas-covers-folly-and-all-you-need-to-know-about-star-tannery-va/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Thomas Cover, a retired tanner from Uniontown MD, founded the tannery in 1870 after repairing an old tanyard.",
