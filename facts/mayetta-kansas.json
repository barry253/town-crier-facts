  "facts": [
    {
      "id": 1,
      "text": "Mayetta, Kansas, takes its name from Mary Etta Lunger, the young daughter of the town’s founders, who died before the town was laid out.",
      "sourceSentenceIds": [
        1,
        3
      ],
      "sourceLabels": [
        "Web source 1",
        "Wikipedia"
      ],
      "source": "https://www.mayetta.org/history"
    },
    {
      "id": 2,
      "text": "Mayetta was founded in October 1886 on Lunger family land, marking the start of a small Kansas community.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.mayetta.org/history"
    },
    {
      "id": 3,
      "text": "The Rock Island Railroad began building a line from Topeka to St. Joseph through Mayetta in the late 19th century.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.mayetta.org/history"
    },
    {
      "id": 4,
      "text": "The Prairie Band Casino & Resort, located near Mayetta, has been operating since 1998 under various management.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Mayetta%2C_Kansas"
    },
    {
      "id": 5,
      "text": "The Prairie Band Potawatomi Reservation, established in 1846, lies just half a mile west of Mayetta.",
