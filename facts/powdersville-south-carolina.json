    },
    {
      "id": 2,
      "text": "During the American Civil War, Powdersville served as a site for storing gunpowder for the state of South Carolina.",
      "sourceSentenceIds": [
        1,
        12
      ],
      "sourceLabels": [
        "Wikipedia",
