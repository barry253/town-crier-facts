  "facts": [
    {
      "id": 1,
      "text": "Tuluksak first emerged as a seasonal camp for indigenous peoples, later becoming a permanent settlement.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.kupi.com/en/explore/united-states/tuluksak/history"
    },
    {
      "id": 2,
      "text": "Russian explorer Lavrenty Zagoskin mapped the area in the 1840s, naming it \"Tulyagmyut.\".",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.kupi.com/en/explore/united-states/tuluksak/history"
    },
    {
      "id": 3,
      "text": "The town sits at the confluence of the Tuluksak and Kuskokwim rivers, making it a historic trading stop.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.kupi.com/en/explore/united-states/tuluksak/history"
    },
    {
      "id": 4,
      "text": "Subsistence farming dominates, with residents harvesting fish and berries in summer and hunting and trapping in winter.",
      "sourceSentenceIds": [
        29
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.kupi.com/en/explore/united-states/tuluksak/history"
    },
    {
      "id": 5,
      "text": "The communal \"qasgiq\" houses elders who pass down oral traditions and teach survival skills to youth.",
      "sourceSentenceIds": [
        30
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.kupi.com/en/explore/united-states/tuluksak/history"
    },
    {
      "id": 6,
      "text": "Tuluksak played a role in the Alaskan gold rush, serving as a gateway for prospectors.",
      "sourceSentenceIds": [
        14
      ],
      "sourceLabels": [
