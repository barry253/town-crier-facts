  "facts": [
    {
      "id": 1,
      "text": "Many streets in Peralvillo are named after Mexican and international musicians, a naming scheme adopted early in the colonia’s history to foster unity.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://en-academic.com/dic.nsf/enwiki/11563741",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The historic downtown of Mexico City roughly aligns with the ancient Aztec city of Tenochtitlan, founded around 1325.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Historic_center_of_Mexico_City",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "In the mid‑1800s, Peralvillo grew thanks to water from Villa de Guadalupe, two nearby train stations, and the nearby hipódromo, drawing influential residents.",
      "sourceSentenceIds": [
        14
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://historico.alcaldiacuauhtemoc.mx/nope/barrio-de-peralvillo/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The historic center contains about 9,000 buildings, 1,550 of which have been declared historically important.",
      "sourceSentenceIds": [
        16
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Historic_center_of_Mexico_City",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The Centro Histórico houses most of Mexico City’s historic sites from both the Aztec and Spanish eras, along with a large number of museums.",
      "sourceSentenceIds": [
        18
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
