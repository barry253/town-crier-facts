  "facts": [
    {
      "id": 1,
      "text": "Waterloo sits along Symmes Creek in southeastern Symmes Township, Lawrence County, Ohio.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Waterloo%2C_Ohio"
    },
    {
      "id": 2,
      "text": "Symmes Township, where Waterloo lies, was organized around 1840 from lands once part of the Virginia Military District.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/waterloo_ohio"
    },
    {
      "id": 3,
      "text": "The Fabulous Five—Beryl Drummond, Curtis McMahon, Stewart Wiseman, Orlyn Roberts, and Wyman Roberts—barnstormed professionally for seven years, dazzling crowds like the Harlem Globetrotters.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/waterloo_ohio"
    },
    {
      "id": 4,
      "text": "Waterloo produced the Waterloo Wonders, who won Ohio's Class B basketball championship in both 1934 and 1935.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Waterloo%2C_Ohio"
    },
    {
      "id": 5,
      "text": "A post office opened in Waterloo in 1843, marking the community's early establishment.",
      "sourceSentenceIds": [
        15
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://roadsidethoughts.com/oh/waterloo-xx-lawrence-profile.htm"
    },
    {
      "id": 6,
      "text": "An Ohio Historical Marker in Waterloo honors the town’s resilience and underdog spirit, celebrating its enduring legacy.",
