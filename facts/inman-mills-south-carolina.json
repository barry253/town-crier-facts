  "facts": [
    {
      "id": 1,
      "text": "Inman Mills is an unincorporated community and historic textile mill village located within the town of Inman in Spartanburg County.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/inman_mills_south_carolina"
    },
    {
      "id": 2,
      "text": "James A. Chapman established Inman Mills in 1901, strategically placing it along the Charleston and Western Carolina Railroad.",
      "sourceSentenceIds": [
        8,
        9
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/inman_mills_south_carolina"
    },
    {
      "id": 3,
      "text": "The original Inman plant doubled its capacity by 1909 and added a four-story expansion in 1920 to support the textile sector.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/inman_mills_south_carolina"
    },
    {
      "id": 4,
      "text": "The historic Inman Mills site operated from 1902 until 2001 and was listed on the National Register of Historic Places in 2016.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/inman_mills_south_carolina"
    },
    {
      "id": 5,
      "text": "Inman hosts an annual Harvest Day on the last Saturday in September featuring food, music, and festivities.",
      "sourceSentenceIds": [
        24
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.cityofinman.org/"
    },
    {
      "id": 6,
      "text": "Friday nights in the historic downtown of Inman feature a summer concert series for the community.",
