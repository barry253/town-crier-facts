  "facts": [
    {
      "id": 1,
      "text": "McCutchenville was laid out in 1829 by Joseph McCutchen, who also built the historic McCutchen Overland Inn that year.",
      "sourceSentenceIds": [
        11,
        13
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/McCutchenville%2C_Ohio",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The McCutchen Overland Inn served as a stagecoach stop on the Harrison Trail before becoming a hotel and apartment building.",
      "sourceSentenceIds": [
        14,
        15
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/McCutchenville%2C_Ohio",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "In 1964 the Wyandot County Historical Society purchased the inn and restored it to its stagecoach days, dedicating it as a museum.",
      "sourceSentenceIds": [
        5,
        6,
        16
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/McCutchenville%2C_Ohio",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "McCutchenville sits at the junction of State Routes 53 and 587 in Wyandot and Seneca counties.",
      "sourceSentenceIds": [
        10,
        21,
        22
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/McCutchenville%2C_Ohio",
      "category": "other",
      "quality": "poor",
      "qualityReason": "location_description"
    },
    {
      "id": 5,
      "text": "A post office has operated continuously in McCutchenville since 1833, keeping the community connected.",
      "sourceSentenceIds": [
        12,
        25
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/McCutchenville%2C_Ohio",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "McCutchenville is one of only two original stagecoach inns remaining in Ohio, preserving a rare slice of 19th‑century travel.",
