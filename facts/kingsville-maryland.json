  "facts": [
    {
      "id": 1,
      "text": "Kingsville takes its name from Abraham King, who died there in 1836.",
      "sourceSentenceIds": [
        13
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Kingsville%2C_Maryland"
    },
    {
      "id": 2,
      "text": "The historic Jerusalem Mill Village, listed on the National Register, sits on the Little Gunpowder Falls and hosts living‑history events.",
      "sourceSentenceIds": [
        8,
        10,
        11
      ],
      "sourceLabels": [
        "Web source 1",
        "Web source 2"
      ],
      "source": "https://livinginmaryland.com/a-locals-guide-to-living-in-kingsville-maryland/"
    },
    {
      "id": 3,
      "text": "A former Nike missile launch and firing control site, once part of Cold War defenses, now lies within Kingsville’s borders.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Kingsville%2C_Maryland"
    },
    {
      "id": 4,
      "text": "Kingsville’s tight‑knit community enjoys wide‑open spaces and a historic charm that locals say defines the town.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://livinginmaryland.com/a-locals-guide-to-living-in-kingsville-maryland/"
    },
    {
      "id": 5,
      "text": "The town’s boundaries are marked by the Little Gunpowder Falls to the northeast and the Big Gunpowder Falls to the southwest, where they merge into the Gunpowder River.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Kingsville%2C_Maryland"
    },
    {
      "id": 6,
      "text": "In 1840, State Geologist John Henry Alexander was the first to place Kingsville on a map, cementing its place in Maryland history.",
