  "facts": [
    {
      "id": 1,
      "text": "Spencer earned its name in 1806 when the town was organized and christened after Judge Ambrose Spencer, a prominent New York jurist.",
      "sourceSentenceIds": [
        5,
        6
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 2"
      ],
      "source": "https://en.wikipedia.org/wiki/Spencer%2C_New_York",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Founded in 1972, the Spencer Historical Society runs a museum and archives that hold a wealth of artifacts chronicling the town’s past.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://museumsdatabase.com/museums/view/22119",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "North Spencer once hosted a railroad station, creamery, stores and post office, serving as a bustling hub before the railroad’s decline.",
      "sourceSentenceIds": [
        8,
        9
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.tiogahistory.org/Site/Spencer.html",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The Halsey Valley Grand Army of the Republic Meeting Hall, located in Spencer, earned a spot on the National Register of Historic Places in 2003.",
      "sourceSentenceIds": [
        11
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Spencer%2C_New_York",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Spencer village sits at the junction where New York State Route 34 and Route 96 split, a key crossroads in the county.",
