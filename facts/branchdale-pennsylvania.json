  "facts": [
    {
      "id": 1,
      "text": "Branchdale was originally called Muddy Branch or Weaverstown and sprang up around 1836 when coal prospects drew settlers.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/branchdale_pennsylvania",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The village grew when Scottish immigrant Robert Weir advanced from laborer to supervisor at Otto Colliery, installing steam engines that allowed deeper mining.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/branchdale_pennsylvania",
      "category": "people",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Reilly Township was formed in 1856 from parts of Branch and Cass Townships, formalizing Branchdale’s boundaries and encouraging settlement.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/branchdale_pennsylvania",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The first coal mine opened in 1836 by Martin Weaver, a local landowner, marking the shift from farming to industrial activity.",
      "sourceSentenceIds": [
        30
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/branchdale_pennsylvania",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Branchdale’s mining heritage lives on in the former company store, a preserved structure that once served miners and their families.",
      "sourceSentenceIds": [
        26
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/branchdale_pennsylvania",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The area’s early settlers were mainly German families who cleared forested land along Muddy Branch for subsistence farming before coal dominated.",
      "sourceSentenceIds": [
        27
      ],
      "sourceLabels": [
        "Web source 1"
      ],
