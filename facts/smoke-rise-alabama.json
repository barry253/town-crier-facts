      "quality": "good"
    },
    {
      "id": 2,
      "text": "Most homes in Smoke Rise sit atop Bryant Mountain or in the valley below, giving the community a distinctive hillside feel.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Smoke_Rise%2C_Alabama",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Residents founded the Smoke Rise Homeowners Association in the mid‑1990s, yet the community remains unincorporated.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Smoke_Rise%2C_Alabama",
