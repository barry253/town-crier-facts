  "facts": [
    {
      "id": 1,
      "text": "Morrice earned its name when founder Isaac Gale chose to honor his friend William Morrice, a Scottish pioneer who lived just outside the village limits.",
      "sourceSentenceIds": [
        1,
        4
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Morrice%2C_Michigan"
    },
    {
      "id": 2,
      "text": "When the Chicago & Port Huron Railroad opened, residents moved the entire town to the tracks, hoping for a depot, but officials only stopped at the first village that built one.",
      "sourceSentenceIds": [
        7,
        8,
        9,
        10,
