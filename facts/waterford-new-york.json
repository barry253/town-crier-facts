  "facts": [
    {
      "id": 1,
      "text": "Waterford village is the oldest incorporated village in the U.S., incorporated in 1794 before the town was formed.",
      "sourceSentenceIds": [
        13
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Waterford%2C_New_York",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town sits at the confluence of the Hudson and Mohawk Rivers, where the Erie Canal’s easternmost locks, the Waterford Flight, connect to the Hudson.",
      "sourceSentenceIds": [
        10,
        21,
        22
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Waterford%2C_New_York",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "During the industrial revolution, Waterford became a manufacturing hub thanks to its location at the confluence of the Hudson, Mohawk, Champlain, and Erie Canals and three railroad lines.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Waterford%2C_New_York",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The Eddy family shaped Waterford’s industrial past; Isaac Newton Eddy founded Franklin Ink Works in 1831, and his son George Washington Eddy built the Hudson and Mohawk Foundry.",
      "sourceSentenceIds": [
        4,
        17
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Waterford%2C_New_York",
      "category": "people",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Waterford hosts annual Canal Fest and Tugboat Roundup celebrations that honor its canal heritage.",
      "sourceSentenceIds": [
        14
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Waterford%2C_New_York",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The Northside Historic District and Peebles Island are listed on the National Register of Historic Places, preserving the town’s 19th‑century industrial architecture.",
      "sourceSentenceIds": [
        19
      ],
