  "facts": [
    {
      "id": 1,
      "text": "The Dalles name comes from the French word for “sluice,” describing the columnar basalt rocks that carved the river’s rapids.",
      "sourceSentenceIds": [
        20
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/The_Dalles%2C_Oregon",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Every April, The Dalles hosts the Cherry Festival, a celebration that traces the town’s historic connection to the region’s cherry orchards.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://explorethedalles.com/",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Fort Dalles Museum, Oregon’s oldest history museum, sits in the 1856 Surgeon’s Quarters and showcases the city’s fur‑trade past.",
      "sourceSentenceIds": [
        13
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/The_Dalles%2C_Oregon",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The Dalles lies 75 miles east of Portland, tucked within the scenic Columbia River Gorge National Scenic Area.",
      "sourceSentenceIds": [
        15
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/The_Dalles%2C_Oregon",
      "category": "other",
      "quality": "poor",
      "qualityReason": "location_description"
    },
    {
      "id": 5,
      "text": "Archaeological evidence shows The Dalles has been a Native American trading center for more than 10,000 years.",
      "sourceSentenceIds": [
        16
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/The_Dalles%2C_Oregon",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "In the 1810s, fur traders from the North West Company and the American Pacific Fur Company navigated The Dalles’ rapids, making it a key portage point.",
      "sourceSentenceIds": [
        24
      ],
      "sourceLabels": [
