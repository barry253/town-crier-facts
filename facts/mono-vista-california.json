  "facts": [
    {
      "id": 1,
      "text": "Mono Vista was first settled during the California Gold Rush in the mid‑1800s, and old mining remnants still dot the surrounding hills.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.trawellino.com/destinations/united-states/california_mono-vista",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Remnants of those early mining operations remain visible today, offering a tangible link to Mono Vista’s gold‑rush past.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.trawellino.com/destinations/united-states/california_mono-vista",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Mono Vista is part of the Sonora micropolitan area, known for its historic Gold Country charm and proximity to Yosemite National Park.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.trawellino.com/destinations/united-states/california_mono-vista",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The town’s scenic landscapes include Pinecrest Lake, a popular spot for kayaking and sunset views.",
      "sourceSentenceIds": [
        24
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.trawellino.com/destinations/united-states/california_mono-vista",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Hikers can explore the Dardanelle Trail, which winds through forested hills and offers panoramic vistas of the Sierra Nevada.",
      "sourceSentenceIds": [
        24
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.trawellino.com/destinations/united-states/california_mono-vista",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Mono Vista’s name reflects its location in the high Sierra, where the sun often paints the valley in golden hues.",
      "sourceSentenceIds": [
        1
      ],
