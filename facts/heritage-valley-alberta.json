  "facts": [
    {
      "id": 1,
      "text": "Amber Valley was founded by African‑American homesteaders from Oklahoma and Texas between 1905‑1912, escaping Jim Crow conditions in the United States.",
      "sourceSentenceIds": [
        18,
        19,
        20
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Amber_Valley%2C_Alberta",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The community built its first schoolhouse in 1913 and a nondenominational church in 1914, serving about 300 residents when the post office opened in 1931.",
      "sourceSentenceIds": [
        26,
        29
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Amber_Valley%2C_Alberta",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Obadiah Place, a preserved homestead of one of the first Black settlers, now serves as a provincial heritage site in Amber Valley.",
      "sourceSentenceIds": [
        6,
        17
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Amber_Valley%2C_Alberta",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "In 1984, Selwyn Jacob directed the documentary “We Remember Amber Valley,” spotlighting the town’s unique Black‑settler history.",
      "sourceSentenceIds": [
        13
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Amber_Valley%2C_Alberta",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "A silver coin in the Royal Canadian Mint’s Black History series was designed to honor Amber Valley’s original settlers and released for Black History Month 2024.",
      "sourceSentenceIds": [
        8,
        9
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Amber_Valley%2C_Alberta",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Amber Valley’s original name was Pine Creek, renamed when a post office opened in 1931, marking its official establishment.",
      "sourceSentenceIds": [
        2,
        28
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Amber_Valley%2C_Alberta",
      "category": "etymology",
      "quality": "good"
    }
