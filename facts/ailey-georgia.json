  "facts": [
    {
      "id": 1,
      "text": "Sugar Ray Robinson, the famed boxer, was born in Ailey on May 3, 1921, and grew up in this small Georgia town.",
      "sourceSentenceIds": [
        22
      ],
      "sourceLabels": [
        "Web source 1"
      ],
