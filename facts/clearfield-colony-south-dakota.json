  "facts": [
    {
      "id": 1,
      "text": "Clearfield Colony was established in 1996 as a daughter colony of the nearby Greenwood Hutterite Colony.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/clearfield_colony_south_dakota"
    },
    {
      "id": 2,
      "text": "Clearfield Colony operates as a self-sustaining communal settlement adhering to Anabaptist principles of shared property and nonresistance.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/clearfield_colony_south_dakota"
    },
    {
      "id": 3,
      "text": "Clearfield Colony lies within the boundaries of the Yankton Sioux Indian Reservation in eastern Charles Mix County.",
      "sourceSentenceIds": [
        20
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/clearfield_colony_south_dakota"
    },
    {
      "id": 4,
      "text": "The community emphasizes agriculture, livestock, and communal trades as its economic base, consistent with Hutterite practices.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/clearfield_colony_south_dakota"
    },
    {
      "id": 5,
      "text": "Education at Clearfield Colony combines public schooling up to grade eight with internal German-language instruction in faith and history.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/clearfield_colony_south_dakota"
    },
    {
      "id": 6,
      "text": "The terrain around Clearfield Colony consists of flat to gently rolling plains ideal for crop production and pastureland.",
      "sourceSentenceIds": [
