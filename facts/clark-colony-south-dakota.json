  "facts": [
    {
      "id": 1,
      "text": "Clark Colony was established in 1955 as a daughter colony of the Jamesville Hutterite Colony.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/clark_colony_south_dakota"
    },
    {
      "id": 2,
      "text": "Hutterite practices at Clark Colony emphasize pacifism, nonconformity, and the internal production of goods like clothing and soap.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/clark_colony_south_dakota"
    },
    {
      "id": 3,
      "text": "Clark Colony operates diversified farming including dairy, beef, swine, poultry, and crops like corn and alfalfa.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/clark_colony_south_dakota"
    },
    {
      "id": 4,
      "text": "The community at Clark Colony maintains a local public school on colony grounds to provide elementary education.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/clark_colony_south_dakota"
    },
    {
      "id": 5,
      "text": "Clark Colony eventually established the Mayfield Hutterite Colony as its own daughter settlement to continue the cycle of communal growth.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/clark_colony_south_dakota"
    },
    {
      "id": 6,
      "text": "Clark Colony experiences a humid continental climate with cold, snowy winters and warm, humid summers typical of the Great Plains.",
      "sourceSentenceIds": [
        24
