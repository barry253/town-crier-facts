  "facts": [
    {
      "id": 1,
      "text": "Pleasanton was founded by Mormons in 1882, establishing a pioneer community in the remote New Mexico high desert.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Pleasanton%2C_New_Mexico"
    },
    {
      "id": 2,
      "text": "Pleasanton was named for an army officer and exemplifies frontier agricultural outposts relying on livestock grazing and limited farming near the Gila National Forest.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/pleasanton_new_mexico"
    },
    {
      "id": 3,
      "text": "In 1885, a group of Chiricahua Apache people had a conflict near Pleasanton, part of the American West history.",
      "sourceSentenceIds": [
        1,
        5
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://kids.kiddle.co/Pleasanton,_New_Mexico"
    },
    {
      "id": 4,
      "text": "Pleasanton sits in Williams Valley, between Glenwood and Cliff, a remote high desert corridor.",
      "sourceSentenceIds": [
        16
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://kids.kiddle.co/Pleasanton,_New_Mexico"
    },
    {
      "id": 5,
      "text": "The community lies within the Gila National Forest region, where federal lands cover over 80% of Catron County's rugged terrain.",
