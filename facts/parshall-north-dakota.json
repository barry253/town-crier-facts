  "facts": [
    {
      "id": 1,
      "text": "Parshall sprang to life in 1914 when the Soo Line Railroad extended its tracks through the area, turning a plain into a town.",
      "sourceSentenceIds": [
        1,
        2
      ],
      "sourceLabels": [
        "Web source 2",
        "Wikipedia"
      ],
      "source": "https://grokipedia.com/page/parshall_north_dakota"
    },
    {
      "id": 2,
      "text": "The town was named after George Parshall, a Hidatsa man who helped survey the site and served as a mail stage driver.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/parshall_north_dakota"
    },
    {
      "id": 3,
      "text": "Parshall hosts the Paul Broste Rock Museum, showcasing a lifelong collection of rocks, minerals, and fossils that reflects the region's geology.",
      "sourceSentenceIds": [
        4,
        7
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/parshall_north_dakota"
    },
    {
      "id": 4,
      "text": "On February 15, 1936, Parshall recorded a chilling -60°F, one of North Dakota's lowest temperatures ever.",
      "sourceSentenceIds": [
        9,
        16
      ],
      "sourceLabels": [
        "Web source 2",
        "Wikipedia"
      ],
      "source": "https://grokipedia.com/page/parshall_north_dakota"
    },
    {
      "id": 5,
      "text": "Parshall sits within the Mandan, Hidatsa, and Arikara Nation's Fort Berthold Indian Reservation, linking it to the region's native heritage.",
      "sourceSentenceIds": [
        12,
        13
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Parshall%2C_North_Dakota"
    },
    {
