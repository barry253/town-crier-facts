  "facts": [
    {
      "id": 1,
      "text": "Dutch John takes its name from a Prussian horse trader and miner who settled here in the early eighteen sixties.",
      "sourceSentenceIds": [
        26,
        27
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://onlineutah.us/dutchjohnhistory.shtml"
    },
    {
      "id": 2,
      "text": "Dutch John was originally built to house the workers constructing the nearby Flaming Gorge Dam.",
      "sourceSentenceIds": [
        24
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://onlineutah.us/dutchjohnhistory.shtml"
    },
    {
      "id": 3,
      "text": "During the peak of dam construction, as many as three thousand five hundred people lived in Dutch John.",
      "sourceSentenceIds": [
        15
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Dutch_John%2C_Utah"
    },
    {
      "id": 4,
      "text": "A resort in Dutch John is home to the world's largest fishing fly, which weighs over three tons.",
      "sourceSentenceIds": [
        17,
        18
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Dutch_John%2C_Utah"
    },
    {
      "id": 5,
      "text": "The Bureau of Reclamation owned the Dutch John townsite and its buildings until the town was privatized in nineteen ninety-eight.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Dutch_John%2C_Utah"
    },
    {
      "id": 6,
      "text": "Dutch John now houses employees of the Flaming Gorge National Recreation Area centered around the dam and lake.",
