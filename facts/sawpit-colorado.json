  "facts": [
    {
      "id": 1,
      "text": "Sawpit was founded in 1892 as a stop on the Rio Grande Southern Railroad, originally called Seymour.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.uncovercolorado.com/towns/sawpit/"
    },
    {
      "id": 2,
      "text": "The town incorporated in 1897, becoming a statutory municipality in San Miguel County.",
      "sourceSentenceIds": [
        13
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.uncovercolorado.com/towns/sawpit/"
    },
    {
      "id": 3,
      "text": "Its name comes from a sawpit built to supply lumber for the booming mining camps that flooded the area.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.uncovercolorado.com/towns/sawpit/"
    },
    {
      "id": 4,
      "text": "Sawpit sits at an elevation of 7,592 feet, giving it a high‑altitude mountain feel.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.uncovercolorado.com/towns/sawpit/"
    },
    {
      "id": 5,
      "text": "The town lies just northwest of Telluride, tucked into the San Miguel County landscape.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.uncovercolorado.com/towns/sawpit/"
    },
    {
      "id": 6,
      "text": "The Sawpit Mercantile, a general store built in the 1920s, still sells gas, liquor, natural foods, and everyday necessities.",
