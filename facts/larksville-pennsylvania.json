  "facts": [
    {
      "id": 1,
      "text": "Larksville was once known as Blindtown before being renamed in honor of a former resident named Peggy Lark.",
      "sourceSentenceIds": [
        11
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Larksville%2C_Pennsylvania"
    },
    {
      "id": 2,
      "text": "Larksville gained prominence in the late nineteenth and early twentieth centuries as an active anthracite coal mining community.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Larksville%2C_Pennsylvania"
    },
    {
      "id": 3,
      "text": "The Susquehanna River forms the southeastern border of Larksville.",
      "sourceSentenceIds": [
        18
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Larksville%2C_Pennsylvania"
    },
    {
      "id": 4,
      "text": "Larksville was incorporated as a borough on November 10, 1909, after formerly being part of Plymouth Township.",
      "sourceSentenceIds": [
        4,
        10
      ],
      "sourceLabels": [
        "Web source 2",
        "Wikipedia"
      ],
      "source": "https://www.pagenweb.org/~luzerne/patk/larks.htm"
    },
    {
      "id": 5,
      "text": "Mining houses in Larksville were originally clustered around collieries such as Boston, Loree, Lance, Woodward, and Number 4.",
      "sourceSentenceIds": [
        14,
        15
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Larksville%2C_Pennsylvania"
    },
    {
      "id": 6,
      "text": "The northern portion of Larksville mostly consists of hills, forests, and a few houses.",
