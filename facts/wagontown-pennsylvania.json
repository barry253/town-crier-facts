  "facts": [
    {
      "id": 1,
      "text": "Wagontown takes its name from the 1736 “Sign of the Waggon” inn, originally the Farmers' and Mechanic's Inn, later expanded by the Way family.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/wagontown_pennsylvania",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Caverns beneath the inn suggest it may have been a stop on the Underground Railroad, hiding enslaved people seeking freedom.",
      "sourceSentenceIds": [
        13,
        20
      ],
      "sourceLabels": [
        "Web source 1",
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/wagontown_pennsylvania",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "West Caln Township, where Wagontown lies, became an official township in 1744 after splitting from Caln in 1731.",
      "sourceSentenceIds": [
        18,
        8
      ],
      "sourceLabels": [
        "Web source 2",
        "Web source 1"
      ],
      "source": "https://findingaids.library.upenn.edu/records/SMREP_WCT.02",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The nearby Hibernia House, listed on the National Register of Historic Places, stands close to Wagontown.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Wagontown%2C_Pennsylvania",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The West Caln Township Historical Commission archives over a decade of documents, maps, and oral histories from 1851 to 2013.",
      "sourceSentenceIds": [
        3
      ],
