  "facts": [
    {
      "id": 1,
      "text": "Agawam’s name comes from a Native American village on the west bank of the Connecticut River, meaning “unloading place” or “fish‑curing place.”.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Agawam%2C_Massachusetts",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "In 1636 William Pynchon bought land from the Agawam tribe for 10 coats, 10 hoes, and 10 fathoms of wampum, laying the town’s early foundation.",
      "sourceSentenceIds": [
        28,
        29
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Agawam%2C_Massachusetts",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The Agawam Historical Association preserves the town’s past and runs the Agawam Historical and Fire House Museum at 35 Elm Street.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Agawam%2C_Massachusetts",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Agawam’s library history began when Minerva Porter Davis donated a building in 1924, creating the town’s first public library.",
      "sourceSentenceIds": [
        19,
        17
      ],
      "sourceLabels": [
        "Web source 1",
        "Wikipedia"
      ],
      "source": "https://www.agawamhistory.org/agawam-timeline",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The town hosts the former Six Flags New England amusement park, once called Riverside Park, one of the largest parks in the U.S.",
      "sourceSentenceIds": [
        25
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Agawam%2C_Massachusetts",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "In 1953 WWLP, an NBC affiliate, opened studios on Provin Mountain in Feeding Hills, making Agawam a regional broadcast hub.",
