      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The community grew along the Washington and Old Dominion Railroad and later expanded along Virginia State Route 7.",
      "sourceSentenceIds": [
        1,
        2
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 2"
      ],
      "source": "https://en.wikipedia.org/wiki/Idylwood%2C_Virginia",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Its borders touch Falls Church to the east, Pimmit Hills and Tysons Corner to the north, and Dunn Loring to the west.",
      "sourceSentenceIds": [
        19
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Idylwood%2C_Virginia",
