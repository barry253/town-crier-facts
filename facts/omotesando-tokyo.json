      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The zelkova‑lined avenue runs from Meiji Shrine’s entrance to Aoyama‑dōri, where Omotesando Station sits.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
