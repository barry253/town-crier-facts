  "facts": [
    {
      "id": 1,
      "text": "In 1889, Companhia Progresso Industrial do Brasil bought Fazenda Bangu and began building the textile factory that would shape the neighborhood.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Bangu%2C_Rio_de_Janeiro",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The factory’s 1893 inauguration made Bangu a textile exporter, spurring the construction of a railroad station, worker houses, and streets.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.rolecarioca.com.br/en/roteiro/40/bangu.html",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Bangu Atlético Clube, founded in 1904, won Brazil’s first professional football championship in 1933 and celebrated a Carioca title in 1966.",
      "sourceSentenceIds": [
        14,
        16
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Bangu%2C_Rio_de_Janeiro",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The first football match in Brazil took place on the factory grounds in 1894, thanks to British workers who brought the sport from England.",
      "sourceSentenceIds": [
        21,
        2,
        6,
        7
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Bangu%2C_Rio_de_Janeiro",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "In 2007, the former factory building was converted into Bangu Shopping, a historic mall that revitalized the west‑zone district after the factory closed.",
      "sourceSentenceIds": [
        13,
        24,
        25
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Bangu%2C_Rio_de_Janeiro",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The neighborhood’s name traces back to a 17th‑century farm, Fazenda Bangu, established by Manuel de Barcelos Domingues in 1673.",
      "sourceSentenceIds": [
        10
