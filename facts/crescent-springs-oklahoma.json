    {
      "id": 1,
      "text": "Crescent Springs was originally settled by land seekers during the Land Run of 1889.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.okhistory.org/publications/enc/entry?entry=CR011"
    },
    {
      "id": 2,
      "text": "William Brown started the town's first general merchandise operation using only a wagon and a tent as his store.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.okhistory.org/publications/enc/entry?entry=CR011"
    },
    {
      "id": 3,
      "text": "The town takes its name from a moon-shaped glade where the early entrepreneurs first started their businesses.",
      "sourceSentenceIds": [
        27
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.okhistory.org/publications/enc/entry?entry=CR011"
    },
    {
      "id": 4,
      "text": "Crescent Springs moved its entire town site to be closer to the railroad after tracks were laid in 1902.",
      "sourceSentenceIds": [
        6,
        7
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.okhistory.org/publications/enc/entry?entry=CR011"
    },
    {
      "id": 5,
      "text": "Lake Lattawanna is a reservoir located in the eastern part of Crescent Springs.",
