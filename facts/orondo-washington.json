      ],
      "source": "https://en.wikipedia.org/wiki/Orondo%2C_Washington",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Orondo was named after a Lake Superior Indian, whose ancestors were thought to be miners of the ancient Old Copper Complex.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Web source 1"
      ],
