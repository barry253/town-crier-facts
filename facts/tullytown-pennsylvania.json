      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Tullytown is served by the Levittown station on SEPTA’s Trenton Line, connecting commuters to Center City Philadelphia.",
      "sourceSentenceIds": [
