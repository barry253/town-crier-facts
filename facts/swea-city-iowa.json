    },
    {
      "id": 2,
      "text": "Residents moved the post office from Swea to Reynolds to ensure the railroad would bring prosperity.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://kpacedc.com/county-community/community-living/swea-city/"
    },
    {
      "id": 3,
      "text": "A second petition on April 19, 1895 led to an election held at a schoolhouse, where 34 voted for incorporation and 1 against.",
      "sourceSentenceIds": [
