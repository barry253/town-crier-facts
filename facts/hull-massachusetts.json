      ],
      "source": "https://en.wikipedia.org/wiki/Hull%2C_Massachusetts",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The historic Paragon Carousel remains on the boardwalk, a relic of the former Paragon Park amusement area.",
      "sourceSentenceIds": [
