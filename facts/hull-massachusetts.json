      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Hull’s Allerton Life Saving Station, opened in 1889, now houses a maritime museum in the old Coast Guard boathouse.",
      "sourceSentenceIds": [
