      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The city’s name comes from the nearby Mountain Iron Mine, a key taconite source.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Mountain_Iron%2C_Minnesota",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Mountain Iron proudly bears the motto “Taconite Capital of the World,” reflecting its mining heritage.",
      "sourceSentenceIds": [
