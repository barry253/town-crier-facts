  "facts": [
    {
      "id": 1,
      "text": "Bryson City began as Charleston, the county seat of Swain County when the county was carved out of surrounding counties in the early 1800s.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Bryson_City%2C_North_Carolina"
    },
    {
      "id": 2,
      "text": "The town’s original layout was a T‑shape, with Main and Everett streets forming the arms; Everett was named for the county’s first sheriff, Epp Everett.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Bryson_City%2C_North_Carolina"
    },
    {
      "id": 3,
      "text": "The Western North Carolina Railroad arrived in 1884, making Bryson City a rail hub until passenger service ended in 1948.",
      "sourceSentenceIds": [
        7,
        9
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Bryson_City%2C_North_Carolina"
    },
    {
      "id": 4,
      "text": "Bryson City lies just west of where the Tuckasegee River meets Deep Creek, a site where Cherokee people have lived for nearly 14,000 years.",
      "sourceSentenceIds": [
        5,
        24
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Bryson_City%2C_North_Carolina"
    },
    {
      "id": 5,
      "text": "The town is the base of the Eastern Band of Cherokee Indians, the only federally recognized tribe in North Carolina.",
      "sourceSentenceIds": [
        8
