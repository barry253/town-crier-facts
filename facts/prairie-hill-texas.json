  "facts": [
    {
      "id": 1,
      "text": "Prairie Hill was named for a rise in the prairie between Christmas Creek and the Navasota River.",
      "sourceSentenceIds": [
        2,
        4
      ],
      "sourceLabels": [
        "Web source 1",
        "Web source 2"
      ],
      "source": "https://www.tshaonline.org/handbook/entries/prairie-hill-tx-limestone-county"
    },
    {
      "id": 2,
      "text": "By 1890 the town had about twenty-five residents, a general store, a gristmill, and two cotton gins.",
      "sourceSentenceIds": [
        22
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.tshaonline.org/handbook/entries/prairie-hill-tx-limestone-county"
    },
    {
      "id": 3,
      "text": "A Masonic temple organized in 1892, followed by a school in 1894 and a blacksmith shop, marked Prairie Hill’s early growth.",
      "sourceSentenceIds": [
        23
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.tshaonline.org/handbook/entries/prairie-hill-tx-limestone-county"
    },
    {
      "id": 4,
      "text": "The town’s post office closed in 1906, only to reopen in 1925 after a decade without mail service.",
      "sourceSentenceIds": [
        24,
        25
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.tshaonline.org/handbook/entries/prairie-hill-tx-limestone-county"
    },
    {
      "id": 5,
      "text": "In 1962 the local Church of Christ closed, and the building was leased by the town as a civic center.",
      "sourceSentenceIds": [
        28,
        29
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.tshaonline.org/handbook/entries/prairie-hill-tx-limestone-county"
    },
    {
      "id": 6,
      "text": "From 1990 to 2000 Prairie Hill’s population hovered around 150 residents, reflecting its small‑town character.",
      "sourceSentenceIds": [
        30
      ],
      "sourceLabels": [
