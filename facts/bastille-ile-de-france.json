  "facts": [
    {
      "id": 1,
      "text": "The Bastille fortress once stood on the west side of Place de la Bastille.",
      "sourceSentenceIds": [
        23
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.travelfranceonline.com/place-de-la-bastilles-history/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Originally called Castel Saint‑Antoine, the fortress was commissioned in 1370 by Hugues Aubriot.",
      "sourceSentenceIds": [
        15
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.travelfranceonline.com/place-de-la-bastilles-history/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "For most of its history, the Bastille served as a state prison for the kings of France.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Bastille",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The storming of the Bastille in 1789 marked a turning point, symbolizing the overthrow of despotic power.",
      "sourceSentenceIds": [
        24
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.travelfranceonline.com/place-de-la-bastilles-history/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Lafayette gifted the Bastille’s key to George Washington in 1790; it now hangs at Mount Vernon.",
      "sourceSentenceIds": [
        20
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Bastille",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The Bastille’s design was copied at Pierrefonds and Tarascon in France and even influenced England’s Nunney Castle.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
