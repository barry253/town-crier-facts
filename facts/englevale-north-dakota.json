      ],
      "source": "https://ransomcountynd.net/englevale-2/",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Englevale once housed three churches, reflecting the town’s early religious diversity in the early 20th century.",
      "sourceSentenceIds": [
        13
      ],
      "sourceLabels": [
