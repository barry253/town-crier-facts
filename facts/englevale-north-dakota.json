      "quality": "good"
    },
    {
      "id": 2,
      "text": "In 1913 Englevale boasted a four‑year high school, a rare feature for a rural community at the time.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Web source 1"
      ],
