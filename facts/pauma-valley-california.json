  "facts": [
    {
      "id": 1,
      "text": "Pauma Valley’s name comes from the Luiseño word meaning “place where there is water,” a nod to the San Luis Rey River that winds through the valley.",
      "sourceSentenceIds": [
        10,
        20
      ],
      "sourceLabels": [
        "Web source 1",
        "Wikipedia"
      ],
      "source": "https://www.vchistory.org/history-of-pauma-valley/",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The Serrano Adobe, built by Jose Antonio Serrano in 1844, was declared California’s first historic landmark in 1971 and still stands near Pala Road.",
      "sourceSentenceIds": [
        2,
        3,
        28,
        29
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.vchistory.org/history-of-pauma-valley/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "In 1892, much of the original Serrano ranch site was set aside as the Pauma‑Yuima Reservation, the homeland of the Pauma‑Yuima Band of Mission Indians.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.vchistory.org/history-of-pauma-valley/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The Lazy H Sky Ranch began as a working ranch in 1920, became a private resort in 1950, and attracted local celebrities to its slopes.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.vchistory.org/history-of-pauma-valley/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "During the late 1800s, the Butterfield Overland Stage Line made a regular stop at Rincon Store, making Pauma a historic stagecoach stop.",
      "sourceSentenceIds": [
        14
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.vchistory.org/history-of-pauma-valley/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Pauma Valley sits at the western base of the Palomar Mountains and is crossed by California Route 76, linking the coast to inland routes.",
      "sourceSentenceIds": [
        22,
        23
