    },
    {
      "id": 2,
      "text": "The neighborhood sits on Portland’s east side, bounded by the Willamette River, SE 28th Ave, Hawthorne Blvd, and East Burnside Street.",
      "sourceSentenceIds": [
        13,
        14,
        15,
        16
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Buckman%2C_Portland%2C_Oregon"
    },
    {
      "id": 3,
      "text": "Lone Fir Cemetery, founded in 1855, is the city’s second‑largest arboretum and still houses a solitary fir tree that stands today.",
      "sourceSentenceIds": [
        3,
        23
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Buckman%2C_Portland%2C_Oregon"
    },
    {
      "id": 4,
      "text": "Colonel Summers Park, opened in 1921 as Belmont Park, remains a cherished green space for Buckman residents.",
      "sourceSentenceIds": [
        11,
        23
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Buckman%2C_Portland%2C_Oregon"
    },
    {
      "id": 5,
      "text": "Buckman once hosted the City of East Portland, the center of a separate municipality that merged with Portland in 1887.",
