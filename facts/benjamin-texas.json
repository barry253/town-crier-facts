  "facts": [
    {
      "id": 1,
      "text": "Benjamin was founded in 1885 by Bedford, who named the town after his son who was killed by lightning.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.tshaonline.org/handbook/entries/benjamin-tx",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town became the county seat of Knox County in 1886, the same year it was officially organized.",
      "sourceSentenceIds": [
        22
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Benjamin%2C_Texas",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Benjamin incorporated in 1928 and sits on the historic Atchison, Topeka and Santa Fe Railroad line.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.tshaonline.org/handbook/entries/benjamin-tx",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "A 1938 courthouse, built with WPA labor, replaced the original 1888 stone structure and still serves the community.",
      "sourceSentenceIds": [
        24,
        25
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Benjamin%2C_Texas",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The 1887 jail, now a private residence, is one of the town’s oldest surviving buildings.",
      "sourceSentenceIds": [
        23
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Benjamin%2C_Texas",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Benjamin’s economy historically relies on farming, ranching, and oil production.",
