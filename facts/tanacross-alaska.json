  "facts": [
    {
      "id": 1,
      "text": "Tanacross takes its name from the Athabascan term 'Taats'altęy,' meaning the historic crossing of the Tanana River on the Eagle Trail.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/tanacross_alaska",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The Tanacross area was the ancestral homeland of the Mansfield‑Ketchumstuk and Healy Lake‑Joseph Village Athabascan bands.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/tanacross_alaska",
      "category": "people",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "During the 1930s, Tanacross built an airstrip on the south bank, later upgraded for WWII use and closed after the war.",
      "sourceSentenceIds": [
        15,
        16,
        17
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Tanacross%2C_Alaska",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "In 1972, the town relocated south across the Tanana River because of water contamination.",
      "sourceSentenceIds": [
        18
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Tanacross%2C_Alaska",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "An uncontrolled grass fire in 1979 destroyed much of Tanacross's abandoned north‑bank site, including ancestral structures.",
      "sourceSentenceIds": [
        10,
        19
      ],
      "sourceLabels": [
        "Web source 1",
        "Wikipedia"
      ],
      "source": "https://grokipedia.com/page/tanacross_alaska",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Residents of Tanacross are Tanah, also called Tinneh, Athabascan Indians who maintain strong cultural ties.",
      "sourceSentenceIds": [
        11
