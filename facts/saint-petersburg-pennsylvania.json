  "facts": [
    {
      "id": 1,
      "text": "St Petersburg was named after Judge Peters, the land’s original owner, and the name changed to St Petersburg in 1862 to avoid confusion with another post office.",
      "sourceSentenceIds": [
        29,
        30
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.stpetersburgpa.com/history",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The borough’s land was granted by the Commonwealth of Pennsylvania in 1794 to Jared Ingersoll, John Adlum, Alexander James Dallas, Charles Swift, and Benjamin Chew.",
      "sourceSentenceIds": [
        25
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.stpetersburgpa.com/history",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "St Petersburg officially became a borough in February 1872 after a court decree separated it from Richland Township.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.stpetersburgpa.com/history",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Early St Petersburg boasted a railroad depot, two boiler houses, and several stores, saloons, and boarding houses that served the growing community.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.stpetersburgpa.com/history",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Silent‑film actress Jane Wolfe (1875–1958) was born in St Petersburg, making the borough a birthplace of early Hollywood talent.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
