  "facts": [
    {
      "id": 1,
      "text": "Founded in 1811 and incorporated in 1825, Vicksburg grew into a bustling hub of commerce, agriculture, and river traffic.",
      "sourceSentenceIds": [
        13
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.vicksburg.org/community/page/history-vicksburg"
    },
    {
      "id": 2,
      "text": "In 1894, entrepreneur Biedenharn bottled Coca‑Cola for the first time right here in Vicksburg.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Vicksburg%2C_Mississippi"
    },
    {
      "id": 3,
      "text": "Vicksburg sits where the mighty Mississippi meets the Yazoo River, a historic confluence that shaped its fate.",
      "sourceSentenceIds": [
        16
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Vicksburg%2C_Mississippi"
    },
    {
      "id": 4,
      "text": "During the Civil War, Vicksburg’s defenders and residents carved caves into the hillsides to survive the siege.",
      "sourceSentenceIds": [
        30
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.vicksburg.org/community/page/history-vicksburg"
    },
    {
      "id": 5,
      "text": "The Vicksburg & Meridian Railroad, the only east‑west line between Memphis and New Orleans, ran through the city in the 1840s.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
