  "facts": [
    {
      "id": 1,
      "text": "The Sutherlin Mansion, an Italian Villa-style house built 1857‑1859, now houses the Danville Museum of Fine Arts and History.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://danvillemuseum.org/about/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "During the 1918‑1919 Spanish Influenza outbreak, the Sutherlin Mansion served as a temporary hospital for victims.",
      "sourceSentenceIds": [
        11
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://danvillemuseum.org/about/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The museum’s permanent exhibits include the Camilla Williams Exhibit, celebrating Danville’s internationally acclaimed opera singer.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://danvillemuseum.org/about/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Danville’s Civil Rights history is highlighted in the museum’s “Movement” exhibit, honoring local leaders and sit‑in protests that prefigured national marches.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://danvillemuseum.org/about/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The Sutherlin property originally spanned 4 acres and included separate kitchen, laundry, and stables, reflecting its role as an urban plantation.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://danvillemuseum.org/about/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Visit SoSi, the new regional tourism brand, was unveiled in 2023 to showcase Danville’s unique personality and growing cultural offerings.",
      "sourceSentenceIds": [
        29
