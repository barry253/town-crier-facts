      "id": 1,
      "text": "Quasqueton's name comes from the Meskwaki language, originally called 'Quasquetuck' or 'Quaquetuck'.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Quasqueton%2C_Iowa",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The Quasqueton Guardian, the town’s second newspaper, began publishing in December 1856.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Quasqueton%2C_Iowa",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The Quasqueton Area Historical Society, organized in 1989, preserves the town’s historical records and artifacts.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://communityhistoryarchives.com/places/quasqueton-area-historical-society/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The Society’s museum sits in the historic State Savings Bank building, remodeled in Romanesque Revival style in 1902 and listed on the National Register.",
      "sourceSentenceIds": [
        23
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://communityhistoryarchives.com/places/quasqueton-area-historical-society/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The Community History Archive offers free, searchable access to digitized newspapers from the late 1800s and early 1900s.",
