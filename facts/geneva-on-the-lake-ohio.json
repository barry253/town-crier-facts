      "quality": "good"
    },
    {
      "id": 2,
      "text": "A pony‑powered carousel added later helped establish Geneva‑on‑the‑Lake as Ohio’s first summer resort.",
      "sourceSentenceIds": [
        20
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
