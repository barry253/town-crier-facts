    },
    {
      "id": 2,
      "text": "Latin Quarter streets once home to philosophers like Descartes, Pascal, Sartre, Camus, Hemingway.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.monumentsofparis.com/latin-quarter-paris"
    },
    {
      "id": 3,
      "text": "The Panthéon, built 1764 as church, became national mausoleum 1791, housing tombs of Voltaire, Rousseau, Hugo, Curie.",
      "sourceSentenceIds": [
        22
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.monumentsofparis.com/latin-quarter-paris"
    },
    {
      "id": 4,
      "text": "The Sorbonne building on Rue des Écoles dates largely from 17th century, its dome is a skyline landmark.",
      "sourceSentenceIds": [
        24
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.monumentsofparis.com/latin-quarter-paris"
    },
    {
      "id": 5,
      "text": "Roman Lutetia founded 52 BC by Romans, built baths, roads, amphitheater, laying groundwork for modern Latin Quarter.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
