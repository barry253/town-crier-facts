      "quality": "good"
    },
    {
      "id": 2,
      "text": "NYU Langone Hospital – Long Island, founded in 1896 as Nassau Hospital, was Long Island’s first voluntary hospital and remains a nationally recognized medical center.",
      "sourceSentenceIds": [
        9,
        10
      ],
      "sourceLabels": [
