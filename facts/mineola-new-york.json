      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "On May 20, 1927, Charles Lindbergh launched his historic trans‑Atlantic flight from the nearby Long Island airfield, a moment that put Mineola on the world map.",
      "sourceSentenceIds": [
        23,
        24
      ],
      "sourceLabels": [
