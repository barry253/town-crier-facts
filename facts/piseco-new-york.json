  "facts": [
    {
      "id": 1,
      "text": "Piseco takes its name from a Native American known to early surveyor Joshua Brown, who christened the lake in the 1800s.",
      "sourceSentenceIds": [
        22
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Piseco%2C_New_York"
    },
    {
      "id": 2,
      "text": "The Piseco Lake Historical Society, founded in 1971, preserves artifacts and hosts lectures about the lake’s rich past.",
      "sourceSentenceIds": [
        13
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://museumsdatabase.com/museums/view/21367"
    },
    {
      "id": 3,
      "text": "Seventeen thousand years ago, glaciers carved the Adirondacks, leaving behind the basin that became Piseco Lake.",
      "sourceSentenceIds": [
        28,
        30
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://pisecolake.org/pages/historical-piseco-lake.asp"
    },
    {
      "id": 4,
      "text": "Before becoming Piseco Lake, the body of water south of the town was once called Spy Lake by early explorers.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://pisecolake.org/pages/historical-piseco-lake.asp"
    },
    {
      "id": 5,
      "text": "The Piseco Lake Historical Society operates as a non‑profit, relying on volunteers, donations, and membership fees to keep history alive.",
