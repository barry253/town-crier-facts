  "facts": [
    {
      "id": 1,
      "text": "Churchville got its name when the North and Southampton Reformed Church began building in 1816, turning a crossroads into a village.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/Churchville,_Pennsylvania",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town’s railroad station opened in 1878, moved in 1891, and helped farmers ship milk to Philadelphia, sparking a shift to dairy farming.",
      "sourceSentenceIds": [
        3,
        11,
        14
      ],
      "sourceLabels": [
        "Web source 1",
        "Web source 2"
      ],
      "source": "https://pennsylvaniagenealogy.org/bucks/churchville-pennsylvania.htm",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The Churchville Historic District was added to the National Register of Historic Places in 1995, preserving its 19th‑century character.",
      "sourceSentenceIds": [
        27
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Churchville%2C_Pennsylvania",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The Churchville Nature Center protects 65 acres of wildlife, a green space operated by Bucks County Parks and Recreation.",
      "sourceSentenceIds": [
        30
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Churchville%2C_Pennsylvania",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "In 1880 the Churchville Creamery began as a dairy, later turning into a cannery, shirt factory, and even coal and oil yards, showing the town’s industrial adaptability.",
