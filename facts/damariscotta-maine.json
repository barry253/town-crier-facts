  "facts": [
    {
      "id": 1,
      "text": "Damariscotta’s name comes from an Algonquian word meaning “place of an abundance of alewives,” fish that have spawned in the lake for millennia.",
      "sourceSentenceIds": [
        8,
        29
      ],
      "sourceLabels": [
        "Web source 2",
        "Wikipedia"
      ],
      "source": "https://www.visitmaine.net/damariscotta-maine/"
    },
    {
      "id": 2,
      "text": "The town’s historic Whaleback Shell Midden, shaped like a whale, is now a state historic site that showcases 2,500‑year‑old oyster shell deposits.",
      "sourceSentenceIds": [
        1,
        4,
        6,
        7,
        18
      ],
      "sourceLabels": [
        "Web source 2",
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://www.visitmaine.net/damariscotta-maine/"
    },
    {
      "id": 3,
      "text": "Early Damariscotta industries included two sawmills, a match factory, and a tannery, reflecting the town’s early industrial roots.",
      "sourceSentenceIds": [
        2,
        3
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Damariscotta%2C_Maine"
    },
    {
      "id": 4,
      "text": "The Lincoln Theater, a local landmark since 1875, still hosts classic movies, independent films, and live performances.",
      "sourceSentenceIds": [
        12,
        13
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.visitmaine.net/damariscotta-maine/"
    },
    {
      "id": 5,
      "text": "Damariscotta and neighboring Newcastle are linked by the Main Street bridge over the river, creating the “Twin Villages” that share a single historic downtown.",
