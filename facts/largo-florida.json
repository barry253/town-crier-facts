      "quality": "good"
    },
    {
      "id": 2,
      "text": "The Tocobaga people were the original inhabitants of the land that became Largo.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.largo.com/connect/living_in_largo/largo_city_history/index.php",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Jackson’s West Coast Garage, opened around 1935, has served as a cornerstone of Largo’s history for 90 years.",
      "sourceSentenceIds": [
