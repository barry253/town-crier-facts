  "facts": [
    {
      "id": 1,
      "text": "Ranchos de Taos is a tiny village just four miles southwest of Taos, home to the San Francisco de Asis Church, a National Historic Landmark.",
      "sourceSentenceIds": [
        1,
        20,
        14
      ],
      "sourceLabels": [
        "Web source 1",
        "Wikipedia"
      ],
      "source": "https://www.legendsofamerica.com/nm-ranchodetaos/"
    },
    {
      "id": 2,
      "text": "The San Francisco de Asis Mission Church, completed in 1815, remains an active parish in the Santa Fe Diocese, holding regular masses and festivals.",
      "sourceSentenceIds": [
        19,
        2
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Ranchos_de_Taos%2C_New_Mexico"
    },
    {
      "id": 3,
      "text": "In 1725 the settlement originally called Las Trampas de Taos was renamed Ranchos de Taos, establishing it as a permanent Spanish community.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Ranchos_de_Taos%2C_New_Mexico"
    },
    {
      "id": 4,
      "text": "Ranchos de Taos Plaza, the historic district, showcases the San Francisco de Asis Mission Church and reflects the town’s preserved heritage.",
      "sourceSentenceIds": [
        14
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Ranchos_de_Taos%2C_New_Mexico"
    },
    {
      "id": 5,
      "text": "The community gathering place, an historic adobe landmark, is reopening for summer 2026 as a lively space for local events.",
