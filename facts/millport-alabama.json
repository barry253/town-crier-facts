  "facts": [
    {
      "id": 1,
      "text": "Millport’s name probably comes from Henry Miller’s grist mill, once called Miller’s Port, which gave the town its early identity.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://encyclopediaofalabama.org/article/millport/",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "In 1878, Henry Miller built the first water‑powered grist mill in Millport, sparking local industry.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://encyclopediaofalabama.org/article/millport/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Millport shifted its location in 1882 when the Georgia Pacific Railroad ran through, moving closer to the tracks.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://encyclopediaofalabama.org/article/millport/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Millport Town Hall was originally called Lick Skillet, and trade historically centered on the three creeks that border the town.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://encyclopediaofalabama.org/article/millport/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Dan Penn, a celebrated Muscle Shoals songwriter, was born and raised in Millport, Alabama.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://encyclopediaofalabama.org/article/millport/",
      "category": "people",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Between 1890 and 1900, Millport was the largest town in Lamar County, a title it held until the 20th century.",
      "sourceSentenceIds": [
        12
