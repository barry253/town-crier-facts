  "facts": [
    {
      "id": 1,
      "text": "Cohoe's historic Victor Holm Cabin, built in 1890 by Finnish immigrant Victor Holm, sits on the Kasilof River and is on the National Register of Historic Places.",
      "sourceSentenceIds": [
        1,
        4,
        26
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/cohoe_alaska",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The area that became Cohoe was long part of Dena'ina Athabascan territory, where seasonal fishing camps dotted the shores of Cook Inlet and the Kasilof River.",
      "sourceSentenceIds": [
        3,
        23,
        24,
        25
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/cohoe_alaska",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "A post office opened in Cohoe in 1950, marking the community's formal recognition and a key step toward organized services.",
      "sourceSentenceIds": [
        22
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/cohoe_alaska",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "After World War II, veterans used federal homestead laws to claim land on the Kenai Peninsula, turning Cohoe into a thriving agricultural settlement.",
      "sourceSentenceIds": [
        28
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/cohoe_alaska",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Oil exploration in the 1950s, highlighted by the 1957 Swanson River discovery near Cohoe, brought workers and families, boosting local housing and services.",
      "sourceSentenceIds": [
        30
      ],
      "sourceLabels": [
        "Web source 1"
      ],
