  "facts": [
    {
      "id": 1,
      "text": "Ottertail began as Otter Tail City, founded by trappers who traded with local Native Americans.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://cityofottertail.com/history",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town served as Otter Tail County’s seat until 1872, when the capital moved to Fergus Falls.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://cityofottertail.com/history",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "When the Soo Line railroad planned a route, owners refused, so the line was rerouted and the new town was platted east of the original site.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://cityofottertail.com/history",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Ottertail was officially platted in 1903 and named after nearby Otter Tail Lake.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Ottertail%2C_Minnesota",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The historic Saint Paul House, once a hotel, was moved from Highway 78 to the current Main Street on Highway 108.",
      "sourceSentenceIds": [
        29
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://cityofottertail.com/history",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Pioneers planned Ottertail’s layout across nearly 3,200 acres, dividing it into five sections for future growth.",
      "sourceSentenceIds": [
        30
      ],
      "sourceLabels": [
        "Web source 1"
      ],
