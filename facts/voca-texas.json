  "facts": [
    {
      "id": 1,
      "text": "Voca earned its name when early settlers from Avoca, Arkansas shortened their hometown’s name for the new post office.",
      "sourceSentenceIds": [
        1,
        20
      ],
      "sourceLabels": [
        "Web source 1",
        "Web source 2"
      ],
      "source": "https://www.tshaonline.org/handbook/entries/voca-tx",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The first permanent settlers arrived in Voca during the late 1850s and early 1860s, pushing into the rugged southeastern McCulloch County.",
      "sourceSentenceIds": [
        15
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/voca_texas",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "A historic bridge was built over the San Saba River near Voca in 1910, linking the community to the river valley.",
      "sourceSentenceIds": [
        26
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.tshaonline.org/handbook/entries/voca-tx",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "By the mid‑1880s Voca boasted 120 residents and housed a school, Methodist church, gristmill, cotton gin, and two general stores.",
      "sourceSentenceIds": [
        25
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.tshaonline.org/handbook/entries/voca-tx",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "In 1990 Voca’s population had dwindled to just 56 residents, reflecting its quiet rural character.",
      "sourceSentenceIds": [
        27
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.tshaonline.org/handbook/entries/voca-tx",
      "category": "other",
      "quality": "poor",
      "qualityReason": "census_demographic"
    },
    {
      "id": 6,
      "text": "A post office opened in Voca in 1878, marking the town’s formal recognition by the federal government.",
