  "facts": [
    {
      "id": 1,
      "text": "German Catholic settlers Carl and Emil Flusche founded Muenster in 1889, inviting fellow immigrants to join them.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Muenster%2C_Texas"
    },
    {
      "id": 2,
      "text": "Muenster was named after Münster, the capital of Westphalia, after the original name Westphalia was already taken.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Muenster%2C_Texas"
    },
    {
      "id": 3,
      "text": "A Missouri–Kansas–Texas Railroad line built in 1887 ran through the area, and the town site was founded in 1889.",
      "sourceSentenceIds": [
        8,
        12
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Muenster%2C_Texas"
    },
    {
      "id": 4,
      "text": "Every April, Muenster’s Germanfest offers beer, BBQ, German food, music, and bike and footraces for locals and visitors.",
      "sourceSentenceIds": [
        19
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Muenster%2C_Texas"
    },
    {
      "id": 5,
      "text": "Each Thanksgiving weekend, Muenster hosts a Christkindlmarkt, a traditional German holiday market.",
      "sourceSentenceIds": [
        20
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Muenster%2C_Texas"
    },
    {
      "id": 6,
      "text": "Oil discovered in the 1920s sparked economic growth and drew new residents to Muenster.",
