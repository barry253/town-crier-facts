  "facts": [
    {
      "id": 1,
      "text": "Mount Zion was founded in 1852 by Reverend Thomas Hicks Martin, whose family settled on land once owned by the Creek Confederacy.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Mount_Zion%2C_Georgia",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town’s name comes from the local Mount Zion Methodist Episcopal Church, established in 1865 and soon became the community’s focal point.",
      "sourceSentenceIds": [
        11
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Mount_Zion%2C_Georgia",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "In 1877 Reverend James Mitchell opened the Mount Zion Seminary, the predecessor of today’s Mount Zion High School.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Mount_Zion%2C_Georgia",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The Georgia General Assembly incorporated Mount Zion as a town in 1912, re‑chartered in 1953 and again in 1978.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Mount_Zion%2C_Georgia",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Mount Zion’s municipal flag, first flown in 2007, uniquely includes the Confederate battle flag, echoing the 1956 Georgia state flag design.",
      "sourceSentenceIds": [
        13,
