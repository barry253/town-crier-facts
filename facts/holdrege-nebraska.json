  "facts": [
    {
      "id": 1,
      "text": "Holdrege was founded in 1883 when the railroad reached the town, and it was named after George Ward Holdrege, a railroad official.",
      "sourceSentenceIds": [
        1,
        2,
        3
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Holdrege%2C_Nebraska",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The first train arrived on December 10, 1883, bringing a pioneer town of about 200 people to life.",
      "sourceSentenceIds": [
        17
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Holdrege%2C_Nebraska",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Holdrege became the county seat in 1884, and its courthouse, now on the National Register, stands as a historic landmark.",
      "sourceSentenceIds": [
        15,
        4
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Holdrege%2C_Nebraska",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The Nebraska Prairie Museum, located in Holdrege, showcases the region’s agricultural heritage and prairie ecosystem.",
      "sourceSentenceIds": [
        14
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Holdrege%2C_Nebraska",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Holdrege’s downtown features brick streets and a historic train station where trains still stop, giving the town a classic feel.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.phelpscountyne.com/just-the-place/holdrege",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The Holdrege Area Public Library, regarded as one of the best in rural Nebraska, serves as a cultural hub for residents.",
      "sourceSentenceIds": [
