  "facts": [
    {
      "id": 1,
      "text": "Lindon’s name comes from an old linden tree that grew in town in 1901, inspiring the misspelled town name.",
      "sourceSentenceIds": [
        20
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Lindon%2C_Utah",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Pioneers first settled Lindon in 1861 on grazing land that later became the town’s core.",
      "sourceSentenceIds": [
        4,
        6
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Lindon%2C_Utah",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The Lindon Cider Mill, built by Lewis Robison in 1857, still stands with its original honeycomb limestone.",
      "sourceSentenceIds": [
        25,
        27
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Lindon%2C_Utah",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Gillman Farm, owned by the Gillman family for over a century, earned Utah’s “Century Farms” designation.",
      "sourceSentenceIds": [
        24
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Lindon%2C_Utah",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Every Fourth of July, Lindon hosts a parade featuring decorated bikes, classic cars, and marching bands that locals have watched for decades.",
      "sourceSentenceIds": [
        13
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.wikixm.com/us/ut/lindon/overview",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The town’s historic hall once hosted plays and silent films before becoming a cannery in 1940.",
      "sourceSentenceIds": [
        15
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Lindon%2C_Utah",
