  "facts": [
    {
      "id": 1,
      "text": "Lake Arrowhead is a man-made reservoir in Adams County, spanning 295 acres with a maximum depth of 30 feet.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/lake_arrowhead_wisconsin"
    },
    {
      "id": 2,
      "text": "Constructed in 1978 by impounding Fourteenmile Creek, Lake Arrowhead was filled with water in the spring of 1979.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/lake_arrowhead_wisconsin"
    },
    {
      "id": 3,
      "text": "The region encompassing Lake Arrowhead was part of the traditional lands of the Ho-Chunk Nation, also known as Winnebago.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/lake_arrowhead_wisconsin"
    },
    {
      "id": 4,
      "text": "Surrounding terrain at Lake Arrowhead was formed by Pleistocene glaciations, which deposited sands and gravels about 15,000 years ago.",
      "sourceSentenceIds": [
        16
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/lake_arrowhead_wisconsin"
    },
    {
      "id": 5,
      "text": "Lake Arrowhead features a robust fishery with key species including walleye, largemouth bass, northern pike, and bluegill.",
      "sourceSentenceIds": [
        23
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/lake_arrowhead_wisconsin"
    },
    {
