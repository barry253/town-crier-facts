      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town’s post office opened in 1833, and Camden was officially platted in 1836.",
      "sourceSentenceIds": [
        15,
        16
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
