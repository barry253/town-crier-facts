  "facts": [
    {
      "id": 1,
      "text": "Alhambra’s name comes from Washington Irving’s book, “Tales of the Alhambra,” and means “The Red Castle.”.",
      "sourceSentenceIds": [
        1,
        2,
        11
      ],
      "sourceLabels": [
        "Web source 1",
        "Web source 2",
        "Wikipedia"
      ],
      "source": "https://madison.illinoisgenweb.org/town_histories/alhambra_history.html",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The village was laid out in 1849 by Dr. Sheppard, who purchased land from the east and platted the town in 1850.",
      "sourceSentenceIds": [
        27,
        28
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://madison.illinoisgenweb.org/town_histories/alhambra_history.html",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Alhambra hosted Illinois’s first cooperative soybean processing unit, the Alhambra Grain & Feed Co., which began full production on March 1, 1945.",
      "sourceSentenceIds": [
        12,
        13
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Alhambra%2C_Illinois",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Illinois Route 140 runs through Alhambra as Main Street, linking the village west to Hamel and east to Greenville.",
      "sourceSentenceIds": [
        15
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Alhambra%2C_Illinois",
      "category": "transport",
      "quality": "poor",
      "qualityReason": "route_only"
    },
    {
      "id": 5,
      "text": "The village’s waters drain southwest to Silver Creek, a tributary of the Kaskaskia River.",
      "sourceSentenceIds": [
        17
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Alhambra%2C_Illinois",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Alhambra’s early growth was tied to the Illinois Central and Clover Leaf Railroads, which ran through the town in the late 19th century.",
