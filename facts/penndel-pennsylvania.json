      "id": 1,
      "text": "Penndel was originally called Attleborough and became an incorporated borough in 1899.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://penndelpalawyers.com/penndel-pennsylvania-facts/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The borough’s name changed to Penndel in 1947 after briefly being called South Langhorne.",
      "sourceSentenceIds": [
        17
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Penndel%2C_Pennsylvania",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "When the Philadelphia Reading Railroad began service in 1876, a train station opened and the town quickly grew around it.",
      "sourceSentenceIds": [
        2,
        3
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Penndel%2C_Pennsylvania",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The Rumpf Factory, a 405‑foot long, three‑story building completed in 1898, still stands mostly empty today.",
      "sourceSentenceIds": [
        1,
        5,
        7
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Penndel%2C_Pennsylvania",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "After a fire destroyed the original factory in August 1901, workers rebuilt it in 1902, keeping the industry alive.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Penndel%2C_Pennsylvania",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Quaker pioneers Thomas Langhorne and Henry Paulin settled the area on Lenape land granted by William Penn in the 1700s.",
      "sourceSentenceIds": [
        4,
        8
