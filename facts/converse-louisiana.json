  "facts": [
    {
      "id": 1,
      "text": "Converse was founded in 1906 when the Kansas City Southern Railway reached Sabine Parish, and it was named after Colonel James Converse, a local landowner.",
      "sourceSentenceIds": [
        1,
        2,
        3
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/converse_louisiana",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Early settlers in the 1880s cleared longleaf pine stands for logging and small‑scale farming, sparking Louisiana’s major lumber boom.",
      "sourceSentenceIds": [
        13,
        29
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/converse_louisiana",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The village’s economy once revolved around cotton ginning and farming, but today it benefits from nearby Toledo Bend Reservoir, the largest man‑made lake in the South.",
      "sourceSentenceIds": [
        12,
        10
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/converse_louisiana",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Converse was home to Babsolina, an African‑American community that housed the Sabine Normal and Industrial Institute, a vocational school for black students.",
      "sourceSentenceIds": [
        4,
        17
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/converse_louisiana",
      "category": "people",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The area’s abundant pine, suitable for construction and naval stores, drew migrants from neighboring states seeking economic prospects in this rural frontier.",
      "sourceSentenceIds": [
        30
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/converse_louisiana",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Louisiana has two communities named Converse, one in Sabine Parish and another in West Feliciana Parish.",
