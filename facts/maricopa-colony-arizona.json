  "facts": [
    {
      "id": 1,
      "text": "Maricopa Colony’s heart is the Historical Society Museum and Visitor Center on Maricopa‑Casa Grande Highway, where local history comes alive.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://maricopahistory.org/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "In 1879 Maricopa Wells dropped its second name and moved its post office south to link with the Southern Pacific Railroad.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.maricopa-az.gov/Our-City/History-of-Maricopa",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Monthly, the Maricopa Historical Society meets in the Redwood Room of the new Library, inviting speakers to share stories of the town.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://maricopahistory.org/",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "During the 1850s and 1860s, Maricopa Wells served as a major stagecoach relay for the San Antonio‑San Diego and Butterfield Overland Mail Lines.",
      "sourceSentenceIds": [
        18
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.maricopa-az.gov/Our-City/History-of-Maricopa",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Heritage Park hosts the Maricopa Museum and Visitor Center, once home to a historic water tower that anchors field‑trip tours.",
      "sourceSentenceIds": [
