  "facts": [
    {
      "id": 1,
      "text": "Oakland, Mississippi, was first settled around 1836, originally located 1.5 miles east of its current site.",
      "sourceSentenceIds": [
        11
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Oakland%2C_Mississippi",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "By the 1850s, Oakland moved to sit beside the new Mississippi and Tennessee Railroad, turning a scattered outpost into a structured rural hub.",
      "sourceSentenceIds": [
        2,
        3,
        5,
        6
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Oakland%2C_Mississippi",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "In the early 1900s, farms around Oakland produced corn, cotton, vegetables, and fruits, with Oakland pears said to rival California's.",
      "sourceSentenceIds": [
        15
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Oakland%2C_Mississippi",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Oakland once boasted two churches, a cotton gin, schools, merchants, and the Bank of Oakland, earning a reputation as one of Mississippi's best business towns of its size.",
      "sourceSentenceIds": [
        16
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Oakland%2C_Mississippi",
      "category": "people",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Oakland's name comes from the dense oak groves that surrounded the original settlement, inspiring the town's moniker.",
      "sourceSentenceIds": [
        30
      ],
      "sourceLabels": [
        "Web source 1"
      ],
