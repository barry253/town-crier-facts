      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The town’s four hills—Military, Pioneer, Sunnyside, and College—converge in downtown Pullman, giving the city its distinctive topography.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Wikipedia"
