      "category": "transport",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Washington State University, founded as the State College of Washington in 1905, sits on land donated by Pullman leaders in 1890.",
      "sourceSentenceIds": [
        4,
        29
      ],
      "sourceLabels": [
        "Wikipedia"
