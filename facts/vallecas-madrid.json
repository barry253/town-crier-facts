      "id": 1,
      "text": "Vallecas first appears in the 1202 Fuero de Madrid granted by King Alfonso VIII, linking it to Madrid's communal lands.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/Vallecas",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The 1888 La Maquinilla line shipped gypsum from Vallecas quarries, enabling worker commuting and fueling nearby factory growth.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/Vallecas",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Centro Cultural Paco Rabal, named after actor Paco Rabal, sits in Vallecas' heart, hosting arts and community events.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://aquimadriz.es/vallecas-explorando-la-historia-y-las-recomendaciones-locales/",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Rayo Vallecano, founded in 1924, remains a symbol of neighborhood pride and has competed in Spain's top football league.",
      "sourceSentenceIds": [
        19
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/Vallecas",
      "category": "people",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Vallecas' industrial boom in the 1920s doubled its population as migrants worked in gypsum, brick, and tile factories near the railway.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
