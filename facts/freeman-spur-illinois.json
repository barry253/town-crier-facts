  "facts": [
    {
      "id": 1,
      "text": "Freeman Spur takes its name from James R. Freeman, the landowner who sold the tract for the Possum Ridge coal mine.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Freeman_Spur%2C_Illinois",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The village sits straddling Williamson and Franklin counties, with most of its area in Williamson.",
      "sourceSentenceIds": [
        5,
        19,
        20
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Freeman_Spur%2C_Illinois",
      "category": "other",
      "quality": "poor",
      "qualityReason": "location_description"
    },
    {
      "id": 3,
      "text": "Freeman Spur grew around the 1908 opening of the Possum Ridge Mine, a coal shaft that still marks the town.",
      "sourceSentenceIds": [
        6,
        8
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Freeman_Spur%2C_Illinois",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "A 1912 tornado leveled the mine’s above‑ground buildings, a dramatic event in the town’s early history.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Freeman_Spur%2C_Illinois",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Freeman Spur’s post office began operating in 1921, long after the mine had drawn settlers.",
