  "facts": [
    {
      "id": 1,
      "text": "Almira was founded when land developers George Reed and James Odgers expanded Charley Davis’s 160‑acre tract, naming the town after Davis’s wife.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.historylink.org/File/23353",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The Central Washington Railroad reached Almira in fall 1889, making it the line’s temporary terminus before the track extended to Coulee City the next summer.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Almira%2C_Washington",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "In 1889, the town’s first post office and small store were built by Charley Davis and his wife Almira, anchoring the community’s early commerce.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.historylink.org/File/23353",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Almira’s early settlers lived in temporary shacks; a harsh winter halted construction, leaving the town a collection of makeshift buildings until spring.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Almira%2C_Washington",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The town’s name origin: developers suggested naming it after Davis’s wife, Almira, after seeing her name on the land deed.",
