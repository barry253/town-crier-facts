  "facts": [
    {
      "id": 1,
      "text": "Altmar was first settled in 1813 by Scottish immigrant Peter Henderson, who built a log cabin on a 200‑acre riverbank.",
      "sourceSentenceIds": [
        1,
        11
      ],
      "sourceLabels": [
        "Web source 2",
        "Wikipedia"
      ],
      "source": "https://grokipedia.com/page/altmar_new_york",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The village’s original name, Sand Bank, came from the local term “Alkineaur,” meaning a sand bank along the Salmon River.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/altmar_new_york",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Altmar’s Salmon River Fish Hatchery raises more than three million young fish each year for Lake Ontario and Lake Erie stocking programs.",
      "sourceSentenceIds": [
        14,
        16
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Altmar%2C_New_York",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Artist Milton Avery was born in 1885 in what was then called Sand Bank, the area that later became Altmar.",
      "sourceSentenceIds": [
        17
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Altmar%2C_New_York",
      "category": "people",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Lake‑effect snow dominates Altmar’s winters, with January averaging about 45 inches of snowfall and peaks sometimes exceeding three inches per hour.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/altmar_new_york",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The village dissolved in 2013, leaving Altmar as an unincorporated community within the Town of Albion.",
