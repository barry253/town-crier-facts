  "facts": [
    {
      "id": 1,
      "text": "Henderson was platted in 1887 when the Fremont, Elkhorn & Missouri Valley Railroad reached the town.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Henderson%2C_Nebraska"
    },
    {
      "id": 2,
      "text": "The town’s name honors pioneer settler David Henderson, after whom the city was named.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Henderson%2C_Nebraska"
    },
    {
      "id": 3,
      "text": "The Mennonite Heritage Park and Museum, located just north of town, preserves the community’s early immigrant history.",
      "sourceSentenceIds": [
        5,
        8
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://hendersonheritage.org/"
    },
    {
      "id": 4,
      "text": "A bronze sculpture, Water: Life Blood of Agriculture, celebrates Henderson’s pioneering role in crop irrigation.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.nebraskatravelerguide.com/places/york/henderson/"
    },
    {
      "id": 5,
      "text": "Henderson Heritage & Tourism, founded in 1994, documents the town’s history and Mennonite heritage through events and archives.",
      "sourceSentenceIds": [
        4
      ],
