  "facts": [
    {
      "id": 1,
      "text": "Estrela’s name comes from the Portuguese word for star, reflected in the dome of the Basílica da Estrela.",
      "sourceSentenceIds": [
        13
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Estrela%2C_Lisbon",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The neighborhood sits halfway up the hill between São Bento and Campo de Ourique, making it a natural lookout over Lisbon.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://nowinportugal.com/estrela-lisbon-neighborhood-guide/",
      "category": "other",
      "quality": "poor",
      "qualityReason": "location_description"
    },
    {
      "id": 3,
      "text": "Basílica da Estrela, built in 1790, houses Queen Maria I’s tomb and a baroque nativity scene with over 500 terracotta figures.",
      "sourceSentenceIds": [
        22
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.lisbonportugaltourism.com/guide/estrela.html",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Jardim da Estrela, laid out in 1852 in a romantic English style, features duck ponds, a wrought‑iron bandstand, and a gazebo that hosts summer concerts.",
      "sourceSentenceIds": [
        6,
        9
      ],
      "sourceLabels": [
        "Web source 1",
        "Web source 2"
      ],
      "source": "https://www.lisbonportugaltourism.com/guide/estrela.html",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The English Cemetery across from the garden contains the grave of novelist Henry Fielding, author of “Tom Jones.”.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.lisbonportugaltourism.com/guide/estrela.html",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Trams 25 and 28 stop right outside the basilica, giving commuters a direct link to the historic center.",
      "sourceSentenceIds": [
        5
