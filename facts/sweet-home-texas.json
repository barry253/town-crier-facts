  "facts": [
    {
      "id": 1,
      "text": "Founded in 1852 along the Spanish Trail, Sweet Home blossomed into a cotton hub until the 1887 railroad bypassed it.",
      "sourceSentenceIds": [
        1,
        6,
        11
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://unitedstatesghosttowns.com/sweet-home-texas-ghost-town/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Once home to 350 residents, a dozen stores, and a recreation hall, Sweet Home now hosts fewer than 50 people.",
      "sourceSentenceIds": [
        26
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://unitedstatesghosttowns.com/sweet-home-texas-ghost-town/",
      "category": "people",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The Providence Missionary Baptist Church stays active, and annual homecomings keep Sweet Home’s community spirit alive amid abandoned buildings.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://unitedstatesghosttowns.com/sweet-home-texas-ghost-town/",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Czech and German settlers arrived in 1873, adding cultural flavors to Sweet Home’s Black‑settled cotton and grain farming community.",
      "sourceSentenceIds": [
        7,
        5
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://unitedstatesghosttowns.com/sweet-home-texas-ghost-town/",
      "category": "people",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The old cemetery, founded in 1898, preserves family histories at Sweet Home’s original townsite.",
