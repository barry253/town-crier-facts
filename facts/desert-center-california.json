      ],
      "source": "https://en.wikipedia.org/wiki/Desert_Center%2C_California",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "In 1992, a roadside historical marker honored Desert Center as the birthplace of Kaiser Permanente, tracing its roots back to a local hospital.",
      "sourceSentenceIds": [
        18,
