  "facts": [
    {
      "id": 1,
      "text": "Bloomsbury, New Jersey was once known as 'Johnson's Iron Works', named after Robert Johnson, who owned the site along the Musconetcong River.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Bloomsbury%2C_New_Jersey",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The name 'Bloomsbury' may come from the influential Bloom family or from the iron ore processed into masses known as 'blooms'.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Bloomsbury%2C_New_Jersey",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Bloomsbury was incorporated as a borough on March 30, 1905, from parts of Bethlehem Township by the New Jersey Legislature.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Bloomsbury%2C_New_Jersey",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Bloomsbury, New Jersey is located on the south side of the Musconetcong River and is the third-smallest municipality in Hunterdon County.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Bloomsbury%2C_New_Jersey",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The borough borders several municipalities, including Bethlehem Township in Hunterdon County and Franklin Township in Warren County.",
