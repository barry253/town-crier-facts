      ],
      "source": "https://grokipedia.com/page/Juliette,_Georgia",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The 1938 Whistle Stop Café, once a family grocery, was filmed for the 1991 movie *Fried Green Tomatoes* and now serves Southern fare to visitors.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 1"
      ],
