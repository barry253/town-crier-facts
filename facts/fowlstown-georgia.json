  "facts": [
    {
      "id": 1,
      "text": "Fowlstown is an unincorporated community in Decatur County, Georgia, located on GA State Route 309, 7.3 miles south of Bainbridge.",
      "sourceSentenceIds": [
        10,
        11
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Fowlstown%2C_Georgia",
      "category": "other",
      "quality": "poor",
      "qualityReason": "location_description"
    },
    {
      "id": 2,
      "text": "The village’s name comes from the Creek word Tutalosi Talofa, meaning “Fowltown,” and was led by chief Neamathla, a “large” or “exceptionally brave” warrior.",
      "sourceSentenceIds": [
        25,
        26,
        27
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://exploresouthernhistory.com/fowltown.html",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "In 1817 the Battle of Fowltown ignited the First Seminole War, fought a few miles south of present‑day Bainbridge near Fowlstown Swamp.",
      "sourceSentenceIds": [
        13,
        20,
        22,
        24
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://exploresouthernhistory.com/fowltown.html",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The exact site of the battle is lost, but a historical marker erected by the Historic Chattahoochee Commission stands in the vicinity of the former village.",
      "sourceSentenceIds": [
        1,
        8
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://dlg.usg.edu/record/dlg_ghm_village-of-fowltown",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The Fowlstown Swamp, shown on 1820s land surveys, was once almost completely surrounded by swamp, making it a strategic location during the 1817 conflict.",
      "sourceSentenceIds": [
        23,
        24
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://exploresouthernhistory.com/fowltown.html",
      "category": "nature",
      "quality": "good"
    }
  ],
