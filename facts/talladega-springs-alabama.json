  "facts": [
    {
      "id": 1,
      "text": "Talladega Springs began as Sulphur Springs, a health‑treat town where visitors drank sulfur‑rich water believed to cure ailments.",
      "sourceSentenceIds": [
        2,
        10,
        30
      ],
      "sourceLabels": [
        "Web source 1",
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://encyclopediaofalabama.org/article/talladega-springs/",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "In the late 1800s the Louisville & Nashville Railroad extended a line to Talladega Springs, bringing daily trains to the town.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://encyclopediaofalabama.org/article/talladega-springs/",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Talladega Springs officially incorporated in 1913, after having been known by its earlier name since 1845.",
      "sourceSentenceIds": [
        9,
        25
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Talladega_Springs%2C_Alabama",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The town once housed a Coca‑Cola bottling plant, a rare industrial claim for a small Alabama resort.",
      "sourceSentenceIds": [
        1,
        3
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Talladega_Springs%2C_Alabama",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Today the original sulfur springs still flow along the Sulphur Branch of the Coosa River, a reminder of the town’s healing roots.",
      "sourceSentenceIds": [
        30
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://encyclopediaofalabama.org/article/talladega-springs/",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "After Lay Dam’s construction in 1914, part of Talladega Springs was submerged beneath the newly formed Lay Lake.",
