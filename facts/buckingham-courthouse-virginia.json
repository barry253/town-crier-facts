  "facts": [
    {
      "id": 1,
      "text": "Buckingham town founded 1818, originally called Maysville before adopting the county name.",
      "sourceSentenceIds": [
        1,
        2
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Buckingham%2C_Virginia",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The first courthouse, completed in 1822, was Virginia’s first temple‑style, porticoed building designed by Thomas Jefferson.",
      "sourceSentenceIds": [
        8,
        24
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Buckingham%2C_Virginia",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "That Jefferson‑designed courthouse burned in 1869 and was rebuilt on the same site in 1873, echoing its original lines.",
      "sourceSentenceIds": [
        27
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.dhr.virginia.gov/historic-registers/014-0111/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The courthouse and surrounding historic district were added to the National Register of Historic Places in 1969.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Buckingham%2C_Virginia",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "During the Civil War, General Lee passed through Buckingham after Appomattox, pitching his last tent just east of town.",
      "sourceSentenceIds": [
        28,
        29
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.dhr.virginia.gov/historic-registers/014-0111/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The Buckingham Courthouse Historic District, including the courthouse and nearby taverns, showcases Jeffersonian architecture and early 19th‑century civic life.",
      "sourceSentenceIds": [
        25,
        26
