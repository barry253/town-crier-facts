  "facts": [
    {
      "id": 1,
      "text": "McKeansburg was founded in 1834 and is the oldest town in Schuylkill County.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.mckeansburghotel.com/history"
    },
    {
      "id": 2,
      "text": "The town’s name honors Thomas McKean, Pennsylvania’s second governor, who served from 1799 to 1808.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.mckeansburghotel.com/history"
    },
    {
      "id": 3,
      "text": "The first house in McKeansburg appeared in 1803 on the site now occupied by the historic hotel that stands today.",
      "sourceSentenceIds": [
        22
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.mckeansburghotel.com/history"
    },
    {
      "id": 4,
      "text": "In 1818 the township expanded by adding land from Columbia and Lehigh counties, shaping its current borders.",
      "sourceSentenceIds": [
        25
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.mckeansburghotel.com/history"
    },
    {
      "id": 5,
      "text": "McKeansburg sits just west of the Little Schuylkill River, whose waters flow south into the larger Schuylkill River.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/McKeansburg%2C_Pennsylvania"
    },
    {
      "id": 6,
      "text": "The town once hosted the county’s first jail and was even considered for the county seat before Orwigsburg won.",
      "sourceSentenceIds": [
        21
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.mckeansburghotel.com/history"
