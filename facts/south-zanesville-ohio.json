  "facts": [
    {
      "id": 1,
      "text": "South Zanesville was platted in 1890 by a syndicate of Zanesville capitalists who secretly assembled land for development.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/south_zanesville_ohio",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The village offered free factory lots from its founding to attract brickworks, wagon production, and ceramics, turning former cornfields into an industrial hub.",
      "sourceSentenceIds": [
        2,
        9
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/south_zanesville_ohio",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "A 500‑acre Merriam farm, once a Shawnee hunting ground, served as a station on the Underground Railroad.",
      "sourceSentenceIds": [
        14,
        5,
        6
      ],
      "sourceLabels": [
        "Web source 1",
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/south_zanesville_ohio",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The South Zanesville Sewer Pipe and Brick Company, incorporated in 1890, produced up to 30,000 bricks daily with 30 employees.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/south_zanesville_ohio",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Water works completed in 1938–1939 with WPA assistance marked a major public works milestone for the village.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/south_zanesville_ohio",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "South Zanesville sits along the Muskingum River near the mouth of Moxahala Creek, defining its early settlement location.",
      "sourceSentenceIds": [
