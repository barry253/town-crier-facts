    {
      "id": 1,
      "text": "Heartland Village earned its name from a 1960s housing project designed to project optimism, unity, and middle‑class stability.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.cityneighborhoods.nyc/heartland-village",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Nestled between Richmondtown and New Springville, Heartland Village sits on a gently rolling plateau once covered by farmland and forests.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.cityneighborhoods.nyc/heartland-village",
      "category": "nature",
      "quality": "poor",
      "qualityReason": "location_description"
    },
    {
      "id": 3,
      "text": "Construction of Heartland Village began in the late 1960s and continued through the early 1980s.",
      "sourceSentenceIds": [
        15
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Heartland_Village%2C_Staten_Island",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "In 1976, two schools opened in the community: an elementary school and Rocco Laurie Intermediate School.",
      "sourceSentenceIds": [
        19,
        20
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Heartland_Village%2C_Staten_Island",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The Verrazzano–Narrows Bridge opened in 1964, sparking the rise of large residential developments like Heartland Village.",
      "sourceSentenceIds": [
        13,
        14
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Heartland_Village%2C_Staten_Island",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Heartland Village lies at Staten Island’s geographic and symbolic center, epitomizing the borough’s postwar suburban transformation.",
