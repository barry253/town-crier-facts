  "facts": [
    {
      "id": 1,
      "text": "Riverdale was built between 1946 and 1950 to house workers constructing the Garrison Dam.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.riverdalenorthdakota.com/about-us/"
    },
    {
      "id": 2,
      "text": "The city’s streets are named after states in the Missouri Basin, including Colorado, Iowa, and Montana.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.riverdalenorthdakota.com/about-us/"
    },
    {
      "id": 3,
      "text": "After the dam finished in 1953, residents from nearby camps moved into Riverdale, making it the largest of those camps.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Riverdale%2C_North_Dakota"
    },
    {
      "id": 4,
      "text": "The federal government ran Riverdale until 1986, when the US Army Corps of Engineers turned it over to the state, and it incorporated shortly after.",
      "sourceSentenceIds": [
        9,
        29
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Riverdale%2C_North_Dakota"
    },
    {
      "id": 5,
      "text": "Riverdale’s high school closed in 1992, and the former building was converted into a hotel and restaurant.",
      "sourceSentenceIds": [
        24,
        26
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Riverdale%2C_North_Dakota"
    },
    {
