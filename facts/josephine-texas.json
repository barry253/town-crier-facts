      "quality": "poor",
      "qualityReason": "location_description"
    },
    {
      "id": 2,
      "text": "The Louisiana and Texas Railway reached the area and named the town after the daughter of a railroad official.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.tshaonline.org/handbook/entries/josephine-tx",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Josephine lies just four miles east of Lavon Lake, offering a quiet riverside setting.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
