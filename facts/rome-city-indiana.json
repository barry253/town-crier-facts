      "quality": "good"
    },
    {
      "id": 2,
      "text": "A post office has been operating in Rome City since 1868, keeping the town connected for over a century.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Rome_City%2C_Indiana",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The town sits along Indiana State Road 9 beside Sylvan Lake, a popular spot for fishing and boating.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Rome_City%2C_Indiana",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Author Gene Stratton‑Porter lived at her lakeside estate, the Cabin at Wildflower Woods, near Rome City from 1913 to 1919.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Rome_City%2C_Indiana",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Scenes from the 1927 film adaptation of Stratton‑Porter’s novel *The Harvester* were shot at Wildflower Woods.",
