      ],
      "source": "https://en.wikipedia.org/wiki/Inland_Empire",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The historic Milk Creek No. was developed in Riverside in 1893, marking a key moment in the town’s early industrial growth.",
      "sourceSentenceIds": [
        15
      ],
      "sourceLabels": [
