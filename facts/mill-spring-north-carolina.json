  "facts": [
    {
      "id": 1,
      "text": "Mill Spring is named after Colonel Ambrose Mills, a Loyalist who built a sawmill and post office in the late 1700s.",
      "sourceSentenceIds": [
        1,
        3,
        4
      ],
      "sourceLabels": [
        "Web source 1",
        "Wikipedia"
      ],
      "source": "https://grokipedia.com/page/mill_spring_north_carolina",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "In 1767 Governor William Tryon negotiated a treaty with Cherokee, setting a boundary that included Mill Spring.",
      "sourceSentenceIds": [
        2,
        9
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/mill_spring_north_carolina",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The 1925 Turner Shoals Dam created a 371‑acre reservoir that now serves as a sediment trap and recreation spot.",
      "sourceSentenceIds": [
        6,
        7
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/mill_spring_north_carolina",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Mill Spring’s mixed hardwood forests feature dry‑mesic oak‑hickory on upper slopes and basic‑mesic on lower north‑facing areas.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/mill_spring_north_carolina",
