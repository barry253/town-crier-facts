  "facts": [
    {
      "id": 1,
      "text": "Bartow was originally known as Traveller's Repose before being renamed after Confederate Colonel Francis S. Bartow.",
      "sourceSentenceIds": [
        4,
        14
      ],
      "sourceLabels": [
        "Web source 1",
        "Wikipedia"
      ],
      "source": "https://grokipedia.com/page/bartow_west_virginia"
    },
    {
      "id": 2,
      "text": "The community of Bartow was first settled in the late 18th century by German immigrant families.",
      "sourceSentenceIds": [
        19
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/bartow_west_virginia"
    },
    {
      "id": 3,
      "text": "The historic Traveller's Repose inn once served as a key stop for travelers and hosted Abraham Lincoln.",
      "sourceSentenceIds": [
        21
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/bartow_west_virginia"
    },
    {
      "id": 4,
      "text": "Confederate forces established Camp Bartow in July 1861 to defend the Allegheny passes during the Civil War.",
      "sourceSentenceIds": [
        22,
        24
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/bartow_west_virginia"
    },
    {
      "id": 5,
      "text": "The Battle of Greenbrier River took place in October 1861 about one mile southeast of present-day Bartow.",
      "sourceSentenceIds": [
        15
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Bartow%2C_West_Virginia"
    },
    {
      "id": 6,
      "text": "Bartow sits at an elevation of approximately 2,772 feet within the Appalachian Mountains.",
