  "facts": [
    {
      "id": 1,
      "text": "Lowell was founded in 1826 as a planned textile mill town named after Francis Cabot Lowell, a pioneer industrialist.",
      "sourceSentenceIds": [
        20,
        23,
        19
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 2"
      ],
      "source": "https://en.wikipedia.org/wiki/Lowell%2C_Massachusetts",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town sits on the Merrimack River's Pawtucket Falls, where Boston merchants harnessed water power for the first American textile mills.",
      "sourceSentenceIds": [
        2,
        22
      ],
      "sourceLabels": [
        "Web source 1",
        "Wikipedia"
      ],
      "source": "https://www.nps.gov/articles/lowell.htm",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Lowell National Historical Park preserves the original mill district and offers boat tours through historic locks and canals built by early Irish immigrants.",
      "sourceSentenceIds": [
        7,
        24
      ],
      "sourceLabels": [
        "Web source 1",
        "Wikipedia"
      ],
      "source": "https://www.nps.gov/articles/lowell.htm",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The Boott Cotton Mills Museum, part of the park, showcases the life of the 'mill girls' who worked in the factories during the 19th century.",
      "sourceSentenceIds": [
        6,
        8
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Lowell%2C_Massachusetts",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Lowell hosts the annual African Festival and the Lowell Folk Festival, drawing hundreds of thousands of visitors each summer.",
      "sourceSentenceIds": [
        17
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Lowell%2C_Massachusetts",
      "category": "people",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Birthplace of artist James Abbott McNeill Whistler and author Jack Kerouac, Lowell has produced several nationally recognized cultural figures.",
      "sourceSentenceIds": [
        16
