    {
      "id": 1,
      "text": "Alexandria was first settled around 1834, originally called Coffeeville in honor of General John Coffee.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/alexandria_alabama"
    },
    {
      "id": 2,
      "text": "The town's name changed to Alexandria as it grew into a post office and railroad station hub.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/alexandria_alabama"
    },
    {
      "id": 3,
      "text": "Alexandria was incorporated as a town in 1880, solidifying its municipal status.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Alexandria%2C_Alabama"
    },
    {
      "id": 4,
      "text": "The community lies near the center of Calhoun County, Alabama, serving as a quiet rural enclave.",
      "sourceSentenceIds": [
        16
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Alexandria%2C_Alabama"
    },
    {
      "id": 5,
      "text": "Alexandria is part of the Anniston–Oxford Metropolitan Statistical Area, linking it to a larger regional economy.",
      "sourceSentenceIds": [
        15
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Alexandria%2C_Alabama"
    },
    {
      "id": 6,
      "text": "To the south, Alexandria borders the Saks census-designated place, a neighboring community within Calhoun County.",
