      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/New_London%2C_Missouri"
    },
    {
      "id": 3,
      "text": "The Ralls County Courthouse, built in 1858, is the oldest courthouse in Missouri and houses a WWI cannon in its front yard.",
      "sourceSentenceIds": [
        6,
        11,
        15,
        16
      ],
