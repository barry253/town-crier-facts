  "facts": [
    {
      "id": 1,
      "text": "Anahuac was named in January 1831 by Manuel de Mier y Terán after the ancient Aztec capital, linking the town to pre‑colonial history.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.tshaonline.org/handbook/entries/anahuac-tx",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The 1832 and 1835 Anahuac Disturbances—battles over Mexican taxes—helped ignite the Texas Revolution that freed Texas from Mexico.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Anahuac%2C_Texas",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "In 1963 the U.S. Fish and Wildlife Service established the Anahuac National Wildlife Refuge, a 16‑mile stretch of coastal marshes southeast of the city.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Anahuac%2C_Texas",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Anahuac hosts the Chambers County Library, a branch that serves the community with regional historical collections.",
      "sourceSentenceIds": [
        26
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Anahuac%2C_Texas",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The town sits on the northeast bank of Trinity Bay, making it the county seat of Chambers County on Texas’s Gulf Coast.",
