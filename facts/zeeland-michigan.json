  "facts": [
    {
      "id": 1,
      "text": "Zeeland, Michigan, takes its name from the Dutch province of Zeeland, reflecting the heritage of its 1847 settlers.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Zeeland%2C_Michigan",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "In 1847, 457 Dutch settlers, led by Jannes Vande Luyster, arrived seeking religious and political freedom to build Zeeland.",
      "sourceSentenceIds": [
        17
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.cityofzeeland.com/history/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The Dekker Huis Museum, housed in an 1876 family home, showcases over 20,000 artifacts that trace Zeeland’s early history.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.cityofzeeland.com/history/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Within twenty-five years of its founding, Zeeland boasted a sawmill, wagon factory, blacksmith shops, and a bustling post office.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Zeeland%2C_Michigan",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Early 1900s Zeeland flourished with a creamery, canning factory, three general stores, a blacksmith shop, and a harness shop.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Web source 1"
      ],
