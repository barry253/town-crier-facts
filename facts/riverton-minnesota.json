  "facts": [
    {
      "id": 1,
      "text": "Riverton got its name from the nearby Rabbit River, a tributary that helped shape the town’s early settlement.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Riverton%2C_Minnesota"
    },
    {
      "id": 2,
      "text": "The city officially incorporated in 1912, marking its transition from a frontier outpost to a structured municipality.",
      "sourceSentenceIds": [
        19
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Riverton%2C_Minnesota"
    },
    {
      "id": 3,
      "text": "A Riverton post office operated from 1913 until 1965, serving the community for over five decades.",
      "sourceSentenceIds": [
        20
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Riverton%2C_Minnesota"
    },
    {
      "id": 4,
      "text": "The Northern Pacific Railroad once had a station in Riverton, connecting the town to regional trade routes.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.lakesnwoods.com/Riverton.htm"
    },
    {
      "id": 5,
      "text": "In 1855, the Rabbit Lake Indian Reservation for the Rabbit Lake Band of Mississippi Chippewa was established here by the Treaty of Washington.",
      "sourceSentenceIds": [
