  "facts": [
    {
      "id": 1,
      "text": "Koukaki derives its name from 19th‑century businessman Georgios Koukakis, who founded an iron‑and‑steel bed factory that supplied Athens’ bourgeoisie.",
      "sourceSentenceIds": [
        5,
        6,
        7
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://koukaki.online/history-roots/",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Located just south of the Acropolis and bordered by Philopappou Hill and Syngrou Avenue, Koukaki is a dense palimpsest of history.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://koukaki.online/history-roots/",
      "category": "other",
      "quality": "poor",
      "qualityReason": "other"
    },
    {
      "id": 3,
      "text": "The 2000 opening of the Acropoli and Syngrou‑Fix metro stations made Koukaki one of Athens’ most accessible neighborhoods.",
      "sourceSentenceIds": [
        15
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://koukaki.online/history-roots/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Koukaki’s most recent transformation began in preparation for the 2004 Olympic Games.",
      "sourceSentenceIds": [
        16
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://koukaki.online/history-roots/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Every Friday, Koukaki hosts a lively weekly vegetable market on Veikou Street.",
      "sourceSentenceIds": [
        21
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Koukaki",
      "category": "culture",
      "quality": "good"
    },
    {
