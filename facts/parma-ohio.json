  "facts": [
    {
      "id": 1,
      "text": "Parma was settled by New Englanders in 1816, originally called Greenbriar, renamed Parma in 1826 after the Italian city.",
      "sourceSentenceIds": [
        3,
        23,
        24,
        25
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.britannica.com/place/Parma-Ohio",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The area that became Parma was first surveyed in 1806 by Abraham Tappan of the Connecticut Land Company, known as Township 6 – Range 13.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Parma%2C_Ohio",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The first settlers were Benajah Fay, his wife Ruth, and their ten children, arriving from Lewis County, New York, in 1816.",
      "sourceSentenceIds": [
        20
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Parma%2C_Ohio",
      "category": "people",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Parma hosts the Henninger House and West Creek Watershed, preserved by the West Creek Preservation Agency.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Parma%2C_Ohio",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Local musician Bob \"Mad Dog\" McGuire wrote the song \"Moon Over Parma\" about a quirky courtship across Cleveland suburbs.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
