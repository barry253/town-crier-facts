  "facts": [
    {
      "id": 1,
      "text": "Atherton was originally called Fair Oaks and served as a flag stop for Southern Pacific Railroad in 1866.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.athertonca.gov/96/History-of-Atherton",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town was renamed in honor of Faxon Dean Atherton, a 19th‑century landowner, after the name Fair Oaks was already taken.",
      "sourceSentenceIds": [
        22
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Atherton%2C_California",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The Holbrook‑Palmer Estate, donated in 1958, now operates as a 22‑acre public park listed on the National Register of Historic Places.",
      "sourceSentenceIds": [
        15
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Atherton%2C_California",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Atherton’s zoning allows only one single‑family home per acre, a rule that keeps the town’s streets lined with sprawling estates.",
      "sourceSentenceIds": [
        17
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Atherton%2C_California",
      "category": "other",
      "quality": "poor",
      "qualityReason": "editorial_filler"
    },
    {
      "id": 5,
      "text": "In 1923, Menlo Park tried to annex Fair Oaks, but residents chose to incorporate separately, keeping Atherton independent.",
      "sourceSentenceIds": [
        21
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Atherton%2C_California",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The town’s library, part of the Peninsula Library System, is a hub for local history and community events.",
      "sourceSentenceIds": [
        14
