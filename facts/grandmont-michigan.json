  "facts": [
    {
      "id": 1,
      "text": "Grandmont officially joined Detroit in 1923, sparking a wave of neighborly community building that still thrives today.",
      "sourceSentenceIds": [
        11
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://thegrandmontcommunity.org/history/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Back in 1835, Andrew Jackson deeded the 80 acres that would become Grandmont to Thomas Norton, laying the groundwork for the neighborhood.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://thegrandmontcommunity.org/history/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The Second Baptist Church once served as a station on the Underground Railroad, a quiet testament to Grandmont’s role in civil‑rights history.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/List_of_neighborhoods_in_Detroit",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "A 140‑acre green space, Palmer Park, borders Grandmont, offering residents a sizable natural retreat right on the city’s edge.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/List_of_neighborhoods_in_Detroit",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "In 1880, a family named the David’s purchased 40 acres from the Harrows for just $300, a modest transaction that helped shape the area’s early development.",
