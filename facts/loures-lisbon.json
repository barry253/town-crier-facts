  "facts": [
    {
      "id": 1,
      "text": "Early human settlement in Loures dates back to the Upper Paleolithic, with discoveries at the Cave of Pego do Diabo and the Cave of Salemas.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Loures",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Neolithic burial chambers such as the Anta de Carcavelos and the Anta do Alto da Toupeira highlight the area’s ancient funerary landscape.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Loures",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "During the 1st millennium, Loures was a Roman settlement centered around a cemetery that later became the site of the first church.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Loures",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "After the Templars were disbanded in 1311, their lands in Loures passed to the Order of Christ, which rebuilt a church over a 4th‑century temple.",
      "sourceSentenceIds": [
        14,
        17
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Loures",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "In 1598, the plague drove Lisbon residents to the elevated village of Montemor, where they built the Chapel of Nossa Senhora da Saúde for protection.",
      "sourceSentenceIds": [
        18,
        20
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Loures",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Loures achieved town status on 26 October 1926 and later became a city on 9 August 1990.",
      "sourceSentenceIds": [
        24
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Loures",
      "category": "history",
      "quality": "good"
    }
