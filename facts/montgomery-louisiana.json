      "id": 1,
      "text": "Montgomery was founded as a French trading post called Bon Dieu Falls in 1719, predating New Orleans by one year.",
      "sourceSentenceIds": [
        13
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/montgomery_louisiana",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town moved east about two miles to the railroad station in 1902, shifting from river trade to rail.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://townofmontgomery.wixsite.com/montgomery/untitled",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The Red River, originally named Rigolette de Bon Dieu, now flows by the bluffs at Montgomery.",
      "sourceSentenceIds": [
        11
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://townofmontgomery.wixsite.com/montgomery/untitled",
      "category": "landmark",
      "quality": "good"
    },
    {
