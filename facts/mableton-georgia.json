  "facts": [
    {
      "id": 1,
      "text": "Mableton takes its name from Scottish immigrant Robert Mable, who bought 300 acres in 1843.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Mableton%2C_Georgia",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "When the Georgia Pacific Railway opened a station in December 1881, Mableton quickly became a commercial hub.",
      "sourceSentenceIds": [
        1,
        6
      ],
      "sourceLabels": [
        "Web source 1",
        "Wikipedia"
      ],
      "source": "https://www.mableton.com/information/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The first train from Atlanta arrived at Mableton’s station just before Christmas 1881.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Mableton%2C_Georgia",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Today the Robert Mable House and Cemetery serve as a historic site and venue for public events.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.mableton.com/information/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Mableton lies roughly 15 miles west‑northwest of Atlanta, about 20 miles from the city’s international airport.",
      "sourceSentenceIds": [
        15
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Mableton%2C_Georgia",
      "category": "other",
      "quality": "poor",
      "qualityReason": "location_description"
    },
    {
      "id": 6,
      "text": "Before settlers arrived, two Native American villages—Sweet Water Town and Nickajack—once dotted the area now known as Mableton.",
