  "facts": [
    {
      "id": 1,
      "text": "Chambly began as a parish in 1665, marking the first European settlement in the area.",
      "sourceSentenceIds": [
        4,
        5
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 2"
      ],
      "source": "https://en.wikipedia.org/wiki/Chambly%2C_Quebec",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Fort Chambly, originally Fort Saint-Louis, was renamed after commander Jacques de Chambly in 1672.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Chambly%2C_Quebec",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Today the fort is a National Historic Site run by Parks Canada, featuring a museum and reenactments.",
      "sourceSentenceIds": [
        8,
        17,
        18
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 2"
      ],
      "source": "https://en.wikipedia.org/wiki/Chambly%2C_Quebec",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The Chambly Canal, also a National Historic Site, was built to bypass rapids on the Richelieu River.",
      "sourceSentenceIds": [
        9,
        19
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 2"
      ],
      "source": "https://en.wikipedia.org/wiki/Chambly%2C_Quebec",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The historic area around Chambly Basin showcases the old fort, canal locks, and islands like Goyer and Demers.",
      "sourceSentenceIds": [
        15
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://en.wikivoyage.org/wiki/Chambly",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Opera legend Emma Albani, born in Chambly in 1847, is honored in a museum at the Cultural Centre.",
      "sourceSentenceIds": [
        7,
        10
      ],
      "sourceLabels": [
        "Web source 2"
