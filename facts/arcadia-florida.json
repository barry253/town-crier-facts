      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Arcadia%2C_Florida",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The city’s citrus industry once thrived, but citrus greening disease has recently damaged the local economy.",
      "sourceSentenceIds": [
        11,
        25
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Arcadia%2C_Florida",
      "category": "economy",
      "quality": "good"
    },
    {
