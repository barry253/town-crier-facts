  "facts": [
    {
      "id": 1,
      "text": "Somerset was first settled in 1677 on Shawomet lands and officially incorporated in 1790.",
      "sourceSentenceIds": [
        21
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Somerset%2C_Massachusetts",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "After the War of 1812, Somerset emerged as one of America's chief distribution points.",
      "sourceSentenceIds": [
        22
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Somerset%2C_Massachusetts",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "In 1872 Somerset became a major coal port, and a large cannery operated there in the early 20th century.",
      "sourceSentenceIds": [
        23
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Somerset%2C_Massachusetts",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The double‑decker Slade's Ferry Bridge, with a railroad on its top level, linked Somerset to Fall River until its 1970 dismantling.",
      "sourceSentenceIds": [
        11,
        25
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Somerset%2C_Massachusetts",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Founded in 1955, the Somerset Historical Society preserves local heritage and runs a museum in the former Village School.",
      "sourceSentenceIds": [
        4,
        12
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://somersethistoricalsociety.com/",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Today, Somerset’s main industry is power generation, centered on the Montaup Electric Company plant (1923) and Brayton Point Power Station (1963).",
