  "facts": [
    {
      "id": 1,
      "text": "Beach City sits on Farm Road 2354 along the northwestern shore of Trinity Bay, about nine miles southeast of Baytown.",
      "sourceSentenceIds": [
        6,
        24
      ],
      "sourceLabels": [
        "Web source 1",
        "Wikipedia"
      ],
      "source": "https://www.tshaonline.org/handbook/entries/beach-city-tx"
    },
    {
      "id": 2,
      "text": "In 1970, Beach City annexed the land that now hosts its Community Building and volunteer fire station.",
      "sourceSentenceIds": [
        20
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Beach_City%2C_Texas"
    },
    {
      "id": 3,
      "text": "The city’s historic core includes the former home site of pioneer Solomon Barrow, whose land later became McCollum Park.",
      "sourceSentenceIds": [
        4,
        5
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Beach_City%2C_Texas"
    },
    {
      "id": 4,
      "text": "Beach City grew from a handful of fishing camps into a permanent community of about 500 residents by the early 1960s.",
      "sourceSentenceIds": [
        28
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Beach_City%2C_Texas"
    },
    {
      "id": 5,
      "text": "The area that became Beach City was originally part of three smaller towns that merged into Baytown in 1948.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Beach_City%2C_Texas"
    },
    {
      "id": 6,
      "text": "Beach City’s name reflects its coastal heritage, with “Beach” highlighting its shoreline location on Trinity Bay.",
      "sourceSentenceIds": [
        6
      ],
