  "facts": [
    {
      "id": 1,
      "text": "Doney Park takes its name from Ben Doney, a pioneering rancher who settled here in the late 1800s.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/doney_park_arizona",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "At about 7,000 feet, Doney Park enjoys a cold semi‑arid climate with four distinct seasons.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/doney_park_arizona",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "In 1936, residents created the Doney Park Water Company, a member‑owned cooperative that still supplies water today.",
      "sourceSentenceIds": [
        21
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/doney_park_arizona",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Doney’s original 1890 cabin was moved to Flagstaff’s Pioneer Museum in 1967, preserving a frontier link.",
      "sourceSentenceIds": [
        20
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/doney_park_arizona",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The community sits on flat, gently rolling meadows that are part of a high‑elevation plateau dotted with ponderosa pines.",
      "sourceSentenceIds": [
        8,
        28
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/doney_park_arizona",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Doney Park lies just east of the San Francisco Peaks, offering sweeping views of Arizona’s tallest range.",
      "sourceSentenceIds": [
        4,
        11
      ],
