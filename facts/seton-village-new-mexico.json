  "facts": [
    {
      "id": 1,
      "text": "Ernest Thompson Seton founded Seton Village in 1930 as an intentional community focused on nature and artistic exploration.",
      "sourceSentenceIds": [
        22
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Seton_Village"
    },
    {
      "id": 2,
      "text": "Seton began building a 32‑room, 6,900‑square‑foot castle in 1933, but it burned during a 2005 restoration.",
      "sourceSentenceIds": [
        28,
        25
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Seton_Village"
    },
    {
      "id": 3,
      "text": "Seton Village earned National Historic Landmark status in 1965, recognizing its unique cultural heritage.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Seton_Village"
    },
    {
      "id": 4,
      "text": "After a fire, the Seton Memorial Library was rebuilt into a trove of natural history, art books, and conservation writings.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://setonvillageneighborhood.org/seton-village-unveiling-the-artistic-and-spiritual-roots-of-santa-fe-s-hidden-gem/"
    },
    {
      "id": 5,
      "text": "Two buildings in the village were fashioned around railroad cars Seton brought, finished plaster inside with adobe walls.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Seton_Village"
    },
    {
      "id": 6,
      "text": "The Academy for the Love of Learning preserved Seton Castle’s footprint and stone walls, turning them into a historical and meditation garden.",
