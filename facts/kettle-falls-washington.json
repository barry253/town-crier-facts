  "facts": [
    {
      "id": 1,
      "text": "Kettle Falls takes its name from the original waterfall on the Columbia River, which was submerged when Grand Coulee Dam was built.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Kettle_Falls%2C_Washington"
    },
    {
      "id": 2,
      "text": "Before the dam flooded the area in 1940, residents moved the town to Meyers Falls, a nearby railroad hub.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Kettle_Falls%2C_Washington"
    },
    {
      "id": 3,
      "text": "Two bridges—one for traffic and one for trains—were erected before the dam and later listed on the National Register of Historic Places.",
      "sourceSentenceIds": [
        9,
        10
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.cityofkettlefalls.org/history"
    },
    {
      "id": 4,
      "text": "The People of the Falls Interpretive Center lets visitors explore 9,000 years of regional history right in Kettle Falls.",
      "sourceSentenceIds": [
        11
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.cityofkettlefalls.org/history"
    },
    {
      "id": 5,
      "text": "Kettle Falls sits on the Colville River just upstream from where it meets the Columbia River.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Kettle_Falls%2C_Washington"
    },
    {
      "id": 6,
      "text": "Lake Roosevelt, the reservoir created by the Columbia River, borders Kettle Falls and lies about 30 miles south of the U.S.–Canada border.",
