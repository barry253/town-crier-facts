  "facts": [
    {
      "id": 1,
      "text": "Findlay began in 1821 when Joseph Vance and Elnathan Corry laid out the first town lots.",
      "sourceSentenceIds": [
        28
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Findlay%2C_Ohio",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The city honors Colonel James Findlay, a War of 1812 commander who built a stockade and road in the Great Black Swamp.",
      "sourceSentenceIds": [
        15,
        26
      ],
      "sourceLabels": [
        "Web source 1",
        "Wikipedia"
      ],
      "source": "https://www.findlayohio.gov/community/visitors",
      "category": "people",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Before the Civil War, Findlay served as a stop on the Underground Railroad, sheltering escaping slaves.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Findlay%2C_Ohio",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Cooper Tire & Rubber Company, founded in 1914, turned Findlay into a national hub for tire manufacturing that still operates today.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Findlay%2C_Ohio",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The original Findlay Public Library opened in 1888 in the courthouse basement before moving to a former post office in 1935.",
      "sourceSentenceIds": [
        4,
        21
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Findlay%2C_Ohio",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Central, a historic building on West Main Cross, was Findlay’s high school until 1963 and now stands as a city landmark.",
