  "facts": [
    {
      "id": 1,
      "text": "Clementon takes its name from Samuel Clement, who bought a glass works in 1811 and christened the settlement Clementon village.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Clementon%2C_New_Jersey",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The borough officially formed on February 13, 1925, after a March 17 referendum split it from Clementon Township.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Clementon%2C_New_Jersey",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Clementon Lake shelters the historic Clementon Amusement Park, once home to the 1919 Jack Rabbit wooden roller coaster.",
      "sourceSentenceIds": [
        13,
        14
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Clementon%2C_New_Jersey",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Around 1800, Jonathon Haines erected a glass factory on a hill that later became the site of modern Clementon Park.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Clementon%2C_New_Jersey",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "In 1961, dirt, gravel and marl removed from that hill supplied material for a planned new post office.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Clementon%2C_New_Jersey",
      "category": "other",
      "quality": "poor",
      "qualityReason": "other"
    },
    {
      "id": 6,
      "text": "Clementon borders Berlin Borough, Lindenwold, Pine Hill and Pine Valley within Camden County.",
