  "facts": [
    {
      "id": 1,
      "text": "Raleigh became the seat of Saline County in 1847, following a meeting of county commissioners in Curran.",
      "sourceSentenceIds": [
        12,
        14
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Raleigh%2C_Illinois",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town’s name honors the Musgrave family, who moved from Raleigh, North Carolina, and persuaded the county to adopt the name.",
      "sourceSentenceIds": [
        15
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Raleigh%2C_Illinois",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "A 20‑by‑24‑foot courthouse, finished on August 15, 1858, cost $5,500 and housed the entire county’s court on its first floor.",
      "sourceSentenceIds": [
        26,
        29
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Raleigh%2C_Illinois",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Early residents built a log house and opened a store, while blacksmiths like Henry Goodrich kept the village bustling in its first years.",
      "sourceSentenceIds": [
        23,
        24
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Raleigh%2C_Illinois",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Surveyors Archibald Sloan, William Crawford, and Martin Kittinger mapped the town, laying out a six‑square‑mile township that would become the county seat.",
      "sourceSentenceIds": [
        16,
        18
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Raleigh%2C_Illinois",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The original courthouse’s second story held two rooms and a hallway, used for grant and petit proceedings during early court sessions.",
