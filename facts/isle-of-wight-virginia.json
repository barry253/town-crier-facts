  "facts": [
    {
      "id": 1,
      "text": "Isle of Wight County began life in 1634 as Warrosquyoake Shire, one of Virginia’s original shires.",
      "sourceSentenceIds": [
        1,
        2,
        4,
        5
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1",
        "Web source 2"
      ],
      "source": "https://en.wikipedia.org/wiki/Isle_of_Wight%2C_Virginia"
    },
    {
      "id": 2,
      "text": "In 1637 the shire was renamed Isle of Wight after the English island of the same name.",
      "sourceSentenceIds": [
        2,
        4,
        8
      ],
      "sourceLabels": [
        "Web source 1",
        "Web source 2",
        "Wikipedia"
      ],
      "source": "https://www.isleofwight.gov/our_community/history/historic_overview.php"
    },
    {
      "id": 3,
      "text": "Christopher Lawne planted the first English plantation on the James River in present‑day Isle of Wight in May 1618.",
      "sourceSentenceIds": [
        17
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.isleofwight.gov/our_community/history/historic_overview.php"
    },
    {
      "id": 4,
      "text": "A 1619 settlement near Mathomauk marked the earliest English presence in the area that would become Isle of Wight.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.isleofwight.gov/our_community/history/historic_overview.php"
    },
    {
      "id": 5,
      "text": "Fort Boykin and Fort Huger, both in Isle of Wight, stand as reminders of the county’s Revolutionary and Civil War past.",
      "sourceSentenceIds": [
