  "facts": [
    {
      "id": 1,
      "text": "Unicoi began life as “Greasy Cove,” then became Swingleville when the Swingle brothers opened a post office in 1851.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Unicoi%2C_Tennessee",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town nestles in the North Indian Creek Valley where the creek emerges from the mountains and turns toward Erwin.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Unicoi%2C_Tennessee",
      "category": "other",
      "quality": "poor",
      "qualityReason": "location_description"
    },
    {
      "id": 3,
      "text": "When railroads arrived in the late 1880s, the post office name shifted to Unicoi City, later shortened to Unicoi.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Unicoi%2C_Tennessee",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Unicoi grew in the early 1900s as a key shipping point for nearby mining and logging operations.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Unicoi%2C_Tennessee",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The town is surrounded by Cherokee National Forest, with Buffalo Mountain to the west and the rugged Unaka Mountains to the east.",
      "sourceSentenceIds": [
        13,
        14
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Unicoi%2C_Tennessee",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Unicoi is part of the Johnson City Metropolitan Statistical Area, itself a component of the Tri‑Cities region.",
