  "facts": [
    {
      "id": 1,
      "text": "Douglas County was established in 1859, carved from Coles County.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://roadsidethoughts.com/il/county/douglas-profile.htm"
    },
    {
      "id": 2,
      "text": "The county takes its name from Senator Stephen A. Douglas, a prominent 19th‑century politician.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.ilsos.gov/departments/archives/irad/douglas.html"
    },
    {
      "id": 3,
      "text": "Tuscola has served as the permanent county seat since 1860, after a brief stint in Camargo.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.ilsos.gov/departments/archives/irad/douglas.html"
    },
    {
      "id": 4,
      "text": "The county’s township map includes Arcola, Bourbon, Bowdre, Camargo, Garrett, Murdock, Newman, Sargent, and Tuscola.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.ilsos.gov/departments/archives/irad/douglas.html"
    },
    {
      "id": 5,
      "text": "Douglas County’s courthouse, located at 401 S. Tuscola, is a key historic landmark.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.ilsos.gov/departments/archives/irad/douglas.html"
    },
    {
      "id": 6,
      "text": "The Illinois Regional Archives Depository for Douglas County is housed in the Booth Library at Eastern Illinois University.",
