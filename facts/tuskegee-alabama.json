  "facts": [
    {
      "id": 1,
      "text": "Tuskegee was founded in 1833 by General Thomas Simpson Woodward, a Creek War veteran who laid out the town one year after Macon County.",
      "sourceSentenceIds": [
        6,
        9
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Tuskegee%2C_Alabama",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "In 1881, Lewis Adams, a former slave, founded the Tuskegee Normal School, the first institution to train teachers for the segregated school system.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Tuskegee%2C_Alabama",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The school later became Tuskegee Institute, and today it is known as Tuskegee University, a historically black college.",
      "sourceSentenceIds": [
        8,
        15
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Tuskegee%2C_Alabama",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Rosa Parks, born in Tuskegee in 1913, rose to national prominence as a civil rights activist after refusing to give up her bus seat.",
      "sourceSentenceIds": [
        1,
        17
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Tuskegee%2C_Alabama",
      "category": "people",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Tuskegee Airmen National Historic Site at Moton Field preserves the legacy of the first African‑American military pilots who flew combat missions in World War II.",
