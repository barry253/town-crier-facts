  "facts": [
    {
      "id": 1,
      "text": "Glenwood was founded in 1908 as a Latter‑Day Saint settlement purchased from the Cochrane Ranch.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/glenwood_alberta",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The village was originally named Glenwoodville after settler Edward Glen Wood, shortened to Glenwood in 1979.",
      "sourceSentenceIds": [
        2,
        18
      ],
      "sourceLabels": [
        "Web source 2",
        "Wikipedia"
      ],
      "source": "https://grokipedia.com/page/glenwood_alberta",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Glenwood’s economy centers on dairy; the Glenwood Cheese Factory Museum showcases local cheesemaking and opens seasonally with an ice cream shop.",
      "sourceSentenceIds": [
        3,
        6,
        24
      ],
      "sourceLabels": [
        "Web source 2",
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/glenwood_alberta",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "In 1923 a canal completed irrigation, boosting farmland after families moved in.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/glenwood_alberta",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "A 1964 water system from the Belly River gave residents running water, but a June flood damaged the pump station.",
