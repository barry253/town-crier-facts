  "facts": [
    {
      "id": 1,
      "text": "Anguilla got its name in 1884 when the Yazoo and Mississippi Valley Railroad arrived, taking its name from a nearby Vick plantation.",
      "sourceSentenceIds": [
        1,
        13
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/anguilla_mississippi",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "After the Civil War, Anguilla grew as a small farming community in the fertile Delta, driven by expanding cotton plantations.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/anguilla_mississippi",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "In the 1950s and 60s, Anguilla adopted mechanical cotton pickers and tractors to replace sharecroppers moving to urban jobs.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/anguilla_mississippi",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Anguilla joined a 1964 civil rights boycott, and local activists helped push school integration in the surrounding county.",
      "sourceSentenceIds": [
        14
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/anguilla_mississippi",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "An EF2 tornado struck Anguilla on December 13, 2022, causing significant damage to the town.",
