  "facts": [
    {
      "id": 1,
      "text": "Athalia was founded in the mid‑19th century by John Tierman, who named the settlement after his daughter, and was incorporated on June 9 1887.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/athalia_ohio",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Athalia lies along the Ohio River and is part of the Huntington‑Ashland metropolitan area.",
      "sourceSentenceIds": [
        13,
        14
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Athalia%2C_Ohio",
      "category": "other",
      "quality": "poor",
      "qualityReason": "location_description"
    },
    {
      "id": 3,
      "text": "Two Mile Creek, a tributary that joins the Ohio River just upstream, has long influenced Athalia’s geography.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/athalia_ohio",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "In 1850, brothers John and Thomas Jones prospected land in Rome Township, settling in 1862 after fleeing slavery and conscription from Virginia.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/athalia_ohio",
      "category": "people",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The village’s river‑based economy persisted into the 20th century, with ferries like the sternwheeler Whisper operating until its dismantling in 1924.",
