  "facts": [
    {
      "id": 1,
      "text": "Cullen was founded in 1886 as a lumber company town by the Cullen Lumber Company, part of Louisiana's late 19th-century timber boom.",
      "sourceSentenceIds": [
        3,
        4
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/cullen_louisiana",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town hosts a Kansas City Southern Railroad museum right across from the International Paper Company container plant, preserving its rail heritage.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Cullen%2C_Louisiana",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "In 1935, International Paper Company opened a mill in Cullen, becoming a major employer and anchoring the town's economy for decades.",
      "sourceSentenceIds": [
        30
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/cullen_louisiana",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Cullen was officially incorporated on June 16, 1955, under the Lawrason Act, transitioning from an unincorporated settlement to a formal municipality.",
      "sourceSentenceIds": [
        28
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/cullen_louisiana",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The town’s origins trace back to the region’s abundant virgin pine forests, which drew out-of-state investors and laborers to establish mills and support settlements.",
      "sourceSentenceIds": [
        22
      ],
      "sourceLabels": [
        "Web source 1"
      ],
