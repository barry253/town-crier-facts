  "facts": [
    {
      "id": 1,
      "text": "Strasburg was named after the German‑Russian village of Strasburg in Ukraine, itself named for Strasbourg in Alsace, France.",
      "sourceSentenceIds": [
        1,
        4
      ],
      "sourceLabels": [
        "Web source 2",
        "Wikipedia"
      ],
      "source": "https://grokipedia.com/page/Strasburg,_North_Dakota",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Strasburg was founded in 1902 when a Chicago, Milwaukee, St. Paul and Pacific Railroad spur reached the site.",
      "sourceSentenceIds": [
        6,
        11,
        26
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Strasburg%2C_North_Dakota",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Lawrence Welk, the famed bandleader, was born on the Welk Homestead near Strasburg in 1903, a site now a state historic park.",
      "sourceSentenceIds": [
        24,
        14
      ],
      "sourceLabels": [
        "Web source 2",
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/Strasburg,_North_Dakota",
      "category": "people",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The Holy Trinity Cemetery southwest of Strasburg, founded in 1912, is part of a 1989 National Register listing of German‑Russian wrought‑iron cross sites.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/Strasburg,_North_Dakota",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Strasburg hosts several historic churches and cross sites that showcase the artistic traditions of its German‑Russian settlers.",
      "sourceSentenceIds": [
