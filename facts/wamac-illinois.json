  "facts": [
    {
      "id": 1,
      "text": "Wamac stretches across three counties—Washington, Marion, and Clinton—making it one of Illinois' few cities split among multiple jurisdictions.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Wamac%2C_Illinois"
    },
    {
      "id": 2,
      "text": "The city was incorporated on July 25 1916, and its name honors the three counties that form its borders.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Wamac%2C_Illinois"
    },
    {
      "id": 3,
      "text": "Wamac sits just south of Centralia, sharing its northern and eastern borders with that larger town.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Wamac%2C_Illinois"
    },
    {
      "id": 4,
      "text": "Illinois Route 51 skirts the city’s eastern edge, running north to Centralia and south 38 miles to Du Quoin.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Wamac%2C_Illinois"
    },
    {
      "id": 5,
      "text": "The Fulton Branch cuts through Wamac’s southern side, feeding into Sewer Creek and ultimately the Kaskaskia River watershed.",
      "sourceSentenceIds": [
        7
