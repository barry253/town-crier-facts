  "facts": [
    {
      "id": 1,
      "text": "Myrtle Point takes its name from the California Myrtle and Bay Laurel trees that grow along the Coquille River.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.ci.myrtlepoint.or.us/history"
    },
    {
      "id": 2,
      "text": "Timber has been central to the economy of Myrtle Point since it was founded by speculative timber interests in 1879.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.ci.myrtlepoint.or.us/history"
    },
    {
      "id": 3,
      "text": "Myrtle Point is situated between the two points of confluence of the three forks of the Coquille River.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.ci.myrtlepoint.or.us/history"
    },
    {
      "id": 4,
      "text": "The completion of a railroad connecting Myrtle Point to the Coos Bay area in 1893 triggered a period of growth.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.ci.myrtlepoint.or.us/history"
    },
    {
      "id": 5,
      "text": "The Coos County Logging Museum in Myrtle Point features exhibits and displays about the region's logging history.",
