      "id": 1,
      "text": "Langley is situated in the historic Horse Creek Valley, where the local hydrology was shaped by the surrounding landscape.",
      "sourceSentenceIds": [
        9,
        10
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
