  "facts": [
    {
      "id": 1,
      "text": "Southington was settled in 1805 by Connecticut pioneers and was originally called Bolestown before being renamed Southington in 1817.",
      "sourceSentenceIds": [
        2,
        7
      ],
      "sourceLabels": [
        "Web source 2",
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/southington_ohio",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town sits in the historic Connecticut Western Reserve, a territory granted to Connecticut in 1662 and sold in 1795 to fund frontier settlement.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/southington_ohio",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The 1906 Chalker Building and the 1907 Town Hall are preserved landmarks that showcase the community’s 19th‑century heritage.",
      "sourceSentenceIds": [
        1,
        11
      ],
      "sourceLabels": [
        "Web source 1",
        "Web source 2"
      ],
      "source": "https://southingtontownship.org/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "A post office has served Southington continuously since 1826, marking its long‑standing role in the region.",
      "sourceSentenceIds": [
        16
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Southington%2C_Ohio",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Southington’s rural character is maintained by a blend of traditional farms and modern growth, with residents working to preserve its small‑town feel.",
      "sourceSentenceIds": [
        24,
        26
      ],
      "sourceLabels": [
        "Web source 1",
        "Web source 1"
      ],
      "source": "https://southingtontownship.org/",
      "category": "other",
      "quality": "poor",
      "qualityReason": "vague"
    },
    {
      "id": 6,
      "text": "The township’s original Town Hall, located at 3419 State Route 534, hosts monthly meetings that are open to the public, reflecting its civic engagement.",
      "sourceSentenceIds": [
