    {
      "id": 1,
      "text": "Upper Elochoman formed part of the traditional territory of Chinookan-speaking peoples, particularly the Wahkiakum tribe.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/upper_elochoman_washington"
    },
    {
      "id": 2,
      "text": "Homesteaders first settled the Elochoman Valley in the 1850s, clearing dense forests for agriculture and dairy operations.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/upper_elochoman_washington"
    },
    {
      "id": 3,
      "text": "Upper Elochoman is characterized by a rural, forested setting with dense coniferous forests and rolling hills.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/upper_elochoman_washington"
    },
    {
      "id": 4,
      "text": "The valley floor of Upper Elochoman sits at an elevation of 52 feet, surrounded by hills rising over 2,600 feet.",
      "sourceSentenceIds": [
        13
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/upper_elochoman_washington"
    },
    {
      "id": 5,
      "text": "Annual precipitation in Upper Elochoman averages 70 to 85 inches, fostering lush vegetation throughout the region.",
      "sourceSentenceIds": [
        18
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/upper_elochoman_washington"
    },
    {
      "id": 6,
      "text": "The Washington Department of Fish and Wildlife operates the Elochoman Hatchery to support native fish stocks.",
