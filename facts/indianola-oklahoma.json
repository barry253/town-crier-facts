      "id": 1,
      "text": "Indianola was originally located in the Choctaw Nation of Indian Territory, several hundred yards from the site of the local school.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Web source 1"
      ],
