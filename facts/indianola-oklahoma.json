    },
    {
      "id": 2,
      "text": "A Choctaw man named Lyman Hugh Perkins once owned a farm on much of the land where Indianola now stands.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 1"
      ],
