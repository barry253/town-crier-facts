  "facts": [
    {
      "id": 1,
      "text": "Wabeno was established in 1897 and is built on a rich logging heritage within the Chequamegon-Nicolet National Forest.",
      "sourceSentenceIds": [
        2,
        3
      ],
      "sourceLabels": [
        "Web source 1",
        "Web source 2"
      ],
      "source": "https://wabenowisconsin.com/"
    },
    {
      "id": 2,
      "text": "The Wabeno Logging Museum features the world's only operation-capable McGiffert Log Loader, known as Steam Locomotive number four.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://wabenowisconsin.com/"
    },
    {
      "id": 3,
      "text": "Wabeno is an outdoor area featuring the pristine Trump Lake and the headwaters of the Oconto River.",
      "sourceSentenceIds": [
        20
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://wabenowisconsin.com/"
    },
    {
      "id": 4,
      "text": "The Wabeno Public Library is located in the former Chicago and North-Western Land Office.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Wabeno%2C_Wisconsin"
    },
    {
      "id": 5,
      "text": "Wabeno school athletic teams are known as the Logrollers, with Larry the Logroller serving as the mascot.",
      "sourceSentenceIds": [
