      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/East_Hampton%2C_Connecticut",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The Bevin Bell Factory, part of Belltown USA, has been crafting American bells since 1832 on Bevin Hill.",
      "sourceSentenceIds": [
        13
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://chathamhistoricalct.org/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Lake Pocotopaug, one of Connecticut’s largest natural treasures, has been a historic summer destination for generations.",
      "sourceSentenceIds": [
        13
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://chathamhistoricalct.org/",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The Comstock Covered Bridge, Connecticut’s last true covered bridge, spans the Salmon River and showcases 19th‑century engineering.",
      "sourceSentenceIds": [
        13
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://chathamhistoricalct.org/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The Air Line Trail, once a high‑speed rail route between New York and Boston, now offers a scenic journey through local forests.",
      "sourceSentenceIds": [
        13
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://chathamhistoricalct.org/",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Founded in 1963, the Chatham Historical Society preserves East Hampton’s heritage in a museum and school house on Bevin Boulevard.",
