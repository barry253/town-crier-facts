    {
      "id": 1,
      "text": "Höngg joined Zürich in 1934, ending its status as an independent municipality.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/H%C3%B6ngg"
    },
    {
      "id": 2,
      "text": "The Ortsmuseum in Höngg lets visitors experience the village’s shift from a wine‑growing hamlet to a thriving urban quarter.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://vvhoengg.ch/ortsmuseum"
    },
    {
      "id": 3,
      "text": "Inside the 1506 wine‑growers house ‘zum Chranz’, the museum’s walls whisper centuries of local life.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://vvhoengg.ch/ortsmuseum"
    },
    {
      "id": 4,
      "text": "Every year Höngg celebrates the Wümmetfest and Räbeliechtli Umzug, lively funfairs that draw locals and visitors alike.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/H%C3%B6ngg"
    },
    {
      "id": 5,
      "text": "The Protestant church Alte Kirche Höngg serves as the quarter’s main religious landmark.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/H%C3%B6ngg"
    },
    {
      "id": 6,
      "text": "Werdinsel, a protected island in the Limmat west of the Europabrücke, offers a natural retreat near Höngg.",
