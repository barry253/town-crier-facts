      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Taberg%2C_New_York",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Taberg Station once served the Rome, Watertown and Ogdensburg Railroad, making the hamlet a regional rail stop.",
