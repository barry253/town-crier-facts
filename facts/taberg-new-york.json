    },
    {
      "id": 2,
      "text": "The Oneida Iron and Glass Company began in 1809 in Taberg, producing shot and shell for the U.S. Army during the War of 1812.",
      "sourceSentenceIds": [
        17
      ],
      "sourceLabels": [
        "Wikipedia"
