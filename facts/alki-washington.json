      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The Hanson‑Olsen Home, built in the 1860s, exemplifies the Arts and Crafts movement that shaped Seattle’s western cities.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Wikipedia"
