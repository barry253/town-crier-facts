      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Alki Point Lighthouse, erected in 1913, still operates today as a historic landmark on the waterfront.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Alki_Point%2C_Seattle",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Hamilton Viewpoint Park, founded in 1954, offers sweeping views of Elliott Bay, the Olympic Mountains, and downtown Seattle.",
