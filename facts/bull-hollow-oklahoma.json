    {
      "id": 2,
      "text": "Bull Hollow became part of the Cherokee Nation territory following the forced relocations of Native American tribes in the 1830s.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/bull_hollow_oklahoma"
    },
    {
      "id": 3,
      "text": "In 1939, Bull Hollow hosted one of two Indian Division camps of the Civilian Conservation Corps in Oklahoma.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/bull_hollow_oklahoma"
    },
    {
      "id": 4,
      "text": "The Ozark Plateau National Wildlife Refuge near Bull Hollow protects endangered cave species like the gray bat and Ozark big-eared bat.",
      "sourceSentenceIds": [
