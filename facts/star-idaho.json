      "id": 1,
      "text": "Star earned its name from a bright star painted on the first schoolhouse, guiding travelers east and west in the 1870s.",
      "sourceSentenceIds": [
        1,
        10
      ],
      "sourceLabels": [
        "Wikipedia",
