  "facts": [
    {
      "id": 1,
      "text": "Captain William Kelly's C Troop of the First Oregon Cavalry built Fort Klamath in 1863 to protect settlers during the Indian Wars.",
      "sourceSentenceIds": [
        19
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://exploreforts.com/forts/fort-klamath-or"
    },
    {
      "id": 2,
      "text": "Fort Klamath served as an important Army post during conflicts with the Klamath, Modoc, and Northern Paiute tribes.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://exploreforts.com/forts/fort-klamath-or"
    },
    {
      "id": 3,
      "text": "During the Modoc War, surviving Modoc participants were marched under guard to Fort Klamath, where leaders were held in the guardhouse.",
      "sourceSentenceIds": [
        21
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://exploreforts.com/forts/fort-klamath-or"
    },
    {
      "id": 4,
      "text": "The Fort Klamath site was officially added to the National Register of Historic Places in 1971.",
      "sourceSentenceIds": [
        22
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://exploreforts.com/forts/fort-klamath-or"
    },
    {
      "id": 5,
      "text": "Dedicated citizens and historical societies established the Fort Klamath Museum in 1960 to preserve the region's military frontier history.",
      "sourceSentenceIds": [
        15
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.wonderfulmuseums.com/museum/fort-klamath-museum-oregon/"
    },
    {
      "id": 6,
      "text": "Fort Klamath is located in a high-elevation region that experiences warm, dry summers and cold, wet winters.",
