      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The village’s growth hinged on rail lines, with the Paul Suburban Railroad arriving in 1892 and streetcar service from St. Paul by 1899.",
      "sourceSentenceIds": [
        3,
        28
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.wchsmn.org/willernie/",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Residents once listened to dance bands from the Pavilion by the lake while sitting on their front porches.",
      "sourceSentenceIds": [
        4,
        2
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.wchsmn.org/willernie/",
