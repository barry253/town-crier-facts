  "facts": [
    {
      "id": 1,
      "text": "Mayville was founded in 1845 as an iron ore mining town, and its historic downtown still reflects that era.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.mayvillecity.com/"
    },
    {
      "id": 2,
      "text": "The Mayville Historical Society Museum sits in the former home and workshop of John Hollenstein, a pioneer wagon and carriage builder.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.marshareachamber.com/mayville"
    },
    {
      "id": 3,
      "text": "In 1873, Hollenstein expanded his wagon business into a factory east of his home, marking Mayville’s early industrial growth.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.marshareachamber.com/mayville"
    },
    {
      "id": 4,
      "text": "Mayville’s downtown once hosted cigar factories, breweries, piano stores, and creameries as the iron industry flourished.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.marshareachamber.com/mayville"
    },
    {
      "id": 5,
      "text": "The city’s Audubon Days festival celebrates its German heritage with bed races, duck races, and a parade featuring local crafts.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Mayville%2C_Wisconsin"
    },
    {
      "id": 6,
      "text": "Mayville’s location along the Rock River and Horicon Marsh places it near one of Wisconsin’s largest wetlands.",
      "sourceSentenceIds": [
        17
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Mayville%2C_Wisconsin"
    }
  ]
