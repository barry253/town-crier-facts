  "facts": [
    {
      "id": 1,
      "text": "Aubrey was officially founded in 1867 when Civil War veteran Lemuel Noah Edwards built the town’s first frame house.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Aubrey%2C_Texas",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town’s name switched from Onega to Aubrey in 1881 when the Texas and Pacific Railway built a depot and a post office was granted.",
      "sourceSentenceIds": [
        1,
        11
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.tshaonline.org/handbook/entries/aubrey-tx",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Jazz legend Louise Tobin, born in Aubrey in 1918, later sang with Harry James and toured worldwide.",
      "sourceSentenceIds": [
        3,
        8
      ],
      "sourceLabels": [
        "Web source 2",
        "Wikipedia"
      ],
      "source": "https://dentonrc.com/news/small-town-aubrey-is-becoming-hub-for-big-planned-communities/article_89f4ea93-db9c-5993-8e95-ea943ccbf382.html",
      "category": "people",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The town rebuilt west of the tracks after the 1887 fire, thanks to land donated by Edwards.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.tshaonline.org/handbook/entries/aubrey-tx",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "In 2008 Aubrey Elementary School was renamed Brockett Elementary, honoring a local educator.",
