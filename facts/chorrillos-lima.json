  "facts": [
    {
      "id": 1,
      "text": "Founded as a deluxe beach resort in 1824, Chorrillos became a town in 1856.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Chorrillos_District",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The pre‑Columbian settlement of Armatambo once occupied the Morro Solar headland before Spanish conquest.",
      "sourceSentenceIds": [
        6,
        13
      ],
      "sourceLabels": [
        "Web source 2",
        "Wikipedia"
      ],
      "source": "https://www.limaeasy.com/lima-guide/districts-lima/the-district-chorrillos",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "During the War of the Pacific, Chilean forces looted and burned Chorrillos in 1881, after which the district was rebuilt and merged into Lima.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Chorrillos_District",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Chorrillos offers panoramic views of the Bay of Lima, La Punta, and San Lorenzo Island from its elevated coastline.",
      "sourceSentenceIds": [
        17
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Chorrillos_District",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The Chorrillos Military School opened in 1898, marking the district’s role in Peru’s military education.",
      "sourceSentenceIds": [
        16
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Chorrillos_District",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "La Herradura beach in Chorrillos is famed for its spicy picantería restaurants, a culinary tradition unique to the area.",
