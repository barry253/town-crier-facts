  "facts": [
    {
      "id": 1,
      "text": "Centerville earned its name from its central position between Saint Paul, the Mississippi River at Anoka, and the Saint Croix River at Stillwater.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Centerville%2C_Minnesota"
    },
    {
      "id": 2,
      "text": "Centerville was founded in 1857, making it one of the earliest settlements in Anoka County.",
      "sourceSentenceIds": [
        19
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Centerville%2C_Minnesota"
    },
    {
      "id": 3,
      "text": "Before French-Canadian settlers arrived in the mid‑1800s, Dakota Indians had lived in the area since the 1600s, returning each year to harvest wild rice.",
      "sourceSentenceIds": [
        11,
        12
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://centervillemn.com/175/History"
    },
    {
      "id": 4,
      "text": "The town’s downtown was once called the French Section, reflecting its early French‑Canadian roots.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://centervillemn.com/175/History"
    },
    {
      "id": 5,
      "text": "In 1854, Charles Peltier built a sawmill on Clearwater Creek, and in 1971 the city honored that legacy by naming Mill Road after it.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://centervillemn.com/175/History"
    },
    {
      "id": 6,
      "text": "Centerville is an enclave, entirely surrounded by the neighboring city of Lino Lakes.",
      "sourceSentenceIds": [
        18
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Centerville%2C_Minnesota"
    }
  ]
