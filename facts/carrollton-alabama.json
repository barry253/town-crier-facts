  "facts": [
    {
      "id": 1,
      "text": "Carrollton was founded on 80 acres granted by the federal government to Pickens County in 1830, land once occupied by the Choctaws.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://encyclopediaofalabama.org/article/carrollton/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Incorporated January 15, 1831, the town was named after Charles Carroll of Carrollton, Maryland, the last surviving signer of the Declaration of Independence.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://encyclopediaofalabama.org/article/carrollton/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The Pickens County Courthouse, built in 1877, dominates Carrollton’s town square and reflects the town’s historic civic heart.",
      "sourceSentenceIds": [
        16
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Carrollton%2C_Alabama",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "After the original courthouse burned in 1865 and a second burned in 1876, the current courthouse was erected in 1877.",
      "sourceSentenceIds": [
        17,
        18,
        16
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Carrollton%2C_Alabama",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "A post office has operated continuously in Carrollton since 1831, linking the town to the nation for nearly two centuries.",
      "sourceSentenceIds": [
        19
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Carrollton%2C_Alabama",
      "category": "other",
      "quality": "poor",
      "qualityReason": "vague"
    },
    {
      "id": 6,
      "text": "Carrollton serves as the county seat of Pickens County, Alabama, anchoring the region’s administrative functions.",
      "sourceSentenceIds": [
        15
