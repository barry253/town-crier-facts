  "facts": [
    {
      "id": 1,
      "text": "Oak Ridge earned its nickname “Secret City” during World II when the Manhattan Project’s Y‑12 and X‑10 plants were built in secrecy.",
      "sourceSentenceIds": [
        16,
        17,
        18,
        23
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Oak_Ridge%2C_Tennessee",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The Oak Ridge National Laboratory, now a leading research hub, began as the X‑10 graphite reactor, the first full‑scale plutonium production plant.",
      "sourceSentenceIds": [
        16,
        18
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Oak_Ridge%2C_Tennessee",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The Oak Ridge Room at the public library houses a vast collection of Manhattan Project photographs and biographies of key scientists.",
      "sourceSentenceIds": [
        6,
        14,
        27
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://orpl.oakridgetn.gov/learn/local-history",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The Manhattan Project National Historical Park in Oak Ridge preserves the town’s wartime legacy and is managed jointly by the National Park Service and the Department of Energy.",
      "sourceSentenceIds": [
        23
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Oak_Ridge%2C_Tennessee",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Oak Ridge’s early infrastructure boasted 300 miles of roads, 55 miles of railroad, ten schools, and seven theaters, built to support the wartime workforce.",
      "sourceSentenceIds": [
        22
      ],
