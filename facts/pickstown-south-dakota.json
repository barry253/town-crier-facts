  "facts": [
    {
      "id": 1,
      "text": "Pickstown was named after Lieutenant General Lewis Pick, a co-author of the Pick-Sloan Plan and chief of the Army Corps of Engineers.",
      "sourceSentenceIds": [
        1,
        2
      ],
      "sourceLabels": [
        "Web source 1",
        "Web source 2"
      ],
      "source": "https://pickstown-sd.net/"
    },
    {
      "id": 2,
      "text": "Pickstown was built in 1948 on a plateau overlooking the Missouri River and the former site of Fort Randall.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://pickstown-sd.net/"
    },
    {
      "id": 3,
      "text": "Pickstown is located on the historic Lewis and Clark Trail and the cultural Oyate Trail.",
      "sourceSentenceIds": [
        9,
        10
      ],
      "sourceLabels": [
        "Web source 1",
        "Web source 2"
      ],
      "source": "https://pickstown-sd.net/"
    },
    {
      "id": 4,
      "text": "The Fort Randall Casino and Hotel, operated by the Yankton Sioux Tribe, sits on an abandoned radar base in Pickstown.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Pickstown%2C_South_Dakota"
    },
    {
      "id": 5,
      "text": "Air Force personnel operated a Strategic Air Command radar base on a hill east of Pickstown from the 1950s until the 1970s.",
      "sourceSentenceIds": [
        14,
        15
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Pickstown%2C_South_Dakota"
    },
    {
      "id": 6,
      "text": "The Fort Randall Chapel and Cemetery is a historical site located just below the dam near Pickstown.",
