  "facts": [
    {
      "id": 1,
      "text": "Leonardtown was originally called Newtown before Governor John Seymour renamed it Seymour Town in the mid‑1700s.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Leonardtown%2C_Maryland",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Nearly twenty years later, the town became Leonardtown in honor of Benedict Leonard Calvert, Maryland’s governor at the time.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Leonardtown%2C_Maryland",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Historic Tudor Hall, now home to the Mary’s County Historical Society, sits in the town square and was listed on the National Register of Historic Places in 1973.",
      "sourceSentenceIds": [
        7,
        8
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Leonardtown%2C_Maryland",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Leonardtown’s downtown is in a renaissance, with new restaurants and specialty shops opening in historic buildings.",
      "sourceSentenceIds": [
        6,
        11
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 2"
      ],
      "source": "https://en.wikipedia.org/wiki/Leonardtown%2C_Maryland",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "A modern public library and seniors center opened in 2021, adding a contemporary touch to the town’s historic feel.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Leonardtown%2C_Maryland",
