  "facts": [
    {
      "id": 1,
      "text": "Kingston is named for Thomas Rice King, who moved here with his family to establish a communal United Order.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Kingston%2C_Utah"
    },
    {
      "id": 2,
      "text": "The King families' United Order functioned as a communal living experiment from 1876 to 1883 in Kingston.",
      "sourceSentenceIds": [
        11
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Kingston%2C_Utah"
    },
    {
      "id": 3,
      "text": "Early homes in Kingston were built in a similar style to form a fort around a ten-acre block.",
      "sourceSentenceIds": [
        15
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Kingston%2C_Utah"
    },
    {
      "id": 4,
      "text": "The first log houses in Kingston featured dirt floors and roofs during the town's early development.",
      "sourceSentenceIds": [
        16
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Kingston%2C_Utah"
    },
    {
      "id": 5,
      "text": "Kingston once featured an industrial center with a flour mill, tannery, sawmill, and woolen mill located just east of town.",
      "sourceSentenceIds": [
        17
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Kingston%2C_Utah"
    },
    {
      "id": 6,
      "text": "Kingston was placed on the National Register of Historical Buildings in 1971.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://piute.gov/recreation-tourism/visit-piute-county/historical-info/"
    }
  ]
