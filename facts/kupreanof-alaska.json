  "facts": [
    {
      "id": 1,
      "text": "Kupreanof’s name comes from the Tlingit word Aansadaak’w, meaning “town before,” because it sits across the channel from Petersburg.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 1"
      ],
