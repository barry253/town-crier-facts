  "facts": [
    {
      "id": 1,
      "text": "Kupreanof’s name comes from the Tlingit word Aansadaak’w, meaning “town before,” because it sits across the channel from Petersburg.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/kupreanof_alaska"
    },
    {
      "id": 2,
      "text": "Kupreanof enjoys a maritime climate with mild temperatures, more than 100 inches of rain each year, and frequent fog and rain.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/kupreanof_alaska"
    },
    {
      "id": 3,
      "text": "A temporary monitoring station near Mount Kupreanof now records seismic, infrasound, and gas data to keep an eye on the volcano.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://avo.alaska.edu/volcano/kupreanof"
    },
    {
      "id": 4,
      "text": "Archaeologists find evidence of Tlingit habitation on Kupreanof Island dating back 2,000 years, including ancient fish traps and petroglyphs.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/kupreanof_alaska"
    },
    {
      "id": 5,
      "text": "Kupreanof sits at 56.82°N, 132.98°W, directly across the Wrangell Narrows from Petersburg’s Mitkof Island.",
