  "facts": [
    {
      "id": 1,
      "text": "Orogrande, Spanish for \"big gold,\" was renamed in 1906 after a gold nugget the size of a man's finger was found in 1905.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.newmexico.org/places-to-visit/ghost-towns/orogrande/",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town sprang up overnight, with a hundred homes built to house only a fraction of the sudden influx of prospectors.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.newmexico.org/places-to-visit/ghost-towns/orogrande/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "A 55‑mile water pipe was laid from the Sacramento River to supply Orogrande during its boom years.",
      "sourceSentenceIds": [
        18
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.newmexico.org/places-to-visit/ghost-towns/orogrande/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The gold and other mineral deposits failed to meet expectations, causing mining activity to wane and the town to revert to a railroad stop.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.newmexico.org/places-to-visit/ghost-towns/orogrande/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Numerous abandoned mines around Orogrande now fall under Bureau of Land Management jurisdiction.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Orogrande%2C_New_Mexico",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Orogrande still hosts a post office, a few businesses, and about fifteen families, keeping the ghost town alive.",
      "sourceSentenceIds": [
