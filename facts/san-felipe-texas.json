  "facts": [
    {
      "id": 1,
      "text": "San Felipe, founded in 1824 as San Felipe de Austin, was the first capital of Stephen F. Austin’s colony and the birthplace of the Texas Rangers.",
      "sourceSentenceIds": [
        3,
        4
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 2"
      ],
      "source": "https://en.wikipedia.org/wiki/San_Felipe%2C_Texas",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town’s main commercial street, Calle Commercio, was laid out by 1828, making San Felipe a bustling hub second only to San Antonio at the time.",
      "sourceSentenceIds": [
        19
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/San_Felipe%2C_Texas",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "In 1836, San Felipe was deliberately burned to prevent Mexican forces from capturing it, then rebuilt a few years later but never regained its former prominence.",
      "sourceSentenceIds": [
        27
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/San_Felipe%2C_Texas",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The original townsite was donated to the state in 1940 and now serves as the San Felipe de Austin State Historic Site, preserving the colony’s legacy.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/San_Felipe%2C_Texas",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "During the late nineteenth century, German settlers arrived in San Felipe, followed by Czechs, adding to the town’s diverse cultural tapestry.",
      "sourceSentenceIds": [
        1,
        5
      ],
      "sourceLabels": [
        "Web source 1"
      ],
