      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The Lewis Mill Complex and George Willard House nearby are listed on the National Register of Historic Places.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Jefferson%2C_Maryland",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Jefferson’s name originated from the many taverns that lined the town in its early days, earning it the nickname “Trap Town.”.",
      "sourceSentenceIds": [
        7,
        26
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Jefferson%2C_Maryland",
      "category": "etymology",
      "quality": "good"
    },
    {
