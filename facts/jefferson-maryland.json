      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town sits at the western base of Catoctin Mountain, with Maryland Route 180 cutting through its historic core.",
      "sourceSentenceIds": [
        28,
        22
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Jefferson%2C_Maryland",
