  "facts": [
    {
      "id": 1,
      "text": "Sintra’s historic center, with its 19th‑century Romanticist architecture and royal palaces, earned UNESCO World Heritage status in 1995.",
      "sourceSentenceIds": [
        13
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
