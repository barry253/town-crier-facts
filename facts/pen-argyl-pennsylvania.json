  "facts": [
    {
      "id": 1,
      "text": "Pen Argyl’s name comes from Cornish “head” and Anglo‑Saxon “argylite”, reflecting its slate‑mining roots.",
      "sourceSentenceIds": [
        14
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Pen_Argyl%2C_Pennsylvania",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "In 1882, quarrymen from Cornwall helped Pen Argyl grow into the heart of Pennsylvania’s Slate Belt.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://penargylborough.com/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The borough still operates one slate quarry, a living reminder of its 19th‑century industry.",
      "sourceSentenceIds": [
        16
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Pen_Argyl%2C_Pennsylvania",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Pen Argyl’s Weona Park Dentzel carousel, built in 1923, is one of the few Dentzel carousels with stationary wooden animals.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://penargylborough.com/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The carousel was restored in 1994 and entered the National Register of Historic Places in 1999.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.discoverlehighvalley.com/directory/borough-of-pen-argyl/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Pen Argyl’s historic railroad roundhouse and shop building, once the main freight yard for the Lehigh and New England Railroad, still stand west of town.",
      "sourceSentenceIds": [
        5,
        6
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
