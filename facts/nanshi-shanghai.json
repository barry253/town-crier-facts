  "facts": [
    {
      "id": 1,
      "text": "Nanshi literally means \"Southern City\" and was the historic core of Shanghai before the British concession north of the wall.",
      "sourceSentenceIds": [
        3,
        15,
        19,
        20
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Nanshi%2C_Shanghai",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The area was rebuilt in the 20th century to recreate a bygone era, giving it the feel of a small island of old Shanghai.",
      "sourceSentenceIds": [
        12,
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://advantiko.com/en/countries/china-en/old-city-nanshi-shanghai/",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Traditional Chinese gates flank the entrance to Nanshi, marking the boundary of the historic district.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://advantiko.com/en/countries/china-en/old-city-nanshi-shanghai/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Huxinting Tea House, located by the water near Yu Garden, is one of Nanshi’s most recognizable landmarks.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://advantiko.com/en/countries/china-en/old-city-nanshi-shanghai/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Nanshi has been called Lao Xiangchang, Yuyuan Laojie, and Mingqing Jie over time, reflecting its evolving identity.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://geomerid.com/en/place/old-town-nanshi-shanghai/overview/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The old city wall built during the Ming Dynasty defined Shanghai’s urban limits for centuries.",
      "sourceSentenceIds": [
