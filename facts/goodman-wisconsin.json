  "facts": [
    {
      "id": 1,
      "text": "Goodman was initially named Dunbar in 1899 before the name was changed to Goodman in 1915.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Goodman%2C_Wisconsin"
    },
    {
      "id": 2,
      "text": "The Goodman brothers founded this community in the late 1800s as a logging site for the Sawyer-Goodman Lumber Company.",
      "sourceSentenceIds": [
        14
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Goodman%2C_Wisconsin"
    },
    {
      "id": 3,
      "text": "William O. Goodman is thought to be one of the first loggers in the country to use selective cutting practices.",
      "sourceSentenceIds": [
        17
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Goodman%2C_Wisconsin"
    },
    {
      "id": 4,
      "text": "The town center features the Goodman Club House, which once drew well-known performers to its ballroom and theater.",
      "sourceSentenceIds": [
        20,
        21
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Goodman%2C_Wisconsin"
    },
    {
      "id": 5,
      "text": "Goodman celebrated its centennial anniversary in 2008 with a lumberjack breakfast, a parade, and a fireworks display.",
      "sourceSentenceIds": [
        22,
        24
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Goodman%2C_Wisconsin"
    },
    {
      "id": 6,
      "text": "Four of the county's finest trout streams flow through the forests of the Goodman area, including the Peme Bon Won.",
