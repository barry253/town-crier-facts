      "id": 1,
      "text": "Horizon City was incorporated on October 22, 1988, after a referendum that formalized a planned community originally developed by the Horizon Corporation.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
