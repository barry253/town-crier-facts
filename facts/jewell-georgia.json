  "facts": [
    {
      "id": 1,
      "text": "Jewell grew from Shivers Mills to Rock Factory, then to its current name, reflecting a shift from family farms to a village centered on its founder.",
      "sourceSentenceIds": [
        1,
        14
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/jewell_georgia",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The community sits on Georgia State Route 16, straddling Warren and Hancock counties along the Ogeechee River as part of the Historic Piedmont Scenic Byway.",
      "sourceSentenceIds": [
        18
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/jewell_georgia",
      "category": "other",
      "quality": "poor",
      "qualityReason": "location_description"
    },
    {
      "id": 3,
      "text": "Late‑18th‑century settlers like the Shivers moved from Virginia, building mills near rocky river shallows that crossed an old Indian trail.",
      "sourceSentenceIds": [
        19
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/jewell_georgia",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The Ogeechee River, a blackwater stream, forms Warren County’s western boundary and shapes local hydrology with its unique watershed dynamics.",
      "sourceSentenceIds": [
        25
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/jewell_georgia",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The Missionary Baptist Church of Christ at Jewell was originally known simply as the Missionary Baptist Church of Christ.",
      "sourceSentenceIds": [
        16
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://vanishinggeorgia.com/category/jewell-ga/",
      "category": "people",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "In the 19th century, Bodfish of Connecticut purchased the former Rock Mill Factory on the Ogeechee River for $3,500, expanding industrial activity.",
      "sourceSentenceIds": [
        15
      ],
      "sourceLabels": [
        "Web source 1"
      ],
