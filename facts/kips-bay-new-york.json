  "facts": [
    {
      "id": 1,
      "text": "Kips Bay takes its name from Dutch settler Jacobus Hendrickson Kip, whose 17th‑century farm stretched north of present‑day 30th Street along the East River.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Kips_Bay%2C_Manhattan",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The neighborhood’s grid slopes gently toward the river, where the FDR Drive and East River Greenway now trace the shoreline once indented by the actual bay.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.cityneighborhoods.nyc/kips-bay",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Bellevue Hospital, founded in the 19th century, drew medical schools and laboratories to Kips Bay, a legacy that still defines the East Side corridor.",
      "sourceSentenceIds": [
        11,
        13
      ],
      "sourceLabels": [
        "Web source 1",
        "Web source 2"
      ],
      "source": "https://www.cityneighborhoods.nyc/kips-bay",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The former Kips Bay Brewing Company, built in 1895, now houses offices but once brewed for New Yorkers.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Kips_Bay%2C_Manhattan",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Bellevue South Park opened in 1979 after a decade of delays, a green space born from the 1960s urban renewal plan.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Kips_Bay%2C_Manhattan",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The Epiphany branch of the NYPL, a Carnegie library opened in 1907, sits at 228 East 23rd Street in Kips Bay.",
