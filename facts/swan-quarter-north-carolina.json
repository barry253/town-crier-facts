      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The village became Hyde County’s seat in 1836 and sits perched on the northeastern edge of Swan Quarter Bay.",
      "sourceSentenceIds": [
        5,
        9,
        16
      ],
      "sourceLabels": [
        "Web source 1",
