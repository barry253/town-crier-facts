      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The Hyde County Courthouse and Lake Mattamuskeet Pump Station are listed on the National Register of Historic Places.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Swan_Quarter%2C_North_Carolina",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "A 50‑car ferry connects Swan Quarter to Ocracoke Island across Pamlico Sound in about two and a half hours.",
      "sourceSentenceIds": [
        17
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Swan_Quarter%2C_North_Carolina",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Mattamuskeet National Wildlife Refuge lies nine miles east of Swan Quarter, sheltering bald eagles, peregrine falcons, and American alligators.",
