  "facts": [
    {
      "id": 1,
      "text": "Fairplay grew around a post road, not a railroad, shaping its early commerce and community life.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://dlg.usg.edu/record/dlg_ghm_fairplay",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town’s name, Fairplay, was honored with a historic marker on its bicentennial, commemorating its long‑standing local identity.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://dlg.usg.edu/record/dlg_ghm_fairplay",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Early settlers built a wool carder, sawmill, and grist mill at Hurricane Creek, fueling antebellum agriculture and textile production.",
      "sourceSentenceIds": [
        14
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/fairplay_douglas_county_georgia",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Oak Grove Cemetery, originally linked to Union Grove Christian Church, preserves 19th‑century burial traditions in Fairplay.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/fairplay_douglas_county_georgia",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Flint Hill Methodist Church, completed in 1883, stands as Fairplay’s finest 19th‑century house of worship, complete with a Masonic hall above.",
      "sourceSentenceIds": [
        27
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/fairplay_douglas_county_georgia",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Fairplay’s roots trace back to the late 1820s, when European settlers arrived after the forced removal of Creek and Cherokee peoples.",
      "sourceSentenceIds": [
        13
