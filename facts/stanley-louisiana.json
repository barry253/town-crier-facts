  "facts": [
    {
      "id": 1,
      "text": "Stanley was renamed in 1957 to honor 'Uncle Jack Stanley,' a local benefactor who helped orphan boys.",
      "sourceSentenceIds": [
        18
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/stanley_louisiana",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The area began as an unincorporated community called Oak Grove in the late 19th century, settled by farmers and preachers who taught in pine log cabins.",
      "sourceSentenceIds": [
        4,
        3
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/stanley_louisiana",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Stanley High School, originally Oak Grove High School, expanded in the 1950s with a new brick grade school, lunchroom, and football stadium, aided by federal vocational programs.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/stanley_louisiana",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The first diploma graduates of the local school were Hazel Bowden and Lewis Hayden Christian in 1921, after years of short terms and basic facilities.",
      "sourceSentenceIds": [
        26
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/stanley_louisiana",
      "category": "other",
      "quality": "poor",
      "qualityReason": "vague"
    },
    {
      "id": 5,
      "text": "Olivet Baptist Church, founded around 1889, and local Methodist congregations shared early facilities with schools, shaping community consolidation.",
