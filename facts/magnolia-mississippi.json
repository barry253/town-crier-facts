  "facts": [
    {
      "id": 1,
      "text": "Magnolia was founded in 1856 by landowner Ansel Prewitt, who parceled his plantation into town lots for early settlers.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.livingplaces.com/MS/Pike_County/Magnolia_City.html",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "In 1873 Magnolia became Pike County’s seat, and a new courthouse on Bay Street opened in 1876, marking its civic growth.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.livingplaces.com/MS/Pike_County/Magnolia_City.html",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The town’s layout mirrors the railroad: residential blocks rose northwest while commercial streets ran parallel to the tracks.",
      "sourceSentenceIds": [
        24
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.livingplaces.com/MS/Pike_County/Magnolia_City.html",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Magnolia sits at the confluence of the Minnehaha River and the Little Tangipahoa River, a geographic highlight of the area.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Magnolia%2C_Mississippi",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "A single public library serves the community, offering a quiet spot for readers amid Magnolia’s historic streets.",
      "sourceSentenceIds": [
        30
