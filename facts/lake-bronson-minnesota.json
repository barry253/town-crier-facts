    },
    {
      "id": 2,
      "text": "The city of Lake Bronson was platted on February 8, 1905, and became incorporated on March 16 of that year.",
      "sourceSentenceIds": [
        8,
        25
      ],
      "sourceLabels": [
        "Web source 2",
        "Web source 1"
      ],
      "source": "https://www.lakesnwoods.com/LakeBronson.htm"
    },
    {
      "id": 3,
      "text": "The first building on the site of Lake Bronson was a hotel erected by Swan Olson.",
      "sourceSentenceIds": [
        28
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://cityoflakebronson.com/"
    },
    {
      "id": 4,
      "text": "The local post office was originally called Percy before changing to Bronson in 1904 and finally Lake Bronson in 1939.",
      "sourceSentenceIds": [
        26
