  "facts": [
    {
      "id": 1,
      "text": "Bean Station was founded in 1776 by William Bean, Tennessee's first white settler, establishing a frontier outpost at a crossroads of trails.",
      "sourceSentenceIds": [
        26
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Bean_Station%2C_Tennessee",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town grew at the junction of the Great Indian Warpath and Daniel Boone’s Wilderness Road, a key spot in America’s westward expansion.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://appalachianmemories.org/2025/02/20/bean-station-tennessee-the-crossroads-of-american-history/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The 1940s construction of Cherokee Dam by the TVA flooded much of Bean Station, forcing residents to relocate and leaving the town largely submerged.",
      "sourceSentenceIds": [
        22
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Bean_Station%2C_Tennessee",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Appalachian Electric Cooperative supplies Bean Station with electricity and broadband, reflecting the town’s modern connectivity rooted in its Appalachian heritage.",
