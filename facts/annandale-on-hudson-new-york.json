    },
    {
      "id": 2,
      "text": "The hamlet sits on the east bank of the Hudson River, overlooking the Catskill Mountains and offering sweeping river views.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.hudsonrivervalley.org/annandale"
    },
    {
      "id": 3,
      "text": "Bard College’s campus preserves the historic Bartlett estate, where 19th‑century stable ruins still stand today.",
      "sourceSentenceIds": [
        17,
