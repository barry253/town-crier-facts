  "facts": [
    {
      "id": 1,
      "text": "Annandale‑on‑Hudson takes its name from an estate donated by John Bard and his wife to Columbia University, which led to the founding of Bard College.",
      "sourceSentenceIds": [
        24,
        25
      ],
      "sourceLabels": [
