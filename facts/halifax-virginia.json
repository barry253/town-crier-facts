    },
    {
      "id": 2,
      "text": "The town lies along the Banister River, an eastward‑flowing tributary of the Dan River and part of the Roanoke watershed.",
      "sourceSentenceIds": [
        24
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
