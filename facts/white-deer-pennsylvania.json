  "facts": [
    {
      "id": 1,
      "text": "White Deer Railroad Station, built 1872 and rebuilt 1910 after a fire, is now being restored by volunteers to its original waiting, ticketing, and baggage rooms.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.visitcentralpa.org/things-to-do/history-and-heritage/railroad-history-comes-alive-in-white-deer/"
    },
    {
      "id": 2,
      "text": "Inside the station, a massive train library holds nearly 500 books and artifacts about train history.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.visitcentralpa.org/things-to-do/history-and-heritage/railroad-history-comes-alive-in-white-deer/"
    },
    {
      "id": 3,
      "text": "The last passenger train left White Deer Station on January 5, 1951, and freight service ended August 14, 1976.",
      "sourceSentenceIds": [
        16
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.visitcentralpa.org/things-to-do/history-and-heritage/railroad-history-comes-alive-in-white-deer/"
    },
    {
      "id": 4,
      "text": "A crew board inside the station shows workers marking on‑duty status, offering a snapshot of daily life.",
      "sourceSentenceIds": [
        18
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.visitcentralpa.org/things-to-do/history-and-heritage/railroad-history-comes-alive-in-white-deer/"
    },
    {
      "id": 5,
      "text": "White Deer Township borders the West Branch Susquehanna River to the east, with Northumberland County across the water.",
      "sourceSentenceIds": [
        21
      ],
