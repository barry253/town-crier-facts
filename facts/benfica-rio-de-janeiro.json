  "facts": [
    {
      "id": 1,
      "text": "Benfica sits in Rio de Janeiro’s North Zone, a neighborhood that grew around the city’s historic center.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Benfica%2C_Rio_de_Janeiro"
    },
    {
      "id": 2,
      "text": "The area lies just north of São Cristóvão and Engenho de Dentro, inside the Centro administrative region.",
      "sourceSentenceIds": [
        7,
        12
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Benfica%2C_Rio_de_Janeiro"
    },
    {
      "id": 3,
      "text": "In the 16th century, Jesuit missionaries planted sugarcane in Benfica after receiving a large land grant from Estácio de Sá.",
      "sourceSentenceIds": [
        8,
        13
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Benfica%2C_Rio_de_Janeiro"
    },
    {
      "id": 4,
      "text": "When the Jesuits were expelled in 1759, Benfica’s lands were parceled to private owners, sparking further settlement.",
      "sourceSentenceIds": [
        9,
        14
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Benfica%2C_Rio_de_Janeiro"
    },
    {
      "id": 5,
      "text": "Today, Avenida Brasil and Avenida Dom Hélder Câmara cut through Benfica, linking downtown Rio to northern and western suburbs.",
      "sourceSentenceIds": [
        10,
        15
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Benfica%2C_Rio_de_Janeiro"
    },
    {
      "id": 6,
      "text": "Benfica’s early plantations also included the nearby Engenho da Rainha and Engenho Novo, key sites in Rio’s sugarcane economy.",
      "sourceSentenceIds": [
        13
      ],
