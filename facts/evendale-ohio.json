    {
      "id": 2,
      "text": "After WWII, General Electric repurposed the mothballed Wright Aeronautical plant in Evendale, employing up to 27,000 workers by 1945.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
