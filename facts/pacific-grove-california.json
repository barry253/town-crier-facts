  "facts": [
    {
      "id": 1,
      "text": "Pacific Grove was founded in 1892 at Lover's Point, making it the oldest marine laboratory on the U.S. Pacific Coast.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Pacific_Grove%2C_California",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town began as a Methodist retreat founded by the Pacific Improvement Company in 1875.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Pacific_Grove%2C_California",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "In 1889 the Southern Pacific Railroad extended service to Pacific Grove, linking it to the wider region.",
      "sourceSentenceIds": [
        21
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://mchsmuseum.com/local-history/historic-places/pacific-grove/",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The Pacific Grove Natural History Museum sits on the former Hopkins Marine Station campus, next to the Monterey Bay Aquarium.",
      "sourceSentenceIds": [
        25
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Pacific_Grove%2C_California",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Pacific Grove earned the nickname “America’s Last Hometown” for its preserved Victorian homes and quiet charm.",
      "sourceSentenceIds": [
        17
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://travelguidetocalifornia.com/pacific-grove/",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The town’s historic register lists over 1,300 structures, the largest number of historic homes for its size on the West Coast.",
