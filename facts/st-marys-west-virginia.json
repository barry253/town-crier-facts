  "facts": [
    {
      "id": 1,
      "text": "St. Marys is the county seat of Pleasants County and is located along the Ohio River at the mouth of Middle Island Creek.",
      "sourceSentenceIds": [
        8,
        14
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/St._Marys%2C_West_Virginia"
    },
    {
      "id": 2,
      "text": "Alexander Creel founded St. Marys in 1849 and named the town in honor of the Virgin Mary.",
      "sourceSentenceIds": [
        4,
        5
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://stmarys.wv.gov/"
    },
    {
      "id": 3,
      "text": "Legend says Alexander Creel founded St. Marys after a vision of the Virgin Mary while traveling by steamboat on the Ohio River.",
      "sourceSentenceIds": [
        7,
        10
      ],
      "sourceLabels": [
        "Web source 2",
        "Wikipedia"
      ],
      "source": "https://stmarys.wv.gov/"
    },
    {
      "id": 4,
      "text": "St. Marys is one of the few remaining towns in the United States where freight trains share city streets with automotive traffic.",
      "sourceSentenceIds": [
        13
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/St._Marys%2C_West_Virginia"
    },
    {
      "id": 5,
      "text": "The Cain House in St. Marys, originally built as a riverside inn and tavern, is listed on the National Register of Historic Places.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://wvexplorer.com/travel/communities/cities-towns/saint-marys-west-virginia/"
    },
    {
      "id": 6,
      "text": "A bridge connects the city of St. Marys to Middle Island, which is part of the Ohio River Islands National Wildlife Refuge.",
