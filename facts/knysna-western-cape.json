  "facts": [
    {
      "id": 1,
      "text": "George Rex, a British entrepreneur, founded Knysna in 1804 after acquiring Melkhoutkraal and later renaming Welbedacht Eastford.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Knysna"
    },
    {
      "id": 2,
      "text": "Knysna’s name likely comes from the Eastern Cape Khoe word for ‘tree’, meaning ‘place of timber’ or ‘place of tree‑ferns’.",
      "sourceSentenceIds": [
        19
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Knysna"
    },
    {
      "id": 3,
      "text": "Knysna hosted one of South Africa’s first gold rushes when a nugget surfaced at Jubilee Creek in 1880.",
      "sourceSentenceIds": [
        11
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.visitknysna.co.za/discover/knysna/"
    },
    {
      "id": 4,
      "text": "The town’s early economy hinged on timber harvesting and boat building, shaping its coastal character.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.visitknysna.co.za/discover/knysna/"
    },
    {
      "id": 5,
      "text": "Archaeologists uncovered 90,000‑year‑old hominid footprints in Knysna, proving human presence for over 300,000 years.",
      "sourceSentenceIds": [
        20
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Knysna"
    },
    {
      "id": 6,
      "text": "The Houtunqua, meaning ‘People Who Bear Honey’, were the original Khoekhoe inhabitants of the Knysna area.",
      "sourceSentenceIds": [
