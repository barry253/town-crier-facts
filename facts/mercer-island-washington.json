  "facts": [
    {
      "id": 1,
      "text": "Mercer Island was named after Judge Thomas Mercer, one of three brothers who helped settle the Seattle area in 1860.",
      "sourceSentenceIds": [
        5,
        7
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 2"
      ],
      "source": "https://en.wikipedia.org/wiki/Mercer_Island%2C_Washington",
      "category": "people",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The first permanent settlers were Charles and Agnes Olds, who arrived in 1885, followed by fifteen families within five years.",
      "sourceSentenceIds": [
        29
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Mercer_Island%2C_Washington",
      "category": "people",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "One of the island's first businesses was Kristoferson's Dairy, likely the first regional dairy farm founded on Mercer Island.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.mercerislandhistory.org/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Sound Transit opened the Mercer Island light‑rail station on March 28, 2026, adding a 447‑stall park‑and‑ride lot.",
      "sourceSentenceIds": [
        19,
        20
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Mercer_Island%2C_Washington",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The Mercer Island Historical Society, founded in 1954, preserves the island’s history through archives and a digital newspaper collection.",
      "sourceSentenceIds": [
        2,
        15
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.mercerislandhistory.org/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Mercer Island operates its own police department, headquartered at a single station that serves the entire community.",
