  "facts": [
    {
      "id": 1,
      "text": "Coeymans takes its name from Dutch settler Barent Pieterse Koeymans, who arrived in 1639 and secured a land patent in 1673.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/coeymans_new_york",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "In the early 20th century, the Powell & Minnock Brick Company, founded in 1895, became the leading brick producer north of Coeymans.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/coeymans_new_york",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The Ariantje Coeymans House, built around 1720, stands as one of the Hudson Valley’s oldest surviving Dutch colonial structures.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/coeymans_new_york",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Shipbuilding surged at Coeymans Landing after the War of 1812, keeping the riverport busy until the early 1900s.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/coeymans_new_york",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "A brief railroad link to Albany opened in 1864, later expanded by the New York West Shore Railroad in 1883 to serve Coeymans Junction.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/coeymans_new_york",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Today, the Port of Coeymans and the Lafarge Cement Plant drive the town’s economy, built on the former Powell & Minnock brick site.",
      "sourceSentenceIds": [
        30
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Coeymans%2C_New_York",
