  "facts": [
    {
      "id": 1,
      "text": "Grafton was formed from Troy and Petersburgh on March 20, 1807, becoming the last town in Rensselaer County to be settled.",
      "sourceSentenceIds": [
        26
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Grafton%2C_New_York"
    },
    {
      "id": 2,
      "text": "The town’s name traces back to Grafton, Vermont, where its first supervisor, Nathaniel Dumbleton, was originally from.",
      "sourceSentenceIds": [
        2,
        4
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Grafton%2C_New_York"
    },
    {
      "id": 3,
      "text": "The Dickinson Hill Fire Tower, standing on a former lookout point, earned a spot on the National Register of Historic Places in 2011.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Grafton%2C_New_York"
    },
    {
      "id": 4,
      "text": "A Peace Pagoda, built by the Nipponzan Myohoji Buddhist order in 1993, sits quietly amid Grafton’s rural landscape.",
      "sourceSentenceIds": [
        19
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Grafton%2C_New_York"
    },
    {
      "id": 5,
      "text": "NY Route 2 cuts across Grafton, linking the town to the broader north‑central corridor of Rensselaer County.",
      "sourceSentenceIds": [
        18
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Grafton%2C_New_York"
    },
    {
      "id": 6,
      "text": "Grafton lies east of Albany and northwest of the Massachusetts border, offering a scenic, rural setting between these notable landmarks.",
