  "facts": [
    {
      "id": 1,
      "text": "Arcadia was named by postmistress Sarah Coulter Hawthorne in 1874 after wild roses and the Greek myth of Arcadia.",
      "sourceSentenceIds": [
        3,
        4
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/arcadia_nebraska"
    },
    {
      "id": 2,
      "text": "First settlers George McKeller and Porter Brown arrived in 1873, establishing early homesteads that became Arcadia.",
      "sourceSentenceIds": [
        1,
        13
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://genealogytrails.com/neb/valley/Neb_hist_markers.htm"
    },
    {
      "id": 3,
      "text": "Arcadia was platted in 1885 anticipating a railroad, and the first train arrived in 1889 via a Burlington branch.",
      "sourceSentenceIds": [
        10,
        11,
        15
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Arcadia%2C_Nebraska"
    },
    {
      "id": 4,
      "text": "Arcadia celebrated its centennial in 1985 with parades and reenactments, drawing residents and descendants to honor pioneer legacies.",
      "sourceSentenceIds": [
        12,
        18
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/arcadia_nebraska"
    },
    {
      "id": 5,
      "text": "Arcadia’s slogan, 'A Home to Come Home To,' highlights its strong family traditions.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/arcadia_nebraska"
    },
    {
      "id": 6,
      "text": "Historically, the area's proximity to the Middle Loup River facilitated early settlement by providing water resources and fertile soils amid the expansive prairie grasslands.",
      "sourceSentenceIds": [
        20
      ],
