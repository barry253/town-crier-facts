  "facts": [
    {
      "id": 1,
      "text": "Fort Myer was originally called Fort Whipple, part of the Civil War defenses protecting Washington, D.C.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.dhr.virginia.gov/historic-registers/000-0004/"
    },
    {
      "id": 2,
      "text": "In 1881 the post was renamed Fort Myer to honor Brigadier General Albert J. Myer, inventor of the signal corps.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Fort_Myer"
    },
    {
      "id": 3,
      "text": "The fort became a National Historic Landmark in 1972 for its preserved cavalry facilities and early aviation history.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Fort_Myer"
    },
    {
      "id": 4,
      "text": "The Army’s first radio station, NAA, was built near Fort Myer in 1913, and its towers transmitted the first transatlantic wireless message in 1915.",
      "sourceSentenceIds": [
        28,
        29
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Fort_Myer"
    },
    {
      "id": 5,
      "text": "Quarters One, built in 1899, has housed the U.S. Army Chief of Staff since 1908.",
      "sourceSentenceIds": [
        14,
        15
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Fort_Myer"
    },
    {
      "id": 6,
      "text": "In 1942 the famed Army Band “Pershing’s Own” moved to Fort Myer, making it a home for elite ceremonial units.",
      "sourceSentenceIds": [
        25
