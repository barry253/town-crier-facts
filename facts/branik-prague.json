  "facts": [
    {
      "id": 1,
      "text": "Braník Rocks are limestone cliffs that rise above the Vltava River, offering a dramatic backdrop to the city.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.czechleaders.com/posts/the-branik-rocks-where-pragues-prehistoric-past-meets-todays-city-life/"
    },
    {
      "id": 2,
      "text": "The cliffs contain layers of rock that date back 420 million years, revealing a deep prehistoric past.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.czechleaders.com/posts/the-branik-rocks-where-pragues-prehistoric-past-meets-todays-city-life/"
    },
    {
      "id": 3,
      "text": "Historically, Braník Rocks were quarried for the “Old Town lime” that helped build Prague’s bridges and embankments.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.czechleaders.com/posts/the-branik-rocks-where-pragues-prehistoric-past-meets-todays-city-life/"
    },
    {
      "id": 4,
      "text": "Today, the same ancient stone hosts fossils, wartime tunnels, and climbers, blending nature, history, and urban life.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.czechleaders.com/posts/the-branik-rocks-where-pragues-prehistoric-past-meets-todays-city-life/"
    },
    {
      "id": 5,
      "text": "Braník once housed a brewery that operated for centuries before closing in 2002.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
