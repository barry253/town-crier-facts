      ],
      "source": "https://en.wikipedia.org/wiki/Ongata_Rongai",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Bomas of Kenya, a cultural center in Rongai, showcases traditional Kenyan lifestyles through living villages and performances.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
