  "facts": [
    {
      "id": 1,
      "text": "Mullica Hill’s name comes from Swedish‑Finnish settlers Eric, John, Olag, and William Mullica who began buying land in 1704.",
      "sourceSentenceIds": [
        2,
        8
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Mullica_Hill%2C_New_Jersey",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "A railroad spur built in the 19th century turned the village into one of the nation’s busiest agricultural shipping points.",
      "sourceSentenceIds": [
        14
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://mullicahill.com/town-history/",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The town hall, still standing, was constructed after the Civil War and is a key example of post‑war architecture.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Mullica_Hill%2C_New_Jersey",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "In 1991, the entire village was listed on the National Register of Historic Places for its architectural and commercial significance.",
      "sourceSentenceIds": [
        10,
        16
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Mullica_Hill%2C_New_Jersey",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Every fall, Mullica Hill hosts a Civil War reenactment that celebrates the period of industrial and agricultural growth.",
      "sourceSentenceIds": [
        18
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Mullica_Hill%2C_New_Jersey",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The area’s early Quaker plantations, established in the late 17th century, laid the groundwork for the town’s later development.",
      "sourceSentenceIds": [
        13
      ],
      "sourceLabels": [
        "Web source 1"
      ],
