  "facts": [
    {
      "id": 1,
      "text": "Laurie sits on a ridge that drains in all directions toward the Lake of the Ozarks, giving the town a unique topographic character.",
      "sourceSentenceIds": [
        23
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Laurie%2C_Missouri",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town’s only historic building, the Laurie Market, was the first in the area to have a telephone and a drilled water well.",
      "sourceSentenceIds": [
        29,
        30
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://lauriemo.gov/history/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "During the Great Depression, the completion of Bagnell Dam created the Lake of the Ozarks, turning the surrounding hills into a resort community.",
      "sourceSentenceIds": [
        28
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://lauriemo.gov/history/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Laurie is located just about two miles north of the Lake of the Ozarks, placing it close to Missouri’s most famous waterway.",
      "sourceSentenceIds": [
        20
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Laurie%2C_Missouri",
      "category": "other",
      "quality": "poor",
      "qualityReason": "location_description"
    },
    {
      "id": 5,
      "text": "Every year from mid‑November to New Year’s Day, Laurie hosts the Enchanted Village of Lights, a drive‑through display that brightens the town for holiday travelers.",
      "sourceSentenceIds": [
        26
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Laurie%2C_Missouri",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The Osage tribe once called the lake area home, and today archaeologists still uncover arrowheads and tomahawks along the Osage River and Gravois Creek.",
      "sourceSentenceIds": [
