  "facts": [
    {
      "id": 1,
      "text": "Deltana sits at the confluence of the Tanana and Delta rivers, a site historically used by Upper Tanana Athabascans.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/deltana_alaska",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The 1913 Chisana gold strike drew thousands of stampeders, increasing traffic on the Valdez‑Fairbanks route near Deltana.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/deltana_alaska",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Army Signal Corps built the McCarty Telegraph station near a roadhouse at Deltana’s confluence, linking Valdez and Fairbanks.",
      "sourceSentenceIds": [
        2,
        13
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Deltana%2C_Alaska",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "During World War II, the U.S. constructed Big Delta Army Airfield—later Fort Greely—just five miles south of Deltana.",
      "sourceSentenceIds": [
        3,
        20
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/deltana_alaska",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "In 1980, 70,000 acres were set aside as the Delta Bison Range to confine the expanding herd away from farmland.",
      "sourceSentenceIds": [
        22
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Deltana%2C_Alaska",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Archaeological sites like Old Healy Lake Village reveal over 10,000 years of occupation, with early 20th‑century epidemics altering traditional patterns.",
      "sourceSentenceIds": [
