  "facts": [
    {
      "id": 1,
      "text": "Dry Creek emerged during the forced relocation of the Cherokee Nation to Indian Territory during the Trail of Tears in the 1830s.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/dry_creek_oklahoma"
    },
    {
      "id": 2,
      "text": "The name Dry Creek comes from a local intermittent stream that runs through the area.",
      "sourceSentenceIds": [
        21
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/dry_creek_oklahoma"
    },
    {
      "id": 3,
      "text": "Dry Creek is located in southeastern Cherokee County near the head of Tenkiller Ferry Lake on the Illinois River.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Dry_Creek%2C_Oklahoma"
    },
    {
      "id": 4,
      "text": "Early settlers in Dry Creek focused on raising livestock and farming the fertile Ozark foothills.",
      "sourceSentenceIds": [
        20
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/dry_creek_oklahoma"
    },
    {
      "id": 5,
      "text": "The Dawes Commission oversaw the distribution of individual land allotments to tribal members in Dry Creek beginning in 1902.",
      "sourceSentenceIds": [
        23
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/dry_creek_oklahoma"
    },
    {
      "id": 6,
      "text": "Construction of the Tenkiller Ferry Dam began in 1947 to provide flood mitigation and hydroelectric power for the region.",
