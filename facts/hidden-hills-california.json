  "facts": [
    {
      "id": 1,
      "text": "Hidden Hills became the 73rd city in Los Angeles County on October 19, 1961.",
      "sourceSentenceIds": [
        19
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Hidden_Hills%2C_California",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The community was designed and developed in the 1950s by landscape architect A. Hanson, who also created Rolling Hills and Palos Verdes Estates.",
      "sourceSentenceIds": [
        16,
        17,
        18
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Hidden_Hills%2C_California",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Hidden Hills is a gated residential community with no sidewalks or streetlights, giving it a rough‑around‑the‑edges charm that Vanity Fair highlighted in 2017.",
      "sourceSentenceIds": [
        20
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Hidden_Hills%2C_California",
      "category": "culture",
      "quality": "poor",
      "qualityReason": "editorial_filler"
    },
    {
      "id": 4,
      "text": "The city lies just north of U.S. Route 101, also called the Ventura Freeway, and borders the Upper Las Virgenes Canyon Open Space Preserve to the north.",
      "sourceSentenceIds": [
        24,
        25,
        23
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Hidden_Hills%2C_California",
      "category": "transport",
      "quality": "poor",
      "qualityReason": "route_only"
    },
    {
      "id": 5,
      "text": "The earliest inhabitants of the area were Chumash people, whose presence dates back thousands of years.",
      "sourceSentenceIds": [
        15
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Hidden_Hills%2C_California",
      "category": "people",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Hidden Hills is surrounded by the Santa Monica Mountains and the southern Simi Hills Transverse range, placing it on the western edge of the San Fernando Valley.",
      "sourceSentenceIds": [
        14,
        22
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Hidden_Hills%2C_California",
