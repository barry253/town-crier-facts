  "facts": [
    {
      "id": 1,
      "text": "Mound City earned its name from a Native American mound that once stood nearby, a site where guests at General Rawlings’ hotel would sleep to enjoy cool breezes and fewer mosquitoes.",
      "sourceSentenceIds": [
        16
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Mound_City%2C_Illinois",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "During the Civil War, the U.S. Navy built a shipyard in Mound City, complete with marine ways, a foundry, and barracks, though flood waters often kept many repair facilities afloat.",
      "sourceSentenceIds": [
        13
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Mound_City%2C_Illinois",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "In 1862, the Navy moved its Mississippi River Squadron headquarters upstream to Mound City, purchasing 10 acres of land to support the growing naval station.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Mound_City%2C_Illinois",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Mound City was incorporated in 1857 as a union of two towns—Mound City, founded by Major General Moses Marshal Rawlings, and Emporium City, a Cincinnati‑Cairo real estate venture.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Mound_City%2C_Illinois",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Geographically, Mound City sits along the Ohio River just north of its confluence with the Mississippi River, a strategic spot during the Civil War.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
