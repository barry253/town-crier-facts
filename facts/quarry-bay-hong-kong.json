  "facts": [
    {
      "id": 1,
      "text": "Quarry Bay's river was diverted by the Tai Koo Reservoir to supply water to Taikoo Dockyard, Sugar factory, and later Swire Coca‑Cola plant.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Quarry_Bay",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The former Swire Coca‑Cola factory on Greig Road is now the residential complex Kornville, while the old Taikoo Sugar factory has become the commercial hub Taikoo Place.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Quarry_Bay",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Quarry Bay Station links the Island Line and Tseung Kwan O line, making it a key transfer point for commuters across Hong Kong Island.",
      "sourceSentenceIds": [
        15
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Quarry_Bay",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The Hong Kong Film Archive, located in Quarry Bay, preserves rare films from Hong Kong’s golden era and hosts rotating exhibits for film lovers.",
      "sourceSentenceIds": [
        12,
        13,
        14
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://hongkongtravel.info/destinations/quarry-bay/",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Quarry Bay’s eastern section, known as Quarry Point, was largely owned by Swire, so many buildings carry the Chinese name Taikoo, reflecting the company’s legacy.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Quarry_Bay",
      "category": "other",
      "quality": "poor",
      "qualityReason": "vague"
    },
    {
      "id": 6,
      "text": "The western end of Quarry Bay, once part of North Point, hosted popular swimming galas in the 1930s, drawing crowds to its sandy beaches.",
