      "id": 1,
      "text": "Williams began as a railroad town in 1874, first called Central before the name changed in 1876.",
      "sourceSentenceIds": [
        3,
        2
      ],
      "sourceLabels": [
        "Web source 1",
        "Wikipedia"
      ],
