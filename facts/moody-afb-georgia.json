  "facts": [
    {
      "id": 1,
      "text": "Moody AFB was originally called Valdosta Airfield and renamed Moody Army Air Field on December 6, 1941.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Moody_Air_Force_Base"
    },
    {
      "id": 2,
      "text": "During World War II, Moody Field trained pilots for the 29th Training Wing, which began there in 1941.",
      "sourceSentenceIds": [
        13
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Moody_Air_Force_Base"
    },
    {
      "id": 3,
      "text": "In 1943, the 804th Women’s Army Auxiliary Corps was activated at Moody Field, bringing 155 enlisted women to the post.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.moody.af.mil/About-Us/FactSheets/"
    },
    {
      "id": 4,
      "text": "The Army Air Corps built 349 buildings at Moody, including 72 barracks, a 170‑bed hospital, and a theater.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.moody.af.mil/About-Us/FactSheets/"
    },
    {
      "id": 5,
      "text": "In 1957, advanced interceptor training and F‑86D Sabres moved to Moody from Tyndall AFB, while its F‑89Ds went to James Connally AFB.",
      "sourceSentenceIds": [
        25
      ],
      "sourceLabels": [
