  "facts": [
    {
      "id": 1,
      "text": "Lake Secession was named to commemorate Abbeville's mark on Civil War history as the first town to secede from the Union.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.lakesecession.com/lake-history"
    },
    {
      "id": 2,
      "text": "Lake Secession is a fourteen hundred and fifty acre reservoir located in Abbeville County on the Rocky River.",
      "sourceSentenceIds": [
        22
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.lakesecession.com/"
    },
    {
      "id": 3,
      "text": "The City of Abbeville completed the Lake Secession Dam in nineteen forty as a Works Progress Administration project.",
      "sourceSentenceIds": [
        23
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.lakesecession.com/"
    },
    {
      "id": 4,
      "text": "Lake Secession impounds the waters of the Rocky River for approximately six miles.",
      "sourceSentenceIds": [
        24,
        26
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.lakesecession.com/"
    },
    {
      "id": 5,
      "text": "The City of Abbeville has owned and operated Lake Secession since its original completion in nineteen forty.",
      "sourceSentenceIds": [
        27,
        28
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.lakesecession.com/"
    },
    {
      "id": 6,
      "text": "The reservoir of Lake Secession extends north from Abbeville County into Anderson County.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Lake_Secession%2C_South_Carolina"
    }
  ]
