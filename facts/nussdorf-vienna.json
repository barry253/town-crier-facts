  "facts": [
    {
      "id": 1,
      "text": "Nußdorf’s name, meaning “nut town,” comes from the many hazelnut trees that once lined its streets.",
      "sourceSentenceIds": [
        23
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Nu%C3%9Fdorf%2C_Vienna"
    },
    {
      "id": 2,
      "text": "Nußdorf sits on both banks of the Nußbach, where the brook meets the Danube Canal.",
      "sourceSentenceIds": [
        21
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Nu%C3%9Fdorf%2C_Vienna"
    },
    {
      "id": 3,
      "text": "In 1783, a tartar and vinegar factory was founded in Nußdorf, using wine‑by‑product residues.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Nu%C3%9Fdorf%2C_Vienna"
    },
    {
      "id": 4,
      "text": "Franz Xaver Bosch bought the factory in 1815 and launched the Nußdorfer Brewery in 1818.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Nu%C3%9Fdorf%2C_Vienna"
    },
    {
      "id": 5,
      "text": "A state‑financed salmiac and salt factory opened in 1800, turning inn‑keepers’ urine into salt.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Nu%C3%9Fdorf%2C_Vienna"
    },
    {
      "id": 6,
      "text": "Viticulture was the backbone of Nußdorf’s prosperity, with monasteries like Klosterneuburg owning vineyards early on.",
      "sourceSentenceIds": [
        14
      ],
      "sourceLabels": [
