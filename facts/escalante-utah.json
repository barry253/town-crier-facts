  "facts": [
    {
      "id": 1,
      "text": "Escalante is named after Silvestre Vélez de Escalante, a Franciscan missionary who led the first European expedition into southern Utah.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Escalante%2C_Utah",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The valley where Escalante sits was called Potato Valley by early explorers after discovering wild potatoes growing there.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Escalante%2C_Utah",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The Escalante River skirts the north side of town, flowing eastward toward the area known as Big Flat.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Escalante%2C_Utah",
      "category": "transport",
      "quality": "poor",
      "qualityReason": "route_only"
    },
    {
      "id": 4,
      "text": "The Hole-in-the-Rock Road, beginning five miles east of Escalante, is the main access route into the Grand Staircase–Escalante National Monument.",
      "sourceSentenceIds": [
        12,
        13
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Escalante%2C_Utah",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Settlers built their first home in March 1876, and many original native‑brick houses still stand in Escalante today.",
      "sourceSentenceIds": [
        21,
        22
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Escalante%2C_Utah",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Since the monument’s 1996 creation, Escalante has seen a surge in visitors, with an estimated 600,000 BLM‑managed tourists passing through each year.",
      "sourceSentenceIds": [
        27,
