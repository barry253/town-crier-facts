  "facts": [
    {
      "id": 1,
      "text": "College Springs began in 1854 as the utopian community of Amity, covering 7,000 acres and promoting moral reform, antislavery, and temperance, inspired by Rev. George Washington Gale.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/college_springs_iowa",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The Western Industrial and Scientific Association, a group of abolitionist reformers from Galesburg, Illinois, led the early settlement and establishment of Amity in 1854.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/college_springs_iowa",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "In February 1855, the community was formally incorporated and renamed the Amity Collegiate Association, marking a shift toward educational focus.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/college_springs_iowa",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The Amity Collegiate Association raised $30,000, bought 7,000 acres, and planned a utopian village, using land sale proceeds to fund the institution and scholarships for shareholders' children.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/college_springs_iowa",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "A 1901 fire destroyed much of College Springs’ business district, leading to a brick rebuild and a brief boom fueled by the Iowa & Southwestern Railway until 1917.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 2"
