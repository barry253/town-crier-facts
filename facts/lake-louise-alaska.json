  "facts": [
    {
      "id": 1,
      "text": "Originally called Lake Adah by Lt. Joseph Castner in 1898, the body of water was renamed Lake Louise by Captain Edwin Glenn in honor of his wife.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Lake_Louise%2C_Alaska",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The area sits within traditional Ahtna Athabascan territory, where the Ahtna people have maintained deep cultural ties to the landscape for millennia.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/lake_louise_alaska",
      "category": "people",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "During World War II, the U.S. Army established a recreation facility at the lake and built the first road into the area.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Lake_Louise%2C_Alaska",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Lake Louise State Recreation Area features a trail that leads to the hilltop where the Army’s original cabins still stand, though in severe disrepair.",
      "sourceSentenceIds": [
        27
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Lake_Louise%2C_Alaska",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Bird Island hosts the only known freshwater nesting site for cormorants in Alaska, drawing birdwatchers from across the state.",
