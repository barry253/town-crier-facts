  "facts": [
    {
      "id": 1,
      "text": "Alexander, Kansas, was founded in 1869 as a trading post and is the oldest town in Rush County.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://rushcounty.org/history_alexander.html",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town takes its name from Alexander Harvey, a 6th Cavalry soldier who established the original trading post.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/alexander_kansas",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "In 1886 Alexander shifted to the south bank of Walnut Creek to sit beside the Santa Fe Railroad, sparking a brief boom.",
      "sourceSentenceIds": [
        2,
        9,
        11
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/alexander_kansas",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "At its peak, Alexander boasted a bank, hospital, newspaper, lumberyard, Santa Fe depot, hotel, churches, and general stores.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Alexander%2C_Kansas",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The abandoned three‑story brick school on K‑96 remains a notable landmark in Alexander.",
