      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "During the 19th century, Stellarton hosted the Foord Pit and Allan Shaft mines, making it a coal‑mining powerhouse.",
      "sourceSentenceIds": [
