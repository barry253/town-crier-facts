  "facts": [
    {
      "id": 1,
      "text": "Blumengard Colony was founded in 1952 as a daughter colony of the Blumengart Hutterite Colony from Manitoba, Canada.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/blumengard_colony_south_dakota"
    },
    {
      "id": 2,
      "text": "Blumengard Colony belongs to the Schmiedeleut Group 2 of the Hutterian Brethren and emphasizes communal living and agriculture.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/blumengard_colony_south_dakota"
    },
    {
      "id": 3,
      "text": "South Dakota's 1935 Communal Corporation Act allowed Blumengard Colony to legally operate as a religious and economic unit with shared property.",
      "sourceSentenceIds": [
        10,
        13
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/blumengard_colony_south_dakota"
    },
    {
      "id": 4,
      "text": "Blumengard Colony is situated in the Northern Glaciated Plains ecoregion at an elevation of approximately 1,614 feet above sea level.",
      "sourceSentenceIds": [
        23
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/blumengard_colony_south_dakota"
    },
    {
      "id": 5,
      "text": "The fertile silty loam soils of Blumengard Colony support robust crop production but require careful management to prevent erosion.",
      "sourceSentenceIds": [
        24,
        25
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/blumengard_colony_south_dakota"
    },
    {
      "id": 6,
      "text": "Blumengard Colony established daughter colonies including the Maple River Hutterite Colony in 1968 and the Evergreen Hutterite Colony in 1992.",
      "sourceSentenceIds": [
        17
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/blumengard_colony_south_dakota"
    }
  ]
