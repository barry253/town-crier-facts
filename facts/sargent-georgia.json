  "facts": [
    {
      "id": 1,
      "text": "Sargent was named after brothers George and Captain H., who owned a local cotton mill in the late 1800s.",
      "sourceSentenceIds": [
        16,
        17
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Sargent%2C_Georgia",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The first textile mill in Sargent opened in 1886, and a general store followed soon after to serve the growing workforce.",
      "sourceSentenceIds": [
        19
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://westgatextiletrail.com/sargent-and-arnco/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Sargent and nearby Arnco together hosted a rich textile industry, with two mills and a railroad that hauled blankets out by freight.",
      "sourceSentenceIds": [
        1,
        10
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://westgatextiletrail.com/sargent-and-arnco/",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "In the 1920s and 1930s, Arnall Mill owners built a “New Town” of shotgun, saltbox, and gable‑front cottages for mill workers.",
      "sourceSentenceIds": [
        23,
        24,
        25
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://westgatextiletrail.com/sargent-and-arnco/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The last textile mill in Sargent closed in 2001, ending over a century of cotton production in the community.",
      "sourceSentenceIds": [
        20
      ],
      "sourceLabels": [
        "Web source 1"
      ],
