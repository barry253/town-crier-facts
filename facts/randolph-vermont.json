  "facts": [
    {
      "id": 1,
      "text": "Randolph was chartered June 29, 1781, originally called Middlesex, by Aaron Storrs and 70 others.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Randolph%2C_Vermont",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town was renamed Randolph to honor Founding Father Edmund Randolph, a gesture to strengthen Vermont's national identity.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Randolph%2C_Vermont",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Victorian prosperity left Randolph with fine Second Empire depot and Renaissance Revival Kimball Public Library, still standing today.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Randolph%2C_Vermont",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "In 1848, the Vermont Central Railroad opened service through Randolph, linking the town to the wider region.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Randolph%2C_Vermont",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Downtown Randolph centers around an Amtrak station, shops, a Playhouse Movie Theatre, and several gas stations, making it a regional hub.",
      "sourceSentenceIds": [
        15
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Randolph%2C_Vermont",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Randolph hosts the Porter Music Box Museum and Chandler Music Hall, showcasing local arts and historic instruments.",
      "sourceSentenceIds": [
        30
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
