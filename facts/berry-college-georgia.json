      ],
      "source": "https://en.wikipedia.org/wiki/Berry_College",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "In the 1930s, the campus expanded to 30,000 acres thanks to Henry Ford’s donation, enabling the construction of the Ford Complex.",
      "sourceSentenceIds": [
        30
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
