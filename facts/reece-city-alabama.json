  "facts": [
    {
      "id": 1,
      "text": "Reece City was first settled by non‑Indians in 1835 after the Cherokee removal, marking the start of white settlement in the Little Wills Valley.",
      "sourceSentenceIds": [
        4,
        9
      ],
      "sourceLabels": [
        "Web source 1",
        "Web source 2"
      ],
      "source": "https://encyclopediaofalabama.org/article/reece-city/"
    },
    {
      "id": 2,
      "text": "The town’s first post office opened in October 1884 under the name Hill, before the community later adopted the name Reeceville in 1903.",
      "sourceSentenceIds": [
        3,
        24
      ],
      "sourceLabels": [
        "Web source 2",
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/reece_city_alabama"
    },
    {
      "id": 3,
      "text": "Reece City officially incorporated in May 1956 after residents voted to include a six‑mile area within the new town limits.",
      "sourceSentenceIds": [
        11,
        25,
        26
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Reece_City%2C_Alabama"
    },
    {
      "id": 4,
      "text": "The town sits in the valley of Little Wills Creek, flanked by Big Ridge to the west and Lookout Mountain to the east.",
      "sourceSentenceIds": [
        14
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Reece_City%2C_Alabama"
    },
    {
      "id": 5,
      "text": "Alabama State Route 211 connects Reece City to US 11 and I‑59, providing a direct route south across Lookout Mountain to Gadsden.",
