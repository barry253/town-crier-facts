  "facts": [
    {
      "id": 1,
      "text": "Keene was founded in 1934 when the first post office opened, giving the town its name.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://visitkeenetx.com/history",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Old Betsy, the local nickname for a famous steam engine, now names Keene’s main street that runs parallel to the old railroad track.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://visitkeenetx.com/history",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Keene’s early pioneers opened the Keene Industrial Academy in 1893, blending classroom learning with hands‑on work experience.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://visitkeenetx.com/history",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The town’s economy once boomed with more than 20 broom factories, a printing press, a cabinet maker, and a motel.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://visitkeenetx.com/history",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Southwestern Union College, founded as a high school in 1896, grew into a twelve‑grade academy and later became part of the university campus.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.tshaonline.org/handbook/entries/keene-tx",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "A historic water tower stood on the SWAU campus from 1921 until it was taken down in 1970.",
      "sourceSentenceIds": [
