  "facts": [
    {
      "id": 1,
      "text": "Boydton was founded in 1812 by Alexander Boyd, a Scottish immigrant who owned the land and laid out the town.",
      "sourceSentenceIds": [
        1,
        3
      ],
      "sourceLabels": [
        "Web source 1",
        "Wikipedia"
      ],
      "source": "https://www.boydton.org/history-of-boydton"
    },
    {
      "id": 2,
      "text": "The town’s streets honor War of 1812 heroes, reflecting its early patriotic spirit.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.boydton.org/history-of-boydton"
    },
    {
      "id": 3,
      "text": "Boyd's Tavern, an early 19‑century building, was restored by Boyd’s descendants and now welcomes public tours.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Boydton%2C_Virginia"
    },
    {
      "id": 4,
      "text": "The United Boydton Methodist Church, designed by Jacob Holt, once housed the stagecoach office that linked Boydton to Petersburg.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.boydton.org/history-of-boydton"
    },
    {
      "id": 5,
      "text": "Boydton’s historic courthouse, a Greek‑Revival structure with six columns, echoes Jeffersonian architecture.",
      "sourceSentenceIds": [
        14
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.boydton.org/history-of-boydton"
    },
    {
      "id": 6,
      "text": "The town sits on a 1‑square‑mile colonial core that boasts over 1,000 historic sites, a treasure trove for walking tours.",
      "sourceSentenceIds": [
