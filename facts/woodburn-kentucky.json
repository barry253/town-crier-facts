      "id": 1,
      "text": "Woodburn began as a hamlet known as 'Mason's Inn,' a stagecoach stop along the road that now follows U.S. Route 31W.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
