  "facts": [
    {
      "id": 1,
      "text": "Evansburg is recognized as one of the earliest planned villages in the United States, featuring well-preserved rural architecture.",
      "sourceSentenceIds": [
        27
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.livingplaces.com/PA/Montgomery_County/Lower_Providence_Township/Evansburg_Historic_District.html"
    },
    {
      "id": 2,
      "text": "The eight-arch stone Skippack Bridge, built in 1792, is the oldest bridge of its size in continuous heavy service in America.",
      "sourceSentenceIds": [
        2,
        8
      ],
      "sourceLabels": [
        "Web source 1",
        "Web source 2"
      ],
      "source": "https://www.livingplaces.com/PA/Montgomery_County/Lower_Providence_Township/Evansburg_Historic_District.html"
    },
    {
      "id": 3,
      "text": "Evansburg served as a successful example of William Penn's vision for peaceful religious coexistence among diverse groups for over two centuries.",
      "sourceSentenceIds": [
        13,
        24,
        26
      ],
      "sourceLabels": [
        "Web source 1",
        "Web source 2"
      ],
      "source": "https://www.livingplaces.com/PA/Montgomery_County/Lower_Providence_Township/Evansburg_Historic_District.html"
    },
    {
      "id": 4,
      "text": "The Evansburg Free Library is housed in a building that predates 1792 and once served as a school, chapel, and printing site.",
      "sourceSentenceIds": [
        10,
        11,
        12
      ],
      "sourceLabels": [
        "Web source 1",
        "Web source 2"
      ],
      "source": "https://www.livingplaces.com/PA/Montgomery_County/Lower_Providence_Township/Evansburg_Historic_District.html"
    },
    {
      "id": 5,
      "text": "The Evansburg Historic District was listed on the National Register of Historic Places in 1972 and contains over 50 historic properties.",
      "sourceSentenceIds": [
        14,
        15
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Evansburg%2C_Pennsylvania"
    },
    {
      "id": 6,
      "text": "Keyser’s Mill in Evansburg is a rare surviving water-powered mill that represents the area's early industrial history.",
