  "facts": [
    {
      "id": 1,
      "text": "The village’s name comes from a legend where Iroquois Indians were defeated by Illinois Indians along the river that now bears the same name.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://iroquoiscountyil.gov/about",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Iroquois sits on the north side of the west‑flowing Iroquois River, a tributary of the Kankakee.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Iroquois%2C_Illinois",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "In 1858 the Peoria and Oquawka Railroad began building eastward from Peoria, passing through what would become Iroquois.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://iroquoiscountyil.gov/about",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Route 52 cuts through the village, linking it just four miles to Sheldon and Donovan.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Iroquois%2C_Illinois",
      "category": "transport",
      "quality": "poor",
      "qualityReason": "route_only"
    },
    {
      "id": 5,
      "text": "Iroquois is surrounded by farmland, reflecting its roots in a predominantly agricultural region.",
