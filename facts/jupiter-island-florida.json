      ],
      "source": "https://www.jupiterisland.com/history/",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The Jupiter Inlet Lifesaving Station opened in 1892 to aid mariners through the island’s treacherous waters.",
      "sourceSentenceIds": [
        23
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.jupiterisland.com/history/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The lighthouse, erected in 1860, remains an active aid to navigation and a historic landmark on Jupiter Island.",
      "sourceSentenceIds": [
        27
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.jupiterisland.com/history/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The Jupiter Inlet Lighthouse Outstanding Natural Area, established in 2008, protects over 120 acres of maritime hammock, mangrove swamp, and scrub habitat.",
      "sourceSentenceIds": [
        16
      ],
      "sourceLabels": [
        "Web source 2"
      ],
