  "facts": [
    {
      "id": 1,
      "text": "Oxford first appeared on a European map in 1670, marking its early recognition as a colonial port.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://oxfordmuseummd.org/oxford-as-a-port-of-entry/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "In 1683 the Maryland General Assembly officially named Oxford a seaport, but the town was laid out between 1666 and 1668 by William Stephens Jr.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Oxford%2C_Maryland",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The Oxford–Bellevue Ferry, established in 1683, remains the oldest continuously operating private ferry service in the United States.",
      "sourceSentenceIds": [
        25
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Oxford%2C_Maryland",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Oxford’s prosperity ended with the Revolutionary War, when Robert Morris’s merchant success collapsed and the town’s fortunes vanished.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://oxfordmuseummd.org/oxford-as-a-port-of-entry/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "After the Civil War, the 1871 railroad and advances in canning revived Oxford, opening national markets for Chesapeake Bay oysters.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Oxford%2C_Maryland",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Oxford today still feels like a waterman’s town, with the Tred Avon River and historic charm preserved.",
      "sourceSentenceIds": [
        6
      ],
