  "facts": [
    {
      "id": 1,
      "text": "Country Squire Lakes was founded in 1973 by a developer who designed it as a planned community centered on several artificial lakes.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Country_Squire_Lakes%2C_Indiana"
    },
    {
      "id": 2,
      "text": "The community’s centerpiece is Country Squire Lake, a reservoir fed by Six Mile Creek, surrounded by smaller lakes.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Country_Squire_Lakes%2C_Indiana"
    },
    {
      "id": 3,
      "text": "Lakes in the western part drain into Mutton Creek, which flows southwest toward the Vernon Fork of the Muscatatuck River.",
      "sourceSentenceIds": [
        4,
        5
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Country_Squire_Lakes%2C_Indiana"
    },
    {
      "id": 4,
      "text": "Six Mile and Mutton Creeks are tributaries of the Vernon Fork of the Muscatatuck River, part of the White River watershed.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Country_Squire_Lakes%2C_Indiana"
    },
    {
      "id": 5,
      "text": "Indiana State Road 7 borders the community’s northeast edge, leading 3 miles southeast to North Vernon and 18 miles northwest to Columbus.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Country_Squire_Lakes%2C_Indiana"
    },
