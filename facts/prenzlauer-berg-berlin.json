    {
      "id": 1,
      "text": "Prenzlauer Berg literally means 'Prenzlau Hill' and has been seen as a hill since historic Berlin days.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Prenzlauer_Berg",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Over 300 buildings are protected historic monuments, including the municipal pool at Oderberger Straße and breweries on Milastraße and Knaackstraße.",
      "sourceSentenceIds": [
        19
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Prenzlauer_Berg",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The water tower at Rykestraße, built in 1877, still stands as a reminder of the district's early industrial era.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Prenzlauer_Berg",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "In the 1980s Prenzlauer Berg became a hotbed for East Germany's counterculture, hosting artists, activists, and the gay community.",
      "sourceSentenceIds": [
        21
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Prenzlauer_Berg",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The area played a key role in the peaceful revolution that brought down the Berlin Wall in 1989.",
      "sourceSentenceIds": [
        22
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Prenzlauer_Berg",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The former brewery on Schönhauser Allee now houses the Kulturbrauerei, a cultural center that hosts concerts and events.",
