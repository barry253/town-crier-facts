  "facts": [
    {
      "id": 1,
      "text": "Sherborn was settled in 1652 and incorporated in 1674, preserving rural heritage with farms, orchards, and over half the land as open space.",
      "sourceSentenceIds": [
        29
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.sherbornma.org/499/About-Sherborn",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town’s name originated when the General Court arbitrarily called it “Sherborne” before settling on Sherborn.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.sherbornma.org/499/About-Sherborn",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "In the 1890s a local mill became advertised as the largest refined cider mill in the world, feeding Boston markets via stagecoach and later railroad.",
      "sourceSentenceIds": [
        7,
        8
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.sherbornma.org/499/About-Sherborn",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Sherborn’s public library traces its roots to a 350‑year‑old story, celebrated with a digital archive launched for the town’s 350th birthday in 2024.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.sherbornstories.org/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Sherborn shares a highly ranked public school system with neighboring Dover, and its elementary school is Pine Hill School.",
      "sourceSentenceIds": [
        13,
        23
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Sherborn%2C_Massachusetts",
      "category": "people",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The town sits 18 miles southwest of Boston, a short drive that lets residents enjoy both rural charm and easy access to the city.",
