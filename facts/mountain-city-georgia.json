  "facts": [
    {
      "id": 1,
      "text": "Mountain City was originally called Pass Over because a road crossed the continental divide, and it sits about 2,500 feet above sea level.",
      "sourceSentenceIds": [
        2,
        7,
        10,
        12
      ],
      "sourceLabels": [
        "Web source 1",
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/mountain_city_georgia",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The Georgia General Assembly incorporated the town as Pass Over in 1907, and it was renamed Mountain City in 1915 to reflect its elevated position.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/mountain_city_georgia",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Tallulah Falls Railroad’s depot in Mountain City once had a roof that burned, but the granite walls kept the building standing.",
      "sourceSentenceIds": [
        13
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Stone_Mountain%2C_Georgia",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The York House, built in 1896 as Georgia’s oldest bed‑and‑breakfast, hosted Walt Disney and Joel Chandler Harris and was added to the National Register of Historic Places in 1982.",
      "sourceSentenceIds": [
        19
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/mountain_city_georgia",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The Mountain City Playhouse, famous for its weekend square‑dancing nights, has been a local cultural hub for decades.",
      "sourceSentenceIds": [
        23
      ],
      "sourceLabels": [
        "Web source 2"
      ],
