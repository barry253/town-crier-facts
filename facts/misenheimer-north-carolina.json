      ],
      "source": "https://en.wikipedia.org/wiki/Misenheimer%2C_North_Carolina",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Gray Stone Day School, a charter high school, opened in 2002 and moved to a former Pfeiffer campus in 2011.",
      "sourceSentenceIds": [
        2,
