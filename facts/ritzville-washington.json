  "facts": [
    {
      "id": 1,
      "text": "Ritzville was named after Phillip Ritz, who settled south of the town in 1864.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Ritzville%2C_Washington",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The Northern Pacific Railroad built a depot in 1881, turning Ritzville into the world's largest wheat shipping point by the early 1900s.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://exploreritzville.com/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "A major fire in 1901 destroyed the wooden downtown; reconstruction began with brick, giving Ritzville its historic brick streets.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://exploreritzville.com/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The downtown area was listed on the National Register of Historic Places in 1990, preserving its 19th‑century character.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://exploreritzville.com/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The Ritzville Carnegie Library, opened in 1907, remains in operation and is a fine example of Carnegie‑era architecture.",
      "sourceSentenceIds": [
        11
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://exploreritzville.com/",
      "category": "landmark",
      "quality": "good"
    }
  ],
