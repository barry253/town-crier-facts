  "facts": [
    {
      "id": 1,
      "text": "Allen was founded in 1854, establishing itself as a growing settlement in northcentral Kansas.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Allen%2C_Kansas"
    },
    {
      "id": 2,
      "text": "The town was named after pioneer Allen McGee when a post office opened in his store on February 26, 1855.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://legendsofkansas.com/allen-kansas/"
    },
    {
      "id": 3,
      "text": "Allen became a Missouri Pacific Railroad station in 1886, linking the town to regional trade routes.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Allen%2C_Kansas"
    },
    {
      "id": 4,
      "text": "The first local newspaper, Allen Tidings, debuted in May 1887, just months after the depot was completed.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://legendsofkansas.com/allen-kansas/"
    },
    {
      "id": 5,
      "text": "The State Bank of Allen opened its doors in June 1895, providing financial services to the growing community.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://legendsofkansas.com/allen-kansas/"
    },
    {
      "id": 6,
      "text": "Among Allen's early businesses was a broom factory, a unique industry for a small Kansas town.",
      "sourceSentenceIds": [
