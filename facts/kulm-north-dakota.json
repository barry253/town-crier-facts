  "facts": [
    {
      "id": 1,
      "text": "Kulm was founded in 1892 as a railroad townsite along the Soo Line, becoming a temporary western terminus until 1898.",
      "sourceSentenceIds": [
        1,
        8
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/Kulm,_North_Dakota",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town was named after a village in Bessarabia, modern‑day Ukraine, by early German‑Russian settler Christian Flegel.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/Kulm,_North_Dakota",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "German‑Russian immigrants from Bessarabia, along with Swedes and Germans, arrived in the late 1880s and early 1890s to homestead the prairie.",
      "sourceSentenceIds": [
        29
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/Kulm,_North_Dakota",
      "category": "people",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "By 1893, Kulm had its first post office under postmaster Frederick Buechler and the Kulm Mill Company, supporting the growing agricultural community.",
      "sourceSentenceIds": [
        30
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/Kulm,_North_Dakota",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Families such as the Buechlers, Hillius, Kurtz, and Schuldheisz helped build Kulm’s wheat and grain farms on the open plains.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/Kulm,_North_Dakota",
      "category": "people",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Kulm experiences large seasonal temperature swings, with warm summers and harsh, sometimes severely cold, winters.",
      "sourceSentenceIds": [
        27
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
