  "facts": [
    {
      "id": 1,
      "text": "Whitwell was renamed from Cheekville after Thomas Whitwell, a British metallurgist who founded a coal company and died in 1878.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Whitwell%2C_Tennessee",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Whitwell grew into a mining town thanks to nearby coal deposits and became an incorporated city in 1956.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Whitwell%2C_Tennessee",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "In 1981, there was a major mining accident when 13 coal miners were killed in an explosion.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Whitwell%2C_Tennessee",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Whitwell also has an annual Labor Day celebration that has been celebrated for over 50 consecutive years.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Whitwell%2C_Tennessee",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Whitwell sits in the southwestern Sequatchie Valley at the base of a steep escarpment of the Cumberland Plateau, with the Sequatchie River just east of the city.",
      "sourceSentenceIds": [
        14,
        15
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Whitwell%2C_Tennessee",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Since 1998, Whitwell students have created the Paper Clips Project, a Holocaust memorial that teaches history through handmade paper clips.",
