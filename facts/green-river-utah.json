  "facts": [
    {
      "id": 1,
      "text": "Green River began as Blake Station, a ferry and way station on the east bank of the river, founded in the late 1870s along the overland mail route.",
      "sourceSentenceIds": [
        3,
        20,
        23
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/Green_River,_Utah",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The Denver and Rio Grande Western Railway arrived in 1883, turning the small hamlet into a boom town with a bridge and roadbed built for the railroad.",
      "sourceSentenceIds": [
        1,
        9,
        14
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 2"
      ],
      "source": "https://en.wikipedia.org/wiki/Green_River%2C_Utah",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The John Wesley Powell Museum in Green River displays historic boats from Powell's 1869–1871 river expeditions, which mapped the basin.",
      "sourceSentenceIds": [
        13,
        5,
        26
      ],
      "sourceLabels": [
        "Web source 1",
        "Wikipedia"
      ],
      "source": "https://www.visitutah.com/places-to-go/cities-and-towns/green-river",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Green River sits on ancestral Ute lands, home to the Seuvarits/Sheberetch band of Ute people.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Green_River%2C_Utah",
      "category": "other",
      "quality": "poor",
      "qualityReason": "other"
    },
    {
      "id": 5,
      "text": "Green River is within easy driving distance of Arches, Canyonlands, and Capitol Reef national parks.",
