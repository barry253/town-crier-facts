  "facts": [
    {
      "id": 1,
      "text": "Köpenick first appears in a 1210 deed issued by Margrave Conrad II of Lusatia.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/K%C3%B6penick"
    },
    {
      "id": 2,
      "text": "The historic town sits on an island where the Dahme and Spree rivers meet, forming Berlin's largest meltwater valley.",
      "sourceSentenceIds": [
        3,
        4
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/K%C3%B6penick"
    },
    {
      "id": 3,
      "text": "In 1558, Elector Joachim II Hector built a hunting lodge that later became Köpenick Palace, now a baroque landmark.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/K%C3%B6penick"
    },
    {
      "id": 4,
      "text": "The Müggelberge hills in Köpenick rise to 115 m, the highest natural point in Berlin, earning the area the nickname “green lungs.”.",
      "sourceSentenceIds": [
        26,
        25
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/K%C3%B6penick"
    },
    {
      "id": 5,
      "text": "Köpenick’s old town hosts 23 storytelling stops, from the city hall to the palace, offering an audio tour of its 800‑year history.",
      "sourceSentenceIds": [
        14
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.berlin-tourismus-online.de/home-eng.html"
    },
    {
      "id": 6,
      "text": "In 1686, a French Huguenot commune was founded in Köpenick, making it a historic refuge for religious exiles.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
