  "facts": [
    {
      "id": 1,
      "text": "Köpenick first appears in a 1210 deed by Margrave Conrad II, marking its earliest recorded mention.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/K%C3%B6penick",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The historic town sits on an island where the Dahme and Spree rivers meet, forming a natural peninsula in Berlin's meltwater valley.",
      "sourceSentenceIds": [
        3,
        4
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/K%C3%B6penick",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "In 1558, Elector Joachim II Hector built a hunting lodge that later became the baroque Köpenick Palace, now a cultural landmark.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/K%C3%B6penick",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The 1936 Olympics hosted rowing competitions in nearby Grünau, with athletes lodging close to Köpenick’s waterways.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/K%C3%B6penick",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Köpenick’s green lungs nickname comes from vast pine forests and lakes like Müggelsee that cover much of its surface.",
      "sourceSentenceIds": [
        26
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/K%C3%B6penick",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The Müggelberge hills rise to 115 m, the highest natural point in Berlin, offering panoramic views over Köpenick.",
      "sourceSentenceIds": [
        27
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
