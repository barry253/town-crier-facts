  "facts": [
    {
      "id": 1,
      "text": "Clintwood was originally called Holly Creek after a stream, then renamed for Major Henry Clinton Wood, a Confederate officer.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Clintwood%2C_Virginia",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town was founded in 1882 when the General Assembly created a new city on Holly Creek to serve as county seat.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://townofclintwood.com/clintwood-history",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "In 1948 Clintwood elected an all‑female town council, dubbed the “Petticoat Government,” catching the eye of Lady Astor.",
      "sourceSentenceIds": [
        13,
        14
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Clintwood%2C_Virginia",
      "category": "people",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Clintwood hosts the Ralph Stanley Museum, honoring the bluegrass legend who grew up in nearby Sandy Ridge.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Clintwood%2C_Virginia",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The town sits at 3,500 feet, giving it an oceanic climate despite being in Appalachia.",
      "sourceSentenceIds": [
        18
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Clintwood%2C_Virginia",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Clintwood’s historic downtown features the Flanagan Dam and Reservoir, a key water source for the region.",
      "sourceSentenceIds": [
        7
