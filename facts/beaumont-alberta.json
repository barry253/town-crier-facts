  "facts": [
    {
      "id": 1,
      "text": "Beaumont’s name comes from the French phrase meaning “beautiful hill,” chosen when the post office was established in 1895.",
      "sourceSentenceIds": [
        1,
        13
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Beaumont%2C_Alberta"
    },
    {
      "id": 2,
      "text": "Beaumont is one of Alberta’s four officially bilingual municipalities, a status that reflects its French‑Canadian heritage.",
      "sourceSentenceIds": [
        14,
        28
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Beaumont%2C_Alberta"
    },
    {
      "id": 3,
      "text": "Downtown Beaumont feels like a French village, with red‑brick walkways and historic buildings echoing its early settlers.",
      "sourceSentenceIds": [
        11
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Beaumont%2C_Alberta"
    },
    {
      "id": 4,
      "text": "Vital Church, built in 1919, stands in Beaumont’s center and is one of the city’s oldest religious structures.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Beaumont%2C_Alberta"
    },
    {
      "id": 5,
      "text": "Every summer, Beaumont hosts the Beaumont Blues & Roots Festival, drawing artists like Chantal Kreviazuk and Corb Lund.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.comeexplorecanada.com/alberta/beaumont"
    },
    {
      "id": 6,
      "text": "Beaumont transitioned from village in 1973 to town in 1980, finally becoming a city in 2019.",
