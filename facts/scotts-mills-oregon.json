  "facts": [
    {
      "id": 1,
      "text": "Scotts Mills takes its name from the sawmill and flour mill owned by Robert Hall Scott and Thomas Scott around 1866.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Scotts_Mills%2C_Oregon"
    },
    {
      "id": 2,
      "text": "Thomas McKay built a sawmill and a grist mill on Butte Creek in Scotts Mills starting in 1847.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.scottsmills.org/history-of-scotts-mills/"
    },
    {
      "id": 3,
      "text": "Butte Creek forms the northeastern border of Scotts Mills before joining the Pudding River in the Willamette River watershed.",
      "sourceSentenceIds": [
        15
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Scotts_Mills%2C_Oregon"
    },
    {
      "id": 4,
      "text": "The Friends Church was built in 1894 and remains a landmark that is still used for services today.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.scottsmills.org/history-of-scotts-mills/"
    },
    {
      "id": 5,
      "text": "The Christian Church was built in 1897 and now serves as the home of the Scotts Mills Area Historical Society.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.scottsmills.org/history-of-scotts-mills/"
    },
    {
      "id": 6,
      "text": "By 1905, the business district of Scotts Mills included a coffin factory, a photograph gallery, and a prune drying shed.",
      "sourceSentenceIds": [
        6
      ],
