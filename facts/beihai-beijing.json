  "facts": [
    {
      "id": 1,
      "text": "Beihai Park began as a lake in the late 10th‑century Liao Dynasty, where Emperor Taizong built the Yao Island Palace on its shore.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://urbanchinatravelogue.com/beihai-park-beijing-travel-guide/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The 35.9‑meter White Dagoba on Qionghua Island blends Tibetan and Han styles, partly designed by Nepalese artisan Araniko.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://urbanchinatravelogue.com/beihai-park-beijing-travel-guide/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "South of Beihai Park sits the Round City, a 46‑meter‑diameter island that has witnessed 800 years of Chinese history.",
      "sourceSentenceIds": [
        11
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://urbanchinatravelogue.com/beihai-park-beijing-travel-guide/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Beihai Park sits just a stone’s throw from the Forbidden City and Jingshan Park, making it a quiet oasis amid Beijing’s historic core.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://urbanchinatravelogue.com/beihai-park-beijing-travel-guide/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "During the Ming and Qing dynasties, Beihai Park was part of the Imperial City’s wall, accessed through seven gates that framed the capital’s heart.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Imperial_City%2C_Beijing",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Beihai Park’s story spans the Jin, Yuan, Ming, and Qing dynasties, preserving nearly a millennium of Chinese culture in a single lake.",
      "sourceSentenceIds": [
        15
      ],
