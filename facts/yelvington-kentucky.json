  "facts": [
    {
      "id": 1,
      "text": "Yelvington was founded in the 1790s by settler Yelverton Overly, whose name evolved into the town's name.",
      "sourceSentenceIds": [
        1,
        3
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/yelvington_kentucky",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The original settlement sat on a key wagon road linking Elizabethtown to the Ohio River ford at Shawneetown, Indiana.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/yelvington_kentucky",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Yelvington grew into a rural hub thanks to fertile soil, abundant timber, and its elevated hilltop location.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/yelvington_kentucky",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "After the railroad arrived, many businesses moved east to the Powers Station, now called Maceo.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Yelvington%2C_Kentucky",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Yelvington Baptist Church, organized in 1813, remains the oldest Baptist church in Daviess County.",
