  "facts": [
    {
      "id": 1,
      "text": "Tsurumi-ryokuchi Park was the venue for Osaka’s International Flower and Greenery Exposition in 1990.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
