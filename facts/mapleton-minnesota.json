  "facts": [
    {
      "id": 1,
      "text": "Mapleton, originally called Sherman, was renamed after the Maple River in 1854 because of the river’s abundant maple trees lining its banks.",
      "sourceSentenceIds": [
        19,
        20
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/mapleton_minnesota"
    },
    {
      "id": 2,
      "text": "The Chicago, St. Paul, Minneapolis and Omaha Railroad reached Mapleton in 1871, turning the town into a regional grain‑shipping hub.",
      "sourceSentenceIds": [
        6,
        7,
        9,
        11,
        13
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/mapleton_minnesota"
    },
    {
      "id": 3,
      "text": "Mapleton’s public library, built in 1910, marked a civic milestone during the town’s early 20th‑century expansion.",
      "sourceSentenceIds": [
        17
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/mapleton_minnesota"
    },
    {
      "id": 4,
      "text": "The Maple River Heritage Museum, located on Silver Street East, preserves the history of the Minnesota Settlement Association and local settlers.",
      "sourceSentenceIds": [
        15,
        16
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://mapleriverheritageinc.com/"
    },
    {
      "id": 5,
      "text": "In 2009, Mapleton’s historic district was added to the National Register of Historic Places for its social history significance.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/mapleton_minnesota"
    },
    {
      "id": 6,
      "text": "Mapleton hosts Minnesota’s oldest curling club, the Heather Curling Club, reflecting the town’s Scottish heritage.",
