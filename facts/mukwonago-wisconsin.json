  "facts": [
    {
      "id": 1,
      "text": "Mukwonago means 'bear's den' from the word mequanego.",
      "sourceSentenceIds": [
        21
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Mukwonago%2C_Wisconsin",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Before settlers, the Potawatomi tribe established a village along the Fox River where Mukwonago now sits.",
      "sourceSentenceIds": [
        2,
        7,
        14
      ],
      "sourceLabels": [
        "Web source 2",
        "Wikipedia",
