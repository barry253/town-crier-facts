      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "In 1843, twenty socialist families from England, led by Hunt, bought 160 acres around Spring Lake.",
      "sourceSentenceIds": [
        4,
        5
      ],
      "sourceLabels": [
        "Web source 1",
        "Web source 2"
      ],
      "source": "https://townofmukwonago.wi.gov/history/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The Milwaukee and Beloit railroad cut through Mukwonago, giving farmers a way to ship crops.",
      "sourceSentenceIds": [
        15,
        16
      ],
      "sourceLabels": [
        "Web source 1",
        "Web source 2"
      ],
      "source": "https://townofmukwonago.wi.gov/history/",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "When the Rock Freeway (I‑43) opened in 1972, it brought a wave of new residents to Mukwonago.",
      "sourceSentenceIds": [
        10,
        13
      ],
      "sourceLabels": [
        "Web source 1",
        "Web source 2"
      ],
      "source": "https://townofmukwonago.wi.gov/history/",
      "category": "history",
      "quality": "good",
      "qualityReason": "location_description"
    },
    {
      "id": 6,
      "text": "Mukwonago sits on the southwestern edge of Vernon Marsh, surrounding Upper and Lower Phantom Lakes.",
