    },
    {
      "id": 3,
      "text": "Pop Castle, a historic plantation home, was bombarded by a Union gunboat during the Civil War and later listed on the National Register in 1989.",
      "sourceSentenceIds": [
        1,
        4
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/White_Stone%2C_Virginia"
    },
    {
      "id": 4,
      "text": "Epaphroditus Lawson, born in Yorkshire, acquired 4,600 acres along the Rappahannock River in 1649–50, laying the groundwork for White Stone.",
      "sourceSentenceIds": [
        3,
        13
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/White_Stone%2C_Virginia"
    },
    {
      "id": 5,
      "text": "White Stone sits in the lower part of Lancaster County, the historic Northern Neck, and has long been tied to agriculture and maritime life.",
      "sourceSentenceIds": [
        5,
        6
      ],
      "sourceLabels": [
        "Web source 2"
