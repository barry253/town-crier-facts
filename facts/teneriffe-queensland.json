      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "By the 1880s Europeans settled Teneriffe, horse‑drawn trams began running in 1885, and land near Teneriffe House was auctioned in 1890.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 1"
