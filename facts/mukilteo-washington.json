    },
    {
      "id": 2,
      "text": "The town’s downtown, called Old Town, has been a Snohomish people settlement for over a millennium before European arrival.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Mukilteo%2C_Washington"
    },
    {
      "id": 3,
      "text": "Mukilteo Lighthouse Park, rebuilt with a $6.6 million renovation in 2008, now hosts a playground and historic 1906 lighthouse.",
      "sourceSentenceIds": [
