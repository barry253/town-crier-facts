  "facts": [
    {
      "id": 1,
      "text": "Anvik’s Christ Church Mission, founded in 1887, is the first Episcopal mission in the Yukon Valley and is listed on the National Register of Historic Places.",
      "sourceSentenceIds": [
        1,
        10
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.kupi.com/en/explore/united-states/anvik"
    },
    {
      "id": 2,
      "text": "Anvik sits where the Anvik River meets the Yukon, a spot that showcases the village’s resilience and natural beauty.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.kupi.com/en/explore/united-states/anvik"
    },
    {
      "id": 3,
      "text": "The native name Gitr’ingithchagg means “Place Where the Mouth of the River Is,” highlighting Anvik’s strategic river confluence.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.kupi.com/en/explore/united-states/anvik"
    },
    {
      "id": 4,
      "text": "Anvik lies west of the Yukon River, right at the mouth of the Anvik River.",
      "sourceSentenceIds": [
        16
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Anvik%2C_Alaska"
    },
    {
      "id": 5,
      "text": "The Anvik Connector trail, a national side trail, links the village to the Iditarod Trail 86 miles east.",
      "sourceSentenceIds": [
        18
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Anvik%2C_Alaska"
    },
    {
      "id": 6,
      "text": "Anvik Tribal Council governs the Deg Hit’an Athabascan community, preserving a heritage that stretches back centuries.",
