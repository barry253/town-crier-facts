      "quality": "good"
    },
    {
      "id": 2,
      "text": "The Palatine, Lake Zurich and Wauconda Railroad arrived in the late 19th century, bringing mail and vacationers, but shut down in 1920 due to lack of business.",
      "sourceSentenceIds": [
        11,
        13
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Wauconda%2C_Illinois",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Wauconda hosts the Wauconda Bog Nature Preserve, a National Natural Landmark that protects a rare glacial wetland.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Wauconda%2C_Illinois",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The Cook House, dedicated in 1992 by the Illinois State Historical Society, remains a preserved historic site on Main Street.",
