  "facts": [
    {
      "id": 1,
      "text": "Carnegie Hill got its name from Andrew Carnegie's 1901 mansion at Fifth Avenue and 91st St.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Carnegie_Hill",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The Carnegie Hill Historic District was first designated in 1974 and expanded in 1993, covering 86th to just north of 98th St.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Carnegie_Hill",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The neighborhood’s northern edge once lay at 96th St but has shifted into what was Spanish Harlem, now called Upper Carnegie Hill by brokers.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Carnegie_Hill",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The Cooper Hewitt, Smithsonian Design Museum now occupies Carnegie Hill’s original Carnegie mansion.",
      "sourceSentenceIds": [
        11
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Carnegie_Hill",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The area once hosted Native American homes of the Wechquaeesgek Indians, with dwellings made of bent trees.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.carnegiehillneighbors.org/history",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The Carnegie Hill Neighbors Association formed in 1970 to protect the district, leading to its landmark status.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 1"
      ],
