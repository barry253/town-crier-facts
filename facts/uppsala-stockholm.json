      "id": 1,
      "text": "Uppsala University, founded in 1477, is the oldest centre of higher education in Scandinavia.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Uppsala",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The city’s Uppsala Cathedral, the largest in the Nordics, dominates the western historic quarter.",
      "sourceSentenceIds": [
        13
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://tourismattractions.net/sweden/uppsala-history-facts",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Gamla Uppsala, just north of the city, hosts ancient Viking burial mounds and runestones that trace Sweden’s pagan past.",
      "sourceSentenceIds": [
        11
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Uppsala",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Carolina Rediviva, the university library, houses priceless manuscripts that have survived since the 16th century.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://tourismattractions.net/sweden/uppsala-history-facts",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Uppsala Castle, built by King Gustav Vasa, once served as a royal residence and made the city Sweden’s secondary capital.",
      "sourceSentenceIds": [
        16
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Uppsala",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The Fyris River splits Uppsala into a historic western side with medieval streets and a modern eastern side that grew during the 1960s boom.",
