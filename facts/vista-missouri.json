  "facts": [
    {
      "id": 1,
      "text": "Vista’s name honors founder John Dawson’s daughter, Vista Lucetta, born in 1872, a common Midwestern practice of naming towns after family members.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/vista_missouri",
      "category": "people",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The village sprang up during the late 19th‑century railroad boom, a classic example of a rural Midwestern rail town that later faded into quiet obscurity.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/vista_missouri",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Vista’s origins mirror a broader pattern of dispersed rural communities formed after the Civil War, where families from Virginia and Tennessee established small trading posts and farms.",
      "sourceSentenceIds": [
        11
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/vista_missouri",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Located in west‑central Missouri, Vista sits within Clair County, a detail that ties the village to the county’s administrative history.",
      "sourceSentenceIds": [
        24
