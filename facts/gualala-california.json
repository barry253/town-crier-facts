  "facts": [
    {
      "id": 1,
      "text": "Gualala comes from the Kashaya Pomo village name Walaali, meaning 'where the water goes down'.",
      "sourceSentenceIds": [
        16
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Gualala%2C_California",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "In the 1860s a lumber mill on the Gualala River produced 175,000 board feet of lumber daily, powering the town's economy for four decades.",
      "sourceSentenceIds": [
        1,
        27,
        28,
        29,
        30
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Gualala%2C_California",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "A 68.5‑inch wide railroad once ran through Gualala, one of the widest gauges in the U.S., replacing animal power in the late 1800s.",
      "sourceSentenceIds": [
        2,
        3
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Gualala%2C_California",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Gualala enjoys a warm‑summer Mediterranean climate, with mild wet winters and cool dry summers shaped by its coastal position.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/Gualala,_California",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The Kashia Band of Pomo Indians, numbering about 1,500 at first contact, were renowned basket weavers and seasonal foragers along the Gualala River.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/Gualala,_California",
      "category": "people",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Today Gualala’s economy centers on tourism, a sharp turn from its former identity as a logging town.",
      "sourceSentenceIds": [
