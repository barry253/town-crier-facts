  "facts": [
    {
      "id": 1,
      "text": "Elmer City got its name from homesteader Elmer Seaton, who donated land for the townsite before his death in 1933.",
      "sourceSentenceIds": [
        1,
        26
      ],
      "sourceLabels": [
        "Web source 2",
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/elmer-city-washington",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town sprang up in the 1930s as a housing community for workers building the nearby Grand Coulee Dam, before formal incorporation in 1947.",
      "sourceSentenceIds": [
        3,
        29
      ],
      "sourceLabels": [
        "Web source 2",
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/elmer-city-washington",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Elmer City was officially incorporated on April 17, 1947, after electricity arrived in 1935.",
      "sourceSentenceIds": [
        11,
        27
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Elmer_City%2C_Washington",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Elmer City enjoys a semi‑arid climate, with hot, dry summers and cold, snowy winters shaped by the Columbia River Basin’s rain shadow.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/elmer-city-washington",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "About 29% of residents identify as Native American, reflecting the town’s location within the Colville Indian Reservation.",
      "sourceSentenceIds": [
        13
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Elmer_City%2C_Washington",
      "category": "people",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The town’s early economy centered on public administration and dam‑related jobs, a legacy that still supports a modest local base today.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
