      "id": 1,
      "text": "The first house in Walnut, built in 1828 by the Ament brothers at Red Oak Grove, marked the village’s beginnings.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
