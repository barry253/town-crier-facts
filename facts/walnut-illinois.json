  "facts": [
    {
      "id": 1,
      "text": "The first house in Walnut, built in 1828 by the Ament brothers at Red Oak Grove, marked the village’s beginnings.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://villageofwalnut.net/history/"
    },
    {
      "id": 2,
      "text": "Originally platted as Brewerville by Richard Brewer, the village later adopted the name Walnut.",
      "sourceSentenceIds": [
        24
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://villageofwalnut.net/history/"
    },
    {
      "id": 3,
      "text": "The Fulton branch of the Burlington Railroad reached Walnut in 1871, linking it to regional trade.",
      "sourceSentenceIds": [
        22
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://villageofwalnut.net/history/"
    },
    {
      "id": 4,
      "text": "After a devastating 1890 fire destroyed much of the business district, residents rallied with the slogan 'Walnut shall rise again' to rebuild.",
      "sourceSentenceIds": [
        25,
        28
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://villageofwalnut.net/history/"
    },
    {
      "id": 5,
      "text": "Walnut is part of the Ottawa Micropolitan Statistical Area, connecting it to a broader regional community.",
