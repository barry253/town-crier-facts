      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Founded in 1880, Oracle began as a stagecoach stop with guest ranches and small mines, drawing health seekers to its dry air.",
      "sourceSentenceIds": [
        15,
        8
      ],
      "sourceLabels": [
        "Web source 1",
