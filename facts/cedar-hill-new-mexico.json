  "facts": [
    {
      "id": 1,
      "text": "Cedar Hill was named in 1890 when residents drew the name from a hat, honoring the local cedar trees.",
      "sourceSentenceIds": [
        1,
        9
      ],
      "sourceLabels": [
        "Web source 2",
        "Wikipedia"
      ],
      "source": "https://grokipedia.com/page/cedar_hill_new_mexico"
    },
    {
      "id": 2,
      "text": "The area saw Euro‑American settlement in the mid‑19th century, thanks to the fertile Animas River floodplain that fed crops and livestock.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/cedar_hill_new_mexico"
    },
    {
      "id": 3,
      "text": "Cedar Hill’s church, rebuilt as part of the Aztec Museum and Pioneer Village, stands as a symbol of early settler resilience.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/cedar_hill_new_mexico"
    },
    {
      "id": 4,
      "text": "A post office operated in Cedar Hill from 1892 until 1966, serving the growing community.",
