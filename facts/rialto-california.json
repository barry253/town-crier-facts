  "facts": [
    {
      "id": 1,
      "text": "Rialto takes its name from Venice’s famous Rialto Bridge, a nickname given by an early settler’s daughter.",
      "sourceSentenceIds": [
        6,
        7
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.rialtohs.org/history",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Although incorporated in 1911, Rialto’s history stretches back to the 15th‑century Serrano Indians who first settled the area.",
      "sourceSentenceIds": [
        15,
        23
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.rialtoca.gov/488/History-of-Rialto",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The Santa Fe Railroad’s 1887 extension between San Bernardino and Los Angeles prompted the Semi‑Tropic Land and Water Company to lay out Rialto’s townsite.",
      "sourceSentenceIds": [
        13,
        17,
        18
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Rialto%2C_California",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "An early 19th‑century adobe, now the city’s oldest building, sits restored near Bud Bender Park, once called Lilac Park.",
      "sourceSentenceIds": [
        24
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Rialto%2C_California",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Pyro Spectaculars, one of America’s largest fireworks companies, has its headquarters in Rialto.",
