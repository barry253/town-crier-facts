      "category": "culture",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The area comprises two colonias: Roma Norte and Roma Sur, divided by Coahuila street.",
      "sourceSentenceIds": [
        27
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Colonia_Roma",
      "category": "other",
