  "facts": [
    {
      "id": 1,
      "text": "Bethel Manor was the site of the Battle of Big Bethel on June 10, 1861, the first organized land battle of the Civil War.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/bethel_manor_virginia",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The community is a Military Family Community for Joint Base Langley‑Eustis, supporting families stationed at the nearby base.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Bethel_Manor%2C_Virginia",
      "category": "other",
      "quality": "poor",
      "qualityReason": "editorial_filler"
    },
    {
      "id": 3,
      "text": "European settlers first arrived around 1610, making the area one of the earliest English settlements on the Virginia Peninsula.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/bethel_manor_virginia",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Baptist congregations emerged in the late colonial era, becoming early anchors of Bethel Manor’s community identity.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/bethel_manor_virginia",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Bethel Manor’s coastal location exposes it to occasional tropical influences, including a risk of hurricanes during the Atlantic season.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/bethel_manor_virginia",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The temperate climate supports diverse vegetation and shapes local water cycles across the surrounding coastal plain.",
