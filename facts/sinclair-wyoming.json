  "facts": [
    {
      "id": 1,
      "text": "Sinclair was originally called Parco after the Producers and Refiners Corporation, which founded the refinery and the company town.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Sinclair%2C_Wyoming"
    },
    {
      "id": 2,
      "text": "The town was renamed Sinclair after the Sinclair Consolidated Oil Corporation acquired the original company during the Great Depression.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Sinclair%2C_Wyoming"
    },
    {
      "id": 3,
      "text": "Denver architects designed Sinclair as a planned community in the mid-twenties using a Spanish Colonial Revival style.",
      "sourceSentenceIds": [
        16
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Sinclair%2C_Wyoming"
    },
    {
      "id": 4,
      "text": "The original oil refinery located just east of Sinclair remains in use to this day.",
      "sourceSentenceIds": [
        15
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Sinclair%2C_Wyoming"
    },
    {
      "id": 5,
      "text": "The historic center of Sinclair was designated as the Parco Historic District in 1987.",
      "sourceSentenceIds": [
        17
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Sinclair%2C_Wyoming"
    },
    {
      "id": 6,
      "text": "Most of the original town sites in Sinclair are listed in the National Register of Historic Places.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.sinclairwyoming.com/history.php"
    }
  ]
}
