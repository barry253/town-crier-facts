  "facts": [
    {
      "id": 1,
      "text": "New Britain earned the nickname “Hardware City” because 19th‑century firms like Stanley Works and Corbin Locks made it a manufacturing hub.",
      "sourceSentenceIds": [
        13
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/New_Britain%2C_Connecticut",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The Stanley Works began in 1843 when Frederick Trent Stanley founded a bolt manufactory that later became Stanley Black & Decker.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/New_Britain%2C_Connecticut",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Central Connecticut State University, founded as a normal school in 1849, sits in New Britain and shares the city’s historic industrial roots.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.britannica.com/place/New-Britain-Connecticut",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The New Britain Museum of American Art, established in 1903, houses a celebrated collection of American paintings and reflects the city’s artistic heritage.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.britannica.com/place/New-Britain-Connecticut",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Walnut Hill Park, designed by Frederick Law Olmsted, offers a green oasis and is listed on the National Register of Historic Places.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/New_Britain%2C_Connecticut",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The New Britain Bees, a Double‑A baseball team, play at Willow Brook Park, where fans can enjoy a hotdog while watching the game.",
