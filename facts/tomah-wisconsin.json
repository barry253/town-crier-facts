      "category": "nature",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Robert E. Gillett founded Tomah in 1855, later incorporating it as a city in 1883.",
      "sourceSentenceIds": [
        2,
        11
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Tomah%2C_Wisconsin",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Tomah remains a rail hub, served by Canadian Pacific, Union Pacific freight lines and Amtrak passenger trains.",
