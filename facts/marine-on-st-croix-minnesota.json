      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "In 1964, residents formed the Marine Restoration Society to preserve the town’s historic riverside charm.",
      "sourceSentenceIds": [
        13,
        21
      ],
      "sourceLabels": [
        "Web source 1",
        "Web source 2"
