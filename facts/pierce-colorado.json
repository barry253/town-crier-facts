  "facts": [
    {
      "id": 1,
      "text": "Pierce earned its name from General John Pierce, president of the Denver Pacific Railroad, when a side track was laid there in 1869.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.piercecolo.gov/pages/our-history",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The first building in Pierce was a boxcar beside the track, later replaced by a house for the track foreman's family.",
      "sourceSentenceIds": [
        24,
        25
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.piercecolo.gov/pages/our-history",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "A post office has operated in Pierce since 1903, with Richard Sullivan as its first postmaster.",
      "sourceSentenceIds": [
        26
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.piercecolo.gov/pages/our-history",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Pierce was formally established as a community in 1918, the same year the Pierce Leader newspaper began publishing.",
      "sourceSentenceIds": [
        28,
        29
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.piercecolo.gov/pages/our-history",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The town’s historic grocery store on Main Street still stands, a relic of Pierce’s early commercial life.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.uncovercolorado.com/towns/pierce/",
      "category": "landmark",
      "quality": "good"
    },
    {
