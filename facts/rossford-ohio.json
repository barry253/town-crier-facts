  "facts": [
    {
      "id": 1,
      "text": "Rossford got its name by blending Ford’s second wife’s surname, Ross, with his own, a nod to the town’s founder.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Rossford%2C_Ohio",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Founded in 1898, Rossford grew around Edward Ford’s glass plant, which occupied 173 acres on the Maumee River.",
      "sourceSentenceIds": [
        3,
        5
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 2"
      ],
      "source": "https://en.wikipedia.org/wiki/Rossford%2C_Ohio",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Shortly after the plant opened, Ford built the Ford Club beside it, giving workers a place to relax and socialize.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Rossford%2C_Ohio",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "During its 100th anniversary in 1998, Rossford erected a memorial beside the Ford Club to honor the town’s origins.",
      "sourceSentenceIds": [
        11
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Rossford%2C_Ohio",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Rossford Public Library serves the community, offering a quiet spot for readers and a hub for local history.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Rossford%2C_Ohio",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Situated along the Maumee River, Rossford sits within the Toledo metropolitan area, bridging rural charm and urban convenience.",
      "sourceSentenceIds": [
        7
