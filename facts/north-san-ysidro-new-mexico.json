  "facts": [
    {
      "id": 1,
      "text": "North San Ysidro takes its name from Saint Isidore the Farmer, the patron saint of agriculture honored across New Mexico.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/north_san_ysidro_new_mexico",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town traces its roots to the 1815 Los Trigos Land Grant, a Spanish decree that encouraged settlement along the Pecos River.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/north_san_ysidro_new_mexico",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "North San Ysidro grew beside the historic Santa Fe Trail, a 19th‑century trade route that linked settlers to markets in Santa Fe.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/north_san_ysidro_new_mexico",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The climate is semi‑arid continental, with January lows around 15°F and July highs near 86°F, shaped by the Sangre de Cristo foothills.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/north_san_ysidro_new_mexico",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "At an average elevation of 6,522 feet, North San Ysidro experiences varied microclimates influenced by surrounding topography.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/north_san_ysidro_new_mexico",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Annual precipitation totals about 17 inches, mostly from July‑September monsoon rains, while winter snowfall averages 23 inches.",
      "sourceSentenceIds": [
