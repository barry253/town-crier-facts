  "facts": [
    {
      "id": 1,
      "text": "Park Falls began in the late nineteenth century as a small river village called Muskellunge Falls.",
      "sourceSentenceIds": [
        13
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Park_Falls%2C_Wisconsin"
    },
    {
      "id": 2,
      "text": "The town was renamed Park Falls because the pines near the falls gave the area the look of a park.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://cityofparkfallswi.gov/history-then-and-now"
    },
    {
      "id": 3,
      "text": "Henry Sherry built northern Wisconsin's first band-saw mill here in 1885, which cut 100 million feet of pine.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://cityofparkfallswi.gov/history-then-and-now"
    },
    {
      "id": 4,
      "text": "The North Fork of the Flambeau River divides Park Falls and serves as a site for fishing and canoeing.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Park_Falls%2C_Wisconsin"
    },
    {
      "id": 5,
      "text": "Park Falls grew rapidly with the addition of a pulp and paper mill and was incorporated as a city in 1912.",
      "sourceSentenceIds": [
        14
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Park_Falls%2C_Wisconsin"
    },
    {
      "id": 6,
      "text": "Murals on downtown buildings in Park Falls depict the history of the local businesses.",
      "sourceSentenceIds": [
        9
