  "facts": [
    {
      "id": 1,
      "text": "The history of Fort Indiantown Gap dates back to 1755, when the colonial government established forts to defend settlers.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Fort_Indiantown_Gap"
    },
    {
      "id": 2,
      "text": "Pennsylvania developed Fort Indiantown Gap in 1931 as a National Guard training site after outgrowing its previous location at Mount Gretna.",
      "sourceSentenceIds": [
        7,
        18
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 2"
      ],
      "source": "https://en.wikipedia.org/wiki/Fort_Indiantown_Gap"
    },
    {
      "id": 3,
      "text": "Fort Indiantown Gap became one of the nation's busiest Army training camps during World War II, serving as a staging area.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://exploreforts.com/forts/fort-indiantown-gap-pa"
    },
    {
      "id": 4,
      "text": "A massive construction project at Fort Indiantown Gap employed 13,000 workers to build over 1,400 buildings, including a 400-bed hospital.",
      "sourceSentenceIds": [
        22
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://exploreforts.com/forts/fort-indiantown-gap-pa"
    },
    {
      "id": 5,
      "text": "Fort Indiantown Gap encompasses about 18,000 acres of land with numerous training areas for military units and law-enforcement agencies.",
      "sourceSentenceIds": [
        23
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Fort_Indiantown_Gap"
    },
    {
      "id": 6,
      "text": "The State House, which served as the official residence of the Lieutenant Governor of Pennsylvania, is located on the grounds.",
