  "facts": [
    {
      "id": 1,
      "text": "Georgetown began as the settlement of Tabanana in 1831, named after the nearby creek that still flows through the area.",
      "sourceSentenceIds": [
        6,
        7,
        17
      ],
      "sourceLabels": [
        "Web source 2",
        "Web source 1"
      ],
      "source": "https://www.georgiahistory.com/ghmi_marker_updated/georgetown/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Quitman County was carved out of Randolph and Stewart counties in 1858, and Georgetown became its sole incorporated town and county seat.",
      "sourceSentenceIds": [
        8,
        16
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.gqc-ga.org/Default.asp?ID=72&pg=History",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The Quitman County Jail, built in the 19th century, earned a spot on the National Register of Historic Places for its architectural significance.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.gqc-ga.org/Default.asp?ID=72&pg=History",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Long before settlers arrived, a fortified prehistoric settlement stood where Cool Branch meets the Chattahoochee River, hinting at the area’s ancient roots.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.gqc-ga.org/Default.asp?ID=72&pg=History",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "A wooden two‑story courthouse erected shortly after the county’s creation burned down in 1920, leaving only the memory of its early civic life.",
      "sourceSentenceIds": [
        29,
        30
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.gqc-ga.org/Default.asp?ID=72&pg=History",
      "category": "history",
      "quality": "good"
