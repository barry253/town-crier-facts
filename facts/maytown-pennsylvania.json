      "quality": "good"
    },
    {
      "id": 3,
      "text": "Visitors to the society’s museum learn about Maytown’s role in the Underground Railroad and its early settlers.",
      "sourceSentenceIds": [
        16
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://museumsdatabase.com/museums/view/26968",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Maytown sits in western Lancaster County, where water drains east and west into unnamed tributaries of the Susquehanna River.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Maytown%2C_Pennsylvania",
