  "facts": [
    {
      "id": 1,
      "text": "Mathews earned its name from Judge George Mathews Jr., a 19th‑century Louisiana Supreme Court justice who owned the 10,000‑acre Georgia Plantation.",
      "sourceSentenceIds": [
        1,
        2
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/mathews_louisiana",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town grew from a plantation hub into a diversified center of agriculture, oil, and manufacturing that mirrors the broader bayou economy.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/mathews_louisiana",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Mid‑1800s saw waves of Cajun settlers who worked on estates like Georgia Plantation, weaving their culture into Mathews’ agricultural tapestry.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/mathews_louisiana",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "In 1835, Judge Mathews Jr. ruled that a woman freed in France could not be re‑enslaved, setting a national precedent.",
      "sourceSentenceIds": [
        18
      ],
