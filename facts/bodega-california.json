  "facts": [
    {
      "id": 1,
      "text": "Bodega Bay takes its name from Spanish naval officer Juan Francisco de la Bodega y Quadra, who charted the coast in the late 1700s.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Bodega_Bay%2C_California",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "During the Russian era, settlers called the settlement Port Rumyantsev, a nod to Foreign Minister Nikolai Petrovich Rumyantsev, before it became Bodega Bay.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Bodega_Bay%2C_California",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "In the 1960s, PG&E planned a nuclear plant at Gaffney Point, but protests and a nearby San Andreas Fault halted the project in 1964.",
      "sourceSentenceIds": [
        9,
