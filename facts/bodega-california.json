      ],
      "source": "https://en.wikipedia.org/wiki/Bodega_Bay%2C_California",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Alfred Hitchcock filmed most of The Birds in 1962 around Bodega Bay, a fact that still draws film fans to the town today.",
      "sourceSentenceIds": [
        20,
        26
      ],
      "sourceLabels": [
        "Wikipedia",
