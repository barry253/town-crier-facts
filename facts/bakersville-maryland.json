  "facts": [
    {
      "id": 1,
      "text": "Bakersville began as Carey's Crossroads, named after landowner George Carey.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://kids.kiddle.co/Bakersville,_Maryland",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The village sits where an early east–west road crossed the main north–south route from Sharpsburg.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Bakersville%2C_Maryland",
      "category": "other",
      "quality": "poor",
      "qualityReason": "location_description"
    },
    {
      "id": 3,
      "text": "German settlers built a union meeting house around 1800, shared by Lutherans, German Reformed, and Methodists.",
      "sourceSentenceIds": [
        6,
        20
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Bakersville%2C_Maryland",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "George Carey donated the land for the church and its graveyard.",
      "sourceSentenceIds": [
        7,
        21
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Bakersville%2C_Maryland",
      "category": "people",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "In 1823 the log church was replaced by a stone sanctuary and schoolhouse, marking the village’s growth.",
      "sourceSentenceIds": [
        8,
        22,
        23
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Bakersville%2C_Maryland",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Today, Salem Evangelical Lutheran Church and cemetery remain as the only public building, surrounded by historic homes.",
      "sourceSentenceIds": [
