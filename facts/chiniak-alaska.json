    },
    {
      "id": 2,
      "text": "In 1971, the Chiniak Tracking Station was converted into a deep‑space station to collect telemetry data.",
      "sourceSentenceIds": [
        7,
        8,
        9
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://chiniak.org/about/"
    },
    {
      "id": 3,
      "text": "The station closed in 1975, saving the Air Force $5.5 million annually in operational costs.",
      "sourceSentenceIds": [
        17
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://chiniak.org/about/"
    },
    {
      "id": 4,
      "text": "The Chiniak Home and School Association supplied library books and carpeting for the local school.",
      "sourceSentenceIds": [
        13
      ],
      "sourceLabels": [
