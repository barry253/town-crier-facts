  "facts": [
    {
      "id": 1,
      "text": "High Point was founded in 1859 and named for its position at the highest point on the North Carolina Railroad between Goldsboro and Charlotte.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://visithighpoint.com/about-high-point-nc/",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "By the mid‑20th century, High Point proudly called itself the “furniture and hosiery capital of the world,” a title reflected in its museum exhibits.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.highpointnc.gov/2122/High-Point-History",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The city’s largest furniture store, Furnitureland South, sits in High Point and remains the nation’s biggest single‑location furniture retailer.",
      "sourceSentenceIds": [
        23
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://visithighpoint.com/about-high-point-nc/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "High Point University, a private Methodist‑affiliated school founded in 1924, shares its name with the city and is a key local landmark.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/High_Point%2C_North_Carolina",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The High Point Museum’s “High Point’s Furniture Heritage” exhibit traces how the town’s factories once supplied the southern market with affordable wooden furniture.",
      "sourceSentenceIds": [
        28
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
