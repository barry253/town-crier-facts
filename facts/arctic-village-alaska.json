      "id": 1,
      "text": "Before the 1950s, the Neets’aii Gwichin of Arctic Village led a highly nomadic life, moving with the seasons.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.tananachiefs.org/about/communities/arctic-village/",
      "category": "people",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Around 1900, Arctic Village transitioned from seasonal camps to a permanent settlement.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Arctic_Village%2C_Alaska",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Arctic Village sits in a Diʼhaii Gwich’in speaking region, where 'my mother' translates to shahanh.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Arctic_Village%2C_Alaska",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "By 1999, more than 95% of residents spoke and understood the Gwich’in language.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Arctic_Village%2C_Alaska",
      "category": "people",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "On September 30, 1970, Arctic Village hit a record low of −13 °F, the coldest September temperature in Alaska.",
