  "facts": [
    {
      "id": 1,
      "text": "Avenida da Liberdade was built on the former Passeio Público, an 18th‑century park once reserved for nobility.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Avenida_da_Liberdade",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The avenue, 90 metres wide, was modeled after Paris’s Champs‑Élysées and opened between 1879 and 1886.",
      "sourceSentenceIds": [
        23,
        24
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Avenida_da_Liberdade",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "A monument in the middle of the boulevard commemorates the 1640 restoration of the Portuguese crown after 60 years of Iberian Union.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.lisbonportugaltourism.com/guide/avenida-da-liberdade.html",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The avenue hosts the Teatro Tivoli BBVA, a historic theater that has staged plays and concerts for over a century.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://lisboavibes.com/avenida-da-liberdade/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Avenida da Liberdade is served by three metro stations—Restauradores, Avenida, and Marquês de Pombal—on the Blue Line.",
      "sourceSentenceIds": [
        19,
        20
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Avenida_da_Liberdade",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The street’s name means “Avenue of Liberty,” reflecting its origins as a public promenade opened to all social classes in 1821.",
      "sourceSentenceIds": [
        22,
        25
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
