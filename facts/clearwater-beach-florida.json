  "facts": [
    {
      "id": 1,
      "text": "Clearwater Beach gets its name from the Native American word 'Pocotopaug,' meaning 'clear water,' after the area's fresh spring springs.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.myclearwater.com/My-Government/About-Clearwater",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Fort Harrison, a Seminole War fort on the bluffs south of downtown, evolved into Clearwater’s agricultural port by the 1850s.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://floridahistory.org/clearwater.htm",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "When Peter Demens’ railroad arrived in the Gilded Age, Clearwater became the county’s second‑largest town, cementing its regional importance.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://floridahistory.org/clearwater.htm",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Clearwater Coast Guard Air Station makes the city the 13th Coast Guard City in the United States, a title it proudly shares.",
      "sourceSentenceIds": [
        14
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.myclearwater.com/My-Government/About-Clearwater",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "With an average temperature of 75°F, Clearwater Beach enjoys a humid subtropical climate, where hot summers are softened by Gulf breezes.",
