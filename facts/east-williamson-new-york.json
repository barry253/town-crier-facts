    },
    {
      "id": 2,
      "text": "The hamlet sits at 456 feet, just two miles east of the town center of Williamson, near the Lake Ontario shoreline.",
      "sourceSentenceIds": [
        10,
        23
      ],
      "sourceLabels": [
        "Wikipedia",
