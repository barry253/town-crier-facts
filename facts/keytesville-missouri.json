  "facts": [
    {
      "id": 1,
      "text": "Keytesville was named after James Keyte, an English Methodist preacher who donated land for the county seat in 1830.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Keytesville%2C_Missouri",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town’s first industry was a mill James Keyte built on Mussel Fork Creek, turning Keytesville into a local milling hub.",
      "sourceSentenceIds": [
        16
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Keytesville%2C_Missouri",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "In 1889 merchants lured the Wabash Railroad to 1.5 miles north, sparking a streetcar line that linked Keytesville to nearby towns.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Keytesville%2C_Missouri",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Three historic sites—First Presbyterian Church, Chariton County Jail, and Redding‑Hill House—are listed on the National Register of Historic Places.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Keytesville%2C_Missouri",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Isaac Redding opened Keytesville’s first hotel in August 1842, a log building that also served as the town’s post office.",
      "sourceSentenceIds": [
        15,
        19
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Keytesville%2C_Missouri",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The original courthouse, a two‑story brick building, burned in 1864 during a Confederate raid led by Sterling Price.",
      "sourceSentenceIds": [
        13,
