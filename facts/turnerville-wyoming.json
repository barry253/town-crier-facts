  "facts": [
    {
      "id": 1,
      "text": "William A. Turner and his family founded Turnerville in September 1890 after moving from West Jordan, Utah, to install a sawmill.",
      "sourceSentenceIds": [
        3,
        16
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.starvalleyhistoricalsociety.org/Turnerville/"
    },
    {
      "id": 2,
      "text": "The Turners started one of the first dance orchestras in the Lower Valley, drawing people from across the region for entertainment.",
      "sourceSentenceIds": [
        22,
        23
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.starvalleyhistoricalsociety.org/Turnerville/"
    },
    {
      "id": 3,
      "text": "Rebecca Turner Hinck established the first school in Turnerville, teaching students during one winter at Grandma Turner's home.",
      "sourceSentenceIds": [
        21
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.starvalleyhistoricalsociety.org/Turnerville/"
    },
    {
      "id": 4,
      "text": "Turnerville established its first post office in 1927 with William J. Edgerton serving as the first postmaster.",
      "sourceSentenceIds": [
        25,
        26
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.starvalleyhistoricalsociety.org/Turnerville/"
    },
    {
      "id": 5,
      "text": "An independent branch of the LDS Church operated in Turnerville until it joined the Bedford Ward in December 1949.",
      "sourceSentenceIds": [
        19,
        20
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.starvalleyhistoricalsociety.org/Turnerville/"
    },
    {
      "id": 6,
      "text": "Nine other communities across North America share the name Turnerville, including locations in Alabama, Georgia, and Ontario.",
