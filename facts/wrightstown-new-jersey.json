      ],
      "source": "https://en.wikipedia.org/wiki/Wrightstown%2C_New_Jersey",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The borough was incorporated on March 4, 1918, after a referendum on March 26, 1918 split portions of New Hanover and North Hanover Townships.",
      "sourceSentenceIds": [
