      "category": "transport",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Fertagus trains began servicing Sete Rios Station in July 1999, linking Lisbon with the Algarve.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Sete_Rios_railway_station",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Intercidades trains between Gare do Oriente and Faro stop at Sete Rios Station three times daily in each direction.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Sete_Rios_railway_station",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "During peak hours, trains at Sete Rios Station arrive every ten minutes; off‑peak and weekends see about thirty‑minute intervals.",
