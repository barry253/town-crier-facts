      "quality": "good"
    },
    {
      "id": 2,
      "text": "Sete Rios Station opened on 20 May 1888 on the Cintura Line between Benfica and Santa Apolónia.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
