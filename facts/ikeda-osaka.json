    {
      "id": 1,
      "text": "Ikeda’s Tower of the Sun, a 70‑meter sculpture commissioned for the 1970 Expo, still dominates the city’s skyline.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.japan.travel/en/destinations/kansai/osaka/ikeda-and-northern-osaka/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Ikeda Castle, erected during the Nanboku‑chō period, was abandoned after Araki Murashige’s 1574 victory and the clan moved to Itami.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Ikeda%2C_Osaka",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The city hosts Satsukiyama Zoo, a municipal animal park that opened in 1974 and remains a local favorite.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Ikeda%2C_Osaka",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Daihatsu has operated a factory in Ikeda since the late 1930s, with its main office established in the 1960s.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Ikeda%2C_Osaka",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "To reach Ikeda, hop on the Hankyu Takarazuka Line at Hankyu‑Umeda and disembark at Ikeda Station.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.japan.travel/en/destinations/kansai/osaka/ikeda-and-northern-osaka/",
