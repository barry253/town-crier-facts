  "facts": [
    {
      "id": 1,
      "text": "La Latina takes its name from the 15th‑century Hospital de La Latina, founded by scholar Beatriz Galindo, who was nicknamed ‘La Latina’ for her Latin mastery.",
      "sourceSentenceIds": [
        2,
        3,
        13
      ],
