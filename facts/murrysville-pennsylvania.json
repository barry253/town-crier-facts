  "facts": [
    {
      "id": 1,
      "text": "Founded in 1820 by Jeremiah Murry, Murrysville grew along the Northern Turnpike as a planned settlement.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/Murrysville,_Pennsylvania",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "In 1878, brothers Michael and Obediah Haymaker drilled the first commercial natural gas well in the United States right in Murrysville.",
      "sourceSentenceIds": [
        27,
        30
      ],
      "sourceLabels": [
        "Web source 2",
        "Wikipedia"
      ],
      "source": "https://grokipedia.com/page/Murrysville,_Pennsylvania",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The early 20th‑century Haymaker Riots erupted over gas‑lease speculation, after a speculator named Haymaker was killed in a clash.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Murrysville%2C_Pennsylvania",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "A hillside Boy Scout‑made tree sign spells Murrysville, with its Y pointing toward the original Haymaker well site.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Murrysville%2C_Pennsylvania",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The Westmoreland Heritage Trail cuts through Murrysville, offering walkers and cyclists a route along historic railroad corridors.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Murrysville%2C_Pennsylvania",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The Murrysville Historical Preservation Society saved the 170‑year‑old Bossart House in the town square, preserving a piece of early architecture.",
      "sourceSentenceIds": [
        5
      ],
