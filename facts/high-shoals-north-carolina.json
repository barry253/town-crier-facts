  "facts": [
    {
      "id": 1,
      "text": "High Shoals got its name from the high rocky shoal across the Catawba River.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/High_Shoals%2C_North_Carolina",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town’s roots trace back to a Swiss‑born ironmaster, John Fulenwider, who founded the High Shoals Iron Works around 1795.",
      "sourceSentenceIds": [
        2,
        7
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/High_Shoals%2C_North_Carolina",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Fulenwider’s charcoal pig‑iron process was one of the earliest in America, keeping the ironworks running until 1875.",
      "sourceSentenceIds": [
        7,
        9
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/High_Shoals%2C_North_Carolina",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "During the War of 1812, the High Shoals ironworks supplied cannonballs to the U.S. Army.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/High_Shoals%2C_North_Carolina",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The South Fork Catawba River cuts through High Shoals, with Sulfur Branch flowing through the town’s western side.",
      "sourceSentenceIds": [
        12,
        14
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/High_Shoals%2C_North_Carolina",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "High Shoals was officially incorporated on November 6, 1973, making it the newest municipality in Gaston County.",
      "sourceSentenceIds": [
        11
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
