  "facts": [
    {
      "id": 1,
      "text": "Uranium City was founded in 1952 to serve the Beaverlodge uranium mines.",
      "sourceSentenceIds": [
        22
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Uranium_City"
    },
    {
      "id": 2,
      "text": "The town’s first school opened in 1977, named after the first teacher who started education in 1952 with 40 students.",
      "sourceSentenceIds": [
        15
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Uranium_City"
    },
    {
      "id": 3,
      "text": "In 1954, The Uranium Times reported 52 mines operating, including Gunnar, Lorado, and Fay‑Ace‑Verna.",
      "sourceSentenceIds": [
        23,
        25
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Uranium_City"
    },
    {
      "id": 4,
      "text": "By the 1960s, Uranium City supplied ore to Canada’s CANDU reactor, the first nuclear power plant in the country.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://uraniumcity-history.com/"
    },
    {
      "id": 5,
      "text": "The community’s original housing consisted mainly of tents before permanent structures were built.",
      "sourceSentenceIds": [
        24
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Uranium_City"
    },
    {
      "id": 6,
      "text": "The local hospital closed in spring 2003, marking a significant change in community services.",
      "sourceSentenceIds": [
        28
