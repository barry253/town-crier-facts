  "facts": [
    {
      "id": 1,
      "text": "Niota sits on the Mississippi River, straddling the eastern end of the Fort Madison Toll Bridge that links the town to Fort Madison, Iowa.",
      "sourceSentenceIds": [
        9,
        12
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Niota%2C_Illinois",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Niota marks the western terminus of Illinois Route 9 and is also served by Illinois Route 96, a segment of the Great River Road.",
      "sourceSentenceIds": [
        13
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Niota%2C_Illinois",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Flooding from the Mississippi River has repeatedly threatened Niota, with the 1993 flood becoming the worst in the town’s history.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Niota%2C_Illinois",
      "category": "other",
      "quality": "poor",
      "qualityReason": "vague"
    },
    {
      "id": 4,
      "text": "In July 1993, inmates joined local residents to reinforce Niota’s levees, helping to protect the community during the flood.",
      "sourceSentenceIds": [
        15
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Niota%2C_Illinois",
      "category": "other",
      "quality": "poor",
      "qualityReason": "vague"
    },
    {
      "id": 5,
      "text": "After Upper Mississippi flooding in April 1965, the U.S. Coast Guard dispatched the vessel Goldenrod to Niota for relief efforts.",
