  "facts": [
    {
      "id": 1,
      "text": "Wyckoff’s historic railroad station, built around 1870 by the New Jersey Midland Railway, later carried passengers for the NYS&W line.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
