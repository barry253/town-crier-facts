      "id": 1,
      "text": "Crossroads Arts District sits at 19th Street and Baltimore Avenue, just south of the Downtown Loop.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Crossroads%2C_Kansas_City",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Once called \"Film Row,\" the area hosted MGM and Disney distribution centers from the 1920s to the 1960s.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.kcur.org/arts-life/2025-07-12/kansas-city-crossroads-arts-district-guide",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Dozens of galleries occupy renovated warehouses, turning old industrial space into a living museum.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Crossroads%2C_Kansas_City",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Brewer's Alley is packed with breweries, all within walking distance of each other.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Crossroads%2C_Kansas_City",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The Crossroads PIEA tax abatement program requires arts uses to occupy at least 51% of a property’s square footage.",
      "sourceSentenceIds": [
        16
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Crossroads%2C_Kansas_City",
