      "id": 1,
      "text": "Randalls Island was once separated from Wards Island by a waterway called Little Hell Gate, which was filled in the early 1960s.",
      "sourceSentenceIds": [
        2,
        17
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
