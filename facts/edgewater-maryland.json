      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Historic London Town and Gardens spans 23 acres, preserving colonial buildings including the National Historic Landmark William Brown House.",
      "sourceSentenceIds": [
        1,
        5
      ],
      "sourceLabels": [
        "Web source 2",
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/Edgewater,_Maryland",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Edgewater Park offers baseball fields, playgrounds, and riverfront trails managed by Anne Arundel County.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/Edgewater,_Maryland",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Edgewater’s name reflects its colonial roots, echoing the original London Town settlement.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/Edgewater,_Maryland",
      "category": "etymology",
      "quality": "good"
    },
    {
