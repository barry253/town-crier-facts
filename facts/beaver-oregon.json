  "facts": [
    {
      "id": 1,
      "text": "Beaver takes its name from the North American beaver, an animal central to the early economy of the Oregon Country.",
      "sourceSentenceIds": [
        3,
        22
      ],
      "sourceLabels": [
        "Web source 2",
        "Web source 1"
      ],
      "source": "https://tillamookcoast.com/plan-your-trip/where-to-go/destination/beaver/"
    },
    {
      "id": 2,
      "text": "The Tillamook and Nestucca tribes utilized the area around Beaver along the Nestucca River before European-American arrival.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/beaver_oregon"
    },
    {
      "id": 3,
      "text": "Beaver established its own post office in 1889, which coincided with the relocation of a local general merchandise store.",
      "sourceSentenceIds": [
        10,
        23
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Beaver%2C_Oregon"
    },
    {
      "id": 4,
      "text": "The arrival of the railroad in 1911 enabled the efficient transport of goods and reduced reliance on coastal shipping.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/beaver_oregon"
    },
    {
      "id": 5,
      "text": "Munson Creek Falls, the tallest waterfall in the Oregon Coast Range, is located near Beaver.",
      "sourceSentenceIds": [
        19
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Beaver%2C_Oregon"
    },
    {
      "id": 6,
      "text": "Beaver remains an unincorporated community that serves as a quiet gateway to the region's natural attractions.",
