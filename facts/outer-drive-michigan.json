      ],
      "source": "https://en.wikipedia.org/wiki/Outer_Drive",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The westernmost section of Outer Drive spans 23.6 miles, running from Jefferson Avenue in Ecorse to Livernois Avenue in Detroit.",
      "sourceSentenceIds": [
