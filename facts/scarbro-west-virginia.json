    },
    {
      "id": 3,
      "text": "Scarbro is situated in a valley surrounded by the mountains of the Appalachian range.",
      "sourceSentenceIds": [
        16,
        17
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://nearbylens.com/cities/usa/wv/scarbro/"
    },
    {
      "id": 4,
      "text": "The art deco company store at Scarbro was built in 1937 to replace an earlier building that burned down.",
