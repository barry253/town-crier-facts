  "facts": [
    {
      "id": 1,
      "text": "Kingsland sits where the Colorado and Llano rivers merge to form Lake Lyndon B. Johnson.",
      "sourceSentenceIds": [
        8,
        17
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 2"
      ],
      "source": "https://en.wikipedia.org/wiki/Kingsland%2C_Texas",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town grew after the Houston and Texas Central Railroad arrived in 1892, bringing commerce and the Antlers Hotel.",
      "sourceSentenceIds": [
        12,
        19
      ],
      "sourceLabels": [
        "Web source 1",
        "Web source 2"
      ],
      "source": "https://kingslandchamber.org/history-lake-lbj-kingsland/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Lake LBJ, originally Lake Granite Shoals, was created in 1950 by the Granite Shoals Dam, giving Kingsland a popular lake hideaway.",
      "sourceSentenceIds": [
        1,
        5,
        11
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://kingslandchamber.org/history-lake-lbj-kingsland/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The Llano County Historical Museum, housed in the historic Bruhl Drugstore Building on the Llano River, interprets local history.",
      "sourceSentenceIds": [
        13,
        14,
        15
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://kingslandchamber.org/history-lake-lbj-kingsland/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Kingsland was originally called Kingsville, named after Martin D. King, and renamed after his wife Nancy Jane King surveyed the town in 1883.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 1"
