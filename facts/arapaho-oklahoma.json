    {
      "id": 2,
      "text": "The town of Arapaho came into existence on April 19, 1892, during the Cheyenne-Arapaho land opening.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 1"
      ],
