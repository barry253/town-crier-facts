  "facts": [
    {
      "id": 1,
      "text": "Trieste began as the Roman settlement Tergeste, later growing under Habsburg rule from 1382 to become a key Adriatic port.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.thecollector.com/history-trieste/"
    },
    {
      "id": 2,
      "text": "In 1833, the Austrian Lloyd shipping company was founded in Trieste to streamline maritime trade, inspired by London’s Lloyd’s.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.thecollector.com/history-trieste/"
    },
    {
      "id": 3,
      "text": "After Italy annexed Trieste, Lloyd Triestino moved its headquarters back to the city and adopted its new name in 1919.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.thecollector.com/history-trieste/"
    },
    {
      "id": 4,
      "text": "Trieste’s cosmopolitan heritage spans Roman ruins, Austrian coffee houses, and a history as the Habsburg Empire’s main commercial port.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.thecollector.com/history-trieste/"
    },
    {
      "id": 5,
      "text": "By 1295, Trieste’s ecclesiastical authorities had ceded power to secular administration, marking a shift toward modern governance.",
      "sourceSentenceIds": [
