  "facts": [
    {
      "id": 1,
      "text": "Elizabeth, West Virginia, is the county seat of Wirt County and is situated along the Little Kanawha River.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Elizabeth%2C_West_Virginia"
    },
    {
      "id": 2,
      "text": "William Beauchamp first settled the site of Elizabeth in 1796 when it was still part of Harrison County, Virginia.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Elizabeth%2C_West_Virginia"
    },
    {
      "id": 3,
      "text": "The town was known as Beauchamp's Mills until 1817, when it was renamed for Elizabeth Beauchamp, the wife of David Beauchamp.",
      "sourceSentenceIds": [
        3,
        5
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 2"
      ],
      "source": "https://en.wikipedia.org/wiki/Elizabeth%2C_West_Virginia"
    },
    {
      "id": 4,
      "text": "Elizabeth was chartered by the Virginia General Assembly in 1822 and became the county seat in 1848.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Elizabeth%2C_West_Virginia"
    },
    {
      "id": 5,
      "text": "The town figured prominently in the Burning Springs Oil Boom before the Civil War.",
      "sourceSentenceIds": [
        29
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://wvexplorer.com/travel/communities/cities-towns/elizabeth-west-virginia/"
    },
    {
      "id": 6,
      "text": "The Kanawha Hotel, a relic of the oil boom period in Elizabeth, is listed on the National Register of Historic Places.",
