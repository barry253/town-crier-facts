  "facts": [
    {
      "id": 1,
      "text": "Leuven hosts Belgium’s oldest university, founded in 1425, and it still shapes the city’s identity.",
      "sourceSentenceIds": [
        2,
        3,
        4
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://wonderfulwanderings.com/leuven/"
    },
    {
      "id": 2,
      "text": "The 15th‑century Town Hall and the 12th‑century St. Michael’s Cathedral are must‑see historic landmarks.",
      "sourceSentenceIds": [
        6,
        28
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://wonderfulwanderings.com/leuven/"
    },
    {
      "id": 3,
      "text": "Leuven lies on the Dijle River and was once a thriving medieval cloth‑producing town.",
      "sourceSentenceIds": [
        22,
        27
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://wonderfulwanderings.com/leuven/"
    },
    {
      "id": 4,
      "text": "After a Papal brief, the Catholic University of Leuven was refounded in 1834 in Mechelen.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/KU_Leuven"
    },
    {
      "id": 5,
      "text": "In 2025, Leuven elected Severine Vermeire as its first female rector, ending a male‑only legacy.",
      "sourceSentenceIds": [
        15,
        16
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/KU_Leuven"
    },
    {
      "id": 6,
      "text": "The UNESCO World Heritage Site Groot Begijnhof, a historic beguinage, doubles as a university residence hall.",
      "sourceSentenceIds": [
