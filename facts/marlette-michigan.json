    },
    {
      "id": 2,
      "text": "Founded in 1987, the society collects, interprets, and shares Marlette’s story for community benefit.",
      "sourceSentenceIds": [
        7,
        2
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://museumsdatabase.com/museums/view/15070"
    },
    {
      "id": 3,
      "text": "Historic Sanborn maps from 1893 to 1909 show Marlette’s early downtown layout, revealing businesses and schools that once lined Main Street.",
      "sourceSentenceIds": [
