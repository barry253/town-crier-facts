      ],
      "source": "https://www.tananachiefs.org/about/communities/hughes/",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The Koyukon Athabascans historically used the land around Hughes for seasonal hunting and fishing.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.kupi.com/en/explore/united-states/hughes/history",
      "category": "people",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "A post office opened in 1942, significantly improving Hughes’ connection with the outside world.",
      "sourceSentenceIds": [
        30
      ],
