        2
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.kupi.com/en/explore/united-states/hughes/history",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "In 1910, the town was named after New York Governor Charles Evans Hughes.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
