  "facts": [
    {
      "id": 1,
      "text": "Republic was founded by gold prospectors in the late 19th century, originally called Eureka Gulch.",
      "sourceSentenceIds": [
        1,
        7
      ],
      "sourceLabels": [
        "Web source 1",
        "Wikipedia"
      ],
      "source": "https://www.republicwa.org/history/"
    },
    {
      "id": 2,
      "text": "The town was platted April 29, 1898, and its post office name changed to Republic because another Eureka existed in Washington.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Republic%2C_Washington"
    },
    {
      "id": 3,
      "text": "Anderson's Grocery, opened in the summer of 1900, remains the oldest operating business in Republic.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Republic%2C_Washington"
    },
    {
      "id": 4,
      "text": "The Republic mine stayed idle until 1902 when railroads arrived, making mining profitable again.",
      "sourceSentenceIds": [
        16
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Republic%2C_Washington"
    },
    {
      "id": 5,
      "text": "The Ferry County Historical Center lets visitors explore Republic’s mining and logging heritage through photos and historic buildings.",
      "sourceSentenceIds": [
        3,
        21
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.republicwa.org/history/"
    },
    {
      "id": 6,
      "text": "Every year the Prospector's Days weekend celebrates the town’s mining and logging past with festivals in the second weekend of June.",
      "sourceSentenceIds": [
        19
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
