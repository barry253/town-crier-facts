  "facts": [
    {
      "id": 1,
      "text": "Tippecanoe was platted in 1840 along the Miami and Erie Canal, a key waterway that once ferried goods across Ohio.",
      "sourceSentenceIds": [
        1,
        8
      ],
      "sourceLabels": [
        "Web source 1",
        "Wikipedia"
      ],
      "source": "https://www.tippcityohio.gov/220/History",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town’s name honors General William Henry Harrison’s nickname, Tippecanoe, after his 1811 victory at the Battle of Tippecanoe.",
      "sourceSentenceIds": [
        9,
        14
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Tippecanoe%2C_Ohio",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "A post office opened in 1841 and operated for 170 years before closing in 2011, marking a long era of local communication.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Tippecanoe%2C_Ohio",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The dry canal locks east of downtown still stand, offering a glimpse into the era when boats navigated the Miami and Erie Canal.",
      "sourceSentenceIds": [
        16
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.tippcityohio.gov/220/History",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Tippecanoe City grew by merging with nearby Hyattsville, a village that shared the same canal‑era traffic and community spirit.",
      "sourceSentenceIds": [
        17
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.tippcityohio.gov/220/History",
