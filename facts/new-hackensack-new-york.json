  "facts": [
    {
      "id": 1,
      "text": "New Hackensack’s heart sits at the crossroads of All Angels Hill Road, New Hackensack Road, and Route 376, a spot officially called New Hackensack Square.",
      "sourceSentenceIds": [
        5,
        8
      ],
      "sourceLabels": [
        "Web source 1",
        "Web source 2"
      ],
      "source": "https://townofwappingerny.gov/town-of-wappinger-history/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The New Hackensack Reformed Church, founded in 1758, is one of only three original Dutch churches that still stand in Dutchess County.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://townofwappingerny.gov/town-of-wappinger-history/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "In 1775, Jacob Griffin’s Tavern in Swartwoutville hosted “Rendezvous” meetings where Tories and the Committee of Safety plotted a spy network.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://townofwappingerny.gov/town-of-wappinger-history/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The hamlet’s first railroad station opened there, marking the beginning of regional rail travel for New Hackensack residents.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.wappingershistoricalsociety.org/town-of-wappinger-history",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "South Mountain Road, a winding two‑lane historic road that runs through New Hackensack, earned a spot on the National Register of Historic Places.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/New_City%2C_New_York",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The Tea House, still standing, showcases carvings of mountains, windmills, and 1930s icons like Popeye, echoing the area’s Dutch‑American heritage.",
      "sourceSentenceIds": [
