  "facts": [
    {
      "id": 1,
      "text": "Cherokee Triangle is a historic Louisville neighborhood known for large homes with eclectic architectural styles.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Cherokee_Triangle%2C_Louisville"
    },
    {
      "id": 2,
      "text": "After Cherokee Park opened in 1891, the area quickly attracted affluent families who built grand homes in the neighborhood.",
      "sourceSentenceIds": [
        25
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Cherokee_Triangle%2C_Louisville"
    },
    {
      "id": 3,
      "text": "A unique landmark is the 1913 equestrian statue of General John Breckinridge Castleman, where the horse poses in the same direction as the rider.",
      "sourceSentenceIds": [
        5,
        11
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 2"
      ],
      "source": "https://en.wikipedia.org/wiki/Cherokee_Triangle%2C_Louisville"
    },
    {
      "id": 4,
      "text": "Cherokee Triangle was once part of the city of Enterprise, incorporated in 1884 to keep liquor sales out of the community.",
      "sourceSentenceIds": [
        2,
        3
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 2"
      ],
      "source": "https://en.wikipedia.org/wiki/Cherokee_Triangle%2C_Louisville"
    },
    {
      "id": 5,
      "text": "The Aquarius Apartments on Cherokee Road were cited as an example of an \"incompatible intrusion\" when the preservation district was established.",
      "sourceSentenceIds": [
        16,
        17
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 2"
      ],
      "source": "https://en.wikipedia.org/wiki/Cherokee_Triangle%2C_Louisville"
    },
    {
      "id": 6,
      "text": "The Cherokee Triangle Association formed in 1962, and new rules and down‑zoning slowed the trend of converting large homes into apartments.",
