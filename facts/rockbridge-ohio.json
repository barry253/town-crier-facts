  "facts": [
    {
      "id": 1,
      "text": "Rockbridge was named after a nearby sandstone arch that stretches about 100 feet long and 10‑20 feet wide.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Rockbridge%2C_Ohio"
    },
    {
      "id": 2,
      "text": "The arch, Ohio’s largest natural bridge, was carved from Mississippian Black Hand Sandstone over millions of years.",
      "sourceSentenceIds": [
        13
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Rockbridge%2C_Ohio"
    },
    {
      "id": 3,
      "text": "In 1978 the land around the arch became Rockbridge State Nature Preserve, covering 182 acres of forest and cliffs.",
      "sourceSentenceIds": [
        8,
        12
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Rockbridge%2C_Ohio"
    },
    {
      "id": 4,
      "text": "The preserve’s 2.75‑mile trail winds through hemlock hollows and along cliff edges to reveal the massive arch.",
      "sourceSentenceIds": [
        15,
        22
      ],
      "sourceLabels": [
