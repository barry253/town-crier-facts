  "facts": [
    {
      "id": 1,
      "text": "Dalworthington Gardens’ name blends Dallas, Fort Worth, and Arlington, reflecting its position in the heart of the Metroplex.",
      "sourceSentenceIds": [
        25
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Dalworthington_Gardens%2C_Texas",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The city began in 1934 as a subsistence homestead project under the National Industrial Recovery Act during the Great Depression.",
      "sourceSentenceIds": [
        16,
        17
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 2"
      ],
      "source": "https://en.wikipedia.org/wiki/Dalworthington_Gardens%2C_Texas",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Of the five New Deal homestead projects in Texas, Dalworthington Gardens is the only one still operating today.",
      "sourceSentenceIds": [
        4,
        21
      ],
      "sourceLabels": [
        "Wikipedia",
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Dalworthington_Gardens%2C_Texas",
      "category": "landmark",
      "quality": "good",
      "qualityReason": "other"
    },
    {
      "id": 4,
      "text": "Original zoning still allows residents to farm and keep livestock on any lot over half an acre that has remained owner‑occupied since 1934.",
      "sourceSentenceIds": [
        23
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Dalworthington_Gardens%2C_Texas",
      "category": "landmark",
      "quality": "good",
      "qualityReason": "editorial_filler"
    },
    {
      "id": 6,
      "text": "Many of the original homesteads are marked with historical plaques, a testament to the work of the Dalworthington Gardens Historical Commission.",
      "sourceSentenceIds": [
