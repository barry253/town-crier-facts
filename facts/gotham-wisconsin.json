  "facts": [
    {
      "id": 1,
      "text": "Gotham was originally founded in 1847 as Richland City at the confluence of the Wisconsin and Pine Rivers.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/gotham_wisconsin"
    },
    {
      "id": 2,
      "text": "The community takes its name from Captain Myron Wheeler Gotham, a Great Lakes freighter captain who retired here.",
      "sourceSentenceIds": [
        17,
        22
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 2"
      ],
      "source": "https://en.wikipedia.org/wiki/Gotham%2C_Wisconsin"
    },
    {
      "id": 3,
      "text": "Relentless erosion from the Wisconsin River eventually forced the abandonment of the original town site around the 1890s.",
      "sourceSentenceIds": [
        15
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/gotham_wisconsin"
    },
    {
      "id": 4,
      "text": "The preserved Gotham Train Depot remains a local landmark and currently serves as a private residence.",
      "sourceSentenceIds": [
        11
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/gotham_wisconsin"
    },
    {
      "id": 5,
      "text": "One of Wisconsin's largest American elm trees once grew near Gotham, featuring a trunk circumference of over twenty feet.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/gotham_wisconsin"
    },
    {
      "id": 6,
      "text": "Gotham sits at an elevation of approximately 699 feet above sea level in the southwestern part of the state.",
      "sourceSentenceIds": [
        26,
