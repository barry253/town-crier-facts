  "facts": [
    {
      "id": 1,
      "text": "West Tawakoni incorporated on March 11, 1967, named for its position on the west side of Lake Tawakoni’s causeway.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.tshaonline.org/handbook/entries/west-tawakoni-tx",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Development in the area began in the 1960s after Lake Tawakoni was completed, sparking growth around the new waterway.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.tshaonline.org/handbook/entries/west-tawakoni-tx",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "West Tawakoni caters to lake visitors with fishing and boating establishments, making it a hub for water‑sports enthusiasts.",
      "sourceSentenceIds": [
        28
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.tshaonline.org/handbook/entries/west-tawakoni-tx",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Its twin city, East Tawakoni, lies on the opposite side of Lake Tawakoni in Rains County, creating a unique pair of lakeside communities.",
      "sourceSentenceIds": [
        18
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/West_Tawakoni%2C_Texas",
      "category": "other",
      "quality": "poor",
      "qualityReason": "vague"
    },
    {
      "id": 6,
      "text": "Lake Tawakoni’s Caddo Inlet lies to the north, while Waco Bay and Kitsee Inlet border the city to the south.",
