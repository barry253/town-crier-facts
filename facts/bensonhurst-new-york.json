      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "A church founded in the 17th century and rebuilt in 1829 still stands, echoing Bensonhurst’s early religious roots.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Web source 2"
      ],
