      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "In the 1940s, waves of southern Italian immigrants settled in Bensonhurst, making it a predominantly Italian enclave.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Bensonhurst%2C_Brooklyn",
      "category": "people",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "For the first time in history, Asian residents outnumbered white residents in Bensonhurst, reaching 46,000 versus 30,000‑39,999.",
