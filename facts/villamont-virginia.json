      "quality": "poor",
      "qualityReason": "location_description"
    },
    {
      "id": 3,
      "text": "The origin of Villamont’s name remains unclear, with no definitive records linking it to early landowners or French influences.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 2"
      ],
