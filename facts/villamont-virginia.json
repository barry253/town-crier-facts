      "quality": "poor",
      "qualityReason": "location_description"
    },
    {
      "id": 2,
      "text": "It sits along U.S. Route 460 between Blue Ridge and Montvale, 15.1 miles west‑northwest of Bedford and 13 miles northeast of Roanoke.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Wikipedia"
