      "category": "etymology",
      "quality": "poor",
      "qualityReason": "other"
    },
    {
      "id": 4,
      "text": "Villamont’s early‑20th‑century growth was driven by the Villamont Land Company, linked to the Virginia Iron, Coal & Coke Company.",
      "sourceSentenceIds": [
        2,
        7
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/villamont_virginia",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The nearest passenger rail service is in Roanoke, yet Villamont never had its own train station.",
