  "facts": [
    {
      "id": 1,
      "text": "Blue Ridge was named for the blue‑flowering grass that gives the hills a blue haze from afar.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.tshaonline.org/handbook/entries/blue-ridge-tx-collin-county",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town was founded in 1876, perched on a hilltop that early settlers called Blue Ridge.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.tshaonline.org/handbook/entries/blue-ridge-tx-collin-county",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "In 1880, the Greenville and Whitewright Northern Traction Company built a railroad from Blue Ridge to Anna, linking the town to regional trade.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.tshaonline.org/handbook/entries/blue-ridge-tx-collin-county",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The land that became Blue Ridge was originally owned by Matthiss Mowry, who received a Republic of Texas land grant for his service in the Texas Revolution.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.tshaonline.org/handbook/entries/blue-ridge-tx-collin-county",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "On January 30, 2017, a 600,000‑gallon oil spill from the Seaway Pipeline reached Blue Ridge, prompting cleanup efforts.",
