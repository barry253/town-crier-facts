  "facts": [
    {
      "id": 1,
      "text": "Congress was founded in the 1880s near Wickenburg and once attracted President McKinley to its bustling gold‑mining streets.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.gowanders.com/attraction/congress",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Gold struck at the Congress Mine in 1884, and the mine ultimately yielded more than $8 million in gold, roughly $400 million in 2007 dollars.",
      "sourceSentenceIds": [
        19,
        22
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Congress%2C_Arizona",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The Santa Fe, Prescott and Phoenix Railroad reached Congress Junction in 1893, turning the town into a regional boom hub.",
      "sourceSentenceIds": [
        20,
        13
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Congress%2C_Arizona",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "When the mine shut in the mid‑1930s, Congress was largely abandoned; today only the old mercantile and cemetery mark its former life.",
      "sourceSentenceIds": [
        25,
        3
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Congress%2C_Arizona",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Modern visitors can explore the abandoned store, assay office, and Pioneer Cemetery, which together preserve the town’s mining heritage.",
      "sourceSentenceIds": [
        6,
        3
      ],
      "sourceLabels": [
        "Web source 2",
        "Web source 1"
      ],
