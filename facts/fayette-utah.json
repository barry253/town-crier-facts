  "facts": [
    {
      "id": 1,
      "text": "Founded in 1861, Fayette was originally called Warm Creek because of a warm spring located in the foothills to the east.",
      "sourceSentenceIds": [
        1,
        21
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Fayette%2C_Utah"
    },
    {
      "id": 2,
      "text": "Fayette takes its name from Fayette, New York, which is the town where the LDS Church was founded.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Fayette%2C_Utah"
    },
    {
      "id": 3,
      "text": "Early settlers in Fayette bargained with Chief Arrapene, trading two fat oxen and some calves for ownership of the spring and meadows.",
      "sourceSentenceIds": [
        27
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://fayetteutah.gov/history"
    },
    {
      "id": 4,
      "text": "The first families arrived in Fayette on April 8, 1861, and built willow shelters to live in until their crops were planted.",
      "sourceSentenceIds": [
        17,
        22
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://fayetteutah.gov/history"
    },
    {
      "id": 5,
      "text": "A post office called Fayette served the local community for over a century, operating from 1864 until 1966.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Fayette%2C_Utah"
    },
    {
      "id": 6,
      "text": "Pioneers Mellor, Metcalf, and Bartholomew originally dug the ditch that now serves as a modern cement lined waterway in Fayette.",
      "sourceSentenceIds": [
