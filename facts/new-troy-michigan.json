  "facts": [
    {
      "id": 1,
      "text": "New Troy’s Historic Village preserves a collection of museums and structures that chronicle the town’s early days.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Troy%2C_Michigan",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The Morley Grist Mill, opened in 1860, was built by Tirrell who arrived from Massachusetts hoping to start a shoe factory.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.harborcountry-news.com/features/doubling-up-on-history-in-new-troy/article_442e7306-4573-52ec-9780-3928cd3e1dfc.html",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The Community Center’s new History Room houses a “historical classroom inside a historical classroom,” complete with vintage desks and chairs.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.harborcountry-news.com/features/doubling-up-on-history-in-new-troy/article_442e7306-4573-52ec-9780-3928cd3e1dfc.html",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "New Troy’s name reflects its founders’ roots in New York and the ancient city of Troy, a common naming pattern in Michigan.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Troy%2C_Michigan",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Local historian Terry Hanover premiered the documentary “Claim to Fame” at the Community Center, tracing how one man gave New Troy its claim to fame.",
      "sourceSentenceIds": [
        18
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.harborcountry-news.com/features/doubling-up-on-history-in-new-troy/article_442e7306-4573-52ec-9780-3928cd3e1dfc.html",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The History Room displays instruments from New Troy’s Marx‑O‑Chime Colony, alongside high‑school memorabilia and a 1968 Miss New Troy contest program.",
