  "facts": [
    {
      "id": 1,
      "text": "Lucien was founded during the 1893 land run when thousands of settlers rushed into northern Oklahoma to claim land.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://myfamilytravels.com/this-charming-oklahoma-town-is-full-of-rural-charm-and-peaceful-views/"
    },
    {
      "id": 2,
      "text": "Originally called Woolsey, the town was renamed in 1903 to honor Lucien Emerson, the area's first doctor.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/lucien_oklahoma"
    },
    {
      "id": 3,
      "text": "The arrival of the Arkansas Valley and Western Railroad in 1903 brought a depot and the town's first bank.",
      "sourceSentenceIds": [
        2,
        12
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/lucien_oklahoma"
    },
    {
      "id": 4,
      "text": "Lucien exemplifies the rural character of the Cherokee Strip region, where most residents engage in farming and ranching.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/lucien_oklahoma"
    },
    {
      "id": 5,
      "text": "Grain elevators punctuate the horizon of Lucien, serving as prominent landmarks across the wide-open landscape.",
      "sourceSentenceIds": [
        8,
        25
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://myfamilytravels.com/this-charming-oklahoma-town-is-full-of-rural-charm-and-peaceful-views/"
    },
    {
      "id": 6,
      "text": "Lucien experiences a humid subtropical climate with hot summers and mild winters influenced by moisture from the Gulf of Mexico.",
      "sourceSentenceIds": [
        15
