  "facts": [
    {
      "id": 1,
      "text": "Ben Avon's name means “hill by the waters” in Scottish, echoing its riverside hilltop setting.",
      "sourceSentenceIds": [
        22
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Ben_Avon%2C_Pennsylvania",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The borough was incorporated in 1891 from Kilbuck Township, becoming a summer retreat for Pittsburgh merchants.",
      "sourceSentenceIds": [
        23,
        24
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Ben_Avon%2C_Pennsylvania",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Early 20th‑century trains linked Ben Avon to Pittsburgh, and the Arthurs‑Johnson House sits beside the historic Pittsburgh and Fort Wayne line.",
      "sourceSentenceIds": [
        4,
        5
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Ben_Avon%2C_Pennsylvania",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Founded in 1976, the Ben Avon Area Historical Association preserves local history through lectures, walking tours, and an annual Home & Garden Tour.",
      "sourceSentenceIds": [
        9,
        10,
        11,
        12
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://museumsdatabase.com/museums/view/27510",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Ohio River Boulevard now hosts gas stations, thrift shops, and ice‑cream shops, yet the old railroad tracks still echo the town’s past.",
