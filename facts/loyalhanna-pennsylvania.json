  "facts": [
    {
      "id": 1,
      "text": "Loyalhanna’s name comes from a Shawnee and Delaware village called Kickenapauling's Town founded around 1727, abandoned by 1748.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/loyalhanna_pennsylvania",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "During the French and Indian War, British forces camped at Loyalhanna in 1758 as a base for advancing on Fort Duquesne.",
      "sourceSentenceIds": [
        15
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/loyalhanna_pennsylvania",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The Army Corps of Engineers created Loyalhanna Lake, a flood‑control reservoir that now hosts boating, camping, and wildlife viewing while cleaning up historic mine‑drainage pollution.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/loyalhanna_pennsylvania",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The community sits within the Loyalhanna Creek watershed, with Saxman Run feeding the creek at Latrobe; no lakes lie inside the CDP.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/loyalhanna_pennsylvania",
      "category": "nature",
      "quality": "poor",
      "qualityReason": "vague"
    },
    {
      "id": 5,
      "text": "Elevations in Loyalhanna range from 975 feet at the creek confluence to over 2,000 feet along surrounding ridges.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/loyalhanna_pennsylvania",
      "category": "other",
      "quality": "poor",
      "qualityReason": "vague"
    },
    {
      "id": 6,
      "text": "Coal mining shaped the area; Mine #1 on Saxman Run was one of Westmoreland County’s largest producers by 1880.",
      "sourceSentenceIds": [
        7
