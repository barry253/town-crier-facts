  "facts": [
    {
      "id": 1,
      "text": "Founded in 1867 by the Union Pacific, Sidney was named after railroad attorney Sidney Dillon, who helped steer the transcontinental line.",
      "sourceSentenceIds": [
        1,
        3
      ],
      "sourceLabels": [
        "Web source 2",
        "Wikipedia"
      ],
      "source": "https://cityofsidney.org/202/History-of-Sidney",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town grew around Fort Sidney, a military outpost whose primary job was protecting Union Pacific track layers from hostile Native American attacks.",
      "sourceSentenceIds": [
        2,
        12
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 2"
      ],
      "source": "https://en.wikipedia.org/wiki/Sidney%2C_Nebraska",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Once dubbed “the toughest town on the tracks,” Sidney attracted Western legends like Wild Bill Hickok, Calamity Jane, and Buffalo Bill Cody.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.visitsidneyne.com/",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "In 1949, the first successful oil well north of Sidney was drilled, adding oil to the local economy and reshaping the region.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://cityofsidney.org/202/History-of-Sidney",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The former headquarters of Cabela’s sat in Sidney until 2017, when the company was acquired by Bass Pro Shops and the building was repurposed.",
      "sourceSentenceIds": [
        20
