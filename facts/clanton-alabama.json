  "facts": [
    {
      "id": 1,
      "text": "Clanton took its name from the South and North Alabama Railroad station that opened there in 1871.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Clanton%2C_Alabama",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The city’s most recognizable landmark is a peach-shaped water tower built in 1993, a nod to its agricultural roots.",
      "sourceSentenceIds": [
        13,
        14
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Clanton%2C_Alabama",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Alfred Baker founded Clanton in 1868, and he later helped create Baker County, which was renamed Chilton County in 1874.",
      "sourceSentenceIds": [
        9,
        11
      ],
      "sourceLabels": [
        "Web source 1",
        "Web source 2"
      ],
      "source": "https://www.clantonal.gov/157/About-Clanton",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Before becoming Clanton, the area was known as Goose Pond, the original county seat of the newly formed Chilton County.",
      "sourceSentenceIds": [
        7,
        8
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Clanton%2C_Alabama",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Clanton sits near the geographic center of the United States, a fact that locals proudly point out to travelers.",
      "sourceSentenceIds": [
        24
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Clanton%2C_Alabama",
      "category": "other",
      "quality": "poor",
      "qualityReason": "location_description"
    },
    {
      "id": 6,
      "text": "Clanton serves as the county seat of Chilton County, a role it has held since the county’s early days.",
