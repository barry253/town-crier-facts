      "id": 1,
      "text": "Sint‑Niklaas received city rights in 1241 from Margaret II, making it one of the oldest cities in the region.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
