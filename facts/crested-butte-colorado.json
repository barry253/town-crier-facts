  "facts": [
    {
      "id": 1,
      "text": "Crested Butte began as a coal mining town in the late 1800s, founded in Gunnison County, Colorado.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.wayfy.co/destinations/crested-butte/history-and-culture"
    },
    {
      "id": 2,
      "text": "The 1960s saw Crested Butte transition from mining to tourism with the opening of its ski resort.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.wayfy.co/destinations/crested-butte/history-and-culture"
    },
    {
      "id": 3,
      "text": "Downtown Crested Butte preserves more than 80 Victorian-era buildings, making it one of Colorado's most intact historic mining towns.",
      "sourceSentenceIds": [
        21
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.wayfy.co/destinations/crested-butte/history-and-culture"
    },
    {
      "id": 4,
      "text": "Crested Butte is dubbed the Wildflower Capital of Colorado, where summer meadows burst with lupines, Indian paintbrush, columbines, and sunflowers.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.wayfy.co/destinations/crested-butte/history-and-culture"
    },
    {
      "id": 5,
      "text": "Music thrives in Crested Butte, with local and visiting artists performing in historic buildings and outdoor venues across town.",
      "sourceSentenceIds": [
        5,
        19
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.wayfy.co/destinations/crested-butte/history-and-culture"
    },
    {
      "id": 6,
      "text": "Captain John Gunnison, after whom Gunnison County is named, led an 1853 expedition that first mapped the area now known as Crested Butte.",
