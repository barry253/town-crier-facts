      "category": "culture",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Lake Tawakoni covers 37,879 acres and sits about 48 miles east of Dallas, offering a sizable waterway for the area.",
      "sourceSentenceIds": [
        18
      ],
      "sourceLabels": [
        "Wikipedia"
