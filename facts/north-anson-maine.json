  "facts": [
    {
      "id": 1,
      "text": "North Anson was named after British Admiral George Anson when Anson town incorporated in 1798, and it briefly split off in 1845 before rejoining in 1855.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/north_anson_maine",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Before Europeans arrived, North Anson lay within Abenaki territory, where the Norridgewock band lived along the Kennebec and Carrabassett rivers.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/north_anson_maine",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "North Anson sits at the confluence of the Kennebec and Carrabassett rivers, a spot that shaped its early transport and hydrology.",
      "sourceSentenceIds": [
        7,
        11
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/north_anson_maine",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "North Anson’s economy once hinged on farming hay, potatoes, oats, and apples, plus sawmills, woolen factories, and tanneries from the 1800s to 1900s.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/north_anson_maine",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Pan Am Railways reopened a spur to North Anson in 2007, but service ended in 2013, and the line is now a planned rail trail.",
      "sourceSentenceIds": [
        25,
