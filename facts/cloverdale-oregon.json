    },
    {
      "id": 2,
      "text": "Charles Ray founded Cloverdale at the turn of the century after settling in the area around 1884.",
      "sourceSentenceIds": [
        1,
        2
      ],
      "sourceLabels": [
        "Web source 2",
        "Wikipedia"
      ],
      "source": "https://tillamookhistory.org/2024/02/17/cloverdale-then-and-now/"
    },
    {
      "id": 3,
      "text": "Cloverdale was named for the wild clover that grew thick in the Nestucca Valley before the land was settled.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://cloverdaleoregon.com/"
    },
    {
      "id": 4,
      "text": "Early development in Cloverdale included the establishment of a store, hotel, bank, and cheese factory.",
      "sourceSentenceIds": [
        7,
        8
      ],
      "sourceLabels": [
