  "facts": [
    {
      "id": 1,
      "text": "Sheridan was once the second largest town in Hamilton County, originally on land owned by abolitionist George Boxley.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Sheridan%2C_Indiana",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town was renamed Sheridan in 1867 after Civil War General Philip Sheridan because another town had the same name.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.sheridanhistoricalsociety.net/history-of-the-town.html",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "A 1913 fire started in a lumber company and gutted much of downtown’s wooden buildings.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Sheridan%2C_Indiana",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Sheridan’s downtown commercial historic district covers about four blocks along Main Street and includes the George Boxley cabin, a National Register site.",
      "sourceSentenceIds": [
        12,
        27
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 2"
      ],
      "source": "https://en.wikipedia.org/wiki/Sheridan%2C_Indiana",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The Monon Railroad arrived in 1882, sparking a boom that clustered mills and factories along Main Street’s south end.",
      "sourceSentenceIds": [
        13,
        28
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 2"
      ],
      "source": "https://en.wikipedia.org/wiki/Sheridan%2C_Indiana",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Sheridan once housed a glass factory, a cannery, and the Thistlethwaite Tile and Brick Plant, showcasing diverse 19th‑century industry.",
