  "facts": [
    {
      "id": 1,
      "text": "Scottsboro was originally named Scottsville, briefly became Scott's Mill, then settled on Scottsboro in 1858.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Scottsboro%2C_Alabama",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town’s founder, Robert T. Scott, built a grist mill, shingle factory, and lobbied the Memphis and Charleston Railroad to run through his property, sparking the town’s growth.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://encyclopediaofalabama.org/article/scottsboro/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Scottsboro is the site of the Scottsboro Boys Museum and Cultural Center, which chronicles the landmark civil‑rights trials that put the town on the national stage.",
      "sourceSentenceIds": [
        14
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://encyclopediaofalabama.org/article/scottsboro/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The city’s Jackson County Court House was the venue for the 2004 dedication of a historical marker honoring the Scottsboro Boys’ struggle for justice.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Scottsboro%2C_Alabama",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Scottsboro’s economy shifted from agriculture and lumber to TVA‑influenced development after 1933, reshaping the region’s industrial path.",
      "sourceSentenceIds": [
        30
