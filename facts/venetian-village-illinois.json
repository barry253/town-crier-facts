      ],
      "source": "https://www.trawellino.com/destinations/united-states/illinois_venetian-village"
    },
    {
      "id": 2,
      "text": "Four private lakes—Sand, Slough, Miltmore, and Fourth—border the community, giving it a lakeside feel.",
      "sourceSentenceIds": [
        7,
        9
      ],
      "sourceLabels": [
        "Web source 1"
