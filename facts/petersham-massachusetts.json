      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town’s common, part of the Petersham Common Historic District, anchors a green space surrounded by historic buildings and a white church steeple.",
      "sourceSentenceIds": [
        19,
        5
      ],
      "sourceLabels": [
        "Wikipedia",
