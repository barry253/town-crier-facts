  "facts": [
    {
      "id": 1,
      "text": "Elm Hall was first settled in 1855 by the Strayer brothers, whose log hall made of elm trees gave the community its name.",
      "sourceSentenceIds": [
        6,
        10,
        12
      ],
      "sourceLabels": [
        "Web source 1",
        "Wikipedia"
      ],
      "source": "https://grokipedia.com/page/elm_hall_michigan",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "A post office opened on August 18, 1857, with Baron Blanchard as first postmaster, and the building is now considered Michigan's smallest active post office.",
      "sourceSentenceIds": [
        13,
        20
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Elm_Hall%2C_Michigan",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "In the late 19th century, Elm Hall grew into a modest hub with sawmills, a pump factory, general stores, a hotel, a Masonic hall, and three churches.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/elm_hall_michigan",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The Old Elm Hall Church, a historic wooden structure, remains as a reminder of the area's early religious and architectural heritage.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/elm_hall_michigan",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Elm Hall was formally platted in 1863 and later expanded in 1876, doubling its size to 12 blocks.",
      "sourceSentenceIds": [
        14,
        28
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Elm_Hall%2C_Michigan",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The Pine River flows through Elm Hall, giving the community a natural waterway that once supported early logging activities.",
      "sourceSentenceIds": [
        17
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
