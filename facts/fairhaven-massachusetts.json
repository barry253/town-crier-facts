  "facts": [
    {
      "id": 1,
      "text": "Settled in 1659 and incorporated in 1812, Fairhaven grew around a bustling whaling harbor that still echoes its maritime past.",
      "sourceSentenceIds": [
        18
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.discoverfairhaven.org/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "In 1841, author Herman Melville departed from Fairhaven’s port aboard the whaleship Acushnet, a launch point for his famous voyage.",
      "sourceSentenceIds": [
        24,
        25
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Fairhaven%2C_Massachusetts",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Joshua Slocum, the first man to sail alone around the world, lived in Fairhaven and his ship Spray once rested in the town’s Poverty Point.",
      "sourceSentenceIds": [
        1,
        8
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Fairhaven%2C_Massachusetts",
      "category": "people",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The Fairhaven Historical Society, founded in 1992, runs a museum that showcases an authentic early‑19th‑century classroom and other town artifacts.",
      "sourceSentenceIds": [
        4,
        29
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.historicalsocietyfairhaven.org/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Fairhaven High School, donated by Rogers in 1906, stands as a prominent landmark on Route 6 and has long been a community focal point.",
      "sourceSentenceIds": [
        14
