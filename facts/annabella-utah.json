  "facts": [
    {
      "id": 1,
      "text": "Annabella began in 1871 as Omni Point and was renamed after two early women, Ann S. Roberts and Isabella Dalton.",
      "sourceSentenceIds": [
        15,
        19,
        20
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Annabella%2C_Utah",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Nestled beneath Cove Mountain, Annabella grew into a Mormon village founded by families such as the Daltons and Gleave.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.seviercountyhistoryhub.org/town-history/anabella-utah",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Two creeks, Cottonwood Creek and Annabella Springs, once flowed through the original settlement.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Annabella%2C_Utah",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The first families were Henry Dalton, a Mormon Battalion veteran, and Joseph Powell, whose records later disappeared.",
      "sourceSentenceIds": [
        15,
        16
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Annabella%2C_Utah",
      "category": "people",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Meacham Springs at Omni Point later supplied water to the nearby town of Inverury, now Central Valley.",
      "sourceSentenceIds": [
        5
      ],
