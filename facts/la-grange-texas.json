  "facts": [
    {
      "id": 1,
      "text": "La Grange takes its name from the Château de la Grange-Bléneau, the French chateau that inspired Marquis de Lafayette’s estate.",
      "sourceSentenceIds": [
        8,
        11
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 2"
      ],
      "source": "https://en.wikipedia.org/wiki/La_Grange%2C_Texas"
    },
    {
      "id": 2,
      "text": "Founded in the 1860s by German immigrant Heinrich Kreische, the town once hosted one of Texas’s first commercial breweries.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.lagrangetx.org/visit-lagrange/"
    },
    {
      "id": 3,
      "text": "The Monument Hill and Kreische Brewery State Historic Sites opened to the public in 1983 after extensive archaeological studies.",
      "sourceSentenceIds": [
        17
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/La_Grange%2C_Texas"
    },
    {
      "id": 4,
      "text": "Czech and German heritage remains visible in La Grange’s architecture, customs, and its reputation for rejecting prohibition in the 1920s.",
      "sourceSentenceIds": [
        5,
        12
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/La_Grange%2C_Texas"
    },
    {
      "id": 5,
      "text": "La Grange’s historic courthouse, brewery ruins, and a celebrated quilt museum showcase the town’s rich cultural tapestry.",
      "sourceSentenceIds": [
        19,
        24
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.lagrangetx.org/visit-lagrange/"
    },
    {
      "id": 6,
      "text": "By 1884, La Grange boasted four churches, three schools, an opera house, an oil factory, and a bank.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 2"
      ],
