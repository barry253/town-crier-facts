  "facts": [
    {
      "id": 1,
      "text": "Annapolis Royal was originally called Port Royal, named by Champlain in 1604, marking one of North America’s earliest European settlements.",
      "sourceSentenceIds": [
        1,
        2
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Annapolis_Royal",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Fort Anne, built in 1629 and later known as Charles Fort, is Canada’s oldest extant fort and a National Historic Site.",
      "sourceSentenceIds": [
        22
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Annapolis_Royal",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The 1605 Habitation at Port‑Royal National Historic Site was the first National Historic Site to have a replica structure built.",
      "sourceSentenceIds": [
        20,
        21
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Annapolis_Royal",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The De Gannes‑Cosby House, dating from 1708, is the oldest wood‑framed building in Canada and the world’s oldest Acadian‑style house.",
      "sourceSentenceIds": [
        25
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Annapolis_Royal",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "In 1869 the arrival of the Windsor and Annapolis Railway sparked a brief boom, adding two large piers and factories to the waterfront.",
