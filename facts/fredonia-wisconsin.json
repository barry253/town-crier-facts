  "facts": [
    {
      "id": 1,
      "text": "Fredonia was carved out of the Town of Port Washington in 1847 and named after Fredonia, New York.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Fredonia%2C_Wisconsin",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The land that became Fredonia was once a Potawatomi village, with the tribe surrendering it in the 1833 Treaty of Chicago.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Fredonia%2C_Wisconsin",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "German and Luxembourger immigrants flooded the area in the 1840s, turning the fertile Ozaukee soils into thriving farms.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/fredonia_town_wisconsin",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The arrival of the Milwaukee and Northern Railway in 1873 built Fredonia Station, shifting growth from Waubeka to the depot and sparking the village’s commercial boom.",
      "sourceSentenceIds": [
        17,
        18
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/fredonia_town_wisconsin",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Waubeka, once the original center of Fredonia, now hosts the National Flag Day Foundation headquarters, linking the area to a national holiday.",
