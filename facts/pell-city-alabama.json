  "facts": [
    {
      "id": 1,
      "text": "Pell City was founded in 1890 by railroad investors and named after George Pell, a financier of the Pell City Iron and Land Company.",
      "sourceSentenceIds": [
        1,
        2
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 2"
      ],
      "source": "https://en.wikipedia.org/wiki/Pell_City%2C_Alabama",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town became the second county seat of Clair County in 1907, a unique dual‑seat arrangement that still exists today.",
      "sourceSentenceIds": [
        27
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Pell_City%2C_Alabama",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Avondale Mills, once the town’s economic heart, operated from 1902 until its demolition in 2008, leaving a historic district that still marks the skyline.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Pell_City%2C_Alabama",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Logan Martin Dam, completed in 1964, created a lake that spurred tourism and new homes along its shores, reshaping Pell City’s growth.",
      "sourceSentenceIds": [
        30
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Pell_City%2C_Alabama",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The town’s iconic water tower still stands, while the original mill smokestack was removed after structural cracks made it hazardous.",
      "sourceSentenceIds": [
        21
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Pell_City%2C_Alabama",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Pell City hosts a dedicated FM station, WFHK, reflecting its local media presence.",
