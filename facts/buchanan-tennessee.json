      "id": 1,
      "text": "Buchanan was founded in the 1840s, long before it became the quiet community it is today.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Buchanan%2C_Tennessee",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town’s name honors Governor John Price Buchanan, whose estate once covered the land where the community now sits.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://rutherfordtnhistory.org/PeoplePlacesStories/historical-categories/communities/buchanan/",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Buchanan remains an unincorporated community in Henry County, Tennessee, with no formal municipal government.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Buchanan%2C_Tennessee",
      "category": "other",
      "quality": "poor",
      "qualityReason": "vague"
    },
    {
      "id": 4,
      "text": "A volunteer fire station, two churches, a Masonic hall, a feed mill, and a post office have served Buchanan’s residents for decades.",
      "sourceSentenceIds": [
        11
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Buchanan%2C_Tennessee",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The Rutherford County Historical Society, founded in 1971, preserves Buchanan’s local history through volunteer efforts and community events.",
      "sourceSentenceIds": [
