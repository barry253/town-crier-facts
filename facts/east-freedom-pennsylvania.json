  "facts": [
    {
      "id": 1,
      "text": "East Freedom grew from a 19th‑century farming settlement into a modest commercial hub after iron workers and Irish immigrants settled in the 1840s.",
      "sourceSentenceIds": [
        3,
        23
      ],
      "sourceLabels": [
        "Web source 2",
        "Web source 1"
      ],
      "source": "https://www.scientificmagz.blog/east-freedom-pa-living-guide",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The village’s first post office opened in 1829 as Three Forges, renamed Freedom in 1841, and later East Freedom to avoid confusion within the new Freedom Township.",
      "sourceSentenceIds": [
        15
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/east_freedom_pennsylvania",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Paul’s Lutheran Church, founded in 1882, and the East Freedom United Methodist Church, dating back to 1843, are among the oldest religious institutions in the community.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/east_freedom_pennsylvania",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The decline of the local iron industry after the 1890 closure of Martha Furnace shifted East Freedom toward a residential and small‑business character.",
      "sourceSentenceIds": [
        17
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/east_freedom_pennsylvania",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "East Freedom’s name honors the anti‑slavery spirit of Freedom Township, which was named during the era of the Underground Railroad.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Web source 1"
      ],
