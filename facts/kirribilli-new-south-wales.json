  "facts": [
    {
      "id": 1,
      "text": "Kirribilli House, one of two official residences of the Australian Prime Minister, dates back to 1842 and sits on a 5‑acre site.",
      "sourceSentenceIds": [
        3,
        16
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Kirribilli",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The suburb’s name comes from an Aboriginal word meaning “good fishing spot,” reflecting its early coastal lifestyle.",
      "sourceSentenceIds": [
        17
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Kirribilli",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Admiralty House began as Colonel Gibbes’ private dwelling, later becoming the government’s Admiralty House, and now houses the Prime Minister’s office.",
      "sourceSentenceIds": [
        3,
        22
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Kirribilli",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The Sydney Harbour Bridge, completed in 1932, linked Kirribilli directly to Sydney’s CBD, sparking a boom in residential development.",
      "sourceSentenceIds": [
        28
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Kirribilli",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "From 1890 to 1921, a wool warehouse and meat cold store operated on the foreshore beside Admiralty House, a rare industrial site in a residential suburb.",
      "sourceSentenceIds": [
        24
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Kirribilli",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Milsons Point railway station, the nearest stop, opened in the early 20th century and still serves commuters across the harbor.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
