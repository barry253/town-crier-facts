  "facts": [
    {
      "id": 1,
      "text": "Founded on June 23 1792, Versailles sprang from land owned by child Hezekiah Briscoe and was laid out by General Marquis Calmes.",
      "sourceSentenceIds": [
        2,
        3,
        7
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Versailles%2C_Kentucky",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town takes its name from France’s Versailles, honoring General Lafayette, a family friend of the founders.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Versailles%2C_Kentucky",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Woodford Reserve Distillery, a Bourbon Trail stop, operates in the historic Old Oscar Pepper building, a National Historic Landmark.",
      "sourceSentenceIds": [
        4,
        10
      ],
      "sourceLabels": [
        "Wikipedia",
