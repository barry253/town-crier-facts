      ],
      "source": "https://en.wikipedia.org/wiki/Versailles%2C_Kentucky",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "US‑62, one of America’s Scenic Byways, runs between Midway and Versailles, making the town a scenic route stop.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 2"
      ],
