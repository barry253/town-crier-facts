  "facts": [
    {
      "id": 1,
      "text": "Cicero was named after Roman orator Marcus Tullius Cicero, chosen by a clerk who loved classics.",
      "sourceSentenceIds": [
        1,
        12
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Cicero%2C_New_York"
    },
    {
      "id": 2,
      "text": "The town originated in 1790 as a township in the Central New York Military Tract, reserved for Revolutionary soldiers.",
      "sourceSentenceIds": [
        14,
        15
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Cicero%2C_New_York"
    },
    {
      "id": 3,
      "text": "In 1827 the western half split off to become the Town of Clay, leaving Cicero with its current borders.",
      "sourceSentenceIds": [
        17
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Cicero%2C_New_York"
    },
    {
      "id": 4,
      "text": "The historic Stone Arabia Schoolhouse, built in 1854, now serves as a museum and is on the National Register of Historic Places.",
      "sourceSentenceIds": [
        6,
        9
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Cicero%2C_New_York"
    },
    {
      "id": 5,
      "text": "Cicero’s landscape is dominated by wetlands and forests, with Oneida Lake forming its northern edge along the Oneida River.",
      "sourceSentenceIds": [
        20,
        21
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Cicero%2C_New_York"
    },
    {
      "id": 6,
      "text": "A former cheese factory, flour mill, and wagon factory once stood in the village, reflecting the town’s 19th‑century industrial past.",
