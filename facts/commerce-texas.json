  "facts": [
    {
      "id": 1,
      "text": "Commerce sprang to life in 1872 when merchants William Jernigan and Josiah Jackson opened a trading post that became the town’s downtown.",
      "sourceSentenceIds": [
        4,
        5
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Commerce%2C_Texas",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town earned its name, Commerce, from the bustling cotton trade that flourished between the Middle and South Sulphur rivers.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Commerce%2C_Texas",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "East Texas A&M University relocated to Commerce after its original campus burned down in 1894, cementing the city’s academic roots.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Commerce%2C_Texas",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Commerce earned the title Bois d'Arc Capital of Texas because it sits in the geographic heart of the tree’s historic range.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Commerce%2C_Texas",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Within Commerce’s limits stands “Big Max,” the second‑largest bois d'arc tree in Texas, a living monument to the region’s natural heritage.",
      "sourceSentenceIds": [
        16
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Commerce%2C_Texas",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "A railroad reached Commerce in 1874, linking it to Fort Worth and sparking a boom that shaped the town’s early growth.",
