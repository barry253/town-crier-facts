  "facts": [
    {
      "id": 1,
      "text": "Founded in the late 1790s at the direction of Zachariah Cox, with the site scouted by John Smith, the town was named after him.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
