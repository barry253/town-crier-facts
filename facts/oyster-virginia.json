  "facts": [
    {
      "id": 1,
      "text": "Oyster sits on Virginia’s Eastern Shore, just 3 feet above sea level, where tides bring the famed Atlantic oyster to shore.",
      "sourceSentenceIds": [
        4,
        6
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Oyster%2C_Virginia"
    },
    {
      "id": 2,
      "text": "Long before English settlers, Native Americans harvested oysters here, making them a staple of early Virginia diets.",
      "sourceSentenceIds": [
        1,
        10
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://virginiahistory.org/learn/oysters-virginia"
    },
    {
      "id": 3,
      "text": "In colonial times, oysters were cheaper than beef and filled menus in homes and taverns across the Old Dominion.",
      "sourceSentenceIds": [
        2,
        16
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://virginiahistory.org/learn/oysters-virginia"
    },
    {
      "id": 4,
      "text": "The oyster’s scientific name, Crassostrea virginica, honors Virginia, where the species was first described.",
      "sourceSentenceIds": [
        23
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://virginiahistory.org/learn/oysters-virginia"
    },
    {
      "id": 5,
      "text": "Each oyster can filter up to 50 gallons of water, a fact that helped Virginia restore its once‑depleted oyster reefs.",
      "sourceSentenceIds": [
        24,
        20
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://virginiahistory.org/learn/oysters-virginia"
    },
    {
      "id": 6,
      "text": "Today, Virginia leads the East Coast in oyster aquaculture, supplying sustainable seafood and green jobs to the region.",
