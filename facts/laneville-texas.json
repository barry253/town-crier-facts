  "facts": [
    {
      "id": 1,
      "text": "Laneville got its name from the intersection of four lanes that formed the town in the 1880s.",
      "sourceSentenceIds": [
        18
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Laneville%2C_Texas",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town’s first post office opened in 1888 with Philetus Williamson as postmaster, and it remains one of only 14 operating in Rusk County since 1950.",
      "sourceSentenceIds": [
        20,
        21
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Laneville%2C_Texas",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Laneville sits at the crossroads of Farm Roads 225 and 1798, just 12 miles south of Henderson and 12 miles northwest of Mount Enterprise.",
      "sourceSentenceIds": [
        24
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Laneville%2C_Texas",
      "category": "other",
      "quality": "poor",
      "qualityReason": "route_only"
    },
    {
      "id": 4,
      "text": "In its early boom, Laneville hosted a cotton gin, three churches, and several stores, reaching 20 businesses by 2000.",
      "sourceSentenceIds": [
        22,
        23
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Laneville%2C_Texas",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The community grew around the Angelina River, which lies nearby and helped shape the local economy.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.tshaonline.org/handbook/entries/laneville-tx",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Former NFL player Mark Moseley was born in Laneville, adding a touch of sports fame to the small town.",
