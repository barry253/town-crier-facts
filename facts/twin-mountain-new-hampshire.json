  "facts": [
    {
      "id": 1,
      "text": "Twin Mountain was granted by King George III in 1772, marking its earliest colonial founding.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.twinmountain.com/historical.html"
    },
    {
      "id": 2,
      "text": "The village sits between North Twin Mountain (4,761 ft) and South Twin Mountain (4,902 ft), the peaks that give the town its name.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Twin_Mountain%2C_New_Hampshire"
    },
    {
      "id": 3,
      "text": "In 1861, six privately owned sawmills operated in Twin Mountain, making timber a cornerstone of its early economy.",
      "sourceSentenceIds": [
        11
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.twinmountain.com/historical.html"
    },
    {
      "id": 4,
      "text": "The Crawford family turned a log cabin into an inn, later building the Notch House in 1828, establishing Twin Mountain as a holiday spot.",
      "sourceSentenceIds": [
        12,
        14
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.twinmountain.com/historical.html"
    },
    {
      "id": 5,
      "text": "Passenger trains in the early 1900s spurred the construction of grand hotels like the Twin Mountain House and the Crawford House, reshaping the town’s hospitality scene.",
      "sourceSentenceIds": [
        15
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.twinmountain.com/historical.html"
    },
    {
      "id": 6,
      "text": "The Appalachian Trail crosses US 302 just east of Twin Mountain, offering hikers a scenic break near the village.",
      "sourceSentenceIds": [
