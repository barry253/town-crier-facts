  "facts": [
    {
      "id": 1,
      "text": "Leetonia was founded in 1869 as a company town for the Leetonia Iron and Coal Company.",
      "sourceSentenceIds": [
        4,
        7
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Leetonia%2C_Ohio"
    },
    {
      "id": 2,
      "text": "The town’s name honors railroad promoter William Lee, who bought the land and mineral rights in the 1860s.",
      "sourceSentenceIds": [
        3,
        5,
        17
      ],
      "sourceLabels": [
        "Web source 1",
        "Wikipedia"
      ],
      "source": "https://www.leetonia.org/history"
    },
    {
      "id": 3,
      "text": "Leetonia hosts one of America’s few remaining Beehive coke ovens, a relic of its coal‑smelting past.",
      "sourceSentenceIds": [
        16,
        26,
        27
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Leetonia%2C_Ohio"
    },
    {
      "id": 4,
      "text": "In 1873 the original company was sold and renamed Cherry Valley Iron and Coal, expanding to over 200 coke ovens and four blast furnaces.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Leetonia%2C_Ohio"
    },
    {
      "id": 5,
      "text": "A historic marker was placed at the former company site in 1993, and plans are underway to turn it into a park and education center.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Web source 1"
      ],
