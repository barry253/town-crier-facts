  "facts": [
    {
      "id": 1,
      "text": "Woolrich was originally called Factoryville, then Richville, and was renamed Woolrich in 1888, still home to the original woolen mill and company headquarters.",
      "sourceSentenceIds": [
        1,
        2
      ],
      "sourceLabels": [
        "Web source 2",
        "Wikipedia"
      ],
      "source": "https://pabook.libraries.psu.edu/literary-cultural-heritage-map-pa/feature-articles/rich-tradition",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The Woolrich Museum in Woolrich celebrates the Rich family and their pioneering outdoor clothing, offering insight into the brand’s role in Pennsylvania’s industrial history.",
      "sourceSentenceIds": [
        12,
        13
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://lumberheritage.org/things-to-do/woolrich-museum-of-rich-family/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "John Rich founded the company in 1830, first selling wool to lumberjacks, and later moved operations to Chatham's Run for better water supply.",
      "sourceSentenceIds": [
        3,
        24
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Woolrich%2C_Pennsylvania",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The famous Buffalo Check pattern, popular with lumberjacks and railroad workers, was first produced in Woolrich’s catalog as the “Woolrich Big Game Hunter’s Suit.”.",
      "sourceSentenceIds": [
        17,
        18
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://pabook.libraries.psu.edu/literary-cultural-heritage-map-pa/feature-articles/rich-tradition",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Woolrich’s main operations sit on a 300‑acre site that once housed a sawmill; the original 1845 mill no longer exists but its location remains the community’s heart.",
      "sourceSentenceIds": [
        25,
        26
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
