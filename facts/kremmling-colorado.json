  "facts": [
    {
      "id": 1,
      "text": "Kremmling began as a lone general store run by Rudolph “Kare” Kremmling on the north side of Muddy Creek.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Kremmling%2C_Colorado",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "When the Moffat railroad arrived in July 1906, Kremmling became Grand County’s central shipping hub.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Kremmling%2C_Colorado",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Founded in 1881 amid the Colorado Silver Boom, Kremmling grew slowly because nearby mountains offered few minerals.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Kremmling%2C_Colorado",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The first post office, named Kinsey City, operated 1881‑1885 with Kare Kremmling as its inaugural postmaster.",
      "sourceSentenceIds": [
        11
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Kremmling%2C_Colorado",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "In 1906 Kasper Schuler erected Kremmling’s first brick building, later converted into the Hotel Eastin in 1933.",
      "sourceSentenceIds": [
        15,
        17
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Kremmling%2C_Colorado",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Kremmling lies along the upper Colorado River, nestled between Byers Canyon and Gore Canyon in Middle Park.",
      "sourceSentenceIds": [
        8
