  "facts": [
    {
      "id": 1,
      "text": "Nakaibito’s name comes from the Navajo term Naakaii Bitoʼ, meaning “Mexican Spring” or “Spaniard’s water,” reflecting early Hispanic interactions.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/nakaibito_new_mexico",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Archaeologists find evidence of Ancestral Puebloan occupation in the Nakaibito area, linking it to the great Chaco Canyon hub of the 9th‑12th centuries.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/nakaibito_new_mexico",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The community sits on the Figueredo Wash drainage, which channels seasonal runoff east into Coyote Wash, part of the Chaco River watershed.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/nakaibito_new_mexico",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "At an elevation of about 6,500 feet, Nakaibito experiences a cold semi‑arid climate with hot summers and chilly winters.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/nakaibito_new_mexico",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Nakaibito lies within the Navajo Nation and is governed by the Mexican Springs Chapter, which was formally recognized in 1955.",
      "sourceSentenceIds": [
        20,
        24
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/nakaibito_new_mexico",
      "category": "people",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Residents celebrate their heritage through storytelling traditions that trace back to the community’s origins and the early Mexican settlers.",
      "sourceSentenceIds": [
        21
