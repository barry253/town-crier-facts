      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/West_Point%2C_Kentucky"
    },
    {
      "id": 2,
      "text": "West Point sits at the confluence of the Ohio and Salt rivers, a strategic position that served as an early crossroads.",
      "sourceSentenceIds": [
        3,
        6
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
