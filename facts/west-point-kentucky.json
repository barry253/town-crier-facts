    },
    {
      "id": 3,
      "text": "Fort Duffield in West Point is the largest and best-preserved earthen fortification from the Civil War period in Kentucky.",
      "sourceSentenceIds": [
        18
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/West_Point%2C_Kentucky"
    },
    {
      "id": 4,
      "text": "General William Tecumseh Sherman ordered the construction of Fort Duffield to protect supply bases and the city of Louisville.",
      "sourceSentenceIds": [
        9
