  "facts": [
    {
      "id": 1,
      "text": "McConnellsville takes its name from Joseph McConnell, an early settler who arrived in 1814 and later served as the town’s first postmaster.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/mcconnellsville_new_york",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "By the late 1800s, the hamlet boasted a chair factory employing about forty workers, canning operations, a wintergreen distillery, and a Methodist Episcopal church rebuilt in 1881.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/mcconnellsville_new_york",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "McConnellsville lies along New York State Route 13, roughly five miles southeast of Camden, close to Fish Creek and the northern shore of Oneida Lake.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/McConnellsville%2C_New_York",
      "category": "other",
      "quality": "poor",
      "qualityReason": "location_description"
    },
    {
      "id": 4,
      "text": "The Erie Canal’s side cut linked Fish Creek directly to the main canal at Higginsville, turning McConnellsville into a vital transportation hub in the early 19th century.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/mcconnellsville_new_york",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Early 1800s saw the construction of a sawmill in 1801, a gristmill around 1804, and Isaac Cook’s double‑log tavern, laying the economic foundation for the hamlet.",
      "sourceSentenceIds": [
        14
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/mcconnellsville_new_york",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Fine sandy loam soils, such as the Honeoye series, dominate the area, providing deep, well‑drained ground that has made McConnellsville a productive farming community.",
      "sourceSentenceIds": [
        21
      ],
      "sourceLabels": [
        "Web source 1"
      ],
