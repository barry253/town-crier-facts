  "facts": [
    {
      "id": 1,
      "text": "Kicking Horse Reservoir was built in 1930 as part of the Flathead Indian Irrigation Project, storing water for reservation agriculture.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/kicking_horse_montana",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The community lies within the traditional homelands of the Salish and Kootenai peoples, who have lived there for thousands of years.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/kicking_horse_montana",
      "category": "people",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The name 'Kicking Horse' comes from Salish individuals Antoine and Angelica Kicking Horse of the Flathead Reservation.",
      "sourceSentenceIds": [
        26
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/kicking_horse_montana",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The Flathead Indian Reservation, which includes Kicking Horse, covers over 1.3 million acres and is governed by the Confederated Salish and Kootenai Tribes.",
      "sourceSentenceIds": [
        20
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/kicking_horse_montana",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The dam’s reservoir supports recreational boating and fishing for rainbow trout and yellow perch while irrigating surrounding reservation farms.",
      "sourceSentenceIds": [
        19
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/kicking_horse_montana",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The Flathead Indian Reservation was established in 1855 by the Hellgate Treaty between Salish, Pend d'Oreille, and Kootenai tribes and the U.S. government.",
      "sourceSentenceIds": [
        25
      ],
