  "facts": [
    {
      "id": 1,
      "text": "Pearl District was once a warehouse and railroad hub after the 1905 Lewis and Clark Exposition.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.pearldistrictportfolio.com/history",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Artists converted warehouses into studios and galleries, leading to the 1986 historic designation of 13th Avenue.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.pearldistrictportfolio.com/history",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The Maddox Building once stored barrels and crates before becoming a storage facility and later a creative space.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.pearldistrictportfolio.com/history",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Powell's City of Books, a Portland icon, sits within the Pearl District.",
      "sourceSentenceIds": [
        29
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Pearl_District%2C_Portland%2C_Oregon",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The former Weinhard Brewery operated from 1864 until 1999 before being redeveloped into the Brewery Blocks.",
