  "facts": [
    {
      "id": 1,
      "text": "Some say the traveler who named Sebastopol was Frederick Law Olmsted, the famed designer of Central Park, and he named it after Sevastopol in Crimea.",
      "sourceSentenceIds": [
        13
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Sebastopol%2C_Mississippi"
    },
    {
      "id": 2,
      "text": "Before becoming Sebastopol, the town was originally called Hathaway Springs in the 19th century.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Sebastopol%2C_Mississippi"
    },
    {
      "id": 3,
      "text": "Sebastopol existed even before the American Civil War, long before its formal incorporation.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://kids.kiddle.co/Sebastopol,_Mississippi"
    },
    {
      "id": 4,
      "text": "Sebastopol was officially incorporated in 1917, long after its early Civil War-era roots.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Sebastopol%2C_Mississippi"
    },
    {
      "id": 5,
      "text": "Each fall, Sebastopol hosts Sebastopolooza, a sizable festival that drew over a thousand attendees in 2010.",
      "sourceSentenceIds": [
        16
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Sebastopol%2C_Mississippi"
    },
    {
