  "facts": [
    {
      "id": 1,
      "text": "Forman was founded in 1884 by Colonel Cornelius Forman in the heart of the Great Plains.",
      "sourceSentenceIds": [
        1,
        3
      ],
      "sourceLabels": [
        "Web source 2",
        "Wikipedia"
      ],
      "source": "https://www.formannd.com/our-history"
    },
    {
      "id": 2,
      "text": "Forman became the county seat of Sargent County in 1886, moving the seat from Milnor.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Forman%2C_North_Dakota"
    },
    {
      "id": 3,
      "text": "The town sits beside Lake Lithia, a local body of water that gives the area a scenic backdrop.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Forman%2C_North_Dakota"
    },
    {
      "id": 4,
      "text": "Forman celebrated its diamond jubilee in 1959, marking 75 years of community life.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Forman%2C_North_Dakota"
    },
    {
      "id": 5,
      "text": "From 1884 to 1984, Forman documented a century of progress on its official website.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Forman%2C_North_Dakota"
    },
    {
      "id": 6,
      "text": "Until 1967, Forman was the only incorporated town in North Dakota, as all other communities were villages or cities.",
      "sourceSentenceIds": [
