  "facts": [
    {
      "id": 1,
      "text": "Boronda was named after José Eusebio Boronda, a Californio ranchero who received a Mexican land grant in 1840 for Rancho Los Laureles, which included the area.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.trawellino.com/destinations/united-states/california_boronda",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The José Eusebio Boronda Adobe, built 1844-1848, is the oldest surviving structure in the Salinas Valley and now part of the Boronda Adobe Historic Center.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/boronda_california",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The adobe showcases Monterey Colonial architecture with a four‑way sloping shingle roof, verandahs, and whitewashed interiors, a hallmark of Mexican‑era design.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/boronda_california",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The community occupies land from the original Rancho Rincón del Sanjón, granted in 1840 and confirmed by the U.S. in 1860 over about 2,230 acres.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/boronda_california",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "José Eusebio Boronda’s family built adobes that blended Mexican and emerging American influences, setting a stylistic precedent for the region.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/boronda_california",
      "category": "culture",
      "quality": "good"
    }
