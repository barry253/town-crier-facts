  "facts": [
    {
      "id": 1,
      "text": "Samuel Royer built Franklin Forge in 1829 at Piney Creek and the Juniata River, naming it after his birth county of Franklin.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/franklin_forge_pennsylvania",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The Royer‑run forge stayed active through at least 1854, feeding Pennsylvania’s early iron industry that supplied raw materials to Pittsburgh’s steel sector.",
      "sourceSentenceIds": [
        15
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/franklin_forge_pennsylvania",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "In 1843, Samuel Royer sold the forge to Elias Hoover and Daniel H., marking a shift in ownership amid the region’s growing iron network.",
      "sourceSentenceIds": [
        16
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/franklin_forge_pennsylvania",
      "category": "history",
      "quality": "poor",
      "qualityReason": "dropped_surname_no_wiki_source"
    },
    {
      "id": 4,
      "text": "By the late 1800s, as iron waned, Franklin Forge merged into Ganister, turning its focus to limestone quarrying.",
      "sourceSentenceIds": [
        18
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/franklin_forge_pennsylvania",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "A one‑room brick schoolhouse appeared in 1895, serving Franklin Forge’s children and signaling the community’s growing educational needs.",
      "sourceSentenceIds": [
        19
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/franklin_forge_pennsylvania",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Piney Creek skirts Franklin Forge to the northwest, emptying into the Frankstown Branch of the Juniata River just upstream of Ganister.",
      "sourceSentenceIds": [
        3,
        5
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Franklin_Forge%2C_Pennsylvania",
      "category": "nature",
      "quality": "good"
    }
  ],
