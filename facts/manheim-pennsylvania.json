  "facts": [
    {
      "id": 1,
      "text": "Manheim was founded in 1762 by glassmaker Henry William Stiegel, who called himself Baron von Stiegel.",
      "sourceSentenceIds": [
        1,
        15,
        22
      ],
      "sourceLabels": [
        "Web source 2",
        "Web source 1",
        "Wikipedia"
      ],
      "source": "https://manheimhistoricalsociety.org/history/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town’s original industry was the Stiegel Glassworks, later known as the American Flint Glass Manufactory, which produced glass equal to European imports.",
      "sourceSentenceIds": [
        3,
        10,
        11
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 2",
        "Web source 2"
      ],
      "source": "https://en.wikipedia.org/wiki/Manheim%2C_Pennsylvania",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Manheim’s first train arrived January 1, 1862, when the Columbia and Reading Railroad opened its first division through the borough.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Manheim%2C_Pennsylvania",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The borough sits on Pennsylvania Route 72, 11 miles northwest of Lancaster, and is bordered by Rapho and Penn Townships.",
      "sourceSentenceIds": [
        26,
        28
      ],
      "sourceLabels": [
        "Wikipedia",
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Manheim%2C_Pennsylvania",
      "category": "other",
      "quality": "poor",
      "qualityReason": "location_description"
    },
    {
      "id": 5,
      "text": "During the Revolutionary War, Manheim served as a safe haven for families of Colonial Patriots such as financier Robert Morris.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.discoverlancaster.com/regions-towns/northern-countryside/manheim/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The historic Manheim Historic Train Station hosts annual holiday events, including a Christmas Tree Lighting in Market Square each December.",
      "sourceSentenceIds": [
        5
      ],
