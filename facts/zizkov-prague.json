  "facts": [
    {
      "id": 1,
      "text": "The Žižkov Television Tower is Prague’s tallest building and the Czech Republic’s highest observation deck, standing 216 metres tall.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.viewfromprague.com/zizkov-prague-district-guide/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Nine pods and three decks house transmitting equipment, but six of those pods are open to visitors, offering panoramic views of the city.",
      "sourceSentenceIds": [
        16,
        21
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/%C5%BDi%C5%BEkov_Television_Tower",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The tower was built because Prague’s expanding city caused increasing interference with television signals.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.viewfromprague.com/zizkov-prague-district-guide/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "In 2013 a luxury one‑room hotel was added to the tower, complete with a bathtub that lets guests soak while watching the skyline.",
      "sourceSentenceIds": [
        27,
        28,
        29
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/%C5%BDi%C5%BEkov_Television_Tower",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Ten fiberglass “Miminka” babies by artist David Černý were temporarily mounted on the tower’s pillars in 2000, creating a quirky street‑art spectacle.",
      "sourceSentenceIds": [
        30
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/%C5%BDi%C5%BEkov_Television_Tower",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Žižkov’s Old Jewish Cemetery is a surprisingly old historical site that can be seen from almost any point in the district.",
