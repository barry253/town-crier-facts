  "facts": [
    {
      "id": 1,
      "text": "Montgomery County, where Spencerville sits, was carved out of Frederick County in 1838 and named after Revolutionary War Major General Richard Montgomery.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://msa.maryland.gov/msa/mdmanual/36loc/mo/chron/html/mochron.html",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The Metropolitan Branch of the Baltimore & Ohio Railroad once ran right through Montgomery County, linking Washington, D.C., to Point of Rocks and passing near Spencerville.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://msa.maryland.gov/msa/mdmanual/36loc/mo/chron/html/mochron.html",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Paleo‑Indians first settled the Spencerville area, living in small semi‑nomadic groups that hunted large game like bison and mammoths.",
      "sourceSentenceIds": [
        26
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://msa.maryland.gov/msa/mdmanual/36loc/mo/chron/html/mochron.html",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Archaeologists have uncovered pottery shards and broken arrowheads near the current National Institutes of Health property, evidence of Late Woodland Period villagers.",
      "sourceSentenceIds": [
        29
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://msa.maryland.gov/msa/mdmanual/36loc/mo/chron/html/mochron.html",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Sargent Shriver, a native of Montgomery County, became the first director of the Peace Corps, a role that put the county on the national stage.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://msa.maryland.gov/msa/mdmanual/36loc/mo/chron/html/mochron.html",
      "category": "people",
      "quality": "good"
    }
  ],
