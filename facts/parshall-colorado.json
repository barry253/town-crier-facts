  "facts": [
    {
      "id": 1,
      "text": "Parshall was named after the Parshall homestead, a ranch sold to Cordelia and Simon Parshall in 1902.",
      "sourceSentenceIds": [
        15,
        3
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://stories.grandcountyhistory.org/article/parshall"
    },
    {
      "id": 2,
      "text": "The town’s original store, run by Walter Dow, was the first drawing card for visitors to the area.",
      "sourceSentenceIds": [
        18
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://stories.grandcountyhistory.org/article/parshall"
    },
    {
      "id": 3,
      "text": "Parshall never incorporated, yet it still hosts a bar, a post office, a chapel, and the Grand County Road and Bridge Department office.",
      "sourceSentenceIds": [
        20
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://stories.grandcountyhistory.org/article/parshall"
    },
    {
      "id": 4,
      "text": "The Henderson Mill, located on County Road 3, processes molybdenum ore from the Henderson Mine just over the Continental Divide.",
      "sourceSentenceIds": [
        6,
        7
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Parshall%2C_Colorado"
    },
    {
      "id": 5,
      "text": "Cattle ranching remains a key part of Parshall’s economy, occupying much of the lower valley.",
      "sourceSentenceIds": [
        8,
        27
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 2"
      ],
      "source": "https://en.wikipedia.org/wiki/Parshall%2C_Colorado"
    },
    {
      "id": 6,
      "text": "Parshall sits on the north bank of the Colorado River, just downstream from Byers Canyon, along U.S. Route 40.",
