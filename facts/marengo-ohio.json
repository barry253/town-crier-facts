  "facts": [
    {
      "id": 1,
      "text": "Marengo was named after the 1800 Battle of Marengo in Italy, a victory for Napoleon that inspired its founder, Mrs. Isaac Freeman.",
      "sourceSentenceIds": [
        1,
        10,
        11
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Marengo%2C_Ohio",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The village was officially platted in 1873, though settlers had lived there since 1843 when Isaac Freeman built a cottage at the site.",
      "sourceSentenceIds": [
        6,
        7
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Marengo%2C_Ohio",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "A post office opened in Marengo in either 1847 or 1848, marking the town’s first federal presence.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Marengo%2C_Ohio",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Marengo sits in central Ohio, within Morrow County, and lies just south of the county seat, Mount Gilead.",
