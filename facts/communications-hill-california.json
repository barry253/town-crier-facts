      "quality": "good"
    },
    {
      "id": 3,
      "text": "San Jose began converting the largely barren hill into a mixed‑use urban neighborhood in 1984, formalized by a specific plan in 1992.",
      "sourceSentenceIds": [
        26,
        27
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Communications_Hill%2C_San_Jose",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The Azevedo Quarry operated from 1971 to 2006, and its aggregate recycling plant is slated to close in 2023 for redevelopment.",
      "sourceSentenceIds": [
        24,
        25
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Communications_Hill%2C_San_Jose",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "A pedestrian bridge and trail are planned to link Communications Hill directly to the nearby Capitol Caltrain station.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Communications_Hill%2C_San_Jose",
