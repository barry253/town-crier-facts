  "facts": [
    {
      "id": 1,
      "text": "Clutier was incorporated on January 16, 1901 as a railroad boomtown founded by William Brice of the Iowa, Minnesota, and Northern Railroad.",
      "sourceSentenceIds": [
        1,
        8
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/clutier_iowa",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town’s name honors Brice’s sister Maude and her husband Bertram Clutier, whose family helped shape the early community.",
      "sourceSentenceIds": [
        2,
        3
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/clutier_iowa",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Czech immigrants arriving between 1850 and 1890 settled in Clutier, drawn by affordable land and a landscape that reminded them of Bohemia.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/clutier_iowa",
      "category": "people",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The ZCBJ Lodge, chartered in 1901 as part of the Western Czech Fraternal Association, still stands as a historic site where Czech traditions were preserved.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/clutier_iowa",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Saint Wenceslaus Church, built in 1899, hosts a Corpus Christi procession that has been celebrated annually since the early 1900s.",
      "sourceSentenceIds": [
