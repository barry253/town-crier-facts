  "facts": [
    {
      "id": 1,
      "text": "Metlakatla comes from Maxłaxaała, a Tsimshian word meaning 'saltwater passage where the wind dies down.'.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Metlakatla%2C_Alaska",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "In 1886, William Duncan, an English missionary, left Metlakatla, B.C., and in 1887 led his followers to Annette Island, founding the town.",
      "sourceSentenceIds": [
        8,
        16
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Metlakatla%2C_Alaska",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Metlakatla is the only remaining federally recognized Indian reserve in Alaska, covering 132,000 acres of land and water.",
      "sourceSentenceIds": [
        27,
        29
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Metlakatla%2C_Alaska",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "During World War II, the U.S. built a military airbase on Annette Island, which later became a Coast Guard search and rescue base.",
      "sourceSentenceIds": [
        22,
        26
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Metlakatla%2C_Alaska",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "In exchange for the airbase, the U.S. promised to build a road connecting Metlakatla to the Inside Passage, enabling year‑round ferry service to Ketchikan.",
      "sourceSentenceIds": [
        23
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Metlakatla%2C_Alaska",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The Metlakatla Indian Community primarily consists of Tsimshian people, with lineage‑based membership and a council that grants citizenship.",
