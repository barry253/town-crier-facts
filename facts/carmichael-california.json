      "qualityReason": "vague"
    },
    {
      "id": 2,
      "text": "Dan Carmichael, the community’s namesake, founded the town after purchasing 2,000 acres from the former Rancho San Juan.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 2"
      ],
