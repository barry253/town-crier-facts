  "facts": [
    {
      "id": 1,
      "text": "South Lansing is part of the Town of Lansing, named after New York jurist John Lansing Jr., the state chancellor.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/south_lansing_new_york",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "South Lansing was part of the Town of Genoa in Cayuga County before becoming a separate town in 1817 when Tompkins County was created.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/south_lansing_new_york",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Before European settlement, the South Lansing area was part of the Cayuga Nation's territory, used for hunting, fishing, and agriculture.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/south_lansing_new_york",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "South Lansing sits on the eastern shore of Cayuga Lake, with rolling uplands rising from the lake and steep gorges carved by Salmon Creek.",
      "sourceSentenceIds": [
        17,
        24
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/south_lansing_new_york",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The Cayuga Shores Wildlife Management Area, a 287‑acre preserve along 3,400 feet of lakeshore, protects water quality and biodiversity in South Lansing.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Web source 1"
