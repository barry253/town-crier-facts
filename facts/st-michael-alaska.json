  "facts": [
    {
      "id": 1,
      "text": "Traders of the Russian-American Company founded St. Michael in 1833 as a trading post for the local Yup'ik people.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/St._Michael%2C_Alaska"
    },
    {
      "id": 2,
      "text": "The settlement and the island of St. Michael were both named after the archangel Michael.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/St._Michael%2C_Alaska"
    },
    {
      "id": 3,
      "text": "Early trade in St. Michael focused on acquiring pelts from sea otters, seals, and other furbearers from local hunters.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/St._Michael,_Alaska"
    },
    {
      "id": 4,
      "text": "St. Michael is located on the east side of St. Michael Island at the southeastern end of the Norton Sound.",
      "sourceSentenceIds": [
        17,
        18
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/St._Michael%2C_Alaska"
    },
    {
      "id": 5,
      "text": "Russian Orthodox missionaries exerted cultural influence in St. Michael through community ties and baptisms.",
      "sourceSentenceIds": [
        11
      ],
