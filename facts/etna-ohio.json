  "facts": [
    {
      "id": 1,
      "text": "Lyman Terrell renamed the village from Carthage to Etna, after the famous Sicilian volcano, when he learned it sat at the highest point between Jacksontown and Columbus.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://etnatownship.com/history/",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "When first laid out, Etna stretched nine and a half miles east‑west and two and a half miles wide before a 1850 adjustment trimmed its east end.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://etnatownship.com/history/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The National Road once brought a steady stream of travelers, but the arrival of the railroad in 1852 halted Etna’s growth along the highway.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://etnatownship.com/history/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "A historic garage built in the early 20th century still stands in Etna, a rare reminder of the town’s early automotive era.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://etnatownship.com/history/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Etna’s post office has been in continuous operation since 1833, serving the community for nearly two centuries.",
      "sourceSentenceIds": [
        17
