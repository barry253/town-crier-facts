      "id": 1,
      "text": "Williamstown was founded in 1865 by landowners Mapes, Williams, and Moore on 900 acres acquired from the railroad company.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
