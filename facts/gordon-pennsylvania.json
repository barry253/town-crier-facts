    },
    {
      "id": 2,
      "text": "During the anthracite boom, the Gordon Plane hauled almost 2,000 coal cars daily up the mountains, fueling the town’s growth.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/gordon_pennsylvania",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "In 1846, William Stevenson installed a steam saw in the valley, sparking Gordon’s early industrial era.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://gordonborough.com/about-us/history/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Gordon’s 1991 centennial logo showed a steam locomotive, honoring its mining and railroading roots.",
