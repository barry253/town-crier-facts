  "facts": [
    {
      "id": 1,
      "text": "Mellenville was renamed from Centerville in 1837 to honor Mr. Mellen, the railroad builder who brought the village its first major growth.",
      "sourceSentenceIds": [
        22,
        30
      ],
      "sourceLabels": [
        "Web source 1",
        "Web source 2"
      ],
      "source": "https://townofclaverack.com/town-life/villages-hamlets/mellenville/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The original wooden passenger station burned in the 1880s, allegedly from a steam locomotive spark, and was replaced by a brick building with a slate roof.",
      "sourceSentenceIds": [
        11,
        12
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://townofclaverack.com/town-life/villages-hamlets/mellenville/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Mellenville sits where Claverack and Eastern creeks meet, just 0.8 miles west of Philmont along New York Route 217.",
      "sourceSentenceIds": [
        4,
        18,
        19,
        20,
        21
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://townofclaverack.com/town-life/villages-hamlets/mellenville/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "A Harder Hosiery Factory once operated on Eastern Creek, occupying a large frame building in the village’s eastern part.",
