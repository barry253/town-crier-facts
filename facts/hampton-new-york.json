  "facts": [
    {
      "id": 1,
      "text": "East Hampton was founded in 1648 when colonial governors bought over 30,000 acres from the Montauk people and sold shares to New England settlers.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.britannica.com/place/the-Hamptons",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Over time, the South Fork evolved from farming, fishing, and whaling communities into a seasonal destination while historic streetscapes, churches, windmills, and maritime landmarks still define its character.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.longislandguide.com/visit/the-hamptons/",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The now disbanded Clinton Academy on Main Street was the first chartered academy authorized by the New York State Board of Regents in 1784.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/East_Hampton%2C_New_York",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The house built in 1680 for Josiah Hobart, a prominent early settler, appears in the first formal deed of conveyance of East Hampton.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/East_Hampton%2C_New_York",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "East Hampton experiences chilly, wet winters and very warm, dry summers, with the ocean moderating thunderstorms and keeping summer temperatures in check.",
      "sourceSentenceIds": [
        22
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/East_Hampton%2C_New_York",
