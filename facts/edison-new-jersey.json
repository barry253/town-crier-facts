  "facts": [
    {
      "id": 1,
      "text": "Edison’s industrial research laboratory, called Edison’s “invention factory,” opened in 1876 and put the township on the map for global innovation.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.edisonchamber.com/history",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The township’s Bonhamtown area on Old Post Road honors Nicholas Bonham, a freeholder from 1682–83.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.edisonchamber.com/history",
      "category": "people",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Edison was originally incorporated as Raritan Township in 1870 before adopting its current name in 1954 to avoid confusion with other Raritan towns.",
      "sourceSentenceIds": [
        17,
        13
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 2"
      ],
      "source": "https://en.wikipedia.org/wiki/Edison%2C_New_Jersey",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The first settlers arrived in the late 1600s when the area was part of Woodbridge and Piscataway, making Edison one of New Jersey’s oldest communities.",
      "sourceSentenceIds": [
        23
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.edisonchamber.com/history",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The Pennsylvania Railroad’s arrival in the late 19th century turned Edison into a rail hub, spurring rapid growth and industrialization.",
      "sourceSentenceIds": [
        25
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.edisonchamber.com/history",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The Edison Memorial Tower, listed on the National Register of Historic Places, was illuminated in 1986 with 12 period street lamps to celebrate Christie Street’s historic lighting.",
      "sourceSentenceIds": [
        27,
        28
      ],
      "sourceLabels": [
        "Web source 1"
      ],
