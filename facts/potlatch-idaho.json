  "facts": [
    {
      "id": 1,
      "text": "Potlatch began in 1903 as a company town for the Potlatch Lumber Company, which built the world's largest white pine sawmill in 1906.",
      "sourceSentenceIds": [
        1,
        5,
        10,
        13
      ],
      "sourceLabels": [
        "Web source 2",
        "Web source 1",
        "Wikipedia"
      ],
      "source": "https://www.cityofpotlatch.org/"
    },
    {
      "id": 2,
      "text": "The town’s mill operated for over seventy years, closing in August 1981 after a long decline in lumber prices.",
      "sourceSentenceIds": [
        21,
        22
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Potlatch%2C_Idaho"
    },
    {
      "id": 3,
      "text": "After the mill shut down, Potlatch transitioned into a bedroom community for nearby university towns Moscow and Pullman.",
      "sourceSentenceIds": [
        25
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Potlatch%2C_Idaho"
    },
    {
      "id": 4,
      "text": "In 1986, part of Potlatch’s historic commercial district was listed on the National Register of Historic Places.",
      "sourceSentenceIds": [
        24
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Potlatch%2C_Idaho"
    },
    {
      "id": 5,
      "text": "Potlatch lies north of the confluence of Rock Creek and the Palouse River, on the edge of the Palouse ecoregion.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Potlatch%2C_Idaho"
    },
    {
      "id": 6,
      "text": "Potlatch banned prostitution and prohibited alcohol during its company town era, encouraging married couples to rent houses.",
      "sourceSentenceIds": [
        18
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Potlatch%2C_Idaho"
