  "facts": [
    {
      "id": 1,
      "text": "Paradis, Louisiana, takes its name from Edouard Paradis, a Quebec immigrant who arrived in 1856 to supply railroad crossties.",
      "sourceSentenceIds": [
        12,
        15
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/paradis_louisiana",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Before European settlers, the area now called Paradis was home to the Sims Site, a 32‑acre Native American archaeological zone occupied for over 600 years.",
      "sourceSentenceIds": [
        11,
        13
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/paradis_louisiana",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "In the early 1910s, Illinois investors led by Julius Funk promoted Paradis as a “showplace” town, building sidewalks, street lights, a bank, and a four‑room Youngs School.",
      "sourceSentenceIds": [
        16,
        30
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/paradis_louisiana",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The Youngs School, opened in the 1910s, became the largest four‑room school in Charles Parish and was named after local physician Luther Youngs.",
      "sourceSentenceIds": [
        5,
        6,
        21,
        22
      ],
      "sourceLabels": [
        "Web source 1",
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/paradis_louisiana",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The community’s sawmill, established by Edouard Paradis, became the nucleus of the town, attracting settlers and shaping its early growth.",
      "sourceSentenceIds": [
        15
      ],
