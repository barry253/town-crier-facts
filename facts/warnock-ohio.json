    {
      "id": 1,
      "text": "Warnock was originally called Warnock's Station, a stop for stagecoaches and later the Baltimore & Ohio Railroad in the late 1800s.",
      "sourceSentenceIds": [
        1,
        2,
        16
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/warnock_ohio",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The post office opened in 1857 and has kept the community’s name alive ever since.",
      "sourceSentenceIds": [
        9,
        20
      ],
      "sourceLabels": [
        "Web source 1",
        "Wikipedia"
      ],
      "source": "https://grokipedia.com/page/warnock_ohio",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Warnock sits on the Unglaciated Allegheny Plateau, where rolling hills and steep ridges carve narrow stream valleys typical of eastern Ohio.",
      "sourceSentenceIds": [
        26
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/warnock_ohio",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The town’s cemetery spans nearly two acres and contains the graves of early settlers like John Warnock (1766–1839) and his wife Isabella.",
      "sourceSentenceIds": [
        11
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/warnock_ohio",
      "category": "people",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Warnock lies along State Route 9, about 4.5 miles south of the county seat, Clairsville, and is part of the Wheeling, WV‑OH Metropolitan Statistical Area.",
