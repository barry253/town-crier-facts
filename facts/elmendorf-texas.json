  "facts": [
    {
      "id": 1,
      "text": "Founded in 1885 by Henry Elmendorf, a former San Antonio mayor, Elmendorf began as a modest railroad town.",
      "sourceSentenceIds": [
        2,
        10,
        24
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Elmendorf%2C_Texas"
    },
    {
      "id": 2,
      "text": "Named after German‑Texan Henry Elmendorf, the town grew around the first brick plant he helped establish.",
      "sourceSentenceIds": [
        2,
        24
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 2"
      ],
      "source": "https://en.wikipedia.org/wiki/Elmendorf%2C_Texas"
    },
    {
      "id": 3,
      "text": "In the late 1800s, Elmendorf’s main businesses were a pottery plant, a Singer‑owned brick factory, and a Gilette cotton gin.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.elmendorf-tx.com/218/Elmendorf-History"
    },
    {
      "id": 4,
      "text": "For many years the largest employer was Star Clay Products, a firebrick factory that still defines the town’s industrial heritage.",
      "sourceSentenceIds": [
        7,
        28
      ],
      "sourceLabels": [
        "Web source 2",
        "Wikipedia"
      ],
      "source": "https://www.tshaonline.org/handbook/entries/elmendorf-tx"
    },
    {
      "id": 5,
      "text": "Elmendorf’s historic train depot once served as a vital link, connecting residents to the broader region.",
