  "facts": [
    {
      "id": 1,
      "text": "Gate City got its name in 1886 because its location near Big Moccasin Gap made it the “Gate Way to the West.”.",
      "sourceSentenceIds": [
        28,
        29
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Gate_City%2C_Virginia",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town was laid out in 1815 on the Wilderness Road and became a gateway for westward travelers.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.dhr.virginia.gov/historic-registers/221-5010/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Pilot Flying J, the largest North American travel‑center network, was founded in Gate City in 1958.",
      "sourceSentenceIds": [
        16
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Gate_City%2C_Virginia",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Gate City’s historic downtown still hosts local musicians playing traditional Appalachian folk and bluegrass.",
