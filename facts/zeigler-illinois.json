  "facts": [
    {
      "id": 1,
      "text": "Zeigler was incorporated in 1914 and named after Levi Zeigler Leiter, the father of the coal company founder Joseph Leiter.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Zeigler%2C_Illinois",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "In 1901 Levi Zeigler Leiter and his son Joseph brought a Chicago fortune to Zeigler, starting a small industrial empire.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.legendsofamerica.com/il-zeigler/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "George Pullman built a company town just south of Chicago, and the Leiters saw an opportunity to do the same in Franklin County.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.legendsofamerica.com/il-zeigler/",
      "category": "history",
      "quality": "poor",
      "qualityReason": "vague"
    },
    {
      "id": 4,
      "text": "The town’s layout resembles a wagon wheel, with a circular park at the center and streets radiating outward.",
      "sourceSentenceIds": [
        11
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Zeigler%2C_Illinois",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "A tragic coal mining accident in 1905 killed fifty men in or near Zeigler, marking a dark chapter in its history.",
      "sourceSentenceIds": [
        14
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Zeigler%2C_Illinois",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Nick Holonyak, the inventor of the first practical visible LED, was born in Zeigler and later became a celebrated scientist.",
      "sourceSentenceIds": [
