  "facts": [
    {
      "id": 1,
      "text": "Brownsburg Historic District was added to the National Register of Historic Places in 1973, preserving mostly pre‑1860 buildings that reflect the village’s early architecture.",
      "sourceSentenceIds": [
        16,
        15
      ],
      "sourceLabels": [
        "Web source 1",
        "Wikipedia"
      ],
      "source": "https://www.dhr.virginia.gov/historic-registers/081-0121/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The village was originally laid out in 1783 on lands owned by Robert Wardlaw and Samuel McChesney along a main stage line.",
      "sourceSentenceIds": [
        16
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.dhr.virginia.gov/historic-registers/081-0121/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "By 1835 Brownsburg boasted twenty dwellings, a mill, three stores, two shoe factories, and a blacksmith shop, making it a bustling hub of activity.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.dhr.virginia.gov/historic-registers/081-0121/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The Valley Railroad built east of town in 1884 shifted commerce away, initiating a long decline for Brownsburg.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.dhr.virginia.gov/historic-registers/081-0121/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The Brownsburg Museum sits in the village center, opened in 1973, and is registered as a Virginia Historic Landmark.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.thebrownsburgmuseum.org/about-us",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Sleepy Hollow, a circa 1800 stone house with an 1830s brick wing, lies under a permanent preservation easement within the historic district.",
      "sourceSentenceIds": [
        19,
        20
      ],
