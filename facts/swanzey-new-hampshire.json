      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "West Swanzey grew as a textile mill town connected by the Ashuelot Railroad; East Swanzey made wooden buckets.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
