    },
    {
      "id": 3,
      "text": "Ferencváros once hosted Hungary’s largest slaughterhouse, a landmark that now stands beside the Central Market Hall on Fővám tér.",
      "sourceSentenceIds": [
        14,
        7
      ],
      "sourceLabels": [
