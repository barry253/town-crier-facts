  "facts": [
    {
      "id": 1,
      "text": "Ferencváros was named after King Francis I when he was crowned king of Hungary on 4 December 1792.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Ferencv%C3%A1ros",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The district’s industrial roots still echo in its converted factories, now housing museums like Trafó and the former slaughterhouse Gizella Malom.",
      "sourceSentenceIds": [
        14
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Ferencv%C3%A1ros",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Ferencváros once hosted Hungary’s largest slaughterhouse, a landmark that now stands beside the Central Market Hall on Fővám tér.",
      "sourceSentenceIds": [
        14,
        7
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Ferencv%C3%A1ros",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The former glass factory turned ruin bar, known for its 20-plus taps of local liquid gold, sits along the Danube’s banks.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://visitcity.travel/en/budapest/district/ferencvaros",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Ferencváros’ main artery, Ráday Street, evolved from a historic restaurant row into a quieter, leafier bistro haven favored by locals.",
      "sourceSentenceIds": [
        9
      ],
