    },
    {
      "id": 2,
      "text": "Former factories line Ferencváros, now home to museums and cultural venues like Trafó, a transformer‑station‑turned‑gallery.",
      "sourceSentenceIds": [
        15
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Ferencv%C3%A1ros"
    },
    {
      "id": 3,
      "text": "Zwack Unicum Museum on Dandár Street lets visitors tour historic cellars holding over 500 oak casks of Hungary’s bitter liqueur.",
      "sourceSentenceIds": [
        1,
        9,
        12
      ],
      "sourceLabels": [
        "Web source 1",
        "Web source 2"
      ],
      "source": "https://visitcity.travel/en/budapest/district/ferencvaros"
    },
    {
      "id": 4,
      "text": "Central Market Hall on Fővám tér remains Ferencváros’s bustling food hub, echoing its 19th‑century market roots.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
