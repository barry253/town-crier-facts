  "facts": [
    {
      "id": 1,
      "text": "Lyons began as Lyon's Station, renamed when the Gulf, Colorado and Santa Fe Railway built its main line through Burleson County in 1880.",
      "sourceSentenceIds": [
        22,
        23
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.tshaonline.org/handbook/entries/lyons-tx-burleson-county",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Camp Pennington, a workers’ camp, evolved into Lyons, becoming the county’s second‑largest town and a regional trading hub.",
      "sourceSentenceIds": [
        23,
        24
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.tshaonline.org/handbook/entries/lyons-tx-burleson-county",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The 1886 post office marked Lyons’ growth, soon followed by its first school and a Methodist church in 1887.",
      "sourceSentenceIds": [
        27,
        28,
        29
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.tshaonline.org/handbook/entries/lyons-tx-burleson-county",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Lyons hosted a diverse mix of businesses: cotton warehouse, oil mill, millinery shop, drugstore, hotel, four general stores, three cotton gins, and blacksmith shops.",
      "sourceSentenceIds": [
        26
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.tshaonline.org/handbook/entries/lyons-tx-burleson-county",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "A Masonic lodge in Lyons served as the community’s civic center, hosting meetings and events for residents.",
      "sourceSentenceIds": [
