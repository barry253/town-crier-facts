  "facts": [
    {
      "id": 1,
      "text": "Foster City was founded in the 1960s on Brewer Island, built on marshland with engineered landfill.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Foster_City%2C_California",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Jack Foster bought Brewer's Island for $200k and partnered with Richard Grant to create a planned city named Foster City.",
      "sourceSentenceIds": [
        5,
        6
      ],
      "sourceLabels": [
        "Web source 1",
        "Web source 2"
      ],
      "source": "https://www.fostercity.org/community/page/history-foster-city",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The first residents moved in on March 7, 1964, and early homes sold for under $18,000.",
      "sourceSentenceIds": [
        27,
        29
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Foster_City%2C_California",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The Hillbarn Theatre, founded in 1940, offers year‑round live theatre and summer camps for kids in Foster City.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Foster_City%2C_California",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Foster City is home to tech giants like Gilead Sciences, Zoox, and Replit, reflecting its Silicon Valley ties.",
      "sourceSentenceIds": [
        22
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Foster_City%2C_California",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "A municipal improvement district called Estero issued over $85.5 million in bonds between 1960‑67, the only other such district in California besides Santa Barbara.",
