  "facts": [
    {
      "id": 1,
      "text": "Early pioneers dubbed the nearly treeless grasslands 'The Barrens,' giving the river its name, Barren River.",
      "sourceSentenceIds": [
        13
      ],
      "sourceLabels": [
        "Web source 1"
      ],
