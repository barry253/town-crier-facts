  "facts": [
    {
      "id": 1,
      "text": "Gasconade was the site of the 1855 Gasconade Bridge disaster, when a locomotive plunged into the river after the bridge collapsed.",
      "sourceSentenceIds": [
        15,
        16
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Gasconade%2C_Missouri"
    },
    {
      "id": 2,
      "text": "The city was officially platted in 1857, just two years after the bridge tragedy reshaped the area’s early history.",
      "sourceSentenceIds": [
        13
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Gasconade%2C_Missouri"
    },
    {
      "id": 3,
      "text": "Gasconade takes its name from the river that meets the Missouri River at the town’s mouth, a spot that drew early settlers.",
      "sourceSentenceIds": [
        14,
        5
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Gasconade%2C_Missouri"
    },
    {
      "id": 4,
      "text": "The Gasconade County Historical Society Museum sits in the old Railroad Hotel, offering a glimpse into the county’s pioneer days.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.visitmo.com/things-to-do/gasconade-county-historical-society-museum"
    },
    {
      "id": 5,
      "text": "The Historical Society’s website archives local history and genealogy records, keeping the stories of Gasconade’s residents alive for future generations.",
