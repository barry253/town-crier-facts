      "id": 1,
      "text": "Havertown was founded by Welsh Quakers in 1681 on land bought from William Penn.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Havertown%2C_Pennsylvania",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town’s name honors Haverfordwest in Wales, reflecting its settlers’ heritage.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Havertown%2C_Pennsylvania",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Haverford College, established in 1833, sits on a 200‑acre campus filled with historic buildings and heritage trees.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://discoverhaverford.org/deep-roots",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The Haverford Township Historical Society, formed in 1939, preserves documents, artifacts, and historic sites like Lawrence Cabin and Nitre Hall.",
      "sourceSentenceIds": [
        3,
        4,
        21,
        23
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://haverfordhistoricalsociety.org/",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "A former commercial rail line served local factories until the 1960s, illustrating Havertown’s industrial past.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Havertown%2C_Pennsylvania",
      "category": "transport",
      "quality": "good"
    },
