  "facts": [
    {
      "id": 1,
      "text": "In 1886 the San Antonio and Aransas Pass Railway built a switch and depot called Brackenridge, sparking settlement in Falls City.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.tshaonline.org/handbook/entries/falls-city-tx",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town was renamed Falls City to avoid confusion with Breckenridge, Texas, after the original name Brackenridge.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.usacitiesonline.com/txcountyfallscity.htm",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Falls City sits a mile southeast of the Wilson county line and seven miles northwest of Karnes City, anchoring it in northern Karnes County.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.tshaonline.org/handbook/entries/falls-city-tx",
