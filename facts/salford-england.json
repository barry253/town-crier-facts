  "facts": [
    {
      "id": 1,
      "text": "Salford was named in the Early Middle Ages, though evidence exists of settlement since Neolithic times.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Salford",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The Roman fort Mamucium, founded in AD 79, became the seed for Salford's development and brought 300 years of Pax Romana.",
      "sourceSentenceIds": [
        4,
        5
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Salford",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "In 1879, industrialist Hans Renold founded a textile‑chain business in Ordsall that evolved into Renold, still making chains today.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Salford",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The University of Salford, originally the Royal Technical Institute in 1896, gained university status in 1967 and is known for engineering.",
      "sourceSentenceIds": [
        14
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.britannica.com/place/Salford-England",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Salford's textile heritage dates back before the Industrial Revolution, with the 1801 Philip's and Lee's Twist Mill being Britain’s second iron‑framed multi‑story building.",
      "sourceSentenceIds": [
        16
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Salford",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Folk legend Ewan MacColl, a key figure in the 1960s folk revival, was born in Salford, linking the city to a global music movement.",
      "sourceSentenceIds": [
        20
      ],
