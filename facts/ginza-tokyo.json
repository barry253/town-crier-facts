  "facts": [
    {
      "id": 1,
      "text": "Ginza was built on a former swamp that was filled in during the 16th century, turning the area into a bustling commercial hub.",
      "sourceSentenceIds": [
        17
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Ginza",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The name Ginza comes from a silver‑coin mint established there in 1612, giving the district its distinctive name.",
      "sourceSentenceIds": [
        18
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Ginza",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "After a devastating fire in 1872, the Meiji government rebuilt Ginza with fireproof brick buildings and wider streets, marking it as a model of modernization.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Ginza",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Ginza’s first Western‑style shopping promenade, completed in 1873, stretched from Shinbashi Bridge to Kyōbashi Bridge and featured Georgian brick buildings.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Ginza",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Since the 1960s, the main north–south artery of Ginza has been closed to traffic on weekends, turning the street into a pedestrian paradise.",
      "sourceSentenceIds": [
        27
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Ginza",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Ginza Station, served by the Ginza, Marunouchi, and Hibiya lines, connects the district to the rest of Tokyo and is a key transit hub for shoppers and tourists.",
      "sourceSentenceIds": [
        13,
        14
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Ginza",
      "category": "landmark",
      "quality": "good"
    }
  ],
