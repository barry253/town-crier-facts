  "facts": [
    {
      "id": 1,
      "text": "Chignik Lake’s name means 'big wind' in the Alutiiq language for the area.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/chignik_alaska"
    },
    {
      "id": 2,
      "text": "The Hume Company opened a cannery in 1896, and the Columbia River Packers built Alaska’s oldest continuously operating seafood facility in 1910.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/chignik_alaska"
    },
    {
      "id": 3,
      "text": "The Alutiiq people have called the Chignik region home in Alaska for millennia.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/chignik_lake_alaska"
    },
    {
      "id": 4,
      "text": "The surrounding terrain bears volcanic influences from the Aleutian Range, with the Aniakchak Caldera about 43 miles southwest.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/chignik_alaska"
    },
    {
      "id": 5,
      "text": "Annual precipitation averages 127 inches of rain and 58 inches of snow, making Chignik Lake one of the wettest spots in Alaska.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/chignik_alaska"
    },
    {
      "id": 6,
      "text": "Commercial salmon fishing dominates, with sockeye salmon accounting for over 90% of harvests and the community landing 16.3 million pounds in 2010.",
