    {
      "id": 1,
      "text": "Essex Village sits on the eastern edge of the town, hugging the Connecticut River and bordering the Canfield‑Meadow Woods Nature Preserve.",
      "sourceSentenceIds": [
        2,
        6
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Essex_Village%2C_Connecticut",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Essex Village’s western boundary follows the historic Connecticut Valley Railroad and touches the Falls River, adding both a key rail line and a waterway to the town’s landscape.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Essex_Village%2C_Connecticut",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Essex Village’s western boundary also follows the Mud River, adding another waterway to the area.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Essex_Village%2C_Connecticut",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "In the early 20th century, the steamship Hartford docked in Essex, making the village a brief maritime hub.",
      "sourceSentenceIds": [
        22
      ],
      "sourceLabels": [
