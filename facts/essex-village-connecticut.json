      ],
      "source": "https://www.essexct.gov/539/Essex-Village",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "A painting by Soldwedel captures the 1777 British attack on Essex Harbor, a pivotal moment in the town’s colonial history.",
