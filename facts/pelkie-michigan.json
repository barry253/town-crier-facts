  "facts": [
    {
      "id": 1,
      "text": "Pelkie was settled by French Canadians around 1885, first called \"King's Landing\" before adopting the name of settler William Pelkie.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Pelkie%2C_Michigan",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town sits on the Sturgeon River in northeast Baraga Township, a spot that helped shape its early logging and farming life.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Pelkie%2C_Michigan",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "In 1909 the Historic Pelkie Grade School was built; it remains the only one‑room schoolhouse still standing in Baraga County and is on the State Register.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Pelkie%2C_Michigan",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The Mineral Range Railroad once ran through Pelkie, with boxcars loading cabbage at the Froberg Siding in the 1910s.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.baragacountyhistoricalmuseum.com/photohistory/pelkie.html",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "A 1930s photo shows Pelkie’s Agriculture School on the road, a reminder of the community’s long‑standing commitment to farming education.",
      "sourceSentenceIds": [
        24
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.baragacountyhistoricalmuseum.com/photohistory/pelkie.html",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Every August, Pelkie hosts the Baraga County Fair on the second weekend, drawing visitors to its historic fairgrounds and dairy‑farm roots.",
