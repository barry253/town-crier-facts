  "facts": [
    {
      "id": 1,
      "text": "Fairview got its name when Colonel Thomas Forster declared in 1797 that the spot offered the fairest view he’d seen.",
      "sourceSentenceIds": [
        26
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.experiencepa.com/fairview/"
    },
    {
      "id": 2,
      "text": "The Sturgeon House, built in 1838, now serves as Fairview’s museum and is listed on the National Register of Historic Places.",
      "sourceSentenceIds": [
        8,
        10
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.experiencepa.com/fairview/"
    },
    {
      "id": 3,
      "text": "Fairview Township was one of Erie County’s first 16 townships, settled in 1797.",
      "sourceSentenceIds": [
        27
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.experiencepa.com/fairview/"
    },
    {
      "id": 4,
      "text": "Fairview sits quietly along Lake Erie’s southern shore, a small township that feels like a breath of fresh air.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.experiencepa.com/fairview/"
    },
    {
      "id": 5,
      "text": "Early settlers William and Jeremiah Sturgeon were drawn to the area by its streams and fertile soil.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.experiencepa.com/fairview/"
    },
    {
      "id": 6,
      "text": "The Fairview Area Historical Society runs the Sturgeon House museum, preserving local genealogical records and artifacts.",
      "sourceSentenceIds": [
