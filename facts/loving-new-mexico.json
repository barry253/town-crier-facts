      "quality": "good"
    },
    {
      "id": 4,
      "text": "After the Civil War, cattle barons like Oliver Loving drove herds along the Pecos River, establishing cow camps that would later become Loving.",
      "sourceSentenceIds": [
        28
      ],
      "sourceLabels": [
