      "id": 1,
      "text": "Bay City was originally called Lower Saginaw and was part of Saginaw County until 1857.",
      "sourceSentenceIds": [
        6,
        9
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
