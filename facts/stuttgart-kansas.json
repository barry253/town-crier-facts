    {
      "id": 1,
      "text": "Stuttgart, Kansas, takes its name from the German city of Stuttgart, honoring the heritage of its early settlers.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://legendsofkansas.com/stuttgart-kansas/"
    },
    {
      "id": 2,
      "text": "Stuttgart was officially founded on February 6, 1888, replacing the earlier settlement of Wagnerville.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://legendsofkansas.com/stuttgart-kansas/"
    },
    {
      "id": 3,
      "text": "The arrival of the Rock Island Railroad turned Stuttgart into a thriving community.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.phillipscountyks.org/stuttgart-photo-gallery"
    },
    {
      "id": 4,
      "text": "Trinity Lutheran Church, founded in 1900, sits a quarter mile west of Stuttgart.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://legendsofkansas.com/stuttgart-kansas/"
    },
    {
      "id": 5,
      "text": "The Stuttgart Band, started in 1903 by organist Theodore Hempler, added musical life to the town.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://legendsofkansas.com/stuttgart-kansas/"
    },
    {
      "id": 6,
      "text": "Stuttgart’s first post office opened on February 6, 1888, with George Veeh as postmaster.",
