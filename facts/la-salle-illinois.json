  "facts": [
    {
      "id": 1,
      "text": "La Salle hosts the Hegeler-Carus Mansion, a National Historic Landmark showcasing 19th‑century industrial elegance.",
      "sourceSentenceIds": [
        1,
        9,
        18
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/La_Salle%2C_Illinois",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Named after French explorer Robert de La Salle, the city borders the Illinois River and the historic Illinois‑Michigan Canal.",
      "sourceSentenceIds": [
        3,
        5
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/La_Salle%2C_Illinois",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The Illinois‑Michigan Canal, now a recreational trail, runs through downtown La Salle, offering hiking, biking, and boating.",
      "sourceSentenceIds": [
        24,
        27
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://familydestinationsguide.com/historic-small-illinois-town/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Matthiessen State Park, established in 1943, honors philanthropist Paul Matthiessen, who once served as La Salle’s mayor.",
      "sourceSentenceIds": [
        29,
        28
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/La_Salle%2C_Illinois",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The Hegeler-Carus Foundation preserves the mansion for events, allowing visitors to experience historic charm and classic architecture.",
      "sourceSentenceIds": [
        20,
