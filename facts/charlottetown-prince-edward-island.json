    {
      "id": 1,
      "text": "Charlottetown was named in honour of Queen Charlotte, wife of George III, when the island passed to Britain in 1763.",
      "sourceSentenceIds": [
        4,
        6
      ],
      "sourceLabels": [
        "Web source 2",
