      ],
      "source": "https://en.wikipedia.org/wiki/Gilbert%2C_Arizona",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The first post office opened in 1912 inside Ayer’s Grocery, the town’s first store, marking Gilbert’s entry into federal services.",
      "sourceSentenceIds": [
        19
      ],
      "sourceLabels": [
