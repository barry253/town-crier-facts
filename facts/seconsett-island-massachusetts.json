      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Between the 1930s and 1950s, Seconsett Island became a haven for artists, writers, and Boston‑area professionals seeking a quiet getaway.",
      "sourceSentenceIds": [
