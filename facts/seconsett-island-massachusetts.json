    {
      "id": 2,
      "text": "The Seconsett Island Bridge, built in the early 20th century, turned a wetland peninsula into a connected island and sparked summer tourism.",
      "sourceSentenceIds": [
        21,
        24
      ],
      "sourceLabels": [
        "Web source 1"
