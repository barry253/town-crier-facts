  "facts": [
    {
      "id": 1,
      "text": "The name 'Cambrian Park' first appeared in 1950s newspapers, referring to Union and Cambrian school areas, the latter named by ranch hand David Lewis in the 1870s.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Cambrian%2C_San_Jose",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The Cambrian Park Plaza was originally built in 1953 at the crossroads of Camden and Union Avenues.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Cambrian%2C_San_Jose",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "A colorful carousel atop the Plaza’s sign is a designated historical landmark, adding a touch of mid‑century charm.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Cambrian%2C_San_Jose",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The We and Our Neighbors clubhouse, built in 1910, is a San Jose Historic Landmark listed on the National Register of Historic Places.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Cambrian%2C_San_Jose",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Cambrian Park has long been centered around its Plaza, which has housed a mix of local shops and national brands since its opening.",
      "sourceSentenceIds": [
        18
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Cambrian%2C_San_Jose",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The neighborhood hosts a branch of the San Jose Public Library, offering free community resources and a weekly free newspaper called the Cambrian Resident.",
