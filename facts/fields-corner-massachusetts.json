  "facts": [
    {
      "id": 1,
      "text": "Fields Corner takes its name from Zechariah Field, an early 17th‑century settler who arrived in Boston in 1629.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Fields_Corner",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Founded in June 1630, Fields Corner is one of Boston’s oldest commercial districts.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Fields_Corner",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Between 2005 and 2010, the Dorchester Avenue Project poured $18 million into widening sidewalks, adding bike lanes and installing energy‑efficient lighting in Fields Corner.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/fields_corner",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The Fields Corner MBTA station opened on November 5, 1927, becoming the southern terminus of the Red Line’s Dorchester extension.",
      "sourceSentenceIds": [
        14
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/fields_corner",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "In 2002, Viet‑AID built an 18,000‑square‑foot community center that now hosts cultural events, youth programs and small‑business support.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/fields_corner",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The 1874 Municipal Building, a Victorian Gothic structure designed by George Clough, once housed a police station, courthouse, and even a jail.",
      "sourceSentenceIds": [
        1
      ],
