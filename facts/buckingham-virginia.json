      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The Buckingham County Historical Society Museum showcases Native American artifacts, Civil War memorabilia, and early settler items.",
      "sourceSentenceIds": [
        19
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://museumsdatabase.com/museums/view/32530",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Every year, Buckingham hosts the County Fair, Christmas Parade, and Apple Harvest Festival.",
      "sourceSentenceIds": [
