  "facts": [
    {
      "id": 1,
      "text": "Khlong Toei means 'the canal of pandan,' named for the pandan plants that grew along its southern bank.",
      "sourceSentenceIds": [
        20
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Khlong_Toei_district"
    },
    {
      "id": 2,
      "text": "Originally a canal‑based settlement from the Ayutthaya period, Khlong Toei later evolved into a major 20th‑century port.",
      "sourceSentenceIds": [
        3,
        15
      ],
      "sourceLabels": [
        "Web source 1",
        "Wikipedia"
      ],
      "source": "https://www.trawellino.com/destinations/thailand/bangkok_khlong-toei"
    },
    {
      "id": 3,
      "text": "In 1947, much of the Khlong Toei canal was filled to expand Rama IV Road, reshaping the district’s layout.",
      "sourceSentenceIds": [
        21
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Khlong_Toei_district"
    },
    {
      "id": 4,
      "text": "Khlong Toei Port, once Thailand’s sole major sea cargo hub, began construction in 1938 and finished after World War II.",
      "sourceSentenceIds": [
        24,
        25
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Khlong_Toei_district"
    },
    {
      "id": 5,
      "text": "The Khlong Toei Market, known for its bustling stalls, sits beside the historic canal and is a key local landmark.",
      "sourceSentenceIds": [
        16
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Khlong_Toei_district"
    },
    {
      "id": 6,
      "text": "The MRT Blue Line serves Khlong Toei with stations that connect the district to the rest of Bangkok, reflecting its modern transit history.",
      "sourceSentenceIds": [
        13,
