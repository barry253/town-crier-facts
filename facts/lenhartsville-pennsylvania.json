  "facts": [
    {
      "id": 1,
      "text": "Heinrich Lenhart founded Lenhartsville in the early 1800s on land once owned by his grandfather.",
      "sourceSentenceIds": [
        15
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Lenhartsville%2C_Pennsylvania"
    },
    {
      "id": 2,
      "text": "The borough incorporated in 1887 and grew along the historic Allentown State Road, now U.S. Route 22.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/lenhartsville_pennsylvania"
    },
    {
      "id": 3,
      "text": "The Washington Hotel opened in 1842, a post office followed in 1854, and the railroad arrived in 1874.",
      "sourceSentenceIds": [
        7,
        10
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/lenhartsville_pennsylvania"
    },
    {
      "id": 4,
      "text": "Lenhart Farm, an 18th‑century building, was added to the National Register of Historic Places in 1978.",
      "sourceSentenceIds": [
        3,
        8,
        5
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 2",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Lenhartsville%2C_Pennsylvania"
    },
    {
      "id": 5,
      "text": "Lenhartsville sits in the valley of Maiden Creek in northern Berks County at 40°34′24″N 75°53′12″W.",
      "sourceSentenceIds": [
        4,
        13
      ],
      "sourceLabels": [
        "Web source 1",
        "Wikipedia"
      ],
      "source": "https://lenhartsville.com/history-%26-about"
    },
    {
      "id": 6,
      "text": "The town hosts the Pennsylvania Dutch‑themed Deitsch Eck Restaurant, opened after a 1913 fire, and Hummel’s Dance Land, founded in 1946.",
