    },
    {
      "id": 2,
      "text": "The historic Haralson County Courthouse, built in 1891, sits at the corner of Bowden and Chestnut Streets in the county seat of Buchanan.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 2"
