  "facts": [
    {
      "id": 1,
      "text": "Wimbledon, ND was founded in 1892 and named after Wimbledon, London, reflecting the heritage of homesteader John Henry Gibson.",
      "sourceSentenceIds": [
        7,
        8
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Wimbledon%2C_North_Dakota",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The Midland Continental Railroad completed its line through Wimbledon in October 1913, turning the town into a four‑railroad hub for regional traffic.",
      "sourceSentenceIds": [
        12,
        24
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Wimbledon%2C_North_Dakota",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "When Wimbledon was founded, a well flooded the town, forcing the city to dynamite it in 1916 to stop the water surge.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Wimbledon%2C_North_Dakota",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "A church in Wimbledon began in 1931 as a union of Presbyterian, German Reformed, and Methodist congregations, later building a dedicated edifice.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Wimbledon%2C_North_Dakota",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Prairie View Cemetery, established in 1910, remains active today as the town’s oldest burial ground.",
      "sourceSentenceIds": [
        11
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
