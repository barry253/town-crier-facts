  "facts": [
    {
      "id": 1,
      "text": "Founded in 1640 by settlers from Newbury, Haverhill was originally called Pentucket, meaning 'place of the winding river'.",
      "sourceSentenceIds": [
        4,
        5,
        7
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Haverhill%2C_Massachusetts",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town was renamed Haverhill after the English town of Haverhill, Suffolk, honoring its first pastor's birthplace.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Haverhill%2C_Massachusetts",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Haverhill grew into a major industrial hub, beginning with sawmills and gristmills, later tanneries, boatyards, and shoe factories that ruled for 180 years.",
      "sourceSentenceIds": [
        23
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.haverhillma.gov/parks-recreation-culture/history-and-heritage/",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Winnekenni Castle, constructed in 1875 from stone quarried locally, remains a distinctive landmark in downtown Haverhill.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.haverhillchamber.com/explore-haverhill/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Haverhill residents were early abolitionists, and several historic homes served as stops on the Underground Railroad.",
      "sourceSentenceIds": [
        26
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
