  "facts": [
    {
      "id": 1,
      "text": "Shawnee Land once hosted a ski resort in the late 1960s, offering a 400‑foot vertical drop with one T‑bar and two rope tows.",
      "sourceSentenceIds": [
        17,
        10
      ],
      "sourceLabels": [
        "Web source 1",
        "Wikipedia"
      ],
      "source": "https://www.dcski.com/lostareas/viewlostprofile.php?id=25",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Investors abandoned the Shawnee Land ski project, leading to the closure of its slopes and the end of winter sports there.",
      "sourceSentenceIds": [
        2,
        26
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Shawnee_Land%2C_Virginia",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Today Shawnee Land is a residential community perched on Great North Mountain, rising from 850 feet to a 2,300‑foot summit ridge.",
      "sourceSentenceIds": [
        8,
        12
      ],
      "sourceLabels": [
        "Wikipedia",
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Shawnee_Land%2C_Virginia",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Marion worked at Shawnee Land from about 1957 to 1985, becoming the longest‑employed person in the community’s history.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.findglocal.com/US/Winchester/160625393970053/Shawneeland-Through-The-Ages",
      "category": "people",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The mountainside community drains eastward into Hogue Creek, which flows northeast to join Back Creek, a tributary of the Potomac River.",
      "sourceSentenceIds": [
        13
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Shawnee_Land%2C_Virginia",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Shawnee Land lies 10 miles west of Winchester and just 3 miles east of the West Virginia border, nestled on the eastern slopes of Great North Mountain.",
