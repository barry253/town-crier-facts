  "facts": [
    {
      "id": 1,
      "text": "Mexican War Streets earned its name from streets named after battles and generals of the Mexican–American War.",
      "sourceSentenceIds": [
        2,
        3
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Mexican_War_Streets",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The neighborhood stretches from Brighton Road to Federal Street and North Avenue to Jefferson Street, covering 27 acres listed on the National Register in 1975.",
      "sourceSentenceIds": [
        13,
        24,
        25
      ],
      "sourceLabels": [
        "Web source 1",
        "Wikipedia"
      ],
      "source": "https://www.mexicanwarstreets.org/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The Mexican War Streets Society, founded in 1969, preserves the district’s historic character while fostering community involvement.",
      "sourceSentenceIds": [
        5,
        7,
        12
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.mexicanwarstreets.org/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Victorian houses line the streets, showcasing 19th‑century architecture that once housed Pittsburgh’s wealthy families.",
      "sourceSentenceIds": [
        20,
        15
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Mexican_War_Streets",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The Mattress Factory, a contemporary art museum, sits nearby and draws artists worldwide, adding modern culture to the historic streets.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.visitpittsburgh.com/blog/pittsburghs-mexican-war-streets/",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The district’s boundaries were originally called the “Buena Vista Tract,” reflecting its early development during the Mexican–American War era.",
      "sourceSentenceIds": [
