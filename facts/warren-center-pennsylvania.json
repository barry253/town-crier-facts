  "facts": [
    {
      "id": 1,
      "text": "Warren Center takes its name from General Joseph Warren, fallen hero of Bunker Hill.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.bradfordcountypa.gov/241/Warren-Township",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Warren Township was formed in 1813, carved out of Orwell Township.",
      "sourceSentenceIds": [
        19
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.bradfordcountypa.gov/241/Warren-Township",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "William Arnold arrived in 1798, becoming the first settler in what is now Warren Township.",
      "sourceSentenceIds": [
        21
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.bradfordcountypa.gov/241/Warren-Township",
      "category": "people",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The township is crisscrossed by streams like Corbin Creek, Dewing Creek, and Pendleton Creek.",
      "sourceSentenceIds": [
        17
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.bradfordcountypa.gov/241/Warren-Township",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Warren Township borders New York to the north, Susquehanna County to the east, and Pike Township to the south.",
      "sourceSentenceIds": [
        16
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.bradfordcountypa.gov/241/Warren-Township",
