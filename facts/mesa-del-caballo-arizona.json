  "facts": [
    {
      "id": 1,
      "text": "Mesa del Caballo means “Tableland of the Horse,” a name that hints at flat‑topped hills and historic ranching in the area.",
      "sourceSentenceIds": [
        1,
        13
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.wisdomlib.org/cities/mesa-del-caballo-86258",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The community sits atop Houston Mesa, a low ridge north of Payson that rises above the surrounding desert.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Mesa_del_Caballo%2C_Arizona",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Nearby, the Mogollon Rim marks the southern edge of the Colorado Plateau, giving the region dramatic high‑desert scenery.",
      "sourceSentenceIds": [
        14
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.wisdomlib.org/cities/mesa-del-caballo-86258",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Old copper mines dot the landscape, and ghost towns nearby remind travelers of Arizona’s boom‑and‑bust mining past.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.wisdomlib.org/cities/mesa-del-caballo-86258",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The Beeline Bus, operated by the Payson Senior Center, links Mesa del Caballo to Payson every weekday for local commuters.",
      "sourceSentenceIds": [
        11
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Mesa_del_Caballo%2C_Arizona",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Weather here is arid, with hot summers, cool winters, and large daily temperature swings that shape the local way of life.",
