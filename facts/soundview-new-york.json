  "facts": [
    {
      "id": 1,
      "text": "Soundview’s name first appeared in early 20th century when developers branded the waterfront district with views toward the Long Island Sound.",
      "sourceSentenceIds": [
        13
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.cityneighborhoods.nyc/soundview",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The neighborhood sits on the Clason Point peninsula, bounded by the Cross Bronx Expressway, White Plains Road, Lacombe Avenue, and the Bronx River.",
      "sourceSentenceIds": [
        15,
        16
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Soundview%2C_Bronx",
      "category": "other",
      "quality": "poor",
      "qualityReason": "location_description"
    },
    {
      "id": 3,
      "text": "Soundview Park, built on a former landfill, is the largest park in the South Bronx and has been fully renovated with new trails and a boat launch.",
      "sourceSentenceIds": [
        29
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Soundview%2C_Bronx",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The Bronx River Houses Tenant Association in Soundview became a model for resident leadership, inspiring nearby community groups in the 1980s and 1990s.",
      "sourceSentenceIds": [
        14
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.cityneighborhoods.nyc/soundview",
      "category": "people",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "In 1947, NYCHA built a temporary housing project of 947 apartments in 473 Quonset huts in Soundview, a unique postwar solution.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Soundview%2C_Bronx",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The Sotomayor Houses honor former resident Supreme Court Justice Sonia Sotomayor, who lived there for 13 years starting in 1957.",
