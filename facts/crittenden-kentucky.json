      ],
      "source": "https://www.crittendencountyky.org/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Crittenden is a home rule-class city that spans Grant and Kenton counties, touching Boone County at its northern edge.",
      "sourceSentenceIds": [
