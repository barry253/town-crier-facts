      "quality": "poor",
      "qualityReason": "location_description"
    },
    {
      "id": 4,
      "text": "Within its boundaries, West Pensacola encompasses the neighborhood of Brownsville, adding to its local character.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
