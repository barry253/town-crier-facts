  "facts": [
    {
      "id": 1,
      "text": "Citrus City was founded in 1943 during World War II by builder Howard Moffitt, who envisioned a planned orange and grapefruit community.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Citrus_City%2C_Texas",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town’s name comes from its early 1900s role as a railroad stop for shipping citrus fruits, even though Texas isn’t a major citrus producer.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.trawellino.com/destinations/united-states/texas_citrus-city",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "A saline irrigation system proved too harsh for fruit, forcing planners to abandon the original large‑town citrus dream.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Citrus_City%2C_Texas",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Only a handful of Howard Moffitt‑style cottages survive today, offering a rare glimpse of the town’s original architectural vision.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Citrus_City%2C_Texas",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The community is part of the McAllen–Edinburg–Mission Metropolitan Statistical Area, linking it to a larger regional economy.",
      "sourceSentenceIds": [
