      "qualityReason": "location_description"
    },
    {
      "id": 3,
      "text": "The Dent County Courthouse, rebuilt in 1871, sits in Salem and is listed on the National Register of Historic Places.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.britannica.com/place/Salem-Missouri",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Salem hosts the Dent County Museum, the Ozark Natural & Cultural Resource Center, the Bonebrake Center of Nature and History, and a historic Downtown Walking Tour.",
