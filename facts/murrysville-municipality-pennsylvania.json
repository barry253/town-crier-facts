  "facts": [
    {
      "id": 1,
      "text": "Murrysville was founded in 1820 when Jeremiah Murry platted the town along the Northern Turnpike to serve travelers.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/Murrysville,_Pennsylvania"
    },
    {
      "id": 2,
      "text": "In 1878, brothers Michael and Obediah Haymaker drilled the first commercial natural gas well in the United States right in Murrysville.",
      "sourceSentenceIds": [
        27,
        30
      ],
      "sourceLabels": [
        "Web source 2",
        "Wikipedia"
      ],
      "source": "https://grokipedia.com/page/Murrysville,_Pennsylvania"
    },
    {
      "id": 3,
      "text": "The early gas boom sparked the Haymaker Riots, a violent clash over lease speculation that left a local speculator dead.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Murrysville%2C_Pennsylvania"
    },
    {
      "id": 4,
      "text": "A hillside Boy Scout project in 1933 carved a giant Murrysville tree sign, with the Y pointing toward the original Haymaker well.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Murrysville%2C_Pennsylvania"
    },
    {
      "id": 5,
      "text": "The Westmoreland Heritage Trail cuts through Murrysville, offering cyclists and walkers a scenic route along former railroad corridors.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Murrysville%2C_Pennsylvania"
    },
    {
