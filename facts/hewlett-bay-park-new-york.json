      "quality": "poor",
      "qualityReason": "vague"
    },
    {
      "id": 3,
      "text": "Homeowners with waterfront lots can add a boat dock or jet ski during the warm spring and summer months.",
      "sourceSentenceIds": [
        22
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://hewlettbayparkny.gov/",
