      ],
      "source": "https://en.wikipedia.org/wiki/Hewlett_Bay_Park%2C_New_York",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The village covers just 0.4 square miles, with each parcel at least one acre, creating a countryside feel and waterfront on Willow Pond that flows into Jamaica Bay.",
      "sourceSentenceIds": [
        20,
        21
      ],
      "sourceLabels": [
