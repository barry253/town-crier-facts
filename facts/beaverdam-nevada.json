  "facts": [
    {
      "id": 1,
      "text": "Beaverdam's roots stretch back a millennium, with Southern Paiute people calling the valley home long before settlers arrived.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/beaverdam_nevada",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Mormon pioneers from Panaca set up sparse ranching outposts around 1870, marking the first non‑native settlement in Beaverdam.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/beaverdam_nevada",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Beaverdam sits at about 4,600 feet, a high‑desert valley floor surrounded by modest uplands.",
      "sourceSentenceIds": [
        14
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/beaverdam_nevada",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Intermittent streams in Beaverdam converge into Meadow Valley Wash, a 110‑mile channel that eventually joins the Muddy River.",
      "sourceSentenceIds": [
        16
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/beaverdam_nevada",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "In the early 1900s, Beaverdam families raised cattle, hogs, and chickens while growing alfalfa and vegetables for local trade.",
      "sourceSentenceIds": [
        21
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/beaverdam_nevada",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "To the west, the Clover Mountains rise over 7,000 feet, shaping Beaverdam's microclimate while keeping the valley open.",
      "sourceSentenceIds": [
        15
      ],
      "sourceLabels": [
        "Web source 1"
      ],
