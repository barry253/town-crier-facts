  "facts": [
    {
      "id": 1,
      "text": "Founded in 1871 by grain farmer John Mitchell, Turlock began as a post office, depot, and grain warehouse.",
      "sourceSentenceIds": [
        3,
        6
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 2"
      ],
      "source": "https://en.wikipedia.org/wiki/Turlock%2C_California",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town’s name comes from the Irish word turlough, meaning “dry lake,” after the railroad turned it into a wheat shipping point.",
      "sourceSentenceIds": [
        13,
        19
      ],
      "sourceLabels": [
        "Web source 2",
        "Wikipedia"
      ],
      "source": "https://www.britannica.com/place/Turlock",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Turlock was incorporated as a city on February 15, 1908, after thriving as an agricultural hub that still dominates the region.",
      "sourceSentenceIds": [
        26,
        27
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Turlock%2C_California",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "California State University, Stanislaus, located in Turlock, makes the city a notable college town in the Central Valley.",
      "sourceSentenceIds": [
        17
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Turlock%2C_California",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "East of town, Turlock Lake State Recreation Area opens a gateway to historic sites in California’s Mother Lode Country.",
