  "facts": [
    {
      "id": 1,
      "text": "Loyal Heights takes its name from Loyal Graef Treat Nichols, the newborn daughter of founder Harry Whitney Treat, as recorded in the 1907 plat.",
      "sourceSentenceIds": [
        3,
        4,
        9
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 2"
      ],
      "source": "https://en.wikipedia.org/wiki/Loyal_Heights%2C_Seattle",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Harry Whitney Treat founded Loyal Heights in 1906, originally part of the independent city of Ballard before it merged with Seattle.",
      "sourceSentenceIds": [
        22
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Loyal_Heights%2C_Seattle",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "In 1907, Ballard—including Loyal Heights—was annexed into the city of Seattle, bringing the neighborhood under municipal governance.",
      "sourceSentenceIds": [
        23
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Loyal_Heights%2C_Seattle",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Shilshole Bay Marina showcases an impressive array of vessels, from small sailboats to large yachts, set against the Olympic Mountains.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://moversofseattle.net/things-to-do-and-places-to-visit-in-loyal-heights-seattle.html",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "At the Ballard Locks, drivers can observe boats passing through, watch salmon in the fish ladder, and explore historic gardens.",
