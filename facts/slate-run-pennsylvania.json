  "facts": [
    {
      "id": 1,
      "text": "Slate Run’s name comes from slate‑rich shale beds that inspired both the community and its 7.3‑mile tributary.",
      "sourceSentenceIds": [
        28
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/slate_run_pennsylvania",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "In 1794 Jacob Lamb paddled up the Susquehanna and Pine Creek in ten canoes, becoming the first permanent resident of Slate Run.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/slate_run_pennsylvania",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "By 1855 Slate Run boasted a post office, general store, hotel, and two churches, signaling a thriving 19th‑century village.",
      "sourceSentenceIds": [
        16
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Slate_Run%2C_Pennsylvania",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "A steam sawmill and a 16‑mile railroad spurred growth in the 1880s, but a June 1889 flood destroyed much of the infrastructure.",
