  "facts": [
    {
      "id": 1,
      "text": "Bridgehampton earned its name from a bridge built over Sagg Pond in 1686, linking Mecox and Sagaponack.",
      "sourceSentenceIds": [
        23,
        24
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Bridgehampton%2C_New_York",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The Beebe Windmill, erected in 1820, stands as one of Long Island’s best‑known surviving smock mills and a local landmark.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.longislandguide.com/visit/bridgehampton/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Bridgehampton Academy opened in 1859 on Ocean Road and became the Bridgehampton Literary and Commercial Institute in 1875.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/Bridgehampton,_New_York",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The Long Island Rail Road arrived in 1870, turning Bridgehampton into a summer retreat for affluent New Yorkers and sparking tennis, golf, and sailing clubs.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/Bridgehampton,_New_York",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The former Bridgehampton Race Circuit, once a road racing track, has been converted into a golf course and homes.",
      "sourceSentenceIds": [
        9
