      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "In 1887 the Fremont, Elkhorn & Missouri Valley Railroad bought 320 acres from Joseph Stockham and built a line to Hastings.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.plainsmanmuseum.org/stockham-history",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The original Stockham sat on the Blue River in Orville precinct, near the county’s first settlement.",
      "sourceSentenceIds": [
        24
      ],
      "sourceLabels": [
