  "facts": [
    {
      "id": 1,
      "text": "Rembrandtplein was renamed in 1876 to honor Rembrandt van Rijn, who lived nearby from 1639 to 1656.",
      "sourceSentenceIds": [
        4,
        20
      ],
      "sourceLabels": [
        "Web source 1",
        "Wikipedia"
      ],
      "source": "https://amsterdamtourism.net/rembrandtplein/"
    },
    {
      "id": 2,
      "text": "The square’s centerpiece is a bronze statue of Rembrandt by Louis Royer, erected in 1852 and moved to the center in 1876.",
      "sourceSentenceIds": [
        1,
        2
      ],
      "sourceLabels": [
        "Web source 2",
        "Wikipedia"
      ],
      "source": "https://amsterdamcitycard.com/rembrandtplein-amsterdam-read-this-before-your-visit/"
    },
    {
      "id": 3,
      "text": "Before becoming a square, the site was part of the Amstel River and later a butter market called Botermarkt in the 17th century.",
      "sourceSentenceIds": [
        7,
        24
      ],
      "sourceLabels": [
        "Web source 2",
        "Wikipedia"
      ],
      "source": "https://amsterdamcitycard.com/rembrandtplein-amsterdam-read-this-before-your-visit/"
    },
    {
      "id": 4,
      "text": "Tram lines 4, 9, and 14 have served Rembrandtplein since the early 20th century, linking it to Dam Square and Amsterdam Centraal.",
      "sourceSentenceIds": [
        18
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Rembrandtplein"
    },
    {
      "id": 5,
      "text": "In the early 1900s, the square evolved into a nightlife hub, drawing artists, young people, and laborers with cafés and entertainment venues.",
      "sourceSentenceIds": [
        27,
        28
      ],
