  "facts": [
    {
      "id": 1,
      "text": "Lake Stickney was once called Paine Field‑Lake Stickney until 2010, reflecting its early association with the nearby airfield.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Lake_Stickney%2C_Washington"
    },
    {
      "id": 2,
      "text": "The 25‑acre lake reaches a maximum depth of 34 feet, making it a modest but popular spot for calm boating.",
      "sourceSentenceIds": [
        20
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://snohomishcountywa.gov/5394/Stickney"
    },
    {
      "id": 3,
      "text": "A wetland borders the southern third of Lake Stickney, while the rest of the shoreline is mainly residential.",
      "sourceSentenceIds": [
        22
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://snohomishcountywa.gov/5394/Stickney"
    },
    {
      "id": 4,
      "text": "A public boat launch on the north shore lets visitors launch non‑gasoline‑powered boats, preserving the lake’s quiet character.",
      "sourceSentenceIds": [
        23,
        24
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://snohomishcountywa.gov/5394/Stickney"
    },
    {
      "id": 5,
      "text": "Since 1993, county staff and volunteers have tracked Lake Stickney’s health, publishing annual reports to keep the ecosystem thriving.",
