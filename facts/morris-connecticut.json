  "facts": [
    {
      "id": 1,
      "text": "Morris was named after Revolutionary War officer James Morris, a Yale graduate who helped found one of the nation’s first co‑educational schools.",
      "sourceSentenceIds": [
        6,
        7
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Morris%2C_Connecticut",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "During the Revolutionary War, Morris opened its homes to quarter Patriots traveling from other New England towns to battles in New York.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.morrishistoricalsocietyct.com/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The Morris Historical Society, founded in 1959, preserves the town’s heritage in the Old Town Hall Museum and the Mill School.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.morrishistoricalsocietyct.com/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Ethel Kirchberger donated the historic schoolhouse that now serves as the Mill School, one of six one‑room schools that once dotted the town.",
      "sourceSentenceIds": [
        3,
        23
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.morrishistoricalsocietyct.com/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Morris’s White Flower Farm, established in 1950, grew flowers and shrubs for national distribution while also raising beef cattle on its 300‑acre estate.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Morris%2C_Connecticut",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The town’s largest natural lake, Bantam Lake, covers roughly 947 acres and was originally called the Great Pond.",
