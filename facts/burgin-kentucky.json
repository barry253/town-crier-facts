  "facts": [
    {
      "id": 1,
      "text": "Burgin was originally called \"Cane Run\" after a local stream, and the name changed when the Cincinnati Southern Railway built a station there.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Burgin%2C_Kentucky",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town’s post office opened in 1877 as \"Bergen\" and adopted the name \"Burgin\" in 1886 to match the train station.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Burgin%2C_Kentucky",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Burgin sits at the headwaters of Cane Run, which flows eastward into the Dix River.",
      "sourceSentenceIds": [
        15
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Burgin%2C_Kentucky",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The climate features hot, humid summers and generally mild to cool winters, typical of central Kentucky.",
      "sourceSentenceIds": [
        16
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Burgin%2C_Kentucky",
      "category": "other",
      "quality": "poor",
      "qualityReason": "editorial_filler"
    },
    {
      "id": 5,
      "text": "Burgin became an incorporated city in 1878, just a year after its official founding in 1877.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Burgin%2C_Kentucky",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Burgin is served by Burgin Independent Schools, a local school district that keeps education close to home.",
