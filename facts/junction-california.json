  "facts": [
    {
      "id": 1,
      "text": "Junction City began as Milltown in the 1850s and was renamed in 1861 when it became the crossroads of Canyon Creek and Trinity River routes.",
      "sourceSentenceIds": [
        1,
        3,
        4
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1",
        "Web source 2"
      ],
      "source": "https://en.wikipedia.org/wiki/Junction_City%2C_California",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "In 1988, the Tibetan Buddhist temple Rigdzin Ling opened as part of the Chagdud Gonpa Foundation, adding a spiritual landmark to the town.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Junction_City%2C_California",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Many large hydraulic mines once operated near Junction City, and today a hydraulic monitor on display marks the town’s golden mining past.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://westernmininghistory.com/towns/california/junction-city/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Perched at 1,604 feet, Junction City overlooks the Trinity River, which flows northwest through the town’s landscape.",
      "sourceSentenceIds": [
        12,
        14
      ],
      "sourceLabels": [
        "Wikipedia",
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Junction_City%2C_California",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "State Route 299 slices through Junction City, forming part of the Trinity Scenic Byway, a National Forest Scenic Byway that winds through the region.",
      "sourceSentenceIds": [
        28,
        29
      ],
      "sourceLabels": [
        "Wikipedia",
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Junction_City%2C_California",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "A single historical marker in Junction City commemorates its centennial, celebrating 100 years of the town’s enduring legacy.",
