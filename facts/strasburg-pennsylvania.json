      "quality": "good"
    },
    {
      "id": 2,
      "text": "Strasburg earned the nickname “Train Town USA” thanks to the Strasburg Rail Road, the nation’s oldest short‑line railroad.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
