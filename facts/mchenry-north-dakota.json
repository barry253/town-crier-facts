  "facts": [
    {
      "id": 1,
      "text": "McHenry was founded in 1899, marking the start of a small North Dakota community.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/McHenry%2C_North_Dakota",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town is named after James McHenry, an early settler from Vermillion, South Dakota.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.mchenrycountynd.gov/about/",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "McHenry County was formed in 1873, carved out of Bottineau County by the territorial legislature.",
      "sourceSentenceIds": [
        29
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.mchenrycountynd.gov/about/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The first organized county government met on October 15, 1884, with Villard serving as the seat for a year.",
      "sourceSentenceIds": [
        30
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.mchenrycountynd.gov/about/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The McHenry County Historical Society & Museum preserves local history, owning landmarks like the 1843 Gannon Log Cabin and a mid‑century tourist cabin.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.mchenrycountyhistory.org/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The museum hosts events such as the annual Heritage Fair, a quilt raffle, and offers educational programs for learners of all ages.",
      "sourceSentenceIds": [
