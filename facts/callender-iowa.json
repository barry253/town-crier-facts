  "facts": [
    {
      "id": 1,
      "text": "Callender was renamed in 1875 after Agnes and James Callender of Brooklyn Heights, New York, who owned the land west of the railroad tracks.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Callender%2C_Iowa"
    },
    {
      "id": 2,
      "text": "In 1875, James and Agnes Callender bought the land that became Callender from Walter Carter, who had purchased it from the U.S. in 1858.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.cityofcallenderiowa.com/CityHistory.aspx"
    },
    {
      "id": 3,
      "text": "An agreement gave the town its name in return for the Callenders donating land for churches, the school, City Hall, and the town park.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.cityofcallenderiowa.com/CityHistory.aspx"
    },
    {
      "id": 4,
      "text": "The present town layout still reflects its 1875 design, preserving the donated church, school, City Hall, and park sites.",
