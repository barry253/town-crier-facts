  "facts": [
    {
      "id": 1,
      "text": "Canterbury was officially incorporated in 1703, named after Canterbury, England.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.ct.one/towns/canterbury"
    },
    {
      "id": 2,
      "text": "The town began as Peagscomsuck in the 1680s, settled by English colonists along the Quinebaug River.",
      "sourceSentenceIds": [
        16,
        23
      ],
      "sourceLabels": [
        "Web source 2",
        "Wikipedia"
      ],
      "source": "https://www.ct.one/towns/canterbury"
    },
    {
      "id": 3,
      "text": "The Winthrop brothers claimed the area in 1653 using a deed from the Nipmuc tribe, while Major Fitch claimed land from Mohegan sachem Owaneco.",
      "sourceSentenceIds": [
        1,
        5
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://canterburyhistorical.org/early-history-of-canterbury/"
    },
    {
      "id": 4,
      "text": "Canterbury hosts the historic Canterbury Female Boarding School, founded by Prudence Crandall in 1831, a pioneering institution for black girls.",
      "sourceSentenceIds": [
        8,
        15
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.ct.one/towns/canterbury"
    },
    {
      "id": 5,
      "text": "The Kent estate, founded by Major Fitch, was the sole settlement between Norwich and Woodstock, making it a rest stop for travelers.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 1"
      ],
