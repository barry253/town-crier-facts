  "facts": [
    {
      "id": 1,
      "text": "Old River is a tidal distributary of the San Joaquin River that flows about 40 miles through the Sacramento–San Joaquin Delta.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Old_River_(California)"
    },
    {
      "id": 2,
      "text": "The river once carried the main channel of the San Joaquin until late‑19th‑ and 20th‑century projects redirected it past Stockton.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Old_River_(California)"
    },
    {
      "id": 3,
      "text": "Old River diverges from the San Joaquin near Tracy, runs west to Mountain House, then north to rejoin 13 miles above Antioch.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Old_River_(California)"
    },
    {
      "id": 4,
      "text": "Levees line Old River, preventing flooding of Delta islands many of which lie below sea level.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Old_River_(California)"
    },
    {
      "id": 5,
      "text": "A pumping station east of Discovery Bay supplies fresh water to Los Vaqueros Reservoir via pipeline.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Old_River_(California)"
    },
    {
      "id": 6,
      "text": "Reverse flow from the Delta Cross Channel pulls water southward up Old River, confusing migrating salmon and helping drive their 20th‑century decline.",
      "sourceSentenceIds": [
        13,
        16
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Old_River_(California)"
    }
  ]
