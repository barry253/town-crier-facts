  "facts": [
    {
      "id": 1,
      "text": "Orange Blossom’s roots trace back to the Northern Valley Yokuts, who hunted, fished, and gathered along the Stanislaus River before European arrival.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/orange_blossom_california",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The community sits on Orange Blossom Road, just north of the Stanislaus River, marking the edge of the Central Valley’s agricultural heart.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Orange_Blossom%2C_California",
      "category": "nature",
      "quality": "good",
      "qualityReason": "location_description"
    },
    {
      "id": 3,
      "text": "Orange Blossom enjoys a Mediterranean climate, with scorching summer highs over 95°F and mild winters that rarely dip below 38°F.",
      "sourceSentenceIds": [
        18
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/orange_blossom_california",
      "category": "nature",
      "quality": "good",
      "qualityReason": "vague"
    },
    {
      "id": 4,
      "text": "Intensive farming in the area fuels elevated particulate matter and ozone, especially during harvest seasons when the San Joaquin Valley’s air quality drops.",
      "sourceSentenceIds": [
        22
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/orange_blossom_california",
      "category": "other",
      "quality": "poor",
      "qualityReason": "other"
    },
    {
      "id": 5,
      "text": "The rise of Oakdale’s Southern Pacific railroad in 1871 spurred Orange Blossom’s growth, turning it into a hub for timber, dairy, and orchard crops.",
