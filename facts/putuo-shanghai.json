  "facts": [
    {
      "id": 1,
      "text": "Putuo’s former flour mill, Fuxin, now hosts the “Babylon of Shanghai,” a leisure and art hub with four historic buildings.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://english.shanghai.gov.cn/en-CityTour/20250605/daf28cf549cd4daf891ee12f19cd63c4.html",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Zhonghua Book Company, founded by educator Lu Feikui in 1912, moved to No 477 Aomen Road in 1935, building five four‑story structures and a bungalow.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://english.shanghai.gov.cn/en-CityTour/20250605/daf28cf549cd4daf891ee12f19cd63c4.html",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The M50 Art Zone, named after 50 Moganshan Road, is a global creative hub born from a 1930s textile factory.",
      "sourceSentenceIds": [
        6,
        8
      ],
      "sourceLabels": [
        "Web source 2",
        "Web source 1"
      ],
      "source": "https://www.oohmyguide.com/shanghai/articles/18/putuo",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "M50 preserves 43,000 sq m of 1930s‑90s industrial buildings, including factories, warehouses, boiler rooms, and canteens, showcasing Shanghai’s textile heritage.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://english.shanghai.gov.cn/en-CityTour/20250605/daf28cf549cd4daf891ee12f19cd63c4.html",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "A tour of Putuo reveals its past and present, weaving history, innovation, nature, and art into every street and alley.",
      "sourceSentenceIds": [
        13
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://english.shanghai.gov.cn/en-CityTour/20250605/daf28cf549cd4daf891ee12f19cd63c4.html",
      "category": "other",
      "quality": "poor",
      "qualityReason": "editorial_filler"
    },
    {
      "id": 6,
      "text": "In 2009, the former Shanghai Central Mint was transformed into the China 1912 Cultural Creative Industry Park, blending heritage with modern creativity.",
      "sourceSentenceIds": [
        18
      ],
