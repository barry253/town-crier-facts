  "facts": [
    {
      "id": 1,
      "text": "Tiki Gardens sits just 10 miles from active Kīlauea, where lava flows enrich soil with minerals while volcanic smog can lower air quality.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/tiki_gardens_hawaii",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The area averages 75°F year‑round, with highs near 79°F and lows around 65°F, thanks to its 686‑foot elevation.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/tiki_gardens_hawaii",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Developed as a residential subdivision, Tiki Gardens offers fee‑simple lots and homes, some overlooking the distant Mauna Kea and Mauna Loa volcanoes.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/tiki_gardens_hawaii",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "At 686 feet above sea level, the community enjoys slightly cooler nights, aiding condensation that feeds its lush landscape.",
      "sourceSentenceIds": [
        10,
        17
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/tiki_gardens_hawaii",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "High humidity—often over 80%—and more than 100 inches of rain annually create frequent showers that keep the area verdant.",
      "sourceSentenceIds": [
        14,
        15
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/tiki_gardens_hawaii",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Flooding threatens 493 properties over the next 30 years, while occasional tropical storms add to the community’s natural hazard profile.",
