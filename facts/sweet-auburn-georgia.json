  "facts": [
    {
      "id": 1,
      "text": "Sweet Auburn was renamed from Wheat Street in 1893, marking the start of its rise as a Black business hub.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://historicblackwallstreet.com/sweet-auburn-avenue-atlanta-a-legacy-of-black-prosperity/",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "In 1956 Fortune magazine dubbed Sweet Auburn the richest Negro street in the world, a title coined by John Wesley Dobbs.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Sweet_Auburn",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The district earned National Historic Landmark status in 1976, protecting 19 acres of its historic African‑American heritage.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Sweet_Auburn",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Martin Luther King Jr.’s birth home at 501 Auburn Avenue now serves as an interpretive center for his legacy.",
      "sourceSentenceIds": [
        18
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://historicblackwallstreet.com/sweet-auburn-avenue-atlanta-a-legacy-of-black-prosperity/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Alonzo Herndon, a former slave, founded Atlanta Life Insurance in 1905 after building wealth as a barber.",
      "sourceSentenceIds": [
        26
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://historicblackwallstreet.com/sweet-auburn-avenue-atlanta-a-legacy-of-black-prosperity/",
      "category": "people",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The Heritage Festival, launched in 1984 by Hosea Williams, celebrates Sweet Auburn’s African‑American achievements each year.",
      "sourceSentenceIds": [
        28
      ],
      "sourceLabels": [
        "Web source 1"
      ],
