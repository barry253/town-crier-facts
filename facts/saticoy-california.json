  "facts": [
    {
      "id": 1,
      "text": "Saticoy’s name comes from the Spanish rendering of the Ventureño Chumash village Sa'aqtik'oy, meaning 'it is sheltered from the wind'.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Saticoy%2C_California",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The Chumash village of Saticoy once lay in what is now the eastern part of San Buenaventura, owned today by the Barbareño/Ventureño Band of Mission Indians.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.sbnature.org/visit/calendar/8863/the-chumash-village-of-saticoy-salvage-archaeology",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "A historic railroad depot marker stands in Saticoy, commemorating the town’s role on the Southern Pacific line.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Saticoy%2C_California",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "In September 1887, Saticoy’s streets and lots were laid out on both sides of the newly opened Southern Pacific Branch Line, creating the town’s original grid.",
      "sourceSentenceIds": [
        14
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Saticoy%2C_California",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The Saticoy Historical Society collection, spanning 1879‑2014, resides at the Museum of Ventura County and includes manuscripts, photographs, and newspaper clippings.",
      "sourceSentenceIds": [
        20,
        21
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://oac.cdlib.org/findaid/ark:/13030/c8q246fj/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The town’s one‑room library, a 700‑square‑foot wooden building used since 1973, was torn down in 1991 to make room for a new community center.",
