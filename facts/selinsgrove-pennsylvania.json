      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The borough’s name honors its founder, Anthony Selin, a Swiss soldier of fortune who led an independent corps for Washington in 1776.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 2"
