  "facts": [
    {
      "id": 1,
      "text": "Donegal was named after the Irish county of Donegal, reflecting the heritage of its early settlers.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Donegal%2C_Pennsylvania"
    },
    {
      "id": 2,
      "text": "The town’s roots trace back to the 1700s when Scots‑Irish immigrants began settling in the Susquehanna Valley.",
      "sourceSentenceIds": [
        30
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://donegalsociety.org/history/"
    },
    {
      "id": 3,
      "text": "Donegal Presbyterian Church, founded in 1791, stands as the community’s oldest landmark and a testament to its early religious life.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://donegalsociety.org/history/"
    },
    {
      "id": 4,
      "text": "In 1917 a commemorative marker was unveiled to honor the town’s first 30 years of growth and community spirit.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://donegalsociety.org/history/"
    },
    {
      "id": 5,
      "text": "The church’s 300‑year celebration in 2021 marked three centuries of faith and continuity for Donegal’s residents.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://donegalsociety.org/history/"
    },
    {
      "id": 6,
      "text": "The historic Study House sits above the Spring, offering a quiet view of the church’s original grounds.",
      "sourceSentenceIds": [
        5
