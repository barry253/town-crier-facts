    },
    {
      "id": 2,
      "text": "The community’s name follows a 19th‑century pattern of honoring local landowners, though the exact origin remains undocumented.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/mcclenney_tract_california"
    },
    {
      "id": 3,
      "text": "At 4,875 feet above sea level, McClenney Tract enjoys cooler temperatures than the surrounding valley.",
