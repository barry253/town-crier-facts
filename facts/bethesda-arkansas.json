  "facts": [
    {
      "id": 1,
      "text": "Bethesda’s name comes from the biblical Pool of Bethesda, symbolizing a house of mercy, and was officially adopted when the post office opened in 1888.",
      "sourceSentenceIds": [
        12,
        15
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/bethesda_arkansas",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Early settlers arrived in the 1840s by White River ferries and steamboats, establishing farms, grist mills, cotton gins, and sawmills by the late 19th century.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/bethesda_arkansas",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "On February 19, 1864, Confederate forces ambushed a Union foraging party at Waugh’s Farm, killing four Union soldiers and capturing thirty‑two.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/bethesda_arkansas",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The Union Pacific Railroad ran along the White River’s southern bank just below Bethesda, linking the town to regional trade in the late 1800s.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/bethesda_arkansas",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Since 1948, the Oran McBride Stone Company has quarried limestone, sandstone, and marble near Bethesda, supplying building materials for the region.",
      "sourceSentenceIds": [
        22
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/bethesda_arkansas",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Every summer, Bethesda hosts its annual Day Parade, a community celebration that showcases local traditions and brings residents together.",
      "sourceSentenceIds": [
