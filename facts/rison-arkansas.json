      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Rison%2C_Arkansas",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Locals affectionately call the town “Rison on the Cotton Belt,” a nod to its historic cotton production.",
      "sourceSentenceIds": [
        26
