      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Echo Canyon was a critical stop on the Hastings Cutoff Trail, where the Donner Party passed in 1846 and later 75,000 Mormon pioneers crossed between 1847 and 1869.",
      "sourceSentenceIds": [
        12,
        25
      ],
      "sourceLabels": [
