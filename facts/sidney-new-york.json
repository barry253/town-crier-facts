  "facts": [
    {
      "id": 1,
      "text": "Sidney was named on April 7, 1801, in honor of British naval officer Sir Sidney Smith, a hero of the American and French revolutionary wars.",
      "sourceSentenceIds": [
        4,
        5
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Sidney%2C_New_York",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town\u2019s early settlers were drawn to the confluence of the Unadilla and Susquehanna rivers, which offered both transportation routes and abundant food.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://townofsidneyny.gov/our-history/",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "In the 19th century, the Albany and Susquehanna Railroad and the Ontario and Western Railroad linked Sidney to regional markets, boosting local industry.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://townofsidneyny.gov/our-history/",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Sidney\u2019s historic museum, run by the Sidney Historical Association, houses artifacts from the town\u2019s industrial past, including a French cheese factory and a silk mill.",
      "sourceSentenceIds": [
        11,
        8
      ],
      "sourceLabels": [
        "Web source 2",
        "Web source 1"
      ],
      "source": "https://sidneyhistory.com/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The village of Sidney sits at the western end of the town along the Susquehanna River, marking the northern boundary with Otsego County.",
      "sourceSentenceIds": [
        16,
        15
      ],
      "sourceLabels": [
        "Wikipedia",
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Sidney%2C_New_York",
      "category": "other",
      "quality": "poor",
      "qualityReason": "location_description"
    },
    {
      "id": 6,
      "text": "The Sidney Historical Association\u2019s museum hosts seasonal programs, such as a 2026 exhibit on General Washington\u2019s Continental Army A-Team.",
