    },
    {
      "id": 2,
      "text": "Como sits in Hertford County, North Carolina, right in the state’s northeastern corner.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Como%2C_North_Carolina"
    },
    {
      "id": 3,
      "text": "The town lies in northern Hertford County, placing it near the North Carolina–Virginia border.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Como%2C_North_Carolina"
    },
    {
      "id": 4,
      "text": "U.S. Route 258 threads through Como, heading southwest to Murfreesboro and northeast to Franklin, Virginia.",
      "sourceSentenceIds": [
        6
