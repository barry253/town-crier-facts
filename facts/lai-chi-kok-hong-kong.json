    },
    {
      "id": 4,
      "text": "Lai Chi Kok Park, accessed via Mei Foo Station, offers a Chinese‑style garden, soccer pitch and a 200‑seat amphitheatre for community events.",
      "sourceSentenceIds": [
        14,
        15,
        16
      ],
      "sourceLabels": [
