      "qualityReason": "location_description"
    },
    {
      "id": 2,
      "text": "When Sacramento bought 19 acres south of Tahoe Elementary School in 1946, the new park was christened Tahoe Park in honor of the school.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
