    {
      "id": 1,
      "text": "Musselburgh is known as 'The Honest Toun' and hosts golf on a 9‑hole Links that sits inside a historic racecourse.",
      "sourceSentenceIds": [
        7,
        8
      ],
      "sourceLabels": [
        "Web source 2"
