  "facts": [
    {
      "id": 1,
      "text": "Musselburgh is known as 'The Honest Toun' and hosts golf on a 9‑hole Links that sits inside a historic racecourse.",
      "sourceSentenceIds": [
        7,
        8
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://visiteastlothian.org/things-to-see-do/towns-villages/musselburgh/",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town’s Roman bridge, built over the River Esk, still carries pedestrians today and dates back to the first fort established after 80 AD.",
      "sourceSentenceIds": [
        21,
        22,
        23,
        24,
        25,
        26
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Musselburgh",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Musselburgh survived a 1544 sacking by Henry VIII’s army, with only a few buildings, like the old bridge, remaining intact.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.undiscoveredscotland.co.uk/musselburgh/musselburgh/index.html",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Two railway stations serve Musselburgh: the western station opened in 1988 beside Queen Margaret University, and the eastern Wallyford station opened in 1994.",
      "sourceSentenceIds": [
        11,
        12,
        13,
        14
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Musselburgh",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Musselburgh was granted burgh of barony status around 1315 and later became a burgh of regality in 1562, reflecting its growing importance.",
      "sourceSentenceIds": [
        29
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Musselburgh",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The town’s name comes from Old English “mussel” for shellfish and “burgh” meaning fortified town, highlighting its coastal origins.",
      "sourceSentenceIds": [
        18,
        19
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Musselburgh",
