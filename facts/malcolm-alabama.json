  "facts": [
    {
      "id": 1,
      "text": "Malcolm sits near where the Alabama and Tombigbee Rivers merge, forming the Mobile River that feeds the expansive Mobile‑Tensaw Delta just south of the town.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/malcolm_alabama",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Before becoming Malcolm, the settlement was called Red Bud, a nod to the abundant eastern redbud trees that once dotted the local landscape.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/malcolm_alabama",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "In 1892, the community opened a post office and adopted the name Malcolm to honor early settler Malcolm McRae, cementing its identity.",
      "sourceSentenceIds": [
        24
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/malcolm_alabama",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Malcolm’s climate is humid subtropical, with scorching July highs around 91°F and mild January lows near 36°F, reflecting its Gulf of Mexico proximity.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/malcolm_alabama",
      "category": "other",
      "quality": "poor",
      "qualityReason": "vague"
    },
    {
      "id": 5,
      "text": "The area that is now Malcolm was first settled during Washington County’s pioneer era, shortly after Alabama achieved statehood on December 14, 1819.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/malcolm_alabama",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The Big John Baptist Church, organized in 1893, grew into a central community hub, using a conch shell as a makeshift bell before acquiring proper equipment.",
      "sourceSentenceIds": [
