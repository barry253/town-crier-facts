  "facts": [
    {
      "id": 1,
      "text": "St. George got its name from developer George Law, who traded land rights for the ferry terminal in exchange for Wiman’s promise to \"canonize\" him.",
      "sourceSentenceIds": [
        1,
        16
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/St._George%2C_Staten_Island",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The 1886 ferry–railroad terminal, later rebuilt in 1951, became the hub that linked St. George to Manhattan and Brooklyn.",
      "sourceSentenceIds": [
        5,
        19
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/St._George%2C_Staten_Island",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Richmond County Courthouse and the U.S. Coast Guard Station, both listed on the National Register in 1983, stand as St. George’s proud historic icons.",
      "sourceSentenceIds": [
        7,
        23
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/St._George%2C_Staten_Island",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Long before European settlers, the Munsee‑speaking Lenape people inhabited the area that is now St. George.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/St._George%2C_Staten_Island",
      "category": "people",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Since 2007, a wave of artists and musicians has moved to St. George’s North Shore, drawn by space and proximity to Manhattan.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/St._George%2C_Staten_Island",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The brick double house at 30‑32 Westervelt Avenue, built 1878‑82, showcases Romanesque Revival style and remains one of St. George’s oldest residences.",
