      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.blm.gov/visit/rock-house-visitor-center-and-recreation-area",
      "category": "other",
      "quality": "poor",
      "qualityReason": "location_description"
    },
    {
