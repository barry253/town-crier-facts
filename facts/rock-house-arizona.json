  "facts": [
    {
      "id": 1,
      "text": "Rock House sits in west‑central Gila County, in the Salt River valley just upstream of Theodore Roosevelt Lake.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Rock_House%2C_Arizona",
      "category": "other",
      "quality": "poor",
      "qualityReason": "location_description"
    },
    {
      "id": 2,
      "text": "The BLM‑run Rock House Visitor Center sits on the California side of the lower Colorado River, offering a boat launch and shaded benches.",
      "sourceSentenceIds": [
        5,
        6
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.blm.gov/visit/rock-house-visitor-center-and-recreation-area",
      "category": "landmark",
      "quality": "poor",
      "qualityReason": "editorial_filler"
    },
    {
      "id": 3,
      "text": "River‑front visitors can enjoy the site year‑round, thanks to the recreation area’s continuous access to the Colorado River.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.blm.gov/visit/rock-house-visitor-center-and-recreation-area",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "A winter BLM volunteer hosts the site, ready to help guests with questions or concerns during the colder months.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.blm.gov/visit/rock-house-visitor-center-and-recreation-area",
      "category": "other",
      "quality": "poor",
      "qualityReason": "other"
    },
    {
      "id": 5,
      "text": "To reach Rock House, drivers must cross Parker Dam onto the California side of the river, then turn left at the BLM sign about eight miles south of the dam.",
      "sourceSentenceIds": [
        12,
        13
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.blm.gov/visit/rock-house-visitor-center-and-recreation-area",
      "category": "other",
      "quality": "poor",
      "qualityReason": "location_description"
    },
    {
      "id": 6,
      "text": "The recreation area lies 14 miles ahead on the right after crossing the bridge over the Colorado River from Parker.",
