      ],
      "source": "https://en.wikipedia.org/wiki/Pembroke%2C_Massachusetts",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The Pembroke Historical Society hosts an annual Grand Old Fashioned Fish Fry to celebrate the local herring run, drawing community and music.",
      "sourceSentenceIds": [
        13
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
