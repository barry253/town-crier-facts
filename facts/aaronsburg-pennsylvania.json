  "facts": [
    {
      "id": 1,
      "text": "Aaronsburg was founded in 1786 by Aaron Levy, a Jewish immigrant from the Netherlands who plotted the town’s grid.",
      "sourceSentenceIds": [
        1,
        3
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Aaronsburg%2C_Centre_County%2C_Pennsylvania",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "It is the first town in Pennsylvania laid out by and named after a Jew.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Aaronsburg%2C_Centre_County%2C_Pennsylvania",
      "category": "people",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The 1949 Aaronsburg Story pageant drew over 30,000 attendees and featured speeches by Justice Felix Frankfurter and UN mediator Ralph Bunche.",
      "sourceSentenceIds": [
        19
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/aaronsburg_historic_district",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The historic district spans 99.7 acres, preserving the town’s original 1786 grid plan.",
      "sourceSentenceIds": [
        13
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/aaronsburg_historic_district",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Three churches—Salem Lutheran, Reformed, and United Brethren—stand on land donated by Levy, exemplifying the town’s interfaith heritage.",
      "sourceSentenceIds": [
