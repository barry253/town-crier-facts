  "facts": [
    {
      "id": 1,
      "text": "Valley Wells, originally called Rosalie, became a critical water stop for 1849 emigrants fleeing Death Valley.",
      "sourceSentenceIds": [
        6,
        12,
        30
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://unitedstatesghosttowns.com/valley-wells-california-ghost-town/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town earned California Historical Landmark #443 status in 1949 for its role in the 1849 Death Valley migration.",
      "sourceSentenceIds": [
        2,
        4,
        16,
        17
      ],
      "sourceLabels": [
        "Web source 1",
        "Wikipedia"
      ],
      "source": "https://unitedstatesghosttowns.com/valley-wells-california-ghost-town/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "From 1898 to 1918, Valley Wells hosted the Copper World Mine, complete with a 100‑ton blast furnace that turned the desert into an industrial hub.",
      "sourceSentenceIds": [
        28,
        21
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://unitedstatesghosttowns.com/valley-wells-california-ghost-town/",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The Yates Ranch, founded in 1894, ran cattle on the Mojave until 1952, showcasing desert ranching techniques.",
      "sourceSentenceIds": [
        27,
        22
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://unitedstatesghosttowns.com/valley-wells-california-ghost-town/",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Today, the Valley Wells Recreation Area, managed by the Searles Lake Gem and Mineral Society, sits on the historic site and offers a glimpse of the town’s past.",
      "sourceSentenceIds": [
        20
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Valley_Wells%2C_California",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Valley Wells sits 5.5 miles northeast of Trona, where pioneers first found the lake’s saline water unusable, prompting their escape toward safer routes.",
      "sourceSentenceIds": [
        30
      ],
