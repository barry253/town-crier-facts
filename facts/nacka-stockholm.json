      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The name Nacka comes from a 16th‑century Crown‑established water‑mill farmstead, a nod to its industrial roots.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Nacka",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Dieselverkstaden in Nacka doubles as a creative space and exhibition hall, showcasing twenty fresh murals that will make your jaw drop.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.visitstockholm.com/o/nacka/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Outdoor enthusiasts can hike Hellasgården and Velamsund’s nature reserves, classic spots that never go out of style.",
      "sourceSentenceIds": [
        30
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.visitstockholm.com/o/nacka/",
      "category": "nature",
      "quality": "good"
    },
    {
