      "category": "culture",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Architectural lovers will notice the designer hotel J at Nacka beach and the early‑20th‑century homes in nearby Saltsjöbaden.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 1"
      ],
