  "facts": [
    {
      "id": 1,
      "text": "South Carthage sits on the south bank of the Cumberland River, stretching from Goodall Island to the confluence with the Caney Fork.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.townofsouthcarthage.com/",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town’s early growth hinged on its role as a steamboat port where goods flowed downriver to Nashville.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Carthage%2C_Tennessee",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "In the 1800s, William Walton built the Walton Road, an early stagecoach route that linked Knoxville with Middle Tennessee.",
      "sourceSentenceIds": [
        14,
        15
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Carthage%2C_Tennessee",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "During the Civil War, Union General George Crook set up a base in South Carthage to counter Confederate guerrillas in East Tennessee.",
      "sourceSentenceIds": [
        22
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Carthage%2C_Tennessee",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "South Carthage is the hometown of guitarist George McCorkle, founding member of the Marshall Tucker Band.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Carthage%2C_Tennessee",
      "category": "people",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The town’s name, Carthage, was chosen when Walton’s community became the county seat of newly formed Smith County in 1804.",
      "sourceSentenceIds": [
        17
