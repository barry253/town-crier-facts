    },
    {
      "id": 2,
      "text": "The city’s downtown waterfront hosts a performing arts center, art galleries, and public parks that reflect its “soul” according to local descriptions.",
      "sourceSentenceIds": [
        19,
        14
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 2"
      ],
      "source": "https://en.wikipedia.org/wiki/Kirkland%2C_Washington"
    },
    {
      "id": 3,
      "text": "Kirkland was the original home of the Seattle Seahawks; their first ten seasons’ headquarters and training facility were at the Lake Washington Shipyard.",
      "sourceSentenceIds": [
        20
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Kirkland%2C_Washington"
    },
    {
      "id": 4,
      "text": "The video game company Valve was founded in Kirkland, making it a birthplace of a major tech firm.",
      "sourceSentenceIds": [
