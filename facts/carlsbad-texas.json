      "quality": "good"
    },
    {
      "id": 2,
      "text": "Residents renamed it Carlsbad after the Bohemian spa town when a post office required a new name, inspired by local mineral‑water wells.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
