    {
      "id": 1,
      "text": "Wahneta began as a railroad whistle stop in the 1920s, when the Atlantic Coast Line Railroad built a station amid orange groves.",
      "sourceSentenceIds": [
        6,
        5
      ],
      "sourceLabels": [
        "Web source 2"
      ],
