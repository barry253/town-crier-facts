      "id": 1,
      "text": "Como is known as the Home of Hill Country Blues, and its Main Street recording studio has hosted major rock, blues, and country performers.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 2"
      ],
