  "facts": [
    {
      "id": 1,
      "text": "Woodrow’s name, adopted in the 19th century, comes from Old English meaning “row of houses near the woods” and was formalized with a post office in 1882.",
      "sourceSentenceIds": [
        15
      ],
      "sourceLabels": [
