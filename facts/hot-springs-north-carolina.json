    {
      "id": 1,
      "text": "Hot Springs, North Carolina, has the only natural hot spring in the state, with waters at 108°F (42°C).",
      "sourceSentenceIds": [
        18
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
