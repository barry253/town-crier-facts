  "facts": [
    {
      "id": 1,
      "text": "Wimberley began as a trading post beside Cypress Creek in 1848, the same year Hays County was organized.",
      "sourceSentenceIds": [
        17
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Wimberley%2C_Texas",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town grew around a gristmill built by William Carvin Winters in 1856, later renamed after Pleasant Wimberley in 1874.",
      "sourceSentenceIds": [
        18,
        20
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Wimberley%2C_Texas",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Winters' home, the only surviving mill structure, earned Recorded Texas Historic Landmark status in 1990 and joined the National Register in 1992.",
      "sourceSentenceIds": [
        2,
        5
      ],
      "sourceLabels": [
        "Web source 2",
        "Wikipedia"
      ],
      "source": "https://wimberley.org/wimberley-history/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Wimberley Valley Museum, housed in the historic Square, showcases the city’s Native American and pioneer heritage.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Wimberley%2C_Texas",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The Blanco River, which flows through town, surged to 41.5 feet during the 2015 floods, nearly 30 feet above flood stage.",
      "sourceSentenceIds": [
        25,
        26
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Wimberley%2C_Texas",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Wimberley Square hosts a mix of boutiques, art galleries, antique shops, and eateries, making it the town’s cultural hub.",
      "sourceSentenceIds": [
        30
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
