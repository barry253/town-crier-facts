  "facts": [
    {
      "id": 1,
      "text": "Destrehan is named after Jean Noël Destréhan, twice president of the Orleans Territory's legislative council (1806, 1811).",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Destrehan%2C_Louisiana"
    },
    {
      "id": 2,
      "text": "The town's centerpiece, Destrehan Plantation, is Louisiana's oldest surviving plantation, built in 1787 along the Mississippi River.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://destrehan.com/"
    },
    {
      "id": 3,
      "text": "Destrehan Plantation was listed on the National Register of Historic Places, preserving its historic significance.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Destrehan%2C_Louisiana"
    },
    {
      "id": 4,
      "text": "The plantation house was restored in 1972 by the River Road Historical Society and now serves as a key attraction on the Great River Road.",
      "sourceSentenceIds": [
        19,
        27
      ],
      "sourceLabels": [
        "Web source 2",
        "Wikipedia"
      ],
      "source": "https://scphistory.org/destrehan-town-history/"
    },
    {
      "id": 5,
      "text": "Destrehan sits on the east bank of the Mississippi River, offering scenic views of the waterway.",
      "sourceSentenceIds": [
        23
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Destrehan%2C_Louisiana"
    },
    {
      "id": 6,
      "text": "The plantation served as a filming location for the 2013 movie 12 Years a Slave.",
