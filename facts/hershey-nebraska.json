  "facts": [
    {
      "id": 1,
      "text": "Hershey was founded in 1892 as a town on the Union Pacific Railroad's Overland Route.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.villageofhershey.com/"
    },
    {
      "id": 2,
      "text": "The town was formally platted in 1894 and named after local rancher J.H. Hershey.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.villageofhershey.com/history"
    },
    {
      "id": 3,
      "text": "Union Pacific tracks first ran through the area in 1866, but Hershey didn't organize until nearly thirty years later.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.villageofhershey.com/history"
    },
    {
      "id": 4,
      "text": "By 1910, Swedish settlers had poured into Hershey, most of them taking up farming.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Hershey%2C_Nebraska"
    },
    {
      "id": 5,
      "text": "Between 1900 and 1920, Hershey expanded rapidly, adding commercial attractions and social amenities that made it a regional economic hub.",
      "sourceSentenceIds": [
        25
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Hershey%2C_Nebraska"
    },
    {
      "id": 6,
      "text": "Parts of the historic Lincoln Highway still run through Hershey, preserved today as landmarks of early American road travel.",
      "sourceSentenceIds": [
        17
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.villageofhershey.com/history"
    }
  ]
