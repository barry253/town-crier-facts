  "facts": [
    {
      "id": 1,
      "text": "Wellsville is known as the oldest permanent settlement in Cache County, nestled at the base of the Wellsville Mountains.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.wellsvillecity.com/history/"
    },
    {
      "id": 2,
      "text": "Wellsville was laid out in 1856 and named after Daniel H. Wells, a leader in the LDS Church.",
      "sourceSentenceIds": [
        3,
        19
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Wellsville%2C_Utah"
    },
    {
      "id": 3,
      "text": "The Wellsville Mountains are considered a topographic curiosity because of their narrow base and unusual height.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.wellsvillecity.com/history/"
    },
    {
      "id": 4,
      "text": "Wellsville is home to the American Heritage Center, the Wellsville Tabernacle, and the Utah State University Equestrian Center.",
      "sourceSentenceIds": [
        18
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Wellsville%2C_Utah"
    },
    {
      "id": 5,
      "text": "The Wellsville Historic Preservation Commission once organized a historical tour to show the town as it existed in 1863.",
