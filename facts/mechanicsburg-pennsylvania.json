  "facts": [
    {
      "id": 1,
      "text": "Mechanicsburg was named after a settlement of mechanics who made and repaired Conestoga wagons in the early 19th century.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Mechanicsburg%2C_Pennsylvania",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "In 1837 the Cumberland Valley Railroad completed its line and Mechanicsburg became a water station where locomotives could restock firewood and water.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Mechanicsburg%2C_Pennsylvania",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The town’s historic downtown features the Irving Female College, the first women’s college in Pennsylvania to grant degrees in arts and sciences.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Mechanicsburg%2C_Pennsylvania",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Located eight miles west of Harrisburg, Mechanicsburg sits in the fertile Cumberland Valley between South Mountain and the Ridge‑and‑Valley Appalachians.",
