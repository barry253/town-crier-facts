  "facts": [
    {
      "id": 1,
      "text": "Ocosta began as the railroad boomtown Ocosta‑by‑the‑Sea, founded amid a dispute between Aberdeen, WA and the Northern Pacific Railroad.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Ocosta%2C_Washington",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town’s name comes from its proximity to the Pacific Ocean, a fact noted in its original designation as Ocosta‑by‑the‑Sea.",
      "sourceSentenceIds": [
        30
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Ocosta%2C_Washington",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "A 2009 thesis titled *Ocosta‑by‑the‑Sea: A Boomtown in Three Narratives* uses historic maps, advertisements, and financial records to chart the city’s imagined future.",
      "sourceSentenceIds": [
        8,
        9
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://digitalcommons.du.edu/etd/35/",
      "category": "other",
      "quality": "poor",
      "qualityReason": "editorial_filler"
    },
    {
      "id": 4,
      "text": "The same study also examines oral histories from the 1950s, a 2007 event, and interviews with residents in 2008 to capture how Ocosta is remembered.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://digitalcommons.du.edu/etd/35/",
      "category": "other",
      "quality": "poor",
      "qualityReason": "editorial_filler"
    },
    {
      "id": 5,
      "text": "The only Sanborn Fire Insurance Map of Ocosta dates to 1894, showing the town’s early downtown layout and labeled businesses.",
      "sourceSentenceIds": [
        5,
        18
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://hometownhistorymaps.com/pages/history-of-ocosta-washington",
