  "facts": [
    {
      "id": 1,
      "text": "West New Brighton was originally called Factoryville, a name that still echoes in local lore.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/West_New_Brighton%2C_Staten_Island",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The neighborhood grew around shipyards and small factories, giving it a steady industrial rhythm while nearby streets kept a suburban calm.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.cityneighborhoods.nyc/west-new-brighton",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "In 1872, the Staten Island Cricket Club founded its grounds at Walker Park, making West New Brighton home to the oldest continuously operating cricket club in the U.S.",
      "sourceSentenceIds": [
        3,
        26
      ],
      "sourceLabels": [
        "Web source 1",
        "Wikipedia"
      ],
      "source": "https://www.cityneighborhoods.nyc/west-new-brighton",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The first lawn tennis court in the United States was built here in 1873, right next to the cricket grounds.",
      "sourceSentenceIds": [
        28
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/West_New_Brighton%2C_Staten_Island",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "West New Brighton’s borders touch the Kill Van Kull to the north, placing it on Staten Island’s historic North Shore heart.",
      "sourceSentenceIds": [
        10,
        20
      ],
      "sourceLabels": [
        "Web source 1",
        "Wikipedia"
      ],
      "source": "https://www.cityneighborhoods.nyc/west-new-brighton",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The neighborhood’s library branch, located at 976 Castleton Avenue, serves as a cultural hub for residents.",
      "sourceSentenceIds": [
