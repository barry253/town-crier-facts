  "facts": [
    {
      "id": 1,
      "text": "Rockville once called \"Loom City\" and is on the National Register for its historic woolen industry role.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.rockvillepubliclibrary.org/books-more/special-collections/local-history/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town’s first water‑powered mill, the Rock Mill, was built on the Hockanum River by Samuel Grant in the 18th century.",
      "sourceSentenceIds": [
        11,
        12,
        29
      ],
      "sourceLabels": [
        "Web source 2",
        "Wikipedia"
      ],
      "source": "https://grokipedia.com/page/rockville_connecticut",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "In the mid‑1800s, Rockville’s mills produced everything from low‑quality shoddy fabrics to high‑end fancy goods that fed U.S. markets.",
      "sourceSentenceIds": [
        14
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/rockville_connecticut",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "By the late 19th century, the area boasted mill complexes, railroads, gasworks, and a steamboat‑friendly Snipsic Lake that hosted recreational boating.",
      "sourceSentenceIds": [
        25
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/rockville_connecticut",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Rockville merged with neighboring Vernon in 1965, ending its independent city status while keeping a borough government and a strong industrial heritage.",
      "sourceSentenceIds": [
        26
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/rockville_connecticut",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The Rockville Public Library’s Local History collection preserves records of the town’s mills, immigrant workers, and cultural institutions for researchers and visitors.",
      "sourceSentenceIds": [
