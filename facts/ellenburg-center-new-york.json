  "facts": [
    {
      "id": 1,
      "text": "Ellenburg takes its name from Ellen Murray, the eldest daughter of John and Harriet Murray, who settled the area in the early 1800s.",
      "sourceSentenceIds": [
        3,
        6
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Ellenburg%2C_New_York",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town was officially formed in 1830 from part of Mooers, and a year later it ceded land to create the town of Clinton.",
      "sourceSentenceIds": [
        17,
        18
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Ellenburg%2C_New_York",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "During the Cold War, two Atlas ICBM missile silos operated in Ellenburg from 1962 until 1965, a secretive chapter in the town’s history.",
      "sourceSentenceIds": [
        19,
        20
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Ellenburg%2C_New_York",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "In the 1860s, the Carter and Vestas starch factory moved to Ellenburg Corners, helping the hamlet grow into a local industrial hub.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.townofellenburgny.gov/history.html",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "By 1880, Ellenburg Corners boasted four churches, three stores, a hotel, a tannery, a starch factory, and a saw mill, reflecting a bustling rural community.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.townofellenburgny.gov/history.html",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "A wind farm proposal in 2004 led to the construction of 54 turbines in northern Ellenburg, completed in 2008 and now producing 81 megawatts of clean energy.",
