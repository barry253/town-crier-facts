  "facts": [
    {
      "id": 1,
      "text": "Prices Fork earned its name from the early German Price (Preisch) family whose land flanked both sides of the road.",
      "sourceSentenceIds": [
        2,
        16
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Prices_Fork%2C_Virginia",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The Price's Fork Historic District, listed on the National Register in 1991, centers on the 1871 James Bain Price House and a nearby store.",
      "sourceSentenceIds": [
        20,
        23
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.dhr.virginia.gov/historic-registers/060-0224/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "In 2014 the historic district expanded to include the 1950 Prices Fork Elementary School and two mid‑century houses, reflecting the town’s growth into the mid‑20th century.",
      "sourceSentenceIds": [
        28,
        29
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.dhr.virginia.gov/historic-registers/060-0224/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Prices Fork sits roughly three miles west of Blacksburg, placing it within the Blacksburg–Christiansburg metro area that covers all of Montgomery County.",
      "sourceSentenceIds": [
        9,
        10
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Prices_Fork%2C_Virginia",
      "category": "other",
      "quality": "poor",
      "qualityReason": "location_description"
    },
    {
      "id": 5,
      "text": "Prices Fork United Methodist Church and its Grange Hall have long been community gathering spots, while the former elementary school now hosts apartments, a brewery, and a kitchen.",
      "sourceSentenceIds": [
        11,
        13
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Prices_Fork%2C_Virginia",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "German immigrants arrived before 1745, establishing the Prices Fork–Tom's Creek area along the New River’s horseshoe bottoms, making the locale part of Virginia’s early German New River Settlement.",
      "sourceSentenceIds": [
        14,
        15
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Prices_Fork%2C_Virginia",
      "category": "history",
      "quality": "good"
    }
