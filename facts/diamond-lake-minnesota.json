  "facts": [
    {
      "id": 1,
      "text": "Diamond Lake’s name likely comes from the surrounding Diamond Lake Terrace Addition, a development that shaped the area in the 1970s.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.minneapolisparks.org/parks-destinations/parks-lakes/diamond_lake_park/"
    },
    {
      "id": 2,
      "text": "The first record of Diamond Lake in park board minutes dates back to December 19, 1923, when a land donation around the lake was proposed.",
      "sourceSentenceIds": [
        27
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.minneapolisparks.org/parks-destinations/parks-lakes/diamond_lake_park/"
    },
    {
      "id": 3,
      "text": "Clarke’s Diamond Lake Realty donated 16.4 acres in 1925, a move that helped secure the lake’s future as a public park.",
      "sourceSentenceIds": [
        29,
        30
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.minneapolisparks.org/parks-destinations/parks-lakes/diamond_lake_park/"
    },
    {
      "id": 4,
      "text": "In 1975, an 8.54‑acre donation completed the park board’s acquisition of the entire lake bed, finalizing the park’s boundaries.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.minneapolisparks.org/parks-destinations/parks-lakes/diamond_lake_park/"
    },
    {
      "id": 5,
      "text": "The shallow lake and its surrounding wetlands host a variety of aquatic life and serve as a refuge for migratory waterfowl year‑round.",
      "sourceSentenceIds": [
        24
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.minneapolisparks.org/parks-destinations/parks-lakes/diamond_lake_park/"
    },
    {
      "id": 6,
      "text": "Diamond Lake is monitored as part of the Minneapolis Park & Recreation Board’s lake water‑quality program, ensuring clean waters for visitors.",
      "sourceSentenceIds": [
        25
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.minneapolisparks.org/parks-destinations/parks-lakes/diamond_lake_park/"
    }
