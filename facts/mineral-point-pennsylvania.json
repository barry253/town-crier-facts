    {
      "id": 2,
      "text": "The village was wiped out in the Great Flood of 1889 when the South Fork Dam failed on May 31.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Mineral_Point%2C_Pennsylvania"
    },
    {
      "id": 3,
      "text": "Mineral Point was the second populated place, after South Fork, to be struck by the rapid waters of the former Lake Conemaugh.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Mineral_Point%2C_Pennsylvania"
    },
    {
      "id": 4,
      "text": "Before the flood, roughly 30 families called Mineral Point home.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Mineral_Point%2C_Pennsylvania"
    },
    {
      "id": 5,
      "text": "About 16 citizens of Mineral Point lost their lives in the 1889 disaster.",
      "sourceSentenceIds": [
        11
      ],
