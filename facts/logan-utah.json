  "facts": [
    {
      "id": 1,
      "text": "Logan takes its name from Ephraim Logan, an early fur trapper who helped pioneer the area.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Logan%2C_Utah",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Settlers sent by Brigham Young founded Logan in 1859, scouting a fort site along the Logan River.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Logan%2C_Utah",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Utah State University, founded in 1888 as the Agricultural College of Utah, now sits on Logan’s main campus.",
      "sourceSentenceIds": [
        1,
        16
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Logan%2C_Utah",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The Logan River carved through ancient glacial deposits, leaving steep slopes and a low‑lying bottomland that defines the city’s terrain.",
      "sourceSentenceIds": [
        22,
        23,
        24
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Logan%2C_Utah",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Logan’s Connect Transit offers zero‑fare bus rides, a legacy of the former Cache Valley Transit District.",
      "sourceSentenceIds": [
        13
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Logan%2C_Utah",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The Utah Festival Opera, founded and headquartered in Logan, brings world‑class opera to the western United States.",
