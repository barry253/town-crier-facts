  "facts": [
    {
      "id": 1,
      "text": "West Riverside got its name because it sits west of Milltown, at the confluence of the Blackfoot and Clark Fork rivers.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Bonner-West_Riverside%2C_Montana",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "A dam built in 1907‑08 at the confluence powered Missoula's streetcar, but it was removed in 2008 during a major Superfund cleanup.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://roamingmontana.com/bonner/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Bonner grew around a mill that ran continuously from 1886 to 2008, a 122‑year legacy.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://roamingmontana.com/bonner/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Bonner and partners in the Montana Improvement Company built a sawmill at the confluence that supplied lumber to the Northern Pacific Railroad and mining towns like Butte.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://roamingmontana.com/bonner/",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The confluence lies in a narrow canyon surrounded by Woody, Bonner, and University Mountains.",
      "sourceSentenceIds": [
        21
      ],
      "sourceLabels": [
