  "facts": [
    {
      "id": 1,
      "text": "Vandergrift was founded in 1895 by George McMurtry, who hired the Olmsted firm to create a model industrial town.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Vandergrift%2C_Pennsylvania",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Olmsted’s design blended social reform, comprehensive infrastructure, and private homeownership to give workers healthier, happier lives.",
      "sourceSentenceIds": [
        23
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Vandergrift%2C_Pennsylvania",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The Victorian Vandergrift Museum & Historical Society, founded in 1990, preserves the town’s unique industrial heritage.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://westmorelandheritage.org/portfolio-item/victorian-vandergrift-museum-historical-society/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The Casino Theater, built in 1905, still hosts live performances and houses the local library.",
      "sourceSentenceIds": [
        15
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://westmorelandheritage.org/portfolio-item/victorian-vandergrift-museum-historical-society/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Exterior scenes for the 2011 film I Am Number Four were shot in Vandergrift, standing in for Paradise, Ohio.",
      "sourceSentenceIds": [
        11
      ],
      "sourceLabels": [
