  "facts": [
    {
      "id": 1,
      "text": "Founded in 1907 after Alex Ranson’s mineral discovery, Empire grew into a bustling gypsum mining town.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://unitedstatesghosttowns.com/empire-nevada-ghost-town/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Empire once boasted a nine‑hole golf course, an Olympic‑sized pool, and tennis courts, a rare luxury for a mining community.",
      "sourceSentenceIds": [
        26
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://unitedstatesghosttowns.com/empire-nevada-ghost-town/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The 2020 film Nomadland was partly shot in Empire, spotlighting the town’s decline after its gypsum plant closed.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Empire%2C_Nevada",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "In 2016, the Empire Mining Company revived the town, reopening the mine and restoring a store and gas station for residents.",
      "sourceSentenceIds": [
        28,
        29,
        30
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Empire%2C_Nevada",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Back in 1855, Dutch Nick Ambrose turned his 160‑acre claim into the first hotel and saloon that would become Empire’s early waystation.",
      "sourceSentenceIds": [
