  "facts": [
    {
      "id": 1,
      "text": "Isabela was officially founded on May 21, 1819, by Spanish settlers led by Narciso de Meléndez y Molina.",
      "sourceSentenceIds": [
        27,
        7
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/Isabela,_Puerto_Rico",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town’s name honors Queen Isabella I of Castile, linking it to Spain’s historic monarchy.",
      "sourceSentenceIds": [
        2,
        6
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 2"
      ],
      "source": "https://en.wikipedia.org/wiki/Isabela%2C_Puerto_Rico",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The coat of arms features two fighting cocks, a nod to Isabela’s long‑standing cockfighting tradition.",
      "sourceSentenceIds": [
        20
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/Isabela,_Puerto_Rico",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Isabela’s coastline stretches about 21 kilometers, with sandy beaches that shift under tropical storms.",
      "sourceSentenceIds": [
        29
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/Isabela,_Puerto_Rico",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The Taíno chief Mabodamaca once ruled the Guajataca region, the area that later became Isabela.",
      "sourceSentenceIds": [
        3,
        1
      ],
      "sourceLabels": [
        "Wikipedia",
