  "facts": [
    {
      "id": 1,
      "text": "Winslow was founded in 1882 and named after Edward F. Winslow, a railroad official.",
      "sourceSentenceIds": [
        1,
        7
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Winslow%2C_Arizona"
    },
    {
      "id": 2,
      "text": "Winslow sits on historic Route 66, now Interstate 40, and is famous for the song \"Take It Easy\" by the Eagles.",
      "sourceSentenceIds": [
        4,
        16
      ],
      "sourceLabels": [
        "Web source 1",
        "Web source 2"
      ],
      "source": "https://www.visitwinslow.com/"
    },
    {
      "id": 3,
      "text": "La Posada Hotel, still operating, is a historic landmark that guests can stay in while exploring the town.",
      "sourceSentenceIds": [
        6,
        15
      ],
      "sourceLabels": [
        "Web source 1",
        "Web source 2"
      ],
      "source": "https://www.visitwinslow.com/"
    },
    {
      "id": 4,
      "text": "The Winslow Visitors Center occupies the former Hubbell Trading Post, offering a glimpse into regional trade history.",
      "sourceSentenceIds": [
        21
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://smalltowntravelguide.com/usa/az/winslow/"
    },
    {
      "id": 5,
      "text": "Meteor Crater, a massive impact structure, lies just west of Winslow and is a popular nearby natural attraction.",
      "sourceSentenceIds": [
        23
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://smalltowntravelguide.com/usa/az/winslow/"
    },
    {
      "id": 6,
      "text": "The town hosts an annual car show on Old Route 66 that has drawn classic car enthusiasts for three decades.",
