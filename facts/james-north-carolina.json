  "facts": [
    {
      "id": 1,
      "text": "James City earned its name in 1865 when the Trent River Settlement was renamed after Union chaplain Horace James, a Freedmen\u2019s Bureau agent.",
      "sourceSentenceIds": [
        1,
        2,
        3
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1",
        "Web source 2"
      ],
      "source": "https://en.wikipedia.org/wiki/James_City%2C_North_Carolina",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "In 1863, the Union Army set up the Trent River Settlement to house freed slaves, forming the seed of James City.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://northcarolinahistory.org/encyclopedia/james-city/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Jones Chapel AME Zion Church and the James City Historical Society preserve the town\u2019s heritage, while early schools and hospitals were founded by the Freedmen\u2019s Bureau and missionaries.",
      "sourceSentenceIds": [
        5,
        8,
        9
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://northcarolinahistory.org/encyclopedia/james-city/",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "James City sits on the west bank of the tidal Neuse River, just across the Trent River from New Bern, the county seat.",
      "sourceSentenceIds": [
        18,
        19
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/James_City%2C_North_Carolina",
      "category": "other",
      "quality": "poor",
      "qualityReason": "location_description"
    },
    {
      "id": 5,
      "text": "Today, James City faces flooding, water quality issues, and the impacts of animal agriculture, echoing long\u2011standing environmental struggles.",
      "sourceSentenceIds": [
        11
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.ncpedia.org/james-city",
      "category": "other",
      "quality": "poor",
      "qualityReason": "other"
    },
    {
      "id": 6,
      "text": "By 1867 the Freedmen\u2019s Bureau stepped back, letting original landowners reclaim full ownership of the former settlement.",
      "sourceSentenceIds": [
        7
      ],
