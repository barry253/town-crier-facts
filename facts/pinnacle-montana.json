  "facts": [
    {
      "id": 1,
      "text": "Pinnacle, originally called Paola, sprang up as a Great Northern Railway station where railroad workers, lumbermen, and US Forest Service employees lived.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.mtmemory.org/nodes/view/128449"
    },
    {
      "id": 2,
      "text": "The town sits 3,711 feet above sea level, roughly half a mile higher than the surrounding valley.",
      "sourceSentenceIds": [
        19
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://roadsidethoughts.com/mt/pinnacle-xx-flathead-profile.htm"
    },
    {
      "id": 3,
      "text": "Pinnacle borders Glacier National Park to the east across the Middle Fork Flathead River and lies within Flathead National Forest to the west.",
      "sourceSentenceIds": [
        13
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Pinnacle%2C_Montana"
    },
    {
      "id": 4,
      "text": "Despite its name, no records explain why the settlement was called Pinnacle; the origin remains unknown.",
      "sourceSentenceIds": [
        14
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.mtmemory.org/nodes/view/128449"
    },
    {
      "id": 5,
      "text": "Pinnacle lies 6 miles north of Essex and 20 miles southeast of West Glacier, placing it in the heart of Montana’s scenic Flathead Valley.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Wikipedia"
