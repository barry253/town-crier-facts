      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town sits 3,711 feet above sea level, roughly half a mile higher than the surrounding valley.",
      "sourceSentenceIds": [
        19
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://roadsidethoughts.com/mt/pinnacle-xx-flathead-profile.htm",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Pinnacle borders Glacier National Park to the east across the Middle Fork Flathead River and lies within Flathead National Forest to the west.",
      "sourceSentenceIds": [
