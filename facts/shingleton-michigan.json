  "facts": [
    {
      "id": 1,
      "text": "Shingleton began as a 1882 railroad stop called Jeromeville, named for Michigan governor David H.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Munising_Township%2C_Michigan",
      "category": "history",
      "quality": "poor",
      "qualityReason": "unverified=['jerome']"
    },
    {
      "id": 2,
      "text": "In 1887 the post office was renamed Shingleton after the local shingle mill that powered the town’s early economy.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Munising_Township%2C_Michigan",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The town’s timber heritage lives on in the old shingle shacks still standing along the highway, some now homes.",
      "sourceSentenceIds": [
        13
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://99wfmk.com/shingleton-michigan/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Today the Michigan Department of Natural Resources runs the Cusino Wildlife Research Station & Field Office right in Shingleton.",
      "sourceSentenceIds": [
        20
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Munising_Township%2C_Michigan",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Shingleton’s past as a logging hub echoes in the quiet, rustic feel that still defines the community.",
