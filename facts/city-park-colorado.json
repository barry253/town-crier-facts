  "facts": [
    {
      "id": 1,
      "text": "Denver City Park was designed in the late 19th century as part of the City Beautiful movement, aiming to bring monumental grandeur to the city.",
      "sourceSentenceIds": [
        20
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://denverpoi.com/denver-city-park/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The park hosts the Denver Zoo and the Denver Museum of Nature & Science, making it a hub for family outings.",
      "sourceSentenceIds": [
        19
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://denverpoi.com/denver-city-park/",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Two large constructed recreational lakes with historic fountains sit at the park's center, surrounded by multi‑use pavilions and islands.",
      "sourceSentenceIds": [
        25
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.tclf.org/landscapes/city-park-denver",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "A statue of Robert Burns, the Scottish poet, stands in the park, reflecting Denver’s early cultural aspirations.",
      "sourceSentenceIds": [
        21
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://denverpoi.com/denver-city-park/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Denver City Park earned official landmark status, preserving its historic character for future generations.",
      "sourceSentenceIds": [
        22
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://denverpoi.com/denver-city-park/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The Denver Museum of Natural History, established in 1901, sits on a hill in the park, offering scenic vistas.",
