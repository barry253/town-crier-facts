  "facts": [
    {
      "id": 1,
      "text": "Carlisle was founded in 1816 when John Kincart donated land to relocate the county seat from Ellisville, 5 miles north.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Carlisle%2C_Kentucky"
    },
    {
      "id": 2,
      "text": "Carlisle sits at the junction of Kentucky Route 32 and Kentucky Route 36, halfway between Lexington and Maysville.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Carlisle%2C_Kentucky"
    },
    {
      "id": 3,
      "text": "Historic downtown Main Street showcases 19th‑ and 20th‑century architecture that feels like stepping back in time.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.carlisle-nicholascounty.org/"
    },
    {
      "id": 4,
      "text": "Carlisle is home to the Daniel Boone Cabin, the pioneer’s last Kentucky residence from 1795 to 1799.",
      "sourceSentenceIds": [
        13,
        14
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Carlisle%2C_Kentucky"
    },
    {
      "id": 5,
      "text": "A wildlife park near Carlisle shelters animals from around the world, offering a unique glimpse of global fauna.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
