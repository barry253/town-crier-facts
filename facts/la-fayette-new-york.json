  "facts": [
    {
      "id": 1,
      "text": "La Fayette, New York, takes its name from the Marquis de Lafayette, a celebrated hero of both the French and American revolutions.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/LaFayette%2C_New_York",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town was officially organized on April 15 1825, carved from parts of Pompey and Onondaga after Lafayette’s 1824‑25 tour of the United States.",
      "sourceSentenceIds": [
        13
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/LaFayette%2C_New_York",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Every year, La Fayette hosts an Apple Festival on the Saturday and Sunday before Columbus Day, drawing visitors to local orchards.",
      "sourceSentenceIds": [
        14
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/LaFayette%2C_New_York",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Today, four apple orchards dot the town’s landscape, a legacy of its long‑standing apple‑growing tradition.",
      "sourceSentenceIds": [
        15
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/LaFayette%2C_New_York",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "La Fayette sits within the former Central New York Military Tract and partly occupies land once reserved for the Onondaga tribe.",
      "sourceSentenceIds": [
        10
