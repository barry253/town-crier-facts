  "facts": [
    {
      "id": 1,
      "text": "Zap was founded in 1913 along a branch line of the Northern Pacific Railway that began in Mandan.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Zap%2C_North_Dakota"
    },
    {
      "id": 2,
      "text": "He was aware of a coal‑mining town in Scotland named Zapp and decided to name the community after the Scottish town.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.usacitiesonline.com/ndcountyzap.htm"
    },
    {
      "id": 3,
      "text": "The town of Zap is probably most widely known for the Zip to Zap riot, which occurred on May 10, 1969.",
      "sourceSentenceIds": [
        22
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Zap%2C_North_Dakota"
    },
    {
      "id": 4,
      "text": "The Zip to Zap was originally intended as a spring break diversion.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Zap%2C_North_Dakota"
    },
    {
      "id": 5,
      "text": "Between 2,000 and 3,000 people descended upon Zap after Chuck Stroup’s article in the NDSU Spectrum drew busloads and planes from across the U.S.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Zap%2C_North_Dakota"
    },
    {
      "id": 6,
      "text": "Zap is located in the prairie country along Spring Creek, a tributary of the Knife River.",
      "sourceSentenceIds": [
        27
