  "facts": [
    {
      "id": 1,
      "text": "Spring Creek Colony was founded in 1961 as a daughter colony of the Maxwell Hutterite Colony near Scotland, South Dakota.",
      "sourceSentenceIds": [
        1,
        9
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/spring_creek_colony_south_dakota"
    },
    {
      "id": 2,
      "text": "Spring Creek Colony embodies the communal Anabaptist tradition of shared property, pacifism, and agrarian self-sufficiency.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/spring_creek_colony_south_dakota"
    },
    {
      "id": 3,
      "text": "The Hutterites of Spring Creek Colony belong to the Schmiedeleut Group 2 branch, tracing their origins to sixteenth-century European Anabaptists.",
      "sourceSentenceIds": [
        10,
        27
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/spring_creek_colony_south_dakota"
    },
    {
      "id": 4,
      "text": "Spring Creek Colony is situated near a key tributary that drains westward into the Oahe Reservoir on the Missouri River.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/spring_creek_colony_south_dakota"
    },
    {
      "id": 5,
      "text": "Deep, fertile silty loam soils support the prairie environment and communal farming practices central to life at Spring Creek Colony.",
      "sourceSentenceIds": [
        26,
        28
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/spring_creek_colony_south_dakota"
    },
    {
      "id": 6,
      "text": "Spring Creek Colony Elementary School provides education for the children of the community in a rural setting.",
