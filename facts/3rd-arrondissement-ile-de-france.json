    {
      "id": 2,
      "text": "The 4th arrondissement of Paris is one of the twenty arrondissements of Paris, the capital city of France.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
