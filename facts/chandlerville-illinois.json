      ],
      "source": "https://nearbylens.com/cities/usa/il/chandlerville/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The Old Chandler House, built in the mid‑19th century, once belonged to the town’s founder and stands as a rare example of period architecture.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 2"
