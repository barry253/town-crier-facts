  "facts": [
    {
      "id": 1,
      "text": "Cullman was founded in 1873 by Colonel John G. Cullmann, a German immigrant who negotiated land for a colony of German settlers.",
      "sourceSentenceIds": [
        3,
        11
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Cullman%2C_Alabama",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town’s name was Americanized to “Cullman” with one “n” when it incorporated in 1874.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Cullman%2C_Alabama",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Cullman is known for its German roots, walkable downtown, lively festivals, scenic lakes, and small‑town warmth.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://visitcullman.com/plan-your-trip/learn-about-cullman/",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The Cullman County Museum, located in downtown, showcases local history with exhibits on a former governor, military relics, and vintage children’s toys.",
      "sourceSentenceIds": [
        17
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://cullmancountymuseum.com/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Cullman’s public television station, CCTV55, is run by students at Cullman High School, giving the town a unique media presence.",
      "sourceSentenceIds": [
        21
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Cullman%2C_Alabama",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Cullman sits along Interstate 65, about 50 miles north of Birmingham and 55 miles south of Huntsville, placing it between two major Alabama cities.",
