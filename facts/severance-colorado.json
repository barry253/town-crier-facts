  "facts": [
    {
      "id": 1,
      "text": "Severance, Colorado, takes its name from pioneer settler David Severance, whose early 19‑century homestead helped seed the area.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Severance%2C_Colorado",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Bruce Eaton, son of former Colorado governor Benjamin Eaton, founded Severance in 1906, and the town incorporated in 1920 with a 40‑to‑0 vote.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.townofseverance.org/244/History-of-the-Town-of-Severance",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Early 1900s, Severance promoted sugar beet farming to spur a Windsor factory, leading to the Great Western Sugar Company’s 1905 opening.",
      "sourceSentenceIds": [
        7,
        8,
        16
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 2"
      ],
      "source": "https://en.wikipedia.org/wiki/Severance%2C_Colorado",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Severance served as a sugar‑beet receiving station and rail dump on the Great Western Railway until the line closed in 1985.",
      "sourceSentenceIds": [
        15
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.townofseverance.org/244/History-of-the-Town-of-Severance",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "In December 2018, nine‑year‑old Dane Best petitioned town officials to lift a long‑standing snowball‑fight ban, a move that won local headlines.",
