  "facts": [
    {
      "id": 1,
      "text": "On December 6, 1846, the Battle of San Pasqual erupted when Mexican‑American forces clashed with Californio lancers in a valley near present‑day Escondido.",
      "sourceSentenceIds": [
        26,
        13
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Battle_of_San_Pasqual",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The battlefield is now a 50‑acre state historic park that preserves the site where General Stephen Kearny’s exhausted army was shattered by 9‑foot lances.",
      "sourceSentenceIds": [
        20,
        13
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.americasstateparks.org/state-park/san-pasqual-battlefield-state-historic-park/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Kit Carson’s midnight ride to San Pasqual brought much‑needed reinforcements, but the American troops still suffered 18 dead in the cold rain.",
      "sourceSentenceIds": [
        20
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.americasstateparks.org/state-park/san-pasqual-battlefield-state-historic-park/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Mule Hill, a small rise on the battlefield, became the focal point of the siege where American soldiers dug in against relentless Californio charges.",
      "sourceSentenceIds": [
        20
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.americasstateparks.org/state-park/san-pasqual-battlefield-state-historic-park/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The park’s visitor center hosts a monument and interpretive displays that honor both sides of the conflict and the Kumeyaay people who originally inhabited the valley.",
      "sourceSentenceIds": [
        20
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.americasstateparks.org/state-park/san-pasqual-battlefield-state-historic-park/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "San Pasqual’s name, meaning “San Pascual,” reflects its early Spanish heritage and the enduring influence of the Kumeyaay culture in the region.",
      "sourceSentenceIds": [
        26
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Battle_of_San_Pasqual",
      "category": "etymology",
      "quality": "good"
    }
