  "facts": [
    {
      "id": 1,
      "text": "Edgewood sprang in the early 1930s when southern Santa Fe County landowners founded the town.",
      "sourceSentenceIds": [
        1,
        2
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Edgewood%2C_New_Mexico"
    },
    {
      "id": 2,
      "text": "The town’s name comes from its position on the edge where Sandia foothill woods meet high‑desert grasslands.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.theroute-66.com/edgewood.html"
    },
    {
      "id": 3,
      "text": "Edgewood once sat on US 470, a short‑lived spur that linked the historic Route 66 corridor to the town.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.theroute-66.com/edgewood.html"
    },
    {
      "id": 4,
      "text": "During the Route 66 boom, diners and service stations sprang up to serve the steady stream of travelers.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.theroute-66.com/edgewood.html"
    },
    {
      "id": 5,
      "text": "Town limits form a checkerboard pattern because Edgewood avoided annexing properties owners didn’t want inside the town.",
      "sourceSentenceIds": [
        20
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Edgewood%2C_New_Mexico"
    },
    {
      "id": 6,
      "text": "Although in Santa Fe County, Edgewood sits closer to Albuquerque than to Santa Fe itself.",
      "sourceSentenceIds": [
