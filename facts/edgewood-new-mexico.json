      "id": 1,
      "text": "Edgewood sprang in the early 1930s when southern Santa Fe County landowners founded the town.",
      "sourceSentenceIds": [
        1,
        2
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
