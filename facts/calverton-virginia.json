  "facts": [
    {
      "id": 1,
      "text": "Calverton may have been named after Calvert County, Maryland, in the 19th century.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Calverton%2C_Virginia",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The village arose circa 1852 as a rural hub on a spur of the Orange and Alexandria Railroad.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.dhr.virginia.gov/historic-registers/030-5165/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Historically called Warrenton Junction, Calverton served local farms as a commercial and social center.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.dhr.virginia.gov/historic-registers/030-5165/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The Calverton Historic District, listed on the National Register in 2010, contains 69 contributing buildings and two structures.",
      "sourceSentenceIds": [
        6,
        23
      ],
      "sourceLabels": [
        "Web source 2",
        "Web source 1"
      ],
      "source": "https://maps.roadtrippers.com/us/calverton-va/points-of-interest/calverton-historic-district",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Notable buildings include a large farmstead, multiple dwellings, a Wesleyan Methodist Church, and a former high school now apartments.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://maps.roadtrippers.com/us/calverton-va/points-of-interest/calverton-historic-district",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Owl Run flows through Calverton, feeding Cedar Run and ultimately the Potomac River.",
      "sourceSentenceIds": [
