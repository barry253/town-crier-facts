  "facts": [
    {
      "id": 1,
      "text": "Cokato sprang to life in 1869 when the First Division of the St. Paul & Pacific Railroad extended its tracks through the area.",
      "sourceSentenceIds": [
        7,
        11,
        17
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 2"
      ],
      "source": "https://en.wikipedia.org/wiki/Cokato%2C_Minnesota"
    },
    {
      "id": 2,
      "text": "The town’s name comes from the Dakota word co‑ka‑ta, meaning “in the midst” or “in the middle” of the prairie.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.cokatomuseum.org/cokato-history.html"
    },
    {
      "id": 3,
      "text": "Cokato’s local history museum chronicles the lives of residents and the surrounding townships in southwest Wright County.",
      "sourceSentenceIds": [
        12,
        2
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Cokato%2C_Minnesota"
    },
    {
      "id": 4,
      "text": "The Gust Akerlund Photography Studio, a National Register landmark, showcases original early‑1900s cameras and a 12‑foot skylight.",
      "sourceSentenceIds": [
        16
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.cokatomuseum.org/"
    },
    {
      "id": 5,
      "text": "By the early 1900s, Cokato’s agriculture shifted from small farms to industry, spurred by a new corn‑canning factory and creamery.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.cokatomuseum.org/cokato-history.html"
    },
    {
      "id": 6,
      "text": "Cokato was incorporated as a village in 1878, solidifying its municipal status after nearly a decade of growth.",
