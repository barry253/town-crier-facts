    {
      "id": 1,
      "text": "Haviland sits in Blue Creek Township, Paulding County, Ohio, a quiet village that feels like a forgotten chapter of history.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 2"
      ],
