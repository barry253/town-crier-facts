      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The old 19th‑century military post near Haviland now serves as a popular photo spot, echoing cannon sounds to curious visitors.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://poi-travel.de/us/city/810-Haviland-Paulding-Ohio.html",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "A short cat jump from Haviland leads to the Paulding County Historical Museum, where local history comes alive.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://poi-travel.de/us/city/810-Haviland-Paulding-Ohio.html",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Haviland’s waterfront features a bridge that locals love, but anglers and tractor drivers often crowd the field on Saturday nights.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://poi-travel.de/us/city/810-Haviland-Paulding-Ohio.html",
