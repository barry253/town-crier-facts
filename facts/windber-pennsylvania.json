      "id": 1,
      "text": "Windber was founded in 1897 by the Berwinds, a coal‑industry family who turned a mining site into a bustling town.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
