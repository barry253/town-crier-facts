      ],
      "source": "https://genealogytrails.com/iowa/franklin/town_info.htm",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "A Congregational church, founded by a local woman who donated a bell, stands as Chapin’s historic religious center.",
      "sourceSentenceIds": [
        28,
