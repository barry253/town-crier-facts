      "id": 1,
      "text": "Chapin was platted in 1858 by Josiah Bushnell Grinnell, who also founded nearby Grinnell, Iowa.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
