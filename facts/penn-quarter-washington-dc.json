  "facts": [
    {
      "id": 1,
      "text": "Penn Quarter sits north of Pennsylvania Avenue, once the heart of Old Downtown, now a cultural hub with museums and theaters.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Penn_Quarter"
    },
    {
      "id": 2,
      "text": "The 1990s revitalization turned silent streets into a living gallery where neoclassical architecture meets contemporary art.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://brainbound.blog/penn-quarter-dc-guide"
    },
    {
      "id": 3,
      "text": "The National Portrait Gallery and Smithsonian American Art Museum sit side‑by‑side, offering free public access to America’s artistic legacy.",
      "sourceSentenceIds": [
        18
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://brainbound.blog/penn-quarter-dc-guide"
    },
    {
      "id": 4,
      "text": "Clara Barton opened the American Red Cross here, and the neighborhood still hosts the Clara Barton Missing Soldiers Office Museum.",
      "sourceSentenceIds": [
        4,
        11
      ],
      "sourceLabels": [
        "Web source 2",
        "Web source 1"
      ],
      "source": "https://brainbound.blog/penn-quarter-dc-guide"
    },
    {
      "id": 5,
      "text": "Capital One Arena, home to the Washington Capitals and Wizards, turns Penn Quarter into a raucous sports hub on game nights.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://washington.org/visit-dc/things-see-do-penn-quarter-chinatown-neighborhood"
    },
    {
      "id": 6,
      "text": "A Victorian Temperance Fountain, erected by a booze‑hating dentist in the 1880s, still marks the cobblestone streets of Penn Quarter.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://washington.org/visit-dc/things-see-do-penn-quarter-chinatown-neighborhood"
