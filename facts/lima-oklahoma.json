  "facts": [
    {
      "id": 1,
      "text": "Lima is one of thirteen remaining historically all-Black towns in Oklahoma, founded for mutual protection and economic self-sufficiency.",
      "sourceSentenceIds": [
        3,
        18
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 2"
      ],
      "source": "https://en.wikipedia.org/wiki/Lima%2C_Oklahoma"
    },
    {
      "id": 2,
      "text": "The town of Lima takes its name from the local limestone quarries that provided economic opportunities starting around 1904.",
      "sourceSentenceIds": [
        2,
        14
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 2"
      ],
      "source": "https://en.wikipedia.org/wiki/Lima%2C_Oklahoma"
    },
    {
      "id": 3,
      "text": "Lima was incorporated in 1913 along the Chicago, Rock Island and Pacific Railroad to facilitate the transport of quarried stone.",
      "sourceSentenceIds": [
        19,
        28
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 2"
      ],
      "source": "https://en.wikipedia.org/wiki/Lima%2C_Oklahoma"
    },
    {
      "id": 4,
      "text": "The community established the Lima Observer newspaper in 1914 to support its early civic infrastructure.",
      "sourceSentenceIds": [
        11,
        13
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 2"
      ],
      "source": "https://en.wikipedia.org/wiki/Lima%2C_Oklahoma"
    },
    {
      "id": 5,
      "text": "Built with help from the Rosenwald Fund in 1921, Rosenwald Hall in Lima is listed on the National Register of Historic Places.",
      "sourceSentenceIds": [
        22,
        26
      ],
      "sourceLabels": [
        "Web source 1",
        "Web source 2"
      ],
      "source": "https://www.okhistory.org/publications/enc/entry?entry=LI003"
    },
    {
      "id": 6,
      "text": "White residents who arrived for the 1926 oil boom created a separate eastern village called New Lima to maintain racial separation.",
      "sourceSentenceIds": [
        1,
        17
      ],
