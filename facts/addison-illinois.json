      "quality": "good"
    },
    {
      "id": 2,
      "text": "The Balzer House, once a family home on East Lake Street, now anchors the Addison Historical Museum complex.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://addisonadvantage.org/visitors/history/index.php",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The Century House, built in 1893 as a teachers’ home for the Lutheran School, was restored to its original condition and now houses part of the museum.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://addisonadvantage.org/visitors/history/index.php",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "In 1999 the original Addison Township Office coach house was moved beside the Century House to become part of the museum’s permanent home.",
      "sourceSentenceIds": [
        14
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://addisonadvantage.org/visitors/history/index.php",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The Addison Historical Museum complex showcases a collection of historic buildings that together paint a comprehensive picture of life in Addison throughout the centuries.",
      "sourceSentenceIds": [
        20
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.wonderfulmuseums.com/museum/addison-historical-museum/",
      "category": "landmark",
      "quality": "good"
    },
    {
