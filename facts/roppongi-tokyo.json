  "facts": [
    {
      "id": 1,
      "text": "Roppongi’s name, coined around 1660, literally means “six trees” in Japanese.",
      "sourceSentenceIds": [
        13
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Roppongi",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "After WWII, U.S. Army occupation turned Roppongi into a hub for foreign nightlife.",
      "sourceSentenceIds": [
        17
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Roppongi",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Roppongi Hills, opened in the early 2000s, blends luxury shops, corporate HQs, and the Mori Art Museum into one mini‑city.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.gotokyo.org/en/story/walks-and-tours/roppongi/index.html",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The Roppongi Art Triangle, centered on Tokyo Midtown and Roppongi Hills, is a hotspot for art, shopping, and nightlife.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.japan.travel/en/spot/2176/",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Roppongi Station connects to the Hibiya, Oedo, and Namboku subway lines, making it a key transit node.",
      "sourceSentenceIds": [
        7,
        8
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.japan.travel/en/spot/2176/",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Minato City Library runs Azabu Library in Roppongi, offering a quiet spot amid the city buzz.",
