  "facts": [
    {
      "id": 1,
      "text": "Essex, Montana was named after the English county and began as a small town on the Great Northern Railway’s main line in 1890.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.mtmemory.org/nodes/view/127696",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Historically, Essex supplied coal and water to steam trains and hosted helper units that pushed freight over Marias Pass.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Essex%2C_Montana",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Amtrak’s Empire Builder stops at Essex station, with westbound trains arriving at 7:41 pm and eastbound at 8:55 am.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Essex%2C_Montana",
      "category": "transport",
      "quality": "poor",
      "qualityReason": "route_only"
    },
    {
      "id": 4,
      "text": "In 1939, the Great Northern built the Izaak Walton Inn as a hostelry for work crews, costing $40,000.",
      "sourceSentenceIds": [
        15
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.mtmemory.org/nodes/view/127696",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Essex hosts the Glacier‑Waterton hamfest, the world’s oldest continually running amateur radio event, since 1934 each July weekend.",
      "sourceSentenceIds": [
