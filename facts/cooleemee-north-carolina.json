  "facts": [
    {
      "id": 1,
      "text": "Cooleemee was built as a cotton mill town and still preserves its heritage with over three hundred historic mill cottages.",
      "sourceSentenceIds": [
        2,
        20
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.cooleemee.org/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The Zachary House, once the mill manager’s home, now serves as the Textile Heritage Museum and opens tours Tuesdays at 1 p.m.",
      "sourceSentenceIds": [
        4,
        30
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://discoverdaviecounty.com/visit-cooleemee/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Cooleemee’s RiverPark spans thirty acres along the South Yadkin River, offering wooded walking trails, a sandy beach, and rock‑racing waters.",
      "sourceSentenceIds": [
        25,
        26
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.cooleemee.org/",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The town’s historic district and the Foard‑Tatum House earned spots on the National Register of Historic Places.",
      "sourceSentenceIds": [
        11
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Cooleemee%2C_North_Carolina",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Cooleemee’s community spirit grew after the mill closed in 1967, with residents staying on to form the town we know today.",
      "sourceSentenceIds": [
        28
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://discoverdaviecounty.com/visit-cooleemee/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The town’s name, pronounced “KOO-lə-mee,” reflects its roots in the local textile industry and the Yadkin River’s influence.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
