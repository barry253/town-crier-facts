  "facts": [
    {
      "id": 1,
      "text": "Łódź received city rights on July 15 1423 from King Władysław Jagiełło, marking its official founding.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://uml.lodz.pl/en/dla-mieszkancow/history-and-tradition/"
    },
    {
      "id": 2,
      "text": "In the 19th century, Łódź became a dynamic international industrial city as weaving settlers were encouraged by local authorities.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://uml.lodz.pl/en/dla-mieszkancow/history-and-tradition/"
    },
    {
      "id": 3,
      "text": "The city’s name comes from the Polish word for “lodge” or “hut,” first mentioned at the end of the 13th century.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://uml.lodz.pl/en/dla-mieszkancow/history-and-tradition/"
    },
    {
      "id": 4,
      "text": "Łódź hosts the National Film School, a world‑renowned institution that produced directors like Roman Polanski and Krzysztof Kieślowski.",
      "sourceSentenceIds": [
        14
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/%C5%81%C3%B3d%C5%BA_Voivodeship"
    },
    {
      "id": 5,
      "text": "After decades of decline, Łódź’s historic downtown is undergoing a rebirth with new investments echoing its industrial roots.",
      "sourceSentenceIds": [
        10,
        11
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://uml.lodz.pl/en/dla-mieszkancow/history-and-tradition/"
    },
    {
      "id": 6,
      "text": "The province borders six voivodeships, including Masovian to the north and east, making Łódź a crossroads of Polish regions.",
      "sourceSentenceIds": [
        17
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
