  "facts": [
    {
      "id": 1,
      "text": "Lakeshore was originally called Fedhaven, a retirement enclave for former federal employees founded in the 1960s before becoming Lakeshore.",
      "sourceSentenceIds": [
        1,
        2
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Lakeshore%2C_Florida"
    },
    {
      "id": 2,
      "text": "The community sits on the Ortega River, just 7 miles southwest of downtown Jacksonville, a spot once shaped by early 20th‑century housing booms.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://jaxtoday.org/2024/08/21/the-jaxson-the-history-of-jacksonvilles-lakeshore-neighborhood/"
    },
    {
      "id": 3,
      "text": "During World War II, Naval Air Station Jacksonville nearby trained over 10,000 pilots and 11,000 airmen, a fact that helped shape the area’s growth.",
      "sourceSentenceIds": [
        11,
        12
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://jaxtoday.org/2024/08/21/the-jaxson-the-history-of-jacksonvilles-lakeshore-neighborhood/"
    },
    {
      "id": 4,
      "text": "The north side of the Ortega River hosts Marina Mile, a historic waterfront that once housed the Huckins Yacht Corp., founded in 1928.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://jaxtoday.org/2024/08/21/the-jaxson-the-history-of-jacksonvilles-lakeshore-neighborhood/"
    },
    {
      "id": 5,
      "text": "Spanish Mission‑style gates and a central boulevard with a linear median park give Lakeshore a Mediterranean‑inspired feel that dates back to the Florida Land Boom.",
      "sourceSentenceIds": [
        13
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://jaxtoday.org/2024/08/21/the-jaxson-the-history-of-jacksonvilles-lakeshore-neighborhood/"
    },
    {
      "id": 6,
      "text": "In 2004, three hurricanes struck Lakeshore, causing significant damage that reshaped the community’s infrastructure and resilience plans.",
      "sourceSentenceIds": [
        16
      ],
