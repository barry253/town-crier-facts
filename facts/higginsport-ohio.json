  "facts": [
    {
      "id": 1,
      "text": "Colonel Robert Higgins founded Higginsport in 1804, naming it White Haven after surveying 1,000 acres granted for his Revolutionary War service.",
      "sourceSentenceIds": [
        1,
        3,
        14,
        15
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Higginsport%2C_Ohio",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "On February 28, 1816, Higgins replatted the town into 114 lots and renamed it Higginsport.",
      "sourceSentenceIds": [
        2,
        4
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Higginsport%2C_Ohio",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "White burley tobacco first grew near Higginsport in 1864, and by the 1880s the village shipped about 2 million pounds annually down the Ohio River.",
      "sourceSentenceIds": [
        23,
        24,
        25
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Higginsport%2C_Ohio",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Higginsport sits on the Ohio River, just downstream of White Oak Creek’s mouth in southeastern Lewis Township.",
      "sourceSentenceIds": [
        13,
        27
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Higginsport%2C_Ohio",
      "category": "other",
      "quality": "poor",
      "qualityReason": "location_description"
    },
    {
      "id": 5,
      "text": "The village’s first brick house appeared in 1835, built by store owner Jesse Dugan.",
