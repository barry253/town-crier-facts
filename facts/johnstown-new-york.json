      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The city earned the nickname “Glove Cities” alongside neighboring Gloversville, dominating global glove production for nearly a century.",
      "sourceSentenceIds": [
        8,
        28
      ],
      "sourceLabels": [
        "Wikipedia",
