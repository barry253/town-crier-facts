      ],
      "source": "https://en.wikipedia.org/wiki/Johnstown%2C_New_York",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Johnstown sits 45 miles northwest of Albany, nestled in the Mohawk Valley near the Adirondack foothills.",
      "sourceSentenceIds": [
        25
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Johnstown%2C_New_York",
      "category": "other",
      "quality": "poor",
      "qualityReason": "location_description"
    },
    {
      "id": 4,
      "text": "Fulton-Montgomery Community College, part of SUNY, opened in 1963 and remains the county’s flagship higher‑education institution.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.britannica.com/place/Johnstown-New-York",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Sir William Johnson’s 1763 home, Johnson Hall, was built for the colonial administrator and now serves as a preserved historic site.",
      "sourceSentenceIds": [
        21
      ],
      "sourceLabels": [
