  "facts": [
    {
      "id": 1,
      "text": "False Pass earned its name because the Bering Sea side of the strait is so shallow that large vessels cannot pass.",
      "sourceSentenceIds": [
        3,
        7
      ],
      "sourceLabels": [
        "Web source 2",
        "Wikipedia"
      ],
      "source": "https://unangaxheritage.org/community/false-pass",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The area was originally settled by a homesteader in the early 1900s, and grew with the establishment of a cannery in 1917.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://unangaxheritage.org/community/false-pass",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "A salmon cannery built on the Unimak Island side of the strait in 1919 became the nucleus of the modern settlement.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/False_Pass%2C_Alaska",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Boats and aircraft are the only ways to reach False Pass, as no road connects it to the rest of Alaska.",
      "sourceSentenceIds": [
        14
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/False_Pass%2C_Alaska",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Commercial fishing for salmon, cod, halibut and crab remains the core of False Pass’s lifestyle and economy.",
      "sourceSentenceIds": [
        10
