      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Its name means 'three rivers' because the Saint‑Maurice splits into three channels at its mouth.",
      "sourceSentenceIds": [
        4,
        27
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
