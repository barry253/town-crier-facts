  "facts": [
    {
      "id": 1,
      "text": "Bynum is an unincorporated community on the banks of the Haw River, founded as a cotton mill town in 1872.",
      "sourceSentenceIds": [
        12,
        22
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Bynum%2C_North_Carolina",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The original mill powered by a wooden dam and water wheels, later upgraded with concrete and generators.",
      "sourceSentenceIds": [
        23,
        24
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Bynum%2C_North_Carolina",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The Bynum General Store, once Harris and Farrell, remains the town’s historic social hub and hosts Friday music series.",
      "sourceSentenceIds": [
        15,
        18,
        20
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Bynum%2C_North_Carolina",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "In the 1970s county bought 73 mill worker houses with HUD grant, preserving the worker housing heritage.",
      "sourceSentenceIds": [
        30
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Bynum%2C_North_Carolina",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Bynum’s bridge over the Haw River was originally a covered wooden bridge, now a National Register site.",
      "sourceSentenceIds": [
        5,
        7
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Bynum%2C_North_Carolina",
      "category": "landmark",
      "quality": "good"
    },
    {
