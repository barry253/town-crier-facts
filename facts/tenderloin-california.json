  "facts": [
    {
      "id": 1,
      "text": "The Tenderloin’s history as a center of alternate sexualities dates back to the early 20th century, with several historic confrontations with police.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Tenderloin%2C_San_Francisco",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "In 1917, San Francisco’s golden age of vice unfolded here, with gambling dens, speakeasies, bordellos, and a historic sex‑worker protest.",
      "sourceSentenceIds": [
        5,
        29
      ],
      "sourceLabels": [
        "Web source 2",
        "Web source 1"
      ],
      "source": "https://visittenderloin.com/about",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The neighborhood’s Little Saigon, a two‑block Vietnamese enclave on Larkin Street, was officially named by the city in 1987.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Tenderloin%2C_San_Francisco",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The Black Hawk jazz club, once at Hyde and Turk Streets, hosted legends like Miles Davis and Thelonious Monk in the 1950s.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Tenderloin%2C_San_Francisco",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The Tenderloin Museum celebrates the area’s misunderstood past, hosting walking tours, artist exhibitions, and events like the 1966 Compton’s Cafeteria Riot reenactment.",
      "sourceSentenceIds": [
        26,
        28
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.tenderloinmuseum.org/",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "A historic drag bar, Aunt Charlie’s, remains one of the few surviving LGBTQ venues in the Tenderloin’s long‑standing queer community.",
