  "facts": [
    {
      "id": 1,
      "text": "Platter was originally established in the late 19th century as the settlement of Finch in Indian Territory.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/platter_oklahoma"
    },
    {
      "id": 2,
      "text": "The community was renamed Platter around 1901 in honor of A.F. Platter, a businessman from Denison, Texas.",
      "sourceSentenceIds": [
        8,
        14
      ],
      "sourceLabels": [
        "Web source 1",
        "Wikipedia"
      ],
      "source": "https://grokipedia.com/page/platter_oklahoma"
    },
    {
      "id": 3,
      "text": "Platter is an unincorporated community in Bryan County situated along the Red River and adjacent to Lake Texoma.",
      "sourceSentenceIds": [
        21
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/platter_oklahoma"
    },
    {
      "id": 4,
      "text": "Early settlers in Platter lived in a lawless frontier environment characterized by gambling, feuds, and self-reliant armed residents.",
      "sourceSentenceIds": [
        22
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/platter_oklahoma"
    },
    {
      "id": 5,
      "text": "In the early 20th century, Platter served as a rural trading hub with fourteen general stores, three corn grist mills, and a cotton gin.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/platter_oklahoma"
    },
    {
      "id": 6,
      "text": "The arrival of the Missouri–Kansas–Texas Railroad in 1872 helped spur early non-Native settlement in the Platter region.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/platter_oklahoma"
    }
