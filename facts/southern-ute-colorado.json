  "facts": [
    {
      "id": 1,
      "text": "The Southern Ute Reservation sits in southwestern Colorado, encompassing parts of La Plata, Montezuma, and San Juan counties.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Ute_people"
    },
    {
      "id": 2,
      "text": "Ute Mountain Utes trace their roots to the Weeminuche band, which moved to the reservation’s western end in 1897.",
      "sourceSentenceIds": [
        27
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Ute_people"
    },
    {
      "id": 3,
      "text": "Before U.S. government interference, Ute hunters and gatherers roamed in small summer bands, collecting food to preserve for winter.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://tentribespartnership.org/tribes/southern-ute-indian-tribe/"
    },
    {
      "id": 4,
      "text": "The Southern Ute Cultural Center & Museum in Durango showcases tribal history, art, and traditional crafts.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.durango.org/listing/southern-ute-cultural-center-%26-museum/153/"
    },
    {
      "id": 5,
      "text": "Annual spring Bear Dances once drew Ute bands together for ceremony, trade, and intermarriage.",
      "sourceSentenceIds": [
        28
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Ute_people"
    },
    {
      "id": 6,
      "text": "Historically, Ute territory stretched beyond Colorado into parts of Wyoming, eastern Nevada, and Arizona.",
