  "facts": [
    {
      "id": 1,
      "text": "Middleway was originally established as the town of Smithfield on land owned by John Smith and William Smith in 1786.",
      "sourceSentenceIds": [
        21
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Middleway%2C_West_Virginia"
    },
    {
      "id": 2,
      "text": "The town became known as Middleway because its post office served as a center of commerce between several other towns.",
      "sourceSentenceIds": [
        6,
        22
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Middleway%2C_West_Virginia"
    },
    {
      "id": 3,
      "text": "Middleway has also been known as Wizard Clip, with some townspeople being referred to as Clippers due to a local legend.",
      "sourceSentenceIds": [
        28
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Middleway%2C_West_Virginia"
    },
    {
      "id": 4,
      "text": "The Middleway Historic District was added to the National Register of Historic Places in 1980 to protect its many historic buildings.",
      "sourceSentenceIds": [
        6,
        23
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Middleway%2C_West_Virginia"
    },
    {
      "id": 5,
      "text": "Middleway began a slow process of attrition after the Baltimore and Ohio Railroad bypassed the town for Summit Point.",
      "sourceSentenceIds": [
        8,
        9
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://middlewayconservancy.org/middlwayhistory"
    },
    {
      "id": 6,
      "text": "Early settlers established a grist mill and a hemp mill in the Middleway area as early as 1734.",
