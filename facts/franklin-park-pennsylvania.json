    {
      "id": 1,
      "text": "Franklin Park was originally named Franklin Township in honor of colonial statesman Benjamin Franklin.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://localhistory.northlandlibrary.org/franklin-park-borough/"
    },
    {
      "id": 2,
      "text": "Revolutionary War veterans and others settled Franklin Park around 1800, and some of their descendants still live in the community.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://localhistory.northlandlibrary.org/franklin-park-borough/"
    },
    {
      "id": 3,
      "text": "Franklin Park was originally part of Western Pennsylvania's Depreciation Lands before residents petitioned to form a new township in 1823.",
      "sourceSentenceIds": [
        7,
        16
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Franklin_Park%2C_Pennsylvania"
    },
    {
      "id": 4,
      "text": "Scattered businesses and farms in Franklin Park enjoyed a thriving oil and gas industry during the late 1800s and early 1900s.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Franklin_Park%2C_Pennsylvania"
    },
    {
      "id": 5,
      "text": "Franklin Park officially transitioned from a township to a borough in August 1961.",
      "sourceSentenceIds": [
        20
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Franklin_Park%2C_Pennsylvania"
    },
    {
      "id": 6,
      "text": "Franklin Park is a charter sponsor of the multi-municipality Northland Public Library.",
