      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Leetsdale%2C_Pennsylvania",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The borough officially became a town in 1904, carved out of the old Leet Township.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.sewickleyhistory.online/our-sewickley/leetsdale-borough/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Elmridge, a historic home in Leetsdale, earned a spot on the National Register of Historic Places.",
      "sourceSentenceIds": [
        3
      ],
