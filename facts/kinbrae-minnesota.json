  "facts": [
    {
      "id": 1,
      "text": "Kinbrae got its Scottish name in August 1883 after the townsite was renamed from De Forest.",
      "sourceSentenceIds": [
        2,
        6
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Kinbrae%2C_Minnesota",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The Dundee Land Company of Scotland founded the town in 1879, initially naming it Airlie after its president, the Earl of Airlie.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://lakesnwoods.com/Kinbrae.htm",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The Southern Minnesota Railroad began building a route through Kinbrae in 1879, linking Heron Lake to Fulda.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://lakesnwoods.com/Kinbrae.htm",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Kinbrae’s depot was called DeForest Station, while the post office was known as Airlie until January 1882 when it changed to DeForest.",
      "sourceSentenceIds": [
        17
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Kinbrae%2C_Minnesota",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "A steam elevator, hotel, and general store were built in Airlie in 1879, but the elevator burned down in April 1883, ending the Dundee Improvement Company’s involvement.",
      "sourceSentenceIds": [
        22,
        25
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Kinbrae%2C_Minnesota",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "By 1896 Kinbrae boasted two general stores, a hardware store, a lumber yard, two elevators, a blacksmith shop, a hotel, a bank, a creamery, and two churches.",
      "sourceSentenceIds": [
        30
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Kinbrae%2C_Minnesota",
      "category": "economy",
      "quality": "good"
    }
  ],
