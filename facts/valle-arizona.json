    {
      "id": 2,
      "text": "The original Valle Station featured a bunkhouse, section house, gang house, railroad telephone, and a 37‑car siding for loading cattle and sheep.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 2"
