  "facts": [
    {
      "id": 1,
      "text": "Lecompte got its name from a 19th‑century Thoroughbred racehorse owned by the Wells family, whose name honored local breeder Ambrose LeComte.",
      "sourceSentenceIds": [
        6,
        7,
        9,
        11
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Lecompte%2C_Louisiana",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Lecompte is known as Louisiana’s Pie Capital thanks to Lea’s Lunchroom, a 1920s‑era eatery famous for Cajun and Creole pies.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/lecompte_louisiana",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The town grew into a key lumber and agricultural rail junction in the late 1800s and early 1900s.",
      "sourceSentenceIds": [
        14
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/lecompte_louisiana",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Before settlers, the area along Bayou Boeuf was claimed by the Pascagoula and Biloxi tribes.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/lecompte_louisiana",
      "category": "people",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Lecompte began as a trading post in 1819 when traders Fulton and Miller bought land from the tribes and sold it to planters.",
      "sourceSentenceIds": [
        3
      ],
