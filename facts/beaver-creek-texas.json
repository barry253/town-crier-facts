  "facts": [
    {
      "id": 1,
      "text": "Beaver Creek was originally called the Beaver Creek Community after a nearby stream before being renamed Hilda when a retired minister opened the first post office.",
      "sourceSentenceIds": [
        3,
        4
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.texasalmanac.com/places/beaver-creek-0"
    },
    {
      "id": 2,
      "text": "Settlers began arriving in 1855, spilling over from German towns like Fredericksburg and New Braunfels.",
      "sourceSentenceIds": [
        22
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.texasalmanac.com/places/beaver-creek-0"
    },
    {
      "id": 3,
      "text": "The first church, built in 1865, doubled as a school and was made from cypress logs and stones.",
      "sourceSentenceIds": [
        25
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.texasalmanac.com/places/beaver-creek-0"
    },
    {
      "id": 4,
      "text": "Classes in the new 1893 school were taught by Henry Bierschwale, one of the county’s earliest educators.",
      "sourceSentenceIds": [
        27
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.texasalmanac.com/places/beaver-creek-0"
    },
    {
      "id": 5,
      "text": "By 1914 Beaver Creek boasted its own telephone service, a notable advance for a rural community.",
      "sourceSentenceIds": [
        29
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.texasalmanac.com/places/beaver-creek-0"
    },
    {
      "id": 6,
      "text": "The town’s post office closed in 1919, after which a community hall was built in 1920.",
