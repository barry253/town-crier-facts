      ],
      "source": "https://www.valleycenterks.gov/discover/valley_center_historical_and_cultural_society.php",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The Valley Center Historical & Cultural Society, incorporated in 1976, preserves local history and operates a vintage house museum.",
      "sourceSentenceIds": [
        8
