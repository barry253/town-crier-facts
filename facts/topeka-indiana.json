  "facts": [
    {
      "id": 1,
      "text": "Topeka was likely named because early settlers saw a landscape that reminded them of Topeka, Kansas.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Topeka%2C_Indiana",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Railroad officials in 1893 suggested a new name for the town, leading to the change from Slabtown to Topeka.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://topekahistoricalsociety.com/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Topeka’s historic library, a branch of the La Grange County Public Library, has served the community since the town’s early days.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Topeka%2C_Indiana",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The town sits in the heart of northeast Indiana Amish country, once home to the peaceful Potawatomi Indian.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
