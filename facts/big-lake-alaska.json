    {
      "id": 1,
      "text": "Herman Gronwoldt, a 15‑year‑old gold prospector, became Big Lake’s first homesteader in 1916, settling near a supply trail and the railroad.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
