  "facts": [
    {
      "id": 1,
      "text": "Hales Corners traces its history back to 1837 when brothers Seneca and William Hale each claimed 160 acres.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Hales_Corners%2C_Wisconsin",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The village was first called \"Hale's Corners\" after William Hale, the first postmaster in 1854, and the apostrophe was later dropped.",
      "sourceSentenceIds": [
        26,
        27
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Hales_Corners%2C_Wisconsin",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Monthly fairs began in the mid‑1800s along the plank road between Janesville and Milwaukee, turning the village into a stock market for farmers.",
      "sourceSentenceIds": [
        28,
        29
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Hales_Corners%2C_Wisconsin",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The Hales Corners Historical Society, made up of volunteers, preserves the village’s heritage and publishes books like \"Hales Corners Wisconsin: A History of the Village Since 1837.\".",
      "sourceSentenceIds": [
        9,
        12
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.halescornershistory.com/",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The area that became Hales Corners was originally claimed by France, then Britain, and finally the United States in 1783, before the Potawatomi Indians inhabited it.",
      "sourceSentenceIds": [
        7,
        18,
        19
      ],
      "sourceLabels": [
        "Web source 1",
        "Wikipedia"
      ],
      "source": "https://halescornerswi.gov/village-history/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Hales Corners was incorporated as a village on January 30, 1952, after decades of growth from a rural settlement.",
      "sourceSentenceIds": [
