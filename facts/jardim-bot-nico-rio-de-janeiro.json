  "facts": [
    {
      "id": 1,
      "text": "Founded on June 13, 1808 by Prince Regent John VI, the garden was created to acclimatize tropical plants for Brazil’s economy.",
      "sourceSentenceIds": [
        1,
        4
      ],
      "sourceLabels": [
        "Web source 1",
        "Web source 2"
      ],
      "source": "https://www.gov.br/jbrj/en/subjects/history",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Jardim Botânico lies beneath the right armpit of Rio’s iconic Christ the Redeemer statue.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Jardim_Bot%C3%A2nico%2C_Rio_de_Janeiro",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The garden houses an herbarium of roughly 330,000 reference specimens, a fine library, and well‑equipped research laboratories.",
      "sourceSentenceIds": [
        14
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.britannica.com/place/Rio-de-Janeiro-Botanical-Garden",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "In 1995 it became the Research Institute Rio de Janeiro Botanical Garden, a federal agency linked to the Ministry of Environment.",
      "sourceSentenceIds": [
        26
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.gov.br/jbrj/en/subjects/history",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Its original mission was to investigate economically useful plants from other tropical regions and prove their therapeutic potential.",
      "sourceSentenceIds": [
        30
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.gov.br/jbrj/en/subjects/history",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The Jardim Botânico neighborhood is known for its large detached houses and hosts many of Rede Globo’s studios.",
