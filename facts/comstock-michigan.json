  "facts": [
    {
      "id": 1,
      "text": "Comstock Township was named after Horace Hawkins Comstock, a businessman, lawyer, and politician who built a schoolhouse that gave the area its name.",
      "sourceSentenceIds": [
        5,
        6
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://comstockmi.gov/about/",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The first sawmill in Kalamazoo County opened in Comstock Creek in 1831, followed by a gristmill in 1832, marking the township’s early industrial roots.",
      "sourceSentenceIds": [
        15
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Comstock_Township%2C_Michigan",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "A post office opened in Comstock in February 1832, and the local school began operating the next year, 1833, showing rapid community development.",
      "sourceSentenceIds": [
        16,
        17
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Comstock_Township%2C_Michigan",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Norfolk Southern and Grand Trunk Western Canadian National railroads provide freight service within Comstock Township, linking it to regional trade routes.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Comstock_Township%2C_Michigan",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The unincorporated community of Comstock sits along the Kalamazoo River and M-96, a historic crossroads in the township’s western section.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Comstock_Township%2C_Michigan",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "East Comstock lies just east of Comstock on M-96 near the dam that creates Morrow Lake on the Kalamazoo River, a scenic waterway.",
