  "facts": [
    {
      "id": 1,
      "text": "Paulding was founded in 1848 as a planned community at the county center, named after the county by speculators hoping to move the seat.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Paulding%2C_Ohio",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The village’s historic courthouse, finished in 1886, sits on a lush green lawn with an old-fashioned gazebo at its heart.",
      "sourceSentenceIds": [
        8,
        26
      ],
      "sourceLabels": [
        "Web source 1",
        "Wikipedia"
      ],
      "source": "https://www.villageofpaulding.com/about-village-paulding",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Paulding once housed a sugar beet factory and a tomato ketchup plant, both now closed as local farms shifted crops.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Paulding%2C_Ohio",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The Paulding County Carnegie Library, built in the 1910s, was the first Carnegie library to serve an entire county instead of a single city.",
      "sourceSentenceIds": [
        17
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Paulding%2C_Ohio",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Paulding’s annual festival showcases steam-powered farm machinery, antique tractor pulls, and weaving brooms, delighting all senses.",
