      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.wisdomlib.org/cities/murraysville-27139",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Murraysville sits on North Carolina’s coastal plain, a flat, fertile landscape that shaped its farming practices.",
      "sourceSentenceIds": [
        25
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.wisdomlib.org/cities/murraysville-27139",
      "category": "nature",
      "quality": "good"
