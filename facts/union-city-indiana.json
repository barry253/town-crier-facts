  "facts": [
    {
      "id": 1,
      "text": "Union City was platted in 1849 by Jeremiah Smith and earned the nickname \"Hub City\" because five railroads converged at the state line.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/Union_City,_Indiana",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Union City’s historic Union City Passenger Depot, now a landmark, is listed on the National Register of Historic Places alongside the William Kerr House and Raphael Kirshbaum Building.",
      "sourceSentenceIds": [
        15
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Union_City%2C_Indiana",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "A post office has operated continuously in Union City since 1852, marking the town’s long‑standing role in regional communication.",
      "sourceSentenceIds": [
        22
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Union_City%2C_Indiana",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The town’s name reflects its origin as a planned community founded in 1849, sharing its name with a twin city across the Ohio border.",
      "sourceSentenceIds": [
        21
