    },
    {
      "id": 2,
      "text": "Founded in 1882 as a stop on the Great Northern Railway, Quamba grew around the railroad’s side track.",
      "sourceSentenceIds": [
        1,
        9
      ],
      "sourceLabels": [
        "Web source 1",
        "Wikipedia"
      ],
      "source": "https://moramn.com/mora-chamber/city-of-quamba/"
    },
    {
      "id": 3,
      "text": "Quamba is the only city in Minnesota that begins with the letter Q, making it a unique place to spot on a map.",
      "sourceSentenceIds": [
        26,
