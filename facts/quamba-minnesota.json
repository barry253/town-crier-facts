  "facts": [
    {
      "id": 1,
      "text": "Quamba’s name comes from an Ojibwe word meaning “mudhole,” a nod to the creek that once ran through the town.",
      "sourceSentenceIds": [
        1,
        6
      ],
      "sourceLabels": [
        "Web source 1",
        "Wikipedia"
      ],
      "source": "https://moramn.com/mora-chamber/city-of-quamba/",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Founded in 1882 as a stop on the Great Northern Railway, Quamba grew around the railroad’s side track.",
      "sourceSentenceIds": [
        1,
        9
      ],
      "sourceLabels": [
        "Web source 1",
        "Wikipedia"
      ],
      "source": "https://moramn.com/mora-chamber/city-of-quamba/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Quamba is the only city in Minnesota that begins with the letter Q, making it a unique place to spot on a map.",
      "sourceSentenceIds": [
        26,
        30
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://moramn.com/mora-chamber/city-of-quamba/",
      "category": "other",
      "quality": "poor",
      "qualityReason": "other"
    },
    {
      "id": 4,
      "text": "Platted in 1901 by Oric Ogilvie Whited, Quamba became an incorporated village on July 11, 1952.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Quamba%2C_Minnesota",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Quamba’s post office opened in 1901, closed briefly, and then served the community until 1966.",
