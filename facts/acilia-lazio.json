    {
      "id": 2,
      "text": "Acilia’s railway station links the neighborhood to Rome’s suburban line, making travel to the capital a quick ride.",
      "sourceSentenceIds": [
        18
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Acilia",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Located midway between Rome and Ostia along Via Ostiense, Acilia sits on a historic route that once ferried Roman legionaries.",
      "sourceSentenceIds": [
        25
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Acilia",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The name Acilia harks back to the ancient Roman family of the Acilii, who owned estates in the area during the empire.",
      "sourceSentenceIds": [
        26
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Acilia",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Just outside Acilia, Castel Porziano began as an ancient hunting lodge and now offers a blend of natural beauty and history.",
      "sourceSentenceIds": [
        2,
        3
      ],
      "sourceLabels": [
        "Web source 2"
      ],
