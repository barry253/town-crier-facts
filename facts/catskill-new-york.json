  "facts": [
    {
      "id": 1,
      "text": "Catskill Village’s Main Street is lined with historic shops and restaurants, a living reminder of the town’s 19th‑century commercial heart.",
      "sourceSentenceIds": [
        21
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Catskill_(town)%2C_New_York",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The Thomas Cole National Historic Site, perched on the Hudson River, offers views of the Catskill Mountains and a glimpse into America’s landscape‑painting roots.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://thomascole.org/plan-your-trip/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "A public boat launch called Dutchman’s Landing lets visitors paddle into the Hudson River, a favorite spot for fishing and kayaking.",
      "sourceSentenceIds": [
        22
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Catskill_(town)%2C_New_York",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Catskill is the setting of Washington Irving’s classic tale “Rip Van Winkle,” linking the village to American literary heritage.",
      "sourceSentenceIds": [
        27
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Catskill_(town)%2C_New_York",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The town’s first settler, Derrick Teunis van Vechten, built a house there in 1680, marking the beginning of Catskill’s long history.",
      "sourceSentenceIds": [
        23
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Catskill_(town)%2C_New_York",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Catskill Village welcomes visitors with a blend of historic architecture, river activities, and an Audubon nature preserve where bald eagles sometimes appear.",
      "sourceSentenceIds": [
        10
      ],
