      ],
      "source": "https://grokipedia.com/page/University_Park,_Texas",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The first public library opened on June 7, 2001, as the University Park Book Bank in Snider Plaza before becoming a municipal library in 2002.",
      "sourceSentenceIds": [
        26,
        29
      ],
      "sourceLabels": [
        "Wikipedia"
