  "facts": [
    {
      "id": 1,
      "text": "Spring Valley Village first petitioned for city status on December 14, 1954, signed by 26 residents and presented to Harris County Judge Bob Casey.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.springvalleytx.com/169/History-of-Spring-Valley-Village",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The city officially incorporated in 1955 after a second vote, winning 183 to 165 in the April 9 election.",
      "sourceSentenceIds": [
        28
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Spring_Valley_Village%2C_Texas",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Because of that 1955 incorporation, Houston never annexed Spring Valley’s territory, keeping the enclave independent within the Houston metro area.",
      "sourceSentenceIds": [
        29
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Spring_Valley_Village%2C_Texas",
      "category": "other",
      "quality": "poor",
      "qualityReason": "vague"
    },
    {
      "id": 4,
      "text": "In 1960 Spring Valley had 3,004 residents and only two businesses, a modest start for a future suburban community.",
      "sourceSentenceIds": [
        30
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Spring_Valley_Village%2C_Texas",
      "category": "other",
      "quality": "poor",
      "qualityReason": "vague"
    },
    {
      "id": 5,
      "text": "Fries Road, a main thoroughfare in the village, was named after a local Mr. Fries, honoring his early contributions to the area.",
