  "facts": [
    {
      "id": 1,
      "text": "Dawson Springs was originally called Tradewater Bend and incorporated in 1832 as Dawson City by the Menser brothers.",
      "sourceSentenceIds": [
        1,
        4
      ],
      "sourceLabels": [
        "Web source 1",
        "Wikipedia"
      ],
      "source": "https://www.exploredawsonsprings.com/aboutus"
    },
    {
      "id": 2,
      "text": "In 1872 the Elizabethtown and Paducah Railroad opened a depot called Tradewater Station on land owned by Patton Alexander and Bryant Dawson.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.exploredawsonsprings.com/aboutus"
    },
    {
      "id": 3,
      "text": "The town peaked in 1901 when more than 50,000 visitors flooded a community of only a few thousand, drawn by its mineral springs.",
      "sourceSentenceIds": [
        5,
        21
      ],
      "sourceLabels": [
        "Web source 1",
        "Wikipedia"
      ],
      "source": "https://www.exploredawsonsprings.com/aboutus"
    },
    {
      "id": 4,
      "text": "The New Century Hotel, built in the early 1900s, hosted three National Fox Hunts and became a central hub for guests seeking curative waters.",
      "sourceSentenceIds": [
        8,
        9
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.exploredawsonsprings.com/aboutus"
    },
    {
      "id": 5,
      "text": "Dawson Springs hosted the Pittsburgh Pirates’ spring training in the 1910s before the Grapefruit League formed.",
      "sourceSentenceIds": [
        22,
        23
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Dawson_Springs%2C_Kentucky"
    },
    {
      "id": 6,
      "text": "The town’s history began with two mineral wells discovered in the early 1800s, which turned the area into a spa destination.",
      "sourceSentenceIds": [
        14,
