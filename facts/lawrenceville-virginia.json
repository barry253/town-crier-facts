  "facts": [
    {
      "id": 1,
      "text": "Lawrenceville was founded in 1814 and named after the famous racehorse Lawrence, placing it right between Richmond and Raleigh.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://lawrencevilleweb.us/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town sits on the Meherrin River, a State Scenic River that locals say is one of Virginia’s best-kept secrets.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://lawrencevilleweb.us/",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Lawrenceville’s downtown hosts the annual Lawrenceville Christmas Parade each December, drawing families from across the county.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://lawrencevilleweb.us/",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Fort Christanna, a historic site on Fort Hill Road, preserves the story of the first permanent settlement for Native Americans and European traders.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://lawrencevilleweb.us/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Saint Paul’s College, a historically black college founded in 1888, was the first institution of higher learning in the town.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Lawrenceville%2C_Virginia",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The Tobacco Heritage Trail winds through Lawrenceville, offering cyclists and walkers a glimpse of the region’s agricultural past.",
