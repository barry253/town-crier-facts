    {
      "id": 1,
      "text": "The Gaslamp Quarter, downtown San Diego, boasts more than 90 Victorian‑era buildings now housing restaurants, shops, and nightclubs.",
      "sourceSentenceIds": [
        8,
        9
      ],
      "sourceLabels": [
        "Wikipedia"
