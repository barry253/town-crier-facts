  "facts": [
    {
      "id": 1,
      "text": "Tiki Island is a village in Galveston County, Texas, known for its Polynesian‑themed street names like Bamboo, Maui, and Tahiti.",
      "sourceSentenceIds": [
        15,
        19
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Tiki_Island%2C_Texas"
    },
    {
      "id": 2,
      "text": "The village is largely man‑made, built in the 1960s by digging canals and filling the land to an elevation of 4 to 10 feet above sea level.",
      "sourceSentenceIds": [
        16,
        3
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Tiki_Island%2C_Texas"
    },
    {
      "id": 3,
      "text": "Tiki Island sits on a tiny peninsula in Jones Bay, five miles west of Galveston, just off Interstate 45.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.tshaonline.org/handbook/entries/village-of-tiki-island-tx"
    },
    {
      "id": 4,
      "text": "The community was incorporated on August 30, 1982, after evolving from a small fishing camp into a weekend‑home area.",
      "sourceSentenceIds": [
        17
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Tiki_Island%2C_Texas"
    },
    {
      "id": 5,
      "text": "Residents enjoy a public park with playground and tennis courts, and a shared city hall and fire station that help maintain the village’s residential character.",
      "sourceSentenceIds": [
        14
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/Tiki_Island,_Texas"
    },
    {
      "id": 6,
      "text": "Because of its low elevation, Tiki Island is vulnerable to storm surges and tidal influences from nearby West Bay.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/Tiki_Island,_Texas"
