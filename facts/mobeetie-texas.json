    },
    {
      "id": 4,
      "text": "The town was first called Sweetwater, but a duplicate name forced it to adopt the Native‑American term Mobeetie in 1879.",
      "sourceSentenceIds": [
        26
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Mobeetie%2C_Texas"
    },
    {
