    {
      "id": 2,
      "text": "The Old Mobeetie Jail Museum displays artifacts and photos of the 1886 jail and the Red River War’s Battle of Sweetwater Creek.",
      "sourceSentenceIds": [
        15,
        16
      ],
      "sourceLabels": [
        "Web source 2"
