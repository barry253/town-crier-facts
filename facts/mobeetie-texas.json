    },
    {
      "id": 3,
      "text": "Fort Elliott’s original parade‑ground flagpole fronts the museum, while a granite marker a half‑mile away marks the fort’s original site.",
      "sourceSentenceIds": [
        17
      ],
      "sourceLabels": [
        "Web source 2"
