  "facts": [
    {
      "id": 1,
      "text": "Swiss immigrant Peter Wys discovered rich silver lodes in the Elkhorn Mountains, leading to the town's founding in the nineteenth century.",
      "sourceSentenceIds": [
        1,
        8,
        22
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Elkhorn%2C_Montana"
    },
    {
      "id": 2,
      "text": "Elkhorn once produced over fourteen million dollars in silver during its peak years of mining prosperity.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Elkhorn%2C_Montana"
    },
    {
      "id": 3,
      "text": "Unlike many other mining towns, Elkhorn was populated mostly by families of married European immigrants.",
      "sourceSentenceIds": [
        13
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Elkhorn%2C_Montana"
    },
    {
      "id": 4,
      "text": "Fraternity Hall was built in 1893 for social gatherings and remains one of the best preserved buildings in Elkhorn.",
      "sourceSentenceIds": [
        14
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Elkhorn%2C_Montana"
    },
    {
      "id": 5,
      "text": "Elkhorn State Park is the smallest state park in Montana and protects historic landmarks like Gillian Hall and a water tower.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://unitedstatesghosttowns.com/elkhorn-montana-ghost-town/"
    },
    {
      "id": 6,
      "text": "Railroad service to Elkhorn eventually halted, leaving only a small fraction of the original inhabitants in the town.",
