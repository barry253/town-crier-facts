  "facts": [
    {
      "id": 1,
      "text": "Nakuru was officially proclaimed a township on 28 January 1904 by British authorities, just a mile from the railway station.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Nakuru",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The city’s name comes from the Maasai people who once grazed the open grasslands that later became Nakuru.",
      "sourceSentenceIds": [
        19
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Nakuru",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "In 1952 Nakuru became a municipality, and in 2021 it was chartered as Kenya’s fourth city after Nairobi, Mombasa, and Kisumu.",
      "sourceSentenceIds": [
        20,
        23,
        24
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Nakuru",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The Hyrax Hill prehistoric site, uncovered by the Leakeys in 1926, sits near Nakuru and is a key Neolithic and Iron Age archaeological site.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
