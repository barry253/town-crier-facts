  "facts": [
    {
      "id": 1,
      "text": "Greenville earned its name from a general store and post office that opened at the corner of Kennett Pike and Buck Road.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://greenvillewilmingtonneighborhood.org/greenville-delaware-unveiling-the-elegant-tapestry-of-history-and-heritage/",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "In 1802, Éleuthère Irénée du Pont founded Eleutherian Mills, using the Brandywine River’s power to produce black powder for war and mining.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/Greenville,_Delaware",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The neighborhood surrounds historic du Pont estates like Nemours and Winterthur, showcasing the family’s industrial and philanthropic legacy.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/Greenville,_Delaware",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "duPont High School, founded in 1893, moved to Centre Road and remains a pillar of local education and civic pride.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://greenvillewilmingtonneighborhood.org/greenville-delaware-unveiling-the-elegant-tapestry-of-history-and-heritage/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Just a short drive from Greenville, Hagley Museum and Library preserves the original site of the DuPont gunpowder works.",
      "sourceSentenceIds": [
        13
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://greenvillewilmingtonneighborhood.org/greenville-delaware-unveiling-the-elegant-tapestry-of-history-and-heritage/"
    },
    {
      "id": 6,
      "text": "Walking down Barley Mill Road, sunlight filters through ancient oaks, giving Greenville a tranquil, historic feel.",
      "sourceSentenceIds": [
        11
      ],
