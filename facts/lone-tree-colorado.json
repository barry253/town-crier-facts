  "facts": [
    {
      "id": 1,
      "text": "Lone Tree’s name comes from a lone pine that once stood on the prairie, a landmark that guided early settlers.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Lone_Tree%2C_Colorado",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The Lone Tree Arts Center, opened in 2008, echoes the historic Florence Train Station in its design and serves as a cultural hub.",
      "sourceSentenceIds": [
        4,
        5
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://lonetreechamber.com/explore/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Four Mile Historic Park, just a short drive away, is a living museum that recreates life in the 1800s for families and history buffs.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://cremedelacreme.com/blog/historic-sites-lone-tree-co/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Englewood Depot, restored from the early 1900s, now hosts a museum that showcases how railroads shaped Lone Tree’s growth.",
      "sourceSentenceIds": [
        6,
        10,
        11
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://cremedelacreme.com/blog/historic-sites-lone-tree-co/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Bluffs Regional Park offers both scenic views and a glimpse into the area’s past, with interpretive signs detailing early settlement history.",
      "sourceSentenceIds": [
        17,
        18
      ],
