  "facts": [
    {
      "id": 1,
      "text": "Manton Historical Museum, housed in the town’s original schoolhouse, was founded by families led by Tip and Alice Wilson in the early 1990s.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://mantonparks.org/museum",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The museum building still stands but needs repair after years of neglect by the district that removed public youth education from Manton.",
      "sourceSentenceIds": [
        20
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://mantonparks.org/museum",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "On the museum lawn sits the original schoolhouse bell, with a plaque from E Clampus Vitus in 2013 marking the town’s education history.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://mantonparks.org/museum",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Manton’s post office has been operating since 1889, anchoring the town’s early communication network.",
      "sourceSentenceIds": [
        21
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Manton%2C_California",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "In August 2005, a forest fire overran Manton, destroying homes and forcing evacuation of the entire town.",
      "sourceSentenceIds": [
