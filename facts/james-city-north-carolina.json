  "facts": [
    {
      "id": 1,
      "text": "James City began in 1863 as the Trent River Settlement, a Union Army project to house freed slaves during the Civil War.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://northcarolinahistory.org/encyclopedia/james-city/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The settlement was renamed James City after Reverend Horace James, a Union chaplain who later served as an agent for the Freedmen's Bureau.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/James_City%2C_North_Carolina",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Residents built churches, businesses, and farms while the American Missionary Association and the Freedmen's Bureau founded schools and hospitals.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://northcarolinahistory.org/encyclopedia/james-city/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "In 1867 the Freedmen's Bureau withdrew its financial support, and the federal government returned land ownership to original owners.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://northcarolinahistory.org/encyclopedia/james-city/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The James City Historical Society and A.M.E. Zion Church run programs that preserve the community’s rich African‑American heritage.",
      "sourceSentenceIds": [
        7,
        8
      ],
