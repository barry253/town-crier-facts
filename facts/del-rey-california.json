  "facts": [
    {
      "id": 1,
      "text": "Del Rey got its name when early settlers renamed the area from Rancho La Ballona to honor a Spanish king.",
      "sourceSentenceIds": [
        2,
        7
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.delreync.org/about-del-rey",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The Beach Land Company launched the “King’s Playground,” which later became the neighborhood known as Del Rey.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.delreync.org/about-del-rey",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Before becoming a beach community, Del Rey was dotted with dairy farms and produce fields fed by flood‑rich soil.",
      "sourceSentenceIds": [
        20
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.delreync.org/about-del-rey",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "A 1901 streetcar line by the Redondo and Hermosa Beach Railroad linked Del Rey to Los Angeles, later part of the Los Angeles Pacific Railroad.",
