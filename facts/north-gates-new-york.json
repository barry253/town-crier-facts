  "facts": [
    {
      "id": 1,
      "text": "North Gates CDP sits at the geographic center of Monroe County, a spot marked just southwest of the town hall.",
      "sourceSentenceIds": [
        28,
        29
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Gates%2C_New_York",
      "category": "nature",
      "quality": "poor",
      "qualityReason": "vague"
    },
    {
      "id": 2,
      "text": "The town’s name honors Revolutionary War General Horatio Gates, who inspired the 1813 incorporation of the area formerly called Northampton.",
      "sourceSentenceIds": [
        3,
        4,
        5
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Gates%2C_New_York",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The Hinchey Homestead, a clapboard farmhouse built by early settler William Hinchey, now serves as a museum managed by the Gates Historical Society.",
      "sourceSentenceIds": [
        11,
        1
      ],
      "sourceLabels": [
        "Web source 2",
        "Web source 1"
      ],
      "source": "https://gateslibrary.org/local-history/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The Gates Historical Society, founded in 1999, preserves local history and showcases the Hinchey Homestead as a model historic site.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://gateslibrary.org/local-history/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The town hall, community center, police department, library, and court offices all share a single building on Buffalo Road, opened in 1969.",
      "sourceSentenceIds": [
        14,
        15
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.townofgatesny.gov/gates-town-history/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The local library offers genealogy resources, including Ancestry.com access, and houses a collection of historic maps and photographs of Gates and Rochester.",
      "sourceSentenceIds": [
        7,
        16,
        17
      ],
      "sourceLabels": [
        "Web source 2"
      ],
