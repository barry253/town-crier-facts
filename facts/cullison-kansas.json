      "category": "people",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Cullison was formally incorporated on January 1, 1887, becoming a recognized city just a few years after its founding.",
      "sourceSentenceIds": [
        11,
        14
      ],
      "sourceLabels": [
        "Web source 1"
