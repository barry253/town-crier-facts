      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The post office opened in 1885 and closed on April 7, 1967, marking the end of Cullison’s era as a functioning postal hub.",
      "sourceSentenceIds": [
        23,
        9
      ],
      "sourceLabels": [
        "Wikipedia",
