  "facts": [
    {
      "id": 1,
      "text": "Bradfordville began as a settlement between 1829 and 1832 when the Bradford brothers moved from North Carolina to farm large tracts of land.",
      "sourceSentenceIds": [
        30
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Bradfordville%2C_Florida",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Thomas Anderson Bradford, born February 13, 1790, founded Walnut Hill Plantation on the area that became Bradfordville.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Bradfordville%2C_Florida",
      "category": "people",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Edward Bradford, born August 2, 1798, established Pine Hill Plantation, a 3,270‑acre cotton plantation that once dominated the region.",
      "sourceSentenceIds": [
        2,
        8
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Bradfordville%2C_Florida",
      "category": "people",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The most successful Bradford brother later founded Horseshoe Plantation east‑southeast of Lake Iamonia, adding another large estate to the county.",
      "sourceSentenceIds": [
        3,
        7
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Bradfordville%2C_Florida",
      "category": "people",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Bradfordville sits in Florida’s Red Hills Region, where rolling hills, ravines, lakes and ponds create a distinctive landscape.",
      "sourceSentenceIds": [
        21,
        23
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Bradfordville%2C_Florida",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Lake Iamonia, one of Florida’s larger natural lakes, lies northwest of Bradfordville and is a popular spot for fishing and boating.",
      "sourceSentenceIds": [
        22
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
