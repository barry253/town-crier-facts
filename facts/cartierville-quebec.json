      ],
      "source": "https://en.wikipedia.org/wiki/Ahuntsic-Cartierville",
      "category": "other",
      "quality": "poor",
      "qualityReason": "location_description"
    },
    {
      "id": 3,
      "text": "Cartierville’s roots reach back to the fortified Sault‑au‑Récollet settlement established by the Sulpicians in 1696.",
      "sourceSentenceIds": [
