  "facts": [
    {
      "id": 1,
      "text": "Nezu Shrine was founded in the 1st century by Yamato Takeru, son of Emperor Keikō, per legend.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Nezu_Shrine",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The shrine was relocated to Nezu in 1705 by Tokugawa Tsunayoshi, the fifth shōgun, and later chosen as guardian deity by his successor Tokugawa Ienobu.",
      "sourceSentenceIds": [
        21,
        22
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Nezu_Shrine",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Nezu Shrine’s main building is built in Ishi-no-ma-zukuri style, modeled after Nikkō Tōshō-gū, and several structures are designated Important Cultural Property.",
      "sourceSentenceIds": [
        17,
        16
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Nezu_Shrine",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The shrine hosts an Azalea Festival from early April to early May, drawing visitors to its blooming azaleas and earning the nickname “Tokyo’s most beautiful shrine.”.",
      "sourceSentenceIds": [
        18
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Nezu_Shrine",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Nezu Shrine sits beside a pond of koi, with a viewing platform midway along the path that offers a view of the main precincts.",
      "sourceSentenceIds": [
        29
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
