  "facts": [
    {
      "id": 1,
      "text": "Caswell Beach was incorporated in 1975, sharing its name with Fort Caswell built in 1825, both honoring Governor Richard Caswell.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Caswell_Beach%2C_North_Carolina",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The Oak Island Lighthouse, operational since 1958, was acquired by the town in 2004 after negotiations with the National Park Service.",
      "sourceSentenceIds": [
        15
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Caswell_Beach%2C_North_Carolina",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "In 1975 the same year the town incorporated, Oak Island Golf Club opened its 18 holes on the west end of town.",
      "sourceSentenceIds": [
        16
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Caswell_Beach%2C_North_Carolina",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Caswell Beach sits on the eastern end of Oak Island, the easternmost of the South Brunswick Islands formed by the 1930s Intracoastal Waterway.",
      "sourceSentenceIds": [
        22,
        23
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Caswell_Beach%2C_North_Carolina",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The town’s sand restoration earned a national award in 2002 for Best Restored Beach after installing sand fences and planting sea oats.",
      "sourceSentenceIds": [
        21
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Caswell_Beach%2C_North_Carolina",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Caswell Beach’s historic Oak Island Life Saving Station lies just east of the lighthouse, a relic of early maritime rescue efforts.",
      "sourceSentenceIds": [
