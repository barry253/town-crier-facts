  "facts": [
    {
      "id": 1,
      "text": "Floridsdorf got its name in 1786 when Floridus Leeb granted land east of Am Spitz to settlers, honoring him.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Floridsdorf"
    },
    {
      "id": 2,
      "text": "The district hosted Austria’s first railway north of the Danube in 1837, sparking industrial growth.",
      "sourceSentenceIds": [
        14
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Floridsdorf"
    },
    {
      "id": 3,
      "text": "During WWI, Lohner‑Werke produced military aircraft in Floridsdorf, linking the area to early aviation.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Floridsdorf"
    },
    {
      "id": 4,
      "text": "The Marchfeldkanal, finished in 1992, now runs through Floridsdorf, creating green corridors and rare wildlife ponds.",
      "sourceSentenceIds": [
        25
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Floridsdorf"
    },
    {
      "id": 5,
      "text": "Vineyards on the Bisamberg slopes in Stammersdorf and Strebersdorf still thrive, preserving a historic agricultural tradition.",
      "sourceSentenceIds": [
        23
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
