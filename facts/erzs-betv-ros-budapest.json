  "facts": [
    {
      "id": 1,
      "text": "Erzsébetváros became an independent district in 1873 after Budapest's unification and was named in 1882 after Queen Elisabeth, reflecting a desire for prestige.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/Erzs%C3%A9betv%C3%A1ros",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The district's core was the historic Jewish Quarter, bounded by Király utca, Dohány utca, and Károly körút, a center of Jewish life until WWII.",
      "sourceSentenceIds": [
        16
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Erzs%C3%A9betv%C3%A1ros",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "In 1894 the New York Coffee House opened on Erzsébetváros, quickly turning into a hub for artists and writers with marble interiors and painted ceilings.",
      "sourceSentenceIds": [
        27,
        28
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://szineserzsebetvaros.hu/en/history/",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The area began to be parceled and populated in the early 18th century after the Turkish occupation, with streets like Király and Dob emerging.",
