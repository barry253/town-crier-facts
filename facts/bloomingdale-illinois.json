  "facts": [
    {
      "id": 1,
      "text": "Bloomingdale began as Meacham's Grove, named after the pioneering Meacham family who settled the area in 1833.",
      "sourceSentenceIds": [
        1,
        20
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Bloomingdale%2C_Illinois"
    },
    {
      "id": 2,
      "text": "In 1839, the village shifted from Cook County to DuPage County, marking a key administrative change in its early history.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Bloomingdale%2C_Illinois"
    },
    {
      "id": 3,
      "text": "The Chicago and Pacific Railroad crossed Bloomingdale’s northern side around 1873, turning the village into a vital rail stop.",
      "sourceSentenceIds": [
        8,
        9
      ],
      "sourceLabels": [
        "Web source 1",
        "Web source 2"
      ],
      "source": "https://www.villageofbloomingdale.org/213/Bloomingdale-History"
    },
    {
      "id": 4,
      "text": "Early commerce boomed with boot and shoemakers, a clothier, carpenters, a wagon maker‑blacksmith, and a cheese factory already thriving by the 1840s.",
      "sourceSentenceIds": [
        4,
        5
      ],
      "sourceLabels": [
        "Web source 1",
        "Web source 2"
      ],
      "source": "https://www.villageofbloomingdale.org/213/Bloomingdale-History"
    },
    {
      "id": 5,
      "text": "In the early 1900s, Bloomingdale and neighboring Roselle shared a library and a single fire engine, swapping locations every six months.",
      "sourceSentenceIds": [
        12,
        14
      ],
      "sourceLabels": [
        "Web source 1",
        "Web source 2"
      ],
      "source": "https://www.villageofbloomingdale.org/213/Bloomingdale-History"
    },
    {
      "id": 6,
      "text": "The village split in 1923, with the northern part becoming the separate town of Roselle while Bloomingdale retained its southern, agricultural character.",
      "sourceSentenceIds": [
        22,
        23
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Bloomingdale%2C_Illinois"
    }
  ]
