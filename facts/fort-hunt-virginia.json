  "facts": [
    {
      "id": 1,
      "text": "Fort Hunt was built in 1897 on George Washington’s former Mount Vernon estate to defend Washington, D.C.",
      "sourceSentenceIds": [
        2,
        13
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Fort_Hunt%2C_Virginia"
    },
    {
      "id": 2,
      "text": "The fort is named after Union Major General Henry Hunt, the Army of the Potomac’s chief of artillery during the Civil War.",
      "sourceSentenceIds": [
        3,
        4
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://armyhistory.org/fort-hunt-virginia/"
    },
    {
      "id": 3,
      "text": "During World War II, Fort Hunt served as an interrogation center called P‑Box 1142 where captured German officers were questioned.",
      "sourceSentenceIds": [
        24,
        25
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Fort_Hunt%2C_Virginia"
    },
    {
      "id": 4,
      "text": "The site has been a military asset since the Spanish–American War, when the land was first used by the U.S. Army.",
      "sourceSentenceIds": [
        21
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Fort_Hunt%2C_Virginia"
    },
    {
      "id": 5,
      "text": "Fort Hunt Park, now operated by the National Park Service, sits on the Potomac River and preserves the historic fort grounds.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Fort_Hunt%2C_Virginia"
    },
    {
      "id": 6,
      "text": "The fort’s location on the Potomac River places it directly across from Fort Washington in Maryland, forming a paired defensive line.",
      "sourceSentenceIds": [
        23
