  "facts": [
    {
      "id": 1,
      "text": "Furlong sits where Pennsylvania Route 263 meets Edison‑Furlong Road, right on the border of Buckingham and Doylestown townships.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Furlong%2C_Pennsylvania",
      "category": "other",
      "quality": "poor",
      "qualityReason": "location_description"
    },
    {
      "id": 2,
      "text": "The village’s name evolved from Beartown to The Green Tree, then to The Bush, and finally to Furlong, reflecting its early innkeepers’ influence.",
      "sourceSentenceIds": [
        13,
        23,
        26,
        27
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://pennsylvaniagenealogy.org/bucks/furlong-pennsylvania.htm",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "John Watson purchased 373 acres of Israel Pemberton’s Manor of Mayleigh in 1757, laying the land foundation for the future Furlong community.",
      "sourceSentenceIds": [
        18,
        19
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://pennsylvaniagenealogy.org/bucks/furlong-pennsylvania.htm",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Thomas Carver, a blacksmith who became an innkeeper, is believed to have been the first landlord of the site that later hosted the Green Tree Tavern.",
      "sourceSentenceIds": [
        20,
        21
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://pennsylvaniagenealogy.org/bucks/furlong-pennsylvania.htm",
      "category": "people",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Furlong’s rural charm is highlighted by its scenic countryside and historic town feel, a hallmark of many unincorporated areas in Pennsylvania.",
