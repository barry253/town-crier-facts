  "facts": [
    {
      "id": 1,
      "text": "Mount Pleasant was annexed by Calgary in 1910 and began development in 1912, marking the start of its transformation into a suburban community.",
      "sourceSentenceIds": [
        22
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.heritageinspiresyyc.org/heritage-places/communities-mount-pleasant/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Confederation Park, a 160‑acre green space that opened in 1967, was once known as the North Hill Coulee and was designed to celebrate Canada’s 100th birthday.",
      "sourceSentenceIds": [
        23,
        24
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.heritageinspiresyyc.org/heritage-places/communities-mount-pleasant/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "In 1958 Calgary’s first shopping mall, North Hill Centre, opened in Mount Pleasant, becoming a landmark of mid‑century retail development.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.heritageinspiresyyc.org/heritage-places/communities-mount-pleasant/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The Pleasant Museum of Local History, established in 1991, houses artifacts and archives that keep Mount Pleasant’s heritage alive for future generations.",
      "sourceSentenceIds": [
        6,
        10,
        9
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://mt-pleasant-museum.squarespace.com/",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Reavley Residence, a historic building in Mount Pleasant, stands as a testament to the area’s early architectural styles.",
      "sourceSentenceIds": [
        12,
        28
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.heritageinspiresyyc.org/heritage-places/communities-mount-pleasant/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "North Mount Pleasant Arts Centre, located in the community, offers a venue for local artists and cultural events, enriching the town’s creative scene.",
