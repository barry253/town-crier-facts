  "facts": [
    {
      "id": 1,
      "text": "Summerville was founded in 1838 as the seat of the newly formed Chattooga County.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Summerville%2C_Georgia",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town’s name comes from its early reputation as a summer resort, a claim also linked to settler David Taylor Jr.’s summer home.",
      "sourceSentenceIds": [
        8,
        9
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Summerville%2C_Georgia",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The 1918 Central of Georgia Railroad Depot, now on the National Register, hosts annual festivals and reflects the city’s rail heritage.",
      "sourceSentenceIds": [
        12,
        22
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Summerville%2C_Georgia",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "A historic turntable, rescued from scrap by CSX and restored in 2003, remains one of the few operational turntables in the United States.",
      "sourceSentenceIds": [
        5,
        6
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.summervillega.org/business/chamber_of_commerce/index.php",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Summerville sits along the Chattooga River at the western base of Taylor Ridge, giving it a distinctive river‑ridge landscape.",
      "sourceSentenceIds": [
        25
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Summerville%2C_Georgia",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The Summerville Commercial Historic District, covering eight city blocks around Commerce Street, was listed on the National Register in 2012.",
      "sourceSentenceIds": [
        23,
