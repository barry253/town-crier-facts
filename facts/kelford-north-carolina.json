  "facts": [
    {
      "id": 1,
      "text": "Kelford once housed a Coca‑Cola bottling plant that operated for decades before a fire destroyed it in the 1990s.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.usacitiesonline.com/nccountykelford.htm",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "At its peak, Kelford boasted a Ford dealership, hotel, movie theater, several hardware and grocery stores, a barber shop, drug store, sawmill, oil distributorship, blacksmith shop, and funeral home.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.usacitiesonline.com/nccountykelford.htm",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Today the town’s business district centers on the Kelford Post Office, Linda’s Beauty Shop, and Floral Discount.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.usacitiesonline.com/nccountykelford.htm",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The North Carolina‑Virginia Railroad line cuts through Kelford, following the old SCL railroad trackage.",
      "sourceSentenceIds": [
        6
