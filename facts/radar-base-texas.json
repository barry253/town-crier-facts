  "facts": [
    {
      "id": 1,
      "text": "Radar Base began as Eagle Pass Army Air Field, a World War II training base opened in 1942 about ten miles north of Eagle Pass.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/radar_base_texas",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "After the airfield closed in 1945, the site was reactivated as Eagle Pass Air Force Station, a Cold War radar facility, in 1957.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/radar_base_texas",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The 733rd Aircraft Control and Warning Squadron manned the station, operating an AN/FPS‑20A search radar and an AN/FPS‑6 height‑finder to feed the early SAGE system.",
      "sourceSentenceIds": [
        8,
        9
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/radar_base_texas",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The radar site was shut down on August 1 1963 after a March 1963 Air Force order to cut back continental air‑defense commitments.",
      "sourceSentenceIds": [
        14
      ],
      "sourceLabels": [
        "Web source 2"
      ],
