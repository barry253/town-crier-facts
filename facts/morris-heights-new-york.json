      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "During the Great Depression and World War II, Morris Heights remained a stable community of factory workers, shopkeepers, and teachers.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
