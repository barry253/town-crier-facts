      "id": 1,
      "text": "A Moravian mission station opened in April 1769 on East Hickory’s eastern Allegheny River bank, serving the Munsee Lenape until it closed in 1770.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 2"
      ],
