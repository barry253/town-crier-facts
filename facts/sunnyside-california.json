  "facts": [
    {
      "id": 1,
      "text": "Sunnyside got its name from William Oothout’s 1890 vineyard, a name that stuck and marked the area’s early agricultural roots.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/sunnyside_fresno_county_california",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "In 1911 locals bought part of the historic Sunnyside Vineyard to build the Sunnyside Golf and Country Club, sparking residential growth.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/sunnyside_fresno_county_california",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "East Kings Canyon Road now hosts shopping centers and diverse eateries, while Sunnyside Park and the Fancher Creek Trail keep historic treescapes alive.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/sunnyside_fresno_county_california",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Sunnyside’s 19th‑century wheat fields and vineyards helped pioneer California’s raisin industry before becoming a quiet residential enclave.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/sunnyside_fresno_county_california",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Sunnyside’s historic treescapes are protected as county landmarks, preserving the neighborhood’s original agricultural charm.",
      "sourceSentenceIds": [
        1
