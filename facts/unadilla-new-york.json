  "facts": [
    {
      "id": 1,
      "text": "Unadilla’s name comes from an Iroquois word meaning “meeting place” in the 18th century.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Unadilla%2C_New_York",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town of Unadilla was carved out of Otsego County in 1792.",
      "sourceSentenceIds": [
        14
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Unadilla%2C_New_York",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "In 1827, residents turned the community of Unadilla into an incorporated village.",
      "sourceSentenceIds": [
        16
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Unadilla%2C_New_York",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The 1851 opening of the Albany and Susquehanna Railroad gave Unadilla a rail link to eastern markets.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://villageofunadilla.com/village-information/history",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Three historic sites—Unadilla Waterworks, Russ-Johnsen Site, and Andrew Mann Inn—are listed on the National Register of Historic Places.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Unadilla%2C_New_York",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Early in the 1900s, the Tie Company, known for quick‑release cords still used today, relocated from Sidney to Unadilla.",
