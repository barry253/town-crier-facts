  "facts": [
    {
      "id": 1,
      "text": "Wolf Lake’s name may come from an early settler or Native American chief named Wolf, the area’s wolves, or the lake’s wolf‑shaped outline.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/wolf_lake_illinois",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The lake breaks into five connected sections, separated by old channels and railroad embankments, with depths reaching up to 18 feet.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/wolf_lake_illinois",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Originating from ancient post‑glacial Lake Chicago, Wolf Lake now hosts more than 2,200 species, including sport fish and endangered sturgeon.",
      "sourceSentenceIds": [
        13
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/wolf_lake_illinois",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "An open channel once linked Wolf Lake to Lake Michigan on the Indiana side, but development cut it off in the 20th century.",
      "sourceSentenceIds": [
        23
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Wolf_Lake_(Indiana%E2%80%93Illinois)",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Five impoundments in Illinois were separated by dikes built in the late 1950s so dredging could supply fill for the Chicago Skyway.",
      "sourceSentenceIds": [
        27
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Wolf_Lake_(Indiana%E2%80%93Illinois)",
      "category": "other",
      "quality": "poor",
      "qualityReason": "other"
    },
    {
