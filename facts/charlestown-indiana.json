      "quality": "good"
    },
    {
      "id": 2,
      "text": "In 1818, the first Grand Lodge of Free & Accepted Masons in Indiana met in Charlestown, thanks to Jonathan Jennings.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Charlestown%2C_Indiana",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The town’s first mill appeared on Fourteen Mile Creek in 1804, and today its tunnel houses the Tunnel Mill Scout Reservation.",
      "sourceSentenceIds": [
        23,
        24
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Charlestown%2C_Indiana",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Charlestown served as Clark County’s seat from 1811 until 1878, when Jeffersonville reclaimed the title.",
      "sourceSentenceIds": [
        25
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Charlestown%2C_Indiana",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Charlestown hosts a branch of the Charlestown‑Clark County Public Library, a key community hub.",
