  "facts": [
    {
      "id": 1,
      "text": "Battle Ground earned its name from the 1811 Battle of Tippecanoe, where Governor William Henry Harrison faced Tecumseh’s confederacy.",
      "sourceSentenceIds": [
        5,
        6,
        8,
        15
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Battle_Ground%2C_Indiana"
    },
    {
      "id": 2,
      "text": "The town’s historic district, listed on the National Register in 1985, preserves 19th‑century architecture that once housed soldiers’ quarters.",
      "sourceSentenceIds": [
        29
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Battle_Ground%2C_Indiana"
    },
    {
      "id": 3,
      "text": "The Tippecanoe Battlefield Museum, a National Historic Landmark, sits on 96 acres with hiking trails and a nature center.",
      "sourceSentenceIds": [
        1,
        2,
        3
      ],
      "sourceLabels": [
        "Web source 2",
        "Wikipedia"
      ],
      "source": "https://tippecanoehistory.org/our-places/tippecanoe-battlefield-museum/"
    },
    {
      "id": 4,
      "text": "The battlefield’s monument, erected in 1908, commemorates the men who fought and died in the 1811 clash.",
