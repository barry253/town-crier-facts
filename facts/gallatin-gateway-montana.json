  "facts": [
    {
      "id": 1,
      "text": "Gallatin Gateway began as Slabtown in 1865, became Salesville in 1883 after lumberman Zachariah Sales, and was renamed Gallatin Gateway in 1927.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://roamingmontana.com/gallatin-gateway/"
    },
    {
      "id": 2,
      "text": "The Gallatin Gateway Inn, opened June 17, 1927, was once hailed as one of the most luxurious hotels of its era.",
      "sourceSentenceIds": [
        24
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Gallatin_Gateway%2C_Montana"
    },
    {
      "id": 3,
      "text": "In 1980 the Gallatin Gateway Inn earned Historic Landmark status after a major restoration, and the same year the Milwaukee Road went bankrupt.",
      "sourceSentenceIds": [
        2,
        9
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 2"
      ],
      "source": "https://en.wikipedia.org/wiki/Gallatin_Gateway%2C_Montana"
    },
    {
      "id": 4,
      "text": "The town became the terminus of a Milwaukee Road branch line from Three Forks, carrying passengers on the route through Yellowstone National Park.",
      "sourceSentenceIds": [
        22
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Gallatin_Gateway%2C_Montana"
    },
    {
      "id": 5,
      "text": "Gallatin Gateway sits at the mouth of Gallatin Canyon, the road from there leads directly to Yellowstone National Park.",
      "sourceSentenceIds": [
        26
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://visitmt.com/cities-towns/gallatin-gateway"
    },
    {
      "id": 6,
      "text": "The town’s elevation is 4,953 feet, placing it high above the surrounding valley.",
      "sourceSentenceIds": [
        16
      ],
