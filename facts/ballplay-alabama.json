  "facts": [
    {
      "id": 1,
      "text": "Ballplay’s name comes from a Cherokee stick‑ball field where tribes played to settle disputes.",
      "sourceSentenceIds": [
        2,
        8
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 2"
      ],
      "source": "https://en.wikipedia.org/wiki/Ballplay%2C_Alabama",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "In December 1832, Creek and Cherokee teams fought a high‑stakes stick‑ball match at Ballplay to decide ownership of a neutral strip of land.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/ballplay_alabama",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "A post office operated in Ballplay from 1840 until it closed in 1905, marking the town’s early civic infrastructure.",
      "sourceSentenceIds": [
        3,
        14
      ],
      "sourceLabels": [
        "Web source 2",
        "Wikipedia"
      ],
      "source": "https://grokipedia.com/page/ballplay_alabama",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Unity Hill Cemetery in Ballplay holds graves dating back to the 19th century, reflecting the community’s long‑standing presence.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/ballplay_alabama",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Ballplay sits near the Coosa River, a waterway historically vital for trade and transportation in the region.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.trawellino.com/destinations/united-states/alabama_ballplay",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "By the early 1840s, white settlers had established homesteads in Ballplay, reshaping the landscape with farming and basic infrastructure.",
