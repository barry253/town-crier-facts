  "facts": [
    {
      "id": 1,
      "text": "Honey Hill gets its name from the abundance of wild bee hives that populated the hilly area during the early nineteenth century.",
      "sourceSentenceIds": [
        24
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/honey_hill_oklahoma"
    },
    {
      "id": 2,
      "text": "Cherokee settlers established the Honey Hill community after their forced relocation along the Trail of Tears in the 1830s.",
      "sourceSentenceIds": [
        25
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/honey_hill_oklahoma"
    },
    {
      "id": 3,
      "text": "The Honey Hill School was founded in 1845 by the Cherokee Nation as one of three initial schools in the Flint District.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/honey_hill_oklahoma"
    },
    {
      "id": 4,
      "text": "Honey Hill Cemetery, also known as Allison Cemetery, was established by the mid-nineteenth century and contains the grave of Ezekiel Mayfield.",
      "sourceSentenceIds": [
        17
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/honey_hill_oklahoma"
    },
    {
      "id": 5,
      "text": "Oak-hickory forests with white oak and shagbark hickory form a canopy over the rolling hills of Honey Hill.",
      "sourceSentenceIds": [
        20
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/honey_hill_oklahoma"
    },
    {
      "id": 6,
      "text": "Honey Hill experiences a humid subtropical climate with hot, humid summers and mild winters typical of eastern Oklahoma.",
