  "facts": [
    {
      "id": 1,
      "text": "Craig was named after Craig Miller (also spelled Millar) who founded a fish saltery on Fish Egg Island in 1907 with Haida help.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Craig%2C_Alaska"
    },
    {
      "id": 2,
      "text": "Craig was incorporated in 1922 as an Alaska second‑class city, thanks to Craig Miller’s cold‑storage plant and packing company.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Craig%2C_Alaska"
    },
    {
      "id": 3,
      "text": "The town sits on Prince of Wales Island, the fourth‑largest U.S. island, and is the island’s largest community.",
      "sourceSentenceIds": [
        14
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Craig%2C_Alaska"
    },
    {
      "id": 4,
      "text": "Craig’s historic cannery walk features artifacts from the 2015 Japan tsunami and a hand‑carved memorial to those lost at sea.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://discoverpowisland.com/communities/craig/"
    },
    {
      "id": 5,
      "text": "In the 1930s, record pink salmon runs drew many new settlers to Craig, boosting its fishing industry.",
      "sourceSentenceIds": [
        16
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Craig%2C_Alaska"
    },
    {
      "id": 6,
      "text": "Craig relies today on commercial fishing, fish processing, and timber, making it a key economic hub on the island.",
      "sourceSentenceIds": [
        17
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Craig%2C_Alaska"
    }
