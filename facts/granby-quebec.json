      "quality": "good"
    },
    {
      "id": 2,
      "text": "Granby’s main attraction is the Granby Zoo, alongside the famous Lac Boivin fountain.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Granby%2C_Quebec",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Lac Boivin formed after a 1815 dam on the North Yamaska River created a shallow swamp that now serves as a local landmark.",
      "sourceSentenceIds": [
        10,
        14
      ],
      "sourceLabels": [
        "Wikipedia",
