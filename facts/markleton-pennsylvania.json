  "facts": [
    {
      "id": 1,
      "text": "Markleton takes its name from Cyrus P.'s paper company that settled the area in the late 1800s.",
      "sourceSentenceIds": [
        25
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Markleton%2C_Pennsylvania"
    },
    {
      "id": 2,
      "text": "A five‑story brick sanatorium built by the paper company turned into a health resort, reachable by the B&O Railroad.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/markleton_pennsylvania"
    },
    {
      "id": 3,
      "text": "The original settlement, Philson's Forge, was a short‑lived iron forge near the Casselman River around 1810.",
      "sourceSentenceIds": [
        22,
        23,
        24
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Markleton%2C_Pennsylvania"
    },
    {
      "id": 4,
      "text": "Markleton lies 7.7 miles east‑northeast of Confluence along the Casselman River, mainly accessed via Pennsylvania Route 281.",
      "sourceSentenceIds": [
        6,
        7
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Markleton%2C_Pennsylvania"
    },
    {
      "id": 5,
      "text": "Appalachian hemlock‑northern hardwood forests once covered Markleton’s slopes, harvested to feed the paper mill’s pulp production.",
