      "category": "nature",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The Billiou‑Stillwell‑Perine House, built 1661, is the oldest surviving building in Staten Island and one of the oldest in the country.",
      "sourceSentenceIds": [
        4,
        6
      ],
      "sourceLabels": [
