      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The Staten Island Railway’s Dongan Hills station, opened in 1860, remains a central link to the ferry and beyond.",
      "sourceSentenceIds": [
        14,
        15
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.cityneighborhoods.nyc/dongan-hills",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Dongan Hills is home to the NYPL Dongan Hills branch at 1617 Richmond Road, serving the community.",
