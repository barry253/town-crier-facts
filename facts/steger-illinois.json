      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "John Valentine Steger erected a piano factory on land south of Chicago Heights, right beside the Chicago and Eastern Illinois Railroad tracks.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Steger%2C_Illinois",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "By 1904 the factory spanned 23 acres and could churn out sixteen thousand pianos each year.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
