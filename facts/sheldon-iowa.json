    },
    {
      "id": 2,
      "text": "In 1907, the Sheldon Carnegie Library opened, funded by a $10,000 grant from the Carnegie Corporation.",
      "sourceSentenceIds": [
        17
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/Sheldon,_Iowa",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The Beaux‑Arts Carnegie building, completed in 1909, later became the Sheldon Prairie Museum and was added to the National Register in 1977.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/Sheldon,_Iowa",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The Ringling Brothers and Barnum & Bailey Circus performed in Sheldon in the early 1900s, drawing some of the largest crowds in the town's history.",
