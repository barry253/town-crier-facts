    },
    {
      "id": 2,
      "text": "In 1893, Wayside was founded as a rural school district, marking the town’s first formal community.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.historictexas.net/city/wayside-texas"
    },
    {
      "id": 3,
      "text": "The first white settlers were JA Ranch cowhands who camped along Palo Duro Canyon’s south rim.",
      "sourceSentenceIds": [
        16
      ],
      "sourceLabels": [
