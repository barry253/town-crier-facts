  "facts": [
    {
      "id": 1,
      "text": "Afula was founded in 1925 during the British Mandate, becoming one of Israel's earliest modern planned cities.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.trawellino.com/destinations/israel/northern-district_afula",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The city’s name echoes its Arab predecessor, likely stemming from the Canaanite‑Hebrew root 'ofel meaning fortress tower.",
      "sourceSentenceIds": [
        26
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Afula",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Tel Afula, the ancient tell near downtown, dates back to the Late Chalcolithic and was once linked to Gideon’s hometown.",
      "sourceSentenceIds": [
        19,
        30
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Afula",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Ottoman authorities opened the Jezreel Valley railway in 1904, first running between Haifa and Beit She'an via Afula.",
      "sourceSentenceIds": [
        11
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Afula",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "In 2011, construction began on a new standard‑gauge line from Haifa to Beit She'an, adding a modern station in Afula.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Afula",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Tadiran, a leading air‑conditioner manufacturer, was founded in Afula and remains a key industrial player.",
      "sourceSentenceIds": [
        7
