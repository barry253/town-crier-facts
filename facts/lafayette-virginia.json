  "facts": [
    {
      "id": 1,
      "text": "Lafayette was officially established in 1828 and laid out on six blocks, a grid of Water, Main, High, Front, Union, Washington, and Back streets.",
      "sourceSentenceIds": [
        23,
        4
      ],
      "sourceLabels": [
        "Web source 1",
        "Web source 2"
      ],
      "source": "https://www.dhr.virginia.gov/historic-registers/060-0418/"
    },
    {
      "id": 2,
      "text": "By 1835, the village boasted 43 houses, a large mill, a tavern, shops, a shoe factory, and a tanyard, making it a bustling river trade hub.",
      "sourceSentenceIds": [
        1,
        7,
        9
      ],
      "sourceLabels": [
        "Web source 2",
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/lafayette_historic_district_lafayette_virginia"
    },
    {
      "id": 3,
      "text": "Growth halted in 1846 when the Southwestern Turnpike bypassed Lafayette, preventing it from becoming a major commercial center.",
      "sourceSentenceIds": [
        25
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.dhr.virginia.gov/historic-registers/060-0418/"
    },
    {
      "id": 4,
      "text": "The district sits at the confluence of the North and South Forks of the Roanoke River, a key geographic feature noted since the mid‑18th century.",
      "sourceSentenceIds": [
        2,
        5,
        6
      ],
      "sourceLabels": [
        "Web source 2",
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/lafayette_historic_district_lafayette_virginia"
    },
    {
      "id": 5,
      "text": "A simple brick Methodist church, built in 1848 on the public square, remains one of the few antebellum structures still standing.",
      "sourceSentenceIds": [
        24
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.dhr.virginia.gov/historic-registers/060-0418/"
    },
    {
      "id": 6,
      "text": "Lafayette Historic District was listed on the Virginia Landmarks Register in 1989 and the National Register of Historic Places in 1991, preserving its historic fabric.",
      "sourceSentenceIds": [
        11,
        19
      ],
      "sourceLabels": [
        "Web source 2",
        "Wikipedia"
      ],
      "source": "https://grokipedia.com/page/lafayette_historic_district_lafayette_virginia"
    }
