  "facts": [
    {
      "id": 1,
      "text": "Newcastle was named after Thomas Pelham-Holles, the 1st Duke of Newcastle‑upon‑Tyne, a close friend of the colonies.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Newcastle%2C_Maine",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Originally called Sheepscot Plantation, Newcastle was one of Maine’s earliest European settlements, founded in the 1630s by about 50 fishermen families.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Newcastle%2C_Maine",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The arrival of the Knox‑Lincoln Railroad in 1871 linked Newcastle to Rockland, dramatically boosting the town’s economy and connectivity.",
      "sourceSentenceIds": [
        8,
        9,
        10
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Newcastle%2C_Maine",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Frances Perkins, the first woman to serve as U.S. Secretary of Labor, was born in Newcastle and helped shape the New Deal.",
      "sourceSentenceIds": [
        14,
        15,
        24
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Newcastle%2C_Maine",
      "category": "people",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The Newcastle Historical Society & Museum works year‑round to scan historic photos, digitize documents, and preserve cemetery records.",
      "sourceSentenceIds": [
        16
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://nhsmaine.org/",
      "category": "other",
      "quality": "poor",
      "qualityReason": "editorial_filler"
    },
    {
      "id": 6,
      "text": "The village of Newcastle sits on the eastern side of the town, along the banks of the Damariscotta River.",
