  "facts": [
    {
      "id": 1,
      "text": "Yorkville got its name from its position north of York Hill, an early term for the elevated land east of what is now Park Avenue.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.cityneighborhoods.nyc/yorkville",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "By the late 19th century, Yorkville had become the heart of Kleindeutschland—New York’s Little Germany—after many German immigrants relocated uptown from the East Village.",
      "sourceSentenceIds": [
        28
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.cityneighborhoods.nyc/yorkville",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Tenement housing predominated east of Third Avenue while the 1837 New York & Harlem Railroad and 1878 Third Avenue Elevated Line spurred rapid urbanization.",
      "sourceSentenceIds": [
        4,
        5
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.cityneighborhoods.nyc/yorkville",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Along East 86th Street, bakeries, beer halls, and delicatessens flourished, transforming the thoroughfare into the “German Broadway.”.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.cityneighborhoods.nyc/yorkville",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Yorkville boasts architecturally distinctive buildings, many of which the Friends of the Upper East Side has sought landmark status for, highlighting its European immigrant heritage.",
      "sourceSentenceIds": [
        10,
        11,
        12
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://friends-ues.org/yorkville-special/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Sleek stations at 86th and 96th Streets spurred renewed investment, blending new glass towers with preserved brownstones.",
      "sourceSentenceIds": [
        16
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.cityneighborhoods.nyc/yorkville",
      "category": "landmark",
      "quality": "good"
    }
