  "facts": [
    {
      "id": 1,
      "text": "Golf, Illinois got its name from the sport of golf, thanks to the Glen View Club founded in 1897.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/golf_illinois",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The Glen View Club opened in 1897, and in 1907 members built the “Dinkey” train to shuttle golfers to the course.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://golf.com/travel/welcome-to-town-golf-illinois/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Paul Railroad built a private siding near the club so wealthy golfers could ride his railcar straight to the greens.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/golf_illinois",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "In 1957 a group of Golf residents moved to Florida and founded the Country Club of Florida for winter play.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://golf.com/travel/welcome-to-town-golf-illinois/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Before European settlement, the area that is now Golf was part of the ancestral lands of the Chippewa, Ottawa, and Potawatomi peoples.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
