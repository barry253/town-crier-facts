  "facts": [
    {
      "id": 1,
      "text": "The historic octagon house, built in the 1850s, anchors the west end of Brasher Falls’ West Main Street.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.northcountrypublicradio.org/news/story/46887/20221118/the-road-to-bringing-a-north-country-village-s-main-street-back-to-life",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "West Main Street is bookended by that octagon house and Veteran’s Park, which even hosts a decommissioned military jet.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.northcountrypublicradio.org/news/story/46887/20221118/the-road-to-bringing-a-north-country-village-s-main-street-back-to-life",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Elaina Rumble and her son Joe Metts opened Elaina’s Bakery and Diner this fall, bringing new life to downtown Brasher Falls.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.northcountrypublicradio.org/news/story/46887/20221118/the-road-to-bringing-a-north-country-village-s-main-street-back-to-life",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The Buck‑Stevens House, a local landmark, earned a spot on the National Register of Historic Places in 1982.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Brasher_Falls%E2%80%93Winthrop%2C_New_York",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Brasher Falls grew around the iron industry, which initially mined and smelted ore before shifting to stove production.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.northcountrypublicradio.org/news/story/46887/20221118/the-road-to-bringing-a-north-country-village-s-main-street-back-to-life",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The former Badenhausen Library now serves as a reading room, keeping the town’s literary tradition alive.",
