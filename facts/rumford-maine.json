  "facts": [
    {
      "id": 1,
      "text": "Rumford’s name comes from settlers who moved from Concord, New Hampshire, which was called Rumford at the time.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://umaine.edu/undiscoveredmaine/western-maine/oxford/rumford/",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town’s industrial boom began when the Oxford Paper Company was founded in 1893, becoming Rumford’s catalyst for growth.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://maine.com/rumford",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Hugh Chisholm’s investments built Rumford Falls, a key site that powered the town’s historic papermaking process.",
      "sourceSentenceIds": [
        18
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://maine.com/rumford",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The Maine Mineral & Gem Museum in Rumford showcases the region’s geological wonders, preserving its natural heritage.",
      "sourceSentenceIds": [
        19
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://maine.com/rumford",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Frank Churchill, the composer of Snow White’s music, was born in Rumford, linking the town to Disney history.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://umaine.edu/undiscoveredmaine/western-maine/oxford/rumford/",
      "category": "people",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Rumford still hosts ND Paper Inc’s Rumford Mill and the Black Mountain of Maine ski resort, blending industry and recreation.",
      "sourceSentenceIds": [
        29
