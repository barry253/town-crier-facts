  "facts": [
    {
      "id": 1,
      "text": "Rossville houses Sandy Ground, the oldest continuously settled free Black community in the U.S., founded by freedmen in 1828.",
      "sourceSentenceIds": [
        7,
        10
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Rossville%2C_Staten_Island"
    },
    {
      "id": 2,
      "text": "The Sandy Ground Museum, founded in 1980, is the first U.S. museum dedicated to a free Black community’s heritage.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.cityneighborhoods.nyc/rossville"
    },
    {
      "id": 3,
      "text": "Five historic structures in Rossville, including a church, cemetery, and three homes, are New York City landmarks.",
      "sourceSentenceIds": [
        3,
        25
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Rossville%2C_Staten_Island"
    },
    {
      "id": 4,
      "text": "The Blazing Star Ferry once linked Staten Island to New Jersey, and its burial ground dates to the mid‑1750s.",
      "sourceSentenceIds": [
        21,
        19
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Rossville%2C_Staten_Island"
    },
    {
      "id": 5,
      "text": "Rossville’s Arthur Kill Road winds through centuries of history, from colonial farms and ferries to modern homes and parks.",
      "sourceSentenceIds": [
        26,
        18
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.cityneighborhoods.nyc/rossville"
    },
    {
      "id": 6,
      "text": "In the 1930s and 1940s, modest new houses appeared along Arthur Kill Road, yet the rural landscape and historic landmarks largely survived.",
