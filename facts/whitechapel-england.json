  "facts": [
    {
      "id": 1,
      "text": "Whitechapel’s name comes from a small chapel, St Mary’s, that later became St Mary Matfelon, the parish church founded in 1338.",
      "sourceSentenceIds": [
        28,
        22
      ],
      "sourceLabels": [
        "Web source 2",
        "Wikipedia"
      ],
      "source": "https://www.eastlondonhistory.co.uk/visit-whitechapel-east-london/"
    },
    {
      "id": 2,
      "text": "The Whitechapel Bell Foundry, once in the area, cast the Liberty Bell, Big Ben, and the Olympic Bell used at the 2012 Games.",
      "sourceSentenceIds": [
        24,
        29
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 2"
      ],
      "source": "https://en.wikipedia.org/wiki/Whitechapel"
    },
    {
      "id": 3,
      "text": "Whitechapel Gallery, opened in 1901, has long been a cultural outpost in a working‑class neighbourhood and still hosts cutting‑edge exhibitions.",
      "sourceSentenceIds": [
        7,
        18
      ],
      "sourceLabels": [
        "Web source 1",
        "Wikipedia"
      ],
      "source": "https://www.london-pages.co.uk/2025/02/27/exploring-the-historic-whitechapel-london/"
    },
    {
      "id": 4,
      "text": "Whitechapel station, originally called Whitechapel (Mile End), was redeveloped in 2010 and now serves as a key East London transport hub.",
      "sourceSentenceIds": [
        10,
        16
      ],
      "sourceLabels": [
        "Wikipedia",
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Whitechapel"
    },
    {
      "id": 5,
      "text": "The area once housed a thriving Jewish community, and its East London Mosque today reflects the district’s long‑standing multicultural heritage.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
