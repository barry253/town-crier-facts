  "facts": [
    {
      "id": 1,
      "text": "Akutan began in 1878 as a fur storage and trading port for the Western Fur & Trading Company.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://unangaxheritage.org/community/akutan",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The Pacific Whaling Company built a whale processing station across the bay from Akutan in 1912, the only whaling station in the Aleutians until 1939.",
      "sourceSentenceIds": [
        6,
        7
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Akutan%2C_Alaska",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "In June 1942, a Japanese A6M Zero fighter crashed on Akutan Island; the recovered aircraft, dubbed the Akutan Zero, helped U.S. tacticians develop dog‑fighting techniques.",
      "sourceSentenceIds": [
        23,
        24,
        25
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Akutan%2C_Alaska",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Water for Akutan comes from a local stream and dam built in 1927, ensuring a reliable supply for residents and fishermen.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Akutan%2C_Alaska",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Akutan lies in a maritime climate zone, where mild winters, cool summers, high winds, storms, and summer fog shape daily life.",
      "sourceSentenceIds": [
        15,
        16,
        17
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Akutan%2C_Alaska",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Akutan is a fishing community and the site of a traditional Unangan village, reflecting the enduring cultural heritage of the Native Village of Akutan.",
      "sourceSentenceIds": [
        30,
        29
      ],
      "sourceLabels": [
