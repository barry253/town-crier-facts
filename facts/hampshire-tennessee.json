  "facts": [
    {
      "id": 1,
      "text": "Before 1837, Hampshire was known as Love's Cross Roads, a name that echoed its early crossroads heritage.",
      "sourceSentenceIds": [
        1,
        14
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.natcheztracetravel.com/natchez-trace-tennessee/hohenwald-summertown-tn/hampshire-tennessee.html",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "In 1807, settlers crossed the Duck River at Gordon's Ferry on the Natchez Trace and founded what is now Hampshire.",
      "sourceSentenceIds": [
        11
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.natcheztracetravel.com/natchez-trace-tennessee/hohenwald-summertown-tn/hampshire-tennessee.html",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Since 1999, the Hampshire Museum has curated the community’s heritage, opening its doors to visitors each Thursday through Saturday.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.natcheztracetravel.com/natchez-trace-tennessee/hohenwald-summertown-tn/hampshire-tennessee.html",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Three award‑winning wineries—Amber Falls, Keg Springs, and Natchez Hills—dot Hampshire’s rolling hills, drawing wine lovers from across the state.",
      "sourceSentenceIds": [
        22
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.nashvillesbigbackyard.org/hampshire",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Each year Hampshire launches its Jubilee and Festival, featuring vendors, food trucks, and live music that celebrate local culture.",
