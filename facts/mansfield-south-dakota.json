  "facts": [
    {
      "id": 1,
      "text": "Mansfield was named for John Mansfield, an Irish immigrant who purchased the land in 1882 and sold lots for twenty-five dollars each.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://bchsofsd.com/mansfield/"
    },
    {
      "id": 2,
      "text": "John Mansfield helped bring the railroad to the site by persuading the company to lay a line through the town.",
      "sourceSentenceIds": [
        3,
        4
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Mansfield%2C_South_Dakota"
    },
    {
      "id": 3,
      "text": "The James River flows seven miles east of Mansfield, and the surrounding valley contains some of the richest farmland in South Dakota.",
      "sourceSentenceIds": [
        11
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Mansfield%2C_South_Dakota"
    },
    {
      "id": 4,
      "text": "Mansfield is widely known for its large variety of game and serves as a popular pheasant hunting venue.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Mansfield%2C_South_Dakota"
    },
    {
      "id": 5,
      "text": "Mansfield once straddled Brown and Spink Counties, with the county line dividing the store, depot, and saloon into two sides of the city.",
      "sourceSentenceIds": [
        13
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://bchsofsd.com/mansfield/"
    },
    {
      "id": 6,
      "text": "By 1910, Mansfield shipped four hundred fifty cars of grain and over thirty cars of potatoes in a single year.",
