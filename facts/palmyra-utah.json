  "facts": [
    {
      "id": 1,
      "text": "Palmyra was founded in 1852 on the Spanish Fork River by Latter-day Saint pioneers.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Palmyra%2C_Utah"
    },
    {
      "id": 2,
      "text": "Palmyra takes its name from Palmyra, New York, a site central to the origins of The Church of Jesus Christ of Latter-day Saints.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/palmyra_utah"
    },
    {
      "id": 3,
      "text": "Early settlers in Palmyra built rudimentary dugout homes due to limited materials when the community first formed.",
      "sourceSentenceIds": [
        27
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/palmyra_utah"
    },
    {
      "id": 4,
      "text": "The town of Palmyra was eventually abandoned sometime in 1856 under the advice of Brigham Young.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Palmyra%2C_Utah"
    },
    {
      "id": 5,
      "text": "Palmyra's early history included challenges like the Walker War, which prompted the construction of forts and heightened defenses.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/palmyra_utah"
    },
    {
      "id": 6,
      "text": "The Fort Palmyra monument serves as a historical tribute to the 1852 settlement and is maintained by the Daughters of Utah Pioneers.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/palmyra_utah"
    }
  ]
