  "facts": [
    {
      "id": 1,
      "text": "Louise is located in southern Humphreys County along Silver Creek in the Mississippi Delta region.",
      "sourceSentenceIds": [
        22
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Louise%2C_Mississippi"
    },
    {
      "id": 2,
      "text": "James S. Reid named the town for his daughter, Louise Reid Rainer, and recorded the town plat in 1906.",
      "sourceSentenceIds": [
        4,
        5
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Louise%2C_Mississippi"
    },
    {
      "id": 3,
      "text": "Louise was established in the 1880s as a railroad stop along the Yazoo and Mississippi Valley Railroad.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/louise_mississippi"
    },
    {
      "id": 4,
      "text": "The Bellgrade lumber company operated a mill in Louise from 1917 through 1936 with a high daily cutting capacity.",
      "sourceSentenceIds": [
        19,
        20
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Louise%2C_Mississippi"
    },
    {
      "id": 5,
      "text": "Louise was incorporated on December 8, 1909, and later became part of Humphreys County in 1918.",
      "sourceSentenceIds": [
        17,
        21
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Louise%2C_Mississippi"
    },
    {
      "id": 6,
      "text": "The town is located roughly five miles west of the Big Sunflower River within the vast alluvial Yazoo Basin.",
