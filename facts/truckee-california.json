  "facts": [
    {
      "id": 1,
      "text": "Truckee grew as a railroad town originally named Coburn Station, starting with the Transcontinental Railroad.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Truckee%2C_California",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town’s name honors a Paiute chief, whose assumed name was Tru-ki-zo, later shortened to Truckee.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Truckee%2C_California",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "In 1863, Joseph Gray’s Roadhouse on the trans‑Sierra wagon road became the first settlement called Gray’s Station.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Truckee%2C_California",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The historic Hilltop Lodge, once a 1940s restaurant, now serves as Cottonwood Restaurant and Bar.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Truckee%2C_California",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Truckee sits at the doorstep of Lake Tahoe and Donner Lake, offering year‑round outdoor adventures.",
