  "facts": [
    {
      "id": 1,
      "text": "Arlington sits along the Elkhorn River in Washington County, Nebraska, offering scenic river views for residents.",
      "sourceSentenceIds": [
        30
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Arlington%2C_Nebraska"
    },
    {
      "id": 2,
      "text": "Arlington was originally called Bell Creek and was platted in 1869 when the Sioux City and Pacific Railroad reached the area.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Arlington%2C_Nebraska"
    },
    {
      "id": 3,
      "text": "The town’s name changed to Arlington in 1882, after Arlington, Virginia, to avoid confusion with another Nebraska town.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Arlington%2C_Nebraska"
    },
    {
      "id": 4,
      "text": "Historic Sanborn Fire Insurance Maps of Arlington, dating back to 1894, provide a detailed visual record of the town’s early downtown layout.",
      "sourceSentenceIds": [
        13,
        17
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://hometownhistorymaps.com/pages/history-of-arlington-nebraska"
    },
    {
      "id": 5,
      "text": "The Sanborn maps show labeled businesses, industrial buildings, hotels, schools, and other landmarks that mattered to everyday life in Arlington.",
      "sourceSentenceIds": [
        14
      ],
