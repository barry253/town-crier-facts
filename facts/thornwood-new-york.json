  "facts": [
    {
      "id": 1,
      "text": "Thornwood’s name may come from an area in Glasgow, Scotland, giving the hamlet a touch of Scottish heritage.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Thornwood%2C_New_York"
    },
    {
      "id": 2,
      "text": "The historic Thornwood Station, still standing on Commerce Street, was once a stop on Metro‑North’s Harlem Line before electrification in the 1980s.",
      "sourceSentenceIds": [
        1,
        9
      ],
      "sourceLabels": [
        "Web source 2",
        "Wikipedia"
      ],
      "source": "https://www.trawellino.com/destinations/united-states/new-york_thornwood"
    },
    {
      "id": 3,
      "text": "A massive marble quarry once operated at the Four Corners intersection, supplying white marble that helped build St. Patrick’s Cathedral in New York City.",
      "sourceSentenceIds": [
        17,
        18,
        19
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Thornwood%2C_New_York"
    },
    {
      "id": 4,
      "text": "The quarry pit was filled in the mid‑1980s, and the Town Center shopping mall now sits on its former site.",
      "sourceSentenceIds": [
        20
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Thornwood%2C_New_York"
    },
    {
      "id": 5,
      "text": "Thornwood became a hamlet within the Town of Mount Pleasant in 1914 after the village of Sherman Park dissolved.",
      "sourceSentenceIds": [
        15
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Thornwood%2C_New_York"
    },
    {
      "id": 6,
      "text": "The station building remains on Commerce Street, but the stop was eliminated when the Harlem Line was electrified, making an elevated platform impractical.",
      "sourceSentenceIds": [
        9,
        10
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Thornwood%2C_New_York"
    }
  ]
