  "facts": [
    {
      "id": 1,
      "text": "Sumida ward, one of Tokyo’s 23 administrative divisions, was officially founded on March 15, 1947.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Sumida%2C_Tokyo",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The Tokyo Skytree, a 634‑meter broadcasting tower, dominates Sumida’s skyline and serves as a modern landmark.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Sumida%2C_Tokyo",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The Edo‑Tokyo Museum in Sumida chronicles the city’s evolution from the Edo period to the present day.",
      "sourceSentenceIds": [
        8,
        10,
        13
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://tokyotourists.com/sumida-tokyo/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Ryōgoku Kokugikan, Japan’s National Sumo Stadium, sits in Sumida and hosts professional sumo tournaments each year.",
      "sourceSentenceIds": [
        7,
        14
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Sumida%2C_Tokyo",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The Komagata Bridge, constructed in 1927, is a historic stone arch that spans the Sumida River within the ward.",
      "sourceSentenceIds": [
        19
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://en.jal.japantravel.com/guide/sumida-city-ward-landmarks-history/66664",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Kinshicho Station, the commercial heart of Sumida, is a major hub served by JR Sobu and Tokyo Metro Hanzomon lines.",
