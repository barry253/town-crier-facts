  "facts": [
    {
      "id": 1,
      "text": "Tidmore Bend takes its name from the Tidmore family, who first claimed land on the north side of the Coosa River in 1842.",
      "sourceSentenceIds": [
        17
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/tidmore_bend_alabama"
    },
    {
      "id": 2,
      "text": "By the mid‑1800s a ferry linked Tidmore Bend to steamboat routes across the Coosa, a feature absent before 1840.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/tidmore_bend_alabama"
    },
    {
      "id": 3,
      "text": "Before European settlement, the area was part of Cherokee ancestral territory, with river valley communities thriving by the late 1700s.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/tidmore_bend_alabama"
    },
    {
      "id": 4,
      "text": "The bend’s low‑relief hills and river terraces create habitats for endemic fish, mussels, and snails in the Coosa River basin.",
      "sourceSentenceIds": [
        23
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/tidmore_bend_alabama"
    },
    {
      "id": 5,
      "text": "Tidmore Bend enjoys a humid subtropical climate, averaging 57.6 inches of rain each year across 101 days.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/tidmore_bend_alabama"
    },
    {
      "id": 6,
      "text": "The CDP covers 9.64 square miles, centered at 34°02′N 85°55′W, with almost no water area.",
