  "facts": [
    {
      "id": 1,
      "text": "Mira Mesa name means \"Table View\" in Spanish, reflecting its early settlers' view of the surrounding hills.",
      "sourceSentenceIds": [
        19
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Mira_Mesa%2C_San_Diego",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The community grew rapidly after 1969, expanding from I-15 to I-805 over about 10,500 acres, one of the first sprawl areas along the corridor.",
      "sourceSentenceIds": [
        27
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Mira_Mesa%2C_San_Diego",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Hourglass Field, a former Navy auxiliary landing field, later became San Diego Miramar College and Hourglass Field Community Park.",
      "sourceSentenceIds": [
        25,
        29
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Mira_Mesa%2C_San_Diego",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Mira Mesa’s development was driven by nearby employers like UC San Diego, Marine Corps Air Station Miramar, Qualcomm, and biotech firms.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Mira_Mesa%2C_San_Diego",
      "category": "economy",
      "quality": "good"
    },
    {
