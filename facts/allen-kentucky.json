  "facts": [
    {
      "id": 1,
      "text": "Allen, Kentucky got its name in 1905 when a local storekeeper named T.J. Allen inspired the post office’s new title.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/allen_kentucky",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The Chesapeake and Ohio Railway’s station, once called Beaver Creek Junction, was renamed Allen in 1936 to stop mail mix‑ups.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/allen_kentucky",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The first post office in the area opened as Mouth of Beaver on August 21, 1854, reflecting the early river‑front settlement.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Allen%2C_Kentucky",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "After the 1794 Battle of Fallen Timbers, veterans from Virginia and other eastern states began claiming land in the Big Sandy Valley, including the future Allen area.",
      "sourceSentenceIds": [
        11
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/allen_kentucky",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Allen sits at the confluence of Beaver Creek and the Levisa Fork of the Big Sandy River, a north‑flowing tributary that feeds the Ohio River watershed.",
      "sourceSentenceIds": [
        13
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/allen_kentucky",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "A new bridge over the Levisa Fork in 1937 sparked the rise of 'New Allen,' a neighborhood that grew east of the original town.",
      "sourceSentenceIds": [
        25
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Allen%2C_Kentucky",
      "category": "history",
      "quality": "good"
    }
