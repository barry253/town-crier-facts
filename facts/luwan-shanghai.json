  "facts": [
    {
      "id": 1,
      "text": "Luwan was once the heart of old Shanghai’s French Concession, established in 1849, and still shows colonial‑era tree‑lined streets and villas.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.trawellino.com/destinations/china/shanghai_luwan",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The district’s name comes from “Lujia Wan” (盧家灣), meaning “Lu family’s bay,” a former river bend now covered by the city.",
      "sourceSentenceIds": [
        9,
        17,
        11
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/luwan_shanghai",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Luwan houses Fuxing Park, a well‑preserved traditional Chinese garden, and the bustling Huaihai Road, a major commercial street.",
      "sourceSentenceIds": [
        20
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.trawellino.com/destinations/china/shanghai_luwan",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Historic residences of Sun Yat‑sen, Mao Zedong, Zhou Enlai, Agnes Smedley and Mei Lanfang once stood in Luwan.",
      "sourceSentenceIds": [
        16
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Luwan%2C_Shanghai",
      "category": "people",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The area is a hub for Shanghainese cuisine, famous for xiaolongbao at Nanxiang Steamed Bun Restaurant.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.trawellino.com/destinations/china/shanghai_luwan",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Luwan’s revitalized Xintiandi area blends preserved historic neighborhoods with modern commercial use, balancing preservation and development.",
