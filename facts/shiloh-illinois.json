  "facts": [
    {
      "id": 1,
      "text": "Shiloh’s church got its name from ancient Jewish and Christian translations of “Shiloh,” which were seen as a reference to the Messiah.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://shilohil.org/residents/about-shiloh/",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Shiloh boasted Illinois’ first library, incorporated in 1839, before its books moved to Belleville in 1853 to form the state’s oldest library.",
      "sourceSentenceIds": [
        11,
        12,
        13
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://shilohil.org/residents/about-shiloh/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "In April 1807, a revival camp at Three Springs drew crowds, marking the first Methodist revival in St. Clair County and possibly the second in Illinois.",
      "sourceSentenceIds": [
        17,
        18
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Shiloh%2C_Illinois",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The park on Frank Scott Parkway houses two historic homes and the Engelmann family cemetery, preserving early settlers’ legacy.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://shilohil.org/residents/about-shiloh/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Gustav Bunsen, George Engelmann, Theodore Engelmann, and Gustave Koerner settled along Shiloh Station Road, shaping the village’s early community.",
