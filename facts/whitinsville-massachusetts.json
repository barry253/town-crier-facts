  "facts": [
    {
      "id": 1,
      "text": "Whitinsville was founded by the Whitin family, after whom the village is named.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Whitinsville%2C_Massachusetts",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The Whitin Machine, founded in 1831, became the world’s largest textile‑machinery manufacturer before closing in 1964.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Whitinsville%2C_Massachusetts",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Whitinsville is one of only four mill villages chosen by the John H. Chaffee Blackstone River Valley National Historic Corridor Commission.",
      "sourceSentenceIds": [
        11,
        12
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Whitinsville%2C_Massachusetts",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The Whitin Community Center, built by the Whitin family, housed a gym where 1936 Olympic back‑stroke champion Alice Bridges trained.",
      "sourceSentenceIds": [
        6,
        27,
        28
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1",
        "Web source 2"
      ],
      "source": "https://en.wikipedia.org/wiki/Whitinsville%2C_Massachusetts",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Whitinsville’s 7.5‑acre Whitin Park, behind the community center, was unveiled for restoration and beautification in early 2000.",
      "sourceSentenceIds": [
        15,
        25
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 2"
      ],
      "source": "https://en.wikipedia.org/wiki/Whitinsville%2C_Massachusetts",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The Main Street facade was restored in 1998‑99 with funds from locals, businesses, and the Massachusetts Historical Commission.",
      "sourceSentenceIds": [
        14,
