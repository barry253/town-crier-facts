  "facts": [
    {
      "id": 1,
      "text": "Bliss takes its name from early settler Sylvester Bliss, who purchased land in the early 1800s.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/bliss_new_york"
    },
    {
      "id": 2,
      "text": "Before settlers arrived, the area that is Bliss was part of the Seneca Nation’s hunting grounds within the Iroquois Confederacy.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/bliss_new_york"
    },
    {
      "id": 3,
      "text": "The arrival of the Rochester and State Line Railroad in 1878 created Bliss Station, sparking a boom in stores, a hotel, and a sawmill.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/bliss_new_york"
    },
    {
      "id": 4,
      "text": "Early transportation in Bliss moved from sled routes in the 1830s to hauling produce via the Erie Canal.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/bliss_new_york"
    },
    {
      "id": 5,
      "text": "Bliss sits in the valley of Wiscoy Creek, where the main stream meets its North Branch.",
      "sourceSentenceIds": [
        30
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Bliss%2C_New_York"
    },
    {
      "id": 6,
      "text": "Historic Sanborn Fire Insurance Maps from 1894, 1905, and 1912 let residents see how Bliss once looked.",
      "sourceSentenceIds": [
        15
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://hometownhistorymaps.com/pages/history-of-bliss-new-york"
    }
  ]
