  "facts": [
    {
      "id": 1,
      "text": "Tribune, Kansas, takes its name from the New York Tribune newspaper, honoring editor Horace Greeley who urged Americans to 'Go West, young man'.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Tribune%2C_Kansas",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town was founded in 1886 during the late 19th‑century westward expansion of Kansas.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Tribune%2C_Kansas",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "A Missouri Pacific Railroad depot opened in 1887, and Tribune was immediately named the county seat.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Tribune%2C_Kansas",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Between 1889 and 1890, a two‑story sandstone courthouse in simplified Italianate style cost $20,000 to build.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/Tribune,_Kansas",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The former courthouse now houses the Horace Greeley Museum, which served as the county’s administrative center until 1975 and is listed on the National Register of Historic Places.",
      "sourceSentenceIds": [
        11
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/Tribune,_Kansas",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Wheat is the primary crop in Tribune, supported by a semi‑arid climate, and the 1911 Tribune Branch Experiment Station researches feed and crop improvements.",
      "sourceSentenceIds": [
        14
      ],
