  "facts": [
    {
      "id": 1,
      "text": "Aston was first settled in 1682 and incorporated as a township in 1688, making it one of Pennsylvania’s earliest municipalities.",
      "sourceSentenceIds": [
        4,
        11
      ],
      "sourceLabels": [
        "Web source 1",
        "Wikipedia"
      ],
      "source": "https://astontownship.net/community/about-aston/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The township’s name changed from Northley to Aston by constable Edward Carter, who honored his hometown of Aston in Oxfordshire, England.",
      "sourceSentenceIds": [
        12,
        13
      ],
      "sourceLabels": [
        "Wikipedia",
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Aston_Township%2C_Pennsylvania",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "In 1906 Aston achieved first‑class township status, a key milestone in its local governance history.",
      "sourceSentenceIds": [
        14
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Aston_Township%2C_Pennsylvania",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The 1945 boundary change saw the northwestern portion of Aston split off to form the borough of Chester Heights, redefining the township’s limits.",
      "sourceSentenceIds": [
        15
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Aston_Township%2C_Pennsylvania",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The Seven Stars Inn on Concord Road hosted British General Cornwallis after the Brandywine battle in 1777, a notable moment in Revolutionary War history.",
      "sourceSentenceIds": [
        17
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Aston_Township%2C_Pennsylvania",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Concord Road was the colonial main thoroughfare between Chadds Ford and Chester, shaping early travel through the area.",
      "sourceSentenceIds": [
        16
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Aston_Township%2C_Pennsylvania",
