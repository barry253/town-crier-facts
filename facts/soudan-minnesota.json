  "facts": [
    {
      "id": 1,
      "text": "Soudan’s name was chosen by Bacon to contrast the harsh Minnesota winters with the tropical heat of Africa’s Sudan.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Soudan%2C_Minnesota"
    },
    {
      "id": 2,
      "text": "The village of Soudan was established on March 3, 1885, during the iron ore boom.",
      "sourceSentenceIds": [
        17
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Soudan%2C_Minnesota"
    },
    {
      "id": 3,
      "text": "The Duluth & Iron Range Railroad was built to serve the Soudan mines, linking the town to regional markets.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Soudan%2C_Minnesota"
    },
    {
      "id": 4,
      "text": "Soudan Underground Mine, now a state park, offers guided tours through its historic iron ore tunnels.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://triptap.com/locations/us/minnesota/soudan"
    },
    {
      "id": 5,
      "text": "Visitors can also explore the mine’s surface tours, learning about mining techniques and the town’s early industry.",
      "sourceSentenceIds": [
        16
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Soudan%2C_Minnesota"
    },
    {
      "id": 6,
      "text": "In 1903, Soudan’s company policy forbade stores and saloons, keeping the community strictly industrial.",
