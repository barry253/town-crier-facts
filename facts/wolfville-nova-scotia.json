      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The town hosts the Annapolis Valley Music Festival each year, where musicians from across the valley compete on Acadia’s campus.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
