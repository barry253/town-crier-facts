      "quality": "good"
    },
    {
      "id": 3,
      "text": "Wolfville’s Main Street once formed part of the New England Planters’ Post Road linking Halifax and Annapolis.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
