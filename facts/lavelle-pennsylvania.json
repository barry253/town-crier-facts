  "facts": [
    {
      "id": 1,
      "text": "Lavelle was originally called Salome, named after Salome Bolich, the wife of a pioneer settler, before being renamed around 1880.",
      "sourceSentenceIds": [
        1,
        2,
        14
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Lavelle%2C_Pennsylvania",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The first retail business in Lavelle was a general store opened by Thomas Edward Enterline, who also served as the village’s postmaster.",
      "sourceSentenceIds": [
        18,
        19
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Lavelle%2C_Pennsylvania",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "A 1895 powder‑mill explosion outside Lavelle destroyed ten buildings, prompting the mill’s closure the following year.",
      "sourceSentenceIds": [
        24,
        29
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Lavelle%2C_Pennsylvania",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The Schuylkill County Fair was held in Lavelle from 1886 through 1895, boosting the hamlet’s visibility.",
      "sourceSentenceIds": [
        20
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Lavelle%2C_Pennsylvania",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "In the mid‑1890s, residents donated land to build a public school that opened shortly thereafter.",
      "sourceSentenceIds": [
        21
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Lavelle%2C_Pennsylvania",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The Citizens Cemetery Association of Lavelle, incorporated in 1900, received a charter in 1903 to operate the village cemetery on Main Street.",
