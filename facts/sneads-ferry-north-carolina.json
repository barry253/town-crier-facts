      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Marine Corps Base Camp Lejeune, established in 1941 just north of Sneads Ferry, spurred economic growth through military jobs and spending.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
