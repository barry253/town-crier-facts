      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Plattsburg serves as the county seat of Clinton County and sits within the Kansas City metropolitan area in western Missouri.",
      "sourceSentenceIds": [
        20
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Plattsburg%2C_Missouri",
