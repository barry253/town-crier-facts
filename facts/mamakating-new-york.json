  "facts": [
    {
      "id": 1,
      "text": "Mamakating was established before Sullivan County, dating back to 1788, making it one of the oldest towns in the region.",
      "sourceSentenceIds": [
        14
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.visitmamakating.org/about-mamakating",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Manuel Gonsalus, first European immigrant, built a cabin on Route 209 circa 1700.",
      "sourceSentenceIds": [
        15
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.visitmamakating.org/about-mamakating",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The Delaware & Hudson Canal ran through Mamakating, and its historic linear park now spans the town’s entire length.",
      "sourceSentenceIds": [
        17,
        23
      ],
      "sourceLabels": [
        "Web source 1",
        "Web source 2"
      ],
      "source": "https://www.visitmamakating.org/about-mamakating",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The New York, Ontario and Western Railroad (O&W) brought tourists from 1868 to 1956, replacing canal traffic.",
      "sourceSentenceIds": [
        18,
        19
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.visitmamakating.org/about-mamakating",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The Hart House, a historic home, was listed on the National Register of Historic Places in 2006.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Mamakating%2C_New_York",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Mount Prosper, a resort community built in the 1890s, is also listed on the National Register of Historic Places.",
      "sourceSentenceIds": [
        11
      ],
