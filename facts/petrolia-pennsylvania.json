  "facts": [
    {
      "id": 1,
      "text": "Petrolia’s birth came with the 1872 “Fanny Jane” oil strike, producing 250‑300 barrels a day and drawing a rush of workers.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/petrolia_pennsylvania",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "By 1876 the town swelled to about 5,000 residents, yet its reputation stayed steadier than many boomtowns thanks to a more stable community.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/petrolia_pennsylvania",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Petrolia was officially incorporated as a borough in February 1873 after 103 citizens petitioned, marking its formal civic birth.",
      "sourceSentenceIds": [
        28
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/petrolia_pennsylvania",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The town’s early streets were built from hastily erected wooden homes and shops, spread across lands west of Bear Creek purchased from George H. Angell.",
      "sourceSentenceIds": [
        29
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/petrolia_pennsylvania",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Today, Petrolia covers only 0.4 square miles but still hosts industrial giants like Sonneborn Refined Products, keeping the oil scent alive.",
      "sourceSentenceIds": [
        23
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/petrolia_pennsylvania",
      "category": "other",
      "quality": "poor",
      "qualityReason": "census_demographic"
    },
    {
      "id": 6,
      "text": "In 2023 the borough celebrated its 150th anniversary with a time‑capsule burial that echoed its founding era and oil heritage.",
      "sourceSentenceIds": [
        24
      ],
