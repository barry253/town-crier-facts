    {
      "id": 2,
      "text": "The name Val Verde means “Green Valley” in Spanish, reflecting the area's lush, forested landscape.",
      "sourceSentenceIds": [
        21
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Val_Verde%2C_California"
    },
    {
      "id": 3,
      "text": "Nestled in the San Martinez Chiquito Canyon, the town sits between 1,250 and 1,400 feet above sea level.",
      "sourceSentenceIds": [
