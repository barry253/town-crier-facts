  "facts": [
    {
      "id": 1,
      "text": "Allgood got its name in December 1915 when a postmaster changed the village's spelling to his surname after a local lime maker complained about the confusing name Chepultepec.",
      "sourceSentenceIds": [
        1,
        21
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Allgood%2C_Alabama",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Founded in 1909, Allgood has evolved from humble beginnings into a vibrant town that celebrates its heritage while embracing progress.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.townofallgoodal.com/",
      "category": "history",
      "quality": "good",
      "qualityReason": "vague"
    },
    {
      "id": 3,
      "text": "A spur track from the L&N Railroad to a local lime plant let Allgood ship lime to other countries.",
      "sourceSentenceIds": [
        11
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.townofallgoodal.com/history",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The historic L&N Depot Station in Allgood once transported cross ties, cotton, cream, eggs, lime, cement, fertilizer, and farm products.",
      "sourceSentenceIds": [
        15
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.townofallgoodal.com/history",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Allgood was formally incorporated in 1959, marking its transition from a precinct to an official town.",
      "sourceSentenceIds": [
        22
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Allgood%2C_Alabama",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Allgood sits in south‑central Blount County’s Murphree Valley, flanked by Straight Mountain to the southeast and Red and Sand Mountains to the northwest.",
