      "id": 1,
      "text": "Villa Grove was founded on June 23, 1887 when railroad crews laid tracks from Danville to Tuscola.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://villagrove.org/about/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Villa Grove sits where Jordan Slough meets the Embarras River, a spot that has flooded many times in its history.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Villa_Grove%2C_Illinois",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The Douglas County Illinois Historical Society in Villa Grove preserves artifacts and photographs of the county’s early settlers and Native American history.",
      "sourceSentenceIds": [
        3,
        26
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://museumsdatabase.com/museums/view/8749",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "In the 1940s, Villa Grove hosted Pancake Festivals that drew crowds of over 10,000 people.",
      "sourceSentenceIds": [
        30
