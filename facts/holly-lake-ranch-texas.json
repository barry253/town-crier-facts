  "facts": [
    {
      "id": 1,
      "text": "Holly Lake Ranch started as a 4,165‑acre resort in the 1970s, with cabins and a lake built after damming Holly Creek.",
      "sourceSentenceIds": [
        13,
        20,
        22
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Holly_Lake_Ranch%2C_Texas",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The community’s name comes from the lake formed by damming Holly Creek, which now hosts a 210‑acre lake and several smaller lakes.",
      "sourceSentenceIds": [
        13,
        23
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Holly_Lake_Ranch%2C_Texas",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "In 1969 Dallas developers Bill McKenzie and Jack Wilson bought the ranch, launching a master plan that still shapes the layout today.",
      "sourceSentenceIds": [
        17,
        18,
        19
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Holly_Lake_Ranch%2C_Texas",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Holly Lake Ranch is a gated, private community that grew from a weekend escape into a thriving residential area with over 2,000 homes.",
      "sourceSentenceIds": [
        4,
        5
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Holly_Lake_Ranch%2C_Texas",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The ranch’s slogan, “It’s Texas’ Best Kept Secret,” reflects its hidden‑gem reputation among Wood County residents.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Holly_Lake_Ranch%2C_Texas",
      "category": "culture",
      "quality": "poor",
      "qualityReason": "editorial_filler"
    },
    {
      "id": 6,
      "text": "The area enjoys mild winters and lies only 30 miles east of Tyler, balancing seclusion with easy access to larger cities.",
