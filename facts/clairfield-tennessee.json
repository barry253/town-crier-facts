  "facts": [
    {
      "id": 1,
      "text": "Clairfield began as a company town when timber magnate Alexander Arthur bought land in the 1880s and planned a major industrial center.",
      "sourceSentenceIds": [
        7,
        8
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Clairfield%2C_Tennessee"
    },
    {
      "id": 2,
      "text": "By 1910, three coal companies—King Mountain, New Jellico, and Standard Coal and Coke—produced 750 tons of coal daily in Clairfield.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Clairfield%2C_Tennessee"
    },
    {
      "id": 3,
      "text": "The 1905 railroad linking Clear Fork to Jellico and Middlesboro opened the valley to large‑scale coal mining.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Clairfield%2C_Tennessee"
    },
    {
      "id": 4,
      "text": "Clairfield occupies a broad hollow along the Clear Fork, just east of the Claiborne‑Campbell line and south of the Tennessee‑Kentucky border.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Clairfield%2C_Tennessee"
    },
    {
      "id": 5,
      "text": "In the 19th century, the Clearfork Valley stayed sparsely populated because of limited bottomlands, poor soil, and its isolation.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Clairfield%2C_Tennessee"
    },
    {
      "id": 6,
      "text": "After World War II, mechanization and surface mining reduced labor needs, leading to a decline throughout the Clearfork Valley.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Clairfield%2C_Tennessee"
    }
  ]
