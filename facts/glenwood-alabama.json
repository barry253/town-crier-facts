  "facts": [
    {
      "id": 1,
      "text": "Glenwood was founded in 1896 when the Central of Georgia Railway built a line through the area.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/glenwood_alabama"
    },
    {
      "id": 2,
      "text": "The town dug the Flowing Well in 1909, an artesian well that still supplies clean water and serves as a community gathering spot.",
      "sourceSentenceIds": [
        11
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/glenwood_alabama"
    },
    {
      "id": 3,
      "text": "Glenwood hosts an annual \"Festival at the Well\" celebrating its heritage and the artesian well.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://encyclopediaofalabama.org/article/glenwood/"
    },
    {
      "id": 4,
      "text": "The Glenwood Mining Company operated from 1953 to about 1973, extracting local iron ore.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://encyclopediaofalabama.org/article/glenwood/"
    },
    {
      "id": 5,
      "text": "Glenwood officially became an incorporated town in 1907, solidifying its municipal status.",
      "sourceSentenceIds": [
        14
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Glenwood%2C_Alabama"
    },
    {
      "id": 6,
      "text": "The town's commercial nursery industry grew in 1905 thanks to abundant evergreen ferns.",
