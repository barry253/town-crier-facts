  "facts": [
    {
      "id": 1,
      "text": "Rapelje was originally Lake Basin, renamed in 1913 after John M. Rapelje, a Northern Pacific Railway executive.",
      "sourceSentenceIds": [
        1,
        3,
        5,
        16,
        25
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Rapelje%2C_Montana",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Rapelje replaced the nearby Lake Basin town, located just east, and now hosts four historic grain elevators that still stand.",
      "sourceSentenceIds": [
        7,
        12,
        18
      ],
      "sourceLabels": [
        "Web source 1",
        "Web source 2"
      ],
      "source": "https://www.mtmemory.org/nodes/view/127885",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The post office opened in 1913, and the town’s school, built in 1920, still serves the community.",
      "sourceSentenceIds": [
        18,
        13
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 2"
      ],
      "source": "https://en.wikipedia.org/wiki/Rapelje%2C_Montana",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Every June, volunteers run the 24‑Hours of Rapelje, a USA Cycling‑sanctioned endurance mountain‑bike race.",
      "sourceSentenceIds": [
        22,
        23
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Rapelje%2C_Montana",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Rapelje sits at the end of a Northern Pacific branch line from Laurel, making it a key grain‑shipping hub today.",
      "sourceSentenceIds": [
        26
      ],
