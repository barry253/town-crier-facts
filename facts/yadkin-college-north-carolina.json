  "facts": [
    {
      "id": 1,
      "text": "Yadkin College was founded in 1856 by the Methodist Protestant Church on land donated by Henry W., establishing the first higher‑education institution in the area.",
      "sourceSentenceIds": [
        26
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.ncpedia.org/yadkin-college",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "After being rechartered in 1861, the college closed during the Civil War, reopened briefly as a preparatory program in 1865, and then resumed as a secondary school in 1867.",
      "sourceSentenceIds": [
        27,
        28
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.ncpedia.org/yadkin-college",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "In 1873 Shadrach Simpson became president, introduced a college curriculum, admitted women for the first time, and built a new three‑story building.",
      "sourceSentenceIds": [
        29
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.ncpedia.org/yadkin-college",
      "category": "people",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The campus was abandoned in 1924 after consolidating with what is now High Point University, ending its independent operation.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.dncr.nc.gov/blog/2024/01/10/yadkin-college-k-24",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The Yadkin College Historic District was added to the National Register of Historic Places in 1988, preserving its historic buildings.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Yadkin_College%2C_North_Carolina",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Contrary to its name, Yadkin College sits in Davidson County, not Yadkin County, a fact that often surprises visitors.",
