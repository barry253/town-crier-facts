  "facts": [
    {
      "id": 1,
      "text": "Mauston’s name comes from its founder, Milton Maugh, who originally called the settlement “Maughs Town.”.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.mauston.com/our-city",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The city’s early growth was driven by the lumber industry, which attracted workers and businesses to the area.",
      "sourceSentenceIds": [
        15
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Mauston%2C_Wisconsin",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The Benjamin Boorman House on Union Street now houses the town’s historical artifacts and tells Mauston’s story.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Mauston%2C_Wisconsin",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Mauston serves as the county seat of Juneau County, making it the administrative hub of the region.",
      "sourceSentenceIds": [
        13
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Mauston%2C_Wisconsin",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The Canadian Pacific Kansas City Tomah Subdivision, once the Milwaukee Road main line, still runs through Mauston, linking it to Chicago and Seattle.",
