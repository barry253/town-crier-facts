  "facts": [
    {
      "id": 1,
      "text": "Kings Bay Base became the East Coast’s main nuclear submarine hub in 1979, hosting ballistic missile submarines ever since.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://en-academic.com/dic.nsf/enwiki/1230041",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The land that is now Kings Bay once served as a plantation and a minor fort during the War of 1812.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.kingsbayhousing.com/history",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "In 1954 the U.S. Army built an ocean terminal at Kings Bay for ammunition shipments in case of national emergency.",
      "sourceSentenceIds": [
        16
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.kingsbayhousing.com/history",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "July 1979 saw the first submarine, the USS James Monroe, porting into Kings Bay after the base’s reconstruction.",
      "sourceSentenceIds": [
        20
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.kingsbayhousing.com/history",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "By 1989 Kings Bay had shifted to a Trident base, becoming the primary homeport for Ohio‑class ballistic missile submarines.",
      "sourceSentenceIds": [
        23
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.kingsbayhousing.com/history",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The Strategic Weapons Facility Atlantic, located near Kings Bay, supports U.S. strategic deterrence operations.",
      "sourceSentenceIds": [
        29
