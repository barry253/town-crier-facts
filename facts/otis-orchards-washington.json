  "facts": [
    {
      "id": 1,
      "text": "Otis Orchards was once the heart of Washington’s first commercial apple‑growing region, thanks to mild climate, rich soil, irrigation and railroads.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://spokanehistorical.org/items/show/529",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "In 1903 the Spokane Canal Company finished a drainage ditch from Newman Lake that fed 2,750 acres of Otis Orchards, turning the area into a fertile apple paradise.",
      "sourceSentenceIds": [
        23
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://spokanehistorical.org/items/show/529",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The 1908 Spokane National Apple Show launched in the city aimed to make the valley a major fruit distribution center, highlighting Otis Orchards’ prominence.",
      "sourceSentenceIds": [
        17
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://spokanehistorical.org/items/show/529",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "By 1913, Otis Orchards was planting two million new apple trees each year, but over‑promotion and falling prices forced many growers to abandon the orchards.",
      "sourceSentenceIds": [
        27
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://spokanehistorical.org/items/show/529",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The area’s canals once dominated the landscape, earning Otis Orchards the nickname “Eden of America” in early promotional ads.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://spokanehistorical.org/items/show/529",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "In 2000s, part of Otis Orchards was annexed into the new city of Spokane Valley, blending historic orchard land with modern urban growth.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
