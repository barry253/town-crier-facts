      "id": 1,
      "text": "Southern Gateway’s Welcome Center sits at the northern end of the Chesapeake Bay Bridge & Tunnel, ready to guide travelers through the Eastern Shore.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Web source 1"
      ],
