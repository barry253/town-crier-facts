  "facts": [
    {
      "id": 1,
      "text": "Noma traces its origins to 1882, when the area was first settled during a period of expansion in northern Holmes County.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://nomafl.com/history-of-noma",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Noma’s name is historically linked to the Noma Mill Company, a timber milling operation that played a significant role in the town’s early economy.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://nomafl.com/history-of-noma",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The community formally organized its local government when Noma was incorporated in July 1904, allowing residents to manage municipal affairs.",
      "sourceSentenceIds": [
        20
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://nomafl.com/history-of-noma",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Lumber production drove settlement; the presence of a mill helped establish Noma as a recognized community during the late nineteenth and early twentieth centuries.",
      "sourceSentenceIds": [
        19
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://nomafl.com/history-of-noma",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Today, Noma continues to serve as a quiet residential community in northern Holmes County, located just south of the Alabama state line.",
      "sourceSentenceIds": [
        26
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://nomafl.com/history-of-noma",
      "category": "other",
      "quality": "poor",
      "qualityReason": "location_description"
    },
    {
      "id": 6,
      "text": "Noma’s history is defined not by growth, but by resilience, continuity, and the lasting contributions of the people who have called it home for more than a century.",
      "sourceSentenceIds": [
        3
      ],
