  "facts": [
    {
      "id": 1,
      "text": "Ruth got its name from a mining claim named after Ruth McDonald, the daughter of the claim’s original owner.",
      "sourceSentenceIds": [
        3,
        6
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 2"
      ],
      "source": "https://en.wikipedia.org/wiki/Ruth%2C_Nevada",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Ruth was founded in 1903 as a company town for the White Pine Copper Company.",
      "sourceSentenceIds": [
        5,
        13,
        16
      ],
      "sourceLabels": [
        "Web source 2",
        "Wikipedia"
      ],
      "source": "https://www.whitepinecounty.net/388/Ruth",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "In 1929, Ruth produced more than 200 million pounds of copper, the peak of its mining output.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://unitedstatesghosttowns.com/ruth-nevada-ghost-town/",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The Nevada Northern Railway began service in 1906, and the town later hosted the BHP Nevada Railroad from 1996 to 1999.",
      "sourceSentenceIds": [
        17,
        8,
        14
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 2"
      ],
      "source": "https://en.wikipedia.org/wiki/Ruth%2C_Nevada",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Ruth was moved at least five times between 1903 and the 1950s, a testament to its company‑controlled resilience.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://unitedstatesghosttowns.com/ruth-nevada-ghost-town/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The Robinson Mine, adjacent to Ruth, remains in operation as of 2022, keeping the town’s mining heritage alive.",
