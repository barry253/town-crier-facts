  "facts": [
    {
      "id": 1,
      "text": "Elizabethton was founded in 1799 and became the county seat of Carter County, Tennessee.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://elizabethton.org/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town sits at the confluence of the Watauga and Doe Rivers, where early settlers built a railroad yard connecting to the ET&WNC.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Elizabethton%2C_Tennessee",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Elizabethton is the historic site of the first independent American government, the Watauga Association, formed in 1772.",
      "sourceSentenceIds": [
        22
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Elizabethton%2C_Tennessee",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The annual Covered Bridge Days festival celebrates the town’s historic covered bridge park, a landmark of Appalachian architecture.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://americannomadtraveler.com/2025/08/19/elizabethton-tn-a-historic-gem-in-the-appalachian-highlands/",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Elizabethton’s name honors Elizabeth, the wife of early settler John Sevier, who helped defend the stockade fort along the Watauga River.",
      "sourceSentenceIds": [
        8
      ],
