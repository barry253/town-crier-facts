  "facts": [
    {
      "id": 1,
      "text": "West Farms was founded in 1666 when Edward Jessup and John Richardson received a royal land grant, carving the area out of Westchester.",
      "sourceSentenceIds": [
        2,
        23
      ],
      "sourceLabels": [
        "Web source 1",
        "Wikipedia"
      ],
      "source": "https://www.cityneighborhoods.nyc/west-farms",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "By the mid‑19th century, West Farms already had about 1,000 residents and 200 houses, making it one of the Bronx’s earliest communities.",
      "sourceSentenceIds": [
        11,
        29
      ],
      "sourceLabels": [
        "Web source 2",
        "Wikipedia"
      ],
      "source": "https://evaluatingurbanplaces.com/2025/03/02/west-farms-one-of-bronxs-original-railroad-suburbs-but-present-day-dense-south-bronx-community/",
      "category": "people",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The 1840s Bronx River Railroad and the 1887 Third Avenue Elevated Line turned West Farms into a desirable commuter suburb for Manhattan workers.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.cityneighborhoods.nyc/west-farms",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "During the American Revolution, West Farms joined forces with Fordham to form a joint militia company after local engagements.",
      "sourceSentenceIds": [
        27
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/West_Farms%2C_Bronx",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The western half of West Farms showcases well‑preserved 1920s brick apartment buildings and rowhouses that reflect its early 20th‑century growth.",
      "sourceSentenceIds": [
        12
