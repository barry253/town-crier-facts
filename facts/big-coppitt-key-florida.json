      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The island first linked to the mainland when Henry Flagler’s Florida East Coast Railway built a railroad fill to nearby Shark Key in the early 1900s.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 2"
      ],
