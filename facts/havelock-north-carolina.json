  "facts": [
    {
      "id": 1,
      "text": "Havelock was originally called \"Havelock Station\" when the Atlantic and North Carolina Railroad built a depot in the late 1850s.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Havelock%2C_North_Carolina",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The city takes its name from Sir Henry Havelock, a British officer celebrated for rescuing hostages during the 1857 Indian Mutiny.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Havelock%2C_North_Carolina",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Union troops used Havelock as a launch point for the 1862 capture of New Bern and the subsequent assault on Fort Macon.",
      "sourceSentenceIds": [
        15
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Havelock%2C_North_Carolina",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The Havelock Tourist & Events Center displays a Civil War fort diorama and other artifacts that chronicle the town’s Civil War history.",
      "sourceSentenceIds": [
        11
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Havelock%2C_North_Carolina",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Havelock is home to Marine Corps Air Station Cherry Point, the world’s largest Marine Corps air station and base of the 2nd Marine Aircraft Wing.",
      "sourceSentenceIds": [
        17
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Havelock%2C_North_Carolina",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Havelock was the initial landing site for the Battle of New Bern, making it a key location in the Civil War’s North Carolina campaign.",
      "sourceSentenceIds": [
        25
      ],
      "sourceLabels": [
        "Wikipedia"
