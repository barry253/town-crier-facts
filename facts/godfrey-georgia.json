      "quality": "good"
    },
    {
      "id": 2,
      "text": "A post office operated in Godfrey from 1889 until 1965, serving the local population for over seven decades.",
      "sourceSentenceIds": [
        14
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Godfrey%2C_Georgia",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Godfrey incorporated as a town in 1906, only to have its charter dissolved in 1995 after nearly nine decades of existence.",
      "sourceSentenceIds": [
        15,
        16
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Godfrey%2C_Georgia",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Godfrey once boasted eight stores, a bank, barber shop, livery stable, icehouse, cotton gin, warehouse, peach shed, railroad depot, post office, and Walton's Mill.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
