  "facts": [
    {
      "id": 1,
      "text": "Lawtonka Acres was once part of the expansive Kiowa-Comanche-Apache Reservation in southwestern Oklahoma's Comanche County.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/lawtonka_acres_oklahoma"
    },
    {
      "id": 2,
      "text": "President William McKinley opened millions of acres of this reservation to non-Indian settlement through a federal land lottery in 1901.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/lawtonka_acres_oklahoma"
    },
    {
      "id": 3,
      "text": "Lawtonka Acres sits at the north end of Lake Lawtonka, a reservoir formed by damming Medicine Creek.",
      "sourceSentenceIds": [
        6,
        23
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Lawtonka_Acres%2C_Oklahoma"
    },
    {
      "id": 4,
      "text": "Citizens of Lawton completed the man-made Lake Lawtonka in 1907 using an earthen and masonry dam.",
      "sourceSentenceIds": [
        30
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/lawtonka_acres_oklahoma"
    },
    {
      "id": 5,
      "text": "Lawtonka Acres borders the Wichita Mountains Wildlife Refuge, which preserves steep granitic peaks and canyons.",
