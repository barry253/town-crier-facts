  "facts": [
    {
      "id": 1,
      "text": "Cass was named after Joseph Kerr Cass, the vice president and cofounder of the West Virginia Pulp and Paper Company.",
      "sourceSentenceIds": [
        1,
        6
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 2"
      ],
      "source": "https://en.wikipedia.org/wiki/Cass%2C_West_Virginia"
    },
    {
      "id": 2,
      "text": "The West Virginia Pulp and Paper Company built Cass from scratch in 1900 with fifty-two white houses divided into three strict classes.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://wheninyourstate.com/west-virginia/cass-multi-ethnic-company-town-rise-and-fall/"
    },
    {
      "id": 3,
      "text": "A large band sawmill at the mouth of Leatherbark Creek once processed red spruce and hardwoods from the surrounding Cheat Mountain region.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/cass_west_virginia"
    },
    {
      "id": 4,
      "text": "The Cass Scenic Railroad State Park preserves steam locomotives and rail cars that once hauled logs down steep mountain inclines.",
      "sourceSentenceIds": [
        13
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/cass_west_virginia"
    },
    {
      "id": 5,
      "text": "Bald Knob summit sits about four miles northeast of Cass at an elevation of over four thousand eight hundred feet.",
      "sourceSentenceIds": [
        15
