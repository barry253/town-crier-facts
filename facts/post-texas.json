  "facts": [
    {
      "id": 1,
      "text": "Post was founded in 1907 by cereal magnate Charles William Post as a “dream city.”.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://postcitytexas.com/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The city’s name honors Fort Phantom Hill, with early settlers seeking fertile land.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.cityofposttexas.com/",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Post’s historic downtown features restored buildings, including the Algerita Hotel, a gin, and a textile plant.",
      "sourceSentenceIds": [
        25
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.cityofposttexas.com/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "In 1907 a post office began in a tent, later becoming the town’s first post office.",
      "sourceSentenceIds": [
        28
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.cityofposttexas.com/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Post sits on the southeastern edge of the Great Plains, near the caprock escarpment of the Llano Estacado.",
