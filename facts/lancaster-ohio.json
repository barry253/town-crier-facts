  "facts": [
    {
      "id": 1,
      "text": "Founded in 1800 by Ebenezer Zane on land awarded for blazing Zane’s Trace, Lancaster began as a frontier outpost.",
      "sourceSentenceIds": [
        4,
        7,
        30
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 2"
      ],
      "source": "https://en.wikipedia.org/wiki/Lancaster%2C_Ohio",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Early settlers traveling the 266‑mile Zane’s Trace came from Lancaster, Pennsylvania, giving the new town its name.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.britannica.com/place/Lancaster-Ohio",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The Ohio Glass Museum, opened in 2002, honors more than a century of glassmaking that once drove Fairfield County’s economy.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Lancaster%2C_Ohio",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The Lancaster Lateral Canal, finished in 1808, connected the town to the Ohio and Erie Canal, opening trade routes.",
      "sourceSentenceIds": [
        15
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.britannica.com/place/Lancaster-Ohio",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The Muskingum Valley Railroad arrived in 1851, and natural gas was discovered nearby in 1887, accelerating local growth.",
      "sourceSentenceIds": [
        15
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.britannica.com/place/Lancaster-Ohio",
      "category": "transport",
      "quality": "poor",
      "qualityReason": "location_description"
    },
    {
      "id": 6,
      "text": "Located on the Hocking River, Lancaster lies about 33 miles southeast of Columbus within the larger metropolitan area.",
