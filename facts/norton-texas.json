  "facts": [
    {
      "id": 1,
      "text": "Norton was founded in 1903 and named after George W. Norton, a businessman who owned the townsite land.",
      "sourceSentenceIds": [
        1,
        21
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Norton%2C_Texas"
    },
    {
      "id": 2,
      "text": "The town sits on Farm Road 383 in west‑central Runnels County, a detail that marks its rural setting.",
      "sourceSentenceIds": [
        2,
        5
      ],
      "sourceLabels": [
        "Web source 1",
        "Web source 2"
      ],
      "source": "https://www.tshaonline.org/handbook/entries/norton-tx"
    },
    {
      "id": 3,
      "text": "The first houses appeared in 1901, and a school opened the same year, giving the community its first public building.",
      "sourceSentenceIds": [
        24
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.tshaonline.org/handbook/entries/norton-tx"
    },
    {
      "id": 4,
      "text": "A post office opened in 1894, moved in 1902, and helped keep Norton connected to the wider world.",
      "sourceSentenceIds": [
        22,
        23
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.tshaonline.org/handbook/entries/norton-tx"
    },
    {
      "id": 5,
      "text": "In 1912 a cyclone struck Norton, killing one resident and damaging several buildings, a reminder of the town’s weather challenges.",
      "sourceSentenceIds": [
        26
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.tshaonline.org/handbook/entries/norton-tx"
    },
    {
      "id": 6,
      "text": "Norton has stayed a small town, serving the surrounding rural area while preserving its early 20th‑century character.",
      "sourceSentenceIds": [
        27
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.tshaonline.org/handbook/entries/norton-tx"
