  "facts": [
    {
      "id": 1,
      "text": "Founded in 1786 by French farmers, Dearborn grew into Michigan’s seventh‑largest city when it incorporated in 1929.",
      "sourceSentenceIds": [
        14,
        21
      ],
      "sourceLabels": [
        "Web source 1",
        "Web source 2"
      ],
      "source": "https://dearborn.gov/about-us"
    },
    {
      "id": 2,
      "text": "The city’s name honors Henry Dearborn, a Revolutionary War hero who served as Secretary of War under President Jefferson.",
      "sourceSentenceIds": [
        15
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://facts.net/world/cities/30-facts-about-dearborn-michigan/"
    },
    {
      "id": 3,
      "text": "Ford Motor Company, founded in 1903, keeps its headquarters in Dearborn, making the city a lifelong hub of automotive innovation.",
      "sourceSentenceIds": [
        16
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://facts.net/world/cities/30-facts-about-dearborn-michigan/"
    },
    {
      "id": 4,
      "text": "The Henry Ford museum, the largest indoor‑outdoor historic complex in the U.S., opened in 2005 to celebrate Arab‑American heritage.",
      "sourceSentenceIds": [
        25,
        27
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 2"
      ],
      "source": "https://en.wikipedia.org/wiki/Dearborn%2C_Michigan"
    },
    {
      "id": 5,
      "text": "The Ford Rouge Complex, once the world’s largest integrated factory, occupies a 3,000‑acre site that once powered the global automotive industry.",
      "sourceSentenceIds": [
        23
