  "facts": [
    {
      "id": 1,
      "text": "Arnot began as the coal town Draketown in 1866, founded by the Blossburg Coal Mining and Railroad Company.",
      "sourceSentenceIds": [
        2,
        12
      ],
      "sourceLabels": [
        "Web source 2",
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/arnot_pennsylvania",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The village was renamed Arnot in 1868 after banker John Arnot, who helped finance the company.",
      "sourceSentenceIds": [
        6,
        18
      ],
      "sourceLabels": [
        "Web source 2",
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/arnot_pennsylvania",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "By 1883, Arnot had grown to Tioga County’s largest town, with 3,500–4,000 residents and a booming semi‑bituminous coal industry.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/arnot_pennsylvania",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The town’s first post office opened in 1868, reflecting its swift transition from a mining camp to an organized community.",
      "sourceSentenceIds": [
        6,
        7
      ],
      "sourceLabels": [
        "Web source 2",
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/arnot_pennsylvania",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Arnot sits off U.S. Route 15, just north of the borough of Blossburg, and is part of Tioga County’s historic coal corridor.",
