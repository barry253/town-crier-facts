  "facts": [
    {
      "id": 1,
      "text": "The 1862 Battle of Birch Coulee, one of the deadliest US‑Dakota War clashes, took place where Morton now stands.",
      "sourceSentenceIds": [
        16,
        2
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Morton%2C_Minnesota",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Morton was named for its founder, Morton, after the town was platted in 1882.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/morton_minnesota",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "From 1884, Morton’s granite quarry produced Morton gneiss for railroad ballast, employing up to 300 workers by 1886.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/morton_minnesota",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The 1851 Treaty of Traverse des Sioux ceded 21 million acres, including Morton’s area, to the U.S. for seven‑and‑a‑half cents per acre.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/morton_minnesota",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Morton is the administrative headquarters of the Lower Sioux Indian Reservation, serving as its central hub.",
