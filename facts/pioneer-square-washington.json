  "facts": [
    {
      "id": 1,
      "text": "Pioneer Square takes its name from a small triangular plaza near the corner of First Avenue and Yesler Way, originally called Pioneer Place.",
      "sourceSentenceIds": [
        27
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Pioneer_Square%2C_Seattle"
    },
    {
      "id": 2,
      "text": "In 1852 the first permanent white settlers chose the area that is now Pioneer Square because it was the only flat spot along Elliott Bay's protected harbor.",
      "sourceSentenceIds": [
        21
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.seattle.gov/neighborhoods/historic-preservation/historic-districts/pioneer-square-preservation-district"
    },
    {
      "id": 3,
      "text": "Father Francis Xavier Prefontaine founded Seattle's first Catholic church, the Church of Our Lady of Good Help, in Pioneer Square in 1870.",
      "sourceSentenceIds": [
        25
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Pioneer_Square%2C_Seattle"
    },
    {
      "id": 4,
      "text": "The early wooden buildings of Pioneer Square were almost all destroyed in the Great Seattle Fire of 1889.",
      "sourceSentenceIds": [
        30
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Pioneer_Square%2C_Seattle"
    },
    {
      "id": 5,
      "text": "King Street Station, opened to the public in 1906, remains a key historic asset in Pioneer Square.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://pioneersquare.org/"
    },
    {
      "id": 6,
      "text": "The 1962 Seattle Hotel was replaced by a parking garage known as the “Sinking Ship,” still standing today in Pioneer Square.",
