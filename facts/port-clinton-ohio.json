      "quality": "good"
    },
    {
      "id": 2,
      "text": "Dubbed the “Walleye Capital of the World,” Port Clinton celebrates its fishing heritage with an annual Walleye Drop on New Year’s Eve.",
      "sourceSentenceIds": [
        1,
        18
      ],
      "sourceLabels": [
