      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Ida Rupp Public Library, the city’s main library, also operates satellite branches in Marblehead and Put‑in‑Bay.",
      "sourceSentenceIds": [
        14
      ],
      "sourceLabels": [
