      ],
      "source": "https://en.wikipedia.org/wiki/Port_Clinton%2C_Ohio",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The Wolcott Keeper’s House, built in the early 1800s for the first lighthouse keeper Benajah Wolcott, now stands restored by the Ottawa County Historical Society.",
      "sourceSentenceIds": [
        3,
        9
      ],
      "sourceLabels": [
