  "facts": [
    {
      "id": 1,
      "text": "Mission Hills grew from the 1950s Dennis Park subdivision, renamed after a 1956 vote that favored the historic Mission name.",
      "sourceSentenceIds": [
        9,
        11,
        12,
        13
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.mhnconline.org/history/"
    },
    {
      "id": 2,
      "text": "The San Fernando Mission, founded in 1797, sits in Mission Hills and remains an active Roman Catholic parish today.",
      "sourceSentenceIds": [
        1,
        4,
        19
      ],
      "sourceLabels": [
        "Web source 1",
        "Web source 2"
      ],
      "source": "https://www.mhnconline.org/history/"
    },
    {
      "id": 3,
      "text": "Andrés Pico Adobe, built around 1834, is the second‑oldest adobe home in Los Angeles County and a Mission Hills landmark.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.mhnconline.org/history/"
    },
    {
      "id": 4,
      "text": "Mission Hills hosts the Bear Pit, a community gathering spot that opened in 1954 and has been a local icon for over five decades.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.mhnconline.org/history/"
    },
    {
      "id": 5,
      "text": "In the early 1950s, Dennis Park Bakery became a neighborhood staple, remembered by many long‑time residents.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.mhnconline.org/history/"
    },
    {
      "id": 6,
      "text": "The original Mission San Fernando aqueduct, completed in 1811, stretched more than a mile to supply water to the mission’s fountain.",
      "sourceSentenceIds": [
        20,
        24
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.californiafrontier.net/mission-san-fernando-facts/"
    }
  ]
