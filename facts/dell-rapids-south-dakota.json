    },
    {
      "id": 2,
      "text": "The Chicago, Milwaukee, and Saint Paul Railroad reached Dell Rapids in 1881, linking it to Egan.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Dell_Rapids%2C_South_Dakota"
    },
    {
      "id": 3,
      "text": "After a main‑street fire, the town was rebuilt entirely in Sioux Quartzite, the same stone that shaped Wallace Dow’s Grand Opera House.",
      "sourceSentenceIds": [
        13,
        5
      ],
      "sourceLabels": [
