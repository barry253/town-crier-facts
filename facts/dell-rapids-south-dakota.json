    },
    {
      "id": 4,
      "text": "Dell Rapids hosts July’s “Quarry Days” and June’s “Cootie Days,” featuring rides and games in the city park.",
      "sourceSentenceIds": [
        14
      ],
      "sourceLabels": [
        "Wikipedia"
