  "facts": [
    {
      "id": 1,
      "text": "The Glico Man sign, installed in 1935, shows a giant athlete on a blue track and has become a symbol of Glico candy.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/D%C5%8Dtonbori",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Matsudaira Tadaaki named the canal and avenue Dōtonbori, with “bori” from “hori” meaning canal, even though Nariyasu Dōton fought on the losing side.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/D%C5%8Dtonbori",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Otakoya, a takoyaki stand that opened in 1972 near Tazaemonbashi, was moved in 2010 because the original site was municipal land.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/D%C5%8Dtonbori",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Dōtonbori runs along the canal from Dōtonboribashi Bridge to Nipponbashi Bridge in Namba, famous for its neon‑lit streets at night.",
      "sourceSentenceIds": [
        20
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/D%C5%8Dtonbori",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "By 1662 the area boasted six Kabuki theatres and five Bunraku theatres, underscoring its long‑standing theatrical heritage.",
      "sourceSentenceIds": [
        30
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/D%C5%8Dtonbori",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "River cruises leave from the Tazaemonbashi Bridge Boat Dock, where guides offer local history in several languages.",
      "sourceSentenceIds": [
        12,
        18
      ],
      "sourceLabels": [
        "Web source 2"
      ],
