  "facts": [
    {
      "id": 1,
      "text": "Buenaventura Lakes grew from rural farmland into a suburban enclave in the 1980s after targeted ads promised a palm‑tree paradise near Walt Disney World.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/buenaventura_lakes_florida",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The area’s growth sparked cultural integration, with Spanish shaping local schools, businesses, and public life as Hispanics rose from 2% in 1980 to 45.5% by 2010.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/buenaventura_lakes_florida",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Early land platting in the late 1960s turned the region into subdivided residential parcels, supported by roads and utilities from the Kissimmee Utility Authority’s predecessor.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/buenaventura_lakes_florida",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Residents enjoy the Osceola Library System, which serves the community with books, programs, and digital resources.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Buenaventura_Lakes%2C_Florida",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Buenaventura Lakes is known as Little Puerto Rico or Little New York, reflecting its strong Puerto Rican and New Yorker heritage.",
