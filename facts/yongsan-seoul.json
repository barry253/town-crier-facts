  "facts": [
    {
      "id": 1,
      "text": "Yongsan got its name from two dragons said to appear by the Han River, shaping the mountains.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.vividdailyinfo.com/2026/05/yongsan-history-travel-guide.html"
    },
    {
      "id": 2,
      "text": "The National Museum of Korea, Korea’s largest, houses artifacts from prehistoric times to the modern era.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.vividdailyinfo.com/2026/05/yongsan-history-travel-guide.html"
    },
    {
      "id": 3,
      "text": "The War Memorial of Korea stands as a massive tribute to Korea’s military history, especially the Korean War.",
      "sourceSentenceIds": [
        11
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.vividdailyinfo.com/2026/05/yongsan-history-travel-guide.html"
    },
    {
      "id": 4,
      "text": "Yongsan History Museum, in a 1928 hospital, showcases local history and features a garden on its third floor.",
      "sourceSentenceIds": [
        12,
        17
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.vividdailyinfo.com/2026/05/yongsan-history-travel-guide.html"
    },
    {
      "id": 5,
      "text": "Seoul Station and Yongsan Station, two of Seoul’s main intercity rail hubs, sit right in Yongsan.",
      "sourceSentenceIds": [
        29
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Yongsan_District"
    },
    {
      "id": 6,
      "text": "The presence of the Yongsan Garrison sparked Itaewon’s growth as a service hub for U.S. military personnel.",
