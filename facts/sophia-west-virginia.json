  "facts": [
    {
      "id": 1,
      "text": "Sophia was named after Sophia McGinnis, the third wife of pioneer Pyrrhus McGinnis, who settled the area in 1843.",
      "sourceSentenceIds": [
        1,
        6,
        22
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 2"
      ],
      "source": "https://en.wikipedia.org/wiki/Sophia%2C_West_Virginia"
    },
    {
      "id": 2,
      "text": "The area that became Sophia was originally known as Soak Creek before the community was incorporated in 1912.",
      "sourceSentenceIds": [
        8,
        16
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Sophia%2C_West_Virginia"
    },
    {
      "id": 3,
      "text": "Sophia developed as a commercial center serving the surrounding Winding Gulf Coalfield and once traded with twenty-four different coal mines.",
      "sourceSentenceIds": [
        27,
        28
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Sophia%2C_West_Virginia"
    },
    {
      "id": 4,
      "text": "The expansion of the Virginian Railway into the region accelerated the growth of Sophia during the early twentieth century.",
      "sourceSentenceIds": [
        24,
        29
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Sophia%2C_West_Virginia"
    },
    {
      "id": 5,
      "text": "The Sophia Historical District is recognized on the National Register of Historic Places for its historical commercial center.",
      "sourceSentenceIds": [
        19
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Sophia%2C_West_Virginia"
    },
    {
      "id": 6,
      "text": "Sophia is associated with Winding Gulf Creek, which is a source of the Guyandotte River.",
      "sourceSentenceIds": [
        7
