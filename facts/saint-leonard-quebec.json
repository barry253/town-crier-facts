  "facts": [
    {
      "id": 1,
      "text": "Saint‑Leonard was originally named Saint‑Leonard de Port Maurice after the Italian Franciscan saint Leonard of Port Maurice.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Saint-Leonard%2C_Quebec"
    },
    {
      "id": 2,
      "text": "The parish of Saint‑Léonard‑de‑Port‑Maurice was founded in April 1886, marking the start of the community.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/Saint-Leonard,_Quebec"
    },
    {
      "id": 3,
      "text": "A wave of Italian immigrants turned the rural hamlet into a bustling borough, shaping its cultural identity.",
      "sourceSentenceIds": [
        2,
        9
      ],
      "sourceLabels": [
        "Web source 1",
        "Web source 2"
      ],
      "source": "https://www.comeexplorecanada.com/quebec/saint-leonard"
    },
    {
      "id": 4,
      "text": "Saint‑Leonard joined Montreal as part of a 2002 municipal reorganization, ending its status as an independent city.",
      "sourceSentenceIds": [
        4,
        21
      ],
      "sourceLabels": [
        "Web source 2",
        "Wikipedia"
      ],
      "source": "https://grokipedia.com/page/Saint-Leonard,_Quebec"
    },
    {
      "id": 5,
      "text": "Today, Saint‑Leonard hosts Montreal’s Via Italia, a vibrant street that celebrates its Italian heritage.",
      "sourceSentenceIds": [
        1,
        22
      ],
      "sourceLabels": [
        "Web source 1",
        "Wikipedia"
      ],
      "source": "https://www.comeexplorecanada.com/quebec/saint-leonard"
    },
    {
      "id": 6,
      "text": "The future Blue Line extension will add three new stations along Jean‑Talon Street East in Saint‑Leonard, opening around 2029.",
      "sourceSentenceIds": [
