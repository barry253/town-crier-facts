      "id": 1,
      "text": "Kilbourne began as a community when West Carroll Parish was created on March 26 1877, splitting Carroll Parish to resolve disputes over the parish seat.",
      "sourceSentenceIds": [
        21,
        23
      ],
      "sourceLabels": [
        "Web source 1"
      ],
