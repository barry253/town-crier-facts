  "facts": [
    {
      "id": 1,
      "text": "Sturgeon was named after early settler Henry Sturgeon in a fertile, limestone-rich region ideal for farming and resource extraction.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/sturgeon_pennsylvania"
    },
    {
      "id": 2,
      "text": "Scotch-Irish families founded Sturgeon in the early nineteenth century after receiving land grants from the New Purchase.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/sturgeon_pennsylvania"
    },
    {
      "id": 3,
      "text": "Early Sturgeon industries included Captain Samuel Morgan's gristmill and Samuel Stewart's sickle manufactory, which fostered local self-sufficiency.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/sturgeon_pennsylvania"
    },
    {
      "id": 4,
      "text": "The Pan Handle Railroad and Chartiers Valley Railroad improved access to Sturgeon and supported the shipment of mineral resources.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/sturgeon_pennsylvania"
    },
    {
      "id": 5,
      "text": "A historic community hall in Sturgeon was once used for hosting dances, medicine shows, and school plays.",
