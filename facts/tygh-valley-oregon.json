  "facts": [
    {
      "id": 1,
      "text": "Tygh Valley is named for the Tenino people, who are also known as the Tygh or Upper Deschutes people.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Tygh_Valley%2C_Oregon"
    },
    {
      "id": 2,
      "text": "Some consider Tygh Valley the beginning of the Barlow Road, where wagon trains crossed the Deschutes River at Sherars Bridge.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Tygh_Valley%2C_Oregon"
    },
    {
      "id": 3,
      "text": "The National Park Service identifies the first tollgate site at Gate Creek on the White River as the Barlow Road's start.",
      "sourceSentenceIds": [
        26
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Tygh_Valley%2C_Oregon"
    },
    {
      "id": 4,
      "text": "The Old Tygh Valley Powerhouse stands as a testament to early twentieth-century efforts to harness natural resources for electricity.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://abandonedin360.com/abandoned-industrial/old-tygh-valley-powerhouse/"
    },
    {
      "id": 5,
      "text": "PP&L operated the Tygh Valley powerhouse until it was finally abandoned in 1963 after the rise of larger power grids.",
      "sourceSentenceIds": [
        9,
        10
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://abandonedin360.com/abandoned-industrial/old-tygh-valley-powerhouse/"
    },
    {
      "id": 6,
      "text": "The powerhouse site was donated to the state in 1974 and became the White River Falls State Park.",
      "sourceSentenceIds": [
        23
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://abandonedin360.com/abandoned-industrial/old-tygh-valley-powerhouse/"
