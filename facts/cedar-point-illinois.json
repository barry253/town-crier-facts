  "facts": [
    {
      "id": 1,
      "text": "Cedar Point was incorporated on October 3, 1907, following the opening of the La Salle County Carbon Coal Company Number 5 Mine in 1906.",
      "sourceSentenceIds": [
        21,
        30
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/cedar_point_illinois"
    },
    {
      "id": 2,
      "text": "The village’s name comes from the nearby Cedar Point Mine, which produced over 2.2 million tons of Colchester coal between 1906 and 1924.",
      "sourceSentenceIds": [
        22,
        10
      ],
      "sourceLabels": [
        "Web source 1",
        "Wikipedia"
      ],
      "source": "https://grokipedia.com/page/cedar_point_illinois"
    },
    {
      "id": 3,
      "text": "Mining camps north of the town housed workers and grew into the core of the community, with rail access via the Ohio & Gulf Railroad.",
      "sourceSentenceIds": [
        4,
        27
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/cedar_point_illinois"
    },
    {
      "id": 4,
      "text": "After the mine closed in 1924, former coal sites were reclaimed for agriculture, restoring the land to productive use.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/cedar_point_illinois"
    },
    {
      "id": 5,
      "text": "Cedar Point sits in a rural Illinois River Valley setting, about 10 miles southwest of LaSalle, within the Ottawa–Streator micropolitan area.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/cedar_point_illinois"
    },
    {
      "id": 6,
      "text": "The village’s early infrastructure included a main shaft 12 by 16 feet and an air shaft reaching 544‑550 feet underground.",
      "sourceSentenceIds": [
        26
