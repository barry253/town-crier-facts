  "facts": [
    {
      "id": 1,
      "text": "Wentworth was founded as 'Rockingham Courthouse' in 1787, making it the oldest settlement in Rockingham County.",
      "sourceSentenceIds": [
        13
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Wentworth%2C_North_Carolina"
    },
    {
      "id": 2,
      "text": "The town’s name honors Charles Watson‑Wentworth, the Marquis of Rockingham, who served twice as UK prime minister.",
      "sourceSentenceIds": [
        1,
        16
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Wentworth%2C_North_Carolina"
    },
    {
      "id": 3,
      "text": "The Rockingham County Courthouse in Wentworth, built in 1895, is on the National Register and houses the county museum.",
      "sourceSentenceIds": [
        7,
        6
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Wentworth%2C_North_Carolina"
    },
    {
      "id": 4,
      "text": "In the 1990s, residents fought a proposed annexation by Reidsville, successfully keeping Wentworth as the county seat.",
      "sourceSentenceIds": [
        17,
        19,
        20
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Wentworth%2C_North_Carolina"
    },
    {
      "id": 5,
      "text": "Wentworth’s post office opened in November 1794, just a few years after the town’s charter.",
      "sourceSentenceIds": [
        14
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Wentworth%2C_North_Carolina"
    },
    {
      "id": 6,
      "text": "The town sits within the Greensboro‑High Point metropolitan area of the Piedmont Triad, linking it to a larger regional culture.",
