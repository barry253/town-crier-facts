      "quality": "good"
    },
    {
      "id": 2,
      "text": "During its boom, the town featured company‑built housing, a church, a school, and a store—all controlled by the mining company.",
      "sourceSentenceIds": [
        16,
        21
      ],
      "sourceLabels": [
        "Web source 1"
