  "facts": [
    {
      "id": 1,
      "text": "Cheltenham Village grew from a 1600s agrarian settlement into a 1700s mill town, later becoming an industrial hub served by the railroad.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.achp.gov/preserve-america/community/cheltenham-township-pennsylvania",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town’s 35‑member Historical Commission preserves the Richard Wall House, a living‑history museum that showcases early residents’ lifestyles.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.achp.gov/preserve-america/community/cheltenham-township-pennsylvania",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Cheltenham’s oldest continuously used school, built in 1883, still operates on its original site and is the oldest of its kind in Pennsylvania.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.achp.gov/preserve-america/community/cheltenham-township-pennsylvania",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The area’s long history makes it an architectural museum, featuring two historic districts and several sites listed on the National Register of Historic Places.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.achp.gov/preserve-america/community/cheltenham-township-pennsylvania",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The town’s name honors Lucretia Mott, the abolitionist who lived here from the 1850s until her death in 1880.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.achp.gov/preserve-america/community/cheltenham-township-pennsylvania",
      "category": "people",
      "quality": "good"
    }
