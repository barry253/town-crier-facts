    },
    {
      "id": 2,
      "text": "The National Outdoor Leadership School was founded in Lander and still operates its headquarters there.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Lander%2C_Wyoming"
    },
    {
      "id": 3,
      "text": "Lander serves as the county seat of Fremont County, Wyoming.",
      "sourceSentenceIds": [
        25
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Lander%2C_Wyoming"
    },
    {
      "id": 4,
      "text": "The city lies along the Middle Fork of the Popo Agie River, just south of the Wind River Indian Reservation.",
      "sourceSentenceIds": [
        26
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Lander%2C_Wyoming"
    },
    {
      "id": 5,
      "text": "Before adopting its current name in 1875, Lander was known as Pushroot, Old Camp Brown, and Fort Augur.",
      "sourceSentenceIds": [
        27
