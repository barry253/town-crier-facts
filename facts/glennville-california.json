  "facts": [
    {
      "id": 1,
      "text": "Glennville was named for James Madison Glenn, a blacksmith who opened the town's first hotel in 1857.",
      "sourceSentenceIds": [
        22
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Glennville%2C_California",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The Glennville adobe, built before the Civil War, still stands on Route 155 and is Kern County's oldest building.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Glennville%2C_California",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Glennville became the last stop on the stagecoach line from Visalia and the trading center after Lavers' Crossing declined.",
      "sourceSentenceIds": [
        23
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Glennville%2C_California",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "State Route 155 follows Thomas Baker's original wagon road, once known as the McFarlane Road, through Glennville.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Glennville%2C_California",
      "category": "transport",
      "quality": "poor",
      "qualityReason": "route_only"
    },
    {
      "id": 5,
      "text": "About ten miles northeast of Glennville lies Deer Creek Grove, the southernmost grove of Giant Sequoia trees.",
