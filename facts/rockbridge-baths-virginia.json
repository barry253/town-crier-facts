  "facts": [
    {
      "id": 1,
      "text": "Rockbridge Baths sits on State Route 39, midway between Lexington and Goshen, where the Maury River winds through the valley.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Rockbridge_Baths%2C_Virginia",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The springs’ iron‑rich waters are naturally carbonated, a feature that drew visitors in the 19th century for their supposed health benefits.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Rockbridge_Baths%2C_Virginia",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "A grand hotel opened in 1857, accommodating up to 200 guests, and became a fashionable retreat for the region’s elite.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Rockbridge_Baths%2C_Virginia",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Robert E. Lee and his wife, Mary Custis Lee, were regulars at the resort, often staying during the summer months.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Rockbridge_Baths%2C_Virginia",
      "category": "people",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "In 1921 the Virginia Military Institute took over the property, turning the former resort into a summer school for cadets.",
      "sourceSentenceIds": [
        11
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Rockbridge_Baths%2C_Virginia",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "A devastating fire in 1926 destroyed the historic hotel, and the site was never rebuilt, leaving only the springs and surrounding forest.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
