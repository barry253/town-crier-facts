  "facts": [
    {
      "id": 1,
      "text": "People began settling in the Cleora area around 1890, when the region was part of the Cherokee Nation of Indian Territory.",
      "sourceSentenceIds": [
        5,
        9
      ],
      "sourceLabels": [
        "Web source 2",
        "Wikipedia"
      ],
      "source": "https://kids.kiddle.co/Cleora,_Oklahoma"
    },
    {
      "id": 2,
      "text": "Cleora was named for Cleora Ann Lunday, the sister of the town's first postmaster, Ed Lunday.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Cleora%2C_Oklahoma"
    },
    {
      "id": 3,
      "text": "The rich soil around Cleora once supported a farming economy that primarily produced wheat, corn, and oats.",
      "sourceSentenceIds": [
        10,
        11
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Cleora%2C_Oklahoma"
    },
    {
      "id": 4,
      "text": "The Kansas, Oklahoma and Gulf Railway built its main train line through Cleora in 1910, bringing prosperity to the community.",
      "sourceSentenceIds": [
        17
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Cleora%2C_Oklahoma"
    },
    {
      "id": 5,
      "text": "Cleora is located in northwestern Delaware County on the northwest side of the Grand Lake o' the Cherokees.",
      "sourceSentenceIds": [
        22
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Cleora%2C_Oklahoma"
    },
    {
      "id": 6,
      "text": "Many original sites in Cleora were inundated when planning began for the Pensacola Dam and the Grand Lake o' the Cherokees.",
