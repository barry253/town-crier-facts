      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Originally a bedroom community in Boone Township, Del City sits three miles east of Oklahoma City and one mile west of Midwest City.",
      "sourceSentenceIds": [
        8,
        12,
        13
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Del_City%2C_Oklahoma",
      "category": "other",
      "quality": "poor",
      "qualityReason": "location_description"
    },
    {
      "id": 3,
      "text": "Interstate 40 cuts through Del City, while Interstate 35 lies just west, making it a true crossroads of major highways.",
      "sourceSentenceIds": [
        29
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Del_City%2C_Oklahoma",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The Del City Historical Society, founded in 1975 with Andy Evans as its first president, preserves the town’s heritage.",
      "sourceSentenceIds": [
        20,
        23
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 2"
      ],
      "source": "https://en.wikipedia.org/wiki/Del_City%2C_Oklahoma",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Olympic gold‑medalist wrestler John Smith once called Del City home, adding sports prestige to the community.",
      "sourceSentenceIds": [
