      "id": 1,
      "text": "Del City was incorporated in 1948, founded by George Epperly who named it after his eldest daughter, Delaphene Campbell.",
      "sourceSentenceIds": [
        1,
        6,
        7
      ],
      "sourceLabels": [
        "Web source 1",
        "Wikipedia"
      ],
