  "facts": [
    {
      "id": 1,
      "text": "North Oaks began in 1883 when railroad magnate James J. Hill turned a 5,000‑acre farm into a model residential community.",
      "sourceSentenceIds": [
        6,
        14,
        15
      ],
      "sourceLabels": [
        "Web source 2",
        "Wikipedia"
      ],
      "source": "https://www.northoaksmn.gov/296/About-North-Oaks",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Every North Oaks deed splits a home’s lot halfway into the street, making all roads privately owned by the homeowners’ association.",
      "sourceSentenceIds": [
        20
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/North_Oaks%2C_Minnesota",
      "category": "other",
      "quality": "poor",
      "qualityReason": "editorial_filler"
    },
    {
      "id": 3,
      "text": "The original North Oaks farm buildings, now restored with informational displays, sit on a site listed on the National Register of Historic Places.",
      "sourceSentenceIds": [
        5,
        22
      ],
      "sourceLabels": [
        "Web source 1",
