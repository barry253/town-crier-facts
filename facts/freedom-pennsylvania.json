      "id": 1,
      "text": "Freedom was founded in 1832 by shipbuilders Jonathan Betz and Stephen Phillips who bought 101 acres from Abner Lacock.",
      "sourceSentenceIds": [
        26
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Freedom%2C_Pennsylvania",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town began as a steamboat‑building hub before becoming known for oil and casket production in the 20th century.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Freedom%2C_Pennsylvania",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The Captain William Vicary House, a stone mansion built by the town’s namesake, is listed on the National Register of Historic Places.",
      "sourceSentenceIds": [
        5,
        6
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Freedom%2C_Pennsylvania",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Freedom sits on the Ohio River, 25 miles northwest of Pittsburgh, and is part of the Pittsburgh metropolitan area.",
      "sourceSentenceIds": [
        24,
        25
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Freedom%2C_Pennsylvania",
      "category": "other",
      "quality": "poor",
      "qualityReason": "location_description"
    },
    {
      "id": 5,
      "text": "In 1896, Freedom merged with neighboring Clair and Vicary boroughs to form a single municipality.",
