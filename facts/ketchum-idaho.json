  "facts": [
    {
      "id": 1,
      "text": "Ketchum was originally called Leadville in 1880, renamed after trapper David Ketchum when the postal service found the name too common.",
      "sourceSentenceIds": [
        4,
        5
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Ketchum%2C_Idaho",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "In the 1880s, the Philadelphia Smelter on Warm Springs Road processed lead and silver for a decade, making Ketchum a smelting hub.",
      "sourceSentenceIds": [
        22
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Ketchum%2C_Idaho",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "By 1920, Ketchum became the largest sheep‑shipping center in the West, with summer flocks grazing in nearby mountains.",
      "sourceSentenceIds": [
        23,
        24
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Ketchum%2C_Idaho",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "After Sun Valley’s 1936 development, Ernest Hemingway and Gary Cooper frequented Ketchum, and Hemingway even bought a home overlooking the Big Wood River in the 1950s.",
      "sourceSentenceIds": [
        12,
        25
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Ketchum%2C_Idaho",
      "category": "people",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Clint Eastwood’s 1985 film Pale Rider was partially shot in the Boulder Mountains near Ketchum.",
      "sourceSentenceIds": [
        16
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Ketchum%2C_Idaho",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Every Labor Day weekend, Ketchum hosts Wagon Days, a carnival featuring Old‑West wagon trains, ore wagons, and a parade.",
