  "facts": [
    {
      "id": 1,
      "text": "Camp Croft was established during World War Two as an Army base and Infantry Replacement Training Center.",
      "sourceSentenceIds": [
        2,
        14
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Camp_Croft%2C_South_Carolina"
    },
    {
      "id": 2,
      "text": "The military reservation was named in honor of Major General Edward Croft, a South Carolinian who served in World War One.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.campcroft.net/site-history/"
    },
    {
      "id": 3,
      "text": "Future Secretary of State Henry Kissinger was among the trainees and became a naturalized citizen at Camp Croft.",
      "sourceSentenceIds": [
        4,
        5
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Camp_Croft%2C_South_Carolina"
    },
    {
      "id": 4,
      "text": "Camp Croft trained sixty thousand soldiers per year from 1941 to 1946 before the land returned to civilian control.",
      "sourceSentenceIds": [
        14,
        16
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Camp_Croft%2C_South_Carolina"
    },
    {
      "id": 5,
      "text": "A prisoner-of-war camp was established at Camp Croft during the later years of the war, holding nearly one thousand German prisoners.",
      "sourceSentenceIds": [
        15
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Camp_Croft%2C_South_Carolina"
    },
    {
      "id": 6,
      "text": "Kelsey Creek forms the southwest boundary of the Camp Croft community and is part of the Tyger River watershed.",
