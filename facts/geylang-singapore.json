  "facts": [
    {
      "id": 1,
      "text": "Geylang’s name comes from the Malay word ‘kilang’, meaning factory, reflecting its early industrial roots.",
      "sourceSentenceIds": [
        11,
        13
      ],
      "sourceLabels": [
        "Web source 1",
        "Web source 2"
      ],
      "source": "https://www.sg101.gov.sg/resources/archives/ourneighbourhood-geylang/",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "In 1896, Indian Muslim trader Haji Mohammed Salleh founded Geylang on land owned by fellow merchant Vena Meena Bok.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Geylang",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The area became known as Geylang Serai, with ‘serai’ meaning lemongrass in Malay.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://thesmartlocal.com/read/geylang-singapore-then-and-now/",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Geylang houses one of Singapore’s oldest Malay settlements, Geylang Serai, which still thrives today.",
      "sourceSentenceIds": [
        30
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Geylang",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Religious sites like Sri Sivan Temple, Masjid Khadijah, and Geylang Evangelical Church showcase the area’s multicultural faiths.",
      "sourceSentenceIds": [
        19
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.sg101.gov.sg/resources/archives/ourneighbourhood-geylang/",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "By 1935, Geylang Serai shifted from coconut plantations to an urban neighbourhood as residents poured in.",
