  "facts": [
    {
      "id": 1,
      "text": "Murchison was named after Colonel T.F. Murchison, a Confederate recruiting officer honored when the town was renamed in 1880.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.tshaonline.org/handbook/entries/murchison-tx",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town’s growth began when the railroad arrived, turning the depot into a bustling hub with 24 businesses nearby.",
      "sourceSentenceIds": [
        10,
        11
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://murchisontx.com/pages/about-us",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "A local brickmaker, Robert Prather, built a factory north of town that supplied bricks for projects throughout Henderson County.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://murchisontx.com/pages/about-us",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Murchison sits at the junction of Farm Roads 1616 and 773, nine miles northeast of Athens in northeastern Henderson County.",
      "sourceSentenceIds": [
        13
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.tshaonline.org/handbook/entries/murchison-tx",
