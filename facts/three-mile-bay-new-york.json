  "facts": [
    {
      "id": 1,
      "text": "Three Mile Bay was first settled between 1810 and 1820, laying the groundwork for its maritime heritage.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Three_Mile_Bay%2C_New_York"
    },
    {
      "id": 2,
      "text": "Entrepreneur Asa Wilcox crafted 48 brigs, schooners, and other vessels from 1835 to 1853, fueling the local shipbuilding boom.",
      "sourceSentenceIds": [
        11
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Three_Mile_Bay%2C_New_York"
    },
    {
      "id": 3,
      "text": "The hamlet boasts its own post office, a volunteer fire company, and boat launches that open Lake Ontario to anglers.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Three_Mile_Bay%2C_New_York"
    },
    {
      "id": 4,
      "text": "Muck‑peat and acid sand soils dominate the area, shaping the unique vegetation that thrives along the shoreline.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://dec.ny.gov/places/three-mile-bay-wildlife-management-area"
    },
    {
      "id": 5,
      "text": "Henslow's sparrow, a threatened species, once bred in Three Mile Bay during the 1980s and 1990s.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://dec.ny.gov/places/three-mile-bay-wildlife-management-area"
    },
