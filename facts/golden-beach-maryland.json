  "facts": [
    {
      "id": 1,
      "text": "Golden Beach grew from a 50‑acre plantation called “The Fishing Place” granted to Thomas Lamar in 1677.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Golden_Beach%2C_Maryland",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The community sits only 13 feet above sea level, making it vulnerable to flooding from the Patuxent River.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/golden_beach_maryland",
      "category": "nature",
      "quality": "poor",
      "qualityReason": "vague"
    },
    {
      "id": 3,
      "text": "Golden Beach’s land began as “The Plains,” a 1,700‑acre farm that produced tobacco, wheat, and soybeans for centuries.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/golden_beach_maryland",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Developed in 1955 from that historic farm, the neighborhood now hosts 3,651 residents and is accessible only to owners and guests with beach passes.",
      "sourceSentenceIds": [
        8,
        7
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/golden_beach_maryland",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Golden Beach’s waterfront access comes from its adjacency to the Patuxent River, a major tributary of the Chesapeake Bay.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/golden_beach_maryland",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Former resident Ronnie Dove, a popular 1960s romantic recording artist, once called Golden Beach home.",
