      ],
      "source": "https://en.wikipedia.org/wiki/Woodland_Hills%2C_Los_Angeles",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Harry Chandler planted 120,000 pepper trees along Canoga Avenue; many still stand as living landmarks in Woodland Hills.",
      "sourceSentenceIds": [
        11
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://carnahanlegacy.real-estate-blog.com/woodland-hills-ca-little-known-facts-that-make-this-valley-neighborhood-stand-out/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Robinson’s Liberty Bells, a local landmark modeled after Philadelphia’s Liberty Bell, stands in Woodland Hills to honor American ideals.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://carnahanlegacy.real-estate-blog.com/woodland-hills-ca-little-known-facts-that-make-this-valley-neighborhood-stand-out/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The Motion Picture & Television Country House and Hospital, a retirement facility reserved for industry professionals, is located in Woodland Hills.",
      "sourceSentenceIds": [
        13
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Woodland_Hills%2C_Los_Angeles",
      "category": "landmark",
      "quality": "good"
    },
