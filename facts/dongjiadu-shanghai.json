  "facts": [
    {
      "id": 1,
      "text": "Dongjiadu Cathedral, built 1849-1853, was the first Roman Catholic cathedral in Shanghai and served as the seat of the bishop until 1960.",
      "sourceSentenceIds": [
        21,
        27,
        30
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/St._Francis_Xavier_Church_(Shanghai)",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "During the Cultural Revolution, the cathedral was shut in 1966 and repurposed as a factory warehouse before restoration.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/St._Francis_Xavier_Church_(Shanghai)",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The cathedral’s Neo‑Baroque design echoes Rome’s Sant’Ignazio Church, reflecting French missionary influence in mid‑19th century Shanghai.",
      "sourceSentenceIds": [
        26
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/St._Francis_Xavier_Church_(Shanghai)",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Dongjiadu, once a bustling ferry port since the Song Dynasty, became a commercial hub for Shanghai’s sand‑shipping industry in the early 20th century.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://wxredian.com/art?id=fd8265d5c7d3e798ba30ac2df261a867",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Recent urban renewal in Dongjiadu has turned the former cathedral into a public activity center and exhibition hall celebrating Shanghai’s maritime history.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://wxredian.com/art?id=fd8265d5c7d3e798ba30ac2df261a867",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The Dongjiadu Skywalk, part of the renewal, is dubbed Shanghai’s most beautiful pedestrian overpass, linking waterfront parks and historic sites.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://wxredian.com/art?id=fd8265d5c7d3e798ba30ac2df261a867",
