  "facts": [
    {
      "id": 1,
      "text": "Lachine was founded as a fur‑trade post in 1669.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Lachine%2C_Quebec"
    },
    {
      "id": 2,
      "text": "The name comes from French “la Chine” mocking explorer La Salle who sought a route to China.",
      "sourceSentenceIds": [
        5,
        6
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Lachine%2C_Quebec"
    },
    {
      "id": 3,
      "text": "In 1825 the Canal de Lachine opened, making the borough a hub for industrialization in Canada.",
      "sourceSentenceIds": [
        16
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://montreal.ca/en/about/lachine"
    },
    {
      "id": 4,
      "text": "The Fur Trade at Lachine National Historic Site preserves a 1803 stone warehouse, a relic of the 17th‑century fur trade.",
      "sourceSentenceIds": [
        11,
        24
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.britannica.com/place/Lachine"
    },
    {
      "id": 5,
      "text": "Lachine merged into Montreal in 2002 after a 1999 merger with Saint‑Pierre.",
      "sourceSentenceIds": [
        30
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Lachine%2C_Quebec"
    },
    {
      "id": 6,
      "text": "Parc René‑Lévesque hosts a garden of sculptures and a municipal dock along the Lachine Canal, a popular spot for locals.",
