  "facts": [
    {
      "id": 1,
      "text": "Garnerville was named after the Garner brothers, textile printers who founded the village in 1838.",
      "sourceSentenceIds": [
        1,
        6
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 2"
      ],
      "source": "https://en.wikipedia.org/wiki/Garnerville%2C_New_York",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The village grew around a 19th‑century factory complex that once employed about 800 workers.",
      "sourceSentenceIds": [
        2,
        8
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Garnerville%2C_New_York",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "A narrow railroad spur, the Garnerville Railroad, linked the printworks to the New Jersey and New York Railroad at Miner's Creek.",
      "sourceSentenceIds": [
        14
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Garnerville%2C_New_York",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "In 2013 the 14‑acre Garner Historic District, full of pre‑Civil War factory buildings, earned a spot on the National Register of Historic Places.",
      "sourceSentenceIds": [
        10,
        20
      ],
      "sourceLabels": [
        "Web source 2",
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/garnerville_new_york",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The 1830s saw John Glass build the first calico mill on 45 acres beside Minisceongo Creek, sparking the hamlet’s textile industry.",
      "sourceSentenceIds": [
        17,
        21
      ],
      "sourceLabels": [
        "Web source 1",
        "Web source 2"
      ],
      "source": "https://garnerhistoricdistrict.com/about/history/timeline/"
    },
    {
      "id": 6,
      "text": "The 2003 Garnerville Arts Project, now the GARNER Arts Center, revitalized historic buildings into a cultural hub.",
      "sourceSentenceIds": [
        5,
