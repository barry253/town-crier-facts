  "facts": [
    {
      "id": 1,
      "text": "Bay Village’s narrow streets were once part of the Back Bay, a body of water that lay west of Boston’s Neck isthmus before the area was filled.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Bay_Village%2C_Boston",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The neighborhood’s Federal‑style rowhouses line Fayette and Melrose Streets, a visual reminder of the early 19th‑century architecture that defines Bay Village’s historic charm.",
      "sourceSentenceIds": [
        14
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.boston-discovery-guide.com/bay-village.html",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "A 1928 map shows a square at Broadway, Fayette, and Carver Streets that once honored a local figure, but the honor vanished when the streets were rearranged.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.boston-discovery-guide.com/bay-village.html",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The Massachusetts Turnpike borders Bay Village to the south, following the former Boston and Worcester Railroad right‑of‑way laid in the 1830s.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Bay_Village%2C_Boston",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Bay Village is Boston’s smallest officially recognized neighborhood, covering only twelve square blocks and home to about seven hundred residents.",
      "sourceSentenceIds": [
        13
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.boston-discovery-guide.com/bay-village.html",
      "category": "other",
      "quality": "poor",
      "qualityReason": "location_description"
    },
    {
      "id": 6,
      "text": "In 1983, the city designated the area bounded by Cortes, Tremont, Piedmont, and Isabella Streets as the Bay Village Historic District, protecting its architectural heritage.",
      "sourceSentenceIds": [
        10
      ],
