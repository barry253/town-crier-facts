  "facts": [
    {
      "id": 1,
      "text": "Waverly earned its name from Sir Walter Scott’s Waverley novels, chosen over the original “Harmonville” idea.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.waverlywelcomehome.com/live-here/history/"
    },
    {
      "id": 2,
      "text": "In 1853, William Patterson Harmon founded Waverly along the Cedar River, building a saw mill that sparked the town’s growth.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.waverlywelcomehome.com/live-here/history/"
    },
    {
      "id": 3,
      "text": "Waverly became Bremer County’s seat in 1859, cementing its role as the region’s administrative hub.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.waverlyia.com/city-information/default.aspx"
    },
    {
      "id": 4,
      "text": "The city’s Historic Preservation Commission earned a 2018 Award of Excellence for safeguarding Waverly’s heritage.",
      "sourceSentenceIds": [
        11
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.waverlywelcomehome.com/live-here/history/"
    },
    {
      "id": 5,
      "text": "Five National Register sites—Old Main, the Bremer County Historical Society Museum, the courthouse, a hydroelectric powerhouse, and a bridge—dot Waverly’s historic streets.",
      "sourceSentenceIds": [
        9
      ],
