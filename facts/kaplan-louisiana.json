  "facts": [
    {
      "id": 1,
      "text": "Kaplan was founded in 1902 by Abrom Kaplan, a Polish‑Jewish immigrant who bought the Jim Todd Plantation and named the town after himself.",
      "sourceSentenceIds": [
        2,
        4
      ],
      "sourceLabels": [
        "Web source 2",
        "Wikipedia"
      ],
      "source": "https://grokipedia.com/page/Kaplan,_Louisiana",
      "category": "people",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Early Kaplan was a tent city until the Southern Pacific Railroad linked it to Gueydan and Abbeville, sparking rapid growth.",
      "sourceSentenceIds": [
        13
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://mostcajun.com/towns/kaplan/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Rice farming remains a cornerstone of Kaplan’s economy, thanks to the flat alluvial soils that support the crop.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/Kaplan,_Louisiana",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The Eleazar Theater, built in 1911, served as both a movie house and dance hall for local performances.",
      "sourceSentenceIds": [
        17
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/Kaplan,_Louisiana",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The Kaplan Herald, originally the Kaplan Journal launched in 1956, has been published continuously ever since.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/Kaplan,_Louisiana",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Country singer Sammy Kershaw hails from Kaplan, adding a musical legacy to the town.",
