  "facts": [
    {
      "id": 1,
      "text": "Moccasin started as a 1849–1855 Gold Rush placer mining camp at the confluence of Moccasin Creek and the Tuolumne River.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/moccasin_california"
    },
    {
      "id": 2,
      "text": "The town sits where State Route 49 meets State Route 120, right on the shore of Moccasin Reservoir beside Lake Don Pedro.",
      "sourceSentenceIds": [
        9,
        10
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Moccasin%2C_California"
    },
    {
      "id": 3,
      "text": "Moccasin’s pink powerhouse, completed in 1925, was built to power San Francisco’s water system and later named after engineer Paul Ost.",
      "sourceSentenceIds": [
        16,
        22
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Moccasin%2C_California"
    },
    {
      "id": 4,
      "text": "The original powerhouse ceased operation in February 1969, replaced by a newer plant that began generating power the same month.",
      "sourceSentenceIds": [
        22,
        23
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Moccasin%2C_California"
    },
    {
      "id": 5,
      "text": "During the Gold Rush, Moccasin was a stagecoach stop on Big Oak Flat Road, and a covered bridge later crossed Moccasin Creek in wet season.",
