  "facts": [
    {
      "id": 1,
      "text": "Shady Hollow gets its name from the dense oak and cedar trees that shade the local creeks, creating a true hollow-like landscape.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.trawellino.com/destinations/united-states/texas_shady-hollow"
    },
    {
      "id": 2,
      "text": "The community sits about ten miles southwest of downtown Austin, right on the Travis‑Hays county line.",
      "sourceSentenceIds": [
        18,
        25
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Shady_Hollow%2C_Texas"
    },
    {
      "id": 3,
      "text": "In 1972, Austin Savings and Loan Owners began developing 600 acres of land that would become Shady Hollow.",
      "sourceSentenceIds": [
        19
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Shady_Hollow%2C_Texas"
    },
    {
      "id": 4,
      "text": "Homeowners formed the Shady Hollow Homeowners Corporation in 1978 to challenge what they saw as misrepresentation by the developer.",
      "sourceSentenceIds": [
        20,
        21
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Shady_Hollow%2C_Texas"
    },
    {
      "id": 5,
      "text": "An agreement in 1978 created parks and recreational facilities along Slaughter Creek, including the Park on Doe Run.",
      "sourceSentenceIds": [
        22
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Shady_Hollow%2C_Texas"
    },
    {
      "id": 6,
      "text": "In 1984, the developer deeded those parks and facilities to the Shady Hollow Homeowners Corporation, solidifying community ownership.",
      "sourceSentenceIds": [
        24
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Shady_Hollow%2C_Texas"
    }
  ]
