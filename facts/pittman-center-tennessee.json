      "quality": "poor",
      "qualityReason": "location_description"
    },
    {
      "id": 3,
      "text": "Historic Pittman Center, listed on the National Register in 1996, houses a library that preserves local records and offers a quiet research space.",
      "sourceSentenceIds": [
        10,
        5
      ],
      "sourceLabels": [
        "Wikipedia",
