      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Pittman Center is the birthplace of country music icon Dolly Parton, who grew up in this Appalachian town.",
      "sourceSentenceIds": [
        2,
        6
      ],
      "sourceLabels": [
        "Wikipedia",
