  "facts": [
    {
      "id": 1,
      "text": "Edgewater was founded in 1910‑1911 as a company town by Tennessee Coal, Iron and Railroad Company.",
      "sourceSentenceIds": [
        1,
        3
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Edgewater%2C_Alabama",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town grew around TCI Coal Mine #13, which was explicitly named \"Edgewater\" to designate the site.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/edgewater_alabama",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Bayview Lake, a 530‑acre reservoir built in 1911, supplied water to TCI’s steel plants while the mine produced over 800,000 tons of coal annually during WWI.",
      "sourceSentenceIds": [
        10,
        19
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/edgewater_alabama",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "In 1912, TCI president George Gordon Crawford ended convict leasing at its mines, shifting to free labor to improve conditions.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/edgewater_alabama",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "During the 1940s, unionization under the United Mine Workers intensified, leading to walkouts and a modest wage increase after government seizure of the mines.",
      "sourceSentenceIds": [
        7,
        17
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/edgewater_alabama",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Edgewater is now a quiet suburban‑rural enclave within the Birmingham metro area, preserving echoes of its industrial past through landmarks like the Methodist church.",
      "sourceSentenceIds": [
        20
      ],
      "sourceLabels": [
