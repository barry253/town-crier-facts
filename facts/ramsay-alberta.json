  "facts": [
    {
      "id": 1,
      "text": "Ramsay is one of Calgary’s oldest neighborhoods, with Spiller Road tracing a First Nations trail.",
      "sourceSentenceIds": [
        24
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.heritageinspiresyyc.org/heritage-places/communities-ramsay/"
    },
    {
      "id": 2,
      "text": "The Macdonald Steel Truss Bridge, built in 1910, linked Ramsay to downtown Calgary and sparked a streetcar service in 1911.",
      "sourceSentenceIds": [
        27
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.heritageinspiresyyc.org/heritage-places/communities-ramsay/"
    },
    {
      "id": 3,
      "text": "Ramsay House (1913), The Beers House (1908), and Maclean Residence (1912) are still standing examples of the community’s historic architecture.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.heritageinspiresyyc.org/heritage-places/communities-ramsay/"
    },
    {
      "id": 4,
      "text": "The Ramsay Community Association publishes a volunteer‑run newsletter four times a year, keeping residents connected to local history.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.ramsaycalgary.ca/"
    },
    {
      "id": 5,
      "text": "A sandstone quarry at Scotsman’s Hill supplied the stone for many of Calgary’s historic sandstone buildings, linking Ramsay to the city’s architectural heritage.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 1"
