  "facts": [
    {
      "id": 1,
      "text": "Spring Valley earned its name from a large spring in the valley pond that early settlers found essential.",
      "sourceSentenceIds": [
        23
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Spring_Valley%2C_New_York",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Dutch pioneers in the mid‑17th century first settled the area that would become Spring Valley, buying land from Algonquin tribes.",
      "sourceSentenceIds": [
        14
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/Spring_Valley,_New_York",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "In 1842 dairy farmers petitioned the New Jersey and New York Railroad, securing a milk train stop that linked Spring Valley to New York City markets.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/Spring_Valley,_New_York",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "By the 1930s, up to eight soda bottling plants operated in Spring Valley, selling local drinks for five cents a bottle.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/Spring_Valley,_New_York",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The Yeshiva of Spring Valley, founded in the mid‑1940s, became a cornerstone for religious education, drawing families to the village.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/Spring_Valley,_New_York",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The Finkelstein Memorial Library, built in 1940, sits on Chestnut Street and has served as the village’s cultural hub for decades.",
      "sourceSentenceIds": [
