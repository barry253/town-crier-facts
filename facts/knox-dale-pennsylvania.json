  "facts": [
    {
      "id": 1,
      "text": "Knox Dale was originally called Shadagee and was platted in 1851 before adopting its current name.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Knox_Dale%2C_Pennsylvania",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town sits at about 1,700 feet on the Allegheny Plateau, surrounded by rolling uplands and steep valleys carved by Sandy Lick Creek tributaries.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/knox_dale_pennsylvania",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Knox Dale’s early economy thrived on timber, with sawmills operating by the 1880s before shifting to agriculture and limestone quarrying.",
      "sourceSentenceIds": [
        12,
        13
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/knox_dale_pennsylvania",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The community’s climate is humid continental, with winters averaging 47 inches of snow that shape local travel and outdoor life.",
      "sourceSentenceIds": [
        4,
        21,
        23
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/knox_dale_pennsylvania",
      "category": "other",
      "quality": "poor",
      "qualityReason": "other"
    },
    {
      "id": 5,
      "text": "Knox Dale lies roughly six miles south-southeast of Brookville, the county seat of Jefferson County, Pennsylvania.",
