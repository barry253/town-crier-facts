  "facts": [
    {
      "id": 1,
      "text": "Well's Tavern, founded in 1759, later became the Kitty Bed & Breakfast and served as a Civil War meeting spot for Northern sympathizers.",
      "sourceSentenceIds": [
        1,
        26
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
