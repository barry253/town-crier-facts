      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town’s name comes from Kittery Court in Devon, England, the home of early settler Alexander Shapleigh.",
      "sourceSentenceIds": [
        3,
        9
      ],
      "sourceLabels": [
        "Web source 2",
