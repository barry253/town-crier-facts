      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Today the Kickapoo Nation splits into four bands: Kansas, Oklahoma, Texas, and Mexican‑Kickapoos.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.ktik-nsn.gov/history-and-language-resource",
      "category": "people",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The Kickapoo have survived centuries of U.S. oppression and relentless assimilation efforts.",
