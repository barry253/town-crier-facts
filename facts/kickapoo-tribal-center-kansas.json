      "quality": "good"
    },
    {
      "id": 2,
      "text": "The Kickapoo, or Kiikaapoi, belong to the Algonquian language family and share close linguistic ties with Pottawatomie, Menomonee, Sauk, Fox, and Shawnee.",
      "sourceSentenceIds": [
        4
      ],
