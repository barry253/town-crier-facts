    },
    {
      "id": 3,
      "text": "After the Ancestral Puebloans left in 1280, Navajo, Jicarilla Apache, Southern Ute, and Ute Mountain peoples inhabited the region.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 2"
