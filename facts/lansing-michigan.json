  "facts": [
    {
      "id": 1,
      "text": "Lansing was chosen as Michigan's capital in 1847 because its central location was seen as safer than Detroit during War of 1812.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Lansing%2C_Michigan",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The Michigan State Capitol, built 1872-78, sits in a 10‑acre park at the city center and was restored 1989‑92.",
      "sourceSentenceIds": [
        18
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.britannica.com/place/Lansing-Michigan",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The birthplace of the U.S. automobile, REO Town, lies just south of downtown where Ransom Eli Olds built factories on Washington Avenue.",
      "sourceSentenceIds": [
        24
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Lansing%2C_Michigan",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Lansing’s library, the Michigan Library and Historical Center, holds one of the nation’s ten largest genealogy collections and a museum of Michigan history.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Lansing%2C_Michigan",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The Grand River, Michigan’s longest river, winds through downtown Lansing and meets the Red Cedar River near the campus of Michigan State University.",
      "sourceSentenceIds": [
        23
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Lansing%2C_Michigan",
      "category": "nature",
      "quality": "good"
    },
    {
