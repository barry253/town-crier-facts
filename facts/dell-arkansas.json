  "facts": [
    {
      "id": 1,
      "text": "Dell was originally named Rozell after an early landowner, but the name was changed to Dell to avoid confusion.",
      "sourceSentenceIds": [
        12,
        16
      ],
      "sourceLabels": [
        "Web source 2",
        "Wikipedia"
      ],
      "source": "https://grokipedia.com/page/dell_arkansas",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "When the Jonesboro, Lake City and Eastern Railroad opened a line through the area, Dell sprang up right beside the tracks.",
      "sourceSentenceIds": [
        5,
        10
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 2"
      ],
      "source": "https://en.wikipedia.org/wiki/Dell%2C_Arkansas",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "In the early 1900s, Dell's timber boom drew hotels, saloons, and log buildings before the area shifted to cotton, soybeans, rice, milo, and corn.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/dell_arkansas",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Dell Gin Company, founded in 1926, became a central cotton-processing hub, operating three gins before closing in 1975.",
      "sourceSentenceIds": [
        3,
        11
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/dell_arkansas",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "A one-room schoolhouse that also served as a church opened in 1896, reflecting Dell's early focus on basic services.",
      "sourceSentenceIds": [
        2
      ],
