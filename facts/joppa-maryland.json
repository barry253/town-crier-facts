    {
      "id": 1,
      "text": "Joppa was founded in 1707 as a British colonial settlement on the Gunpowder River.",
      "sourceSentenceIds": [
        1,
        3
      ],
      "sourceLabels": [
        "Web source 1",
        "Wikipedia"
      ],
