      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The area first appeared as \"Old Town\" by residents, while the newer area was called \"New Town\".",
      "sourceSentenceIds": [
        30
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Old_Town%2C_Toronto",
