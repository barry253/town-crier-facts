      ],
      "source": "https://wiki-dale.win/index.php/Cultural_Heritage_and_Landmarks_of_Verbank,_NY:_A_Visitor%27s_Guide"
    },
    {
      "id": 2,
      "text": "The historic Verbank Schoolhouse, now preserved, regularly hosts community events and stands as a testament to local education.",
      "sourceSentenceIds": [
        13,
        14
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://wiki-dale.win/index.php/Cultural_Heritage_and_Landmarks_of_Verbank,_NY:_A_Visitor%27s_Guide"
    },
    {
      "id": 3,
      "text": "Camp Young Judaea Sprout Lake, founded in 1976, serves as a Zionist summer camp for children in grades two through eight.",
      "sourceSentenceIds": [
        19
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Verbank%2C_New_York"
    },
    {
      "id": 4,
      "text": "The Verbank Hunting And Fishing Club, opened in 1928, offers anglers a historic venue on Verbank Club Road.",
      "sourceSentenceIds": [
