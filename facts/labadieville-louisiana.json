  "facts": [
    {
      "id": 1,
      "text": "Labadieville, originally called Brûlée Labadie, takes its name from French pioneer Jean Louis Labadie who settled along Bayou Lafourche in the early 1800s.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Labadieville%2C_Louisiana",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Before European arrival, the area that is now Labadieville hosted Washa, Chawasha, and Chitimacha villages along Bayou Lafourche.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/labadieville_louisiana",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "After 1750, Labadieville welcomed Acadian exiles, Germans, Spanish, Portuguese, Irish, English, Italians, and Canary Islanders, shaping its multicultural heritage.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/labadieville_louisiana",
      "category": "people",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Philomena Catholic Church, built in the mid‑1700s, remains one of Labadieville's oldest standing structures.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.louisiana-destinations.com/labadieville.htm",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "In 1871, Labadieville's parish founded the Institute of the Immaculate Conception, running a parochial school for more than a century.",
      "sourceSentenceIds": [
