  "facts": [
    {
      "id": 1,
      "text": "Bald Head Island, historically known as Smith Island, sits on east side of Cape Fear River in Brunswick County.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Bald_Head_Island%2C_North_Carolina"
    },
    {
      "id": 2,
      "text": "The island's name originates from a long‑standing nickname, not from a literal bald head.",
      "sourceSentenceIds": [
        29
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Bald_Head_Island%2C_North_Carolina"
    },
    {
      "id": 3,
      "text": "In 1789, commissioners authorized a lighthouse at the Cape Fear River mouth, a beacon still guiding ships today.",
      "sourceSentenceIds": [
        21
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Bald_Head_Island%2C_North_Carolina"
    },
    {
      "id": 4,
      "text": "The Cape Fear Lifesaving Station, built in 1882 on East Beach, marked the island’s first organized rescue service.",
      "sourceSentenceIds": [
        24
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.starnewsonline.com/story/news/local/2024/09/16/a-timeline-of-development-for-bald-head-island-nc/74982845007/"
    },
    {
      "id": 5,
      "text": "2000 saw the opening of the Smith Island Museum of History, preserving the island’s layered past.",
      "sourceSentenceIds": [
        18
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.starnewsonline.com/story/news/local/2024/09/16/a-timeline-of-development-for-bald-head-island-nc/74982845007/"
    },
    {
