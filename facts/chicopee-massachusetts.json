      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The Chicopee Historical Society, founded in 1986, preserves the city’s heritage and offers residents a chance to rediscover local history.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 2"
      ],
