      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The Chicopee Canal Walk is a rail trail that follows the historic canal from Cabotville’s sycamore trees to the former Uniroyal factory site.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
