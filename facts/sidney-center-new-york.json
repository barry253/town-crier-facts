  "facts": [
    {
      "id": 1,
      "text": "Sidney Center sits 7.2 miles east‑southeast of the village of Sidney, New York.",
      "sourceSentenceIds": [
        13
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Sidney_Center%2C_New_York",
      "category": "other",
      "quality": "poor",
      "qualityReason": "location_description"
    },
    {
      "id": 2,
      "text": "The town was named Sidney in 1797 after British naval officer Sir Sidney Smith, a hero of the American and French revolutionary wars.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://townofsidneyny.gov/our-history/",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Early settlers were drawn to the area for its location near the confluence of the Unadilla and Susquehanna rivers, which offered transportation and food.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://townofsidneyny.gov/our-history/",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "In the 19th century, the Albany and Susquehanna Railroad and the Ontario and Western Railroad brought commerce to Sidney Center, turning it into a regional trade hub.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://townofsidneyny.gov/our-history/",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The Sidney Historical Association, located at 44 Grand Street, hosts a museum that showcases artifacts from Sidney’s early industries, including a French cheese factory and a silk mill.",
      "sourceSentenceIds": [
        2,
        10
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://sidneyhistory.com/",
      "category": "landmark",
      "quality": "good"
    }
  ],
