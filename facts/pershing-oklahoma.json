    },
    {
      "id": 2,
      "text": "Pershing originated as a small railroad station serving the local oil and gas fields in the early twentieth century.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/pershing_oklahoma"
    },
    {
      "id": 3,
      "text": "The community grew as a hub for workers during a major petroleum boom in east-central Osage County.",
