  "facts": [
    {
      "id": 1,
      "text": "Chehalis was founded in 1850 by Schuyler and Eliza Saunders on a donation land claim, originally called Saundersville.",
      "sourceSentenceIds": [
        1,
        9
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 2"
      ],
      "source": "https://en.wikipedia.org/wiki/Chehalis%2C_Washington",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town’s name changed to Chehalis in 1870, after the Northern Pacific Railroad arrived in 1873, cementing its role as a rail hub.",
      "sourceSentenceIds": [
        17,
        10
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 2"
      ],
      "source": "https://en.wikipedia.org/wiki/Chehalis%2C_Washington",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Chehalis sits where the Chehalis, Newaukum, and Skookumchuck rivers meet, a spot that has caused historic floods and shaped its identity.",
      "sourceSentenceIds": [
        6,
        11
      ],
      "sourceLabels": [
        "Wikipedia",
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Chehalis%2C_Washington",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "In 2008 the city opened the Vernetta Smith Chehalis Timberland Library, replacing a 1910 Carnegie library and honoring a local family matriarch.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Chehalis%2C_Washington",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Chehalis earned the nickname “The Maple Leaf City” thanks to its abundant maple trees and the convergence of waterways that fostered early industry.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Chehalis%2C_Washington",
      "category": "economy",
      "quality": "good"
    }
