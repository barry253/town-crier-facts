  "facts": [
    {
      "id": 1,
      "text": "Canongate's name comes from the route the Holyrood Abbey canons took to Edinburgh, called the canons' gait.",
      "sourceSentenceIds": [
        24
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/The_Canongate",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The Canongate Tolbooth, now the People's Story Museum, once served as a town hall and prison.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/The_Canongate",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "In 1707 a summerhouse garden in Canongate hosted the signing of the Treaty of Union.",
      "sourceSentenceIds": [
        14
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.scotland.org.uk/guide/places/canongate",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The Canongate Bridge was the main entrance to the historic burgh, leading from the bridge into the town.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://scotlandstartshere.com/point-of-interest/canongate/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Queen's House, now part of the Scottish Parliament complex, is a historic building in Canongate.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/The_Canongate",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The Canongate Kirk, opened in 1691, replaced Holyrood Abbey as the parish church of the area.",
