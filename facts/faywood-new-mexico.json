  "facts": [
    {
      "id": 1,
      "text": "Faywood was named after the developers of the Faywood Hot Springs, J.C. and T.C., who built the first resort in 1896.",
      "sourceSentenceIds": [
        1,
        3,
        15
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Faywood%2C_New_Mexico",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The original Hudson Hot Springs resort burned in 1892, forcing a rebuild that later became the famed Casa de Consuelo hotel.",
      "sourceSentenceIds": [
        9,
        3
      ],
      "sourceLabels": [
        "Web source 2",
        "Web source 1"
      ],
      "source": "https://unitedstatesghosttowns.com/faywood-new-mexico-ghost-town/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Soldiers from Camp Cody in the early 1900s brought international attention to Faywood’s healing waters.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://unitedstatesghosttowns.com/faywood-new-mexico-ghost-town/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Prehistoric peoples left mortar holes in the tufa dome, showing the springs were used by nomadic hunter‑gatherers long before Europeans.",
      "sourceSentenceIds": [
        25
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://faywoodhotsprings.com/about-us",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "After fires and war, Faywood was abandoned by 1952, yet visitors today can still walk among adobe ruins and soak the same thermal waters.",
      "sourceSentenceIds": [
        6,
        12
      ],
      "sourceLabels": [
        "Web source 2",
        "Web source 2"
      ],
      "source": "https://unitedstatesghosttowns.com/faywood-new-mexico-ghost-town/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "In 1993 Elon Yurwit and Wanda Fuselier revived Faywood, turning the deserted town into a modern hot‑spring destination while preserving historic foundations.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Web source 2"
      ],
