  "facts": [
    {
      "id": 1,
      "text": "Gananda, New York was originally planned as a community with approximately 17,000 houses and multiple neighborhood centers as part of a federal program in the 1970s.",
      "sourceSentenceIds": [
        1,
        2
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Gananda%2C_New_York",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The Gananda Central School District was created specifically for the planned city and had the unique ability to lease school facilities for community use after hours.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Gananda%2C_New_York",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Financial difficulties led to the end of the City of Gananda by 1974, despite significant infrastructure already being laid out.",
      "sourceSentenceIds": [
        8,
        11
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Gananda%2C_New_York",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The only completed public park in Gananda, New York, was Fox Tail Park, which originally featured a full playground and sports fields.",
      "sourceSentenceIds": [
        21,
        22
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Gananda%2C_New_York",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Gananda, New York is unique among its neighbors because all utility lines are buried underground, unlike surrounding areas where they are above ground.",
      "sourceSentenceIds": [
        26
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Gananda%2C_New_York",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The original educational facility in Gananda housed the entire K-12 school system until the 1980s, showcasing the community's early commitment to education.",
      "sourceSentenceIds": [
