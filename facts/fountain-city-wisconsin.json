  "facts": [
    {
      "id": 1,
      "text": "Fountain City is a small city bordering the Mississippi River in Buffalo County, Wisconsin.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Fountain_City%2C_Wisconsin"
    },
    {
      "id": 2,
      "text": "Fountain City was originally called Holmes' Landing after Thomas A. Holmes, who settled there in 1839.",
      "sourceSentenceIds": [
        5,
        13
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Fountain_City%2C_Wisconsin"
    },
    {
      "id": 3,
      "text": "The town took the name Fountain City because boats stopped at the landing to take on water from nearby springs.",
      "sourceSentenceIds": [
        14
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Fountain_City%2C_Wisconsin"
    },
    {
      "id": 4,
      "text": "Fountain City sits on a bend in the Mississippi River where the water flows at the base of the bluffs.",
      "sourceSentenceIds": [
        16
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Fountain_City%2C_Wisconsin"
    },
    {
      "id": 5,
      "text": "Eagle Creek flows around the base of Eagle Bluff, which is one of the tallest bluffs along the Mississippi River.",
      "sourceSentenceIds": [
        18
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Fountain_City%2C_Wisconsin"
    },
    {
      "id": 6,
      "text": "The steep bluffs of Fountain City are part of the Driftless Area, a region not smoothed over by glaciers.",
      "sourceSentenceIds": [
        19
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Fountain_City%2C_Wisconsin"
