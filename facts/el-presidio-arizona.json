  "facts": [
    {
      "id": 1,
      "text": "El Presidio San Agustín del Tucson opened its museum in 1976, offering walking tours that showcase the fort’s Spanish colonial roots.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://tucsonpresidio.com/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The fort was first built on March 28, 1776 by Juan Bautista de Anza’s expedition, marking the first Spanish military outpost in the Southwest.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Presidio_of_San_Francisco",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "El Presidio sits along the Juan Bautista de Anza National Historic Trail, a route that traces the original 1774–1776 expedition across Arizona.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.nps.gov/places/presidio-san-agustin-del-tucson.htm",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "In 1962 the fort earned National Historic Landmark status, recognizing its importance to U.S. military and colonial history.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Presidio_of_San_Francisco",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The museum’s Territorial Patio hosts a summer tavern series, where historians like Homer Thiel discuss Tucson’s saloon heritage.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://tucsonpresidio.com/",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Admission to the Presidio Museum’s summer tours costs $10 for members and $13 for non‑members, with a $15 door price for walk‑ins.",
      "sourceSentenceIds": [
        5
      ],
