  "facts": [
    {
      "id": 1,
      "text": "Solon Mills sits on U.S. Route 12, just 2 miles southwest of Spring Grove.",
      "sourceSentenceIds": [
        18,
        19
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Solon_Mills%2C_Illinois",
      "category": "other",
      "quality": "poor",
      "qualityReason": "location_description"
    },
    {
      "id": 2,
      "text": "The village grew around a saw mill, a grist mill, and a cheese and butter factory that once operated here.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://mchenryareahistoricalsociety.blogspot.com/2022/10/the-solon-mills-depot.html",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "In 1902 the Milwaukee Railroad built a depot north of Route 12, hoping the town would flourish.",
      "sourceSentenceIds": [
        7,
        8
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://mchenryareahistoricalsociety.blogspot.com/2022/10/the-solon-mills-depot.html",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The depot later moved to the intersection of Route 12 and Route 31, where it became a popular restaurant for half a century.",
      "sourceSentenceIds": [
        15,
        21
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://mchenryareahistoricalsociety.blogspot.com/2022/10/the-solon-mills-depot.html",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The original depot building, now closed as a restaurant, was hoped to be relocated again after its 2021 closure.",
      "sourceSentenceIds": [
        22
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://mchenryareahistoricalsociety.blogspot.com/2022/10/the-solon-mills-depot.html",
