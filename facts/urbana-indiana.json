  "facts": [
    {
      "id": 1,
      "text": "Urbana was called the '7-Mile Town' because it sat halfway between North Manchester and Wabash on the old Wabash Road.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/urbana_indiana"
    },
    {
      "id": 2,
      "text": "Platted in 1854 along the future Cincinnati, Wabash & Michigan Railroad, Urbana grew after the line arrived in 1874.",
      "sourceSentenceIds": [
        6,
        7
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/urbana_indiana"
    },
    {
      "id": 3,
      "text": "A 19th‑century German settler community helped build two churches—Evangelical and United Brethren—by the 1880s.",
      "sourceSentenceIds": [
        19
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/urbana_indiana"
    },
    {
      "id": 4,
      "text": "Urbana sits at 40°53′51″N 85°47′32″W, just 7 miles north of Wabash and 7 miles south of North Manchester.",
      "sourceSentenceIds": [
        21,
        22
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/urbana_indiana"
    },
    {
      "id": 5,
      "text": "The Wabash River, Indiana’s longest, flows east of Urbana, shaping local agriculture but the town itself has no major water bodies.",
      "sourceSentenceIds": [
        1,
        4
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/urbana_indiana"
    },
    {
      "id": 6,
      "text": "Climate is humid continental with warm summers and snowy winters, averaging 10.9°C yearly and 1050 mm rainfall.",
