      "id": 1,
      "text": "Urbana was called the '7-Mile Town' because it sat halfway between North Manchester and Wabash on the old Wabash Road.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 1"
      ],
