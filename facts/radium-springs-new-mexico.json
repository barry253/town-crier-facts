  "facts": [
    {
      "id": 1,
      "text": "When the post office opened, a water test revealed microcuries of radium, allowing the town to adopt the name Radium Springs.",
      "sourceSentenceIds": [
        26
      ],
      "sourceLabels": [
        "Web source 1"
      ],
