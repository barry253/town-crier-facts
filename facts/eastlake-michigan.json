  "facts": [
    {
      "id": 1,
      "text": "Eastlake was originally called Brooklyn and was founded by workers of the Louis Sands lumber mill in the 1870s.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.manisteenews.com/local-history/article/eastlake-grew-shaped-lumber-mills-143-years-ago-18369353.php",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The village officially appeared on maps in 1881 and got its post office name Eastlake in 1882.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.manisteenews.com/local-history/article/eastlake-grew-shaped-lumber-mills-143-years-ago-18369353.php",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Steam ferry boats once ran hourly between Eastlake and Manistee, and railroads later linked the village to the wider region.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.manisteenews.com/local-history/article/eastlake-grew-shaped-lumber-mills-143-years-ago-18369353.php",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Eastlake sits across Manistee Lake from the city of Manistee, with the Manistee River valley to its north.",
      "sourceSentenceIds": [
        10,
        13
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Eastlake%2C_Michigan",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The village incorporated in 1912, becoming an official municipality after decades of growth.",
      "sourceSentenceIds": [
        11
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Eastlake%2C_Michigan",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The village hall, located at 175 Main St, serves as the center for local government and community events.",
