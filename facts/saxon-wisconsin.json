      "id": 1,
      "text": "Saxon is located in Iron County, Wisconsin, and serves as a direct connection to the historic mouth of the Montreal River.",
      "sourceSentenceIds": [
        9,
        13
      ],
      "sourceLabels": [
        "Wikipedia",
