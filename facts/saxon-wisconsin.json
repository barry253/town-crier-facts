    },
    {
      "id": 2,
      "text": "French explorers visited Cree bands near the Montreal River in the 1660s, highlighting the long-standing Indigenous presence in Saxon.",
      "sourceSentenceIds": [
        1,
        6
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/saxon_wisconsin"
    },
    {
      "id": 3,
      "text": "European immigrants from Germany and other regions settled Saxon in the mid-19th century to mine the resource-rich Penokee Range.",
      "sourceSentenceIds": [
        3,
        4
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/saxon_wisconsin"
    },
    {
      "id": 4,
      "text": "Saxon Harbor once served as a strategic supply point for shipping iron ore from the region to distant smelters.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/saxon_wisconsin"
    },
    {
      "id": 5,
      "text": "The logging industry became a dominant force in Saxon during the late 1800s to supply wood for regional railroads and charcoal kilns.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/saxon_wisconsin"
    },
