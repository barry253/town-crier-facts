      "id": 1,
      "text": "Nikolaiviertel’s streets were rebuilt in 1987 mixing reconstructed historic houses with concrete Plattenbau blocks, giving it a unique look.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
