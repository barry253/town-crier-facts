      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "High Falls on Agawamuck Creek drops over 30 feet right in the village center, a favorite spot for locals.",
      "sourceSentenceIds": [
        28
      ],
      "sourceLabels": [
