  "facts": [
    {
      "id": 1,
      "text": "Boaz was officially founded on November 11, 1878, when the Sparks family from Georgia settled the area.",
      "sourceSentenceIds": [
        2,
        5
      ],
      "sourceLabels": [
        "Web source 2",
        "Wikipedia"
      ],
      "source": "https://encyclopediaofalabama.org/article/boaz/"
    },
    {
      "id": 2,
      "text": "The town’s name comes from the biblical figure Boaz, a husband of Ruth, and the name was adopted by 1886.",
      "sourceSentenceIds": [
        1,
        8
      ],
      "sourceLabels": [
        "Web source 1",
        "Web source 2"
      ],
      "source": "https://www.cityofboaz.org/195/History-of-Boaz"
    },
    {
      "id": 3,
      "text": "A railroad line arrived in 1892, and Boaz was incorporated in 1897, though some records suggest 1884.",
      "sourceSentenceIds": [
        16
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://encyclopediaofalabama.org/article/boaz/"
    },
    {
      "id": 4,
      "text": "After the Civil War, Boaz became a hub for used automobile sales and repair, a trend that continued into the 1970s with factory outlet stores.",
      "sourceSentenceIds": [
        10,
        27
      ],
      "sourceLabels": [
        "Web source 2",
        "Wikipedia"
      ],
      "source": "https://encyclopediaofalabama.org/article/boaz/"
    },
    {
      "id": 5,
      "text": "The Snellgrove Homestead and the Edward Fenns Whitman House in Boaz are listed on the National Register of Historic Places.",
      "sourceSentenceIds": [
        12,
        17
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 2"
      ],
      "source": "https://en.wikipedia.org/wiki/Boaz%2C_Alabama"
    },
    {
      "id": 6,
      "text": "Every Fourth of July, Boaz hosts a fireworks display and concert, and late July features an antique tractor show.",
      "sourceSentenceIds": [
