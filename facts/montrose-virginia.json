      "id": 1,
      "text": "Montrose means \"dark mountain\" in Old French, a name that likely reflects the dark‑shaded hills surrounding the town.",
      "sourceSentenceIds": [
        3,
        18
      ],
      "sourceLabels": [
        "Web source 1"
      ],
