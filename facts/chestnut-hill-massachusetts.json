  "facts": [
    {
      "id": 1,
      "text": "Chestnut Hill takes its name from Francis Lee, who built the area’s first country house in the 1850s.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://brooklinehistoricalsociety.org/history/pehlke/ChestnutHill.asp",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "A railroad stop opened by 1854 near today’s MBTA station at the intersection of Dunster and Middlesex Roads.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.brooklinema.gov/4077/Chestnut-Hill-Local-Historic-District",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The first suburban homes appeared in 1886‑7 at 40, 50, and 52 Dunster Road beside the new Richardson station.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.brooklinema.gov/4077/Chestnut-Hill-Local-Historic-District",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Eastward growth in the early 1900s followed the rise of the automobile, moving farther from the original station.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.brooklinema.gov/4077/Chestnut-Hill-Local-Historic-District",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Chestnut Hill sits six miles west of downtown Boston, spanning Brookline, Newton, and Boston across two counties.",
