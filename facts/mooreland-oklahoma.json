    },
    {
      "id": 2,
      "text": "The town was first called Dail City, but the government denied the name because another town with that name already existed.",
      "sourceSentenceIds": [
        7,
        29
      ],
      "sourceLabels": [
        "Web source 2",
        "Wikipedia"
      ],
      "source": "https://www.okhistory.org/publications/enc/entry?entry=MO016"
    },
    {
      "id": 3,
      "text": "Mooreland got its current spelling because an extra letter o was accidentally added to the official plat and registration.",
      "sourceSentenceIds": [
