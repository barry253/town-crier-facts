  "facts": [
    {
      "id": 1,
      "text": "Bakerstown’s name comes from Thomas Baker, a Nova Scotian who bought the original lots in 1810.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://richland.pa.us/199/Township-History",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town’s first hotel, the Bakerstown Hotel, opened around 1810 and survived a massive fire in 1922 before relocating.",
      "sourceSentenceIds": [
        27
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.pittsburghbeautiful.com/2024/03/25/bakerstown/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "A single narrow‑gauge track was laid through Bakerstown in 1870 by the Pittsburgh, New Castle, and Lake Erie Railroad.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://richland.pa.us/199/Township-History",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "By 1959 every telephone exchange in Bakerstown had switched to dial service, thanks to the North Pittsburgh Telephone Company founded in 1906.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.pittsburghbeautiful.com/2024/03/25/bakerstown/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The town sits on land that was once part of the “Depreciation Lands” in Cunningham’s District 4.",
      "sourceSentenceIds": [
        22
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://richland.pa.us/199/Township-History",
      "category": "other",
      "quality": "poor",
      "qualityReason": "other"
    },
    {
