  "facts": [
    {
      "id": 1,
      "text": "Brookfield Center was platted in 1806 with a central green set aside, echoing New England town layouts.",
      "sourceSentenceIds": [
        2,
        7
      ],
      "sourceLabels": [
        "Web source 1",
        "Wikipedia"
      ],
      "source": "https://grokipedia.com/page/brookfield_center_ohio",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Judge Samuel Hinckley named the township after Brookfield, England, after winning a 15,305‑acre lot in the 1798 Connecticut Land Company lottery.",
      "sourceSentenceIds": [
        20,
        29
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/brookfield_center_ohio",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The first settler, James McMullen, arrived in 1801 on a 160‑acre parcel from Hinckley, marking the start of permanent habitation.",
      "sourceSentenceIds": [
        21
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/brookfield_center_ohio",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "In the 1830s coal discoveries spurred growth, and by the early 1900s Frederick Masury ran an explosives plant that operated until 1930.",
      "sourceSentenceIds": [
        22
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/brookfield_center_ohio",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The Overland Stage Line connected Brookfield to cities like Erie and Dunkirk in the mid‑1820s, making it a regional travel hub.",
      "sourceSentenceIds": [
        23
