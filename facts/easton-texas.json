  "facts": [
    {
      "id": 1,
      "text": "Easton sits on Farm Road 2906, ten miles southeast of Longview in southeastern Gregg County and northeastern Rusk County.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.tshaonline.org/handbook/entries/easton-tx"
    },
    {
      "id": 2,
      "text": "In 1885 the Texas, Sabine Valley and Northwestern Railway built a line through Easton, sparking a sawmill boom by the late 1880s.",
      "sourceSentenceIds": [
        27
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.tshaonline.org/handbook/entries/easton-tx"
    },
    {
      "id": 3,
      "text": "A post office reopened in March 1949, shortly after Easton incorporated and began a new chapter of growth.",
      "sourceSentenceIds": [
        30
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.tshaonline.org/handbook/entries/easton-tx"
    },
    {
      "id": 4,
      "text": "Oilfields discovered in the 1940s revived Easton, drawing workers and reshaping the town’s economy.",
      "sourceSentenceIds": [
        29
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.tshaonline.org/handbook/entries/easton-tx"
    },
    {
      "id": 5,
      "text": "The town’s name appears as the title of a 1957 CBS Western episode, “Easton, Texas,” starring Robert Culp.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Easton%2C_Texas"
    },
    {
      "id": 6,
      "text": "Easton prides itself on small‑town values, guided growth, and preserving its historical, cultural, and natural heritage.",
      "sourceSentenceIds": [
        11
      ],
