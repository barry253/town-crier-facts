  "facts": [
    {
      "id": 2,
      "text": "The town’s name comes from the Lenape word Peshtank, meaning “where the waters stand,” later anglicized to Paxtang.",
      "sourceSentenceIds": [
        13
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Paxtang%2C_Pennsylvania",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Paxtang dates to the 18th century when Euro‑Americans settled on the site of the Shawnee‑Lenape village of Peshtank.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Paxtang%2C_Pennsylvania",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The Old Paxton Church, built in 1740, is the oldest Presbyterian church building in continuous use in Pennsylvania and the second oldest in the U.S.",
      "sourceSentenceIds": [
        21,
        22
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Paxtang%2C_Pennsylvania",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Paxtang was the site where Presbyterian Scotch‑Irish frontiersmen organized the Paxton Boys, a vigilante group involved in the Conestoga Massacre.",
      "sourceSentenceIds": [
        17
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Paxtang%2C_Pennsylvania",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The borough hosts historic homes and structures such as the Paxtang Municipal Building, Paxtang Elementary School, and Paxton Presbyterian Church.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 1"
      ],
