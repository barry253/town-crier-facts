  "facts": [
    {
      "id": 2,
      "text": "The town\u2019s name comes from the Lenape word Peshtank, meaning \u201cwhere the waters stand,\u201d later anglicized to Paxtang.",
      "sourceSentenceIds": [
        13
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Paxtang%2C_Pennsylvania",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Paxtang dates to the 18th century when Euro\u2011Americans settled on the site of the Shawnee\u2011Lenape village of Peshtank.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Paxtang%2C_Pennsylvania",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The Old Paxton Church, built in 1740, is the oldest Presbyterian church building in continuous use in Pennsylvania and the second oldest in the U.S.",
      "sourceSentenceIds": [
        21,
        22
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Paxtang%2C_Pennsylvania",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Paxtang was the site where Presbyterian Scotch\u2011Irish frontiersmen organized the Paxton Boys, a vigilante group involved in the Conestoga Massacre.",
      "sourceSentenceIds": [
        17
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Paxtang%2C_Pennsylvania",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The borough hosts historic homes and structures such as the Paxtang Municipal Building, Paxtang Elementary School, and Paxton Presbyterian Church.",
