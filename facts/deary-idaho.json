  "facts": [
    {
      "id": 1,
      "text": "Deary was founded in 1907 and named after lumber businessman William Deary.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Deary%2C_Idaho",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town was renamed 'Deary' when the railroad reached it, turning a waystation into a rail hub.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Deary%2C_Idaho",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Deary sits at the base of Potato Hill, locally called 'Spud Hill,' and offers nearby camping and fishing between Spring Valley Reservoir and Moose Creek.",
      "sourceSentenceIds": [
        18
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Deary%2C_Idaho",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The original post office building and an original home on Main Street still stand, preserving Deary's early 20th-century character.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.dearyidaho.com/history.html",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Before becoming Deary, the waystation was known as Spud Hill and later Anderson, owned by Joe and Lou Wells.",
      "sourceSentenceIds": [
        10,
