  "facts": [
    {
      "id": 1,
      "text": "Hazel Green was named for the hazel shrubs that were prevalent in the area when its post office opened in 1829.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Hazel_Green%2C_Kentucky"
    },
    {
      "id": 2,
      "text": "Hazel Green developed along the Red River and was incorporated in 1856, before Wolfe County was even organized.",
      "sourceSentenceIds": [
        24,
        28
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://appalachianhistorian.org/hazel-green-wolfe-county-education-healing-waters-and-mountain-community/"
    },
    {
      "id": 3,
      "text": "Local tradition says a mineral spring in Hazel Green gained a reputation for healing after its owner used it to treat a dog.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://appalachianhistorian.org/hazel-green-wolfe-county-education-healing-waters-and-mountain-community/"
    },
    {
      "id": 4,
      "text": "By the late nineteenth century, Hazel Green became a regional center with its own newspaper, hotels, and a celebrated mineral spring.",
      "sourceSentenceIds": [
        23
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://appalachianhistorian.org/hazel-green-wolfe-county-education-healing-waters-and-mountain-community/"
    },
    {
      "id": 5,
      "text": "Hazel Green Academy once served as one of the most important educational institutions in Appalachian Kentucky.",
      "sourceSentenceIds": [
