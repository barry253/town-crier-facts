  "facts": [
    {
      "id": 1,
      "text": "Linville was founded in 1883 and was once called Clay or Porcelain.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Linville%2C_North_Carolina",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town was named after William and John Linville, who were killed by Cherokees in 1766.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Linville%2C_North_Carolina",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The East Tennessee and Western North Carolina Railroad, nicknamed Tweetsie, ran through Linville from 1916 until a 1940 flood washed away the tracks.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Linville%2C_North_Carolina",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Linville sits in the Blue Ridge Mountains, surrounded by Grandmother, Flat Rock, Pixie, Moore, Brier Knob, and Grandfather Mountains.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Linville%2C_North_Carolina",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The Linville River, draining into Lake Kawahna and Grandmother Lake, cuts through the community and feeds local waterfalls.",
      "sourceSentenceIds": [
        13
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Linville%2C_North_Carolina",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Linville hosts the Grandfather Mountain Highland Games, the largest modern Highland games event in North Carolina.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Linville%2C_North_Carolina",
