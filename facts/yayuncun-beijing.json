      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Yayuncun_Subdistrict",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Since the Games, Yayuncun has evolved into a high‑end residential enclave featuring landmarks like the Beijing International Conventions Center and the North Star Shopping Center.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Yayuncun_Subdistrict",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Yayuncun played host to the historic Fourth World Conference on Women, a landmark event in gender equality advocacy.",
