      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Every year after Easter, Hilo hosts the Merrie Monarch Festival, a week‑long hula competition that celebrates both ancient and modern dance.",
      "sourceSentenceIds": [
        21
      ],
      "sourceLabels": [
        "Wikipedia"
