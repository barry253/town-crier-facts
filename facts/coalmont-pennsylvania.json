  "facts": [
    {
      "id": 1,
      "text": "Coalmont is a borough in Huntingdon County, Pennsylvania, situated in the valley of Shoup Run.",
      "sourceSentenceIds": [
        15,
        16
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Coalmont%2C_Pennsylvania"
    },
    {
      "id": 2,
      "text": "Coalmont's origins trace back to the early 1840s when the area was sparsely settled within Carbon Township.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/coalmont_pennsylvania"
    },
    {
      "id": 3,
      "text": "The Huntingdon and Broad Top Mountain Railroad facilitated coal transport during the area's peak mining era from 1862 to 1865.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/coalmont_pennsylvania"
    },
    {
      "id": 4,
      "text": "Coalmont was officially incorporated on December 21, 1864, after being formed from a portion of Carbon Township.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/coalmont_pennsylvania"
    },
    {
      "id": 5,
      "text": "Local mining operations utilized underground drift and slope mines to extract semi-bituminous coal from the Broad Top Field.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/coalmont_pennsylvania"
    },
    {
      "id": 6,
      "text": "Coalmont experiences a humid continental climate with cold, snowy winters and mild, humid summers in the Appalachian Mountains.",
      "sourceSentenceIds": [
        14
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/coalmont_pennsylvania"
    }
