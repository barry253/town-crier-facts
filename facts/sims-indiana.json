  "facts": [
    {
      "id": 1,
      "text": "The Miami tribe originally inhabited Sims Township, part of a confederacy that controlled much of central Indiana.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/sims_township_grant_county_indiana",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Sims Township was organized in 1848 after surveying its 36 sections in 1827, once part of the Miami Indian Reserve.",
      "sourceSentenceIds": [
        22
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/sims_township_grant_county_indiana",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Early settlers in Sims faced malaria and bridgeless streams, but later drainage tiles, gravel roads, and railroads like the Pennsylvania Railroad and Clover Leaf line spurred growth.",
      "sourceSentenceIds": [
        25
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/sims_township_grant_county_indiana",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Sims is one of two Indiana communities named Sims; the other is located in Bartholomew County.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://roadsidethoughts.com/in/sims-xx-grant-profile.htm",
      "category": "other",
      "quality": "poor",
      "qualityReason": "other"
    },
    {
      "id": 5,
      "text": "White settlement in Sims Township began after the 1818 Treaty of St., marking the first permanent European presence in the area.",
      "sourceSentenceIds": [
