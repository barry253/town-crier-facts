  "facts": [
    {
      "id": 1,
      "text": "Laval was named after François de Montmorency‑Laval, the first Roman Catholic Bishop of Quebec.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Laval%2C_Quebec",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The island’s first European settlers were Jesuits granted a seigneury in 1636, and by 1675 François de Montmorency‑Laval controlled it.",
      "sourceSentenceIds": [
        22,
        23
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Laval%2C_Quebec",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "In 1965 the whole island was merged into a single city of Laval, a move that sparked controversy but set the stage for modern growth.",
      "sourceSentenceIds": [
        29
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Laval%2C_Quebec",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The Montreal Metro reached Laval in 2007 with three new stations—Cartier, De la Concorde, and Montmorency—expanding commuter links.",
      "sourceSentenceIds": [
        10,
        12
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Laval%2C_Quebec",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Agriculture appeared in Laval as early as 1670, long before the area became a suburban hub.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Laval%2C_Quebec",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The city’s heritage dates back over 400 years, yet it officially came into being in 1965, reflecting a blend of old and new.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Web source 1"
      ],
