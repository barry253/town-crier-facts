  "facts": [
    {
      "id": 1,
      "text": "Old Fourth Ward is the birthplace of Martin Luther King Jr., with his boyhood home at 501 Auburn Avenue now part of the National Historic Site.",
      "sourceSentenceIds": [
        11,
        12,
        13
      ],
      "sourceLabels": [
        "Web source 1",
        "Web source 2"
      ],
      "source": "https://atlantaandbeyond.com/atlanta-old-fourth-ward-neighborhood-guide-mlk-historic-district/",
      "category": "people",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The neighborhood hosts the historic Ebenezer Baptist Church, where King was baptized and his father preached.",
      "sourceSentenceIds": [
        13
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.exploreatl.com/old-fourth-ward.html",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The BeltLine Eastside Trail runs through Old Fourth Ward, passing industrial sites like the DuPre Excelsior Mill and National NuGrape Company lofts.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Old_Fourth_Ward",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Ponce City Market, a mixed‑use development, sits on the former Sears, Roebuck & Co. building in the Old Fourth Ward.",
      "sourceSentenceIds": [
        19
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Old_Fourth_Ward",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Old Fourth Ward retains its historic name, the only Atlanta neighborhood still called by its original city council district.",
      "sourceSentenceIds": [
        25
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://atlantaandbeyond.com/atlanta-old-fourth-ward-neighborhood-guide-mlk-historic-district/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "After the 1906 Race Riots, the area shifted from a white to a black neighborhood, becoming a center of African‑American culture.",
