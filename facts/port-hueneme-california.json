  "facts": [
    {
      "id": 1,
      "text": "Port Hueneme’s name derives from the Spanish spelling of the Chumash word Wene Me, meaning \"Resting Place\".",
      "sourceSentenceIds": [
        21
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Port_Hueneme%2C_California",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town officially became Port Hueneme in 1939 and was incorporated on March 24, 1948.",
      "sourceSentenceIds": [
        22
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Port_Hueneme%2C_California",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Thomas Bard built the original Hueneme Wharf in 1871 after spotting a deep submarine canyon that made the site ideal for shipping.",
      "sourceSentenceIds": [
        26,
        11
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 2"
      ],
      "source": "https://en.wikipedia.org/wiki/Port_Hueneme%2C_California",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "A 650‑foot pier erected in 1956 began as a sewer‑outfall trestle before evolving into the fishing pier locals use today.",
      "sourceSentenceIds": [
        29
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Port_Hueneme%2C_California",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Each year the Harbor Days Festival brings food, live bands, and contests—kite‑flying, sand sculpture, and more—to Port Hueneme’s waterfront.",
      "sourceSentenceIds": [
        5,
        6,
        16
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Port_Hueneme%2C_California",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The Waterfront Promenade, also called Lighthouse Promenade, stretches along the shore and showcases the historic 1872 Wharf and Oxnard Packing House.",
