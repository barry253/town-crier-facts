  "facts": [
    {
      "id": 1,
      "text": "Beavercreek’s Wartinger Historical Park hosts an annual Ice Cream Social that celebrates the city’s history with local stories and period artifacts.",
      "sourceSentenceIds": [
        21,
        23
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://beavercreekhistoricalsociety.org/",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The Interpretive Center at Wartinger Park is built to look like a Shawnee longhouse, honoring the Native American heritage of the Little Miami River area.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://beavercreekhistoricalsociety.org/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Beavercreek grew from a 19th‑century agricultural township into a thriving suburban center as Ohio’s population expanded westward.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.wisdomlib.org/cities/beavercreek-11677",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The city’s name means a creek frequented by beavers, reflecting the natural wildlife that once thrived in the area.",
      "sourceSentenceIds": [
        27
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.wisdomlib.org/cities/beavercreek-11677",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Local historian Brett Williford often shares tall tales about Beavercreek’s early settlers, the Shawnee people, and the city’s role in Ohio’s settlement.",
      "sourceSentenceIds": [
        5,
        18,
        19
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://beavercreekhistoricalsociety.org/",
      "category": "people",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Beavercreek’s historic cabins—home to families like the Harshmans and Ankeneys—are preserved in Wartinger Park, offering a glimpse into the city’s pioneer era.",
      "sourceSentenceIds": [
        23
      ],
      "sourceLabels": [
        "Web source 1"
      ],
