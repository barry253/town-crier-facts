  "facts": [
    {
      "id": 1,
      "text": "Crystal Lake Park grew from Dwyer Station, founded in 1839 by Dwyer, which once sat at the corner of Clayton and Denny Roads.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.crystallakepark.org/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Oehler Drive, once the main street off Bopp Road, was renamed Country Club Drive in the mid‑1950s.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.crystallakepark.org/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Hunter Park on the west side of Putter Lane honors the Hunter families for their long‑standing contributions to the community.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.crystallakepark.org/",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Boland Bridge over Two‑Mile Creek on Country Club Drive commemorates Donald Boland, a former Street Commissioner who oversaw the bridge’s replacement.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.crystallakepark.org/",
      "category": "other",
      "quality": "poor",
      "qualityReason": "vague"
    },
    {
      "id": 5,
      "text": "The town’s golf course was originally owned by the Oehlers, a family that helped shape early recreation in the area.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.crystallakepark.org/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Crystal Lake Park’s history is actively collected through photos, maps, and remembrances, preserving the city’s heritage for future generations.",
      "sourceSentenceIds": [
