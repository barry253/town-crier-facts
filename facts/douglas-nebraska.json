  "facts": [
    {
      "id": 1,
      "text": "Douglas, Nebraska, got its name from Harriet Douglass McKibbon, the maiden name of the original townsite owner's wife.",
      "sourceSentenceIds": [
        16
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/douglas_nebraska",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "In 1887, Simpson McKibbon sold land to the Missouri Pacific Railroad, and the village was quickly renamed Douglas to align with the rail line.",
      "sourceSentenceIds": [
        15,
        14,
        4
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/douglas_nebraska",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The village board steers local affairs, hosting community events that preserve Douglas’s historic charm on Nebraska’s southeastern plains.",
      "sourceSentenceIds": [
        13
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/douglas_nebraska",
      "category": "other",
      "quality": "poor",
      "qualityReason": "editorial_filler"
    },
    {
      "id": 4,
      "text": "Douglas marked its 100th anniversary in 1988 with a yearbook that chronicled a century of local history and achievements.",
      "sourceSentenceIds": [
        17
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/douglas_nebraska",
