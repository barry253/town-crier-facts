      "id": 1,
      "text": "Douglas, Nebraska, got its name from Harriet Douglass McKibbon, the maiden name of the original townsite owner's wife.",
      "sourceSentenceIds": [
        16
      ],
      "sourceLabels": [
        "Web source 1"
      ],
