      ],
      "source": "https://westernmininghistory.com/towns/california/johnsville/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The Johnsville Historical Society was founded in 1991 to preserve the region’s rich mining, railroad, and timber heritage.",
      "sourceSentenceIds": [
