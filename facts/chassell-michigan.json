  "facts": [
    {
      "id": 1,
      "text": "Chassell takes its name from John Chassell, one of the area’s earliest European settlers.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.visitkeweenaw.com/blog/post/a-historical-guide-to-visiting-chassell-michigan/",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "John Chassell helped raise $160,000 to start the First National Bank of Houghton and later served as its first cashier.",
      "sourceSentenceIds": [
        1,
        7
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 2"
      ],
      "source": "https://en.wikipedia.org/wiki/Chassell%2C_Michigan",
      "category": "people",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Two railroads crossed Chassell: the Duluth South Shore & Atlantic hauled logs, while the Houghton Chassell & Southwestern linked the town to the world.",
      "sourceSentenceIds": [
        18,
        19
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.chassellhistory.org/",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The Heritage Center’s building celebrated its centennial in 1917; after the school closed in 1992 it has been cared for by the Chassell Historical Organization.",
      "sourceSentenceIds": [
        12,
        13
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.chassellhistory.org/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The Chassell School Complex, with a 1912 high school and a 1917 elementary building, earned a spot on the National Register of Historic Places in 2009.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Chassell%2C_Michigan",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "In 1887 the Sturgeon River Lumber Company built the ‘Chassell House’ near its mill to accommodate the growing workforce.",
