    },
    {
      "id": 2,
      "text": "The Turkey Point Light Station in North East joined the National Register of Historic Places in 2002.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/North_East%2C_Maryland"
    },
    {
      "id": 3,
      "text": "North East sits at the headwaters of the Chesapeake Bay, just under an hour from Philadelphia and Baltimore.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.northeastmd.org/town-information/about-north-east/"
    },
    {
      "id": 4,
      "text": "The McCullough and Iron Company, once in North East, produced the first galvanized sheet iron in the United States.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 2"
      ],
