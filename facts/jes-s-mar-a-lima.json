  "facts": [
    {
      "id": 1,
      "text": "Jesús María hosts a monument to the 1942 War of 1942, a monument to Japanese immigration, and the Eye that Cries memorial.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Jes%C3%BAs_Mar%C3%ADa_District%2C_Lima",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The Natural History Museum, managed by the National University of San Marcos, is a must‑visit for curious travelers in Jesús María.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://pueblolibrelima.com/tourist-attractions-in-jesus-maria/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Residencial San Felipe, built on the former San Felipe horse track, blends high density living with green space and shopping, defining Jesús María’s middle‑class identity.",
      "sourceSentenceIds": [
        25,
        26
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Jes%C3%BAs_Mar%C3%ADa_District%2C_Lima",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Before Spanish colonization, the area now known as Jesús María belonged to the Curacazgo of Guatca, following the Huatica river.",
      "sourceSentenceIds": [
        18,
        19
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Jes%C3%BAs_Mar%C3%ADa_District%2C_Lima",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "El Campo de Marte, one of Lima’s largest parks, stretches across Jesús María and offers sweeping city views.",
      "sourceSentenceIds": [
        30
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Jes%C3%BAs_Mar%C3%ADa_District%2C_Lima",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Jesús María is famed for its Asian‑influenced cuisine, with Chifa and Nikkei restaurants drawing food lovers from across Lima.",
      "sourceSentenceIds": [
