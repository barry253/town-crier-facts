  "facts": [
    {
      "id": 1,
      "text": "Bossier City was incorporated in 1907 and named after Pierre Evariste John Baptiste Bossier, a former Creole general turned cotton planter.",
      "sourceSentenceIds": [
        2,
        7
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Bossier_City%2C_Louisiana"
    },
    {
      "id": 2,
      "text": "The city’s official flag was designed by local artist Velma Hagert and unveiled during a 1951 city slogan contest.",
      "sourceSentenceIds": [
        20,
        23
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.bossierlibrary.org/node/25769"
    },
    {
      "id": 3,
      "text": "Bossier City’s history center celebrates its 1951 formal classification with ceremonies that included bands from local high schools and Barksdale Air Force Base.",
      "sourceSentenceIds": [
        17,
        18
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.bossierlibrary.org/node/25769"
    },
    {
      "id": 4,
      "text": "The town grew from a cotton‑exporting river landing to a railroad hub, then an airbase and oil‑boom town, now known for tourism and casino gambling.",
      "sourceSentenceIds": [
        13
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Bossier_City%2C_Louisiana"
    },
    {
      "id": 5,
      "text": "Bossier City shares its television and radio markets with Shreveport and the Texarkana metropolitan area as part of the Ark‑La‑Tex region.",
