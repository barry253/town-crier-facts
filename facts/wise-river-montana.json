    },
    {
      "id": 3,
      "text": "In the early 1800s, the Wise River area served as a buffer zone for tribes like the Shoshone, Blackfeet, Nez Perce, and Salish.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://discoveringmontana.com/rivers/wise/"
    },
    {
      "id": 4,
      "text": "The 49‑mile Pioneer Mountains Scenic Byway follows the Wise River from its source, offering scenic turns to historic sites like Coolidge.",
      "sourceSentenceIds": [
        25,
        26
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://discoveringmontana.com/rivers/wise/"
    },
    {
      "id": 5,
      "text": "Wise River is one of North America’s fastest‑flowing tributaries, a mountain creek that roars over boulders.",
      "sourceSentenceIds": [
        15
