      ],
      "source": "https://en.wikipedia.org/wiki/Goodsprings%2C_Nevada",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The 1913 Pioneer Saloon remains open, its cherry‑wood walls having hosted films like Fear and Loathing in Las Vegas and shows such as Ghost Adventures.",
      "sourceSentenceIds": [
        3,
        8,
        30
      ],
      "sourceLabels": [
        "Web source 1",
