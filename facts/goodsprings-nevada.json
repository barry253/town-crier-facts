      ],
      "source": "https://offroad.vegas/goodsprings-nevada-history/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Goodsprings is a living ghost town, founded in 1856 by Mormon miners who discovered lead ore, and it still retains its historic charm.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Web source 2"
