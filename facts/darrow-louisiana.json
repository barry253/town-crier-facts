    {
      "id": 1,
      "text": "Before European arrival, the Darrow area was home to Houma, Bayogoula, and Tchitimacha tribes along the Mississippi and Bayou Lafourche.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
