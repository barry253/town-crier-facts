      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The Jackson Historical Society, founded in 1977, preserves artifacts, maps, books, and 19th‑century White Mountain art.",
      "sourceSentenceIds": [
        1,
        11,
        15
      ],
      "sourceLabels": [
        "Web source 1"
      ],
