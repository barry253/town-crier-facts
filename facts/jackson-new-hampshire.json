      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town’s historic 1879 Town Hall, now home to the Jackson Historical Society, is listed on the National Register of Historic Places.",
      "sourceSentenceIds": [
        14
      ],
      "sourceLabels": [
        "Web source 1"
      ],
