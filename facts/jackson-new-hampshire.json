      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "In 1916 the Glen Ellis House, a mansard‑roofed hotel built 1875‑6, was added as a 100‑guest annex to Wentworth Hall, raising capacity to 350.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Wikipedia"
