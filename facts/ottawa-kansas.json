  "facts": [
    {
      "id": 1,
      "text": "Ottawa was founded on land donated by the Ottawa tribe, who gave 20,000 acres to start Ottawa University in 1864.",
      "sourceSentenceIds": [
        11
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Ottawa%2C_Kansas",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The city’s name comes from the Ottawa tribe, whose word means “to trade.”.",
      "sourceSentenceIds": [
        10,
        12
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Ottawa%2C_Kansas",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Ottawa sits on both banks of the Marais des Cygnes River, a spot that has flooded many times, including a deadly 1928 flood that crested at 38.65 feet.",
      "sourceSentenceIds": [
        8,
        16
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Ottawa%2C_Kansas",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The Great Flood of 1951 covered a third of Ottawa, making it the most famous flood in the city’s history.",
      "sourceSentenceIds": [
        18,
        21
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Ottawa%2C_Kansas",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Ottawa is the county seat of Franklin County and lies 58 miles southwest of Kansas City at the junction of U.S. Route 50 and Interstate 35.",
      "sourceSentenceIds": [
        7,
        26,
        27
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Ottawa%2C_Kansas",
      "category": "transport",
      "quality": "poor",
      "qualityReason": "route_only"
    },
    {
      "id": 6,
      "text": "The city hosts Ottawa University, a private liberal arts college founded in 1865 that remains a central part of the community.",
