  "facts": [
    {
      "id": 1,
      "text": "Littlerock, named after the Little Rock Wash, earned its nickname “The Fruit Basket of the Antelope Valley” with historic orchards of almonds, apples, peaches, and pears.",
      "sourceSentenceIds": [
        1,
        8
      ],
      "sourceLabels": [
        "Web source 1",
        "Wikipedia"
      ],
      "source": "https://littlerockrcofc.org/",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Founded in 1893, Littlerock grew into an agricultural hub of about 12,600 residents, nestled in the San Gabriel Mountains foothills roughly 50 miles north of Los Angeles.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://digital-desert.wrightwoodcalifornia.com/littlerock-ca/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The 1924 Littlerock Dam, a historic architectural landmark, still supplies irrigation water to orchards and offers boating, fishing, and camping on its reservoir.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://digital-desert.wrightwoodcalifornia.com/littlerock-ca/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Public transit in Littlerock is operated by the Antelope Valley Transit Authority, connecting residents to nearby cities.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Littlerock%2C_California",
      "category": "transport",
      "quality": "poor",
      "qualityReason": "route_only"
    },
    {
      "id": 5,
      "text": "Littlerock celebrated its first schoolhouse opening in 1913 and the founding of its first library a year later in 1914.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://digital-desert.wrightwoodcalifornia.com/littlerock-ca/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Littlerock lies 11 miles southeast of Palmdale’s Civic Center, bordered by Palmdale, Pearblossom, Sun Village, and the San Gabriel Mountains.",
      "sourceSentenceIds": [
        9,
