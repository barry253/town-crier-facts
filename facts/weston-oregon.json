  "facts": [
    {
      "id": 1,
      "text": "Weston is located at the foot of the Blue Mountains on Pine Creek.",
      "sourceSentenceIds": [
        13
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Weston%2C_Oregon"
    },
    {
      "id": 2,
      "text": "Weston was originally a post office called Mitchell's Station, established in February 1867.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Weston%2C_Oregon"
    },
    {
      "id": 3,
      "text": "A man named Lieuallen renamed the town after his hometown of Weston, Missouri.",
      "sourceSentenceIds": [
        1,
        5
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Weston%2C_Oregon"
    },
    {
      "id": 4,
      "text": "Weston was officially incorporated by the Oregon Legislative Assembly on October 19, 1878.",
      "sourceSentenceIds": [
        11
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Weston%2C_Oregon"
    },
    {
      "id": 5,
      "text": "Novelist Nard Jones lived in Weston as a youth and based his first novel, Oregon Detour, on the town.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Weston%2C_Oregon"
    },
    {
      "id": 6,
      "text": "A stage station was established in the area as early as 1863 to serve teamsters, packers, and emigrants.",
