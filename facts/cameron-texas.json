  "facts": [
    {
      "id": 1,
      "text": "Cameron takes its name from Ewen Cameron, a Scottish highlander who fought in the Texas Revolution.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Cameron%2C_Texas"
    },
    {
      "id": 2,
      "text": "The Milam County Railroad Museum in downtown Cameron displays a detailed HO‑scale replica of 1940s Cameron, preserving over 40 years of rail history.",
      "sourceSentenceIds": [
        23,
        24
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.camerontexas.net/page/comm-Points-of-Interest"
    },
    {
      "id": 3,
      "text": "The Morgan Military Aviation Museum in Cameron showcases WWII pilot training and the critical support roles that helped airmen succeed overseas.",
      "sourceSentenceIds": [
        13
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.welcometocameron.com/visit-cameron-tx"
    },
    {
      "id": 4,
      "text": "Cameron sits among 18 historic bridges in Milam County, each telling its own story and mapped by the Texas DOT Historic Bridge Map.",
      "sourceSentenceIds": [
        2,
        6,
        21
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.camerontexas.net/page/comm-Points-of-Interest"
    },
    {
      "id": 5,
      "text": "The Milam County Historical Jail Museum, once a 19th‑century jail, now tells stories of overcrowding and daring escape attempts.",
