  "facts": [
    {
      "id": 1,
      "text": "Mccutcheon Field began as a World War II military base and was named after Lt. Col. Francis McCutcheon, a highly decorated Marine aviator.",
      "sourceSentenceIds": [
        1,
        4
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://nearbylens.com/cities/usa/nc/mccutcheon_field/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The base started as 29 parcels of tobacco farm purchased for $64,502 in 1941, a modest beginning that grew into a major installation.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Marine_Corps_Air_Station_New_River",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Between 1943 and 1944 Marine bombing squadrons VMB‑433, VMB‑443 and VMB‑612 operated PBJ Mitchell bombers from the field.",
      "sourceSentenceIds": [
        15
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Marine_Corps_Air_Station_New_River",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Marine Corps Air Station New River, located in Mccutcheon Field, was the first Marine base to fly the MV‑22 Osprey tilt‑rotor aircraft.",
      "sourceSentenceIds": [
        18
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Marine_Corps_Air_Station_New_River",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "A memorial park in the community honors the military personnel who served at the base, reflecting the town’s proud heritage.",
