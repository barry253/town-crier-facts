    },
    {
      "id": 3,
      "text": "The area hosts upscale seaside resorts like the Ponte Vedra Inn and Club, the Lodge and Club, and the Marriott at Sawgrass.",
      "sourceSentenceIds": [
        20
      ],
      "sourceLabels": [
        "Wikipedia"
