  "facts": [
    {
      "id": 1,
      "text": "In 1844, Maquoketa was renamed from Springfield after the Maquoketa River to avoid confusion.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Maquoketa%2C_Iowa",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Goodenow, the region’s first settler, arrived in what is now Maquoketa in 1838.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Maquoketa%2C_Iowa",
      "category": "people",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The 1840 mail route between Davenport and Dubuque ran through Maquoketa’s Main Street.",
      "sourceSentenceIds": [
        14
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Maquoketa%2C_Iowa",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The railroad reached Maquoketa in 1870, sparking rapid growth and turning the town into a regional hub.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Maquoketa%2C_Iowa",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "In 1873, Maquoketa became the county seat, moving the capital from Andrew.",
      "sourceSentenceIds": [
        18
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Maquoketa%2C_Iowa",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "John Goodenow built Maquoketa’s first hotel, the Goodenow House, in 1849 near Main and Platt.",
