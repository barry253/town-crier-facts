  "facts": [
    {
      "id": 1,
      "text": "Gayle Mill originated with the establishment of the Wylie Cotton Mill in 1900 within Chester County.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/gayle_mill_south_carolina"
    },
    {
      "id": 2,
      "text": "The Gayle Plant was named for Walter Gayle, who helped acquire salvaged equipment from bankrupt northern mills.",
      "sourceSentenceIds": [
        1,
        5
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/gayle_mill_south_carolina"
    },
    {
      "id": 3,
      "text": "Mill owners developed a dedicated village in Gayle Mill to house and support the textile production workforce.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/gayle_mill_south_carolina"
    },
    {
      "id": 4,
      "text": "The historic Lancaster and Chester Railway once served the industrial area, including the mills in Gayle Mill.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/gayle_mill_south_carolina"
    },
    {
      "id": 5,
      "text": "Gayle Mill is an unincorporated suburban area located on the west side of the city of Chester.",
      "sourceSentenceIds": [
        11
