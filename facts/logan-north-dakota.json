      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Logan County's boundaries were altered on March 9, 1883, when part of its territory became the present county of McIntosh.",
      "sourceSentenceIds": [
        22
      ],
      "sourceLabels": [
        "Web source 2"
      ],
