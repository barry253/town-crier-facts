      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://genealogytrails.com/ndak/logan/history.html",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The county contains no large rivers, but several lakes dot its surface and water lies abundant a few feet below the surface.",
