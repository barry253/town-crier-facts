  "facts": [
    {
      "id": 1,
      "text": "Carthage was founded in 1804 on the north bank of the Cumberland River, just west of the Caney Fork junction.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.townofcarthagetn.gov/history",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town’s location at the confluence of the Caney Fork and Cumberland rivers made it a bustling steamboat port in the early 1800s.",
      "sourceSentenceIds": [
        6,
        9
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Carthage%2C_Tennessee",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The historic Cordell Hull Bridge, a landmark you see when entering Carthage, spans the Cumberland River and honors the former U.S. Secretary of State.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.knoxroadtripper.com/start/carthage-tennessee",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The Smith County Courthouse, completed in 1879, showcases Second Empire architecture and sits on the National Register of Historic Places.",
      "sourceSentenceIds": [
        15,
        20
      ],
      "sourceLabels": [
        "Web source 1",
        "Web source 2"
      ],
      "source": "https://www.townofcarthagetn.gov/history",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The Walton Hotel, a two‑story Main Street landmark, was named after a Revolutionary War soldier who received a land grant in the area.",
      "sourceSentenceIds": [
        3,
        22
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.knoxroadtripper.com/start/carthage-tennessee",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The first Nashville & Knoxville Railroad line reached Carthage in August 1888, boosting the town’s growth after river traffic declined.",
      "sourceSentenceIds": [
        13,
        14
      ],
      "sourceLabels": [
        "Web source 1"
