  "facts": [
    {
      "id": 1,
      "text": "Kincheloe grew from a lumbering town and railroad hub in the late 19th century, with the township formally established in 1899.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/kincheloe_michigan",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town sits on the former Kincheloe Air Force Base, a 7,265‑acre Strategic Air Command site that once covered 7,265 acres.",
      "sourceSentenceIds": [
        11
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Kincheloe%2C_Michigan",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The base began as Kinross Auxiliary Airfield in 1941 to refuel Alaska‑bound aircraft, later expanding into a major Cold War installation.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/kincheloe_michigan",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The Oaks at Kincheloe golf course started as a nine‑hole course built by the base in 1951 and grew to 18 holes in 1987.",
      "sourceSentenceIds": [
        14
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Kincheloe%2C_Michigan",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Environmental investigations continue at former base sites due to PFAS contamination in groundwater affecting local wells.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/kincheloe_michigan",
      "category": "other",
      "quality": "poor",
      "qualityReason": "other"
    },
    {
      "id": 6,
      "text": "Kincheloe lies at the eastern end of Kinross Charter Township, just east of I‑75 and about 20 miles southwest of Sault Ste. Marie.",
