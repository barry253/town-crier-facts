  "facts": [
    {
      "id": 1,
      "text": "Arnold grew from a 300‑acre farm bought by War of 1812 veteran John Arnold in 1815, giving the town its name.",
      "sourceSentenceIds": [
        1,
        4
      ],
      "sourceLabels": [
        "Web source 2",
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/Arnold,_Maryland",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Thomas Hamilton Arnold, John’s son, ran the Baltimore and Annapolis Short Line Railroad station in 1887, linking the community to regional trade.",
      "sourceSentenceIds": [
        2,
        6
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 2"
      ],
      "source": "https://en.wikipedia.org/wiki/Arnold%2C_Maryland",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The town sits on the Broadneck Peninsula, bordered by the Severn and Magothy rivers, a geography that shaped its early farming life.",
      "sourceSentenceIds": [
        18,
        10,
        23
      ],
      "sourceLabels": [
        "Wikipedia",
        "Wikipedia",
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Arnold%2C_Maryland",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Anne Arundel Community College, founded in 1961, anchors Arnold’s higher‑education scene and draws students from across the state.",
      "sourceSentenceIds": [
        5,
        29
      ],
      "sourceLabels": [
        "Web source 2",
        "Wikipedia"
      ],
      "source": "https://grokipedia.com/page/Arnold,_Maryland",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Arnold Park’s Wilmer Stone White Oak is slated to become Maryland’s state tree, honoring a historic forester who once owned the land.",
      "sourceSentenceIds": [
        16,
        3
      ],
      "sourceLabels": [
        "Wikipedia",
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Arnold%2C_Maryland",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "In the 1970s Severn Oaks Farm, part of the historic Swan Neck grant, covered 140 acres, illustrating the area’s long‑standing agricultural roots.",
