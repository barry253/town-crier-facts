  "facts": [
    {
      "id": 1,
      "text": "Quartzsite’s historic stage station, built in 1866 by Charley Tyson, once served travelers between Ehrenberg and Wickenburg on the California‑Arizona line.",
      "sourceSentenceIds": [
        18,
        20
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Quartzsite%2C_Arizona",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The Tysons Well Stage Station Museum, opened in February 1980, showcases pioneer and mining artifacts, including equipment from the Margarita Mine’s assay office.",
      "sourceSentenceIds": [
        4,
        10
      ],
      "sourceLabels": [
        "Web source 1",
        "Web source 1"
      ],
      "source": "https://quartzsitehistory.com/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Quartzsite’s restored Oasis Hotel, originally built in 1900, sits beside the Stage Station Museum and reflects the town’s early 20th‑century hospitality.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Quartzsite%2C_Arizona",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The Hi Jolly Monument, honoring the famed camel driver, was added to the National Register of Historic Places in 2011.",
      "sourceSentenceIds": [
        5,
        7
      ],
      "sourceLabels": [
        "Wikipedia",
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Quartzsite%2C_Arizona",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Quartzsite lies directly on Interstate 10, making it the first town drivers see when entering Arizona from California’s Greater Los Angeles region.",
      "sourceSentenceIds": [
        24
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Quartzsite%2C_Arizona",
      "category": "transport",
      "quality": "poor",
      "qualityReason": "route_only"
    },
    {
      "id": 6,
      "text": "The town’s name derives from the quartz deposits that once attracted miners to the area during the late 1800s.",
      "sourceSentenceIds": [
        15
      ],
      "sourceLabels": [
