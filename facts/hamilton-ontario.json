  "facts": [
    {
      "id": 1,
      "text": "Hamilton was named for George Hamilton, who laid out the town in 1815 between the waterfront and the Niagara Escarpment, giving the city its distinctive sloping shape.",
      "sourceSentenceIds": [
        23
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.britannica.com/place/Hamilton-Ontario",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The Burlington Canal opened in 1830 linking Hamilton Harbour to Lake Ontario, turning Hamilton into a major port and rail centre.",
      "sourceSentenceIds": [
        23
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.britannica.com/place/Hamilton-Ontario",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "McMaster University, founded in Toronto in 1887 and moved to Hamilton in 1930, is noted for nuclear research and sits on the western edge of the city.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.britannica.com/place/Hamilton-Ontario",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The Art Gallery of Hamilton, founded in 1914, is Ontario's third‑largest public art gallery and houses over 9,000 works focused on European, Canadian, and contemporary art.",
      "sourceSentenceIds": [
        3,
        13
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Hamilton%2C_Ontario",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Hamilton hosts the Canadian Warplane Heritage Museum, the HMCS Haida National Historic Site, and the Canadian Football Hall of Fame, showcasing military and sports history.",
      "sourceSentenceIds": [
        24
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Hamilton%2C_Ontario",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The city’s green spaces cover 1,077 hectares across 310 locations, while the Hamilton Conservation Authority manages an additional 4,500 hectares of natural land.",
