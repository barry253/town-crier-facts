  "facts": [
    {
      "id": 1,
      "text": "Ketron Island got its name from a misspelling of “Kittson” by cartographers during the 1838–1842 Wilkes Expedition.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
