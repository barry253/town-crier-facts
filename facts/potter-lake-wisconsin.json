  "facts": [
    {
      "id": 1,
      "text": "Potter Lake was named after John Fox Potter, a nineteenth-century politician, lawyer, and judge from Wisconsin.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.potterslake.org/history"
    },
    {
      "id": 2,
      "text": "John Fox Potter arrived in Wisconsin at age nineteen and built a log cabin on a small lake in Walworth County.",
      "sourceSentenceIds": [
        16,
        19
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.potterslake.org/history"
    },
    {
      "id": 3,
      "text": "The early pioneer John Fox Potter cleared three hundred and fifty acres of land with his own hands.",
      "sourceSentenceIds": [
        20,
        21
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.potterslake.org/history"
    },
    {
      "id": 4,
      "text": "John Fox Potter and his bride traveled to their homestead in an oxcart, carrying a new cooking stove for their cabin.",
      "sourceSentenceIds": [
        25,
        26
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.potterslake.org/history"
    },
    {
      "id": 5,
      "text": "During their muddy journey to the homestead, the newlyweds sang familiar hymns to boost their spirits.",
      "sourceSentenceIds": [
        27,
        28
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.potterslake.org/history"
    },
    {
      "id": 6,
      "text": "John Fox Potter eventually replaced his original log house with a large colonial home near the lake.",
      "sourceSentenceIds": [
        30
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.potterslake.org/history"
    }
  ]
}
