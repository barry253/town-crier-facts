  "facts": [
    {
      "id": 1,
      "text": "New Philadelphia was founded in 1804 by tavern keeper John Knisely from York, Pennsylvania, who plotted the city’s grid layout.",
      "sourceSentenceIds": [
        6,
        23
      ],
      "sourceLabels": [
        "Web source 2",
        "Wikipedia"
      ],
      "source": "https://www.britannica.com/place/New-Philadelphia-Ohio",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The city’s streets High Avenue and Broadway echo Philadelphia’s original High Street and Broad Street, reflecting the founders’ homage.",
      "sourceSentenceIds": [
        4,
        27
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/New_Philadelphia%2C_Ohio",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Tuscora Park, built by the Works Progress Administration, still showcases its original stone gates, paths, and retaining walls.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/New_Philadelphia%2C_Ohio",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "New Philadelphia lies along the Tuscarawas River, within the Western Allegheny Plateau ecoregion that shapes its rolling hills.",
      "sourceSentenceIds": [
        18,
        26
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/New_Philadelphia%2C_Ohio",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "From the early 1950s, the Baltimore and Ohio Railroad ran a six‑day‑a‑week passenger train through New Philadelphia to Cleveland.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
