  "facts": [
    {
      "id": 1,
      "text": "Glade Park sits on the Uncompahgre Plateau, bisected by Unaweep Canyon that stretches into eastern Utah.",
      "sourceSentenceIds": [
        23
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/glade_park_colorado",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The community’s historic Pipeline School, closed in 1951, became a social hub when the 1973 GPCS repurposed it into a community center.",
      "sourceSentenceIds": [
        3,
        5
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/glade_park_colorado",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The area’s geology dates back to the Pennsylvanian period, with Triassic and Jurassic sandstones uplifted by the Laramide Orogeny into dramatic canyons.",
      "sourceSentenceIds": [
        24
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/glade_park_colorado",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Early ranchers in the 1880s used the open grasslands for cattle, with the first permanent ranch, the VV Ranch, founded in 1883 by C.W. Sleeper.",
      "sourceSentenceIds": [
        26,
        27
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/glade_park_colorado",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Because no municipal water system exists, most Glade Park homes rely on wells or rooftop harvesting, fostering a high number of self‑sufficient, eco‑friendly homes.",
