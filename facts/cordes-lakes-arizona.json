  "facts": [
    {
      "id": 1,
      "text": "Cordes Lakes began in 1883 when German immigrant John Henry Cordes bought Antelope Station, turning a dusty crossroads into a vital stage stop.",
      "sourceSentenceIds": [
        8,
        30
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.destination4x4.com/cordes-arizona-yavapai-county/"
    },
    {
      "id": 2,
      "text": "The town never grew into a large settlement; instead, it stayed a tight‑knit cluster of adobe and frame buildings, including a 1912 barn and a gas station.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.destination4x4.com/cordes-arizona-yavapai-county/"
    },
    {
      "id": 3,
      "text": "Unlike many frontier towns, Cordes never hosted saloons, brawls, or mining shootouts, earning a reputation for quiet endurance.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.destination4x4.com/cordes-arizona-yavapai-county/"
    },
    {
      "id": 4,
      "text": "By the mid‑1950s the post office closed and residents dispersed, leaving Cordes effectively abandoned as a community.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.destination4x4.com/cordes-arizona-yavapai-county/"
    },
    {
      "id": 5,
      "text": "Today the historic core remains a true semi‑ghost town on private property owned by Cordes family descendants, marking over 140 years of continuous presence.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.destination4x4.com/cordes-arizona-yavapai-county/"
    },
    {
      "id": 6,
      "text": "Back roads from Cordes Lakes lead straight to the Agua Fria National Monument, a nearby natural landmark.",
      "sourceSentenceIds": [
        14
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
