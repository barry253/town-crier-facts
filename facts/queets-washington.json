  "facts": [
    {
      "id": 1,
      "text": "Queets once thrived as a fishing town with a cannery that served as a hub for early settlers and Native Americans.",
      "sourceSentenceIds": [
        25
      ],
      "sourceLabels": [
        "Web source 1"
      ],
