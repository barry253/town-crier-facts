  "facts": [
    {
      "id": 1,
      "text": "New London Township was chartered in 1723 after the London Company bought land from William Penn in 1699.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://findingaids.library.upenn.edu/records/SMREP_NLHS.01",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The township’s name honors the London Company, a group of five entrepreneurs who parceled the land for immigrant farmers.",
      "sourceSentenceIds": [
        29
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://newlondontwp.net/history/",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Two historic covered bridges, Linton Stephens and Rudolph & Arthur, sit in New London and are listed on the National Register.",
      "sourceSentenceIds": [
        3,
        4
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/New_London_Township%2C_Pennsylvania",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "A 1803 library was established, marking early commitment to education in the community.",
      "sourceSentenceIds": [
        13
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://newlondontwp.net/history/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The New London Area Historical Society preserves over 12 linear feet of archival material, including 2,000 color slides of local life.",
      "sourceSentenceIds": [
