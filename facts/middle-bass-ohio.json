  "facts": [
    {
      "id": 1,
      "text": "Middle Bass Island was first christened Isle de Fleures by French explorer Robert de LaSalle in 1679, a nod to its wildflower abundance.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/Middle_Bass_Island",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Winemaking took root in 1866 when Andrew Wehrle founded Golden Eagle Wine Cellars, which grew into the nation's largest producer by 1875.",
      "sourceSentenceIds": [
        27
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/Middle_Bass_Island",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Peter Lonz opened his winery in 1884, merged with Golden Eagle remnants in 1926, and the historic Lonz buildings earned National Register status in 1989.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/Middle_Bass_Island",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The Lonz Winery property reopened in 2017 as part of Middle Bass Island State Park, offering visitors a taste of history.",
      "sourceSentenceIds": [
        16
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.shoresandislands.com/communities/islands/middle-bass-island/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Conservation efforts protect 7.8‑acre East Point Preserve, where visitors can launch kayaks and stroll trails along Lake Erie shores.",
      "sourceSentenceIds": [
        29
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/Middle_Bass_Island",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Before Europeans, Ottawa tribes called the island Mens‑neswe‑notin and used it as a seasonal fishing camp, hunting, and gathering hub.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Web source 2"
      ],
