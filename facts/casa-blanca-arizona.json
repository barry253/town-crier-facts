  "facts": [
    {
      "id": 1,
      "text": "Casa Blanca became the site of the Butterfield Overland Mail station in 1858, a key stop on the Southern Emigrant Trail.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Casa_Blanca%2C_Arizona",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town’s original name, La Tierra Amontonada, means “Piled Up Land,” a nod to the nearby Hohokam ruin mound.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Casa_Blanca%2C_Arizona",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Before American settlement, Casa Blanca was one of the Pima villages along the Gila River, first noted by Stephen W. Kearny in 1846.",
      "sourceSentenceIds": [
        8,
        9,
        10
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Casa_Blanca%2C_Arizona",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Ammi White opened White’s Mill in 1861 to grind Pima grain, turning the village into a regional flour center.",
      "sourceSentenceIds": [
        23
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Casa_Blanca%2C_Arizona",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "During the Civil War, Confederate raiders destroyed White’s Mill and captured its owner, forcing the California Column to build Fort Barrett nearby.",
      "sourceSentenceIds": [
        24,
        25
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Casa_Blanca%2C_Arizona",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "After the 1854 Gadsden Purchase, Casa Blanca’s Pima villages became part of the New Mexico Territory before Arizona statehood.",
      "sourceSentenceIds": [
        11
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
