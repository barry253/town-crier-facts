  "facts": [
    {
      "id": 1,
      "text": "Clifford, once called New Glasgow, is an unincorporated community in Amherst County, Virginia.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Clifford%2C_Virginia"
    },
    {
      "id": 2,
      "text": "The town sits on Virginia State Route 151, just 4.3 miles north‑northeast of Amherst.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Clifford%2C_Virginia"
    },
    {
      "id": 3,
      "text": "Five historic sites near Clifford—Brick House, Geddes, Mountain View Farm, Winton, and the Clifford‑New Glasgow Historic District—are listed on the National Register.",
      "sourceSentenceIds": [
        11
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Clifford%2C_Virginia"
    },
    {
      "id": 4,
      "text": "The Clifford‑New Glasgow Historic District preserves a snapshot of the community’s past architecture and layout.",
      "sourceSentenceIds": [
        30
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://kids.kiddle.co/Clifford,_Virginia"
    },
    {
      "id": 5,
      "text": "Clifford’s post office first opened its doors on March 23, 1883, serving the local community for over a century.",
      "sourceSentenceIds": [
        29
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://kids.kiddle.co/Clifford,_Virginia"
    },
    {
      "id": 6,
      "text": "Because it is unincorporated, Clifford does not have its own town government and instead falls under Amherst County’s jurisdiction.",
      "sourceSentenceIds": [
        22,
        23
      ],
      "sourceLabels": [
        "Web source 2"
      ],
