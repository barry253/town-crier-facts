  "facts": [
    {
      "id": 1,
      "text": "Saint Jo was founded in 1849 and originally called Head of Elm because of its proximity to the Elm Fork of the Trinity River.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.stjotx.com/"
    },
    {
      "id": 2,
      "text": "The town’s name honors Joseph Anderson Howell, a surveyor who laid out the settlement and was a teetotaler friend of Captain Boggess.",
      "sourceSentenceIds": [
        5,
        12
      ],
      "sourceLabels": [
        "Web source 2",
        "Web source 2"
      ],
      "source": "https://www.stjotx.com/"
    },
    {
      "id": 3,
      "text": "Saint Jo sits on the historic Chisholm Trail, where millions of cattle were driven north to Kansas in the post‑Civil War era.",
      "sourceSentenceIds": [
        10,
        20
      ],
      "sourceLabels": [
        "Web source 1",
        "Wikipedia"
      ],
      "source": "https://www.saintjochamber.com/"
    },
    {
      "id": 4,
      "text": "The Stonewall Saloon, once a bustling frontier bar, now serves as a museum preserving late‑19th‑century Western life.",
      "sourceSentenceIds": [
        17,
        23
      ],
      "sourceLabels": [
        "Wikipedia",
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/St._Jo%2C_Texas"
    },
    {
      "id": 5,
      "text": "The town’s downtown square remains largely unchanged, reflecting its 19th‑century character and the relaxed lifestyle of its thousand residents.",
      "sourceSentenceIds": [
        9,
        23
      ],
      "sourceLabels": [
