      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The Hayes Branch of the Calcasieu Parish Public Library opened in a new building in 1955, providing a dedicated space for local learning.",
      "sourceSentenceIds": [
