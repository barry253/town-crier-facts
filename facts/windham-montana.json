  "facts": [
    {
      "id": 1,
      "text": "Windham was named by rancher Hamilton, who came from Vermont’s Windham County, bringing a piece of home to Montana.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/windham_montana",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The Great Northern Railroad’s branch line opened between 1906 and 1908, and at its peak Windham handled six passenger trains each day.",
      "sourceSentenceIds": [
        9,
        15,
        16
      ],
      "sourceLabels": [
        "Web source 1",
        "Web source 2"
      ],
      "source": "https://www.mtmemory.org/nodes/view/127921",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Windham’s first hotel, which doubled as a post office, opened in 1909 alongside a general store that served early settlers.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/windham_montana",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Windham sits in the Sage Creek valley, a northeast‑flowing tributary that feeds the Judith River toward the Missouri.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Windham%2C_Montana",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "At 4,264 feet above sea level, Windham’s elevation gives it a high‑country ranching climate.",
      "sourceSentenceIds": [
        3,
        21
      ],
      "sourceLabels": [
        "Web source 1",
        "Web source 2"
      ],
      "source": "https://www.mtmemory.org/nodes/view/127921",
      "category": "other",
      "quality": "poor",
      "qualityReason": "vague"
    },
    {
      "id": 6,
      "text": "Every year, Windham hosts the “What the Hay?” contest, where 4‑H and farmer teams compete for scholarships and community prizes.",
