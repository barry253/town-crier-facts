  "facts": [
    {
      "id": 1,
      "text": "Oakwood was named after early settler Henry Oakwood who arrived in 1833.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Oakwood%2C_Illinois",
      "category": "people",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The village sprang up when the IB&W Railroad reached the area in 1870, prompting platting of Oakwood, Fithian, and Muncie.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Oakwood%2C_Illinois",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "A field tile factory started in 1885 by two locals used clay dug nearby, supplying most of the county’s farmland tiles.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Oakwood%2C_Illinois",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The first church building in town, Oakwood United Methodist, was erected in 1884 after Methodist organization began in the 1830s.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Oakwood%2C_Illinois",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The historic Salt Kettle, once on Route 150, now sits at the I‑74 rest area near Oakwood, a relic of the town’s salt‑mining past.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.oakwoodil.org/history/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Oakwood’s early economy grew from salt mining, then shifted to coal mining in the 1860s, providing major jobs for Vermilion County.",
