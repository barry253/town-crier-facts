      "id": 1,
      "text": "Prehistoric humans first settled at the confluence of the Meuse and Légia rivers, on the site of today’s Place Saint‑Lambert.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 2"
