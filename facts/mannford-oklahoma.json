    },
    {
      "id": 2,
      "text": "Country singer and songwriter Lee Hazlewood, known for his collaborations with Nancy Sinatra, was born in Mannford.",
      "sourceSentenceIds": [
        2,
        13
      ],
      "sourceLabels": [
        "Wikipedia",
