    {
      "id": 2,
      "text": "St. Paul Roman Catholic Church was built in 1846 and is the oldest brick building in the Pacific Northwest.",
      "sourceSentenceIds": [
        15
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/St._Paul%2C_Oregon"
    },
    {
      "id": 3,
      "text": "Paul Pioneer Cemetery is the burial location for William Cannon, the only authenticated Revolutionary War veteran buried in Oregon.",
      "sourceSentenceIds": [
