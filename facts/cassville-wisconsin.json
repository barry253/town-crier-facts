    },
    {
      "id": 2,
      "text": "The village was named after Lewis Cass, who served as the governor of Michigan Territory from 1813 to 1831.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Cassville%2C_Wisconsin"
    },
    {
      "id": 3,
      "text": "The site of Cassville was occupied by the Meskwaki people before European settlement began in 1827.",
      "sourceSentenceIds": [
        21,
        23
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Cassville%2C_Wisconsin"
    },
    {
      "id": 4,
      "text": "Real estate speculators once incorrectly bet that Cassville would become the capital city of the newly established Wisconsin Territory.",
      "sourceSentenceIds": [
        26
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Cassville%2C_Wisconsin"
    },
    {
      "id": 5,
      "text": "Investors from Albany, New York, financed the construction of the Denniston House, a substantial brick lodging house built in 1836.",
