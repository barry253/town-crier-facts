      "quality": "poor",
      "qualityReason": "other"
    },
    {
      "id": 4,
      "text": "Caroline County, where Lake Caroline sits, was founded in 1728 from parts of Essex, King and Queen, and King William counties.",
      "sourceSentenceIds": [
        19
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://genealogytrails.com/vir/caroline/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "During the Colonial Period, Caroline County became the birthplace of Thoroughbred racing in North America.",
      "sourceSentenceIds": [
        20
      ],
      "sourceLabels": [
