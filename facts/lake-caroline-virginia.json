      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "During the Colonial Period, Caroline County became the birthplace of Thoroughbred racing in North America.",
      "sourceSentenceIds": [
        20
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://genealogytrails.com/vir/caroline/",
      "category": "history",
      "quality": "good"
    },
    {
