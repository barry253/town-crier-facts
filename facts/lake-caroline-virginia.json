      "quality": "good"
    },
    {
      "id": 4,
      "text": "Caroline County, where Lake Caroline sits, was founded in 1728 from parts of Essex, King and Queen, and King William counties.",
      "sourceSentenceIds": [
        19
      ],
      "sourceLabels": [
        "Web source 2"
      ],
