  "facts": [
    {
      "id": 1,
      "text": "Loysville began as Andesville in 1840, renamed shortly after to honor pioneer Michael Loy who died that year and whose will spurred further development.",
      "sourceSentenceIds": [
        1,
        2
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/loysville_pennsylvania",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town sits where Pennsylvania Routes 274 and 850 cross, about ten miles northwest of New Bloomfield in Perry County’s Sherman's Valley.",
      "sourceSentenceIds": [
        7,
        8
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Loysville%2C_Pennsylvania",
      "category": "other",
      "quality": "poor",
      "qualityReason": "location_description"
    },
    {
      "id": 3,
      "text": "A 1762 gristmill, rebuilt in stone in 1812, once served as one of the valley’s first mills and drew trade from surrounding farms.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/loysville_pennsylvania",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Lebanon Church, built in 1794, later became Tressler Memorial Lutheran Church in 1909, reflecting the area’s German Reformed and Lutheran roots.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/loysville_pennsylvania",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "In 1853 the Loysville Academy opened in the church basement, later moving into a brick building in 1855–56 that housed classrooms and an auditorium.",
      "sourceSentenceIds": [
        22,
        23
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/loysville_pennsylvania",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The town’s 0.99‑square‑mile footprint is marked by a Pennsylvania Keystone Marker that commemorates its 1830 founding.",
      "sourceSentenceIds": [
        11
      ],
      "sourceLabels": [
        "Web source 1"
      ],
