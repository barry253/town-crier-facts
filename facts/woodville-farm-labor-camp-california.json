  "facts": [
    {
      "id": 1,
      "text": "Woodville Labor Camp was founded in 1934 by the Farm Security Administration and dedicated by Eleanor Roosevelt.",
      "sourceSentenceIds": [
        14,
        8
      ],
      "sourceLabels": [
        "Web source 1",
        "Wikipedia"
      ],
      "source": "https://www.recorderonline.com/labor-camps-fill-a-need-for-families/article_fb0e1685-8d73-50e5-8286-5910abd81518.html"
    },
    {
      "id": 2,
      "text": "The camp remains one of the few original New Deal labor camps still housing farm workers, with 178 units and a daycare center.",
      "sourceSentenceIds": [
        19,
        20
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.recorderonline.com/labor-camps-fill-a-need-for-families/article_fb0e1685-8d73-50e5-8286-5910abd81518.html"
    },
    {
      "id": 3,
      "text": "Residents must earn at least 65% of their income from farm work and be legally in the U.S., ensuring the camp serves true farm laborers.",
      "sourceSentenceIds": [
        25
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.recorderonline.com/labor-camps-fill-a-need-for-families/article_fb0e1685-8d73-50e5-8286-5910abd81518.html"
    },
    {
      "id": 4,
      "text": "Original garden units from the 1930s were later replaced by cement block apartments in the 1960s and stucco homes in the 1970s–80s.",
      "sourceSentenceIds": [
        27,
        29,
        30
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.recorderonline.com/labor-camps-fill-a-need-for-families/article_fb0e1685-8d73-50e5-8286-5910abd81518.html"
    },
    {
      "id": 5,
      "text": "The Tulare County Housing Authority, a state‑chartered agency, operates Woodville Camp.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.recorderonline.com/labor-camps-fill-a-need-for-families/article_fb0e1685-8d73-50e5-8286-5910abd81518.html"
    },
    {
      "id": 6,
      "text": "The Authority runs 5,000 low‑income units across Tulare County, ranking second in the U.S. for farm‑labor housing.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 1"
      ],
