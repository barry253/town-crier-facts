  "facts": [
    {
      "id": 1,
      "text": "Castroville was founded in 1844 by Henri Castro, drawing Alsatian immigrants from France to settle the new Texas town.",
      "sourceSentenceIds": [
        2,
        7
      ],
      "sourceLabels": [
        "Web source 1",
        "Wikipedia"
      ],
      "source": "https://www.visitcastrovilletx.com/historic-district.php"
    },
    {
      "id": 2,
      "text": "The town’s name honors founder Henri Castro, who secured an empresario contract with the Republic of Texas in 1842.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.tshaonline.org/handbook/entries/castroville-tx"
    },
    {
      "id": 3,
      "text": "The Landmark Inn State Historic Site, built in 1849, began as a way station for travelers crossing Texas.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.visitcastrovilletx.com/historic-district.php"
    },
    {
      "id": 4,
      "text": "In 1998, Castroville welcomed the Steinbach Haus, a reconstructed 17th‑century Alsatian house originally built between 1618 and 1648.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Castroville%2C_Texas"
    },
    {
      "id": 5,
      "text": "A walking tour in Castroville showcases more than 70 historic homes and structures built between 1844 and 1920.",
      "sourceSentenceIds": [
        26
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.visitcastrovilletx.com/historic-district.php"
    },
    {
      "id": 6,
      "text": "In 1880 the Southern Pacific Railroad bypassed Castroville, refusing a bonus that would have brought the line through town.",
