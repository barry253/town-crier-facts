  "facts": [
    {
      "id": 1,
      "text": "Three Lakes began as a mining settlement and received a railroad station on the Marquette, Houghton and Ontonagon line in 1878.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Three_Lakes%2C_Michigan"
    },
    {
      "id": 2,
      "text": "The community’s name comes from its proximity to Beaufort, George, and Ruth Lakes, which drain into Lake Michigamme.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Three_Lakes%2C_Michigan"
    },
    {
      "id": 3,
      "text": "US 41, M‑28, and the Lakes State Connector travel east–west right through the heart of Three Lakes.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Three_Lakes%2C_Michigan"
    },
    {
      "id": 4,
      "text": "Three Lakes sits in the western region of Michigan’s Upper Peninsula, within Baraga County.",
