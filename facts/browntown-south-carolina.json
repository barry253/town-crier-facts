  "facts": [
    {
      "id": 1,
      "text": "Moses Brown received three land grants between 1768 and 1769 that would eventually become the farmstead known as Browntown.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.scpictureproject.org/florence-county/browntown.html"
    },
    {
      "id": 2,
      "text": "Browntown is listed on the National Register of Historic Places for its collection of buildings reflecting a self-sufficient nineteenth-century way of life.",
      "sourceSentenceIds": [
        6,
        19
      ],
      "sourceLabels": [
        "Web source 1",
        "Web source 2"
      ],
      "source": "https://www.scpictureproject.org/florence-county/browntown.html"
    },
    {
      "id": 3,
      "text": "The Browntown museum features a cotton gin constructed in 1842 based on the original Eli Whitney design.",
      "sourceSentenceIds": [
        15,
        30
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.scpictureproject.org/florence-county/browntown.html"
    },
    {
      "id": 4,
      "text": "The Brown family expanded their property to around ten thousand acres in the early nineteenth century to cultivate tobacco and cotton.",
      "sourceSentenceIds": [
        13
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.scpictureproject.org/florence-county/browntown.html"
    },
    {
      "id": 5,
      "text": "Historic structures in Browntown include the Moses Brown home, which is thought to date from the late eighteenth century.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.scpictureproject.org/florence-county/browntown.html"
    },
    {
      "id": 6,
      "text": "Scape Ore Swamp forms the southwest edge of Browntown and serves as a tributary of the Black River.",
      "sourceSentenceIds": [
        11
