  "facts": [
    {
      "id": 1,
      "text": "Redwood Heights started as the Avenue Terrace subdivision in the 1920s, dubbed the 'Piedmont of East Oakland' for its wooded hills and marine views.",
      "sourceSentenceIds": [
        29,
        30
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Redwood_Heights%2C_Oakland%2C_California"
    },
    {
      "id": 2,
      "text": "Redwood Road, the neighborhood's main artery, was once a logging road that cut through the original redwood stand.",
      "sourceSentenceIds": [
        8,
        9
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Redwood_Heights%2C_Oakland%2C_California"
    },
    {
      "id": 3,
      "text": "Homes in Redwood Heights, built mainly between the 1920s and 1950s, display craftsman, storybook, and ranch architectural styles.",
      "sourceSentenceIds": [
        13,
        14
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Redwood_Heights%2C_Oakland%2C_California"
    },
    {
      "id": 4,
      "text": "Avenue Terrace Park, also known as Jordan Park, sits at the corner of Jordan Road and Bennett Place.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Redwood_Heights%2C_Oakland%2C_California"
    },
    {
      "id": 5,
      "text": "In the 19th century, loggers felled giant redwoods over 30 feet in diameter, and the forest was largely cleared by 1860.",
