  "facts": [
    {
      "id": 1,
      "text": "Blooming Prairie earned its name from the prairie’s abundant flowers, a unique moniker shared by no other U.S. post office.",
      "sourceSentenceIds": [
        18
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Blooming_Prairie%2C_Minnesota",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town sprang up around the Minnesota Central Railroad, housing workers who built the first rail station in the 1860s.",
      "sourceSentenceIds": [
        3,
        8
      ],
      "sourceLabels": [
        "Web source 1",
        "Web source 2"
      ],
      "source": "https://bloomingprairiemn.gov/?SEC=3D5B5D09-F9DB-4097-9FB9-010E5B672C70&Type=B_BASIC",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Blooming Prairie’s historic downtown, featuring 19th‑century architecture, earned a spot on the National Register of Historic Places.",
      "sourceSentenceIds": [
        7,
        11
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 2"
      ],
      "source": "https://en.wikipedia.org/wiki/Blooming_Prairie%2C_Minnesota",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "A post office has operated in Blooming Prairie since 1868, serving the community for over 150 years.",
      "sourceSentenceIds": [
        19
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Blooming_Prairie%2C_Minnesota",
      "category": "landmark",
      "quality": "poor",
      "qualityReason": "vague"
    },
    {
      "id": 5,
      "text": "Blooming Prairie was officially incorporated by 1874, solidifying its status as a city within Dodge and Steele counties.",
      "sourceSentenceIds": [
        20
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Blooming_Prairie%2C_Minnesota",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Before Prohibition, Blooming Prairie thrived as a lucrative alcohol hub, and in 1917 Steele County remained the only wet county in the region.",
      "sourceSentenceIds": [
        21,
