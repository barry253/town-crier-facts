  "facts": [
    {
      "id": 1,
      "text": "Sharpsville was platted May 24 1850, hoping to become the county seat of Tipton Township, which later became Tipton.",
      "sourceSentenceIds": [
        16
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Sharpsville%2C_Indiana",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town incorporated in 1873, lost that status in 1881, then regained village status.",
      "sourceSentenceIds": [
        18
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Sharpsville%2C_Indiana",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The Sharpsville post office has been in operation since 1851 and remains a historic landmark.",
      "sourceSentenceIds": [
        19
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Sharpsville%2C_Indiana",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Martha Ann Grishaw taught the first Sharpsville school in a wooden cabin in 1852.",
      "sourceSentenceIds": [
        22,
        23
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Sharpsville%2C_Indiana",
      "category": "people",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "In 1861, a company formed in Sharpsville joined the 26th Indiana Infantry as Company C, with 78 residents listed.",
      "sourceSentenceIds": [
        28,
        29
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Sharpsville%2C_Indiana",
      "category": "history",
      "quality": "good"
    },
    {
