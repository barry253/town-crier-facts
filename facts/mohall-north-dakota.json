  "facts": [
    {
      "id": 1,
      "text": "Mohall was originally called Hall, but the name was changed in 1902 to avoid confusion with another North Dakota town.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Mohall%2C_North_Dakota",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town was founded in 1901 by M.O., a businessman from Duluth who moved north of Minot to homestead.",
      "sourceSentenceIds": [
        3,
        10
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://mohallndak.com/index.asp?SEC=CE5B3672-2C7B-461D-830E-BBD7CDD269F9&Type=B_BASIC",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "M.O. secured 80 acres, built the town, and served as postmaster, banker, storekeeper, and newspaper editor, while also farming 1,200 acres nearby.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://mohallndak.com/index.asp?SEC=CE5B3672-2C7B-461D-830E-BBD7CDD269F9&Type=B_BASIC",
      "category": "people",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Mohall became the county seat of Renville County in 1910, and the courthouse opened in 1937.",
      "sourceSentenceIds": [
        11,
        12
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Mohall%2C_North_Dakota",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Despite its inland location, Mohall experiences a notable seasonal lag, with weather patterns more similar to New England than the Great Plains.",
