  "facts": [
    {
      "id": 1,
      "text": "Founded in 1353 as Allenstein by the Teutonic Knights, Olsztyn grew around a strategic castle that still dominates the skyline.",
      "sourceSentenceIds": [
        3,
        6
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/Olsztyn",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The city’s name traces back to the Baltic Prussian tribe of Galindians who settled the area before Christianization.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/Olsztyn",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Today, Olsztyn hosts the University of Warmia and Mazury, making it a key educational hub in the region.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/Olsztyn",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Olsztyn Castle, along with Lidzbark Warmiński, Reszel, and Pieniężno castles, showcases the area’s medieval fortification heritage.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Warmian%E2%80%93Masurian_Voivodeship",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The first historical mention of Olsztyn appears in a Frombork charter dated December 31, 1348.",
