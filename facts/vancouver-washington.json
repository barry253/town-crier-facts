      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The reconstructed Fort Vancouver National Historic Site earned a spot on the National Register of Historic Places' Dozen Distinctive Destinations list in 2003.",
      "sourceSentenceIds": [
