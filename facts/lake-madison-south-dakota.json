  "facts": [
    {
      "id": 1,
      "text": "William Lee and Charles Walker established the town of Madison on the southwest side of Lake Madison in 1870.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.madisonsd.com/about/history.aspx"
    },
    {
      "id": 2,
      "text": "Both the lake and the town of Madison were named after Madison, Wisconsin, the former home of Lee and Walker.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.madisonsd.com/about/history.aspx"
    },
    {
      "id": 3,
      "text": "Lake Madison provides opportunities for camping, boating, and fishing for walleye, perch, and northern pike.",
      "sourceSentenceIds": [
        10,
        11
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Lake_Madison%2C_South_Dakota"
    },
    {
      "id": 4,
      "text": "Lake Madison drains to the southeast into Round Lake and Brant Lake as part of the Big Sioux River watershed.",
      "sourceSentenceIds": [
        14
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Lake_Madison%2C_South_Dakota"
    },
    {
      "id": 5,
      "text": "Madison was designated as the county seat for Lake County in 1873, two years before the town was actually platted.",
      "sourceSentenceIds": [
        28
      ],
      "sourceLabels": [
