  "facts": [
    {
      "id": 1,
      "text": "Gu-Win’s name blends the neighboring towns Guin and Winfield and was inspired by the local Gu‑Win Drive‑In Theater once owned by George Thornton.",
      "sourceSentenceIds": [
        6,
        13,
        30
      ],
