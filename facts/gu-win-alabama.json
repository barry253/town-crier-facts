      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Gu-Win sits in a low gap between the Buttahatchee and Luxapallila Creek subwatersheds that feed the Tombigbee River.",
      "sourceSentenceIds": [
        21
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Gu-Win%2C_Alabama",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "When first established, the community was called Ear Gap after a post office and grew along a railroad line.",
      "sourceSentenceIds": [
        7,
        10
      ],
      "sourceLabels": [
