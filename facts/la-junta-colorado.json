  "facts": [
    {
      "id": 1,
      "text": "La Junta means \"the junction\" because it sat where the Santa Fe Trail met a road to Pueblo.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/La_Junta%2C_Colorado",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town grew around Bent’s Old Fort, a 19th‑century fur trading post that now sits just northeast of La Junta.",
      "sourceSentenceIds": [
        14,
        3
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/La_Junta%2C_Colorado",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "During WWII, an Army Air Force training base operated outside La Junta, and a Strategic Air Command detachment stayed until the 1980s.",
      "sourceSentenceIds": [
        16,
        17
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/La_Junta%2C_Colorado",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The 1978‑79 mini‑series Centennial filmed scenes at Bent’s Old Fort National Historic Site, just east of town.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/La_Junta%2C_Colorado",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "La Junta hosts an annual Tarantula Fest where tourists watch tarantulas mate in September and October.",
