  "facts": [
    {
      "id": 1,
      "text": "Fortson was renamed from Blanchard's Crossing in 1885 when Columbus and Rome Railroad built a station on Thomas Daniel Fortson's land.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/fortson_georgia",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The Greek Revival Fortson House, built 1858 by Thomas Daniel Fortson, still stands and was added to National Register in 1999.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/fortson_georgia",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Fortson lies about 10 miles north of Columbus along the Chattahoochee River valley, near the river 5 miles southwest.",
      "sourceSentenceIds": [
        22,
        8
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/fortson_georgia",
      "category": "other",
      "quality": "poor",
      "qualityReason": "location_description"
    },
    {
      "id": 4,
      "text": "The community’s origins trace back to the 1830s when Almond and Fortson families established farms after Native American tribes were relocated.",
      "sourceSentenceIds": [
        24
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/fortson_georgia",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Fortson’s development accelerated mid‑20th century due to expansion of nearby Fort Benning, now Fort Moore.",
      "sourceSentenceIds": [
        17
      ],
      "sourceLabels": [
        "Web source 1"
      ],
