    {
      "id": 1,
      "text": "Lonetree, Wyoming, is situated just north of the high Uinta Mountains and twenty miles south of Fort Bridger.",
      "sourceSentenceIds": [
        21
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.intermountainhistories.org/items/show/875"
    },
    {
      "id": 2,
      "text": "The Henrys Fork River, a tributary of the Green River, first brought fur-trading Europeans to the Lonetree area.",
      "sourceSentenceIds": [
        22
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.intermountainhistories.org/items/show/875"
    },
    {
      "id": 3,
      "text": "Brigham Young sent Captain Isaac Bullock to the Lonetree area in the early 1850s, leading to early LDS settlements.",
      "sourceSentenceIds": [
        23,
        24
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.intermountainhistories.org/items/show/875"
    },
    {
      "id": 4,
      "text": "Early homesteaders in Lonetree eventually turned to ranching after settling in the region.",
      "sourceSentenceIds": [
        25,
        26
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.intermountainhistories.org/items/show/875"
    },
    {
      "id": 5,
      "text": "An old log building with a white façade once served as the post office and mercantile store for Lonetree.",
      "sourceSentenceIds": [
        19
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.intermountainhistories.org/items/show/875"
    },
    {
      "id": 6,
      "text": "The Gregory store in Lonetree hosted community gatherings, including dances, turkey hunts, and games.",
