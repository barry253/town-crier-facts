  "facts": [
    {
      "id": 1,
      "text": "Oildale was founded in 1909 when Samuel Dickinson subdivided his land, originally called Waits and North Side.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Oildale%2C_California"
    },
    {
      "id": 2,
      "text": "The town’s name came from the railroad siding “Oil Junction” and the nearby terminal “Oil City”; the post office was renamed Oildale by Crane.",
      "sourceSentenceIds": [
        2,
        3
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.standardschools.net/60827_2"
    },
    {
      "id": 3,
      "text": "A depot built in 1900 at Oil City sparked a lively community that later moved to what is now North Chester Avenue.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.standardschools.net/60827_2"
    },
    {
      "id": 4,
      "text": "The Fox Theatre, constructed in 1930 as a movie palace, now hosts live performances and reflects Oildale’s artistic heritage.",
      "sourceSentenceIds": [
        4,
        13
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://touristplaces.guide/top-10-places-to-visit-in-oildale-nature-adventure-and-history/"
    },
    {
      "id": 5,
      "text": "Oildale sits 3.5 miles north‑northwest of downtown Bakersfield at 469 feet elevation, adjacent to three major California oil fields.",
      "sourceSentenceIds": [
        28,
        30
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Oildale%2C_California"
    },
    {
      "id": 6,
      "text": "The Oildale Historical Museum, originally located elsewhere, now showcases exhibits on the oil industry and local pioneers.",
      "sourceSentenceIds": [
        7,
        14,
        15
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://touristplaces.guide/top-10-places-to-visit-in-oildale-nature-adventure-and-history/"
    }
  ]
