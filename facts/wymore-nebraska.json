  "facts": [
    {
      "id": 1,
      "text": "Wymore was platted on May 21, 1881, as a railroad town on land donated by Samuel Wymore.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://cityofwymore.com/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Known as the Welsh Capital of the Great Plains, Wymore hosted generations of Welsh immigrants who built a church, school, and cemetery.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://cityofwymore.com/history/",
      "category": "people",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The Wymore Welsh Heritage Centre houses a Welsh-language library cataloged in English, oral histories, and artifacts of Welsh life on the Great Plains.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Wymore%2C_Nebraska",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "In 1919, a library opened after a 1917 letter from the Fortnightly Club to the Carnegie Foundation, and an addition was finished in 2002.",
      "sourceSentenceIds": [
        10,
        11,
        12
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://cityofwymore.com/history/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Wymore’s early 20th-century electric tram was a notable feature of the town’s transportation history.",
      "sourceSentenceIds": [
        15
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Wymore%2C_Nebraska",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The town’s Welsh Heritage Project, founded in 2000, preserves the legacy of early settlers through archives and community events.",
      "sourceSentenceIds": [
        1
