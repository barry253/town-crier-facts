  "facts": [
    {
      "id": 1,
      "text": "Quantico’s name comes from a Doeg village called Pamacocack, meaning “by the long stream,” as recorded by English colonists in 1608.",
      "sourceSentenceIds": [
        16,
        27
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Quantico%2C_Virginia",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town’s growth began when the Richmond, Fredericksburg, and Potomac Railroad reached it in 1870, two years before adopting the name Quantico.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.britannica.com/place/Quantico-Virginia",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Founded in 1654, Quantico grew beside Marine Corps Base Quantico, becoming a town that literally sits inside a military installation.",
      "sourceSentenceIds": [
        3,
        7
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.quantico.marines.mil/News/News-Article-Display/Article/1199395/the-town-within-an-installation/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The FBI Academy at Quantico was famously featured in the 1991 film The Silence of the Lambs and the TV series Quantico.",
      "sourceSentenceIds": [
        11
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Quantico%2C_Virginia",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Quantico enjoys a humid subtropical climate, with hot summers and mild winters typical of southeastern Virginia.",
      "sourceSentenceIds": [
