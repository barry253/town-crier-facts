  "facts": [
    {
      "id": 1,
      "text": "Alamo Square Park sits atop a hill, offering views of the Transamerica Pyramid, Golden Gate Bridge, and Bay Bridge on clear days.",
      "sourceSentenceIds": [
        21
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Alamo_Square%2C_San_Francisco",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The park’s “Painted Ladies” are a row of Victorian homes built in 1857 that have survived since the mid‑1800s.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://virtualtourist.com/travel/North_America/United_States_of_America/California/San_Francisco-755471/Things_To_Do-San_Francisco-Alamo_Square-BR-1.html",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Alamo Hill was once a watering hole on the horseback trail between Mission Dolores and the Presidio in the 1800s.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Alamo_Square%2C_San_Francisco",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Author Alice Walker lived in a Painted Lady across from the park until the mid‑1990s.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Alamo_Square%2C_San_Francisco",
      "category": "people",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "A free walking tour of the Victorian district is organized by the San Francisco Public Library.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.sftourismtips.com/alamo-square.html",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The neighborhood’s Victorian architecture remained largely untouched by the urban renewal projects that reshaped other parts of the Western Addition.",
