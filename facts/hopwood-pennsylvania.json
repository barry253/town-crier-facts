  "facts": [
    {
      "id": 1,
      "text": "Hopwood was founded in 1781 by John Hopwood, who planned the village along the National Road.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.heraldstandard.com/special_sections/2023/may/12/historic-hopwood/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The village was briefly renamed Monroe after President James Monroe, a close friend of the Hopwood family, before reverting in 1881.",
      "sourceSentenceIds": [
        10,
        11
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.heraldstandard.com/special_sections/2023/may/12/historic-hopwood/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Historic McCarthy’s Kitchen remains one of Hopwood’s most photographed landmarks, showcasing 19th‑century architecture.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.heraldstandard.com/special_sections/2023/may/12/historic-hopwood/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Route 40 Business, the old National Pike, cuts through Hopwood’s center, linking the town to the historic stone‑building corridor.",
      "sourceSentenceIds": [
        30
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Hopwood%2C_Pennsylvania",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Hopwood hosted the Uniontown Speedway from 1916 to the mid‑1920s, where the 1921 AAA Championship races were held.",
      "sourceSentenceIds": [
        23,
        24
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Hopwood%2C_Pennsylvania",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The Hopwood‑Miller Tavern, later known as the Moses Hopwood House, welcomed presidents including John Quincy Adams and James Buchanan during the early 1800s.",
