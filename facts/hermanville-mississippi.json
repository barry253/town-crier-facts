      ],
      "source": "https://en.wikipedia.org/wiki/Hermanville%2C_Mississippi",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The Natchez, Jackson and Columbus Railroad finished in 1882, and a depot was built in Hermanville, connecting the town to regional trade.",
      "sourceSentenceIds": [
        4,
        12
      ],
      "sourceLabels": [
        "Wikipedia",
