      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The Budapest‑Kelenföld railway station is one of the city’s four busiest hubs and the terminus of Metro Line 4, which opened in 2014.",
      "sourceSentenceIds": [
        9,
        11
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
