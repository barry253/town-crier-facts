    },
    {
      "id": 4,
      "text": "The Kelenföld Power Station, once an industrial icon, now showcases a blend of architectural elegance and industrial art.",
      "sourceSentenceIds": [
        16,
        17
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://aimarketingugynokseg.hu/en/kelenfold-budapests-hidden-gem-of-history/"
    },
    {
      "id": 5,
      "text": "Line 4 of the Budapest Metro, which began service in 2014, terminates at Kelenföld, making it a modern transit hub.",
