  "facts": [
    {
      "id": 1,
      "text": "Mount Tabor got its name from Plympton Kelly, son of pioneer Clinton Kelly, who suggested the biblical Mount Tabor after reading about Napoleon’s 1799 battle.",
      "sourceSentenceIds": [
        3,
        25
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Mount_Tabor_(Oregon)",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The park sits atop a dormant cinder‑cone that erupted over 300,000 years ago as part of Oregon’s Boring Lava Field.",
      "sourceSentenceIds": [
        10,
        30
      ],
      "sourceLabels": [
        "Web source 1",
        "Wikipedia"
      ],
      "source": "https://www.taborfriends.org/the-volcano",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Three historic reservoirs on the mountain were added to the National Register of Historic Places in 2004, preserving their open‑air design.",
      "sourceSentenceIds": [
        6,
        7
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Mount_Tabor_(Oregon)",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The reservoirs, threatened by underground storage plans, sparked a decade‑long debate over preserving Portland’s historic open‑air water sources.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Mount_Tabor_(Oregon)",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Tabor Park’s old plant nursery, once a major supplier of street trees for Portland, is now a historic landmark listed in 2004.",
      "sourceSentenceIds": [
        15,
        17
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.mttaborpdx.org/history-of-park",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The park’s historic lampposts still draw power from a small on‑site generator, keeping the original lighting alive.",
