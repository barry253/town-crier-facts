  "facts": [
    {
      "id": 1,
      "text": "Bukchon’s name means “north village” because it sits north of Cheonggyecheon Stream and Jongno.",
      "sourceSentenceIds": [
        1,
        5
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 2"
      ],
      "source": "https://en.wikipedia.org/wiki/Bukchon_Hanok_Village",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The area began as an aristocratic quarter during the Joseon dynasty and became a hanok neighborhood after twentieth‑century urbanization.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.swallowsnotes.com/blog/bukchon-and-the-experiential-city",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Bukchon preserves more than 900 traditional Korean houses, many dating to the late 19th and early 20th centuries.",
      "sourceSentenceIds": [
        9,
        11
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Bukchon_Hanok_Village",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Tourists can only enter the village between 10 a.m. and 5 p.m. unless they stay in a guesthouse, a rule that started in November 2024.",
      "sourceSentenceIds": [
        23,
        24
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Bukchon_Hanok_Village",
      "category": "other",
      "quality": "poor",
      "qualityReason": "editorial_filler"
    },
    {
      "id": 5,
      "text": "The Seoul tourism site urges visitors to keep noise low, avoid littering, and stay in groups of fewer than ten people.",
      "sourceSentenceIds": [
        26
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Bukchon_Hanok_Village",
      "category": "other",
      "quality": "poor",
      "qualityReason": "editorial_filler"
    },
    {
      "id": 6,
      "text": "Bukchon’s streets were once home to notable figures such as Pak Yŏnghyo and Kim Okkyun, who lived in large houses during the late Joseon and Korean Empire periods.",
      "sourceSentenceIds": [
        27
