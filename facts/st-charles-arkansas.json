  "facts": [
    {
      "id": 1,
      "text": "St. Charles sits on the White River and was the site of the Battle of Saint Charles during the Civil War.",
      "sourceSentenceIds": [
        23
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/St._Charles%2C_Arkansas",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town’s historic house served as a hospital for both Union and Confederate soldiers during the Civil War.",
      "sourceSentenceIds": [
        13
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/St._Charles%2C_Arkansas",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "In 1935 the surrounding White River was designated a wildlife refuge, and in 2014 it was renamed the Dale Bumpers White River National Wildlife Refuge.",
      "sourceSentenceIds": [
        2,
        3
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/St._Charles%2C_Arkansas",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "St. Charles was originally settled by French Coureur des Bois Pierre Pertuis after purchasing land from a 1797 Spanish grant.",
      "sourceSentenceIds": [
        29
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/St._Charles%2C_Arkansas",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Before railroads arrived, St. Charles functioned as an important port on the White River.",
      "sourceSentenceIds": [
        14
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/St._Charles%2C_Arkansas",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The area was part of the Middle Mississippian culture during the Woodland Period, long before European settlement.",
