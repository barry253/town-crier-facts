  "facts": [
    {
      "id": 1,
      "text": "The historic Wittmond Hotel & Restaurant, founded by German immigrant Conrad Wittmond, still serves locals and travelers in Calhoun County for over five generations.",
      "sourceSentenceIds": [
        1,
        22
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://calhounil.org/ova_dep/points-of-interest/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Calhoun County sits on a peninsula formed by the Mississippi and Illinois rivers, almost completely surrounded by water.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Calhoun_County%2C_Illinois",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The 1876 one‑man jail on Main Street remains in Calhoun, a relic of the county’s early justice system.",
      "sourceSentenceIds": [
        20
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://calhounil.org/ova_dep/points-of-interest/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Calhoun’s Historical Society, established in 1975, collects and displays artifacts that chronicle the county’s early 19th‑century settlement.",
      "sourceSentenceIds": [
        25
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://calhounil.org/ova_dep/points-of-interest/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The Great Flood of 1993 was the most significant natural disaster to impact Calhoun County, reshaping its riverine landscape.",
      "sourceSentenceIds": [
        15
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Calhoun_County%2C_Illinois",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Mary Immaculate Conception Catholic Church, originally built in 1848, survived a fire on Christmas Eve 2011 and remains a landmark in Calhoun.",
