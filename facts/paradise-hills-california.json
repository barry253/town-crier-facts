  "facts": [
    {
      "id": 1,
      "text": "Paradise Hills preserves a 30‑acre patch of black walnut woodland, one of the last in Los Angeles, offering shade and habitat for local wildlife.",
      "sourceSentenceIds": [
        21,
        16
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.protectparadisehill.com/",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The hill serves as a vital wildlife corridor, home to 43 bird species, 14 mammals, and even federally protected bobcats and peregrine falcons.",
      "sourceSentenceIds": [
        18,
        19
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.protectparadisehill.com/",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Visitors can stroll the Memorial Trailway, a historic path that winds through the community’s Gold Rush‑era streets and past the award‑winning Gold Nugget Museum.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.townofparadise.com/community/page/visitors",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Every spring, the hill bursts into fields of pastel lupine and mustard, turning the 33‑acre landscape into a living canvas of color.",
      "sourceSentenceIds": [
        17
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.protectparadisehill.com/",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Local residents gather on Paradise Hill to protect the land from development, holding annual events that unite the community in conservation efforts.",
      "sourceSentenceIds": [
        11,
        12,
        13
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.protectparadisehill.com/",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The hill’s name reflects its lush, golden appearance, a fitting tribute to the quiet, rolling terrain that overlooks the heart of Los Angeles.",
      "sourceSentenceIds": [
        15
      ],
      "sourceLabels": [
