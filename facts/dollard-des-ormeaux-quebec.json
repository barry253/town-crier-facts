  "facts": [
    {
      "id": 1,
      "text": "Dollard-des-Ormeaux is named after Adam Dollard des Ormeaux, the savior at the Battle of Long Sault.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Dollard-des-Ormeaux",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The city’s spelling switched from Dollard-des-Ormeaux to Dollard des Ormeaux in 1960, then back to the hyphenated form in 1969.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Dollard-des-Ormeaux",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "In 1967, Dollard-des-Ormeaux earned the title Suburb of the Year, a rare honor for a Montreal suburb.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://ville.ddo.qc.ca/en/my-city/history/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The town was originally a bedroom community in the early 1960s before growing into the most populous suburb on the Island of Montreal.",
      "sourceSentenceIds": [
        7,
        27
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Dollard-des-Ormeaux",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The city’s library, built under Mayor Janiszewski, now serves as a cultural hub and was part of the city’s early civic development.",
      "sourceSentenceIds": [
        22,
        23
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Dollard-des-Ormeaux",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Monuments and plaques across Dollard-des-Ormeaux commemorate the Battle of Long Sault, a story that became a staple of French‑Canadian culture.",
      "sourceSentenceIds": [
        12,
        11
      ],
