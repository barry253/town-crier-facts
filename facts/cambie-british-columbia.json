  "facts": [
    {
      "id": 1,
      "text": "Cambie Surgery Centre, founded by Brian Day, is a Vancouver-based private clinic that challenged British Columbia's Medicare Protection Act.",
      "sourceSentenceIds": [
        7,
        8,
        18
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Cambie_Surgeries_Corporation_v_British_Columbia",
      "category": "other",
      "quality": "poor",
      "qualityReason": "wrong_article"
    },
    {
      "id": 2,
      "text": "The clinic’s lawsuit argued that the MPA violated Canadians’ Charter rights, claiming it forced patients to endure long waits for public care.",
      "sourceSentenceIds": [
        9,
        10,
        21
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Cambie_Surgeries_Corporation_v_British_Columbia",
      "category": "other",
      "quality": "poor",
      "qualityReason": "editorial_filler"
    },
    {
      "id": 3,
      "text": "In 2020, a 880‑page decision by Justice John Steeves dismissed the case, stating the plaintiffs did not prove a Charter breach.",
      "sourceSentenceIds": [
        12,
        13,
        23,
        24
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Cambie_Surgeries_Corporation_v_British_Columbia",
      "category": "other",
      "quality": "poor",
      "qualityReason": "editorial_filler"
    },
    {
      "id": 4,
      "text": "The B.C. Court of Appeal upheld Steeves’ ruling in 2022, dismissing the appeal without costs.",
      "sourceSentenceIds": [
        15,
        16,
        30
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Cambie_Surgeries_Corporation_v_British_Columbia",
      "category": "other",
      "quality": "poor",
      "qualityReason": "editorial_filler"
    },
    {
      "id": 5,
      "text": "The Supreme Court of Canada declined to hear the appeal, leaving the MPA unchanged.",
      "sourceSentenceIds": [
        17
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Cambie_Surgeries_Corporation_v_British_Columbia",
      "category": "other",
      "quality": "poor",
      "qualityReason": "editorial_filler"
    },
    {
      "id": 6,
      "text": "Brian Day, the clinic’s medical director, pledged to appeal immediately after the 2020 ruling, keeping the debate alive.",
      "sourceSentenceIds": [
