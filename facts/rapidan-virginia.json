  "facts": [
    {
      "id": 1,
      "text": "Rapidan began as Waugh's Ford mill community in late 1700s in Virginia.",
      "sourceSentenceIds": [
        18
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Rapidan%2C_Virginia",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The Orange and Alexandria Railroad crossed the Rapidan River in 1854, turning the village into a shipping hub.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Rapidan%2C_Virginia",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Renamed Rapid Ann Station in 1854, the village later became Rapidan in 1886.",
      "sourceSentenceIds": [
        1,
        7,
        21
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Rapidan%2C_Virginia",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Civil War raids destroyed most buildings; the village rebuilt as a wood‑product shipping point after the war.",
      "sourceSentenceIds": [
        9,
        25
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Rapidan%2C_Virginia",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The Rapidan Historic District, added to the NRHP in 1987, contains 35 contributing buildings, including two 1874 Carpenter Gothic churches.",
      "sourceSentenceIds": [
        10,
        27
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Rapidan%2C_Virginia",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Locust Grove, an 18th‑century farmhouse in Rapidan, was listed on the VLR and NRHP in 1985.",
