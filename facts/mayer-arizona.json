      ],
      "source": "https://shebuystravel.com/mayer-az/",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Three buildings in Mayer—Mayer Apartments, the Business Block, and the Red Brick Schoolhouse—are listed on the National Register of Historic Places.",
