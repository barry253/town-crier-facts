  "facts": [
    {
      "id": 1,
      "text": "Mosier is a city along the Columbia River in Wasco County, Oregon.",
      "sourceSentenceIds": [
        20
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Mosier%2C_Oregon"
    },
    {
      "id": 2,
      "text": "The Mosier Valley area was originally inhabited by the Wasco people, who lived on the south side of the Columbia River.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://cityofmosier.gov/community-in-mosier/the-history-of-mosier/"
    },
    {
      "id": 3,
      "text": "Pioneer Jonah Mosier first settled the area in 1854 near the confluence of the Columbia River and Mosier Creek.",
      "sourceSentenceIds": [
        7,
        8
      ],
      "sourceLabels": [
        "Web source 1",
        "Web source 2"
      ],
      "source": "https://cityofmosier.gov/community-in-mosier/the-history-of-mosier/"
    },
    {
      "id": 4,
      "text": "The arrival of the transcontinental railroad in 1882 opened Mosier to more settlement and trade.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://cityofmosier.gov/community-in-mosier/the-history-of-mosier/"
    },
    {
      "id": 5,
      "text": "Mosier was incorporated as a city in 1914, and the current post office building originally served as the town bank.",
      "sourceSentenceIds": [
        21,
        22
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Mosier%2C_Oregon"
    },
    {
      "id": 6,
      "text": "Eighteenmile Island is located in the Columbia River just a half-mile downstream from the city of Mosier.",
      "sourceSentenceIds": [
