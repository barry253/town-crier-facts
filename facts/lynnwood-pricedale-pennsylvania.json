      "quality": "poor",
      "qualityReason": "location_description"
    },
    {
      "id": 2,
      "text": "The Monongahela River forms Lynnwood-Pricedale's southwestern edge, marking the line between Washington and Fayette counties.",
      "sourceSentenceIds": [
        18
      ],
      "sourceLabels": [
        "Wikipedia"
