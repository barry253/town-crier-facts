  "facts": [
    {
      "id": 1,
      "text": "Stanford began as a planned railroad town in 1867 along the Jacksonville Division of the Chicago and Alton Railroad.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/stanford_illinois",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town was originally called Allin, platted on December 14, 1867, before changing its name to Stanford in 1870.",
      "sourceSentenceIds": [
        26,
        28
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Stanford%2C_Illinois",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "John Armstrong, born in Posey County, Indiana, owned the land and helped plat the village, becoming its founder.",
      "sourceSentenceIds": [
        27,
        30,
        7
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 2"
      ],
      "source": "https://en.wikipedia.org/wiki/Stanford%2C_Illinois",
      "category": "people",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "After World War II, the Chicago and Alton line fell out of use, prompting Stanford to diversify into farming and small‑scale commerce.",
      "sourceSentenceIds": [
        22
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/stanford_illinois",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Today, Stanford preserves its historic grain elevators and hosts community events, reflecting its small‑town charm and commitment to heritage.",
      "sourceSentenceIds": [
        14,
        23
      ],
      "sourceLabels": [
        "Web source 1",
        "Web source 2"
      ],
      "source": "https://www.stanford-il.org/",
      "category": "culture",
      "quality": "good"
    }
