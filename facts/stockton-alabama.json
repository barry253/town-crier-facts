  "facts": [
    {
      "id": 1,
      "text": "Stockton likely takes its name from Francis Stockton, who chose the site for Baldwin County's first courthouse in 1809.",
      "sourceSentenceIds": [
        20
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Stockton%2C_Alabama",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Stockton is the nearest community to the Bottle Creek Indian Mounds, a National Historic Landmark featuring 18 platform mounds built between AD 1200 and 1550.",
      "sourceSentenceIds": [
        1,
        17
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 2"
      ],
      "source": "https://en.wikipedia.org/wiki/Stockton%2C_Alabama",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Stockton grew from a Taensa Indian settlement into a 19th‑century cotton shipping hub, linked by stagecoach and steamer to Mobile and Montgomery.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/stockton_alabama",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "After the Civil War, Stockton shifted from timber and cotton trade to sawmills and local agriculture as railroads and natural disasters weakened its economy.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 2"
      ],
