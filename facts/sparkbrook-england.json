  "facts": [
    {
      "id": 1,
      "text": "Sparkbrook takes its name from a small stream that once flowed south of Birmingham’s city centre, later channeled into a canal.",
      "sourceSentenceIds": [
        12,
        13
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Sparkbrook",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The area’s Grade I listed St Agatha’s Church on Stratford Road was consecrated in 1901 and remains a prominent landmark.",
      "sourceSentenceIds": [
        23,
        24
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Sparkbrook",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "In 1894, the Ladypool Road Mission Hall opened as part of the Sparkbrook Gospel Mission, founded in 1886, reflecting the area’s religious heritage.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Sparkbrook",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The historic Spark Brook stream once followed a path that joined the River Cole north of Tyseley Industrial Estate, marking early boundary lines.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://billdargue.jimdofree.com/placenames-gazetteer-a-to-y/places-s/sparkbrook/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "A marble statue of Chartist MP Attwood once stood at New Street and Stephenson Place before moving closer to his Larches Green home in 1975.",
