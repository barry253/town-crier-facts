  "facts": [
    {
      "id": 1,
      "text": "King City was originally established in the mid-1960s as a retirement community.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://tualatinvalley.org/cities-towns/king-city/"
    },
    {
      "id": 2,
      "text": "The Tualatin Development Company built King City starting in 1964 as a planned community for adults.",
      "sourceSentenceIds": [
        7,
        8
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/King_City%2C_Oregon"
    },
    {
      "id": 3,
      "text": "The Tualatin Development Company chose the name King City and used a royalty theme for the street names.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/King_City%2C_Oregon"
    },
    {
      "id": 4,
      "text": "Early rules in King City once prohibited anyone under the age of 50 from living in the city.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/King_City%2C_Oregon"
    },
    {
      "id": 5,
      "text": "King City later expanded its boundaries to include newer developments that did not have age restrictions.",
      "sourceSentenceIds": [
        11
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/King_City%2C_Oregon"
    },
    {
      "id": 6,
      "text": "In 2024, King City increased its land area by approximately 215 acres through an annexation on its west side.",
      "sourceSentenceIds": [
        13,
        14
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/King_City%2C_Oregon"
    }
  ]
}
