      "id": 1,
      "text": "Dormont was incorporated on March 31, 1909, becoming the first independent municipality in Allegheny County’s South Hills.",
      "sourceSentenceIds": [
        27,
        30
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
