  "facts": [
    {
      "id": 1,
      "text": "Castle Pines Village began as a gated residential community perched between 6,000 and 6,500 feet on Colorado’s Front Range.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Castle_Pines_Village%2C_Colorado"
    },
    {
      "id": 2,
      "text": "The town’s modern identity is tied to golf, with Jack Nicklaus‑designed Castle Pines Golf Club opening in 1981.",
      "sourceSentenceIds": [
        12,
        6
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Castle_Pines_Village%2C_Colorado"
    },
    {
      "id": 3,
      "text": "From 1986 to 2006, the PGA Tour hosted the BMW Championship at Castle Pines, returning in 2018 to honor its legacy.",
      "sourceSentenceIds": [
        13,
        7
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Castle_Pines_Village%2C_Colorado"
    },
    {
      "id": 4,
      "text": "Castle Pines sits on the northernmost tablelands of the Front Range, offering sweeping views of Pikes Peak, Mount Blue Sky, and the Rockies.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Castle_Pines_Village%2C_Colorado"
    },
    {
      "id": 5,
      "text": "Before European settlers, the area was home to Ute, Arapaho, and Cheyenne peoples, whose presence predates recorded history.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://colorado.wiki/a/Castle_Pines,_Colorado"
    },
    {
