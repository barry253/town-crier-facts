  "facts": [
    {
      "id": 1,
      "text": "McKee City was founded in 1884 by Colonel John McKee, a Civil War veteran, who planned a self‑sustaining farming enclave along the West Jersey Railroad.",
      "sourceSentenceIds": [
        2,
        3,
        10
      ],
      "sourceLabels": [
        "Web source 1",
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/mckee_city_new_jersey",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The community takes its name from Colonel John McKee, an African American property speculator who owned vast lands in the late 19th century.",
      "sourceSentenceIds": [
        7,
        9
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://alchetron.com/McKee-City%2C-New-Jersey",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Today McKee City hosts the historic Atlantic City Race Course and the Hamilton Mall, which opened in 1987.",
      "sourceSentenceIds": [
        15,
        17
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/McKee_City%2C_New_Jersey",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "McKee envisioned a 4,000‑acre planned community where freed slaves from the South could settle after the Civil War.",
      "sourceSentenceIds": [
        18
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/McKee_City%2C_New_Jersey",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "After McKee died, he left $2 million to the Archdiocese of Philadelphia to build a Catholic church, rectory, and convent, but the funds were never distributed.",
