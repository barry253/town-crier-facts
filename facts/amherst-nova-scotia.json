  "facts": [
    {
      "id": 1,
      "text": "Amherst earned its name when Colonel Joseph Morse renamed the village after Lord Amherst, the British Army commander in North America during the Seven Years' War.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Amherst%2C_Nova_Scotia",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The arrival of the Intercolonial Railway in 1872 sparked an industrial boom that made Amherst the most productive manufacturing center in the Maritime Provinces by 1908.",
      "sourceSentenceIds": [
        21,
        23
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Amherst%2C_Nova_Scotia",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Stroll down Victoria Street and see historic sandstone buildings and Victorian homes that date back to the town’s late‑19th‑century industrial heyday.",
      "sourceSentenceIds": [
        7,
        8
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.novascotia.com/explore-by-region/northumberland-shore/amherst/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "During World War I, the town’s Malleable Iron Foundry housed an internment camp where Russian revolutionary Leon Trotsky spent a month in 1917.",
      "sourceSentenceIds": [
        27
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Amherst%2C_Nova_Scotia",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "In the 19th century, Amherst grew into a key shipbuilding hub, supplying vessels and services to communities along the Bay of Fundy.",
      "sourceSentenceIds": [
        17
      ],
