  "facts": [
    {
      "id": 1,
      "text": "In 1766, Emperor Joseph II opened the Prater to the public, ending centuries of aristocratic exclusivity.",
      "sourceSentenceIds": [
        28
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Prater",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The Prater’s 4.4‑km Hauptallee, built in 1538, linked the palace gardens to the hunting grounds and still guides visitors today.",
      "sourceSentenceIds": [
        27
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Prater",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The Riesenrad, Vienna’s giant Ferris wheel, first appeared in 1897 as part of the “Venice in Vienna” amusement area.",
      "sourceSentenceIds": [
        15
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.praterwien.com/en/prater/fun-in-vienna/history/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "In 1874 the Viennese Harness Racing Club began racing on the Hauptallee before moving to the permanent Trabrennbahn Krieau in 1878.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Prater",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The Wurstelprater carousel, originally built by Basilio Calafati in the 1840s, now features a Great Chinese figure added in 1854.",
      "sourceSentenceIds": [
        17,
        18
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://prater.at/en/prater-history/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The Prater hosted the 2nd Workers’ Olympiad in 1931, when the new Praterstadion—later Ernst‑Happel‑Stadion—opened for the event.",
