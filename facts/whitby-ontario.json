      ],
      "source": "https://en.wikipedia.org/wiki/Whitby%2C_Ontario",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The Whitby Sports Hall of Fame, located in the Sports Centre, celebrates local athletes who have earned national and Olympic honors.",
