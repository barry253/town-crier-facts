  "facts": [
    {
      "id": 1,
      "text": "Pyatt was named after a Missouri Pacific Railroad engineer when the railroad arrived in 1904, and the town officially incorporated on June 11, 1929.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/pyatt",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Before becoming Pyatt, settlers called the area Stringtown and later Clear Creek, with a post office opening in 1855 under that name.",
      "sourceSentenceIds": [
        2,
        5
      ],
      "sourceLabels": [
        "Web source 2",
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/pyatt",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Pyatt’s original schoolhouse, built in the early 1930s from hand‑quarried rock, is one of four National Register of Historic Places sites in the town.",
      "sourceSentenceIds": [
        7,
        15
      ],
      "sourceLabels": [
        "Web source 1",
        "Web source 2"
      ],
      "source": "https://www.pyatt.net/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Archaeologists have found Native American artifacts in Crooked Creek valley, indicating long‑term habitation before European settlers arrived.",
      "sourceSentenceIds": [
        10,
        11
      ],
      "sourceLabels": [
        "Web source 2",
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/pyatt",
      "category": "people",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "During the Civil War, Pyatt endured guerrilla raids that disrupted farms and caused widespread food shortages, yet no major battles ever took place there.",
      "sourceSentenceIds": [
        12,
        9
      ],
      "sourceLabels": [
        "Web source 2",
