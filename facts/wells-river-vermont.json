  "facts": [
    {
      "id": 1,
      "text": "Wells River takes its name from the river that flows into the Connecticut River at the eastern edge of the village.",
      "sourceSentenceIds": [
        25
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Wells_River%2C_Vermont"
    },
    {
      "id": 2,
      "text": "The area was first called Governor's Right because five hundred acres were granted to Governor Benning Wentworth of New Hampshire.",
      "sourceSentenceIds": [
        13
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Wells_River%2C_Vermont"
    },
    {
      "id": 3,
      "text": "Located at the head of navigation for the Connecticut River, Wells River developed as a center for trade.",
      "sourceSentenceIds": [
        15
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Wells_River%2C_Vermont"
    },
    {
      "id": 4,
      "text": "Canal boats once floated downriver from Wells River laden with lumber and shingles, returning with goods like iron, salt, and molasses.",
      "sourceSentenceIds": [
        16
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Wells_River%2C_Vermont"
    },
    {
      "id": 5,
      "text": "The arrival of the Connecticut and Passumpsic Rivers Railroad in 1848 rendered the river's barge traffic obsolete.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Wells_River%2C_Vermont"
    },
    {
      "id": 6,
      "text": "The village center of Wells River was added to the National Register of Historic Places in 1983 as a historic district.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
