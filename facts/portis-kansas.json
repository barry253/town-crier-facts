  "facts": [
    {
      "id": 1,
      "text": "Portis was renamed on February 16, 1880, to honor Thomas Jefferson Portis, vice‑president of the Missouri Pacific Railroad.",
      "sourceSentenceIds": [
        1,
        18
      ],
      "sourceLabels": [
        "Web source 2",
        "Wikipedia"
      ],
      "source": "https://grokipedia.com/page/portis_kansas",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Louisa Lindley, a Civil War widow, helped found Portis in 1871, naming it after the biblical town and using her log cabin as the first trading post.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/portis_kansas",
      "category": "people",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "After World War II, tractors and combine harvesters transformed farming in Portis, cutting labor needs and allowing larger‑scale operations.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/portis_kansas",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Portis sits on the north fork of the Solomon River, giving it a modest riverside setting.",
      "sourceSentenceIds": [
        19
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Portis%2C_Kansas",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Mail deliveries for Portis were often mixed up with those for Bethany, Missouri, prompting the name change.",
