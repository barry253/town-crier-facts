      "category": "economy",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The Community Theater, Gourd Creek Cave, Onyx Cave, and Ozark Iron Furnace Stack in Newburg are listed on the National Register of Historic Places.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Wikipedia"
