      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Newburg sits on the north bank of Little Piney Creek, just south of the former U.S. Route 66 alignment.",
      "sourceSentenceIds": [
        24,
        25
      ],
      "sourceLabels": [
