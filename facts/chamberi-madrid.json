  "facts": [
    {
      "id": 1,
      "text": "In Plaza de Chamberí, a bust of comic actress Loreto Prado—originally sculpted by Mariano Benlliure—stands beside the bandstand.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.esmadrid.com/en/discover-chamberi",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Chamberí once housed Madrid’s first elevated water tank, built between 1907 and 1911 to supply the city.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.esmadrid.com/en/discover-chamberi",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The Chamberí metro station opened in 1919, closed in 1966 when its platforms could not be widened for growing traffic.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.esmadrid.com/en/discover-chamberi",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Beneath the modern Chamberí station lies Andén 0, a perfectly preserved 1960s ghost station now displayed as a museum.",
      "sourceSentenceIds": [
        12,
        13
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://madridallincluded.com/chamberi-madrid-guide/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Chamberí’s urban outline emerged from the 1860 Ensanche plan drafted by Carlos María de Castro, shaping its modern grid.",
      "sourceSentenceIds": [
        15
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Chamber%C3%AD",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Artist Joaquín Sorolla’s former home in Chamberí, where he lived until 1911, now serves as a museum celebrating his work.",
      "sourceSentenceIds": [
        29,
