  "facts": [
    {
      "id": 1,
      "text": "Named after New York’s “Empire State,” the town’s title reflects its founders’ ambition.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Empire%2C_Colorado",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Founded as a gold‑mining camp during the Pike’s Peak Gold Rush, Empire later thrived in the Colorado Silver Boom.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Empire%2C_Colorado",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Empire officially became a statutory town on April 12 1882, marking its formal civic establishment.",
      "sourceSentenceIds": [
        17
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Empire%2C_Colorado",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Nestled in Clear Creek’s valley west of Denver, Empire sits on the north side of the valley floor.",
      "sourceSentenceIds": [
