  "facts": [
    {
      "id": 1,
      "text": "Ivanhoe got its name when the railroad depot was renamed after Sir Walter Scott's novel Ivanhoe in 1890.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/ivanhoe_north_carolina",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The Beatty‑Corbett House, Black River Presbyterian, and Ivanhoe Baptist Churches were all listed on the National Register in 1986.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Ivanhoe%2C_North_Carolina",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Ivanhoe sits in Franklin Township, named for post‑Civil War landowner Franklin Corbett, a formerly enslaved man who prospered leasing turpentine forests.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/ivanhoe_north_carolina",
      "category": "people",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Scottish Highland immigrants first settled the area in 1739, drawn by longleaf pines for tar, pitch, turpentine, and timber.",
      "sourceSentenceIds": [
        8,
        9,
        10,
        11
      ],
      "sourceLabels": [
        "Web source 2",
        "Wikipedia"
      ],
      "source": "https://grokipedia.com/page/ivanhoe_north_carolina",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The Black River’s confluence of Great Coharie Creek and Six Runs Creek made it a vital transport artery, with private landings easing seasonal high‑water travel.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 2"
