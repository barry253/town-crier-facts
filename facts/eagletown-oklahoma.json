  "facts": [
    {
      "id": 1,
      "text": "The Choctaws named Eagletown Osi Yamaha, which translates to Eagletown.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.redriverhistorian.com/post/eagletown-choctaw-trail-of-tears"
    },
    {
      "id": 2,
      "text": "Eagletown began as a station into Indian Territory on the Choctaw Trail of Tears shortly after the Louisiana Purchase.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.redriverhistorian.com/post/eagletown-choctaw-trail-of-tears"
    },
    {
      "id": 3,
      "text": "Eagletown was prominent in regional history during the period of Choctaw national sovereignty from the 1830s to 1906.",
      "sourceSentenceIds": [
        13
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.okhistory.org/publications/enc/entry?entry=EA011"
    },
    {
      "id": 4,
      "text": "The Gardner Mansion, located three miles west of Eagletown, is listed on the National Register of Historic Places.",
