  "facts": [
    {
      "id": 1,
      "text": "Amberson sits in a narrow valley between the Kittatinny and Tuscarora Mountains, where a central brook once powered local mills.",
      "sourceSentenceIds": [
        24
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/amberson_pennsylvania",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The community was first settled in the 1730s by Scotch‑Irish immigrants who built Presbyterian churches and self‑sufficient homesteads.",
      "sourceSentenceIds": [
        25
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/amberson_pennsylvania",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "In 1763, Francis Amberson, after whom the valley is named, established the first permanent settlement in the area.",
      "sourceSentenceIds": [
        20
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Amberson%2C_Pennsylvania",
      "category": "people",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Amberson Valley played a role in the Underground Railroad, sheltering escaped slaves in the 1840s.",
      "sourceSentenceIds": [
        15
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/amberson_pennsylvania",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The Amberson Valley Historical Society, founded in 1978, preserves the region’s history through a museum, research library, and archival collection.",
      "sourceSentenceIds": [
        1,
        5,
        16
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://museumsdatabase.com/museums/view/26703",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "A reinforced‑concrete bridge built in 1907, the Keggereis Ford Bridge, still spans the West Branch of Conococheague Creek, marking a shift to modern transportation.",
      "sourceSentenceIds": [
        26
      ],
