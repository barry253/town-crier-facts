  "facts": [
    {
      "id": 1,
      "text": "Chemung’s name comes from the Seneca word meaning “big horn,” a nod to a mammoth tusk once found along the river.",
      "sourceSentenceIds": [
        5,
        9,
        17
      ],
      "sourceLabels": [
        "Web source 2",
        "Wikipedia"
      ],
      "source": "https://www.discoverchemung.com/plan-your-visit/about-chemung/fun-facts/",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Chemung County was officially formed on March 29, 1836, from part of Tioga County, its growth fueled by the Chemung River, canal, and railroads.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.discoverchemung.com/plan-your-visit/about-chemung/fun-facts/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The Chemung Canal Bank Building, built in 1833, is Elmira’s oldest commercial structure and now houses the Chemung Valley History Museum.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.discoverchemung.com/plan-your-visit/about-chemung/fun-facts/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Chemung town was established in 1788, lost land to Tioga County in 1791, and ceded the area that became Elmira in 1792.",
      "sourceSentenceIds": [
        21,
        22,
        23
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Chemung%2C_New_York",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The Chemung River, a tributary of the Susquehanna, winds through the town’s southern edge, marking its western boundary with Pennsylvania.",
      "sourceSentenceIds": [
        26
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Chemung%2C_New_York",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Hovey Everett House and Riverside Cemetery are listed on the National Register of Historic Places, preserving Chemung’s early architectural heritage.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
