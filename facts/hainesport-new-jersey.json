  "facts": [
    {
      "id": 1,
      "text": "Hainesport got its name when Barclay Haines built a pier on the Rancocas Creek in 1848, shortening the original Haines' Port.",
      "sourceSentenceIds": [
        14,
        15
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Hainesport_Township%2C_New_Jersey",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "During the Revolutionary War, American rebels fired on Hessian soldiers in 1778 after the long wooden bridge over the Rancocas Creek was dismantled.",
      "sourceSentenceIds": [
        13,
        12
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Hainesport_Township%2C_New_Jersey",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The first European settlers were Quakers who arrived in 1677, establishing the community that would become Hainesport.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Hainesport_Township%2C_New_Jersey",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Hainesport Township officially became a township on March 12, 1924, carved out of portions of Lumberton.",
      "sourceSentenceIds": [
        16
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Hainesport_Township%2C_New_Jersey",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The historic Barclay Haines home, built in 1848, still stands as a reminder of the township’s early days.",
