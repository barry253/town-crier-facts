      ],
      "source": "https://en.wikipedia.org/wiki/Cabery%2C_Illinois",
      "category": "people",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The village hosts a small pond called 'the Clay Hole,' a favored fishing spot during warm months, though not suitable for swimming.",
      "sourceSentenceIds": [
