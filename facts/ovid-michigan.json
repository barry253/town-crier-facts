  "facts": [
    {
      "id": 1,
      "text": "Ovid was named after Ovid, New York, the hometown of settler William Swarthout who moved here in the mid‑1800s.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Ovid%2C_Michigan",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The village of Ovid was originally settled by people from Ovid, Seneca Falls County, N.Y., who purchased land sight unseen.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.ovidmi.org/HISTORY/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Ovid Historical Society founded 1972 by locals to preserve history and now hosts educational programs for children.",
      "sourceSentenceIds": [
        1,
        9
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://museumsdatabase.com/museums/view/15773",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Ovid Historical Society operates out of Ovid Township Hall built in 1877, listed on the National Register of Historic Places.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://museumsdatabase.com/museums/view/15773",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The old Congregational Church built in 1872 is listed on both the state and national historic registers.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.ovidmi.org/HISTORY/",
      "category": "landmark",
      "quality": "good"
    },
    {
