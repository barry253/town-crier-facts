  "facts": [
    {
      "id": 1,
      "text": "Laporte was first settled by French‑Canadian fur trappers and mountain men in the late 1820s, making it Larimer County’s earliest community.",
      "sourceSentenceIds": [
        19
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Laporte%2C_Colorado",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town’s name, “La Porte,” means “the door” in French, reflecting its role as the gateway to the mountains north of the South Platte.",
      "sourceSentenceIds": [
        24
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Laporte%2C_Colorado",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "In 1860 a town company organized the settlement, originally called Colona, before renaming it Laporte the following year.",
      "sourceSentenceIds": [
        4,
        2
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Laporte%2C_Colorado",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Laporte became the county seat in November 1861 after the territorial legislature designated it, solidifying its status as a regional hub.",
      "sourceSentenceIds": [
        26
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Laporte%2C_Colorado",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "An Overland Stage station and toll bridge were built over the Cache la Poudre River, turning Laporte into a critical stop for travelers heading west.",
      "sourceSentenceIds": [
        10,
        28
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Laporte%2C_Colorado",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Antoine Janis, the first permanent settler north of the Arkansas River, made Laporte his home in 1844; his cabin now sits in Heritage Courtyard.",
      "sourceSentenceIds": [
        22,
        15
      ],
