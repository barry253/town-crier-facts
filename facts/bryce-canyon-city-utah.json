      ],
      "source": "https://en.wikipedia.org/wiki/Bryce_Canyon_City%2C_Utah"
    },
    {
      "id": 2,
      "text": "Ruby Syrett established a lodge and cabins at this location in 1916 as tourism for the canyon began to grow.",
      "sourceSentenceIds": [
        4,
        27
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
