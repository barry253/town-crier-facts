    },
    {
      "id": 3,
      "text": "Bryce Canyon City became the first town incorporated under a short-lived 2007 state law regarding municipal petitions.",
      "sourceSentenceIds": [
        3,
        12
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Bryce_Canyon_City%2C_Utah"
    },
    {
      "id": 4,
      "text": "The town hosts several annual events, including the Bryce Canyon Winter Festival, the Country Rodeo, and the Canyon 2 Canyon Bike Ride.",
      "sourceSentenceIds": [
        30
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.visitbrycecanyoncity.com/"
    },
    {
      "id": 5,
      "text": "A majority of the residents in Bryce Canyon City are members of the Syrett family and employees of Ruby's Inn.",
