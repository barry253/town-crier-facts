  "facts": [
    {
      "id": 1,
      "text": "Springbank got its name from the nearby Springbank Creek that flows southeast into the Elbow River.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Springbank%2C_Alberta",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Around 1876 settlers moved into an area then called ‘Spring Bank’ after a Dominion Land Act amendment.",
      "sourceSentenceIds": [
        28
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.rockyview.ca/communities-and-recreation/our-communities/springbank",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The community shifted from farming to rural residential living in the 1950s as families sought quieter surroundings.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.rockyview.ca/communities-and-recreation/our-communities/springbank",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Since the early 1980s, Calgary annexed eastern Springbank, creating neighbourhoods like Springbank Hill, Aspen Woods, and Cougar Ridge.",
      "sourceSentenceIds": [
        12,
        13
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Springbank%2C_Alberta",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Calaway Park, an outdoor family amusement park, sits within Springbank’s borders and draws visitors from across Alberta.",
      "sourceSentenceIds": [
        15
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Springbank%2C_Alberta",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Springbank Community High School is housed inside Springbank Park For All Seasons, which also hosts an ice arena and curling rink.",
