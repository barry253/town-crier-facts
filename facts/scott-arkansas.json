      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The Plantation Agriculture Museum on the Pulaski County side showcases cotton production artifacts and hosts the annual Antique Tractor and Engine Show.",
      "sourceSentenceIds": [
        8,
        16
      ],
      "sourceLabels": [
