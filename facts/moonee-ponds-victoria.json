  "facts": [
    {
      "id": 1,
      "text": "Moonee Ponds takes its name from the nearby Moonee Ponds Creek, a waterway once home to the Wurundjeri people.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://mooneeponds.vic.guide/History",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The Clocktower Centre, now a lively performing‑arts venue, began life in 1890 as Essendon Town Hall.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://mooneeponds.vic.guide/History",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Queens Park started as a water reserve for travelling stock and later hosted Burke and Wills in 1860.",
      "sourceSentenceIds": [
        11,
        29
      ],
      "sourceLabels": [
        "Web source 1",
        "Wikipedia"
      ],
      "source": "https://www.mooneepondshistory.com/history",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "In 1998 the Moonee Ponds Creek Co‑ordination Committee was formed to protect and restore the creek and its tributaries.",
      "sourceSentenceIds": [
        7
      ],
