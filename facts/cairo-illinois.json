  "facts": [
    {
      "id": 1,
      "text": "Cairo was named after Egypt’s capital because its confluence of the Ohio and Mississippi Rivers reminded settlers of the Nile Delta.",
      "sourceSentenceIds": [
        1,
        9
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 2"
      ],
      "source": "https://en.wikipedia.org/wiki/Cairo%2C_Illinois",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "During the Civil War, Union General Ulysses S. Grant occupied Cairo and built Fort Defiance to guard the strategic river junction.",
      "sourceSentenceIds": [
        16,
        2
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Cairo%2C_Illinois",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The city’s historic custom house and other 19th‑century buildings were originally designed to sit above the levee tops, protecting them from floods.",
      "sourceSentenceIds": [
        17
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Cairo%2C_Illinois",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Cairo once served as a major railroad hub; by 1900 several lines branched from the city, linking it to Chicago and the Midwest.",
      "sourceSentenceIds": [
        29,
        28
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Cairo%2C_Illinois",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "In the 1960s, Cairo became a flashpoint for civil rights, with local activists forming the Cairo United Front to challenge segregation.",
      "sourceSentenceIds": [
        12,
        13,
        14
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Cairo%2C_Illinois",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Today, the confluence of the Mississippi and Ohio Rivers is a unique natural landmark, visible from the city’s riverfront park at sunrise.",
