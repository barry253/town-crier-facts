      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "South Ashburnham receives more than 44 inches of rain annually, one of the highest in the U.S., and snow covers the ground for about 68 days each year.",
      "sourceSentenceIds": [
        15
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/South_Ashburnham%2C_Massachusetts",
      "category": "other",
      "quality": "poor",
      "qualityReason": "vague"
    },
    {
      "id": 4,
      "text": "Temperatures fall below 50°F for 195 days per year, giving the area a long, cool season.",
      "sourceSentenceIds": [
        14
