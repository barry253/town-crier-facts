      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Historic landmarks such as Blackford Bridge, Carter Hill, and the Samuel Gilmer House earn Lebanon a place on the National Register of Historic Places.",
      "sourceSentenceIds": [
