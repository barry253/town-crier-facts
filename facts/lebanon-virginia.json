      ],
      "source": "https://en.wikipedia.org/wiki/Lebanon%2C_Virginia",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Lebanon Lutheran Church, established in 1851 by Pastor Jacob Scherer, stands as one of the town’s oldest religious institutions.",
      "sourceSentenceIds": [
