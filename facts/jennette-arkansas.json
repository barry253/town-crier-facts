  "facts": [
    {
      "id": 1,
      "text": "Jennette began as a swampy hardwood forest in Crittenden County before settlers cleared it for agriculture.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/jennette_arkansas"
    },
    {
      "id": 2,
      "text": "In the early twentieth century, the Edwards Fair Lumber Company cleared the forest and dug drainage ditches to convert the land to farmland.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/jennette_arkansas"
    },
    {
      "id": 3,
      "text": "Jennette was formally incorporated on November 20, 1987, after residents petitioned for municipal status.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/jennette_arkansas"
    },
    {
      "id": 4,
      "text": "Three longstanding churches—Pilgrim Rest Missionary Baptist, a Church of God in Christ, and a nondenominational church—anchor community life.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/jennette_arkansas"
    },
    {
      "id": 5,
      "text": "Jennette receives about 56 inches of rain annually, peaking in spring from Gulf moisture and thunderstorms.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/jennette_arkansas"
    },
    {
      "id": 6,
      "text": "The town is largely African American and serves as a residential farming community with no major businesses.",
