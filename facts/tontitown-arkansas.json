      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The Tontitown Grape Festival, a celebration of local viticulture, has run uninterrupted since 1898.",
      "sourceSentenceIds": [
        18
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Tontitown%2C_Arkansas",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "A railroad depot opened in 1912, linking Tontitown’s grape growers to markets in Springdale.",
      "sourceSentenceIds": [
