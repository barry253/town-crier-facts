      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Geuzenveld Park offers a green oasis for strolls, picnics, and outdoor activities right in the heart of the neighborhood.",
      "sourceSentenceIds": [
        16
      ],
      "sourceLabels": [
        "Web source 1"
