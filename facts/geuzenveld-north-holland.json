    },
    {
      "id": 2,
      "text": "The neighborhood was built in the 1950s as part of a post‑war effort to house Amsterdam’s growing population.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://amsterdamcitycard.com/geuzenveld-amsterdam-read-this-before-your-visit/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Architect Cornelis van Eesteren designed Geuzenveld, and its functionalist buildings reflect mid‑20th‑century Dutch architecture.",
      "sourceSentenceIds": [
