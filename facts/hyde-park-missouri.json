  "facts": [
    {
      "id": 1,
      "text": "Hyde Park was first mentioned in the mid‑1880s real‑estate boom, marking the start of its development as a residential enclave.",
      "sourceSentenceIds": [
        18
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Hyde_Park%2C_Kansas_City"
    },
    {
      "id": 2,
      "text": "The neighborhood’s name dates back to 1833, when pioneers settled the area that would become Hyde Park.",
      "sourceSentenceIds": [
        11
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.hydeparkkc.org/history"
    },
    {
      "id": 3,
      "text": "George Kessler designed a park for Hyde Park, laying groundwork for Kansas City’s City Beautiful boulevards and parks.",
      "sourceSentenceIds": [
        20
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Hyde_Park%2C_Kansas_City"
    },
    {
      "id": 4,
      "text": "Hyde Park’s historic district includes 1,500 homes, with 291 in Central Hyde Park and 767 in South Hyde Park contributing to the register.",
      "sourceSentenceIds": [
        16
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Hyde_Park%2C_Kansas_City"
    },
    {
      "id": 5,
      "text": "In 1894, Stanley Young established Kansas City’s first golf course, the 17‑hole Kenwood Golf Links, within Hyde Park’s park.",
      "sourceSentenceIds": [
        29
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Hyde_Park%2C_Kansas_City"
    },
