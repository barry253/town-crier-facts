  "facts": [
    {
      "id": 1,
      "text": "South Woodstock was originally settled in the 1770s with rural agricultural homesteads built on the local hilltops.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/South_Woodstock%2C_Vermont"
    },
    {
      "id": 2,
      "text": "Located in the Kedron Valley, South Woodstock once served as a center for sheep husbandry.",
      "sourceSentenceIds": [
        6,
        14
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/South_Woodstock%2C_Vermont"
    },
    {
      "id": 3,
      "text": "The village of South Woodstock grew around the gristmills of the Cottle brothers to serve outlying farmers.",
      "sourceSentenceIds": [
        18
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/South_Woodstock%2C_Vermont"
    },
    {
      "id": 4,
      "text": "South Woodstock maintained its early nineteenth century character because it remained away from economically important railroad transport.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/South_Woodstock%2C_Vermont"
    },
    {
      "id": 5,
      "text": "The South Woodstock Village Historic District was listed on the National Register of Historic Places in 1983.",
      "sourceSentenceIds": [
        15
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/South_Woodstock%2C_Vermont"
    },
    {
      "id": 6,
      "text": "Notable landmarks in South Woodstock include the 1839 South Chapel and the Perkins Academy, built in 1848.",
      "sourceSentenceIds": [
