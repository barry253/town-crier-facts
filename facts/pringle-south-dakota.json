  "facts": [
    {
      "id": 1,
      "text": "Pringle was originally known as the Point of Rocks Stage Station, named after a distinct granite outcropping east of the town.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Pringle%2C_South_Dakota"
    },
    {
      "id": 2,
      "text": "The town was renamed Pringle in 1890 to honor Anna Carr Pringle, who provided hospitality to railroad crews.",
      "sourceSentenceIds": [
        1,
        2,
        3
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1",
        "Web source 2"
      ],
      "source": "https://en.wikipedia.org/wiki/Pringle%2C_South_Dakota"
    },
    {
      "id": 3,
      "text": "Pringle's early settlement grew around a stage station that established its own post office in 1885.",
      "sourceSentenceIds": [
