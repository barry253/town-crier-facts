  "facts": [
    {
      "id": 1,
      "text": "Bayview operated its own post office from 1925 to 1935 before merging with Eureka's, a key step in its integration into the greater Eureka area.",
      "sourceSentenceIds": [
        4,
        14
      ],
      "sourceLabels": [
        "Web source 1",
        "Wikipedia"
      ],
      "source": "https://grokipedia.com/page/bayview_humboldt_county_california",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The Bayview area sits on traditional Wiyot territory, where the Wiyot people lived for thousands of years before European contact.",
      "sourceSentenceIds": [
        5,
        28
      ],
      "sourceLabels": [
        "Web source 1",
        "Wikipedia"
      ],
      "source": "https://grokipedia.com/page/bayview_humboldt_county_california",
      "category": "people",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Indigenous trails crisscrossed Bayview, later shaping the routes of early European roads through the neighborhood.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/bayview_humboldt_county_california",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "In the 1950 census, Bayview was part of the Bayview‑Rosewood‑Cutten unincorporated community, reflecting its early administrative grouping.",
      "sourceSentenceIds": [
        15
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Bayview%2C_Humboldt_County%2C_California",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Bayview’s close‑knit atmosphere offers parks and waterfront views in one of California’s most ecologically diverse coastal regions.",
