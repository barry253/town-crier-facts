  "facts": [
    {
      "id": 1,
      "text": "Tulia serves as the county seat of Swisher County and sits at the crossroads of U.S. highways.",
      "sourceSentenceIds": [
        26,
        27
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Tulia%2C_Texas",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town’s original site lay on land from the Tule Ranch division of the JA Ranch.",
      "sourceSentenceIds": [
        6,
        8,
        9
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1",
        "Web source 2"
      ],
      "source": "https://en.wikipedia.org/wiki/Tulia%2C_Texas",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "In 1887, a post office opened in James A. Parrish’s dugout on Middle Tule Draw, nine miles west of today’s Tulia.",
      "sourceSentenceIds": [
        29,
        30
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Tulia%2C_Texas",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "An original Ozark Trail marker still stands on Tulia’s square, a reminder of its role as a major stop on that historic route.",
      "sourceSentenceIds": [
        14
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.tshaonline.org/handbook/entries/tulia-tx",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The Swisher County Museum once showcased pioneer relics and a log cabin that began as a line camp for the JA Ranch.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.tshaonline.org/handbook/entries/tulia-tx",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "A modern courthouse built in 1962 anchors Tulia’s square, while the Swisher County Memorial Building houses the library and chamber of commerce.",
      "sourceSentenceIds": [
