  "facts": [
    {
      "id": 1,
      "text": "Medora was founded in 1883 by French nobleman Marquis de Mores, who named the town after his wife, Medora von Hoffman.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Medora%2C_North_Dakota",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town’s first meat‑packing plant was built by de Mores, and his house, the Chateau de Mores, now serves as a museum.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Medora%2C_North_Dakota",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "De Mores aimed to ship refrigerated meat from Medora to Chicago by rail, pioneering cold‑chain logistics in the late 19th century.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Medora%2C_North_Dakota",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "On April 7, 1903, President Theodore Roosevelt stopped in Medora during a western tour, greeting crowds at the Rough Riders Hotel.",
      "sourceSentenceIds": [
        22
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Medora%2C_North_Dakota",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "In 1962, entrepreneur Harold Schafer purchased the Rough Riders Hotel, restoring it in the 1960s and sparking Medora’s cultural revival.",
      "sourceSentenceIds": [
        11,
        12,
        13,
        25
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://medora.com/whatismedora/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The Von Hoffman House, built by Medora’s parents, is listed on the National Register of Historic Places and preserves the town’s early heritage.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://medora.com/whatismedora/",
      "category": "landmark",
      "quality": "good"
    }
