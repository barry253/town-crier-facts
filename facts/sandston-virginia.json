  "facts": [
    {
      "id": 1,
      "text": "Sandston started as a World War I munitions factory, with 230 kit houses built for workers of the Seven Pines Loading Plant.",
      "sourceSentenceIds": [
        7,
        8,
        21,
        24
      ],
      "sourceLabels": [
        "Web source 1",
        "Web source 2"
      ],
      "source": "https://www.dhr.virginia.gov/historic-registers/043-6271/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town’s name honors Oliver Sands, president of the Richmond and Fairfield Railway that ran the streetcar line to Seven Pines.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Sandston%2C_Virginia",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Sandston’s historic district, covering 226 acres, was added to the National Register of Historic Places in 2021.",
      "sourceSentenceIds": [
        3,
        19,
        9
      ],
      "sourceLabels": [
        "Web source 2",
        "Web source 1",
        "Wikipedia"
      ],
      "source": "https://archive.org/details/hctvva-Exploring_the_Sandston_Historic_District",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The district showcases Colonial Revival, Bungalow/Craftsman, Spanish Mission Revival, and Minimal Traditional homes built between 1918 and 1966.",
      "sourceSentenceIds": [
        26
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.dhr.virginia.gov/historic-registers/043-6271/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The streetcar line was called “Nine Mile Road” because it matched the nine‑mile distance from Richmond to Seven Pines.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Sandston%2C_Virginia",
      "category": "transport",
      "quality": "good"
    }
