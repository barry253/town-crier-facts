  "facts": [
    {
      "id": 1,
      "text": "White City earned its name from the white‑colored homes that lined its streets, many of which were prefabricated Sears Catalog houses shipped from the 1904 World's Fair.",
      "sourceSentenceIds": [
        2,
        21
      ],
      "sourceLabels": [
        "Web source 2",
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/white_city_illinois",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Founded in 1859 as a modest farming settlement, White City evolved into a mining community with skating rinks, dance halls, gardens, a brick building, and an elementary school.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/white_city_illinois",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "In 1904, the St. Louis Mining Company sank the first shaft for its #15 coal mine, marking the start of White City’s mining boom.",
      "sourceSentenceIds": [
        20
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://thevillageofwhitecity.myruralwater.com/about-us",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "White City’s waterways drain westward into Cahokia Creek, which flows directly into the Mississippi River.",
      "sourceSentenceIds": [
        9,
        10
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/White_City%2C_Illinois",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The town was officially incorporated on June 21, 1907, as a coal‑mining community following the opening of Mine No. 15.",
