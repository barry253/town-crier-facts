  "facts": [
    {
      "id": 1,
      "text": "Founded in 1671 by French Jesuit Jacques Marquette, St. Ignace is Michigan's second‑oldest city founded by Europeans.",
      "sourceSentenceIds": [
        1,
        2,
        3
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1",
        "Web source 2"
      ],
      "source": "https://en.wikipedia.org/wiki/St._Ignace%2C_Michigan",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Fort de Buade, a fur‑trade post started in 1681 by Louis de La Porte, now serves as a museum that chronicles early commerce.",
      "sourceSentenceIds": [
        7,
        20
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/St._Ignace%2C_Michigan",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The Detroit, Mackinac and Marquette Railroad arrived in 1882, turning the village into a rail hub that linked the Straits to Detroit.",
      "sourceSentenceIds": [
        11,
        19
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/St._Ignace%2C_Michigan",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "St. Ignace is the headquarters of the Mackinac Bands of Chippewa and Ottawa Indians, where indigenous culture is celebrated through events and art.",
      "sourceSentenceIds": [
        8,
        12,
        22
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/St._Ignace%2C_Michigan",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "In 1883 the village incorporated as a city, marking its transition from a trading post to a modern municipality.",
      "sourceSentenceIds": [
        16
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://northernmichiganhistory.com/st-ignace-michigans-timeless-gateway-to-history/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The town’s name honors St. Ignatius of Loyola, reflecting its Jesuit missionary roots.",
