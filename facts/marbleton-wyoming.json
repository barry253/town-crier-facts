      "id": 1,
      "text": "Marbleton is located in Sublette County, Wyoming, and experiences a subarctic climate with brutally cold and long winters.",
      "sourceSentenceIds": [
        9,
        11
      ],
      "sourceLabels": [
        "Wikipedia"
