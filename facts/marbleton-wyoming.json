    },
    {
      "id": 2,
      "text": "Marbleton and nearby Big Piney remained fairly isolated for much of their history, with the closest railroad stop nearly sixty miles away.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 1"
      ],
