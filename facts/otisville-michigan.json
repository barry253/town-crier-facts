      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The village’s first sawmill was built by John Hayes in 1851, then sold to Francis Otis the next year.",
      "sourceSentenceIds": [
        5,
        22
      ],
      "sourceLabels": [
        "Web source 2",
        "Wikipedia"
      ],
      "source": "https://kids.kiddle.co/Otisville,_Michigan",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "A Pere Marquette Railway station opened in Otisville in 1874, linking the village to regional trade.",
      "sourceSentenceIds": [
