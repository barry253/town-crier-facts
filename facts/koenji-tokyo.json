  "facts": [
    {
      "id": 1,
      "text": "Koenji became a bohemian hotspot in the 1960s when folk‑rock stars Takuro Yoshida and Kosetsu Minami moved there.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/K%C5%8Denji",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "After the 1923 Great Kanto Earthquake, displaced merchants rebuilt Koenji with shops, eateries, and bars that still define its economy.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.japan-experience.com/all-about-japan/tokyo/attractions-excursions/koenji",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Cheap rents and a youthful vibe drew artists and musicians, establishing Koenji as Tokyo’s capital of underground cool.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.japan-experience.com/all-about-japan/tokyo/attractions-excursions/koenji",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "From the mid‑1970s, live‑music venues opened across Koenji, turning it into a haven for indie folk, psychedelic, and punk bands.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/K%C5%8Denji",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Pal Arcade and dozens of “live houses” in Koenji birthed Japan’s punk scene, where up‑coming bands honed their craft in intimate clubs.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.japan-experience.com/all-about-japan/tokyo/attractions-excursions/koenji",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Every summer, Koenji celebrates the Awa Odori dance, a massive street festival where troupes parade with drums, flutes, and shamisen.",
      "sourceSentenceIds": [
        21,
        28
      ],
