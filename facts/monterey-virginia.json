  "facts": [
    {
      "id": 1,
      "text": "Monterey was named to honor the 1846 Battle of Monterrey, where General Zachary Taylor secured a key victory for the United States.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Monterey%2C_Virginia",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "In 1847, Monterey was chosen as Highland County’s seat after the 1838 blaze that damaged the Staunton‑Parkersburg Turnpike.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Monterey%2C_Virginia",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Every March, the Highland County Maple Festival turns Monterey into a maple‑syrup hub, attracting roughly 50,000 visitors.",
      "sourceSentenceIds": [
        16
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Monterey%2C_Virginia",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Historic sights like the 19th‑century Monterey Inn and the Highland County Courthouse showcase the town’s architectural heritage.",
      "sourceSentenceIds": [
        5,
        6
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.islands.com/2075081/monterey-virginia-quaint-town-nicknamed-little-switzerland-mountain-views-maple-syrup/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "US 250, constructed in the 1840s, originally ran through Monterey as part of the Staunton‑Parkersburg Turnpike linking the Shenandoah Valley to the Ohio River.",
      "sourceSentenceIds": [
        4
      ],
