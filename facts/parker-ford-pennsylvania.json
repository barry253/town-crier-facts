  "facts": [
    {
      "id": 1,
      "text": "Parker Ford’s historic tavern, built in 1766 by Edward Parker, still stands as a two‑story sandstone inn on the original river trail.",
      "sourceSentenceIds": [
        16,
        18,
        21
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.livingplaces.com/PA/Chester_County/East_Coventry_Township/Parker_Ford.html",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "In September 1777, George Washington and his Continental Army crossed the Schuylkill River at Parker Ford, making the site a key Revolutionary War waypoint.",
      "sourceSentenceIds": [
        25
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.livingplaces.com/PA/Chester_County/East_Coventry_Township/Parker_Ford.html",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The Parker Ford District earned national historic status for its commerce, transportation, and military significance from 1700 to 1899.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.eastvincent.org/?SEC=301AFB7B-6AA7-496D-949B-5080035A30A0",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Parker Ford sits at the crossroads of Pennsylvania Route 724 and Bethel Church Road, a junction that once connected travelers from Philadelphia to the western back‑country.",
      "sourceSentenceIds": [
        10,
        11,
        27
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Parker_Ford%2C_Pennsylvania",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "A Tavern Steering Committee now guides a master plan to preserve Parker Ford’s historic inn, ensuring the site remains a cultural treasure for future generations.",
      "sourceSentenceIds": [
        9
      ],
