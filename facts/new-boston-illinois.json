  "facts": [
    {
      "id": 1,
      "text": "New Boston sits on the east bank of the Mississippi River, where Boston Bay meets Eliza Creek.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/New_Boston%2C_Illinois",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Early 1800s Sac and Fox Indians called the region Yellowbanks, stretching from present‑day New Boston to Oquawka.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/new_boston_illinois",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "In 1827 William Denison and his son John first settled New Boston, coexisting peacefully with chiefs Black Hawk and Keokuk.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/new_boston_illinois",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "After the Black Hawk War, 1832 land cessions opened the area to Yankee migrants from Massachusetts, many fleeing Nauvoo.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/new_boston_illinois",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Post‑World War II New Boston added small‑scale manufacturing like the Dewey Stave Factory and Seastone Wagon Company, yet floods still tested resilience.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/new_boston_illinois",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Port Louisa National Wildlife Refuge surrounds much of New Boston’s natural area, protecting wetlands that host migratory birds.",
      "sourceSentenceIds": [
