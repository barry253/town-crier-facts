  "facts": [
    {
      "id": 1,
      "text": "Chili’s name comes from a station on the Denver & Rio Grande Railroad’s Chili Line, a name inspired by the region’s famous chile peppers.",
      "sourceSentenceIds": [
        5,
        3
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Chili%2C_New_Mexico",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Chili was settled by Spanish colonists in the late 17th and 18th centuries, after the reconquest following the Pueblo Revolt of 1680.",
      "sourceSentenceIds": [
        10,
        11
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/chili_new_mexico",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "By the mid‑1800s, Chili functioned as a modest farming and ranching outpost, producing crops like maize, beans, and chile peppers along the fertile Rio Chama valley.",
      "sourceSentenceIds": [
        28
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/chili_new_mexico",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The Chili Line was abandoned in 1942 after the Interstate Commerce Commission approved closure following the final train run on August 30, 1941.",
      "sourceSentenceIds": [
