  "facts": [
    {
      "id": 1,
      "text": "Alphonse 'Al' Paré named the growing mining camp 'Timmins' after his uncle, Noah Timmins, the Hollinger Mines president.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Timmins"
    },
    {
      "id": 2,
      "text": "Noah Timmins founded the town in 1912 to house employees of the Hollinger Mine.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://tourismtimmins.com/about/"
    },
    {
      "id": 3,
      "text": "A company town was founded near modern‑day Gillies Lake to house Hollinger Mines employees.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Timmins"
    },
    {
      "id": 4,
      "text": "The Porcupine/Dome camp, owned by Dome Mines, sat on Porcupine Lake beside the original mining town.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Timmins"
    },
    {
      "id": 5,
      "text": "Timmins sits on the Mattagami River in northeastern Ontario, a key waterway for early transport.",
      "sourceSentenceIds": [
        24
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Timmins"
    },
    {
      "id": 6,
      "text": "The city’s economy centers on natural resource extraction, especially gold, zinc, copper, nickel, and silver mining.",
      "sourceSentenceIds": [
        25,
        26
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Timmins"
    }
  ]
