  "facts": [
    {
      "id": 1,
      "text": "Axson was renamed in 1916 after First Lady Ellen Axson Wilson, the wife of President Woodrow Wilson.",
      "sourceSentenceIds": [
        18,
        17
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Axson%2C_Georgia",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "A single historic building, McCranie’s Turpentine Still, sits in Axson and is listed on the National Register of Historic Places.",
      "sourceSentenceIds": [
        11,
        12
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.georgiaencyclopedia.org/articles/counties-cities-neighborhoods/atkinson-county/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Atkinson County, where Axson lies, was carved out of Clinch and Coffee counties in 1917 by the state legislature.",
      "sourceSentenceIds": [
        5,
        6
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.georgiaencyclopedia.org/articles/counties-cities-neighborhoods/atkinson-county/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The Brunswick and Albany Railroad reached Pearson, the county seat, in the 1870s, linking the area to the wider rail network.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.georgiaencyclopedia.org/articles/counties-cities-neighborhoods/atkinson-county/",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Axson sits on U.S. Route 82, just 7.1 miles east of Pearson, making it a quiet stop along a historic corridor.",
