      "quality": "good"
    },
    {
      "id": 3,
      "text": "Cayuta was created from part of the Town of Spencer in 1824, before Schuyler County existed.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Cayuta%2C_New_York",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "In 1854, Cayuta expanded by adding parts of Catharine and Erin, then both in Chemung County.",
