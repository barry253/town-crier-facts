  "facts": [
    {
      "id": 1,
      "text": "Ravenswood was named after a hero in Walter Scott’s 1819 novel The Bride of Lammermoor, chosen by Henrietta Fitzhugh, wife of founder Henry Fitzhugh.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Ravenswood%2C_West_Virginia",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "First settled in 1810, the town’s streets were laid out in 1835 on land once owned by George Washington.",
      "sourceSentenceIds": [
        16
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Ravenswood%2C_West_Virginia",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The Ohio River Railroad reached Ravenswood in 1886, linking it to the wider region and spurring growth.",
      "sourceSentenceIds": [
        20
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Ravenswood%2C_West_Virginia",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "One mile north of Ravenswood, the 1863 Battle of Buffington Island took place, a rare naval engagement on the Ohio River.",
      "sourceSentenceIds": [
        19
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Ravenswood%2C_West_Virginia",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "In 1957, Kaiser Aluminum opened the world’s largest refinery nearby, employing 12,000 workers and reshaping the local economy.",
