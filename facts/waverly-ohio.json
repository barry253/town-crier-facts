  "facts": [
    {
      "id": 1,
      "text": "Waverly sprang to life in 1829 when the Ohio‑Erie Canal cut through its banks, spurring rapid growth along the Scioto River.",
      "sourceSentenceIds": [
        2,
        30
      ],
      "sourceLabels": [
        "Web source 1",
        "Wikipedia"
      ],
      "source": "https://cityofwaverly.net/about/city_history.php"
    },
    {
      "id": 2,
      "text": "Engineers on the canal named the town Waverly after a suggestion by Francis Cleveland, replacing its earlier name Uniontown.",
      "sourceSentenceIds": [
        9,
        12
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Waverly%2C_Ohio"
    },
    {
      "id": 3,
      "text": "James Emmitt, one of the richest men in southern Ohio, left his mark on Waverly with several historic buildings and Emmitt Avenue.",
      "sourceSentenceIds": [
        3,
        10
      ],
      "sourceLabels": [
        "Web source 1",
        "Wikipedia"
      ],
      "source": "https://cityofwaverly.net/about/city_history.php"
    },
    {
      "id": 4,
      "text": "Two rail lines, the Scioto Valley and Ohio Southern, ran through Waverly in the 1860s, prompting the county seat to move from Piketon.",
      "sourceSentenceIds": [
        23
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://touring-ohio.com/southwest/waverly/waverly.html"
    },
    {
      "id": 5,
      "text": "Around Waverly, the Adena and Hopewell peoples built mounds that still stand today, linking the town to ancient Ohio cultures.",
      "sourceSentenceIds": [
        14,
        15
      ],
      "sourceLabels": [
        "Wikipedia",
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Waverly%2C_Ohio"
    },
    {
      "id": 6,
      "text": "Waverly is the hometown of the country‑rock pioneers Pure Prairie League, giving the village a place in music history.",
