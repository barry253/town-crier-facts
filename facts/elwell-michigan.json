  "facts": [
    {
      "id": 1,
      "text": "Elwell was settled around 1877 and quickly became a station on the Pere Marquette Railroad.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://99wfmk.com/elwell-michigan-vintage-photos/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The MacLachlan Sanitarium, a stone building erected in the mid‑1880s, once treated nerve, skin, rheumatism, and tuberculosis patients.",
      "sourceSentenceIds": [
        25,
        26,
        27
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://99wfmk.com/elwell-michigan-vintage-photos/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "After the doctor died in 1920, the sanitarium became a boarding house, dance hall, restaurant, saloon, and later a private residence.",
      "sourceSentenceIds": [
        28
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://99wfmk.com/elwell-michigan-vintage-photos/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Elwell’s post office opened in 1880, and the village was officially platted in 1911.",
      "sourceSentenceIds": [
        22
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://99wfmk.com/elwell-michigan-vintage-photos/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Today the MacLachlan Sanitarium is a Michigan State Historic Site and listed on the National Register of Historic Places.",
      "sourceSentenceIds": [
        6,
        8
      ],
      "sourceLabels": [
        "Web source 1"
      ],
