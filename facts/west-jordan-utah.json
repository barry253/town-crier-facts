      "text": "West Jordan was founded around 1849 on the western banks of the Jordan River.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/West_Jordan%2C_Utah",
