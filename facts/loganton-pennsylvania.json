  "facts": [
    {
      "id": 1,
      "text": "Loganton was named after Chief James Logan, son of Chief Shikellamy in the 19th century.",
      "sourceSentenceIds": [
        3,
        4
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Loganton%2C_Pennsylvania",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The borough sits in the fertile Sugar Valley, one of the last central PA regions settled by Europeans.",
      "sourceSentenceIds": [
        6,
        27
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.logantonborough.org/new-pagebc2bda87",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The Great Shamokin Path, an ancient Native American trail, cuts through Sugar Valley, linking major tribal regions.",
      "sourceSentenceIds": [
        26
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.logantonborough.org/new-pagebc2bda87",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "In the early 1800s, John Kleckner built Sugar Valley’s first grist and sawmills on land once owned by Caspar Wistar.",
      "sourceSentenceIds": [
        16
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Loganton%2C_Pennsylvania",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The Sugar Valley Historical Society, located at 1756 Bull Run Road, preserves the area's history and hosts public exhibits.",
      "sourceSentenceIds": [
        1,
        7
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.svhistory.org/",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Loganton lies at the northern base of Sugar Valley Mountain, part of the Ridge‑and‑Valley Appalachians.",
      "sourceSentenceIds": [
