    {
      "id": 3,
      "text": "Watermen and recreational boaters share the broad rivers, back bays, and scenic coves of Kent Narrows, home to crabs, oysters, osprey, herons, and sea ducks.",
      "sourceSentenceIds": [
        23
      ],
