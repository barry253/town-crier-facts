      ],
      "source": "https://henderson.nc.gov/community/history.php"
    },
    {
      "id": 5,
      "text": "Henderson sits on the former Seaboard Air Line S‑Line; Amtrak served the town until 1986 before rerouting.",
      "sourceSentenceIds": [
