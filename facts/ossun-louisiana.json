      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Mid‑19th‑century Acadian exiles and French immigrants founded Ossun, turning the prairie into a tight‑knit agrarian community.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 1"
      ],
