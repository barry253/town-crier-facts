  "facts": [
    {
      "id": 1,
      "text": "The oldest standing building in Laurel Hill is the Presbyterian Church, dating back to 1797 and still a centerpiece of the town’s heritage.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://visitnc-soul.com/history/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Stewartsville Cemetery, founded in 1785, is one of the few burial grounds that honors blacks, whites, and Native Americans side by side.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://visitnc-soul.com/history/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The John Blue House, part of the North Carolina Rural Heritage Center, showcases Steamboat Gothic architecture and is a rare example of that style in the region.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://visitnc-soul.com/history/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Richmond Temperance Hall, established in 1853, was founded to elevate the moral and cultural life of Laurel Hill and its surrounding community.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://visitnc-soul.com/history/",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Laurel Hill’s Heritage Village brings together a collection of relocated historic structures, each moved to the grounds for preservation and public display.",
      "sourceSentenceIds": [
        14
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://visitnc-soul.com/history/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Residents of Laurel Hill celebrate their diverse roots with local events and festivities that reflect the town’s rich cultural heritage.",
      "sourceSentenceIds": [
        8,
        9
      ],
