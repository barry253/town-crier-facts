  "facts": [
    {
      "id": 1,
      "text": "Shady Shores became an official town in 1960 to avoid being annexed by Denton, adopting the name of its original subdivision.",
      "sourceSentenceIds": [
        23
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Shady_Shores%2C_Texas",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town’s roots trace back to the 1920s when Dallas contractor John William Franck built a fishing camp of ten wood‑shingle cabins on Lake Dallas’s northern shore.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Shady_Shores%2C_Texas",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "In the 1930s, many of those early fishing camps were replaced by permanent homes, a number of which still stand today.",
      "sourceSentenceIds": [
        21
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Shady_Shores%2C_Texas",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Lake Dallas was enlarged in the late 1950s, becoming the larger Lewisville Lake that now surrounds Shady Shores.",
      "sourceSentenceIds": [
        22
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Shady_Shores%2C_Texas",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Shady Shores is one of four communities that make up the Lake Cities, a collective of towns bordering each other.",
      "sourceSentenceIds": [
        16
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://lakecitieschamber.com/your-cities/shady-shores-chamber-of-commerce/",
      "category": "other",
      "quality": "poor",
      "qualityReason": "other"
    },
    {
      "id": 6,
      "text": "The town’s first school, Shady Shores Independent School, opened in 1912, serving local families before the town’s incorporation.",
      "sourceSentenceIds": [
