  "facts": [
    {
      "id": 1,
      "text": "Originally called Cressmanville in 1797 after landowner John Cressman, the village was renamed Tyler's Port in 1842 to honor President John Tyler.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/tylersport_pennsylvania",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "By 1880, Tylersport boasted about 50 houses, a cigar factory, a Belgian block factory, and 224 residents, marking its modest industrial growth.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/tylersport_pennsylvania",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Tylersport sits where Pennsylvania Route 563 meets Allentown Road, anchoring the village in Montgomery County.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Tylersport%2C_Pennsylvania",
      "category": "other",
      "quality": "poor",
      "qualityReason": "location_description"
    },
    {
      "id": 4,
      "text": "The village lies in a rural valley drained by Perkiomen and Ridge Valley Creeks, roughly 35 miles northwest of Philadelphia.",
      "sourceSentenceIds": [
        14
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/tylersport_pennsylvania",
      "category": "other",
      "quality": "poor",
      "qualityReason": "location_description"
    },
    {
      "id": 5,
      "text": "White's Mill, one of four gristmills by 1893, processed grain and sometimes lumber, illustrating Tylersport’s water‑powered industry.",
      "sourceSentenceIds": [
        25
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/tylersport_pennsylvania",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Tylersport hosts Salford Township’s administrative center, with its municipal building located at 139 Ridge Road.",
      "sourceSentenceIds": [
        13
