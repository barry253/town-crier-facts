  "facts": [
    {
      "id": 1,
      "text": "Guilderland takes its name from the Dutch province of Gelderland, reflecting the town’s early European roots.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Guilderland%2C_New_York",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "In 1795 Jan and Leonard de Neufville opened the Hamilton Glass Works, the town’s first major industry.",
      "sourceSentenceIds": [
        6,
        7,
        12
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Guilderland%2C_New_York",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "French’s Mills, a hamlet near Guilderland Center, once powered textile mills with water from the Normans Kill falls.",
      "sourceSentenceIds": [
        3,
        13
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 2"
      ],
      "source": "https://en.wikipedia.org/wiki/Guilderland%2C_New_York",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Peter Broeck had already established a clothing factory in 1795, showing early textile activity in the area.",
      "sourceSentenceIds": [
        11
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.townofguilderland.gov/247/History-of-Our-Town",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The Great Western Turnpike and later railroads cut through Guilderland in the 1800s, spurring hamlet growth with post offices and schools.",
      "sourceSentenceIds": [
        16,
        22
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.townofguilderland.gov/247/History-of-Our-Town",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The Frederick House in Guilderland Center, preserved by the Historical Society, opens to the public for tours of early 19th‑century life.",
      "sourceSentenceIds": [
        18
