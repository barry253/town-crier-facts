  "facts": [
    {
      "id": 1,
      "text": "Solomons was originally called Bourne's Island, renamed after Baltimore businessman Isaac Solomon who opened a cannery post‑Civil War.",
      "sourceSentenceIds": [
        1,
        3
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Solomons%2C_Maryland"
    },
    {
      "id": 2,
      "text": "The town grew in the 19th century as a hub for oyster harvesting, boat building, and the seafood trade.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Solomons%2C_Maryland"
    },
    {
      "id": 3,
      "text": "Peter's Chapel, a 1889 Carpenter Gothic church, remains active and is a historic landmark.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Solomons%2C_Maryland"
    },
    {
      "id": 4,
      "text": "A bronze fountain outside the Arts Building depicts a Chesapeake Bay waterman with oyster‑harvesting tongs, honoring local maritime heritage.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Solomons%2C_Maryland"
    },
    {
      "id": 5,
      "text": "During World War II, Solomons hosted the Naval Amphibious Training Base, where over 60,000 troops trained for D‑Day and other Pacific battles.",
      "sourceSentenceIds": [
        24,
        28
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Solomons%2C_Maryland"
    },
    {
      "id": 6,
      "text": "The Annmarie Sculpture Garden hosts artisan markets and live concerts, showcasing the Chesapeake Bay spirit in Solomons.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Web source 2"
      ],
