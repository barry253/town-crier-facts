  "facts": [
    {
      "id": 1,
      "text": "Eckhart Mines was founded as a company town for the nearby Eckhart Mines.",
      "sourceSentenceIds": [
        15
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Eckhart_Mines%2C_Maryland",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town’s name honors George Eckhart, whose family lost their land when the coal company took over because they lacked a deed.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://coalcampusa.com/westmd/george/eckhart-mines-md-coal-camp/eckhart-mines-md-coal-camp.htm",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The Maryland Mining Company opened the Eckhart Mine in 1835, making it the first commercial coal company in the United States.",
      "sourceSentenceIds": [
        29,
        23
      ],
      "sourceLabels": [
        "Web source 1",
        "Wikipedia"
      ],
      "source": "https://coalcampusa.com/westmd/george/eckhart-mines-md-coal-camp/eckhart-mines-md-coal-camp.htm",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "In 1846 a railroad connected the mine to markets, later absorbed into the Eckhart Branch Railroad, a historic line in Maryland.",
      "sourceSentenceIds": [
        8,
        3
      ],
      "sourceLabels": [
        "Web source 1",
        "Web source 2"
      ],
      "source": "https://coalcampusa.com/westmd/george/eckhart-mines-md-coal-camp/eckhart-mines-md-coal-camp.htm",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The town sits at the southwestern base of Federal Hill, just 1.8 miles east of Frostburg and 0.8 miles northwest of Clarysville.",
      "sourceSentenceIds": [
        17
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Eckhart_Mines%2C_Maryland",
      "category": "other",
      "quality": "poor",
      "qualityReason": "location_description"
    },
    {
      "id": 6,
      "text": "The outcrop of the Pittsburgh coal seam here is locally called \"the big vein\" or the \"14 foot coal,\" a prized bituminous deposit.",
      "sourceSentenceIds": [
        19
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Eckhart_Mines%2C_Maryland",
