  "facts": [
    {
      "id": 1,
      "text": "Thackerville is named after Zacariah Thacker, a pioneer from Arkansas who founded the community in the mid-nineteenth century.",
      "sourceSentenceIds": [
        6,
        7
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 2"
      ],
      "source": "https://en.wikipedia.org/wiki/Thackerville%2C_Oklahoma"
    },
    {
      "id": 2,
      "text": "Thackerville historically served as an agriculture-based community where local farmers grew watermelons and peanuts.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.okhistory.org/publications/enc/entry?entry=TH001"
    },
    {
      "id": 3,
      "text": "The community relocated to its present location after 1887 to be closer to the Gulf, Colorado and Santa Fe Railway.",
      "sourceSentenceIds": [
        24,
        25
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Thackerville%2C_Oklahoma"
    },
    {
      "id": 4,
      "text": "Thackerville once featured a dirt main street with board walks that connected the porches of local stores.",
      "sourceSentenceIds": [
        28
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Thackerville%2C_Oklahoma"
    },
    {
      "id": 5,
      "text": "Judge Hosea Townsend officially incorporated Thackerville into Indian Territory on July 5, 1899.",
