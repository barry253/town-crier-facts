  "facts": [
    {
      "id": 1,
      "text": "Huntingdon Valley began when John Boutcher gifted land to his son, forming the village that now sits along Huntingdon Pike.",
      "sourceSentenceIds": [
        14
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Huntingdon_Valley%2C_Pennsylvania"
    },
    {
      "id": 2,
      "text": "In the 19th century, the village featured two hotels, two stores, a hall, a mill, a church, post office, coal and lumber yard, railroad station, and forty houses.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://hvlibrary.org/about-hvl/history/"
    },
    {
      "id": 3,
      "text": "The Huntingdon Valley Library, founded in 1871, has served the community for over a century.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://hvlibrary.org/about-hvl/history/"
    },
    {
      "id": 4,
      "text": "The local Historical Society displays artifacts in a dedicated case inside the library.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://hvlibrary.org/about-hvl/history/"
    },
    {
      "id": 5,
      "text": "Founded in 1936, the Old York Road Historical Society preserves the folklore of communities along Old York Road.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://huntingdonhistory.org/"
    },
    {
      "id": 6,
      "text": "The Lady Washington Inn earned a spot on the National Register of Historic Places in 1982.",
      "sourceSentenceIds": [
        17
      ],
