  "facts": [
    {
      "id": 1,
      "text": "Peachland was officially incorporated on March 31, 1895, after the North Carolina General Assembly passed an act to establish the town.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.townofpeachland.org/history.html"
    },
    {
      "id": 2,
      "text": "The town’s name honors Pad Gray’s peach orchard, a local landmark that inspired the name chosen in 1888.",
      "sourceSentenceIds": [
        2,
        21
      ],
      "sourceLabels": [
        "Web source 2",
        "Web source 1"
      ],
      "source": "https://centralina.org/blog/new-member-spotlight-town-of-peachland/"
    },
    {
      "id": 3,
      "text": "Before becoming Peachland, the community was originally called Mulcahy.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.townofpeachland.org/history.html"
    },
    {
      "id": 4,
      "text": "Lawyers Spring Primitive Baptist Church stands where travelers once camped near a spring on the historic Lawyers Road.",
      "sourceSentenceIds": [
        20,
        7
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.townofpeachland.org/history.html"
    },
    {
      "id": 5,
      "text": "The Barrett‑Faulkner House was listed on the National Register of Historic Places in 2012, preserving Peachland’s architectural heritage.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Peachland%2C_North_Carolina"
    },
    {
      "id": 6,
      "text": "A one‑room schoolhouse served the community in the Lawyers Spring area before Peachland’s formal incorporation.",
