  "facts": [
    {
      "id": 1,
      "text": "Sabael got its name from Sabael Benedict, an 18‑year‑old Abenaki hunter who trekked from Quebec to Indian Lake in 1765.",
      "sourceSentenceIds": [
        3,
        4,
        5,
        7
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 2"
      ],
      "source": "https://en.wikipedia.org/wiki/Sabael%2C_New_York",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The hamlet sits on Indian Lake’s western shore beside New York State Route 30, about 16.2 miles north of Speculator.",
      "sourceSentenceIds": [
        9,
        29
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 2"
      ],
      "source": "https://en.wikipedia.org/wiki/Sabael%2C_New_York",
      "category": "other",
      "quality": "poor",
      "qualityReason": "location_description"
    },
    {
      "id": 3,
      "text": "White settlers arrived in the early 1800s, building dams on the Indian River in 1846 and enlarging them in 1861 to drive logs to the Hudson.",
      "sourceSentenceIds": [
        22
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/sabael_new_york",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "After 1897 state acquisition preserved the land, logging ended by 1950 and the area pivoted to tourism, boating on Indian Lake and hiking in the Jessup River Wild Forest.",
      "sourceSentenceIds": [
        24
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/sabael_new_york",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "As an unincorporated hamlet, Sabael has no municipal government and falls under the jurisdiction of the town of Indian Lake within the Adirondack Park.",
      "sourceSentenceIds": [
        25,
        26
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/sabael_new_york",
