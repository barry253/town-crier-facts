  "facts": [
    {
      "id": 1,
      "text": "Butlerville was named after its founder, Abram B., who helped establish the community in the early 1800s.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Butlerville%2C_Ohio"
    },
    {
      "id": 2,
      "text": "The village was officially platted in 1838 when a new turnpike reached the area, sparking early growth.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Butlerville%2C_Ohio"
    },
    {
      "id": 3,
      "text": "In 1851, Butlerville became an incorporated village, giving it formal municipal status within Warren County.",
      "sourceSentenceIds": [
        11
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Butlerville%2C_Ohio"
    },
    {
      "id": 4,
      "text": "A post office operated in Butlerville from 1833 until 1905, serving residents before mail was routed through Pleasant Plain.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Butlerville%2C_Ohio"
    },
    {
      "id": 5,
      "text": "Telephone service for the town comes through the Butlerville exchange, while mail is delivered via the Pleasant Plain post office.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Butlerville%2C_Ohio"
    },
    {
      "id": 6,
      "text": "Butlerville sits in central Harlan Township, in the southwestern part of Warren County, Ohio.",
