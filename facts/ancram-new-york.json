    {
      "id": 1,
      "text": "Ancram was founded in 1803, originally part of the town of Gallatin.",
      "sourceSentenceIds": [
        1,
        20
      ],
      "sourceLabels": [
        "Web source 1",
        "Wikipedia"
      ],
      "source": "https://www.ancramny.org/"
    },
    {
      "id": 2,
      "text": "The town’s name comes from Ancrum, Scotland, reflecting the Livingston family’s Scottish roots.",
      "sourceSentenceIds": [
        3,
        21
      ],
      "sourceLabels": [
        "Wikipedia",
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Ancram%2C_New_York"
    },
    {
      "id": 3,
      "text": "During the Revolution, Ancram’s iron forge produced the massive chain that later spanned the Hudson River at West Point.",
      "sourceSentenceIds": [
        2,
        16
      ],
      "sourceLabels": [
        "Wikipedia",
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Ancram%2C_New_York"
    },
    {
      "id": 4,
      "text": "The Roeliff Jansen Kill, which drains most of Ancram, flows west to the Hudson River.",
      "sourceSentenceIds": [
        25,
        26
      ],
      "sourceLabels": [
        "Wikipedia",
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Ancram%2C_New_York"
    },
    {
      "id": 5,
      "text": "Ancram once housed the only iron works in the New York Colony, founded by Philip Livingston in 1743.",
      "sourceSentenceIds": [
        4,
        5
      ],
      "sourceLabels": [
        "Web source 1",
        "Wikipedia"
      ],
      "source": "https://www.ancramny.org/"
    },
    {
      "id": 6,
      "text": "The hamlet of Boston Corner, now part of Ancram, was annexed from Massachusetts in 1857 after a state agreement.",
