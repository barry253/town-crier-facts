      "quality": "good"
    },
    {
      "id": 4,
      "text": "Italian families built Our Lady of Sorrows Roman Catholic Church, anchoring the Italian‑American community centered at the 108th‑Street and Corona Avenue intersection.",
      "sourceSentenceIds": [
        20,
        15
      ],
      "sourceLabels": [
