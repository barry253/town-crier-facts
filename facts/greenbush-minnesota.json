  "facts": [
    {
      "id": 1,
      "text": "Greenbush’s name comes from the Ojibwe term “Sha Ach Wah,” meaning spruce tree or green bush.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://greenbushmn.govoffice2.com/?SEC=65394E9F-8015-413E-8EC6-0E96E8A0BE2C",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "When the Great Northern Railroad arrived in 1904, merchants rolled their buildings to a new town called West Greenbush.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/greenbush_minnesota",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The original settlement sat on a ridge that once marked the shore of ancient Lake Agassiz.",
      "sourceSentenceIds": [
        19
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Greenbush%2C_Minnesota",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Polish, Bohemian, and Scandinavian settlers began arriving in the late 1880s, drawn by the Homestead Act’s 160‑acre offer.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
