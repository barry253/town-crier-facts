  "facts": [
    {
      "id": 1,
      "text": "The Rocks earned its name because the first churches in Australia—St Patrick’s, St Philip’s and Scots Church—were built there.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/The_Rocks%2C_New_South_Wales"
    },
    {
      "id": 2,
      "text": "Stone‑paved lanes and impeccably conserved heritage buildings in The Rocks hide thousands of years of history anyone can discover.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.therocks.com/our-story"
    },
    {
      "id": 3,
      "text": "The Rocks Museum houses three historic stores: Samson’s Cottage (1844), Raphael’s Store (1853) and Mackellar’s Store (1854).",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.nsw.gov.au/visiting-and-exploring-nsw/walks-near-me/hidden-gems/rocks"
    },
    {
      "id": 4,
      "text": "From its earliest days, The Rocks was known as a slum, frequented by convicts, sailors and prostitutes.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/The_Rocks%2C_New_South_Wales"
    },
    {
      "id": 5,
      "text": "A historic walk in The Rocks takes you past Cadmans Cottage, Sydney Observatory and the first fortified position, Dawes Point Battery.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/The_Rocks%2C_New_South_Wales"
    },
    {
      "id": 6,
      "text": "The Rocks sits just north‑west of the Sydney CBD, offering views of the Harbour Bridge and easy access to Circular Quay.",
      "sourceSentenceIds": [
        28
      ],
