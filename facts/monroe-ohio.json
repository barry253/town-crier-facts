  "facts": [
    {
      "id": 1,
      "text": "Monroe was laid out in 1817 along the Dayton‑Cincinnati Pike, a key route for early settlers.",
      "sourceSentenceIds": [
        20
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Monroe%2C_Ohio"
    },
    {
      "id": 2,
      "text": "The city’s name honors President James Monroe, the fifth president of the United States.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Monroe%2C_Ohio"
    },
    {
      "id": 3,
      "text": "The Monroe Historical Society, housed in a 1910 general store, preserves artifacts and stories from the town’s past.",
      "sourceSentenceIds": [
        5,
        9,
        11
      ],
      "sourceLabels": [
        "Web source 2",
        "Web source 1"
      ],
      "source": "https://www.travelbutlercounty.com/explore/monroe/history"
    },
    {
      "id": 4,
      "text": "Visitors can step back in time at the Monroe Pioneer Log Cabin, a living museum of early frontier life.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.travelbutlercounty.com/explore/monroe/history"
    },
    {
      "id": 5,
      "text": "Monroe’s historic 1910 museum has shifted roles—from a general store to a soda fountain, dress shop, and community hub over the last century.",
      "sourceSentenceIds": [
        15
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.travelbutlercounty.com/explore/monroe/history"
    },
    {
      "id": 6,
      "text": "The town’s Main Street still hosts a police station and a fire station, reflecting its long‑standing civic infrastructure.",
      "sourceSentenceIds": [
        17
      ],
      "sourceLabels": [
