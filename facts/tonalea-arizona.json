      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Tonalea Chapter was first certified as a Navajo Nation Chapter on February 14, 1956, marking its formal community governance.",
      "sourceSentenceIds": [
        18
      ],
      "sourceLabels": [
        "Web source 1"
      ],
