  "facts": [
    {
      "id": 1,
      "text": "Chama was founded in 1860 by pioneers from Chamita, New Mexico, who settled at an elevation of 8,179 feet in the Upper Huerfano Valley.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.uncovercolorado.com/towns/chama/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town’s name changed from Crestones to Chama to honor the settlers’ New Mexico hometown, preserving their Hispanic heritage.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/chama_huerfano_county_colorado",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Early Chama residents built adobe homes that echo the architectural style of Santa Fe, NM, giving the hamlet a distinctive Southwestern feel.",
      "sourceSentenceIds": [
        17
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.uncovercolorado.com/towns/chama/",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "In the 1870s, ranchers introduced Hereford cattle and mules, forming the Querno Verde Live Stock Association that helped shape local ranching practices.",
      "sourceSentenceIds": [
        26
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/chama_huerfano_county_colorado",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "A 1876 burro‑powered flour mill processed local wheat, corn, and potatoes, illustrating early self‑sufficiency in Chama’s agrarian economy.",
      "sourceSentenceIds": [
        27
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/chama_huerfano_county_colorado",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The 1902 flood from a breached Goose Lake reservoir devastated Pass Creek mining sites, highlighting Chama’s vulnerability to natural disasters in rugged terrain.",
      "sourceSentenceIds": [
        29
      ],
      "sourceLabels": [
        "Web source 2"
      ],
