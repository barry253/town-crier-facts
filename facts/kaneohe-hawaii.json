  "facts": [
    {
      "id": 1,
      "text": "Kaneohe’s name means “bamboo man,” a story that ties the town’s identity to ancient Hawaiian lore.",
      "sourceSentenceIds": [
        3,
        15
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
