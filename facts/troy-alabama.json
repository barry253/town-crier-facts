  "facts": [
    {
      "id": 1,
      "text": "Troy sprang to life in 1838 when John Hanchey and John Coskrey moved the county seat from Monticello to their Deer Stand Hill property, renaming it Troy.",
      "sourceSentenceIds": [
        7,
        2
      ],
      "sourceLabels": [
        "Web source 2",
        "Wikipedia"
      ],
      "source": "https://encyclopediaofalabama.org/article/troy/"
    },
    {
      "id": 2,
      "text": "The town’s name may honor Alexander Troy, a former North Carolina attorney general.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://encyclopediaofalabama.org/article/troy/"
    },
    {
      "id": 3,
      "text": "Troy University began in 1887 as a state teacher’s college and has grown into a prominent public university.",
      "sourceSentenceIds": [
        9,
        17
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://encyclopediaofalabama.org/article/troy/"
    },
    {
      "id": 4,
      "text": "Three Notch Road, once a Creek hunting trail, became an official road in 1824 and later a trade route to Pensacola.",
      "sourceSentenceIds": [
        16
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://encyclopediaofalabama.org/article/troy/"
    },
    {
      "id": 5,
      "text": "Each May, Troy hosts the Alabama Law Enforcement Torch Run, timed to coincide with the Alabama Special Olympics State Games.",
      "sourceSentenceIds": [
        3
