  "facts": [
    {
      "id": 1,
      "text": "Sierra Ridge sits beside dinosaur tracks that date back 150 million years, a relic from the age of the first dinosaurs.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.fs.usda.gov/r02/psicc/recreation",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The lake near Sierra Ridge was carved into a glacial cirque between Mount Bierstadt and the Alpine Tunnel Trail, a remnant of ancient glaciers.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.fs.usda.gov/r02/psicc/recreation",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Mountains around Sierra Ridge form the crest of the Continental Divide, the high ridge that separates waters flowing to the Atlantic and Pacific.",
      "sourceSentenceIds": [
        20
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.fs.usda.gov/r02/psicc/recreation",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Colorado’s famous fourteen‑footers, including peaks near Sierra Ridge, attract climbers seeking the challenge of summits over 14,000 feet.",
      "sourceSentenceIds": [
        15
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.fs.usda.gov/r02/psicc/recreation",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The Pike‑San Isabel National Forests cover about 3 million acres, offering Sierra Ridge residents endless hiking, fishing, and camping options.",
      "sourceSentenceIds": [
        17
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.fs.usda.gov/r02/psicc/recreation",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Sierra Ridge is officially part of the Denver–Aurora–Lakewood Metropolitan Statistical Area, linking it to the region’s largest urban core.",
