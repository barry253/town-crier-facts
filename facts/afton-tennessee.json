  "facts": [
    {
      "id": 1,
      "text": "Afton’s name echoes Robert Burns’s 1791 poem “Sweet Afton,” tying the community to a Scottish river that inspired the lyric.",
      "sourceSentenceIds": [
        15,
        8
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 2"
      ],
      "source": "https://en.wikipedia.org/wiki/Afton%2C_Tennessee",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "In 1858, Joseph Henderson sold land for a railroad right‑of‑way, prompting the construction of a depot that helped birth the village of Afton.",
      "sourceSentenceIds": [
        11
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/afton_tennessee",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The historic Brown‑Neas House, built around 1868, stands as a National Register example of local 19th‑century architecture in Afton.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/afton_tennessee",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Afton sits just five miles east of Greeneville, the county seat founded the same year, making it a close neighbor in early regional trade.",
      "sourceSentenceIds": [
        4
