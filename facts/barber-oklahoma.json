    },
    {
      "id": 2,
      "text": "The community of Barber emerged as a rural agricultural center centered on the rich soils of the Illinois River valley.",
      "sourceSentenceIds": [
        14
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/barber_oklahoma"
    },
    {
      "id": 3,
      "text": "The Barber post office operated from 1909 until 1954, serving as a vital social and communication link for the early community.",
      "sourceSentenceIds": [
        15
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/barber_oklahoma"
    },
    {
      "id": 4,
      "text": "Barber is located in a humid subtropical climate with hot summers and mild winters typical of eastern Oklahoma.",
      "sourceSentenceIds": [
