      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The Burra Burra Mine, discovered in 1843, became the heart of the Great Copper Basin and now hosts the Ducktown Basin Museum.",
      "sourceSentenceIds": [
        7,
