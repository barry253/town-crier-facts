  "facts": [
    {
      "id": 1,
      "text": "Marchmont was named after the 5th Earl of Marchmont, Hugh Hume Campbell, whose title comes from the hill of Roxburgh Castle.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Marchmont",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The area was planned as a middle‑class suburb by Sir George Warrender in the 1860s, with architect David Bryce’s 1869 feuing plan calling for terraced villas.",
      "sourceSentenceIds": [
        27,
        28
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Marchmont",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Marchmont’s streets honor family ties: Thirlestane and Lauderdale reference Warrender’s mother, while Spottiswoode nods to John Spottiswoode and Arden to the Earl of Haddington.",
      "sourceSentenceIds": [
        3,
        4,
        13
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Marchmont",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Victorian tenements dominate Marchmont, mostly four‑to‑five‑storey blocks built in Scots Baronial style with crow‑stepped gables and ornate cornicing.",
      "sourceSentenceIds": [
        8,
        24
      ],
      "sourceLabels": [
        "Web source 1",
        "Wikipedia"
      ],
      "source": "https://edinburghdaily.co.uk/area-guide/discover-marchmont-edinburgh-victorian-gem-meadows-haven/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Originally alcohol‑free to maintain respectability, Marchmont earned conservation area status in 1987, later expanded to include The Meadows and Bruntsfield Links.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://edinburghdaily.co.uk/area-guide/discover-marchmont-edinburgh-victorian-gem-meadows-haven/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Ronnie Corbett, the beloved comedian, once lived in Marchmont, adding a touch of celebrity to the neighborhood.",
