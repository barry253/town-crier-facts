  "facts": [
    {
      "id": 1,
      "text": "Sultan sprang up in 1880 when a gold vein on the Sultan River drew settlers to the Skykomish confluence.",
      "sourceSentenceIds": [
        1,
        9
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Sultan%2C_Washington",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town’s name comes from Chief T’seul‑ted of the Skykomish, whose name was anglicized to “Sultan” by early settlers.",
      "sourceSentenceIds": [
        3,
        5,
        6
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Sultan%2C_Washington",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "During 1891–92, Sultan hosted a Great Northern Railway supply depot that employed up to 800 workers at its peak.",
      "sourceSentenceIds": [
        4,
        7,
        14
      ],
      "sourceLabels": [
        "Web source 1",
        "Wikipedia"
      ],
      "source": "https://www.sultanwa.gov/223/History",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Sultan sits where the Skykomish, Sultan, and Wallace rivers meet, about 23 miles east of Everett.",
