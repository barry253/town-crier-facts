    },
    {
      "id": 2,
      "text": "The town’s first township meeting took place at Captain David Scott’s house on April 8, 1836.",
      "sourceSentenceIds": [
        18,
        20
      ],
      "sourceLabels": [
        "Wikipedia",
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/DeWitt%2C_Michigan"
    },
    {
      "id": 3,
      "text": "In 1843, the Detroit‑Pontiac Railroad opened a line that ran through DeWitt, linking it to the regional rail network.",
      "sourceSentenceIds": [
        13
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://totallocal.com/dewitt/history/"
    },
    {
      "id": 4,
      "text": "DeWitt’s historic Looking Glass Brewery, listed on the Michigan Historic Sites register in 1985, still operates today.",
      "sourceSentenceIds": [
        14
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://totallocal.com/dewitt/history/"
    },
    {
      "id": 5,
      "text": "On September 13, 2011, DeWitt unveiled Michigan’s first electric‑vehicle charging station at 110 South Bridge Street.",
