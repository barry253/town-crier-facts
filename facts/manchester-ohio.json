      "id": 1,
      "text": "Manchester was founded in 1790 as Massie's Station by explorer Nathaniel Massie, who surveyed the Virginia Military District.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Manchester%2C_Ohio",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "In 1791 the settlement was renamed Manchester after Massie's ancestral home in England.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Manchester%2C_Ohio",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The village sits on the Ohio River, its riverfront shaping the town’s history and economy.",
      "sourceSentenceIds": [
        15,
        6
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Manchester%2C_Ohio",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Manchester was the fourth permanent settlement in the Northwest Territory, showing its early frontier importance.",
      "sourceSentenceIds": [
        17
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Manchester%2C_Ohio",
      "category": "history",
      "quality": "good"
    },
    {
