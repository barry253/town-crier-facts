      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Every five years since 1930, Taft hosts Oildorado, a week‑long festival celebrating its oil‑pioneering past with parades and reenactments.",
      "sourceSentenceIds": [
        17,
        22
      ],
      "sourceLabels": [
