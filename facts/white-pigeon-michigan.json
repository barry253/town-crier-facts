      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "White Pigeon became Michigan’s oldest incorporated village when it was chartered in 1837.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.usacitiesonline.com/micountywhitepigeon.htm",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The Michigan Southern Railroad’s main yard complex sits in White Pigeon, a key rail hub.",
      "sourceSentenceIds": [
