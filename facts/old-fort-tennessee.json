  "facts": [
    {
      "id": 1,
      "text": "Old Stone Fort sits on a peninsula where the Duck River meets the Little Duck River, forming a natural defensive shape.",
      "sourceSentenceIds": [
        1,
        23
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Old_Stone_Fort_(Tennessee)"
    },
    {
      "id": 2,
      "text": "The fort’s walls are a prehistoric earthwork built between 80 and 550 AD, likely for ceremony rather than defense.",
      "sourceSentenceIds": [
        21
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Old_Stone_Fort_(Tennessee)"
    },
    {
      "id": 3,
      "text": "In 1836 the first Coffee County court met at the Old Stone Fort Tavern, marking the site’s early civic role.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Old_Stone_Fort_(Tennessee)"
    },
    {
      "id": 4,
      "text": "Samuel Murray’s 1823 rope factory on the Little Duck River shows the peninsula’s early industrial use of water power.",
      "sourceSentenceIds": [
        3,
        28
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Old_Stone_Fort_(Tennessee)"
    },
    {
      "id": 5,
      "text": "The park now covers 876 acres, including the 50‑acre enclosure, and is managed by Tennessee’s Department of Environment and Conservation.",
      "sourceSentenceIds": [
        24,
        30
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Old_Stone_Fort_(Tennessee)"
    },
    {
      "id": 6,
      "text": "A 1876 Smithsonian survey uncovered artifacts that helped confirm the fort’s Middle Woodland origins.",
      "sourceSentenceIds": [
        13
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Old_Stone_Fort_(Tennessee)"
