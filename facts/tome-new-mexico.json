  "facts": [
    {
      "id": 1,
      "text": "Tome was founded in 1739 when 29 settlers from Albuquerque petitioned to take over land abandoned after the Pueblo Revolt.",
      "sourceSentenceIds": [
        7,
        8,
        10
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Tome%2C_New_Mexico",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town’s name honors Tomé Domínguez de Mendoza, whose 1659 encomienda granted the fertile Rio Grande bottomlands.",
      "sourceSentenceIds": [
        2,
        4
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 2"
      ],
      "source": "https://en.wikipedia.org/wiki/Tome%2C_New_Mexico",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Tome blends Hispanic and Native American traditions, reflected in its historic plaza, church, and annual festivals.",
      "sourceSentenceIds": [
        5,
        6
      ],
      "sourceLabels": [
        "Web source 1",
        "Web source 2"
      ],
      "source": "https://www.trawellino.com/destinations/united-states/new-mexico_tome",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Tome sits on the Rio Grande valley’s Bosque del Rio Grande, a flat irrigated plain that supports historic farming.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/tome_new_mexico",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "During the 1800s, Tome was a key waypoint on the Camino Real, yet it suffered flooding and Native attacks.",
      "sourceSentenceIds": [
        18
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Tome%2C_New_Mexico",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Today, Tome hosts the University of New Mexico’s Valencia Campus, a hub for regional higher education.",
      "sourceSentenceIds": [
