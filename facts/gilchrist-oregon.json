  "facts": [
    {
      "id": 1,
      "text": "Gilchrist is the last remaining company town in Oregon, founded in 1938 by the family behind the Gilchrist Timber Company.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.southernoregon.org/cities/gilchrist/"
    },
    {
      "id": 2,
      "text": "The Gilchrist Timber Company moved here from Mississippi in search of lumber and lower taxes, building a dam on the Little Deschutes River.",
      "sourceSentenceIds": [
        3,
        13
      ],
      "sourceLabels": [
        "Web source 2",
        "Wikipedia"
      ],
      "source": "https://www.southernoregon.com/profiles/gilchrist/index.html"
    },
    {
      "id": 3,
      "text": "Built in 1939, the Gilchrist Mall was the first mall opened east of the Cascade Mountains.",
      "sourceSentenceIds": [
        15,
        16
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Gilchrist%2C_Oregon"
    },
    {
      "id": 4,
      "text": "All houses in Gilchrist were once painted in a specific shade called Gilchrist brown, except for a small area called Rainbow Circle.",
      "sourceSentenceIds": [
        21
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Gilchrist%2C_Oregon"
    },
    {
      "id": 5,
      "text": "The Public Works Administration built the Gilchrist School in 1939 to serve the local community.",
      "sourceSentenceIds": [
        14
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Gilchrist%2C_Oregon"
    },
    {
      "id": 6,
      "text": "Gilchrist is surrounded by giant ponderosa pines and numerous protected wilderness areas, rivers, and lakes.",
