  "facts": [
    {
      "id": 1,
      "text": "Las Vegas was founded in 1905 when 110 acres of land next to the Union Pacific Railroad were auctioned, and it was officially incorporated on March 16, 1911.",
      "sourceSentenceIds": [
        1,
        2
      ],
      "sourceLabels": [
