  "facts": [
    {
      "id": 1,
      "text": "Ransom Township takes its name from Captain Samuel Ransom, a local hero who died fighting at the Battle of Wyoming.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Ransom_Township%2C_Pennsylvania"
    },
    {
      "id": 2,
      "text": "The township was founded in 1849, carved out of Exeter and Newton townships while still part of Luzerne County.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Ransom_Township%2C_Pennsylvania"
    },
    {
      "id": 3,
      "text": "When Lackawanna County was created in 1878, Ransom Township joined the new county, leaving Luzerne behind.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Ransom_Township%2C_Pennsylvania"
    },
    {
      "id": 4,
      "text": "Within its borders lies the small village of Milwaukee, a quiet community that shares the township’s rural charm.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Ransom_Township%2C_Pennsylvania"
    },
    {
      "id": 5,
      "text": "Ransom’s landscape features gentle rolling hills and a low population density, giving it a peaceful, countryside feel.",
      "sourceSentenceIds": [
        28
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://lackawannacounty.com/ransom"
    },
    {
      "id": 6,
      "text": "The township’s history is rooted in early American frontier life, with settlers drawn by the promise of open land and opportunity.",
