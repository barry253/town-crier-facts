  "facts": [
    {
      "id": 1,
      "text": "Deering began in 1901 as a supply station for interior gold mining, originally called Yutica, near the historic Malemiut Eskimo village of Inmachukmiut.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Deering%2C_Alaska",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The city sits on a sandy spit where the Inmachuk River empties into Kotzebue Sound, 92 km southwest of Kotzebue.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Deering%2C_Alaska",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Deering’s name probably comes from the schooner Abbie M., which was present in the area at that time.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Deering%2C_Alaska",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "In 1970, Deering was incorporated as a fourth‑class city, establishing its own city council under the Indian Reorganization Act of 1934.",
      "sourceSentenceIds": [
        14
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Deering%2C_Alaska",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The community’s residents are primarily Iñupiat, who maintain a strong subsistence lifestyle centered on hunting and fishing.",
