  "facts": [
    {
      "id": 1,
      "text": "Fredonia, once called Freedona or Hursts Store, hosts the New Hope Rosenwald School, a National Register landmark.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://kids.kiddle.co/Fredonia,_Alabama",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Incorporated September 29, 1853, Fredonia grew into the county’s trade hub, featuring sixteen businesses and the Southern Military Academy.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/fredonia_alabama",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "After the Creek ceded the land in 1832, settlers quickly founded Fredonia, becoming Chambers County’s northeastern pioneer community.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/fredonia_alabama",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The Fredonia Methodist Church, built in 1833, remains a historic landmark with many early settler descendants still living nearby.",
      "sourceSentenceIds": [
        11
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/fredonia_alabama",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Fredonia enjoys a humid subtropical climate, with hot, humid summers peaking around 89°F and mild winters averaging 33°F.",
      "sourceSentenceIds": [
        25,
        27
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/fredonia_alabama",
      "category": "nature",
      "quality": "poor",
      "qualityReason": "vague"
    },
    {
      "id": 6,
      "text": "The town sits on the Southern Piedmont Upland, where rolling hills rise between 700 and 850 feet above sea level.",
      "sourceSentenceIds": [
        22,
