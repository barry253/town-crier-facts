  "facts": [
    {
      "id": 1,
      "text": "Franktown takes its name from prospector James Frank Gardner, who built a cabin in 1859 that later became known as Frankstown.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Franktown%2C_Colorado",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Between 1861 and 1863, Franktown served as the first county seat of Douglas County before the seat moved to Castle Rock.",
      "sourceSentenceIds": [
        13,
        14
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Franktown%2C_Colorado",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The Franktown School Museum houses artifacts from early settlers, including farm tools and mining remnants that tell the town’s pioneer story.",
      "sourceSentenceIds": [
        15
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.uncovercolorado.com/towns/franktown/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The Franktown Cave is a massive rock shelter where prehistoric people left evidence of their early presence.",
      "sourceSentenceIds": [
        16
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.uncovercolorado.com/towns/franktown/",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Historic Frankstown Inc, a non‑profit founded in the 1980s, preserves the town’s heritage by maintaining the museum, cemetery, and other historic sites.",
      "sourceSentenceIds": [
        1,
        18,
        20,
        21
      ],
      "sourceLabels": [
        "Web source 2",
        "Web source 1"
      ],
      "source": "https://museumsdatabase.com/museums/view/4854",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The National Register of Historic Places lists the Franktown 163 site, a landmark that reflects the town’s rich historical legacy.",
