    {
      "id": 1,
      "text": "Sun River takes its name from the river itself, whose original Lakota name Nataeosueti means 'Medicine' or 'Sun'.",
      "sourceSentenceIds": [
        2,
        8
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 2"
      ],
      "source": "https://en.wikipedia.org/wiki/Sun_River%2C_Montana",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "John Largent founded Sun River in 1867, laying out the town, selling lots, and building a toll bridge for Mullan Road traffic.",
      "sourceSentenceIds": [
        13,
        14
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Sun_River%2C_Montana",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The Sun River begins where the South and North Forks meet in Flathead National Forest, flowing east toward the Missouri.",
      "sourceSentenceIds": [
        3,
        4,
        6
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://discoveringmontana.com/rivers/sun/",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The nearby Buffalo Jump Park is a National Historic Landmark and the largest buffalo jump ever built.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://discoveringmontana.com/rivers/sun/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Sun River’s climate is cold semi‑arid, with hot summers, chilly nights, and winter chinook winds that can raise temperatures dramatically.",
      "sourceSentenceIds": [
        24
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Sun_River%2C_Montana",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The Sun River ultimately joins the Missouri River, making it part of the vast Missouri River watershed.",
