  "facts": [
    {
      "id": 1,
      "text": "Upper St. Clair was founded in 1788 and named after General Arthur St. Clair, a Revolutionary War hero.",
      "sourceSentenceIds": [
        5,
        7
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.twpusc.org/community/about_usc.php",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The first European settler in the area was Scotsman John Fife, who arrived in 1762 near what is now Washington and McLaughlin Run.",
      "sourceSentenceIds": [
        2,
        28
      ],
      "sourceLabels": [
        "Web source 1",
        "Wikipedia"
      ],
      "source": "https://www.twpusc.org/community/about_usc.php",
      "category": "people",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The 1830 Log House on McLaughlin Run Road is the township’s most familiar historic landmark, standing beside the municipal building.",
      "sourceSentenceIds": [
        11,
        12
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.twpusc.org/community/about_usc.php",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The Historical Society of Upper St. Clair, founded in 1988, preserves artifacts, family histories, and the township’s rich heritage.",
      "sourceSentenceIds": [
        15,
        16,
        17
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.hsusc.org/",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Upper St. Clair was the site of a notable Whiskey Rebellion incident in 1794, a key moment in early American history.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.twpusc.org/community/about_usc.php",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "About nine percent of Upper St. Clair’s 733 acres are dedicated to parks and fields, offering ample green space for residents.",
