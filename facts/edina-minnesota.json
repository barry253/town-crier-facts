      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The city’s name comes from Andrew Craik, who moved from Edinburgh in 1869, bought a mill, and renamed it the Edina Mill.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
