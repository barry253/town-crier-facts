    {
      "id": 1,
      "text": "Founded in 1763 by Joseph Chapline, the town was named after Governor Horatio Sharpe, a name later formalized when the first post office opened in 1820.",
      "sourceSentenceIds": [
        1,
        2
      ],
      "sourceLabels": [
