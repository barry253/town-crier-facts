  "facts": [
    {
      "id": 1,
      "text": "Avalon was founded in 1882 by businessman Richard Dempsey Yow, who also ran a mercantile with his brothers.",
      "sourceSentenceIds": [
        1,
        2
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/avalon_georgia",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town’s name honors the mythical island of Avalon from Arthurian legend, evoking a haven of healing and eternal youth.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/avalon_georgia",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Avalon grew into a self‑contained rural village, complete with a railway station, post office, school, and church that served its early economy.",
      "sourceSentenceIds": [
        3,
        9
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/avalon_georgia",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The community sits along historic State Route 17, about seven miles southeast of Toccoa, the county seat.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/avalon_georgia",
      "category": "other",
      "quality": "poor",
      "qualityReason": "location_description"
    },
    {
      "id": 5,
      "text": "In 1909, Avalon was officially incorporated, formalizing its status after nearly two decades of growth.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/avalon_georgia",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Richard Dempsey Yow, born in South Carolina in 1844, moved to Franklin County, Georgia, by the late 1860s before founding Avalon.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 2"
      ],
