  "facts": [
    {
      "id": 1,
      "text": "Teaticket’s name comes from the Wampanoag word Tataket, meaning 'at the principal tidal stream.'.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Teaticket%2C_Massachusetts"
    },
    {
      "id": 2,
      "text": "Teaticket sits between East Falmouth and Falmouth in southern Falmouth, offering a quiet coastal community.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Teaticket%2C_Massachusetts"
    },
    {
      "id": 3,
      "text": "South of Route 28, Teaticket occupies a neck bordered by Great Pond to the east and Little Pond to the west, extending to Vineyard Sound.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Teaticket%2C_Massachusetts"
    },
    {
      "id": 4,
      "text": "Massachusetts Route 28 runs east–west through the center of Teaticket, connecting the village to neighboring communities.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Teaticket%2C_Massachusetts"
    },
    {
      "id": 5,
      "text": "The neck of Teaticket is home to the Maravista neighborhood, a local residential area.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Teaticket%2C_Massachusetts"
    },
    {
      "id": 6,
      "text": "Teaticket is located at 41.557934°N, 70.586815°W, placing it in southern Falmouth on the Cape Cod peninsula.",
