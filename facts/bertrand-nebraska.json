      "quality": "good"
    },
    {
      "id": 2,
      "text": "The village of Bertrand was formally founded in 1883 by the Lincoln Land Company, selecting a site fourteen miles northwest of Holdrege.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 2"
      ],
