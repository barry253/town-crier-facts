  "facts": [
    {
      "id": 1,
      "text": "Toeterville was platted in 1898 by Henry and Mina Toeter, who named the town after themselves and built its first general store.",
      "sourceSentenceIds": [
        1,
        8,
        25
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Toeterville%2C_Iowa",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The Dubuque and Stacyville Railroad reached the site on January 21, 1898, sparking the town’s growth.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://iagenweb.org/mitchell/localdat/toetervi.htm",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Fred Stoyke opened the first post office in the village’s general merchandise store, making it the town’s communication hub.",
      "sourceSentenceIds": [
        26,
        27
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://iagenweb.org/mitchell/localdat/toetervi.htm",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "A wagon factory built by the town’s founders added to Toeterville’s early industrial mix, though it later burned down.",
      "sourceSentenceIds": [
        4,
        5
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://iagenweb.org/mitchell/localdat/toetervi.htm",
      "category": "other",
      "quality": "poor",
      "qualityReason": "other"
    },
    {
      "id": 5,
      "text": "Henry Toeter also constructed an elevator in the town, reflecting early agricultural infrastructure.",
