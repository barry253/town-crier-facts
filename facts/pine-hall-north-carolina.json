    },
    {
      "id": 3,
      "text": "On March 20, 1998, an EF‑1 tornado briefly touched down north of Route 311 near Morning Star Baptist Church in Pine Hall.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Pine_Hall%2C_North_Carolina"
    },
    {
      "id": 4,
      "text": "That tornado traveled 1.5 miles before lifting near the Stokes‑Rockingham County line, later becoming the Stoneville tornado of the 1998 outbreak.",
      "sourceSentenceIds": [
        11,
        12
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Pine_Hall%2C_North_Carolina"
    },
    {
      "id": 5,
      "text": "The tornado’s path was part of the larger 1998 Gainesville‑Stoneville tornado outbreak that affected much of the Carolinas.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Pine_Hall%2C_North_Carolina"
    },
    {
