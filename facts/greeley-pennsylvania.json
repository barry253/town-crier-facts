  "facts": [
    {
      "id": 1,
      "text": "Greeley was named for Horace Greeley, the founder of The New York Tribune, whose influence peaked in the mid‑1800s.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Greeley%2C_Pennsylvania",
      "category": "people",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town hosts some of America’s oldest camps, including Pine Forest Camp, one of the first summer camps in the United States.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.islands.com/1951810/greeley-pennsylvania-americas-oldest-camp-town-kayaking-fishing-waterfall-trails/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Greeley is a heavily wooded, rural area with no central town square, a typical feature of Pike County’s backcountry.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Greeley%2C_Pennsylvania",
      "category": "other",
      "quality": "poor",
      "qualityReason": "vague"
    },
    {
      "id": 4,
      "text": "A 19th‑century sawmill built by the Sylvania Association still leaves a towering stone wall beside a stream that flows through the township.",
      "sourceSentenceIds": [
        22,
        23
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Greeley%2C_Pennsylvania",
      "category": "landmark",
      "quality": "good"
    },
    {
