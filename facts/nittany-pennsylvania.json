  "facts": [
    {
      "id": 1,
      "text": "Mount Nittany first appeared on William Scull’s 1770 colonial Pennsylvania map, marking the ridge that would later define Centre County.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://centrehistory.org/article/mount-nittany/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The name 'Mount Nittany' derives from an Algonquian word meaning 'single mountain,' reflecting its solitary peak.",
      "sourceSentenceIds": [
        24
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Nittany_Lion",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "In 1907, Penn State student Joe Mason invented the Nittany Lion mascot after a Princeton visit, proclaiming it would defeat the Bengal tiger.",
      "sourceSentenceIds": [
        17,
        18,
        21
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Nittany_Lion",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "After a mascot‑making company closed in 1990, Elisabeth DeAngelo‑Tucker and her husband John took over production of the Nittany Lion costume.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Nittany_Lion",
      "category": "people",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Mount Nittany is Centre County’s most famous geographical feature, celebrated in local folklore, cultural history, and scenic tours.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://centrehistory.org/article/mount-nittany/",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Nancy Barrett became the first and only woman to try out for the Nittany Lion mascot in 1996, performing a traditional one‑arm push‑up routine.",
