  "facts": [
    {
      "id": 1,
      "text": "Kaskaskia was founded in 1703 as a Jesuit mission alongside the Kaskaskia tribe of the Illiniwek Confederacy.",
      "sourceSentenceIds": [
        6,
        7
      ],
      "sourceLabels": [
        "Web source 1",
