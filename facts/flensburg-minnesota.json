  "facts": [
    {
      "id": 1,
      "text": "Flensburg was officially platted in March 1890 by settlers Olaf and Dagmar Searle, laying out the village grid in Culdrum Township.",
      "sourceSentenceIds": [
        21
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Flensburg%2C_Minnesota",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Flensburg takes its name from the German seaport in Schleswig‑Holstein, echoing the early European immigrant roots of the area.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/flensburg_minnesota",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The Little Falls and Dakota Railroad, finished in 1882, sparked Flensburg’s early growth by adding a sidetrack to a nearby mill.",
      "sourceSentenceIds": [
        2,
        7
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/flensburg_minnesota",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "On April 1, 1893, Flynn Station officially became Flensburg, a change announced by the local press.",
