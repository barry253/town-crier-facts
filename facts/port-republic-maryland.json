  "facts": [
    {
      "id": 1,
      "text": "Port Republic sits at the crossroads of MD routes 2/4, 264, 509, 765, and Parkers Creek Road, making it a historic junction in Calvert County.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Port_Republic%2C_Maryland",
      "category": "other",
      "quality": "poor",
      "qualityReason": "location_description"
    },
    {
      "id": 2,
      "text": "The town’s River Room museum showcases how Port Republic grew into a bustling colonial river port before the Civil War.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.portrepublicmuseum.org/museum-exhibit",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "After the war, the Keeping Room interprets how floods, war, and railroads reshaped Port Republic from industry to a quiet residential community.",
      "sourceSentenceIds": [
        4,
        5
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.portrepublicmuseum.org/museum-exhibit",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The Port Republic Heritage Society works to protect and display the town’s historical documents and artifacts for future generations.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://portheritage.org/",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "In 2005, the former College of Southern Maryland campus in Port Republic was moved to Prince Frederick, marking a significant shift in local education.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Port_Republic%2C_Maryland",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The Discovery Room offers visitors research tools, maps, and a computer database, helping them explore Port Republic’s rich past.",
