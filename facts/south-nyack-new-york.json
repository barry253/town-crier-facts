  "facts": [
    {
      "id": 1,
      "text": "South Nyack was incorporated as a village in 1878 and remained so until 2022, after which it became a hamlet within the Town of Orangetown.",
      "sourceSentenceIds": [
        17,
        22
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/South_Nyack%2C_New_York",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The hamlet sits on the Hudson River and serves as the western terminus of the historic Tappan Zee Bridge.",
      "sourceSentenceIds": [
        23,
        16
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/South_Nyack%2C_New_York",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "South Nyack once boasted Rockland County's first fire company, founded in 1834 at 90 Depot Place.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/South_Nyack%2C_New_York",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The original South Nyack train station, located between Mansfield and Cornelison Avenues on Chase Avenue, was demolished when the I‑287 interchange was built in the 1950s.",
      "sourceSentenceIds": [
        14
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/South_Nyack%2C_New_York",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The Nyack Promise initiative focuses on honoring artists, musicians, and writers while investing in infrastructure, public spaces, and sustainable practices like LED lighting and EV charging stations.",
