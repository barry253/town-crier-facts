      "quality": "good"
    },
    {
      "id": 2,
      "text": "The Toyonaka Plateau, a gently sloping terrace 20‑50 meters high, sits on the western edge and anchors the city’s urban core.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
