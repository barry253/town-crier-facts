  "facts": [
    {
      "id": 1,
      "text": "Peace River was originally named Peace River Crossing and was renamed the Village of Peace River on May 22, 1916.",
      "sourceSentenceIds": [
        1,
        4
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Peace_River%2C_Alberta",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town sits where the Peace River meets the Smoky, Heart, and Pat's Creeks, making it a historic confluence for fur traders.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Peace_River%2C_Alberta",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "A 12‑foot wooden statue in Riverfront Park honors Henry Fuller Davis, a key figure in the town’s early development.",
      "sourceSentenceIds": [
        20
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Peace_River%2C_Alberta",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The Peace River Museum, Archives & Mackenzie Centre holds over 10,000 artifacts, including a fur‑trade gallery that traces settlement history.",
      "sourceSentenceIds": [
        24
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Peace_River%2C_Alberta",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The original Hudson’s Bay Factor’s House, built in 1904, now stands beside the Third Mission Heritage Suites, a reminder of the town’s trading past.",
      "sourceSentenceIds": [
        11
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Peace_River%2C_Alberta",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The town’s railway, the northernmost in Canada, once carried passengers and freight from Edmonton, cementing Peace River’s role as a regional hub.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://peaceriverchamber.com/our-history/",
      "category": "transport",
      "quality": "good"
    }
