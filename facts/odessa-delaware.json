  "facts": [
    {
      "id": 1,
      "text": "Odessa was renamed after the Ukrainian port city of Odessa in the 19th century to keep the town alive as a major port.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Odessa%2C_Delaware"
    },
    {
      "id": 2,
      "text": "Founded as Cantwell's Bridge in the 18th century, the town grew around a toll bridge over Appoquinimink Creek opened in 1721.",
      "sourceSentenceIds": [
        3,
        29
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Odessa%2C_Delaware"
    },
    {
      "id": 3,
      "text": "By the mid‑1800s, Odessa became a stop along the Wilmington and Western Railroad, boosting agricultural trade.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://delaware.wiki/a/Odessa_Delaware"
    },
    {
      "id": 4,
      "text": "The Delaware River has long served as a vital transportation route and water source for Odessa’s agriculture.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://delaware.wiki/a/Odessa_Delaware"
    },
    {
      "id": 5,
      "text": "A significant portion of Odessa is listed on the National Register of Historic Places as a historic district.",
      "sourceSentenceIds": [
        28
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Odessa%2C_Delaware"
    },
    {
      "id": 6,
      "text": "Local groups like the Odessa Historical Society keep 19th‑century buildings and landscapes intact through preservation work.",
