  "facts": [
    {
      "id": 1,
      "text": "Arcadia was founded in 1855 by four men from Dodge County on a hill overlooking the Trempealeau River Valley.",
      "sourceSentenceIds": [
        1,
        2
      ],
      "sourceLabels": [
        "Web source 1",
        "Wikipedia"
      ],
      "source": "https://arcadiawi.hosted.civiclive.com/our_community/city_history"
    },
    {
      "id": 2,
      "text": "The city of Arcadia developed along the river valley after the Green Bay and Western Railroad built a line through the area.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Arcadia%2C_Wisconsin"
    },
    {
      "id": 3,
      "text": "Arcadia is the largest city in Trempealeau County and is currently a Latino-majority community.",
      "sourceSentenceIds": [
        14
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Arcadia%2C_Wisconsin"
    },
    {
      "id": 4,
      "text": "David Massuere began work on a flour mill in 1858, which was completed two years later in Arcadia.",
      "sourceSentenceIds": [
        15
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Arcadia%2C_Wisconsin"
    },
    {
      "id": 5,
      "text": "Ashley Furniture and Golden Plump both operate large factories in Arcadia today.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.trempealeaucountyhistory.org/arcadia"
    },
    {
      "id": 6,
      "text": "The first school in Arcadia was founded in 1857 with Sarah McMasters serving as the first teacher.",
