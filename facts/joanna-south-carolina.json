    },
    {
      "id": 3,
      "text": "Before becoming Joanna, the town was known as Goldville starting in 1872.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Joanna%2C_South_Carolina"
    },
    {
      "id": 4,
      "text": "Joanna was renamed in 1948 after the wife of a local industrialist.",
