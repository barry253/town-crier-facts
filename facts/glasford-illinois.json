  "facts": [
    {
      "id": 1,
      "text": "Glasford takes its name from founder Samuel Alexander Glasford, who bought the land that later hosted the Toledo, Peoria and Western Railway station.",
      "sourceSentenceIds": [
        1,
        6
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Glasford%2C_Illinois"
    },
    {
      "id": 2,
      "text": "The village was laid out on December 9, 1868 and officially incorporated as a municipality in 1889.",
      "sourceSentenceIds": [
        11
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Glasford%2C_Illinois"
    },
    {
      "id": 3,
      "text": "A post office opened as Timber on June 35, 1846 before changing its name to Glasford on January 7, 1869.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Glasford%2C_Illinois"
    },
    {
      "id": 4,
      "text": "Glasford lies near the Glasford crater, an ancient meteorite impact whose bedrock layers were shattered and later buried by glaciers.",
      "sourceSentenceIds": [
        12,
        13,
        15
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Glasford%2C_Illinois"
    },
    {
      "id": 5,
      "text": "The historic Glasford Hotel stands as a reminder of the town’s early hospitality industry and architectural charm.",
      "sourceSentenceIds": [
        4
      ],
