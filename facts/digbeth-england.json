    },
    {
      "id": 2,
      "text": "Digbeth was originally called 'Duck's bath,' a nod to the area's historic water supply.",
      "sourceSentenceIds": [
        13
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Digbeth"
    },
    {
      "id": 3,
      "text": "The original Digbeth Coach Station, built in 1929 by Midland Red, now serves as Birmingham Coach Station.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Digbeth"
    },
    {
      "id": 4,
      "text": "Alfred Bird’s 1902 eggless custard plant on High Street evolved into the Custard Factory, now a creative hub for 400 SMEs.",
      "sourceSentenceIds": [
        11,
        19,
        20,
        21
      ],
      "sourceLabels": [
