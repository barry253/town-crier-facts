  "facts": [
    {
      "id": 1,
      "text": "Snover’s post office opened on May 7, 1895, and the town was named in honor of Congressman Horace Greeley Snover.",
      "sourceSentenceIds": [
        4,
        18
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/snover_michigan",
      "category": "people",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town’s early economy relied on farming, with local farmers shipping crops and livestock via the Detroit, Bay City & Western Railroad.",
      "sourceSentenceIds": [
        13,
        30
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://thumbwind.com/2025/05/06/snover-michigan-history/",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "A 1905 photo shows the Snover Cornet Band performing at a local fair, illustrating how music united the community.",
      "sourceSentenceIds": [
        26,
        27
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://thumbwind.com/2025/05/06/snover-michigan-history/",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Snover sits about 90 miles northeast of Detroit on Michigan’s Thumb peninsula, an area shaped by Great Lakes commerce and 19th‑century settlement.",
      "sourceSentenceIds": [
        14
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/snover_michigan",
      "category": "other",
      "quality": "poor",
      "qualityReason": "location_description"
    },
    {
      "id": 5,
      "text": "The town’s founding settlers cleared dense forests for farming, marking the first European‑American presence in what would become Moore Township.",
