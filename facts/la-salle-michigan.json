  "facts": [
    {
      "id": 1,
      "text": "La Salle Township was first settled in 1831 and had a post office briefly in 1832-33 before reopening in 1834.",
      "sourceSentenceIds": [
        11,
        12,
        13
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/La_Salle_Township%2C_Michigan",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The township’s name may honor General James Winchester, whose militia protected the area during the War of 1812.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/La_Salle_Township%2C_Michigan",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "A 1907 amusement park, Toledo Beach Amusement Park, once drew visitors from Toledo and was served by a trolley line that ran until 1927.",
      "sourceSentenceIds": [
        19,
        21,
        22
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/La_Salle_Township%2C_Michigan",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "La Salle’s eastern edge borders Lake Erie, and the township is drained by Otter Creek, Sulphur Creek, and Muddy Creek, all flowing to the lake.",
      "sourceSentenceIds": [
        26,
        27,
        28,
        29
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/La_Salle_Township%2C_Michigan",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Grand View and North Shores are unincorporated communities along Lake Erie within La Salle, each marked on historic maps.",
      "sourceSentenceIds": [
        9,
        17
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/La_Salle_Township%2C_Michigan",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The township’s main north–south artery is US 24, known locally as Telegraph Road, cutting through its center.",
