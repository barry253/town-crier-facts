  "facts": [
    {
      "id": 1,
      "text": "Lake Mystic’s land was first settled by Muskogean‑speaking Apalachee people, whose territory stretched across northwest Florida.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/lake_mystic_florida",
      "category": "people",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "After Florida’s 1821 acquisition, American settlers flooded the area, attracted by fertile soils and easy river access.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/lake_mystic_florida",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Wetlands around Lake Mystic feed diverse habitats, drawing on the Floridan aquifer that recharges the region’s groundwater.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/lake_mystic_florida",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Lake Mystic carved itself through karst limestone, creating depressions and sinks typical of the Panhandle’s geology.",
      "sourceSentenceIds": [
        11
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/lake_mystic_florida",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Lake Mystic enjoys a humid subtropical climate, with hot, humid summers and mild winters that rarely drop below freezing.",
      "sourceSentenceIds": [
        15
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/lake_mystic_florida",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Hurricane Ivan in 2004 dumped more than five inches of rain over Lake Mystic, sparking localized flooding.",
      "sourceSentenceIds": [
