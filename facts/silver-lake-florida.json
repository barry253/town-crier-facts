  "facts": [
    {
      "id": 1,
      "text": "Silver Lake got its name from Captain Melton Haynes, an 1845 boat captain who ferried travelers between nearby lakes in the 1880s.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/silver_lake_florida",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Silver Lake is an almost circular, natural freshwater lake in Lake County, Florida.",
      "sourceSentenceIds": [
        22
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Silver_Lake_(Silver_Lake%2C_Florida)",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Because it has no major surface inflows or outflows, Silver Lake drains indirectly through minor tributaries into the Harris Chain of Lakes within the Ocklawaha basin.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/silver_lake_silver_lake_florida",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Today, Silver Lake keeps historic residences from the early 20th century, giving the area a suburban feel while supporting Lake County’s recreational and natural landscape.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/silver_lake_florida",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Silver Lake lacks a public boat ramp or swimming beach, so visitors must ask landowners for permission before fishing.",
      "sourceSentenceIds": [
        27
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
