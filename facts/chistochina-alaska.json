  "facts": [
    {
      "id": 1,
      "text": "The Ahtna Athabascan people have inhabited the upper Copper River Basin—including the Chistochina area—for over 5,000 years.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/chistochina_alaska"
    },
    {
      "id": 2,
      "text": "Chistochina first began as an Ahtna fish camp and a stopover for traders and trappers.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Chistochina%2C_Alaska"
    },
    {
      "id": 3,
      "text": "The road that passes through Chistochina later became part of the Valdez‑Eagle Trail built by miners during the 1897 gold rush.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Chistochina%2C_Alaska"
    },
    {
      "id": 4,
      "text": "Chistochina Lodge was constructed as a roadhouse to serve prospectors during the gold rush era.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Chistochina%2C_Alaska"
    },
    {
      "id": 5,
      "text": "Gold was mined along the upper Chistochina River and its runoff creeks, fueling the early 20th‑century economy.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Chistochina%2C_Alaska"
    },
    {
      "id": 6,
      "text": "The community remains a primarily traditional Native village governed by the Native Village of Chistochina, part of the Ahtna Alaska Native Regional Corporation.",
