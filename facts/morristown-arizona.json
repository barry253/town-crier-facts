    {
      "id": 1,
      "text": "Founded in the late 1800s as a stagecoach stop between Phoenix and Wickenburg, Morristown grew along the desert road.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Web source 1"
      ],
