  "facts": [
    {
      "id": 1,
      "text": "Kandiyohi is pronounced KAN-dee-YOH-hy, a pronunciation locals use when chatting about their hometown.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Kandiyohi%2C_Minnesota"
    },
    {
      "id": 2,
      "text": "The city’s name comes from a Sioux word meaning 'where the buffalo fish come from,' reflecting the area's natural heritage.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Kandiyohi%2C_Minnesota"
    },
    {
      "id": 3,
      "text": "Kandiyohi was laid out in 1869 when the railroad extended to that point, marking the start of its growth.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Kandiyohi%2C_Minnesota"
    },
    {
      "id": 4,
      "text": "Residents cherish small‑town values, guided growth, and a commitment to preserving historical, cultural, and natural heritage.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://cityofkandiyohimn.gov/about-us"
    },
    {
      "id": 5,
      "text": "South of Kandiyohi sits a historic marker overlooking the lakes, marking the original site of Minnesota’s state capitol.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://cityofkandiyohimn.gov/about-us"
    },
    {
      "id": 6,
      "text": "The city lies in central Minnesota, roughly 93 miles west of Minneapolis–St. Paul, a short drive from the Twin Cities.",
