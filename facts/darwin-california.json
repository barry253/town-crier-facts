  "facts": [
    {
      "id": 1,
      "text": "Darwin takes its name from local rancher and prospector Darwin French, who helped chart the area in the mid‑1800s.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Darwin%2C_California",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "In the 1870s, gold, silver, and lead were uncovered in the Coso Range, sparking a brief mining boom that lasted until 1878.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://digital-desert.com/darwin/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "A post office opened in Darwin in 1875, closed briefly in 1902, and has remained in operation ever since.",
      "sourceSentenceIds": [
        15
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Darwin%2C_California",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The 1926 Eichbaum Toll Road opened western access to Death Valley, and when the park became a national monument in 1933, the road was bought to allow free entry.",
      "sourceSentenceIds": [
        16,
        17
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Darwin%2C_California",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "In 1937 a new highway cutoff bypassed Darwin, effectively isolating the once‑thriving mining town.",
      "sourceSentenceIds": [
        18
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Darwin%2C_California",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Darwin lies near the scenic Darwin Falls Wilderness, a rugged area known for its dramatic waterfalls and desert hiking trails.",
