  "facts": [
    {
      "id": 1,
      "text": "Cross Mountain was originally called Kreuzberg, and Native Americans used it as a lookout before settlers found a timber cross there in 1847.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.fbgtx.org/415/Cross-Mountain-Park"
    },
    {
      "id": 2,
      "text": "The discovery of the timber cross led to the hill being renamed Cross Mountain.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.fbgtx.org/415/Cross-Mountain-Park"
    },
    {
      "id": 3,
      "text": "Cross Mountain Park sits on a 1,951‑foot marl and limestone hill, offering sweeping views of the surrounding countryside.",
      "sourceSentenceIds": [
        13
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.fbgtx.org/415/Cross-Mountain-Park"
    },
    {
      "id": 4,
      "text": "The park lies just outside Fredericksburg on North Milam Street, a favorite spot for nature lovers and history buffs.",
