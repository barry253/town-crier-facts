  "facts": [
    {
      "id": 1,
      "text": "Belding was first called Otisco when James Dickinson set up a sawmill in 1836.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://baccmi.org/get-to-know-belding/"
    },
    {
      "id": 2,
      "text": "Richardson’s Mill, Belding’s first silk factory, opened in 1887 and later became the Jolly Kid plant that made children’s clothing.",
      "sourceSentenceIds": [
        6,
        7
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://baccmi.org/get-to-know-belding/"
    },
    {
      "id": 3,
      "text": "The historic Belrockton Museum, once a dormitory for silk factory workers, now houses Belding’s museum and an interactive children’s exhibit.",
      "sourceSentenceIds": [
        5,
        11
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.belding.mi.us/"
    },
    {
      "id": 4,
      "text": "After a 1893 fire, the Belding Memorial Library was rebuilt in a room over Connell’s Drug Store before moving to City Hall.",
      "sourceSentenceIds": [
        18,
        16
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Belding%2C_Michigan"
    },
    {
      "id": 5,
      "text": "Belding’s name honored the Belding family in 1871, replacing earlier names like Broas Rapids and Hog Wallow.",
      "sourceSentenceIds": [
        27,
        26
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Belding%2C_Michigan"
    },
    {
      "id": 6,
      "text": "Near Main Street’s bridge, a large factory building known as the Jolly Kid plant stands, a reminder of the town’s textile past.",
      "sourceSentenceIds": [
