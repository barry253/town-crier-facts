      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Meta Platforms headquarters sits in Menlo Park, a city that also launched Google, Roblox, Round Table Pizza, and SRI International.",
      "sourceSentenceIds": [
