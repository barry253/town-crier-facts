  "facts": [
    {
      "id": 1,
      "text": "Pfafftown was founded in 1784 when German immigrant Peter Pfaff Sr. bought land west of Muddy Creek, establishing a farming community.",
      "sourceSentenceIds": [
        9,
        7,
        2
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/pfafftown_north_carolina"
    },
    {
      "id": 2,
      "text": "The John Henry Pfaff House, a 19th‑century farmhouse, remains a historic landmark that showcases Pfafftown’s preserved heritage amid modern growth.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/pfafftown_north_carolina"
    },
    {
      "id": 3,
      "text": "In 1865, locals built the Gothic Revival Pfafftown Christian Church, later remodeled through 1973, reflecting the town’s enduring religious heritage.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/pfafftown_north_carolina"
    },
    {
      "id": 4,
      "text": "Transou Road honors the early 19th‑century Transou family, skilled wagon builders whose durable wagons gained regional fame.",
      "sourceSentenceIds": [
        29
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/pfafftown_north_carolina"
    },
    {
      "id": 5,
      "text": "A general store opened in 1891 at Yadkinville Road and Pfaff Lane, serving as a social hub until 1972.",
      "sourceSentenceIds": [
        30
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/pfafftown_north_carolina"
    },
    {
      "id": 6,
      "text": "Pfafftown’s name honors its founder, Peter Pfaff Sr., whose family helped shape the community’s early agricultural and commercial life.",
