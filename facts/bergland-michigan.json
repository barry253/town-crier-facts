  "facts": [
    {
      "id": 1,
      "text": "Bergland was founded in 1900 by Gunlek A, who moved his logging operations from Sidnaw to the hardwood-rich area west of Lake Gogebic.",
      "sourceSentenceIds": [
        1,
        10,
        11,
        20
      ],
      "sourceLabels": [
        "Web source 2",
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/bergland_michigan",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town’s name honors its founder, Gunlek A, reflecting the early 20th‑century logging boom that shaped the community.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/bergland_michigan",
      "category": "people",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "In 1903 a sawmill on Lake Gogebic let logs float directly to water, eliminating rail transport to Sidnaw.",
      "sourceSentenceIds": [
        16
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://berglandmi.gov/history",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Bergland sits on the north shore of Lake Gogebic, Michigan’s largest natural inland lake, and borders the Lake Gogebic CDP to the west.",
      "sourceSentenceIds": [
        7,
        23
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 2"
      ],
      "source": "https://en.wikipedia.org/wiki/Bergland%2C_Michigan",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Heavy snowfall and a short 75‑day growing season make winter sports like snowmobiling and cross‑country skiing staples of local life.",
      "sourceSentenceIds": [
        30
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/bergland_michigan",
      "category": "nature",
      "quality": "poor",
      "qualityReason": "vague"
    },
    {
      "id": 6,
      "text": "Today, nearly 42% of Bergland’s 566 housing units are seasonal, supporting a tourism‑focused economy centered on recreation and hospitality.",
      "sourceSentenceIds": [
        21
      ],
      "sourceLabels": [
        "Web source 2"
      ],
