  "facts": [
    {
      "id": 1,
      "text": "Mechanicsville began as \"New-Work\" in 1814 with stone houses, a store, and a nail factory, showcasing early craftsmanship.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/mechanicsville_bucks_county_pennsylvania"
    },
    {
      "id": 2,
      "text": "The village adopted the name Mechanicsville in 1830 when its post office opened, reflecting its artisan roots.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/mechanicsville_bucks_county_pennsylvania"
    },
    {
      "id": 3,
      "text": "Samuel Wilson’s seed company, founded in 1876, turned Mechanicsville into a global seed hub, shipping seedlings worldwide and printing 50,000 catalog copies by 1891.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/mechanicsville_bucks_county_pennsylvania"
    },
    {
      "id": 4,
      "text": "The historic district, listed on the National Register in 1989, preserves 27 Georgian and vernacular stone buildings from the 19th century.",
      "sourceSentenceIds": [
        17
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/mechanicsville_bucks_county_pennsylvania"
    },
    {
      "id": 5,
      "text": "Located 5 miles northeast of Doylestown and 25 miles north of Philadelphia, Mechanicsville lies within Bucks County’s suburban‑rural mix.",
      "sourceSentenceIds": [
        22
      ],
