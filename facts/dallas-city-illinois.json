  "facts": [
    {
      "id": 1,
      "text": "Dallas City was laid out in 1848 and named after Vice President George Mifflin Dallas.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Dallas_City%2C_Illinois",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Abraham Lincoln stopped in Dallas City on Oct 23, 1858 to deliver a speech, and a monument marks the spot on the Mississippi River.",
      "sourceSentenceIds": [
        11,
        15
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Dallas_City%2C_Illinois",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The town’s post office has been operating since 1850, making it one of the oldest continuous services in the area.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Dallas_City%2C_Illinois",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Amtrak’s Southwest Chief passes through Dallas City on BNSF tracks but does not stop, a quirk for rail fans.",
      "sourceSentenceIds": [
        28
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Dallas_City%2C_Illinois",
