      "quality": "poor",
      "qualityReason": "route_only"
    },
    {
      "id": 5,
      "text": "Dallas City sits in both Hancock and Henderson counties, each linking it to different micropolitan statistical areas.",
      "sourceSentenceIds": [
        7
