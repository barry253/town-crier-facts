  "facts": [
    {
      "id": 1,
      "text": "Almond originated when Jacob Meyers established a stagecoach and freight route between Berlin and Stevens Point, Wisconsin.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Almond%2C_Wisconsin"
    },
    {
      "id": 2,
      "text": "Jacob Meyers built a barn and inn in Almond to provide a necessary resting stop for his stagecoach horses.",
      "sourceSentenceIds": [
        11
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Almond%2C_Wisconsin"
    },
    {
      "id": 3,
      "text": "A post office was established in Almond on July 8, 1850, at the site of the original stagecoach stop.",
      "sourceSentenceIds": [
        13
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Almond%2C_Wisconsin"
    },
    {
      "id": 4,
      "text": "Almond takes its name from the hometown of its first postmaster, who was a native of Almond, New York.",
      "sourceSentenceIds": [
        14
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Almond%2C_Wisconsin"
    },
    {
      "id": 5,
      "text": "The village of Almond was officially incorporated in 1905.",
      "sourceSentenceIds": [
        9,
        10
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Almond%2C_Wisconsin"
    },
    {
      "id": 6,
      "text": "The Almond Wisconsin Historical Society preserves local records, photographs, and artifacts to document the community's past.",
      "sourceSentenceIds": [
        8
      ],
