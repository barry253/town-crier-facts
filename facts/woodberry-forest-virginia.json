  "facts": [
    {
      "id": 1,
      "text": "Founded in 1889 by Captain Robert Stringfellow Walker, a former Mosby's Rangers officer, Woodberry Forest School began as a private boarding school.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Woodberry_Forest_School",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Walker hired a tutor to educate his six sons and nearby children, creating the first classroom that would become Woodberry Forest.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Woodberry_Forest_School",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Named after the Madison plantation, the campus honors William Madison, brother of President James Madison, who once owned the land.",
      "sourceSentenceIds": [
        4,
        6,
        7
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.hallowedground.org/site-locations/woodberry-forest-the-residence/",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The Residence, built around 1793 for William Madison, later adopted a Jeffersonian design and now serves as the headmaster's home.",
      "sourceSentenceIds": [
        11,
        18
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.hallowedground.org/site-locations/woodberry-forest-the-residence/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Woodberry Forest fields teams in the Virginia Prep League and maintains a century‑old football rivalry with Episcopal High School, first played in 1901.",
      "sourceSentenceIds": [
        3,
        21,
        22
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Woodberry_Forest_School",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Spanning roughly 1,200 acres, the campus is bounded on one side by the Rapidan River.",
      "sourceSentenceIds": [
        16,
