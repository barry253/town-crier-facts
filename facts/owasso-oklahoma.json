  "facts": [
    {
      "id": 1,
      "text": "Owasso’s name comes from an Osage word meaning “the end of the trail,” named after the railroad’s turnaround Y near the depot.",
      "sourceSentenceIds": [
        16,
        22
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Owasso%2C_Oklahoma",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "When Owasso first settled in 1881, it lay in the Cooweescoowee District of the Cherokee Nation, near what is now 66th Street North.",
      "sourceSentenceIds": [
        13,
        19
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Owasso%2C_Oklahoma",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The town’s streets were originally named after Union and Confederate generals, but in 1960 the names were changed to numbers and tree names.",
      "sourceSentenceIds": [
        9,
