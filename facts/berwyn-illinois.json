  "facts": [
    {
      "id": 1,
      "text": "Berwyn's development began in 1856 when Thomas Baldwin subdivided 347 acres into 10‑acre lots, marketing it as an exclusive community.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.berwyn-il.gov/community-guide/about-berwyn",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "In 1862 Baldwin sold an 80‑foot strip to the Chicago, Burlington & Quincy Railroad, prompting a railroad extension to the new community.",
      "sourceSentenceIds": [
        13
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.berwyn-il.gov/community-guide/about-berwyn",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Berwyn's south end originally comprised three communities: LaVergne, Upsala (Swedetown), and Berwyn.",
      "sourceSentenceIds": [
        11
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.berwyn-il.gov/community-guide/about-berwyn",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Ogden Avenue in Berwyn is part of Historic Route 66 and hosts an annual Vintage Car Show each September since 1990.",
      "sourceSentenceIds": [
        15
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
