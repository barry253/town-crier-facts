  "facts": [
    {
      "id": 1,
      "text": "Clune began as Coal Run, a coal‑patch town founded 1912‑13 by Lucius Waterman Robinson of R&PC&I.",
      "sourceSentenceIds": [
        1,
        26
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/clune_pennsylvania",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The first coal shipment left Clune on Jan 16, 1913, kicking off a boom that produced over 103,000 tons in 1914.",
      "sourceSentenceIds": [
        27,
        29
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/clune_pennsylvania",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Company houses lined the streets, and a former mine office now serves as the post office, a relic still standing.",
      "sourceSentenceIds": [
        9,
        25
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/clune_pennsylvania",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Holy Cross Byzantine Church opened in 1945, later closed and turned into a private home, reflecting the town’s shifting demographics.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/clune_pennsylvania",
      "category": "people",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Clune sits at 1,260 feet on a plateau in western Pennsylvania’s Appalachian region, about 8.7 miles west‑southwest of Indiana.",
      "sourceSentenceIds": [
        17,
        11
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/clune_pennsylvania",
      "category": "other",
      "quality": "poor",
      "qualityReason": "location_description"
    },
    {
      "id": 6,
      "text": "The town’s name changed from Coal Run to Clune when the post office was established, formalizing its identity amid nearby rail lines.",
      "sourceSentenceIds": [
