  "facts": [
    {
      "id": 1,
      "text": "Denver City sprang to life in 1935 when a successful oil strike turned a quiet ranch area into a boomtown.",
      "sourceSentenceIds": [
        1,
        28
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://denvercitytexas.org/resources/history.php",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town’s name comes from Denver Productions, the oil company that first drilled there, combined with “City” to signal optimism.",
      "sourceSentenceIds": [
        3,
        4
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Denver_City%2C_Texas",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Oil still fuels Denver City’s economy, with about seventy‑five percent of local jobs tied to the industry.",
      "sourceSentenceIds": [
        26
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://denvercitytexas.org/resources/history.php",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Daily, the surrounding fields pump roughly 250,000 barrels of crude, keeping Denver City among Texas’s top producers.",
      "sourceSentenceIds": [
        27
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://denvercitytexas.org/resources/history.php",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The Denver City Historical Museum preserves artifacts from the town’s early oil days and the surrounding ranching heritage.",
      "sourceSentenceIds": [
        11
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://texastimetravel.com/cities/denver-city/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Geographically, Denver City sits on the far west side of Texas, halfway between Lubbock and Midland‑Odessa, close to the New Mexico border.",
