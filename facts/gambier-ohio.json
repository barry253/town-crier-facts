  "facts": [
    {
      "id": 1,
      "text": "Gambier was named after Lord James Gambier, a benefactor of Kenyon College, by founder Philander Chase in the 1800s.",
      "sourceSentenceIds": [
        1,
        2
      ],
      "sourceLabels": [
        "Web source 1",
        "Wikipedia"
      ],
      "source": "https://www.villageofgambier.org/1196/About-Gambier",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The village is the home of Kenyon College, a historic liberal‑arts institution founded in 1824.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Gambier%2C_Ohio",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "In the 1960s, Japanese writer Junzo Shono lived in Gambier, later publishing the popular book *A Sojourn in Gambier*.",
      "sourceSentenceIds": [
        11
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Gambier%2C_Ohio",
      "category": "people",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "On May 4, 2020, Gambier became the first Knox County municipality to enact anti‑discrimination laws protecting LGBTQ+ residents.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Gambier%2C_Ohio",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Gambier sits along the Kokosing River, a tributary that shapes the village’s natural landscape.",
      "sourceSentenceIds": [
        16
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Gambier%2C_Ohio",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The village hosts a branch of The Public Library of Mount Vernon & Knox County, serving local residents and students.",
