      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town takes its name from Solon Anthony, the son of Dan and Betty, after the family land passed down to him.",
      "sourceSentenceIds": [
        23
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/anthonyville_arkansas",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "In 1946 the Anthony family opened the Anthony Funeral Home on their land, becoming a cornerstone of the community.",
      "sourceSentenceIds": [
        18,
