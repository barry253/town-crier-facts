      "id": 1,
      "text": "Dan and Betty Anthony bought land from Memphis cotton merchant Raynall Cornell, turning a family farm into the nucleus of what would become Anthonyville.",
      "sourceSentenceIds": [
        22
      ],
      "sourceLabels": [
        "Web source 2"
      ],
