  "facts": [
    {
      "id": 1,
      "text": "Mason earned its name from Stevens T. Mason, Michigan’s first governor, who helped shape the state’s early history.",
      "sourceSentenceIds": [
        5,
        27
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Mason%2C_Michigan",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "In 1836, Stevens T. Mason cleared 20 acres of forest to establish Mason Center, the town’s original nucleus.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Mason%2C_Michigan",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Mason’s first courthouse appeared in 1843, and by 1858 the town boasted sawmills, carriage factories, copper shops, a steam flourmill, and a buffalo robe manufacturer.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Mason%2C_Michigan",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The historic Pink School, erected in 1859 at Columbia and College Roads, earned Michigan’s One‑Room Schoolhouse of the Year award.",
      "sourceSentenceIds": [
        18,
        25
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://masonmuseum.org/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The Mason Area Historical Museum at 200 E. houses the Virginia Schlichter Auditorium, where the society meets monthly from March through November.",
      "sourceSentenceIds": [
        14,
        15,
        9
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://masonmuseum.org/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Capital Area Transportation Authority buses run daily between Lansing and Mason, linking the county seat to the state capital.",
      "sourceSentenceIds": [
        24
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Mason%2C_Michigan",
