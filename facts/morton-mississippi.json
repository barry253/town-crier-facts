  "facts": [
    {
      "id": 1,
      "text": "Morton was renamed in 1856 after Elizabeth Morton Taylor, the wife of settler Colonel Caleb W., following its early settlement around 1850.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/morton_mississippi",
      "category": "etymology",
      "quality": "poor",
      "qualityReason": "dropped_surname_no_wiki_source"
    },
    {
      "id": 2,
      "text": "The town’s founding followed the 1830 Treaty of Dancing Rabbit Creek, which opened former Choctaw lands to white settlers in central Mississippi.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/morton_mississippi",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "A Southern Railroad of Mississippi line reached Morton in 1858, linking the town to broader markets and sparking early trade.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/morton_mississippi",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "In the early 1900s, the Hall‑Legan Lumber Company employed nearly 800 residents, making lumber a cornerstone of Morton’s economy.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/morton_mississippi",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Today, Morton hosts one of the world’s largest broiler producers, Koch Foods, whose plant has shaped the town’s demographics and labor history.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/morton_mississippi",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Morton is surrounded by the Bienville National Forest, offering residents and visitors a lush natural backdrop right on the town’s edge.",
      "sourceSentenceIds": [
        15
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Morton%2C_Mississippi",
