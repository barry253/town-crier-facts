  "facts": [
    {
      "id": 2,
      "text": "The area that became Newtown Grant was part of a 5,000‑acre tract William Penn bought from the Indians in 1682.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.newtowngrant.org/community",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "George Washington used a house on South Sycamore Street in Newtown as his headquarters after the Battle of Trenton before heading to Princeton.",
      "sourceSentenceIds": [
        3,
        23,
        24
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.newtowngrant.org/community",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Newtown served as Bucks County’s seat from 1726 to 1813, turning the village into a bustling government center.",
      "sourceSentenceIds": [
        18,
        26
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.newtowngrant.org/community",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Newtown was laid out like an open fan around a central common, a design surveyed by Thomas Holme in 1684 that still marks its borders.",
      "sourceSentenceIds": [
        19,
        20
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.newtowngrant.org/community",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Newtown Grant is divided into 14 distinct subsections, including Eagles Pointe, Fawn Hollow, and Willow Creek/Eagle Trace, reflecting its planned residential development.",
      "sourceSentenceIds": [
        15
      ],
