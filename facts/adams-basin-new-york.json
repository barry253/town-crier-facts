  "facts": [
    {
      "id": 1,
      "text": "Adams Basin grew around a sawmill built by settler Abner Adams on Salmon Creek when the Erie Canal opened in the 1820s.",
      "sourceSentenceIds": [
        1,
        27
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/adams_basin_new_york",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The hamlet’s oldest intact tavern barroom, the Adams Basin Inn, dates back to 1827 and was listed on the National Register of Historic Places in 1985.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/adams_basin_new_york",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "In the 1870s, about 70 people lived in Adams Basin, working as farmers, blacksmiths, teachers, and canal‑related tradesmen.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/adams_basin_new_york",
      "category": "people",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Adams Basin sits on the historic Erie Canal, which runs through the northern part of Ogden and shapes the local hydrology.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/adams_basin_new_york",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The hamlet’s small schoolhouse at 416 Washington Street serves as a pocket park with a playground and basketball court for nearby residents.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/adams_basin_new_york",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Summer highs in Adams Basin hover around 70‑72°F, while spring and autumn bring variable weather moderated by lake influences.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 1"
      ],
