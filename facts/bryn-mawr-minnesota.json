  "facts": [
    {
      "id": 1,
      "text": "Bryn Mawr’s name comes from Welsh for “big hill” and the area was promoted as a “garden suburb” in the mid‑1800s.",
      "sourceSentenceIds": [
        1,
        19
      ],
      "sourceLabels": [
        "Wikipedia",
