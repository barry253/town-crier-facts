    {
      "id": 2,
      "text": "The first seamless tubing factory in the United States was built in Ellwood City, helping make bicycles a popular mode of transport.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 1"
      ],
