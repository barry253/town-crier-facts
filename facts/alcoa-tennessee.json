  "facts": [
    {
      "id": 1,
      "text": "Alcoa was founded as a company town in 1910 when the Aluminum Company of America bought land near the Little Tennessee River for hydroelectric power.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/Alcoa,_Tennessee",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town’s streets—Bessemer, Joule, Edison, Darwin, and Watt—are named after famous scientists, reflecting the company’s scientific heritage.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Alcoa%2C_Tennessee",
      "category": "people",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "By 1939 employment at the plant exceeded 4,000, sparking a housing boom that led Alcoa to build thousands of company homes for workers.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/Alcoa,_Tennessee",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "In 1956 Alcoa sold its electric distribution system to the city, ending the company’s control over utilities and marking a shift toward municipal ownership.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/Alcoa,_Tennessee",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Alcoa’s shift from a single‑industry town to a balanced suburb is seen in the Maryville‑Alcoa Greenway, a pedestrian bridge network linking former industrial sites to trails.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/Alcoa,_Tennessee",
      "category": "history",
      "quality": "good"
    }
