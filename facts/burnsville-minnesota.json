  "facts": [
    {
      "id": 1,
      "text": "Burnsville sits on a bluff overlooking the south bank of the Minnesota River, upstream from its confluence with the Mississippi.",
      "sourceSentenceIds": [
        3,
        6
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 2"
      ],
      "source": "https://en.wikipedia.org/wiki/Burnsville%2C_Minnesota"
    },
    {
      "id": 2,
      "text": "The city’s name traces back to early Irish settler William Byrne, whose surname was recorded as \"Burns\" and never corrected.",
      "sourceSentenceIds": [
        15,
        16,
        30
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Burnsville%2C_Minnesota"
    },
    {
      "id": 3,
      "text": "Before settlers, the Mdewakanton Dakota established a village at the isthmus between Black Dog Lake and the Minnesota River, now near the Black Dog Power Plant.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Burnsville%2C_Minnesota"
    },
    {
      "id": 4,
      "text": "Burnsville’s downtown, called the Heart of the City, blends urban-style retail with condominiums and anchors the community’s modern identity.",
      "sourceSentenceIds": [
        20
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Burnsville%2C_Minnesota"
    },
    {
      "id": 5,
      "text": "The Minnesota Valley Transit Authority’s hub, the Burnsville Transit Station, was renovated for $13.3 million and reopened in February 2018.",
      "sourceSentenceIds": [
        12,
        13
      ],
      "sourceLabels": [
        "Wikipedia",
