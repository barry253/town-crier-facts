  "facts": [
    {
      "id": 1,
      "text": "Littleton earned its name in 1854 when William Window petitioned the Postmaster General to honor his father‑in‑law, James Little.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://schuyler-ilgw.genealogyvillage.com/schuylernewhome/Towns/Littleton1908.html",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Window built Littleton’s first house in 1847 and served as the town’s inaugural postmaster that same year.",
      "sourceSentenceIds": [
        14
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://schuyler-ilgw.genealogyvillage.com/schuylernewhome/Towns/Littleton1908.html",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "On October 26, 1856, a devastating tornado struck Littleton, set back its development for years.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://schuyler-ilgw.genealogyvillage.com/schuylernewhome/Towns/Littleton1908.html",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "From 1904 to 1930, Littleton was the southern terminus of the Macomb & Western Illinois Railway, boosting local commerce.",
      "sourceSentenceIds": [
        17
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://schuyler-ilgw.genealogyvillage.com/schuylernewhome/Towns/Littleton1908.html",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Littleton officially became an incorporated village in 1911, establishing its own municipal government.",
      "sourceSentenceIds": [
        18
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Littleton%2C_Illinois",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Early settlers like David Trainor were attracted to Littleton Township’s rich prairie lands, building farms as early as 1825.",
