  "facts": [
    {
      "id": 1,
      "text": "Bunker Hill got its name from the prominent coal bunkers used for local mining operations in the early twentieth century.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/bunker_hill_oregon"
    },
    {
      "id": 2,
      "text": "Bunker Hill is a residential neighborhood in southern Coos Bay situated near the mouth of Coalbank Slough.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/bunker_hill_oregon"
    },
    {
      "id": 3,
      "text": "Coal mining in the Bunker Hill area peaked in the late nineteenth century before declining in the 1920s due to alternative fuels.",
      "sourceSentenceIds": [
        25
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/bunker_hill_oregon"
    },
    {
      "id": 4,
      "text": "Steam locomotives once hauled coal to bunkers in Bunker Hill that could hold up to one thousand tons each.",
      "sourceSentenceIds": [
        27
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/bunker_hill_oregon"
    },
    {
      "id": 5,
      "text": "Bunker Hill featured bungalow-style homes during a period of modest residential expansion in the 1920s and 1930s.",
      "sourceSentenceIds": [
        29
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/bunker_hill_oregon"
    },
    {
      "id": 6,
      "text": "The 1932 opening of the Isthmus Slough Bridge in Bunker Hill eliminated the need for the Marshfield-Eastside ferry route.",
      "sourceSentenceIds": [
        30
      ],
      "sourceLabels": [
        "Web source 1"
      ],
