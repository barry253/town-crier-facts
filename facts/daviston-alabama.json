  "facts": [
    {
      "id": 1,
      "text": "Daviston was named after its first postmaster, John O., who opened the post office in 1853.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/daviston_alabama"
    },
    {
      "id": 2,
      "text": "The area that became Daviston opened to white settlers in 1832 after the Creek Nation ceded land in the Treaty of Cusseta.",
      "sourceSentenceIds": [
        13
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/daviston_alabama"
    },
    {
      "id": 3,
      "text": "Daviston incorporated on February 16, 1887, becoming Tallapoosa County's first rural town.",
      "sourceSentenceIds": [
        17
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Daviston%2C_Alabama"
    },
    {
      "id": 4,
      "text": "In 1989, a sewing factory opened in Daviston, employing about 110 residents before closing in 1998.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/daviston_alabama"
    },
    {
      "id": 5,
      "text": "Daviston College opened in the 1880s, became a high school in 1916, and closed in 1988 after fires.",
      "sourceSentenceIds": [
