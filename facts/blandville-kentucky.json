  "facts": [
    {
      "id": 1,
      "text": "Blandville was founded in 1842 and named after Captain Bland Ballard, a War of 1812 hero.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Blandville%2C_Kentucky",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "From 1842 to 1881, Blandville served as the county seat of Ballard County before the seat moved to Wickliffe.",
      "sourceSentenceIds": [
        20
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Blandville%2C_Kentucky",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The town’s center was a circle anchored by the courthouse and city park, but the lack of railroad access later stunted growth.",
      "sourceSentenceIds": [
        15
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://unitedstatesghosttowns.com/blandville-kentucky-ghost-town/",
      "category": "landmark",
      "quality": "poor",
      "qualityReason": "vague"
    },
    {
      "id": 4,
      "text": "Historic structures are mostly gone or in ruins, including an abandoned college building and scattered remnants of its commercial past.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://unitedstatesghosttowns.com/blandville-kentucky-ghost-town/",
      "category": "landmark",
      "quality": "poor",
      "qualityReason": "vague"
    },
    {
      "id": 5,
      "text": "An old graveyard and historic house remain as the primary physical evidence of Blandville’s once‑prosperous existence.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://unitedstatesghosttowns.com/blandville-kentucky-ghost-town/",
      "category": "landmark",
      "quality": "poor",
      "qualityReason": "vague"
    },
    {
      "id": 6,
      "text": "Blandville sits at 463 feet above sea level, on rich black loam and yellow clay soils.",
      "sourceSentenceIds": [
        13
      ],
      "sourceLabels": [
        "Web source 1"
