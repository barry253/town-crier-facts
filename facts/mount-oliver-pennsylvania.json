  "facts": [
    {
      "id": 1,
      "text": "Mount Oliver earned its name when Ormsby christened the settlement after his son, Oliver Ormsby.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Mount_Oliver%2C_Pennsylvania"
    },
    {
      "id": 2,
      "text": "Perched on a crest roughly three miles west of the Monongahela River, Mount Oliver offers sweeping views of Pittsburgh.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Mount_Oliver%2C_Pennsylvania"
    },
    {
      "id": 3,
      "text": "The borough has remained an enclave, entirely surrounded by Pittsburgh, after successfully resisting multiple annexation attempts.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Mount_Oliver%2C_Pennsylvania"
    },
    {
      "id": 4,
      "text": "In 1892 residents gathered a petition, and the courts approved Mount Oliver’s incorporation as a borough on November 9.",
      "sourceSentenceIds": [
        15
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Mount_Oliver%2C_Pennsylvania"
    },
    {
      "id": 5,
      "text": "Once a bustling commercial hub in the 1980s, Mount Oliver has seen a notable decline in local business activity since then.",
      "sourceSentenceIds": [
        18
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Mount_Oliver%2C_Pennsylvania"
    },
    {
      "id": 6,
      "text": "Mount Oliver sits at latitude 40°24′41″N and longitude 79°59′12″W, placing it just west of Pittsburgh’s downtown.",
      "sourceSentenceIds": [
        19
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Mount_Oliver%2C_Pennsylvania"
