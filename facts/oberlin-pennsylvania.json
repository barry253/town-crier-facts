  "facts": [
    {
      "id": 1,
      "text": "Oberlin was named after John Frederic Oberlin, a French minister and social reformer.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://oberlinheritagecenter.org/intro-to-oberlin-history/",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Oberlin College first admitted African Americans in 1835 and awarded the first degree to an African‑American woman in 1862.",
      "sourceSentenceIds": [
        27,
        28
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://oberlinheritagecenter.org/intro-to-oberlin-history/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The Oberlin Heritage Center preserves an 1830s one‑room schoolhouse and other historic buildings that document the town’s abolitionist past.",
      "sourceSentenceIds": [
        1,
        9
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.achp.gov/preserve-america/stewards/oberlin-heritage-center",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Volunteers at the Heritage Center paint, garden, give tours, and run hands‑on history activities year‑round.",
      "sourceSentenceIds": [
        19,
        20
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.achp.gov/preserve-america/stewards/oberlin-heritage-center",
      "category": "other",
      "quality": "poor",
      "qualityReason": "editorial_filler"
    },
    {
      "id": 5,
      "text": "Oberlin was a hub for the Underground Railroad, though no contemporary records call it “Station 99” and tunnels are unconfirmed.",
      "sourceSentenceIds": [
        22,
        14
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://oberlinheritagecenter.org/intro-to-oberlin-history/",
      "category": "history",
      "quality": "poor",
      "qualityReason": "vague"
    },
    {
      "id": 6,
      "text": "The Conservatory of Music, officially established in 1865, began as part of the college before becoming its own entity.",
      "sourceSentenceIds": [
