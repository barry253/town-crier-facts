  "facts": [
    {
      "id": 1,
      "text": "Crouch takes its name from Billy Crouch, a miner who settled near the Payette River and donated land for a community hall in the 1920s.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/crouch_idaho",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town was founded in 1934 when a post office opened, spurred by workers from nearby CCC camps.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/crouch_idaho",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "In 1951 Crouch incorporated, partly to legalize alcohol and gambling—practices that later ended amid local controversies.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/crouch_idaho",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "French fur traders explored the area in 1818, and a gold rush in the 1860s turned Garden Valley into a mining supply hub, with bridge built in 1867.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/crouch_idaho",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Crouch sits at 3,048 feet elevation along the South Fork of the Payette River, right in the heart of Garden Valley.",
      "sourceSentenceIds": [
        26
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/crouch_idaho",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The Wildlife Canyon Scenic Byway, a paved road between Crouch and Lowman, replaced a small unpaved road in 2018.",
      "sourceSentenceIds": [
        11
      ],
