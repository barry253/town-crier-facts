  "facts": [
    {
      "id": 1,
      "text": "Strongsville was founded as a township on February 25, 1818, named after John Stoughton Strong, a Vermont native who led the settlers.",
      "sourceSentenceIds": [
        11,
        12
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Strongsville%2C_Ohio"
    },
    {
      "id": 2,
      "text": "The city’s nickname, Crossroads of the Nation, comes from the historic intersection of the Baltimore and Ohio Railroad and the Southwestern Electric Line.",
      "sourceSentenceIds": [
        16
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Strongsville%2C_Ohio"
    },
    {
      "id": 3,
      "text": "The John Stoughton Strong House, built in the 1830s, was added to the National Register of Historic Places on November 24, 1980.",
      "sourceSentenceIds": [
        19
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Strongsville%2C_Ohio"
    },
    {
      "id": 4,
      "text": "Strongsville’s historic village preserves original 19th‑century buildings and includes a replica of the log cabins built when the town was founded.",
