      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The Northwest District hosts Portland’s Moda Center and the Oregon Convention Center, anchoring the city’s sports and event scene.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Web source 2"
      ],
