  "facts": [
    {
      "id": 1,
      "text": "St. Albert began in 1861 as a Métis settlement founded by Father Albert Lacombe, who built the original Father Lacombe Chapel.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/St._Albert%2C_Alberta",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Bishop Alexandre‑Antonin Taché named the town Saint Albert after Lacombe’s patron saint, Albert of Louvain.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/St._Albert%2C_Alberta",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The city has hosted major sporting events, including the 1979 Alberta Summer Games, 1994 Winter Games, 2011 55+ Winter Games, and 2012 Special Olympics Canada Winter Games.",
      "sourceSentenceIds": [
