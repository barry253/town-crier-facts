      ],
      "source": "https://www.lompicopark.org/history",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Before settlers, the Zayante Indians, part of the Ohlone, inhabited the forests and rivers around Lompico for centuries.",
      "sourceSentenceIds": [
        1,
        10,
        11
      ],
      "sourceLabels": [
