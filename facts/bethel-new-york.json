      "quality": "good"
    },
    {
      "id": 2,
      "text": "In 1969, the legendary Woodstock festival moved from Wallkill to Bethel, making the town a landmark in music history.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Bethel%2C_New_York",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Bethel once hosted dozens of Borscht Belt hotels and summer camps, including Camp Ma-Ho-Ge and Camp Ranger on Silver Lake.",
      "sourceSentenceIds": [
        19
      ],
      "sourceLabels": [
