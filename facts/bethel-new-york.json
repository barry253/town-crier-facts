      "category": "culture",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The Bikur Cholim B'nai Israel Synagogue in Bethel earned a spot on the National Register of Historic Places in 1999.",
      "sourceSentenceIds": [
        7
