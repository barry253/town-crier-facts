  "facts": [
    {
      "id": 1,
      "text": "Pottsgrove Manor was built in 1752 for the Potts family, showcasing early Georgian architecture and the lives of John and Ruth Potts and their 13 children.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.montcopavotes.gov/930/Pottsgrove-Manor",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The manor sits on four acres that are part of Montgomery County's Division of Parks, Trails, and Historic Sites.",
      "sourceSentenceIds": [
        13
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.montcopavotes.gov/930/Pottsgrove-Manor",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Pottsgrove Manor hosts living history interpreters who demonstrate traditional crafts, cooking, and colonial skills.",
      "sourceSentenceIds": [
        16
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.montcopavotes.gov/930/Pottsgrove-Manor",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The Sanatoga Union Sunday School and Sunnybrook are listed on the National Register of Historic Places.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Lower_Pottsgrove_Township%2C_Pennsylvania",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Sanatoga Park spans 54 acres and includes a man‑made lake, bandshell, pavilion, playground, soccer and baseball fields.",
      "sourceSentenceIds": [
        11
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Lower_Pottsgrove_Township%2C_Pennsylvania",
      "category": "culture",
      "quality": "good"
    },
    {
