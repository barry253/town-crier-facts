  "facts": [
    {
      "id": 1,
      "text": "Linden began as a mining camp after an Irish peddler named Patrick O'Meara discovered lead while searching for firewood in 1827.",
      "sourceSentenceIds": [
        2,
        29
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.lindenhistoricalsociety.com/"
    },
    {
      "id": 2,
      "text": "Skilled miners from Cornwall and Yorkshire, England, immigrated to Linden starting in the 1830s to work the local lead deposits.",
      "sourceSentenceIds": [
        30
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.lindenhistoricalsociety.com/"
    },
    {
      "id": 3,
      "text": "A log structure built in 1837 near the Peddler's Creek cemetery served as both a school and a Methodist Church.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.lindenhistoricalsociety.com/"
    },
    {
      "id": 4,
      "text": "Linden's early community life featured several local bands and church choirs.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.lindenhistoricalsociety.com/"
    },
    {
      "id": 5,
      "text": "The Masons remain an active organization in Linden, though the local IOOF chapter eventually disbanded.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
