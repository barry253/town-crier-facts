  "facts": [
    {
      "id": 1,
      "text": "Ohio City began as a gold mining town in the early 1860s.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.uncovercolorado.com/ghost-towns/ohio-city/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "In 1879 prospector Jacob Hess discovered silver at Ohio Creek, then called Gold Creek.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Ohio_City%2C_Colorado",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Hess moved his camp to Ohio Creek, naming the settlement Eagle City and becoming its first settler.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Ohio_City%2C_Colorado",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The Denver, South Park and Pacific Railroad reached Ohio City the following year, linking it to regional trade.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Ohio_City%2C_Colorado",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The Ohio City Town Hall, originally the Baer Boss Mercantile, now serves as a community center and historic landmark.",
      "sourceSentenceIds": [
        6,
        7
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://gunnisoncounty.org/628/Ohio-City",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Gunnison County acquired the Town Hall in 1974 after declaring Ohio City abandoned, then secured historic preservation grants in 2011 and 2013.",
      "sourceSentenceIds": [
        11,
        13,
        14
      ],
      "sourceLabels": [
        "Web source 1"
      ],
