  "facts": [
    {
      "id": 1,
      "text": "Hobson City officially incorporated on August 16, 1899, becoming Alabama's first city founded solely by and for Black citizens.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Hobson_City%2C_Alabama",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town was named for Richmond Pearson Hobson, a Spanish‑American War naval hero.",
      "sourceSentenceIds": [
        8,
        10
      ],
      "sourceLabels": [
        "Web source 1",
        "Web source 2"
      ],
      "source": "https://townofhobsoncity.com/about/",
      "category": "people",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Hobson City became Alabama's first self‑governed all‑black municipality in 1899 and still has an African‑American majority.",
      "sourceSentenceIds": [
        22
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Hobson_City%2C_Alabama",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Black residents in Mooree Quarters paid $1,200 in school taxes to Oxford each year but were denied access to white schools.",
      "sourceSentenceIds": [
        25
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Hobson_City%2C_Alabama",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Hobson City boasts several buildings listed on the National Register of Historic Places.",
      "sourceSentenceIds": [
        13
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Hobson_City%2C_Alabama",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Before becoming independent, Hobson City was part of Oxford, a railroad hub incorporated in 1852.",
      "sourceSentenceIds": [
        16
      ],
      "sourceLabels": [
        "Web source 2"
