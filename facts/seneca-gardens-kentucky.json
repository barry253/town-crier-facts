  "facts": [
    {
      "id": 1,
      "text": "Seneca Gardens is a home rule-class city in Jefferson County, Kentucky, and part of the Louisville Metro government.",
      "sourceSentenceIds": [
        15
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Seneca_Gardens%2C_Kentucky",
      "category": "other",
      "quality": "poor",
      "qualityReason": "vague"
    },
    {
      "id": 2,
      "text": "The city’s strong neighborhood spirit and commitment to preservation trace back nearly a century, built by residents who cared deeply about the place they call home.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://cityofsenecagardens.com/our-history/",
      "category": "culture",
      "quality": "poor",
      "qualityReason": "vague"
    },
    {
      "id": 3,
      "text": "Most of the present area of Seneca Gardens was purchased from the Speed family in 1825 and 1846 by German gardener Jacob Wetstein.",
      "sourceSentenceIds": [
        21
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Seneca_Gardens%2C_Kentucky",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Jacob Wetstein founded the Methodist Westein Community Church in Seneca Gardens and is locally credited with helping enslaved people escape via the Underground Railroad.",
      "sourceSentenceIds": [
        22
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Seneca_Gardens%2C_Kentucky",
      "category": "people",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Seneca Gardens incorporated on September 26, 1941, with its first city budget calling for $1,600 in expenditures.",
      "sourceSentenceIds": [
        28
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Seneca_Gardens%2C_Kentucky",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Bowman Field, a large army base established in 1940, lies just north of Seneca Gardens.",
