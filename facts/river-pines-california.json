  "facts": [
    {
      "id": 1,
      "text": "River Pines takes its name from the nearby Cosumnes River and the surrounding pine forests that define the area.",
      "sourceSentenceIds": [
        27
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.wisdomlib.org/cities/river-pines-169891"
    },
    {
      "id": 2,
      "text": "During the California Gold Rush, prospectors and later loggers were drawn to River Pines because of its proximity to the Cosumnes River.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.wisdomlib.org/cities/river-pines-169891"
    },
    {
      "id": 3,
      "text": "In the 1920s, damming the Cosumnes River turned River Pines into a resort with boating and fishing activities.",
      "sourceSentenceIds": [
        11,
        22
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/River_Pines%2C_California"
    },
    {
      "id": 4,
      "text": "By May 1926, Brooke hired surveyor Cassius M. Phinney to subdivide land north of the river and south of Plymouth‑Aukum road.",
      "sourceSentenceIds": [
        14,
        25
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/River_Pines%2C_California"
    },
    {
      "id": 5,
      "text": "River Pines evolved into a quiet, remote community that still hosts a post office, a general store, and plenty of privacy.",
      "sourceSentenceIds": [
        13,
        24
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/River_Pines%2C_California"
    },
    {
      "id": 6,
      "text": "The town sits 3 miles north‑northeast of Fiddletown at an elevation of 1,985 feet above sea level.",
