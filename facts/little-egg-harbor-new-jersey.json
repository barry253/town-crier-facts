  "facts": [
    {
      "id": 1,
      "text": "Dutch explorer Cornelius Jacobsen Mey named the inlet 'Eyren Hafen' in 1614 because gulls’ eggs lined its shores, giving Little Egg Harbor its name.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/Little_Egg_Harbor_Township,_New_Jersey",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Hendrick Jacobs Falkenberg arrived in 1693 on land bought from the Lenni Lenape, establishing one of the township’s first European settlements.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/Little_Egg_Harbor_Township,_New_Jersey",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The Egg Harbor Friends Meeting, founded in 1702, built its first meeting house in 1709—the oldest surviving church structure in the region.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/Little_Egg_Harbor_Township,_New_Jersey",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "In October 1778, British forces raided Little Egg Harbor at night, catching Continental troops led by Casimir Pulaski asleep and bayoneting many.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/Little_Egg_Harbor_Township,_New_Jersey",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The Pulaski Monument on the waterfront marks the site of that 1778 raid and honors Pulaski’s bravery during the Revolutionary War.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/Little_Egg_Harbor_Township,_New_Jersey",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "A 1912 German-built Tuckerton Wireless Station in Little Egg Harbor once transmitted transatlantic radiotelegraphy to a counterpart in Eilvese, Germany.",
      "sourceSentenceIds": [
        19
      ],
      "sourceLabels": [
        "Web source 2"
      ],
