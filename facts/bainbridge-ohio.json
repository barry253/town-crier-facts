  "facts": [
    {
      "id": 1,
      "text": "Bainbridge was platted in 1805 by General Nathaniel Massie and incorporated as a village in 1838, named for naval hero Commodore William Bainbridge.",
      "sourceSentenceIds": [
        3,
        4
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/bainbridge_ross_county_ohio",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The village’s Harris Dental Museum, housed in an 1815 brick house, is listed on the National Register and preserves the birthplace of America’s first dental school.",
      "sourceSentenceIds": [
        5,
        18
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/bainbridge_ross_county_ohio",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Bainbridge’s early economy grew around a grist mill, distillery, and small furnace built by Massie, leveraging the fertile lands along Paint Creek.",
      "sourceSentenceIds": [
        28
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/bainbridge_ross_county_ohio",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "By the late 1800s, Bainbridge became a shipping point on the Dayton, Toledo & Ironton Railroad, boosting local farming and small‑scale manufacturing.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/bainbridge_ross_county_ohio",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The village’s founding reflected patriotic sentiment, as Massie chose higher ground to avoid malaria reported at his earlier settlement, Amsterdam.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 1"
      ],
