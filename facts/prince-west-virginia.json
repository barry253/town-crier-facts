  "facts": [
    {
      "id": 1,
      "text": "The community of Prince was named after William Prince, an early settler who purchased land in the New River Gorge.",
      "sourceSentenceIds": [
        1,
        13
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Prince%2C_West_Virginia"
    },
    {
      "id": 2,
      "text": "Prince is one of the few towns in the New River Gorge that was never owned by a coal company.",
      "sourceSentenceIds": [
        19,
        20
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.nps.gov/neri/learn/historyculture/prince.htm"
    },
    {
      "id": 3,
      "text": "The first passenger train depot in the New River Gorge opened in Prince in 1880.",
      "sourceSentenceIds": [
        26
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.nps.gov/neri/learn/historyculture/prince.htm"
    },
    {
      "id": 4,
      "text": "William and James Prince secured a deal requiring every train to stop in Prince as they passed through their land.",
      "sourceSentenceIds": [
        16,
        17
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.nps.gov/neri/learn/historyculture/prince.htm"
    },
    {
      "id": 5,
      "text": "Prince served as a prime supplier of goods and people to surrounding mining towns due to its ideal location.",
      "sourceSentenceIds": [
        22,
        23
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.nps.gov/neri/learn/historyculture/prince.htm"
    },
    {
      "id": 6,
      "text": "Located at an altitude of 1,263 feet, Prince is currently served by an Amtrak station.",
      "sourceSentenceIds": [
