  "facts": [
    {
      "id": 1,
      "text": "Thiseio’s name comes from the Temple of Hephaestus, mistakenly called Thiseion, linking the area to the mythical king Theseus.",
      "sourceSentenceIds": [
        20
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Thiseio",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The ancient Agora’s bema, built in the 6th century BC, hosted orators such as Aristides, Pericles, and Themistocles.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.travel.gr/en/arts-and-culture-en/explore-thiseio-the-gateway-to-ancient-athens/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "From Thiseio’s tree‑lined hill, drivers see the Acropolis and the city’s green‑island center, a view that feels like a breath of fresh air.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.thisisathens.org/neighbourhoods/thissio-locals-guide",
      "category": "other",
      "quality": "poor",
      "qualityReason": "editorial_filler"
    },
    {
      "id": 4,
      "text": "The National Observatory of Athens, Greece’s oldest meteorological station, sits on the Hill of the Nymphs near Thiseio, operating since 1858.",
      "sourceSentenceIds": [
        13,
        15
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Thiseio",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Thiseio borders the Agora, Keramikos, and Pnyx, making it a gateway to Athens’ ancient democratic birthplace and its most celebrated archaeological sites.",
      "sourceSentenceIds": [
