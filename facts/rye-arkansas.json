    },
    {
      "id": 2,
      "text": "The arrival of railroads in the 1880s sparked a timber boom, with sawmills operating in Rye through the 1930s.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 1"
      ],
