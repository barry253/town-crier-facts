    },
    {
      "id": 3,
      "text": "Croweburg once hosted a station on the Joplin & Pittsburg electric railway, linking it to regional rail traffic.",
      "sourceSentenceIds": [
        12,
        13
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Croweburg%2C_Kansas"
    },
    {
      "id": 4,
      "text": "The town unified from four separate mining camps—Croweburg Camp #14, #15, #16, and New Camp—each about half a mile apart.",
      "sourceSentenceIds": [
        27
      ],
      "sourceLabels": [
        "Web source 1"
