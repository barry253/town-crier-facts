      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Luke's Church, founded 1742, and Luke's Cemetery, founded 1742, hold graves of Ursinus College founders and Sundance Kid grandparents.",
      "sourceSentenceIds": [
