  "facts": [
    {
      "id": 1,
      "text": "Alcalá de Henares earned UNESCO World Heritage status for its well‑preserved medieval centre, complete with winding cobbled streets and historic buildings.",
      "sourceSentenceIds": [
        13
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Alcal%C3%A1_de_Henares",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The Complutense University was founded here in 1499, becoming the first university to declare Spanish a language of culture.",
      "sourceSentenceIds": [
        7,
        8
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.esmadrid.com/en/trips-alcala-henares",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Miguel de Cervantes was born in Alcalá in 1547, and his former home now serves as a museum that traces the origins of Don Quixote.",
      "sourceSentenceIds": [
        23
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.esmadrid.com/en/trips-alcala-henares",
      "category": "people",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The Corral de Comedias, opened in the 17th century, is the oldest documented open‑air theatre in Spain.",
      "sourceSentenceIds": [
        15,
        27
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Alcal%C3%A1_de_Henares",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Alcalá’s name derives from the Arabic word for citadel, reflecting its origins as a Muslim fortress on the Henares River.",
      "sourceSentenceIds": [
        30
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Alcal%C3%A1_de_Henares",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "After the university moved to Madrid in 1836, a new campus was founded in Alcalá in 1977, preserving the city’s academic heritage.",
      "sourceSentenceIds": [
        5,
        6
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Alcal%C3%A1_de_Henares",
