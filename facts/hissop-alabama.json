    },
    {
      "id": 2,
      "text": "Hissop’s post office opened in 1880 and closed in 1990, linking the community to the wider region.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Hissop%2C_Alabama"
    },
    {
      "id": 3,
      "text": "Hissop sits at 790 feet above sea level, nestled in the gently rolling Piedmont uplands of central Alabama.",
      "sourceSentenceIds": [
        14
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/hissop_alabama"
    },
    {
      "id": 4,
      "text": "Hissop enjoys a humid subtropical climate, with July highs around 90°F and January lows near 36°F.",
      "sourceSentenceIds": [
        18
