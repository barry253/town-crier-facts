      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town’s name comes from New England villages Amenia, New York and Sharon, Connecticut, via the Amenia and Sharon Land Company.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
