  "facts": [
    {
      "id": 1,
      "text": "Gentilly’s name comes from the French word “gentil,” meaning gentle or noble, a nod to its early rural scenery.",
      "sourceSentenceIds": [
        14
      ],
      "sourceLabels": [
        "Web source 1"
      ],
