  "facts": [
    {
      "id": 1,
      "text": "Fairfield Glade was founded in 1970 as a master‑planned resort, after Fairfield Communities, Inc. bought about 12,000 acres in 1969.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/Fairfield_Glade,_Tennessee"
    },
    {
      "id": 2,
      "text": "In 2011, Fairfield Glade earned a spot among the United States' 50 best master‑planned communities.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/Fairfield_Glade,_Tennessee"
    },
    {
      "id": 3,
      "text": "The community sits on the Cumberland Plateau, bordered east by Daddys Creek valley and north by the Catoosa Wildlife Management Area.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Fairfield_Glade%2C_Tennessee"
    },
    {
      "id": 4,
      "text": "Fairfield Glade is managed by a homeowner’s association that enforces architectural standards, maintains golf courses, and operates the sewage plant.",
      "sourceSentenceIds": [
        16,
        17
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Fairfield_Glade%2C_Tennessee"
    },
    {
      "id": 5,
      "text": "The community maintains its own police department to serve residents and visitors.",
      "sourceSentenceIds": [
        19
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Fairfield_Glade%2C_Tennessee"
    },
    {
      "id": 6,
      "text": "Before becoming a planned community, the land hosted coal mining by the Cumberland Coal & Coke Company and extensive logging for railroads.",
