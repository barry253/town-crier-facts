  "facts": [
    {
      "id": 1,
      "text": "Fox was named after nearby Fox Creek, a small tributary that feeds into Goldstream Creek Valley.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.alaska.org/detail/town-of-fox",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The Tanana Valley Railroad reached Fox in 1905, making it a rail‑connected mining hub until the line closed in 1930.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.alaska.org/detail/town-of-fox",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Fox began as a gold‑mining camp in 1905, with tailings and abandoned equipment still visible today.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/fox_alaska",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Fox experiences subarctic winters that can drop below –50°F, with historic lows reaching –66°F in nearby Fairbanks during 1934.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/fox_alaska",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The Howling Dog Saloon, originally from Ester, moved to Fox in the early 1970s and still hosts live music.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Fox%2C_Alaska",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "In the 1960s, the Permafrost Tunnel Research Facility was built in Fox to study permafrost layers beneath the town.",
      "sourceSentenceIds": [
        16
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
