  "facts": [
    {
      "id": 1,
      "text": "Kewaunee takes its name from the Menominee word Kewāneh, which is an archaic name for a species of duck.",
      "sourceSentenceIds": [
        13
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Kewaunee%2C_Wisconsin"
    },
    {
      "id": 2,
      "text": "The current settlement of Kewaunee began in 1836 after false rumors of gold deposits triggered a minor gold rush.",
      "sourceSentenceIds": [
        21
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Kewaunee%2C_Wisconsin"
    },
    {
      "id": 3,
      "text": "Kewaunee evolved from a lumber milling center into a city by 1893, bolstered by rail connections and car ferry services.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/Kewaunee,_Wisconsin"
    },
    {
      "id": 4,
      "text": "French Jesuit missionary Jacques Marquette celebrated All Saints Day at a Potawatomi village in Kewaunee back in 1674.",
      "sourceSentenceIds": [
        16
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Kewaunee%2C_Wisconsin"
    },
    {
      "id": 5,
      "text": "Kewaunee is located on the northwestern shore of Lake Michigan and serves as the county seat of Kewaunee County.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Kewaunee%2C_Wisconsin"
    },
    {
      "id": 6,
      "text": "The Kewaunee Power Station, located in the region, was officially decommissioned on May 7, 2013.",
