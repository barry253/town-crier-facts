  "facts": [
    {
      "id": 1,
      "text": "Lake Annette was created by Ed and Anne Pruitt in 1956 as a 38‑acre reservoir, becoming the heart of a planned residential community.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/lake_annette_missouri"
    },
    {
      "id": 2,
      "text": "The lake’s name honors Pruitt daughter Annette, born the night the reservoir first filled on March 22, 1957, during a heavy rainstorm.",
      "sourceSentenceIds": [
        10,
        11
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Lake_Annette%2C_Missouri"
    },
    {
      "id": 3,
      "text": "The dam, 16 feet high and holding 325 acre‑feet, was finished in 1959 after the lake filled in 1957.",
      "sourceSentenceIds": [
        28,
        29
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/lake_annette_missouri"
    },
    {
      "id": 4,
      "text": "Lake Annette incorporated as a fourth‑class city in 1982, joining the Kansas City metropolitan area.",
      "sourceSentenceIds": [
        27,
        12
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/lake_annette_missouri"
    },
    {
      "id": 5,
      "text": "The original construction involved excavating the basin and building a dam, but early runoff was too low to fill the reservoir.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/lake_annette_missouri"
    },
    {
