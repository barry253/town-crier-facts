  "facts": [
    {
      "id": 1,
      "text": "New Harmony was founded in 1814 by the Harmony Society, a German religious group led by George Rapp.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/New_Harmony%2C_Indiana",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "In 1825 Robert Owen purchased the town and renamed it the New Harmony Community of Equality, sparking a utopian experiment.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/New_Harmony%2C_Indiana",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "More than 30 original Harmonist and Owenite buildings survive today, making New Harmony a National Historic Landmark district.",
      "sourceSentenceIds": [
        18
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/New_Harmony%2C_Indiana",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The modern Atheneum, a visitor center for Historic New Harmony, was designed by renowned architect Richard Meier.",
      "sourceSentenceIds": [
        13
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/New_Harmony%2C_Indiana",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Inside the town library, a vault holds manuscripts, letters, and documents that chronicle New Harmony’s early history.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/New_Harmony%2C_Indiana",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The New Harmony State Historic Site offers guided tours of the town’s historic buildings and shares the story of its utopian past.",
      "sourceSentenceIds": [
        25,
        26
      ],
      "sourceLabels": [
        "Web source 2"
      ],
