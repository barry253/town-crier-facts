  "facts": [
    {
      "id": 1,
      "text": "Logan Square was annexed into Chicago in 1889, after early settlers like Martin Kimbell farmed the prairie that would become the neighborhood.",
      "sourceSentenceIds": [
        1,
        11,
        23
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1",
        "Web source 2"
      ],
      "source": "https://en.wikipedia.org/wiki/Logan_Square%2C_Chicago",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The Logan Square Boulevards District, a historic grid of wide streets, was listed on the National Register of Historic Places in 1985 and became a Chicago Landmark in 2005.",
      "sourceSentenceIds": [
        6,
        28
      ],
      "sourceLabels": [
        "Web source 1",
        "Wikipedia"
      ],
      "source": "https://www.logansquarepreservation.org/history",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "In 1916, Kosciuszko Park was dedicated to Tadeusz Kościuszko, a Polish hero who fought in the American Revolution.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Logan_Square%2C_Chicago",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The iconic Congress Theater, built in 1926, has been a cultural hub for Logan Square ever since.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Logan_Square%2C_Chicago",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Shel Silverstein, the beloved author and poet, grew up in Logan Square and later became a national literary icon.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Logan_Square%2C_Chicago",
      "category": "people",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The 1963 founding of the Logan Square Neighborhood Association marked a new era of community organization and neighborhood revitalization.",
