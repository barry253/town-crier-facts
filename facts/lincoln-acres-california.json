  "facts": [
    {
      "id": 1,
      "text": "Lincoln Acres began as a farming settlement during the Great Depression, later becoming a predominantly Mexican American community with a strong small‑town feel.",
      "sourceSentenceIds": [
        1,
        20
      ],
      "sourceLabels": [
        "Web source 1",
        "Wikipedia"
      ],
      "source": "https://www.sandiegocounty.gov/content/sdc/pds/gpupdate/comm/LincolnAcres.html",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The community’s library started in 1940, grew into the smallest county branch, and a new building opened in 2013, tripling its size.",
      "sourceSentenceIds": [
        13,
        14,
        30
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Lincoln_Acres%2C_California",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Lincoln Acres is a county island wholly inside National City, yet it remains unincorporated and is included in National City’s “sphere of influence.”.",
      "sourceSentenceIds": [
        18,
        6
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 2"
      ],
      "source": "https://en.wikipedia.org/wiki/Lincoln_Acres%2C_California",
      "category": "other",
      "quality": "poor",
      "qualityReason": "location_description"
    },
    {
      "id": 4,
      "text": "A 2019 county commission approved annexing a quarter acre of Lincoln Acres near the I‑805/CA‑54 interchange into National City.",
      "sourceSentenceIds": [
        24
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Lincoln_Acres%2C_California",
      "category": "other",
      "quality": "poor",
      "qualityReason": "editorial_filler"
    },
    {
      "id": 5,
      "text": "La Vista Cemetery, the largest plot, has an endowed section and a Rest Haven where families maintain their own headstones.",
      "sourceSentenceIds": [
