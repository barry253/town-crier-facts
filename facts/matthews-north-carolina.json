    {
      "id": 1,
      "text": "Matthews was renamed in 1879 after Edward Matthews, the railroad director who helped bring the first train to town.",
      "sourceSentenceIds": [
        4,
        18
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 2"
      ],
      "source": "https://en.wikipedia.org/wiki/Matthews%2C_North_Carolina",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town’s first train arrived on December 15, 1874, a milestone that sparked rapid growth and earned Matthews the nickname “Stumptown” for its cleared cotton fields.",
      "sourceSentenceIds": [
        5,
        18
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 2"
      ],
      "source": "https://en.wikipedia.org/wiki/Matthews%2C_North_Carolina",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Matthews Heritage Museum, opened in 2013, preserves local history in downtown and is run by the Matthews Historical Foundation founded in 1987.",
      "sourceSentenceIds": [
        2,
        3,
        19
      ],
      "sourceLabels": [
        "Web source 1",
        "Web source 2"
      ],
      "source": "https://matthewsheritagemuseum.org/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "A 1996 National Register listing protects ten historic Trade Street buildings, including the Outen Pottery on Jefferson Street.",
      "sourceSentenceIds": [
        20,
        21
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://belocalpub.n2pub.com/locations/belocal-charlotte-se-suburbs-nc/articles/-7af9b4/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Matthews hosts Stumptown Athletic, a professional soccer club that began play in 2019 in the National Independent Soccer Association.",
