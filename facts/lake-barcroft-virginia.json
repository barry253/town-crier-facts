  "facts": [
    {
      "id": 1,
      "text": "Lake Barcroft was created when the Alexandria Water Company built a dam on Holmes Run in 1915, forming a 620‑million‑gallon reservoir.",
      "sourceSentenceIds": [
        17,
        18
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Lake_Barcroft%2C_Virginia",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "In 1942 the dam was raised by five feet, expanding the lake to 800 million gallons and adding 24 gates for better water control.",
      "sourceSentenceIds": [
        19
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Lake_Barcroft%2C_Virginia",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "After Hurricane Agnes in 1972 flooded the lake above the dam, the community rebuilt the damaged spillway and the lake remained dry for two years.",
      "sourceSentenceIds": [
        25,
        26,
        27,
        29
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Lake_Barcroft%2C_Virginia",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The Lake Barcroft Community Association, founded in the early 1950s, later became the Lake Barcroft Association that manages the lake and surrounding common grounds.",
      "sourceSentenceIds": [
        23,
        24
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Lake_Barcroft%2C_Virginia",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The lake’s name honors Dr. Barcroft, a 19th‑century mill owner who built his home on the site and helped establish the early community.",
      "sourceSentenceIds": [
        1,
        16
      ],
      "sourceLabels": [
        "Web source 1",
        "Wikipedia"
      ],
      "source": "https://lakebarcroft.org/about",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Lake Barcroft sits on 680 acres that were purchased for $1 million in 1949 and later sold to residents for $300,000 in 1970, turning the area into a planned residential community.",
      "sourceSentenceIds": [
        21,
        22,
        24
