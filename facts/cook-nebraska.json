      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "When the first Missouri Pacific train arrived in November 1888, Cook’s growth pushed the Spring Creek Post Office to relocate there.",
      "sourceSentenceIds": [
        11
      ],
      "sourceLabels": [
