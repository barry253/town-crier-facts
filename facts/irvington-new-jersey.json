  "facts": [
    {
      "id": 1,
      "text": "Irvington was settled in 1666 as Camptown, a land grant from Sir George Carteret, before being renamed in 1852 for author Washington Irving.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.britannica.com/place/Irvington-New-Jersey",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "In 1800, the new fast‑mail line from Philadelphia to New York City chose Irvington as a relay station, boosting its early growth.",
      "sourceSentenceIds": [
        15
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://irvingtonnj.gov/history-of-irvington/",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "From 1887 to 1965, Irvington hosted Olympic Park, a 40‑acre amusement park that straddled its border with Maplewood.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Irvington%2C_New_Jersey",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The town incorporated as an independent village on March 27, 1874, separating from Clinton Township after a long period as Camptown.",
      "sourceSentenceIds": [
        21
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Irvington%2C_New_Jersey",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "After the park closed, its famous merry‑go‑round was sold and transported to Disney World in Orlando, FL.",
