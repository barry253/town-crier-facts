  "facts": [
    {
      "id": 1,
      "text": "Onawa was founded in 1857 and platted by the Monona County Land Company.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.onawa.com/history"
    },
    {
      "id": 2,
      "text": "The town was named after a character in Henry Wadsworth Longfellow's poem The Song of Hiawatha.",
      "sourceSentenceIds": [
        2,
        5
      ],
      "sourceLabels": [
        "Web source 2",
        "Wikipedia"
      ],
      "source": "https://www.onawa.com/history"
    },
    {
      "id": 3,
      "text": "Onawa boasts the widest main street in the continental United States, a quirky claim that draws curious visitors.",
      "sourceSentenceIds": [
        1,
        16
      ],
      "sourceLabels": [
        "Web source 2",
        "Wikipedia"
      ],
      "source": "https://www.onawa.com/history"
    },
    {
      "id": 4,
      "text": "The Monona County Courthouse, built in 1891–1892, showcases Richardsonian Romanesque architecture and stands as a local landmark.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.onawa.com/history"
    },
    {
      "id": 5,
      "text": "In 1867 the railway arrived, prompting the town to relocate from its original riverside site to its current location.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.onawa.com/history"
    },
    {
      "id": 6,
      "text": "During World War II, Onawa hosted a prisoner‑of‑war camp for German soldiers from 1944 to 1946.",
      "sourceSentenceIds": [
        17
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Onawa%2C_Iowa"
    }
  ]
