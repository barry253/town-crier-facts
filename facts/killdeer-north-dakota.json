  "facts": [
    {
      "id": 1,
      "text": "Killdeer was founded in 1914 when the Northern Pacific Railway extended a branch line to the town.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Killdeer%2C_North_Dakota",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town’s name comes from the Hidatsa phrase Cíìdadagi Arudíheesh, meaning “Where Deer Are Killed.”.",
      "sourceSentenceIds": [
        18
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Killdeer%2C_North_Dakota",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Killdeer Mountain Battlefield State Historic Site sits 8.5 miles northwest of the town, preserving the July 28, 1864 clash between General Sully’s troops and a Sioux encampment.",
      "sourceSentenceIds": [
        7,
        8
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.history.nd.gov/historicsites/kmb/index.html",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "After the battle, General Sully ordered troops to destroy abandoned village materials the next morning.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.history.nd.gov/historicsites/kmb/index.html",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The battlefield today still resembles its 1864 layout, despite modern roads, fences, farms, ranches, oil wells, and collection facilities.",
      "sourceSentenceIds": [
        12
      ],
