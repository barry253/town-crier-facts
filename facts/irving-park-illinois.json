  "facts": [
    {
      "id": 1,
      "text": "Irving Park takes its name from author Washington Irving, after a town with the same name already existed in Illinois.",
      "sourceSentenceIds": [
        2,
        30
      ],
      "sourceLabels": [
        "Wikipedia",
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Irving_Park%2C_Chicago"
    },
    {
      "id": 2,
      "text": "The Irving Park Historical Society, founded in 1984, preserves the neighborhood’s 19th‑century architecture and documents its rich heritage.",
      "sourceSentenceIds": [
        3,
        18
      ],
      "sourceLabels": [
        "Web source 2",
        "Wikipedia"
      ],
      "source": "https://oldirvingpark.com/history/"
    },
    {
      "id": 3,
      "text": "Developers convinced the Chicago & Northwestern Railroad to stop trains in Irving Park by building a station in the late 19th century.",
      "sourceSentenceIds": [
        6,
        8
      ],
      "sourceLabels": [
        "Web source 1",
        "Web source 2"
      ],
      "source": "https://www.portageparkchamber.org/history-irving-park"
    },
    {
      "id": 4,
      "text": "After the 1871 Chicago Fire, residents watched the flames from cupolas and soon built many modest yet distinctive homes in the area.",
      "sourceSentenceIds": [
        10,
        14,
        15
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1",
        "Web source 2"
      ],
      "source": "https://en.wikipedia.org/wiki/Irving_Park%2C_Chicago"
    },
    {
      "id": 5,
      "text": "Since the 1990s, Irving Park Road hosts a vibrant Serbian community, reflected in its cafés, restaurants, and cultural festivals.",
      "sourceSentenceIds": [
        11
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Irving_Park%2C_Chicago"
    },
    {
      "id": 6,
      "text": "The neighborhood’s streets showcase Craftsman and Prairie style homes, a hallmark of the early 20th‑century architectural movement.",
      "sourceSentenceIds": [
