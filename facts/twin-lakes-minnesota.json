    },
    {
      "id": 2,
      "text": "The town’s post office began as Nunda in 1859, switching to Twin Lakes in 1881.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.lakesnwoods.com/TwinLakes.htm"
    },
    {
      "id": 3,
      "text": "A railroad reached Twin Lakes in 1878, turning it into a railway village.",
