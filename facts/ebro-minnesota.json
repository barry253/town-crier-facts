    {
      "id": 1,
      "text": "Ebro, Minnesota, got its name from the Ebro River in Spain, a nod to European ties.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Ebro%2C_Minnesota"
    },
    {
      "id": 2,
      "text": "The arrival of the Great Northern Railway in the 1890s drew Scandinavian and German settlers to Ebro, turning it into a farming hub.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/ebro_minnesota"
    },
    {
      "id": 3,
      "text": "Before settlers, the Ojibwe Red Lake and Pembina bands inhabited the area that became Ebro.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/ebro_minnesota"
    },
    {
      "id": 4,
      "text": "Ebro experiences long, harsh winters with heavy snowfall and mild summers that rarely exceed 71.6°F.",
      "sourceSentenceIds": [
        19
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/ebro_minnesota"
    },
    {
      "id": 5,
      "text": "After WWII, mechanized farming reduced labor demand, prompting many Ebro residents to move to cities.",
