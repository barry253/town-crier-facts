  "facts": [
    {
      "id": 1,
      "text": "Callaway was named after William Rodger Callaway, a passenger agent for the Soo Line Railroad, and the township was organized in 1906.",
      "sourceSentenceIds": [
        1,
        2
      ],
      "sourceLabels": [
        "Web source 1",
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/callaway_minnesota",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Early settlers were largely Scandinavian, with Norwegians and Swedes leaving surnames like Eide, Granquist, and Londeen across the prairie.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/callaway_minnesota",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Callaway’s 120‑to‑140‑day frost‑free season limits crops to hardy varieties such as corn, soybeans, and small grains.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/callaway_minnesota",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The nearby Buffalo River, monitored by the USGS, provides water access but can flood due to its 91.9‑square‑mile drainage basin.",
      "sourceSentenceIds": [
        19
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/callaway_minnesota",
      "category": "nature",
      "quality": "poor",
      "qualityReason": "vague"
    },
    {
      "id": 5,
      "text": "Grasshopper infestations and the 1926‑1932 Dust Bowl caused widespread farm foreclosures, mirroring Callaway’s own struggles with unpayable mortgages.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 1"
