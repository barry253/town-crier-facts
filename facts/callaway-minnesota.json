    {
      "id": 1,
      "text": "Callaway was named after William Rodger Callaway, a passenger agent for the Soo Line Railroad, and the township was organized in 1906.",
      "sourceSentenceIds": [
        1,
        2
      ],
      "sourceLabels": [
        "Web source 1",
