  "facts": [
    {
      "id": 1,
      "text": "Cherry Valley became an official borough in 1909 after residents petitioned the court and ran a thirty‑day notice in the Butler Eagle.",
      "sourceSentenceIds": [
        21
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.butlereagle.com/20230411/cherry-valley-history-a-story-of-defiance-ingenuity/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town’s name honors Captain Jolly, a Revolutionary War veteran who planted cherry trees in the valley in the early 1800s.",
      "sourceSentenceIds": [
        24,
        25,
        26,
        27
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.butlereagle.com/20230411/cherry-valley-history-a-story-of-defiance-ingenuity/",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "At its centennial, Cherry Valley was the smallest borough in Butler County, home to just 72 residents.",
      "sourceSentenceIds": [
        14
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.butlereagle.com/20230411/cherry-valley-history-a-story-of-defiance-ingenuity/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "In the late 1900s, coal trucks began traveling over Cherry Valley’s roads instead of longer state routes.",
      "sourceSentenceIds": [
        28
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.butlereagle.com/20230411/cherry-valley-history-a-story-of-defiance-ingenuity/",
      "category": "other",
      "quality": "poor",
      "qualityReason": "other"
    },
    {
      "id": 6,
      "text": "The borough marked its 100th anniversary in 2009, featured in a Pennsylvania Magazine article titled “A visit to Pennsylvania’s smallest incorporated towns.”.",
