  "facts": [
    {
      "id": 1,
      "text": "Covenant Life, Alaska, emerged in the early 1970s as a remote communal settlement founded by adherents of The Move.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/covenant_life_alaska",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Covenant Life, Alaska, was founded by Fife, a former Baptist preacher who taught the end times were imminent and urged followers to relocate to isolated wilderness 'end‑time farms'.",
      "sourceSentenceIds": [
        29
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/covenant_life_alaska",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The surrounding Coast Mountains provide a backdrop of steep, glaciated peaks, influencing local hydrology through glacial melt and seasonal flooding risks.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/covenant_life_alaska",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Residents primarily engage in subsistence activities, small‑scale farming, and seasonal work, with limited infrastructure and no formal municipal services, underscoring its self‑reliant, faith‑driven character.",
      "sourceSentenceIds": [
        28
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/covenant_life_alaska",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Guided by church elders who enforce communal rules, Covenant Life emphasizes collective living and spiritual discipline in a remote, rural setting near the Chilkat River valley.",
      "sourceSentenceIds": [
        27
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/covenant_life_alaska",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Covenant Life sits between the Klehini River to the north and the Tsirku River to the south in northern Haines Borough, Alaska.",
      "sourceSentenceIds": [
        15
      ],
