  "facts": [
    {
      "id": 1,
      "text": "Nelson Township sits in Tioga County, Pennsylvania, right on the New York state line with the Town of Tuscarora to its north.",
      "sourceSentenceIds": [
        5,
        6
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Nelson_Township%2C_Pennsylvania",
      "category": "other",
      "quality": "poor",
      "qualityReason": "location_description"
    },
    {
      "id": 2,
      "text": "The village of Nelson was moved in the late 1970s when the Cowanesque Dam project flooded its original site.",
      "sourceSentenceIds": [
        16,
        17
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Nelson_Township%2C_Pennsylvania",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Hikers on the Tompkins Trail can still see the old main street of Nelson where the village once stood.",
      "sourceSentenceIds": [
        18,
        19
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Nelson_Township%2C_Pennsylvania",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Nelson Cemetery lies near the former church sites, marking where two churches once served the original village community.",
      "sourceSentenceIds": [
        20
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Nelson_Township%2C_Pennsylvania",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Nelson Township contains 252 housing units, spread out at an average density of about 22.3 per square mile.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Nelson_Township%2C_Pennsylvania",
      "category": "other",
      "quality": "poor",
      "qualityReason": "census_demographic"
    },
    {
      "id": 6,
      "text": "The township’s name, Nelson, echoes the common place name found in 52 other U.S. communities, though this one is uniquely in Pennsylvania.",
