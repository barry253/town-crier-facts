  "facts": [
    {
      "id": 1,
      "text": "IXL is a historical freedmen's town in Okfuskee County that originated as a rural community of African American farm families.",
      "sourceSentenceIds": [
        6,
        11
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 2"
      ],
      "source": "https://en.wikipedia.org/wiki/IXL%2C_Oklahoma"
    },
    {
      "id": 2,
      "text": "The town of IXL was settled on land allotments granted to Creek freedmen during the early nineteen hundreds.",
      "sourceSentenceIds": [
        11
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/ixl_oklahoma"
    },
    {
      "id": 3,
      "text": "One theory suggests the name IXL stands for Indian Exchange Land, referencing the town's location on Mvskoke land.",
      "sourceSentenceIds": [
        16
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/IXL%2C_Oklahoma"
    },
    {
      "id": 4,
      "text": "The IXL community once contributed funds to build a schoolhouse and a teacherage with support from the Rosenwald Fund.",
      "sourceSentenceIds": [
        29,
        30
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.okhistory.org/publications/enc/entry?entry=IX001"
    },
    {
      "id": 5,
      "text": "IXL features a humid subtropical climate with hot, humid summers and cool to mild winters with occasional freezes.",
