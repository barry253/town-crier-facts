      "category": "people",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Gackle’s close‑knit community reflects German and Russian roots, with Volga German settlers leaving architectural marks and German inscriptions on its First UCC Church.",
      "sourceSentenceIds": [
        3,
        14,
        23
      ],
