  "facts": [
    {
      "id": 1,
      "text": "The city is a historic mining settlement founded in 1859 during the Pike's Peak Gold Rush and came to be known as the 'Richest Square Mile on Earth'.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Central_City%2C_Colorado",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Central City was named a National Historic Landmark in 1961, and the historic buildings are protected by city ordinance.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.visitcentralcity.com/history",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Buildings were previously limited to heights of 53 feet (16 m), so as not to shadow the town's historic buildings.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Central_City%2C_Colorado",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The Teller House, Catholic church, Roworth's City Bakery, and several other structures survived the fire, while about 150 structures were destroyed.",
      "sourceSentenceIds": [
        28
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Central_City%2C_Colorado",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The Gilpin Historical Society offers tours of historic buildings like the Teller House, Opera House, and Thomas House.",
      "sourceSentenceIds": [
        15
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.visitcentralcity.com/history",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Central City is authentic Colorado, with the state’s Historical Preservation Office validating 294 buildings that date back more than 100 years.",
      "sourceSentenceIds": [
        19
      ],
      "sourceLabels": [
