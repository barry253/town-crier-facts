      "id": 1,
      "text": "Santa Clara was founded in 1777 by Spanish missionaries, centered around Mission Santa Clara de Asís.",
      "sourceSentenceIds": [
        4,
        5,
        7,
        10
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Santa_Clara%2C_California",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The city’s name honors Saint Clare of Assisi, the Italian saint known for piety.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://ohmyfacts.com/world/cities/30-facts-about-santa-clara/",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Santa Clara University, founded in 1851, is California’s oldest institution of higher learning and a Jesuit university.",
      "sourceSentenceIds": [
        9,
        11
      ],
      "sourceLabels": [
        "Web source 1",
        "Web source 2"
      ],
      "source": "https://ohmyfacts.com/world/cities/30-facts-about-santa-clara/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The Triton Museum of Art, located on the university campus, showcases American Indian, American, and European art collections.",
      "sourceSentenceIds": [
        12,
        24
      ],
      "sourceLabels": [
        "Web source 1",
        "Web source 2"
      ],
      "source": "https://ohmyfacts.com/world/cities/30-facts-about-santa-clara/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Santa Clara’s historic downtown once featured City Hall, Franck Building, and Santa Clara Theater, all razed during redevelopment.",
      "sourceSentenceIds": [
        16,
        17
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Santa_Clara%2C_California",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The Harris-Lass House Museum, built in 1865, is the last surviving farm site in Santa Clara and offers Victorian architecture.",
