  "facts": [
    {
      "id": 1,
      "text": "Cedartown earned its name from the red cedar timber that once lined the area.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Cedartown%2C_Georgia",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Cedartown’s Main Street, with its 1890s architecture, earned a spot on the National Register of Historic Places.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Cedartown%2C_Georgia",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The West Cinema, opened in 1941, remains a cherished mid‑century entertainment landmark in Cedartown.",
      "sourceSentenceIds": [
        22
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.downtowncedartown.com/visiting-c234e",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Passenger rail arrived early 20th century, but the 1969 end of the Silver Comet led to the depot’s demolition.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Cedartown%2C_Georgia",
      "category": "transport",
      "quality": "poor",
      "qualityReason": "route_only"
    },
    {
      "id": 5,
      "text": "The Polk County Historical Museum chronicles Cedartown’s industrial boom, from cotton mills to Goodyear factories.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.downtowncedartown.com/visiting-c234e",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Cedartown’s Main Street hosted Coca‑Cola production from 1886 until 1977, now honored in a local museum.",
