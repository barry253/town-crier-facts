  "facts": [
    {
      "id": 1,
      "text": "Millis-Clicquot takes its name from railroad executive Lansing Millis, who helped bring the railroad through the area in 1863.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/Millis,_Massachusetts"
    },
    {
      "id": 2,
      "text": "The Clicquot part of the name honors the Clicquot Club Company, a beverage maker founded there in 1881.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Millis-Clicquot%2C_Massachusetts"
    },
    {
      "id": 3,
      "text": "Early settlers built a fortified garrison house near South End Pond after the devastation of King Philip’s War.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/Millis,_Massachusetts"
    },
    {
      "id": 4,
      "text": "Once a textile and manufacturing hub along the Charles River, Millis has since become a primarily suburban residential town.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/Millis,_Massachusetts"
    },
    {
      "id": 5,
      "text": "The area that is now Millis was first part of Dedham, then Medfield, became Medway in 1713, and finally incorporated in 1885.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/Millis,_Massachusetts"
    },
    {
      "id": 6,
      "text": "The Fairbanks Palisade, the only surviving stone house in the area, stands as a reminder of frontier life during the 17th century.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/Millis,_Massachusetts"
    }
  ]
}
