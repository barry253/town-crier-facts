      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Every August, Orangeville hosts the Dufferin Film Festival, a showcase of independent cinema that began in 2024.",
      "sourceSentenceIds": [
        19
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Orangeville%2C_Ontario",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The Athlete Institute once housed the Orangeville A's, a professional basketball team that played in Canada’s National Basketball League.",
      "sourceSentenceIds": [
        10
