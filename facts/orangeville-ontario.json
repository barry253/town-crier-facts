      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The historic Opera House, restored in 1993–1994, sits on the second floor of Orangeville’s Town Hall.",
      "sourceSentenceIds": [
        14,
        18
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 2"
      ],
      "source": "https://en.wikipedia.org/wiki/Orangeville%2C_Ontario",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Andrew Carnegie helped fund Orangeville’s public library, which opened in 1908 on Broadway and Mill Street.",
      "sourceSentenceIds": [
        20,
        22
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 2"
