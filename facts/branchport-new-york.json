  "facts": [
    {
      "id": 1,
      "text": "Branchport began with a 1831 store called Esperanza, Spanish for 'hope,' around which the hamlet grew.",
      "sourceSentenceIds": [
        1,
        4
      ],
      "sourceLabels": [
        "Web source 1",
        "Wikipedia"
      ],
      "source": "https://grokipedia.com/page/branchport_new_york",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "From 1835 to 1922, Branchport served as a bustling steamboat port on Keuka Lake, ferrying passengers and produce.",
      "sourceSentenceIds": [
        12,
        27
      ],
      "sourceLabels": [
        "Web source 1",
        "Wikipedia"
      ],
      "source": "https://grokipedia.com/page/branchport_new_york",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Between 1913 and 1928, an 8½‑mile electric trolley ran from Penn Yan to Branchport, linking the hamlet to the Northern Central Railroad.",
      "sourceSentenceIds": [
        12,
        28
      ],
      "sourceLabels": [
        "Web source 1",
        "Wikipedia"
      ],
      "source": "https://grokipedia.com/page/branchport_new_york",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The Modeste Bedient Memorial Library opened its doors in 2006, continuing a library tradition that began with Branchport’s first library in 1913.",
      "sourceSentenceIds": [
        17
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.lifeinthefingerlakes.com/picturesque-branchport-tiny-hamlet-steeped-tradition/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Branchport lies within the Beddoe Tract, a 7,000‑acre parcel acquired in 1788 as part of the Phelps and Gorham Purchase.",
      "sourceSentenceIds": [
        2,
        24
      ],
      "sourceLabels": [
        "Web source 1",
        "Wikipedia"
      ],
      "source": "https://grokipedia.com/page/branchport_new_york",
      "category": "other",
      "quality": "poor",
      "qualityReason": "vague"
    },
    {
      "id": 6,
      "text": "Early industries—basket factory, foundry, spoke factory, planing mill, and harness shop—thrived until devastating fires in the 1890s and 1901.",
      "sourceSentenceIds": [
