  "facts": [
    {
      "id": 1,
      "text": "Belle Meade Plantation, now Belle Meade Historic Site and Winery, hosts a Victorian manor museum filled with Harding family artifacts.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Belle_Meade%2C_Tennessee",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Founded in 1807 by planter John Harding, the estate grew to an eight‑square‑mile thoroughbred breeding powerhouse before the Civil War.",
      "sourceSentenceIds": [
        23,
        29
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Belle_Meade%2C_Tennessee",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "During the Civil War, Union soldiers quartered at the mansion, pillaging it for weeks while the owner was imprisoned.",
      "sourceSentenceIds": [
        30
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Belle_Meade%2C_Tennessee",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "In 1906 financial setbacks led to subdivision of the plantation, and the city of Belle Meade incorporated in 1938 on part of that land.",
      "sourceSentenceIds": [
        24,
        25
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Belle_Meade%2C_Tennessee",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Belle Meade Boulevard ends at the main entrance to Percy Warner Park, the city’s largest park, where Richland Creek flows through the neighborhood.",
      "sourceSentenceIds": [
        7,
        26
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Belle_Meade%2C_Tennessee",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The Belle Meade Mansion, built in the 1820s by John Harding, remains a centerpiece for history lovers exploring the area.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
