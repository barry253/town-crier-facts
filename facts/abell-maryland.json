  "facts": [
    {
      "id": 1,
      "text": "Abell’s name comes from the Abell family, longtime owners of the Baltimore Sun papers, who once owned a large summer estate called Guilford.",
      "sourceSentenceIds": [
        17,
        18
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.abellimprovement.org/history-of-abell",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "In 1914, Terrapin Park opened north of 29th Street as a ballpark for the Federal League’s Baltimore Orioles before becoming Oriole Park.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.abellimprovement.org/history-of-abell",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The neighborhood’s grid street pattern dates back to the first quarter of the twentieth century, reflecting its early 1900s development.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.abellimprovement.org/history-of-abell",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "A 1922 church replaced a fifty‑year‑old tabernacle, marking a significant shift in the community’s religious architecture.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.abellimprovement.org/history-of-abell",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Remnants of older diagonal roads, like Merryman Lane and truncated Vineyard Lane, still trace the area’s original layout.",
      "sourceSentenceIds": [
        16
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.abellimprovement.org/history-of-abell",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Most homes in Abell are medium‑to‑large row houses, a style that was popular in the late nineteenth century.",
      "sourceSentenceIds": [
        19
      ],
