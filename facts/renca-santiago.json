  "facts": [
    {
      "id": 1,
      "text": "Renca was officially founded on May 6, 1894, becoming a new commune in Santiago.",
      "sourceSentenceIds": [
        1,
        8
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Renca",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The name Renca comes from a wild plant that once covered the area during pre‑Hispanic times.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://renca.cl/nuestra-historia/",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Cerro Renca, a prominent hill in the commune, offers panoramic views of northern Santiago and hosts several radio transmitters.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.traveldojo.com/renca/",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "In the late 1800s, Renca's land was prized for its fertile farms, with over a hundred agricultural properties valued at more than sixty thousand pesos each.",
      "sourceSentenceIds": [
        14
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://renca.cl/nuestra-historia/",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The arrival of the railway and the road from Cañadilla linked Renca to Santiago, sparking its early growth.",
      "sourceSentenceIds": [
        15
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://renca.cl/nuestra-historia/",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Early historians note that the Picunches and Spanish settlers fought over Renca’s lands, with the area playing a role in the 1541 destruction of Santiago.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Web source 1"
      ],
