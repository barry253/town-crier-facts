      "quality": "poor",
      "qualityReason": "location_description"
    },
    {
      "id": 5,
      "text": "The community sits in Clark Township, north of the Middle Fork of the Anderson River, a tributary that historically powered local mills.",
      "sourceSentenceIds": [
