  "facts": [
    {
      "id": 1,
      "text": "Coburg was first surveyed by Robert Hoddle in 1837‑1838, noting a sheep station by Mr Hyatt on Merri Creek’s east bank.",
      "sourceSentenceIds": [
        1,
        20
      ],
      "sourceLabels": [
        "Wikipedia",
