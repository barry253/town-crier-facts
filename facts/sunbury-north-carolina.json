  "facts": [
    {
      "id": 1,
      "text": "Sunbury was named after General Horatio Gates, the Revolutionary War commander who won Saratoga in 1777.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/sunbury_north_carolina",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town began as Sunsbury in the late 1600s on William Hunter’s land grants, a scattered crossroads in Cypress Swamp.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/sunbury_north_carolina",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Sunbury Academy opened in 1832 as one of the Albemarle region’s first coeducational schools, operating for seven years before private seminaries rose.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/sunbury_north_carolina",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The Sunbury High School complex, built in 1937 in Colonial Revival style, served grades 1‑12 until 1962, closed 1997, and earned National Register status in 2009.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/sunbury_north_carolina",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Before European contact, the Chowanoke and Tuscarora peoples inhabited the area, fishing, farming, and trading along its rivers and wetlands.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/sunbury_north_carolina",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Sunbury is a charming coastal town on North Carolina’s Outer Banks, offering history, culture, and outdoor activities.",
