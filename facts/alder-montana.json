  "facts": [
    {
      "id": 1,
      "text": "Alder, Montana, takes its name from Alder Creek, named by Henry Edgar in 1863, the site of Montana's second major gold discovery.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Alder%2C_Montana",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Alder served as the primary railroad terminus for Alder Gulch, shipping gold ore out and bringing vital supplies in.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://southwestmt.com/communities/details/?name=alder",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Alder hosts a gem mine that visitors can explore, offering a hands‑on look at the region's mineral treasures.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.visitmt.com/cities-towns/alder",
      "category": "landmark",
      "quality": "good",
      "qualityReason": "editorial_filler"
    },
    {
      "id": 4,
      "text": "Just five miles north of Alder lies Robber's Roost, an historic stage stop that once served travelers during the gold rush.",
      "sourceSentenceIds": [
        22
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.visitmt.com/cities-towns/alder",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The Ruby River skirts Alder's western edge, while the Ruby River Reservoir sits seven miles south, offering a scenic waterway nearby.",
