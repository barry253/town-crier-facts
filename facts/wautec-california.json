  "facts": [
    {
      "id": 1,
      "text": "Wautec sits on the Yurok Indian Reservation, about 20 miles downstream of Weitchpec along the Klamath River.",
      "sourceSentenceIds": [
        4,
        9
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Wautec%2C_California",
      "category": "other",
      "quality": "poor",
      "qualityReason": "location_description"
    },
    {
      "id": 2,
      "text": "The village was a historic hub for fishing salmon, sturgeon, and gathering mussels, seaweed, and acorns from the river.",
      "sourceSentenceIds": [
        20
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/wautec_california",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Old‑growth redwood forests surround Wautec, creating a biodiverse corridor that supports migratory species in the Klamath Basin.",
      "sourceSentenceIds": [
        16
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/wautec_california",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "In 2023 a $5 million state grant helped the Yurok Tribe beautify Wautec, adding a new restroom, upgraded basketball court, and playground equipment.",
      "sourceSentenceIds": [
        6,
        7
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/wautec_california",
      "category": "other",
      "quality": "poor",
      "qualityReason": "other"
    },
    {
      "id": 5,
      "text": "The Yurok, called Oohl in their language, maintained over 50 villages along the lower Klamath, with Wautec a key upriver settlement.",
      "sourceSentenceIds": [
