      "quality": "good"
    },
    {
      "id": 2,
      "text": "A post office has served Theodosia continuously since 1886, making it one of the oldest operating postal sites in the county.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Theodosia%2C_Missouri",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The village’s name may honor either Theodosia Herd, an early postmaster’s wife, or Theodosia Kirby, a postmaster’s daughter.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Theodosia%2C_Missouri",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Theodosia’s climate features four seasons, with an average yearly temperature of 61°F and about 43 inches of rainfall.",
      "sourceSentenceIds": [
        28
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://sierraozark.com/theodosia-at-a-glance",
