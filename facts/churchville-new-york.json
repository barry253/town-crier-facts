      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://churchvilleny.gov/history/",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "A 2003 historical walking tour of Churchville, earned by Nikki Torcelo for a Girl Scout Gold Award, highlights local heritage.",
      "sourceSentenceIds": [
        13
      ],
      "sourceLabels": [
