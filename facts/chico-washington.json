  "facts": [
    {
      "id": 1,
      "text": "Chico was named in 1889 after a Suquamish head chief, giving the town its distinctive Pacific Northwest heritage.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Chico%2C_Washington",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Situated on the Dyes Inlet waterfront, Chico lies just south of Silverdale, anchoring it to Puget Sound’s tidal waters.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Chico%2C_Washington",
      "category": "other",
      "quality": "poor",
      "qualityReason": "location_description"
    },
    {
      "id": 3,
      "text": "The historic Chico General Store, with its worn floorboards and the scent of fresh coffee mingling with salt air, remains a local landmark.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.wikixm.com/us/wa/chico/overview",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Chico’s social commerce thrives in its small‑town feel, where the general store beats a sprawling mall as the community’s gathering spot.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.wikixm.com/us/wa/chico/overview",
      "category": "other",
      "quality": "poor",
      "qualityReason": "editorial_filler"
    },
    {
      "id": 5,
      "text": "East of Chico borders Dyes Inlet, while westward it meets Camp Wesley Harris and Newberry Hill Heritage Park, framing the town’s natural edges.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Chico%2C_Washington",
      "category": "other",
      "quality": "poor",
      "qualityReason": "location_description"
    },
    {
      "id": 6,
      "text": "Daily life in Chico follows the gentle, reliable tempo of tides and changing seasons, echoing the Pacific Northwest’s rhythm.",
