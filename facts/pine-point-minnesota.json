  "facts": [
    {
      "id": 1,
      "text": "Pine Point sits within the White Earth Indian Reservation, a homeland carved out by the 1867 treaty that gathered displaced Ojibwe bands.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/pine_point_minnesota",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "In 1873, an agreement let the Otter Tail Pillager Chippewa move into Pine Point, turning the southeast quadrant into a Pillager Band stronghold.",
      "sourceSentenceIds": [
        14
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/pine_point_minnesota",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Early 20th‑century settlers in Pine Point were mainly Ojibwe from the Otter Tail Pillager Band and Leech Lake migrants who claimed allotted lands in Becker County.",
      "sourceSentenceIds": [
        15
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/pine_point_minnesota",
      "category": "people",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The community’s traditional economy thrives on wild rice harvesting, fishing, deer hunting, and maple sugaring, activities long practiced by Ojibwe families.",
      "sourceSentenceIds": [
        27
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/pine_point_minnesota",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The 2016 documentary The Seventh Fire follows a Native American gang rooted in Pine Point, spotlighting contemporary tribal challenges.",
      "sourceSentenceIds": [
        26
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Pine_Point%2C_Minnesota",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The 1889 Nelson Act split reservation lands, creating fractionated parcels that later became the basis of Pine Point’s farming community.",
