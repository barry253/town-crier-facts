  "facts": [
    {
      "id": 1,
      "text": "Ribera lies at the foot of Rowe Mesa along the Pecos River, 50 miles southeast of Santa Fe.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Ribera%2C_New_Mexico",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town is split by Interstate 25 and Route 3, the historic Route 66, and still shows old rusted cars and abandoned structures.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Ribera%2C_New_Mexico",
      "category": "other",
      "quality": "poor",
      "qualityReason": "vague"
    },
    {
      "id": 3,
      "text": "The San Miguel del Vado Church, a fortress‑like adobe with its original 1821 bell, is a National Historic District and still holds occasional services.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/ribera_new_mexico",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Ribera originated during the Spanish colonial era under the San Miguel del Vado Land Grant, covering the Pecos River Valley where the community grew.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/ribera_new_mexico",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "After Mexican independence in 1821, Ribera became a key port on the Santa Fe Trail, hosting a customs station from 1830 and reaching trade values of $250,000 by 1843.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/ribera_new_mexico",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The early 1900s federal surveys fenced common grazing lands, forcing many stock breeders to relocate or abandon operations, reshaping Ribera’s ranching economy.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Web source 2"
      ],
