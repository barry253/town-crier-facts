  "facts": [
    {
      "id": 1,
      "text": "Ranburne got its name in 1894, blending Randolph and Cleburne County names.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://encyclopediaofalabama.org/article/ranburne/"
    },
    {
      "id": 2,
      "text": "Before that, the town was called Lost Creek after a boy vanished down a nearby stream.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://encyclopediaofalabama.org/article/ranburne/"
    },
    {
      "id": 3,
      "text": "The present‑day town sits on the site of Cleburne County’s oldest settlement, founded around 1814.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://encyclopediaofalabama.org/article/ranburne/"
    },
    {
      "id": 4,
      "text": "The Southern Railway reached the area in the 1880s, linking Birmingham, Jefferson County, and Atlanta.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://encyclopediaofalabama.org/article/ranburne/"
    },
    {
      "id": 5,
      "text": "Ranburne prides itself on small‑town values that guide growth and preserve its heritage.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://ranburnealabama.com/"
    },
    {
      "id": 6,
      "text": "The town’s identity centers on preserving its historical, cultural, and natural heritage for future generations.",
      "sourceSentenceIds": [
