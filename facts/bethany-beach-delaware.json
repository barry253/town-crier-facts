  "facts": [
    {
      "id": 1,
      "text": "Founded in 1901 as a religious retreat, Bethany Beach grew into a seasonal resort drawing Mid‑Atlantic visitors each summer.",
      "sourceSentenceIds": [
        2,
        10
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://delaware.wiki/a/Bethany_Beach"
    },
    {
      "id": 2,
      "text": "The town incorporated in 1909 after the boardwalk was rebuilt in 1905 and a lifesaving station opened in 1907.",
      "sourceSentenceIds": [
        26
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Bethany_Beach%2C_Delaware"
    },
    {
      "id": 3,
      "text": "A 2007 manmade sand dune now protects the beach, replacing the original natural dune that once defined the town’s shoreline.",
      "sourceSentenceIds": [
        11
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://delaware.wiki/a/Bethany_Beach"
    },
    {
      "id": 4,
      "text": "The 1962 Ash Wednesday Storm was the most destructive in Bethany Beach history, striking the town in March 1962.",
      "sourceSentenceIds": [
        16
      ],
      "sourceLabels": [
