  "facts": [
    {
      "id": 1,
      "text": "Mifflinburg was named after Thomas Mifflin, Pennsylvania's first governor, when Youngmanstown and Rotestown merged in 1827.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.visitcentralpa.org/plan-your-trip-today/towns-and-countrysides/mifflinburg/",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town’s historic Heiss House and Buggy Shop are listed on the National Register of Historic Places, preserving its 19th‑century craftsmanship.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Mifflinburg%2C_Pennsylvania",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Rail service began in 1871 when the Lewisburg and Tyrone Railroad connected Mifflinburg to Lewisburg, later expanding west to Bellefonte.",
      "sourceSentenceIds": [
        9,
        11
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 2"
      ],
      "source": "https://en.wikipedia.org/wiki/Mifflinburg%2C_Pennsylvania",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The Mifflinburg Buggy Museum, housed in a former buggy shop, showcases the town’s legacy of carriage manufacturing.",
      "sourceSentenceIds": [
        19
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
