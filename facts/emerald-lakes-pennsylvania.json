  "facts": [
    {
      "id": 1,
      "text": "Emerald Lakes emerged in the 1970s as a planned residential and vacation community in the Pocono Mountains region.",
      "sourceSentenceIds": [
        1,
        12
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/emerald_lakes_pennsylvania"
    },
    {
      "id": 2,
      "text": "Five man-made lakes, including East Emerald Lake, serve as the central focal points for the community's layout.",
      "sourceSentenceIds": [
        18
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/emerald_lakes_pennsylvania"
    },
    {
      "id": 3,
      "text": "Pine Tree Lake and Brookdale Lake were constructed primarily for recreational and aesthetic purposes amid the wooded hills.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/emerald_lakes_pennsylvania"
    },
    {
      "id": 4,
      "text": "Emerald Lakes transitioned from a seasonal vacation destination to a year-round community during the 1980s tourism boom.",
      "sourceSentenceIds": [
        23
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/emerald_lakes_pennsylvania"
    },
    {
      "id": 5,
      "text": "The terrain of Emerald Lakes features Appalachian topography with elevations ranging from 1,600 to 2,000 feet above sea level.",
      "sourceSentenceIds": [
        17
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/emerald_lakes_pennsylvania"
    },
    {
      "id": 6,
      "text": "Founders established a private property owners' association to manage the community's shared governance and woodland amenities.",
