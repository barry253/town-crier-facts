  "facts": [
    {
      "id": 1,
      "text": "District Heights Apartments, later Woodland Springs, opened in phases from 1949 to 1951 as a 925‑unit Colonial Revival complex for veterans and federal workers.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/District_Heights,_Maryland",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "In 1946, the remaining 300 acres of undeveloped land were purchased by New York City builder Samuel R. Tepper, sparking the town’s growth.",
      "sourceSentenceIds": [
        16
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/District_Heights%2C_Maryland",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "By 1926, District Heights had about 25 homes, two businesses, a grocery store, a filling station, a pump house, and a free Model T bus.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/District_Heights%2C_Maryland",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The 1940s saw Cape Cod–style houses spring up in District Heights, built with Federal Housing Administration financing for returning veterans.",
      "sourceSentenceIds": [
        15
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/District_Heights%2C_Maryland",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The first streets of District Heights, Halleck and Aztec, were laid out by 1925, marking the town’s earliest organized layout.",
      "sourceSentenceIds": [
        14
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/District_Heights%2C_Maryland",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The District Heights library opened in 1987, honoring the area's 19th‑century Spaldings election district that later became Spauldings.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
