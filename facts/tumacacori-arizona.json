    {
      "id": 1,
      "text": "Tumacacori earned its name from a 1691 mission founded by Father Eusebio Kino, the first Spanish mission in southern Arizona.",
      "sourceSentenceIds": [
        4,
        5
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Tumacacori%2C_Arizona",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The ruins of Mission San José de Tumacácori, now a National Historical Park, survived until the 19th‑century Apache raids that halted its rebuilding.",
      "sourceSentenceIds": [
        3,
        24
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Tumacacori%2C_Arizona",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "O’odham, Yaqui, and Apache peoples mingled with Jesuit and Franciscan missionaries here, sometimes clashing, sometimes collaborating.",
      "sourceSentenceIds": [
        2,
        6
      ],
      "sourceLabels": [
        "Web source 2",
        "Web source 1"
      ],
      "source": "https://wnpa.org/explore-parks/tumacacori",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The park’s visitor center showcases exhibits on mission life, O’odham culture, and Spanish colonial history.",
      "sourceSentenceIds": [
        19
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://wnpa.org/explore-parks/tumacacori",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "A scenic riverside trail, the Anza Trail, follows part of the historic route Spanish settlers used to reach California.",
      "sourceSentenceIds": [
