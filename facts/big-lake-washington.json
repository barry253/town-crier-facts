  "facts": [
    {
      "id": 1,
      "text": "Big Lake’s historic heart sits on the lake’s north end, once a bustling logging town that vanished after a fire in the early 1900s.",
      "sourceSentenceIds": [
        5,
        16
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Big_Lake%2C_Washington",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The Big Lake Historical Society, founded in 2006, preserves the area’s heritage in a museum housed in the former 1928 elementary school.",
      "sourceSentenceIds": [
        4,
        25
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://museumsdatabase.com/museums/view/33421",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Every year the society hosts Heritage Day, showcasing demonstrations and displays that bring Big Lake’s logging, farming, and fishing past to life.",
      "sourceSentenceIds": [
        6,
        26
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://museumsdatabase.com/museums/view/33421",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Big Lake covers roughly 1,000 acres, making it a favorite spot for fishing, boating, and seasonal birdwatching.",
      "sourceSentenceIds": [
        30
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.trawellino.com/destinations/united-states/washington_big-lake",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "A 9‑hole golf course on the lake’s east side offers a quick round amid the community’s rural setting.",
      "sourceSentenceIds": [
        15
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Big_Lake%2C_Washington",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The community’s name, Big Lake, reflects the size of the water body that anchors the town’s identity.",
