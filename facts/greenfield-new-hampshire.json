      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Crotched Mountain Rehabilitation Center opened in 1953, expanded to serve adults by 1961, and now helps over 2,000 children and adults.",
      "sourceSentenceIds": [
        18,
