  "facts": [
    {
      "id": 1,
      "text": "Sylvania calls itself the \"Azalea and Dogwood City\" and the \"Welcome Station City.\".",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Sylvania%2C_Georgia"
    },
    {
      "id": 2,
      "text": "The town was founded in 1790 by settlers after the Revolutionary War.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Sylvania%2C_Georgia"
    },
    {
      "id": 3,
      "text": "The Sylvania Visitor Center is the only state visitor center still giving out free Coca‑Cola and Georgia peanuts.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://gastateparks.org/Sylvania"
    },
    {
      "id": 4,
      "text": "Historic Civil‑War era 12‑pound Napoleon cannons guard the northern end of town.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.cityofsylvaniaga.com/tourism-and-shopping.cfm"
    },
    {
      "id": 5,
      "text": "The old Georgia Welcome Station, the oldest such center in the U.S., offers free juice and soda and southern hospitality.",
      "sourceSentenceIds": [
        15
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.cityofsylvaniaga.com/tourism-and-shopping.cfm"
    },
    {
      "id": 6,
      "text": "The town’s name comes from Latin sylvan meaning \"forest land,\" reflecting its wooded heritage.",
