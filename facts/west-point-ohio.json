      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://kids.kiddle.co/West_Point,_Columbiana_County,_Ohio",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "West Point’s post office opened in 1836, closed in 1903, then reopened in 1955 and served residents until 2018.",
      "sourceSentenceIds": [
        24,
