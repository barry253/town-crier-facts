      "quality": "poor",
      "qualityReason": "route_only"
    },
    {
      "id": 3,
      "text": "A Civil War plaque marks the site where Confederate General John Hunt Morgan surrendered on July 26, 1863, just outside West Point.",
      "sourceSentenceIds": [
        27,
