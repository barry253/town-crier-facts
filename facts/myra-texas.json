  "facts": [
    {
      "id": 1,
      "text": "Myra sprang to life in 1887 when the Gainesville, Henrietta and Western Railway cut a line through the area, and it was christened after the superintendent’s daughter.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.tshaonline.org/handbook/entries/myra-tx"
    },
    {
      "id": 2,
      "text": "Nestled twelve miles west of Gainesville, Myra sits in the heart of Cooke County.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.tshaonline.org/handbook/entries/myra-tx"
    },
    {
      "id": 3,
      "text": "In 1898, one of Cooke County’s earliest oil wells was drilled right at Myra’s townsite.",
      "sourceSentenceIds": [
        27
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.tshaonline.org/handbook/entries/myra-tx"
    },
    {
      "id": 4,
      "text": "By 1902, Thad Harrison had installed a water system while Jack Felty wired a telephone line for the community.",
      "sourceSentenceIds": [
        30
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.tshaonline.org/handbook/entries/myra-tx"
    },
    {
      "id": 5,
      "text": "Aldridge, a rival town name, vanished when the post office refused to change Myra’s name, uniting the area under one banner.",
