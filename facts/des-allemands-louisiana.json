  "facts": [
    {
      "id": 1,
      "text": "Des Allemands translates from French as 'of the Germans,' reflecting its origins as a German immigrant settlement.",
      "sourceSentenceIds": [
        25
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Des_Allemands%2C_Louisiana",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Before the Civil War, a railroad depot opened in 1856, and the town’s post office began operating in 1868, later renamed Des Allemands in 1964.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/des_allemands_louisiana",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Des Allemands hosts an annual Catfish Festival featuring live music, carnival attractions, and catfish‑based recipes, a tradition started by Reverend William McCallion.",
      "sourceSentenceIds": [
        27
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Des_Allemands%2C_Louisiana",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Gertrude Catholic Church, founded in 1901, and public schools dating to 1879 illustrate the town’s Cajun and German‑influenced heritage.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/des_allemands_louisiana",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The town lies along Bayou des Allemands, the natural boundary separating Lafourche and St. Charles Parishes.",
      "sourceSentenceIds": [
        18
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Des_Allemands%2C_Louisiana",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Des Allemands originated as part of the German Coast, a 18th‑century settlement of German immigrants along the Mississippi River.",
      "sourceSentenceIds": [
        14
      ],
      "sourceLabels": [
        "Web source 2"
      ],
