  "facts": [
    {
      "id": 1,
      "text": "Harriman takes its name from E.H. Harriman, former president of the Union Pacific Railroad, whose estate Arden sat adjacent to the village.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Harriman%2C_New_York"
    },
    {
      "id": 2,
      "text": "The village was formerly known as Turner, named after Peter Turner's early restaurant, before residents voted 58 to 13 in 1910 to rename it Harriman after E.H. Harriman's death.",
      "sourceSentenceIds": [
        3,
        14
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Harriman%2C_New_York"
    },
    {
      "id": 3,
      "text": "In 1851, Erie Railroad executive Charles Minot issued the first train order ever sent by telegraph, wiring from what was then Turner Station to allow his train to proceed ahead of schedule.",
      "sourceSentenceIds": [
        5,
        6
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Harriman%2C_New_York"
    },
    {
      "id": 4,
      "text": "Harriman State Park, located just east of the village, is the second-largest state park in New York State.",
      "sourceSentenceIds": [
        22
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Harriman%2C_New_York"
    },
    {
      "id": 5,
      "text": "A former Erie Railroad right-of-way through Harriman has been converted into the 19.5-mile Heritage Trail, a shared-use path stretching to Middletown.",
      "sourceSentenceIds": [
        20
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
