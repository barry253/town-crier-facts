  "facts": [
    {
      "id": 1,
      "text": "Cassville was founded in 1845 and named after U.S. Senator Lewis Cass, becoming the county seat of Barry County.",
      "sourceSentenceIds": [
        1,
        2,
        13,
        20,
        22
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Cassville%2C_Missouri",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "During the Civil War, Cassville was nearly destroyed by Union and Confederate forces, including the 1861 Battle of Little Blue, yet it rebuilt with a short‑line railroad.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/Cassville,_Missouri",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Cassville briefly served as Missouri's second Confederate capitol from Oct 31 to Nov 7, 1861, when a pro‑Confederate convention met in the courthouse.",
      "sourceSentenceIds": [
        14,
        28
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Cassville%2C_Missouri",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Cassville hosts a branch of the Barry‑Lawrence Regional Library, offering a public library that serves the community.",
      "sourceSentenceIds": [
        16
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Cassville%2C_Missouri",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Cassville Municipal Airport sits two miles northwest of town, providing general aviation services to the area.",
      "sourceSentenceIds": [
        17
