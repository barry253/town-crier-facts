  "facts": [
    {
      "id": 1,
      "text": "Silvana was named for its beautiful sylvan surroundings by early settlers who loved the lush forested area.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://pacific-hwy.net/silvana.htm",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town sprang up after the Great Northern railroad reached the area in 1891, prompting a rapid layout called Silvana.",
      "sourceSentenceIds": [
        3,
        4
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://pacific-hwy.net/silvana.htm",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Silvana sits on the old Great Northern line, now BNSF, 52 miles north of Seattle, serving surrounding farms and ranches.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://pacific-hwy.net/silvana.htm",
      "category": "other",
      "quality": "poor",
      "qualityReason": "location_description"
    },
    {
      "id": 4,
      "text": "The historic grain elevator, a long‑standing landmark, still stands on the south side of the highway beside the tracks.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://pacific-hwy.net/silvana.htm",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Silvana Island lies in the Stillaguamish River floodplain, with the main channel north of the island and South and Cook Sloughs forming its boundaries.",
      "sourceSentenceIds": [
        9,
        10,
        11
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Silvana%2C_Washington",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The Stillaguamish post office, established in 1888 in a store on the road to Stanwood, marked the first commercial spot that would become Silvana.",
