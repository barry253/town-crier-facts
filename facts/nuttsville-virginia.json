      "quality": "poor",
      "qualityReason": "location_description"
    },
    {
      "id": 3,
      "text": "Nuttsville’s sandy loam soils drain well, supporting the region’s long‑standing tobacco and grain farming traditions.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/nuttsville_virginia",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The Rappahannock River’s proximity means occasional flooding and hurricane surges are natural hazards for the low‑lying area.",
      "sourceSentenceIds": [
        25
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/nuttsville_virginia",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "In the 1800s, a two‑story wood‑frame post office doubled as a general store, exemplifying rural postal architecture.",
      "sourceSentenceIds": [
        16
      ],
      "sourceLabels": [
        "Web source 1"
      ],
