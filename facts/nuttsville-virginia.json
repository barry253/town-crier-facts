      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The community sits at the crossroads of Virginia State Route 354 and Route 619, a historic agricultural hub on the Northern Neck.",
      "sourceSentenceIds": [
        20
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/nuttsville_virginia",
