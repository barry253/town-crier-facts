    {
      "id": 1,
      "text": "Clovis was founded in 1891 by Marcus Pollasky and Fresno investors, who named it after Pollasky's partner Clovis M.",
      "sourceSentenceIds": [
        6,
        10,
        15
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.clovisca.gov/tourism/plan_your_stay/about_clovis.php",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Clovis began as a freight stop on the San Joaquin Valley Railroad, constructed by Marcus Pollasky and Michigan lumbermen in 1890.",
      "sourceSentenceIds": [
        19,
        20,
        8
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Clovis%2C_California",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The original depot, now a historic landmark, still stands near the old station site in downtown Clovis.",
      "sourceSentenceIds": [
        14
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Clovis%2C_California",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Clovis Rodeo Grounds and Clark Intermediate School sit on the former planing mill that once processed lumber from the Sierra Nevada.",
      "sourceSentenceIds": [
        12,
        16
      ],
      "sourceLabels": [
        "Wikipedia",
