  "facts": [
    {
      "id": 1,
      "text": "Orme grew from Needmore, renamed by Richard Orme Campbell after his son, whose mother’s maiden name was Orme.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Orme%2C_Tennessee",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "In 1902, Frederick Gates secured a Nashville, Chattanooga & St. Louis Railway branch, turning the remote valley into a coal‑shipping hub.",
      "sourceSentenceIds": [
        27,
        28
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Orme%2C_Tennessee",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "By 1905, Battle Creek Coal & Coke Company was extracting about 1,000 tons of Sequatchie Valley coal daily, the best domestic coal in the area.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.historicsouthpittsburgtn.org/OrmeTennesseeHistory1.html",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Orme’s original mining company, Needmore, was sold to Gates in the late 1890s, sparking the town’s rapid growth to several thousand residents within a few years.",
