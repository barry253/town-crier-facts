      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The former Ely School House, now the Ely Community Center, earned National Register of Historic Places status on September 20, 2006.",
      "sourceSentenceIds": [
        20
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Ely%2C_Iowa",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The Ely Community History Society, housed on the lower floor of the Community Center, preserves archives and displays historic wall panels.",
      "sourceSentenceIds": [
        2,
        9
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.elyhistory.com/p/welcome.html",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Ely’s heritage is deeply rooted in Czech immigration, shaping a distinct ethnic identity documented throughout the town’s history.",
      "sourceSentenceIds": [
        11
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.elyhistory.com/p/welcome.html",
