  "facts": [
    {
      "id": 1,
      "text": "Fort Sheridan was named after Civil War cavalry general Philip Sheridan to honor his services to Chicago.",
      "sourceSentenceIds": [
        1,
        2
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Fort_Sheridan%2C_Illinois"
    },
    {
      "id": 2,
      "text": "The 110‑acre Historic District, listed on the National Register in 1980, became a National Historic Landmark in 1984.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.historyillinois.org/historical-markers/fort-sheridan"
    },
    {
      "id": 3,
      "text": "Holabird & Roche designed 64 of the fort’s 94 buildings, creating a cohesive architectural ensemble on the 110‑acre district.",
      "sourceSentenceIds": [
        15
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://friendsofhistoricfortsheridan.org/fort-history"
    },
    {
      "id": 4,
      "text": "The water tower, once the tallest structure in the Chicago area, was shortened by 60 feet in 1940.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.historyillinois.org/historical-markers/fort-sheridan"
    },
    {
      "id": 5,
      "text": "After the army closed in 1993, the fort’s residential enclave now houses active duty and guard families for the nearby Great Lakes Navy Training Center.",
      "sourceSentenceIds": [
        21
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Fort_Sheridan%2C_Illinois"
    },
    {
      "id": 6,
      "text": "Fort Sheridan’s rugged ravines and heavy forestation made the land unsuitable for farming, preserving its natural landscape for military use.",
      "sourceSentenceIds": [
        19
