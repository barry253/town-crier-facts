  "facts": [
    {
      "id": 1,
      "text": "Matewan sits at the confluence of the Tug Fork River and Mate Creek in Mingo County, West Virginia.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Matewan%2C_West_Virginia"
    },
    {
      "id": 2,
      "text": "The town of Matewan was named after Matteawan, which is now called Beacon, in Dutchess County, New York.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Matewan%2C_West_Virginia"
    },
    {
      "id": 3,
      "text": "Matewan is known for its role in American labor history, specifically the 1920 Matewan Massacre during the West Virginia Mine Wars.",
      "sourceSentenceIds": [
        27
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://matewancvb.com/home"
    },
    {
      "id": 4,
      "text": "The center of Matewan is designated as the Matewan Historic District, which is a National Historic Landmark.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Matewan%2C_West_Virginia"
    },
    {
      "id": 5,
      "text": "The West Virginia Mine Wars Museum provides history on the intense labor conflicts that led to advancements in organization.",
      "sourceSentenceIds": [
        7,
        9
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 2"
      ],
      "source": "https://en.wikipedia.org/wiki/Matewan%2C_West_Virginia"
    },
    {
