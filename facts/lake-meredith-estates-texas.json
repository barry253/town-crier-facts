  "facts": [
    {
      "id": 1,
      "text": "Lake Meredith Estates sits on the shores of Lake Meredith, a reservoir formed by the Sanford Dam on the Canadian River.",
      "sourceSentenceIds": [
        21
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://meredith.uslakes.info/"
    },
    {
      "id": 2,
      "text": "The lake’s dramatic 200‑foot canyons were carved by the Canadian River over thousands of years, creating striking layers of color.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.nps.gov/lamr/index.htm"
    },
    {
      "id": 3,
      "text": "National Park Service provides five boat ramps, with launch fees of $4 per day or $10 for a three‑day period.",
      "sourceSentenceIds": [
        24,
        25
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://meredith.uslakes.info/"
    },
    {
      "id": 4,
      "text": "A $40 annual permit is available for boaters, renewable each January to enjoy the lake.",
      "sourceSentenceIds": [
        26
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://meredith.uslakes.info/"
    },
    {
      "id": 5,
      "text": "Shoreline access is limited because the reservoir’s sides are very steep, making most of the water’s edge inaccessible.",
      "sourceSentenceIds": [
        29
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://meredith.uslakes.info/"
    },
    {
      "id": 6,
      "text": "The lake supplies drinking water to Amarillo and Lubbock, making it a vital regional resource.",
      "sourceSentenceIds": [
