      "id": 1,
      "text": "Jeromesville takes its name from Jean‑Baptiste Jerome, a French‑Canadian fur trader who helped pioneer the area.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Jeromesville%2C_Ohio",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The village was officially platted in 1815, near a former Native‑American settlement once called Jerometown.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Jeromesville%2C_Ohio",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "A post office has been operating in Jeromesville since 1816, making it one of the oldest continuous postal services in the county.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Jeromesville%2C_Ohio",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Jeromesville was the first village in Ohio to codify a Junior Village Council into state law.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Jeromesville%2C_Ohio",
      "category": "history",
      "quality": "good"
    },
    {
