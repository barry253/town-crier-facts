  "facts": [
    {
      "id": 1,
      "text": "Ninety Six takes its name from a settlement located at the ninety-sixth milepost from the Keowee Indian village.",
      "sourceSentenceIds": [
        22
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://townofninetysix.sc.gov/local-history"
    },
    {
      "id": 2,
      "text": "Robert Gouedy established a permanent trading post in Ninety Six around 1751, dealing in cloth, beads, rum, and deerskins.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://sabrinas-town.vercel.app/towns/ninety-six-sc/history"
    },
    {
      "id": 3,
      "text": "Ninety Six grew into the most significant hub of commerce and political authority in the Carolina backcountry before the Revolution.",
      "sourceSentenceIds": [
        29
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://sabrinas-town.vercel.app/towns/ninety-six-sc/history"
    },
    {
      "id": 4,
      "text": "The Ninety Six National Historic Site preserves the location of the original settlement and a British fort.",
      "sourceSentenceIds": [
        11
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Ninety_Six%2C_South_Carolina"
    },
    {
      "id": 5,
      "text": "Ninety Six shifted two miles eastward in 1852 when the Greenville-Columbia Railroad was constructed.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://townofninetysix.sc.gov/local-history"
    },
    {
      "id": 6,
      "text": "The Historic Ninety Six Mill Village still contains many original homes from the era of the town's textile mills.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Ninety_Six%2C_South_Carolina"
