  "facts": [
    {
      "id": 1,
      "text": "Alexander village was named after pioneer Alexander Rea, who bought 28.1 acres in 1802 for just $56.20.",
      "sourceSentenceIds": [
        7,
        8
      ],
      "sourceLabels": [
        "Web source 1",
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/alexander_village_new_york",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The village’s charter, granted in 1834, is one of only twelve original New York village charters still in use today.",
      "sourceSentenceIds": [
        25
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/alexander_village_new_york",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Railroad service began in 1843 when the Buffalo‑Rochester line reached Alexander, opening two stations on Railroad Avenue.",
      "sourceSentenceIds": [
        24
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/alexander_village_new_york",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The Alexander Museum showcases a collection of farm and work tools that paint a vivid picture of rural life in the 19th and early 20th centuries.",
      "sourceSentenceIds": [
        20,
        21
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://visitgeneseeny.com/blog/discovering-alexander-ny-a-journey-of-history-and-charm",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Alexander sits on the Hudson River’s western bank, just two miles east of Rhinecliff’s Amtrak station.",
