  "facts": [
    {
      "id": 1,
      "text": "McVeytown is a borough in Mifflin County, Pennsylvania, on the west bank of the Juniata River.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/McVeytown%2C_Pennsylvania"
    },
    {
      "id": 2,
      "text": "The town was originally called Waynesburg, settled in 1762, laid out in 1795, and incorporated in 1833.",
      "sourceSentenceIds": [
        6,
        9
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/McVeytown%2C_Pennsylvania"
    },
    {
      "id": 3,
      "text": "Joseph Rothrock, known as the “Father of Pennsylvania Forestry,” was born in McVeytown on April 9, 1839.",
      "sourceSentenceIds": [
        7,
        8
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/McVeytown%2C_Pennsylvania"
    },
    {
      "id": 4,
      "text": "The borough’s name comes from John McVey, who owned the land and founded the settlement.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/McVeytown%2C_Pennsylvania"
    },
    {
      "id": 5,
      "text": "Samuel Holliday began the area’s settlement in 1755, moving permanently in 1762, and laid out the town that would become McVeytown.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/McVeytown%2C_Pennsylvania"
    },
    {
      "id": 6,
      "text": "McVeytown sits between Harrisburg and State College, bordered by the picturesque Juniata River.",
      "sourceSentenceIds": [
        28
      ],
