  "facts": [
    {
      "id": 1,
      "text": "Elsinore was named by Danish settlers after Kronborg Castle, the historic home of Shakespeare’s Hamlet, reflecting the town’s Danish roots.",
      "sourceSentenceIds": [
        1,
        14
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Elsinore%2C_Utah",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The first passenger train rolled into Elsinore on July 21, 1896, linking the town to the Denver & Rio Grande Railroad.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Elsinore%2C_Utah",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "From 1911 to 1929, Elsinore housed a Utah‑Idaho Sugar Company factory that processed sugar beets until a blight forced its closure.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Elsinore%2C_Utah",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "In late September and early October 1921, Elsinore trembled under two magnitude‑six earthquakes, damaging buildings but sparing lives.",
      "sourceSentenceIds": [
        15,
        16
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Elsinore%2C_Utah",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Elsinore’s first library began in the basement of its public school, starting with a modest collection of 1,000 books.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Elsinore%2C_Utah",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Today, Elsinore supports local artists through a small gallery and gift shop that showcases regional talent.",
