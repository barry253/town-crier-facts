      "id": 1,
      "text": "New Hartford, New York was settled in March 1788 by Jedediah Sanger, who moved to the area after losing his farm in New Hampshire.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/New_Hartford%2C_New_York",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The name New Hartford was given by a settler family from Hartford, Connecticut, reflecting the town's historical connections.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/New_Hartford%2C_New_York",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "New Hartford, New York covers over 16,000 acres, significantly more than the original land purchased by Sanger.",
      "sourceSentenceIds": [
        21
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/New_Hartford%2C_New_York",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The town of New Hartford contains a village also named New Hartford, showcasing its unique local governance structure.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/New_Hartford%2C_New_York",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "New Hartford is the largest suburb of Utica, located just five miles northeast of the town and village.",
      "sourceSentenceIds": [
        4
