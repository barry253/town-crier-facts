  "facts": [
    {
      "id": 1,
      "text": "Monett was named after Henry Monett, a popular general station agent for several railroads, including the New York, Chicago and St. Louis Railroad.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Monett%2C_Missouri",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town earned the nickname “Strawberry Capital of the Midwest” from a thriving fruit business; the 1927 Ozark Fruit Growers Association building anchors the Downtown Monett Historic District.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Monett%2C_Missouri",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Recent revitalization projects in Monett’s historic downtown restored architectural quality and boosted local businesses, giving the area a fresh cultural scene.",
      "sourceSentenceIds": [
        9,
        10
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Monett%2C_Missouri",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Monett’s high school football team, the Monett Cubs, was inducted into the Missouri Sports Hall of Fame in 2018 for its long‑standing success since 1927.",
