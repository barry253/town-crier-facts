  "facts": [
    {
      "id": 1,
      "text": "Blairs takes its name from John Christian Blair, honored when a post office opened there in 1927.",
      "sourceSentenceIds": [
        5,
        19
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.chathamstartribune.com/opinion/article_de392990-825b-11ef-a169-bf809388cdb0.html",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "A railroad once ran north from Danville, curving left past Fall Creek Depot before crossing White Oak Mountain into Blairs.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.chathamstartribune.com/opinion/article_de392990-825b-11ef-a169-bf809388cdb0.html",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Fertile soils in Pittsylvania County turned Blairs into a tobacco hub, with plantations and family farms shaping the landscape.",
      "sourceSentenceIds": [
        6,
        7
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://usapulse.blog/blairs-virginia-5-hidden-charms-guide",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The Civil War left an indelible mark on Blairs, as the town and surrounding county endured the conflict’s upheaval.",
      "sourceSentenceIds": [
        8,
        9
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://usapulse.blog/blairs-virginia-5-hidden-charms-guide",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "A Virginia Historical Marker across from the post office marks where the original tavern stood, honoring early settlers.",
      "sourceSentenceIds": [
        18
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.chathamstartribune.com/opinion/article_de392990-825b-11ef-a169-bf809388cdb0.html",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Blairs’ resilient spirit traces back to its tobacco‑driven agriculture, which shaped property lines, governance, and a labor force built on slavery.",
