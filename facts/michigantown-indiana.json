  "facts": [
    {
      "id": 1,
      "text": "Michigantown got its name from the Michigan Road, an early thoroughfare that ran through the area.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Michigantown%2C_Indiana",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Joseph Hill and Robert Edwards laid out the town in 1830, placing lots on both sides of the Michigan Road.",
      "sourceSentenceIds": [
        3,
        4
      ],
      "sourceLabels": [
        "Web source 2",
        "Wikipedia"
      ],
      "source": "https://kids.kiddle.co/Michigantown,_Indiana",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "In 1912 the Marion, Kokomo and Frankfort Electric Railroad built a line that ran right next to the existing railroad through town.",
      "sourceSentenceIds": [
        5,
