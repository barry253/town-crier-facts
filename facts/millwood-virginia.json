  "facts": [
    {
      "id": 1,
      "text": "The Burwell‑Morgan Mill, built in 1785, offers live grinding demonstrations every Saturday at 11 a.m. on its 400‑acre grounds.",
      "sourceSentenceIds": [
        17
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://experienceclarkecounty.com/explore-outdoors/towns-villages/millwood/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Long Branch House, a 200‑year‑old mansion, welcomes visitors to guided tours that showcase its historic architecture and art gallery.",
      "sourceSentenceIds": [
        15
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://experienceclarkecounty.com/explore-outdoors/towns-villages/millwood/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Locke’s Store, a gourmet country market operating since 1836, sits just across from the mill and serves Virginia wines, deli sandwiches, and homemade desserts.",
      "sourceSentenceIds": [
        21
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://experienceclarkecounty.com/explore-outdoors/towns-villages/millwood/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Millwood hosts several Clarke County historic sites, including the Burwell‑Morgan Mill, Carter Hall, Long Branch Plantation, Old Chapel, and the River House.",
      "sourceSentenceIds": [
        11
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Millwood%2C_Virginia",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The Clarke County Historical Association frequently stages historical reenactments and events at the mill, drawing history enthusiasts to Millwood.",
