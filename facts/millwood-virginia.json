      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Locke\u2019s Store, a gourmet country market operating since 1836, sits just across from the mill and serves Virginia wines, deli sandwiches, and homemade desserts.",
      "sourceSentenceIds": [
        21
      ],
      "sourceLabels": [
