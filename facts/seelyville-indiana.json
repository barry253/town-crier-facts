    },
    {
      "id": 2,
      "text": "When the Terre Haute and Eastern Railroad crossed the south side of town, it hired Jonas Seely as station master.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
