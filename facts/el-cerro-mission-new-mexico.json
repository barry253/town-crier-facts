  "facts": [
    {
      "id": 1,
      "text": "El Cerro Mission sits about 25 miles south of Albuquerque, named after the nearby 400‑foot basalt hill, El Cerro de Tomé.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/el_cerro_mission_new_mexico",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Every Good Friday, hundreds gather on El Cerro de Tomé to reenact the Stations of the Cross in a historic pilgrimage.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/el_cerro_mission_new_mexico",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The hill’s slopes hold petroglyphs from 3000 BC to the 17th century, blending Native cosmology with later Christian symbols.",
      "sourceSentenceIds": [
        24
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/el_cerro_mission_new_mexico",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "In 1659, soldier Tomé Domínguez de Mendoza received a land grant that placed El Cerro de Tomé along the El Camino Real de Tierra Adentro.",
      "sourceSentenceIds": [
        25
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/el_cerro_mission_new_mexico",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "After World War II, the 1950s saw a revival when Edwin Berry installed permanent crosses and a masonry shrine on the summit.",
      "sourceSentenceIds": [
