      "quality": "poor",
      "qualityReason": "route_only"
    },
    {
      "id": 4,
      "text": "East Ellijay sits roughly 70 miles north of Atlanta, placing it within easy reach of the city yet far enough to feel remote.",
      "sourceSentenceIds": [
        23
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.eastellijay.org/",
      "category": "other",
      "quality": "poor",
      "qualityReason": "location_description"
    },
    {
      "id": 5,
      "text": "Route 76 runs along the northern edge of East Ellijay, sharing the path of Routes 5/515.",
