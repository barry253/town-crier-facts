      "id": 1,
      "text": "East Ellijay began as Fort Hetzel, a 1838 Cherokee removal fort that housed Native Americans before the Trail of Tears.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
