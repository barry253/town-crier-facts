  "facts": [
    {
      "id": 1,
      "text": "South Cairo was founded in 1803 as part of the Town of Cairo, originally called Canton, carved from Coxsackie, Freehold, and Catskill.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/south_cairo_new_york",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "James Barker’s 1765 purchase of 6,000 acres along Catskill Creek sparked the first organized European settlement near what would become South Cairo.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/south_cairo_new_york",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "In 1885 the Catskill Mountain Railroad extended a branch to Cairo, enabling timber, bluestone, hay, and fruit to reach Catskill Landing and spurring local mill development.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/Cairo,_New_York",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The area’s wetlands and floodplains along Catskill Creek and Shingle Kill recharge aquifers and provide flood control, though seasonal flooding remains a risk.",
      "sourceSentenceIds": [
        11
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/south_cairo_new_york",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Before European arrival, the Mahican people used the South Cairo landscape seasonally for fishing and as a trade route between the Hudson and Delaware valleys.",
      "sourceSentenceIds": [
        12,
        13
      ],
      "sourceLabels": [
        "Web source 1"
      ],
