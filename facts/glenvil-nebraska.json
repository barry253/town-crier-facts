  "facts": [
    {
      "id": 1,
      "text": "Glenvil was founded in 1873 when the St. Joseph & Denver City Railroad reached the site, prompting a depot and section house.",
      "sourceSentenceIds": [
        1,
        2
      ],
      "sourceLabels": [
        "Web source 1",
        "Wikipedia"
      ],
      "source": "https://www.villageofglenvil.org/history",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Glenvil’s first substantial school, the Glenville School, operated from 1903 to 1995 and is now listed on the National Register of Historic Places.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Glenvil%2C_Nebraska",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "In 1997, Glenvil residents sent letters to celebrities asking for money to build a playground, and Microsoft chairman Bill Gates sent a $5,000 check.",
      "sourceSentenceIds": [
        15,
        16
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Glenvil%2C_Nebraska",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "After Gates’ donation, Glenvil school alumnus Merle Hinrichs mailed a $20,000 check to help finish the playground.",
      "sourceSentenceIds": [
