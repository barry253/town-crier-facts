  "facts": [
    {
      "id": 1,
      "text": "Ball Ground earned its name from a Cherokee ballgame played on the site, a tradition that still echoes in the town’s name.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Ball_Ground%2C_Georgia",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "A railroad stop built in 1882 sparked the town’s founding, and the depot remains a historic landmark today.",
      "sourceSentenceIds": [
        16,
        18,
        19
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Ball_Ground%2C_Georgia",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The town hosted a Coca‑Cola bottling plant from 1903 to 1933, a key part of its early industrial era.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Ball_Ground%2C_Georgia",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Marble from Tate, Georgia was shipped through Ball Ground and finished in local marble companies, giving the town a distinctive stone industry.",
      "sourceSentenceIds": [
        26
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Ball_Ground%2C_Georgia",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The Ball Ground Historic District was listed on the National Register in 2009, preserving homes built between the 1880s and 1920s.",
      "sourceSentenceIds": [
        29,
        30
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Ball_Ground%2C_Georgia",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "In 2015 Universal Alloy Corporation opened a factory in Ball Ground to supply Boeing with aircraft wing parts, linking the town to modern aerospace.",
