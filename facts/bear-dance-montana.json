  "facts": [
    {
      "id": 1,
      "text": "Bear Dance got its name from an 1891 incident when settlers shared bear meat and danced in celebration.",
      "sourceSentenceIds": [
        7,
        8
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/bear_dance_montana",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "A 1909 Forest Service cabin, later moved to a local ranch in 1958, still stands as the historic Bear Dance cabin.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/bear_dance_montana",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Bear Dance sits on Flathead Lake’s east shore, the largest natural freshwater lake west of the Mississippi River.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/bear_dance_montana",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The area that became Bear Dance was long inhabited by the Confederated Salish and Kootenai Tribes, who have lived there for thousands of years.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/bear_dance_montana",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Bear Dance experiences a humid continental climate, with cold snowy winters and mild summers kept temperate by Flathead Lake’s thermal mass.",
      "sourceSentenceIds": [
        16
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/bear_dance_montana",
      "category": "nature",
      "quality": "good"
    }
