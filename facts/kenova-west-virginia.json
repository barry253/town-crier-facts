  "facts": [
    {
      "id": 1,
      "text": "Kenova is situated at the confluence of the Ohio and Big Sandy rivers, marking the lowest point in western West Virginia.",
      "sourceSentenceIds": [
        7,
        9
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 2"
      ],
      "source": "https://en.wikipedia.org/wiki/Kenova%2C_West_Virginia"
    },
    {
      "id": 2,
      "text": "The name Kenova is a portmanteau of Kentucky, Ohio, and Virginia, reflecting the three states that met here.",
      "sourceSentenceIds": [
        5,
        19
      ],
      "sourceLabels": [
        "Web source 1",
        "Wikipedia"
      ],
      "source": "https://www.wvencyclopedia.org/entries/1144"
    },
    {
      "id": 3,
      "text": "Founded in the mid-nineteenth century, Kenova developed primarily as a railroad town and served as a terminal for several major lines.",
      "sourceSentenceIds": [
        1,
        13
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Kenova%2C_West_Virginia"
    },
    {
      "id": 4,
      "text": "The historic Dreamland pool in Kenova opened in 1925 and remains in operation today.",
      "sourceSentenceIds": [
        18
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.wvencyclopedia.org/entries/1144"
    },
    {
      "id": 5,
      "text": "The Miller House in Kenova is listed on the National Register of Historic Places and was once visited by President Grover Cleveland.",
      "sourceSentenceIds": [
        11
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Kenova%2C_West_Virginia"
    },
    {
      "id": 6,
      "text": "During the 1930s and 1940s, Kenova's pavilion dance floor attracted famous performers like Louis Armstrong and Frank Sinatra.",
