  "facts": [
    {
      "id": 1,
      "text": "Prairie View was founded on July 15, 1879, along the Rock Island Railroad, a vital line for early settlers.",
      "sourceSentenceIds": [
        1,
        3
      ],
      "sourceLabels": [
        "Web source 1",
        "Wikipedia"
      ],
      "source": "https://www.phillipscountyks.org/departments/tourism/history-of-prairie-view"
    },
    {
      "id": 2,
      "text": "The town was officially platted on September 24, 1887, by Daniel W. Thomas and the Kansas Town and Land Company.",
      "sourceSentenceIds": [
        23,
        24,
        25
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.phillipscountyks.org/departments/tourism/history-of-prairie-view"
    },
    {
      "id": 3,
      "text": "Prairie View sits twelve miles north of Logan at 39°40'57\" N, 99°18'39\" W, a clear marker on the map.",
      "sourceSentenceIds": [
        26
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.phillipscountyks.org/departments/tourism/history-of-prairie-view"
    },
    {
      "id": 4,
      "text": "The town’s first post office opened in July 1879, the same month the community was established.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Prairie_View%2C_Kansas"
    },
    {
      "id": 5,
      "text": "Prairie View High School, once known as the Prairie View Pirates, closed when schools unified in the region.",
      "sourceSentenceIds": [
        21,
