      ],
      "source": "https://www.mtmemory.org/nodes/view/128471",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Olaf Bergh opened a coal mine near Redstone that operated until the 1940s.",
      "sourceSentenceIds": [
        14
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.mtmemory.org/nodes/view/128471",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Redstone sits at the confluence of the Muddy River and Eagle Creek, surrounded by cattle country in the Big Muddy Creek badlands.",
      "sourceSentenceIds": [
        2,
        11
      ],
      "sourceLabels": [
        "Wikipedia",
