  "facts": [
    {
      "id": 1,
      "text": "Rose Valley was founded in 1901 as an Arts and Crafts community by architect William Lightfoot Price, who bought 80 acres around the former textile mill.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Rose_Valley%2C_Pennsylvania",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Price also co‑founded Arden, Delaware, a utopian single‑tax community based on Henry George’s economic model.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Rose_Valley%2C_Pennsylvania",
      "category": "people",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The Hedgerow Theatre, founded in 1923, remains a regional theatre that showcases works by local writers, painters, and architects.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Rose_Valley%2C_Pennsylvania",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The borough’s name traces back to land grants given by William Penn in 1681 to the Vernon brothers, who settled the area in 1682.",
      "sourceSentenceIds": [
        14
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.rosevalleyborough.org/history",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "A large portion of Rose Valley was placed on the National Register of Historic Places, preserving its historic landscape and architecture.",
      "sourceSentenceIds": [
        15
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.rosevalleyborough.org/history",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Rose Valley incorporated as a borough on December 23, 1923, separating from Middletown and Nether Providence Townships.",
      "sourceSentenceIds": [
        18
