      "quality": "good"
    },
    {
      "id": 2,
      "text": "Luis Barragán began urbanizing Pedregal in the mid‑1940s, aiming to blend architecture with the natural volcanic landscape.",
      "sourceSentenceIds": [
        20
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Jardines_del_Pedregal",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The Plaza de las Fuentes, Pedregal’s original entrance, opened in 1949 at the corner of Fuentes and San Jerónimo avenues.",
      "sourceSentenceIds": [
        24
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Jardines_del_Pedregal",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Max Cetto’s studio‑home, built in 1951, remains one of the first modernist houses in the area.",
      "sourceSentenceIds": [
        12,
        27
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Jardines_del_Pedregal",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Pedregal hosts the University Museum of Contemporary Art, the Botanical Garden, and the Espacio Escultórico, showcasing contemporary culture.",
