      "id": 1,
      "text": "Dunbar Creek, which feeds the Templeton River west of Brisco, was named after Vancouver land speculator Charles Trott Dunbar.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://inthewindermere.ca/dunbar/",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "In Vancouver, Dunbar Heights, Dunbar Street and Dunbar Park all honor the same Charles Trott Dunbar.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://inthewindermere.ca/dunbar/",
      "category": "people",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Dunbar’s real‑estate dealings in the Windermere Valley were murky, and it is unclear why he focused on that area.",
      "sourceSentenceIds": [
        23
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://inthewindermere.ca/dunbar/",
