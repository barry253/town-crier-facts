      "category": "transport",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The fast‑food chain Del Taco was founded in Yermo in 1964, a notable origin of a national brand.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
