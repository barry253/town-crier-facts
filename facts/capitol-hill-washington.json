  "facts": [
    {
      "id": 1,
      "text": "Thomas Jefferson named Capitol Hill in 1793, echoing Rome’s Capitoline Hill to honor the ancient Temple of Jupiter Optimus Maximus.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Capitol_Hill",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The Folger Shakespeare Library, a marble Art Deco building, sits on Capitol Hill and houses the world’s largest Shakespeare collection.",
      "sourceSentenceIds": [
        1,
        21,
        22
      ],
      "sourceLabels": [
        "Web source 2",
        "Wikipedia"
      ],
      "source": "https://www.britannica.com/place/Washington-DC/Capitol-Hill",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "After the Civil War, middle‑class government workers settled on Capitol Hill, prompting developers to build rows of two‑ and three‑story brick homes.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.britannica.com/place/Washington-DC/Capitol-Hill",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Capitol Hill is Washington, D.C.’s oldest residential neighborhood, dating back to the city’s original layout.",
      "sourceSentenceIds": [
        18
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.britannica.com/place/Washington-DC/Capitol-Hill",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The Capitol Complex on Capitol Hill includes the U.S. Capitol, the Senate and House office buildings, the Supreme Court, and the Library of Congress.",
      "sourceSentenceIds": [
        28
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Capitol_Hill",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "In 1791, artist John Trumbull noted that the Capitol site was covered in thick wood, making it unlikely for livestock to graze there.",
