  "facts": [
    {
      "id": 1,
      "text": "Moore Park was named after John Thomas Moore, who invested heavily in the Belt Line hoping it would attract buyers to his subdivision.",
      "sourceSentenceIds": [
        21,
        22
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.neighbourhoodguide.com/toronto/midtown/moore-park/",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The Belt Line’s opening triggered a depression that stalled Moore Park’s construction until the early 1900s.",
      "sourceSentenceIds": [
        23,
        24
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.neighbourhoodguide.com/toronto/midtown/moore-park/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "By the 1930s, Moore Park was fully developed and has since been ranked Toronto’s top family neighbourhood.",
      "sourceSentenceIds": [
        25,
        26
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.neighbourhoodguide.com/toronto/midtown/moore-park/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Moore Park is surrounded by natural barriers: Mount Pleasant Cemetery to the north, Park Drive Ravine to the south, and two ravines to the east and west.",
      "sourceSentenceIds": [
        28
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.neighbourhoodguide.com/toronto/midtown/moore-park/",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "During Christmastime, many homes in Moore Park light up with giant inflatable Santas that can reach 20 feet tall.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.neighbourhoodguide.com/toronto/midtown/moore-park/",
      "category": "culture",
      "quality": "poor",
      "qualityReason": "editorial_filler"
    },
    {
      "id": 6,
      "text": "Moore Park’s location in Midtown Toronto places it within walking distance of Clair subway station, offering easy transit access.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 1"
      ],
