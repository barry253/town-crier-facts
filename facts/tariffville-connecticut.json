  "facts": [
    {
      "id": 1,
      "text": "Tariffville earned its name from the Tariff Act of 1824, which protected wool and cotton textiles and inspired the Tariff Manufacturing Company.",
      "sourceSentenceIds": [
        23,
        24
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Tariffville%2C_Connecticut",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The Tariffville Historic District, listed on the National Register of Historic Places, preserves Greek Revival and Gothic Revival homes that date back to the 19th century.",
      "sourceSentenceIds": [
        15,
        17
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Tariffville%2C_Connecticut",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Founded in 2003, the Tariffville Village Association works to protect the village’s natural resources and educate residents about its rich history.",
      "sourceSentenceIds": [
        1,
        4
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.tariffvillevillage.org/",
      "category": "other",
      "quality": "poor",
      "qualityReason": "vague"
    },
    {
      "id": 4,
      "text": "Tariffville sits at the confluence of the Farmington River and Salmon Brook Wild and Scenic River, making it a hotspot for whitewater kayaking and national events.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/tariffville_connecticut",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The first steel manufacturing plant in the United States was built in Tariffville in 1727 along the Farmington River, marking an early industrial milestone.",
      "sourceSentenceIds": [
        29
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Tariffville%2C_Connecticut",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The village’s Village Green and Gazebo serve as the focal point of its historic district and host community events that celebrate its four nationally recognized designations.",
      "sourceSentenceIds": [
