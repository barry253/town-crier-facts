  "facts": [
    {
      "id": 1,
      "text": "Grassmarket began as a bustling horse and cattle market before slipping into ruin during the 19th century.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://outaboutscotland.com/the-grassmarket-in-edinburgh/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Public executions once took place here, and a crucifix was mounted on a wall opposite the gallows.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.allaboutedinburgh.co.uk/grassmarket-edinburgh",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Maggie Dickson, a fishwife who survived an alleged execution, inspired a pub named after her just yards from the gallows.",
      "sourceSentenceIds": [
        1,
        3,
        5
      ],
      "sourceLabels": [
        "Web source 2",
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://outaboutscotland.com/the-grassmarket-in-edinburgh/",
      "category": "people",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The White Hart Inn, founded in 1516, is one of Edinburgh’s oldest pubs and sits on the Grassmarket.",
      "sourceSentenceIds": [
        15
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.allaboutedinburgh.co.uk/grassmarket-edinburgh",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Candlemaker Row, next to Grassmarket, dates back to the 11th or 12th century as a farmstead beside major cattle routes.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Grassmarket",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Grassmarket sits at the foot of Castle Rock, below surrounding ground levels, creating a low‑lying hollow in Edinburgh’s Old Town.",
      "sourceSentenceIds": [
        24,
