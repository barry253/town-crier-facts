      "id": 1,
      "text": "DeWitt takes its name from New York governor DeWitt Clinton, who served from 1817 to 1823.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/DeWitt%2C_Illinois",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "DeWitt sits in central Illinois as a village within DeWitt County, a region known for its rich agricultural land.",
      "sourceSentenceIds": [
        4,
        15
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/DeWitt%2C_Illinois",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The county seat, Clinton, lies just 25 miles from Bloomington‑Normal and 50 miles from Springfield, placing DeWitt within easy reach of larger cities.",
      "sourceSentenceIds": [
        16
      ],
      "sourceLabels": [
        "Web source 1"
      ],
