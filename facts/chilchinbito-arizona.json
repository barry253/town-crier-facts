      "quality": "poor",
      "qualityReason": "location_description"
    },
    {
      "id": 3,
      "text": "In March 2020, a 46‑year‑old Chilchinbito resident became the first COVID‑19 case reported on the Navajo Nation.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Chilchinbito%2C_Arizona",
      "category": "other",
      "quality": "poor",
      "qualityReason": "vague"
    },
    {
      "id": 4,
      "text": "That resident was tested in Phoenix after being transferred from Kayenta Health Center.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Chilchinbito%2C_Arizona",
      "category": "other",
      "quality": "poor",
      "qualityReason": "vague"
    },
    {
      "id": 5,
      "text": "Two days later, the Navajo Health Command ordered Chilchinbito to be quarantined and isolated.",
      "sourceSentenceIds": [
        8
