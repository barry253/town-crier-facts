      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town sits on Navajo Nation land that stretches across four state lines in the Four Corners region.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Chilchinbito%2C_Arizona",
