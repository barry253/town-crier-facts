      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Woodlands%2C_Singapore",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Woodlands Train Checkpoint links Singapore to Johor Bahru Sentral via a shuttle train across the causeway, a key cross‑border connection.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
