  "facts": [
    {
      "id": 1,
      "text": "Dobson Ranch began as a cattle ranch in 1886 when Wilson Wesley Dobson moved from Canada to Arizona.",
      "sourceSentenceIds": [
        14
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.dobsonranchhoa.com/discover/the-best-place-to-live",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The City of Mesa bought the original Dobson homestead in 1973 to build a championship 18‑hole municipal golf course.",
      "sourceSentenceIds": [
        18
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.dobsonranchhoa.com/discover/the-best-place-to-live",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Continental Homes designed the community’s eight artificial lakes and surrounding greenbelts, creating the water‑filled landscape that defines Dobson Ranch today.",
      "sourceSentenceIds": [
        25,
        28
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.dobsonranchhoa.com/discover/the-best-place-to-live",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The elegant Dobson family home, built in the 1950s, now houses the popular Ranch House restaurant, a local culinary landmark.",
      "sourceSentenceIds": [
        19
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.dobsonranchhoa.com/discover/the-best-place-to-live",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Dobson Ranch’s boundaries are marked by US 60 to the north, the 101 to the west, Guadalupe Road to the south, and Extension Road to the east.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Dobson_Ranch%2C_Mesa",
      "category": "other",
      "quality": "poor",
      "qualityReason": "location_description"
    },
    {
      "id": 6,
      "text": "The community’s lakes were filled starting in early 1975, a process that took months and required careful water‑rights management from the Salt River Project.",
      "sourceSentenceIds": [
        28,
        1
      ],
