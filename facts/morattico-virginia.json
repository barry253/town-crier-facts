  "facts": [
    {
      "id": 1,
      "text": "Morattico’s name derives from the Moraughtacund tribe, whose village may have stood near the site.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Morattico%2C_Virginia",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Captain John Smith recorded the Moraughtacunds in 1608, making the area one of the earliest documented Native American settlements.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Morattico%2C_Virginia",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The Morattico Waterfront Museum occupies the original wharf that operated from 1889 to 1933, preserving the town’s river trade history.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Morattico%2C_Virginia",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The museum is a 501(c)(3) member of the American Association for State and Local History, underscoring its historical importance.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.morattico.org/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "From 1706 to 1835, the Ball family owned Morattico Plantation, which was divided into eight parcels after the last owner died without an heir.",
      "sourceSentenceIds": [
        2,
        11,
        16,
        17
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Morattico%2C_Virginia",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "In 2011, the Village of Morattico Historic District was listed on the National Register of Historic Places, honoring its 19th‑century heritage.",
