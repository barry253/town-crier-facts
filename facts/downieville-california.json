  "facts": [
    {
      "id": 1,
      "text": "Downieville was founded in late 1849 during the California Gold Rush, originally called The Forks because of its location at the confluence of the Downie and Yuba Rivers.",
      "sourceSentenceIds": [
        1,
        3,
        8
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Downieville%2C_California",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town was renamed after Major William Downie, the miner who first struck gold there in September 1849.",
      "sourceSentenceIds": [
        4,
        24,
        27
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Downieville%2C_California",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "A historic 1852 stone building houses the Downieville Museum, once a general store and now a window into 19th‑century life.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Downieville%2C_California",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Downieville’s terrain once hosted a flume that drew water from the East Fork at Ben Pauley’s Sawmill and crossed the North Fork of the Yuba, supplying mining operations.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://downievillepudca.gov/index.php/home/history",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Downieville remains a gateway to outdoor adventures, offering white‑water rafting, snowmobiling, and skiing while preserving its gold‑rush heritage.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 1"
      ],
