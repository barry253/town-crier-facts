  "facts": [
    {
      "id": 1,
      "text": "Loomis began as a lumber town founded by Erastus Loomis and George Wise, after whom Wise Township was named.",
      "sourceSentenceIds": [
        5,
        4,
        19
      ],
      "sourceLabels": [
        "Web source 1",
        "Wikipedia",
        "Wikipedia"
      ],
      "source": "https://99wfmk.com/loomis-michigan/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "During its heyday, Loomis boasted a church, depot, two hotels, a horse race track, and a hemlock extract factory.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://99wfmk.com/loomis-michigan/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The Pere Marquette Rail-Trail now follows the former Flint & Pere Marquette Railroad line that served Loomis until about 1960.",
      "sourceSentenceIds": [
        23,
        27
      ],
      "sourceLabels": [
        "Wikipedia",
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Loomis%2C_Michigan",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Patrick Holden's hotel, built in 1871, is the oldest surviving structure and now operates as a market and antique shop.",
      "sourceSentenceIds": [
        25,
        26
      ],
      "sourceLabels": [
        "Wikipedia",
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Loomis%2C_Michigan",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The Loomis Basin Historical Society preserves local history and partners with the Placer County Genealogical Society to maintain a reference collection at the Loomis Library.",
