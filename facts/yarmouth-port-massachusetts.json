  "facts": [
    {
      "id": 1,
      "text": "Yarmouth Port’s first permanent European settlement began in 1637 when Thomas and John Yarmouth founded the town that would later bear their name.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://boston.wiki/a/Yarmouth,_Massachusetts",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The Yarmouth Historical Society Museum preserves colonial and 19th‑century artifacts, offering a tangible link to the town’s early history.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://boston.wiki/a/Yarmouth,_Massachusetts",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Captain Bangs Hallet House Museum, owned by the Historical Society of Old Yarmouth, showcases the town’s maritime heritage.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://yarmouthcapecod.com/historic-yarmouth-port-a-sea-captains-paradise/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "A former church, the town’s best surviving Gothic example, now serves as a community venue for events and weddings.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://yarmouthcapecod.com/historic-yarmouth-port-a-sea-captains-paradise/"
    },
    {
      "id": 5,
      "text": "The Yarmouth River, a tidal waterway flowing into the Atlantic, has long been vital for fishing and transportation.",
      "sourceSentenceIds": [
        19
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://boston.wiki/a/Yarmouth,_Massachusetts",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Every year, the Yarmouth Writers’ Festival partners with the Cape Cod Writers’ Center to bring authors and readers together for storytelling.",
