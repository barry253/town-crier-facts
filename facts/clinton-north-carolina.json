  "facts": [
    {
      "id": 1,
      "text": "Clinton was named for Brigadier General Richard Clinton, a North Carolina militia officer from the American Revolution.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Clinton%2C_North_Carolina",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town was incorporated in 1822 and became the county seat of Sampson County, the largest and oldest city in the county.",
      "sourceSentenceIds": [
        9,
        15
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.cityofclintonnc.com/1308/City-History",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Clinton sits at the geographic center of Sampson County and grew into the region’s main agricultural marketing hub.",
      "sourceSentenceIds": [
        21
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Clinton%2C_North_Carolina",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The Sampson County History Museum on Lisbon Street showcases the area’s past, from early settlers in 1740 to the town’s 19th‑century growth.",
      "sourceSentenceIds": [
        12,
        14
      ],
      "sourceLabels": [
        "Web source 2",
        "Wikipedia"
      ],
      "source": "https://www.visitsampsonnc.com/belongs_to_city/clinton/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Downtown Clinton features the state’s largest dogwood mural, a 90‑foot long public art piece that celebrates the region’s natural beauty.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.visitsampsonnc.com/belongs_to_city/clinton/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "In 1953, Clinton transitioned from a town to a city, marking a milestone in its development as a regional center.",
