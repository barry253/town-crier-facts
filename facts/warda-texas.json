  "facts": [
    {
      "id": 1,
      "text": "Warda was named after Wartha in Saxony, the former home of Wendish immigrant Falke.",
      "sourceSentenceIds": [
        2,
        5
      ],
      "sourceLabels": [
        "Web source 1",
        "Web source 2"
      ],
      "source": "https://www.tshaonline.org/handbook/entries/warda-tx",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Falke opened a general store in 1874, which later became the Falke General Store and post office that stayed in his family until 1946.",
      "sourceSentenceIds": [
        3,
        27
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.tshaonline.org/handbook/entries/warda-tx",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The Jurk sawmill, founded in 1906, helped make Warda a lumber source on the eastern edge of the Lost Pines.",
      "sourceSentenceIds": [
        3,
        25
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.tshaonline.org/handbook/entries/warda-tx",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Warda became a voting place for Precinct 16 in 1875 and opened its post office the following year.",
      "sourceSentenceIds": [
        28
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.tshaonline.org/handbook/entries/warda-tx",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "By 1884 the settlement boasted sawmills, gristmills, cotton gins, two general stores, a blacksmith, a wagonmaker, a coffin maker, a barber, a physician, and a drugstore.",
      "sourceSentenceIds": [
        29
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.tshaonline.org/handbook/entries/warda-tx",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "A Lutheran school operated in Warda until 1969, supplemented by a public school from 1898 to 1948.",
      "sourceSentenceIds": [
        30
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.tshaonline.org/handbook/entries/warda-tx",
      "category": "culture",
      "quality": "good"
    }
