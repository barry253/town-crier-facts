    {
      "id": 1,
      "text": "Geneva was first incorporated in 1806, then again in 1812 and 1871.",
      "sourceSentenceIds": [
        16
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.visitfingerlakes.com/plan-your-trip/ontario-county-ny/geneva/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The city’s name likely comes from Geneva, Switzerland, because of its lakeside setting, though some say it has Native American roots.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.visitfingerlakes.com/plan-your-trip/ontario-county-ny/geneva/",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Historic Geneva, founded in 1883, preserves the city’s past through the Geneva History Museum, Rose Hill Mansion, and John Johnston House.",
      "sourceSentenceIds": [
        1,
        5
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://historicgeneva.org/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Belhurst Castle, a 19th‑century landmark on Seneca Lake, draws visitors for its romantic architecture and wedding venues.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.visitfingerlakes.com/plan-your-trip/ontario-county-ny/geneva/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Hobart and William Smith Colleges and Cornell’s New York State Agricultural Experiment Station give Geneva a strong academic presence.",
