  "facts": [
    {
      "id": 1,
      "text": "Old Town earned National Historic Landmark status in June 2015, recognizing its rich architectural heritage.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Old_Town%2C_Chicago",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "In the early 1900s, locals called Old Town the “Cabbage Patch” because of the abundant cabbage farms that once dotted the area.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Old_Town%2C_Chicago",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Before Chicago’s 1871 fire, Old Town was a bustling trade hub for Potawatomi, Miami, and Illinois Native Americans.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Old_Town%2C_Chicago",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Michael’s Church, one of only seven buildings to survive the Great Chicago Fire, still stands in Old Town’s historic streets.",
      "sourceSentenceIds": [
        10,
        30
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Old_Town%2C_Chicago",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Henry Gerber’s home on North Crilly Court became the first U.S. gay‑rights organization in 1924, later named a Chicago Landmark in 2001.",
      "sourceSentenceIds": [
        13,
        14
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Old_Town%2C_Chicago",
      "category": "people",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The Brown‑Purple Line’s 1536–40 North Sedgwick Street station, built in 1900, is one of the oldest surviving ‘El’ stations in Chicago.",
      "sourceSentenceIds": [
        25,
