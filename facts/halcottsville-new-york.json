  "facts": [
    {
      "id": 1,
      "text": "Halcottsville was named after Revolutionary War soldier John Halcott, who defected from the English army and joined Washington's patriots.",
      "sourceSentenceIds": [
        4,
        19
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Halcottsville%2C_New_York",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The hamlet sits on the East Branch Delaware River, where a dam built in 1805 by Halcott and David Kelly created Lake Wawaka, powering industry for a century.",
      "sourceSentenceIds": [
        21,
        24
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.centralcatskills.com/halcottsville",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "In 1871, the arrival of the Delaware & Ulster Railroad turned Halcottsville into a regional trade hub, with a paddle‑wheel launch offering rides to visitors.",
      "sourceSentenceIds": [
        7,
        26
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.centralcatskills.com/halcottsville",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Two buildings in Halcottsville—the Kelly Round Barn and Old School Baptist Church—are listed on the National Register of Historic Places.",
      "sourceSentenceIds": [
        6,
        12
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 2"
      ],
      "source": "https://en.wikipedia.org/wiki/Halcottsville%2C_New_York",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The Wawaka Grange, opened in 1875, served as a community center for farmers in the surrounding valleys.",
      "sourceSentenceIds": [
        29
