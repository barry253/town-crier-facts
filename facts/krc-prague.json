      "id": 1,
      "text": "Krč first appears in written records in 1222, long before it joined Prague.",
      "sourceSentenceIds": [
        22
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Kr%C4%8D",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "In 1922 Krč was incorporated into Prague, adding 3,700 residents and 323 addresses to the city.",
      "sourceSentenceIds": [
        21,
        24
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Kr%C4%8D",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Line C of the Prague Metro currently stops at Praha‑Krč station, linking the district to the city center.",
      "sourceSentenceIds": [
        26
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Kr%C4%8D",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Future Line D of the Prague Metro will run through Krč, directly serving the nearby Thomayer hospital.",
      "sourceSentenceIds": [
        18
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Kr%C4%8D",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The Thomayer hospital complex houses the Institute for Clinical and Experimental Medicine, a leading research center.",
      "sourceSentenceIds": [
        25
      ],
      "sourceLabels": [
