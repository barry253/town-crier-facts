  "facts": [
    {
      "id": 1,
      "text": "Gurabo was officially founded in 1815, though its roots trace back to the indigenous Taíno people who once inhabited the area.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://incrediblepuertorico.com/towns/gurabo/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Nicknamed “La Ciudad de las Escaleras,” Gurabo’s rolling hills have inspired a network of staircases and pedestrian paths that locals love.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.trawellino.com/destinations/puerto-rico/gurabo_gurabo",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The town’s historic church, Parroquia Nuestra Señora del Rosario, was built in 1821 and showcases neoclassical design right in the town square.",
      "sourceSentenceIds": [
        11
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.trawellino.com/destinations/puerto-rico/gurabo_gurabo",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Gurabo’s Hacienda la Esperanza, a 19th‑century sugar plantation, now serves as a nature reserve with hiking trails and historic ruins.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.trawellino.com/destinations/puerto-rico/gurabo_gurabo",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Gurabo hosts the Puerto Rico Baseball Academy and High School, a baseball academy that has produced several professional players.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Gurabo%2C_Puerto_Rico",
      "category": "culture",
      "quality": "good"
    },
    {
