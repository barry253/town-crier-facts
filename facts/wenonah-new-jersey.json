  "facts": [
    {
      "id": 1,
      "text": "Wenonah was founded in 1871 by Philadelphia businessmen as a country resort, drawn by its location along Mantua Creek and the West Jersey Railroad.",
      "sourceSentenceIds": [
        1,
        2,
        3
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1",
        "Web source 2"
      ],
      "source": "https://en.wikipedia.org/wiki/Wenonah%2C_New_Jersey",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The borough’s name comes from the mother of Hiawatha in Henry Wadsworth Longfellow’s poem *The Song of Hiawatha*.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Wenonah%2C_New_Jersey",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Wenonah has been a dry town since its early days, meaning alcohol cannot be bought or sold legally within its limits.",
      "sourceSentenceIds": [
        17
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Wenonah%2C_New_Jersey",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "In 2026, Wenonah celebrated 30 years of Tree City USA accreditation, a testament to its long‑standing commitment to forest stewardship.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://boroughofwenonah.com/",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Over four decades, the borough installed numerous dams that created recreational lakes, turning the area into a popular spot for boating and fishing.",
      "sourceSentenceIds": [
        19
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Wenonah%2C_New_Jersey",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "On September 1, 2021, an EF3 tornado struck Wenonah, damaging more than 200 properties, the largest number of any municipality hit by the storm.",
