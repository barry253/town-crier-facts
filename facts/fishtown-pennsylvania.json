  "facts": [
    {
      "id": 1,
      "text": "Fishtown’s name comes from its early fishermen who controlled Delaware River fishing rights from Cape May to Trenton.",
      "sourceSentenceIds": [
        28,
        29
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Fishtown%2C_Philadelphia",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Captain Anthony Palmer founded the area in 1728, laying out a triangular boundary by the Delaware River, Front Street, and York Street.",
      "sourceSentenceIds": [
        8,
        10
      ],
      "sourceLabels": [
        "Web source 2",
        "Wikipedia"
      ],
      "source": "https://guidetophilly.com/philadelphia-neighborhoods/fishtown/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Palmer used proceeds from selling the Hope Farm estate to buy the Fairman Estate and then sold parcels to fishermen and shipbuilders.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Fishtown%2C_Philadelphia",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The Palmer Cemetery, also called Kensington Burial Grounds, began around 1732 and remains an active burial ground today.",
      "sourceSentenceIds": [
        6,
        14
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Fishtown%2C_Philadelphia",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Once the heart of Philadelphia’s fishing industry, Fishtown now blends historic charm with a cutting‑edge cultural scene that draws visitors worldwide.",
      "sourceSentenceIds": [
