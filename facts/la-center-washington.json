  "facts": [
    {
      "id": 1,
      "text": "La Center sits on the East Fork of the Lewis River, 16.5 miles north of Vancouver and 4 miles southeast of Woodland.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.pacific-hwy.net/lacenter.htm",
      "category": "other",
      "quality": "poor",
      "qualityReason": "location_description"
    },
    {
      "id": 2,
      "text": "In the 1870s La Center was the business hub and navigation head of the East Fork of the Lewis River.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/La_Center%2C_Washington",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Steamers Mascot and Walker often ran low on water, forcing passengers and freight to transfer to scows pulled by horses.",
      "sourceSentenceIds": [
        11,
        12
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/La_Center%2C_Washington",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The city officially incorporated on August 27, 1909, marking its transition from a river town to a formal municipality.",
      "sourceSentenceIds": [
        13
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/La_Center%2C_Washington",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Highland Lutheran Church, built in 1887, stands as one of La Center’s oldest standing religious structures.",
      "sourceSentenceIds": [
        30
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/La_Center%2C_Washington",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "La Center hosts three card‑room casinos—New Phoenix, Last Frontier, and Fortune—where poker is legal but slots are not.",
