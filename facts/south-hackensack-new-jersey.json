  "facts": [
    {
      "id": 1,
      "text": "South Hackensack became a township on November 15, 1935, after a referendum that passed 309 to 15.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/South_Hackensack%2C_New_Jersey",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The township’s name comes from its position south of the city of Hackensack.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/South_Hackensack%2C_New_Jersey",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "South Hackensack is split into three noncontiguous parts: a northeastern residential core, a western Garfield Park area, and a southern industrial strip in the Meadowlands.",
      "sourceSentenceIds": [
        11,
        12,
        13
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/South_Hackensack%2C_New_Jersey",
      "category": "other",
      "quality": "poor",
      "qualityReason": "vague"
    },
    {
      "id": 4,
      "text": "NJ Transit buses 161 and 165 connect South Hackensack to Manhattan’s Port Authority, while route 76 heads to Newark and 772 offers local service.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/South_Hackensack%2C_New_Jersey",
      "category": "transport",
      "quality": "poor",
      "qualityReason": "route_only"
    },
    {
      "id": 5,
      "text": "The township is governed by a five‑member Committee elected at‑large for staggered three‑year terms.",
      "sourceSentenceIds": [
        28,
        29
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/South_Hackensack%2C_New_Jersey",
      "category": "other",
      "quality": "poor",
      "qualityReason": "vague"
    },
    {
      "id": 6,
      "text": "South Hackensack operates under New Jersey’s Township form of government, the second most common municipal structure in the state.",
      "sourceSentenceIds": [
