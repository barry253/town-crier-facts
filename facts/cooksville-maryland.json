      "id": 1,
      "text": "Cooksville was founded in 1802 by Thomas Cook, who bought land from Captain Hobbs and set up the settlement at a key crossroads.",
      "sourceSentenceIds": [
        1,
        3
      ],
      "sourceLabels": [
        "Web source 1",
        "Wikipedia"
      ],
