  "facts": [
    {
      "id": 1,
      "text": "Rose Bay takes its name from George Rose, a British Treasury secretary, with the suburb first called Rose Bay in 1788.",
      "sourceSentenceIds": [
        3,
        21
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Rose_Bay%2C_New_South_Wales",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "HMAS Tingira, meaning \"open sea\" in Aboriginal language, was moored in Rose Bay from 1912 to 1927.",
      "sourceSentenceIds": [
        4,
        7
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Rose_Bay%2C_New_South_Wales",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The Wintergarden Cinema, a landmark that hosted the Sydney Film Festival from 1968 to 1973, was demolished for luxury apartments in the late 1980s.",
      "sourceSentenceIds": [
        15
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Rose_Bay%2C_New_South_Wales",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "From Rose Bay's waterfront you can see both the Sydney Opera House and the Harbour Bridge side by side.",
      "sourceSentenceIds": [
        17
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Rose_Bay%2C_New_South_Wales",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Rose Bay Cottage, built in 1834 by architect John Verge for James Holt, stands as one of the suburb’s oldest surviving homes.",
      "sourceSentenceIds": [
        28
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Rose_Bay%2C_New_South_Wales",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The last commercial flight from Rose Bay, an Ansett service to Lord Howe Island, departed on 10 September 1974, ending the era of flying boats.",
