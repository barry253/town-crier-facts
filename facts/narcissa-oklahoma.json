  "facts": [
    {
      "id": 1,
      "text": "Narcissa was named after Narcissa Owen Walker, the daughter of the postmaster who established the town's post office.",
      "sourceSentenceIds": [
        5,
        6,
        8
      ],
      "sourceLabels": [
        "Web source 1",
        "Web source 2"
      ],
      "source": "https://www.theroute-66.com/narcissa.html"
    },
    {
      "id": 2,
      "text": "The town of Narcissa was incorporated in 1902, shortly after the Frisco Railroad passed through the region.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.theroute-66.com/narcissa.html"
    },
    {
      "id": 3,
      "text": "Brothers James Henry and Frank Gaines built a grain elevator in the early 1900s that became the nucleus of the local economy.",
      "sourceSentenceIds": [
        15,
        20
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/narcissa_oklahoma"
    },
    {
      "id": 4,
      "text": "Narcissa lies along the original 1926 alignment of Route 66, which brought travelers and revenue to the community.",
      "sourceSentenceIds": [
        10,
        21
      ],
      "sourceLabels": [
        "Web source 2",
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/narcissa_oklahoma"
    },
    {
      "id": 5,
      "text": "The Narcissa D-X Gas Station is listed on the National Register of Historic Places for its role in Route 66 roadside development.",
      "sourceSentenceIds": [
        2,
        4
      ],
      "sourceLabels": [
        "Web source 2",
        "Wikipedia"
      ],
      "source": "https://grokipedia.com/page/narcissa_oklahoma"
    },
    {
      "id": 6,
      "text": "Narcissa originated as a settlement in Ottawa County within Indian Territory, an area historically allocated to the Cherokee Nation.",
      "sourceSentenceIds": [
        3
