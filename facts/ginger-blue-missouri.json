  "facts": [
    {
      "id": 1,
      "text": "Ginger Blue was founded in 1915 when a railroad magnate built a summer lodge on the Elk River to attract city folk.",
      "sourceSentenceIds": [
        3,
        5,
        7,
        8
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/ginger_blue_missouri",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The village’s name comes from a Native American chief who lived in the area during the 18th century.",
      "sourceSentenceIds": [
        4,
        22
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/ginger_blue_missouri",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The original lodge was on a bluff overlooking the Elk River, turning informal fishing camps into a formal resort by the late 1910s.",
      "sourceSentenceIds": [
        25,
        28
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/ginger_blue_missouri",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Special train excursions from Kansas City, Tulsa, and Wichita brought crowds to Ginger Blue in the early 1920s.",
      "sourceSentenceIds": [
        29
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/ginger_blue_missouri",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "After a fire destroyed the resort, the village declined until modern transportation and medical advances reduced demand for such retreats.",
      "sourceSentenceIds": [
        23
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/ginger_blue_missouri",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Ginger Blue sits on a sharp meander of the Elk River, placing it within the Neosho River watershed that feeds the Arkansas River.",
      "sourceSentenceIds": [
        12,
        13
      ],
