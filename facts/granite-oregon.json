  "facts": [
    {
      "id": 1,
      "text": "Granite was first established by miners after gold was discovered along Granite Creek on July 4, 1862.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Granite%2C_Oregon"
    },
    {
      "id": 2,
      "text": "The town was originally called Independence, but it was renamed Granite in 1878 because another Oregon city already used that name.",
      "sourceSentenceIds": [
        10,
        11
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Granite%2C_Oregon"
    },
    {
      "id": 3,
      "text": "Granite once thrived as a gold mining town with a population of five thousand people.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://traveloregon.com/things-to-do/culture-history/ghost-towns/granite/"
    },
    {
      "id": 4,
      "text": "The local economy collapsed in 1942 when the federal government shut down gold mining to support the World War Two effort.",
      "sourceSentenceIds": [
        6,
        18,
        20
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Granite%2C_Oregon"
    },
    {
      "id": 5,
      "text": "Telephone and electric services in Granite fell out of use and were abandoned after World War Two.",
      "sourceSentenceIds": [
        5,
        21
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Granite%2C_Oregon"
    },
    {
      "id": 6,
      "text": "Granite is located in the Blue Mountains of eastern Oregon along the Elkhorn Drive Scenic Byway.",
