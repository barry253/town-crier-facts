  "facts": [
    {
      "id": 1,
      "text": "Dexter was named after Judge Samuel Dexter, who was running for governor of Massachusetts when the town incorporated in 1816.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Dexter%2C_Maine",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "In the 1960s, Dexter gained regional fame from the log‑cabin style outlets of the Dexter Shoe Company, founded in a former woolen mill in 1958 by Harold Alfond.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Dexter%2C_Maine",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Five Dexter buildings are on the National Register of Historic Places, including the Dexter Grist Mill, Universalist Church, and Abbott Memorial Library.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Dexter%2C_Maine",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "In 1818, Jonathan Farrar built a grist mill at the falls, and by 1836 the Abbott brothers powered five woolen mills on the river.",
      "sourceSentenceIds": [
        29,
        30
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Dexter%2C_Maine",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The 1857 Dexter Town Hall, praised in 1886 as one of the best in the state, still stands as a historic landmark.",
      "sourceSentenceIds": [
        16
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://dextermaine.info/history.html",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Parts of Dexter’s downtown were used as backdrops for Stephen King‑based film Creepshow 2 in 1987.",
