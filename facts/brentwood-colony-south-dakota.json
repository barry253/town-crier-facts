  "facts": [
    {
      "id": 1,
      "text": "Brentwood Colony was founded in 1987 as a division from the nearby Thunderbird Hutterite Colony.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/brentwood_colony_south_dakota"
    },
    {
      "id": 2,
      "text": "Brentwood Colony belongs to the Schmiedeleut Group 1 of Hutterites, an Anabaptist sect emphasizing communal living and pacifism.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/brentwood_colony_south_dakota"
    },
    {
      "id": 3,
      "text": "The colony operates ProPork, a large swine operation that manages thousands of sows and finishes tens of thousands of pigs annually.",
      "sourceSentenceIds": [
        11
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/brentwood_colony_south_dakota"
    },
    {
      "id": 4,
      "text": "Brentwood Colony has diversified its economy by manufacturing modular houses, closets, and cabinets.",
      "sourceSentenceIds": [
        30
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/brentwood_colony_south_dakota"
    },
    {
      "id": 5,
      "text": "The landscape around Brentwood Colony consists of broad, level uplands shaped by ancient glacial deposition.",
      "sourceSentenceIds": [
        16
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/brentwood_colony_south_dakota"
    },
    {
      "id": 6,
      "text": "Fertile, well-drained soils in the area provide an ideal environmental base for the colony's agricultural activities.",
      "sourceSentenceIds": [
