  "facts": [
    {
      "id": 2,
      "text": "Mauna Loa is the largest active volcano on the planet, rising 13,681 feet above sea level and 30,000 feet from the ocean floor.",
      "sourceSentenceIds": [
        21,
        23,
        24
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.nps.gov/havo/learn/nature/mauna-loa.htm",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The volcano covers about 51% of Hawaiʻi Island and its mass is nearly twice the combined area of all other Hawaiian islands.",
      "sourceSentenceIds": [
        23,
        26
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.nps.gov/havo/learn/nature/mauna-loa.htm",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Mauna Loa’s eruptions often start in the summit caldera before moving into one of its two rift zones, which have historically sent lava toward Hilo and South Kona.",
      "sourceSentenceIds": [
        30,
        2
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.nps.gov/havo/learn/nature/mauna-loa.htm",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Scientists estimate that 90 percent of Mauna Loa’s surface has been covered by flows from the last 4,000 years.",
      "sourceSentenceIds": [
        27
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.nps.gov/havo/learn/nature/mauna-loa.htm",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The name Maunaloa means “long mountain” in Hawaiian, reflecting its broad, rounded shield volcano shape.",
      "sourceSentenceIds": [
        22
