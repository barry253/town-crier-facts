      "source": "https://en.wikipedia.org/wiki/Fortitude_Valley%2C_Queensland",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "A 2010 safety audit revealed frequent pedestrian‑vehicle clashes in Fortitude Valley, prompting the council to introduce a new speed limit.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Fortitude_Valley%2C_Queensland",
