  "facts": [
    {
      "id": 1,
      "text": "Fortitude Valley’s McWhirter’s Department Store, an Art Deco landmark first opened in 1898, still stands as a reminder of the suburb’s commercial past.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
