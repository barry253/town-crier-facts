  "facts": [
    {
      "id": 1,
      "text": "Swall Meadows sits partway up the Sherwin Grade at 6,000-7,000 ft, offering views of the Sierra Crest.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Swall_Meadows%2C_California"
    },
    {
      "id": 2,
      "text": "In 2011 the Eastern Sierra Land Trust secured a 104‑acre easement on the Naylon ranch to protect mule deer winter range and a historic orchard.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/swall_meadows_california"
    },
    {
      "id": 3,
      "text": "The area was first homesteaded in the 1870s by James L.C. Swall, whose name lives in the meadow’s title.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/swall_meadows_california"
    },
    {
      "id": 4,
      "text": "A 60‑acre Swall Wildlife Preserve on the Wilson property preserves riparian habitats and sagebrush scrub, keeping mule deer connected to public lands.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/swall_meadows_california"
    },
    {
      "id": 5,
      "text": "Swall Meadows’ meadow hosts wet‑habitat plants like Jeffrey pines, willows, and bog orchids, a remnant of its former apple orchard.",
      "sourceSentenceIds": [
        13
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Swall_Meadows%2C_California"
    },
    {
      "id": 6,
      "text": "The old wagon road that climbed 3,000 ft up the Sherwin Grade from Owens Valley toward Crowley Lake can still be seen between Paradise and Swall Meadows.",
      "sourceSentenceIds": [
