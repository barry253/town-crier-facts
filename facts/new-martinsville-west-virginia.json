  "facts": [
    {
      "id": 1,
      "text": "New Martinsville was founded by Presley Martin, who platted the town in 1838 and named it after himself.",
      "sourceSentenceIds": [
        1,
        2
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/New_Martinsville%2C_West_Virginia"
    },
    {
      "id": 2,
      "text": "In 1846, New Martinsville was chosen as Wetzel County’s seat by the county‑establishing act.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://newmartinsville.com/"
    },
    {
      "id": 3,
      "text": "The town added “New” in 1871 to distinguish itself from Martinsville, Virginia.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.wvencyclopedia.org/entries/2200"
    },
    {
      "id": 4,
      "text": "New Martinsville sits where the former West Virginia Short Line, now part of CSX, meets the Ohio River Division of the Baltimore & Ohio Railroad.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.wvencyclopedia.org/entries/2200"
    },
    {
      "id": 5,
      "text": "Gloria Swanson’s 1925 film Stage Struck was shot in and around New Martinsville.",
      "sourceSentenceIds": [
        9,
        10
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 2"
      ],
      "source": "https://en.wikipedia.org/wiki/New_Martinsville%2C_West_Virginia"
    },
    {
      "id": 6,
      "text": "New Martinsville lies on the Ohio River, serving as a gateway between West Virginia and Ohio.",
