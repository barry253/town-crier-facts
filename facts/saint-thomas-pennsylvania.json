  "facts": [
    {
      "id": 1,
      "text": "Saint Thomas Township earned its name from the Campbell families that settled there in the 1740s; William Archibald later renamed it to honor Thomas Campbell.",
      "sourceSentenceIds": [
        13,
        14,
        15
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/St._Thomas_Township%2C_Pennsylvania",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Three sites in Saint Thomas—Franklin Furnace Historic District, the Chambersburg and Bedford Turnpike Road Company Toll House, and Woodland—are listed on the National Register of Historic Places.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/St._Thomas_Township%2C_Pennsylvania",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The township’s earliest settlers included Col. John Armstrong, John Campbell, and John Dixon, who arrived in the 1740s and helped shape the area’s early community.",
      "sourceSentenceIds": [
        11,
        12,
        13
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/St._Thomas_Township%2C_Pennsylvania",
      "category": "people",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Pennsylvania Route 30 slices through Saint Thomas, running east to Chambersburg and west to McConnellsburg, linking the township to regional hubs.",
      "sourceSentenceIds": [
        21
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/St._Thomas_Township%2C_Pennsylvania",
      "category": "transport",
      "quality": "poor",
      "qualityReason": "route_only"
    },
    {
      "id": 5,
      "text": "Waterways in Saint Thomas drain into tributaries of Conococheague Creek, which feeds the Potomac River watershed and shapes the local landscape.",
      "sourceSentenceIds": [
        20
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/St._Thomas_Township%2C_Pennsylvania",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The village once called Campbelltown hosted the first St. Thomas or Campbeltown Presbyterian Church in 1818, a shared place of worship for three congregations until 1854.",
      "sourceSentenceIds": [
        18,
        19
      ],
      "sourceLabels": [
