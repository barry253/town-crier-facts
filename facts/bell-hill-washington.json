  "facts": [
    {
      "id": 1,
      "text": "Bell Hill takes its name from the hill it sits on, rising over 1,000 feet above sea level.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Bell_Hill%2C_Washington"
    },
    {
      "id": 2,
      "text": "The community lies just south of Sequim, tucked into eastern Clallam County.",
      "sourceSentenceIds": [
        7,
        9
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Bell_Hill%2C_Washington"
    },
    {
      "id": 3,
      "text": "Bell Hill features two distinct peaks: the western hillock is exposed, while the eastern one is forested with Douglas fir and Pacific madrone.",
      "sourceSentenceIds": [
        10,
        12
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Bell_Hill%2C_Washington"
    },
    {
      "id": 4,
      "text": "The eastern hillock reaches about 950 feet above sea level, slightly lower than the overall hill’s summit.",
      "sourceSentenceIds": [
        11
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Bell_Hill%2C_Washington"
    },
    {
      "id": 5,
      "text": "Precipitation on Bell Hill is higher than Sequim’s but still drier than most of western Washington.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Bell_Hill%2C_Washington"
    },
    {
      "id": 6,
      "text": "Bell Hill’s elevation is listed as 1,020 feet above sea level in local records.",
