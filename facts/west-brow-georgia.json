      "category": "transport",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "In 1895, West Brow’s community was noted for having a post office and railroad service, a rare combination for a mountain town.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 1"
      ],
