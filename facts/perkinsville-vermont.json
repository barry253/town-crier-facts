  "facts": [
    {
      "id": 1,
      "text": "Perkinsville was originally known as Duncanville after Nahum Duncan, the area's first store and tavern keeper in the early 1800s.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/perkinsville_vermont"
    },
    {
      "id": 2,
      "text": "James Perkins, a Boston capitalist who invested in local industry around 1830, gave the village its current name.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/perkinsville_vermont"
    },
    {
      "id": 3,
      "text": "Dams on the Black River powered local machine tool manufacturing and farming operations during the 19th and early 20th centuries.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/perkinsville_vermont"
    },
    {
      "id": 4,
      "text": "The construction of the North Springfield Dam in the late 1950s created the 49-acre Stoughton Pond.",
      "sourceSentenceIds": [
        20,
        21
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/perkinsville_vermont"
    },
    {
      "id": 5,
      "text": "Stoughton Pond submerged much of Lower Perkinsville, including homes, farms, and the Jones and Lamson power dam.",
      "sourceSentenceIds": [
        21
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/perkinsville_vermont"
    },
    {
      "id": 6,
      "text": "Cellar holes and bridge abutments remain as markers of the lost village preserved through local historical efforts.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/perkinsville_vermont"
    }
  ]
