  "facts": [
    {
      "id": 1,
      "text": "Williams Lake is named after Secwepemc Chief William, whose counsel kept the Shuswap from joining the Tsilhqot'in uprising.",
      "sourceSentenceIds": [
        13
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Williams_Lake%2C_British_Columbia",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town was founded in 1860 by Gold Commissioner Philip Henry Nind and constable William Pinchbeck, who organized local government during the Cariboo Gold Rush.",
      "sourceSentenceIds": [
        15
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Williams_Lake%2C_British_Columbia",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "When the Cariboo Road was rerouted in 1863 to bypass Williams Lake, the town fell into obscurity until the Pacific Great Eastern Railway arrived in 1919.",
      "sourceSentenceIds": [
        22,
        25
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Williams_Lake%2C_British_Columbia",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Williams Lake hosts Canada’s second‑largest professional rodeo, the Williams Lake Stampede, featuring a parade of floats and local community groups.",
      "sourceSentenceIds": [
        12,
        6
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Williams_Lake%2C_British_Columbia",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The city celebrated its first LGBTQ2S Pride Week in August 2022, raising the inclusive pride flag at city hall.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Williams_Lake%2C_British_Columbia",
