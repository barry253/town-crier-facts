    },
    {
      "id": 2,
      "text": "In 1938, Hopewell’s colonial and industrial past earned it designation as Hopewell Village National Historic Site.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://home.nps.gov/hofu/hopewell-furnace-250th-anniversary.htm",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The cold blast furnace that once powered Hopewell shut down in 1883, unable to compete with Pittsburgh and Bethlehem steel mills.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://home.nps.gov/hofu/hopewell-furnace-250th-anniversary.htm",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Hopewell Furnace celebrated its 250th anniversary in 2021, marking two and a half centuries of industrial heritage.",
      "sourceSentenceIds": [
        17,
        18
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://home.nps.gov/hofu/hopewell-furnace-250th-anniversary.htm",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The site was renamed Hopewell Furnace National Historic Site in 1988 to better reflect its industrial legacy.",
      "sourceSentenceIds": [
