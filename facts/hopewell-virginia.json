  "facts": [
    {
      "id": 1,
      "text": "Hopewell sits where the Appomattox and James rivers meet, a spot chosen for its strategic overlook of both waterways.",
      "sourceSentenceIds": [
        3,
        8
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Hopewell%2C_Virginia",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "DuPont built a dynamite plant in Hopewell in the 1800s, later switching to guncotton during World War I.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Hopewell%2C_Virginia",
      "category": "economy",
      "quality": "poor",
      "qualityReason": "unverified=['smith']"
    },
    {
      "id": 3,
      "text": "After DuPont left, Hopewell nearly became a ghost town until 1923 when Tubize Corporation opened a new plant on the old site.",
      "sourceSentenceIds": [
        11
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Hopewell%2C_Virginia",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The Historic Hopewell Foundation preserves the city’s past, including stories of its enslaved community at Weston Manor.",
      "sourceSentenceIds": [
        2,
        17
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.historichopewell.org/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "City Point, Hopewell’s oldest part, was founded in 1613 by Sir Thomas Dale and later became the Union army’s headquarters in 1864.",
      "sourceSentenceIds": [
        21,
        28,
        29
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Hopewell%2C_Virginia",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Hopewell’s flagship library houses a cyber café, a vast YA collection, and a replica of the 1600s frigate ship Hopewell.",
