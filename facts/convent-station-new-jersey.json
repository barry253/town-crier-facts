  "facts": [
    {
      "id": 1,
      "text": "Convent Station earned its name from a railroad stop built in the 1870s to serve the nearby Academy of Saint Elizabeth.",
      "sourceSentenceIds": [
        2,
        3
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Convent_Station%2C_New_Jersey"
    },
    {
      "id": 2,
      "text": "The Academy of Saint Elizabeth, founded in 1860 by the Sisters of Charity, was the first secondary school for young women in New Jersey.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Convent_Station%2C_New_Jersey"
    },
    {
      "id": 3,
      "text": "Saint Elizabeth University, the oldest college for women in New Jersey, opened on the same campus in 1899 and still operates today.",
      "sourceSentenceIds": [
        8,
        10
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Convent_Station%2C_New_Jersey"
    },
    {
      "id": 4,
      "text": "The present Renaissance Revival train station, completed in 1913, remains a historic landmark on the campus grounds.",
      "sourceSentenceIds": [
        11
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.morristwp.com/214/Convent-Station"
    },
    {
      "id": 5,
      "text": "The Morris County Golf Club, established in 1894, occupies 175 acres of rolling hills just north of Convent Station.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Convent_Station%2C_New_Jersey"
    },
    {
      "id": 6,
      "text": "Convent Station’s municipal building and police headquarters sit beside the Morris Museum, a cultural hub that showcases regional art and history.",
