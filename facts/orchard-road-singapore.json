  "facts": [
    {
      "id": 1,
      "text": "Orchard Road got its name from the nutmeg, pepper, and fruit orchards that once lined the area.",
      "sourceSentenceIds": [
        18,
        19
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Orchard_Road",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "In the 1830s, the area that is now Orchard Road hosted gambier and pepper plantations before shifting to nutmeg and fruit orchards.",
      "sourceSentenceIds": [
        28,
        29
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Orchard_Road",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The first notable shop on Orchard Road was Tangs, founded in 1934 and established on the street in the 1950s.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Orchard_Road",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Orchard Road became a one‑way street east of Scotts Road in 1974 and fully one‑way by 1977 after Orchard Boulevard opened.",
      "sourceSentenceIds": [
        23,
        24
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Orchard_Road",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The Orchard Planning Area, defined by the Urban Redevelopment Authority, stretches from Orange Grove Road to Handy Road, encompassing the famous shopping corridor.",
      "sourceSentenceIds": [
        6,
        27
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Orchard_Road",
      "category": "other",
      "quality": "poor",
      "qualityReason": "vague"
    },
    {
      "id": 6,
      "text": "The underground pedestrian network beneath Orchard Road connects major malls, allowing shoppers to walk between stores without stepping onto the street.",
      "sourceSentenceIds": [
        26
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
