  "facts": [
    {
      "id": 1,
      "text": "Milan, Ohio was founded in 1817 by Ebenezer Merry, who named it Beatty before it became the village of Milan.",
      "sourceSentenceIds": [
        1,
        3
      ],
      "sourceLabels": [
        "Web source 1",
        "Wikipedia"
      ],
      "source": "https://milanohio.gov/about/"
    },
    {
      "id": 2,
      "text": "From the 1830s to the 1850s, Milan thrived as a canal‑powered retail hub thanks to the Erie Canal’s deep ship‑bearing channel.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Milan%2C_Ohio"
    },
    {
      "id": 3,
      "text": "During its canal heyday, Milan built up to 75 schooners, some 125 feet long, for Lake Erie trade.",
      "sourceSentenceIds": [
        14
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://milanohio.gov/about/"
    },
    {
      "id": 4,
      "text": "Thomas Edison was born in Milan in 1847, making the village the inventor’s hometown.",
      "sourceSentenceIds": [
        28,
        24
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 2"
      ],
      "source": "https://en.wikipedia.org/wiki/Milan%2C_Ohio"
    },
    {
      "id": 5,
      "text": "Milan boasts a treasure trove of 19th‑century homes, many listed on the National Register of Historic Places.",
      "sourceSentenceIds": [
