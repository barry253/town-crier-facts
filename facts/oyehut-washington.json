  "facts": [
    {
      "id": 1,
      "text": "Oyehut began as a Quinault Indian village that served as a key crossover point from the Pacific beach to the north shore of Grays Harbor.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/oyehut_hogans_corner_washington",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "White settlers arrived in the late 19th century, turning Oyehut into a rural coastal community as Grays Harbor County expanded.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/oyehut_hogans_corner_washington",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Oyehut sits at the south end of Washington State Route 115, a scenic coastal drive.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Oyehut%2C_Washington",
      "category": "transport",
      "quality": "poor",
      "qualityReason": "route_only"
    },
    {
      "id": 4,
      "text": "Driving east on SR 115 and SR 109 from Oyehut takes you 18 miles to Hoquiam.",
