  "facts": [
    {
      "id": 1,
      "text": "Bow’s name comes from Stratford‑atte‑Bow, meaning \"the paved way to a ford by the bow‑shaped bridge.\".",
      "sourceSentenceIds": [
        23
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.eastlondonhistory.co.uk/east-london-locations-bow/",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "In 1888 workers at the Bryant and May match factory staged the famous matchgirls strike, led by Annie Besant, improving wages and conditions.",
      "sourceSentenceIds": [
        14,
        24
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Bow%2C_London",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The Roman road from London Bridge to Colchester passes through Bow, making it one of Britain’s earliest paved roads.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Bow%2C_London",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Bow contains parts of Victoria Park and the Queen Elizabeth Olympic Park, linking historic green space with Olympic heritage.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Bow%2C_London",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Sylvia Pankhurst, a suffragette and anti‑fascist, lived in Bow and founded the East London Federation of Suffragettes.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
