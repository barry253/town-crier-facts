  "facts": [
    {
      "id": 1,
      "text": "Roaming Shores began when Rock Creek was dammed in 1966, creating Lake Roaming Rock and the Rome Rock Association that owns the private lake community.",
      "sourceSentenceIds": [
        25
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.roamingshoresoh.gov/history",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The village marked its 50th anniversary in 2016, then updated its history book for the 55th in 2021 and the 60th in 2026.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.roamingshores.org/RRA1/the-history-of-roaming-rock-shores/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Lake Roaming Rock was originally planned to cover 450 acres, stretch 4\u00bd miles wide, and offer 16 miles of shoreline.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.roamingshores.org/RRA1/the-history-of-roaming-rock-shores/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The Rome Rock Association once owned every one of the community\u2019s 26 miles of roads, making them private, yet 27 entrances keep the public from being barred.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.roamingshoresoh.gov/history",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Early on, the Association was the sole governing body of this expansive quiet private lakefront community that straddles two townships.",
