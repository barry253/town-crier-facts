  "facts": [
    {
      "id": 1,
      "text": "Bangor is a village in La Crosse County, Wisconsin, situated along the La Crosse River.",
      "sourceSentenceIds": [
        25
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Bangor%2C_Wisconsin"
    },
    {
      "id": 2,
      "text": "Early settlers named Bangor after the town of Bangor in Wales, as many of the original residents were Welsh natives.",
      "sourceSentenceIds": [
        4,
        8
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Bangor%2C_Wisconsin"
    },
    {
      "id": 3,
      "text": "Prior to European settlement, the area of Bangor was inhabited by the Ho-Chunk people, also known as the Winnebago.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/bangor_wisconsin"
    },
    {
      "id": 4,
      "text": "Swiss families followed the early Welsh immigrants to Bangor, claiming much of the surrounding farmland.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/bangor_wisconsin"
    },
    {
      "id": 5,
      "text": "The arrival of the La Crosse and Milwaukee Railroad in 1858 prompted the village of Bangor to relocate a few miles to align with the tracks.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/bangor_wisconsin"
    },
    {
      "id": 6,
      "text": "Early industry in Bangor included the Hussa Brewery, which was founded in 1860 and contributed to the area's economic vitality.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/bangor_wisconsin"
    }
  ]
}
