  "facts": [
    {
      "id": 1,
      "text": "Marlene Village was established in 1949 as a low-cost residential development to meet the postwar housing demand in the Portland area.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/marlene_village_oregon"
    },
    {
      "id": 2,
      "text": "Developer Harry Mittleman named Marlene Village after his infant granddaughter, Marlene Schnitzer, to reflect the community's family-oriented ethos.",
      "sourceSentenceIds": [
        3,
        4
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 2"
      ],
      "source": "https://en.wikipedia.org/wiki/Marlene_Village%2C_Oregon"
    },
    {
      "id": 3,
      "text": "Early homes in Marlene Village cost around eight thousand five hundred dollars and were targeted at returning World War II veterans.",
      "sourceSentenceIds": [
        20,
        30
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/marlene_village_oregon"
    },
    {
      "id": 4,
      "text": "Severe flooding from Cedar Mill Creek once forced some Marlene Village residents to use rowboats to access their homes.",
      "sourceSentenceIds": [
        20
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/marlene_village_oregon"
    },
    {
      "id": 5,
      "text": "The Village Church was established in 1949 as a Baptist church plant amid wooded surroundings during the area's early growth.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/marlene_village_oregon"
    },
    {
      "id": 6,
      "text": "The area was originally inhabited by the Atfalati band of the Kalapuya tribe before European pioneers settled here in the 1850s.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/marlene_village_oregon"
    }
  ]
}
