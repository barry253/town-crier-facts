      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Shaughnessy is home to heritage mansions in classic Edwardian and Tudor styles, many preserved as heritage properties.",
      "sourceSentenceIds": [
        11,
        10
      ],
      "sourceLabels": [
        "Web source 2"
