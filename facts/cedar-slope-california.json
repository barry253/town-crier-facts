      ],
      "source": "https://the50unitedstates.com/california/cedar-slope",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Before settlers arrived, the area that is now Cedar Slope was part of the Yokuts people’s traditional territory in the Sierra Nevada foothills.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 1"
      ],
