  "facts": [
    {
      "id": 1,
      "text": "Seaview began in 1859 when Jonathan Stout, a cooper from Ohio, arrived on the Long Beach Peninsula.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Seaview%2C_Washington",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "In 1889 the Ilwaco Railway and Navigation Company started a narrow‑gauge line that ran up the peninsula to Nahcotta, making Seaview a rail stop.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Seaview%2C_Washington",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The original Stout Hotel, built by Stout, still stands as a historic landmark in Seaview.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.seaviewhistorical.org/historic-seaview",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Charles Beaver, Stout’s son‑in‑law, was a contractor who built several of Seaview’s finest houses.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.seaviewhistorical.org/historic-seaview",
      "category": "people",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Seaview’s name evolved through Stout’s, Ocean View, North Pacific Beach, and finally Sea View, reflecting its ocean outlook.",
      "sourceSentenceIds": [
        18,
        19,
