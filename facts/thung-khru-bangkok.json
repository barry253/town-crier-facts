      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The Bangkok Noi Canal cuts through Thung Khru, offering scenic waterways that echo the city’s historic canal transport.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 1"
      ],
