      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Originally a rice‑farming district, Thung Khru became a residential and educational hub during Bangkok’s 20th‑century expansion.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
