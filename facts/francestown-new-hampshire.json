  "facts": [
    {
      "id": 1,
      "text": "Francestown was incorporated in 1772 and named after Frances Deering Wentworth, wife of colonial governor John Wentworth.",
      "sourceSentenceIds": [
        1,
        11
      ],
      "sourceLabels": [
        "Web source 1",
        "Wikipedia"
      ],
      "source": "https://www.francestownnh.org/1241/History-of-Francestown",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "From 1792 to 1912, high‑quality soapstone was quarried in Francestown, supplying blocks for churches and public buildings.",
      "sourceSentenceIds": [
        13
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Francestown%2C_New_Hampshire",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The town’s highest point is the summit of Crotched Mountain, rising to 2,066 feet on its western border.",
      "sourceSentenceIds": [
        14
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Francestown%2C_New_Hampshire",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Francestown once collected a one‑cent‑per‑mile toll from coaches on the Second New Hampshire Turnpike, the sole route between Boston and Vermont.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Francestown%2C_New_Hampshire",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The historic district includes the 18th‑century Meetinghouse, Town Hall, and Academy, all preserved on the town common.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Francestown%2C_New_Hampshire",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The Levi Woodbury Homestead, home of a former U.S. Supreme Court justice, sits within Francestown’s historic core.",
      "sourceSentenceIds": [
