  "facts": [
    {
      "id": 1,
      "text": "Montgomery was founded in 1835 by Daniel Gray, who built the first wooden house there in 1836 and later named the village after his New York county.",
      "sourceSentenceIds": [
        15,
        18,
        21
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Montgomery%2C_Illinois",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "In 1858 the village of Montgomery was officially incorporated, with Ralph Gray, Daniel’s son, elected its first president.",
      "sourceSentenceIds": [
        24,
        25
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Montgomery%2C_Illinois",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The 1990 Montgomery Historical Committee book, “The History of Montgomery, Illinois in Words and Pictures,” was so popular it was reprinted twice and again in 2014 with a grant‑funded update.",
      "sourceSentenceIds": [
        3,
        12
      ],
      "sourceLabels": [
