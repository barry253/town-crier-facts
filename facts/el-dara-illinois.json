  "facts": [
    {
      "id": 1,
      "text": "El Dara began in 1836 when Nathaniel Winters founded the village as Washington, later renamed during the Mexican War.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/el_dara_illinois"
    },
    {
      "id": 2,
      "text": "In 1847, a local resident misspelled Eldora, Mexico, as El Dara when naming the settlement.",
      "sourceSentenceIds": [
        21
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/el_dara_illinois"
    },
    {
      "id": 3,
      "text": "Early El Dara boasted a flour mill and a tobacco factory that processed leaves for market sale.",
      "sourceSentenceIds": [
        3,
        6
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/el_dara_illinois"
    },
    {
      "id": 4,
      "text": "Two historic churches, built in 1854 and 1876, stand as El Dara’s oldest surviving structures.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/el_dara_illinois"
    },
    {
      "id": 5,
      "text": "Floods from Sny levee breaks in the 1870s and 1880s devastated crops and forced residents to rebuild bottomlands.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/el_dara_illinois"
    },
    {
      "id": 6,
      "text": "El Dara helped found the Pike County Old Settlers’ Association in 1872, hosting annual meetings with music and relic displays.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/el_dara_illinois"
    }
  ]
