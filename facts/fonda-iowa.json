  "facts": [
    {
      "id": 1,
      "text": "Fonda’s name comes from the Latin word for \"fountain,\" chosen because the town sits near Sunken Grove, an area that was flooded most of the year.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://fondaiowa.com/community/history/"
    },
    {
      "id": 2,
      "text": "Fonda was founded in 1870 and lies in Cedar Township, the southwest corner of Pocahontas County.",
      "sourceSentenceIds": [
        13
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://fondaiowa.com/"
    },
    {
      "id": 3,
      "text": "Four miles northwest of Fonda, the Sunken Grove Wildlife Management Area preserves the region’s historic wetlands.",
      "sourceSentenceIds": [
        27
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Fonda%2C_Iowa"
    },
    {
      "id": 4,
      "text": "Surrounding Fonda, the landscape features wetlands, glacial erratics, concentric ridges, and expansive flat areas.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Fonda%2C_Iowa"
    },
    {
      "id": 5,
      "text": "Big Cedar Creek, a tributary of the Raccoon River, was channelized in the early 1900s and now flows past Fonda’s west side.",
      "sourceSentenceIds": [
        24,
        25
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
