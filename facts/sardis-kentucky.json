  "facts": [
    {
      "id": 1,
      "text": "Sardis was founded in the early 19th century by War of 1812 veteran Luke Dye and incorporated on February 14, 1850.",
      "sourceSentenceIds": [
        1,
        5
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/sardis_kentucky"
    },
    {
      "id": 2,
      "text": "The town’s name comes from the biblical Sardis mentioned in Revelation or the ancient Lydian capital, reflecting early settlers’ religious influences.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/sardis_kentucky"
    },
    {
      "id": 3,
      "text": "Sardis sits on a ridge that drains north to Smith Branch and south to Five Lick Creek, linking it to the Licking River watershed.",
      "sourceSentenceIds": [
        14
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Sardis%2C_Kentucky"
    },
    {
      "id": 4,
      "text": "In 1915 an electric plant was built and expanded in 1916 to power the Sardis Opera House, a cultural venue for plays and music.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/sardis_kentucky"
    },
    {
      "id": 5,
      "text": "Confederate General John Hunt Morgan’s men ransacked Sardis on June 12, 1864, during the Civil War.",
      "sourceSentenceIds": [
        25
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://oldwashingtonky.com/sardis/"
    },
    {
      "id": 6,
      "text": "The first trustees of Sardis included Luke Dye, John Murphy, Isaac Reid, James Vanderburg, and Peyton White.",
