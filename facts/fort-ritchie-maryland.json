  "facts": [
    {
      "id": 1,
      "text": "Fort Ritchie started as a Maryland National Guard training site before becoming a World War II Army camp.",
      "sourceSentenceIds": [
        5,
        25
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Fort_Ritchie%2C_Maryland",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "During World War II, Camp Ritchie trained the Ritchie Boys, interrogators who later served in every conflict from Korea to the Gulf War.",
      "sourceSentenceIds": [
        6,
        26
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.ritchierevival.com/history",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "After the war, the site was upgraded to permanent Fort Ritchie and stayed active until its closure in 1998.",
      "sourceSentenceIds": [
        6,
        23
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.ritchierevival.com/history",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The Ritchie History Museum now occupies the former Brigade Officers Mess Hall, built 1932‑34 and later turned into a memorial library.",
      "sourceSentenceIds": [
        20,
        8
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.ritchiemuseum.org/",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The museum hosts a digital archive funded by the National Endowment of Humanities, preserving thousands of documents about Fort Ritchie's military history.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.ritchiemuseum.org/",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "In 2026, the museum will celebrate Fort Ritchie's 100th anniversary by laying a time capsule on June 20 at 4 p.m.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
