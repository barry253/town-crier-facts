  "facts": [
    {
      "id": 1,
      "text": "Jacksonville began in 1847 on the east bank of Gum Creek, when a blacksmith shop became the town’s first post office.",
      "sourceSentenceIds": [
        13,
        25
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Jacksonville%2C_Texas",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "In 1872 the International‑Great Northern Railroad bypassed Jacksonville, prompting residents to survey a new townsite right on the tracks.",
      "sourceSentenceIds": [
        10,
        11
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://jacksonvilletx.org/150/History-of-Jacksonville",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The town’s name honors two early settlers, William Jackson and a second namesake, chosen when the post office changed from Gum Creek in 1850.",
      "sourceSentenceIds": [
        26,
        27,
        28
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Jacksonville%2C_Texas",
      "category": "people",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The new Jacksonville Public Library opened in April 2021 inside the Norman Activities Center, replacing a 70‑year‑old building on the same site.",
      "sourceSentenceIds": [
        16,
        18
      ],
      "sourceLabels": [
        "Wikipedia",
