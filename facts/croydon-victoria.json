  "facts": [
    {
      "id": 1,
      "text": "Croydon got its name from the Lacey family, who named the area after Mrs Lacey's hometown in Essex, England.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Croydon%2C_Victoria",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town’s railway station was renamed Croydon on 1 August 1884, replacing the original name Warrandyte.",
      "sourceSentenceIds": [
        2,
        25
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Croydon%2C_Victoria",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Early Croydon industries included clay extraction for ceramics, charcoal production for Melbourne, and a broom factory that used local sword grass.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.maroondah.vic.gov.au/Explore/About-our-City/History-of-Maroondah/History-of-Croydon",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Magda Szubanski, the beloved comedian and actress, grew up in Croydon, adding a touch of national fame to the suburb.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Croydon%2C_Victoria",
      "category": "people",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The Croydon Historical Society Museum houses a research room where visitors can access local newspapers, maps, and family records.",
      "sourceSentenceIds": [
        16,
        19
      ],
      "sourceLabels": [
        "Web source 1",
        "Web source 2"
      ],
      "source": "https://www.maroondah.vic.gov.au/Explore/About-our-City/History-of-Maroondah/History-of-Croydon",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Croydon is home to 3ECB, the community radio station Radio Eastern FM 98.1, which broadcasts local news and music.",
