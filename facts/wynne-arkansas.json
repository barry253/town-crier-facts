  "facts": [
    {
      "id": 1,
      "text": "Wynne takes its name from Captain Jesse Watkins Wynne, a Texan who earned the rank of captain in the Civil War at just 21.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Wynne%2C_Arkansas"
    },
    {
      "id": 2,
      "text": "When the east–west railroad crossed the north–south line near a boxcar, the area became known as Wynne Junction.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Wynne%2C_Arkansas"
    },
    {
      "id": 3,
      "text": "A boxcar turned upright became Wynne Station, and the town’s first post office opened there on September 27, 1882.",
      "sourceSentenceIds": [
        19,
        20
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Wynne%2C_Arkansas"
    },
    {
      "id": 4,
      "text": "The Cross County Historical Society operates the Cross County Museum, preserving the region’s heritage in Wynne.",
      "sourceSentenceIds": [
        13
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.crosscountyar.org/museum"
    },
    {
      "id": 5,
      "text": "KWYN, the main radio station in Wynne, broadcasts under the East Arkansas Broadcasters umbrella.",
      "sourceSentenceIds": [
        22,
        23
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Wynne%2C_Arkansas"
    },
    {
      "id": 6,
      "text": "Wynne serves as the largest city and county seat of Cross County, Arkansas.",
