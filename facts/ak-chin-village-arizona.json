  "facts": [
    {
      "id": 1,
      "text": "Ak-Chin means 'mouth of the wash' in O’odham, reflecting the community’s connection to the local wash.",
      "sourceSentenceIds": [
        15
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://ak-chin.nsn.us/",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "President Taft signed a reservation for Ak-Chin in 1912, but the land was cut to under 22,000 acres the next year.",
      "sourceSentenceIds": [
        27
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://ak-chin.nsn.us/about/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "A 1984 federal settlement granted Ak-Chin water rights to the Colorado River, sustaining its irrigation-based agriculture.",
      "sourceSentenceIds": [
        29
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://ak-chin.nsn.us/about/",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Ak-Chin Farms became the community’s first major enterprise, anchoring its agricultural economy.",
      "sourceSentenceIds": [
        30
      ],
      "sourceLabels": [
