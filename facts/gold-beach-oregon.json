  "facts": [
    {
      "id": 1,
      "text": "Gold Beach got its name from miners who found gold in the sands at the Rogue River mouth in the early 1850s.",
      "sourceSentenceIds": [
        1,
        11
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 2"
      ],
      "source": "https://en.wikipedia.org/wiki/Gold_Beach%2C_Oregon",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Mailboats out of Gold Beach have been delivering mail upstream to Agness since 1895, one of only two rural routes left in the U.S.",
      "sourceSentenceIds": [
        21
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Gold_Beach%2C_Oregon",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Timber harvesting became Gold Beach’s largest industry until the early 1980s, when over‑harvesting cut the supply.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.goldbeachoregon.gov/index.asp?SEC=93B7C715-15A2-424E-A704-D77E23235915&DE=5E468501-D85E-42CA-96B5-3DC9B6E06E47",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The 1932 Rogue River Bridge features Art Deco scoring and banding on Tuscan‑style columns, a rare coastal example.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.travelgoldbeach.com/history",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Settlers clashed with the Tututni, whose forced relocation to Siletz and Grand Ronde Reservations marked a tragic chapter.",
      "sourceSentenceIds": [
        10,
        16
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.travelgoldbeach.com/history",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Gold Beach enjoys cool, wet winters and mild, dry summers, keeping temperature swings very narrow for its latitude.",
