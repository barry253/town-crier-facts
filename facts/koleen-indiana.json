    },
    {
      "id": 3,
      "text": "A narrow‑gauge railroad ran through Koleen, built by the Bedford, Springville, Owensburg, and Bloomfield Railroad Company in the late 1800s.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Web source 1"
