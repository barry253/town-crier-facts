  "facts": [
    {
      "id": 1,
      "text": "Charleston was the filming location for the 1960 Elia Kazan drama Wild River, spotlighting rural South tensions over dam construction and civil rights.",
      "sourceSentenceIds": [
        1,
        17
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/charleston_tennessee",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The East Tennessee & Georgia Railroad bridge over the Hiwassee River, completed in 1842, turned Charleston into a vital Confederate supply line during the Civil War.",
      "sourceSentenceIds": [
        2,
        16
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/charleston_tennessee",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Named for Colonel Edward Bradley, Charleston began as a ferry crossing in 1808 by Major John Walker Sr., later becoming a key river hub.",
      "sourceSentenceIds": [
        6,
        23
      ],
      "sourceLabels": [
        "Web source 2",
        "Wikipedia"
      ],
      "source": "https://grokipedia.com/page/charleston_tennessee",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Charleston hosts the international headquarters of The Church of God, a distinct Christian denomination headquartered there.",
      "sourceSentenceIds": [
