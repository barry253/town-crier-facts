    },
    {
      "id": 2,
      "text": "Ben Bibo ran a trading post in Bibo from 1895 until 1920, serving nearby pueblos and ranchers.",
      "sourceSentenceIds": [
        15
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Bibo%2C_New_Mexico"
    },
    {
      "id": 3,
      "text": "Bibo sits on Mount Taylor’s southeast slope, about 15 miles north of Laguna Pueblo.",
      "sourceSentenceIds": [
        28
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/bibo_new_mexico"
    },
    {
      "id": 4,
      "text": "Solomon Bibo married an Acoma woman in 1885, blending Pueblo and Jewish traditions in their household.",
