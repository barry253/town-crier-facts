  "facts": [
    {
      "id": 1,
      "text": "Kimball was named after early settler Frye Kimball, who helped establish the town in the late 19th century.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Kimball%2C_Minnesota"
    },
    {
      "id": 2,
      "text": "The Forest City Stockade stands as a historic landmark, reflecting the complex history between settlers and Native Americans.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://kimballarea.com/history"
    },
    {
      "id": 3,
      "text": "When the Soo-Line Railroad chose Kimball Prairie over nearby Maine Prairie in 1886, the town became a key freight and passenger stop.",
      "sourceSentenceIds": [
        16,
        18
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.ci.kimball.mn.us/index.asp?SEC=BF3CDC8C-500A-4F63-A938-D345E5C508E6&Type=B_BASIC"
    },
    {
      "id": 4,
      "text": "Kimball's 1908 City Hall is the only property in the city listed on the National Register of Historic Places.",
      "sourceSentenceIds": [
        13
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Kimball%2C_Minnesota"
    },
    {
      "id": 5,
      "text": "Every year the Forest City Stockade hosts threshers events and historical reenactments that bring Minnesota’s pioneer past to life.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://kimballarea.com/history"
    },
    {
      "id": 6,
      "text": "The original pioneer village featured churches, stores, a lodge hall, a blacksmith shop, and a cheese factory.",
      "sourceSentenceIds": [
        10
      ],
