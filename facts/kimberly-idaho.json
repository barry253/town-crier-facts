  "facts": [
    {
      "id": 1,
      "text": "Kimberly was founded in 1905 as part of a land development initiative in the Snake River Plain.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/kimberly_idaho"
    },
    {
      "id": 2,
      "text": "The city of Kimberly is named in honor of Peter L. McMillan.",
      "sourceSentenceIds": [
        5,
        6,
        10
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/kimberly_idaho"
    },
    {
      "id": 3,
      "text": "Peter L. McMillan is recognized as the founding father of Kimberly for overseeing the town's rapid infrastructure growth.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/kimberly_idaho"
    },
    {
      "id": 4,
      "text": "Kimberly emerged from an ambitious project to reclaim over a million acres for farming in the Magic Valley.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/kimberly_idaho"
    },
    {
      "id": 5,
      "text": "The development of Kimberly was supported by the Carey Act of 1901, which promoted irrigation in arid western lands.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/kimberly_idaho"
    },
    {
      "id": 6,
      "text": "Kimberly is located in Twin Falls County and is part of the Twin Falls Metropolitan Statistical Area.",
      "sourceSentenceIds": [
        12,
        13
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Kimberly%2C_Idaho"
