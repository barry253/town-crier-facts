  "facts": [
    {
      "id": 1,
      "text": "Cedar Grove was originally called Rochester when John Ward platted it in 1837, but was renamed for the cedar groves along Pipe Creek.",
      "sourceSentenceIds": [
        1,
        2
      ],
      "sourceLabels": [
        "Web source 2",
        "Wikipedia"
      ],
      "source": "https://grokipedia.com/page/cedar_grove_indiana",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Ward built a large gristmill in Cedar Grove, which survived the 1847 flood and later powered local industry.",
      "sourceSentenceIds": [
        15,
        3
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 2"
      ],
      "source": "https://en.wikipedia.org/wiki/Cedar_Grove%2C_Indiana",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The 1914 Cedar Grove Bridge, a two‑span camelback Pratt truss, replaced an 1870 bridge lost in the 1913 flood and now sits on the National Register.",
      "sourceSentenceIds": [
        6,
        7,
        4
      ],
      "sourceLabels": [
        "Web source 2",
        "Wikipedia"
      ],
      "source": "https://grokipedia.com/page/cedar_grove_indiana",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Late‑1830s canal construction and later railroads turned Cedar Grove into a transport hub, keeping the town prosperous into the 20th century.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/cedar_grove_indiana",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Cedar Grove officially became an incorporated town in 1907, marking its transition from a rural settlement to a formal municipality.",
      "sourceSentenceIds": [
        16
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Cedar_Grove%2C_Indiana",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The 386‑foot Cedar Grove Bridge carried traffic until 1999, after which it was closed to vehicles but remains a landmark.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Web source 2"
      ],
