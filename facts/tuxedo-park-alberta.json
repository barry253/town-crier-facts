  "facts": [
    {
      "id": 1,
      "text": "Tuxedo Park is a residential neighbourhood in the northeast and northwest quadrants of Calgary, Alberta.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Tuxedo_Park%2C_Calgary",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The community is bisected by Centre Street from north to south, giving it a distinctive north‑south layout.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Tuxedo_Park%2C_Calgary",
      "category": "other",
      "quality": "poor",
      "qualityReason": "vague"
    },
    {
      "id": 3,
      "text": "Annexed by Calgary in 1910 and established as a neighbourhood in 1929, Tuxedo Park has a long municipal history.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Tuxedo_Park%2C_Calgary",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The first home built in the area, a three‑story farmhouse, still stands and has been declared a historic site.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://calgarycommunities.com/ca_neighbourhood/tuxedo-park/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "In 2020, Calgary City Council approved the construction of 16 Avenue North Station, part of the Calgary Green Line, on Centre Street.",
