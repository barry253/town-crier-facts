      "quality": "good"
    },
    {
      "id": 2,
      "text": "The name 'Yuba' derives from the Spanish word 'uva'—grape—named after wild grapes spotted by early explorers.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
