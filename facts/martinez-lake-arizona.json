      "quality": "good"
    },
    {
      "id": 2,
      "text": "The lake’s name honors the early Martinez ranchers who grazed along the Colorado River in the early 1900s.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/martinez_lake",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Martinez Lake formed when the Imperial Dam completed in 1935, creating a backwater of the Imperial Reservoir.",
      "sourceSentenceIds": [
        8,
        26
      ],
      "sourceLabels": [
        "Web source 2",
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/martinez_lake",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Temperatures swing from 48°F in winter to over 107°F in summer, driving high evaporation rates.",
