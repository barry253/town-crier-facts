      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The historic Stamford Park homestead has been restored recently by Knox Council, preserving a key piece of the suburb’s heritage.",
      "sourceSentenceIds": [
        25
      ],
      "sourceLabels": [
