  "facts": [
    {
      "id": 1,
      "text": "Redfield was founded in 1878, when settlers first arrived and a post office opened as Stennett Junction before the town adopted its current name in 1881.",
      "sourceSentenceIds": [
        15
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Redfield%2C_South_Dakota",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town grew into a railroad hub, sitting at the crossroads of the Chicago and North Western Railway and the Milwaukee Road Railroad.",
      "sourceSentenceIds": [
        6,
        12
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 2"
      ],
      "source": "https://en.wikipedia.org/wiki/Redfield%2C_South_Dakota",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Redfield became Spink County’s seat in 1886 after a six‑year legal battle among neighboring towns.",
      "sourceSentenceIds": [
        16
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Redfield%2C_South_Dakota",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Redfield College opened in 1887 and served the community until 1932, leaving a legacy of early higher‑education in the region.",
      "sourceSentenceIds": [
        17
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Redfield%2C_South_Dakota",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "In 1902 the Northern Hospital for the Insane opened just north of town, a facility that still operates today as the South Dakota Developmental Center.",
      "sourceSentenceIds": [
        18,
        19
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Redfield%2C_South_Dakota",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Three U.S. Presidents—William McKinley, William Howard Taft, and Franklin D. Roosevelt—visited Redfield during their travels in the early 20th century.",
      "sourceSentenceIds": [
