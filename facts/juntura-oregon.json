      "id": 1,
      "text": "Juntura takes its name from the Spanish word for juncture, reflecting its location at the confluence of the Malheur River and its North Fork.",
      "sourceSentenceIds": [
        1,
        2,
        5
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Juntura%2C_Oregon"
    },
    {
      "id": 2,
      "text": "Fur trapper Peter Skene Ogden discovered the junction of the Malheur River at Juntura in 1828 while traveling with the Hudson's Bay Company.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/juntura_oregon"
    },
    {
      "id": 3,
      "text": "The Juntura post office was established in 1890 and continues to operate today.",
