  "facts": [
    {
      "id": 1,
      "text": "Metamora hosts the only surviving wooden aqueduct in the U.S., the Duck Creek Aqueduct, built in 1843 and partially destroyed by a flood in 1846.",
      "sourceSentenceIds": [
        1,
        5
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 2"
      ],
      "source": "https://en.wikipedia.org/wiki/Metamora%2C_Indiana",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The Whitewater Canal, which once carried boats from 1839 to 1865, powered mills that processed cotton, flour, and paper until 1936.",
      "sourceSentenceIds": [
        28,
        29
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Metamora%2C_Indiana",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Metamora was platted in 1838 and named after the play “Metamora; or, The Last of the Wampanoags” by John Augustus Stone.",
      "sourceSentenceIds": [
        26,
        27
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Metamora%2C_Indiana",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The town’s historic grist mill, still operating, is Indiana’s oldest and continues to grind corn into flour, meal, and grits.",
      "sourceSentenceIds": [
        30
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Metamora%2C_Indiana",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "A guided walking tour of the Whitewater Canal lets visitors see the canal’s brick buildings dating back to the 1830s on Metamora’s west side.",
      "sourceSentenceIds": [
        12,
        13
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.indianamuseum.org/historic-sites/whitewater-canal-historic-site/things-to-do/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The Duck Creek Aqueduct is a National Historic Civil Engineering Landmark and is listed on the National Register of Historic Places.",
      "sourceSentenceIds": [
        2,
        5
      ],
