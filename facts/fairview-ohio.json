  "facts": [
    {
      "id": 1,
      "text": "Fairview Park began as part of Rockport Township before becoming the Rocky River hamlet.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Fairview_Park%2C_Ohio"
    },
    {
      "id": 2,
      "text": "The village incorporated in 1903 and split in 1910, with the north becoming Rocky River and the south becoming Goldwood.",
      "sourceSentenceIds": [
        11
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Fairview_Park%2C_Ohio"
    },
    {
      "id": 3,
      "text": "Goldwood later divided again, and the northern section evolved into Fairview Village.",
      "sourceSentenceIds": [
        13
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Fairview_Park%2C_Ohio"
    },
    {
      "id": 4,
      "text": "In 1948 the community renamed itself Fairview Park, marking a new chapter in its history.",
      "sourceSentenceIds": [
        19
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Fairview_Park%2C_Ohio"
    },
    {
      "id": 5,
      "text": "The 1947 opening of Fairview Shopping Center on Lorain Road drew former Cleveland residents into the area.",
      "sourceSentenceIds": [
        21
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Fairview_Park%2C_Ohio"
    },
    {
      "id": 6,
      "text": "By 1950 the village’s population had grown to 9,234, prompting its designation as the City of Fairview Park.",
      "sourceSentenceIds": [
        22
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Fairview_Park%2C_Ohio"
    }
  ]
}
