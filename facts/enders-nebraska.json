      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Enders%2C_Nebraska",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The 1,707‑acre Enders Reservoir, created by the 1947‑1951 Enders Dam, sits on the north shore of the village and offers 26 miles of shoreline.",
