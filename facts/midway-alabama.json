  "facts": [
    {
      "id": 1,
      "text": "Midway first settled after the 1832 Creek land cession, originally part of Barbour County before becoming part of Bullock County.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/midway_alabama",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Midway incorporated in 1870, and the Montgomery‑Eufaula Railroad arrived in the early 1870s, linking it to regional trade.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://encyclopediaofalabama.org/article/midway/",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The Old Merritt School, built in 1921 on land donated by Mary Elizabeth Merritt, is a Rosenwald‑funded school now listed on the National Register.",
      "sourceSentenceIds": [
        5,
        12,
        4,
        28,
        29,
        30
      ],
      "sourceLabels": [
        "Web source 1",
        "Web source 2",
        "Wikipedia"
      ],
      "source": "https://encyclopediaofalabama.org/article/midway/",
      "category": "other",
      "quality": "poor",
      "qualityReason": "editorial_filler"
    },
    {
      "id": 4,
      "text": "The boll weevil that struck in 1915 devastated Midway’s cotton yields, prompting a shift to peanuts, corn, and pecans.",
      "sourceSentenceIds": [
        14
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/midway_alabama"
    },
    {
      "id": 5,
      "text": "Midway earned Alabama Register of Landmarks and Heritage status in 1990 and National Register of Historic Places listing in 1998.",
