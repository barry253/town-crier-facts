  "facts": [
    {
      "id": 1,
      "text": "Chuathbaluk, called Little Russian Mission to avoid confusion with the Yukon’s Russian Mission, adopted its Yup'ik name meaning 'the hills where the big blueberries grow' in the 1960s.",
      "sourceSentenceIds": [
        4,
        19
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Chuathbaluk%2C_Alaska",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "An influenza epidemic in 1900 devastated Chuathbaluk, causing a significant loss of residents and reshaping the community’s early history.",
      "sourceSentenceIds": [
        4,
        8
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Chuathbaluk%2C_Alaska",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Sergius Chapel, a Russian Orthodox church built around 1891, stands as Chuathbaluk’s most significant landmark and is listed on the National Register of Historic Places.",
      "sourceSentenceIds": [
        3,
        9,
        12,
        14
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.kupi.com/en/explore/united-states/chuathbaluk",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Just north of Chuathbaluk rises the Russian Mountains, a small circular range that adds a distinctive geological feature to the landscape.",
      "sourceSentenceIds": [
        17
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Chuathbaluk%2C_Alaska",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Chuathbaluk’s cultural heritage blends Alaska Native traditions with early Russian influences, creating a unique identity that resonates with residents and visitors alike.",
      "sourceSentenceIds": [
