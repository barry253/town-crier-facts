  "facts": [
    {
      "id": 1,
      "text": "McLoud was founded in 1895 and named after John William McLoud, an attorney for the Choctaw, Oklahoma and Gulf Railroad.",
      "sourceSentenceIds": [
        1,
        2,
        5
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/McLoud%2C_Oklahoma"
    },
    {
      "id": 2,
      "text": "Early day McLoud was known for manufacturing and selling whiskey to whites and American Indians in dry Indian Territory.",
      "sourceSentenceIds": [
        15
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/McLoud%2C_Oklahoma"
    },
    {
      "id": 3,
      "text": "The original town of McLoud was destroyed in a flood and rebuilt on higher ground one mile south.",
      "sourceSentenceIds": [
        16
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/McLoud%2C_Oklahoma"
    },
    {
      "id": 4,
      "text": "McLoud was recognized as the Blackberry Capital of the World in 1949 after the Chamber of Commerce sent berries to President Harry Truman.",
      "sourceSentenceIds": [
        20
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/McLoud%2C_Oklahoma"
    },
    {
      "id": 5,
      "text": "The McLoud Historical Museum and Heritage Center houses a collection of artifacts and documents related to the history of the city.",
      "sourceSentenceIds": [
        8,
        9
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.travelok.com/listings/view.profile/id.32243"
    },
    {
      "id": 6,
      "text": "McLoud is located in the Crosstimbers ecoregion and the Frontier Country tourism region of northwestern Pottawatomie County.",
