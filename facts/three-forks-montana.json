  "facts": [
    {
      "id": 1,
      "text": "Three Forks was founded September 17, 1908 by John Q. Adams, who moved the Madison Bridge House and the Sacajawea Hotel to the new site.",
      "sourceSentenceIds": [
        7,
        8,
        19
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Three_Forks%2C_Montana",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Three Forks sits where the Jefferson, Madison, and Gallatin rivers meet, the birthplace of the Missouri River.",
      "sourceSentenceIds": [
        10,
        12
      ],
      "sourceLabels": [
        "Web source 2",
        "Wikipedia"
      ],
      "source": "https://discoverthreeforks.com/",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "In 1909 the bustling community boasted a newspaper, eight saloons, a cement factory, and a railroad division point on the Milwaukee Road.",
      "sourceSentenceIds": [
        1,
        13
      ],
      "sourceLabels": [
        "Web source 1",
        "Wikipedia"
      ],
      "source": "https://threeforksmontana.us/about-us-history",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The historic Sacajawea Hotel, originally the Madison Bridge House, still stands as a National Historic Landmark.",
      "sourceSentenceIds": [
        1,
        3,
        19
      ],
      "sourceLabels": [
        "Web source 1",
        "Wikipedia"
      ],
      "source": "https://threeforksmontana.us/about-us-history",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Headwaters Heritage Museum in downtown preserves exhibits on Native American history, Lewis & Clark, and the early homesteading era.",
      "sourceSentenceIds": [
