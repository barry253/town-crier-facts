      ],
      "source": "https://mercercountyhistoricalsociety.net/"
    },
    {
      "id": 3,
      "text": "The Mercer County Historical Society, founded in 1957, preserves local history and operates the Mercer County War Museum and Agricultural Museum.",
      "sourceSentenceIds": [
