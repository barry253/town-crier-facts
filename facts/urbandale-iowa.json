  "facts": [
    {
      "id": 1,
      "text": "Urbandale was incorporated April 16, 1917, emerging as a streetcar suburb of Des Moines and home to several coal mines.",
      "sourceSentenceIds": [
        11
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://communityhistoryarchives.com/places/urbandale-historical-society/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The Urbandale Historical Society, founded in 1976, preserves the town’s streetcar era, coal‑mining past, and post‑war suburban growth.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://communityhistoryarchives.com/places/urbandale-historical-society/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The original Urbandale neighborhood later became Beaverdale to avoid confusion with the new development that took the Urbandale name in 1907.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.urbandale.org/412/Urbandales-History",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "A 1905 railroad line intended to reach Woodward ended at 70th and Roseland, now marked by Trolley Park, because of right‑of‑way issues.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.urbandale.org/412/Urbandales-History",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Living History Farms hosted Pope John Paul II in 1979, where he addressed an estimated 350,000 people.",
      "sourceSentenceIds": [
