  "facts": [
    {
      "id": 1,
      "text": "Founded in 1887 by former slaves led by Isaiah Montgomery, Mound Bayou became the first independent Black community in Mississippi.",
      "sourceSentenceIds": [
        6,
        10
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Mound_Bayou%2C_Mississippi",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town purchased land from the Louisville, New Orleans, and Texas Railroad Company, choosing a fertile spot in the Delta.",
      "sourceSentenceIds": [
        22
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.cityofmoundbayou.com/our-history",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Mound Bayou Normal Institute, a Black school founded in 1892 by the American Missionary Association, educated generations of Delta youth.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Mound_Bayou%2C_Mississippi",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "In 1967, Delta Health Center opened in Mound Bayou as the first rural community health center in the United States.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Mound_Bayou%2C_Mississippi",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Taborian Hospital, built in 1909, served as a vital medical facility for the community and remains a historic landmark.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Mound_Bayou%2C_Mississippi",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Mound Bayou’s legacy as a beacon of Black self‑determination is highlighted in its annual festivals that celebrate resilience and achievement.",
      "sourceSentenceIds": [
        20,
