  "facts": [
    {
      "id": 1,
      "text": "The name Castorland, New York, translates to 'Land of the Beaver', reflecting its historical ties to the region's wildlife.",
      "sourceSentenceIds": [
        2,
        5
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Castorland%2C_New_York",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Castorland was founded in 1792 by refugees from the French Revolution seeking a peaceful new home away from the violence in France.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Castorland%2C_New_York",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The village is situated in the southeast corner of the town of Denmark, near the Black River and Beaver River confluence.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Castorland%2C_New_York",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Due to harsh winters and poor planning, the original Castorland colony was dissolved in 1814, leading many settlers to return to Europe.",
      "sourceSentenceIds": [
        6,
        7
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Castorland%2C_New_York",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "In 1796, the Paris Mint struck a token to commemorate the Franco-American Colony of Castorland, which remains a collector's item today.",
      "sourceSentenceIds": [
        17
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Castorland%2C_New_York",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Castorland, New York, is located north of Lowville and southeast of Carthage, making it a unique spot in Lewis County.",
