  "facts": [
    {
      "id": 1,
      "text": "Glenrock began as Deer Creek Station, a pioneer trading post on the Oregon Trail in the 1850s.",
      "sourceSentenceIds": [
        1,
        4
      ],
      "sourceLabels": [
        "Web source 1",
        "Wikipedia"
      ],
      "source": "https://conversecountytourism.com/plan/visit-glenrock",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Glenrock sits at the confluence of Deer Creek and the North Platte River, once a key stage relay point.",
      "sourceSentenceIds": [
        5,
        7
      ],
      "sourceLabels": [
        "Web source 2",
        "Web source 1"
      ],
      "source": "https://wakeupwyo.com/the-most-important-unknown-town-in-wyoming-history/",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The historic downtown features the Commerce Block, built in 1917 and listed on the National Register of Historic Places.",
      "sourceSentenceIds": [
