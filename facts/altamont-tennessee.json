  "facts": [
    {
      "id": 1,
      "text": "Altamont’s name blends the Spanish alto for “high” with mont for “mountain,” hinting at its hilltop setting.",
      "sourceSentenceIds": [
        11
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Altamont%2C_Tennessee"
    },
    {
      "id": 2,
      "text": "The Grundy County Courthouse, standing since 1859, has been the town’s civic heart for over a century.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.southcumberlandchamber.com/altamont-tennessee-south-cumberland-chamber-of-commerce"
    },
    {
      "id": 3,
      "text": "In 1988, Altamont’s old school was repurposed into City Hall, the Library, and Museum, preserving its historic charm.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Altamont%2C_Tennessee"
    },
    {
      "id": 4,
      "text": "Altamont hosts one of the southeastern United States’ oldest Mormon congregations, founded in the 1890s.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Altamont%2C_Tennessee"
    },
    {
      "id": 5,
      "text": "Perched on the southern Cumberland Plateau, Altamont sits between the Highland Rim escarpment and Savage Gulf gorge.",
      "sourceSentenceIds": [
        18
