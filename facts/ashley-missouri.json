  "facts": [
    {
      "id": 1,
      "text": "Ashley earned its name from explorer William Henry Ashley, who served as Missouri’s lieutenant governor in the 1820s.",
      "sourceSentenceIds": [
        1,
        7,
        17
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
