      ],
      "source": "https://www.franklinohio.org/residents/history.php",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Franklin hosts the Franklin Public Library, a branch of the Franklin‑Springboro Public Library system.",
