      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "By the early 1890s, paper making dominated Franklin’s economy, with five factories operating in the village.",
      "sourceSentenceIds": [
        11
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.franklinohio.org/residents/history.php",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The Uhlenbrock Cigar Factory, once a major employer, still exists today as the Eldridge Publishing Company, now based in Florida.",
      "sourceSentenceIds": [
        13,
