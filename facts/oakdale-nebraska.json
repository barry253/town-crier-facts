      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.antelopecountymuseum.org/towns/oakdale",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Oakdale sits on the south bank of Cedar Creek, about a mile west of its confluence with the Elkhorn, at roughly 1,600 feet elevation.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 2"
      ],
