      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town was named after Peter Chardon Brooks, who donated land for the village.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.buckeyetrail.org/towns/chardon",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Chardon Square, the historic heart, was rebuilt after a 1868 fire that destroyed the courthouse and many stores.",
      "sourceSentenceIds": [
        20,
