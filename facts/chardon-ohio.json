      ],
      "source": "https://en.wikipedia.org/wiki/Chardon%2C_Ohio",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Geauga County Maple Syrup Museum in Chardon celebrates the area’s former status as the nation’s largest maple syrup producer.",
      "sourceSentenceIds": [
        7,
        10
      ],
      "sourceLabels": [
        "Web source 1",
