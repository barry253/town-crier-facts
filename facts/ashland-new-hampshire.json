  "facts": [
    {
      "id": 1,
      "text": "Ashland was set off from Holderness Village in 1868 and named after Henry Clay's Kentucky estate, Ashland.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Ashland%2C_New_Hampshire",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Ashland’s compact downtown centers around Main Street, highlighted by the historic Ashland Railroad Station Museum, a former rail junction.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://localnh.com/towns/ashland",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Kerosene street lights lit in 1886 were soon replaced by electric lights powered by the Ashland Electric Company, founded in 1888.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://ashland.nh.gov/pages/about-us",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Ashland built its first town hall in 1871 and established the oldest continuously operating library in New Hampshire’s northern four counties.",
      "sourceSentenceIds": [
        21
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://ashland.nh.gov/pages/about-us",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Located near the state’s geographic center, Ashland hosts Scribner‑Fellows State Forest, a popular spot for hiking and wildlife viewing.",
      "sourceSentenceIds": [
        25
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Ashland%2C_New_Hampshire",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The 112‑foot falls on the Squam River powered early sawmills and gristmills built in 1770‑1771, fueling Ashland’s first industrial boom.",
      "sourceSentenceIds": [
