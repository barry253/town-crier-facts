      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The 88th Air Base Wing staffs over 38,000 people, making Wright‑Patterson the biggest employer in Ohio with a $6.5 billion annual economic impact.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Web source 1"
