      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "In 1852, Métis guide Pierre Bottineau and companions first settled the area that would become Osseo.",
      "sourceSentenceIds": [
        20
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/osseo_minnesota",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The Great Northern Railroad arrived in 1882, bringing steam trains that cut through Osseo.",
