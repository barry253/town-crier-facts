      "id": 1,
      "text": "Long before settlers, the Quapaw and other indigenous peoples left mounds near Indian Bay, evidence of a thriving pre‑European culture.",
      "sourceSentenceIds": [
        1,
        12
      ],
      "sourceLabels": [
        "Web source 1"
