  "facts": [
    {
      "id": 1,
      "text": "Pocomoke City, dubbed \"the friendliest town on the Eastern Shore\", was renamed in 1878 after the river's name meaning \"black water\".",
      "sourceSentenceIds": [
        18,
        9
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Pocomoke_City%2C_Maryland",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The historic MarVa Theater, a 1927 Art Deco auditorium, now hosts live performances and is being restored as a regional performing‑arts center.",
      "sourceSentenceIds": [
        2,
        27
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Pocomoke_City%2C_Maryland",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The Sturgis One Room School Museum, moved downtown, preserves African‑American education history and is part of the town’s cultural heritage.",
      "sourceSentenceIds": [
        1,
        11
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.cityofpocomoke.com/",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Pocomoke City’s downtown Historic District, listed on the National Register, showcases Victorian, Colonial Revival, and Beaux‑Arts architecture from 1830‑1946.",
      "sourceSentenceIds": [
        17
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://downtownpocomoke.com/about/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The town grew around a railroad line built in the 1880s, part of the Pennsylvania Railroad, linking Wilmington to Cape Charles.",
      "sourceSentenceIds": [
        9,
        10
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Pocomoke_City%2C_Maryland",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Pocomoke City hosts the Delmarva Discovery Museum, an interactive exhibit focused on local ecology and history.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Pocomoke_City%2C_Maryland",
