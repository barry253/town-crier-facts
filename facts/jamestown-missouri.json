  "facts": [
    {
      "id": 1,
      "text": "Jamestown sits on a bluff on the southern bank of the Missouri River, six miles above its confluence with the Mississippi.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://oldjamestownassociation.org/old-jamestown-history-highlights/",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The first documented reference to Jamestown dates to June 1819, when Phinehas James established the settlement.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://oldjamestownassociation.org/old-jamestown-history-highlights/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The Jamestown Mercantile, a historic general store, still stands as a reminder of simpler times in the town.",
      "sourceSentenceIds": [
        27
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://familydestinationsguide.com/quaint-town-missouri-hidden/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Locals greet visitors in the historic town, offering a genuine, uncurated experience rather than staged reenactments.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://familydestinationsguide.com/quaint-town-missouri-hidden/",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "A stately white church in Jamestown has served as a community landmark, witnessing generations of meaningful moments.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://familydestinationsguide.com/quaint-town-missouri-hidden/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The area once hosted an Indian trail that skirted forest west of the prairie, providing a shorter portage to the Missouri River.",
