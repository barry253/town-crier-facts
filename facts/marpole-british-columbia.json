  "facts": [
    {
      "id": 1,
      "text": "Marpole was named after Richard Marpole in 1916 and became a major industrial centre before joining Vancouver in 1929.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Marpole",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The Great Marpole Midden, one of North America's largest pre‑contact middens, was designated a National Historic Site in 1933.",
      "sourceSentenceIds": [
        5,
        12,
        15
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 2"
      ],
      "source": "https://en.wikipedia.org/wiki/Marpole",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "In 1892 Charles Hill‑Tout excavated the extensive midden, sparking archaeological study of Pacific coast refuse heaps.",
      "sourceSentenceIds": [
        13,
        16
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.pc.gc.ca/apps/dfhd/page_nhs_eng.aspx?id=81",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Marpole’s early 20th‑century economy was built around sawmills, canneries, and shingle mills, fueled by the Vancouver Lulu Island Railway.",
      "sourceSentenceIds": [
        9,
        24
      ],
      "sourceLabels": [
        "Web source 1",
        "Wikipedia"
      ],
      "source": "https://marpolehistorical.ca/",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The Marpole Museum and Historical Society, housed in the historic Colbourne House, invites community members to learn about local heritage.",
      "sourceSentenceIds": [
        2,
        10
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://marpolehistorical.ca/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Marpole’s historic Joy Kogawa House, a 1912 Japanese‑Canadian home, now hosts a writer‑in‑residence program run by the city.",
      "sourceSentenceIds": [
        6,
        7
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
