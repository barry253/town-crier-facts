  "facts": [
    {
      "id": 1,
      "text": "Kiryat Gat was founded in 1954 as a ma'abara, a temporary camp for Jewish immigrants, before becoming a development town in 1955.",
      "sourceSentenceIds": [
        5,
        1
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 2"
      ],
      "source": "https://en.wikipedia.org/wiki/Kiryat_Gat",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The city’s name comes from the ancient Philistine city of Gath, though early archaeologists later corrected the identification.",
      "sourceSentenceIds": [
        3,
        4,
        7,
        18
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1",
        "Web source 2"
      ],
      "source": "https://en.wikipedia.org/wiki/Kiryat_Gat",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "In 1972 Kiryat Gat was granted municipal status, becoming Israel’s 31st city.",
      "sourceSentenceIds": [
        30
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Kiryat_Gat",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The town hosts Intel’s Fab 28 plant, one of the world’s most advanced semiconductor fabrication facilities producing 7‑nanometer chips.",
      "sourceSentenceIds": [
        21
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Kiryat_Gat",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Kiryat Gat’s early housing relied on prefabricated concrete units, creating the characteristic dormitory‑style blocks seen in many 1950s Israeli development towns.",
      "sourceSentenceIds": [
        13
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/Kiryat_Gat",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The Lachish Stream borders parts of the city, shaping local hydrology and historically supporting cotton and wool processing industries.",
