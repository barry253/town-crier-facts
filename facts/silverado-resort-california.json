  "facts": [
    {
      "id": 1,
      "text": "Silverado Resort began as a private estate in the 1870s before becoming a resort in the mid‑20th century and later hosting the PGA Tour’s Fortinet Championship.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
