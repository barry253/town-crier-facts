      "id": 1,
      "text": "Lahaina was the royal capital of the Hawaiian Kingdom from 1820 until 1845 when the capital moved to Honolulu.",
      "sourceSentenceIds": [
        5,
        13
      ],
      "sourceLabels": [
        "Web source 1",
