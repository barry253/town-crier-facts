      "id": 1,
      "text": "Derby earned its name when the Atchison, Topeka and Santa Fe Railway renamed its station after official C.F. Derby in 1880.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
