  "facts": [
    {
      "id": 1,
      "text": "Centerville emerged in the mid‑19th century as a settlement in Linn County, part of the Kansas Territory created by the Kansas‑Nebraska Act of 1854.",
      "sourceSentenceIds": [
        11
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/centerville_kansas",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The Kansas City branch of the Missouri‑Kansas‑Texas Railroad, also called the Katy, ran through Centerville in the early 1870s, linking local farms to larger markets.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/centerville_kansas",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "In 1918 a booster station for the Amoco Oil Company was built in Centerville, later converted into The Pumphouse Venue in 2007.",
      "sourceSentenceIds": [
        18,
        23
      ],
      "sourceLabels": [
        "Web source 1",
        "Wikipedia"
      ],
      "source": "https://grokipedia.com/page/centerville_kansas",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Centerville’s climate features hot, humid summers and mild to cool winters, with snowfall averaging about 12 inches annually.",
      "sourceSentenceIds": [
        24,
        3
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Centerville%2C_Kansas",
      "category": "nature",
      "quality": "poor",
      "qualityReason": "vague"
    },
    {
      "id": 5,
      "text": "Situated on Sugar Creek, Centerville’s early settlers reflected broader patterns in Linn County, where pro‑slavery sympathies aligned with Missouri’s influence.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/centerville_kansas",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Centerville is the birthplace of dancer and choreographer Wayne Lamb, a figure known for his contributions to American dance.",
      "sourceSentenceIds": [
