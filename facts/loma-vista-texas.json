  "facts": [
    {
      "id": 1,
      "text": "Loma Vista takes its name from a nearby hill that Spanish explorers used as a landmark on the Upper Presidio Road.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.tshaonline.org/handbook/entries/loma-vista-tx",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town sits on Farm Road 1867, twelve miles south of Batesville in southeastern Zavala County.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.tshaonline.org/handbook/entries/loma-vista-tx",
      "category": "other",
      "quality": "poor",
      "qualityReason": "location_description"
    },
    {
      "id": 3,
      "text": "Along Loma Vista’s western edge, remnants of the historic Presidio Road trail system still trace the path of Spanish colonial outposts.",
      "sourceSentenceIds": [
        25
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://unitedstatesghosttowns.com/loma-vista-texas-ghost-town/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "A small cemetery near the ghost town features limestone monuments that mark the graves of early settlers.",
      "sourceSentenceIds": [
        19
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://unitedstatesghosttowns.com/loma-vista-texas-ghost-town/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Eight historical maps of the region, ranging from the 19th to early 20th centuries, are preserved in local archives.",
      "sourceSentenceIds": [
        24
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://unitedstatesghosttowns.com/loma-vista-texas-ghost-town/",
      "category": "nature",
      "quality": "poor",
      "qualityReason": "vague"
    },
    {
      "id": 6,
      "text": "Local historical societies have installed protective fencing and informational plaques to preserve Loma Vista’s heritage and encourage respectful tourism.",
