  "facts": [
    {
      "id": 1,
      "text": "Louisa was originally called Louisa Court House, named after the courthouse built in 1742 at the corner of Courthouse Road and Main Street.",
      "sourceSentenceIds": [
        1,
        4
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Louisa%2C_Virginia",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The Virginia Central Railroad, chartered as the Louisa Railroad in 1836, ran through the town by 1840, linking local farms to eastern markets.",
      "sourceSentenceIds": [
        6,
        11
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Louisa%2C_Virginia",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The Battle of Trevilian Station, the largest cavalry battle of the war, occurred just six miles west of Louisa in June 1864.",
      "sourceSentenceIds": [
        21,
        20
      ],
      "sourceLabels": [
        "Web source 2",
        "Web source 1"
      ],
      "source": "https://www.louisahistory.org/history",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Patrick Henry, famed for “give me liberty or give me death,” was first elected to the Virginia House of Burgesses from Louisa in 1765.",
      "sourceSentenceIds": [
        17
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://louisava.gov/community/history-of-town/",
      "category": "people",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Louisa’s 1905 courthouse and the historic Louisa High School are listed on the National Register of Historic Places.",
      "sourceSentenceIds": [
        9
