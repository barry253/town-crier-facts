  "facts": [
    {
      "id": 1,
      "text": "Garwood, New Jersey was incorporated as a borough on March 19, 1903, from parts of Cranford and Westfield Town.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Garwood%2C_New_Jersey",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The borough was named after Samuel Garwood, who was the president of a railroad-affiliated land company.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Garwood%2C_New_Jersey",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Garwood developed in the late 19th century as an industrial and residential community, closely tied to the Jersey Central Railroad.",
      "sourceSentenceIds": [
        3,
        4
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Garwood%2C_New_Jersey",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Most streets on the north side of Garwood are numbered, while those on the south side are named after trees.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Garwood%2C_New_Jersey",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Dissatisfaction with services from Cranford and Westfield led Garwood residents to seek local self-government in the early 1900s.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Garwood%2C_New_Jersey",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The borough established its first municipal building in 1915, shortly after its incorporation.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Garwood%2C_New_Jersey",
      "category": "history",
      "quality": "good"
    }
