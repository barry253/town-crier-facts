      "id": 1,
      "text": "Manchester Township sprang to life on April 6 1865 when 34,000 acres of Dover Township were carved out to form a new municipality.",
      "sourceSentenceIds": [
        17
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://theoceancountylibrary.org/Branches/MA/ma.htm",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Named after Manchester, England, the township honors William Torrey, a New York banker who mapped the land in the 1800s.",
      "sourceSentenceIds": [
        4,
        6
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 2"
      ],
      "source": "https://en.wikipedia.org/wiki/Manchester_Township%2C_New_Jersey",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Lakehurst Naval Air Station, inside Manchester, was the site of the infamous 1937 Hindenburg disaster.",
      "sourceSentenceIds": [
        20,
        22
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 2"
      ],
      "source": "https://en.wikipedia.org/wiki/Manchester_Township%2C_New_Jersey",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Hangar One, a National Historic Landmark at Lakehurst, still shelters the wreckage where the Hindenburg once docked.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://theoceancountylibrary.org/Branches/MA/ma.htm",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The Heritage Minerals Museum and historic Cedar Bridge Tavern let visitors explore Manchester’s rich mining past.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://mgmcnj.org/uncategorized/manchester-township/",
      "category": "culture",
      "quality": "good"
    },
