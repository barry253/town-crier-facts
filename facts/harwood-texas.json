  "facts": [
    {
      "id": 1,
      "text": "Harwood was founded in 1874 when the Galveston, Harrisburg and San Antonio Railway reached the area.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Harwood%2C_Texas",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town was named after Thomas Moore Harwood, a lawyer who moved to Texas in 1850 and started a practice in Gonzales in 1853.",
      "sourceSentenceIds": [
        6,
        10
      ],
      "sourceLabels": [
        "Web source 1",
        "Web source 2"
      ],
      "source": "https://www.tshaonline.org/handbook/entries/harwood-tx",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "In 1913 the residents incorporated Harwood specifically to stop a saloon from opening, reflecting the town’s early desire for a sober community.",
      "sourceSentenceIds": [
        29
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Harwood%2C_Texas",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The post office that began in Mule Creek in 1872 was moved to Harwood in 1874, marking the town’s official start as a postal community.",
      "sourceSentenceIds": [
        27,
        28
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Harwood%2C_Texas",
      "category": "landmark",
      "quality": "good"
    }
