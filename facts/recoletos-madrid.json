    {
      "id": 1,
      "text": "Recoletos takes its name from a 16th‑century monastery of Recollect friars near today’s National Library and Archaeological Museum.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/recoletos_madrid",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Paseo de Recoletos, a tree‑lined boulevard created in 1840, links Plaza de Cibeles to Plaza de Colón as an extension of the Prado.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/recoletos_madrid",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Recoletos became a modern symbol when cafés like the 1888‑founded Café Gijón attracted intellectuals, artists, and the elite.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/recoletos_madrid",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The Biblioteca Nacional de España, holding over 35 million items, is a key landmark in Recoletos.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/recoletos_madrid",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Recoletos borders Retiro Park to the east and the Paseo del Prado to the south, linking green space with Madrid’s cultural corridor.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/recoletos_madrid",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "19th‑century palaces along Recoletos now house cultural centers like Casa de América, BBVA Foundation, and Mapfre Foundation.",
      "sourceSentenceIds": [
        4
      ],
