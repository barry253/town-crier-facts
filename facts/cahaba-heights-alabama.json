  "facts": [
    {
      "id": 1,
      "text": "Cahaba Heights was originally called Merkle, named after engineer W.A. Merkle who supervised a 1887 water pumping station.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/cahaba_heights_vestavia_hills"
    },
    {
      "id": 2,
      "text": "The community grew from a small settlement along the Cahaba River in southeastern Jefferson County, southeast of Birmingham.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/cahaba_heights_vestavia_hills"
    },
    {
      "id": 3,
      "text": "River Run and Blue Lake neighborhoods showcase medium‑density housing that balances growth with historical character, a trend that began in the early 2000s.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/cahaba_heights_vestavia_hills"
    },
    {
      "id": 4,
      "text": "The Cahaba River, the longest free‑flowing river in Alabama, runs through Cahaba Heights before heading southwest toward the Alabama River.",
      "sourceSentenceIds": [
        14,
        16
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Cahaba_River"
    },
    {
      "id": 5,
      "text": "Cahaba Heights enjoys limited bus service from the Birmingham‑Jefferson County Transit Authority, a nod to its suburban roots.",
