  "facts": [
    {
      "id": 1,
      "text": "Tisdale was originally called Doghide after the nearby river, but the arrival of the railway renamed it in honour of F.W. Tisdale.",
      "sourceSentenceIds": [
        2,
        4
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 2"
      ],
      "source": "https://en.wikipedia.org/wiki/Tisdale%2C_Saskatchewan",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "In 2005, Tisdale marked its centennial with a homecoming celebration that coincided with Saskatchewan's own 100‑year anniversary.",
      "sourceSentenceIds": [
        16
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Tisdale%2C_Saskatchewan",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Dubbed the Honey Capital of Saskatchewan, the town produces about 4.1 million kilograms of honey, roughly ten percent of Canada’s total.",
      "sourceSentenceIds": [
        20,
        21,
        22
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Tisdale%2C_Saskatchewan",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "A roadside attraction, Tisdale’s 6‑foot‑11‑inch honey bee statue is the second‑largest in the world, following only Falher’s.",
      "sourceSentenceIds": [
        25,
        26
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Tisdale%2C_Saskatchewan",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The town’s 100,000‑square‑foot RecPlex houses a state‑of‑the‑art ice arena, a six‑sheet curling rink, and a performing‑arts theatre.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Tisdale%2C_Saskatchewan",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Tisdale serves as the business hub for the surrounding agricultural boreal forest region of central Saskatchewan.",
      "sourceSentenceIds": [
        11
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Tisdale%2C_Saskatchewan",
