      "category": "nature",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Today, Lat Krabang hosts industrial parks alongside growing residential neighborhoods, reflecting its shift from rural orchards to urban development.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
