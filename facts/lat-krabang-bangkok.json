      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Before 1992, rowboats were the main way people moved around Lat Krabang, even carrying coffins to temples during funerals.",
      "sourceSentenceIds": [
        18,
        19,
        20,
        21
      ],
      "sourceLabels": [
