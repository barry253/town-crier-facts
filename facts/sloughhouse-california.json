      ],
      "source": "https://elkgrovehistoricalsociety.com/sloughhouse/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "A bridge over Deer Creek, built by John Mahone, connects the town to the surrounding valley.",
