  "facts": [
    {
      "id": 1,
      "text": "Sloughhouse was founded in the mid‑19th century and named after a swampy slough that once covered the area.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://aurica.ai/en/article/martin-sparks/sloughhouse-california"
    },
    {
      "id": 2,
      "text": "Jared Sheldon built a roadhouse in 1850, later renaming the community after another building he had built nearby.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Sloughhouse%2C_California"
    },
    {
      "id": 3,
      "text": "The historic Sloughhouse Inn once served as a stagecoach stop and still stands as a testament to the town’s vibrant past.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://aurica.ai/en/article/martin-sparks/sloughhouse-california"
    },
    {
      "id": 4,
      "text": "Sloughhouse is a registered California Historical Landmark, preserving its Gold Rush era heritage.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://elkgrovehistoricalsociety.com/sloughhouse/"
    },
    {
      "id": 5,
      "text": "A bridge over Deer Creek, built by John Mahone, connects the town to the surrounding valley.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://elkgrovehistoricalsociety.com/sloughhouse/"
    },
    {
      "id": 6,
      "text": "The town sits on California State Route 16, about 17 miles southeast of Sacramento, offering easy access while keeping rural charm.",
