  "facts": [
    {
      "id": 1,
      "text": "The area around Harmony was originally inhabited by the Nipmuc people, who used the land for hunting, fishing, and gathering.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/harmony_rhode_island"
    },
    {
      "id": 2,
      "text": "David Burlingame settled in Harmony around 1709, establishing one of the first farms in the region near Shinscot Brook.",
      "sourceSentenceIds": [
        2,
        23
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/harmony_rhode_island"
    },
    {
      "id": 3,
      "text": "Harmony developed in the early nineteenth century as a rural hub, featuring a toll gate and an acid factory.",
      "sourceSentenceIds": [
        14
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/harmony_rhode_island"
    },
    {
      "id": 4,
      "text": "A toll booth for the Glocester Turnpike was located in Harmony until the system was abolished in the 1850s.",
      "sourceSentenceIds": [
        16
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Harmony%2C_Rhode_Island"
    },
    {
      "id": 5,
      "text": "The historic Harmony Chapel and Cemetery, located at the center of the village, date back to 1816.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Harmony%2C_Rhode_Island"
    },
    {
      "id": 6,
      "text": "Harmony's historic district features Federal and Greek Revival architecture, including the 1838 post office and store.",
      "sourceSentenceIds": [
        5,
        25
      ],
      "sourceLabels": [
