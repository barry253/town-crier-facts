  "facts": [
    {
      "id": 1,
      "text": "Duquesne Incline, completed in 1877, was originally steam‑powered and designed by Hungarian‑American engineer Samuel Diescher.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Duquesne_Incline"
    },
    {
      "id": 2,
      "text": "The 793‑foot long incline climbs 400 feet at a 30‑degree angle, using a rare 5‑foot track gauge.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Duquesne_Incline"
    },
    {
      "id": 3,
      "text": "In 1975 the Duquesne Incline earned a spot on the National Register of Historic Places.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Duquesne_Incline"
    },
    {
      "id": 4,
      "text": "Pittsburgh Regional Transit owns the incline, while a nonprofit society preserves and operates it.",
      "sourceSentenceIds": [
        17
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Duquesne_Incline"
    },
    {
      "id": 5,
      "text": "The next year Allegheny County Port Authority assumed ownership and now leases the incline to the society.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.pittsburghbeautiful.com/2017/04/24/pittsburgh-neighborhoods-duquesne-heights/"
    },
    {
      "id": 6,
      "text": "Duquesne and Monongahela Inclines are the only passenger inclines still running on Pittsburgh’s South Side.",
      "sourceSentenceIds": [
        16
