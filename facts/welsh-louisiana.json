  "facts": [
    {
      "id": 1,
      "text": "Welsh began as a homestead of Miles Welsh, a Pennsylvania man seeking a warmer climate for his health.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Welsh%2C_Louisiana",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "In 1880, Welsh donated land to the Louisiana Western Rail Road, which later became part of Southern Pacific and built a station there.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Welsh%2C_Louisiana",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The town’s original home sat on the main stagecoach route between New Iberia and Texas, making it a key stop for travelers.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Welsh%2C_Louisiana",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "In 1913, Welsh shifted from Imperial Calcasieu Parish to the newly formed Jefferson Davis Parish, marking a new administrative era.",
      "sourceSentenceIds": [
        13
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Welsh%2C_Louisiana",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Welsh is one of seventeen Louisiana towns that operate their own independent municipal electrical power system, a rare local energy model.",
      "sourceSentenceIds": [
        26
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.townofwelsh.com/",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "AeroLites, a manufacturer of light aircraft, is headquartered in Welsh, adding a touch of aviation industry to the town’s profile.",
