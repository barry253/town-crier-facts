  "facts": [
    {
      "id": 1,
      "text": "Newton Falls got its name from James Newton, who built a sawmill there in 1894 that later became the Newton Falls Paper Mill.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Newton_Falls%2C_New_York",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "In 2007 former mill workers and town residents revived the plant as Newton Falls Fine Paper, breathing new life into the historic mill.",
      "sourceSentenceIds": [
        15
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Newton_Falls%2C_New_York",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The mill closed again on June 28, 2011, ending more than a century of paper production in the hamlet.",
      "sourceSentenceIds": [
        16
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Newton_Falls%2C_New_York",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Before the mill, a massive iron strip mine called Benson Mines operated at the junction of CR 60 and NY 3, employing 1,200 workers at its peak.",
      "sourceSentenceIds": [
        22
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Newton_Falls%2C_New_York",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The hamlet’s streets feature several Sears houses perched atop Plank Hill along Newton Falls Road, a reminder of its mill town origins.",
