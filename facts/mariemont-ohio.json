  "facts": [
    {
      "id": 1,
      "text": "Mariemont was founded in 1923 by philanthropist Mary Emery and designed by architect John Nolen, creating one of America’s first planned communities.",
      "sourceSentenceIds": [
        5,
        21
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Mariemont%2C_Ohio",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "In 2007, Mariemont earned National Historic Landmark status, recognizing its intact early 20th‑century town plan and architecture.",
      "sourceSentenceIds": [
        3,
        4
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 2"
      ],
      "source": "https://en.wikipedia.org/wiki/Mariemont%2C_Ohio",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The village’s layout reflects an English garden city vision, blending single‑family homes with low‑rise apartments in a compact, walkable design.",
      "sourceSentenceIds": [
        23
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Mariemont%2C_Ohio",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Mariemont’s historic district is one of only a handful of preserved planned communities in the United States, celebrated for its cohesive streetscape.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://visitmariemont.com/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "A pioneer cemetery sits beside the Mariemont Community Church, marking the site of the village’s earliest settlers from the late 1700s.",
      "sourceSentenceIds": [
        20
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Mariemont%2C_Ohio",
      "category": "people",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The American Planning Association named Mariemont a “Great Neighbourhood” in 2008 for its unique character and strong citizen participation.",
      "sourceSentenceIds": [
        29
