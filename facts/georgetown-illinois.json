  "facts": [
    {
      "id": 1,
      "text": "Georgetown’s name may honor George Beckwith, echoing Danville’s namesake Dan Beckwith, or it could honor James Haworth’s son George.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Georgetown%2C_Illinois"
    },
    {
      "id": 2,
      "text": "The Paris and Danville Railroad reached Georgetown in 1871, and an interurban line began carrying passengers between the towns after 1900.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Georgetown%2C_Illinois"
    },
    {
      "id": 3,
      "text": "Georgetown was established in 1826, platted by James Haworth, though the first home appeared in 1820 by Henry Johnson.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Georgetown%2C_Illinois"
    },
    {
      "id": 4,
      "text": "The town’s first post office opened in 1828, marking its growing role as a regional hub.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Georgetown%2C_Illinois"
    },
    {
      "id": 5,
      "text": "At Georgetown’s southern edge, the Little Vermillion River flows over a dam that sits just beyond the town’s borders.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Georgetown%2C_Illinois"
    },
    {
      "id": 6,
      "text": "Danville Mass Transit runs Route 9 buses that connect Georgetown to downtown Danville and other nearby destinations.",
