  "facts": [
    {
      "id": 1,
      "text": "Whale Pass’s waters host all five Pacific salmon species, Pacific halibut, herring, rockfish, and marine mammals like humpback whales, Steller sea lions, harbor seals, and sea otters.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/whale_pass_alaska",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The name 'Whale Passage' dates back to the 1880s, when a U.S. Navy commander named it after observing humpback whales in the 10‑mile waterway.",
      "sourceSentenceIds": [
        29,
        30
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/whale_pass_alaska",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Whale Pass began as a mid‑20th‑century logging camp in 1964, evolving into a permanent community by the early 1980s after land sales and road extensions.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/whale_pass_alaska",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The Tlingit Tee‑hit‑ton clan historically called the area Oota‑heen, using it for fishing and seasonal travel along Prince of Wales Island’s coastal waterways.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/whale_pass_alaska",
      "category": "people",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "In 2017, Whale Pass incorporated as Alaska’s newest city, becoming the state’s 116th second‑class city.",
