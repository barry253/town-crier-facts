  "facts": [
    {
      "id": 1,
      "text": "Liverpool, Texas, takes its name from the English port of Liverpool, chosen by Commodore Nelson.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.tshaonline.org/handbook/entries/liverpool-tx",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town was formally established in 1837, becoming a key settlement in early Brazoria County.",
      "sourceSentenceIds": [
        21
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Liverpool%2C_Texas",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Liverpool grew into a shipping point for wool, hides, and produce via Chocolate Bayou during the 1830s.",
      "sourceSentenceIds": [
        2,
        22,
        23
      ],
      "sourceLabels": [
        "Web source 2",
        "Wikipedia"
      ],
      "source": "https://www.tshaonline.org/handbook/entries/liverpool-tx",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The town sits along the Union Pacific Railroad and County Road 171, just northeast of Angleton and south of Alvin.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Liverpool%2C_Texas",
      "category": "other",
      "quality": "poor",
      "qualityReason": "location_description"
    },
    {
      "id": 5,
      "text": "A post office opened in Liverpool in 1846, closed in 1867, then reopened in 1879 and stayed open thereafter.",
      "sourceSentenceIds": [
        24,
        25
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Liverpool%2C_Texas",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "To the east, Liverpool is bordered by the winding Chocolate Bayou, a historic waterway.",
