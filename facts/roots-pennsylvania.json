  "facts": [
    {
      "id": 1,
      "text": "Roots hosts the Root’s Old Mill Flea Market, a Tuesday gathering where vintage comics, handmade jewelry, and farm‑fresh produce mingle in a historic mill.",
      "sourceSentenceIds": [
        17,
        18,
        19
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://familydestinationsguide.com/flea-market-amazing-pennsylvania/",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The market’s historic mill building, with weathered wooden beams, serves as a living backdrop that tells the story of Pennsylvania’s agricultural heritage.",
      "sourceSentenceIds": [
        2,
        19
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://familydestinationsguide.com/flea-market-amazing-pennsylvania/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "A distinctive white barn with a towering silo stands on the Roots grounds, a landmark visible from miles away that guides shoppers like a retail lighthouse.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://familydestinationsguide.com/flea-market-amazing-pennsylvania/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Roots sits on the north side of Bells Gap Run, a stream that flows southeast off the Allegheny Front and joins the Little Juniata River at Bellwood.",
      "sourceSentenceIds": [
        16
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Roots%2C_Pennsylvania",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The community lies along Pennsylvania Route 865, a road that leads southeast 1.6 miles to Bellwood and northwest up the Allegheny Front 6 miles to Blandburg.",
      "sourceSentenceIds": [
        15
      ],
