      "quality": "good"
    },
    {
      "id": 4,
      "text": "During the 1830s–1850s, Elizabeth Lake was a vital watering stop between the Butterfield Overland Mail’s Widow Smith’s Station and Mud Spring stage stops.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
