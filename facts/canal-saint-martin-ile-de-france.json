  "facts": [
    {
      "id": 1,
      "text": "The Canal Saint‑Martin snakes 4.5 km through Paris’s 10th and 11th arrondissements, linking the Seine to the Canal de l’Ourcq.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.theparisianguide.com/s/canal-saint-martin/",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Napoleon Bonaparte opened the canal in 1825 to boost Paris’s water supply, turning it into a vital artery for the city.",
      "sourceSentenceIds": [
        20
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.theparisianguide.com/s/canal-saint-martin/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "In 1360 a canal bisected the island at Rue Poulettière, creating the smaller Ile des Vaches, literally “Island of Cows.”.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/%C3%8Ele_Saint-Louis",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Pont Marie, the bridge that links the island to the right bank, honors Christophe Marie, a 17th‑century developer who revived the area.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/%C3%8Ele_Saint-Louis",
      "category": "people",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "During the French Revolution the island briefly bore the patriotic name Ile de la Fraternité before returning to its historic title.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
