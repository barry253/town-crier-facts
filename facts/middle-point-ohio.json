  "facts": [
    {
      "id": 1,
      "text": "Middle Point earned its name because it sits right between Delphos and Van Worth, a fact noted by early settlers.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Middle_Point%2C_Ohio"
    },
    {
      "id": 2,
      "text": "Before becoming Middle Point, the area was called Sykestown, honoring the Sykes family who first owned the land.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Middle_Point%2C_Ohio"
    },
    {
      "id": 3,
      "text": "The village grew around a railroad depot on the Pittsburgh‑Fort Wayne‑Chicago line, making it a key stopping point in the 1800s.",
      "sourceSentenceIds": [
        4,
        5
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.wisdomlib.org/cities/middle-point-160419"
    },
    {
      "id": 4,
      "text": "A branch of the Brumback Library serves Middle Point, offering residents a quiet spot for reading and research.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Middle_Point%2C_Ohio"
    },
    {
      "id": 5,
      "text": "Middle Point was officially laid out in 1851, marking the start of its development as a rural community.",
      "sourceSentenceIds": [
        14
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Middle_Point%2C_Ohio"
    },
    {
      "id": 6,
      "text": "A post office has operated in Middle Point since 1854, keeping the town connected for over a century.",
      "sourceSentenceIds": [
        15
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Middle_Point%2C_Ohio"
    }
