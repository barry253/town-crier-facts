  "facts": [
    {
      "id": 1,
      "text": "Connellsville was founded as a township in 1793 and became a borough on March 1, 1806, by militia captain Zachariah Connell.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Connellsville%2C_Pennsylvania",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town earned the nickname “Coke Capital of the World” thanks to its historic coal and coke industry along the Youghiogheny River.",
      "sourceSentenceIds": [
        17
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.visitpa.com/explore/regions/laurel-highlands/connellsville/",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Five railroads once served Connellsville, including the Baltimore and Ohio, Pennsylvania, Western Maryland, Pittsburgh and Lake Erie, and Norfolk and Western.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Connellsville%2C_Pennsylvania",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Connellsville’s Carnegie Free Library, built in 1905, remains a National Register landmark and a testament to early 20th‑century philanthropy.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.visitpa.com/explore/regions/laurel-highlands/connellsville/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "In 1911, Connellsville became the first city in Fayette County when it merged with New Haven, marking a milestone in local governance.",
