  "facts": [
    {
      "id": 1,
      "text": "Founded in 1836 by Isaac Miller, Magnolia began as a modest settlement in Ohio's rural heart.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://villageofmagnolia.com/home/"
    },
    {
      "id": 2,
      "text": "Before its current name, the area in Carroll County was known as Downingville, honoring early settlers.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://villageofmagnolia.com/home/"
    },
    {
      "id": 3,
      "text": "On February 1 1846, Downingville merged with a neighboring community, officially becoming Magnolia.",
      "sourceSentenceIds": [
        11
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Magnolia%2C_Ohio"
    },
    {
      "id": 4,
      "text": "Magnolia sits beside Sandy Creek, a gentle waterway that has shaped its landscape for generations.",
      "sourceSentenceIds": [
        13
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Magnolia%2C_Ohio"
    },
    {
      "id": 5,
      "text": "Drivers will find Magnolia at the crossroads of State Routes 183 and 542, a historic junction that still guides travelers today.",
