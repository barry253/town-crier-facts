  "facts": [
    {
      "id": 1,
      "text": "Lewisville was named after settler Lewis Laugenour, who donated land for the town’s central development.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://lewisvillenc.net/about-lewisville"
    },
    {
      "id": 2,
      "text": "The town’s first newspaper, The Lewisville Citizen, ran from 1948 to 1961, founded by the Lewisville Civic Club.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://lewisvillenc.net/about-lewisville"
    },
    {
      "id": 3,
      "text": "The historic Roller Mill, built in 1910, operated until 1984 and remains a landmark of local industry.",
      "sourceSentenceIds": [
        13
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://lewisvillenc.net/about-lewisville"
    },
    {
      "id": 4,
      "text": "Lewisville’s archives, housed at the Lewisville Branch Library on Shallowford Road, are open to the public for research.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://lewisvillehistory.org/"
    },
    {
      "id": 5,
      "text": "In the mid‑1770s, settlers on the Great Wagon Road paused at the Yadkin River near Shallow Ford before crossing into North Carolina.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://lewisvillenc.net/about-lewisville"
    },
    {
      "id": 6,
      "text": "The Lewisville Historical Society hosts regular membership meetings and invites the public to learn about local history.",
      "sourceSentenceIds": [
