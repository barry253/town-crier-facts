      "id": 1,
      "text": "Fairview Heights was first settled in the late 18th century, with permanent European settlers arriving in the early 1800s as part of Ridge Prairie.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 2"
      ],
