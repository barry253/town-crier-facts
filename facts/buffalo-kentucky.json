  "facts": [
    {
      "id": 1,
      "text": "Buffalo Trace Distillery, founded in 1775, claims to be the oldest continuously operating distillery in the United States.",
      "sourceSentenceIds": [
        15,
        16,
        17
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Buffalo_Trace_Distillery"
    },
    {
      "id": 2,
      "text": "The name \"Buffalo Trace\" comes from an ancient buffalo trackway that crossed the Kentucky River in Franklin County.",
      "sourceSentenceIds": [
        13
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Buffalo_Trace_Distillery"
    },
    {
      "id": 3,
      "text": "In 2016, the distillery announced a $200 million expansion plan to grow its operations.",
      "sourceSentenceIds": [
        27
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Buffalo_Trace_Distillery"
    },
    {
      "id": 4,
      "text": "During Prohibition, Buffalo Trace was allowed to keep running to produce whiskey for medicinal purposes.",
      "sourceSentenceIds": [
        24
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Buffalo_Trace_Distillery"
    },
    {
      "id": 5,
      "text": "In early April 2025, heavy rains caused the Kentucky River to rise to 48.24 feet, the second highest level in the distillery's 200‑year history.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Buffalo_Trace_Distillery"
    },
    {
      "id": 6,
      "text": "The original distillery foundation, built in 1873, was uncovered in 2016 during renovations and still stands beneath the modern building.",
