  "facts": [
    {
      "id": 1,
      "text": "Harriman was founded in 1889 by Frederick Gates along the Emory River and the Cincinnati‑Southern Railroad line.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://cityofharriman.net/about/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town earned the nickname “the town that temperance built” because a group of temperance advocates founded it in the late 19th century.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://cityofharriman.net/about/",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "By 1892, rolling mills, factories, and other businesses had relocated to Harriman, turning it into a bustling industrial center.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Harriman%2C_Tennessee",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "A 1890 land sale of 10,000 acres funded the construction of factories, churches, schools, and a hilltop residential neighborhood overlooking the town.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://cityofharriman.net/about/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The Emory River forms an oxbow bend that surrounds Harriman’s original section, creating a distinctive waterway around the town.",
      "sourceSentenceIds": [
