  "facts": [
    {
      "id": 1,
      "text": "Highland Village was incorporated as a city on Valentine’s Day in February 1963, when a group of lakeside residents decided to make their homes permanent.",
      "sourceSentenceIds": [
        4,
        7
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://highlandvillage.org/112/History-of-Highland-Village",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The city’s early growth centered along the northern shore of Lewisville Lake, where many of the first residents were Dallas professionals looking for weekend retreats.",
      "sourceSentenceIds": [
        25,
        26
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://highlandvillage.org/112/History-of-Highland-Village",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Doubletree Ranch Park today sits on land that once belonged to the original ranch that helped shape Highland Village’s early landscape.",
      "sourceSentenceIds": [
        27
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://highlandvillage.org/112/History-of-Highland-Village",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Public transit arrived in 2008 when DCTA began a bus service that connected Highland Village to the broader DCTA network.",
      "sourceSentenceIds": [
        21
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Highland_Village%2C_Texas",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "In 2020, DCTA replaced its Highland Village Connect Shuttle with a Lyft discount program to improve network efficiency.",
      "sourceSentenceIds": [
        22
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Highland_Village%2C_Texas",
      "category": "transport",
      "quality": "poor",
      "qualityReason": "other"
    },
    {
      "id": 6,
      "text": "The city’s on‑demand GoZone service launched in September 2021, partnering with Via Transportation to replace the Lyft program and offer flexible rides.",
