  "facts": [
    {
      "id": 1,
      "text": "Meredosia’s name blends the French word for lake, “mere,” with the name of priest Antoine D’Osia, the first white settler.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.historyillinois.org/historical-markers/historic-meredosia"
    },
    {
      "id": 2,
      "text": "Steamboats began arriving in 1826, and their traffic helped organize the village in 1832 along the Illinois River.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.historyillinois.org/historical-markers/historic-meredosia"
    },
    {
      "id": 3,
      "text": "Three local button factories drew daily river shelling, turning Meredosia into a bustling pearl‑button hub in the early 20th century.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.historyillinois.org/historical-markers/historic-meredosia"
    },
    {
      "id": 4,
      "text": "Boyd Button Factory, the last independent pearl button factory in the U.S., ceased operations in 1948.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.historyillinois.org/historical-markers/historic-meredosia"
    },
    {
      "id": 5,
      "text": "In 2018 a new bridge replaced the 1936 narrow span over the Illinois River, restoring a modern crossing for the village.",
      "sourceSentenceIds": [
        17,
        18
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Meredosia%2C_Illinois"
    },
    {
      "id": 6,
      "text": "The Skinner Bandstand in Boyd Park commemorates composer Frank Skinner, who played and directed there in the 1910s.",
      "sourceSentenceIds": [
        8,
        12
      ],
