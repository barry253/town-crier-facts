    {
      "id": 1,
      "text": "Salley was settled in 1735 as John's Town by Swiss-German families who received land grants from King George II.",
      "sourceSentenceIds": [
        20
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Salley%2C_South_Carolina"
    },
    {
      "id": 2,
      "text": "The town was renamed Salley in 1887 to honor Dempsey Salley, a member of the South Carolina Legislature.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Salley%2C_South_Carolina"
    },
    {
      "id": 3,
      "text": "Salley is known for hosting the town-wide Chitlin Strut festival every November.",
      "sourceSentenceIds": [
        19
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Salley%2C_South_Carolina"
    },
    {
      "id": 4,
      "text": "The Salley Historic District features sixty Victorian and Art Deco homes and was listed on the National Register of Historic Places in 2000.",
      "sourceSentenceIds": [
