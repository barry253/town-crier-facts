  "facts": [
    {
      "id": 1,
      "text": "Clemmons was first settled in 1802 by Peter Clemmons and became a village in 1986.",
      "sourceSentenceIds": [
        2,
        5
      ],
      "sourceLabels": [
        "Web source 2",
        "Web source 1"
      ],
      "source": "https://discoverclemmons.com/224/Village-Facts"
    },
    {
      "id": 2,
      "text": "Originally called Clemmonsville, the town quickly turned into a hub for agriculture and industry.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.clemmons.org/347/History"
    },
    {
      "id": 3,
      "text": "Stagecoach lines ran through Clemmons, and the Idols Dam power station gave the village its first commercial hydroelectric plant.",
      "sourceSentenceIds": [
        9,
        10
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.clemmons.org/347/History"
    },
    {
      "id": 4,
      "text": "The Idols Dam power station was the first commercial hydroelectric generating station in North Carolina to transmit alternating current over long distances.",
      "sourceSentenceIds": [
        11
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.clemmons.org/347/History"
    },
    {
      "id": 5,
      "text": "Tanglewood Park, with its arboretum and rose garden, hosts a seasonal Festival of Lights that lights up the village each winter.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Clemmons%2C_North_Carolina"
    },
    {
      "id": 6,
      "text": "The Clemmons Historical Society works tirelessly to preserve the village’s history through photos, information, and education.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.clemmons.org/347/History"
    }
