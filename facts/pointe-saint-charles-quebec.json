  "facts": [
    {
      "id": 1,
      "text": "Pointe-Saint-Charles takes its name from Charles Le Moyne d’Iberville, a 17th‑century Montreal settler who first held the land.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/Pointe-Saint-Charles",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The 1848 enlargement of the Lachine Canal turned Pointe-Saint-Charles from a sparsely settled area into a bustling industrial hub.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/Pointe-Saint-Charles",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Pointe-Saint-Charles is known as the heart of historic Irish Montreal, with streets like Rue Saint‑Patrick and Place Dublin.",
      "sourceSentenceIds": [
        11
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Pointe-Saint-Charles",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Reopening the Lachine Canal in 2002 turned former factory sites into lofts and condos, revitalizing the waterfront.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Pointe-Saint-Charles",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Charlevoix Metro station opened in 1978, giving Pointe-Saint-Charles its first direct link to downtown Montreal.",
      "sourceSentenceIds": [
        18
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Pointe-Saint-Charles",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Maison Saint‑Gabriel, built in 1698 by the Congrégation de Notre‑Dame, is one of Montreal’s oldest surviving buildings.",
      "sourceSentenceIds": [
        28
