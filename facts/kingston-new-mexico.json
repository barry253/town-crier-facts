  "facts": [
    {
      "id": 1,
      "text": "Jack Sheddon discovered silver at the Solitaire Mine in 1883, sparking Kingston's rapid growth as a mining boomtown.",
      "sourceSentenceIds": [
        15
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Kingston%2C_New_Mexico",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Between 1883 and 1893, Kingston's 27 mines yielded nearly 6 million ounces of silver, fueling the town's prosperity.",
      "sourceSentenceIds": [
        20
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Kingston%2C_New_Mexico",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Even after the boom, Kingston endured as a quiet mining outpost for many decades.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://westernmininghistory.com/towns/new-mexico/kingston/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Kingston serves today as a gateway to the Gila National Forest and Gila Cliff Dwellings, drawing hikers and history enthusiasts.",
      "sourceSentenceIds": [
        13
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://westernmininghistory.com/towns/new-mexico/kingston/",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Kingston sits in the Black Range along New Mexico State Road 152, a scenic stretch through rugged terrain.",
      "sourceSentenceIds": [
        14
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Kingston%2C_New_Mexico",
      "category": "nature",
      "quality": "good"
    },
    {
