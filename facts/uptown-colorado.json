  "facts": [
    {
      "id": 1,
      "text": "Colorado Springs was founded as a resort town in 1871 by General William Jackson Palmer after he built the Denver and Rio Grande Railroad.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.visitcos.com/things-to-do/history-heritage/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The city earned the nickname “Olympic City USA” because it hosts the U.S. Olympic & Paralympic Training Center and the national committee headquarters.",
      "sourceSentenceIds": [
        22
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Colorado_Springs%2C_Colorado",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Glen Eyrie Castle, built in 1871 for the Palmers, still stands today as a historic landmark overlooking the city.",
      "sourceSentenceIds": [
        14
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.visitcos.com/things-to-do/history-heritage/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The Garden of the Gods Visitor & Nature Center on 1805 N 30th St showcases 300‑foot sandstone formations that earned the area National Natural Landmark status.",
      "sourceSentenceIds": [
        29
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Colorado_Springs%2C_Colorado",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Colorado Springs’ military presence accounts for more than 40% of the region’s economy, with major defense contractors headquartered there.",
      "sourceSentenceIds": [
        17
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Colorado_Springs%2C_Colorado",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The Martin Luther King Jr. Bypass, part of I‑25, runs through the city, reflecting its role in civil rights history.",
      "sourceSentenceIds": [
