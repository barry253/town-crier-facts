  "facts": [
    {
      "id": 1,
      "text": "Ruth earned its name in 1880 when a new post office opened, honoring Michael Ruth who donated land for a railroad depot.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Sherman_Township%2C_Huron_County%2C_Michigan",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Early settlers traced back to 1855 when John Hunsanger from Germany arrived, sparking a wave of Baden and Westphalian families in the 1860s.",
      "sourceSentenceIds": [
        12,
        13
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Sherman_Township%2C_Huron_County%2C_Michigan",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Ruth’s name also nods to a massive white limestone boulder in Lake Huron that defined the 1807 Treaty of Detroit boundary.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Sherman_Township%2C_Huron_County%2C_Michigan",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Ruth’s early identity as “German Settlement” reflected the cultural heritage of its first families, many of whom kept German traditions alive.",
      "sourceSentenceIds": [
        14
