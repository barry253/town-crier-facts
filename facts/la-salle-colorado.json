  "facts": [
    {
      "id": 1,
      "text": "LaSalle was named by railroad officials after LaSalle Street in Chicago.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/LaSalle%2C_Colorado",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The first Union Pacific train, Number 28, steamed through present‑day LaSalle on May 8, 1870, marking the town’s birth.",
      "sourceSentenceIds": [
        15
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://lasalletown.com/2171/History",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The original depot burned in 1906 and was replaced in 1907 with a larger building that now serves as the McMahan Community Center.",
      "sourceSentenceIds": [
        18
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://lasalletown.com/2171/History",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "LaSalle’s first street lights appeared in 1913, followed by a water tower and underground lines in 1917.",
      "sourceSentenceIds": [
        27,
        28
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://lasalletown.com/2171/History",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "In the 1920s and 30s, residents entertained themselves at the two‑story Crystal Theater on Union Avenue, which hosted theater, bowling, and roller‑skating.",
      "sourceSentenceIds": [
        30
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://lasalletown.com/2171/History",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "LaSalle’s post office has been operating continuously since 1886, a testament to its early growth.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/LaSalle%2C_Colorado"
