  "facts": [
    {
      "id": 1,
      "text": "Port Alsworth was founded in 1950 by Babe Alsworth, a missionary and bush pilot, and Mary Alsworth, the town's first postmaster.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Port_Alsworth%2C_Alaska",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Since 1980, Port Alsworth has served as Lake Clark National Park's headquarters and a gateway to ecotourism, sport fishing, and hunting.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/Port_Alsworth,_Alaska",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Port Alsworth sits on Lake Clark's south shore, right where the Tanalian River empties into the lake.",
      "sourceSentenceIds": [
        16
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Port_Alsworth%2C_Alaska",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Archaeology shows the Dena'ina Athabascan people used the Port Alsworth area for over 14,000 years, hunting caribou and making tools.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/Port_Alsworth,_Alaska",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Port Alsworth is located on private land within Lake Clark National Park and Preserve and is the site of the national park's field headquarters.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Port_Alsworth%2C_Alaska",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Samaritan's Purse operates a lodge for wounded U.S. military veterans in Port Alsworth for 'Operation Heal Our Patriots' (OHOP).",
