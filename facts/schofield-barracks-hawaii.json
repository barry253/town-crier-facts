      "category": "people",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The barracks served as the principal setting for James Jones’s novel From Here to Eternity and its 1953 film adaptation.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
