      "category": "culture",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Vernon's Towne Cinema, a 1930s Art Deco theatre, still hosts the Vernon Film Society’s screenings.",
      "sourceSentenceIds": [
        11
