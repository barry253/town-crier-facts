  "facts": [
    {
      "id": 1,
      "text": "Riegelsville was founded by Benjamin Riegel, a landowner whose family gave the borough its name.",
      "sourceSentenceIds": [
        3,
        4
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Riegelsville%2C_Pennsylvania",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The Riegelsville Suspension Bridge, built in 1904 by John A. Roebling's firm, still carries traffic between Pennsylvania and New Jersey.",
      "sourceSentenceIds": [
        14,
        27,
        29
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.islands.com/2036014/riegelsville-pennsylvania-century-old-bridge-canal-town-trails-historic-charm/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The Delaware Canal opened in 1832, turning Riegelsville into a bustling mill town with warehouses and factories along its banks.",
      "sourceSentenceIds": [
        5,
        18
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Riegelsville%2C_Pennsylvania",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The historic Riegelsville Inn, erected in 1838, has welcomed travelers for over 160 years and remains standing today.",
      "sourceSentenceIds": [
        6,
        7
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Riegelsville%2C_Pennsylvania",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Between 1904 and 1926, electric trolleys of the Doylestown & Easton Street Railway Company ran through Riegelsville, linking it to regional centers.",
      "sourceSentenceIds": [
        23
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Riegelsville%2C_Pennsylvania",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The Benjamin Riegel House, a stone residence built by the founder’s family, was listed on the National Register of Historic Places in 1987.",
      "sourceSentenceIds": [
        9
