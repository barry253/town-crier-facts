  "facts": [
    {
      "id": 1,
      "text": "Vidalia was founded by Don José Vidal, a secretary to Spanish Governor Manuel Gayoso de Lemos, in the late 18th century.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Vidalia%2C_Louisiana"
    },
    {
      "id": 2,
      "text": "In 1811 the Orleans Territorial legislature renamed the town Vidalia in honor of its founder.",
      "sourceSentenceIds": [
        14
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Vidalia%2C_Louisiana"
    },
    {
      "id": 3,
      "text": "Vidalia hosts Louisiana's first hydroelectric power plant, the largest prefabricated plant in the world, which began operation in 1990.",
      "sourceSentenceIds": [
        19,
        20
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Vidalia%2C_Louisiana"
    },
    {
      "id": 4,
      "text": "The Tacony Plantation in Vidalia is listed on the National Register of Historic Places, preserving a piece of the town's early history.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Vidalia%2C_Louisiana"
    },
    {
      "id": 5,
      "text": "Vidalia sits on the west bank of the Mississippi River, opposite Natchez, Mississippi, and is connected by the Natchez–Vidalia Bridge.",
      "sourceSentenceIds": [
        10,
        11
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Vidalia%2C_Louisiana"
    },
    {
      "id": 6,
      "text": "The Great Sandbar Duel of 1827, involving Jim Bowie, turned into a violent brawl and remains a regional legend in Vidalia.",
      "sourceSentenceIds": [
        17,
        18
      ],
