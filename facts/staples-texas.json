  "facts": [
    {
      "id": 1,
      "text": "Staples grew around a country store opened by Civil War veteran John Douglas Staples in 1871 near a live oak grove.",
      "sourceSentenceIds": [
        25
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.cityofstaples.com/history"
    },
    {
      "id": 2,
      "text": "The town’s post office opened May 19, 1879, and was called Staples Store until 1891 when the name was shortened.",
      "sourceSentenceIds": [
        26,
        27
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.cityofstaples.com/history"
    },
    {
      "id": 3,
      "text": "In 1867 Leonidas Hardeman used the San Marcos River to power a cotton gin, later adding steam when the river ran low.",
      "sourceSentenceIds": [
        21,
        23
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.cityofstaples.com/history"
    },
    {
      "id": 4,
      "text": "Camp Edward Clark, a Confederate training site, operated in the area in 1861, reflecting the town’s Civil War ties.",
      "sourceSentenceIds": [
        19
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.cityofstaples.com/history"
    },
    {
      "id": 5,
      "text": "Staples sits in northeastern Guadalupe County, just west of the San Marcos River that marks the Caldwell County border.",
