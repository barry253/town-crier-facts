  "facts": [
    {
      "id": 1,
      "text": "Inniswold began as a late‑18th‑century trading post, drawn by timber resources and its proximity to the Mississippi River.",
      "sourceSentenceIds": [
        26
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.city-usa.top/state-louisiana-city-inniswold",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town’s name blends Gaelic 'Innis'—meaning a small island or meadow—with Old English 'wold,' a term for rolling open land.",
      "sourceSentenceIds": [
        27
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.city-usa.top/state-louisiana-city-inniswold",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "During the Civil War, a brief skirmish outside Inniswold saw Union and Confederate foraging parties clash inconclusively.",
      "sourceSentenceIds": [
        29
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.city-usa.top/state-louisiana-city-inniswold",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "In the 19th century, Inniswold grew slowly as a hub for local agriculture and timber processing.",
      "sourceSentenceIds": [
        28
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.city-usa.top/state-louisiana-city-inniswold",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The 20th century brought steady growth to Inniswold, thanks to better transportation links and a shift toward a diversified economy.",
      "sourceSentenceIds": [
        30
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.city-usa.top/state-louisiana-city-inniswold",
      "category": "economy",
      "quality": "good"
    },
