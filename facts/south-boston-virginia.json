  "facts": [
    {
      "id": 1,
      "text": "South Boston was founded in 1796 as Boyd's Ferry, named after Boston, Massachusetts.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/South_Boston%2C_Virginia",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town became a major brightleaf tobacco market, second largest in the U.S. before Great Depression.",
      "sourceSentenceIds": [
        25
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/South_Boston%2C_Virginia",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "In 1854 a railroad depot sparked growth; by early 1900s it was the country’s second largest brightleaf tobacco market.",
      "sourceSentenceIds": [
        14
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.dhr.virginia.gov/historic-registers/130-0006/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The South Boston Historic District includes tobacco warehouses and factories that illustrate the town’s golden age of tobacco trading.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.dhr.virginia.gov/historic-registers/130-0006/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The town reverted to town status in 1995, the first Virginia city to do so, rejoining Halifax County.",
      "sourceSentenceIds": [
        10
      ],
