    },
    {
      "id": 2,
      "text": "The community of Sycamore began to develop in 1891 when the railroad first came through the area.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.allendalecounty.com/government/cities___towns/sycamore.php"
    },
    {
      "id": 3,
      "text": "Sycamore's early history includes a plantation that was used by General Sherman's troops and burned when they departed.",
      "sourceSentenceIds": [
        20
      ],
