  "facts": [
    {
      "id": 1,
      "text": "Wartburg was founded in 1844 by Georg Friedrich Gerding, a land speculator who organized the East Tennessee Colonization Company.",
      "sourceSentenceIds": [
        2,
        3
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Wartburg%2C_Tennessee",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town’s name comes from Wartburg Castle in Germany, where Martin Luther translated the New Testament into German.",
      "sourceSentenceIds": [
        4,
        5
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Wartburg%2C_Tennessee",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Early settlers included European-trained professionals such as architect Carl Rothe and musician Gustav Knabe, bringing cultural flair to the new community.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Wartburg%2C_Tennessee",
      "category": "people",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "During the Civil War, Confederate and Union forces clashed near Wartburg in 1862, reflecting the town’s deep division over secession.",
      "sourceSentenceIds": [
        20,
        26
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Wartburg%2C_Tennessee",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The current courthouse, a Richardsonian Romanesque building completed in 1904, stands as a historic landmark in downtown Wartburg.",
      "sourceSentenceIds": [
        30
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Wartburg%2C_Tennessee",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Wartburg Speedway, a dirt racetrack, hosts an annual race season that draws fans from across the region.",
