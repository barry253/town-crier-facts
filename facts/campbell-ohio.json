  "facts": [
    {
      "id": 1,
      "text": "Campbell began in 1902 when the Youngstown Iron, Sheet and Tube Company built a factory on the Mahoning River.",
      "sourceSentenceIds": [
        6,
        4
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://cityofcampbellohio.org/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town was first called East Youngstown, a name that lingered on deeds until 1926 when it was renamed after industrialist James Campbell.",
      "sourceSentenceIds": [
        2,
        3
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Campbell%2C_Ohio",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Greek immigrants settled early in Campbell, making the village a notable hub of Greek culture in the region.",
      "sourceSentenceIds": [
        13
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Campbell%2C_Ohio",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The Campbell Works once housed four blast furnaces and a 79‑inch hot strip mill, a marvel of early 20th‑century steelmaking.",
      "sourceSentenceIds": [
        14
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Campbell%2C_Ohio",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Rail service from the Mahoning Valley Railway, Chessie, and Three Rivers Railroads kept Campbell connected to the national steel network.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Campbell%2C_Ohio",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "In 1977, the sudden closure of the Campbell Works left 5,000 workers unemployed, an event locals remember as “Black Monday.”.",
      "sourceSentenceIds": [
        18
