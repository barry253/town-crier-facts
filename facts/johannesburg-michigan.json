  "facts": [
    {
      "id": 1,
      "text": "Johannesburg, Michigan, takes its name from Johanna Hanson, the wife of the company president who founded the town.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.charltontownship.com/"
    },
    {
      "id": 2,
      "text": "A Michigan Central Railroad branch reached Johannesburg in 1887, linking the community to the wider rail network.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Johannesburg%2C_Michigan"
    },
    {
      "id": 3,
      "text": "Charlton Township, which includes Johannesburg, was established in 1875, laying the groundwork for the town's development.",
      "sourceSentenceIds": [
        26
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.charltontownship.com/"
    },
    {
      "id": 4,
      "text": "At its height, Johannesburg, affectionately called Joburg, housed about 700 residents, bustling with lumber and milling activity.",
      "sourceSentenceIds": [
        29
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.charltontownship.com/"
    },
    {
      "id": 5,
      "text": "Historic Sanborn Fire Insurance Maps from 1912 capture Johannesburg's downtown layout, revealing labeled businesses and industrial buildings.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://hometownhistorymaps.com/pages/history-of-johannesburg-michigan"
    },
    {
      "id": 6,
      "text": "The town's library, built in the early 20th century, remains a cultural hub for Johannesburg residents today.",
