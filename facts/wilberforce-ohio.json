  "facts": [
    {
      "id": 1,
      "text": "Wilberforce, Ohio, takes its name from British abolitionist William Wilberforce, who helped end the slave trade in the United Kingdom.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Wilberforce%2C_Ohio",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town is home to the National Afro‑American Museum and Cultural Center, the first national museum devoted to African‑American history.",
      "sourceSentenceIds": [
        9,
        17
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 2"
      ],
      "source": "https://en.wikipedia.org/wiki/Wilberforce%2C_Ohio",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Before the Civil War, Wilberforce served as a crucial Underground Railroad stop, operating seven stations for escaping slaves.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Wilberforce%2C_Ohio",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Wilberforce hosts two historically black universities—Wilberforce University, founded in 1856, and Central State University—making it a center of African‑American higher education.",
      "sourceSentenceIds": [
        8,
        10
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Wilberforce%2C_Ohio",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "In 1970, Congressman Clarence Brown introduced federal legislation to establish an African‑American museum on the historic Wilberforce University campus.",
      "sourceSentenceIds": [
        3,
        13
      ],
      "sourceLabels": [
        "Web source 2",
        "Web source 1"
      ],
      "source": "https://www.nps.gov/places/naamcc.htm",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The museum opened in 1988, showcasing more than 9,000 artifacts and 650 linear feet of archival material that tell the story of resistance.",
      "sourceSentenceIds": [
        14,
        15
      ],
      "sourceLabels": [
        "Web source 1",
        "Web source 2"
      ],
      "source": "https://www.greenecountyohio.org/listing/national-afro-american-museum-%26-cultural-center/16/",
