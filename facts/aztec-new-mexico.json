  "facts": [
    {
      "id": 1,
      "text": "Aztec was founded in September 1887 to provide commercial services for new Hispanic and Anglo settlers.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://aztecmuseum.org/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Early settlers named the town Aztec after mistaking Puebloan ruins for the ancient Mexican civilization.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://aztecmuseum.org/",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The Aztec Ruins National Monument, a 900‑year‑old Puebloan site, lies just outside the town.",
      "sourceSentenceIds": [
        17
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Aztec%2C_New_Mexico",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The Aztec Museum displays artifacts that trace the town’s 900‑year history and early irrigation ditches.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://aztecmuseum.org/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Aztec’s semi‑arid climate brings hot summers, with about 50 afternoons each year exceeding 90°F.",
