      ],
      "source": "https://en.wikipedia.org/wiki/Rosedale%2C_Alberta",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The Rosedale Bridge on Roper Rd offers views of the Red Deer River and a gravel road beneath for fishing.",
      "sourceSentenceIds": [
        14
      ],
      "sourceLabels": [
