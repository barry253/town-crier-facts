  "facts": [
    {
      "id": 1,
      "text": "Breathedsville earned its name from the Breathed family, whose 18th‑century homesteads anchored the town’s early growth.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/breathedsville_maryland",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "By the 1880s, the Washington County Railroad linked Breathedsville to Hagerstown, speeding grain shipments to Baltimore.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/breathedsville_maryland",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The nearby canal boosted regional wheat and corn markets, even though Breathedsville never sat on its banks.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/breathedsville_maryland",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Booths Mill on Antietam Creek, just outside Breathedsville, churned thousands of flour barrels by the 1880s.",
      "sourceSentenceIds": [
        29
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/breathedsville_maryland",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "During the Civil War, Breathedsville lay only ten miles from the Antietam Battlefield, witnessing troop movements.",
      "sourceSentenceIds": [
        30
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/breathedsville_maryland",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Today, Breathedsville’s population is predominantly Black or African American, making up 69.1% of residents.",
      "sourceSentenceIds": [
