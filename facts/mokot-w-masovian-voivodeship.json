  "facts": [
    {
      "id": 1,
      "text": "Mokotów’s name may stem from a German owner called Mokoto or Mokot, though no records confirm such a person.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Mokot%C3%B3w"
    },
    {
      "id": 2,
      "text": "Mokotów joined Warsaw in 1916, transforming a village into a bustling urban district.",
      "sourceSentenceIds": [
        16
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Mokot%C3%B3w"
    },
    {
      "id": 3,
      "text": "The first documented mention of Mokotów appears as Mokotowo in 1367.",
      "sourceSentenceIds": [
        17
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Mokot%C3%B3w"
    },
    {
      "id": 4,
      "text": "In the 1700s, wealthy magnates built grand mansions, villas, and palaces across Mokotów.",
      "sourceSentenceIds": [
        18
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Mokot%C3%B3w"
    },
    {
      "id": 5,
      "text": "Most of Mokotów’s pre‑war buildings survived World War II, making it one of Warsaw’s few well‑preserved historic areas.",
      "sourceSentenceIds": [
        20
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Mokot%C3%B3w"
    },
    {
      "id": 6,
      "text": "Mokotów Prison, a notorious facility, sits within the borough and has a long, controversial history.",
