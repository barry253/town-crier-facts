  "facts": [
    {
      "id": 1,
      "text": "Arivaca’s name comes from the O'odham words 'Ari' meaning 'little' and 'vaca' meaning 'springs', pointing to the area’s water sources.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.visitarivaca.com/arivaca-history",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Arivaca first appeared on maps as 'Aravica Mines' in 1860, hinting at early mining interest.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Arivaca%2C_Arizona",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "In 1879, builders erected the Arivaca Schoolhouse, Arizona’s oldest standing school building, later added to the National Register in 2012.",
      "sourceSentenceIds": [
        8,
        9
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Arivaca%2C_Arizona",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Father Kino trekked through Arivaca in 1695, marking the visita of San Martin de Aribac on his Pimeria Alta map.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.visitarivaca.com/arivaca-history",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The 1918 influenza epidemic took the lives of 30 Arivaca residents, a grim reminder of the era’s health crises.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.visitarivaca.com/arivaca-history",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "From 1911 to 1914, the Tucson–Nogales railroad reached Arivaca, but mail continued to arrive by mule-drawn buckboard.",
