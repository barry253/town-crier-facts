  "facts": [
    {
      "id": 1,
      "text": "Valencia was originally called Brookside, then Sunnyside, but the name changed in the 1890s to avoid confusion with a railroad stop of the same name in Lancaster, Pennsylvania.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Valencia%2C_Pennsylvania",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The borough’s incorporation date is disputed; some records say 1896, others 1897, reflecting a small historical hiccup.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.butlereagle.com/20240213/valencia-a-tiny-borough-with-a-big-history/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "In 1902 the Kingsley Association bought 65 acres in Valencia to create a “fresh‑air farm” that hosted up to 250 inner‑city children each summer.",
      "sourceSentenceIds": [
        25
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.experiencebutler.com/cities-and-towns/valencia/",
      "category": "people",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Valencia’s volunteer fire station, opened in 1927, served not only the borough but also neighboring Mars, Adams, and Middlesex townships, extending its reach into Allegheny County.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.butlereagle.com/20240213/valencia-a-tiny-borough-with-a-big-history/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The borough sits in the valley of Breakneck Creek near its source, bordered by Adams Township to the north, east, and west and by Richland and Pine townships to the south.",
