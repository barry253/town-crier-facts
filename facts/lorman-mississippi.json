  "facts": [
    {
      "id": 1,
      "text": "Lorman was originally called Hays City in 1884, renamed in 1899 after landowner Charlotte Hays' daughter Mary Lorman Hays to avoid confusion.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/Lorman,_Mississippi",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town’s growth hinged on a post office and railroad stop, and the historic Old Country Store, founded 1875, still serves Southern fried chicken.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/Lorman,_Mississippi",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Alcorn State University, founded 1871, lies just outside Lorman and is the nation’s first Black land‑grant college, shaping the town’s identity.",
      "sourceSentenceIds": [
        5,
        23
      ],
      "sourceLabels": [
        "Web source 2",
        "Web source 1"
      ],
      "source": "https://dailywise.com/state/mississippi/this-hidden-mississippi-town-glows-with-history-soulful-food-and-college-spirit/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Lorman hosts several historic plantations, including Blantonia, Canemount, China Grove, Prospect Hill, and Rosswood, reflecting its Delta heritage.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Lorman%2C_Mississippi",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The Great River Road passes through Lorman, linking it to the Mississippi River corridor and preserving its historic travel route.",
      "sourceSentenceIds": [
        11
