  "facts": [
    {
      "id": 1,
      "text": "Flemington was named after pioneer settler William Fleming in the early 19th century.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Flemington%2C_Georgia",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "William Fleming surveyed a tract ten miles west of Midway in 1815, naming it Gravel Hill.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://cityofflemington.org/flemington-history",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Early settlers such as John Osgood and Major John Bacon, members of Midway Congregational Church, built a log house that served as church and school.",
      "sourceSentenceIds": [
        16,
        17,
        20,
        21
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://cityofflemington.org/flemington-history",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "A frame church on Gravel Hill, built on land given by Simon Fraser, served the community for twenty years starting in 1832.",
      "sourceSentenceIds": [
        24,
        25,
        26
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://cityofflemington.org/flemington-history",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Flemington’s post office operated from 1889 until 1966, marking the town’s early communication hub.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Flemington%2C_Georgia",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Route 84 runs through Flemington, connecting it west to Hinesville and east to Interstate 95 near Midway.",
      "sourceSentenceIds": [
        14
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Flemington%2C_Georgia",
