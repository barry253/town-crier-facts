  "facts": [
    {
      "id": 1,
      "text": "Weissensee takes its name from the small lake Weißer See, literally meaning \"White Lake,\" which sits at the heart of the quarter.",
      "sourceSentenceIds": [
        13
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Wei%C3%9Fensee_(Berlin)",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The lake is almost circular, about 300 metres across and 10.6 metres deep, covering 8.3 hectares of water.",
      "sourceSentenceIds": [
        25
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Wei%C3%9Fensee_(Berlin)",
      "category": "nature",
      "quality": "poor",
      "qualityReason": "vague"
    },
    {
      "id": 3,
      "text": "The Radrennbahn Weissensee cycling track, built for motorbike racing, later hosted popular music concerts, turning it into a cultural hotspot.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Wei%C3%9Fensee_(Berlin)",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "From 1914 onwards, Weissensee Studios produced silent films, including works by Fritz Lang and the expressionist classic \"The Cabinet of Dr. Caligari.\".",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Wei%C3%9Fensee_(Berlin)",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Weissensee was historically eclipsed by Prenzlauer Berg and Pankow, but its appeal has risen thanks to its proximity to the hip, pricier neighborhood.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Wei%C3%9Fensee_(Berlin)",
      "category": "other",
      "quality": "poor",
      "qualityReason": "editorial_filler"
    },
    {
      "id": 6,
      "text": "The largest concert ever held in Weissensee was Bruce Springsteen’s July 19, 1988 show, drawing an estimated 160,000 fans.",
