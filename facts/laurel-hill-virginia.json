  "facts": [
    {
      "id": 1,
      "text": "Laurel Hill takes its name from the 18th‑century Laurel Hill House, once the home of Revolutionary War patriot William Lindsay.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Laurel_Hill%2C_Virginia",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The community grew on the former Lorton Reformatory grounds, purchased by Fairfax County in 2002 after the prison closed.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Laurel_Hill%2C_Virginia",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Laurel Hill sits in Fairfax County, bordered by Crosspointe to the northwest, Newington Forest to the north, Lorton to the east, and Prince William County to the south.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Laurel_Hill%2C_Virginia",
      "category": "other",
      "quality": "poor",
      "qualityReason": "location_description"
    },
    {
      "id": 4,
      "text": "About twenty miles south of Washington, D.C., Laurel Hill lies near the Potomac River, offering a quiet suburban feel.",
      "sourceSentenceIds": [
        11
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.trawellino.com/destinations/united-states/virginia_laurel-hill",
      "category": "other",
      "quality": "poor",
      "qualityReason": "location_description"
    },
    {
      "id": 5,
      "text": "Laurel Hill Golf Club, a public course, draws golfers from the region and locals alike.",
      "sourceSentenceIds": [
        14
