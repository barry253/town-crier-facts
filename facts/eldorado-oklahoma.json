    },
    {
      "id": 2,
      "text": "Local schoolteacher Walter Thompson named Eldorado, which is Spanish for the gilded one, to symbolize prosperity.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/eldorado_oklahoma"
    },
    {
      "id": 3,
      "text": "Eldorado's origins trace back to a post office established in 1890, before the town shifted to align with the railroad.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/eldorado_oklahoma"
    },
    {
      "id": 4,
      "text": "James Scarborough founded the first local newspaper, the Eldorado Light, in 1901.",
      "sourceSentenceIds": [
        6,
        8,
        9
      ],
      "sourceLabels": [
        "Web source 1",
        "Web source 2"
      ],
      "source": "https://www.okhistory.org/publications/enc/entry?entry=EL003"
    },
    {
      "id": 5,
      "text": "Past industries in Eldorado included copper mining, candy production, and the United States Gypsum Company.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.okhistory.org/publications/enc/entry?entry=EL003"
    },
    {
      "id": 6,
      "text": "Columbian mammoth bones unearthed northwest of Eldorado are now displayed at the Sam Noble Oklahoma Museum of Natural History.",
