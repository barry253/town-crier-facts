  "facts": [
    {
      "id": 1,
      "text": "Redgranite earned its name from the rich deposits of mahogany-red granite discovered in the area in 1889.",
      "sourceSentenceIds": [
        2,
        15
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 2"
      ],
      "source": "https://en.wikipedia.org/wiki/Redgranite%2C_Wisconsin"
    },
    {
      "id": 2,
      "text": "Hard red granite from Redgranite was used to pave the streets of some of the largest cities in the United States.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://vl.redgranite.wi.gov/"
    },
    {
      "id": 3,
      "text": "The Chicago and Northwestern Railroad extended a ten mile spur line to Redgranite in 1901 to improve stone transportation.",
      "sourceSentenceIds": [
        1,
        12
      ],
      "sourceLabels": [
        "Web source 1",
        "Web source 2"
      ],
      "source": "https://vl.redgranite.wi.gov/"
    },
    {
      "id": 4,
      "text": "Concrete and asphalt replaced paving blocks around 1920, ending the local granite paving business after a 1913 strike.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://vl.redgranite.wi.gov/"
    },
    {
      "id": 5,
      "text": "The former quarry site in Redgranite is now a water-filled pit used for swimming.",
      "sourceSentenceIds": [
