      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://doverlibrary.org/local-history-room/local-history-resources/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Dover sits on the Tuscarawas River near Sugar Creek’s mouth, giving it a scenic riverside setting.",
