  "facts": [
    {
      "id": 1,
      "text": "Whiterocks takes its name from the white outcropping near the mouth of the canyon, as named by the Ute Indians.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://onlineutah.us/whiterockshistory.shtml"
    },
    {
      "id": 2,
      "text": "Fort Robidoux, one of Utah's first European-American trading posts, was established on the outskirts of modern Whiterocks in 1828.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Whiterocks%2C_Utah"
    },
    {
      "id": 3,
      "text": "Whiterocks was established in 1868 as the first white settlement in eastern Utah.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://onlineutah.us/whiterockshistory.shtml"
    },
    {
      "id": 4,
      "text": "Chief Antero recommended moving the Indian Agency to Whiterocks in 1868 because the site was located in the center of the basin.",
      "sourceSentenceIds": [
        22,
        24,
        28
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Whiterocks%2C_Utah"
    },
    {
      "id": 5,
      "text": "Whiterocks is located near an ancient Uinta Fremont village that was partially excavated in 1966.",
      "sourceSentenceIds": [
        29
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Whiterocks%2C_Utah"
    },
    {
      "id": 6,
      "text": "The region around Whiterocks preserves archaeological evidence of human occupation dating back to Paleoindian hunters around 11,000 BC.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Web source 1"
      ],
