  "facts": [
    {
      "id": 1,
      "text": "Oswego was settled by Scots-Irish and English colonists in the mid-eighteenth century who relied on tobacco, cotton, and timber.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/oswego_south_carolina"
    },
    {
      "id": 2,
      "text": "The community was originally called Lodebar and then Bethel before adopting the name Oswego by eighteen ninety.",
      "sourceSentenceIds": [
        26
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/oswego_south_carolina"
    },
    {
      "id": 3,
      "text": "Bethel United Methodist Church was completed in eighteen fifty-eight using donated timber and labor from the local community.",
      "sourceSentenceIds": [
        25
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/oswego_south_carolina"
    },
    {
      "id": 4,
      "text": "Oswego features the flat to gently rolling rural landscapes characteristic of the South Carolina Midlands.",
      "sourceSentenceIds": [
        19
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/oswego_south_carolina"
    },
    {
      "id": 5,
      "text": "A humid subtropical climate in Oswego brings hot, humid summers and mild winters with an average annual temperature of sixty-two degrees.",
      "sourceSentenceIds": [
        20,
        21
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/oswego_south_carolina"
    },
    {
      "id": 6,
      "text": "Commercial cotton cultivation introduced around seventeen ninety-six established the area as part of the antebellum plantation system.",
