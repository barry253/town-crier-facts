  "facts": [
    {
      "id": 1,
      "text": "Black River is a village in Jefferson County, New York, located on the border of the towns of Le Ray and Rutland.",
      "sourceSentenceIds": [
        6,
        7
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Black_River%2C_New_York"
    },
    {
      "id": 2,
      "text": "The area was first settled around 1806 with the construction of a mill on the south side of the Black River.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Black_River%2C_New_York"
    },
    {
      "id": 3,
      "text": "Black River was previously called Lockport and grew to include both sides of the river and two small river islands.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Black_River%2C_New_York"
    },
    {
      "id": 4,
      "text": "The LeRay Mansion in Black River was listed on the National Register of Historic Places in 1974.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Black_River%2C_New_York"
    },
    {
      "id": 5,
      "text": "The Black River flows through the center of the village and forms the border between the towns of Le Ray and Rutland.",
      "sourceSentenceIds": [
        21
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Black_River%2C_New_York"
    },
    {
      "id": 6,
      "text": "The community incorporated as a village in 1891, taking land from the towns of Rutland and Le Ray.",
      "sourceSentenceIds": [
        19
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Black_River%2C_New_York"
