  "facts": [
    {
      "id": 1,
      "text": "Nicolaus was founded in 1850 and has had a post office since July 28, 1851, making it one of California's oldest post offices.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Nicolaus%2C_California"
    },
    {
      "id": 2,
      "text": "The town's namesake, Nicolaus Allgeier, opened a ferry in 1843 to cross the Feather River between Sutter's Fort and Sutter's Hock Farm.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Nicolaus%2C_California"
    },
    {
      "id": 3,
      "text": "During the Gold Rush, Nicolaus served as a major stopping point along the Feather River, drawing miners and traders.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Nicolaus%2C_California"
    },
    {
      "id": 4,
      "text": "From 1850-1851 and 1852-1856, Nicolaus briefly held the title of Sutter County seat, even moving to Yuba City for two months in 1854.",
      "sourceSentenceIds": [
        11
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Nicolaus%2C_California"
    },
    {
      "id": 5,
      "text": "The local economy thrives on walnut orchards and rice farming, reflecting the fertile lands along the Feather River.",
      "sourceSentenceIds": [
        21
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Nicolaus%2C_California"
    },
    {
      "id": 6,
      "text": "Every Labor Day, Nicolaus hosts a parade that attracts visitors from across the state, celebrating its community spirit.",
      "sourceSentenceIds": [
        22
      ],
