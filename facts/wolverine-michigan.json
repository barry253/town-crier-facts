  "facts": [
    {
      "id": 1,
      "text": "When George Richards settled, the community was first called Torrey before adopting the name Wolverine for its post office in 1880.",
      "sourceSentenceIds": [
        3,
        29
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Wolverine%2C_Michigan"
    },
    {
      "id": 2,
      "text": "In the 1890s, Wolverine boomed as logging camps multiplied and the whistle of locomotives echoed through the forest.",
      "sourceSentenceIds": [
        18
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://thumbwind.com/2025/12/02/history-of-wolverine-michigan/"
    },
    {
      "id": 3,
      "text": "The Jackson, Lansing & Saginaw Railroad reached Wolverine by 1881, turning the village into a critical rail artery for timber.",
      "sourceSentenceIds": [
        19
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://thumbwind.com/2025/12/02/history-of-wolverine-michigan/"
    },
    {
      "id": 4,
      "text": "Wolverine’s 1910s depot hosted passengers and freight, with a water tower steaming up steam locomotives.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://thumbwind.com/2025/12/02/history-of-wolverine-michigan/"
    },
    {
      "id": 5,
      "text": "The Sturgeon River runs through Wolverine, home to a state fish hatchery that once supported local fishing.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://thumbwind.com/2025/12/02/history-of-wolverine-michigan/"
    },
    {
      "id": 6,
      "text": "Wolverine’s roots trace back to Native American tribes who first navigated the Sturgeon River before European settlement.",
      "sourceSentenceIds": [
