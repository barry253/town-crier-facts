  "facts": [
    {
      "id": 1,
      "text": "Brown City began as a railroad station in 1879 on the Port Huron and Northwestern Railway, later part of the Pere Marquette system.",
      "sourceSentenceIds": [
        4,
        5,
        6
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 2"
      ],
      "source": "https://en.wikipedia.org/wiki/Brown_City%2C_Michigan"
    },
    {
      "id": 2,
      "text": "By 1907 the community had grown from a village incorporated in 1887 to an officially recognized city.",
      "sourceSentenceIds": [
        6,
        26
      ],
      "sourceLabels": [
        "Web source 2",
        "Wikipedia"
      ],
      "source": "https://thumbwind.com/2026/03/10/brief-history-of-brown-city/"
    },
    {
      "id": 3,
      "text": "The Travco factory turned Brown City into the “Home of the Motorhome,” linking the town to the RV boom.",
      "sourceSentenceIds": [
        10,
        1
      ],
      "sourceLabels": [
        "Web source 2",
        "Web source 2"
      ],
      "source": "https://thumbwind.com/2026/03/10/brief-history-of-brown-city/"
    },
    {
      "id": 4,
      "text": "Lumber and agriculture powered Brown City’s early economy, with the Brown City Elevator becoming a key grain exchange point.",
      "sourceSentenceIds": [
        1,
        25
      ],
      "sourceLabels": [
        "Web source 2",
        "Wikipedia"
      ],
      "source": "https://thumbwind.com/2026/03/10/brief-history-of-brown-city/"
    },
    {
      "id": 5,
      "text": "Just outside town, the Bruce Mansion stands as a prominent reminder of the region’s lumber‑era prosperity.",
      "sourceSentenceIds": [
        21,
        18
      ],
      "sourceLabels": [
        "Web source 2",
        "Web source 2"
      ],
      "source": "https://thumbwind.com/2026/03/10/brief-history-of-brown-city/"
    },
    {
      "id": 6,
      "text": "Brown City lies in Michigan’s Thumb, straddling Sanilac County with a small slice in Lapeer County.",
