  "facts": [
    {
      "id": 1,
      "text": "Murdock was platted in 1914 by land speculator John Murdock after the Charlotte Harbor and Northern Railway opened in 1907.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://charlottefl.ent.sirsi.net/client/en_US/libraries/?rm=MURDOCK1%7C%7C%7C1%7C%7C%7C0%7C%7C%7Ctrue",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "At the southwest corner of US 41 and the CH&N, Murdock once hosted a hotel, general store, post office, loading dock, and a two‑story depot.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://charlottefl.ent.sirsi.net/client/en_US/libraries/?rm=MURDOCK1%7C%7C%7C1%7C%7C%7C0%7C%7C%7Ctrue",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "John Murdock abandoned the town in 1916 and relocated to Jacksonville, leaving the village largely dormant.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://charlottefl.ent.sirsi.net/client/en_US/libraries/?rm=MURDOCK1%7C%7C%7C1%7C%7C%7C0%7C%7C%7Ctrue",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The Murdock Library was founded in 1985 as the administrative hub of the Charlotte County Library System.",
      "sourceSentenceIds": [
        14
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Port_Charlotte%2C_Florida",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "In 2005 the Murdock Public Library moved into the new Mid‑County Regional Library facility, consolidating services for the area.",
      "sourceSentenceIds": [
        16
      ],
