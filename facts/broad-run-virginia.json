  "facts": [
    {
      "id": 1,
      "text": "Broad Run takes its name from the waterway that winds through the village, giving the town its identity.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Broad_Run%2C_Virginia",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Chapman's Mill, also known as Beverley’s Mill, sits two‑thirds of a mile east‑southeast of town center and was the site of the Civil War Battle of Thoroughfare Gap.",
      "sourceSentenceIds": [
        5,
        10,
        18
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Broad_Run%2C_Virginia",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The Broad Run/Little Georgetown Rural Historic District spans nearly 9,500 acres across Fauquier and Prince William counties, preserving a rare 19th‑century agricultural landscape.",
      "sourceSentenceIds": [
        25,
        26,
        27
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.dhr.virginia.gov/historic-registers/030-5514/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "When railroads fell out of favor, Broad Run’s bustling late‑19th‑century community dwindled, leaving fewer than five historic homes and scattered stone foundations.",
      "sourceSentenceIds": [
        4,
        9,
        16
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 2"
      ],
      "source": "https://en.wikipedia.org/wiki/Broad_Run%2C_Virginia",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The Broad Run postal area’s southern edge once housed the historic town of New Baltimore, now largely outside the modern postal boundaries.",
      "sourceSentenceIds": [
        7,
        12
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Broad_Run%2C_Virginia",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Today, Sharkawi Farms spices and Meriwether Vineyard’s Pearmund Cellars Winery showcase Broad Run’s ongoing agricultural charm.",
      "sourceSentenceIds": [
