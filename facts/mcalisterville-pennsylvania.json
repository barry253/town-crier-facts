  "facts": [
    {
      "id": 1,
      "text": "McAlisterville was founded in 1810 and named for early settler Hugh McAlister, who acquired the land in the late eighteenth century.",
      "sourceSentenceIds": [
        1,
        8
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/mcalisterville_pennsylvania"
    },
    {
      "id": 2,
      "text": "McAlisterville once hosted the first school in Pennsylvania dedicated to educating children orphaned or half-orphaned by the American Civil War.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/mcalisterville_pennsylvania"
    },
    {
      "id": 3,
      "text": "The community of McAlisterville sits in the valley of Little Lost Creek, a tributary of the Juniata River.",
      "sourceSentenceIds": [
        17
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/McAlisterville%2C_Pennsylvania"
    },
    {
      "id": 4,
      "text": "Lost Creek Presbyterian Church has served the McAlisterville area since 1800, originally forming as an extension of a church in Mifflintown.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/mcalisterville_pennsylvania"
    },
    {
      "id": 5,
      "text": "McAlisterville is the boyhood home of radio personality Nelson Lauver, known for The American Storyteller Radio Journal.",
      "sourceSentenceIds": [
        29
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/McAlisterville%2C_Pennsylvania"
    },
    {
      "id": 6,
      "text": "William McAlister formally established the village in 1810 by surveying and laying out seven half-acre lots along the main road.",
