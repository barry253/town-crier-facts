      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Iron_City%2C_Tennessee",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town’s iron ore mining boom began in 1886 when a railroad branch reached the area, turning a small settlement into a mining hub.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Iron_City%2C_Tennessee",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Iron City sits in Shoal Creek Valley, surrounded by rugged hills on three sides and the creek to the east.",
      "sourceSentenceIds": [
        16,
        17
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Iron_City%2C_Tennessee",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "State Route 242 meets State Route 227 in Iron City, linking the community to Westpoint and Lawrenceburg to the northeast.",
      "sourceSentenceIds": [
        20
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Iron_City%2C_Tennessee",
