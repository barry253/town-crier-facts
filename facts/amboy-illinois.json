  "facts": [
    {
      "id": 1,
      "text": "Amboy grew when the Illinois Central Railroad extended there in the 1850s, turning it into a manufacturing and repair hub.",
      "sourceSentenceIds": [
        8,
        13
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 2"
      ],
      "source": "https://en.wikipedia.org/wiki/Amboy%2C_Illinois",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town’s name may come from the Indian word “em‑boli,” meaning “between the hills,” or from Perth Amboy, New Jersey.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://issuu.com/shawmedia/docs/svm_awg_090922/s/16774542",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The historic Amboy Depot Museum sits in a former Illinois Central depot and division headquarters, now on the National Register of Historic Places.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://issuu.com/shawmedia/docs/svm_awg_090922/s/16774542",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "During World War II, Amboy hosted the Green River Ordnance Plant, a major ammunition factory that operated from 1942 to 1945.",
      "sourceSentenceIds": [
        7,
        27
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Amboy%2C_Illinois",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "In 1860, Joseph Smith III reorganized the Community of Christ in Amboy, marking a significant religious event in the town’s history.",
      "sourceSentenceIds": [
