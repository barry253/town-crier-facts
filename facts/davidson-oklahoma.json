    },
    {
      "id": 2,
      "text": "The town of Davidson was named in honor of A. Davidson, who served as a railroad director.",
      "sourceSentenceIds": [
        1,
        5
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Davidson%2C_Oklahoma"
    },
    {
      "id": 3,
      "text": "Agriculture drove the early economy of Davidson, which at one time featured five cotton gins and three grain elevators.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Davidson%2C_Oklahoma"
    },
    {
      "id": 4,
      "text": "Early Davidson offered a full range of services, including movie theaters, newspapers, saloons, livery stables, and blacksmiths.",
      "sourceSentenceIds": [
