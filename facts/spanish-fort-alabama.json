  "facts": [
    {
      "id": 1,
      "text": "Spanish Fort sits on a hill overlooking Mobile Bay, just 10 miles east of Mobile.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.cityofspanishfort.com/history"
    },
    {
      "id": 2,
      "text": "The area was first a French trading post during Mobile’s occupation, later becoming a plantation by Louis Augustin Rochon in the 1750s.",
      "sourceSentenceIds": [
        5,
        6,
        22
      ],
      "sourceLabels": [
        "Web source 1",
        "Wikipedia"
      ],
      "source": "https://www.cityofspanishfort.com/history"
    },
    {
      "id": 3,
      "text": "In 1780, Choctaw warriors raided the Rochon plantation, killing three household members and an enslaved African man.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Spanish_Fort%2C_Alabama"
    },
    {
      "id": 4,
      "text": "During the Civil War, Confederate forces fortified Spanish Fort as an eastern defense of Mobile, and Union troops captured it after a fierce bombardment on April 8.",
      "sourceSentenceIds": [
        8,
        28,
        14
      ],
      "sourceLabels": [
        "Web source 2",
        "Wikipedia",
        "Web source 2"
      ],
      "source": "https://encyclopediaofalabama.org/article/spanish-fort/"
    },
    {
      "id": 5,
      "text": "The city’s seal displays six flags that have flown over it, reflecting its colonial, British, Spanish, and Confederate past.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.cityofspanishfort.com/history"
    },
    {
      "id": 6,
      "text": "Spanish Fort’s streets in the Estates area are named after Civil War battles, and historic plaques dot the streets.",
      "sourceSentenceIds": [
