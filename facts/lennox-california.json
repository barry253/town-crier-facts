  "facts": [
    {
      "id": 1,
      "text": "Lennox was established as a small farming settlement around 1905 and named Lennox in 1912.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Lennox%2C_California",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The city was originally much larger, covering several square miles of what is now Inglewood and Hawthorne.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Lennox%2C_California",
      "category": "history",
      "quality": "poor",
      "qualityReason": "vague"
    },
    {
      "id": 3,
      "text": "Lennox began as an unincorporated community and was incorporated as a city in 1951.",
