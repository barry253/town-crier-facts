      ],
      "source": "https://www.wisdomlib.org/cities/lennox-23988",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "A Pacific Electric railway line ran through Lennox’s center along Hawthorne Boulevard in the 1920s.",
      "sourceSentenceIds": [
