  "facts": [
    {
      "id": 1,
      "text": "West Sand Lake was formed in 1812 from parts of Greenbush and Berlin, dating back to Dutch colony Rensselaerswyck.",
      "sourceSentenceIds": [
        4,
        16
      ],
      "sourceLabels": [
        "Web source 2",
        "Web source 1"
      ],
      "source": "https://discoversandlake.org/history-of-sand-lake/"
    },
    {
      "id": 2,
      "text": "Route 43 has long been the backbone of West Sand Lake, linking its historic hamlet to surrounding areas.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.townofsandlake.us/townofsandlake"
    },
    {
      "id": 3,
      "text": "The hamlet’s main street still hosts a mid‑1800s building that once housed a pharmacy, now a charming local shop.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.townofsandlake.us/townofsandlake"
    },
    {
      "id": 4,
      "text": "The western edge of the hamlet contains homes that trace back to the early 1800s, making it the oldest part of town.",
      "sourceSentenceIds": [
        25
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.townofsandlake.us/townofsandlake"
    },
    {
      "id": 5,
      "text": "West Sand Lake’s landscape shifts from undulating hills in the west to rugged mountains in the east.",
      "sourceSentenceIds": [
        18
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.townofsandlake.us/townofsandlake"
    },
    {
      "id": 6,
      "text": "The town’s early industry thrived along Wynant’s “Kill,” a creek that powered mills and shaped settlement patterns.",
      "sourceSentenceIds": [
        21
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.townofsandlake.us/townofsandlake"
