  "facts": [
    {
      "id": 1,
      "text": "Cochecton sits on the Delaware River where a historic \"station rock\" marked the triple‑state border of New York, New Jersey, and Pennsylvania.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Cochecton%2C_New_York",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town’s name comes from the Lenape word \"cushetunk,\" meaning \"place of red stone hills,\" echoing the area’s abundant red mudstone.",
      "sourceSentenceIds": [
        22
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Cochecton%2C_New_York",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Cochecton’s railroad station is the oldest surviving passenger station in New York State, and it was moved a mile upstream in the 1990s.",
      "sourceSentenceIds": [
        3,
        5
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Cochecton%2C_New_York",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The Drake‑Curtis House, Cochecton Presbyterian Church, and several other sites are listed on the National Register of Historic Places.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Cochecton%2C_New_York",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Originally part of Mamakating, Cochecton became its own town in 1828 and later gave rise to the Town of Delaware in 1869.",
      "sourceSentenceIds": [
        11,
        26,
        27
      ],
      "sourceLabels": [
        "Web source 1"
      ],
