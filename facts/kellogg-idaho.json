  "facts": [
    {
      "id": 1,
      "text": "Kellogg takes its name from prospector Noah Kellogg, who first staked a claim in the area.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Kellogg%2C_Idaho"
    },
    {
      "id": 2,
      "text": "For nearly a century, Kellogg thrived as a silver mining hub, extracting vast amounts of the precious metal.",
      "sourceSentenceIds": [
        11,
        12
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Kellogg%2C_Idaho"
    },
    {
      "id": 3,
      "text": "When Bunker Hill Mine shut in 1981, thousands lost jobs and the region faced lead contamination in water and soil.",
      "sourceSentenceIds": [
        13,
        14
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Kellogg%2C_Idaho"
    },
    {
      "id": 4,
      "text": "After mining closed, Kellogg reinvented itself as a ski resort, featuring a 3.1‑mile gondola that climbs to a 5,700‑foot lodge on Kellogg Mountain.",
      "sourceSentenceIds": [
        16,
        17,
        20,
        21
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Kellogg%2C_Idaho"
    },
    {
      "id": 5,
      "text": "In May 1972, a fire at the Sunshine Mine claimed 91 miners' lives, prompting new safety regulations.",
      "sourceSentenceIds": [
        22,
