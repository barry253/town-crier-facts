    },
    {
      "id": 2,
      "text": "In the late 19th and early 20th centuries, timber and the Northern Pacific Railroad drove Napavine’s early economy.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Napavine%2C_Washington"
    },
    {
      "id": 3,
      "text": "A passenger depot opened in Napavine in the late 1910s and remained in service until 1960.",
      "sourceSentenceIds": [
        14
