      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The Northumberland County Historical Society Museum, housed in the historic Rice’s Hotel/Hughlett’s Tavern, offers artifacts that trace the area’s colonial roots.",
      "sourceSentenceIds": [
        18,
        27
      ],
      "sourceLabels": [
