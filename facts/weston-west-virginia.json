  "facts": [
    {
      "id": 1,
      "text": "Weston began as Preston in 1818, became Lewis County’s seat, and was renamed Weston in 1819 after land donor Henry Flesher.",
      "sourceSentenceIds": [
        1,
        5,
        6,
        7
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 2",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Weston%2C_West_Virginia",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The Trans‑Allegheny Lunatic Asylum, authorized in 1858, opened in 1864 after Civil War delays and now stands as a National Historic Landmark.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.britannica.com/place/Weston-West-Virginia",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Today the former asylum building, one of the nation’s largest hand‑cut stone structures, operates as the Trans‑Allegheny Lunatic Asylum tourist attraction.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.wvencyclopedia.org/entries/1100",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "In 1879 a narrow‑gauge railroad linked Weston to Clarksburg, a development fueled by commerce generated by the asylum.",
      "sourceSentenceIds": [
        11
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.wvencyclopedia.org/entries/1100",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Weston lies on the West Fork River where it meets Stonecoal Creek, roughly 15 miles west of Buckhannon.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Weston%2C_West_Virginia",
      "category": "nature",
      "quality": "poor",
      "qualityReason": "location_description"
    },
    {
      "id": 6,
      "text": "The city hosts the Museum of American Glass, a unique craft museum dedicated to the art and history of glassmaking.",
      "sourceSentenceIds": [
        18
