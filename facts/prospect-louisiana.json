  "facts": [
    {
      "id": 1,
      "text": "Grant Parish, where Prospect sits, was carved from parts of Winn, Rapides, and Catahoula parishes when it was founded on March 4, 1869, during Reconstruction.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/prospect_louisiana"
    },
    {
      "id": 2,
      "text": "After the Civil War, new settlers moved into central Louisiana thanks to expanding railroads, sparking early growth in Prospect.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/prospect_louisiana"
    },
    {
      "id": 3,
      "text": "Prospect lies at 31°26′55″N 92°29′49″W, standing 177 feet (54 meters) above sea level.",
      "sourceSentenceIds": [
        25
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/prospect_louisiana"
    },
    {
      "id": 4,
      "text": "Prospect is part of the Alexandria Metropolitan Statistical Area, linking it to the regional economy centered around Alexandria, roughly 20 miles south.",
      "sourceSentenceIds": [
        26
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/prospect_louisiana"
    },
    {
      "id": 5,
      "text": "The community exemplifies the area's quiet, rural character, offering a peaceful escape from city life.",
      "sourceSentenceIds": [
        27
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/prospect_louisiana"
    },
    {
      "id": 6,
      "text": "Grant Parish, where Prospect is located, observes Central Standard Time, which is six hours behind Coordinated Universal Time.",
