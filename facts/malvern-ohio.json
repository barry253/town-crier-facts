  "facts": [
    {
      "id": 1,
      "text": "Malvern was laid out in 1834 by Rev. William Hardesty as the village of Troy, then renamed Malvern in 1840.",
      "sourceSentenceIds": [
        15,
        16,
        3
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Malvern%2C_Ohio"
    },
    {
      "id": 2,
      "text": "In 1806 Moses and Mary Porter settled the area that would become Malvern, marking the village’s earliest settlement.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://villageofmalvern.net/"
    },
    {
      "id": 3,
      "text": "Malvern was incorporated as a village on May 31, 1869, formalizing its local government.",
      "sourceSentenceIds": [
        17
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Malvern%2C_Ohio"
    },
    {
      "id": 4,
      "text": "The Malvern Clay Company and Canton & Malvern Fire Clay Paving Brick Company produced millions of paving bricks in 1893, many still visible in local streets.",
      "sourceSentenceIds": [
        18,
        19,
        20
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Malvern%2C_Ohio"
    },
    {
      "id": 5,
      "text": "The Malvern Historical Society, a non‑profit, preserves the village’s 200‑year history and maintains a museum on East Porter Street.",
      "sourceSentenceIds": [
        2,
        5,
        9
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://malvernhistoricalsociety.org/"
    },
    {
      "id": 6,
      "text": "Malvern lies along Sandy Creek and is traversed by Ohio State Route 43, a historic corridor through northwestern Ohio.",
      "sourceSentenceIds": [
        21,
