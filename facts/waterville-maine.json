  "facts": [
    {
      "id": 1,
      "text": "Waterville was incorporated on June 23, 1802 after residents on the west side of the Kennebec River split from Winslow.",
      "sourceSentenceIds": [
        30
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Waterville%2C_Maine",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The city’s name comes from the original village called “Taconnet,” named after Chief Taconnet, located at the Kennebec and Sebasticook confluence.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Waterville%2C_Maine",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "In 1849 the Androscoggin and Kennebec Railroad opened to Waterville, later becoming part of Maine Central Railroad which built repair shops there in 1870.",
      "sourceSentenceIds": [
        10,
        11
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Waterville%2C_Maine",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Hathaway Company, a high‑end dress shirt maker that operated for over 160 years, was bought by Berkshire Hathaway and closed in Waterville.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Waterville%2C_Maine",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The historic Hathaway Mill complex is now being redeveloped into mixed‑use space, including 65 affordable housing units funded by historic tax credits.",
      "sourceSentenceIds": [
        13,
        14
      ],
