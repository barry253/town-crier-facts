    },
    {
      "id": 3,
      "text": "In 1936-38 Mandatory negotiations paved a road to Gan Yavne, reducing isolation.",
      "sourceSentenceIds": [
        15,
        21
      ],
      "sourceLabels": [
        "Web source 2",
        "Wikipedia"
      ],
      "source": "https://grokipedia.com/page/gan_yavne"
    },
    {
      "id": 4,
      "text": "The town's soils are deep loess, calcareous and clayey, making it historically fertile for agriculture.",
      "sourceSentenceIds": [
        13
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/gan_yavne"
    },
    {
      "id": 5,
      "text": "Gan Yavne hosts a youth village, Beit Apple, reflecting its early focus on agricultural education.",
      "sourceSentenceIds": [
