    },
    {
      "id": 2,
      "text": "Name means \"Garden of Yavne\", linking to ancient city of Yavne (Jabneh) near Via Maris.",
      "sourceSentenceIds": [
        1,
        8,
        12,
        14
      ],
      "sourceLabels": [
