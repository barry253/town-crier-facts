  "facts": [
    {
      "id": 1,
      "text": "Sunbury was founded in 1772 where the West and North Branches of the Susquehanna River meet, making it a historic river confluence.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.visitcentralpa.org/plan-your-trip-today/towns-and-countrysides/sunbury/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The city’s name comes from Sunbury‑on‑Thames in England, a town just outside Greater London.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Sunbury%2C_Pennsylvania",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The Edison Hotel, the first building to use Edison’s three‑wire system, was renamed to honor the inventor after he wired the nearby railroad station.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://sunburypa.org/visit-sunbury/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The Northumberland County Historical Society’s museum at 1150 North Front Street houses an extensive genealogical library that preserves local family histories.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://sunburypa.org/visit-sunbury/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "From 1727 to 1756, Sunbury was one of Pennsylvania’s largest and most influential Native American settlements.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Sunbury%2C_Pennsylvania",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "More than 20 houses of worship in Sunbury date back to the mid‑1780s, showcasing the city’s early religious diversity.",
      "sourceSentenceIds": [
        27
