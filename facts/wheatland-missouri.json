  "facts": [
    {
      "id": 1,
      "text": "Wheatland was likely named after President James Buchanan’s Pennsylvania home, called Wheatland, where he died in 1868.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Wheatland%2C_Missouri"
    },
    {
      "id": 2,
      "text": "The town’s Settlers Village preserves original cabins and barns, except for the Butterfield Overland Mail Relay Station built from a historic photograph.",
      "sourceSentenceIds": [
        7,
        8
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://ozarksfn.com/2024/06/28/before-its-gone/"
    },
    {
      "id": 3,
      "text": "Wheatland was officially platted in 1869, just a year after the Butterfield stagecoach line passed through the area.",
      "sourceSentenceIds": [
        10,
        8
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 2"
      ],
      "source": "https://en.wikipedia.org/wiki/Wheatland%2C_Missouri"
    },
    {
      "id": 4,
      "text": "Every historic building in Wheatland carries a plaque that marks its construction era and any notable donors.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://ozarksfn.com/2024/06/28/before-its-gone/"
    },
    {
      "id": 5,
      "text": "Wheatland is a city in Hickory County, Missouri, known for its commitment to preserving local heritage and natural beauty.",
      "sourceSentenceIds": [
        9,
        2
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Wheatland%2C_Missouri"
    },
    {
      "id": 6,
      "text": "The Butterfield Overland Mail Route ran a stagecoach line from Tipton, Missouri, through Wheatland to San Francisco between 1859 and 1861.",
      "sourceSentenceIds": [
        8
      ],
