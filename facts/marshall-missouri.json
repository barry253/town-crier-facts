  "facts": [
    {
      "id": 1,
      "text": "Marshall was founded April 13, 1839 when Jeremiah O'Dell donated land, and named for Supreme Court Chief Justice John Marshall.",
      "sourceSentenceIds": [
        1,
        4,
        13
      ],
      "sourceLabels": [
