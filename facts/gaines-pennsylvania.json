  "facts": [
    {
      "id": 1,
      "text": "Gaines Township was carved out of Shippen Township on December 29, 1837, and named for General Edmund Pendleton Gaines.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/gaines_pennsylvania",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "In the 1930s, natural‑gas exploration near Gaines Township sparked a brief boom, bringing drilling jobs and temporary infrastructure to the area.",
      "sourceSentenceIds": [
        11
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/gaines_pennsylvania",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Gaines lies in the Pine Creek valley, a region celebrated for its rural charm and abundant outdoor recreation opportunities.",
      "sourceSentenceIds": [
        13
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/gaines_pennsylvania",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "By the mid‑1800s, lumbering ruled the local economy, with sawmills on Pine Creek rafting logs downstream to larger markets.",
      "sourceSentenceIds": [
        14
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/gaines_pennsylvania",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Coal mining emerged in the 1880s, spurring the growth of villages like Gurnee and the construction of a 4.5‑mile railroad branch.",
      "sourceSentenceIds": [
        14
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/gaines_pennsylvania",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The first settlers arrived around 1804‑05, lured by the abundant timber along Pine Creek that would shape Gaines’ early development.",
      "sourceSentenceIds": [
        16
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/gaines_pennsylvania",
      "category": "history",
      "quality": "good"
