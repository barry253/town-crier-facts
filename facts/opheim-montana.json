      "id": 1,
      "text": "Opheim was named after early settler Alfred Sumner Opheim, who, with his wife Helen, served as the town’s first postmasters.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Opheim%2C_Montana",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Opheim was established in 1912 during the homestead boom under the Enlarged Homestead Act of 1909.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/opheim_montana",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Opheim’s depot, built before the Great Northern Railway expansion, stayed active until the line’s abandonment in 1991.",
      "sourceSentenceIds": [
        2,
        10
      ],
