      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Canary Islanders, called Isleños, began settling Delacroix between 1779 and 1783 under Spanish governor Bernardo de Gálvez.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Web source 1"
