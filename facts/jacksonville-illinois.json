      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Illinois College, the state’s second‑oldest college, opened in 1829 thanks to a Yale Band of students who traveled west.",
      "sourceSentenceIds": [
        2,
        16
      ],
      "sourceLabels": [
        "Web source 2",
        "Wikipedia"
      ],
      "source": "https://www.jacksonvillemainstreet.org/history",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The Illinois Conference Female Academy, founded in 1846, later evolved into MacMurray College, a notable women's institution.",
      "sourceSentenceIds": [
        4,
        12
      ],
      "sourceLabels": [
        "Wikipedia",
