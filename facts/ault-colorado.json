  "facts": [
    {
      "id": 1,
      "text": "Ault was renamed in 1897 after Alexander Ault, who saved the local grain market by buying the entire harvest during a hard year.",
      "sourceSentenceIds": [
        1,
        20
      ],
      "sourceLabels": [
        "Web source 1",
        "Wikipedia"
      ],
      "source": "https://www.aultcolorado.gov/",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town was originally called High Land, then Burgdorff Siding, and finally Ault after incorporation in 1904.",
      "sourceSentenceIds": [
        5,
        3,
        4
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 2"
      ],
      "source": "https://en.wikipedia.org/wiki/Ault%2C_Colorado",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "A north–south Union Pacific line that connects Denver and Cheyenne runs through Ault, shaping its early growth.",
      "sourceSentenceIds": [
        7,
        9
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Ault%2C_Colorado",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Ault’s only high school merged with nearby towns in 1963, becoming Highland High School.",
      "sourceSentenceIds": [
        16
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Ault%2C_Colorado",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The town’s Fall Festival, held each August, features food, contests, and a street dance, a quirky tradition.",
      "sourceSentenceIds": [
        13
      ],
      "sourceLabels": [
