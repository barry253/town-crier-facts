      "id": 1,
      "text": "Odessa was named after the Ukrainian city of Odesa, reflecting settlers' admiration for the Russian port.",
      "sourceSentenceIds": [
        3,
        1
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 2"
      ],
