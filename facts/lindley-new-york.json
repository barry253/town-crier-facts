      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Eleazer Lindsley, originally from Morristown, New Jersey, helped secure land for the town during the 1789 Treaty of Canandaigua.",
      "sourceSentenceIds": [
