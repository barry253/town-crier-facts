  "facts": [
    {
      "id": 1,
      "text": "Side streets off Main Avenue were once labeled A, B, C, and later renamed after early settlers like Barent Dutcher and Captain John Buckhout.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Irvington%2C_New_York",
      "category": "other",
      "quality": "poor",
      "qualityReason": "editorial_filler"
    },
    {
      "id": 2,
      "text": "Influential residents convinced the Hudson River Railroad to rename the local station to Irvington in 1849, and the post office followed suit.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Irvington%2C_New_York",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The 1881 Burnham factory, rebuilt after a fire, sits on the National Register of Historic Places since 1999.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Irvington%2C_New_York",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Across the tracks, the former Lord & Burnham factory now houses Bridge Street Properties, a mixed‑use complex with about 60 tenants.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Irvington%2C_New_York",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The Ardsley Historical Society preserves local heritage through a digital archive created in partnership with Advantage Archives.",
      "sourceSentenceIds": [
        20
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://communityhistoryarchives.com/places/ardsley-historical-society/",
      "category": "other",
      "quality": "poor",
      "qualityReason": "editorial_filler"
    },
    {
      "id": 6,
      "text": "Long‑time resident Anthony Radomski crafted leatherwork for Ardsley’s 100‑year celebration in 1996, a highlight of the town’s centennial.",
      "sourceSentenceIds": [
