  "facts": [
    {
      "id": 1,
      "text": "Parkville was originally part of the Gunpowder Falls area, settled in the 18th century by European immigrants drawn to its fertile land and proximity to Baltimore.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.trawellino.com/destinations/united-states/maryland_parkville"
    },
    {
      "id": 2,
      "text": "The Herring Run Park flows through Parkville, offering trails and green spaces along a historic stream once used for milling in the 19th century.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.trawellino.com/destinations/united-states/maryland_parkville"
    },
    {
      "id": 3,
      "text": "Amtrak and MARC trains serve Baltimore’s Penn Station, which is about a 15‑minute drive from Parkville.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.trawellino.com/destinations/united-states/maryland_parkville"
    },
    {
      "id": 4,
      "text": "Parkville homes tend to be older, with several historic neighborhoods that reflect the town’s early development.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://livinginmaryland.com/a-locals-guide-to-living-in-parkville-maryland/"
    },
    {
      "id": 5,
      "text": "The northern border of Parkville follows Interstate 695, the Baltimore Beltway, from Loch Raven Boulevard to Putty Hill Avenue.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Parkville%2C_Maryland"
    },
    {
      "id": 6,
      "text": "The eastern boundary of Parkville roughly follows Putty Hill Avenue as it becomes Rossville Boulevard, while the southern edge meets the Baltimore City line near Glen Road.",
      "sourceSentenceIds": [
