  "facts": [
    {
      "id": 1,
      "text": "Mount Holly Springs began industrial life in 1812 when Barbour, McClure, and Knox built the first mill along Mountain Creek.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://mhsboro.org/history/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Paper makers in the borough bought used rags and used Mountain Creek’s water both to power their machines and to clean the pulp.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://mhsboro.org/history/",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Later, the mills switched to Fourdrinier machines, the first U.S. models introduced around the same time as the industry grew.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://mhsboro.org/history/",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Even today, mineral springs still flow through the borough, though the old pavilions that once dispensed the water are now decaying.",
      "sourceSentenceIds": [
        18
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://mhsboro.org/history/",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "In the early 1900s, Mount Holly Park drew summer visitors to the area, making the borough a seasonal resort destination.",
      "sourceSentenceIds": [
        20
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://mhsboro.org/history/",
