  "facts": [
    {
      "id": 1,
      "text": "Twin Lakes sits on the Colville Reservation, about 8.5 miles west of Inchelium, Washington.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://colvillelakes.wsu.edu/twinlakesfact.html"
    },
    {
      "id": 2,
      "text": "North Twin Lake covers 917 acres while South Twin Lake spans 1,020 acres, both rising to 2,572 feet above sea level.",
      "sourceSentenceIds": [
        13
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://colvillelakes.wsu.edu/twinlakesfact.html"
    },
    {
      "id": 3,
      "text": "The lakes are mesotrophic, meaning they have an intermediate level of productivity that supports diverse fish species.",
      "sourceSentenceIds": [
        16
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://colvillelakes.wsu.edu/twinlakesfact.html"
    },
    {
      "id": 4,
      "text": "A native aquatic plant called watershield dominates the beds, covering about 68 acres in North Twin Lake and 19 acres in South Twin Lake.",
      "sourceSentenceIds": [
        21,
        22
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://colvillelakes.wsu.edu/twinlakesfact.html"
    },
    {
      "id": 5,
      "text": "Historically, a redband rainbow trout may have lived in Twin Lakes, but today hatchery coastal rainbow trout are the primary stock.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://colvillelakes.wsu.edu/twinlakesfact.html"
    },
    {
      "id": 6,
      "text": "The lakes’ outlet, Cornstalk Creek, flows east from North Twin Lake to the Columbia River at Inchelium.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Twin_Lakes%2C_Washington"
    }
  ]
