  "facts": [
    {
      "id": 1,
      "text": "Laurinburg, incorporated in 1877, traces its roots back to settlers arriving around 1785.",
      "sourceSentenceIds": [
        13,
        20
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.laurinburg.org/about-2/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Named after the McLaurin family, Laurinburg was originally spelled Laurinburgh and pronounced like Edinburgh.",
      "sourceSentenceIds": [
        3,
        5
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Laurinburg%2C_North_Carolina",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "A Wilmington, Charlotte and Rutherford Railroad line reached Laurinburg in 1861, and the town housed railroad shops moved there in 1865.",
      "sourceSentenceIds": [
        8,
        9
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Laurinburg%2C_North_Carolina",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Laurinburg Academy, founded in 1904 as the Laurinburg Normal Industrial Institute, was created by local black citizens after segregation.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Laurinburg%2C_North_Carolina",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Laurinburg High School, a private school, was established in 1852, making it one of the oldest schools in the state.",
      "sourceSentenceIds": [
        23
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Laurinburg%2C_North_Carolina",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Laurinburg’s Main Street is a historic landmark in itself, noted for its preserved architecture.",
