      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The Georgia General Assembly incorporated Kite in 1891, giving it official town status.",
      "sourceSentenceIds": [
        16
      ],
      "sourceLabels": [
