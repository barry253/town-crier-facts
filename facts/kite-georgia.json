      ],
      "source": "https://en.wikipedia.org/wiki/Kite%2C_Georgia",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Kite sits on the Little Ohoopee River, a gentle waterway that runs through Johnson County.",
      "sourceSentenceIds": [
        14
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Kite%2C_Georgia",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Route 221 cuts through Kite’s center as Montgomery Street, linking the town north to Bartow and south to Soperton.",
      "sourceSentenceIds": [
        18
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Kite%2C_Georgia",
