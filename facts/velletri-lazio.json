  "facts": [
    {
      "id": 1,
      "text": "Velletri’s name comes from the ancient Roman city Velitrae, reflected in Greek forms like Ουελιτρα and Βελιτρα.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Velletri",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "During the Middle Ages, Velletri boasted formidable castle walls with six gates, including Porta Fura and Porta Romana.",
      "sourceSentenceIds": [
        13
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Velletri",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "In May 1944, Velletri became a focal point of fighting after the Allied landings at Anzio during World War II.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Velletri",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Legend says the Volsci first clashed with Rome near Velletri under King Ancus Marcius, sparking early Roman Republic conflicts.",
      "sourceSentenceIds": [
        10,
        11
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Velletri",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The Oreste Nardini Civic Archeological Museum in Velletri showcases artifacts from protohistoric times through the medieval era.",
      "sourceSentenceIds": [
        15
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Velletri",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Helios Filme, founded in 1900, made Velletri a pioneer of Italian cinema, releasing films like Dante’s The Inferno in 1911.",
