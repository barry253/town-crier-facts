  "facts": [
    {
      "id": 1,
      "text": "Barada was named for Antoine (Antonine) Barada, a French‑Omaha trader who ran a post on the Nemaha Half‑Breed Reservation.",
      "sourceSentenceIds": [
        1,
        2,
        3
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1",
        "Web source 2"
      ],
      "source": "https://en.wikipedia.org/wiki/Barada%2C_Nebraska",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The village first appeared in the 1850s, emerging as one of the earliest settlements in northeast Richardson County.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/barada_nebraska",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Barada was officially incorporated as a village in 1927 after residents petitioned under Nebraska’s territorial statutes.",
      "sourceSentenceIds": [
        14
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Barada%2C_Nebraska",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The Big Nemaha River valley’s post‑glacial alluvium and loess layers create nutrient‑rich loams that support local farming.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/barada_nebraska",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Antoine Barada’s grave sits in the village’s Catholic cemetery, a tangible link to its founder.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/barada_nebraska",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "An ancient Indian Cave and a historic elm tree, possibly marked by Lewis and Clark, stand as cultural markers.",
