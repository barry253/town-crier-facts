  "facts": [
    {
      "id": 1,
      "text": "Chelmsford was founded by settlers from Woburn and Concord in 1652.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Chelmsford%2C_Massachusetts"
    },
    {
      "id": 2,
      "text": "An act of the Massachusetts General Court incorporated Chelmsford as a town in May 1655, naming it after Chelmsford, England.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Chelmsford%2C_Massachusetts"
    },
    {
      "id": 3,
      "text": "Daily freight trains run through Chelmsford on the historic Stony Brook Railroad, a reminder of the town’s rail heritage.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Chelmsford%2C_Massachusetts"
    },
    {
      "id": 4,
      "text": "The Chelmsford Public Library’s Local History Room houses a vast collection of books and documents about the town’s past, available by appointment.",
      "sourceSentenceIds": [
        8,
        9
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.chelmsfordlibrary.org/services/chelmsford-history"
    },
    {
      "id": 5,
      "text": "Pennacook leaders Passaconaway and Wonalancet maintained friendly ties with the early settlers who founded Chelmsford within their territory.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Chelmsford%2C_Massachusetts"
    },
    {
      "id": 6,
      "text": "The town’s early history includes the farming community of East Chelmsford, which later became Lowell, a pioneer of America’s Industrial Revolution.",
