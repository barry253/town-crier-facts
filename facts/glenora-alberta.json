  "facts": [
    {
      "id": 1,
      "text": "Glenora was named by Malcolm Groat for the west side of Groat Ravine, intended as a prestigious area.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.edmontonhistoricalboard.com/neighbourhoods/glenora/",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The neighborhood was protected by an early 1900s regulation, keeping it free of commercial or religious buildings and preserving its early estates.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.edmontonhistoricalboard.com/neighbourhoods/glenora/",
      "category": "other",
      "quality": "poor",
      "qualityReason": "other"
    },
    {
      "id": 3,
      "text": "Glenora hosts the City’s highest concentration of historic resources, with nearly 140 buildings listed after a 2015‑2017 study.",
      "sourceSentenceIds": [
        13,
        14
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.canadashistory.ca/explore/historic-sites/glenora-neighbourhood",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The 1912 Tudor‑Revival C.W. Cross Residence remains a standout example of early 20th‑century architecture in Glenora.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.edmontonhistoricalboard.com/neighbourhoods/glenora/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The Glenora Substation‑650 on Stony Plain Road is a prominent landmark that once powered the neighborhood’s early growth.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.edmontonhistoricalboard.com/neighbourhoods/glenora/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Glenora’s first school was a pair of temporary buildings moved from Westmount in 1918, reflecting the community’s early educational needs.",
      "sourceSentenceIds": [
        2
      ],
