        8
      ],
      "sourceLabels": [
        "Web source 2",
        "Wikipedia"
      ],
      "source": "https://www.britannica.com/place/Shelbyville-Indiana",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Shelby County Public Library’s main branch in Shelbyville opened in 1905 and remains a historic landmark.",
      "sourceSentenceIds": [
