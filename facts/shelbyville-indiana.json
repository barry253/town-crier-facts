      "id": 1,
      "text": "Shelbyville was named for Revolutionary War hero Isaac Shelby, the first governor of Kentucky.",
      "sourceSentenceIds": [
        4,
        6
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 2"
      ],
