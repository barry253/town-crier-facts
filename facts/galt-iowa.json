  "facts": [
    {
      "id": 1,
      "text": "Galt was originally platted as Norwich in 1881 by the Cedar Rapids, Iowa Falls, and Northwestern Land and Town Lot Company.",
      "sourceSentenceIds": [
        24
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://iagenweb.org/wright/Histories/Galthistory_files/Galthistory.htm",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town incorporated as Galt on January 6, 1913, formalizing its status after decades of growth.",
      "sourceSentenceIds": [
        26
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://iagenweb.org/wright/Histories/Galthistory_files/Galthistory.htm",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Postal officials authorized a post office in January 1882, stipulating it be called Galtville before it was renamed Galt.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://iagenweb.org/wright/Histories/Galthistory_files/Galthistory.htm",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Railroad tracks were spiked through the infant hamlet in autumn 1880, linking Galt to regional trade routes.",
      "sourceSentenceIds": [
        25
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://iagenweb.org/wright/Histories/Galthistory_files/Galthistory.htm",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "In the early 20th century, Galt thrived as a trading and commercial center, a far cry from its quiet present.",
      "sourceSentenceIds": [
        29
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://iagenweb.org/wright/Histories/Galthistory_files/Galthistory.htm",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "By the 1920s, Galt housed the Pascoe Mercantile Company, a general merchandise store that served local farmers and travelers.",
