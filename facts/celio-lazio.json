  "facts": [
    {
      "id": 1,
      "text": "Celio takes its name from the ancient Caelian Hill, one of Rome’s original seven hills.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://renatoprosciutto.com/celio-district-rome/",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The rione’s coat of arms shows an African bust wearing an elephant headdress, recalling a statue found in Via Capo d’Africa.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Celio_(rione_of_Rome)",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Between 1885 and 1891, a military hospital was built atop Caelian Hill, near the medieval Santo Stefano in Formis.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Celio_(rione_of_Rome)",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Celio became an official rione in 1921, separating land from Monti and Campitelli.",
      "sourceSentenceIds": [
        11
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Celio_(rione_of_Rome)",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Rome’s newer Line C metro cuts through Celio, linking Colosseo and Porta Metronia stations.",
      "sourceSentenceIds": [
        24
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Celio_(rione_of_Rome)",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Tourists flock to Celio for the Colosseum and the Arch of Constantine, both lying within its borders.",
      "sourceSentenceIds": [
        29
