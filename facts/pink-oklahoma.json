  "facts": [
    {
      "id": 1,
      "text": "Oral history suggests that the town of Pink was named in honor of a local resident named Pink.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Pink%2C_Oklahoma"
    },
    {
      "id": 2,
      "text": "Pink emerged after the Iowa, Sac and Fox, Citizen Band Potawatomi, and Absentee Shawnee lands opened in September 1891.",
      "sourceSentenceIds": [
        25
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.okhistory.org/publications/enc/entry?entry=PI010"
    },
    {
      "id": 3,
      "text": "The easternmost allotments of the Big Jim Band of Absentee Shawnee were located in what is now Pink.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Pink%2C_Oklahoma"
    },
    {
      "id": 4,
      "text": "Pink has served as a hub for local agriculturists throughout the town's history.",
      "sourceSentenceIds": [
        26
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.okhistory.org/publications/enc/entry?entry=PI010"
    },
    {
      "id": 5,
      "text": "Railroads never came closer than ten miles to Pink, which limited the town's importance during the railroad era.",
      "sourceSentenceIds": [
        19
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Pink%2C_Oklahoma"
    },
    {
      "id": 6,
      "text": "The Nellie McCoy Nature Reserve in Pink protects Cross Timbers flora and fauna along with Native American and pioneer history.",
      "sourceSentenceIds": [
