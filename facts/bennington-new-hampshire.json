  "facts": [
    {
      "id": 1,
      "text": "Bennington was named to honor the 1777 Battle of Bennington, a Revolutionary War clash fought near Vermont.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Bennington%2C_New_Hampshire"
    },
    {
      "id": 2,
      "text": "A paper‑making factory opened in 1835 at the site of today’s Monadnock Paper Mill, sparking the town’s industrial boom.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Bennington%2C_New_Hampshire"
    },
    {
      "id": 3,
      "text": "Bennington emerged from former lands of Deering, Francestown, Greenfield and Hancock, officially becoming a town in 1842.",
      "sourceSentenceIds": [
        4,
        15
      ],
      "sourceLabels": [
        "Web source 1",
        "Wikipedia"
      ],
      "source": "https://townofbennington.com/history/"
    },
    {
      "id": 4,
      "text": "In 1874 plans were underway to route the Peterborough and Hillsborough railroad through Bennington, linking it to regional trade.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Bennington%2C_New_Hampshire"
    },
    {
      "id": 5,
      "text": "The Contoocook River drops 70 feet over just 1.2 miles in Bennington, powering historic mills for generations.",
      "sourceSentenceIds": [
        16
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Bennington%2C_New_Hampshire"
    },
    {
      "id": 6,
      "text": "Bennington’s first gristmill appeared in 1782, followed by a cotton mill in 1810, marking the town’s early industrial roots.",
      "sourceSentenceIds": [
        17
      ],
