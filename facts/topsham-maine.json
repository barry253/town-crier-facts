  "facts": [
    {
      "id": 1,
      "text": "Topsham was incorporated in 1764, named after Topsham in Devon, England, after a sawmill built in 1716 on the Cathance River.",
      "sourceSentenceIds": [
        1,
        3,
        24
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 2"
      ],
      "source": "https://en.wikipedia.org/wiki/Topsham%2C_Maine",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town’s early economy boomed between 1798 and 1812, with shipping and shipbuilding thriving along the Androscoggin and Cathance Rivers.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://topshamlibrary.org/topsham-history/",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "A 1936 flood forced the Androscoggin to flow through the lower levels of the Pejepscot Mill, damaging the pedestrian Swing Bridge.",
      "sourceSentenceIds": [
        30
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Topsham%2C_Maine",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The Maine Feldspar Company, located near Elm Street’s railroad tracks, processed 40 tons of spar daily and employed 75 workers in the early 20th century.",
      "sourceSentenceIds": [
        14
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://topshamlibrary.org/topsham-history/",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Topsham’s annual fair, first erected in 1856 by the Sagadahoc Agricultural & Horticultural Society, still hosts the town’s historic fairgrounds.",
      "sourceSentenceIds": [
        27
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Topsham%2C_Maine",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The town’s library, part of the Pejepscot Historical Society, preserves local history and serves as a community hub.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
