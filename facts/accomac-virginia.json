  "facts": [
    {
      "id": 1,
      "text": "Accomac was originally called Drummondtown, named after landowner Richard Drummond, when the Virginia House of Delegates incorporated it in 1786.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.accomac.org/overview",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town’s brick courthouse, built in 1756, still houses court records dating back to 1663 and a Revolutionary War cannon.",
      "sourceSentenceIds": [
        20,
        11
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Accomac%2C_Virginia",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Accomac’s streets—Front, Back, Cross, and South—were lined in the early 1800s with hotels, stores, and a tannery, showing a bustling 19th‑century economy.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.accomac.org/overview",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "During the Civil War, Union General Henry Lockwood occupied Accomac without bloodshed, preserving the town’s buildings and property.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.accomac.org/overview",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The arrival of the railroad in the late 1800s brought steady prosperity, prompting new Victorian homes that still line Accomac’s historic core.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Accomac%2C_Virginia",
      "category": "history",
      "quality": "good"
    }
