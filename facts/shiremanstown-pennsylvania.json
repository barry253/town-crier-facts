  "facts": [
    {
      "id": 1,
      "text": "Shiremanstown was named after Daniel Shireman, a German butcher who settled there in the 18th century.",
      "sourceSentenceIds": [
        1,
        7
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Shiremanstown%2C_Pennsylvania"
    },
    {
      "id": 2,
      "text": "The borough incorporated in 1864, after growing from a community that once belonged to Lower Allen Township.",
      "sourceSentenceIds": [
        2,
        8
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Shiremanstown%2C_Pennsylvania"
    },
    {
      "id": 3,
      "text": "A German Reformed church and school appeared near Shiremanstown before 1797, later becoming the historic Peace Church.",
      "sourceSentenceIds": [
        11,
        12
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Shiremanstown%2C_Pennsylvania"
    },
    {
      "id": 4,
      "text": "St. John's Evangelical Lutheran Church, now on Main Street, traces its roots back to a 1908 fire that prompted a new building.",
      "sourceSentenceIds": [
        16,
        17,
        18
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Shiremanstown%2C_Pennsylvania"
    },
    {
      "id": 5,
      "text": "Shiremanstown sits 6 miles southwest of Harrisburg, the state capital, and is part of the Harrisburg–Carlisle Metropolitan Statistical Area.",
      "sourceSentenceIds": [
        21,
        6
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Shiremanstown%2C_Pennsylvania"
    },
    {
      "id": 6,
      "text": "The borough borders Hampden Township to the north and Lower Allen Township to the south, framing its small geographic footprint.",
