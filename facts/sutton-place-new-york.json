  "facts": [
    {
      "id": 1,
      "text": "Sutton Place began as a stretch of Avenue A, added in 1811 to fill the north–south gap east of First Avenue.",
      "sourceSentenceIds": [
        28,
        29
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Sutton_Place%2C_Manhattan",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "On Sutton Place South, building numbers climb as you head south, the only Manhattan street where addresses increase that way.",
      "sourceSentenceIds": [
        21,
        20,
        22
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Sutton_Place%2C_Manhattan",
      "category": "landmark",
      "quality": "poor",
      "qualityReason": "editorial_filler"
    },
    {
      "id": 3,
      "text": "The Sutton Place Historic District, listed on the National Register, preserves early 20th‑century townhouses that once housed Elsie de Wolfe and Anne Harriman Vanderbilt.",
      "sourceSentenceIds": [
        23,
        8
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Sutton_Place%2C_Manhattan",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "One Sutton Place South, a neo‑Georgian apartment building by Rosario Candela, sits behind an iron fence that borders Sutton Place Park.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Sutton_Place%2C_Manhattan",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "In 1928, the block north of 59th Street was renamed York Avenue to honor a U.S. president, a rare street‑renaming in Manhattan.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Sutton_Place%2C_Manhattan",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The 1920s saw Sutton Place reborn as a haven for influential women, including Anne Harriman Vanderbilt and Anne Morgan, who helped shape its elite reputation.",
      "sourceSentenceIds": [
        9
      ],
