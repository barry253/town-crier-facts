  "facts": [
    {
      "id": 1,
      "text": "Artesia was named after artesian wells discovered in 1903, giving the city its water‑powered heritage.",
      "sourceSentenceIds": [
        22
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Artesia%2C_New_Mexico"
    },
    {
      "id": 2,
      "text": "The Artesia Historical Museum and Art Center, along with the library dubbed New Mexico’s Most Beautiful Library, preserve the town’s story.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://artesiachamber.com/explore/"
    },
    {
      "id": 3,
      "text": "In 1932, the Ocotillo theater opened, later renovated in 2008 to host touring performers and community events.",
      "sourceSentenceIds": [
        18
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://artesiachamber.com/explore/"
    },
    {
      "id": 4,
      "text": "Artesia’s Heritage Walkway showcases murals and tile work that chronicle the town’s past, while bronze statues along Main Street add a visual timeline.",
      "sourceSentenceIds": [
        13,
        14
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://artesiachamber.com/explore/"
    },
    {
      "id": 5,
      "text": "The city hosts one of only two Strangite meeting places worldwide, a rare religious landmark.",
      "sourceSentenceIds": [
        24
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Artesia%2C_New_Mexico"
    },
    {
      "id": 6,
      "text": "Artesia’s high‑voltage direct‑current back‑to‑back station links eastern and western electric grids, a unique energy hub.",
      "sourceSentenceIds": [
        17
