  "facts": [
    {
      "id": 1,
      "text": "Rentiesville was founded in 1903 as an all-Black town on land owned by William Rentie and Phoebe McIntosh.",
      "sourceSentenceIds": [
        10,
        12
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Rentiesville%2C_Oklahoma"
    },
    {
      "id": 2,
      "text": "Rentiesville is one of the last surviving examples of the all-Black towns that emerged in Oklahoma during the early twentieth century.",
      "sourceSentenceIds": [
        13
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://okcivilrightstrail.com/history-of-rentiesville/"
    },
    {
      "id": 3,
      "text": "Historian John Hope Franklin, one of the most influential scholars of African American history, was born in Rentiesville.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://okcivilrightstrail.com/history-of-rentiesville/"
    },
    {
      "id": 4,
      "text": "The Honey Springs Battlefield, listed on the National Register of Historic Places, is located within the Rentiesville town limits.",
      "sourceSentenceIds": [
        20
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Rentiesville%2C_Oklahoma"
    },
    {
      "id": 5,
      "text": "Blues singer Minner was born in Rentiesville and co-founded the Down Home Blues Club and the annual Dusk Til Dawn Blues Festival.",
      "sourceSentenceIds": [
        11,
        17
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Rentiesville%2C_Oklahoma"
    },
    {
      "id": 6,
      "text": "Rentiesville became a flag stop on the Missouri–Kansas–Texas Railroad after its post office opened in 1904.",
      "sourceSentenceIds": [
        21
