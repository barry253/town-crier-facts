      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Kealakekua Bay is the first European landing site in Hawaii, where Captain James Cook anchored in 1779.",
      "sourceSentenceIds": [
        17
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://bigislandguide.com/kealakekua-bay",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Settled over a thousand years ago, the bay contains heiaus and traditional Hawaiian temples that reveal ancient spiritual life.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://bigalohaguide.com/places/kealakekua-bay-historical-district",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Kealakekua Bay blends sacred history with modern ocean recreation, making it a unique place where culture and nature intersect.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://bigalohaguide.com/places/kealakekua-bay-historical-district",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Kayakers paddle across the bay's calm surface, gaining views of historical sites that dot its shores.",
      "sourceSentenceIds": [
        11
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://bigalohaguide.com/places/kealakekua-bay-historical-district",
      "category": "culture",
      "quality": "good"
    },
    {
