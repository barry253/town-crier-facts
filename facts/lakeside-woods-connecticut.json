      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Off Birchwood Avenue, the preserved remains of a 19th‑century fishing cabin offer a glimpse into Lakeside Woods' early maritime past.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 2"
      ],
