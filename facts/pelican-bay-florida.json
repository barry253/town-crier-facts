  "facts": [
    {
      "id": 1,
      "text": "Pelican Bay was originally called Clam Bay before 1974, when the name changed to honor its abundant wildlife.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/pelican_bay_florida",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The community’s roots trace back to the early 1970s, when Coral Ridge Properties and the Barron Collier family developed 2,330 acres of land.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/pelican_bay_florida",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "From the start, planners set aside mangroves, wetlands, and open space, and in 1982 the local mangrove forest became a protected natural resource area.",
      "sourceSentenceIds": [
        24
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/pelican_bay_florida",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The Pelican Bay Foundation, the master homeowners’ association, maintains the common areas, keeping the community’s ecology and amenities in balance.",
      "sourceSentenceIds": [
        25
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/pelican_bay_florida",
      "category": "other",
      "quality": "poor",
      "qualityReason": "other"
    },
    {
      "id": 5,
      "text": "Pelican Bay is part of the Naples–Marco Island Metropolitan Statistical Area.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Pelican_Bay%2C_Florida",
      "category": "other",
      "quality": "poor",
      "qualityReason": "location_description"
    },
    {
      "id": 6,
      "text": "Geographically, Pelican Bay sits west of the Gulf of Mexico, north of Vanderbilt Beach Road, south of Naples, and east of U.S. 41 the Tamiami Trail.",
      "sourceSentenceIds": [
