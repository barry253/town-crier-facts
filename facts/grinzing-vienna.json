  "facts": [
    {
      "id": 1,
      "text": "Grinzing’s name means 'of the people who belong to a man named Grinzo,' first recorded as Grinzigan in 1114.",
      "sourceSentenceIds": [
        1,
        24
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Grinzing",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The Trummelhof court sits atop Roman ruins, showing Grinzing’s history stretches back to antiquity.",
      "sourceSentenceIds": [
        2,
        10
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Grinzing",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Vineyards have thrived for centuries, especially on the Reisenberg and Hungerberg hills, making Grinzing a historic wine village.",
      "sourceSentenceIds": [
        11,
        22
      ],
      "sourceLabels": [
        "Web source 1",
        "Wikipedia"
      ],
      "source": "https://www.grinzland.com/",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Composers like Beethoven, Schubert, and Mahler, and thinkers such as Einstein and Freud, have lived or visited Grinzing, leaving cultural echoes.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.grinzland.com/",
      "category": "people",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "A brewery founded in the Trummelhof in 1814 produced beer intermittently until 1831, adding to the village’s artisanal heritage.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Grinzing",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Until the 19th century, Grinzing fell under the authority of Klosterneuburg Monastery, shaping its medieval development.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
