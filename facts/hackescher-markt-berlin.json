  "facts": [
    {
      "id": 1,
      "text": "Hackescher Markt was named after Count Hans Christoph Friedrich Graf von Hacke, who turned a swamp into a market square in 1750.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Hackescher_Markt",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "In 1821 an association for Jewish culture and science was founded on the square, marking early Jewish intellectual life.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.hackesche-hoefe.de/en/story/hackescher-markt-its-history-and-how-it-got-its-name-1008",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The Art Nouveau Hackesche Höfe courtyard, with August Endell’s glazed tiles, opened its first courtyard in 1906 and still hosts cinema and restaurants.",
      "sourceSentenceIds": [
        6,
        15
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.travel2berlin.com/post/hackescher-markt-where-berlin-s-history-meets-its-restless-present",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Every Thursday and Saturday a weekly market continues the square’s trading tradition, echoing its origins as a bustling marketplace.",
