  "facts": [
    {
      "id": 1,
      "text": "Coffman Cove began as a logging camp in the 1950s, laying the groundwork for the community that would later become a city.",
      "sourceSentenceIds": [
        30
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://discoverpowisland.com/communities/coffman-cove/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town officially incorporated as a city in 1989, marking its transition from a small logging settlement to a recognized municipality.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Coffman_Cove%2C_Alaska",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Coffman Cove sits along the Inside Passage on the east side of Prince of Wales Island, a key maritime corridor in Southeast Alaska.",
      "sourceSentenceIds": [
        29
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://discoverpowisland.com/communities/coffman-cove/",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The area is a temperate rainforest, receiving high precipitation and enjoying mild summers while experiencing cold winters typical of the region.",
      "sourceSentenceIds": [
        22
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Coffman_Cove%2C_Alaska",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Scheduled float‑plane service, including flights by Taquan Air, connects Coffman Cove to other island communities and mainland destinations.",
      "sourceSentenceIds": [
        23,
        24
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Coffman_Cove%2C_Alaska",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Ferry service to Coffman Cove was suspended in 2009, but by 2020 the Alaska Marine Hi‑way restored connections from Bellingham and Prince Rupert via Ketchikan.",
