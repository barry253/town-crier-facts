  "facts": [
    {
      "id": 1,
      "text": "Darragh is an unincorporated community in Hempfield Township, Westmoreland County, Pennsylvania.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Darragh%2C_Pennsylvania"
    },
    {
      "id": 2,
      "text": "Originally a coal town, Darragh sits along Pennsylvania Route 136, just one mile west of Arona.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Darragh%2C_Pennsylvania"
    },
    {
      "id": 3,
      "text": "The town became the hub for Keystone Coal and Coke’s operations near Little Sewickley Creek.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Darragh%2C_Pennsylvania"
    },
    {
      "id": 4,
      "text": "Its mines—Madison, Arona, Sewickley, and Keystone Shaft—employed about 1,000 people at their peak.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Darragh%2C_Pennsylvania"
    },
    {
      "id": 5,
      "text": "By 1925 the Madison, Arona and Sewickley mines had shut down, ending a major era of local coal mining.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Darragh%2C_Pennsylvania"
    },
    {
      "id": 6,
      "text": "The Keystone Shaft mine closed in the mid‑1930s, and by 1938 Keystone Coal and Coke had withdrawn from Darragh.",
      "sourceSentenceIds": [
        8,
        9
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Darragh%2C_Pennsylvania"
    }
  ]
