  "facts": [
    {
      "id": 1,
      "text": "Copperas Cove grew from a 1870s ranching community to the largest city in Coryell County, now home to more than 30,000 residents.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.copperascovetx.gov/269/About-Copperas-Cove",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "When the Gulf, Colorado and Santa Fe Railway arrived in 1882, it redesigned the town’s streets and turned the depot into a key shipping point for local farmers.",
      "sourceSentenceIds": [
        22,
        23,
        24
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Copperas_Cove%2C_Texas",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "In 1942 the U.S. government built Camp Hood next to Copperas Cove, giving the struggling town a new lifeline during the Great Depression.",
      "sourceSentenceIds": [
        30
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Copperas_Cove%2C_Texas",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The town’s first post office opened in March 1879 with Marsden Ogletree as postmaster, and the original building still hosts the Ogletree Gap Heritage Festival.",
      "sourceSentenceIds": [
        20,
        21
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Copperas_Cove%2C_Texas",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Every year the town celebrates its pioneer roots at the Ogletree Gap Heritage Festival, an event held in the historic post office building.",
      "sourceSentenceIds": [
        21,
