  "facts": [
    {
      "id": 1,
      "text": "Freeland earned its name from a 1900 socialist commune that called the land “free for all people.”.",
      "sourceSentenceIds": [
        9,
        10,
        13
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Freeland%2C_Washington"
    },
    {
      "id": 2,
      "text": "The town sits on a mile‑wide isthmus between Holmes Harbor and Mutiny Bay, flanked by Saratoga Passage and Admiralty Inlet.",
      "sourceSentenceIds": [
        21
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Freeland%2C_Washington"
    },
    {
      "id": 3,
      "text": "Freeland’s founders, led by George Washington Daniels, plotted five‑acre lots with wide streets to create a cooperative community.",
      "sourceSentenceIds": [
        15
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Freeland%2C_Washington"
    },
    {
      "id": 4,
      "text": "In 1902 the colony shifted from share‑based land purchases to outright sales when the dividend plan failed.",
      "sourceSentenceIds": [
        14
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Freeland%2C_Washington"
    },
    {
      "id": 5,
      "text": "Freeland Hall, built in the early 1900s, hosted dances, club meetings, and community events for generations.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://freelandchamber.org/explore-freeland/historic-freeland/"
    },
    {
      "id": 6,
      "text": "Freeland is located at the head of Holmes Harbor, 17 miles south of Coupeville on South Whidbey Island.",
