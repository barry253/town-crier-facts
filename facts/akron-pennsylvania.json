    },
    {
      "id": 2,
      "text": "At one time, more than 50 cigar “factories” dotted Akron, many hidden in back rooms of private homes.",
      "sourceSentenceIds": [
        4,
        5
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.akron-pa.com/akron-community/our-history"
    },
    {
      "id": 3,
      "text": "The Miller Hess Shoe Company dominated Akron’s economy from the early 1900s until it closed its doors in 1985.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.akron-pa.com/akron-community/our-history"
    },
    {
      "id": 4,
      "text": "One of Akron’s oldest structures is a log cabin built in 1724, predating George Washington by eight years.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Web source 1"
      ],
