  "facts": [
    {
      "id": 1,
      "text": "In 1886, discovery of natural gas in Delaware County sparked a boom that forever changed Muncie.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://destinationmuncie.org/a-walk-through-historic-muncie-landmarks/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Muncie’s Carnegie Library, built in 1902 and funded by Andrew Carnegie, still houses a Local History and Genealogy Collection.",
      "sourceSentenceIds": [
        2,
        26
      ],
      "sourceLabels": [
        "Web source 2",
        "Web source 2"
      ],
      "source": "https://destinationmuncie.org/a-walk-through-historic-muncie-landmarks/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The former Muncie Masonic Temple, now Cornerstone Center for the Arts, celebrated 100 years in 2026 and stands as a six‑story Gothic Revival landmark.",
      "sourceSentenceIds": [
        17
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://destinationmuncie.org/a-walk-through-historic-muncie-landmarks/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Minnetrista Museum & Gardens preserves the legacy of the Ball sisters’ 1894 home on the White River, now a cultural center.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://destinationmuncie.org/a-walk-through-historic-muncie-landmarks/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Muncie’s industrial profile by WWII was “jars and cars,” with General Motors making transmissions and batteries and the Ball family’s jar factories.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://muncieparks.com/history-and-background/",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The Emily Kimbrough Historic District, named after the Hoosier author, showcases late Victorian homes and was designated a historic district in 1976.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
