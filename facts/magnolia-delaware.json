  "facts": [
    {
      "id": 1,
      "text": "Magnolia was originally known as Caroon Manor when the land was first given by the Duke of York.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Magnolia%2C_Delaware"
    },
    {
      "id": 2,
      "text": "The town of Magnolia was named for the Duke of York's favorite tree, the magnolia.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Magnolia%2C_Delaware"
    },
    {
      "id": 3,
      "text": "Magnolia was founded about a mile from the river to keep inhabitants close to the water but away from swarming mosquitoes.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.islands.com/1937900/magnolia-delaware-most-eccentric-towns-offers-odd-landmarks-historic-sites-iconic-restaurant/"
    },
    {
      "id": 4,
      "text": "Founders gave Magnolia a circular boundary to represent brotherhood, and the town still retains these original boundaries today.",
      "sourceSentenceIds": [
        18,
        20
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Magnolia%2C_Delaware"
    },
    {
      "id": 5,
      "text": "A sign at the Lindale House claims that Magnolia is the center of the universe around which the Earth revolves.",
      "sourceSentenceIds": [
        21
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Magnolia%2C_Delaware"
    },
    {
      "id": 6,
      "text": "Quakers left a lasting mark on Magnolia, including the historic Murderkill Friends Burial Ground.",
      "sourceSentenceIds": [
