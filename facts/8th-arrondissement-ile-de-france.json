      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The Arc de Triomphe, a monumental gateway, dominates the western end of the Champs‑Élysées within the 8th arrondissement.",
      "sourceSentenceIds": [
        11
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/8th_arrondissement_of_Paris",
      "category": "landmark",
      "quality": "good"
    },
    {
