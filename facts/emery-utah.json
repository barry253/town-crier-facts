    },
    {
      "id": 2,
      "text": "North Horn Formation near Emery holds Cretaceous fossils, including microfossils and palynomorphs that reveal ancient life.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Emery%2C_Utah"
    },
    {
      "id": 3,
      "text": "North of Emery, Flagstaff Peak preserves dinosaur footprints and bone material, a window into prehistoric life.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Emery%2C_Utah"
    },
    {
      "id": 4,
      "text": "Two Fremont culture sites flank Emery, where pottery, manos, and metates show a distinct pre‑Columbian way of life.",
