    },
    {
      "id": 2,
      "text": "Its mission is to give residents and visitors a dynamic space that sparks curiosity about local and global history.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.ahpd.org/arlington-heights-historical-museum/"
    },
    {
      "id": 3,
      "text": "Walking down Olympic and West Avenue feels like stepping into a place you’ve always known.",
      "sourceSentenceIds": [
        4
