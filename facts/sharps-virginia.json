  "facts": [
    {
      "id": 1,
      "text": "Sharp's Island sits in the James River, part of a unique archipelago just west of the 14th Street Bridge.",
      "sourceSentenceIds": [
        17
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://richmond.com/from-the-archives/collection_1ee127f8-6be0-11e7-a4c0-df249432e44c.html"
    },
    {
      "id": 2,
      "text": "In the 1950s, families called Sharp's Island home, strolling by boat and enjoying river life.",
      "sourceSentenceIds": [
        19
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://richmond.com/from-the-archives/collection_1ee127f8-6be0-11e7-a4c0-df249432e44c.html"
    },
    {
      "id": 3,
      "text": "A house built around 1895 on the island was destroyed by a 1963 flood, leaving only ashes behind.",
      "sourceSentenceIds": [
        22,
        23
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://richmond.com/from-the-archives/collection_1ee127f8-6be0-11e7-a4c0-df249432e44c.html"
    },
    {
      "id": 4,
      "text": "Architect Henry Tenser Jr. bought Sharp's Island in 1970, turning it into a private retreat.",
      "sourceSentenceIds": [
        21
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://richmond.com/from-the-archives/collection_1ee127f8-6be0-11e7-a4c0-df249432e44c.html"
    },
    {
      "id": 5,
      "text": "The island first entered the historical record on New Year’s Eve 1853, marking the start of its documented past.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.richmonder.org/i-bought-an-island-on-the-james-river-then-i-learned-its-history/"
    },
    {
      "id": 6,
      "text": "Historically, Sharp's Island hosted spring shad fishing and granite quarrying for bridge construction.",
