  "facts": [
    {
      "id": 1,
      "text": "West Haven-Sylvan was originally part of the traditional territory of the Atfalati band of the Kalapuya people.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/west_haven_sylvan_oregon"
    },
    {
      "id": 2,
      "text": "The name Sylvan comes from Silvanus, the Roman deity of the woods, to avoid confusion with other Oregon post offices.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/West_Haven-Sylvan%2C_Oregon"
    },
    {
      "id": 3,
      "text": "Pioneer Jones settled at the head of Tanner Creek in 1847 and dreamed of making his community the capital of Oregon.",
      "sourceSentenceIds": [
        13,
        15
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/West_Haven-Sylvan%2C_Oregon"
    },
    {
      "id": 4,
      "text": "West Haven-Sylvan is located along the eastern edge of Washington County, with a small portion extending into Multnomah County.",
      "sourceSentenceIds": [
        17
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/West_Haven-Sylvan%2C_Oregon"
    },
    {
      "id": 5,
      "text": "Steep slopes exceeding twenty percent occur along ravines and creeks, contributing to the scenic, undulating terrain of West Haven-Sylvan.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/west_haven_sylvan_oregon"
    },
    {
