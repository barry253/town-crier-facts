  "facts": [
    {
      "id": 1,
      "text": "Moreland got its name when an LDS apostle, standing on a buggy seat, declared, 'This is more land, and we'll make a settlement.'.",
      "sourceSentenceIds": [
        16
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://jacobbarlow.com/2023/04/28/moreland-settlement/",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Early settlers in Moreland came from England and Scandinavian countries, bringing diverse cultural roots to the flat sagebrush plains.",
      "sourceSentenceIds": [
        18
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://jacobbarlow.com/2023/04/28/moreland-settlement/",
      "category": "people",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "On November 17, 1894, Herbert Brown and John England plowed the first furrow of the People’s Canal, diverting Snake River water into the valley.",
      "sourceSentenceIds": [
        20
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://jacobbarlow.com/2023/04/28/moreland-settlement/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Hyrum Grimmett became Moreland’s first postmaster, operating the post office out of his own home.",
      "sourceSentenceIds": [
        21
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://jacobbarlow.com/2023/04/28/moreland-settlement/",
      "category": "people",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "In the fall of 1893, Josiah Draper built the town’s first log house, marking the start of permanent structures.",
      "sourceSentenceIds": [
        23
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://jacobbarlow.com/2023/04/28/moreland-settlement/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The first meeting house, erected in 1896, doubled as a school with Hyrum Gimmett teaching the children.",
      "sourceSentenceIds": [
        24
      ],
