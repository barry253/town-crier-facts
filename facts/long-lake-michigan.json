      ],
      "source": "https://www.longlakeassociation.website/history-of-long-lake",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The Ramona Palace Ballroom, finished in the 1930s, hosted dancing and big‑band music for Midwestern crowds.",
      "sourceSentenceIds": [
        18
      ],
      "sourceLabels": [
