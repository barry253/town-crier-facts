      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Rowland Ellis named his farm Bryn Mawr, meaning “great hill” in Welsh, after his Merionethshire home in England.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 1"
