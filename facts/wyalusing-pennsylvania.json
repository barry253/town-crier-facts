  "facts": [
    {
      "id": 1,
      "text": "Wyalusing’s name comes from the Native American word “M’chwihilusing,” meaning “home of the honorable warrior,” later anglicized to Wyalusing.",
      "sourceSentenceIds": [
        6,
        8
      ],
      "sourceLabels": [
        "Web source 1",
        "Wikipedia"
      ],
      "source": "https://wyalusingborough.com/history/",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "In 1765, Moravian pacifists founded Friedenshütten, a settlement of tents called “Cabins of Peace,” on the site that would become Wyalusing.",
      "sourceSentenceIds": [
        1,
        7
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Wyalusing%2C_Pennsylvania",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The town sits where Wyalusing Creek meets the Susquehanna River, overlooking Browntown Mountain and the famous Wyalusing Rocks.",
      "sourceSentenceIds": [
        16,
        10
      ],
      "sourceLabels": [
        "Web source 1",
        "Wikipedia"
      ],
      "source": "https://wyalusingborough.com/history/",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "A railroad built in the mid‑1880s turned Wyalusing into a key shipping point for livestock, grain, lumber, and flagstone.",
      "sourceSentenceIds": [
        17
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://wyalusingborough.com/history/",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Wyalusing became an official borough in 1887, and many of its Main Street buildings date from the late 19th and early 1920s.",
      "sourceSentenceIds": [
        28,
        29
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Wyalusing%2C_Pennsylvania",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The local library and the Wyalusing Valley Museum, both on Route 6, preserve the borough’s rich history for visitors and residents alike.",
      "sourceSentenceIds": [
        21
      ],
