  "facts": [
    {
      "id": 1,
      "text": "Belcourt is named after Father Belcourt, a French‑Canadian missionary who served the Chippewa in the mid‑nineteenth century.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Belcourt%2C_North_Dakota",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Belcourt was originally called Siipiising, Anishinaabe for 'creek that sings with life‑giving water' and was known to Europeans as Ox Creek.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Belcourt%2C_North_Dakota",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The community serves as the seat of the Turtle Mountain Band of Chippewa Indians.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Belcourt%2C_North_Dakota",
      "category": "other",
      "quality": "poor",
      "qualityReason": "vague"
    },
    {
      "id": 4,
      "text": "Belcourt hosts Turtle Mountain Community College and the Turtle Mountain Chippewa Indian Heritage Center, showcasing blended Indigenous‑French heritage.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/belcourt_north_dakota",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "KEYA, a tribal radio station at 88.5 FM, broadcasts from Belcourt and serves the reservation community.",
      "sourceSentenceIds": [
        18
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Belcourt%2C_North_Dakota",
      "category": "other",
      "quality": "poor",
      "qualityReason": "vague"
    },
    {
      "id": 6,
      "text": "In 1882, a federal order reserved 720 square miles for the Turtle Mountain Band, creating a homeland for its members.",
      "sourceSentenceIds": [
        13
