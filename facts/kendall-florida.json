      "quality": "good"
    },
    {
      "id": 2,
      "text": "The first public school in Kendall opened in 1929, originally called Kendall School and now known as Kenwood K‑8 Center.",
      "sourceSentenceIds": [
        1,
        16
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
