      "category": "culture",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Hutchinson Technology Incorporated, founded in 1965 in a repurposed chicken coop, grew into a major disk‑drive component manufacturer with 7,701 employees by 2000.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
