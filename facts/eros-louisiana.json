  "facts": [
    {
      "id": 1,
      "text": "Eros, Louisiana, began as a company town when the Tremont Lumber Company built a sawmill there in 1898.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/eros_louisiana"
    },
    {
      "id": 2,
      "text": "The town’s name comes from the 433rd asteroid, Eros, chosen by Mary Collins who loved astronomy.",
      "sourceSentenceIds": [
        4,
        7
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Eros%2C_Louisiana"
    },
    {
      "id": 3,
      "text": "Eros served as a central hub for surrounding rural communities, offering a post office, hotels, and the parish’s first high school.",
      "sourceSentenceIds": [
        23,
        20
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Eros%2C_Louisiana"
    },
    {
      "id": 4,
      "text": "A 1920 cyclone destroyed the original sawmill, prompting a rebuild that only lasted until a 1926 fire.",
      "sourceSentenceIds": [
        24,
        25
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Eros%2C_Louisiana"
    },
    {
      "id": 5,
      "text": "After the fires, the Tremont Lumber Company moved its operations to Olla, leaving only a few hundred residents in Eros.",
      "sourceSentenceIds": [
