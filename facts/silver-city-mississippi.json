      "id": 1,
      "text": "Silver City was incorporated on September 21, 1904, and grew as an agricultural hub with the Yazoo & Mississippi Valley Railroad boosting its connectivity.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 1"
      ],
