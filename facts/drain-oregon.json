  "facts": [
    {
      "id": 1,
      "text": "Drain was first settled in 1847 by Warren Goodell, who received 320 acres as a Donation Land Grant from the U.S.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://drainchamber.org/history/"
    },
    {
      "id": 2,
      "text": "The city of Drain takes its name from town founder and politician Charles J. Drain.",
      "sourceSentenceIds": [
        15
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Drain%2C_Oregon"
    },
    {
      "id": 3,
      "text": "The railroad brought prosperity to Drain, leading to the construction of many homes, stores, and public buildings within a decade.",
      "sourceSentenceIds": [
        11
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://drainoregon.org/drain-history/"
    },
    {
      "id": 4,
      "text": "The Drain Normal School was founded by the Methodist Church in 1883 before the state took over in 1885.",
      "sourceSentenceIds": [
        1,
        2
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Drain%2C_Oregon"
    },
    {
      "id": 5,
      "text": "Elk Creek and Pass Creek, both tributaries of the Umpqua River, converge in the city of Drain.",
      "sourceSentenceIds": [
        21
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Drain%2C_Oregon"
    },
    {
