    {
      "id": 1,
      "text": "Delta was incorporated in 1880, and its Main Street is listed on the National Register for its Victorian architecture.",
      "sourceSentenceIds": [
        1,
        8
      ],
      "sourceLabels": [
        "Web source 1"
      ],
