      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Members belong to the Dariusleut branch of Hutterites and share the surname Walter.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/prairie_elk_colony_montana",
      "category": "other",
      "quality": "poor",
      "qualityReason": "editorial_filler"
    },
    {
      "id": 4,
      "text": "The community maintains a five‑acre garden that yields corn, potatoes, beans, squash, peppers, watermelons, and juneberries.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/prairie_elk_colony_montana",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Men handle fieldwork and machinery while women and children tend gardens and prepare meals in a communal kitchen.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/prairie_elk_colony_montana",
      "category": "culture",
      "quality": "good"
    },
    {
