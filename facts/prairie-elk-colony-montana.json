      "id": 1,
      "text": "Prairie Elk Colony began in 2006 when a group split from Surprise Creek Hutterite Colony to form a new community.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
