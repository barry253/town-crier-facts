  "facts": [
    {
      "id": 1,
      "text": "Madisonville began in 1800 as the shell‑filled town of Coquille, founded by Jean Baptiste Baham, and was renamed in 1811 after President James Madison.",
      "sourceSentenceIds": [
        4,
        5,
        1
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 2"
      ],
      "source": "https://en.wikipedia.org/wiki/Madisonville%2C_Louisiana",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The Tchefuncte River Lighthouse, one of Louisiana’s oldest, entered the National Register in 1986 and survived the fury of Hurricanes Katrina and Rita.",
      "sourceSentenceIds": [
        12,
        13
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Madisonville%2C_Louisiana",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Before the Civil War, Madisonville served as a bustling port, shipping bricks and other goods from the Tchefuncte River towns to New Orleans.",
      "sourceSentenceIds": [
        29
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Madisonville%2C_Louisiana",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The New Orleans, Jackson & Great Northern Railroad, finished in 1854, linked Madisonville to the wider southeastern Louisiana network.",
      "sourceSentenceIds": [
        19
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/Madisonville,_Louisiana",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Lake Pontchartrain Basin Maritime Museum showcases the region’s seafaring heritage, and Madisonville hosts an annual Wooden Boat Festival that draws boating enthusiasts.",
      "sourceSentenceIds": [
        25
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/Madisonville,_Louisiana",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Today, Madisonville preserves its 19th‑century river town charm by blending historic buildings with new developments that support boating, marinas, and specialty shops.",
      "sourceSentenceIds": [
        15
