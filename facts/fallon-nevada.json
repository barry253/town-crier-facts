  "facts": [
    {
      "id": 1,
      "text": "Fallon was founded during the Gold Rush when Forty-niners paused at the Carson River; the town began in a shack owned by Michael and Eliza Fallon.",
      "sourceSentenceIds": [
        17,
        18
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Fallon%2C_Nevada",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The historic downtown, centered on Maine Street, was listed on the National Register of Historic Places in 2019, preserving its early 20th‑century architecture.",
      "sourceSentenceIds": [
        5,
        22
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Fallon%2C_Nevada",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Naval Air Station Fallon, built in 1942 southeast of town, hosts the U.S. Navy Fighter Weapons School, famously known as TOPGUN.",
      "sourceSentenceIds": [
        12,
        13,
        24
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Fallon%2C_Nevada",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Fallon's public library, the Churchill County Library, serves as a community hub and preserves local history.",
      "sourceSentenceIds": [
        14
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Fallon%2C_Nevada",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The city’s nickname, “The Oasis of Nevada,” reflects its wide‑open desert views and small‑town charm highlighted by local tourism sites.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://visitfallonnevada.com/",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "A new TravelStory app offers narrated walking and arts & agriculture tours led by Mayor Ken Tedford, showcasing Fallon’s diverse sights.",
