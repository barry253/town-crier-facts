  "facts": [
    {
      "id": 1,
      "text": "Napoleon was founded in the 1880s and named after pioneer storekeeper Napoleon Goodsill.",
      "sourceSentenceIds": [
        1,
        2
      ],
      "sourceLabels": [
        "Web source 1",
        "Wikipedia"
      ],
      "source": "https://www.napoleonnd.com/history/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Napoleon serves as the county seat of Logan County, making it the administrative hub of the region.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Napoleon%2C_North_Dakota",
      "category": "people",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The town’s courthouse, completed in 1937, earned a spot on the National Register of Historic Places.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.napoleonnd.com/history/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The railroad arrived in 1898, bringing crews and supplies to build a depot, water tank, and livestock pens.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.napoleonnd.com/history/",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Napoleon was incorporated as a village in 1914 and later as a city in 1947.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Napoleon%2C_North_Dakota",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The Logan County Courthouse, built in 1921, stands as a historic landmark in the town.",
