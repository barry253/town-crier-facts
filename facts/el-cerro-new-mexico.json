  "facts": [
    {
      "id": 1,
      "text": "El Cerro began as La Plaza del Cerro de Guadalupe, an agrarian settlement founded in the early 1850s by Hispano settlers from Questa and Taos.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/cerro_new_mexico",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "In the early 1970s, El Cerro emerged as a rural subdivision named after the nearby Cerro de Los Lunas, a volcanic hill visible for miles.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.trawellino.com/destinations/united-states/new-mexico_el-cerro",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "El Cerro’s most notable feature is an acequia-based irrigation system, engineered by early settlers to sustain farming and livestock in an otherwise arid landscape.",
      "sourceSentenceIds": [
        14
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/cerro_new_mexico",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Because Guadalupe Mountain offered no direct runoff, residents diverted the Rito Latir from Latir Peak, bending it southward to form the acequia madre, an artificial river for the plaza.",
      "sourceSentenceIds": [
        15
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/cerro_new_mexico",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Perched at 7,602 feet, El Cerro sits on the Taos Plateau, a high desert formed by Miocene-era basaltic lava flows.",
      "sourceSentenceIds": [
        18,
        22
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/cerro_new_mexico",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "El Cerro receives about 13.4 inches of rain each year but averages 61.5 inches of snow, with roughly 40 snowy days from November to April.",
      "sourceSentenceIds": [
        26,
