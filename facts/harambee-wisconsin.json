  "facts": [
    {
      "id": 1,
      "text": "Harambee’s name comes from Swahili, meaning “pulling together,” and the neighborhood stretches from Interstate‑43 to Keefe Avenue.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://emke.uwm.edu/entry/harambee/",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "German immigrants first settled the area in the 1800s, laying the groundwork for its early architecture.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Harambee_(neighborhood)",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "In 1891 the city annexed the nearby farming community of Williamsburg, bringing new residents into the district.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://emke.uwm.edu/entry/harambee/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The neighborhood began attracting African‑American residents in the early twentieth century, reshaping its cultural landscape.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://lostinmilwaukee.com/exploring-harambee-a-vibrant-neighborhood-in-milwaukees-heart/",
      "category": "people",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The Martin Luther King branch of the Milwaukee Public Library, the MLK Heritage Health Center, and the Northcott Neighborhood House serve as community hubs in Harambee.",
