  "facts": [
    {
      "id": 1,
      "text": "Denver City sprang to life in 1935 after a successful oil strike that turned the area into a boomtown.",
      "sourceSentenceIds": [
        1,
        28
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://denvercitytexas.org/resources/history.php"
    },
    {
      "id": 2,
      "text": "The town’s name comes from Denver Productions, the oil company that helped found the community, combined with “City” to signal optimism.",
      "sourceSentenceIds": [
        3,
        4
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Denver_City%2C_Texas"
    },
    {
      "id": 3,
      "text": "Situated on Texas’s far western edge, Denver City sits roughly midway between Lubbock and Midland‑Odessa, close to the New Mexico border.",
      "sourceSentenceIds": [
        9,
        13,
        14
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://denvercitytexas.org/resources/history.php"
    },
    {
      "id": 4,
      "text": "Today, the local oil industry still dominates, producing about 250,000 barrels of crude daily from five distinct zones.",
      "sourceSentenceIds": [
        26,
        27
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://denvercitytexas.org/resources/history.php"
    },
    {
      "id": 5,
      "text": "The Denver City Historical Museum preserves and showcases the town’s rich oil‑era heritage and early pioneer life.",
      "sourceSentenceIds": [
        11
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://texastimetravel.com/cities/denver-city/"
    },
    {
      "id": 6,
      "text": "Oil leasing began in 1927, but it wasn’t until 1935 that a successful well finally sparked the town’s growth.",
      "sourceSentenceIds": [
