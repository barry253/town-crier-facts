  "facts": [
    {
      "id": 1,
      "text": "Stevens Village takes its name from its first chief, Skidedlestalk “Old Steven” Stevens, who was elected chief in 1902.",
      "sourceSentenceIds": [
        2,
        3
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Stevens_Village%2C_Alaska"
    },
    {
      "id": 2,
      "text": "The original settlement, Dinyea meaning “mouth of the canyon,” was founded by three Athabascan brothers from the Koyukon region.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.tananachiefs.org/about/communities/stevens-village/"
    },
    {
      "id": 3,
      "text": "Stevens Village experiences long, harsh winters with daily lows often below zero and occasional drops to –60°F, while summers stay mild at 65‑72°F.",
      "sourceSentenceIds": [
        15,
        17,
        18,
        19,
        20,
        21
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.tananachiefs.org/about/communities/stevens-village/"
    },
    {
      "id": 4,
      "text": "During the gold rush, locals felled timber to supply mining camps and steamboats on the Yukon River.",
      "sourceSentenceIds": [
        22
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.tananachiefs.org/about/communities/stevens-village/"
    },
    {
      "id": 5,
      "text": "Stevens Village was among the first communities to embrace regional cooperation that became CATG, pioneering shared governance and service delivery.",
      "sourceSentenceIds": [
        28,
        29,
        30
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.catg.org/history/stevens-village-leads"
    },
    {
      "id": 6,
      "text": "Stevens Village sits at 66°0′19″N 149°6′11″W, right in the heart of the Yukon Flats.",
