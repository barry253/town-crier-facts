  "facts": [
    {
      "id": 1,
      "text": "Ash Fork earned the nickname 'Flagstone Capital of Arizona' because its historic buildings were built from local red sandstone.",
      "sourceSentenceIds": [
        5,
        11
      ],
      "sourceLabels": [
        "Web source 2",
        "Wikipedia"
      ],
      "source": "https://visitusaparks.com/ash-fork-a-hidden-gem-on-route-66/",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town began as a siding for the Atlantic and Pacific Railroad in 1882, later becoming part of the Santa Fe Railway.",
      "sourceSentenceIds": [
        12,
        13
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Ash_Fork%2C_Arizona",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "After a devastating fire in 1885, Ash Fork was rebuilt on the opposite side of the tracks in 1893 and remains there today.",
      "sourceSentenceIds": [
        14
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Ash_Fork%2C_Arizona",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The original 1893 Santa Fe depot, constructed from striking red Coconino sandstone, still welcomes visitors and echoes the era of steam engines.",
      "sourceSentenceIds": [
        25,
        26
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.ashforkrt66historicmuseum.com/ourhistory",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The Hi‑Line Motor Court sign, salvaged from the historic roadside era, is preserved in Ash Fork’s Route 66 museum to honor the town’s golden‑age heritage.",
      "sourceSentenceIds": [
        9,
