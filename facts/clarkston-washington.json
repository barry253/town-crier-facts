  "facts": [
    {
      "id": 1,
      "text": "Clarkston sits where the Snake and Clearwater rivers meet, forming a natural confluence that defines the Lewis-Clark Valley.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Clarkston%2C_Washington"
    },
    {
      "id": 2,
      "text": "The city’s name honors William Clark of the famed Lewis and Clark Expedition, though neither explorer ever set foot on its side of the river.",
      "sourceSentenceIds": [
        17
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Clarkston%2C_Washington"
    },
    {
      "id": 3,
      "text": "Robert Bracken first settled the area in 1862, and Clarkston officially became a city on August 14, 1902.",
      "sourceSentenceIds": [
        15
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Clarkston%2C_Washington"
    },
    {
      "id": 4,
      "text": "The Lewis-Clark Valley, a hub of Northwest history and culture, surrounds Clarkston along with Lewiston and Asotin.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://visitlcvalley.com/"
    },
    {
      "id": 5,
      "text": "Clarkston lies within the Lewis-Clark Valley AVA wine region, home to 16 vineyards that trace wine‑growing back to the late 1800s.",
      "sourceSentenceIds": [
