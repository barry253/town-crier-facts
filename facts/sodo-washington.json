  "facts": [
    {
      "id": 1,
      "text": "SoDo’s name started as “South of the Dome” but after the Kingdome fell, it’s now read as “South of Downtown.”.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/SoDo%2C_Seattle"
    },
    {
      "id": 2,
      "text": "The neighborhood deliberately echoes New York’s SoHo, turning former factory spaces into artist lofts and studios during the 1970s.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/SoDo%2C_Seattle"
    },
    {
      "id": 3,
      "text": "Sound Transit’s 1 Line runs through SoDo, stopping at SODO on Lander Street and Stadium on Royal Brougham Way.",
      "sourceSentenceIds": [
        13
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/SoDo%2C_Seattle"
    },
    {
      "id": 4,
      "text": "Some of SoDo’s warehouse buildings still house their original industries, while others have become artist lofts, galleries, and quirky shops.",
      "sourceSentenceIds": [
        15
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/SoDo%2C_Seattle"
    },
    {
      "id": 5,
      "text": "I‑90’s western terminus, the end of a 3,020‑mile route to Boston, sits right in SoDo’s heart.",
      "sourceSentenceIds": [
        23
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/SoDo%2C_Seattle"
    },
    {
      "id": 6,
      "text": "Before becoming industry, the area that is now SoDo was tidal flats that were filled in during the early 20th century.",
