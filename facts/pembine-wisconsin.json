  "facts": [
    {
      "id": 1,
      "text": "The name Pembine comes from the Menominee word for cranberries, which also gave its name to the nearby Pemebonwon River.",
      "sourceSentenceIds": [
        7,
        12,
        20
      ],
      "sourceLabels": [
        "Web source 1",
        "Web source 2",
        "Wikipedia"
      ],
      "source": "https://thebrassie.com/what-is-the-history-of-pembine-wisconsin/"
    },
    {
      "id": 2,
      "text": "Pembine began as a lumber camp in 1887 and grew into a community centered around the softwood logging industry.",
      "sourceSentenceIds": [
        8,
        3
      ],
      "sourceLabels": [
        "Web source 1",
        "Wikipedia"
      ],
      "source": "https://thebrassie.com/what-is-the-history-of-pembine-wisconsin/"
    },
    {
      "id": 3,
      "text": "The local economy in Pembine eventually shifted from logging to potato farming and the dairy industry.",
      "sourceSentenceIds": [
        23
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Pembine%2C_Wisconsin"
    },
    {
      "id": 4,
      "text": "Pembine was originally part of the town of Amberg until it was established as a separate town in April 1914.",
      "sourceSentenceIds": [
        22
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Pembine%2C_Wisconsin"
    },
    {
      "id": 5,
      "text": "The Pemebonwon River and the scenic Long Slide Falls are located in the immediate vicinity of Pembine.",
      "sourceSentenceIds": [
        18
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Pembine%2C_Wisconsin"
    },
    {
      "id": 6,
      "text": "The historic Pembine union train station, which was built in 1887, was destroyed by a fire in June 2019.",
