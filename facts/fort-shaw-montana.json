  "facts": [
    {
      "id": 1,
      "text": "Fort Shaw was established in 1867 as a U.S. Army post to protect travel routes, settlers, and trade in Montana Territory.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.lewisandclark.travel/listing/historic-fort-shaw/"
    },
    {
      "id": 2,
      "text": "The Sun River Valley Museum, located on the historic Fort Shaw grounds, preserves one of Montana’s most important frontier military sites.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.lewisandclark.travel/listing/historic-fort-shaw/"
    },
    {
      "id": 3,
      "text": "After decommissioning in 1891, Fort Shaw became an Indian boarding school, and its girls’ basketball team won nearly every game from 1902 to 1906.",
      "sourceSentenceIds": [
        15,
        16
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Fort_Shaw%2C_Montana"
    },
    {
      "id": 4,
      "text": "The fort’s original name was Camp Reynolds before it was renamed to honor Colonel William H. Shaw, a notable military figure.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Fort_Shaw%2C_Montana"
    },
    {
      "id": 5,
      "text": "Fort Shaw sits 24 miles west of Great Falls on Highway 200, a route that follows the historic Lewis & Clark Trail.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.lewisandclark.travel/listing/historic-fort-shaw/"
    },
    {
      "id": 6,
      "text": "The Fort Shaw Historic District and Cemetery is listed on the National Register of Historic Places, preserving its 19th‑century structures.",
      "sourceSentenceIds": [
