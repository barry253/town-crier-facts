  "facts": [
    {
      "id": 1,
      "text": "Oak Hill rises above Manistee Lake, its name reflecting the hilltop view that early settlers prized.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Oak_Hill%2C_Michigan",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "In 1874 lumber magnate Charles Rietz erected a grand mansion on the hill, complete with gardens and vineyards.",
      "sourceSentenceIds": [
        3,
        15,
        16
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/oak_hill_michigan",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "After Rietz died in 1890, parts of his estate were donated in 1908, creating Rietz Park with woodlands and a historic pool.",
      "sourceSentenceIds": [
        2,
        17
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/oak_hill_michigan",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The area’s first permanent Euro‑American settlement began in 1841 when John Stronach built a sawmill at the Manistee River mouth, igniting the lumber boom.",
      "sourceSentenceIds": [
        10,
        11
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/oak_hill_michigan",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Route 31 skirts Oak Hill’s western edge, a road that evolved from early logging trails to a modern highway by the 20th century.",
      "sourceSentenceIds": [
        9,
        19,
        20
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Oak_Hill%2C_Michigan",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Oak Hill grew from worker housing around the Filer & Sons sawmill, which closed in 1914, marking the town’s shift from logging to residential life.",
      "sourceSentenceIds": [
        24,
        26
      ],
