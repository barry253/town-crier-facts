  "facts": [
    {
      "id": 1,
      "text": "Violet Hill began as a mid‑19th‑century settlement drawn by Ozark timber and fertile farmland after Izard County formed in 1825.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/violet_hill_arkansas",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The 1858 post office became the community’s first hub, linking farmers to the White River steamboat trade.",
      "sourceSentenceIds": [
        28,
        29
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/violet_hill_arkansas",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "A steam grist‑mill, blacksmith shop, general store, and church once defined Violet Hill’s modest commercial core.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/violet_hill_arkansas",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "As logging waned in the early 20th century, Violet Hill shifted toward sustainable agriculture, mirroring county trends.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/violet_hill_arkansas",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The town sits at 748 feet on the Ozark Plateau, where rolling hills keep summer heat in check.",
      "sourceSentenceIds": [
        18,
        26
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/violet_hill_arkansas",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Violet Hill’s humid subtropical climate brings hot, humid summers and mild winters, with about 48 inches of rain each year.",
      "sourceSentenceIds": [
        21,
