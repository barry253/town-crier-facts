  "facts": [
    {
      "id": 1,
      "text": "Westlake began as a 1810 settlement when two Connecticut families crossed the Western Reserve to build homesteads in Dover Township.",
      "sourceSentenceIds": [
        13,
        19,
        20
      ],
      "sourceLabels": [
        "Web source 2",
        "Wikipedia"
      ],
      "source": "https://grokipedia.com/page/Westlake,_Ohio",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "In 1911 Dover Village incorporated, then changed its name to Westlake in 1940 to avoid confusion with another Dover in Ohio.",
      "sourceSentenceIds": [
        1,
        3,
        5,
        6
      ],
      "sourceLabels": [
        "Web source 2",
        "Wikipedia"
      ],
      "source": "https://grokipedia.com/page/Westlake,_Ohio",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Westlake achieved city status in 1957 as post‑World War II families moved from Cleveland seeking larger homes and lower densities.",
      "sourceSentenceIds": [
        1,
        5,
        9,
        24
      ],
      "sourceLabels": [
        "Web source 2",
        "Wikipedia"
      ],
      "source": "https://grokipedia.com/page/Westlake,_Ohio",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The Clague House Museum, housed in a historic home, chronicles Westlake’s early days and its evolution from Dover Village.",
      "sourceSentenceIds": [
        12,
        10
      ],
      "sourceLabels": [
        "Web source 1",
        "Wikipedia"
      ],
      "source": "https://case.edu/ech/articles/w/westlake",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Lakewood Country Club, the only Northern Ohio club to host a PGA‑based televised golf tour, is located in Westlake.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Westlake%2C_Ohio",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Westlake’s humid continental climate brings lake‑effect snow from Lake Erie during cold, snowy winters.",
      "sourceSentenceIds": [
        16
      ],
      "sourceLabels": [
