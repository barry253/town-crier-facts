  "facts": [
    {
      "id": 1,
      "text": "Leland sits on an isthmus between Lake Leelanau and Lake Michigan, bisected by the Leland River.",
      "sourceSentenceIds": [
        18
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Leland%2C_Michigan",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The village originated as one of the oldest and largest Ottawa settlements on the peninsula, originally called Mishi-me-go-bing.",
      "sourceSentenceIds": [
        19,
        21
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Leland%2C_Michigan",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "In 1854, settlers built a dam and sawmill that raised water 12 feet, creating Lake Leelanau from three natural lakes.",
      "sourceSentenceIds": [
        23,
        24
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Leland%2C_Michigan",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "From 1870 to 1884, the Leland Lake Superior Iron Co. smelted up to 40 tons of iron daily using charcoal from local maple and beech.",
      "sourceSentenceIds": [
        26,
        27
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Leland%2C_Michigan",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The historic Fishtown, still owned by the Fishtown Preservation Society, once housed two fish tugs, Joy and Janice Sue, and remains a living museum of fishing heritage.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Leland%2C_Michigan",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Leland was the county seat of Leelanau County from 1883 until 2004, when the seat moved to Suttons Bay Township.",
