  "facts": [
    {
      "id": 1,
      "text": "Aurora was founded in 1875 by Ezra Houghton Curtis and three other families along the banks of the Sevier River.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Aurora%2C_Utah"
    },
    {
      "id": 2,
      "text": "Settlers originally called the town Willowbend because they built their houses along a large bend of the Sevier River.",
      "sourceSentenceIds": [
        3,
        4,
        15
      ],
      "sourceLabels": [
        "Web source 1",
        "Wikipedia"
      ],
      "source": "https://www.seviercountyhistoryhub.org/town-history/aurora-utah"
    },
    {
      "id": 3,
      "text": "The name Aurora was chosen because of the Northern Lights and the Roman Goddess of dawn.",
      "sourceSentenceIds": [
        16,
        17
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Aurora%2C_Utah"
    },
    {
      "id": 4,
      "text": "Aurora moved its city center west several miles to avoid the spring flooding of the Sevier River.",
      "sourceSentenceIds": [
        18
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Aurora%2C_Utah"
    },
    {
      "id": 5,
      "text": "Aurora is nestled in the fertile Sevier Valley, surrounded by the Pahvant Range and the Manti LaSal National Forest.",
      "sourceSentenceIds": [
        5,
        22
      ],
      "sourceLabels": [
        "Web source 1",
        "Wikipedia"
      ],
      "source": "https://www.seviercountyhistoryhub.org/town-history/aurora-utah"
    },
    {
      "id": 6,
      "text": "Most current residents of Aurora can track their lineage back to one of the four founding families of the city.",
      "sourceSentenceIds": [
        24
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Aurora%2C_Utah"
