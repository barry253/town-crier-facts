  "facts": [
    {
      "id": 1,
      "text": "Middleburg was originally called Swinefordstown after tavern owner John Albright Swineford, who ran a tavern there in 1787.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Middleburg%2C_Pennsylvania"
    },
    {
      "id": 2,
      "text": "Swineford owned land on the north bank of Middle Creek, anchoring the town’s early development.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://middleburgborough.com/about-middleburg-borough/"
    },
    {
      "id": 3,
      "text": "The Swineford name lives on in the Swineford National Bank, founded in 1903 and now part of Fulton Financial Family.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Middleburg%2C_Pennsylvania"
    },
    {
      "id": 4,
      "text": "When the Sunbury and Lewistown Railroad arrived, new lots appeared and the town’s southern section was first called Franklin, later Swineford.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Middleburg%2C_Pennsylvania"
    },
    {
      "id": 5,
      "text": "Native Americans had lived in this region for centuries before European settlement.",
      "sourceSentenceIds": [
        11
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://middleburgborough.com/about-middleburg-borough/"
    },
    {
      "id": 6,
      "text": "Middleburg serves as the county seat of Snyder County, Pennsylvania, and is the administrative center for the county.",
      "sourceSentenceIds": [
        30
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Middleburg%2C_Pennsylvania"
