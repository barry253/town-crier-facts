      "id": 1,
      "text": "Emmett earned its name from Irish patriot Robert Emmet, honoring the folk hero who inspired the town’s founders.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 1"
      ],
