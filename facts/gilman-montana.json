  "facts": [
    {
      "id": 1,
      "text": "Gilman sprang up in the early 1910s when the Great Northern Railway built a branch line through the Sun River Valley.",
      "sourceSentenceIds": [
        8,
        10
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Gilman%2C_Montana"
    },
    {
      "id": 2,
      "text": "The town was officially chartered by the Gilman Townsite Company, named after company officer Abraham Lincoln Bradley.",
      "sourceSentenceIds": [
        6,
        7
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.mtmemory.org/nodes/view/127739"
    },
    {
      "id": 3,
      "text": "Today, the only surviving building from Gilman's early days is Bradley’s abandoned brick bank building.",
      "sourceSentenceIds": [
        11
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.mtmemory.org/nodes/view/127739"
    },
    {
      "id": 4,
      "text": "Historic Sanborn maps show Gilman’s original downtown blocks, schools, hotels, and factories that once defined everyday life.",
      "sourceSentenceIds": [
        1,
        5
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://hometownhistorymaps.com/pages/history-of-gilman-montana"
    },
    {
      "id": 5,
      "text": "You can view Gilman exactly as it looked over a century ago by looking at the 1916 Sanborn map available from Hometown History Maps.",
      "sourceSentenceIds": [
        14,
        16
      ],
