  "facts": [
    {
      "id": 1,
      "text": "Westland began as a Quaker settlement in the late 1700s, with the first meetinghouse built in 1782 on Joseph Townsend's farm.",
      "sourceSentenceIds": [
        1,
        29
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/westland_pennsylvania",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The Westland Friends Meeting House closed in 1864, and its property became a cemetery association in 1902, preserving over 700 graves.",
      "sourceSentenceIds": [
        2,
        13
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/westland_pennsylvania",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "In 1928 the Montour Railroad built Westland Branch, giving the town a direct rail link for coal shipping and reducing reliance on the Pennsylvania Railroad.",
      "sourceSentenceIds": [
        7,
        8
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/westland_pennsylvania",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Westland once hosted a company town for the Pittsburgh Coal Company, with housing and a store for miners until the mid‑1940s.",
      "sourceSentenceIds": [
        26
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/westland_pennsylvania",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Westland’s rural‑suburban character today reflects Washington County’s shift from heavy industry to quieter residential life.",
      "sourceSentenceIds": [
        25,
        27
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/westland_pennsylvania",
      "category": "culture",
      "quality": "good"
    }
