  "facts": [
    {
      "id": 1,
      "text": "Founded by aviation pioneer Glenn Curtiss and James Bright during the 1920s land boom, the town was originally called Country Club Estates.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Miami_Springs%2C_Florida",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The city was renamed after a local spring that supplied fresh water to Miami until the mid‑1990s.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Miami_Springs%2C_Florida",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The 1927 Pueblo Revival hotel later became the Miami‑Battle Creek Sanitarium, then The Palm Spa, and today is Fair Havens Center.",
      "sourceSentenceIds": [
        4,
        5
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Miami_Springs%2C_Florida",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The Clune‑Stadnik Building, a Pueblo Revival landmark on Curtiss Parkway, is listed on the National Register of Historic Places.",
