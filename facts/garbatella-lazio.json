  "facts": [
    {
      "id": 1,
      "text": "Garbatella was founded on February 18, 1920, on an estate beside the Basilica of Saint Paul Outside the Walls.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Garbatella",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The neighborhood’s layout follows the Garden City model, with low houses grouped around shared courtyards that echo Roman Baroque style.",
      "sourceSentenceIds": [
        19,
        30
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Garbatella",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Benedetto Brin Square marks the historic gateway; its cornerstone was laid in 1920, the same year the neighborhood began.",
      "sourceSentenceIds": [
        11
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.justroma.it/en/authentic-neighborhoods/garbatella-an-authentic-neighborhood-of-rome/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Garbatella’s Teatro Palladium, now run by Roma Tre University, once hosted silent films and early Italian cinema.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Garbatella",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The Fontana Carlotta in Piazza Rinaldo da Montecroce features a “Lovers’ Staircase” that locals still climb for a romantic view.",
