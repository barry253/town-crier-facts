  "facts": [
    {
      "id": 1,
      "text": "Wanblee is named after the Lakota word for eagle because of its proximity to Eagle Nest Butte.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Wanblee%2C_South_Dakota"
    },
    {
      "id": 2,
      "text": "The community of Wanblee began as a Lakota encampment along Pass Creek, originally known as Lip's Camp.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/wanblee_south_dakota"
    },
    {
      "id": 3,
      "text": "Wanblee is located just a few miles northeast of the North American continental pole of inaccessibility.",
      "sourceSentenceIds": [
        15
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Wanblee%2C_South_Dakota"
    },
    {
      "id": 4,
      "text": "The 1992 movie Thunderheart was partly filmed right here in Wanblee.",
      "sourceSentenceIds": [
        14
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Wanblee%2C_South_Dakota"
    },
    {
      "id": 5,
      "text": "Craven Creek runs through the west side of Wanblee and leads north to the White River.",
      "sourceSentenceIds": [
        16
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Wanblee%2C_South_Dakota"
    },
    {
      "id": 6,
      "text": "Wanblee is situated within the Pine Ridge Indian Reservation, which is primarily home to the Oglala Lakota band of the Sioux.",
