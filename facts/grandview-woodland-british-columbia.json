  "facts": [
    {
      "id": 1,
      "text": "Grandview–Woodland stretches from Burrard Inlet south to Broadway, with Commercial Drive running north‑south through the heart of the neighbourhood.",
      "sourceSentenceIds": [
        10,
        12,
        14
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Grandview%E2%80%93Woodland",
      "category": "other",
      "quality": "poor",
      "qualityReason": "location_description"
    },
    {
      "id": 2,
      "text": "The area was first developed after the Interurban train line reached New Westminster in 1891, sparking a new community along the waterfront.",
      "sourceSentenceIds": [
        19
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Grandview%E2%80%93Woodland",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "A small cove where a stream met the inlet became the first industrial site, hosting a brewery followed by sawmills that cleared the surrounding forests.",
      "sourceSentenceIds": [
        17
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Grandview%E2%80%93Woodland",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Two historic churches, the 1909 Methodist Cultch and the 1910 Robertson Presbyterian, have been repurposed into housing, showing heritage woven into modern life.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://spacing.ca/vancouver/2019/09/24/developing-a-community-the-history-of-grandview/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Commercial Drive, locally called “The Drive”, has been a hub of ethnic diversity and quirky shops for nearly a century, earning a reputation as Vancouver’s cultural corridor.",
      "sourceSentenceIds": [
        24,
        25,
        26
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Grandview%E2%80%93Woodland",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The name Grand View first appeared on a sign by an Interurban stop near Commercial Drive and 1st Avenue, later formalized in 1911 as the neighbourhood grew.",
      "sourceSentenceIds": [
        20,
        21
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Grandview%E2%80%93Woodland",
