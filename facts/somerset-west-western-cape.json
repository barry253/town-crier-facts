  "facts": [
    {
      "id": 1,
      "text": "Somerset West was founded in 1822 on part of the historic Vergelegen farm, an 18th‑century Cape Dutch farmhouse built by Willem Adriaan van der Stel.",
      "sourceSentenceIds": [
        1,
        2,
        13
      ],
      "sourceLabels": [
        "Web source 1",
        "Wikipedia"
      ],
      "source": "https://www.peterventer.com/somerset-west-history"
    },
    {
      "id": 2,
      "text": "The town was named after British governor Lord Charles Somerset; “West” was added after 1825 to distinguish it from Somerset East.",
      "sourceSentenceIds": [
        3,
        5,
        8
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1",
        "Web source 2"
      ],
      "source": "https://en.wikipedia.org/wiki/Somerset_West"
    },
    {
      "id": 3,
      "text": "Paardevlei, once an AECI explosives factory in the late 19th century, still stands as a reminder of Somerset West’s industrial heritage.",
      "sourceSentenceIds": [
        12,
        17
      ],
      "sourceLabels": [
        "Web source 2",
        "Web source 1"
      ],
      "source": "https://cultureconnectsa.com/a-different-look-at-somerset-west/"
    },
    {
      "id": 4,
      "text": "Somerset West overlooks Helderberg Mountain, a “clear mountain” that surrounds the town in an amphitheatre of the Hottentots‑Holland range.",
      "sourceSentenceIds": [
        28,
        29
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 2"
      ],
      "source": "https://en.wikipedia.org/wiki/Somerset_West"
    },
    {
      "id": 5,
      "text": "All Saints Church, founded in 1861, is one of the oldest and largest churches in Somerset West, reflecting its early missionary roots.",
