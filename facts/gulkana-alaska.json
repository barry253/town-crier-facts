  "facts": [
    {
      "id": 1,
      "text": "Gulkana began in 1903 as a U.S. Army telegraph station, marking the town’s first permanent settlement.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://gulkanacouncil.org/about/our-history/"
    },
    {
      "id": 2,
      "text": "For about 5,000 years before Europeans arrived, Ahtna Athabascans lived along the Gulkana River, shaping the region’s culture.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/gulkana_alaska"
    },
    {
      "id": 3,
      "text": "In 2020, Governor Dunleavy signed an agreement that returned Gulkana’s traditional gravesite to the village after almost eighty years.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://gulkanacouncil.org/about/our-history/"
    },
    {
      "id": 4,
      "text": "Gulkana enforces a strict alcohol ban, prohibiting sale, importation, and possession within the village limits.",
      "sourceSentenceIds": [
        23
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Gulkana%2C_Alaska"
    },
    {
      "id": 5,
      "text": "Since 2008, Gulkana’s buildings run on solar power, and a 2013 MIEX water treatment plant supplies clean water.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/gulkana_alaska"
    },
    {
      "id": 6,
      "text": "The original Army telegraph station on higher ground north of the Gulkana River later evolved into a civilian aviation hub, easing isolation.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Web source 1"
      ],
