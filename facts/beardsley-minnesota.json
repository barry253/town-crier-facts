  "facts": [
    {
      "id": 1,
      "text": "Beardsley was founded in 1880 when the first town meeting took place at Joseph Branch’s home.",
      "sourceSentenceIds": [
        28
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://mnbump.com/city-of-beardsley/beardsley-history/"
    },
    {
      "id": 2,
      "text": "The town’s first settler applied for a homestead on April 3, 1878, built a house by August, and established residence that year.",
      "sourceSentenceIds": [
        22,
        23
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://mnbump.com/city-of-beardsley/beardsley-history/"
    },
    {
      "id": 3,
      "text": "A branch of the Cloud and Lake Traverse Railway linked Beardsley to Morris and Browns Valley, helping the town grow.",
      "sourceSentenceIds": [
        24,
        25
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://mnbump.com/city-of-beardsley/beardsley-history/"
    },
    {
      "id": 4,
      "text": "Beardsley holds state record high temperatures: 111°F in September 1931, 98°F in October 1963, and shares the July record of 115°F set there in 1917.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Beardsley%2C_Minnesota"
    },
    {
      "id": 5,
      "text": "In 1975, a 4.6‑magnitude earthquake was felt across 315,000 square kilometers, including Beardsley.",
