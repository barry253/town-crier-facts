  "facts": [
    {
      "id": 1,
      "text": "Summit was incorporated as a township in 1869 from parts of New Providence and Springfield, then became a city in 1899.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Summit%2C_New_Jersey",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town’s name comes from its position atop the Second Watchung Mountain and the early Summit Lodge of jurist James Kent.",
      "sourceSentenceIds": [
        16,
        28
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Summit%2C_New_Jersey",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The Morris and Essex Railroad, built in 1837, ran over what was then called 'The Summit' hill, giving the town its name.",
      "sourceSentenceIds": [
        17
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Summit%2C_New_Jersey",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Summit hosts the Reeves‑Reed Arboretum, a historic country estate turned suburban conservancy that educates visitors about nature.",
      "sourceSentenceIds": [
        21
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Summit%2C_New_Jersey",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The city supports public art through Summit Public Art, a volunteer organization founded in 2002 that brings art to public spaces.",
      "sourceSentenceIds": [
        4
