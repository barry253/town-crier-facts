    {
      "id": 1,
      "text": "Wahpeton was founded in 1869 and its name comes from a Sioux word meaning “Dwellers Among Leaves.”.",
      "sourceSentenceIds": [
        1,
        2
      ],
      "sourceLabels": [
        "Web source 2",
