  "facts": [
    {
      "id": 1,
      "text": "Milford Square was once called Heistville, named after the Heist family who ran Achey's Mill and renovated the miller's home.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Milford_Square%2C_Pennsylvania",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Campbell's Bridge, a historic stone arch, earned a spot on the National Register of Historic Places in 1988.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Milford_Square%2C_Pennsylvania",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The town sits along PA Route 663, just a short drive from Trumbauersville, and is a gateway to Bucks County’s scenic backroads.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Milford_Square%2C_Pennsylvania",
      "category": "other",
      "quality": "poor",
      "qualityReason": "location_description"
    },
    {
      "id": 4,
      "text": "Milford Square lies on Unami Creek, also called Swamp Creek, which feeds into the larger Perkiomen Creek watershed.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Milford_Square%2C_Pennsylvania",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Achey's Bridge, the first concrete‑reinforced bridge in America, was designed by Henry Mercer and now sits on private property.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Milford_Square%2C_Pennsylvania",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The area offers a perfect base for exploring rural Bucks County’s historic sites, natural beauty, and rolling farmland.",
