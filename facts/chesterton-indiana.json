  "facts": [
    {
      "id": 1,
      "text": "Chesterton’s name comes from Old English, meaning a fortified place belonging to a freeman, hinting at Roman roots.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.wisdomlib.org/cities/chesterton-31294",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town was first called Calumet in 1850, then renamed Chesterton in 1870 after a railroad town with the same name.",
      "sourceSentenceIds": [
        1,
        5
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Chesterton%2C_Indiana",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Chesterton High School hosts the only local radio station, WDSO 88.3, which broadcasts news and music for the community.",
      "sourceSentenceIds": [
        14,
        16
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Chesterton%2C_Indiana",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The South Shore Line stops at Dune Park station just north of Chesterton, offering frequent trains to Chicago and South Bend.",
      "sourceSentenceIds": [
        17
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Chesterton%2C_Indiana",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The area was first settled as Coffee Creek in 1833, with a post office opening two years later in 1835.",
