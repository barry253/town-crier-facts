  "facts": [
    {
      "id": 1,
      "text": "Founded by German immigrant Martin Loy around 1795, Loysburg grew around his farm, flour mill, and general store.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/loysburg_pennsylvania",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town briefly became Pattonville in 1844 when James Patton bought key properties, but locals restored the original name in 1864.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/loysburg_pennsylvania",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Loysburg sits at the southern end of Morrisons Cove, where the terrain shifts from valleys to the Nittany Anticlinorium’s northeast‑southwest trending anticline.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/loysburg_pennsylvania",
      "category": "other",
      "quality": "poor",
      "qualityReason": "location_description"
    },
    {
      "id": 4,
      "text": "Yellow Creek, draining 69.2 square miles, flows through Loysburg and sustains a steady 46.8 cfs base flow before joining the Susquehanna Basin.",
      "sourceSentenceIds": [
        11,
        24
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/loysburg_pennsylvania",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The historic Loysburg Mill, rebuilt in 1836‑37, operated until 1950, serving as a local landmark for over a century.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/loysburg_pennsylvania",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The community lies along Pennsylvania Route 36, a historic corridor that follows the Loysburg Gap through Tussey Mountain.",
      "sourceSentenceIds": [
        13
      ],
