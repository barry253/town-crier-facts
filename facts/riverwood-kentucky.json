  "facts": [
    {
      "id": 1,
      "text": "Riverwood was founded in 1961 by developer Paul Semonin Jr., who envisioned a planned community in northeastern Jefferson County.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.riverwoodky.org/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Riverwood officially incorporated on November 11, 1969, becoming a home‑rule city in Jefferson County.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.riverwoodky.org/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "In 1998, Riverwood residents voted against merging with Indian Hills, keeping the city independent.",
      "sourceSentenceIds": [
        11
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.riverwoodky.org/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Riverwood sits at the foot of the historic Locust Grove home, founded by William and Lucy Clark Croghan in 1792.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.riverwoodky.org/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Surrounded by woods and bordered by a creek, Riverwood hosts abundant wildlife throughout its green spaces.",
      "sourceSentenceIds": [
        23
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.riverwoodky.org/",
      "category": "nature",
      "quality": "good"
    },
    {
