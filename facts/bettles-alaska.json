  "facts": [
    {
      "id": 1,
      "text": "Bettles was named after trader Gordon C. Bettles, who opened a trading post there in 1898 during the Alaska Gold Rush.",
      "sourceSentenceIds": [
        2,
        5
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 2"
      ],
      "source": "https://en.wikipedia.org/wiki/Bettles%2C_Alaska",
      "category": "people",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "In the late 1940s, residents moved Bettles downstream to make room for the Bettles Airstrip, shifting the town closer to the river confluence.",
      "sourceSentenceIds": [
        12,
        24
      ],
      "sourceLabels": [
        "Web source 2",
        "Wikipedia"
      ],
      "source": "https://grokipedia.com/page/Bettles,_Alaska",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Old Bettles, once a bustling trading post, became a ghost town after flooding and erosion forced residents to leave by the late 20th century.",
      "sourceSentenceIds": [
        1,
        26
      ],
      "sourceLabels": [
        "Web source 2",
        "Wikipedia"
      ],
      "source": "https://grokipedia.com/page/Bettles,_Alaska",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Long before settlers, Koyukon Athabascans and Iñupiat peoples used the Koyukuk River corridor near Bettles for hunting, fishing, and seasonal travel.",
      "sourceSentenceIds": [
        3,
        16,
        17
      ],
      "sourceLabels": [
        "Web source 1",
        "Web source 2"
      ],
      "source": "https://www.nps.gov/gaar/planyourvisit/bettles.htm",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Bettles serves as a gateway to Gates of the Arctic National Park, located about 20 miles north of the town.",
      "sourceSentenceIds": [
        18,
        19
      ],
      "sourceLabels": [
        "Web source 2",
        "Wikipedia"
      ],
      "source": "https://grokipedia.com/page/Bettles,_Alaska",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Bettles hosts a National Park Service ranger station that offers backcountry orientations and permits for exploring nearby wilderness.",
