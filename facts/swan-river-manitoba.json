  "facts": [
    {
      "id": 1,
      "text": "Swan River was founded in 1900 when a Canadian Northern Railway line was announced, growing from a simple post office.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Swan_River%2C_Manitoba",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town’s name comes from trumpeter swans that once bred near Swan Lake, though they are now locally extirpated.",
      "sourceSentenceIds": [
        2,
        4
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Swan_River%2C_Manitoba",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "In 1876, the North-West Mounted Police’s musical band debuted in the area that would become Swan River, with instruments shipped by dog sled.",
      "sourceSentenceIds": [
        5,
        6
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Swan_River%2C_Manitoba",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Swan River sits in a valley between the Duck Mountains and Porcupine Hills, close to Saskatchewan, and the Swan River flows into Swan Lake 55 km northeast.",
      "sourceSentenceIds": [
        8,
        14,
        15
      ],
      "sourceLabels": [
        "Web source 1",
        "Wikipedia"
      ],
      "source": "https://www.comeexplorecanada.com/manitoba/swan-river",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The town once boasted a junior Olympic‑sized outdoor swimming pool, the Swan River Kinsmen Pool, and still has a six‑sheet curling rink.",
      "sourceSentenceIds": [
        10,
        11
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Swan_River%2C_Manitoba",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Valley soils here are a mix of glacial till and lacustrine clay, making the land exceptionally fertile yet alkaline, limiting crops like blueberries.",
