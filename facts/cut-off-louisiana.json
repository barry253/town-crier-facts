  "facts": [
    {
      "id": 1,
      "text": "Cut Off earned its name from a 1857 canal cutoff that shortened Bayou Lafourche’s route to the Gulf, a French term La Coupe.",
      "sourceSentenceIds": [
        2,
        18
      ],
      "sourceLabels": [
        "Web source 2",
        "Wikipedia"
      ],
      "source": "https://grokipedia.com/page/Cut_Off,_Louisiana",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town sits where Bayou Lafourche meets a historic canal that links to Lake Salvador, a shallow 16‑mile brackish lake.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/Cut_Off,_Louisiana",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Before Europeans arrived, the land that is now Cut Off belonged to the Chitimacha tribe.",
