      ],
      "source": "https://obioncounty.org/live/major-towns/kenton",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Legend says a traveling gypsy band gifted a matched pair of white squirrels to a farmer, sparking the town’s famous squirrel population.",
      "sourceSentenceIds": [
