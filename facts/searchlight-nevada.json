    },
    {
      "id": 2,
      "text": "The town’s boom began when George Frederick Colton discovered the Duplex Mine in 1897, sparking a gold rush.",
      "sourceSentenceIds": [
        22
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://unitedstatesghosttowns.com/searchlight-nevada-ghost-town/"
    },
    {
      "id": 3,
      "text": "A narrow‑gauge railroad built in 1902 hauled ore to mills, keeping Searchlight thriving until a 1923 storm washed out the tracks.",
      "sourceSentenceIds": [
        14,
        11
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://unitedstatesghosttowns.com/searchlight-nevada-ghost-town/"
    },
    {
      "id": 4,
      "text": "The Searchlight Museum, opened in 1989, sits in the community center and showcases over a century of mining history.",
      "sourceSentenceIds": [
        8,
