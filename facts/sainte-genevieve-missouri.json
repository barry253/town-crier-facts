  "facts": [
    {
      "id": 1,
      "text": "Sainte Genevieve is the oldest permanent European settlement in Missouri, founded in 1735 by French Canadian colonists.",
      "sourceSentenceIds": [
        3,
        27
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Ste._Genevieve%2C_Missouri",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The Louis Bolduc House, built in 1792, is one of the oldest structures in town and a National Historic Landmark.",
      "sourceSentenceIds": [
        1,
        7
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Ste._Genevieve%2C_Missouri",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The Genevieve National Historical Park preserves the town’s colonial heritage and is the 422nd unit of the National Park Service.",
      "sourceSentenceIds": [
        9,
        16
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 2"
      ],
      "source": "https://en.wikipedia.org/wiki/Ste._Genevieve%2C_Missouri",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The Genevieve–Modoc Ferry, nicknamed the “French Connection,” links the town across the Mississippi to Illinois.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Ste._Genevieve%2C_Missouri",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The town’s early economy relied on river trade, with ferries connecting to nearby French colonial sites like Fort de Chartres.",
