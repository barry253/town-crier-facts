  "facts": [
    {
      "id": 1,
      "text": "Stites was founded in 1899 when the Stites Townsite Company platted the area, naming it after homesteader Jacob Stites.",
      "sourceSentenceIds": [
        1,
        3
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/stites_idaho",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Stites became the eastern terminus of the Northern Pacific Clearwater branch in 1900, later part of the Camas Prairie Railroad.",
      "sourceSentenceIds": [
        6,
        10,
        11
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Stites%2C_Idaho",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Stites sits in a rugged canyon of the South Fork Clearwater River, a key drainage feature of the subbasin.",
      "sourceSentenceIds": [
        4,
        28
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/stites_idaho",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "In 1936, the Salmon River bridge was relocated to Stites, boosting local connectivity.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/stites_idaho",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Today Stites is a hub for outdoor recreation, offering fishing, boating, hiking along the Clearwater River and supporting small‑scale agriculture and tourism.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/stites_idaho",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "At the turn of the 20th century, Stites served as a transportation hub for the upper Clearwater gold country and Camas Prairie farmers and ranchers.",
      "sourceSentenceIds": [
        12
      ],
