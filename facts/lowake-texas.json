  "facts": [
    {
      "id": 1,
      "text": "Lowake sprang up in 1909 when the Concho, San Saba, and Llano Valley Railway cut a line between Miles and Paint Rock, placing the town midway.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Lowake%2C_Texas"
    },
    {
      "id": 2,
      "text": "The town’s name honors two local farmers, Lowe and Schlake, who donated the land that became the original townsite.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.tshaonline.org/handbook/entries/lowake-tx"
    },
    {
      "id": 3,
      "text": "Lowake sits where Farm to Market Roads 381 and 1929 cross the Concho River, nine miles northwest of Paint Rock.",
      "sourceSentenceIds": [
        29
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Lowake%2C_Texas"
    },
    {
      "id": 4,
      "text": "A post office opened in Lowake the same year the town was founded, 1909.",
      "sourceSentenceIds": [
        20
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Lowake%2C_Texas"
    },
    {
      "id": 5,
      "text": "In 1936 Lowake operated its own school, serving students from first grade through high school juniors by 1940.",
      "sourceSentenceIds": [
        30
      ],
