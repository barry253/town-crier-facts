  "facts": [
    {
      "id": 1,
      "text": "Fort Chiswell got its name from a frontier fort erected in 1758 as an outpost during the French and Indian War.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Fort_Chiswell%2C_Virginia",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "During the American Revolution, the fort guarded a small lead deposit used to mold bullets for the Continental Army.",
      "sourceSentenceIds": [
        13
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Fort_Chiswell%2C_Virginia",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "After the county seat moved to Wytheville, the fort fell into disrepair and its buildings were abandoned in the late 18th century.",
      "sourceSentenceIds": [
        14
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Fort_Chiswell%2C_Virginia",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "In the 1970s, construction of I‑77 buried the remaining foundations of the fort and its surrounding structures.",
      "sourceSentenceIds": [
        15
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Fort_Chiswell%2C_Virginia",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The Fort Chiswell Site, the Mansion at Fort Chiswell, and the McGavock Family Cemetery are all listed on the National Register of Historic Places.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Fort_Chiswell%2C_Virginia",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The original fort stood at the junction of the Great Trading Path and the Richmond Road, near the New River.",
      "sourceSentenceIds": [
        13
