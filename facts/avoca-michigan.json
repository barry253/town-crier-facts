  "facts": [
    {
      "id": 1,
      "text": "Avoca was named after James Abbott, who owned the early mills that sparked the settlement.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Kenockee_Township%2C_Michigan",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town once hosted a Port Huron and Northwestern Railway station, later part of the Pere Marquette Railroad, serving passengers and mail.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Kenockee_Township%2C_Michigan",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "In 1816 Ignace Morass erected a sawmill on Mill Creek off the Pine River, laying the town’s industrial roots.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://kenockeetownshipmi.gov/about/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "A post office operated in Avoca from May 1892 until March 1942, marking a key era of local communication.",
      "sourceSentenceIds": [
        17
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Kenockee_Township%2C_Michigan",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Located on M‑136, Avoca lies roughly 15 miles northwest of Port Huron in St. Clair County.",
