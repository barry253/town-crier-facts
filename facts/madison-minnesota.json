  "facts": [
    {
      "id": 1,
      "text": "Madison was platted in 1884 and named after Madison, Wisconsin, in the heart of Lac qui Parle County.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Madison%2C_Minnesota",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Madison secured county seat status in 1886 after a contest with Lac qui Parle Village, prompting the Independent Press to relocate.",
      "sourceSentenceIds": [
        6,
        7
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/madison_minnesota",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The Minneapolis and St. Louis Railroad line through the area in late 1884 spurred the platting of Madison.",
      "sourceSentenceIds": [
        8,
        9,
        10
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/madison_minnesota",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Multiple devastating fires in the late 19th and early 20th centuries prompted Madison to rebuild with durable brick buildings.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/madison_minnesota",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Madison proclaims itself the lutefisk capital of the USA in the Midwest.",
      "sourceSentenceIds": [
        16
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Madison%2C_Minnesota",
