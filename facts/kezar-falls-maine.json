  "facts": [
    {
      "id": 1,
      "text": "George Kezar, an 18th-century settler, built a rock-to-rock footbridge across the Ossipee River, giving Kezar Falls its name.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://winslowmaine.org/exploring-the-hidden-gems-of-kezar-falls-maine-a-comprehensive-guide-to-discover-this-charming-city",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The Porter–Parsonsfield Covered Bridge, a graceful wooden bridge over the Ossipee River, dates to 1876, was restored in 1999, and is on the National Register.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://winslowmaine.org/exploring-the-hidden-gems-of-kezar-falls-maine-a-comprehensive-guide-to-discover-this-charming-city",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "In the 19th century, Kezar Falls powered water-driven mills and factories, turning the village into a bustling industrial hub with Main Street shops.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://winslowmaine.org/exploring-the-hidden-gems-of-kezar-falls-maine-a-comprehensive-guide-to-discover-this-charming-city",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Kezar Falls was incorporated as the Porter Kezar Falls Village Corporation within the Town of Porter by the Maine Legislature.",
      "sourceSentenceIds": [
        29
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Kezar_Falls%2C_Maine",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Today the Porter–Parsonsfield Bridge is preserved as one of Maine’s last covered bridges and a popular spot for photographers.",
