    {
      "id": 2,
      "text": "Marshall Herbert John Green named Wakita after a local Cherokee chief who supposedly cast a spell to protect the area from tornadoes.",
      "sourceSentenceIds": [
        8,
        9,
        11
      ],
      "sourceLabels": [
