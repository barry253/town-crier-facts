      "quality": "good"
    },
    {
      "id": 2,
      "text": "The Galleria’s Polar Ice rink, built in 1970, was the first indoor ice rink ever constructed inside a mall.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
