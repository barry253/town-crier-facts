    {
      "id": 1,
      "text": "Tionesta means “home of the wolves,” a name derived from a Native American word.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Tionesta%2C_Pennsylvania",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town sits on the Wild & Scenic Allegheny River, where the river and Tionesta Creek meet in a picturesque confluence.",
      "sourceSentenceIds": [
        23,
        30
      ],
      "sourceLabels": [
        "Web source 1",
        "Web source 2"
      ],
      "source": "https://www.visitpa.com/explore/regions/pennsylvania-wilds/tionesta/",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Tionesta hosts Pennsylvania’s only inland functioning lighthouse, open for tours several times a year.",
      "sourceSentenceIds": [
        24
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.visitpa.com/explore/regions/pennsylvania-wilds/tionesta/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Every July, cowboys and cowgirls compete in a three‑night Allegheny Mountain Championship Rodeo that draws regional crowds.",
      "sourceSentenceIds": [
        24
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.visitpa.com/explore/regions/pennsylvania-wilds/tionesta/",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "August features the Tionesta Indian Festival, celebrating the town’s Native American heritage with music, food, and storytelling.",
      "sourceSentenceIds": [
        24
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.visitpa.com/explore/regions/pennsylvania-wilds/tionesta/",
      "category": "culture",
      "quality": "good"
    },
