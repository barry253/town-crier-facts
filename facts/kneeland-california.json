    {
      "id": 1,
      "text": "Kneeland was named after John Kneeland, an early settler who arrived mid‑19th century.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://facts.net/history/people/25-facts-about-kneeland/"
    },
    {
      "id": 2,
      "text": "The area was originally inhabited by the Wiyot tribe, who lived along rivers and coastal areas of Humboldt County.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://facts.net/history/people/25-facts-about-kneeland/"
    },
    {
      "id": 3,
      "text": "Kneeland’s schoolhouse, built in 1895, still stands today as a reminder of the area's educational history.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://facts.net/history/people/25-facts-about-kneeland/"
    },
    {
      "id": 4,
      "text": "The Kneeland post office operated from 1880 to 1891 and from 1892 until 2011, when it was slated for closure by USPS.",
      "sourceSentenceIds": [
        29
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Kneeland%2C_California"
    },
    {
      "id": 5,
      "text": "Kneeland sits 2,129 feet above sea level, about 12 miles east of Humboldt Bay and roughly midway between Eureka and Arcata.",
      "sourceSentenceIds": [
        14,
        15
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Kneeland%2C_California"
    },
    {
      "id": 6,
      "text": "The region experiences warm, dry summers with no average monthly temperatures above 71.6°F, while light snowfall is typical several times a year due to higher elevation.",
