  "facts": [
    {
      "id": 1,
      "text": "Brighton‑Le‑Sands was originally called Seven Mile Beach, renamed Lady Robinsons Beach in 1874 to honor Governor Sir Hercules Robinson's wife.",
      "sourceSentenceIds": [
        7,
        27
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Brighton-Le-Sands%2C_New_South_Wales"
    },
    {
      "id": 2,
      "text": "In 1885 Thomas Saywell built a steam tramway from Rockdale station to the beach, later electrified in 1900 and closed in 1949.",
      "sourceSentenceIds": [
        20
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/history_of_brighton_le_sands_new_south_wales"
    },
    {
      "id": 3,
      "text": "The Grand Parade runs along the foreshore and meets Bay Street at Brighton‑Le‑Sands' commercial centre, a historic hub for seaside visitors.",
      "sourceSentenceIds": [
        25
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Brighton-Le-Sands%2C_New_South_Wales"
    },
    {
      "id": 4,
      "text": "Brighton‑Le‑Sands hosted a weekend ferry service starting in 1903, linking it with Kurnell, Sans Souci, and La Perouse.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Brighton-Le-Sands%2C_New_South_Wales"
    },
    {
      "id": 5,
      "text": "The New Brighton Hotel, opened in the 1880s, briefly housed Scots College and later hosted boxer Peter Jackson, reflecting the suburb's early social scene.",
      "sourceSentenceIds": [
        14
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/history_of_brighton_le_sands_new_south_wales"
    }
  ]
