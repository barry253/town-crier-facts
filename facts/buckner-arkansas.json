  "facts": [
    {
      "id": 1,
      "text": "Buckner was founded in 1883 and incorporated May 11, 1885, as a station town on the Cotton Belt Railroad.",
      "sourceSentenceIds": [
        3,
        9
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/buckner_arkansas",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The Cotton Belt line turned Buckner into a key stop for logging, moving pine and hardwood from southern Arkansas forests.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/buckner_arkansas",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Buckner’s climate features hot, humid summers and mild to cool winters, with a growing season from mid‑March to mid‑November.",
      "sourceSentenceIds": [
        15,
        4
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/buckner_arkansas",
      "category": "nature",
      "quality": "poor",
      "qualityReason": "vague"
    },
    {
      "id": 4,
      "text": "The county’s soils are deep sand‑clay mixtures, often reddish or yellowish, supporting cotton and other crops.",
      "sourceSentenceIds": [
        11
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/buckner_arkansas",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The 1930s droughts devastated Buckner’s farming, causing crop failures and economic strain in the rural community.",
