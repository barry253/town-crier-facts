  "facts": [
    {
      "id": 1,
      "text": "Pipersville grew around a tavern built in 1759 by Joseph Bladen at the crossroads of Durham and Philadelphia‑Easton roads.",
      "sourceSentenceIds": [
        12,
        14,
        15
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/pipersville_pennsylvania",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Colonel George Piper bought the tavern in 1778, renamed it after himself, and the surrounding settlement adopted the name Pipersville.",
      "sourceSentenceIds": [
        3,
        16
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/pipersville_pennsylvania",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The tavern hosted figures like Benjamin Franklin and even exiled king Joseph Bonaparte, making it a hub for early American politics.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/pipersville_pennsylvania",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Pipersville sits at the intersection of Pennsylvania Routes 413 and 611, a junction that has linked Philadelphia to the interior since colonial times.",
      "sourceSentenceIds": [
        9,
        26
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Pipersville%2C_Pennsylvania",
      "category": "other",
      "quality": "poor",
      "qualityReason": "location_description"
    },
    {
      "id": 5,
      "text": "The community’s economy historically relied on agriculture and roadside services, with many farms protected by conservation easements that limit development.",
      "sourceSentenceIds": [
        7,
        10
      ],
      "sourceLabels": [
        "Web source 1",
        "Wikipedia"
      ],
      "source": "https://grokipedia.com/page/pipersville_pennsylvania",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "During the 19th century, mills powered by Tohickon Creek supplied flour, meal, feed, and lumber to local farmers, sustaining the area for over a century.",
      "sourceSentenceIds": [
        18,
        19,
        20
      ],
