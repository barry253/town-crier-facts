  "facts": [
    {
      "id": 1,
      "text": "Mission's name comes from the nearby St. Mary's Mission founded by Oblates in 1868.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Mission%2C_British_Columbia",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The city’s coat of arms features a Mission cross, symbolizing crossroads, history, and forest wealth.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.mission.ca/community-environment/about-mission",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "In 1893, Harry Brown French founded the Mission Regional Chamber of Commerce, marking the town’s early commercial growth.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Mission%2C_British_Columbia",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Mission sits at the junction of the Canadian Pacific Railway mainline and a northward Burlington Northern extension, once called a new metropolis.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Mission%2C_British_Columbia",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "A historic Chinatown emerged after the 1894 flood when abandoned lots were taken over by Chinese merchants, lasting until the 1920s.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Mission%2C_British_Columbia",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The Mission Museum preserves local history, offering exhibits that trace the city’s evolution from Stó:lō lands to a modern community.",
      "sourceSentenceIds": [
        20
      ],
      "sourceLabels": [
        "Web source 2"
      ],
