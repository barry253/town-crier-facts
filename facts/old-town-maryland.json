  "facts": [
    {
      "id": 1,
      "text": "Oldtown was originally called \"Shawanese Old Town\" after a Shawnee village abandoned a decade earlier.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://alchetron.com/Oldtown%2C-Maryland",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Opessa Street honors Shawnee leader King Opessa, linking the town’s name to its Native American roots.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.canaltrust.org/discoveryarea/oldtown/",
      "category": "people",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The Chesapeake and Ohio Canal’s Lockhouse 70 in Oldtown overlooks a five‑mile stretch of canal to the Town Creek Aqueduct.",
      "sourceSentenceIds": [
        13
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.canaltrust.org/discoveryarea/oldtown/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Thomas Cresap opened a trading post in 1741 at the abandoned Shawnee village, sparking Oldtown’s early commerce.",
      "sourceSentenceIds": [
        16
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://alchetron.com/Oldtown%2C-Maryland",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The town’s historic Michael Cresap house sits beside the bridge crossing Lock 70, a reminder of early frontier life.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.canaltrust.org/discoveryarea/oldtown/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Oldtown’s hidden treasure status comes from its preserved canal scenery and the nearby abandoned railroad bridge east of Lock 68.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 1"
      ],
