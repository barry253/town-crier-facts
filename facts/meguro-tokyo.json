    {
      "id": 1,
      "text": "Meguro ward was founded on March 15, 1947 in the post‑war era.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Meguro",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Ryusen‑ji Temple, also called Meguro Fudo, dates back to 808 and gives the ward its name.",
      "sourceSentenceIds": [
        4,
        8,
        9
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.tsunagujapan.com/20-must-visit-spots-meguro-tokyo/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The Meguro River’s paper lanterns light up during the Nakameguro Sakura Festival, where locals feast under cherry blossoms.",
      "sourceSentenceIds": [
        11
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.gotokyo.org/en/spot/103/index.html",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Nakameguro Station, served by Tokyu Toyoko and Tokyo Metro Hibiya, is the gateway to the trendy riverside cafés and cherry‑blossom views.",
      "sourceSentenceIds": [
        21
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.tsunagujapan.com/20-must-visit-spots-meguro-tokyo/",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The Meguro Sky Garden is a 35‑meter‑high linear roof garden that spirals above two expressways.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Meguro",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The ward hosts the Tokyo Metropolitan Museum of Photography and the Meguro Museum of Art, showcasing contemporary and photographic works.",
      "sourceSentenceIds": [
