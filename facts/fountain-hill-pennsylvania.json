  "facts": [
    {
      "id": 1,
      "text": "Fountain Hill’s name comes from the 1846 Fontainebleau estate, whose springs inspired the town’s name.",
      "sourceSentenceIds": [
        27
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Fountain_Hill%2C_Pennsylvania",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The 147‑acre Hoffert Farm, once the largest tenant farm, was sold to the Moravians in 1743.",
      "sourceSentenceIds": [
        19,
        2
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Fountain_Hill%2C_Pennsylvania",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The oldest standing building in Fountain Hill is a 1755 farmhouse built by Cornelius Weygandt.",
      "sourceSentenceIds": [
        20
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Fountain_Hill%2C_Pennsylvania",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "In 1886, Fountain Hill joined the Industrial Revolution with several silk mills, a first for the area.",
      "sourceSentenceIds": [
        28
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Fountain_Hill%2C_Pennsylvania",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The Sayre Mansion Inn, an 18‑room historic hotel, once housed Lehigh Valley Railroad engineer Sayre and now preserves 19th‑century charm.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.fountainhill.org/about-fountain-hill/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Fountain Hill became an incorporated borough on November 13, 1893, after a successful petition to Lehigh County.",
