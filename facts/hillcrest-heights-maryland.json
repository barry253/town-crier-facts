  "facts": [
    {
      "id": 1,
      "text": "Hillcrest Heights grew from the 18th‑century Colebrook estate, later owned by Thomas Dent and William Hatton in 1671 and Colonel John Addison in 1688.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Hillcrest_Heights%2C_Maryland",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The neighborhood’s post‑World War II boom turned former woodland of the Colebrooke plantation into a model of FHA‑influenced suburban planning.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/hillcrest_heights_maryland",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The Hillcrest Heights Library, opened in 1976, remains a community hub that reflects the area’s long‑standing emphasis on family‑oriented living.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/hillcrest_heights_maryland",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Historically, the Piscataway people inhabited the land that is now Hillcrest Heights before European colonization in the mid‑17th century.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/hillcrest_heights_maryland",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Demographically, Hillcrest Heights is predominantly Black or African American, a pattern rooted in its history as affordable housing for federal employees and veterans.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/hillcrest_heights_maryland",
      "category": "people",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The neighborhood’s single‑family rambler and duplex homes, built in the 1950s and 1960s, give Hillcrest Heights its classic mid‑century suburban look.",
      "sourceSentenceIds": [
        11
      ],
