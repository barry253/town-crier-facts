  "facts": [
    {
      "id": 1,
      "text": "Grant began in 1925 as a fishing village, where early settlers also grew crops along the Indian River Lagoon.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Grant-Valkaria%2C_Florida"
    },
    {
      "id": 2,
      "text": "The Town of Grant‑Valkaria was officially incorporated on July 25, 2006, merging the historic communities of Grant and Valkaria.",
      "sourceSentenceIds": [
        20
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Grant-Valkaria%2C_Florida"
    },
    {
      "id": 3,
      "text": "The Bensen House, a 19th‑century landmark, now serves as the town’s historic museum and a reminder of Grant’s early days.",
      "sourceSentenceIds": [
        5,
        7
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Grant-Valkaria%2C_Florida"
    },
    {
      "id": 4,
      "text": "Fisherman’s Landing Park hosts the Grant Depot and Bensen House, offering a riverside stroll back to the town’s maritime roots.",
      "sourceSentenceIds": [
        7,
        8
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://granthistoricalhouse.com/"
    },
    {
      "id": 5,
      "text": "During Prohibition, bootleggers used boats from Cuba and the Bahamas to deliver liquor to Grant, where they loaded custom Cadillacs to transport contraband north.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grantcommunitycenter.com/welcome-home/grant-historical-society/our-history/"
    },
    {
      "id": 6,
      "text": "The first train arrived in Grant in November 1893, sparking the construction of Grant Station and linking the town to the regional rail network.",
      "sourceSentenceIds": [
        13
      ],
