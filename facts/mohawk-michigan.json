  "facts": [
    {
      "id": 1,
      "text": "Mohawk was named after the Mohawk native tribe and once housed the Wolverine–Mohawk Mining Company’s copper mine founded in 1898.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://lakesuperiorcircletour.info/location/mohawk/"
    },
    {
      "id": 2,
      "text": "The Ahmeek Streetcar Station, built in 1900 for the Houghton County Traction Company, once ran tracks to Calumet, Lake Linden, and Hubbell.",
      "sourceSentenceIds": [
        7,
        8
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.visitkeweenaw.com/blog/post/your-guide-to-exploring-mohawk-area/"
    },
    {
      "id": 3,
      "text": "Mohawkite, a rare mineral, is believed to have been found only in the Mohawk Mine, making the town a unique geological site.",
      "sourceSentenceIds": [
        15,
        20
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Mohawk%2C_Michigan"
    },
    {
      "id": 4,
      "text": "The massive cliff ridge of the Cliff Range dominates the Keweenaw Peninsula, standing tall as you drive through Mohawk.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.visitkeweenaw.com/blog/post/your-guide-to-exploring-mohawk-area/"
    },
    {
      "id": 5,
      "text": "Cliff Drive marks the former Cliffton Mining Community, with markers that detail the operations of the historic Cliff Mine.",
      "sourceSentenceIds": [
