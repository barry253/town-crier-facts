      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The Chicago & North Western Railway ran through Le Grand in 1863, spurring growth.",
      "sourceSentenceIds": [
        8,
        17
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/le_grand_iowa",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Le Grand’s limestone quarries supplied stone for the Marshall County Courthouse and the Iowa State Historical Building.",
      "sourceSentenceIds": [
        11,
