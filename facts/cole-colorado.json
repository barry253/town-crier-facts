      ],
      "source": "https://www.coledenver.org/history",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The Wyatt School, a clean‑brick landmark built in 1887, still stands at 3620 Franklin St. as a testament to Cole’s early education history.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 1"
      ],
