      "qualityReason": "dropped_surname_no_wiki_source"
    },
    {
      "id": 4,
      "text": "Cole was an early Denver Public Schools superintendent who pioneered the city’s junior high model, influencing education nationwide.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.coledenver.org/history",
      "category": "people",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The 1888 Swedish Evangelical Lutheran Church was later repurposed into housing, reflecting Cole’s adaptive reuse of historic buildings.",
      "sourceSentenceIds": [
