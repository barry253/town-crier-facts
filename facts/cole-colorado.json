      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Cole’s name honors Carlos M., a pioneer who helped shape the neighborhood’s identity in the late 19th century.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
