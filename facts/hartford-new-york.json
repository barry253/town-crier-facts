  "facts": [
    {
      "id": 1,
      "text": "Hartford began as part of a 26,000‑acre Provincial Patent granted to 26 New York Infantry officers after the French and Indian War.",
      "sourceSentenceIds": [
        6,
        13
      ],
      "sourceLabels": [
        "Web source 1",
        "Web source 2"
      ],
      "source": "https://www.hartfordny.gov/history/"
    },
    {
      "id": 2,
      "text": "The town’s name comes from the old Charlotte County, renamed Washington County following the American Revolution.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.hartfordny.gov/history/"
    },
    {
      "id": 3,
      "text": "The Elisha Straight House, once a Union Army recruitment center, now houses Hartford Museum and its Civil War exhibits.",
      "sourceSentenceIds": [
        21,
        26
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://washingtoncounty.fun/our-county/hartford-ny/"
    },
    {
      "id": 4,
      "text": "Hartford Baptist Church & Cemetery, a Victorian Gothic church, contains graves of early settlers and Revolutionary War veterans.",
      "sourceSentenceIds": [
        21,
        25
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://washingtoncounty.fun/our-county/hartford-ny/"
    },
    {
      "id": 5,
      "text": "Rolling hills and dairy farms make Hartford a popular agritourism spot, featuring small farms, vineyards, and craft food stands.",
      "sourceSentenceIds": [
