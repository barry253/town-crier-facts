  "facts": [
    {
      "id": 1,
      "text": "Duquesne takes its name from Fort Duquesne, the French fort that once guarded the Monongahela River.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Duquesne%2C_Pennsylvania"
    },
    {
      "id": 2,
      "text": "In the early 1900s, Duquesne housed the world’s largest blast furnace, the Dorothy Six, powering the region’s steel boom.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Duquesne%2C_Pennsylvania"
    },
    {
      "id": 3,
      "text": "The historic Duquesne Incline, a cable car that climbs the river bluff, still offers panoramic views of Pittsburgh today.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.trawellino.com/destinations/united-states/pennsylvania_duquesne"
    },
    {
      "id": 4,
      "text": "Duquesne’s African American community grew during the Great Migration and the town was a key stop on the Underground Railroad.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.trawellino.com/destinations/united-states/pennsylvania_duquesne"
    },
    {
      "id": 5,
      "text": "Located just 12 miles south of Pittsburgh, Duquesne sits along the Monongahela River, a vital artery for early trade.",
      "sourceSentenceIds": [
        18
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Duquesne%2C_Pennsylvania"
    },
    {
      "id": 6,
      "text": "Founded in 1789 and incorporated in 1891, Duquesne evolved from a frontier settlement into a steel‑industry hub before its post‑industrial rebirth.",
      "sourceSentenceIds": [
        11
      ],
