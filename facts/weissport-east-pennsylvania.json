  "facts": [
    {
      "id": 1,
      "text": "Founded 1792 by Colonel Jacob Weiss, the borough quickly became a hub for canal boat construction and repair along the Lehigh Canal.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://weissportborough.com/front-page/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "By 1832, Weissport East was a major center for boat building, serving the Lehigh Coal and Navigation Company and the Morris Canal & Banking Company.",
      "sourceSentenceIds": [
        18
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://weissportborough.com/front-page/",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The borough sits on the east side of the Lehigh River, covering about 0.16 square miles of which 0.14 is land.",
      "sourceSentenceIds": [
        19
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://weissportborough.com/front-page/",
      "category": "other",
      "quality": "poor",
      "qualityReason": "vague"
    },
    {
      "id": 4,
      "text": "Route 209 runs through Weissport East, meeting Interstate 476 just east of town and leading toward the Lehigh Valley.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Weissport_East%2C_Pennsylvania",
      "category": "transport",
      "quality": "poor",
      "qualityReason": "route_only"
    },
    {
      "id": 5,
      "text": "The Lehigh River and the D&L Trail make Weissport East a favorite spot for history enthusiasts and nature lovers alike.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://weissportborough.com/front-page/",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Weissport East borders the borough of Weissport to the west, the Lehigh River to the southwest, and Pohopoco Creek to the south.",
      "sourceSentenceIds": [
        7
      ],
