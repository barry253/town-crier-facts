  "facts": [
    {
      "id": 1,
      "text": "Hayward was incorporated on March 11 1876 and was originally called “Haywards” after the landmark hotel that drew early travelers.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.hayward-ca.gov/discover/hayward-history",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The city’s name shifted from “Hayward’s” to “Haywood,” then “Haywards,” before settling on Hayward in 1911.",
      "sourceSentenceIds": [
        19
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Hayward%2C_California",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Hayward’s historic City Hall sits atop a fault line and was closed after seismic damage from gradual activity.",
      "sourceSentenceIds": [
        29
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Hayward%2C_California",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The Oakes Hotel, once a modest inn, became Hayward’s cultural hub with a stage and scenery for balls and theatrical performances.",
      "sourceSentenceIds": [
        26
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.hayward-ca.gov/discover/hayward-history",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Agapius Honcharenko’s Ukraina Ranch is California’s only historical landmark owned by a Ukrainian patriot and Greek Orthodox priest.",
