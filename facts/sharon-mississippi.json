  "facts": [
    {
      "id": 1,
      "text": "Sharon grew in the antebellum era and was named after the Sharon United Methodist Church, organized in 1835, whose current building dates to 1892.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/sharon_madison_county_mississippi",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "In the 19th century, Sharon became an educational hub, hosting the Sharon Female College founded in 1837 and a boys’ school, both later merged and moved elsewhere.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/sharon_madison_county_mississippi",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "To the west of Sharon lies the Big Black River, a major tributary of the Mississippi, about 10‑15 miles away, shaping historic travel routes.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/sharon_madison_county_mississippi",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Sharon is an unincorporated rural settlement with no formal municipal government, centered around a historic core that includes homes, farms, and community institutions.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/sharon_madison_county_mississippi",
      "category": "other",
      "quality": "poor",
      "qualityReason": "other"
    },
    {
      "id": 5,
      "text": "Adjacent to the church lies a cemetery established by 1838, holding graves of early settlers and notable families like the Byars and Divines, reflecting Methodist heritage.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/sharon_madison_county_mississippi",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "In the heart of Mississippi lies Sharon, a community where genuine Southern hospitality thrives and small-town charm abounds.",
