  "facts": [
    {
      "id": 1,
      "text": "Kutztown University began in 1866 as the Keystone State Normal School, with its first classes held in what is now Old Main.",
      "sourceSentenceIds": [
        1,
        21
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Kutztown_University"
    },
    {
      "id": 2,
      "text": "In 1928 the school was renamed Kutztown State Teachers College and became the first institution in the area to award bachelor’s degrees.",
      "sourceSentenceIds": [
        10,
        11,
        12
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1",
        "Web source 2"
      ],
      "source": "https://en.wikipedia.org/wiki/Kutztown_University"
    },
    {
      "id": 3,
      "text": "On July 1, 1983 the campus was designated Kutztown University of Pennsylvania and joined the Pennsylvania State System of Higher Education.",
      "sourceSentenceIds": [
        17,
        18,
        23
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Kutztown_University"
    },
    {
      "id": 4,
      "text": "Old Main, the campus’s oldest building, still houses classrooms and the university’s original administrative offices.",
      "sourceSentenceIds": [
        21,
        1
      ],
      "sourceLabels": [
