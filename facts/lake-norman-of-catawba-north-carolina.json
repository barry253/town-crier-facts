  "facts": [
    {
      "id": 1,
      "text": "Lake Norman is North Carolina’s largest man‑made lake, created by damming the Catawba River in the 1960s.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://lakenorman.com/the-history-of-lake-norman-from-creation-to-a-thriving-community/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The lake’s name honors Queen Charlotte, wife of King George III, reflecting colonial ties.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://lakenorman.com/the-history-of-lake-norman-from-creation-to-a-thriving-community/",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Before the dam, the area hosted thriving communities; families from Charlotte packed station wagons to build homes on its shores.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://lakenorman.com/the-history-of-lake-norman-from-creation-to-a-thriving-community/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Duke Energy’s Marshall Steam Station, a coal plant, sits just northeast of downtown Terrell on Lake Norman’s western shore.",
      "sourceSentenceIds": [
        15
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Lake_Norman_of_Catawba%2C_North_Carolina",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "In 2014, Duke Energy dumped coal ash into Lake Norman to repair a leaking pipe, raising environmental concerns.",
      "sourceSentenceIds": [
        16
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Lake_Norman_of_Catawba%2C_North_Carolina",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "A sinkhole appeared at the base of the Marshall Steam Station dam in 2015, prompting repairs.",
      "sourceSentenceIds": [
        17
      ],
