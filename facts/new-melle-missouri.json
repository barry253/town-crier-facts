  "facts": [
    {
      "id": 1,
      "text": "New Melle was named after Melle, Germany, where many of its first settlers came from in 1839.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/New_Melle%2C_Missouri",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Immigrants traveled west along the Booneslick Trail, then south to a high point that reminded them of home and named it New Melle.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.cityofnewmelle.com/city-history",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The Stahlhuth Brick Factory operated in New Melle during the late 19th century.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://boonecountryconnection.com/featured-stories/6935-more-new-melle-history",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Paul Lutheran Church, founded in 1844, now sits on the National Register of Historic Places.",
      "sourceSentenceIds": [
        15,
        8
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/New_Melle%2C_Missouri",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The Boone‑Duden Historical Society Museum on Mill Street houses archives that chronicle New Melle’s past.",
