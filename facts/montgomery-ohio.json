  "facts": [
    {
      "id": 1,
      "text": "Montgomery was first settled in 1795 by six families from Orange County, New York, who named the village after their hometown.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.montgomeryohio.gov/historic-landmarks/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "In 1802, Revolutionary War veteran Nathaniel Terwilliger laid out the town that would become Montgomery.",
      "sourceSentenceIds": [
        26
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Montgomery%2C_Ohio",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The village grew into a coach stop on the Cincinnati–Zanesville Road, featuring an inn, two taverns, a grist mill and a carding mill.",
      "sourceSentenceIds": [
        28
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Montgomery%2C_Ohio",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The Montgomery Landmarks Commission, formed in 1976, now protects 32 historic sites that tell the city’s story.",
      "sourceSentenceIds": [
        15,
        19
      ],
      "sourceLabels": [
        "Web source 1",
        "Web source 2"
      ],
      "source": "https://www.montgomeryohio.gov/historic-landmarks/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "In 1986, Montgomery withdrew from Symmes Township, creating a paper township that later became the city’s official boundaries.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Montgomery%2C_Ohio",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "During the COVID‑19 pandemic, Montgomery staged a “reverse parade” on July 4, 2020, letting cars drive past while residents stayed inside to celebrate safely.",
      "sourceSentenceIds": [
