  "facts": [
    {
      "id": 1,
      "text": "Fort McKavett was established in 1852 to protect West Texas settlers and serve as a rest stop for California-bound immigrants.",
      "sourceSentenceIds": [
        27
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.battlefields.org/visit/heritage-sites/fort-mckavett-state-historic-site"
    },
    {
      "id": 2,
      "text": "The post was briefly used as a Civil War prisoner‑of‑war camp before Texans abandoned it in April 1862.",
      "sourceSentenceIds": [
        24
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://thc.texas.gov/state-historic-sites/fort-mckavett/fort-mckavett-history"
    },
    {
      "id": 3,
      "text": "In 1859, declining Native American hostilities and a shift to a southerly California route caused Fort McKavett to be abandoned.",
      "sourceSentenceIds": [
        23
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://thc.texas.gov/state-historic-sites/fort-mckavett/fort-mckavett-history"
    },
    {
      "id": 4,
      "text": "The 10th Cavalry withdrew in 1878 after the Lipan Apache were defeated, ending the fort’s strategic role.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Fort_McKavett_State_Historic_Site"
    },
    {
      "id": 5,
      "text": "The Texas Historical Commission designated the site a state historic site on May 17, 1968, preserving its legacy for future generations.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://thc.texas.gov/state-historic-sites/fort-mckavett/fort-mckavett-history"
    },
    {
      "id": 6,
      "text": "Fort McKavett was added to the National Register of Historic Places on July 14, 1971, after preservation began in 1968.",
      "sourceSentenceIds": [
        11
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Fort_McKavett_State_Historic_Site"
