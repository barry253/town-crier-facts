  "facts": [
    {
      "id": 1,
      "text": "Rock Point was named for the rockfish, or striped bass, that were once abundant in its waters.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Rock_Point%2C_Maryland",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town sits near Cobb Island at the mouth of the Wicomico River, a key spot for early maritime trade.",
      "sourceSentenceIds": [
        17
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Rock_Point%2C_Maryland",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "In the early 1900s, Rock Point hosted a large hotel, a steamboat wharf, and a general store that drew vacationers and hunters alike.",
      "sourceSentenceIds": [
        18
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Rock_Point%2C_Maryland",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "An oyster shucking and packing plant operated here, turning the area into a seasonal hub for finfish, oysters, and crabs shipped to Washington and Baltimore.",
      "sourceSentenceIds": [
        20
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Rock_Point%2C_Maryland",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "During the Civil War, Confederate activity centered in Rock Point, and Union troops occupied the town for 300 days.",
      "sourceSentenceIds": [
        22
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Rock_Point%2C_Maryland",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Rock Point’s early economy relied on fishing and seasonal tourism, a pattern that shaped its development before the rise of modern vacation land.",
      "sourceSentenceIds": [
