  "facts": [
    {
      "id": 1,
      "text": "Originally platted around 1873 and first named Viroqua, the town was renamed Morley in 1886, reflecting its origins as a key stop for agricultural transport in the region.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/morley_iowa",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The railroad's arrival facilitated the town's platting in 1873, establishing it as a key station along the route and enabling transportation infrastructure in a rural area.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/morley_iowa",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Morley sits amid rolling farmland and lies near the Wapsipinicon River valley, whose meandering course shapes the local lowlands.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/morley_iowa",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The local economy revolves around agriculture, with residents historically focused on corn, livestock, and dairy farming, supported by the area's fertile lands and proximity to transportation routes.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/morley_iowa",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Morley's community library, located on Vine Street, serves as a hub for local educational resources.",
      "sourceSentenceIds": [
        18
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/morley_iowa",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The settlement of what is now Morley, Iowa, occurred amid the broader pioneer expansion into eastern Iowa during the mid-19th century.",
      "sourceSentenceIds": [
        13
      ],
