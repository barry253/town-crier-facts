  "facts": [
    {
      "id": 1,
      "text": "Arnaudville earned its name in the 19th century when the Arnaud brothers donated land for a church that served both white and Black residents.",
      "sourceSentenceIds": [
        4,
        9
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Arnaudville%2C_Louisiana",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town sits on the site of an Attakapas Indian village and was first settled by French colonists in the late 18th century.",
      "sourceSentenceIds": [
        3,
        20
      ],
      "sourceLabels": [
        "Web source 1",
        "Wikipedia"
      ],
      "source": "https://grokipedia.com/page/arnaudville_louisiana",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The arrival of the railroad in 1870 connected Arnaudville to larger markets and shifted its economy beyond bayou trade.",
      "sourceSentenceIds": [
        13
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/arnaudville_louisiana",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Arnaudville hosts the Étouffée Festival each April, the Le Feu et l'Eau Rural Arts Celebration in December, and the Bayou Blues Revival in April.",
      "sourceSentenceIds": [
        28
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Arnaudville%2C_Louisiana",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Nearly forty percent of Arnaudville residents speak Cajun French at home, making it a vibrant hub for Creole, Cajun, and French arts.",
