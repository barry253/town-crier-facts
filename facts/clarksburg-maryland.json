  "facts": [
    {
      "id": 1,
      "text": "Clarksburg was named for trader John Clarke, established at intersection of main road between Georgetown and Frederick and an old Seneca trail.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Clarksburg%2C_Maryland",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "One of its earliest white inhabitants, Michael Ashford Dowden, built an inn on 'Hammer Hill' in 1754 that later hosted General Braddock’s army.",
      "sourceSentenceIds": [
        6,
        9
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Clarksburg%2C_Maryland",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The town’s historic inn served as a meeting place for Sons of Liberty before the Revolution and may have fed President Andrew Jackson en route to inauguration.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Clarksburg%2C_Maryland",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "In 2017, Damascus parents painted the town’s water tower with a green‑and‑gold “D” logo, turning a plain tower into a local landmark.",
