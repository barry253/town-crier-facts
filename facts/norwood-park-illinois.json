  "facts": [
    {
      "id": 1,
      "text": "Norwood Park got its name from Henry Ward Beecher’s 1868 novel 'Norwood,' but the 'Park' was added when another Illinois town already used Norwood.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Norwood_Park%2C_Chicago",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The Noble–Seymour–Crippen House, built in 1833, stands as Chicago’s oldest extant building and a centerpiece of Norwood Park’s historic district.",
      "sourceSentenceIds": [
        27
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Norwood_Park%2C_Chicago",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "In 1986 Chicago declared the Norwood Park Historic District, and in 1988 the Noble–Seymour–Crippen House became a city landmark.",
      "sourceSentenceIds": [
        11
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Norwood_Park%2C_Chicago",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Norwood Park’s strong Polish heritage has attracted new Polish immigrants in recent years, enriching the neighborhood’s cultural tapestry.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://chicago-beautiful.com/norwood-park/",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Union Ridge, one of Cook County’s highest points, borders Norwood Park and offers scenic views that have drawn visitors for generations.",
      "sourceSentenceIds": [
        17
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://chicago-beautiful.com/norwood-park/",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "William Howard Taft High School, completed in 1939, inspired the 1978 musical Grease and remains a local landmark.",
