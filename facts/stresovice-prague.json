      "id": 1,
      "text": "Střešovice houses the Prague Public Transport Museum inside its historic tram depot.",
      "sourceSentenceIds": [
        15
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/St%C5%99e%C5%A1ovice",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Střešovice earned the nickname 'local Beverly Hills' for homes of figures like Václav Havel.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/St%C5%99e%C5%A1ovice",
      "category": "people",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Villa Müller, a 1930 functionalist masterpiece by Adolf Loos, graces the neighborhood.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/St%C5%99e%C5%A1ovice",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The Church of St Norbert, built 1890‑91 in Romanesque Revival, is a key sight.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/St%C5%99e%C5%A1ovice",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Střešovice first appeared between the 10th and 11th centuries, belonging to the royal family until 1143.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
