    {
      "id": 1,
      "text": "Kill Buck, founded in 1818, takes its name from Seneca chief Daniel (or Dave) Kill Buck, who once led the village.",
      "sourceSentenceIds": [
        1,
        8
      ],
      "sourceLabels": [
        "Web source 1",
        "Wikipedia"
      ],
