  "facts": [
    {
      "id": 1,
      "text": "Kill Buck, founded in 1818, takes its name from Seneca chief Daniel (or Dave) Kill Buck, who once led the village.",
      "sourceSentenceIds": [
        1,
        8
      ],
      "sourceLabels": [
        "Web source 1",
        "Wikipedia"
      ],
      "source": "https://historicpath.com/seneca-nation-indians-tours-rt-219/kill-buck",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "In 1875, a Torge brewery opened, adding a splash of industry to the hamlet’s 19th‑century economy.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://historicpath.com/seneca-nation-indians-tours-rt-219/kill-buck",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Kill Buck’s post office began in 1836 and, after a long history, relocated to Salamanca in 1992.",
      "sourceSentenceIds": [
        3,
        17
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://historicpath.com/seneca-nation-indians-tours-rt-219/kill-buck",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The hamlet straddles a boundary: the north sits in Great Valley, the south lies within the Allegany Indian Reservation.",
      "sourceSentenceIds": [
        13
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Kill_Buck%2C_New_York",
      "category": "other",
      "quality": "poor",
      "qualityReason": "vague"
    },
    {
      "id": 5,
      "text": "Chief Kill Buck’s wigwam once marked the site where a 1856 Senear & Green store now stands.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://historicpath.com/seneca-nation-indians-tours-rt-219/kill-buck",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "In Seneca, Kill Buck translates literally to “it goes around stone,” hinting at the region’s rocky terrain.",
      "sourceSentenceIds": [
