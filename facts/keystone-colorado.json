      "quality": "good"
    },
    {
      "id": 3,
      "text": "The Old Town of Keystone was a timber town half a mile west of today’s resort, supplying lumber to homesteaders and railroads.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Web source 2"
