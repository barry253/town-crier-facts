    },
    {
      "id": 2,
      "text": "The Montpelier Mansion, once owned by Thomas Snowden, now serves as a museum open to the public in South Laurel.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 2"
      ],
