  "facts": [
    {
      "id": 1,
      "text": "Founded in 1879 during the Colorado Silver Boom, Red Cliff sprang up when miners from Leadville crossed Tennessee Pass seeking new prospects.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Red_Cliff%2C_Colorado",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town’s name comes from the striking red sandstone and quartzite cliffs that surround it.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://visitminturnredcliff.com/red-cliff/",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Red Cliff was the first county seat of Eagle County from 1883 until the seat moved to Eagle in 1921.",
      "sourceSentenceIds": [
        14
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Red_Cliff%2C_Colorado",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The Historic Green Bridge, a vivid green span over the Eagle River gorge, marks the dramatic entrance to Red Cliff.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://unearththevoyage.com/colorado-red-cliff-hidden-gem-on-crimson-cliffs/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Hikers can wander abandoned mining trails through aspen groves, discovering hidden waterfalls and glimpses of wildlife in the remote canyon.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://unearththevoyage.com/colorado-red-cliff-hidden-gem-on-crimson-cliffs/",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Today, Red Cliff remains the oldest town in Eagle County, home to about 280 residents who enjoy a quiet mountain lifestyle.",
