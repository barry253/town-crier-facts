  "facts": [
    {
      "id": 1,
      "text": "Paris emerged in the early nineteenth century as a stopover along the Pittsburgh-Steubenville Pike, starting with a tavern built by Richard Ward.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/paris_pennsylvania"
    },
    {
      "id": 2,
      "text": "The Panhandle Railroad brought development to Paris by the 1860s, establishing stations for shipping coal from nearby mines and local dairy milk.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/paris_pennsylvania"
    },
    {
      "id": 3,
      "text": "In the 1880s, Paris was described as a neat little country town featuring artisan shops and the Paris Collegiate Institute.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/paris_pennsylvania"
    },
    {
      "id": 4,
      "text": "Paris sits on a ridge between the valleys of Harmon Creek to the south and King's Creek to the north.",
      "sourceSentenceIds": [
        18
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/paris_pennsylvania"
    },
    {
      "id": 5,
      "text": "Fertile soils developed from Pennsylvanian-age sedimentary rocks allow farmers in Paris to cultivate crops like corn and hay.",
      "sourceSentenceIds": [
        23,
        24
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/paris_pennsylvania"
    },
    {
      "id": 6,
      "text": "Early European settlers arrived in the Paris region during the 1770s, seeking fertile lands amid the American Revolutionary War.",
