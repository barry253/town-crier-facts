  "facts": [
    {
      "id": 1,
      "text": "Milan, Minnesota, takes its name from the Italian city of Milan.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Milan%2C_Minnesota"
    },
    {
      "id": 2,
      "text": "Founded by Norwegian immigrants in 1879, Milan still feels like a proud ethnic village.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.milanmn.com/"
    },
    {
      "id": 3,
      "text": "The earliest tangible evidence of Milan dates back to a 13th‑century iron hatchet left by Vikings.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.milanmn.com/index.asp?SEC=C75BCD32-5114-4FFC-A029-37759F7AEF27&DE=DAF01F37-595A-4421-AE5C-C16B0C356FB2"
    },
    {
      "id": 4,
      "text": "In 1879 the Paul Railroad laid steel rails and built a tool shed that marked Milan’s future site.",
      "sourceSentenceIds": [
        5,
        6
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.milanmn.com/index.asp?SEC=C75BCD32-5114-4FFC-A029-37759F7AEF27&DE=DAF01F37-595A-4421-AE5C-C16B0C356FB2"
    },
    {
      "id": 5,
      "text": "Lutheran and Methodist churches have been mainstays in Milan’s community for most of its history.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.milanmn.com/index.asp?SEC=C75BCD32-5114-4FFC-A029-37759F7AEF27&DE=DAF01F37-595A-4421-AE5C-C16B0C356FB2"
    },
    {
      "id": 6,
      "text": "Since the mid‑2000s, Milan has welcomed many Micronesian immigrants thanks to the Compact of Free Association.",
      "sourceSentenceIds": [
        11
      ],
