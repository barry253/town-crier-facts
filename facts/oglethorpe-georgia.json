  "facts": [
    {
      "id": 1,
      "text": "Oglethorpe was named for James Edward Oglethorpe, the founder of colonial Georgia, and first settled by Timothy Barnard before the Revolution.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.georgiaencyclopedia.org/articles/counties-cities-neighborhoods/oglethorpe/",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "In 1838, Oglethorpe was founded and later incorporated as a town in 1849 and as a city in 1852.",
      "sourceSentenceIds": [
        3,
        15
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Oglethorpe%2C_Georgia",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The city hosted Georgia’s first Southwest Georgian newspaper, founded in 1851 by Simri Rose.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.georgiaencyclopedia.org/articles/counties-cities-neighborhoods/oglethorpe/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "In 1886, Horace Lumpkin, son of freedpeople, opened one of Georgia’s first schools for African Americans in Oglethorpe.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.georgiaencyclopedia.org/articles/counties-cities-neighborhoods/oglethorpe/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Epidemics of malaria and smallpox in the 1850s and 1860s devastated the town, prompting many residents to flee south to Americus.",
