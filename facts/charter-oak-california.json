  "facts": [
    {
      "id": 1,
      "text": "Charter Oak got its name from a prominent oak tree that American soldiers linked to Connecticut's Charter Oak during the Mexican–American War.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Charter_Oak%2C_California",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Before European arrival, the Tongva (Gabrielino) people lived in what is now Charter Oak for thousands of years.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Charter_Oak%2C_California",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Railroad expansion in 1887 diverted the Atchison, Topeka and Santa Fe line away from Charter Oak, shaping its growth.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Charter_Oak%2C_California",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "In the late 1800s, citrus farmers settled Charter Oak, and its sandy soil supported orchards and nurseries of cactus and other small plants.",
      "sourceSentenceIds": [
        9,
        25
      ],
      "sourceLabels": [
        "Web source 1",
        "Wikipedia"
      ],
      "source": "https://grokipedia.com/page/charter_oak_california",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Charter Oak sits on flat ground, with Walnut Creek in the southeast and the concrete‑lined San Dimas Wash cutting through the north.",
      "sourceSentenceIds": [
        22,
        23
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Charter_Oak%2C_California",
      "category": "nature",
      "quality": "poor",
      "qualityReason": "vague"
    },
    {
      "id": 6,
      "text": "Since 1989, Charter Oak has hosted a national team training center that produced Olympian Jamie Dantzscher and champion Vanessa Atler.",
