      ],
      "source": "https://www.goosecreeksubdivision.org/goose-creek-lake",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The reservoir was created by damming Goose Creek, an east‑flowing tributary of Fourche Du Clos that feeds the Mississippi River watershed.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Wikipedia"
