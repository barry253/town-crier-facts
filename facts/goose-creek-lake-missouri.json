      "category": "nature",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The subdivision is gated, with a 24‑hour manned entrance and monthly trustee meetings held on the second Saturday at 9 a.m.",
      "sourceSentenceIds": [
