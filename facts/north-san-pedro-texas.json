  "facts": [
    {
      "id": 1,
      "text": "North San Pedro’s name honors Saint Peter, following Spanish colonial naming traditions for missions, creeks, and settlements.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/north_san_pedro_texas",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The first permanent settlement in the area was the Santa Petronila Ranch, founded in 1762 by Captain Blás María de la Garza Falcón.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/north_san_pedro_texas",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "North San Pedro is the northern remnant of historic San Pedro barrio, annexed south in 1990, and now depends on Robstown for police, fire, water, gas, and electricity.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/north_san_pedro_texas",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Spanish colonial ranchers from Nuevo Santander began establishing outposts in the 1760s north of the Rio Grande, shaping the region’s ranching heritage.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/north_san_pedro_texas",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Oil discoveries in 1930 sparked local employment and infrastructure growth, leading Robstown to provide tax‑free police, fire, water, gas, and electricity to North San Pedro.",
      "sourceSentenceIds": [
        24
      ],
      "sourceLabels": [
        "Web source 1"
