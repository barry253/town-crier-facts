      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The Bloomington Old Town Hall Museum, housed in a historic former town hall, chronicles the city’s story from prehistoric times to today.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Wikipedia"
