  "facts": [
    {
      "id": 1,
      "text": "Butte City was once a bustling grain‑shipping center on the Sacramento River, moving tons of wheat and barley by barge.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Butte_City%2C_Glenn_County%2C_California",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Perched on the east bank of the Sacramento River, Butte City lies 11 miles southeast of Willows at just 89 feet above sea level.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Butte_City%2C_Glenn_County%2C_California",
      "category": "other",
      "quality": "poor",
      "qualityReason": "location_description"
    },
    {
      "id": 3,
      "text": "A bridge has crossed the Sacramento River at Butte City since the 1880s, and a new State Route 162 bridge is under construction as of 2023.",
      "sourceSentenceIds": [
        11
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Butte_City%2C_Glenn_County%2C_California",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The surrounding landscape is dominated by rice paddies, walnut orchards, alfalfa fields, and corn farms that feed the regional market.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Butte_City%2C_Glenn_County%2C_California",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Butte City’s first post office opened its doors in 1883, marking the town’s emergence as a community hub.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Butte_City%2C_Glenn_County%2C_California",
      "category": "history",
      "quality": "good"
    },
    {
