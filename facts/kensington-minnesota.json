    {
      "id": 1,
      "text": "Kensington sprang up in 1887 as a railroad town when the Minneapolis and Pacific Railway reached the area.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/kensington_minnesota",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Kensington was named after Kensington in London, reflecting settlers’ admiration for the English borough.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Kensington%2C_Minnesota",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The town is famous for the Kensington Runestone, first displayed in Kensington and sparking debate over its authenticity.",
      "sourceSentenceIds": [
        7,
        8
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Kensington%2C_Minnesota",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The local museum showcases the stone in an exhibit titled “Kensington – a Town & its Stone,” detailing the area's history.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://nllndirectory.omeka.net/items/show/25",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Kensington’s rural setting highlights its role as a hub for agricultural heritage and Scandinavian immigrant history in west-central Minnesota.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Web source 1"
      ],
