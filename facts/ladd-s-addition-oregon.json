  "facts": [
    {
      "id": 1,
      "text": "Ladd's Addition is Portland's oldest planned residential development and one of the oldest in the western United States.",
      "sourceSentenceIds": [
        17
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Ladd's_Addition"
    },
    {
      "id": 2,
      "text": "William S. Ladd designed the neighborhood with a diagonal wagon wheel arrangement instead of following the standard city grid.",
      "sourceSentenceIds": [
        21
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Ladd's_Addition"
    },
    {
      "id": 3,
      "text": "Ladd's Addition features four diamond-shaped rose gardens and a central traffic circle surrounding a park.",
      "sourceSentenceIds": [
        21,
        28
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Ladd's_Addition"
    },
    {
      "id": 4,
      "text": "The narrow streets of Ladd's Addition are lined with American elm trees that are inoculated yearly against Dutch elm disease.",
      "sourceSentenceIds": [
        26,
        27
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Ladd's_Addition"
    },
    {
      "id": 5,
      "text": "Ladd's Addition is one of fewer than twenty areas in Portland that still have alleyways.",
      "sourceSentenceIds": [
        22
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Ladd's_Addition"
    },
    {
      "id": 6,
      "text": "The National Register of Historic Places designated Ladd's Addition as a historic district in 1988.",
