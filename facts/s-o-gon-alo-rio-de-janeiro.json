  "facts": [
    {
      "id": 1,
      "text": "São Gonçalo’s oldest surviving colonial site is the 17th‑century Nossa Senhora da Boa Esperança Farm in Ipiiba, still standing today.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/S%C3%A3o_Gon%C3%A7alo%2C_Rio_de_Janeiro",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "In 1567, Portuguese forces under Estácio de Sá began the final push that expelled French and Tamoio allies from the area that would become São Gonçalo.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/S%C3%A3o_Gon%C3%A7alo%2C_Rio_de_Janeiro",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The Jesuits established the first farm in the region, Colubandê, at the edge of the modern RJ‑104 road in the early 1600s.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.saogoncalo.rj.gov.br/sao-goncalo/historia-de-sao-goncalo/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "São Gonçalo hosts the Fazenda Colubandê, a colonial‑era building that now serves as a cultural landmark in the neighborhood of the same name.",
      "sourceSentenceIds": [
        15
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://en.wikivoyage.org/wiki/S%C3%A3o_Gon%C3%A7alo",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The municipality contains 4% of the 1,936‑hectare Guanabara Ecological Station, a protected area created in 2006.",
      "sourceSentenceIds": [
        16
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/S%C3%A3o_Gon%C3%A7alo%2C_Rio_de_Janeiro",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The Laranjal Water Treatment Station, one of the two main stations for Rio’s metropolitan area, supplies potable water to São Gonçalo and surrounding regions.",
      "sourceSentenceIds": [
        18,
        19
      ],
      "sourceLabels": [
        "Web source 2"
      ],
