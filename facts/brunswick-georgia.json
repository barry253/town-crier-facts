  "facts": [
    {
      "id": 1,
      "text": "Brunswick was named after the German duchy of Brunswick‑Lüneburg, the ancestral home of King George III.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Brunswick%2C_Georgia"
    },
    {
      "id": 2,
      "text": "The historic Old City Hall, built in 1889, was fully restored in 2004 and now houses Brunswick’s municipal offices.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.explorestsimonsisland.com/Brunswick.html"
    },
    {
      "id": 3,
      "text": "Brunswick’s downtown, laid out by General James Oglethorpe over 240 years ago, showcases Victorian architecture and preserved colonial buildings.",
      "sourceSentenceIds": [
        22
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.explorestsimonsisland.com/Brunswick.html"
    },
    {
      "id": 4,
      "text": "During World War II, Brunswick hosted a strategic military base for escort blimps and a shipbuilding facility for the U.S. Navy.",
      "sourceSentenceIds": [
        25
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Brunswick%2C_Georgia"
    },
    {
      "id": 5,
      "text": "The town’s live oak, Lover’s Oak, stands at the intersection of Prince and Albany streets and is a local landmark.",
      "sourceSentenceIds": [
        13
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Brunswick%2C_Georgia"
    },
    {
      "id": 6,
      "text": "Brunswick’s historic Court House, originally built in 1884, was rebuilt in 1907 after a hurricane damaged it in 1896.",
      "sourceSentenceIds": [
        23
      ],
      "sourceLabels": [
        "Web source 2"
      ],
