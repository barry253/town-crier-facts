  "facts": [
    {
      "id": 1,
      "text": "Conesus Lake, the westernmost Finger Lake, was carved by glaciers that retreated over 10,000 years ago.",
      "sourceSentenceIds": [
        23,
        24,
        25
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://conesuslake.org/lake-information/lake-facts/",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Its shoreline stretches across the towns of Conesus, Geneseo, Groveland, and Livonia.",
      "sourceSentenceIds": [
        27
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://conesuslake.org/lake-information/lake-facts/",
      "category": "other",
      "quality": "poor",
      "qualityReason": "vague"
    },
    {
      "id": 3,
      "text": "Approximately 65% of the lake’s residents live there year‑round, while seasonal cottages still dot the shore.",
      "sourceSentenceIds": [
        28
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://conesuslake.org/lake-information/lake-facts/",
      "category": "other",
      "quality": "poor",
      "qualityReason": "vague"
    },
    {
      "id": 4,
      "text": "Year‑round, locals and visitors enjoy fishing, boating, swimming, and even ice fishing when the lake freezes.",
      "sourceSentenceIds": [
        29,
        30
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://conesuslake.org/lake-information/lake-facts/",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Since 2003, the Conesus Lake Watershed Council has overseen water‑quality projects and invasive‑species prevention.",
      "sourceSentenceIds": [
        17,
        21
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.livingstoncountyny.gov/217/Conesus-Lake",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The entire lake benefits from public sewer, water, electricity, gas, and cable, making it one of the most densely populated Finger Lakes.",
