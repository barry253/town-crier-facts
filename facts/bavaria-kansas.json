  "facts": [
    {
      "id": 1,
      "text": "Bavaria was first called Honek after settler Ernst Hohneck, who arrived in 1865.",
      "sourceSentenceIds": [
        3,
        7
      ],
      "sourceLabels": [
        "Web source 1",
        "Wikipedia"
      ],
      "source": "https://legendsofkansas.com/bavaria-kansas/"
    },
    {
      "id": 2,
      "text": "In 1877 the town was reorganized and renamed Bavaria to honor Hohneck’s German roots.",
      "sourceSentenceIds": [
        6,
        2
      ],
      "sourceLabels": [
        "Web source 1",
        "Wikipedia"
      ],
      "source": "https://legendsofkansas.com/bavaria-kansas/"
    },
    {
      "id": 3,
      "text": "Bavaria sits on the Union Pacific mainline, yet the railroad never spurred growth.",
      "sourceSentenceIds": [
        13,
        9
      ],
      "sourceLabels": [
        "Web source 1",
        "Wikipedia"
      ],
      "source": "https://legendsofkansas.com/bavaria-kansas/"
    },
    {
      "id": 4,
      "text": "The old schoolhouse, now gone, and other surviving landmarks echo Bavaria’s vibrant past.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://michael-hankins.com/2026/01/06/bavaria-kansas/"
    },
    {
      "id": 5,
      "text": "Today Bavaria remains an unincorporated ghost town, its history kept alive in local memories.",
      "sourceSentenceIds": [
        17
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://michael-hankins.com/2026/01/06/bavaria-kansas/"
    },
    {
      "id": 6,
      "text": "In the early 1880s, Bavaria hosted a drug store, wagon shop, blacksmith, school, syrup factory, and houses for about 150 residents.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Web source 1"
