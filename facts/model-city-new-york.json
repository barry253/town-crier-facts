  "facts": [
    {
      "id": 1,
      "text": "Model City was envisioned by William T. Love as a utopian metropolis for over a million people, complete with a canal and hydroelectric plant.",
      "sourceSentenceIds": [
        5,
        13,
        14
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Model_City%2C_New_York"
    },
    {
      "id": 2,
      "text": "Love abandoned the project after digging only 4,600 feet of canal, a stretch that now lies within modern Niagara Falls.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Model_City%2C_New_York"
    },
    {
      "id": 3,
      "text": "By the mid‑1990s, Model City had shrunk to a rural road with a few dozen families and a bar, far from its grand original plan.",
      "sourceSentenceIds": [
        21
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Model_City%2C_New_York"
    },
    {
      "id": 4,
      "text": "The area that once hosted Model City later became the infamous Love Canal landfill, holding more than 20,000 tons of chemical waste.",
      "sourceSentenceIds": [
        22,
        26,
        27
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Model_City%2C_New_York"
    },
    {
      "id": 5,
      "text": "William Love, the mastermind behind Model City, had earlier tried a similar scheme in Huron, South Dakota, in 1890.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Model_City%2C_New_York"
    },
    {
      "id": 6,
      "text": "The hamlet of Model City sits within the town of Lewiston in Niagara County, New York.",
      "sourceSentenceIds": [
        11
