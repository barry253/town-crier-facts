      ],
      "source": "https://www.cityoffrenchburg.com/history",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Frenchburg sits within the Daniel Boone National Forest and is just minutes from Cave Run Lake, the “Muskie Capital of the South.”.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
