      "category": "nature",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Frenchburg’s historic downtown still hosts traditions such as Trade Days and the Menifee Mountain Memories Festival.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.cityoffrenchburg.com/history",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The Frenchburg School Campus, founded by Edward Owings Guerrant, earned National Register status in 1978.",
      "sourceSentenceIds": [
