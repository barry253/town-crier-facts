    {
      "id": 1,
      "text": "Brookville was platted in 1850 and named for a small brook near the town site.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Brookville%2C_Ohio"
    },
    {
      "id": 2,
      "text": "The Brookville Historical Society began in 1973 and now houses the Genealogy/Research Library in the Spitler House Community Museum.",
      "sourceSentenceIds": [
        8,
        16
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://brookvillehistory.org/"
    },
    {
      "id": 3,
      "text": "The railroad depot on Hay and Cusick Avenues closed in 1979 when trains stopped, and the building was later donated to the Historical Society.",
      "sourceSentenceIds": [
        9,
        10
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://brookvillehistory.org/"
    },
    {
      "id": 4,
      "text": "The Genealogy/Research Library, now called the Wayne and Dorothy Watkins Research Library, opened in the Exhibit Building after a recent move.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://brookvillehistory.org/"
    },
    {
      "id": 5,
      "text": "Brookville’s public library is a branch of the Dayton Metro Library system.",
      "sourceSentenceIds": [
        13
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Brookville%2C_Ohio"
    },
    {
      "id": 6,
      "text": "The town’s first pioneers arrived around 1814, long before its official platting.",
