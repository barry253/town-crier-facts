  "facts": [
    {
      "id": 1,
      "text": "Vernon Center once thrived as a mercantile hub, with grist mills, sawmills, a tannery, cheese factories powered by Town Brook, and stores like the Denton family shop and Vandegriff's Tavern.",
      "sourceSentenceIds": [
        11
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/vernon_center_new_jersey",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The village began as a slope‑side vacation housing development of 1,356 units, now operated by real‑estate investor Andrew Mulvihill.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Vernon_Township%2C_New_Jersey",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Vernon Township was created on April 8 1793 from Hardyston Township and named after George Washington’s half‑brother Lawrence Washington’s estate, Mount Vernon.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/vernon_center_new_jersey",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "In 2003, Vernon Center earned a Town Center Designation to promote smart growth while preserving over 4,000 years of architectural history in buildings like the Abram Rutan House.",
      "sourceSentenceIds": [
        16
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/vernon_center_new_jersey",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The 1881 Lehigh & Hudson River Railroad Depot, now a deli, showcases the township’s historic rail connection.",
      "sourceSentenceIds": [
        22
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/vernon_center_new_jersey",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Vernon Township hosts Mountain Creek, a ski resort that once operated as Great Gorge and now also offers a water park.",
      "sourceSentenceIds": [
        26
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
