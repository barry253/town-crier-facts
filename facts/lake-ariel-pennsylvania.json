  "facts": [
    {
      "id": 1,
      "text": "Lake Ariel was first settled in 1822 by the Jones family and was originally called The Stock Farm before becoming Jonestown.",
      "sourceSentenceIds": [
        23
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Lake_Ariel%2C_Pennsylvania"
    },
    {
      "id": 2,
      "text": "The town’s name changed to Lake Ariel after a post office named Ariel was established, a shift that reflected the growing community.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Lake_Ariel%2C_Pennsylvania"
    },
    {
      "id": 3,
      "text": "Lake Ariel Park, opened in the late 19th century, drew visitors with rides like the Cyclone rollercoaster, a waterslide, and a miniature train.",
      "sourceSentenceIds": [
        30
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Lake_Ariel%2C_Pennsylvania"
    },
    {
      "id": 4,
      "text": "The Pennsylvania Coal Company’s Gravity Railroad helped expand Lake Ariel by bringing workers and encouraging local businesses.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Lake_Ariel%2C_Pennsylvania"
    },
    {
      "id": 5,
      "text": "Founded in 2002, the Lake Ariel Region Historical Association preserves the area’s past through a research library in the Lake Ariel Memorial Hall.",
      "sourceSentenceIds": [
        1,
        6
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://museumsdatabase.com/museums/view/27999"
    },
    {
      "id": 6,
      "text": "Lake Ariel sits at an elevation of 437 feet, nestled in the Poconos of northeastern Pennsylvania.",
