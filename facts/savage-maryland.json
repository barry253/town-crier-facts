  "facts": [
    {
      "id": 1,
      "text": "Savage takes its name from Philadelphia merchant John Savage, who invested in a mill on the Little Patuxent falls.",
      "sourceSentenceIds": [
        6,
        22
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 2"
      ],
      "source": "https://en.wikipedia.org/wiki/Savage%2C_Maryland",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The Bollman Truss Railroad Bridge, the only iron truss bridge of its type in the world, sits in Savage and is listed on the National Register.",
      "sourceSentenceIds": [
        2,
        10
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Savage%2C_Maryland",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Savage Mill, founded in 1822, harnessed water power from the Little and Middle Patuxent rivers and now preserves its original 19th‑century buildings.",
      "sourceSentenceIds": [
        29,
        24
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Savage%2C_Maryland",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "When a B&O spur reached Savage in 1887, the Bollman Bridge was moved to its present site beside the factory.",
      "sourceSentenceIds": [
        2,
        9
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Savage%2C_Maryland",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The Savage Volunteer Fire Company, founded in 1937, first operated from a station on Savage‑Guilford Road.",
