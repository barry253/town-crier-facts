  "facts": [
    {
      "id": 1,
      "text": "Meridian‑Kessler was named after the Meridian‑Kessler Neighborhood Association, formed in 1965 to unify the area.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://indyencyclopedia.org/meridian-kessler/"
    },
    {
      "id": 2,
      "text": "The neighborhood is bounded by Kessler Boulevard to the north, the Monon Trail to the east, 38th Street to the south, and Meridian Street to the west.",
      "sourceSentenceIds": [
        19
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Meridian-Kessler%2C_Indianapolis"
    },
    {
      "id": 3,
      "text": "Meridian Street between 40th and Kessler was added to the National Register of Historic Places in 1986.",
      "sourceSentenceIds": [
        11
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Meridian-Kessler%2C_Indianapolis"
    },
    {
      "id": 4,
      "text": "The area began as farmland in 1822, and the oldest surviving farmhouse dates back to 1832.",
      "sourceSentenceIds": [
        8,
        23
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Meridian-Kessler%2C_Indianapolis"
    },
    {
      "id": 5,
      "text": "Since 1973, residents host an annual home tour to showcase property improvements and community spirit.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://indyencyclopedia.org/meridian-kessler/"
    },
    {
      "id": 6,
      "text": "The Meridian‑Kessler Neighborhood Association is the largest neighborhood community in Indianapolis, focusing on livability and historic preservation.",
      "sourceSentenceIds": [
        13
