      "id": 1,
      "text": "The Maugansville Historical Society was founded in 1976 and has since collected artifacts, documents, and photographs of the town.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
