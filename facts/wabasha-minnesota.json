  "facts": [
    {
      "id": 1,
      "text": "Wabasha takes its name from Chief Wa-pa-shaw, a prominent Sioux leader whose encampment once stood along the Mississippi River.",
      "sourceSentenceIds": [
        1,
        9
      ],
      "sourceLabels": [
        "Web source 1",
        "Web source 2"
      ],
      "source": "https://www.wabasha.org/community-resources/about/wabashas-chronological-history-heritage/",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Before settlers, the M'dewakanton band of Dakota Indians called the Wabasha area home.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.co.wabasha.mn.us/community/history.php",
      "category": "people",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Wabasha houses Minnesota’s oldest surviving brick schoolhouse, now a museum, and Grace Memorial Episcopal Church, the state’s oldest with a Tiffany stained‑glass window.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.co.wabasha.mn.us/community/history.php",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Between 1817 and 1823, trader Augustin Rocque set up a network of posts along the Mississippi, extending from Lake Pepin to Iowa’s Cedar River.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.wabasha.org/community-resources/about/wabashas-chronological-history-heritage/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "In 1871, the railroad connected Wabasha to eastern cities, ending the era of steamboats that once ferried goods up and down the Mississippi.",
      "sourceSentenceIds": [
        22
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.co.wabasha.mn.us/community/history.php",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The 1993 comedy Grumpy Old Men is set in Wabasha, though most scenes were filmed elsewhere in Minnesota.",
      "sourceSentenceIds": [
