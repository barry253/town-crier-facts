  "facts": [
    {
      "id": 1,
      "text": "Scott County was founded in 1833, named for Abram M., and lies in the Mississippi Delta’s rich alluvial soils.",
      "sourceSentenceIds": [
        1,
        7
      ],
      "sourceLabels": [
        "Web source 2",
        "Web source 1"
      ],
      "source": "https://www.scottcountyms.gov/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "In 1927, the Delta & Pine Land Company moved its headquarters to Scott, turning the village into a global cotton powerhouse.",
      "sourceSentenceIds": [
        11
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Scott%2C_Mississippi",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "At its peak, the Delta & Pine Land Company spanned over 36,000 acres, making it the world’s largest contiguous cotton plantation.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/scott_mississippi",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "In 2007, Monsanto acquired the Delta & Pine Land Company, ending Scott’s era as a cotton industry hub.",
      "sourceSentenceIds": [
        13
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/scott_mississippi",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The introduction of the mechanical cotton picker in the mid‑20th century dismantled sharecropping in Scott, reducing the need for manual labor.",
      "sourceSentenceIds": [
        29
      ],
      "sourceLabels": [
        "Web source 1"
      ],
