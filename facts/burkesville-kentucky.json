  "facts": [
    {
      "id": 1,
      "text": "Burkesville was incorporated in 1846, named after Isham Burk, a prominent local leader.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Burkesville%2C_Kentucky",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town’s origins trace back to 1798 when pioneers led by Major John Crockett laid it out on land owned by Isham Burk, formal founding in 1810.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/Burkesville,_Kentucky",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Burkesville once thrived as a 19th‑century river port, moving timber, farm goods, and other cargo by steamboat along the Cumberland River.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/Burkesville,_Kentucky",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The last steamboat docked in Burkesville in 1929, the year after the first major road opened to Glasgow, 40 miles west.",
      "sourceSentenceIds": [
        25
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Burkesville%2C_Kentucky",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "In 1944, the Corps of Engineers’ Dale Hollow Reservoir creation turned the area into a fishing and tourism spot, boosting a trout fishery.",
      "sourceSentenceIds": [
        28
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Burkesville%2C_Kentucky",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Burkesville earned Kentucky’s 26th Trail Town title in 2022, promoting paddling, trails, and community events that highlight its natural landscape.",
      "sourceSentenceIds": [
        11
