    {
      "id": 1,
      "text": "Palisades’ riverfront was once a National Landmark, where visitors can explore historic reenactments and a living‑history school program.",
      "sourceSentenceIds": [
        3,
        4
      ],
      "sourceLabels": [
        "Web source 1"
