  "facts": [
    {
      "id": 1,
      "text": "Modale was originally called Martinsdale, laid out in 1872 by Benjamin Martin, and named after him.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Modale%2C_Iowa",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The city’s current name, Modale, comes from its setting in a dale near the Missouri River and was adopted when the first railroad depot was built.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Modale%2C_Iowa",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Founded in 1874, Modale is a friendly farm community in the Missouri River Valley north of Omaha.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.modaleiowa.com/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Modale supports the arts through its Grand Lodge Arts Center, a historic venue that continues to host performances today.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.modaleiowa.com/",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The Modale School and Masonic Hall, built in 1880, originally served as the town’s first school building.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.modaleiowa.com/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Modale is the birthplace of Myra Keaton, the vaudeville performer who was Buster Keaton’s mother.",
