  "facts": [
    {
      "id": 1,
      "text": "Murphys was founded by brothers John and Daniel Murphy, part of the Stephens‑Townsend‑Murphy Party that crossed the Sierra Nevada in 1844.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Murphys%2C_California"
    },
    {
      "id": 2,
      "text": "The town’s original name, Murphy’s Camp, honored the brothers’ trading post where John even “married” a Miwok woman named Pokela.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.calaverashistory.org/murphys"
    },
    {
      "id": 3,
      "text": "Murphys is a California Historical Landmark #275, preserving its gold‑rush heritage since the mid‑1800s.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Murphys%2C_California"
    },
    {
      "id": 4,
      "text": "Main Street today hosts over two dozen wine tasting rooms, a legacy of the town’s former gold‑mining prosperity.",
      "sourceSentenceIds": [
        22
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Murphys%2C_California"
    },
    {
      "id": 5,
      "text": "Every March, Murphys celebrates an Irish Day parade that draws up to 35,000 people to Main Street.",
      "sourceSentenceIds": [
        24
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Murphys%2C_California"
    },
    {
      "id": 6,
      "text": "The world’s largest crystalline gold leaf sits just south of Murphys at Ironstone Vineyards, a nod to the town’s mining past.",
      "sourceSentenceIds": [
