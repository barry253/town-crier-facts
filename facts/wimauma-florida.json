  "facts": [
    {
      "id": 1,
      "text": "Wimauma’s name comes from the first letters of its founder’s daughters—Will, Maude, and Mary.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Wimauma%2C_Florida",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Captain C.H. Davis built a railroad between Turkey Creek and Bradenton, then founded Wimauma at its midpoint in 1902.",
      "sourceSentenceIds": [
        12,
        15
      ],
      "sourceLabels": [
        "Web source 2",
        "Wikipedia"
      ],
      "source": "https://hcfl.gov/about-hillsborough/history/faces-behind-the-places/faces-behind-the-places-wimauma",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Since the early 1900s, Wimauma has hosted a Church of God camp meeting, now held in an enclosed convention center.",
      "sourceSentenceIds": [
        11,
        18,
        19,
