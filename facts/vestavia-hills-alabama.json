  "facts": [
    {
      "id": 1,
      "text": "Vestavia Hills grew from George Battey Ward’s 1924 estate, a house modeled after Rome’s Temple of Vesta, which gave the city its name.",
      "sourceSentenceIds": [
        22,
        2
      ],
      "sourceLabels": [
        "Web source 2",
        "Web source 1"
      ],
      "source": "https://encyclopediaofalabama.org/article/vestavia-hills/",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The city’s first LEED‑certified library, the Library in the Forest, opened in 2005 and is the first of its kind in Alabama.",
      "sourceSentenceIds": [
        21
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://vhal.org/community/about-vestavia-hills/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Vestavia Hills sits atop Shades Mountain, placing it on the northern edge of Birmingham’s urban core.",
      "sourceSentenceIds": [
        28
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Vestavia_Hills%2C_Alabama",
      "category": "other",
      "quality": "poor",
      "qualityReason": "location_description"
    },
    {
      "id": 4,
      "text": "The planned community originally aimed to house about 1,000 residents, a vision realized when Charles Byrd purchased Ward’s estate in 1940.",
      "sourceSentenceIds": [
        4,
        7
      ],
      "sourceLabels": [
        "Web source 2",
        "Web source 1"
      ],
      "source": "https://encyclopediaofalabama.org/article/vestavia-hills/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The city’s wrestling program holds Alabama’s record with 15 state championships, including back‑to‑back titles in 2016 and 2017.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Vestavia_Hills%2C_Alabama",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Vestavia Hills’ historic homes, many dating to the 1920s, reflect the city’s origins as a retreat for Birmingham’s wealthy.",
      "sourceSentenceIds": [
