      "id": 1,
      "text": "Southwark hosted the original Globe Theatre, where Shakespeare’s plays premiered, and a modern reconstruction opened near the site in 1997.",
      "sourceSentenceIds": [
        28
      ],
      "sourceLabels": [
        "Web source 2"
      ],
