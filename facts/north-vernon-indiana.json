  "facts": [
    {
      "id": 1,
      "text": "North Vernon was founded in 1854 as a railroad hub, originally called Tripton, and was renamed to avoid confusion with another Indiana town.",
      "sourceSentenceIds": [
        1,
        2,
        5,
        6
      ],
      "sourceLabels": [
        "Web source 2",
        "Wikipedia"
      ],
      "source": "https://talktoannie.com/explore-north-vernon-indiana-a-town-with-historical-roots-and-modern-appeal/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Jennings County Historical Society’s museum showcases artifacts that tell North Vernon's rich past.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://talktoannie.com/explore-north-vernon-indiana-a-town-with-historical-roots-and-modern-appeal/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Muscatatuck Urban Training Center, once a state hospital, now serves as a unique urban training facility.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://talktoannie.com/explore-north-vernon-indiana-a-town-with-historical-roots-and-modern-appeal/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "North Vernon Airport, formerly Saint Anne Field, was an auxiliary airfield for the U.S. Army Air Forces before becoming a municipal airport in 1948.",
      "sourceSentenceIds": [
        14
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/North_Vernon%2C_Indiana",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The city hosts three historic districts—Annadale, Downtown, and Walnut Street—listed on the National Register of Historic Places.",
      "sourceSentenceIds": [
