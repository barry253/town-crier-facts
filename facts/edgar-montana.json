    {
      "id": 1,
      "text": "Edgar was named for J. Thornton’s brother when he founded the town in 1907.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.mtmemory.org/nodes/view/127832",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Thornton insisted Edgar remained a dry town and donated land for a park beside the railroad.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.mtmemory.org/nodes/view/127832",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The Edgar post office opened May 28, 1909 with J. Thornton as its first postmaster.",
      "sourceSentenceIds": [
