  "facts": [
    {
      "id": 1,
      "text": "Maryland Park’s roots trace back to the Piscataway people, an Algonquian tribe that fished, hunted, and farmed along the Potomac before the 17th century.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/maryland_park_maryland",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Early land grants turned the area into a patchwork of rural estates along waterways, a pattern that lingered into the 18th century.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/maryland_park_maryland",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The Mid‑Atlantic climate keeps Maryland Park’s temperatures moderate, with continental influences softening extremes compared to farther inland.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/maryland_park_maryland",
      "category": "other",
      "quality": "poor",
      "qualityReason": "vague"
    },
    {
      "id": 4,
      "text": "Proximity to Chesapeake Bay keeps humidity high year‑round, sometimes turning mornings into misty, moisture‑laden scenes.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/maryland_park_maryland",
      "category": "other",
      "quality": "poor",
      "qualityReason": "vague"
    },
    {
      "id": 5,
      "text": "The Maryland flag, adopted by the state legislature in 1904, features the historic Calvert and Crossland coats of arms.",
      "sourceSentenceIds": [
        11
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Flag_of_Maryland",
      "category": "other",
      "quality": "poor",
      "qualityReason": "editorial_filler"
    },
    {
      "id": 6,
      "text": "The flag’s design shows six gold and black vertical bars with a diagonal band in the first and fourth quarters, and a cross bottony in the second and third.",
      "sourceSentenceIds": [
        21
