  "facts": [
    {
      "id": 1,
      "text": "Union Mills Canal Outlet Locks #1 and #2 were built 1850‑1854 as part of the Rivanna River canal linking Charlottesville to Columbia.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.dhr.virginia.gov/historic-registers/032-5010/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Lock #1 remains exposed while lock #2 is filled with silt, showing contrasting preservation states.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.dhr.virginia.gov/historic-registers/032-5010/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The locks are constructed of finely finished, hammer‑dressed granite blocks, exemplifying 19th‑century engineering craftsmanship.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.dhr.virginia.gov/historic-registers/032-5010/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Cast‑iron hardware and masonry silt aprons still survive on lock #1, along with niches that once held wooden gates.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.dhr.virginia.gov/historic-registers/032-5010/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Union Mills’ post office opened in 1813, marking the community’s early establishment in Fluvanna County.",
      "sourceSentenceIds": [
        16
      ],
