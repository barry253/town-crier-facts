  "facts": [
    {
      "id": 1,
      "text": "Silver Plume originated as a silver mining camp along Clear Creek during Colorado's gold and silver rush.",
      "sourceSentenceIds": [
        26
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Silver_Plume%2C_Colorado",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town’s name comes from the 7:30 am shift start time at the local mine, a detail noted in local lore.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.uncovercolorado.com/towns/silver-plume/",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Silver Plume sits within the Georgetown‑Silver Plume National Historic District, a federally designated area that includes the Georgetown Loop Railroad.",
      "sourceSentenceIds": [
        8,
        11
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Silver_Plume%2C_Colorado",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The George Rowe Museum, housed in the town’s original schoolhouse, displays artifacts from Silver Plume’s mining era.",
      "sourceSentenceIds": [
        10,
        15
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 2"
      ],
      "source": "https://en.wikipedia.org/wiki/Silver_Plume%2C_Colorado",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Silver Plume’s post office opened December 1 1875, and the town was incorporated September 24 1880.",
