  "facts": [
    {
      "id": 1,
      "text": "Gerlach sprang to life in 1906 when the Western Pacific Railroad built its Feather River Route through the Black Rock Desert.",
      "sourceSentenceIds": [
        2,
        7
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 2"
      ],
      "source": "https://en.wikipedia.org/wiki/Gerlach%2C_Nevada",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town was named after Louis Gerlach’s ranching company, the Gerlach Land and Cattle Company, which owned vast Black Rock lands.",
      "sourceSentenceIds": [
        4,
        5
      ],
      "sourceLabels": [
        "Web source 2",
        "Wikipedia"
      ],
      "source": "https://grokipedia.com/page/Gerlach,_Nevada",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Just north of Gerlach, the Fly Geyser erupts in a rainbow of colors, a rare geothermal wonder on private land.",
      "sourceSentenceIds": [
        3,
        29
      ],
      "sourceLabels": [
        "Web source 2",
        "Wikipedia"
      ],
      "source": "https://grokipedia.com/page/Gerlach,_Nevada",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Gypsum mining once powered Gerlach’s economy, turning the town into a regional supplier of the mineral.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Gerlach%2C_Nevada",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "After a mine closed, Gerlach pivoted to tourism, hosting Burning Man’s 70,000‑person crowds each summer.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/Gerlach,_Nevada",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "In 1843, explorer Frémont camped near Gerlach’s Boiling Springs, naming the spring a quarter mile north of town.",
      "sourceSentenceIds": [
