  "facts": [
    {
      "id": 1,
      "text": "Ketchum was named for James Ketchum, a Delaware Indian and Methodist minister who moved to Indian Territory in 1867.",
      "sourceSentenceIds": [
        5,
        6
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Ketchum%2C_Oklahoma"
    },
    {
      "id": 2,
      "text": "The town of Ketchum was originally established in 1899 on the banks of the Grand River in Mayes County.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.okhistory.org/publications/enc/entry?entry=KE013"
    },
    {
      "id": 3,
      "text": "Ketchum relocated to southeastern Craig County around 1912 during the construction of the Missouri, Oklahoma and Gulf Railroad.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Ketchum%2C_Oklahoma"
    },
    {
      "id": 4,
      "text": "The original townsite of Ketchum was eventually filled in by the creation of Grand Lake o' the Cherokees.",
      "sourceSentenceIds": [
        26
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Ketchum%2C_Oklahoma"
    },
    {
      "id": 5,
      "text": "Ketchum relied on agriculture until the construction of Pensacola Dam between 1938 and 1940 created Grand Lake.",
      "sourceSentenceIds": [
        27
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Ketchum%2C_Oklahoma"
    },
    {
      "id": 6,
      "text": "Tourism and lake-related businesses have dominated the local economy of Ketchum since the formation of Grand Lake.",
      "sourceSentenceIds": [
        28
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Ketchum%2C_Oklahoma"
    }
  ]
