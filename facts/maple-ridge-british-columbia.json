  "facts": [
    {
      "id": 1,
      "text": "Maple Ridge's indigenous roots trace back thousands of years, with the Katzie and Kwantlen First Nations as original inhabitants.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.mapleridge.ca/explore-maple-ridge/about-maple-ridge/explore-our-heritage",
      "category": "people",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The historic Port Haney Wharf, built in the late 1800s, once served as a key transportation hub and now stands as a heritage site.",
      "sourceSentenceIds": [
        11
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.mapleridge.ca/explore-maple-ridge/about-maple-ridge/explore-our-heritage",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Maple Ridge’s downtown core, known as Haney, houses Haney House, one of the city’s oldest buildings dating to 1878 and now a museum.",
      "sourceSentenceIds": [
        22
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.mapleridge.ca/explore-maple-ridge/about-maple-ridge/explore-our-heritage",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The city has been a backdrop for TV shows like The X‑Files and Stargate SG‑1, and the Ridge Film Studios in downtown hosts episodic productions.",
      "sourceSentenceIds": [
        5,
        6,
        17
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Maple_Ridge%2C_British_Columbia",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Maple Ridge produced baseball legend Larry Walker, a Hall of Fame player, and hockey star Cam Neely, both born in the city.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Maple_Ridge%2C_British_Columbia",
      "category": "people",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Gold discovery along the Fraser River in the mid‑1800s sparked an influx of settlers to the area that would become Maple Ridge.",
      "sourceSentenceIds": [
        10
      ],
