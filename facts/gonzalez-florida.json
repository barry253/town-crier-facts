  "facts": [
    {
      "id": 1,
      "text": "Gonzalez, once called Gonzalia, takes its name from the Gonzalez family who once ran a farm in the area.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Gonzalez%2C_Florida",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Manuel Gonzalez, the family patriarch, was born in Spain before settling in what is now Gonzalez.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Gonzalez%2C_Florida",
      "category": "people",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Gonzalez sits just north of Pensacola and is considered part of the Cantonment area.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Gonzalez%2C_Florida",
      "category": "other",
      "quality": "poor",
      "qualityReason": "location_description"
    },
    {
      "id": 4,
      "text": "Tate High School, the largest public school in Escambia County, is located in the Gonzalez area.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Gonzalez%2C_Florida",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "During the Civil War, Gonzalez housed a Confederate storage facility operated by Manuel Gonzalez’s son, Samuel Z.",
      "sourceSentenceIds": [
        11
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Gonzalez%2C_Florida",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The Gonzalez farm became the scene of a skirmish between Union forces from Fort Barrancas and Confederate troops.",
