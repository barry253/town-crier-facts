  "facts": [
    {
      "id": 1,
      "text": "Big Stone Gap East sits just outside the town limits, tucked on the eastern edge of Big Stone Gap in southwestern Wise County.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Big_Stone_Gap_East%2C_Virginia"
    },
    {
      "id": 2,
      "text": "The community earned its name from the historic Three Forks, an early pioneer trail that once ran through the area.",
      "sourceSentenceIds": [
        24
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.virginia.org/places-to-visit/regions/heart-of-appalachia/big-stone-gap/"
    },
    {
      "id": 3,
      "text": "Visitors can stroll the Walking Tour of Big Stone Gap, which loops through historic sites and museums that chronicle the town’s coal‑mining past.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://dwr.virginia.gov/vbwt/mountain-trail/MBS/"
    },
    {
      "id": 4,
      "text": "Lake Keokee nearby offers a chance to spot dragonflies in summer and waterfowl in winter, making it a favorite spot for nature lovers.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://dwr.virginia.gov/vbwt/mountain-trail/MBS/"
    },
    {
      "id": 5,
      "text": "The lush green mountains surrounding Big Stone Gap East provide a scenic backdrop for enjoying local history, culture, and nature.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.virginia.org/places-to-visit/regions/heart-of-appalachia/big-stone-gap/"
    },
    {
      "id": 6,
      "text": "The town’s heritage is celebrated at the Meador Coal Museum, where artifacts detail the region’s once‑thriving coal industry.",
      "sourceSentenceIds": [
        4
      ],
