  "facts": [
    {
      "id": 1,
      "text": "New Sarpy takes its name from Leon Sarpy, a Tennessee native who fought at the Battle of Shiloh during the Civil War.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://scphistory.org/new-sarpy-town-history/",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "French explorers Pierre Le Moyne d'Iberville and Jean-Baptiste Le Moyne de Bienville first charted the area in 1699, naming it L’Anse aux Outardes.",
      "sourceSentenceIds": [
        6,
        7
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://kids.kiddle.co/New_Sarpy,_Louisiana",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "In 1722–23, settlers from France, Germany, and Canada received land grants on the east bank, founding the first east‑bank settlement at L’Anse aux Outardes.",
      "sourceSentenceIds": [
        24
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/New_Sarpy%2C_Louisiana",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "New Sarpy Elementary School, part of the Charles Parish Public School System, serves local students in the community.",
      "sourceSentenceIds": [
        27
