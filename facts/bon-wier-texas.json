      "id": 1,
      "text": "Bon Wier sprang to life in 1905 as a stop on the Jasper and Eastern Railway, linking Kirbyville to the Sabine River.",
      "sourceSentenceIds": [
        1,
        7
      ],
      "sourceLabels": [
        "Web source 1",
        "Wikipedia"
      ],
