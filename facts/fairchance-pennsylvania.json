  "facts": [
    {
      "id": 1,
      "text": "The borough’s name comes from Fidelus Oliphant’s promise of a “fair chance” to repay a Uniontown bank loan, a story that locals still share.",
      "sourceSentenceIds": [
        2,
        22,
        7,
        19,
        20,
        21
      ],
      "sourceLabels": [
        "Web source 1",
        "Wikipedia"
      ],
      "source": "https://grokipedia.com/page/fairchance_pennsylvania",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Permanent settlement began in 1752 when Wendall Brown and his sons established a homestead in Provance’s Bottom before moving to richer soils in Georges.",
      "sourceSentenceIds": [
        28
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/fairchance_pennsylvania",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Early economy hinged on iron production, with Oliphant’s furnaces drawing local siderite and Mercer ores before switching to coke fuel in the 1880s.",
      "sourceSentenceIds": [
        24,
        4
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/fairchance_pennsylvania",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "A railroad line opened between 1877 and 1882, linking Fairchance to the Southwest Pennsylvania Railway and eventually the Baltimore & Ohio network.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/fairchance_pennsylvania",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Fairchance sits at the western base of Chestnut Ridge, the westernmost major ridge of the Appalachian Mountains in this part of Pennsylvania.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Fairchance%2C_Pennsylvania",
      "category": "nature",
      "quality": "poor",
      "qualityReason": "location_description"
    },
    {
      "id": 6,
      "text": "The historic Fairchance Furnace, once a key ironworks, shifted from using local siderite to coke fuel by the 1880s, reflecting industrial change.",
      "sourceSentenceIds": [
