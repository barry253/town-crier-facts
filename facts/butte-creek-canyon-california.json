      "id": 1,
      "text": "Butte Creek Canyon is a 110‑mile tributary of the Sacramento River that winds through a spectacular mini‑Grand Canyon before reaching the valley floor.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 2"
      ],
