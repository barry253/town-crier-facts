    {
      "id": 1,
      "text": "Hodgenville is the birthplace of Abraham Lincoln, and the National Historical Park preserves the cabin where he was born.",
      "sourceSentenceIds": [
        17,
        2,
        4
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Hodgenville%2C_Kentucky",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Downtown Hodgenville hosts the Lincoln Museum, where two bronze statues—Lincoln as a child and as an adult—stand in the town square.",
      "sourceSentenceIds": [
        21
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Hodgenville%2C_Kentucky",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The city lies along the North Fork of the Nolin River, a tributary that flows into the Green River.",
      "sourceSentenceIds": [
        10,
        22
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Hodgenville%2C_Kentucky",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "After building a mill in 1789, settlers incorporated Hodgenville on February 18, 1836, formalizing the community that grew around it.",
      "sourceSentenceIds": [
        13,
        16
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Hodgenville%2C_Kentucky",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Hodgenville’s LaRue County Public Library offers lending services to residents and visitors alike.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Hodgenville%2C_Kentucky",
      "category": "landmark",
      "quality": "good"
    },
    {
