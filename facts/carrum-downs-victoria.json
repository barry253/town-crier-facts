  "facts": [
    {
      "id": 1,
      "text": "Carrum Downs grew out of a 15‑km‑long, up to 8‑km‑wide Carrum Swamp that once covered the area.",
      "sourceSentenceIds": [
        17,
        18
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Carrum_Downs"
    },
    {
      "id": 2,
      "text": "The suburb’s name comes from the Indigenous term Karrum Karrum, meaning “boomerang,” a nod to the bay’s shape.",
      "sourceSentenceIds": [
        15
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Carrum_Downs"
    },
    {
      "id": 3,
      "text": "Carrum Downs Post Office opened on 1 November 1909, marking the town’s first formal postal service.",
      "sourceSentenceIds": [
        30
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Carrum_Downs"
    },
    {
      "id": 4,
      "text": "The Carrum Downs Health Precinct now hosts pathology, radiology, dental, physiotherapy and a retail gym, all under one roof.",
      "sourceSentenceIds": [
