  "facts": [
    {
      "id": 1,
      "text": "Ruzyne Airport was renamed after Václav Havel in 2012, honoring the last Czechoslovak and first Czech president.",
      "sourceSentenceIds": [
        1,
        17
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/V%C3%A1clav_Havel_Airport_Prague",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The main runway 06/24 was rebuilt from 2012 to 2013, while runway 12/30 remained the only usable one during that period.",
      "sourceSentenceIds": [
        18,
        19
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/V%C3%A1clav_Havel_Airport_Prague",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Ruzyne sits 12 kilometres west of Prague’s centre, right beside the village of Kněževes, and 12 kilometres southeast of Kladno.",
      "sourceSentenceIds": [
        15
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/V%C3%A1clav_Havel_Airport_Prague",
      "category": "other",
      "quality": "poor",
      "qualityReason": "location_description"
    },
    {
      "id": 4,
      "text": "In 2018, the airport handled roughly 17 million passengers, making it one of the busiest in Central Europe.",
      "sourceSentenceIds": [
        16
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/V%C3%A1clav_Havel_Airport_Prague",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Since 2024, trolleybus line 59 links both terminals directly to metro station Nádraží Veleslavín, a quick hop to the city centre.",
      "sourceSentenceIds": [
        11
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/V%C3%A1clav_Havel_Airport_Prague",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "A major terminal expansion is slated to begin in 2027 or 2028, adding new gates and extending check‑in areas.",
