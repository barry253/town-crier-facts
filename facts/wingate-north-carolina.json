  "facts": [
    {
      "id": 1,
      "text": "Wingate takes its name from Washington Manly Wingate, a former president of Wake Forest College.",
      "sourceSentenceIds": [
        1,
        2
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Wingate%2C_North_Carolina"
    },
    {
      "id": 2,
      "text": "The town was officially chartered as an incorporated village in 1901 by the North Carolina legislature.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.townofwingatenc.gov/181/History"
    },
    {
      "id": 3,
      "text": "Railroad tracks first cut through the area in 1874, sparking the growth of a village that would become Wingate.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.townofwingatenc.gov/181/History"
    },
    {
      "id": 4,
      "text": "Wingate’s first bank opened its doors in 1909, marking the town’s early financial development.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.townofwingatenc.gov/181/History"
    },
    {
      "id": 5,
      "text": "Wingate University, founded in 1924, remains a central landmark and cultural hub for the town.",
      "sourceSentenceIds": [
