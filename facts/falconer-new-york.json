  "facts": [
    {
      "id": 1,
      "text": "Falconer was first called Worksburg after Edward Work, who bought the land from the Holland Land Company in 1807.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Falconer%2C_New_York",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "In 1874 the village adopted the name Falconer, honoring William T. Falconer, a railroad land donor.",
      "sourceSentenceIds": [
        18
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Falconer%2C_New_York",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The Chadakoin River, the outlet of Chautauqua Lake, winds through Falconer before joining Cassadaga Creek at Levant.",
      "sourceSentenceIds": [
        23
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Falconer%2C_New_York",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Falconer’s 25‑mph speed limit is the lowest in Chautauqua County, while Route 394 runs at 35 mph.",
      "sourceSentenceIds": [
        27
      ],
      "sourceLabels": [
