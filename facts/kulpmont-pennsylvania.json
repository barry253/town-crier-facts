  "facts": [
    {
      "id": 1,
      "text": "Kulpmont was incorporated as a borough on August 24, 1915, with its first council meeting held on January 3, 1916.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Kulpmont%2C_Pennsylvania"
    },
    {
      "id": 2,
      "text": "Unlike neighboring patch towns built by single coal companies, Kulpmont developed as an open residential hub.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Kulpmont%2C_Pennsylvania"
    },
    {
      "id": 3,
      "text": "Monroe Henry Kulp, a local businessman, spearheaded Kulpmont’s development and gave the town its name.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Kulpmont%2C_Pennsylvania"
    },
    {
      "id": 4,
      "text": "The Pennsylvania and Lehigh Valley Railroads ran nearby, shaping Kulpmont’s layout and coal transport routes.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Kulpmont%2C_Pennsylvania"
    },
    {
      "id": 5,
      "text": "When deep mining declined, Kulpmont diversified its economy by becoming a center for garment manufacturing.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Kulpmont%2C_Pennsylvania"
    },
    {
      "id": 6,
      "text": "After the 1944 closure of Alaska Colliery, the region transitioned toward surface strip mining, altering local employment patterns.",
      "sourceSentenceIds": [
        11
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Kulpmont%2C_Pennsylvania"
    }
