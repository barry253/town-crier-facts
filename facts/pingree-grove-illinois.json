  "facts": [
    {
      "id": 1,
      "text": "Pingree Grove began when Andrew and Daniel Pingree settled the area in 1838, laying the groundwork for a future village.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.villageofpingreegrove.org/202/History"
    },
    {
      "id": 2,
      "text": "The village’s name honors the Pingree family, who bought land from the federal government that same year.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.villageofpingreegrove.org/202/History"
    },
    {
      "id": 3,
      "text": "A post office opened two miles west of the village in 1838, and the Pingree Grove Post Office itself was established in 1848.",
      "sourceSentenceIds": [
        28,
        29
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.villageofpingreegrove.org/202/History"
    },
    {
      "id": 4,
      "text": "In 1882 Daniel and Hannah Pingree officially laid out and platted the village, giving it a formal town plan.",
      "sourceSentenceIds": [
        30
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.villageofpingreegrove.org/202/History"
    },
    {
      "id": 5,
      "text": "On February 10, 2010, a 3.8‑magnitude earthquake shook Pingree Grove, the first in Northern Illinois since 2004.",
      "sourceSentenceIds": [
        22,
        23,
        27
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Pingree_Grove%2C_Illinois"
    },
    {
      "id": 6,
      "text": "Route 20 runs through Pingree Grove, connecting it 17 miles northwest to Marengo and 7 miles southeast to Elgin.",
