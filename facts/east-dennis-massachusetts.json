      "id": 1,
      "text": "East Dennis is a picturesque village on Cape Cod Bay, bordering Brewster to the east.",
      "sourceSentenceIds": [
        3,
        20
      ],
      "sourceLabels": [
        "Web source 1",
        "Wikipedia"
      ],
