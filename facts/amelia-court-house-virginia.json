  "facts": [
    {
      "id": 1,
      "text": "Amelia Court House was named for Princess Amelia of Great Britain, the second daughter of King George II, in 1735.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Amelia_Court_House%2C_Virginia",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Founded amid Virginia’s Piedmont, the town grew around mixed‑crop plantations in a rural landscape.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Amelia_Court_House%2C_Virginia",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "When the Richmond and Danville Railroad reached the village in the 1850s, visitors began arriving by train.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Amelia_Court_House%2C_Virginia",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The 1923‑24 Colonial‑style courthouse, built of red brick and concrete, still protects court records that survived the Civil War.",
      "sourceSentenceIds": [
        4,
        17,
        19
      ],
      "sourceLabels": [
        "Web source 1",
        "Wikipedia"
      ],
      "source": "https://www.vaco.org/county-connections/visit-amelia-county-and-the-amelia-county-courthouse/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Amelia Day, a May festival started in the 1980s, celebrates the town’s founding with music, dancing, and community food.",
      "sourceSentenceIds": [
