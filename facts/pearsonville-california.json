  "facts": [
    {
      "id": 1,
      "text": "Pearsonville was named for Lucy and Andrew Pearson, who founded the town on a 40‑acre plot they purchased in 1960.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Pearsonville%2C_California",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town once boasted a 1960s Uniroyal Tire-built “Uniroyal Gal” fiberglass statue, now a quirky local landmark.",
      "sourceSentenceIds": [
        2,
        7
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Pearsonville%2C_California",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The Pearson family started Pearson’s Auto Wrecking in 1964, a towing and recovery business that still operates today.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Pearsonville%2C_California",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Pearsonville sits on the northern edge of Indian Wells Valley, 17.25 miles northwest of Ridgecrest, right on the Kern‑Inyo county line.",
