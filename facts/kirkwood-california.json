  "facts": [
    {
      "id": 1,
      "text": "Zack Kirkwood, a cattle rancher, opened an inn called Kirkwood's in 1863 along the Amador/Nevada Wagon Toll Road.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Kirkwood%2C_California"
    },
    {
      "id": 2,
      "text": "The inn later became a fashionable summer resort before evolving into the Kirkwood Mountain Resort we know today.",
      "sourceSentenceIds": [
        11,
        12
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Kirkwood%2C_California"
    },
    {
      "id": 3,
      "text": "Kirkwood sits at the historic convergence of Alpine, Amador, and El Dorado counties, a junction still marked inside the original inn building.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Kirkwood%2C_California"
    },
    {
      "id": 4,
      "text": "The town lies within the Eldorado National Forest, surrounded by the Sierra Nevada mountains.",
      "sourceSentenceIds": [
        9,
        27
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Kirkwood%2C_California"
    },
    {
      "id": 5,
      "text": "When the resort was built, it operated on its own micro‑utility, supplying power without connecting to the state grid.",
      "sourceSentenceIds": [
        22
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Kirkwood%2C_California"
    },
    {
      "id": 6,
      "text": "Kirkwood was formerly known as Kirk, Kirkwood's, and Roundtop before settling on its current name.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Kirkwood%2C_California"
