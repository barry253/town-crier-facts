  "facts": [
    {
      "id": 1,
      "text": "Shawneetown sits on the site of a former Shawnee community, hence the name.",
      "sourceSentenceIds": [
        14
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Shawneetown%2C_Missouri",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The village was founded by Shawnee immigrants from Ohio and Indiana and Delaware immigrants from Delaware and New Jersey, who were living with the Shawnee in Ohio and Indiana.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Shawneetown%2C_Missouri",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Spanish authorities invited the Shawnee and Delaware to settle there in 1787 as a buffer between French settlements and the Osage.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Shawneetown%2C_Missouri",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Shawneetown operated its own post office from 1871 to 1907 and again from 1913 to 1946.",
      "sourceSentenceIds": [
        19
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Shawneetown%2C_Missouri",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The community is located twenty miles north of Cape Girardeau and is part of the Cape Girardeau–Jackson metropolitan area.",
      "sourceSentenceIds": [
        13
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Shawneetown%2C_Missouri",
