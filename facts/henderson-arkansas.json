  "facts": [
    {
      "id": 1,
      "text": "Henderson first sprang up around 1860, just a mile west of where it sits today.",
      "sourceSentenceIds": [
        11
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://norforklakefun.com/the_village_of_henderson/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Frank Smith started a North Fork River ferry around 1902, making the river the town’s main artery.",
      "sourceSentenceIds": [
        13
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://norforklakefun.com/the_village_of_henderson/",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The ferry was replaced in December 1934 by a concrete bridge that linked the two riverbanks.",
      "sourceSentenceIds": [
        15
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://norforklakefun.com/the_village_of_henderson/",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "When the Corps built Norfork Dam, Henderson’s original homes were demolished and later submerged under 15 feet of lake water.",
      "sourceSentenceIds": [
        17,
        18
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://norforklakefun.com/the_village_of_henderson/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Today Henderson sits on higher ground, hosting Lake Norfork Marina, a hotel, a resort, and a realtor office.",
      "sourceSentenceIds": [
        24
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://norforklakefun.com/the_village_of_henderson/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The final ferry for US 62 and AR 101, nicknamed the “Arkansas Navy,” sailed its last route in 1984 when the Memorial Bridges opened.",
      "sourceSentenceIds": [
