  "facts": [
    {
      "id": 1,
      "text": "Mono City sits just north of Mono Lake, where salty waters and tufa towers rise from the lakebed.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/mono_city_california",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town’s economy centers on retirement living, seasonal visitors drawn to Mono Lake’s tufa formations, and the historic Mono Inn.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/mono_city_california",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Mono City’s early growth mirrored the late‑19th‑century mining and ranching boom that swept the Mono Basin.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/mono_city_california",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Monoville, an earlier settlement nearby, vanished by the early 1860s after water shortages and short mining seasons depleted its prospects.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/mono_city_california",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The Mono Inn, founded in 1922 as a bunkhouse and restaurant, helped attract settlers and travelers to the area.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/mono_city_california",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Volcanic eruptions and repeated Sierra Nevada glaciations have carved Mono Valley’s basin, leaving moraines that shape local hydrology.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/mono_city_california",
      "category": "nature",
      "quality": "good"
    }
