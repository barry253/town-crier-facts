  "facts": [
    {
      "id": 1,
      "text": "Ravensworth’s name comes from the English estate that was the seat of the Barons of Ravensworth.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.ravensworthfarm.org/early-history",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The original plantation was granted to William Fitzhugh in the late 1600s, a man who never lived there but hired French Huguenot tenants to grow tobacco.",
      "sourceSentenceIds": [
        5,
        27
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.ravensworthfarm.org/early-history",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The mansion, built in the late 1700s, burned to the ground on August 1, 1926, leaving only a few surviving portraits.",
      "sourceSentenceIds": [
        10,
        20,
        4
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Ravensworth%2C_Virginia",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Ravensworth Farm was the largest land grant in Fairfax County, spanning nearly 22,000 acres when William Fitzhugh purchased it in 1685.",
      "sourceSentenceIds": [
        1,
        26
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.ravensworthfarm.org/early-history",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "During the Civil War, the estate’s slave quarters and cemetery were still visible, as recalled by resident John Hawthorne in an oral history interview.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://fairfaxaahi.centerformasonslegacies.com/items/show/98",
      "category": "people",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The Ravensworth subdivision that exists today was developed in the early 1960s, transforming the historic plantation into a residential community.",
      "sourceSentenceIds": [
        11
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Ravensworth%2C_Virginia",
