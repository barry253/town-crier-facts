      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "John Kindler’s 1936 house on Percival Terrace showcases the popular Interwar Old English style that defined Holland Park’s early architecture.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
