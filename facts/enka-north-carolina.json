  "facts": [
    {
      "id": 1,
      "text": "Enka’s name comes from the Dutch initials N and K of Nederlandse Kunstzijdefabriek, the rayon company that founded the town.",
      "sourceSentenceIds": [
        13
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Enka%2C_North_Carolina",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The American Enka Company, founded in 1928, built what became the nation’s largest rayon‑producing factory.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Enka%2C_North_Carolina",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "In 1929 the company developed Enka Village, a planned community with employee houses that grew into a historic neighborhood.",
      "sourceSentenceIds": [
        16
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Enka%2C_North_Carolina",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "A 2023 industrial redevelopment plan approved only if the historic clock tower is preserved, keeping a key landmark alive.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Enka%2C_North_Carolina",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Enka Lake Club opened on a lake built to supply the rayon plant, later becoming part of a private community.",
      "sourceSentenceIds": [
        24
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Enka%2C_North_Carolina",
      "category": "landmark",
      "quality": "good"
    },
    {
