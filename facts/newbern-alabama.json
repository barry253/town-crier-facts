  "facts": [
    {
      "id": 1,
      "text": "Newbern was originally called Cane Brake because of abundant cane, then renamed after New Bern, North Carolina, the former seat of the British Province.",
      "sourceSentenceIds": [
        1,
        6
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://encyclopediaofalabama.org/article/newbern/",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "In 1829, Harvey Tyndall and Simpson Hemphill opened Newbern’s first store, dubbed Grab All, marking the town’s early commercial start.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://encyclopediaofalabama.org/article/newbern/",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The 1859 arrival of a railroad from Uniontown linked Newbern to the Selma‑Demopolis line, boosting cotton exports before the Civil War.",
      "sourceSentenceIds": [
        18,
        20
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/Newbern,_Alabama",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Newbern’s historic district is listed on the Alabama Register of Landmarks and History, preserving many 19th‑century structures.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://encyclopediaofalabama.org/article/newbern/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "During the Civil War, Newbern supplied soldiers to the Fifth, Eleventh, and Twentieth Alabama regiments, reflecting its deep Confederate ties.",
      "sourceSentenceIds": [
        22
      ],
      "sourceLabels": [
        "Web source 1"
      ],
