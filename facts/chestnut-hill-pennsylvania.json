  "facts": [
    {
      "id": 1,
      "text": "Chestnut Hill’s roots trace back to the 17th century when it was part of the German Township, founded by Francis Daniel Pastorius.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.experiencepa.com/chestnut-hill/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "In 1884, the Philadelphia, Germantown and Chestnut Hill Railroad added a second line, cementing the area’s status as a railroad suburb of Center City.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Chestnut_Hill%2C_Philadelphia",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The Chestnut Hill Conservancy protects the neighborhood’s historic facades and tree‑lined sidewalks, earning it praise as one of the best main streets in the U.S.",
      "sourceSentenceIds": [
        22,
        23
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.experiencepa.com/chestnut-hill/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Chestnut Hill’s park features forested paths, historic bridges, and a serene creek, making it a favorite spot for outdoor enthusiasts.",
      "sourceSentenceIds": [
        24
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.experiencepa.com/chestnut-hill/",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The Chestnut Hill Branch of the Free Library of Philadelphia sits at 8711 Germantown Avenue, serving the community with a rich collection.",
