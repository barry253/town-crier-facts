  "facts": [
    {
      "id": 1,
      "text": "Tipton was founded in 1858 by William Tipton Seely, a War of 1812 veteran, and became the eastern terminus of the Butterfield Overland Mail stagecoach route.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/Tipton,_Missouri",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Tipton’s 158‑foot 8‑Ball Water Tower, painted black with white markings in 1968 by Fischer Manufacturing, holds 110,000 gallons and is a local landmark.",
      "sourceSentenceIds": [
        26
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/Tipton,_Missouri",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The Moniteau County Courthouse, built in 1882, sits in Tipton and is listed on the National Register of Historic Places.",
      "sourceSentenceIds": [
        16
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://museumsdatabase.com/museums/view/17606",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Tipton’s public library, the Price James Memorial Library, was established with a voter‑approved property tax in 2017 and is recognized by the State Library.",
      "sourceSentenceIds": [
        22
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Tipton%2C_Missouri",
      "category": "other",
      "quality": "poor",
      "qualityReason": "vague"
    },
    {
      "id": 5,
      "text": "The town’s name honors William Tipton Seely, an English‑born immigrant who ran a trading post at nearby Round Hill in the 1850s.",
      "sourceSentenceIds": [
        25
      ],
      "sourceLabels": [
        "Web source 1"
      ],
