  "facts": [
    {
      "id": 1,
      "text": "Keachi’s name derives from the Kichai tribe, a Caddo Confederacy group that once inhabited the area.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/keachi_louisiana"
    },
    {
      "id": 2,
      "text": "Before incorporation, Keachi’s Presbyterian, Methodist, and Baptist churches served as the town’s social and religious centers.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/keachi_louisiana"
    },
    {
      "id": 3,
      "text": "Keachie College, founded in 1857, taught Latin, Greek, and sciences and became co‑educational by 1879.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/keachi_louisiana"
    },
    {
      "id": 4,
      "text": "During the Civil War, Keachie College was converted into a hospital for wounded soldiers from the Battle of Mansfield.",
      "sourceSentenceIds": [
        28
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/keachi_louisiana"
    },
    {
      "id": 5,
      "text": "Keachi is celebrated for its preserved Greek Revival architecture, including the historic Baptist and Methodist churches.",
      "sourceSentenceIds": [
        29
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/keachi_louisiana"
    },
    {
      "id": 6,
      "text": "The Keachi Heritage Foundation keeps the town’s past alive with cemetery cleanups and historical gatherings.",
      "sourceSentenceIds": [
        9
