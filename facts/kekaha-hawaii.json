  "facts": [
    {
      "id": 1,
      "text": "The Kekaha Sugar Company was founded in 1878, becoming the town's main employer for the next 120 years.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.kupi.com/en/explore/united-states/kekaha/history",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The sugar mill shaped Kekaha's development, influencing banking, employment, transportation, housing, and utilities like water and electricity.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Kekaha%2C_Hawaii",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Kekaha evolved from a traditional ahupuaʻa into a modern settlement only in the second half of the 19th century.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.kupi.com/en/explore/united-states/kekaha/history",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The town sits on Kauai's dry leeward side, at the mountain base and near the Mana plains.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.kupi.com/en/explore/united-states/kekaha/history",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The historic smokestack of the Kekaha Sugar Mill still towers above the town, a landmark from 1898 until 2000.",
      "sourceSentenceIds": [
        25
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://historichawaii.org/historic-property-ka/kekaha-sugar-mill/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "In 1992, Hurricane Iniki struck Kekaha, causing significant damage to homes and plantations and reshaping the community.",
