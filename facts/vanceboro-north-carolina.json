      "id": 1,
      "text": "Vanceboro was originally called Swift Creek before residents renamed it in 1877 to honor Governor Zebulon Vance.",
      "sourceSentenceIds": [
        1,
        5
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Vanceboro%2C_North_Carolina",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town sits on the east bank of winding Swift Creek, about sixteen miles northeast of New Bern.",
      "sourceSentenceIds": [
        19
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.vanceboronc.com/about-our-town",
      "category": "other",
      "quality": "poor",
      "qualityReason": "location_description"
    },
    {
      "id": 3,
      "text": "In the late 19th century, Vanceboro grew around a railroad stop that served steamboats twice weekly to New Bern.",
      "sourceSentenceIds": [
        3,
        27
      ],
      "sourceLabels": [
        "Web source 2"
      ],
