  "facts": [
    {
      "id": 1,
      "text": "After the Tennessee Midland Railway reached Beech Bluff in 1888‑1890, the community officially adopted the name Beech Bluff, named for a nearby beech‑tree‑lined bluff.",
      "sourceSentenceIds": [
        14
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Beech_Bluff%2C_Tennessee",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The community was historically home to a high school, founded as a one‑room schoolhouse in 1885 and closed during desegregation in 1977.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Beech_Bluff%2C_Tennessee",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "In 1852, a post office was established at Beech Bluff, which was then also known as Homer and used as a summer resort.",
      "sourceSentenceIds": [
        13
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Beech_Bluff%2C_Tennessee",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The area which is now Beech Bluff was first inhabited by the Chickasaw, from whom an earthwork remains.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Beech_Bluff%2C_Tennessee",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Beech Bluff is built on deposits of loess which have developed brown or grayish brown silt loam soils.",
