  "facts": [
    {
      "id": 1,
      "text": "Natural Bridge earned its name from a 148‑foot‑long sandstone arch that rises 60 feet high.",
      "sourceSentenceIds": [
        1,
        4
      ],
      "sourceLabels": [
        "Web source 1",
        "Web source 2"
      ],
      "source": "https://encyclopediaofalabama.org/article/natural-bridge/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Byler Road, Alabama’s first state‑built turnpike, cuts through Natural Bridge and helped spark early 19th‑century settlement.",
      "sourceSentenceIds": [
        28,
        12
      ],
      "sourceLabels": [
        "Web source 1",
        "Web source 2"
      ],
      "source": "https://encyclopediaofalabama.org/article/natural-bridge/",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The North Alabama Railroad arrived in 1895, hauling coal and timber to markets in Jasper and Haleyville.",
      "sourceSentenceIds": [
        6,
        11
      ],
      "sourceLabels": [
        "Web source 1",
        "Web source 2"
      ],
      "source": "https://encyclopediaofalabama.org/article/natural-bridge/",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "During the Civil War, the bridge area served as a refuge for Unionists evading the draft and Confederate deserters.",
      "sourceSentenceIds": [
        30
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://encyclopediaofalabama.org/article/natural-bridge/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Visitors can walk beneath the arch at Natural Bridge Park, which opens the landmark to the public.",
      "sourceSentenceIds": [
        18
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Natural_Bridge%2C_Alabama",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Before Europeans arrived, Creek Indians used the bridge’s cave‑like spaces for shelter.",
