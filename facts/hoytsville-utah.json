  "facts": [
    {
      "id": 1,
      "text": "Thomas Bradberry founded Hoytsville in 1859, though the settlement was first known as East Plymouth and later as Unionville.",
      "sourceSentenceIds": [
        2,
        7,
        25,
        26
      ],
      "sourceLabels": [
        "Web source 1",
        "Web source 2",
        "Wikipedia"
      ],
      "source": "https://www.summitcountyutah.gov/146/Hoytsville-Settlement"
    },
    {
      "id": 2,
      "text": "Hoytsville was renamed in 1874 to honor early settler Samuel P. Hoyt and his wife Emily.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/hoytsville_utah"
    },
    {
      "id": 3,
      "text": "Settlers in Hoytsville built a fort for protection during the Utah Black Hawk War, and the foundation is still identifiable today.",
      "sourceSentenceIds": [
        27
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Hoytsville%2C_Utah"
    },
    {
      "id": 4,
      "text": "The Hoyt Mansion in Hoytsville is considered one of the most elegant nineteenth century homes still standing in Utah.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Hoytsville%2C_Utah"
    },
    {
      "id": 5,
      "text": "Samuel P. Hoyt established the first flour mill in Summit County and operated the local post office from his home.",
      "sourceSentenceIds": [
        28,
        29
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Hoytsville%2C_Utah"
    },
    {
      "id": 6,
      "text": "Farmers in Hoytsville primarily focus on dairy farming, beef ranching, and raising sheep for wool.",
