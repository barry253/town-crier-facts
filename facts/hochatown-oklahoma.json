  "facts": [
    {
      "id": 1,
      "text": "Hochatown was named for a Choctaw Indian who arrived in the area in 1833 during the Trail of Tears.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/Hochatown_Oklahoma"
    },
    {
      "id": 2,
      "text": "The original town of Hochatown grew around the Choctaw Lumber and Coal Company and gained a post office in 1894.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Hochatown%2C_Oklahoma"
    },
    {
      "id": 3,
      "text": "During the 1920s and 1930s, the community of Hochatown became well known for its moonshine production.",
      "sourceSentenceIds": [
        19
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Hochatown%2C_Oklahoma"
    },
    {
      "id": 4,
      "text": "The original townsite of Hochatown was submerged beneath the waters of Broken Bow Lake in 1970.",
      "sourceSentenceIds": [
        13
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/Hochatown,_Oklahoma"
    },
    {
      "id": 5,
      "text": "Hochatown is located in the Little Dixie region, which was largely settled by Southerners after the Civil War.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Hochatown%2C_Oklahoma"
    },
    {
      "id": 6,
      "text": "McCurtain County Commissioners passed articles of incorporation to re-establish Hochatown as a municipality on November 28, 2022.",
      "sourceSentenceIds": [
        25
