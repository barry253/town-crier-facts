  "facts": [
    {
      "id": 1,
      "text": "Linden takes its name from the linden trees that once lined the Middle Raccoon River, a natural landmark that shaped the town.",
      "sourceSentenceIds": [
        10,
        13
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/linden_iowa"
    },
    {
      "id": 2,
      "text": "In 1879 the Des Moines, Adel, and Western Railway arrived, and pioneers Elisha Evans and Matthew Burnham donated land for the station, igniting Linden's growth.",
      "sourceSentenceIds": [
        2,
        3,
        15
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/linden_iowa"
    },
    {
      "id": 3,
      "text": "By 1897 Linden boasted 30 businesses, a bank founded in 1890, and its own newspaper, The Linden Guidon.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/linden_iowa"
    },
    {
      "id": 4,
      "text": "Linden opened its public library in 1960, a community hub that continues to serve residents with books and events.",
      "sourceSentenceIds": [
        16
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/linden_iowa"
    },
    {
      "id": 5,
      "text": "The Linden Lions Club was chartered in 1967 and built a community building in the city park by 1970.",
