  "facts": [
    {
      "id": 1,
      "text": "Bellefonte takes its name from the French words for beautiful foundry, referring to an iron furnace that operated here from 1826 to 1893.",
      "sourceSentenceIds": [
        1,
        28
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Bellefonte%2C_Kentucky"
    },
    {
      "id": 2,
      "text": "The unusual topography of Bellefonte was created by the ancient Teays River, which is clearly visible on topographical maps.",
      "sourceSentenceIds": [
        30
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Bellefonte%2C_Kentucky"
    },
    {
      "id": 3,
      "text": "Bellefonte was originally part of the several thousand-acre Wheatley farm before it was developed into a residential area.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Bellefonte%2C_Kentucky"
    },
    {
      "id": 4,
      "text": "The Means and Russell Iron Company began selling town lots in Bellefonte starting in 1918.",
      "sourceSentenceIds": [
        27
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Bellefonte%2C_Kentucky"
    },
    {
      "id": 5,
      "text": "Bellefonte was first incorporated on July 3, 1951, beginning with only 275 residents.",
      "sourceSentenceIds": [
        14
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Bellefonte%2C_Kentucky"
    },
    {
      "id": 6,
      "text": "A few original log-built dwellings from the 1800s iron furnace settlement still remain as upscale residential homes along Route 5 in Bellefonte.",
