  "facts": [
    {
      "id": 1,
      "text": "Woodlawn Cemetery, opened in 1863, earned National Historic Landmark status in 2011 for its transition from a rural cemetery to a more orderly design.",
      "sourceSentenceIds": [
        4,
        5
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
