  "facts": [
    {
      "id": 1,
      "text": "Campos Elíseos began as a planned neighborhood in 1878, laid out by Frederico Glette and Victor Nothmann with wide streets and large plots.",
      "sourceSentenceIds": [
        18,
        23
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Campos_El%C3%ADseos_(S%C3%A3o_Paulo)",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The area was once called Campo Redondo, a farm that later became the site of the famous Praça Princesa Isabel, where horse races ran until 1876.",
      "sourceSentenceIds": [
        22,
        7
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Campos_El%C3%ADseos_(S%C3%A3o_Paulo)",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "In 1907 the Elias Chaves Palace, modeled after France’s Château d’Écouen, became the residence of São Paulo’s provincial presidents and was renamed Campos Elíseos Palace.",
      "sourceSentenceIds": [
        3,
        26
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Campos_El%C3%ADseos_(S%C3%A3o_Paulo)",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The 1965 transfer of the state government to the Palácio dos Bandeirantes left Campos Elíseos Palace empty, sparking a wave of abandoned mansions.",
      "sourceSentenceIds": [
        11,
        10
      ],
      "sourceLabels": [
        "Web source 1",
        "Wikipedia"
      ],
      "source": "https://avidanocentro.com.br/cidades/campos-eliseos-historia/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The Júlio Prestes Station, opened in 1938, turned the neighborhood into a transport hub, prompting hotels and boarding houses to spring up around the new bus terminal.",
      "sourceSentenceIds": [
        15,
        16
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Campos_El%C3%ADseos_(S%C3%A3o_Paulo)",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "In 1977 the bus station closed and the building was reborn as Fashion Center Luz, a shopping mall that still echoes the area’s commercial past.",
      "sourceSentenceIds": [
        17
      ],
