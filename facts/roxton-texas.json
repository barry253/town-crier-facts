  "facts": [
    {
      "id": 1,
      "text": "Roxton began as Fort Shelton, a 1837 settlement founded by Eli Shelton on Cane Creek.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.tshaonline.org/handbook/entries/roxton-tx"
    },
    {
      "id": 2,
      "text": "The town’s post office was renamed Roxton in 1869, cementing the new name.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.tshaonline.org/handbook/entries/roxton-tx"
    },
    {
      "id": 3,
      "text": "In 1887 the Gulf, Colorado and Santa Fe Railway extended a line half a mile west of the original site, prompting most residents to relocate and leaving the old townsite known as Old Roxton.",
      "sourceSentenceIds": [
        9,
        10
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.tshaonline.org/handbook/entries/roxton-tx"
    },
    {
      "id": 4,
      "text": "The city’s core values emphasize small‑town charm, preservation of heritage, and a welcoming spirit.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://cityofroxton.com/"
    },
    {
      "id": 5,
      "text": "Roxton lies at the junction of Farm Roads 137 and 38, eighteen miles southwest of Paris in Lamar County.",
