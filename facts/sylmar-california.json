    },
    {
      "id": 3,
      "text": "Sylmar’s olive groves, planted with Mission, Nevadillo Blanco, and Manzanillo varieties, trace back to the 18th‑century mission era.",
      "sourceSentenceIds": [
        14,
        26
      ],
      "sourceLabels": [
