  "facts": [
    {
      "id": 1,
      "text": "Bonneau Beach takes its name from the influential Bonneau family, French Huguenots who settled in South Carolina during the late 1600s.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/bonneau_beach_south_carolina"
    },
    {
      "id": 2,
      "text": "The area was once home to the Santee Indian Mound, a prehistoric ceremonial site that is now submerged beneath the lake.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.trawellino.com/destinations/united-states/south-carolina_bonneau-beach"
    },
    {
      "id": 3,
      "text": "Bonneau's Ferry began operating in 1712, serving as a crucial crossing on the Eastern Branch of the Cooper River.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/bonneau_beach_south_carolina"
    },
    {
      "id": 4,
      "text": "Lake Moultrie was created in the early 1940s through the construction of the Pinopolis Dam for flood control and hydroelectric power.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/bonneau_beach_south_carolina"
    },
    {
      "id": 5,
      "text": "Bonneau Beach sits on the shore of Lake Moultrie as part of the larger Santee-Cooper Lakes system.",
      "sourceSentenceIds": [
        8,
        13
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Bonneau_Beach%2C_South_Carolina"
    },
    {
      "id": 6,
      "text": "The region's Lowcountry location brings moist air from the Atlantic Ocean, contributing to consistently high humidity levels throughout the year.",
