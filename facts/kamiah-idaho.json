  "facts": [
    {
      "id": 1,
      "text": "The name 'Kamiah' is Nez Perce for 'many rope litters,' as Nez Perce manufactured 'Kamia' ropes in the area to fish steelhead.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Kamiah%2C_Idaho",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "On their return trip east, the Lewis and Clark Expedition camped in the Kamiah area for several weeks during the spring of 1806, waiting for snows to melt.",
      "sourceSentenceIds": [
        13
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Kamiah%2C_Idaho",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Here also is the Nez Perce Historical Park Site, 'The Heart of the Monster' which is an important legend in Nez Perce Indian lore.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Web source 2"
      ],
