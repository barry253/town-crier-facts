  "facts": [
    {
      "id": 1,
      "text": "Marunouchi means \"inside the circle\" from its location within the palace's outer moat.",
      "sourceSentenceIds": [
        24
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Marunouchi",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The area was once an inlet of Tokyo Bay called Hibiya before Tokugawa filled it in 1592.",
      "sourceSentenceIds": [
        26
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Marunouchi",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Tokyo Station, opened 1914, sits in Marunouchi and its red‑brick façade is a striking contrast to nearby skyscrapers.",
      "sourceSentenceIds": [
        13
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.gotokyo.org/en/destinations/central-tokyo/tokyo-station-and-marunouchi/index.html",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Marunouchi houses 20 Fortune Global 500 headquarters, making it a global business hub.",
      "sourceSentenceIds": [
        25
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Marunouchi",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The Marunouchi Building, completed 1923, was one of the first modern office towers in Japan.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Marunouchi",
      "category": "landmark",
      "quality": "good"
    },
    {
