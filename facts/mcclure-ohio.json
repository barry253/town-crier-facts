  "facts": [
    {
      "id": 1,
      "text": "McClure was founded in the late 1870s when John McClure platted the village on his farm, and the town was named in his honor.",
      "sourceSentenceIds": [
        1,
        3
      ],
      "sourceLabels": [
        "Web source 1",
        "Wikipedia"
      ],
      "source": "https://grokipedia.com/page/mcclure_ohio",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The village officially incorporated in 1886, a few years after railroads began reaching the area and boosting local farming growth.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/mcclure_ohio",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "McClure remained Ohio’s last hand‑cranked telephone town until 1975, when residents finally abandoned the manual system for the future communications.",
      "sourceSentenceIds": [
        11,
        23
      ],
      "sourceLabels": [
        "Wikipedia",
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/McClure%2C_Ohio",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Volunteer workers started the local telephone company in 1908, bought Bell equipment, and later sold it to Otto Miller in 1970, renaming it McClure Telephone Company.",
      "sourceSentenceIds": [
        14,
        15,
        5
      ],
      "sourceLabels": [
        "Wikipedia",
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/McClure%2C_Ohio",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "McClure’s manual telephone operator system served as an informal information hub, connecting residents before modern phones arrived today.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Web source 1"
      ],
