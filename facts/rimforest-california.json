    {
      "id": 1,
      "text": "Rimforest sits at roughly 5,650 feet in the San Bernardino Mountains, between Crestline and Lake Arrowhead.",
      "sourceSentenceIds": [
        9,
        11,
        12
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/rimforest_california",
      "category": "nature",
      "quality": "poor",
      "qualityReason": "vague"
    },
    {
      "id": 2,
      "text": "The community grew from land tracts subdivided 1921-1946, with cabins, motels, and a post office by 1950.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/rimforest_california",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Rimforest was built along Rim of the World Drive, constructed 1915-1916 to open the high country to tourists.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/rimforest_california",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The Serrano people, called \"people of the mountains,\" have inhabited the area for at least 10,000 years.",
      "sourceSentenceIds": [
        2,
        4,
        25
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/rimforest_california",
      "category": "people",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Rimforest lies within a Very High Fire Hazard Severity Zone, with dense coniferous forests and dry conditions fueling wildfires.",
      "sourceSentenceIds": [
        14,
        20
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/rimforest_california",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The area receives 30-40 inches of precipitation annually, mostly as snow from November to March, reaching up to 50 inches in deep winter.",
