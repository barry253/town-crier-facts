  "facts": [
    {
      "id": 1,
      "text": "Punggol’s name comes from the Malay phrase meaning “throwing sticks to bring down fruit,” a nod to its farming past.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://punggoltown.com/about/"
    },
    {
      "id": 2,
      "text": "The 120‑year‑old Punggol bungalow, now part of a condominium, is the town’s last surviving historical house.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.sg101.gov.sg/resources/archives/ourneighbourhood-punggol/"
    },
    {
      "id": 3,
      "text": "Punggol Waterway, Singapore’s longest man‑made waterway, stretches 4.2 km and gives the town its waterfront character.",
      "sourceSentenceIds": [
        8,
        28
      ],
      "sourceLabels": [
        "Web source 1",
        "Wikipedia"
      ],
      "source": "https://www.sg101.gov.sg/resources/archives/ourneighbourhood-punggol/"
    },
    {
      "id": 4,
      "text": "The Punggol LRT east loop opened in 2005, while the west loop began service in 2014, linking the town to the city.",
      "sourceSentenceIds": [
        15
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Punggol"
    },
    {
      "id": 5,
      "text": "In 2007, the Punggol 21 Plus plan re‑imagined the area as a waterfront town, sparking the development of the Punggol Waterway.",
      "sourceSentenceIds": [
        27,
        28
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Punggol"
    },
    {
      "id": 6,
      "text": "Punggol’s earliest settlement dates back to the early 1800s, making it one of Singapore’s oldest villages.",
      "sourceSentenceIds": [
