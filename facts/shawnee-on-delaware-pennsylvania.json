      ],
      "source": "https://en.wikipedia.org/wiki/Shawnee_on_Delaware%2C_Pennsylvania",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "A state historical marker at Rivers Edge Park commemorates the Shawnee/Minisink Archaeological Site, highlighting the area’s Native American heritage.",
      "sourceSentenceIds": [
