      "id": 1,
      "text": "East McKeesport was named after the McKee family, early pioneers who settled the area in the mid‑1700s.",
      "sourceSentenceIds": [
        1,
        24,
        26
      ],
      "sourceLabels": [
        "Web source 1"
      ],
