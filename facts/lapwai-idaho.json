  "facts": [
    {
      "id": 1,
      "text": "Lapwai sits in a valley carved by Lapwai Creek, just south of where it meets the Clearwater River.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Lapwai%2C_Idaho"
    },
    {
      "id": 2,
      "text": "The name Lapwai means \"place of the butterflies,\" a nod to the many butterflies that once swarmed the area.",
      "sourceSentenceIds": [
        14
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Lapwai%2C_Idaho"
    },
    {
      "id": 3,
      "text": "In 1836, Henry Spalding founded a Protestant mission among the Nez Perce near present‑day Lapwai.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Lapwai%2C_Idaho"
    },
    {
      "id": 4,
      "text": "Fort Lapwai, the town’s predecessor, operated from 1863 until 1884 before the village was incorporated in 1911.",
      "sourceSentenceIds": [
        12,
        13
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Lapwai%2C_Idaho"
    },
    {
      "id": 5,
      "text": "The Northern Idaho Indian Agency moved to Fort Lapwai in 1904, making the site a regional administrative center.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.nezpercecountymuseum.com/lapwai-idaho"
    },
    {
      "id": 6,
      "text": "The hills flanking Lapwai rise over 600 feet within a mile, creating dramatic scenery on both sides of the town.",
      "sourceSentenceIds": [
        16
      ],
