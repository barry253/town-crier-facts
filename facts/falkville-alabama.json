  "facts": [
    {
      "id": 1,
      "text": "Falkville began as Cowhead, first settled in 1820, just one year after Alabama became a state.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://encyclopediaofalabama.org/article/falkville/"
    },
    {
      "id": 2,
      "text": "The town takes its name from veteran Louis Falk, who opened the first store and served as postmaster.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://encyclopediaofalabama.org/article/falkville/"
    },
    {
      "id": 3,
      "text": "A Louisville & Nashville Railroad station opened in Falkville in 1872, linking the town to regional trade.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Falkville%2C_Alabama"
    },
    {
      "id": 4,
      "text": "Falkville incorporated three times—1876, 1886, and 1898—reflecting its evolving civic status in the late 19th century.",
      "sourceSentenceIds": [
        14
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Falkville%2C_Alabama"
    },
    {
      "id": 5,
      "text": "The Works Progress Administration built Falkville's town hall in 1936, a lasting reminder of New Deal architecture.",
      "sourceSentenceIds": [
        17
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Falkville%2C_Alabama"
    },
    {
