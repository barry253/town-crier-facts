  "facts": [
    {
      "id": 1,
      "text": "Pantops sits on a ridge east of Charlottesville, offering roadside overlooks of the Rivanna Valley and Blue Ridge foothills.",
      "sourceSentenceIds": [
        1,
        12,
        16
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.traveldojo.com/pantops-virginia/",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The neighborhood’s name comes from the topography around Pantops Mountain, developed as Charlottesville expanded eastward in the 20th and 21st centuries.",
      "sourceSentenceIds": [
        17
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.traveldojo.com/pantops-virginia/",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Pantops Mountain Road and U.S. Route 250 provide the main vehicle access, winding up to scenic viewpoints and picnic areas on the ridge.",
      "sourceSentenceIds": [
        21,
        22,
        24,
        26
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.traveldojo.com/pantops-virginia/",
      "category": "transport",
      "quality": "poor",
      "qualityReason": "route_only"
    },
    {
      "id": 4,
      "text": "The area is part of Albemarle County’s low rolling Piedmont terrain, with the Blue Ridge visible to the west from the ridge.",
      "sourceSentenceIds": [
        20
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.traveldojo.com/pantops-virginia/",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Pantops is a suburban extension of Charlottesville, lying just across the Rivanna River and close to the University of Virginia and Monticello.",
      "sourceSentenceIds": [
        4,
        5
      ],
      "sourceLabels": [
        "Web source 1",
        "Wikipedia"
      ],
      "source": "https://www.traveldojo.com/pantops-virginia/",
      "category": "other",
      "quality": "poor",
      "qualityReason": "location_description"
    },
    {
      "id": 6,
      "text": "The climate is humid subtropical, with warm summers peaking in July and cold winters, temperatures ranging from -4°C to 31°C.",
      "sourceSentenceIds": [
