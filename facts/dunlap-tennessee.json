      "quality": "good"
    },
    {
      "id": 3,
      "text": "In the 1980s and 1990s, the Sequatchie Valley Historical Association turned the old coke ovens into Dunlap Coke Ovens Park.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
