      "id": 1,
      "text": "Ballville was named for Colonel Ball, a local Indian fighter who led a squadron to victory on July 30, 1813.",
      "sourceSentenceIds": [
        2,
        3
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Ballville%2C_Ohio",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The community was first settled around 1840, the same year it was officially laid out.",
      "sourceSentenceIds": [
        4,
        5
      ],
      "sourceLabels": [
        "Web source 2",
        "Wikipedia"
      ],
      "source": "https://kids.kiddle.co/Ballville,_Ohio",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "During the 1813 battle, Colonel Ball’s squadron charged an unexpected Indian attack near what is now Oakwood Cemetery.",
      "sourceSentenceIds": [
        26,
        27
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.ballville.org/history/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Ball’s first township election took place in April 1822 at the home of David Chambers.",
      "sourceSentenceIds": [
        25
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.ballville.org/history/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Oakwood Cemetery today marks the site where the squadron’s charge ended without any soldier casualties.",
