  "facts": [
    {
      "id": 1,
      "text": "Oakridge grew from forested farmland to a mid‑century residential and shopping hub during the 1950s and 1960s.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://vancouver.page/place/oakridge-neighbourhood-vancouver/"
    },
    {
      "id": 2,
      "text": "Oakridge Park, once called Oakridge Centre, anchors the neighbourhood at the corner of West 41st Avenue and Cambie Street.",
      "sourceSentenceIds": [
        29,
        30
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Oakridge_Park"
    },
    {
      "id": 3,
      "text": "The park’s mixed‑use complex was originally slated to feature a Target store, which closed when Target Canada filed for bankruptcy in 2015.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Oakridge_Park"
    },
    {
      "id": 4,
      "text": "Hudson’s Bay was the first anchor tenant signed for the mall before the Target plan.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Oakridge_Park"
    },
    {
      "id": 5,
      "text": "A $6.5 billion redevelopment will add a 1‑km circular park path, a community centre, and a fully upgraded SkyTrain station by summer 2026.",
      "sourceSentenceIds": [
        23,
        24,
        25,
        26,
        27
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Oakridge_Park"
    },
    {
      "id": 6,
      "text": "The redevelopment also introduces a new underground entrance linking the SkyTrain concourse directly to the mall, plus two street‑level escalators and a weather‑protected roof.",
