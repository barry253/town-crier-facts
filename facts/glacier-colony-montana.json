  "facts": [
    {
      "id": 1,
      "text": "Glacier Colony was founded in 1951 as a Lehrerleut Hutterite settlement near Cut Bank, Montana.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/glacier_colony_montana",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The colony began as a split from Elm Spring Hutterite Colony in Alberta, reflecting post‑war migration patterns.",
      "sourceSentenceIds": [
        1,
        29
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/glacier_colony_montana",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Glacier Colony produced two daughter colonies: Cascade Hutterite Colony near Fort Shaw and Zenith Hutterite Colony close to Cut Bank.",
      "sourceSentenceIds": [
        27
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/glacier_colony_montana",
      "category": "other",
      "quality": "poor",
      "qualityReason": "other"
    },
    {
      "id": 4,
      "text": "Property laws posed logistical hurdles for the colony, as Canadian communal ownership clashed with U.S. regulations.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/glacier_colony_montana",
      "category": "other",
      "quality": "poor",
      "qualityReason": "other"
    },
    {
      "id": 5,
      "text": "Despite early obstacles, Glacier Colony helped expand Lehrerleut presence in Montana, with seven settlements founded between 1948 and 1951.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/glacier_colony_montana",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The colony’s communal farming operations began on purchased land in northern Montana, emphasizing shared labor among members.",
