  "facts": [
    {
      "id": 1,
      "text": "Stephenville grew from a hamlet of a few hundred people with no paved streets in 1941 to a modern town of over 5,000 by the mid‑1950s.",
      "sourceSentenceIds": [
        27
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Stephenville%2C_Newfoundland_and_Labrador"
    },
    {
      "id": 2,
      "text": "The town’s rapid expansion began when the United States built Ernest Harmon Air Force Base in 1941, bringing thousands of American personnel and contractors.",
      "sourceSentenceIds": [
        5,
        4
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/Stephenville_Newfoundland_and_Labrador"
    },
    {
      "id": 3,
      "text": "After the base closed in 1966, its buildings were repurposed for housing, recreation and entertainment, keeping the former military infrastructure alive.",
      "sourceSentenceIds": [
        30
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Stephenville%2C_Newfoundland_and_Labrador"
    },
    {
      "id": 4,
      "text": "Stephenville hosts the Stephenville Theatre Festival, founded by local actor Maxim Mazumdar, reflecting the town’s strong theatre tradition.",
      "sourceSentenceIds": [
        7,
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Stephenville%2C_Newfoundland_and_Labrador"
    },
    {
      "id": 5,
      "text": "The Newfoundland and Labrador Public Library system is headquartered in Stephenville, making it a regional cultural hub.",
      "sourceSentenceIds": [
        14
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Stephenville%2C_Newfoundland_and_Labrador"
    },
    {
      "id": 6,
      "text": "The town’s name honors the historic Acadian village that existed between 1848 and 1870, reflecting its early French‑Canadian roots.",
