      "id": 1,
      "text": "East Harlem, also called Spanish Harlem or El Barrio, stretches north of 96th St to east of Fifth Ave, bounded by Harlem and East Rivers.",
      "sourceSentenceIds": [
        22
      ],
      "sourceLabels": [
        "Web source 1"
      ],
