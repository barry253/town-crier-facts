    },
    {
      "id": 2,
      "text": "In the 1870s, Italian laborers were brought to build First Avenue trolley tracks, adding to the neighborhood’s diverse mix.",
      "sourceSentenceIds": [
        8,
        17
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/East_Harlem"
    },
    {
      "id": 3,
      "text": "The area was rural until the 1860s, when residential settlements appeared northeast of Third Ave and East 110th St.",
      "sourceSentenceIds": [
        23
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://urbanareas.net/info/resources/neighborhoods-manhattan/east-harlem-manhattanhistory/"
    },
    {
      "id": 4,
      "text": "East Harlem hosts Metropolis, one of the few major TV studios north of midtown, where shows like BET’s 106 & Park were filmed.",
      "sourceSentenceIds": [
        28
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/East_Harlem"
    },
    {
      "id": 5,
      "text": "The neighborhood has 24 NYCHA developments, reflecting its long history of public housing.",
