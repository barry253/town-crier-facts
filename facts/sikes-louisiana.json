  "facts": [
    {
      "id": 1,
      "text": "Sikes was named for Sikes Bowman (1856–1925), a Baptist leader, musician, and the village’s first postmaster.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Sikes%2C_Louisiana"
    },
    {
      "id": 2,
      "text": "The village’s earliest settlers arrived in the 1830s when Wade Hammond, a Primitive Baptist preacher, established his home nearby.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/sikes_louisiana"
    },
    {
      "id": 3,
      "text": "In 1901 the Kyiche Cooperative Association opened Sikes’ first store on Bandall Underwood’s property.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/sikes_louisiana"
    },
    {
      "id": 4,
      "text": "The Tremont and Gulf Railroad arrived around 1904, prompting the store and post office to relocate closer to the tracks.",
