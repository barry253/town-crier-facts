  "facts": [
    {
      "id": 1,
      "text": "Hamilton City began in 1905 when James Hamilton and the Alta California Sugar Beet Company built a large sugar beet processing plant.",
      "sourceSentenceIds": [
        15
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Hamilton_City%2C_California",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The original plant became the Holly Sugar Plant, later owned by Holly Sugar Corporation, then Spreckels, Imperial, and finally Nutrien, which renovated it in 2021.",
      "sourceSentenceIds": [
        16,
        17,
        18
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Hamilton_City%2C_California",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The town’s first post office opened in 1906, marking its official recognition.",
      "sourceSentenceIds": [
        19
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Hamilton_City%2C_California",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Hamilton City sits on the Sacramento River at mile 199, just 151 feet above sea level.",
      "sourceSentenceIds": [
        11,
        9
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Hamilton_City%2C_California",
      "category": "other",
      "quality": "poor",
      "qualityReason": "location_description"
    },
    {
      "id": 5,
      "text": "The community lies 9.5 miles east of Orland and 10 miles west of Chico, placing it squarely in Glenn County’s heart.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Hamilton_City%2C_California",
      "category": "other",
      "quality": "poor",
      "qualityReason": "location_description"
    },
    {
      "id": 6,
      "text": "The large silos of the former Holly Sugar Plant are still visible from almost anywhere in town, a reminder of its industrial past.",
