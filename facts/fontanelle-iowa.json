  "facts": [
    {
      "id": 1,
      "text": "Fontanelle was founded in 1851 as Summerset before being renamed after Chief Logan Fontenelle, a key Omaha treaty negotiator.",
      "sourceSentenceIds": [
        1,
        4
      ],
      "sourceLabels": [
        "Web source 1",
        "Wikipedia"
      ],
      "source": "https://visitadaircounty.org/fontanelle-2/",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Fontanelle served as Adair County's original county seat before the capital moved to Greenfield.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://visitadaircounty.org/fontanelle-2/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The town’s public square hosts a sesquicentennial mural by Ray “Bubba” Sorensen that celebrates its railroad heritage, alongside a marker for the first log cabin.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://visitadaircounty.org/fontanelle-2/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "A prominent water tower on 5th Street stands as a local landmark, and the town was first planned out in 1855.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://kids.kiddle.co/Fontanelle,_Iowa",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The city was officially incorporated on August 23, 1871, solidifying its status as a municipal entity.",
      "sourceSentenceIds": [
        15
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Fontanelle%2C_Iowa",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Early settler John Gibbs built a large log cabin in the city square in 1855, later operating a brief hotel from that structure.",
