  "facts": [
    {
      "id": 1,
      "text": "Astoria is named after John Jacob Astor, whose American Fur Company founded Fort Astoria there in the early 19th century.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Astoria%2C_Oregon",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Founded in 1811, Astoria is Oregon's oldest city and the first permanent American settlement west of the Rocky Mountains.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Astoria%2C_Oregon",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Lewis and Clark spent the winter of 1805‑06 at nearby Fort Clatsop, where ranger‑led programs now bring their journey to life.",
      "sourceSentenceIds": [
        4,
        17
      ],
      "sourceLabels": [
        "Web source 1",
        "Wikipedia"
      ],
      "source": "https://oregoncoastjourney.com/astoria-oregon-travel-guide/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The Columbia River Maritime Museum in Astoria showcases the region’s rich maritime history along the Pacific coast.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://traveloregon.com/places-to-go/cities/astoria/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The historic Fort Astoria has been recreated as part of Lewis and Clark National Historical Park, preserving its original layout.",
      "sourceSentenceIds": [
        17
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Astoria%2C_Oregon",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Since 1998, Astoria has hosted the Fisher Poets Gathering, where fishermen and poets celebrate the coastal fishing heritage.",
      "sourceSentenceIds": [
        14
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Astoria%2C_Oregon",
