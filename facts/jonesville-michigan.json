  "facts": [
    {
      "id": 1,
      "text": "Jonesville was founded in 1828 when brothers Benaiah and Edmund Jones settled along the St. Joseph River.",
      "sourceSentenceIds": [
        20,
        21,
        29
      ],
      "sourceLabels": [
        "Web source 1",
        "Web source 2"
      ],
      "source": "https://jonesvillemi.gov/about-jonesville/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town grew around a railroad built in the late 1800s, and Main Street (US‑12/Chicago Street) developed beside the tracks.",
      "sourceSentenceIds": [
        30,
        7
      ],
      "sourceLabels": [
        "Web source 2",
        "Web source 2"
      ],
      "source": "https://michigan4you.com/history-of-jonesville-michigan/",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Jonesville once housed a bustling cigar industry, with Poor’s Cigar Factory among several local manufacturers.",
      "sourceSentenceIds": [
        8,
        12,
        14
      ],
      "sourceLabels": [
        "Web source 2",
        "Web source 2",
        "Web source 2"
      ],
      "source": "https://michigan4you.com/history-of-jonesville-michigan/",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "A 19th‑century carriage factory, the Deal and Son Carriage Factory, still stands and has been repurposed into apartments.",
      "sourceSentenceIds": [
        5,
        6,
        16
      ],
      "sourceLabels": [
        "Wikipedia",
        "Wikipedia",
        "Web source 2"
      ],
      "source": "https://en.wikipedia.org/wiki/Jonesville%2C_Michigan",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The town’s historic downtown includes the Delevan (Munro) House and the Kiddie Brush and Toy Company, both Michigan State Historic Sites.",
