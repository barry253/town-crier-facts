      "quality": "good"
    },
    {
      "id": 3,
      "text": "The park faces the Pacific at North America’s active margin where the Juan de Fuca plate slowly sinks beneath the continent.",
      "sourceSentenceIds": [
        14
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://parks.wa.gov/about/news-center/field-guide-blog/ocean-city-state-park-history",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Sudden movements of the Juan de Fuca Plate can trigger earthquakes that reshape the land and spawn tsunamis.",
      "sourceSentenceIds": [
        15
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://parks.wa.gov/about/news-center/field-guide-blog/ocean-city-state-park-history",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "A 1700 9.0 quake dropped the coast, launching a 12‑foot tsunami that crossed the Pacific in ten hours and reached Japan.",
