    },
    {
      "id": 2,
      "text": "John Cuppy platted New Cumberland in 1839, originally naming the town Vernon or Cuppytown before renaming it after Cumberland, Maryland.",
      "sourceSentenceIds": [
        4,
        5,
        11
      ],
      "sourceLabels": [
