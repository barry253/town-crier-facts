      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Almanzo Wilder, who later married author Laura Ingalls Wilder, was born on a family farm in Burke on February 13, 1857.",
      "sourceSentenceIds": [
        13,
        15
      ],
      "sourceLabels": [
        "Web source 2",
