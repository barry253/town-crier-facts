  "facts": [
    {
      "id": 1,
      "text": "Wola’s name comes from its original status as a village freed from tribute payments to the prince.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.przewodnik.wola.waw.pl/page/1809,english-version---the-history-of-wola.html"
    },
    {
      "id": 2,
      "text": "The first written record of Wola appears in a 1367 inventory of Prince Trojden’s holdings.",
      "sourceSentenceIds": [
        24
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.przewodnik.wola.waw.pl/page/1809,english-version---the-history-of-wola.html"
    },
    {
      "id": 3,
      "text": "From 1576 to 1764, every royal election in Poland was held in Wola, making it a national political hub.",
      "sourceSentenceIds": [
        27,
        28,
        29,
        30
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.przewodnik.wola.waw.pl/page/1809,english-version---the-history-of-wola.html"
    },
    {
      "id": 4,
      "text": "On April 8, 1916, Prussian authorities incorporated Wola into the expanding city of Warsaw.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.przewodnik.wola.waw.pl/page/1809,english-version---the-history-of-wola.html"
    },
    {
      "id": 5,
      "text": "The 1845 opening of the Warsaw‑Vienna Railway cut customs borders and spurred Wola’s industrial growth.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.przewodnik.wola.waw.pl/page/1809,english-version---the-history-of-wola.html"
    },
    {
      "id": 6,
      "text": "Wola’s past is still visible in its old workers’ tenements and factories that line the streets.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 2"
      ],
