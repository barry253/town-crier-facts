  "facts": [
    {
      "id": 1,
      "text": "Oakham was first settled by British colonists in 1749 as part of Rutland and incorporated in 1762.",
      "sourceSentenceIds": [
        16
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Oakham%2C_Massachusetts",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The village of Coldbrook Springs, once a bustling iron‑spring town, now exists only as a scenic byway marked by a lone stone marker.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.oakham-ma.gov/203/History-of-Oakham",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The Central Mass Railroad opened in 1887, turning Oakham into a quick link for people and goods across the East.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.oakham-ma.gov/203/History-of-Oakham",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Oakham’s public library, founded in 1892, sits in a fieldstone building called Fobes Memorial Library, funded by the Fobes family.",
      "sourceSentenceIds": [
        13
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Oakham%2C_Massachusetts",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Oakham’s name changed from Oakhampton to Oakham for an unknown reason, a quirky detail of its early history.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Oakham%2C_Massachusetts",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Oakham lies within the Ware River Watershed, now part of Massachusetts state forest after all structures were cleared for the Quabbin Reservoir Aqueduct system.",
      "sourceSentenceIds": [
