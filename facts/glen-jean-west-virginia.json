  "facts": [
    {
      "id": 1,
      "text": "Glen Jean was named for Jean McKell, the wife of landowner Thomas G., when the town was founded in the early 1870s.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Glen_Jean%2C_West_Virginia"
    },
    {
      "id": 2,
      "text": "Glen Jean once served as a railroad junction and coal mining center, featuring its own opera house, hotels, and company store.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Glen_Jean%2C_West_Virginia"
    },
    {
      "id": 3,
      "text": "The Bank of Glen Jean is the chief remaining structure from the town's boom era and is listed on the National Register of Historic Places.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Glen_Jean%2C_West_Virginia"
    },
    {
      "id": 4,
      "text": "Glen Jean serves as the headquarters for the New River Gorge National Park and Preserve.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Glen_Jean%2C_West_Virginia"
    },
    {
      "id": 5,
      "text": "The Summit Bechtel Reserve, the national high adventure base for the Boy Scouts of America, is located in Glen Jean.",
      "sourceSentenceIds": [
        11
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Glen_Jean%2C_West_Virginia"
    },
    {
