  "facts": [
    {
      "id": 1,
      "text": "Austwell’s name blends Austin and McDowell, the founders’ surnames, reflecting the town’s origins in 1911.",
      "sourceSentenceIds": [
        5,
        23,
        24
      ],
      "sourceLabels": [
        "Web source 2",
        "Wikipedia"
      ],
      "source": "https://refugiocountytx.org/relocating/austwell",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The city sits on Farm Road 774 beside Hynes Bay, an extension of San Antonio Bay.",
      "sourceSentenceIds": [
        7,
        26
      ],
      "sourceLabels": [
        "Web source 1",
        "Wikipedia"
      ],
      "source": "https://www.tshaonline.org/handbook/entries/austwell-tx",
