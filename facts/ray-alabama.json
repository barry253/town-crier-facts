  "facts": [
    {
      "id": 1,
      "text": "Ray, Alabama sits in Coosa County, a region carved from Creek lands in 1832 and named after the Coosa River.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/ray_alabama",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The first official map recognition of Ray appeared in the 1970s, marking it as a small, dispersed settlement amid forests and farmland.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/ray_alabama",
      "category": "other",
      "quality": "poor",
      "qualityReason": "vague"
    },
    {
      "id": 3,
      "text": "Early settlers in Ray, by the 1850s, cultivated cotton and corn on fertile upland soils, while water‑powered mills processed grain and gin cotton.",
      "sourceSentenceIds": [
        18,
        19
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/ray_alabama",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The boll weevil infestation of the 1910s devastated Ray’s cotton crops, prompting farmers to diversify into livestock, corn, wheat, oats, and timber.",
      "sourceSentenceIds": [
        7,
        22
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/ray_alabama",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "In recent decades, Ray’s proximity to Lake Martin—about twenty miles south—has spurred conservation efforts and small‑scale tourism for fishing and recreation.",
      "sourceSentenceIds": [
        26
      ],
      "sourceLabels": [
        "Web source 1"
      ],
