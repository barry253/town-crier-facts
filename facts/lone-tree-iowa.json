  "facts": [
    {
      "id": 1,
      "text": "Lone Tree earned its name from a massive elm that once stood on a hill south of town, where buffalo grazed under its branches.",
      "sourceSentenceIds": [
        15,
        16,
        17
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Lone_Tree%2C_Iowa",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "That elm survived prairie fires because the grass around it was scarce, a rare natural protection in the region.",
      "sourceSentenceIds": [
        18
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Lone_Tree%2C_Iowa",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "In the 1960s Dutch Elm disease killed the tree, but locals salvaged its wood to craft a sign marking its former spot.",
      "sourceSentenceIds": [
        19,
        20
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Lone_Tree%2C_Iowa",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The Lone Tree Historical Society, founded in 1976, preserves the town’s past through collections, research, and public education.",
      "sourceSentenceIds": [
        6,
        12
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://museumsdatabase.com/museums/view/11051",
      "category": "people",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "A historic building donated to the society was renovated to house its museum, offering visitors a glimpse into local heritage.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://museumsdatabase.com/museums/view/11051",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The society’s research center holds genealogical records, maps, and local history books, making it a key resource for anyone curious about Lone Tree.",
      "sourceSentenceIds": [
