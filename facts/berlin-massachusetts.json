      "quality": "poor",
      "qualityReason": "location_description"
    },
    {
      "id": 3,
      "text": "After the Civil War, a large shoe factory powered Berlin’s economy, while lumbering and shoe manufacturing offered residents non‑agricultural jobs.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Berlin%2C_Massachusetts",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "From 1891 to 1928, Berlin’s public library operated out of the Town Hall, serving the community’s reading needs.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
