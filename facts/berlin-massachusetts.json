      "id": 1,
      "text": "Berlin earned its name in 1784 and became an incorporated town in 1812, marking its formal establishment in Massachusetts.",
      "sourceSentenceIds": [
        4,
        8
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
