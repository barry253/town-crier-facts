      "quality": "poor",
      "qualityReason": "vague"
    },
    {
      "id": 2,
      "text": "The neighborhood’s building boom began in the 1920s, and by 1930 it had its own newspaper, The Broadmoor News.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 1"
      ],
