    {
      "id": 1,
      "text": "Naukati Bay was originally called Naukatee Bay when the U.S. named it in 1904.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Naukati_Bay%2C_Alaska",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Alaska Natives once camped along the shores of Naukati Bay, calling it Naukatee.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://discoverpowisland.com/communities/naukati-bay/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The community began as a logging camp before evolving into an independent settlement over the past three decades.",
      "sourceSentenceIds": [
        6,
        17
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Naukati_Bay%2C_Alaska",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Naukati Bay sits on the western coast of Prince of Wales Island, forming the largest indentation of Tuxekan Passage.",
      "sourceSentenceIds": [
        13
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Naukati_Bay%2C_Alaska",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The bay’s entrance, about two miles north of Staney Island, is narrow and rock‑bound, with kelp and reefs that can almost close it at low tide.",
      "sourceSentenceIds": [
        14,
        21
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Naukati_Bay%2C_Alaska",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The area enjoys a cool maritime climate, with summer temperatures ranging from 46 to 70°F and winter highs between 32 and 42°F.",
