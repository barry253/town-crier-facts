  "facts": [
    {
      "id": 1,
      "text": "Kaibab Estates West sits on the Kaibab Plateau, a high‑desert plateau that once supported ponderosa pine forests and grazing by early settlers.",
      "sourceSentenceIds": [
        20
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/kaibab_estates_west_arizona",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The community’s name reflects its location west of the Kaibab Plateau, a landmark that was protected by President Theodore Roosevelt’s 1906 Grand Canyon Game Preserve.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/kaibab_estates_west_arizona",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Indigenous Kaibab Band of Paiute, Havasupai, and Hualapai peoples have inhabited the land for millennia, using it for sustenance and ceremonies.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/kaibab_estates_west_arizona",
      "category": "people",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The 19th‑century Homestead Act allowed settlers to claim 160‑acre parcels, leading to scattered ranching and logging that began to degrade grasslands by the 1910s.",
      "sourceSentenceIds": [
        26,
        27
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/kaibab_estates_west_arizona",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Since the 2000s, affordable land sales have drawn retirees and off‑grid enthusiasts, making the community largely owner‑occupied mobile homes.",
      "sourceSentenceIds": [
        13,
        30
      ],
      "sourceLabels": [
        "Web source 1"
      ],
