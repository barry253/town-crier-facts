  "facts": [
    {
      "id": 1,
      "text": "Founded in 1770 and incorporated in 1835, Saint‑Eustache has roots that stretch back to the early days of New France.",
      "sourceSentenceIds": [
        1,
        3
      ],
      "sourceLabels": [
        "Web source 1",
        "Wikipedia"
      ],
      "source": "https://www.comeexplorecanada.com/quebec/saint-eustache"
    },
    {
      "id": 2,
      "text": "The Battle of Saint‑Eustache on December 14, 1837 saw rebels defeated and the town burned, a pivotal moment in the Lower Canada Rebellion.",
      "sourceSentenceIds": [
        12,
        13,
        22,
        23
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Saint-Eustache%2C_Quebec"
    },
    {
      "id": 3,
      "text": "Saint‑Eustache’s historic church, built between 1780 and 1783, was rebuilt after the 1837 fire and still bears bullet‑hole marks on its front facade.",
      "sourceSentenceIds": [
        5,
        14,
        24
      ],
      "sourceLabels": [
        "Web source 1",
        "Wikipedia"
      ],
      "source": "https://www.comeexplorecanada.com/quebec/saint-eustache"
    },
    {
      "id": 4,
      "text": "From 1965 to 2019, the Autodrome Saint‑Eustache hosted stock‑car and drag races, drawing motorsport fans to the suburb.",
      "sourceSentenceIds": [
        15,
        26
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Saint-Eustache%2C_Quebec"
    },
    {
      "id": 5,
      "text": "In 1979, General Motors opened a transit‑bus plant in Saint‑Eustache, producing GM, MCI, and Nova Bus vehicles since 1993.",
      "sourceSentenceIds": [
        25
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.comeexplorecanada.com/quebec/saint-eustache"
    },
    {
      "id": 6,
      "text": "Located 35 km northwest of Montreal on the north shore of the Rivière des Mille Îles, Saint‑Eustache is a charming off‑island suburb of the city.",
      "sourceSentenceIds": [
