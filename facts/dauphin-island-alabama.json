  "facts": [
    {
      "id": 1,
      "text": "Dauphin Island got its name when French explorer D'Iberville renamed it after the future king Louis XV, the dauphin.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Dauphin_Island%2C_Alabama",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "When D'Iberville first landed, he called the island Île du Massacre because he found a pile of human skeletons.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Dauphin_Island%2C_Alabama",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The 1873 Dauphin Island Light, still standing, earned a spot on the National Register of Historic Places.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Dauphin_Island%2C_Alabama",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Fort Gaines, visible on the island’s coat of arms, features two cannons that point north and south, echoing its Civil War role.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Dauphin_Island%2C_Alabama",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The Audubon Bird Sanctuary covers 164 acres, making it a key stop for migratory birds heading north from South America.",
      "sourceSentenceIds": [
        21
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Dauphin_Island%2C_Alabama",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Archaeologists uncovered shell middens on the island that date back about 1,500 years, evidence of Mississippian seasonal occupation.",
      "sourceSentenceIds": [
        23
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Dauphin_Island%2C_Alabama",
      "category": "history",
      "quality": "good"
