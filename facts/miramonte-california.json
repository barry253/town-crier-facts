  "facts": [
    {
      "id": 1,
      "text": "Miramonte means \"Mountain View\" in Spanish and is an unincorporated community in Fresno County.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Miramonte%2C_California",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town began as Rancho Miramontes in 1841, granted to Juan José Candelario Miramontes by the Mexican government.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://unitedstatesghosttowns.com/miramonte-california-ghost-town/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "A post office opened in 1909, closed in 1912, then reopened in 1923, serving as a social hub for early ranch families.",
      "sourceSentenceIds": [
        12,
        4,
        29
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Miramonte%2C_California",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The historic Villa Mira Monte, located at 17860 Monterey Road, is still open on Saturdays for history enthusiasts.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://unitedstatesghosttowns.com/miramonte-california-ghost-town/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Unlike typical ghost towns, Miramonte never mined; its decline stemmed from shifting from grain to water‑intensive crops during the 1930s.",
      "sourceSentenceIds": [
        23
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://unitedstatesghosttowns.com/miramonte-california-ghost-town/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Today, nature has reclaimed most of the settlement; no standing structures remain, making the site a quiet reminder of California’s agricultural past.",
      "sourceSentenceIds": [
        24
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://unitedstatesghosttowns.com/miramonte-california-ghost-town/",
      "category": "nature",
      "quality": "good"
    }
