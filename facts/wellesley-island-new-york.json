  "facts": [
    {
      "id": 1,
      "text": "Wellesley Island got its name in 1815 when British Captain William Fitzwilliam Owen renamed Wells Island to honor Arthur Wellesley, the Duke of Wellington.",
      "sourceSentenceIds": [
        1,
        3,
        6
      ],
      "sourceLabels": [
        "Web source 2",
        "Wikipedia"
      ],
      "source": "https://grokipedia.com/page/Wellesley_Island",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "In 1875, John Ferdinand Dayan founded Thousand Island Park on the island’s northern end as a Methodist campground, later listed on the National Register in 1982.",
      "sourceSentenceIds": [
        5,
        7,
        12
      ],
      "sourceLabels": [
        "Web source 2",
        "Wikipedia"
      ],
      "source": "https://grokipedia.com/page/Wellesley_Island",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The island’s shoreline nearly doubles when you include the Lake of the Isles that it surrounds on three sides.",
      "sourceSentenceIds": [
        20
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Wellesley_Island",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Five segments of the Thousand Islands International Bridge connect Wellesley Island to Canada, crossing the International Rift.",
      "sourceSentenceIds": [
        22
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Wellesley_Island",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The 4.5‑mile Black River Trail, a former railroad bed, winds through Wellesley Island for hikers and cyclists.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://parks.ny.gov/visit/state-parks/wellesley-island-state-park",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Long before settlers, the Haudenosaunee and Anishinaabe peoples used Wellesley Island’s waterways for hunting and trade.",
      "sourceSentenceIds": [
