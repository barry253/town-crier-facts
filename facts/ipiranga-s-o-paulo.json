      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The Botanical Garden of São Paulo, founded in 1928 by botanist Frederico Carlos Hoehne, occupies a historic Ipiranga site.",
      "sourceSentenceIds": [
