  "facts": [
    {
      "id": 1,
      "text": "Greenwood’s Veterans Memorial features a life‑size bald eagle, a soldier, and marble plaques honoring multiple conflicts.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 2"
      ],
