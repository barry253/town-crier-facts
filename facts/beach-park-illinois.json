  "facts": [
    {
      "id": 1,
      "text": "Beach Park’s origins trace back to 1908 when railroad planners first discussed a line from Chicago to Milwaukee.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://villageofbeachpark.com/discover-bp/village-profile/35-history",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The original train stop was called Beach Depot, a name that appeared on early Chicago‑Milwaukee Electric maps.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://villageofbeachpark.com/discover-bp/village-profile/35-history",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Some streets in the village honor silent‑film stars, a tribute that still shows up on the map today.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://villageofbeachpark.com/discover-bp/village-profile/35-history",
      "category": "people",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Before the village existed, the area was part of Camp Logan, a rifle range built by the Illinois National Guard in 1892.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Beach_Park%2C_Illinois",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The Lake Michigan dunes that surround Beach Park were once part of the Three Fires of the Algonquin Nation in the 1700s.",
      "sourceSentenceIds": [
        5,
        6
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://dnr.illinois.gov/parks/about/park.adelinejaygeo-karisillinoisbeach.html",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The northern unit of Illinois Beach State Park, stretching to the Wisconsin border, was added to the state’s park system between 1971 and 1982.",
      "sourceSentenceIds": [
        21,
        15
      ],
      "sourceLabels": [
        "Wikipedia",
