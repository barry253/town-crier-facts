  "facts": [
    {
      "id": 1,
      "text": "Harrisburg was founded in 1836 by Joseph Chenoweth, a landowner descended from early settlers Elijah and Thomas Chenoweth.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/harrisburg_ohio",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Before becoming Harrisburg, the area was known as Darby Cross Roads, a key intersection for early 19th‑century travelers.",
      "sourceSentenceIds": [
        13
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Harrisburg%2C_Ohio",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "A post office called Big Darby opened March 13, 1834, was renamed Harrisburgh in 1835, briefly closed in 1836, and reopened the same year.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/harrisburg_ohio",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The village’s original land came from a Virginia Military Grant owned by the Chenoweth family.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://harrisburgohio.gov/history-of-harrisburg/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Harrisburg once had its own band of ten musicians under the direction of a local conductor.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://harrisburgohio.gov/history-of-harrisburg/",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The spelling was officially changed to 'Harrisburg' in 1893, dropping the extra 'h'.",
      "sourceSentenceIds": [
