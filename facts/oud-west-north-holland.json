  "facts": [
    {
      "id": 1,
      "text": "Oud-West derives its name from Dutch \"Oud,\" added to distinguish it from Nieuw-Loosdrecht, meaning \"old ferry over the drainage canal.\".",
      "sourceSentenceIds": [
        8,
        9
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Oud-Loosdrecht"
    },
    {
      "id": 2,
      "text": "The village first appeared in records in 1384 as \"van der Loesdrecht,\" hinting at its medieval roots.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Oud-Loosdrecht"
    },
    {
      "id": 3,
      "text": "Oud-West hosts a quirky sculpture called Boomzagertje, a man humorously cutting into a real tree branch.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://travel.usnews.com/Amsterdam_Netherlands/Things_To_Do/OudWest_66205/"
    },
    {
      "id": 4,
      "text": "The neighborhood features De Hallen, a food hall that also doubles as a cinema, offering diverse street food and dining.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://travel.usnews.com/Amsterdam_Netherlands/Things_To_Do/OudWest_66205/"
    },
    {
      "id": 5,
      "text": "Oud-West is served by trams 5, 13, 17, and 19, connecting it directly to Amsterdam’s city center.",
      "sourceSentenceIds": [
        19
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://travel.usnews.com/Amsterdam_Netherlands/Things_To_Do/OudWest_66205/"
    },
    {
      "id": 6,
      "text": "The area contains many Rijksmonumenten, Dutch national heritage sites that preserve the village’s architectural history.",
      "sourceSentenceIds": [
        10
      ],
