    {
      "id": 1,
      "text": "Dixon takes its name from founder John Dixon, who operated a rope ferry across the Rock River in the late 1820s.",
      "sourceSentenceIds": [
        4,
        9,
        30
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Dixon%2C_Illinois",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Former U.S. President Ronald Reagan spent his childhood in Dixon, where his boyhood home on South Hennepin Avenue now serves as a museum.",
      "sourceSentenceIds": [
        20,
        25,
        3
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Dixon%2C_Illinois",
      "category": "people",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The 1873 Dixon Bridge Disaster, the worst road bridge collapse in American history, claimed 28 lives and shocked the nation.",
      "sourceSentenceIds": [
        11,
        29
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Dixon%2C_Illinois",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The Lincoln Monument State Memorial in Dixon marks the spot where Abraham Lincoln joined the Illinois militia at Fort Dixon during the 1832 Black Hawk War.",
      "sourceSentenceIds": [
        26,
        27
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Dixon%2C_Illinois",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The Northwest Territory Historic Center, housed in Ronald Reagan's former South Central School, offers research, exhibits, and a surround‑sound theater in Dixon.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Dixon%2C_Illinois",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Dixon Stage Left, a local performing‑arts theater, and the Rosbrook Studio arts co‑op showcase regional talent and creative collaboration.",
