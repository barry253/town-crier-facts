  "facts": [
    {
      "id": 1,
      "text": "Northeast Harbor began as Sand Point, first settled in 1761 by Abraham Somes and James Richardson at Somes Sound.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/Northeast_Harbor,_Maine",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "In 1775, the Manchester family from Machias became the first permanent family in Northeast Harbor.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/Northeast_Harbor,_Maine",
      "category": "people",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Northeast Harbor’s climate is humid continental with maritime influence, yielding mild summers, cold winters, and steady moisture year‑round.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/Northeast_Harbor,_Maine",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Just outside the village, Asticou Azalea Garden blooms in late spring, while Thuya Garden climbs a steep path from the harbor.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/Northeast_Harbor,_Maine",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Northeast Harbor sits beside Acadia National Park, offering easy access to trails, carriage roads, and the nearby Bear Island Lighthouse.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/Northeast_Harbor,_Maine",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The Asticou Inn, now the Asticou Hotel, was built by Augustus Chase, a grandson of Glaswegian John C., in the 19th century.",
      "sourceSentenceIds": [
