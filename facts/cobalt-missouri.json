  "facts": [
    {
      "id": 1,
      "text": "Cobalt was incorporated in 1952 and its name comes from the region's sporadic cobalt mining history.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/cobalt_missouri",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The village sits just one mile west of Fredericktown, on the historic Mine La Motte-Fredericktown mining district of the Ozark Plateau.",
      "sourceSentenceIds": [
        26,
        27
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/cobalt_missouri",
      "category": "other",
      "quality": "poor",
      "qualityReason": "location_description"
    },
    {
      "id": 3,
      "text": "In the late 1950s, the Madison Mine employed about 250 workers, paying wages higher than local factory jobs, boosting the nearby downtown economy.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/cobalt_missouri",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Lead mining has shaped the area since the early 18th century, drawing pioneers to surface galena deposits and creating a mix of farming and extractive communities.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/cobalt_missouri",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Cobalt lies within Missouri's Lead Belt, a region known for rolling hills, forests, and streams typical of the Ozark Plateau.",
      "sourceSentenceIds": [
        27
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/cobalt_missouri",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The village's economy today includes health care, accommodation, manufacturing, and mining, reflecting its extractive heritage.",
      "sourceSentenceIds": [
        4
      ],
