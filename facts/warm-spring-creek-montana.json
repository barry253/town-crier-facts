  "facts": [
    {
      "id": 1,
      "text": "Warm Spring Creek begins at the Gigantic Warm Spring, the world's largest natural warm spring, discharging 50,000 gallons per minute at 68°F.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/warm_spring_creek_montana",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The creek’s steady flow makes it resilient to seasonal droughts, supporting local wildlife and anglers year‑round.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/warm_spring_creek_montana",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Native American tribes, including the Blackfeet, Salish, and Pend d'Oreille, used the Warm Spring Creek area for hunting and seasonal camps before European settlement.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/warm_spring_creek_montana",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "In the 1870s, ranchers like Pierre Laverdure settled near Camp Lewis, marking the shift from trapping to permanent cattle ranching in the basin.",
      "sourceSentenceIds": [
        23
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/warm_spring_creek_montana",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The Kendall gold mine built a power plant along Warm Spring Creek in the early 1900s, using the spring’s water to generate electricity for mining operations.",
