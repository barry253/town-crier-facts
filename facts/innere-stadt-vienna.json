  "facts": [
    {
      "id": 1,
      "text": "Innere Stadt is Vienna's historic first district, a tapestry of history woven through centuries.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://allaboutvienna.com/innere-stadt-vienna-old-town-travel-guide/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The district borders follow the former city walls, now circled by the Ringstraße.",
      "sourceSentenceIds": [
        30
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Innere_Stadt",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Stephansdom, the cathedral, began construction in the 12th century and has been rebuilt several times.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://allaboutvienna.com/innere-stadt-vienna-old-town-travel-guide/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The Kunsthistorisches Museum, opened in 1891 by Emperor Franz Joseph I, houses art from ancient Egypt to the Renaissance.",
      "sourceSentenceIds": [
        14,
        15
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://allaboutvienna.com/innere-stadt-vienna-old-town-travel-guide/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The Spanish Riding School, established in 1572, is the oldest riding school in the world.",
      "sourceSentenceIds": [
        13
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://allaboutvienna.com/innere-stadt-vienna-old-town-travel-guide/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The Hofburg Imperial Palace complex includes the Imperial Apartments and the Spanish Riding School, reflecting Gothic to Baroque styles.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://allaboutvienna.com/innere-stadt-vienna-old-town-travel-guide/",
      "category": "landmark",
      "quality": "good"
