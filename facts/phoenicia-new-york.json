  "facts": [
    {
      "id": 1,
      "text": "Phoenicia began as a 19th‑century factory town, founded in 1863 by the Chichester family to make chairs and cradles before shifting to fine office furniture.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/Phoenicia,_New_York"
    },
    {
      "id": 2,
      "text": "The historic 1899 Phoenicia Railroad Station, now part of the Empire State Railway Museum, sits at the confluence of Esopus and Stony Clove Creeks.",
      "sourceSentenceIds": [
        4,
        10
      ],
      "sourceLabels": [
        "Web source 1",
        "Wikipedia"
      ],
      "source": "https://grokipedia.com/page/Phoenicia,_New_York"
    },
    {
      "id": 3,
      "text": "Phoenicia’s geography places it at the foot of Mount Tremper, Romer, and Sheridan Mountains, with the Esopus and Stony Clove Creeks meeting just below the town center.",
      "sourceSentenceIds": [
        14,
        25
      ],
      "sourceLabels": [
        "Web source 2",
        "Web source 1"
      ],
      "source": "https://upstatehouse.com/a-guide-to-phoenicia-ny-rugged-rural-charm/"
    },
    {
      "id": 4,
      "text": "The hamlet’s social life traditionally centers around its post office, bank, thrift shop, and the dog‑friendly Phoenicia Library, which hosts book readings and film screenings.",
