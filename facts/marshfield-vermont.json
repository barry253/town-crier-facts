    },
    {
      "id": 2,
      "text": "The Abenaki were the original inhabitants of the land that eventually became the town of Marshfield.",
      "sourceSentenceIds": [
        30
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://marshfieldvt.gov/index.asp?Type=B_BASIC&SEC=%7BBA0A26C1-7CDB-4BE2-9F6B-5C67180E9F8C%7D&Design=PrintView"
    },
    {
      "id": 3,
      "text": "The fertile valley of the Winooski River bisects Marshfield and played a key role in the town's development.",
      "sourceSentenceIds": [
        8,
        29
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://marshfieldvt.gov/index.asp?Type=B_BASIC&SEC=%7BBA0A26C1-7CDB-4BE2-9F6B-5C67180E9F8C%7D&Design=PrintView"
    },
    {
      "id": 4,
      "text": "The Montpelier and Wells River Railroad arrived in Marshfield in 1873, bringing a station and telegraph service to the village.",
      "sourceSentenceIds": [
        4,
        5
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://marshfieldvt.gov/index.asp?Type=B_BASIC&SEC=%7BBA0A26C1-7CDB-4BE2-9F6B-5C67180E9F8C%7D&Design=PrintView"
    },
    {
      "id": 5,
      "text": "Portions of the 1983 film adaptation of Robert Cormier's novel I Am the Cheese were filmed in Marshfield.",
      "sourceSentenceIds": [
        18,
        19
      ],
