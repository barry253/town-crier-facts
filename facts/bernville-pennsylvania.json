  "facts": [
    {
      "id": 1,
      "text": "Bernville was named in January 1820 after Stephanus Umbenhauer's birthplace in Bern, Switzerland.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Bernville%2C_Pennsylvania",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The area was first called Tulpehocken by Delaware Indians, meaning \"Land of the Turtles,\" before Palatine settlers arrived in the 1720s.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.visitpa.com/explore/regions/dutch-country-roads/bernville/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Thirty-three Palatine families from Schoharie, New York, settled at the confluence of Tulpehocken and Northkill Creeks in 1723.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Bernville%2C_Pennsylvania",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Bernville’s Main Street, laid out in 1819, still hosts nineteenth‑century buildings like the historic Eagle Hotel.",
      "sourceSentenceIds": [
        28
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Bernville%2C_Pennsylvania",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "In 1851, residents broke away from Penn Township over road maintenance and incorporated Bernville as a borough.",
      "sourceSentenceIds": [
        23
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Bernville%2C_Pennsylvania",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The Union Canal, completed in 1828, once let boats cross Northkill Creek via a dam, two locks, and a mule bridge near Bernville.",
      "sourceSentenceIds": [
        21,
        22
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Bernville%2C_Pennsylvania",
