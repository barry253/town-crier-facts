  "facts": [
    {
      "id": 1,
      "text": "Sea Island was first called Fifth Creek Island by Native Americans before remaining largely uninhabited until the 1920s.",
      "sourceSentenceIds": [
        11
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.georgiaencyclopedia.org/articles/geography-environment/sea-island/",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "In 1926 the Sea Island Company bought the island, sparking a transformation into a luxury resort destination.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.goldenisles.com/islands-towns/sea-island/history/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The Cloister Hotel opened in 1928, nicknamed the “Little Friendly Hotel,” and later became Sea Island’s flagship resort.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Sea_Island%2C_Georgia",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Sea Island hosts three championship golf courses, including the historic Plantation course completed in 1928.",
      "sourceSentenceIds": [
        3,
        4
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Sea_Island%2C_Georgia",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The island’s only Forbes Five‑Star restaurant, The Georgian Rooms, earned the award for fifteen straight years.",
      "sourceSentenceIds": [
        23,
        24
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Sea_Island%2C_Georgia",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Since 2016, the Anschutz family’s Broadmoor‑Sea Island Company has owned the island, keeping it a private gated community.",
      "sourceSentenceIds": [
        17
      ],
