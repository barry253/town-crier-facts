  "facts": [
    {
      "id": 1,
      "text": "Dighton was incorporated in 1712 after separating from Taunton, originally part of the Taunton South Purchase.",
      "sourceSentenceIds": [
        23,
        1
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Dighton%2C_Massachusetts",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Dighton sits on the western shore of the Taunton River, making it a historic crossroads for travel between Plymouth, Bristol, and Fall River.",
      "sourceSentenceIds": [
        17,
        18,
        21,
        22
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Dighton%2C_Massachusetts",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "In 1765, Dighton’s wharves staged the “Molasses Affair,” a protest mirroring the Boston Tea Party over British molasses taxes.",
      "sourceSentenceIds": [
        26,
        27,
        28
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Dighton%2C_Massachusetts",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The Berkley–Dighton Bridge, built in the 1890s, once carried a single lane of traffic between Center Street and Elm Street.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Dighton%2C_Massachusetts",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Dighton celebrated its 300th anniversary in 2012 with selectmen donning historic costumes and crossing the river to Ferry Landing.",
      "sourceSentenceIds": [
        11
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Dighton%2C_Massachusetts",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The town’s public library, part of the Dighton Public Library system, serves as a community hub.",
