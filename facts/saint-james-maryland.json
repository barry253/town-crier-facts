  "facts": [
    {
      "id": 1,
      "text": "Saint James School, founded in 1842, still houses a Gothic Revival chapel that dates back to the 19th century.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.trawellino.com/destinations/united-states/maryland_saint-james",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town began as a German Lutheran community in the 1730s, making it one of Washington County’s oldest European settlements.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.trawellino.com/destinations/united-states/maryland_saint-james",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Saint James sits beside the Appalachian Trail and the Chesapeake‑and‑Ohio Canal National Historical Park, offering hikers scenic routes.",
      "sourceSentenceIds": [
        4,
        7
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.trawellino.com/destinations/united-states/maryland_saint-james",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The local economy relies on agriculture and small‑scale tourism, with 19th‑century farmhouses dotting the landscape.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.trawellino.com/destinations/united-states/maryland_saint-james",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "A short drive from Saint James is Antietam National Battlefield, the site of the Civil War’s bloodiest single‑day battle.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.trawellino.com/destinations/united-states/maryland_saint-james",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Saint James was once called Lydia, a name that appears in early maps before the town adopted its current name.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/St._James%2C_Maryland",
