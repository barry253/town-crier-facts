  "facts": [
    {
      "id": 1,
      "text": "Lakeland South’s history dates back to mid‑19th‑century settlement, making it one of Washington’s older suburbs.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://beckdc.com/historical-places-in-lakeland-south/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The Lake Tapps Historic Marker commemorates early settlers and offers interpretive panels about the area’s past.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://beckdc.com/historical-places-in-lakeland-south/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The Military Road Historical Marker remembers the 19th‑century route that linked Fort Steilacoom to Fort Bellingham.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://beckdc.com/historical-places-in-lakeland-south/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Neely Mansion stands as a preserved historic building, showcasing the town’s architectural heritage.",
      "sourceSentenceIds": [
        16
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://beckdc.com/historical-places-in-lakeland-south/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Lakeland South’s development is part of the broader suburban growth around Tacoma, reflecting mid‑20th‑century expansion.",
      "sourceSentenceIds": [
        11
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.wisdomlib.org/cities/lakeland-south-33838",
      "category": "history",
      "quality": "good"
    },
    {
