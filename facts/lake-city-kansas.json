  "facts": [
    {
      "id": 1,
      "text": "Lake City was founded in 1873 by Reuben Lake, who named the town after himself.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://legendsofkansas.com/lake-city-kansas/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Reuben Lake started a sawmill by the Medicine Lodge River to supply lumber for early houses.",
      "sourceSentenceIds": [
        30
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://legendsofkansas.com/lake-city-kansas/",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The Atchison, Topeka & Santa Fe Railroad finally reached Lake City by 1907, after initially planning a line in the 1870s.",
      "sourceSentenceIds": [
        9,
        12
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://legendsofkansas.com/lake-city-kansas/",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Lake City sits on the Medicine Lodge River in a deep valley of the Gypson Hills, surrounded by dense forest on the south.",
      "sourceSentenceIds": [
        27
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://legendsofkansas.com/lake-city-kansas/",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The town is now considered a ghost town, with remnants of its historic structures still visible.",
      "sourceSentenceIds": [
        26
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://legendsofkansas.com/lake-city-kansas/",
      "category": "other",
      "quality": "poor",
      "qualityReason": "other"
    },
    {
