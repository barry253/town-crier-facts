  "facts": [
    {
      "id": 1,
      "text": "Appling was renamed for Colonel Daniel Appling, a War of 1812 hero, after his death in 1817.",
      "sourceSentenceIds": [
        5,
        8
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 2"
      ],
      "source": "https://en.wikipedia.org/wiki/Appling%2C_Georgia"
    },
    {
      "id": 2,
      "text": "The town’s courthouse, remodeled 1855‑56, now showcases Greek Revival and Italianate details and has been on the National Register since 1980.",
      "sourceSentenceIds": [
        14,
        18
      ],
      "sourceLabels": [
        "Wikipedia",
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Appling%2C_Georgia"
    },
    {
      "id": 3,
      "text": "When the Macon and Brunswick Railroad reached Appling in 1870, it spurred the founding of nearby towns like Surrency and Graham.",
      "sourceSentenceIds": [
        9,
        10
      ],
      "sourceLabels": [
        "Web source 2",
        "Web source 2"
      ],
      "source": "https://www.georgiaencyclopedia.org/articles/counties-cities-neighborhoods/appling-county/"
    },
    {
      "id": 4,
      "text": "Appling remains the county seat of Appling County, though all government functions now operate out of Evans.",
      "sourceSentenceIds": [
        29
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Appling%2C_Georgia"
    },
    {
      "id": 5,
      "text": "Located about eighteen miles northwest of Augusta, Appling’s rural setting offers a window into Georgia’s southeastern history.",
      "sourceSentenceIds": [
        19
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.visitcolumbiacountyga.com/plan-your-visit/towns-and-communities/appling/"
    },
    {
