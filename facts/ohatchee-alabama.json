  "facts": [
    {
      "id": 1,
      "text": "Ohatchee’s historic Fort Strother and Janney Furnace keep its Native American and Civil War past alive.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.atlasalabama.gov/municipalities/ohatchee/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Janney Furnace was built to produce pig iron for the Confederacy during the Civil War, though it never actually fired.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Ohatchee%2C_Alabama",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The town center sits just north of where Tallaseehatchee Creek meets Ohatchee Creek, a tributary of the Coosa River.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Ohatchee%2C_Alabama",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "General Andrew Jackson used the Ohatchee area as a staging ground for the Battle of Talladega during the Creek War.",
      "sourceSentenceIds": [
        5,
        14
      ],
      "sourceLabels": [
        "Web source 1",
        "Wikipedia"
      ],
      "source": "https://encyclopediaofalabama.org/article/ohatchee/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Janney Furnace now serves as a museum and park, listed on the Alabama Register of Landmarks and Heritage.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://encyclopediaofalabama.org/article/ohatchee/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The site also honors Calhoun County men who died serving in the Confederate military, with a dedicated memorial.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Web source 1"
      ],
