      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "By 1920, Marine Corps schools at Quantico were founded, earning the base the nickname \"Crossroads of the Marine Corps\".",
      "sourceSentenceIds": [
        2,
        20
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Marine_Corps_Base_Quantico",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The Commanding General's Quarters, built in 1920, was added to the National Register of Historic Places in 2009.",
      "sourceSentenceIds": [
        11
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Marine_Corps_Base_Quantico",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The FBI Academy, the FBI's main training center, is housed on Quantico Base alongside the Marine Corps.",
      "sourceSentenceIds": [
        26
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Marine_Corps_Base_Quantico",
      "category": "landmark",
      "quality": "good"
    },
    {
