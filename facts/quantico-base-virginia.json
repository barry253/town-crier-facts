      "id": 1,
      "text": "Quantico's name, meaning \"by the long stream\" in a Native American language, was adopted in 1872 after the railroad arrived.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 2"
      ],
