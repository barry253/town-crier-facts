  "facts": [
    {
      "id": 1,
      "text": "Port Royal was established in 1652 as a port at the head of sea‑going navigation on the Rappahannock River.",
      "sourceSentenceIds": [
        27
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Port_Royal%2C_Virginia"
    },
    {
      "id": 2,
      "text": "The town’s name comes from Thomas Roy’s tobacco warehouse, which gave the area its early commercial identity.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.dhr.virginia.gov/historic-registers/284-0047/"
    },
    {
      "id": 3,
      "text": "Dorothy Roy and her husband John ran a crown‑chartered warehouse, a ferry across the Rappahannock, and a tavern that served travelers.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Port_Royal%2C_Virginia"
    },
    {
      "id": 4,
      "text": "Historic Port Royal Inc, founded in 1992, operates a museum that preserves the town’s colonial and 19th‑century heritage.",
      "sourceSentenceIds": [
        1,
        3
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://museumsdatabase.com/museums/view/32446"
    },
    {
      "id": 5,
      "text": "The chimneys of the original Roy house still stand today as one of Port Royal’s few remaining colonial structures.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Port_Royal%2C_Virginia"
    },
    {
      "id": 6,
      "text": "Shipping from Port Royal declined after railroads appeared in the 1830s, ending the town’s era as a tobacco export hub.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Port_Royal%2C_Virginia"
    }
  ]
