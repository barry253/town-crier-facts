  "facts": [
    {
      "id": 1,
      "text": "Parker City was originally platted as Morristown in 1851 before the railroad prompted a name change.",
      "sourceSentenceIds": [
        1,
        3
      ],
      "sourceLabels": [
        "Web source 2",
        "Wikipedia"
      ],
      "source": "https://grokipedia.com/page/parker_city_indiana",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "A brief attempt to rename the post office back to Morristown in 1870 failed after a year, cementing Parker's identity.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/parker_city_indiana",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Randolph County, founded in 1818 from Wayne County, reflects early Quaker settlement patterns that shaped Parker City's roots.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/parker_city_indiana",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Parker City remains a peaceful, community-oriented town, offering a rural retreat in east-central Indiana.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/parker_city_indiana",
