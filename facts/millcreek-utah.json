  "facts": [
    {
      "id": 1,
      "text": "Millcreek’s history spans three centuries, from pioneer farm homes to mid‑century starter‑home subdivisions.",
      "sourceSentenceIds": [
        9,
        10
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.millcreekut.gov/481/History",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "In 2002 Salt Lake County created Millcreek Township to give residents local control and prevent annexation by neighboring cities.",
      "sourceSentenceIds": [
        17,
        18
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.millcreekut.gov/481/History",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The 2012 ballot question incorporated Millcreek, setting city boundaries identical to the township and sparking a debate over municipal government.",
      "sourceSentenceIds": [
        22
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.millcreekut.gov/481/History",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Millcreek’s downtown plan centers on Highland Drive and 3300 South, a commercial hub that will tie together the city’s neighborhoods.",
      "sourceSentenceIds": [
        24
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.millcreekut.gov/481/History",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The historic Millcreek Historic Preservation Commission works to keep the town’s three‑century heritage alive for future generations.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.millcreekut.gov/481/History",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Millcreek residents often identify with Salt Lake City for mailing addresses, despite being a separate city.",
