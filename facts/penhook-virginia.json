      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The Old Chapel Church, built in 1769 as a chapel of ease, sits at 436 Old Chapel Road and was added to the National Register in 2017.",
      "sourceSentenceIds": [
