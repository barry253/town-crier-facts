  "facts": [
    {
      "id": 1,
      "text": "Saint Martinville began as the Poste des Atakapas trading post on Bayou Teche, later renamed and made the parish seat.",
      "sourceSentenceIds": [
        3,
        4
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/St._Martinville%2C_Louisiana",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The city officially incorporated in 1817, becoming Louisiana's sixth community to receive city status under state law.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://stmartinville.gov/our-history/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The Duchamp Opera House, opened in 1830, once hosted France‑style operas and witty comedies in the heart of town.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/St._Martinville%2C_Louisiana",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "A beloved local tradition featured the Excelsior Brass Band performing beneath a gazebo on the church green.",
      "sourceSentenceIds": [
        18
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://stmartinville.gov/our-history/",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Martinville maintains international friendships, twinned with towns in France, Canada, Belgium, and Senegal.",
