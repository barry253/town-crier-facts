  "facts": [
    {
      "id": 1,
      "text": "Trinity Bellwoods Park, named after the former Garrison Creek ravine, gave its name to the surrounding neighbourhood.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Trinity-Bellwoods",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Trinity Bellwoods Park once housed Trinity College, one of the University of Toronto’s original colleges, and its gates still stand.",
      "sourceSentenceIds": [
        13,
        15
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Trinity-Bellwoods",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Victorian homes built between the 1880s and 1900s line Trinity Bellwoods, showcasing ornate brickwork and bay windows.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://blog.wedu.ca/toronto/trinity-bellwoods-torontos-most-vibrant-neighborhood/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "By the 1960s, Portuguese immigrants settled in Trinity Bellwoods, a shift that now defines much of the neighbourhood’s character.",
      "sourceSentenceIds": [
        21
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Trinity-Bellwoods",
      "category": "people",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Every Tuesday from spring to fall, a farmer’s market fills Trinity Bellwoods’ northwestern panhandle with fresh produce.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Trinity-Bellwoods",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Ossington Avenue’s former sports bars have transformed into trendy restaurants and cafés, reshaping the area’s nightlife.",
