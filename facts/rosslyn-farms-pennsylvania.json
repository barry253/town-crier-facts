  "facts": [
    {
      "id": 1,
      "text": "Rosslyn Farms was founded in 1902 by the Chartiers Land Company and developed by William Hayes Parrish.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Rosslyn_Farms%2C_Pennsylvania",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The borough’s name comes from Rosslyn, Scotland, where the president of the Chartiers Land Company’s parents were born.",
      "sourceSentenceIds": [
        21
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://rosslynfarmspa.gov/about/a-brief-history-of-rosslyn-farms/",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "When the community reached 60 homes, Pittsburgh Railways ran a streetcar to the hilltop, but it closed quickly because of winter hazards.",
      "sourceSentenceIds": [
        26,
        27
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://rosslynfarmspa.gov/about/a-brief-history-of-rosslyn-farms/",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Bus service began in 1941, replacing the short‑lived streetcar line.",
      "sourceSentenceIds": [
        28
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://rosslynfarmspa.gov/about/a-brief-history-of-rosslyn-farms/",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "William Parrish started the annual Fourth of July celebration soon after arriving, a tradition still marked today.",
      "sourceSentenceIds": [
        30
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://rosslynfarmspa.gov/about/a-brief-history-of-rosslyn-farms/",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "After William Hayes Parrish died in 1919, his son William Morrison Parrish continued developing the borough.",
      "sourceSentenceIds": [
        25
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://rosslynfarmspa.gov/about/a-brief-history-of-rosslyn-farms/",
