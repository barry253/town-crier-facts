  "facts": [
    {
      "id": 1,
      "text": "Quinnesec’s name comes from the Ojibwe word bekweneseg, meaning “smoky,” a nod to the Big and Little Quinnesec Falls that once bore the same name.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Quinnesec%2C_Michigan",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Explorer John Lane Buell discovered rich iron ore in 1871, founded the Quinnesec Mine, and by 1874 shipped the first ore load to Menominee.",
      "sourceSentenceIds": [
        24,
        25,
        26,
        27,
        28,
        29
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.breitungtownshipmi.gov/townshiphistory",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The Menominee River Railroad, a branch of the Chicago and Northwestern, reached Quinnesec in 1877, turning the town into a bustling rail terminus.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.breitungtownshipmi.gov/townshiphistory",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Logging supplied essential timber for the mining industry, making timber harvesting a mainstay alongside ore extraction in Quinnesec’s early economy.",
      "sourceSentenceIds": [
        30
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.breitungtownshipmi.gov/townshiphistory",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Quinnesec sits on the Menominee River, which forms the natural boundary between Michigan and Wisconsin.",
