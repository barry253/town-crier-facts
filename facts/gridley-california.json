      "id": 1,
      "text": "Gridley sprang to life in 1870 when the Oregon and California Railroad cut through the area, bringing trains and settlers.",
      "sourceSentenceIds": [
        3,
        4
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
