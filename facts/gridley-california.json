      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town’s name honors Vernon Bennett Gridley, a wool grower and grain farmer who owned a 960‑acre ranch nearby.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Gridley%2C_California",
      "category": "etymology",
      "quality": "good"
    },
    {
