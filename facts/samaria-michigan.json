  "facts": [
    {
      "id": 1,
      "text": "Samaria was renamed from Weeksville in 1879 when its post office opened, honoring early settlers Samuel and Mary Weeks.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/samaria_michigan",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "A railroad station appeared in May 1878, built by the Wabash Railroad, and served passengers until 1920 when it became a flag stop.",
      "sourceSentenceIds": [
        6,
        14,
        17
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Samaria%2C_Michigan",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Bedford Township, where Samaria lies, was organized March 23, 1836 after splitting from Erie Township, part of Monroe County’s early post‑War of 1812 expansion.",
      "sourceSentenceIds": [
        9,
        30
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/samaria_michigan",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Samaria Road once carried M‑151 until 1965, after which the route was turned over to local control and US 25 was later decommissioned.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/samaria_michigan",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The first township election in the area took place May 2, 1836 at Levi Lewis’s home on Samaria Road, electing William Dunbar supervisor.",
