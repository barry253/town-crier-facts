  "facts": [
    {
      "id": 1,
      "text": "Thomaston was incorporated on January 1, 1825 and became the seat of Upson County.",
      "sourceSentenceIds": [
        24
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Thomaston%2C_Georgia",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town’s name honors General Jett Thomas, an Indian fighter from the War of 1812.",
      "sourceSentenceIds": [
        2,
        3,
        4
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.cityofthomaston.com/187/History",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The Upson County courthouse, built in 1908, now sits on the National Register of Historic Places.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Thomaston%2C_Georgia",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "In the town square, a cannonball mounted on a marble base claims to be the first fired at Fort Sumter.",
      "sourceSentenceIds": [
        18,
        20
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.georgiaencyclopedia.org/articles/counties-cities-neighborhoods/thomaston/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The Upson Historical Society Museum, housed in a former school building, opened in 1833 and preserves local history.",
      "sourceSentenceIds": [
        21
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.georgiaencyclopedia.org/articles/counties-cities-neighborhoods/thomaston/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Georgia State Routes 36 and 74 cross Thomaston, making it a junction for east‑west and north‑south travel.",
      "sourceSentenceIds": [
        28
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
