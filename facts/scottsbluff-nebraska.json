      "quality": "good"
    },
    {
      "id": 2,
      "text": "The city sits across the North Platte River from a bluff now protected by the National Park Service as Scotts Bluff National Monument.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
