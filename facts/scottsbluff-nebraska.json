      "category": "nature",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The bluff was named after fur trader Hiram Scott, found dead near the site after a fur expedition.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
