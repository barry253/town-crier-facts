  "facts": [
    {
      "id": 1,
      "text": "Bingham Lake was platted on July 28 1875 and officially incorporated in 1900, marking its formal establishment as a city.",
      "sourceSentenceIds": [
        16
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Bingham_Lake%2C_Minnesota",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The city takes its name from the adjacent Bingham Lake, a 270‑acre shallow body that never exceeds 10 feet in depth.",
      "sourceSentenceIds": [
        13
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/bingham_lake_minnesota",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "European‑American settlement began in the late 1860s, spurred by the Homestead Act and expanding railroad lines that opened the prairie for farming.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/bingham_lake_minnesota",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "A tile factory operated in Bingham Lake, producing up to 8,000 tiles daily under John Henderson’s management and employing eleven workers.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/bingham_lake_minnesota",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "A post office served the community from 1871 until its closure in 1992, reflecting the town’s long‑standing civic infrastructure.",
      "sourceSentenceIds": [
        17
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Bingham_Lake%2C_Minnesota",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The town has weathered several tornadoes, including a powerful one on March 29 1998 and additional tornado reports in 2009 and 2019.",
      "sourceSentenceIds": [
        11
