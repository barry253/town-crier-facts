  "facts": [
    {
      "id": 1,
      "text": "Odivelas is home to the Cistercian Monastery of São Dinis e São Bernardo, founded in the early 14th century.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://letusdiscover.com/odivelas-mills-fountains-monuments-guide/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The dolmen of Anta das Pedras Grandes in Caneças is an intact prehistoric dolmen whose capstone still sits on the ground.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://letusdiscover.com/odivelas-mills-fountains-monuments-guide/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Legend says King Denis would travel to Odivelas at night to meet women, giving the town its name.",
      "sourceSentenceIds": [
        18,
        20
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Odivelas",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The municipality sits just 8 km northwest of Lisbon’s center, in a plain that stretches from Pontinha to Póvoa de Santo Adrião.",
      "sourceSentenceIds": [
        12,
        14
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Odivelas",
      "category": "other",
      "quality": "poor",
      "qualityReason": "location_description"
    },
    {
      "id": 5,
      "text": "Odivelas hosts guided tours of historic springs that double as lessons in hydrology and city planning.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://letusdiscover.com/odivelas-mills-fountains-monuments-guide/",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The town’s old district borders Lisbon, Amadora, Sintra, and Loures, forming part of Greater Lisbon’s urban fabric.",
