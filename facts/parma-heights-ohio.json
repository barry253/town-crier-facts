  "facts": [
    {
      "id": 1,
      "text": "Parma Heights was first settled by New Englanders in 1816, originally called Greenbriar before adopting the name Parma in 1826.",
      "sourceSentenceIds": [
        1,
        2,
        11,
        12,
        15,
        17
      ],
      "sourceLabels": [
        "Web source 2",
        "Wikipedia"
      ],
      "source": "https://www.britannica.com/place/Parma-Ohio",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town’s first settlers were Benajah Fay and his wife Ruth Wilcox Fay, who arrived from Lewis County, New York, bringing ten children.",
      "sourceSentenceIds": [
        11
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Parma_Heights%2C_Ohio",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "A historic stone house, the Henninger House, built in 1849, still stands on one of Parma Heights’ highest points, offering a view of the northeastern county.",
      "sourceSentenceIds": [
        28,
        29
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Parma_Heights%2C_Ohio",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Parma Heights is surrounded on three sides—north, east, and south—by the larger city of Parma, while Brook Park and Middleburg Heights border its west.",
      "sourceSentenceIds": [
        7,
        8
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Parma_Heights%2C_Ohio",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The original Broadview Road was known as Town Line Road and Independence Road, reflecting early transportation routes that connected the township to neighboring settlements.",
      "sourceSentenceIds": [
        24
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Parma_Heights%2C_Ohio",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The area that became Parma Heights was surveyed in 1806 by Abraham Tappan of the Connecticut Land Company, marking its place in the Western Reserve.",
