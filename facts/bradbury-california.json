  "facts": [
    {
      "id": 1,
      "text": "Bradbury takes its name from Louis Leonard Bradbury, who bought 2,750 acres of the former Rancho Azusa de Duarte in 1892.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.cityofbradbury.org/about_us/city_history.php"
    },
    {
      "id": 2,
      "text": "The city incorporated on August 22, 1957, just before Monrovia and Duarte were set to annex the area.",
      "sourceSentenceIds": [
        15,
        16
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Bradbury%2C_California"
    },
    {
      "id": 3,
      "text": "Bradbury sits in the San Gabriel Valley foothills, just below the edge of Angeles National Forest.",
      "sourceSentenceIds": [
        9,
        10
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Bradbury%2C_California"
    },
    {
      "id": 4,
      "text": "Bradbury Estates is a gated community where each lot must be at least five acres, making it one of the largest residential parcels in the county.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Bradbury%2C_California"
    },
    {
      "id": 5,
      "text": "An arched bridge over the historic Pacific Electric Railroad tracks once connected Bradbury to Duarte, a reminder of the early 20th‑century streetcar era.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.cityofbradbury.org/about_us/city_history.php"
    },
    {
      "id": 6,
      "text": "In 1912, Minerva Bradbury married Isaac Polk and built Chateau Bradbury, a grand mansion that still stands on the original family estate.",
