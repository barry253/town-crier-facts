  "facts": [
    {
      "id": 1,
      "text": "Glen Flora was originally named Miller's Siding after Frank Miller, who built the area's first sawmill in the 1880s.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Glen_Flora%2C_Wisconsin"
    },
    {
      "id": 2,
      "text": "Early steam engines required frequent stops, leading to the creation of the Glen Flora station midway between Deertail and Ingram.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Glen_Flora%2C_Wisconsin"
    },
    {
      "id": 3,
      "text": "Three early settlers homesteaded land in Glen Flora around 1885, and their descendants still live in the area today.",
      "sourceSentenceIds": [
        28,
        29
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://ruskcounty.org/?SEC=D2EEB27E-3CA0-422B-BA6D-1AD52BD6E986&DE=69F8FF8C-D116-485B-90AE-6443B9AA2477"
    },
    {
      "id": 4,
      "text": "Early Glen Flora operated three large sawmills that shipped lumber, shingles, ties, and barrel stoves by rail.",
      "sourceSentenceIds": [
        30
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://ruskcounty.org/?SEC=D2EEB27E-3CA0-422B-BA6D-1AD52BD6E986&DE=69F8FF8C-D116-485B-90AE-6443B9AA2477"
    },
    {
      "id": 5,
      "text": "An 1891 album described Glen Flora as a lumber settlement with about thirty residents located on Duncan Creek.",
