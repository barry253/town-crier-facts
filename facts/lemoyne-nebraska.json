  "facts": [
    {
      "id": 1,
      "text": "Lemoyne was surveyed and platted in 1911, named after landowner Lemoyne Jacobs who lobbied for the Union Pacific line.",
      "sourceSentenceIds": [
        1,
        2,
        3
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Lemoyne%2C_Nebraska",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "In 1937 residents were told to relocate, and by 1941 the original town was submerged under Lake McConaughy.",
      "sourceSentenceIds": [
        19,
        21,
        22,
        25
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Lemoyne%2C_Nebraska",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The 2004 drought lowered Lake McConaughy enough to expose the submerged town’s foundations for the first time in 63 years.",
      "sourceSentenceIds": [
        10,
        23,
        24
      ],
      "sourceLabels": [
        "Web source 1",
        "Wikipedia"
      ],
      "source": "https://grokipedia.com/page/lemoyne_nebraska",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Today Lemoyne thrives as a seasonal beach town, drawing visitors to its sandy shores and fishing for trophy species.",
      "sourceSentenceIds": [
        26,
        27
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/lemoyne_nebraska",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The Union Pacific completed a 1909 branch through the North Platte Valley, routed through Lemoyne Jacobs’ land after his early 1880s settlement.",
