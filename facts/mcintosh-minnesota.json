  "facts": [
    {
      "id": 1,
      "text": "McIntosh was named for Angus John McIntosh, a Scottish‑descended immigrant who settled in the area in 1870.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/McIntosh%2C_Minnesota",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town’s roots trace back to the 1883 opening of the “Thirteen Towns” in Polk County, where settlers first homesteaded.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/McIntosh%2C_Minnesota",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "In 1886, Angus McIntosh bought land near a school site, attracting settlers such as Ole Lee and Knute Austin to form the village.",
      "sourceSentenceIds": [
        27,
        29
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://mcintoshmn.com/community/about",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The arrival of the railroad sparked excitement, as towns vied to become the rail line’s hub.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://mcintoshmn.com/community/about",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "McIntosh’s original general store, known as “Old McIntosh,” stood northeast of the school land and served early residents.",
      "sourceSentenceIds": [
        30
      ],
      "sourceLabels": [
        "Web source 1"
      ],
