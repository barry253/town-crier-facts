  "facts": [
    {
      "id": 1,
      "text": "College Place earned its name from Walla Walla University, formerly Walla Walla College, which founded the city in 1946.",
      "sourceSentenceIds": [
        24,
        27
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/College_Place%2C_Washington",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The historic Mullan Road Park in College Place preserves stone markers from the 19th‑century trail that linked Fort Benton to Fort Walla Walla.",
      "sourceSentenceIds": [
        2,
        6
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://beckdc.com/historical-places-in-college-place/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Whitman Mission National Historic Site, located in College Place, commemorates the 1847 Whitman Massacre that sparked regional tensions.",
      "sourceSentenceIds": [
        7,
        16,
        22
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://beckdc.com/historical-places-in-college-place/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Frenchtown, a historic neighborhood in College Place, showcases well‑preserved early houses and the 1901 Saint Rose of Lima Catholic Church.",
      "sourceSentenceIds": [
        18,
        20
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://beckdc.com/historical-places-in-college-place/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "During World War II, Martin Field west of College Place served as an air training base before becoming a private airfield.",
      "sourceSentenceIds": [
        25,
        26
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/College_Place%2C_Washington",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "College Place celebrates its heritage with the First Treaty Council Monument, also known as Pe‑Wa‑Oo‑Yit, honoring early treaty negotiations.",
