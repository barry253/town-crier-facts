  "facts": [
    {
      "id": 1,
      "text": "Dyess Colony was founded in 1934 as a federal agricultural resettlement community under the Works Progress Administration and the Federal Emergency Relief Administration.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.astate.edu/outreach/history-and-heritage/heritage-sites/dyess-cash/history.html",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town was named after William Reynolds Dyess, a Mississippi County native who served as Arkansas’s first WPA administrator.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.astate.edu/outreach/history-and-heritage/heritage-sites/dyess-cash/history.html",
      "category": "people",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Johnny Cash grew up in Dyess from age three, and the town is his boyhood home.",
      "sourceSentenceIds": [
        7,
        19
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Dyess%2C_Arkansas",
      "category": "people",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "By its first anniversary in May 1935, Dyess Colony had built 347 homes, a commissary, school, cotton gin, and miles of gravel roads.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://aymag.com/arkansas-backstories-dyess-colony/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The colony’s boyhood home of Johnny Cash is listed on the National Register of Historic Places along with other surviving buildings.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Dyess%2C_Arkansas",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Dyess Colony was the largest agrarian community created by the federal government during the Great Depression.",
      "sourceSentenceIds": [
        22
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Dyess%2C_Arkansas",
