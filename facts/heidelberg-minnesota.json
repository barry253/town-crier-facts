  "facts": [
    {
      "id": 1,
      "text": "Heidelberg was platted December 4, 1878, by German settlers Frank Heil and Frederick Ihrig, who named it after their hometown in Germany.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Heidelberg%2C_Minnesota",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town’s first post office opened in 1867, long before the town was officially platted, serving early settlers for 36 years.",
      "sourceSentenceIds": [
        4,
        10
      ],
      "sourceLabels": [
        "Web source 2",
        "Wikipedia"
      ],
      "source": "https://www.cityofheidelbergmn.com/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Heidelberg’s first city council convened on July 5, 1894, marking the start of formal municipal governance.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.cityofheidelbergmn.com/history",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "In the late 1850s, Frank Heil and Frederick Ihrig settled in the area, bringing German craftsmanship that later shaped local businesses.",
      "sourceSentenceIds": [
        29
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.cityofheidelbergmn.com/",
      "category": "people",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Heidelberg’s Creamery became the only cheese factory in both Nicollet and Le Sueur counties, a unique regional food heritage.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
