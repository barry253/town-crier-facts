  "facts": [
    {
      "id": 1,
      "text": "Panama City Beach became an official city in 1970 when several beachside communities, including the original resort area founded by Gideon Thomas, merged together.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Panama_City_Beach%2C_Florida",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Summer highs in Panama City Beach climb into the 90s while winter lows hover in the 50s, making it ideal for sunbathing and scenic hikes.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.pcbfl.gov/181/Area-Information",
      "category": "other",
      "quality": "poor",
      "qualityReason": "vague"
    },
    {
      "id": 3,
      "text": "The 2018 Category 5 Hurricane Michael struck near Mexico Beach, devastating much of Bay County, including Panama City Beach, and ranking among the strongest U.S. hurricanes.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Panama_City_Beach%2C_Florida",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Scuba divers flock to Panama City Beach because it earned the nickname 'Wreck Capital of the South' for its many historic shipwrecks.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.visitpanamacitybeach.com/plan-your-trip/faqs/pcb-facts/",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "If caught in a rip current at Panama City Beach, swimmers should relax and swim parallel to the shore until the current carries them out.",
