  "facts": [
    {
      "id": 1,
      "text": "Mansura was originally called Prairie des Avoyelles, a name French soldiers gave after seeing the town resemble Egypt’s Mansoura during Napoleon’s campaign.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.townofmansura.com/about",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Settled in the late 1700s while still under Spanish rule, Mansura’s early history dates back to colonial Louisiana.",
      "sourceSentenceIds": [
        15
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.townofmansura.com/about",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Mansura blends American Indian, French, Spanish, and English cultures, a mix that shaped its unique regional identity.",
      "sourceSentenceIds": [
        14
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.townofmansura.com/about",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The Louisiana 4‑H Museum, opened in 2009, honors more than 100 inductees from every one of Louisiana’s 64 parishes.",
      "sourceSentenceIds": [
        5,
        7,
        2
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Mansura%2C_Louisiana",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Every May, Mansura hosts the Cochon de Lait Festival, featuring a greasy pig contest and a spirited hog‑calling competition.",
      "sourceSentenceIds": [
        4,
        18
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Mansura%2C_Louisiana",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Known for its cuisine, Mansura’s cochon de lait is celebrated as one of Louisiana’s finest smoked pork dishes.",
      "sourceSentenceIds": [
        16,
        14
      ],
      "sourceLabels": [
        "Web source 2"
      ],
