  "facts": [
    {
      "id": 1,
      "text": "Lame Deer takes its name from Miniconjou Lakota chief Lame Deer, who was killed by the U.S. Army in 1877 under a flag of truce.",
      "sourceSentenceIds": [
        1,
        3
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Lame_Deer%2C_Montana",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town hosts the annual Northern Cheyenne Powwow, a gathering that draws thousands each July and showcases traditional dance and music.",
      "sourceSentenceIds": [
        6,
        28
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Lame_Deer%2C_Montana",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Chief Dull Knife College, a tribal community college and land‑grant institution, sits in Lame Deer and serves the reservation’s youth.",
      "sourceSentenceIds": [
        20
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Lame_Deer%2C_Montana",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Lame Deer is the headquarters for the Northern Cheyenne Indian Reservation’s tribal and government agencies.",
      "sourceSentenceIds": [
        5,
        27
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Lame_Deer%2C_Montana",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The Charging Horse Casino and Cafe, along with the Northern Cheyenne Arts and Crafts Center, offer authentic cultural experiences within town limits.",
      "sourceSentenceIds": [
        19
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Lame_Deer%2C_Montana",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The Lame Deer Museum preserves Plains Indian artifacts and includes a documentary film on the historic Saint Labre school.",
