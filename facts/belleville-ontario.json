  "facts": [
    {
      "id": 1,
      "text": "Belleville earned its name when colonial administrator Sir Francis Gore renamed the settlement in honor of his wife, Lady Annabella Gore, in 1816.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Belleville%2C_Ontario",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The Ontario Institution for the Education of the Deaf and Dumb, later the Ontario School for the Deaf, began operations in Belleville in the 19th century.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Belleville%2C_Ontario",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Glanmore National Historic Site, Belleville's community museum, houses restored 1880s rooms and artifacts that chronicle local history.",
      "sourceSentenceIds": [
        10,
        11,
        12,
        13,
        14
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.belleville.ca/en/index.aspx",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Belleville gave birth to the Dixie Lee Fried Chicken chain in 1964 and Journey's End Corporation's economy‑limited hotel chain in 1978.",
      "sourceSentenceIds": [
        15
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Belleville%2C_Ontario",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Henry Corby, a 19th‑century merchant, founded Corby Distillery, built a grocery store, and helped fund Belleville's first bridge across the Bay of Quinte.",
      "sourceSentenceIds": [
        16
      ],
