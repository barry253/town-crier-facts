  "facts": [
    {
      "id": 1,
      "text": "Bel Air South grew from a 1731 land grant known as \"Scott's Old Fields\" into Harford County’s seat by 1782.",
      "sourceSentenceIds": [
        21,
        22
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Bel_Air%2C_Maryland",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town’s name evolved from “Belle Aire” to the modern spelling after the Civil War, dropping an extra “e” and a second “l.”.",
      "sourceSentenceIds": [
        23
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Bel_Air%2C_Maryland",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The Maryland and Pennsylvania Railroad, nicknamed the Ma & Pa, ran through Bel Air South until 1958, sparking a post‑war building boom.",
      "sourceSentenceIds": [
        5,
        8
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Bel_Air%2C_Maryland",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Bel Air South’s early growth was fueled by the canning industry and related financial businesses that emerged after the Civil War.",
      "sourceSentenceIds": [
        4,
        8
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Bel_Air%2C_Maryland",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The town’s courthouse, begun in 1782 on Main Street, remains a central landmark and the heart of Harford County’s government.",
      "sourceSentenceIds": [
