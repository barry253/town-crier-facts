    },
    {
      "id": 2,
      "text": "Mark Twain based his short story 'The Celebrated Jumping Frog of Calaveras County' on a tale heard at the Angels Hotel in 1865.",
      "sourceSentenceIds": [
        21
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Angels_Camp%2C_California"
    },
    {
      "id": 3,
      "text": "The city hosts an annual Jumping Frog Jubilee each May at the Calaveras County Fairgrounds.",
      "sourceSentenceIds": [
        22
