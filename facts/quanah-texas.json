  "facts": [
    {
      "id": 1,
      "text": "Quanah was founded in the 1880s as a railroad stop and named after Comanche chief Quanah Parker, son of Peta Nocona and Cynthia Ann Parker.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://texastimetravel.com/cities/quanah/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The 1908 Hardeman County Courthouse, a Beaux Arts building, sits beside a granite monument honoring Quanah Parker.",
      "sourceSentenceIds": [
        11
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://cityofquanah.com/tourism",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The 1890 stone Hardeman County Jail Museum, now a National Register site, tells the story of Quanah Parker and early settlers.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://texastimetravel.com/cities/quanah/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "A 1938 mural by artist Jerry Bywaters at the post office chronicles Quanah’s history from buffalo plains to the 1930s.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://texastimetravel.com/cities/quanah/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Quanah’s name honors the last principal chief of the Comanche Nation, making it one of Texas’s few towns named for a Native American leader.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Quanah%2C_Texas",
      "category": "etymology",
      "quality": "good"
    }
