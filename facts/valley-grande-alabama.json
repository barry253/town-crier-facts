  "facts": [
    {
      "id": 1,
      "text": "Valley Grande was originally called Valley Creek in 1819 before being renamed Summerfield in 1845 to honor Methodist preacher John Summerfield.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Valley_Grande%2C_Alabama",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "In 1841 the Alabama Conference of the Methodist Church opened the Methodist Centenary Institute, a co‑educational school chartered by the legislature.",
      "sourceSentenceIds": [
        16
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Valley_Grande%2C_Alabama",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "George Phillips planted a cotton plantation called Grand View in the area that later became Valley Grande.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://cityofvalleygrande.com/about/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The historic core of Summerfield, now part of Valley Grande, remains intact and is listed on the National Register of Historic Places covering 56.12 acres.",
      "sourceSentenceIds": [
        18
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Valley_Grande%2C_Alabama",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The first academy in Dallas County, chartered in 1829, was located in Valley Creek, the town that would become Valley Grande.",
      "sourceSentenceIds": [
        15
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Valley_Grande%2C_Alabama",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Today Valley Grande still encompasses the historic community of Summerfield, preserving its 19th‑century heritage.",
      "sourceSentenceIds": [
        7
