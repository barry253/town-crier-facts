    },
    {
      "id": 3,
      "text": "Bon Homme Colony is nestled on the shores of the Missouri River and Lewis and Clark Lake.",
      "sourceSentenceIds": [
        15
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://info.newstandard-group.com/blog/bonhomme"
    },
    {
      "id": 4,
      "text": "Trading history in the area dates back to 1794 when a French trapper established a post on Bon Homme Island.",
      "sourceSentenceIds": [
