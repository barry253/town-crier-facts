  "facts": [
    {
      "id": 1,
      "text": "Benedict, Maryland, takes its name from Benedict Leonard Calvert, the 15th Proprietary Governor of Maryland, who ruled in the early 1700s.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Benedict%2C_Maryland",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Founded in 1683 as Benedict‑Leonardtown, the town grew into a modest colonial port that exported tobacco to Chesapeake markets.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/benedict_maryland",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "In August 1814, British forces under General Robert Ross landed in Benedict, launching the Chesapeake campaign that led to Washington’s burning.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Benedict%2C_Maryland",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Camp Stanton, erected in October 1863 for the Maryland 7th Regiment, later became the training ground for the 19th Regiment of U.S. Colored Troops.",
      "sourceSentenceIds": [
        13,
        14
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Benedict%2C_Maryland",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The Benedict Bridge, a 0.5‑mile span of Maryland Route 231, carries traffic over the Patuxent River between Charles and Calvert counties.",
      "sourceSentenceIds": [
