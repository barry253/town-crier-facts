  "facts": [
    {
      "id": 1,
      "text": "Hinckley was named after Judge Samuel Hinckley, a land speculator from Massachusetts.",
      "sourceSentenceIds": [
        25
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Hinckley%2C_Ohio",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "A post office has operated in Hinckley since 1825, marking its long‑standing community presence.",
      "sourceSentenceIds": [
        24
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Hinckley%2C_Ohio",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The Hinckley Historical Society, founded in 1988, preserves local heritage in the 1846 Greek Revival Hinckley Historical House.",
      "sourceSentenceIds": [
        3,
        8,
        20
      ],
      "sourceLabels": [
        "Web source 2",
        "Web source 1",
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/hinckley_ohio",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The historic house sits at 1634 Center Road, a small white clapboard Greek Revival home that houses the society’s research library.",
      "sourceSentenceIds": [
        20
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://hinckleytwp.org/community/hinckley-township-ohio-history/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Hinckley remained a wilderness longer than nearby areas because its hilly terrain limited early agriculture, with settlement accelerating after land was divided into 100 plots of 160 acres.",
      "sourceSentenceIds": [
        19
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/hinckley_ohio",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The Connecticut Western Reserve once claimed the area, leading to the Pennamite Wars between Connecticut settlers and Pennsylvania proprietors.",
