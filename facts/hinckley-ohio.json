        24
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Hinckley%2C_Ohio",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The Hinckley Historical Society, founded in 1988, preserves local heritage in the 1846 Greek Revival Hinckley Historical House.",
      "sourceSentenceIds": [
        3,
        8,
        20
      ],
      "sourceLabels": [
