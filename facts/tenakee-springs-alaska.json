  "facts": [
    {
      "id": 1,
      "text": "Tenakee Springs got its name in 1928 when the post office and settlement were renamed to spotlight the town’s natural hot springs.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.kupi.com/en/explore/united-states/tenakee-springs/history",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town’s first commercial building, Snyder Mercantile, dates back to 1899 and showcases Gold Rush era architecture.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.kupi.com/en/explore/united-states/tenakee-springs/history",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "In 1916, the Superior Packing Company opened a cannery, sparking a boom that drew new settlers to the area.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.kupi.com/en/explore/united-states/tenakee-springs/history",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "For much of its history, Tenakee Springs had no automotive traffic, preserving a pedestrian‑only street layout along Tenakee Avenue.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.kupi.com/en/explore/united-states/tenakee-springs/history",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The original Tlingit people used the Chichagof Island lands that now host Tenakee Springs, linking the town to ancient indigenous heritage.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.kupi.com/en/explore/united-states/tenakee-springs/history",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The Snyder Mercantile building was honored in 1993 by being listed on the National Register of Historic Places, cementing its architectural significance.",
