  "facts": [
    {
      "id": 1,
      "text": "Saegertown was founded in 1824 when Daniel Saeger bought a sawmill and laid out the town.",
      "sourceSentenceIds": [
        4,
        8
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Saegertown%2C_Pennsylvania",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town’s name honors Daniel Saeger, a Pennsylvania native of German descent who settled the area in 1823.",
      "sourceSentenceIds": [
        9,
        10
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Saegertown%2C_Pennsylvania",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Before becoming Saegertown, the settlement was briefly called Aldens Mill after Major Roger Alden built a sawmill around 1800.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Saegertown%2C_Pennsylvania",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The Edward Saeger House, built by the town’s founder, was added to the National Register of Historic Places in 1980.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Saegertown%2C_Pennsylvania",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "In 1920 the Saegertown Ginger Ale Company launched Eureka Springs, a local soft drink that later switched to bottled water when national brands dominated.",
      "sourceSentenceIds": [
        28,
        29
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.frenchcreekconservancy.org/saegertown/",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Today Saegertown Beverages continues the legacy by selling Eureka Springs Water, a nod to the town’s early 20th‑century beverage history.",
