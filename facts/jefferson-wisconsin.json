  "facts": [
    {
      "id": 1,
      "text": "Jefferson sits where the Rock and Crawfish rivers meet, a spot chosen for water power and steamboat navigation in the 1830s.",
      "sourceSentenceIds": [
        1,
        2,
        18,
        19
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Jefferson%2C_Wisconsin",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The city’s founders were New England farmers who brought Yankee values, including a passion for education and abolitionism, to the frontier.",
      "sourceSentenceIds": [
        3,
        13,
        23
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Jefferson%2C_Wisconsin",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Jefferson’s historic downtown preserves buildings on the National Register, reflecting its 19th‑century commercial boom.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://jeffersontourismwi.com/history/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The 1911 Carnegie library, now a performing‑arts hub, showcases Prairie School architecture and the town’s early commitment to learning.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://jeffersontourismwi.com/history/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Camp Jefferson, a World War II German POW camp, once stood on the county fairgrounds, a reminder of the city’s wartime role.",
      "sourceSentenceIds": [
        27
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Jefferson%2C_Wisconsin",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Gemütlichkeit Days, started in 1971, celebrates the German heritage that many Jefferson residents share, echoing the town’s immigrant roots.",
      "sourceSentenceIds": [
        29
