  "facts": [
    {
      "id": 1,
      "text": "Youngstown was named after Alexander Young, who bought the first lot on November 25, 1815, in Westmoreland County.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Youngstown%2C_Pennsylvania",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Youngstown became an official borough on April 2, 1831, after a petition to the Pennsylvania legislature.",
      "sourceSentenceIds": [
        16
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Youngstown%2C_Pennsylvania",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The Kingston House, a trade hub and hotel from 1800, earned a spot on the National Register of Historic Places in 1983.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Youngstown%2C_Pennsylvania",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "When the Pennsylvania Railroad opened a line through nearby Latrobe in 1852, merchants shifted toward the tracks, reducing traffic on the Greensburg‑Stoystown Turnpike.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Youngstown%2C_Pennsylvania",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Since 1875, the Mahoning Valley Historical Society has celebrated local history and now offers a free reservation line at 330‑743‑2589.",
      "sourceSentenceIds": [
        14
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://mahoninghistory.org/",
      "category": "other",
      "quality": "poor",
      "qualityReason": "editorial_filler"
    },
    {
