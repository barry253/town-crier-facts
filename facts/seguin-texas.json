  "facts": [
    {
      "id": 1,
      "text": "Seguin was founded August 12, 1838, just 16 months after Texas won independence, making it one of the state's oldest towns.",
      "sourceSentenceIds": [
        1,
        11
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Seguin%2C_Texas",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town was named for Juan Seguín, a Tejano freedom fighter who fought for the Republic of Texas.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Seguin%2C_Texas",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Seguin’s Sebastopol House, built in 1856, is a rare limecrete concrete home and a Texas Historical Commission landmark on the National Register.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Seguin%2C_Texas",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The Seguin Public Library’s Local History Room houses microfilm of Guadalupe County newspapers dating back to the 1890s, useful for genealogy.",
      "sourceSentenceIds": [
        23,
        24
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.seguintexas.gov/1449/Local-History-Resources",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Guadalupe County was organized in 1845 with Seguin as its county seat, cementing the town’s early regional importance.",
