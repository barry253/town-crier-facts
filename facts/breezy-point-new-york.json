  "facts": [
    {
      "id": 1,
      "text": "Breezy Point is a private community run by a cooperative that owns the entire 500‑acre area while residents hold shares.",
      "sourceSentenceIds": [
        18,
        19
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Breezy_Point%2C_Queens",
      "category": "other",
      "quality": "poor",
      "qualityReason": "other"
    },
    {
      "id": 2,
      "text": "The community’s private security patrols the beach and restricts access to owners, renters, and guests.",
      "sourceSentenceIds": [
        29
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Breezy_Point%2C_Queens",
      "category": "other",
      "quality": "poor",
      "qualityReason": "other"
    },
    {
      "id": 3,
      "text": "Breezy Point’s shoreline includes a 200‑acre area with dunes, marshland, and a breeding ground for piping plover and other shorebirds.",
      "sourceSentenceIds": [
        21,
        22
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Breezy_Point%2C_Queens",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "In 1960, the Atlantic Improvement State Corporation sold the land for $17 million, and residents later bought half for $11 million to form the cooperative.",
      "sourceSentenceIds": [
        25,
        26
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Breezy_Point%2C_Queens",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The Breezy Point Historical Society, founded in 2015 after Hurricane Sandy, works to preserve the area’s history from the 1900s to today.",
      "sourceSentenceIds": [
        3,
        9
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://breezypointhistory.org/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The Silver Gull Beach Club in Breezy Point doubled as the El Flamingo Beach Club in the 1984 film The Flamingo Kid.",
