  "facts": [
    {
      "id": 1,
      "text": "Milesburg was founded by Samuel Miles, a Continental Army officer who started ironworks at Centre Furnace in 1791.",
      "sourceSentenceIds": [
        27,
        28
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.milesburg.org/history",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The borough’s name evolved from Milesborough to Milesburgh in 1827, finally becoming Milesburg in 1893.",
      "sourceSentenceIds": [
        24,
        25
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.milesburg.org/history",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Milesburg sits where the Bald Eagle and Spring Creeks meet, in the heart of Centre County’s historic Bald Eagle Valley.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://milesburgboro.com/",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The Hannah Green Meeting House, built around 1793, now houses the Milesburg Museum and serves as a research library.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.milesburg.org/history",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The Iddings‑Baldridge House, a 19th‑century landmark, earned a spot on the National Register of Historic Places in 1977.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Milesburg%2C_Pennsylvania",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Samuel Miles’ brothers and sons helped settle the area in 1793, drawing ironworkers to the ore‑rich banks of the two creeks.",
      "sourceSentenceIds": [
        29,
        30
      ],
      "sourceLabels": [
        "Web source 1"
      ],
