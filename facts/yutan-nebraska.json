  "facts": [
    {
      "id": 1,
      "text": "Yutan began as Clear Creek, platted in 1876 when the Omaha and Republican Valley Railroad reached the spot.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Yutan%2C_Nebraska"
    },
    {
      "id": 2,
      "text": "The town was renamed in 1884 after Chief Ietan, an Otoe Indian leader whose village once stood nearby.",
      "sourceSentenceIds": [
        3,
        4
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 2"
      ],
      "source": "https://en.wikipedia.org/wiki/Yutan%2C_Nebraska"
    },
    {
      "id": 3,
      "text": "In 1833, the Yutan site hosted a treaty among the Oto, Pawnee, and Delaware tribes before the Oto left in 1835.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Yutan%2C_Nebraska"
    },
    {
      "id": 4,
      "text": "Yutan sits along Upper Clear Creek, a tributary that helped shape the town’s early settlement patterns.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Yutan%2C_Nebraska"
    },
    {
      "id": 5,
      "text": "The city’s public schools, Yutan Elementary and Yutan High, serve the community under the Yutan Public Schools district.",
      "sourceSentenceIds": [
        23,
        24
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Yutan%2C_Nebraska"
    },
    {
      "id": 6,
      "text": "Located in Saunders County, Yutan lies in northeastern Nebraska, close to the Platte River basin.",
      "sourceSentenceIds": [
        8
      ],
