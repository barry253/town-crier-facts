      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The Morris Canal, built in the 1830s, ran through Stewartsville and carried anthracite coal to New Jersey and New York factories.",
      "sourceSentenceIds": [
        11,
        9
      ],
      "sourceLabels": [
        "Web source 1"
