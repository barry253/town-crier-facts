  "facts": [
    {
      "id": 1,
      "text": "St. Elizabeth’s name comes from a local Roman Catholic church, itself likely named after Elizabeth of Hungary.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/St._Elizabeth%2C_Missouri"
    },
    {
      "id": 2,
      "text": "Before becoming St. Elizabeth, the town was called Charlestown and was platted in 1875 after its original owner, Charley Holtschneider.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/St._Elizabeth%2C_Missouri"
    },
    {
      "id": 3,
      "text": "The historic Boeckman Bridge, a landmark in the village, earned a spot on the National Register of Historic Places in 1979.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/St._Elizabeth%2C_Missouri"
    },
    {
      "id": 4,
      "text": "St. Elizabeth sits at the crossroads of Missouri Routes 52 and E, anchoring the village in northeast Miller County.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/St._Elizabeth%2C_Missouri"
    },
    {
      "id": 5,
      "text": "The Osage River runs just two miles west of St. Elizabeth, shaping the local landscape and watershed.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/St._Elizabeth%2C_Missouri"
    },
    {
      "id": 6,
      "text": "The village rests on a ridge that drains west to Whalen Creek and east to Tavern Creek, both tributaries of the Osage River.",
      "sourceSentenceIds": [
        13
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/St._Elizabeth%2C_Missouri"
