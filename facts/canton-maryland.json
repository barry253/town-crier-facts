  "facts": [
    {
      "id": 1,
      "text": "Canton takes its name from John O'Donnell, who christened his plantation after the Chinese port Guangzhou, then called Canton.",
      "sourceSentenceIds": [
        20
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Canton%2C_Baltimore",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "In 1872, skilled Irish and Polish workers began immigrating to Canton factories, shaping the neighborhood’s industrial roots.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Canton%2C_Baltimore",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The Union Railroad first connected Canton to downtown Baltimore, and work resumed 1871‑73, employing 300 workers and costing over $3 million.",
      "sourceSentenceIds": [
        11,
        12
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Canton%2C_Baltimore",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Canton’s branch of the Enoch Pratt Free Library, Baltimore’s first library, opened in 1866 and sits on O’Donnell Square.",
      "sourceSentenceIds": [
        13
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Canton%2C_Baltimore",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Before 1608, the land that is now Canton lay within the Piscataway sphere of influence, yet John Smith reported it uninhabited after conflicts with the Massawomeck.",
