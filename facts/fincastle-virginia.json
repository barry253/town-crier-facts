  "facts": [
    {
      "id": 1,
      "text": "Fincastle was founded in 1772 and named after Lord Fincastle, son of Virginia’s last royal governor.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.botetourtva.gov/333/History",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town began as and remains the seat of Botetourt County, a historic center.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.townoffincastle.org/index.php",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Fincastle’s Main Street hosts a historic movie theater, a classic soda fountain, and local shops that echo its 19th‑century charm.",
      "sourceSentenceIds": [
        16
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.botetourtva.gov/333/History",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The Botetourt County Historical Museum, located in Fincastle, showcases the county’s rich heritage and offers educational tours.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.botetourtva.gov/333/History",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Fincastle is a nationally recognized Lewis & Clark Community, allowing visitors to see documents signed by Thomas Jefferson and Patrick Henry.",
      "sourceSentenceIds": [
        15
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.botetourtva.gov/333/History",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The town’s early growth centered around a sawmill built by John Miller, which became the nucleus of the village.",
