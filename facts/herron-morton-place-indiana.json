  "facts": [
    {
      "id": 1,
      "text": "During the Civil War, Herron‑Morton Place hosted Camp Morton, a Confederate prisoner‑of‑war camp named after Governor Oliver P. Morton.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Herron%E2%80%93Morton_Place_Historic_District",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "In 1888, the Hoosier Group art school opened in Morton Place, bringing a new wave of regional artists.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Herron%E2%80%93Morton_Place_Historic_District",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "John Herron's 1895 bequest of $200,000 launched the Herron Art Institute, sparking Indianapolis's first major art museum.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Herron%E2%80%93Morton_Place_Historic_District",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The Herron‑Morton Place Neighborhood Association began in 1976, later turning into a historic preservation force.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Herron%E2%80%93Morton_Place_Historic_District",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Herron‑Morton Place earned National Register of Historic Places status in 1983, cementing its architectural legacy.",
      "sourceSentenceIds": [
        21
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Herron%E2%80%93Morton_Place_Historic_District",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The neighborhood once hosted iconic LGBTQ venues like Club Betty K and the 21 Club, shaping early gay culture.",
      "sourceSentenceIds": [
        29
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Herron%E2%80%93Morton_Place_Historic_District",
