  "facts": [
    {
      "id": 1,
      "text": "Plains was founded in 1827 after federal authorities forced out Muscogee Indians under the Treaty of Washington, and was located one mile north of its present site.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.georgiaencyclopedia.org/articles/counties-cities-neighborhoods/plains/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "In 1885 a major east–west railroad extended into the area, consolidating three settlements into one and prompting Plains to move one mile south to the new rail line.",
      "sourceSentenceIds": [
        10,
        15
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 2"
      ],
      "source": "https://en.wikipedia.org/wiki/Plains%2C_Georgia",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The town’s name evolved from “Plains of Dura,” a biblical reference, to simply “Plains” after local businessmen petitioned the legislature.",
      "sourceSentenceIds": [
        8,
        26
      ],
      "sourceLabels": [
        "Web source 2",
        "Wikipedia"
      ],
      "source": "https://www.georgiaencyclopedia.org/articles/counties-cities-neighborhoods/plains/",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Plains’ economy shifted from cotton to peanuts after a boll weevil infestation in 1915 forced farmers to find a new crop.",
      "sourceSentenceIds": [
        22
      ],
      "sourceLabels": [
