      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "William McConnell became Richmond’s first postmaster when President Van Buren appointed him after the town secured a post office.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
