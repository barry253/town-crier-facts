      ],
      "source": "https://richmond-il.com/our-history/",
      "category": "people",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Richmond’s first cheese factory, opened by McConnell a half‑mile west of town, was the county’s first cheese factory.",
      "sourceSentenceIds": [
        10,
