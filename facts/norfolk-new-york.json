      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town’s boundaries stabilized after 1825, with only a small area lost to the Village of Potsdam Junction in 1869.",
      "sourceSentenceIds": [
        11
      ],
      "sourceLabels": [
        "Web source 2"
      ],
