  "facts": [
    {
      "id": 1,
      "text": "Founded in 1789 as Ship Harbour, Port Hawkesbury was renamed after Admiral Sir Edward Hawke, who steered Governor Cornwallis to Halifax.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Port_Hawkesbury",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "In the 19th century, the town built the brig James, one of Canada’s earliest ship portraits, showcasing its shipbuilding prowess.",
      "sourceSentenceIds": [
        22
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Port_Hawkesbury",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Port Hawkesbury once served as a stop for American coastal steam ships, linking the island to mainland trade routes.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Port_Hawkesbury",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The town’s museum focuses on the 1950s and houses an ancestral library that is a prized resource for genealogy enthusiasts.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.cbisland.com/en/blog/port-hawkesbury",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "During the Canso Causeway’s 50th anniversary, plaques were installed in Port Hawkesbury to commemorate the region’s role in the causeway’s history.",
