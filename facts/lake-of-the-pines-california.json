      ],
      "source": "https://www.lop.org/about-us1"
    },
    {
      "id": 2,
      "text": "The reservoir was created by damming Magnolia Creek in the Bear River watershed, reaching a maximum elevation of 459 meters.",
      "sourceSentenceIds": [
        10
      ],
