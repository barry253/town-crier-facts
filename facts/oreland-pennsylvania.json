  "facts": [
    {
      "id": 1,
      "text": "Oreland village was laid out in 1889 near the North Penn Railroad, now part of SEPTA’s Lansdale/Doylestown Line.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Oreland%2C_Pennsylvania",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Oreland, as part of Springfield Township, was settled as one of William Penn’s original manors.",
      "sourceSentenceIds": [
        18
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Oreland%2C_Pennsylvania",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "In 1686 Thomas Fitzwater discovered vast lime deposits, built a kiln by 1693, and drew William Penn’s attention to the area.",
      "sourceSentenceIds": [
        19,
        20
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Oreland%2C_Pennsylvania",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The lime and ore deposits in the area gave Oreland its name.",
      "sourceSentenceIds": [
        21
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Oreland%2C_Pennsylvania",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Mining and farming dominated Oreland until the 20th century, when it evolved into a residential suburb of Philadelphia.",
      "sourceSentenceIds": [
        22
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Oreland%2C_Pennsylvania",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "A bronze tablet installed in 1928 marks where Emlen House, George Washington’s headquarters during the Revolutionary War, once stood.",
