  "facts": [
    {
      "id": 1,
      "text": "Roncesvalles Avenue takes its name from the 1813 Battle of Roncesvalles in Spain, a tribute to Colonel Walter O'Hara who fought there.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Roncesvalles%2C_Toronto",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Colonel Walter O'Hara first settled the area in 1850 after being wounded and captured during the Spanish battle.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Roncesvalles%2C_Toronto",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Roncesvalles Village’s Business Improvement Area, founded in 1985, is one of Toronto’s oldest BIA districts.",
      "sourceSentenceIds": [
        16
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Roncesvalles%2C_Toronto",
      "category": "other",
      "quality": "poor",
      "qualityReason": "editorial_filler"
    },
    {
      "id": 4,
      "text": "In 2012, Roncesvalles became the only Toronto neighbourhood to reach the Canadian Institute of Planners’ Great Places in Canada finalist list.",
      "sourceSentenceIds": [
