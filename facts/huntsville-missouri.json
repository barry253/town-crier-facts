  "facts": [
    {
      "id": 1,
      "text": "Huntsville was named after Daniel Hunt, a Kentuckian who first settled there between 1820-21.",
      "sourceSentenceIds": [
        3,
        28
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Huntsville%2C_Missouri",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town became the county seat of Randolph County in 1831, just two years after the county was organized.",
      "sourceSentenceIds": [
        26,
        27
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Huntsville%2C_Missouri",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The Huntsville Historical Society, chartered June 19, 1973, runs a museum that preserves artifacts and offers a public research library.",
      "sourceSentenceIds": [
        4,
        8,
        25
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Huntsville%2C_Missouri",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Historic Sanborn maps of Huntsville are housed at the University of Missouri, giving a detailed view of the town’s past layout.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Huntsville%2C_Missouri",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Huntsville hosts a branch of the Little Dixie Regional Libraries, providing community access to books and resources.",
      "sourceSentenceIds": [
        24
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Huntsville%2C_Missouri",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The town’s early economy featured William Goggins’ mill, the first in Randolph County, which helped spur local development.",
