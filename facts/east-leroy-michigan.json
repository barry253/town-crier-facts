  "facts": [
    {
      "id": 1,
      "text": "East Leroy was named after Leroy Fish, the first-born son of early settler David C., whose wife suggested the name.",
      "sourceSentenceIds": [
        5,
        23
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/east_leroy_michigan",
      "category": "etymology",
      "quality": "poor",
      "qualityReason": "dropped_surname_no_wiki_source"
    },
    {
      "id": 2,
      "text": "The community’s post office opened on June 28, 1852, as Secillia, with William H. Gilles appointed its first postmaster.",
      "sourceSentenceIds": [
        14,
        19,
        20
      ],
      "sourceLabels": [
        "Web source 2",
        "Wikipedia"
      ],
      "source": "https://99wfmk.com/east-leroy-michigan/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "East Leroy emerged as a key station on the Michigan Central Railroad, linking Battle Creek to Goshen, Indiana in the mid‑1800s.",
      "sourceSentenceIds": [
        4,
        6
      ],
      "sourceLabels": [
        "Web source 1",
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/east_leroy_michigan",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "A marsh once split the settlement into East and West Leroy, but most of the wetlands were drained in the 19th century for farming.",
      "sourceSentenceIds": [
        8,
        10
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/east_leroy_michigan",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The township’s fertile soils, ranging from burr‑oak plains to timbered lands, supported early agriculture despite health issues like ague.",
      "sourceSentenceIds": [
        25
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/east_leroy_michigan",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "East Leroy lies about 11 miles south‑southwest of Battle Creek, within the Kalamazoo River watershed that shapes its humid continental climate.",
      "sourceSentenceIds": [
