  "facts": [
    {
      "id": 1,
      "text": "Anchor Point earned its name when Captain James Cook lost a kedge anchor off the inlet in May 1778.",
      "sourceSentenceIds": [
        5,
        9
      ],
      "sourceLabels": [
        "Web source 1",
        "Wikipedia"
      ],
      "source": "https://grokipedia.com/page/anchor_point_alaska",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The Dena'ina Athabascan people first settled the Anchor Point area around 1200 AD, using seasonal camps along the Anchor River.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/anchor_point_alaska",
      "category": "people",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "A 1948 road to Homer opened Anchor Point, prompting a post office and school by 1949 and doubling homesteads within five years.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/anchor_point_alaska",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The Anchor River cuts through the southern part of Anchor Point, emptying into Cook Inlet just west of the town center.",
      "sourceSentenceIds": [
        13
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Anchor_Point%2C_Alaska",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Anchor Point’s economy centers on the Anchor River, where summer salmon runs draw anglers to the area.",
      "sourceSentenceIds": [
        17,
        18
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Anchor_Point%2C_Alaska",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Russian traders operated along the Kenai Peninsula into the 19th century, but the 1867 Alaska Purchase shifted control away from Russia.",
