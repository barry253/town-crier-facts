  "facts": [
    {
      "id": 1,
      "text": "Maybee was named after early settler Abram Maybee, a founding resident whose name lives on in the town’s sign.",
      "sourceSentenceIds": [
        2,
        4
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Maybee%2C_Michigan",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "In the late 1800s, Maybee grew into a railroad transport hub for charcoal and other wood products, linking Michigan to Detroit and Ohio.",
      "sourceSentenceIds": [
        1,
        7
      ],
      "sourceLabels": [
        "Web source 1",
        "Wikipedia"
      ],
      "source": "https://www.islands.com/2116842/between-detroit-toledo-hidden-gem-maybee-michigan-shops-parks-eats/",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The village’s historic hall, built in 1912, housed government offices and a fire station until 1977.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Maybee%2C_Michigan",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Early Maybee included a grain elevator, gristmill, mining quarry, sand pit, hotel, churches, schools, and dozens of small factories and stores.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Maybee%2C_Michigan",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Today the village offices sit at 9043 Raisin Street, right next to the historic Maybee Village Hall.",
      "sourceSentenceIds": [
        25
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Maybee%2C_Michigan",
      "category": "other",
      "quality": "poor",
      "qualityReason": "location_description"
    },
    {
      "id": 6,
      "text": "In 2013, Maybee expanded its boundaries by annexing 546 acres of the former Stoneco Quarry north of town.",
