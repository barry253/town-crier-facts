  "facts": [
    {
      "id": 1,
      "text": "Electric City earned its name from the nearby Grand Coulee Dam, one of the world’s largest hydroelectric plants.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/electric-city-washington",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Electric City was established in 1934 as one of several settlements built to house workers for the future Grand Coulee Dam.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Electric_City%2C_Washington",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "President Roosevelt stopped in Electric City during his 1934 tour of the dam site, and by August that year, 500 lots had been platted.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Electric_City%2C_Washington",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "A post office opened in June 1935, followed by a school a year later, marking the town’s early growth.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Electric_City%2C_Washington",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Electric City was incorporated as a fourth‑class city on August 4, 1950, after a contested vote that the court upheld.",
      "sourceSentenceIds": [
        13,
        14
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Electric_City%2C_Washington",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "State Route 155 links Electric City southwest to the Grand Coulee Dam and the city of Grand Coulee.",
      "sourceSentenceIds": [
        16
