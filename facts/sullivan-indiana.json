  "facts": [
    {
      "id": 1,
      "text": "Founded in 1854, Sullivan grew from a farming and coal‑mining hub and was named after a local settler who helped shape the area.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://sullivanindiana.com/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "In 1925 a mine in Sullivan exploded, killing 51 of the 122 miners working underground.",
      "sourceSentenceIds": [
        14
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Sullivan%2C_Indiana",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "A second mine disaster in 1937 claimed 20 lives, adding to the town’s mining tragedy history.",
      "sourceSentenceIds": [
        15
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Sullivan%2C_Indiana",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "On March 31, 2023, an EF3 tornado tore through Sullivan, damaging more than 200 structures with winds up to 165 mph.",
      "sourceSentenceIds": [
        16,
        17,
        18
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Sullivan%2C_Indiana",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The Sullivan County Historical Museum showcases artifacts from old coal mines and 19th‑century homes, preserving the town’s rugged past.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 1"
      ],
