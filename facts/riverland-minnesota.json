  "facts": [
    {
      "id": 1,
      "text": "Riverland sits within the White Earth Indian Reservation boundaries, established in 1867 to provide a homeland for displaced Ojibwe bands.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/riverland_minnesota",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The area that became Riverland was originally part of Ojibwe territory, where the people cultivated lakes, rivers, and forests long before Europeans arrived.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/riverland_minnesota",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Mahnomen County, which includes Riverland, was carved from Norman County in 1906, and the Clapp Amendment allowed Ojibwe allotments to be sold to non‑Natives, spurring white farmer settlement.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/riverland_minnesota",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Scandinavian and German immigrants settled Riverland, planting wheat and potatoes; German homesteader Frank Schneider was among the earliest settlers.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/riverland_minnesota",
      "category": "people",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The Wild Rice River, a tributary of the Red River of the North, forms Riverland’s eastern boundary.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Riverland%2C_Minnesota",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Riverland’s ecology is shaped by nearby White Earth Reservation wetlands, forests, and lakes, creating rich biodiversity across the glacial landscape.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/riverland_minnesota",
