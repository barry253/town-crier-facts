  "facts": [
    {
      "id": 1,
      "text": "Allen Persinger platted Frederick on May 12–13, 1836, and the town was originally named Fredricksville before the U.S. Post Office shortened it in 1892.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://schuyler-ilgw.genealogyvillage.com/schuylernewhome/Towns/Fredericktwp2.html",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Frederick Township served as the gateway to Schuyler County during the town’s earliest years.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://schuyler-ilgw.genealogyvillage.com/schuylernewhome/Towns/Fredericktwp2.html",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The town became a vital steamboat landing, with Farwell & Co. building a dike to connect high land to boat land for reliable service.",
      "sourceSentenceIds": [
        19
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://schuyler-ilgw.genealogyvillage.com/schuylernewhome/Towns/Fredericktwp2.html",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Frederick sits on the Illinois River, just four miles north of Beardstown.",
      "sourceSentenceIds": [
        14
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://schuyler-ilgw.genealogyvillage.com/schuylernewhome/Towns/Fredericktwp2.html",
      "category": "other",
      "quality": "poor",
      "qualityReason": "location_description"
    },
    {
      "id": 5,
      "text": "Frederick Township is the smallest in Schuyler County, its irregular shape bounded by the Illinois River and Sugar Creek.",
      "sourceSentenceIds": [
        23
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://schuyler-ilgw.genealogyvillage.com/schuylernewhome/Towns/Fredericktwp2.html",
      "category": "other",
      "quality": "poor",
      "qualityReason": "other"
    },
    {
      "id": 6,
      "text": "James Lammy was among the first to settle permanently in Frederick Township, establishing a home near the present village in 1825.",
      "sourceSentenceIds": [
        27
      ],
      "sourceLabels": [
