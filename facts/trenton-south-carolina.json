    {
      "id": 1,
      "text": "President George Washington dined at the Piney Woods tavern in what would become Trenton during his Southern Tour in 1791.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.trentonsc.us/history/"
    },
    {
      "id": 2,
      "text": "James Monroe Wise founded Trenton in 1870 by building the town's first store and residence.",
      "sourceSentenceIds": [
        4,
        30
      ],
      "sourceLabels": [
        "Web source 2",
        "Web source 1"
      ],
      "source": "https://www.trentonsc.us/"
    },
    {
      "id": 3,
      "text": "Trenton grew from a stagecoach way-station into a railroad town after the Charlotte, Columbia, and Augusta Railroad was built through the area.",
      "sourceSentenceIds": [
        3,
        6
      ],
      "sourceLabels": [
        "Web source 2",
        "Web source 1"
      ],
      "source": "https://www.trentonsc.us/"
    },
    {
      "id": 4,
      "text": "Bettis Academy and Junior College is listed on the National Register of Historic Places for its role in African American education.",
      "sourceSentenceIds": [
        8,
        13
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.trentonsc.us/history/"
    },
    {
      "id": 5,
      "text": "Marshfield, a historic plantation house with an outbuilding and cemetery, is listed on the National Register of Historic Places in Trenton.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
