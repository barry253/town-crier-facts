  "facts": [
    {
      "id": 1,
      "text": "Shannon was named for Samuel Shannon, an early landowner who bought land from Chickasaw Chief Itawamba.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Shannon%2C_Mississippi",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town moved north when the Mobile and Ohio Railroad was built through the community in the 1850s, reshaping its layout.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Shannon%2C_Mississippi",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "In 1860 Shannon incorporated and opened a post office, marking its formal establishment as a town.",
      "sourceSentenceIds": [
        19
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Shannon%2C_Mississippi",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Coca-Cola began bottling in Shannon around 1915, making the town part of the brand's early expansion.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Shannon%2C_Mississippi",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Chiwapa Creek meanders just south of Shannon, adding a natural waterway to the town's landscape.",
      "sourceSentenceIds": [
        15
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Shannon%2C_Mississippi",
      "category": "nature",
      "quality": "good"
    },
    {
