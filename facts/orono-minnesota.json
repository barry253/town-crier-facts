  "facts": [
    {
      "id": 1,
      "text": "Orono was named by early settler Major George Brackett after his hometown of Orono, Maine.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/Orono,_Minnesota"
    },
    {
      "id": 2,
      "text": "The area was first surveyed in 1858, organized as a township on April 9 1889, and later incorporated as a city in 1955.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/Orono,_Minnesota"
    },
    {
      "id": 3,
      "text": "Orono’s zoning, first adopted in 1950 and tightened through the 1970s, protected its rural heritage and lakefront.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/Orono,_Minnesota"
    },
    {
      "id": 4,
      "text": "The 2008‑2030 Community Management Plan formalized goals to preserve Orono’s distinct urban and rural lifestyles.",
      "sourceSentenceIds": [
        11
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/Orono,_Minnesota"
    },
    {
      "id": 5,
      "text": "Orono lies about 16 miles west of Lake Minnetonka’s north shore.",
      "sourceSentenceIds": [
