  "facts": [
    {
      "id": 1,
      "text": "The Moapa Valley was first settled by Ancestral Puebloans around 300 A.D., marking the westernmost reach of the Basketmaker culture.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/Moapa_Valley,_Nevada",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Moapa Valley stretches roughly 40 miles (64 km) northwest to southeast, making it one of Nevada’s longest valleys.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Moapa_Valley%2C_Nevada",
      "category": "nature",
      "quality": "poor",
      "qualityReason": "vague"
    },
    {
      "id": 3,
      "text": "Early settlers traced the valley’s origins back to around 350 B.C., long before European arrival.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Moapa_Valley%2C_Nevada",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "An 1870 survey placed the land in Nevada, leading to a brief abandonment in 1871, but farming rebounded in the 1880s.",
      "sourceSentenceIds": [
        15
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/Moapa_Valley,_Nevada",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Devastating floods in 1938 and 1939 spurred flood‑control efforts, and the 1930s Hoover Dam project submerged historic sites like St. Thomas.",
      "sourceSentenceIds": [
        16
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/Moapa_Valley,_Nevada",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Today, Moapa Valley cultivates about 10,000 acres of row crops—radishes, onions, tomatoes, and alfalfa—while urban growth converts some farmland to residential use.",
      "sourceSentenceIds": [
