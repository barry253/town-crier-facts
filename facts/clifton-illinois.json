  "facts": [
    {
      "id": 1,
      "text": "Clifton was founded in 1857, marking the start of a small village that would grow around the railroad.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Clifton%2C_Illinois"
    },
    {
      "id": 2,
      "text": "The village takes its name from the Clifton hotel in Chicago, a popular destination for travelers in the late 1800s.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Clifton%2C_Illinois"
    },
    {
      "id": 3,
      "text": "The Clifton House, a village landmark on the far north block, burned down on January 19, 1894, after standing for decades.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.cliftonillinois.com/history"
    },
    {
      "id": 4,
      "text": "North of the former Clifton House, the vacant Standard Oil Station of 1957 once marked the original site of the Henrotin house.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.cliftonillinois.com/history"
    },
    {
      "id": 5,
      "text": "Clifton’s early economy included the Clifton Garage & Machine Shop, which sold Goodyear tires and served local farmers.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.cliftonillinois.com/history"
    },
    {
      "id": 6,
      "text": "In the south block, the Vialta Theatre once hosted community performances before closing in the mid‑20th century.",
