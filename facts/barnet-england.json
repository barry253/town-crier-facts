  "facts": [
    {
      "id": 1,
      "text": "Barnet’s elevated position earned it the nickname “High Barnet,” a name the Great Northern Railway adopted for its 1872 station.",
      "sourceSentenceIds": [
        22
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Chipping_Barnet",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The historic Great North Road once made Barnet a common resting point between London, York, and Edinburgh.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Chipping_Barnet",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "St John the Baptist Church, standing where the town centre once was, remains a landmark visible for miles.",
      "sourceSentenceIds": [
        11
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Chipping_Barnet",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Tudor Hall, built in 1577 for Queen Elizabeth I’s Free Grammar School, now houses Barnet College.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.britannica.com/place/Barnet-borough-London",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Barnet’s local history is preserved in the Barnet Museum, which showcases artifacts from the borough’s past.",
      "sourceSentenceIds": [
        13
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.barnet.gov.uk/community/arts-and-culture/history-and-heritage-barnet",
      "category": "culture",
      "quality": "good"
    },
    {
