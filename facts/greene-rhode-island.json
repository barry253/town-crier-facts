  "facts": [
    {
      "id": 1,
      "text": "Greene was named in honor of Nathanael Greene, a Rhode Island-born general who helped lead American forces during the Revolutionary War.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Greene%2C_Rhode_Island"
    },
    {
      "id": 2,
      "text": "Until 1854, the area now known as Greene was primarily a swamp with a single cart path running through it.",
      "sourceSentenceIds": [
        20
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Greene%2C_Rhode_Island"
    },
    {
      "id": 3,
      "text": "The original train stop in Greene was called Coffin Station because Coffin Road was the nearest road at the time.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Greene%2C_Rhode_Island"
    },
    {
      "id": 4,
      "text": "Greene grew into an important shipping hub for local farmers to send milk, wood, and cranberries to Providence and Hartford.",
      "sourceSentenceIds": [
        4,
        13
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Greene%2C_Rhode_Island"
    },
    {
      "id": 5,
      "text": "The Advent Christian Church established a religious campground in Greene in 1880 that drew up to ten thousand summer visitors.",
      "sourceSentenceIds": [
        5,
        14
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Greene%2C_Rhode_Island"
    },
    {
      "id": 6,
      "text": "The Coventry Greenway is a rail trail running through Greene along the route of the old New York, New Haven and Hartford Railroad.",
