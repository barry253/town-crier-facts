  "facts": [
    {
      "id": 1,
      "text": "Malta, Ohio, was founded in 1816 by ex‑sailor Simeon Pool, who named it after the Mediterranean island he once visited.",
      "sourceSentenceIds": [
        1,
        11
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Malta%2C_Ohio",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "A 19th‑century stone jail, the Morgan County Dungeon, was rediscovered in 1964, moved to Main Street, and now bears an Ohio Historical Marker.",
      "sourceSentenceIds": [
        4,
        5,
        6,
        22
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Malta%2C_Ohio",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The village hosts two National Register‑listed wooden bridges: the 1867 Helmick Mill Covered Bridge and the nearby Adams Covered Bridge.",
      "sourceSentenceIds": [
        8,
        9
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Malta%2C_Ohio",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Malta grew along the Muskingum River, which became a key trade route after locks and dams were built between 1836 and 1841.",
      "sourceSentenceIds": [
        20
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Malta%2C_Ohio",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Every July, Malta partners with McConnelsville to stage Civil War Encampment Days, complete with reenactments and cannon fire.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Malta%2C_Ohio",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Rock Hollow School, a one‑room building erected in 1877, still stands as a reminder of 19th‑century rural education.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
