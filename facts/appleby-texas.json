      "id": 1,
      "text": "Appleby was christened for James Appleby, the former auditor of the Houston, East and West Texas Railway.",
      "sourceSentenceIds": [
        6,
        1
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
