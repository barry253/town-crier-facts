      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Historic Downtown Wetaskiwin showcases restored buildings and hand‑painted murals that tell the town’s story as you stroll down Main Street.",
      "sourceSentenceIds": [
        3,
        9
      ],
      "sourceLabels": [
