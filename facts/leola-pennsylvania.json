  "facts": [
    {
      "id": 1,
      "text": "Leola's name blends Leacock and Glenola, the former train station that once served the town.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Leola%2C_Pennsylvania",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Leola emerged as a small hamlet tied to Amish tobacco farming; the Inn at Leola Village began in 1867 as farmhouses supplying Lancaster cigar factories.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/leola_pennsylvania",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Upper Leacock Township, which includes Leola, was formed in 1843 after the Columbia and Philadelphia Railroad arrived in 1834.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/leola_pennsylvania",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Salem Hellers Reformed Church, founded in 1722, was Lancaster County’s first German‑language church and still bears tombstones from 1729.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/leola_pennsylvania",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Leola sits on a low east‑west ridge that drains north into Groff Creek and south into Mill Creek.",
      "sourceSentenceIds": [
        18
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Leola%2C_Pennsylvania",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Leola’s preserved heritage sites and close proximity to Amish attractions draw visitors, supporting the town’s tourism‑driven economy.",
