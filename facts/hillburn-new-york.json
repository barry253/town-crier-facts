      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "In 1943, Thurgood Marshall and the NAACP won a desegregation case that opened Hillburn’s schools to students of color.",
      "sourceSentenceIds": [
        9,
        13
      ],
      "sourceLabels": [
        "Wikipedia",
