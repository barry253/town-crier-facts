      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Hillburn’s Brook Chapel, built in 1893, is listed on the National Register of Historic Places.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Hillburn%2C_New_York",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The African American Historical Society of Rockland County’s Historic Hillburn project documents the village’s layered Indigenous, African, and European heritage.",
