  "facts": [
    {
      "id": 1,
      "text": "Archaeological evidence shows Kwethluk has been inhabited since prehistoric times, long before European contact.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.kupi.com/en/explore/united-states/kwethluk"
    },
    {
      "id": 2,
      "text": "During the late 1800’s, four families from four different villages, banded together to form what was to become Kwethluk.",
      "sourceSentenceIds": [
        15
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://cityofkwethluk.com/about/"
    },
    {
      "id": 3,
      "text": "The constantly changing channel gives the village its name: Kwethluk is derived from the Yupik kuik, meaning 'river', plus -rrluk, meaning 'bad, unnatural'.",
      "sourceSentenceIds": [
        20
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Kwethluk%2C_Alaska"
    },
    {
      "id": 4,
      "text": "Kwethluk lies at the confluence of the Kuskokwim and Kwethluk rivers in the Yukon-Kuskokwim Delta.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Kwethluk%2C_Alaska"
    },
    {
      "id": 5,
      "text": "Nicholas Russian Orthodox Church, a beautiful white wooden structure that serves as a testament to the area’s historical influences.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.kupi.com/en/explore/united-states/kwethluk"
    },
    {
      "id": 6,
      "text": "In 1939, Kwethluk villagers collectively owned approximately 31,000 reindeer, a significant part of their subsistence economy.",
      "sourceSentenceIds": [
