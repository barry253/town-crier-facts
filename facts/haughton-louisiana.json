  "facts": [
    {
      "id": 1,
      "text": "Haughton began as a railroad town in 1884 when the Vicksburg, Shreveport & Pacific Railroad built a station there.",
      "sourceSentenceIds": [
        30
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/Haughton,_Louisiana",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "In its first year, the Haughton depot shipped about 3,000 bales of cotton, supporting six businesses, boarding houses, and sawmills.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/Haughton,_Louisiana",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "By 1885, Mary Jane had deeded 80 acres for public streets and the station, laying out the town’s early grid.",
      "sourceSentenceIds": [
        25
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/Haughton,_Louisiana",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The Haughton family migrated from Tennessee via Mississippi in 1845, settling on 2,000 acres that later became the town’s namesake.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 1"
