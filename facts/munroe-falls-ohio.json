  "facts": [
    {
      "id": 1,
      "text": "Munroe Falls was founded in 1838 when brothers William and Edmund Munroe purchased mills and 250 acres, naming the new village after themselves.",
      "sourceSentenceIds": [
        7,
        8
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Munroe_Falls%2C_Ohio",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The Pennsylvania and Ohio Canal opened on August 4, 1840 just north of the Cuyahoga River, following the path of today’s railroad tracks through Munroe Falls.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.summithistory.org/munroe-falls",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The Munroe Falls Historical Society, founded in 1976, runs a 19th‑century home museum that houses local history exhibits and a library.",
      "sourceSentenceIds": [
        4,
        2
      ],
      "sourceLabels": [
        "Web source 1",
        "Web source 2"
      ],
      "source": "https://www.munroefallshistory.com/",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Munroe Falls Town Hall, originally built in 1885 as a township school, now serves as the village’s civic center.",
      "sourceSentenceIds": [
        11
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.summithistory.org/munroe-falls",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "A stone summer kitchen built around 1817 on a historic home in Munroe Falls is listed on the National Register of Historic Places.",
