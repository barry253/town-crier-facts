  "facts": [
    {
      "id": 1,
      "text": "Jacona’s name comes from the Tewa word Sakona, the pueblo’s original name, adapted by Spanish settlers.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Jacona%2C_New_Mexico",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The pueblo of Sakonae, later Jacona, remained inhabited through the 1680 Pueblo revolt and was abandoned only after 1696.",
      "sourceSentenceIds": [
        11
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.ranchojacona.com/ourhistory",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "North of Pojoaque, pink cliffs known as the tobacco barranca once grew wild tobacco, a feature highlighted in Jacona’s logo.",
      "sourceSentenceIds": [
        15,
        16
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.ranchojacona.com/ourhistory",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "During harvest, villagers built temporary summer houses in fields to protect crops from birds, animals, and hostile humans.",
      "sourceSentenceIds": [
        18
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.ranchojacona.com/ourhistory",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "In 1702 Spain granted a large valley tract to Ignacio Roybal’s family, laying the foundation for Jacona Ranch.",
      "sourceSentenceIds": [
        19
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.ranchojacona.com/ourhistory",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The historic Ignacio Roybal House still stands east of Jacona, a mile along County 84, preserving early 18th‑century adobe.",
      "sourceSentenceIds": [
        20
      ],
      "sourceLabels": [
        "Web source 1"
      ],
