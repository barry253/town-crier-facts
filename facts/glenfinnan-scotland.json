  "facts": [
    {
      "id": 1,
      "text": "Glenfinnan is a small historic village nestled in the Scottish Highlands at the head of Loch Shiel.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://localpage.uk/glenfinnan"
    },
    {
      "id": 2,
      "text": "The village has no supermarket, petrol station, or bank, so residents travel to Fort William or Mallaig.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://localpage.uk/glenfinnan"
    },
    {
      "id": 3,
      "text": "The 18‑metre Glenfinnan Monument, a column topped by a kilted Highlander, commemorates the 1745 Jacobite rising.",
      "sourceSentenceIds": [
        8,
        9
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Glenfinnan"
    },
    {
      "id": 4,
      "text": "The Glenfinnan Viaduct, a 380‑metre concrete bridge built 1897–1901, carries the Jacobite steam train that crosses it each spring through autumn.",
      "sourceSentenceIds": [
        4,
        20
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://visitwesthighlands.co.uk/travel-guides/lochaber/glenfinnan/"
    },
    {
      "id": 5,
      "text": "The Jacobite steam train, once a link between Glasgow and the West Coast fishing ports, now runs seasonally as a tourist attraction.",
      "sourceSentenceIds": [
        12,
        17
      ],
      "sourceLabels": [
        "Web source 1",
        "Wikipedia"
      ],
      "source": "https://localpage.uk/glenfinnan"
    },
    {
      "id": 6,
      "text": "In 1745, Prince Charles Edward Stuart raised his standard on the hill near Glenfinnan, marking the start of the Jacobite rising.",
      "sourceSentenceIds": [
        23,
        27
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Glenfinnan"
    }
  ],
