    {
      "id": 1,
      "text": "Stansberry Lake lies within the Puget Sound region of western Washington, about fifteen miles southwest of Tacoma.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/stansberry_lake_washington"
    },
    {
      "id": 2,
      "text": "The terrain around Stansberry Lake consists of gently rolling hills shaped by ancient glacial deposits like drumlins and moraines.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/stansberry_lake_washington"
    },
    {
      "id": 3,
      "text": "Stansberry Lake is sustained by inflows from local streams and direct rainfall, forming part of the Minter Creek sub-basin.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/stansberry_lake_washington"
    },
    {
      "id": 4,
      "text": "Regional drainage from Stansberry Lake ultimately flows into the Carr Inlet of the Puget Sound.",
      "sourceSentenceIds": [
        13
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/stansberry_lake_washington"
    },
    {
      "id": 5,
      "text": "Stansberry Lake offers a quiet lakeside setting that is well known for local recreation such as fishing.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/stansberry_lake_washington"
    },
    {
