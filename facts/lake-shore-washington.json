      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Parker’s Landing Historical Park offers walking paths and gardens that preserve the memory of Lake Shore’s pioneer era.",
      "sourceSentenceIds": [
        5,
