  "facts": [
    {
      "id": 1,
      "text": "Alcove is a hamlet in the town of Coeymans, Albany County, New York.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Alcove%2C_New_York",
      "category": "other",
      "quality": "poor",
      "qualityReason": "vague"
    },
    {
      "id": 2,
      "text": "The hamlet grew around mills on Hannacroix Creek, where Ephraim Andrews founded the Valley Mill in 1844 and it later became a straw‑paper factory.",
      "sourceSentenceIds": [
        12,
        13,
        14
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Alcove%2C_New_York",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "After a 1892 fire left only a 110‑foot chimney, that stone tower now stands on the National Register of Historic Places.",
      "sourceSentenceIds": [
        18,
        19
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Alcove%2C_New_York",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The Alcove Preservation Association is restoring that chimney into a pocket park and interpretive historical center.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Alcove%2C_New_York",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Casperus Ackerman built the first mill in the area in 1790, long before the hamlet adopted the name Alcove.",
      "sourceSentenceIds": [
        11
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Alcove%2C_New_York",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Alcove’s historic district spans 140 acres and features houses faced with locally quarried bluestone.",
      "sourceSentenceIds": [
        25,
