      "id": 1,
      "text": "Granger is located near the confluence of the Blacks Fork and Hams Fork rivers in Sweetwater County, Wyoming.",
      "sourceSentenceIds": [
        3,
        11
      ],
      "sourceLabels": [
        "Wikipedia"
