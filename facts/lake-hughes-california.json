  "facts": [
    {
      "id": 1,
      "text": "Lake Hughes was named for Judge Griffith (Patrick) Hughes, who homesteaded the area around the turn of the 20th century.",
      "sourceSentenceIds": [
        1,
        4,
        20
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1",
        "Web source 2"
      ],
      "source": "https://en.wikipedia.org/wiki/Lake_Hughes%2C_California"
    },
    {
      "id": 2,
      "text": "The community was once called West Elizabeth Lake and served mainly for farming and cattle grazing until the early 20th century.",
      "sourceSentenceIds": [
        9,
        20
      ],
      "sourceLabels": [
        "Web source 1",
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/Lake_Hughes,_California"
    },
    {
      "id": 3,
      "text": "From 1858 to 1861, Lake Hughes sat on the Butterfield Overland Mail route between Widow Smith's Station and Mud Spring stage stops.",
      "sourceSentenceIds": [
        12,
        17
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 2"
      ],
      "source": "https://en.wikipedia.org/wiki/Lake_Hughes%2C_California"
    },
    {
      "id": 4,
      "text": "In 1907 William Mulholland began work on the Elizabeth Lake Tunnel, a 5‑mile passage that now lies 285 feet beneath the valley floor.",
      "sourceSentenceIds": [
        25,
        26
      ],
      "sourceLabels": [
        "Wikipedia",
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Lake_Hughes%2C_California"
    },
    {
      "id": 5,
      "text": "The tunnel was bored from both ends, meeting in the center within 1½ inches of alignment after 27,000 feet of solid rock.",
      "sourceSentenceIds": [
        27,
        29,
        30
      ],
      "sourceLabels": [
        "Wikipedia",
        "Wikipedia",
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Lake_Hughes%2C_California"
    },
    {
      "id": 6,
      "text": "The historic Frakes homestead of Samuel H. was incorporated into an 8,400‑square‑foot clubhouse that still stands near the lake.",
