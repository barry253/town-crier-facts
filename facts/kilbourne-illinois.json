  "facts": [
    {
      "id": 1,
      "text": "Kilbourne was named after Edward Kilbourne, a contractor who built railroad sections through the area in the late 1860s.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/kilbourne_illinois",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Pioneers such as the Fields, Garretts, and Rays arrived, drawn by wildlife and fertile prairies; by 1845 the area had schools, churches, and barter commerce.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/kilbourne_illinois",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The village grew from James Blakeley's 1836 cabin into a Baptist‑influenced community that met Civil War troop quotas early and survived prairie fires and an 1845 hailstorm.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/kilbourne_illinois",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Early settlers in the 1830s, after 1821–25 surveys, included Jesse Baker, who by 1833 produced 90 bushels per acre, one of the first farms.",
