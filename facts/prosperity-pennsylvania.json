      "id": 1,
      "text": "Prosperity got its name when founder Robert Wallace, after a failed Wallaceton idea, chose the hopeful title to signal expected growth.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 1"
      ],
