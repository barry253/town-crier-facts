      "category": "economy",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The Podlaskie Museum in Białystok preserves regional history and operates branches in Bielsk, Choroszcz, Supraśl, Tykocin and Turośń.",
      "sourceSentenceIds": [
        15
      ],
      "sourceLabels": [
