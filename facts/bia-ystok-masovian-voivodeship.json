      ],
      "source": "https://www.staypoland.com/about_bialystok.htm/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "By 1863 Białystok boasted 230 textile factories employing roughly 3,000 workers in the heart of Poland's industrial boom.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Web source 1"
      ],
