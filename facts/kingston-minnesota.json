  "facts": [
    {
      "id": 1,
      "text": "Kingston was named after Kingston, Ontario, the hometown of surveyor J.B., who mapped the area in 1855.",
      "sourceSentenceIds": [
        1,
        2
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.meekercomuseum.org/kingston-township"
    },
    {
      "id": 2,
      "text": "Early settlers in Kingston came from England via Maine and from Finland, turning the area into a trading post with Native Americans before the town was platted.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://wjon.com/kingston-history-minnesota/"
    },
    {
      "id": 3,
      "text": "In 1885, Meeker County built the Salisbury Bridge over the Crow River, but without safe approaches it was rarely used.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.meekercomuseum.org/kingston-township"
    },
    {
      "id": 4,
      "text": "Kingston boasted a thriving town baseball team that folded in the early 1970s when the local school closed.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://wjon.com/kingston-history-minnesota/"
    },
    {
      "id": 5,
      "text": "The town’s early religious life centered on Lutheranism, with three Finnish Lutheran churches and a Presbyterian congregation at one time.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://wjon.com/kingston-history-minnesota/"
    },
    {
      "id": 6,
      "text": "The Kingston American Legion was founded in 1963, and it once hosted Minnesota Twins star Tony Oliva for a speech.",
      "sourceSentenceIds": [
        30
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://wjon.com/kingston-history-minnesota/"
    }
  ]
