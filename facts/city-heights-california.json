  "facts": [
    {
      "id": 1,
      "text": "City Heights got its name in 1910 when a real estate agent split the former Sylvan area into ten‑acre lots and called it Citrus Heights.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Citrus_Heights%2C_California",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "In the 1880s Abraham Klauber and Samuel Steiner bought over 240 acres northeast of Balboa Park, hoping to develop the high‑land area that would become City Heights.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://cityheightssd.com/history/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Citrus Heights voters approved incorporation on November 5, 1996, with 62.5% of the vote, making the city official January 1, 1997.",
      "sourceSentenceIds": [
        11,
        12
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Citrus_Heights%2C_California",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The city enjoys mild winters and dry, hotter summers, with average highs reaching 93°F in July and lows around 38°F in winter.",
      "sourceSentenceIds": [
        13
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Citrus_Heights%2C_California",
      "category": "other",
      "quality": "poor",
      "qualityReason": "vague"
    },
    {
      "id": 5,
      "text": "Year‑long average temperature hovers around 68°F, dipping to 45°F in December and January and climbing to 76°F in July.",
      "sourceSentenceIds": [
        14
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Citrus_Heights%2C_California",
      "category": "other",
      "quality": "poor",
      "qualityReason": "vague"
    },
    {
      "id": 6,
      "text": "Citrus Heights records about 268 sunny days a year, making it one of the sunniest spots in the Sacramento region.",
      "sourceSentenceIds": [
        21
      ],
      "sourceLabels": [
