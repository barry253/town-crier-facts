  "facts": [
    {
      "id": 1,
      "text": "Blue Hill was incorporated on Jan 30, 1789, named after its commanding summit overlooking the region.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Blue_Hill%2C_Maine",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town's first settlement, Plantation Number 5, began in 1762 when Captain Joseph Wood and John Roundy built homes on Mill Island at the tidal falls.",
      "sourceSentenceIds": [
        18
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Blue_Hill%2C_Maine",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "By 1859, Blue Hill shipped 5,000 cords of firewood annually from its port, reflecting its role in the lumber trade.",
      "sourceSentenceIds": [
        22
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Blue_Hill%2C_Maine",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "In 1869, the reversing falls were described as “a tidewater power probably unsurpassed in the state of Maine,” a testament to the town’s natural energy resources.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://bluehillme.gov/about/town-history-in-brief/",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Blue Hill’s granite was used in iconic structures such as the Brooklyn Bridge and the New York Stock Exchange Building.",
      "sourceSentenceIds": [
        25
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Blue_Hill%2C_Maine",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The town hosts an annual Blue Hill Fair, a long‑standing tradition celebrating local culture.",
      "sourceSentenceIds": [
        16
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
