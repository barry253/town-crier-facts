      ],
      "source": "https://grokipedia.com/page/lotus_california",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "During the Gold Rush, Lotus was a key supply point and toll bridge crossing for miners traveling to upstream diggings.",
      "sourceSentenceIds": [
        9,
        10
      ],
      "sourceLabels": [
        "Web source 1",
