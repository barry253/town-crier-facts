  "facts": [
    {
      "id": 1,
      "text": "Castellana originated in 1833 as Paseo de las Delicias de Isabel II, later known as Paseo de la Fuente Castellana.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Wikipedia"
