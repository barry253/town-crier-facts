  "facts": [
    {
      "id": 1,
      "text": "Malott sits on the western bank of the Okanogan River, where a historic bridge once connected travelers across the water.",
      "sourceSentenceIds": [
        29
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Malott%2C_Washington",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Fort Okanogan, founded in 1811 by the Pacific Fur Company, once stood at the confluence of the Okanogan and Columbia Rivers as a key trading post.",
      "sourceSentenceIds": [
        10,
        11
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://beckdc.com/historical-places-in-malott/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The Old Molson Ghost Town, part of the Old Molson Historic Site, preserves abandoned buildings that echo the lives of early settlers.",
      "sourceSentenceIds": [
        20,
        21
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://beckdc.com/historical-places-in-malott/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The Methow Rapids U‑Bolt Historical Marker in Malott commemorates a dramatic 1938 flood that destroyed much of the town after a dam burst on Loop Creek.",
      "sourceSentenceIds": [
        5,
        9
      ],
      "sourceLabels": [
        "Web source 1",
        "Wikipedia"
      ],
      "source": "https://beckdc.com/historical-places-in-malott/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Malott’s Okanogan County Historical Museum showcases artifacts from Native American settlements, pioneer homesteads, and early twentieth‑century buildings.",
      "sourceSentenceIds": [
        6,
        13
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://beckdc.com/historical-places-in-malott/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The Chillowist Trail Historic Marker honors a trail that once linked communities and facilitated cultural exchange among indigenous peoples.",
