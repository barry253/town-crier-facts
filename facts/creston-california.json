  "facts": [
    {
      "id": 1,
      "text": "Creston was founded in March 1884 by four pioneers who purchased the 40,000‑acre Rancho Huer Huero land grant.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://crestonnews.org/creston-history",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town’s name honors early settler Calvin J. Cressy, whose ranch gave the area its original name, Huer Huero.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Creston%2C_California",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Creston began as a stagecoach stop on the Los Angeles–San Francisco route, a fact that still echoes in its historic buildings.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://ideadailynews.com/discovering-creston-california-a-hidden-gem-in-the-golden-state/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The Creston Post Office opened in 1885, and the Community Church followed in 1886, both still standing as local landmarks.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://crestonnews.org/creston-history",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Creston Elementary School’s bell has rung the same tune since 1889, a tradition cherished by generations of residents.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://crestonnews.org/creston-history",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The town’s early economy featured three saloons, two restaurants, livery stables, blacksmith shops, a bakery, and a jail, reflecting its frontier spirit.",
      "sourceSentenceIds": [
        2
      ],
