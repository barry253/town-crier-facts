  "facts": [
    {
      "id": 1,
      "text": "Roma Norte began as an upper‑class Porfirian neighborhood in the early 1900s, drawing wealthy families from the historic center.",
      "sourceSentenceIds": [
        2,
        13
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Colonia_Roma",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The area hosts about 1,100 mansions and historic buildings, most built between 1906 and 1939, many now repurposed as cafés and galleries.",
      "sourceSentenceIds": [
        4,
        14,
        18
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1",
        "Web source 2"
      ],
      "source": "https://en.wikipedia.org/wiki/Colonia_Roma",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Plaza Río de Janeiro, once called Plaza Roma, sits at the heart of the neighborhood and is surrounded by the Fuente de Cibeles fountain.",
      "sourceSentenceIds": [
        3,
        6
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Colonia_Roma",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The Universidad de las Américas de la Ciudad de México, founded in 1940, occupies a landmark building that once housed the London University.",
      "sourceSentenceIds": [
        1,
        16
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Colonia_Roma",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Insurgentes and Sevilla metro stations border Roma Norte, while Ecobici bike‑share stations pepper the streets, making the area highly walkable.",
      "sourceSentenceIds": [
        24,
        26
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 2"
      ],
      "source": "https://en.wikipedia.org/wiki/Colonia_Roma",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Roma Norte’s circular park features a replica of Michelangelo’s David, a quirky reminder of the neighborhood’s artistic heritage.",
      "sourceSentenceIds": [
        12
      ],
