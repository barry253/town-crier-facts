  "facts": [
    {
      "id": 1,
      "text": "New Bremen was founded by German immigrants in 1833 and named after the German city of Bremen.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/New_Bremen%2C_Ohio",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The New Bremen Historic Association, founded in 1973, runs two museums that preserve the village’s canal and bicycle history.",
      "sourceSentenceIds": [
        1,
        5,
        20
      ],
      "sourceLabels": [
        "Web source 1",
        "Web source 2"
      ],
      "source": "https://newbremen.com/historical-sites-museums/",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The village’s historic Lockkeepers House is one of the oldest existing houses and now serves as a museum showcasing canal artifacts.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://newbremen.com/historical-sites-museums/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The “Bowstring” bridge, a cast‑and‑wrought‑iron truss bridge, once carried traffic over the Miami‑Erie Canal and now stands as a rare example of 19th‑century engineering.",
      "sourceSentenceIds": [
        15
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://newbremen.com/historical-sites-museums/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "New Bremen’s Bicycle Museum of America celebrates the town’s long‑standing connection to cycling, featuring a collection of vintage bicycles and racing memorabilia.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://newbremen.com/historical-sites-museums/",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The village’s canal history is highlighted in the “Journey through Time” exhibit, which traces New Bremen’s rise as a canal town to its modern rebirth.",
      "sourceSentenceIds": [
        26
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://newbremenhistory.org/en/",
      "category": "history",
      "quality": "good"
    }
