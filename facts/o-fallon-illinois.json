  "facts": [
    {
      "id": 1,
      "text": "O'Fallon started as O'Fallon Station, a railroad depot on the O&M line named after its president, Col. John O'Fallon.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.ofallonhistory.net/homepage2.html"
    },
    {
      "id": 2,
      "text": "Founded in 1854, the town was named for Colonel John O'Fallon, a wealthy St. Louis businessman.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/O'Fallon%2C_Illinois"
    },
    {
      "id": 3,
      "text": "In 1827, John Mason Peck established Illinois’ first college, Rock Spring Seminary, in what is now O'Fallon.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.ofallonhistory.net/homepage2.html"
    },
    {
      "id": 4,
      "text": "Scott Air Force Base, founded in 1917, fueled O'Fallon's growth, and the later I‑64 turned the town into a commercial center.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.ofallonhistory.net/homepage2.html"
    },
    {
      "id": 5,
      "text": "The O'Fallon Historical Society Museum, opened in 1988, occupies the 1904 First National Bank building and showcases local heritage.",
      "sourceSentenceIds": [
        1,
        13,
        22
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.ofallonhistory.net/homepage2.html"
    },
    {
      "id": 6,
      "text": "Actor William Holden and illustrator Bernie Fuchs, both born in O'Fallon, are honored in permanent exhibits at the museum.",
      "sourceSentenceIds": [
        11,
        12
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.ofallonhistory.net/homepage2.html"
    }
  ]
