  "facts": [
    {
      "id": 1,
      "text": "Calumet was founded by the Calumet Coke Company in 1888 as a housing site for its workers.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Calumet%2C_Pennsylvania",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town originally had twenty double houses, twelve single-family houses, and a few commercial and industrial buildings.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Calumet%2C_Pennsylvania",
      "category": "other",
      "quality": "poor",
      "qualityReason": "vague"
    },
    {
      "id": 3,
      "text": "Calumet’s downtown was granted National Historic Landmark status in 1989 after a survey began in the 1960s.",
      "sourceSentenceIds": [
        1,
        2
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://ruralinsights.org/content/keweenaw-national-historical-park-and-calumet-what-you-see-is-what-you-get/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The Calumet Coke Works ceased operation by the time the town was abandoned.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Calumet%2C_Pennsylvania",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The Southwest Branch of the Pennsylvania Railroad once served the community, linking it to regional coal transport.",
      "sourceSentenceIds": [
        7
