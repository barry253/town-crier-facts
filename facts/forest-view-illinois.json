  "facts": [
    {
      "id": 1,
      "text": "Forest View was founded in 1924 as a haven for World War I veterans, conceived by attorney Joseph Nosek.",
      "sourceSentenceIds": [
        3,
        7
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://forestview-il.org/municipal-services/history/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The village’s name comes from the forest preserves and flowered prairies visible west of the new town across Harlem Avenue.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://forestview-il.org/municipal-services/history/",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "A massive Commonwealth Edison power plant built in 1949 between Oak Park and Ridgeland Avenues spurred Forest View’s growth from 50 homes to over 250.",
      "sourceSentenceIds": [
        29
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://forestview-il.org/municipal-services/history/",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The village’s industrial corridor along I‑55 and the 47th‑Street trucking hub make it a key node for freight, drawing about 70,000 people daily.",
      "sourceSentenceIds": [
        23,
        24
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://forestview-il.org/municipal-services/history/",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Forest View’s only known U.S. village once governed exclusively by ex‑servicemen, a unique legacy of its veteran founders.",
      "sourceSentenceIds": [
