      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "In the early 1900s, dairy farmers drove wagons to Clinton Corners’ creamery, loading milk onto the Poughkeepsie and Eastern Railway.",
      "sourceSentenceIds": [
        28
      ],
      "sourceLabels": [
        "Wikipedia"
