  "facts": [
    {
      "id": 1,
      "text": "Leisenring is an unincorporated community in Dunbar Township, Fayette County, Pennsylvania, United States, about 3 miles west‑southwest of Connellsville.",
      "sourceSentenceIds": [
        1,
        2,
        13,
        14
      ],
      "sourceLabels": [
        "Web source 1",
        "Wikipedia"
      ],
      "source": "https://grokipedia.com/page/leisenring_pennsylvania",
      "category": "other",
      "quality": "poor",
      "qualityReason": "location_description"
    },
    {
      "id": 2,
      "text": "The town grew around the Leisenring No. 2 coke works, built in 1882 by the Connellsville Coke and Iron Company, and operated until 1955.",
      "sourceSentenceIds": [
        21,
        23,
        27
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/leisenring_pennsylvania",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Beehive coke ovens—502 in number—lined Bute Road and surrounding hillsides, forming a distinctive industrial landscape that still marks the area.",
      "sourceSentenceIds": [
        24
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/leisenring_pennsylvania",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The Pittsburgh coal seam under Leisenring, part of the Conemaugh Group, lies 200–400 feet below surface and fueled the town’s mining boom.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/leisenring_pennsylvania",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "After mining ended, reclamation buried most ovens by the early 21st century, leaving only foundations and a large refuse pile as relics.",
      "sourceSentenceIds": [
        29
      ],
      "sourceLabels": [
