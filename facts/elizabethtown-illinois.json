    },
    {
      "id": 2,
      "text": "The Rose Hotel, once the oldest continuously run hotel in Illinois, closed in the 1960s and is now a state historic site.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Elizabethtown%2C_Illinois"
    },
    {
      "id": 3,
      "text": "The First Baptist Church of Elizabethtown, founded in 1806, is the oldest Baptist congregation and the oldest known Protestant church in Illinois.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Wikipedia"
