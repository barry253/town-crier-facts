      "quality": "good"
    },
    {
      "id": 3,
      "text": "The average flow of 470 cubic feet of water per second makes Big Spring the second‑largest tributary of the Current River.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Big_Spring_(Missouri)",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The spring’s aqua‑blue water churns out whitecaps before calming into a crystal‑clear channel that joins the river after about 1,000 feet.",
