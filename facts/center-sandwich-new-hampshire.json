  "facts": [
    {
      "id": 1,
      "text": "Center Sandwich began as site of early gristmill erected 1768 by Daniel Beede, followed by sawmill 1780 on Red Hill River.",
      "sourceSentenceIds": [
        13
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Center_Sandwich%2C_New_Hampshire"
    },
    {
      "id": 2,
      "text": "The oldest surviving building is the 1792 Baptist church, originally Federal style, later Greek Revival features.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Center_Sandwich%2C_New_Hampshire"
    },
    {
      "id": 3,
      "text": "The village center and surrounding area are listed on the National Register as the Center Sandwich Historic District.",
      "sourceSentenceIds": [
        11
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Center_Sandwich%2C_New_Hampshire"
    },
    {
      "id": 4,
      "text": "The Sandwich Fair, a community celebration, is held annually in early October.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Center_Sandwich%2C_New_Hampshire"
    },
    {
      "id": 5,
      "text": "The Sandwich Historical Society’s mission is to collect and preserve the town’s material culture and share it through educational outreach.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.sandwichhistorical.org/"
    },
    {
      "id": 6,
      "text": "After the Civil War, Center Sandwich declined in importance because no railroads were built to serve the area.",
