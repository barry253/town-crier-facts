  "facts": [
    {
      "id": 1,
      "text": "Agua Fria Village lies on historic Camino Real, served as rest stop for travelers on last stretch from Mexico City to Santa Fe.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://historyinsantafe.com/santa-fes-agua-fria-village/"
    },
    {
      "id": 2,
      "text": "The village’s name comes from Tewa “cold water place” and Spanish “Agua Fría,” referencing the cold springs of the Santa Fe River.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.taosnews.com/magazines/land-water-people-time/agua-fr-a/article_e8cb457e-a4e7-5066-9db2-c57925ded1ad.html"
    },
    {
      "id": 3,
      "text": "In 1835, residents founded their own mission because attending church elsewhere was difficult, reflecting strong faith in Agua Fria.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Agua_Fria%2C_New_Mexico"
    },
    {
      "id": 4,
      "text": "Agua Fria Village received “Traditional Historic Community” status in 1995, protecting it from municipal annexation under state law.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Agua_Fria%2C_New_Mexico"
    },
    {
      "id": 5,
      "text": "The first historic reference to Agua Fria dates to 1776 by Fray Francisco Atanasio Domínguez, who called it Quemado after a burned pueblo.",
      "sourceSentenceIds": [
        10
      ],
