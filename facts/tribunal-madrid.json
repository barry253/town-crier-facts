  "facts": [
    {
      "id": 1,
      "text": "Tribunal station opened on 17 October 1919, one of the first eight stops on Madrid’s metro network.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Tribunal_(Madrid_Metro)",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The station was originally called Hospicio, named after the nearby Real Hospicio de San Fernando on Calle Fuencarral.",
      "sourceSentenceIds": [
        2,
        11
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Tribunal_(Madrid_Metro)",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Line 10 platforms opened on 18 December 1981 as part of the former FEVE suburban railway between Carabanchel and Chamartín de la Rosa.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Tribunal_(Madrid_Metro)",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Today Tribunal serves both Line 1 and Line 10, linking the city’s historic center with its northern suburbs.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Tribunal_(Madrid_Metro)",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The station’s entrance is located on Calle Fuencarral, a street that once hosted Madrid’s first public hospital.",
