  "facts": [
    {
      "id": 1,
      "text": "Charlotteville was first settled in the 1790s as part of early farming communities in the Schoharie Valley.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/charlotteville_new_york",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The hamlet sits at about 1,604 feet, giving it a cooler climate and scenic ridges of sandstone and limestone.",
      "sourceSentenceIds": [
        19,
        18
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/charlotteville_new_york",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Charlotteville hosts the Bute‑Warner‑Truax Farm, a National Register of Historic Places site built in the 19th century.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Charlotteville%2C_New_York",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Robinson’s Hotel (built 1853) and the nearby Ryders/Summit Rest Hotel (c.1850) made Charlotteville a summer resort for travelers.",
      "sourceSentenceIds": [
        12,
        13
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/charlotteville_new_york",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The New York Conference Seminary, founded in 1850 by the Methodist Episcopal Church, turned Charlotteville into a regional educational hub.",
      "sourceSentenceIds": [
        27
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/charlotteville_new_york",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Charlotteville lies near the headwaters of Charlotte Creek, part of the Susquehanna River watershed.",
