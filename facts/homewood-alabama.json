      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Homewood%2C_Alabama",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "In 1960, the Jack's Family Restaurants chain was founded right here in Homewood, becoming a regional favorite.",
      "sourceSentenceIds": [
