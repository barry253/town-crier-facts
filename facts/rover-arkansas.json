  "facts": [
    {
      "id": 1,
      "text": "Rover sits in the Arkansas River Valley, surrounded by rolling hills, forested uplands, and the Fourche La Fave River that shapes its low ridges.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/rover_arkansas"
    },
    {
      "id": 2,
      "text": "Established with a post office in 1854, Rover grew as part of the nineteenth‑century expansion into Arkansas's river valleys.",
      "sourceSentenceIds": [
        13
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/rover_arkansas"
    },
    {
      "id": 3,
      "text": "The late‑nineteenth and early‑twentieth‑century timber boom brought lumber companies and rail lines, spurring Rover's growth.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/rover_arkansas"
    },
    {
      "id": 4,
      "text": "Rover experiences a humid subtropical climate, with July highs averaging 93°F and January lows around 32°F.",
      "sourceSentenceIds": [
        19,
        20,
        21
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/rover_arkansas"
    },
    {
      "id": 5,
      "text": "The area receives about 50 inches of rain annually, peaking in May with nearly 5 inches of showers.",
      "sourceSentenceIds": [
        23
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/rover_arkansas"
    },
    {
      "id": 6,
      "text": "Oak‑hickory forests dominate, supporting white‑tailed deer, wild turkey, and colorful cardinals that thrive in the valley.",
