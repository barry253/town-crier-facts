  "facts": [
    {
      "id": 1,
      "text": "Cooksville began as “Kochsville” on December 4 1882, founded by real‑estate dealer Frederick Wilhelm Koch, and the name changed to Cooksville within a year.",
      "sourceSentenceIds": [
        14,
        15,
        16
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Cooksville%2C_Illinois",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The original town was laid out as a rectangle north of the railroad, with the southern blocks slightly truncated because the tracks ran diagonally.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Cooksville%2C_Illinois",
      "category": "landmark",
      "quality": "poor",
      "qualityReason": "vague"
    },
    {
      "id": 3,
      "text": "The Illinois Central’s Bloomer Line, which once served Cooksville, was later absorbed by Illinois Central and sometimes called the Bloomer Line.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Cooksville%2C_Illinois",
      "category": "transport",
      "quality": "poor",
      "qualityReason": "route_only"
    },
    {
      "id": 4,
      "text": "Cooksville lies 18 miles east‑northeast of Bloomington, in eastern McLean County, and sits within the Mackinaw River watershed.",
      "sourceSentenceIds": [
        28,
        30
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Cooksville%2C_Illinois",
