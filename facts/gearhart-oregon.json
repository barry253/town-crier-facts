  "facts": [
    {
      "id": 1,
      "text": "Gearhart is named for Phillip Gearhart, who traveled from Missouri with his family and arrived in Oregon City in 1848.",
      "sourceSentenceIds": [
        2,
        6
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Gearhart%2C_Oregon"
    },
    {
      "id": 2,
      "text": "Phillip Gearhart established a six hundred forty acre donation land claim in the south Plains after buying squatter's rights in 1851.",
      "sourceSentenceIds": [
        13,
        14
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Gearhart%2C_Oregon"
    },
    {
      "id": 3,
      "text": "The original land holdings of Phillip Gearhart encompassed all of present day Gearhart and a portion of Seaside.",
      "sourceSentenceIds": [
        17
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Gearhart%2C_Oregon"
    },
    {
      "id": 4,
      "text": "Phillip Gearhart built a family home and farm near a grist mill by Mill Creek in a sheltered area.",
      "sourceSentenceIds": [
        18
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Gearhart%2C_Oregon"
    },
    {
      "id": 5,
      "text": "A railroad built in 1889 between Astoria and Seaside helped Gearhart draw attention as a pleasant landscape for picnicking.",
      "sourceSentenceIds": [
        4,
        7,
        20
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Gearhart%2C_Oregon"
    },
    {
      "id": 6,
      "text": "Early settlers were attracted to the Ridge Path through the dune meadows of the Phillip Gearhart land claim.",
      "sourceSentenceIds": [
        21
      ],
      "sourceLabels": [
