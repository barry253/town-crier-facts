  "facts": [
    {
      "id": 1,
      "text": "Budafok, literally “Buda cape,” was known as Promontor until 1886, reflecting its headland position on the Danube.",
      "sourceSentenceIds": [
        6,
        10
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Budafok",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The village’s limestone plateau hosts Europe’s longest wine‑cellar network, 25 km underground, earning Budafok the nickname “Cellar Town.”.",
      "sourceSentenceIds": [
        13,
        14,
        15
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Budafok",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "In 1899, Budafok became the first Hungarian suburb electrified by the East‑Hungarian Power Supply Company.",
      "sourceSentenceIds": [
        18,
        19
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Budafok",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The Tétényi Plateau’s dolomite and limestone karst, plus loess soil, made Budafok a historic center for wine and champagne production.",
      "sourceSentenceIds": [
        26,
        3,
        8
      ],
      "sourceLabels": [
        "Web source 1",
        "Wikipedia"
      ],
      "source": "https://www.budapest.com/en/locations/budafok",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The Törley Champagne Factory Museum, once a leading champagne producer, now showcases Budafok’s winemaking heritage.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Budafok",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Prince Eugene of Savoy built a palace amid the vineyards, linking Budafok’s aristocratic past to its wine culture.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Budafok",
