  "facts": [
    {
      "id": 1,
      "text": "Cherry Valley’s first permanent settler was Joseph Griggs, who moved to the north bank of the Kishwaukee River in 1835.",
      "sourceSentenceIds": [
        27
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Cherry_Valley%2C_Illinois"
    },
    {
      "id": 2,
      "text": "The village was officially incorporated on January 31, 1857, after years as an unincorporated trade hub.",
      "sourceSentenceIds": [
        28
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Cherry_Valley%2C_Illinois"
    },
    {
      "id": 3,
      "text": "A mill on the Kishwaukee River and the arrival of the railroad in 1852 marked Cherry Valley’s early landmark events.",
      "sourceSentenceIds": [
        1,
        2
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 2"
      ],
      "source": "https://en.wikipedia.org/wiki/Cherry_Valley%2C_Illinois"
    },
    {
      "id": 4,
      "text": "The core of Cherry Valley sits just north of where the north and south branches of the Kishwaukee River meet.",
      "sourceSentenceIds": [
        5,
        8
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 2"
      ],
      "source": "https://en.wikipedia.org/wiki/Cherry_Valley%2C_Illinois"
    },
    {
      "id": 5,
      "text": "Cherry Valley Elementary serves grades 3‑5, while younger students attend White Swan Elementary outside the village center.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://en-academic.com/dic.nsf/enwiki/70795"
    },
    {
      "id": 6,
      "text": "Though close to Rockford, Cherry Valley remained outside the Rockford community for most of its history.",
