  "facts": [
    {
      "id": 1,
      "text": "Tijeras Pueblo Archaeological Site was occupied by Ancestral Puebloans from about 1313 to 1425 CE.",
      "sourceSentenceIds": [
        17
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Tijeras%2C_New_Mexico",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Tijeras lies in a canyon that served as a natural corridor between Great Plains nomads and Spanish Rio Grande settlements.",
      "sourceSentenceIds": [
        22
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Tijeras%2C_New_Mexico",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The Carnuel land grant, created in 1763, was designed to defend Albuquerque from Comanche, Kiowa, and Apache raids.",
      "sourceSentenceIds": [
        21
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Tijeras%2C_New_Mexico",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Apache harassment forced the settlement’s abandonment in 1771, after Governor Pedro Fermin de Medinueta annulled the grant and ordered structures destroyed.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.tijerasnm.gov/our-heritage/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The Santo Nino Church, built around 1912, is listed on both New Mexico’s State Register of Cultural Properties and the National Register of Historic Places.",
      "sourceSentenceIds": [
        9,
        10
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.tijerasnm.gov/our-heritage/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The Mescalero Apache called Tijeras Canyon Nakai'e Naagishuł, meaning “Mexican they dragged.”.",
      "sourceSentenceIds": [
