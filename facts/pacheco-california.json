  "facts": [
    {
      "id": 1,
      "text": "Pacheco takes its name from Salvio Pacheco, a Californio ranchero who owned the nearby Rancho Monte del Diablo.",
      "sourceSentenceIds": [
        3,
        4
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://kids.kiddle.co/Pacheco,_California"
    },
    {
      "id": 2,
      "text": "During the 1850s to 1870s, Pacheco served as Contra Costa County’s commercial hub, with warehouses and a flour mill along Pacheco Slough.",
      "sourceSentenceIds": [
        12,
        14,
        16
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Pacheco%2C_California"
    },
    {
      "id": 3,
      "text": "Pacheco Slough was deep enough to receive ocean-based shipping, making the town a key port for grain from nearby valleys.",
      "sourceSentenceIds": [
        13
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Pacheco%2C_California"
    },
    {
      "id": 4,
      "text": "A post office operated in Pacheco from 1859 to 1913 and has been in service again since 1955.",
      "sourceSentenceIds": [
        11
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Pacheco%2C_California"
    },
    {
      "id": 5,
      "text": "The town’s Walnut Creek, once called Pacheco Creek, once flowed deep and free into Suisun Bay.",
      "sourceSentenceIds": [
        15
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Pacheco%2C_California"
    },
    {
      "id": 6,
      "text": "In September 2011, Martinez reached a tax‑sharing deal that paved the way for a proposed annexation of Pacheco.",
