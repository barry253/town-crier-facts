  "facts": [
    {
      "id": 1,
      "text": "Tarentum was founded in 1829 by Judge Henry Marie Brackenridge after the Pennsylvania Canal opened.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://tarentumboro.com/information/about"
    },
    {
      "id": 2,
      "text": "The borough’s name comes from the ancient Greek city-state Tarentum, chosen by Brackenridge when he surveyed the area.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://tarentumboro.com/information/about"
    },
    {
      "id": 3,
      "text": "Tarentum grew into a riverworking community, with the Pennsylvania Railroad and later streetcars fueling its industrial boom.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Tarentum%2C_Pennsylvania"
    },
    {
      "id": 4,
      "text": "The town once housed a grist mill, a fulling mill, and a two‑story German‑style log home built in 1800 that stood until 1945.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://tarentumboro.com/information/about"
    },
    {
      "id": 5,
      "text": "In 1926 Riverview Memorial Park was dedicated to honor veterans who served in World War I and other conflicts.",
      "sourceSentenceIds": [
        17
      ],
