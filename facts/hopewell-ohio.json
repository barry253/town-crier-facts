  "facts": [
    {
      "id": 1,
      "text": "Nearly 2,000 years ago, Native Americans erected dozens of monumental mounds and earthen enclosures across southern Ohio.",
      "sourceSentenceIds": [
        18
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://verdanttraveler.com/hopewell-culture-national-historical-park/",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Today, those archaeological sites are preserved and showcased at Hopewell Culture National Historical Park, a UNESCO World Heritage site.",
      "sourceSentenceIds": [
        19
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://verdanttraveler.com/hopewell-culture-national-historical-park/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "At Hopewell Culture National Historical Park, you can explore the spirituality and significance of ancient earthworks built by the Hopewell culture.",
      "sourceSentenceIds": [
        20
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://verdanttraveler.com/hopewell-culture-national-historical-park/",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "These prehistoric earthworks, created by ancient mound builders, testify to the rich cultural heritage and Native American history of the region.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://verdanttraveler.com/hopewell-culture-national-historical-park/",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Great geometric earthworks rank among the most impressive Native American monuments of prehistory, constructed by cultures that followed the Hopewell.",
      "sourceSentenceIds": [
        13
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Hopewell_tradition",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The mound group received its name from Mordecai Hopewell, whose family owned the land where the earthworks sit.",
      "sourceSentenceIds": [
        5
