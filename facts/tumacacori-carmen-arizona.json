  "facts": [
    {
      "id": 1,
      "text": "Tumacacori sits in a valley carved by the Santa Cruz River, where O’odham, Yaqui, and Apache peoples once mingled with Spanish missionaries.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.nps.gov/tuma/index.htm",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The ruins of Mission San José de Tumacácori, built in the late 1700s, are preserved as Tumacácori National Historical Park.",
      "sourceSentenceIds": [
        24,
        8
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 2"
      ],
      "source": "https://en.wikipedia.org/wiki/Tumacacori%2C_Arizona",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Father Eusebio Kino founded the first Spanish mission in southern Arizona in 1691, just south of the current park.",
      "sourceSentenceIds": [
        4,
        5
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Tumacacori%2C_Arizona",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Repeated Apache raids in the 1800s forced the mission’s abandonment, halting local agricultural growth for decades.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Tumacacori%2C_Arizona",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The park offers a self‑guided tour that lets visitors walk through the mission church, cemetery, and surrounding grounds.",
      "sourceSentenceIds": [
        18
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://wnpa.org/explore-parks/tumacacori",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "A scenic riverside trail, the Anza Trail, follows part of the historic route Spanish settlers used to reach California.",
      "sourceSentenceIds": [
