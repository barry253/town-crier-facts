    {
      "id": 1,
      "text": "Washington sprang to life in 1818 when Daviess County was authorized after Knox County split.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://getindiana.com/news/washington",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town’s name honors Washington Township, the area’s original civil division in Indiana.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Washington%2C_Indiana",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Main Street houses the Daviess County Historical Society Museum, an old Masonic Lodge that showcases 200 years of local history.",
      "sourceSentenceIds": [
        26,
        27
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://getindiana.com/news/washington",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "A railroad arrived in Washington in 1857, and by 1889 it had become a major depot for the Ohio and Mississippi Railroad.",
      "sourceSentenceIds": [
        18,
        19
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Washington%2C_Indiana",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Beck’s Mill, one of the few operational gristmills left in the United States, stands as a celebrated historic landmark in Washington.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.washingtoncountytourism.com/?view=article&id=1:welcome&catid=2",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The Pioneer Village at the John Hay Center lets visitors step back into 19th‑century life with a restored gristmill and engaging exhibits.",
