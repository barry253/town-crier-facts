  "facts": [
    {
      "id": 1,
      "text": "Seat Pleasant blossomed into a railroad suburb when the Washington, Baltimore and Annapolis Electric Railway reached the town in 1908, and the line operated until 1935.",
      "sourceSentenceIds": [
        26,
        8
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Seat_Pleasant%2C_Maryland",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "In 1906, residents around the station renamed the area Seat Pleasant, borrowing the name from the historic Williams‑Berry estate.",
      "sourceSentenceIds": [
        11,
        16
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Seat_Pleasant%2C_Maryland",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Maryland Route 704, now Martin Luther King Jr. Highway, slices through Seat Pleasant and was originally called George Palmer Highway after a local banker.",
      "sourceSentenceIds": [
        4,
        18,
        20
      ],
      "sourceLabels": [
        "Web source 1",
        "Wikipedia",
        "Wikipedia"
      ],
      "source": "https://seatpleasantmd.gov/241/History",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The Addison Road Metro station, part of the Blue and Silver Lines, opened on November 22, 1980, linking Seat Pleasant to Washington D.C.",
      "sourceSentenceIds": [
        12,
        13,
        14
      ],
      "sourceLabels": [
        "Wikipedia",
        "Wikipedia",
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Seat_Pleasant%2C_Maryland",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Seat Pleasant’s origins trace back to Joseph Gregory’s dairy farm, which was subdivided into small farms and rural home sites in 1873.",
