  "facts": [
    {
      "id": 1,
      "text": "Borden was founded in 1816 by Rhode Islander John Borden and was originally called New Providence after Providence, Rhode Island.",
      "sourceSentenceIds": [
        1,
        2
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Borden%2C_Indiana",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town officially changed its name from New Providence to Borden on December 29, 1994.",
      "sourceSentenceIds": [
        23
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Borden%2C_Indiana",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "In 1884 William W. Borden founded the Borden Institute, a local school that later became part of the town’s educational history.",
      "sourceSentenceIds": [
        5,
        8
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Borden%2C_Indiana",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Borden’s library and museum, started by William W. Borden, once housed a geological collection that later joined Chicago’s Field Museum.",
      "sourceSentenceIds": [
        15,
        19
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Borden%2C_Indiana",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Borden sits in Wood Township, Clark County, Indiana, and its community center still occupies the former Borden Institute building.",
