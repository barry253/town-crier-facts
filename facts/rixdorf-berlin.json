  "facts": [
    {
      "id": 1,
      "text": "Rixdorf began as the medieval village Richardsdorf, later shortened to Rixdorf before becoming Neukölln.",
      "sourceSentenceIds": [
        18,
        19,
        20
      ],
      "sourceLabels": [
        "Web source 1",
        "Web source 2"
      ],
      "source": "https://www.visitberlin.de/en/rixdorf-berlin-neukolln"
    },
    {
      "id": 2,
      "text": "In 1912, Rixdorf was officially renamed Neukölln to celebrate Emperor Wilhelm II’s 40th year on the throne.",
      "sourceSentenceIds": [
        21,
        12
      ],
      "sourceLabels": [
        "Web source 2",
        "Wikipedia"
      ],
      "source": "https://www.europesays.com/germany/8769/"
    },
    {
      "id": 3,
      "text": "The village chapel of Rixdorf, built around 1400 in late Gothic style, remains Neukölln’s oldest church.",
      "sourceSentenceIds": [
        2,
        26
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Neuk%C3%B6lln_(locality)"
    },
    {
      "id": 4,
      "text": "The 1887 Franz Weeren Eisenwerk ironworks on Glasower Straße now houses an industrial villa and stands as a historic landmark.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Neuk%C3%B6lln_(locality)"
    },
    {
      "id": 5,
      "text": "The former beer hall Neue Welt, founded in 1865 as a beer garden, today hosts concerts as Huxleys Neue Welt.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Neuk%C3%B6lln_(locality)"
    },
    {
      "id": 6,
      "text": "The Neukölln–Mittenwald railroad, a single‑track line, still operates north of Berlin for industrial transport.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Neuk%C3%B6lln_(locality)"
    }
  ]
