    {
      "id": 1,
      "text": "Founded in the late 18th century by Scottish immigrants, Chisholm was named after their hometown in Scotland.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://winslowmaine.org/unveiling-the-hidden-charm-of-chisholm-maine-exploring-the-enchanting-gems-of-a-rustic-city"
    },
    {
      "id": 2,
      "text": "Chisholm’s historic buildings and landmarks still stand, preserving the town’s rustic charm despite modern growth.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://winslowmaine.org/unveiling-the-hidden-charm-of-chisholm-maine-exploring-the-enchanting-gems-of-a-rustic-city"
    },
    {
      "id": 3,
      "text": "The Chisholm Historical Society Museum, housed in a 19th‑century Victorian mansion, showcases artifacts that chronicle the town’s past.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 1"
      ],
