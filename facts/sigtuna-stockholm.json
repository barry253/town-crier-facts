  "facts": [
    {
      "id": 1,
      "text": "Sigtuna was founded over 1,000 years ago on the shore of Lake Mälaren, making it one of Sweden’s oldest towns.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Sigtuna"
    },
    {
      "id": 2,
      "text": "Founded in AD 980 by Erik the Victorious, the town’s main street, Stora Gatan, still follows its original medieval route.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://visitsweden.com/where-to-go/middle-sweden/uppland/sigtuna/"
    },
    {
      "id": 3,
      "text": "Sigtuna is Sweden’s oldest town and the world’s most runestone‑dense place, with thousands of stone markers scattered across the area.",
      "sourceSentenceIds": [
        7,
        8
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://visitsweden.com/where-to-go/middle-sweden/uppland/sigtuna/"
    },
    {
      "id": 4,
      "text": "Viking heritage is everywhere in Sigtuna, from historic churches and ruins to the highest concentration of runestones in the world.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://visitsweden.com/where-to-go/middle-sweden/uppland/sigtuna/"
    },
    {
      "id": 5,
      "text": "A palace‑hopping day trip is easy, with Skånelaholm Castle and the 18th‑century Steninge Castle showcasing elegant historic grounds.",
      "sourceSentenceIds": [
        15
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://visitsweden.com/where-to-go/middle-sweden/uppland/sigtuna/"
    },
    {
      "id": 6,
      "text": "The name Sigtuna may mean either “swamp” or “strong fortress,” reflecting ancient theories about its early landscape and purpose.",
      "sourceSentenceIds": [
        25,
        27
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Sigtuna"
    }
  ]
