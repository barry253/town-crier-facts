  "facts": [
    {
      "id": 1,
      "text": "Shippensburg was first settled in July 1730 by Scots‑Irish families, making it the oldest community in the Cumberland Valley.",
      "sourceSentenceIds": [
        12,
        30
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://shippensburg.org/fast-facts-history/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town’s name honors Edward Shippen, who received a land grant from William Penn’s heirs.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://shippensburg.org/fast-facts-history/",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "In 1819, Shippensburg incorporated as a borough, becoming the second oldest west of the Susquehanna River after York.",
      "sourceSentenceIds": [
        25,
        29
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Shippensburg%2C_Pennsylvania",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Shippensburg University, founded in 1871 as a normal school, sits just north of the borough and hosts the historic Old Main building.",
      "sourceSentenceIds": [
        3,
        15
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Shippensburg%2C_Pennsylvania",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The town once hosted furniture factories, engine and pump works, and other industrial plants that shaped its 19th‑century economy.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Shippensburg%2C_Pennsylvania",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "In the winter of 1763‑64, an officer and eighteen provincial troops were stationed in Shippensburg, reflecting its early military role.",
