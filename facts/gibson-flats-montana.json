  "facts": [
    {
      "id": 1,
      "text": "Gibson Flats sits on a 3,346‑foot plateau, giving it a mild continental climate with chinook winds that can raise temperatures by 20°F in minutes.",
      "sourceSentenceIds": [
        13,
        18
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/gibson_flats_montana",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The name 'Gibson Flats' first appeared in a 1908 USGS survey describing an oxbow of the preglacial Missouri River channel.",
      "sourceSentenceIds": [
        22
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/gibson_flats_montana",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "In 1806, two Blackfeet warriors were killed near the Marias River confluence during a return expedition, a clash that intensified tensions between the tribe and settlers.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/gibson_flats_montana",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The Lewis and Clark Corps portaged around the Great Falls of the Missouri, roughly 10 miles northeast of Gibson Flats, mapping the area that later drew settlers.",
      "sourceSentenceIds": [
        21
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/gibson_flats_montana",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The Montana Central Railway's 1887 arrival drew homesteaders to Gibson Flats, who hoped irrigation along the Sun River would turn the arid plains into farmland.",
      "sourceSentenceIds": [
