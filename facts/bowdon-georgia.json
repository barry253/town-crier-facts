  "facts": [
    {
      "id": 1,
      "text": "Bowdon was incorporated on January 1, 1859 and was named after Alabama congressman Franklin Welsh Bowdon.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Bowdon%2C_Georgia"
    },
    {
      "id": 2,
      "text": "Bowdon College opened in 1857, closed in 1936, and its former campus now houses the Bowdon Area Historical Society headquarters.",
      "sourceSentenceIds": [
        19,
        10,
        11
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 2"
      ],
      "source": "https://en.wikipedia.org/wiki/Bowdon%2C_Georgia"
    },
    {
      "id": 3,
      "text": "The Bowdon Railway ran through the city from 1910 until 1963, linking the town to regional markets.",
      "sourceSentenceIds": [
        20
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Bowdon%2C_Georgia"
    },
    {
      "id": 4,
      "text": "The Bowdon Area Historical Society, chartered in 1985, preserves the town’s heritage and operates a museum on the historic Bowdon College site.",
      "sourceSentenceIds": [
        13,
        17
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://carrollcountyhistory.org/bowdon.html"
    },
    {
      "id": 5,
      "text": "The former Bowdon Methodist Protestant church, the last remaining structure from the old college campus, was restored and now serves as the Society’s Meeting Place.",
      "sourceSentenceIds": [
        10,
        12
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://carrollcountyhistory.org/bowdon.html"
    },
    {
      "id": 6,
      "text": "Bowdon’s historic marker at Bowdon High School commemorates the college’s original location and its role as the “Athens of the West.”.",
      "sourceSentenceIds": [
        2,
        6
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://carrollcountyhistory.org/bowdon.html"
    }
  ]
