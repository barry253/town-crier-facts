  "facts": [
    {
      "id": 1,
      "text": "Nottoway County Courthouse, built 1839‑1843, showcases Greek Revival style with a Tuscan portico and triple‑hung sash, reflecting Jeffersonian influence.",
      "sourceSentenceIds": [
        1,
        4,
        10
      ],
      "sourceLabels": [
        "Web source 2",
        "Web source 1"
      ],
      "source": "https://www.vaco.org/county-connections/visit-nottoway-county-and-the-nottoway-county-historic-courthouse/"
    },
    {
      "id": 2,
      "text": "The courthouse replaced an 1798 building and was finished in 1843, standing on the same site where Union soldiers bivouacked in 1865, destroying many records.",
      "sourceSentenceIds": [
        9,
        12
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.dhr.virginia.gov/historic-registers/067-0004/"
    },
    {
      "id": 3,
      "text": "Nottoway, originally called Lewistown, was a mid‑nineteenth‑century stop on the Southside Railroad, later part of the Norfolk Southern Railway.",
      "sourceSentenceIds": [
        3,
        5,
        6
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Nottoway%2C_Virginia"
    },
    {
      "id": 4,
      "text": "The courthouse’s marble sills and lintels add a touch of refinement to its Flemish‑bond brickwork, a detail noted by historians.",
      "sourceSentenceIds": [
        11,
        10
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.dhr.virginia.gov/historic-registers/067-0004/"
    },
    {
      "id": 5,
      "text": "In 1973 the Nottoway County Courthouse earned a spot on the National Register of Historic Places, highlighting its architectural significance.",
      "sourceSentenceIds": [
        7,
        8
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Nottoway%2C_Virginia"
    },
    {
      "id": 6,
      "text": "The courthouse sits on spacious grounds in the center of Nottoway, with a large portico of four white columns and a pediment framing the east front.",
