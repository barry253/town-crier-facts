  "facts": [
    {
      "id": 1,
      "text": "Williamsburg was founded in 1790 by Jacob Ake, originally called Aketown, making it the oldest borough within Blair County.",
      "sourceSentenceIds": [
        4,
        16
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Williamsburg%2C_Pennsylvania",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Union Street commemorates the federal union, Liberty Street celebrates American liberty, and Black, Taylor, and Dean honor three local judges.",
      "sourceSentenceIds": [
        5,
        7
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Williamsburg%2C_Pennsylvania",
      "category": "people",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "A small cross street named Blue Pirate Street runs beside the high school, a nod to the school’s mascot.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Williamsburg%2C_Pennsylvania",
      "category": "landmark",
      "quality": "poor",
      "qualityReason": "vague"
    },
    {
      "id": 4,
      "text": "The Pennsylvania Canal once ran through Williamsburg, abandoned in 1872, and the old towpath later became part of the Pennsylvania Railroad line that reached the town in 1873.",
      "sourceSentenceIds": [
        1,
        19
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Williamsburg%2C_Pennsylvania",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The Baker Mansion History Museum, run by the Blair County Historical Society, preserves Williamsburg’s heritage and sits near the town’s historic core.",
      "sourceSentenceIds": [
