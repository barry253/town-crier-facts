      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town was first laid out in 1881, just a few years after the first post office opened on May 14, 1878.",
      "sourceSentenceIds": [
        12,
        3
      ],
      "sourceLabels": [
        "Wikipedia",
