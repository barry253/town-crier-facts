      "id": 1,
      "text": "River Bottom is located in eastern Muskogee County, bordered by the Arkansas River to the west and the community of Sand Hill to the east.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
