  "facts": [
    {
      "id": 1,
      "text": "Founded 1818 by brothers Seth and Zebulon Leavenworth as an Ohio River port, Leavenworth grew into a bustling shipping hub.",
      "sourceSentenceIds": [
        4,
        13
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/leavenworth_indiana",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Leavenworth served as Crawford County seat from 1843 until 1896, when county records were moved after a Supreme Court ruling.",
      "sourceSentenceIds": [
        24,
        6
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Leavenworth%2C_Indiana",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Pearl button factories dotted Leavenworth, cutting mussel shells into discs that were sanded and shipped to Massachusetts before plastic buttons ended the industry after WWII.",
      "sourceSentenceIds": [
        7,
        8,
        9
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/leavenworth_indiana",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The first newspaper of Crawford County, The Crisis, began publishing in Leavenworth in 1839, marking the town’s early press history.",
      "sourceSentenceIds": [
        20
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Leavenworth%2C_Indiana",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Old Leavenworth, the original town on the Ohio River floodplain, was almost completely destroyed by the 1937 flood, the most devastating in the valley’s history.",
      "sourceSentenceIds": [
        10,
        11
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Leavenworth%2C_Indiana",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "A bluff overlooking the Ohio River, part of the Indiana Ridge, rises behind Leavenworth and faces directly across the river toward Kentucky.",
      "sourceSentenceIds": [
