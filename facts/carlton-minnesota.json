  "facts": [
    {
      "id": 1,
      "text": "Carlton County, established in 1857, was named after Reuben B. Carlton, a pioneer blacksmith and Minnesota state senator.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/carlton_minnesota"
    },
    {
      "id": 2,
      "text": "Carlton's early economy centered on rail transportation, a key junction for freight and passengers, while logging relied heavily on the railroads to move timber.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/carlton_minnesota"
    },
    {
      "id": 3,
      "text": "After the 1918 Cloquet Fire, which devastated much of Carlton County but spared the town of Carlton, the region recovered in the 1920s.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/carlton_minnesota"
    },
    {
      "id": 4,
      "text": "The Saint Louis River flows east‑southeast through the county, discharging into Lake Superior.",
      "sourceSentenceIds": [
        20
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Carlton_County%2C_Minnesota"
    },
    {
      "id": 5,
      "text": "Carlton, the county seat of Carlton County, sits on the Saint Louis River and serves as the region's administrative hub.",
      "sourceSentenceIds": [
        15
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Carlton_County%2C_Minnesota"
    },
    {
      "id": 6,
      "text": "Part of the Fond du Lac Indian Reservation lies in northeastern Carlton County.",
