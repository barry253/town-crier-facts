    },
    {
      "id": 4,
      "text": "Orwigsburg sits at 40°39′24″N 76°6′7″W, nestled in the rolling hills of Schuylkill County.",
      "sourceSentenceIds": [
        11,
        7
      ],
      "sourceLabels": [
