  "facts": [
    {
      "id": 1,
      "text": "Miles Platting first appeared on a 1790 map where Oldham Road crossed Newton Brook, marking its early geographic roots.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Miles_Platting",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The name derives from “platting,” a local word for a small bridge across a stream, and the area lay a mile from Manchester.",
      "sourceSentenceIds": [
        19,
        22
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Miles_Platting",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "During the Industrial Revolution, Miles Platting grew into a factory district, hosting mills like Holland, Victoria, and Ducie by the late 19th century.",
      "sourceSentenceIds": [
        23
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Miles_Platting",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Oldham Road railway station, opened 1839, served as Manchester and Leeds Railway’s original terminus before moving to Victoria in 1844.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Miles_Platting",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "After factories closed, the area faced unemployment and became a slum, but 1990s regeneration replaced terraces with council housing.",
      "sourceSentenceIds": [
        6,
        17,
        28
      ],
      "sourceLabels": [
        "Web source 2",
        "Wikipedia"
      ],
      "source": "https://netvol.co.uk/miles-platting-manchester-history-and-regeneration/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Historic industrial buildings now sit beside modern housing, creating a unique urban landscape that reflects the area’s resilience.",
