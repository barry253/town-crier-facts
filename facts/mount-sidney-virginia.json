  "facts": [
    {
      "id": 1,
      "text": "Mount Sidney’s historic district began as a handful of homes and shops that served travelers on the Old Wagon Road.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.dhr.virginia.gov/historic-registers/007-1300/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "After the Civil War, the Valley Railroad arrived east of town, turning Mount Sidney into a leading commercial hub in northern Augusta County.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.dhr.virginia.gov/historic-registers/007-1300/",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Founded in 1826, Mount Sidney ranks among Augusta County’s oldest towns.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.dhr.virginia.gov/historic-registers/007-1300/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The 1830s saw a building boom as the Old Wagon Road was upgraded to the Valley Turnpike.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.dhr.virginia.gov/historic-registers/007-1300/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Today the Mount Sidney Historic District showcases well‑preserved turnpike‑town architecture from the early‑19th to mid‑20th centuries.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.dhr.virginia.gov/historic-registers/007-1300/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Mount Sidney’s rolling hills and lush farmland offer fresh mountain air and a picturesque rural setting.",
      "sourceSentenceIds": [
        13
