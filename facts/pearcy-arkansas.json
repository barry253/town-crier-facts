  "facts": [
    {
      "id": 1,
      "text": "Pearcy's origins trace back to the late 19th century when a post office opened in 1890, serving local farmers and timber workers.",
      "sourceSentenceIds": [
        27
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/pearcy_arkansas",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Pearcy lies in the foothills of the Ouachita Mountains, surrounded by mixed hardwoods and pines that feed the nearby Ouachita National Forest.",
      "sourceSentenceIds": [
        24
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/pearcy_arkansas",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The community sits at roughly 620 feet above sea level, giving it a mild, humid subtropical climate with hot summers and cool winters.",
      "sourceSentenceIds": [
        16,
        19
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/pearcy_arkansas",
      "category": "other",
      "quality": "poor",
      "qualityReason": "vague"
    },
    {
      "id": 5,
      "text": "Early settlers, including trappers like Isaac Cates and John Percival, built log cabins to support agriculture and health seekers after the 1832 Hot Springs Reservation.",
      "sourceSentenceIds": [
        26
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/pearcy_arkansas",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Pearcy’s development was tied to agriculture and timber; after the Civil War, pine and hardwood harvesting supplied railroads and construction across Arkansas.",
      "sourceSentenceIds": [
