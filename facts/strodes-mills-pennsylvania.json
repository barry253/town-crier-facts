  "facts": [
    {
      "id": 1,
      "text": "Strodes Mills celebrated its 300th anniversary in 2021, marking three centuries of local history.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.friendsofstrodesmill.com/the-history-of-strode-s-mill",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Construction of the Strode's Mill Heritage Center, an outdoor interpretive site, will begin in 2026.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.eastbradford.org/253/Strodes-Mill-Heritage-Center",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The Heritage Center sits on the former site of the Strode's Sausage and Scrapple Company.",
      "sourceSentenceIds": [
        18
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.eastbradford.org/253/Strodes-Mill-Heritage-Center",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Strodes Mills National Historic District traces its roots back to 1721, making it one of the oldest crossroads villages in the area.",
      "sourceSentenceIds": [
        19
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.eastbradford.org/253/Strodes-Mill-Heritage-Center",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "British troops moved through Strodes Mills just before the 1777 Battle of Brandywine, leaving a lasting imprint on the region.",
      "sourceSentenceIds": [
        21
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.eastbradford.org/253/Strodes-Mill-Heritage-Center",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Friends of Strodes Mill have restored the historic Strode's Barn and Springhouse, preserving the village’s culinary heritage.",
