      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The town lies on Indiana’s border with Illinois, within Kent Township of Warren County.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
