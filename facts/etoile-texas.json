    },
    {
      "id": 3,
      "text": "Steamboats from Beaumont docked at Brown’s Ferry on the Angelina River just outside Etoile until 1881.",
      "sourceSentenceIds": [
        21
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.tshaonline.org/handbook/entries/etoile-tx",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "In 1876 Reverend James Sims built a church at Macedonia Springs, sparking the development of a nearby town called Macedonia.",
      "sourceSentenceIds": [
        18
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.tshaonline.org/handbook/entries/etoile-tx",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "By 1897 Etoile hosted the Fisher and Crown General Store, a local hub for residents and travelers.",
      "sourceSentenceIds": [
        23
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.tshaonline.org/handbook/entries/etoile-tx",
      "category": "other",
      "quality": "poor",
      "qualityReason": "vague"
    },
    {
