  "facts": [
    {
      "id": 1,
      "text": "Mill Basin began as Mill Island, a separate landmass in Jamaica Bay before becoming part of Brooklyn.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Mill_Basin%2C_Brooklyn",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "A 17th‑century mill on Mill, Bergen, and Barren Islands signaled the area's early industrial roots.",
      "sourceSentenceIds": [
        30
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Mill_Basin%2C_Brooklyn",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Streets in Mill Basin were named for nearby bays and coasts, and ranch houses first appeared in the 1950s.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.cityneighborhoods.nyc/mill-basin",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The Mill Basin Library opened in 1940 and moved to its current building in 1975, remaining a community hub.",
      "sourceSentenceIds": [
        23,
        24
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Mill_Basin%2C_Brooklyn",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "A lack of railroad connections historically kept Mill Basin from developing a larger commercial sector.",
      "sourceSentenceIds": [
