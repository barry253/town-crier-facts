  "facts": [
    {
      "id": 1,
      "text": "Bogota, New Jersey was formed on November 14, 1894, during a period known as 'Boroughitis' in Bergen County.",
      "sourceSentenceIds": [
        2,
        3
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Bogota%2C_New_Jersey",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The name Bogota honors the Bogert family, the first European settlers in the area, possibly blended with another family name for easier pronunciation.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Bogota%2C_New_Jersey",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Bogota, New Jersey is bisected by the CSX River Line, dividing the borough into an industrial eastern half and a suburban western half.",
      "sourceSentenceIds": [
        9,
        10,
        11
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Bogota%2C_New_Jersey",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The borough's name is pronounced buh-GOH-tə, differing from the capital city of Colombia, Bogotá, which is accented on the final syllable.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Bogota%2C_New_Jersey",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "In 1895, portions of Bogota were taken to help form the newly created Township of Teaneck.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Bogota%2C_New_Jersey",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Bogota, New Jersey is located on the east shore of the Hackensack River, providing a scenic waterfront view.",
