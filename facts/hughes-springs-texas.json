  "facts": [
    {
      "id": 1,
      "text": "Hughes Springs was founded in 1839 by Reece Hughes, a pioneer who settled in Texas and later named the town after himself.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.hschamber.org/about",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The original settlement grew around a famous chalybeate spring, known for its iron‑rich waters, which drew early settlers in 1847.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.hschamber.org/about",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "When the East Line and Red River Railroad reached the area in 1876, Hughes Springs became a key station and its population began to boom.",
      "sourceSentenceIds": [
        20
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.tshaonline.org/handbook/entries/hughes-springs-tx",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "On November 4, 2022, an EF2 tornado struck Hughes Springs, causing significant damage and reminding residents of the region’s severe weather risks.",
