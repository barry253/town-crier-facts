      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town sits at the confluence of the South Fork of the Rio Grande River and the main Rio Grande River, a feature that defines its geography.",
      "sourceSentenceIds": [
        6,
        10
      ],
      "sourceLabels": [
        "Wikipedia",
