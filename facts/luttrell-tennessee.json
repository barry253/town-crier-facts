  "facts": [
    {
      "id": 1,
      "text": "Luttrell was originally called Cedar Ford and was renamed in 1890 after James Churchwell Luttrell Jr., a former Knoxville mayor.",
      "sourceSentenceIds": [
        1,
        9
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Luttrell%2C_Tennessee",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town grew into a shipping hub when the Powell Valley Railroad arrived in 1887, linking it to Norfolk Southern.",
      "sourceSentenceIds": [
        4,
        6
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Luttrell%2C_Tennessee",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Luttrell sits in a valley between Copper Ridge to the north and Clinch Mountain to the south, part of the Appalachian Ridge‑and‑Valley range.",
      "sourceSentenceIds": [
        14,
        15
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Luttrell%2C_Tennessee",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Flat Creek, a tributary of the Holston River, drains the city’s landscape.",
      "sourceSentenceIds": [
        16
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Luttrell%2C_Tennessee",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Tennessee State Route 131 and State Route 61 intersect in Luttrell, connecting it to Plainview, Maynardville, and Blaine.",
      "sourceSentenceIds": [
        18,
        19
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Luttrell%2C_Tennessee",
      "category": "transport",
      "quality": "poor",
      "qualityReason": "route_only"
    },
    {
      "id": 6,
      "text": "The city was officially incorporated in 1925 by a private act of the Tennessee General Assembly, later amended in 1965.",
