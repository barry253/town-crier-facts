  "facts": [
    {
      "id": 1,
      "text": "Alexandria serves as the county seat for Hanson County in central South Dakota.",
      "sourceSentenceIds": [
        10,
        11
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Alexandria%2C_South_Dakota"
    },
    {
      "id": 2,
      "text": "Founded in 1879 as Clarksville, the community was later renamed Alexandria in honor of Alexander Mitchell.",
      "sourceSentenceIds": [
        1,
        2,
        3,
        6
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 2"
      ],
      "source": "https://en.wikipedia.org/wiki/Alexandria%2C_South_Dakota"
    },
    {
      "id": 3,
      "text": "The city's early growth was accelerated by railroad infrastructure that connected Alexandria to broader markets after statehood in 1889.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/alexandria_south_dakota"
    },
    {
      "id": 4,
      "text": "Alexandria established its post office in 1880 and officially incorporated as a city in 1885.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Alexandria%2C_South_Dakota"
    },
    {
      "id": 5,
      "text": "The original Hanson County Courthouse was built in Alexandria between 1904 and 1905 and served as a hub until 2010.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/alexandria_south_dakota"
    },
    {
      "id": 6,
      "text": "Alexandria historically served as a key shipping point for grain, contributing to the economy of southeast South Dakota.",
      "sourceSentenceIds": [
        5
