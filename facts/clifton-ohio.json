  "facts": [
    {
      "id": 1,
      "text": "Clifton was platted in 1840 and named for the nearby cliffs on the Little Miami River.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Clifton%2C_Ohio"
    },
    {
      "id": 2,
      "text": "The historic 1893 Clifton Opera House hosts local musicians, turning the village into a living music venue.",
      "sourceSentenceIds": [
        4,
        3
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 2"
      ],
      "source": "https://en.wikipedia.org/wiki/Clifton%2C_Ohio"
    },
    {
      "id": 3,
      "text": "Clifton Mill, one of the largest water‑powered grist mills still in existence, sits beside the 1886 Covered Bridge.",
      "sourceSentenceIds": [
        16,
        17
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Clifton%2C_Ohio"
    },
    {
      "id": 4,
      "text": "The entire village is listed on the National Register of Historic Places, preserving its 19th‑century streetscape.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://familydestinationsguide.com/town-ohio-charming-postcard/"
    },
    {
      "id": 5,
      "text": "Clifton Gorge State Nature Preserve borders the village to the west, where a red‑painted grist mill perches on a limestone gorge.",
      "sourceSentenceIds": [
        5,
        10
      ],
      "sourceLabels": [
        "Web source 1",
        "Web source 2"
      ],
      "source": "https://www.citydirectory.us/village-clifton-ohio.html"
    },
    {
      "id": 6,
      "text": "Clifton is the eastern terminus of Ohio State Route 343, with the Little Miami River and the Gorge to its south and west.",
