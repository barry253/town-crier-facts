  "facts": [
    {
      "id": 1,
      "text": "Pullman grew around a railroad station built on land owned by Hopper and Bennett, giving the town's early name Hoppertown.",
      "sourceSentenceIds": [
        1,
        16
      ],
      "sourceLabels": [
        "Web source 2",
        "Wikipedia"
      ],
      "source": "https://99wfmk.com/pullman-michigan/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town’s streets were originally named after inventors, and Corliss Avenue honors the inventor of the Corliss steam engine.",
      "sourceSentenceIds": [
        2,
        5
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.pullman-museum.org/theTown/",
      "category": "people",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The original Pullman town was completed in 1884, and by May 1881 more than 350 people were already living there.",
      "sourceSentenceIds": [
        29,
        28
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.pullman-museum.org/theTown/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Pullman’s residential layout remains largely unchanged, with nearly all historic housing standing as it did when the town was first built.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.pullman-museum.org/theTown/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The town’s first permanent residents, the Benson family, moved in on January 1, 1881, marking the start of Pullman's community life.",
      "sourceSentenceIds": [
        27
      ],
      "sourceLabels": [
        "Web source 1"
      ],
