      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The village adopted the name Hazel Crest in 1900 after hazelnut bushes that grew on a rise just south of town.",
      "sourceSentenceIds": [
        20
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Hazel_Crest%2C_Illinois",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The Kauchak Municipal Center honors former president Kauchak, who led the village for twenty years from 1973 to 1993.",
