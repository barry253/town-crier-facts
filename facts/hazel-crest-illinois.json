      "id": 1,
      "text": "William McClintock, a newspaper editor from Ohio, founded the village in 1890, buying 80 acres from farmer Fred Puhrman.",
      "sourceSentenceIds": [
        2,
        4
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
