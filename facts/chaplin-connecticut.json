  "facts": [
    {
      "id": 1,
      "text": "Chaplin was incorporated in 1822 after residents negotiated with Mansfield, Hampton and Windham, and was named in honor of benefactor Deacon Benjamin Chaplin.",
      "sourceSentenceIds": [
        1,
        2
      ],
      "sourceLabels": [
        "Web source 1",
        "Wikipedia"
      ],
      "source": "https://www.chaplinct.org/about.htm",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town’s historic core, Chaplin Historic District, sits on Chaplin Street and was added to the National Register of Historic Places in 1978.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Chaplin%2C_Connecticut",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Witter House, another National Register site on Chaplin Street, was listed in 1970 and reflects the town’s 19th‑century architecture.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Chaplin%2C_Connecticut",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Chaplin’s growth centered on a church built with a bequest from Benjamin Chaplin, who died in 1795, meeting house had to be within a mile of his home.",
      "sourceSentenceIds": [
        29
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.chaplinct.org/about.htm",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The Chaplin Museum preserves local history and is housed in a former town building that showcases the village’s 19th‑century building boom.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Chaplin%2C_Connecticut",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "During Memorial Day 2026, the town hall, library, senior center and DPW will close, and garbage pickup shifts to Friday, May 29.",
      "sourceSentenceIds": [
        4
