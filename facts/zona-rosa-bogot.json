      "quality": "good"
    },
    {
      "id": 2,
      "text": "The Andino Shopping Centre anchors Zona Rosa, offering international brands, pharmacies, cafes, and currency exchange under one roof.",
      "sourceSentenceIds": [
        24
      ],
      "sourceLabels": [
        "Web source 1"
      ],
