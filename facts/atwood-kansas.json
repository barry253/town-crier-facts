      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The Atwood Public Library partners with Advantage Archives to offer free, searchable access to over 30,000 digitized newspaper pages.",
      "sourceSentenceIds": [
        18,
