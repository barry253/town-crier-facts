  "facts": [
    {
      "id": 1,
      "text": "Atwood got its name from 14‑year‑old Attwood Matheny, who traveled with his father when the town was founded.",
      "sourceSentenceIds": [
        4,
        5
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Atwood%2C_Kansas"
    },
    {
      "id": 2,
      "text": "The Atwood Public Library partners with Advantage Archives to offer free, searchable access to over 30,000 digitized newspaper pages.",
      "sourceSentenceIds": [
        18,
        19
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://communityhistoryarchives.com/places/atwood-public-library/"
    },
    {
      "id": 3,
      "text": "In the late 1880s, the Chicago, Burlington & Quincy Railroad ran through Atwood, spurring its growth as an agricultural hub.",
      "sourceSentenceIds": [
        15,
        16,
        17
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://legendsofkansas.com/atwood-kansas/"
    },
    {
      "id": 4,
      "text": "Atwood became the county seat of Rawlins County in 1881, a status it holds to this day.",
      "sourceSentenceIds": [
        29
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Atwood%2C_Kansas"
    },
    {
      "id": 5,
      "text": "Visitors can explore the Rawlins County Historical Museum, the historic Shirley Opera House, or relax by Lake Atwood just north of town.",
      "sourceSentenceIds": [
        25
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://legendsofkansas.com/atwood-kansas/"
    },
    {
      "id": 6,
      "text": "The library’s three‑story red brick building, built in Romanesque Revival style by Eisenfraut‑Colby‑Pottinger, stands as a local landmark.",
