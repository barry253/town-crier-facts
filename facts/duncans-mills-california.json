      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "In 1877 the North Pacific Coast Railroad arrived, turning the town into a key rail hub for Sonoma County.",
      "sourceSentenceIds": [
        8,
        15
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
