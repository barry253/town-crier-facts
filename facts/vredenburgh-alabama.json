  "facts": [
    {
      "id": 1,
      "text": "Vredenburgh began in 1910 as a company town founded by Peter Vredenburgh Jr., who brought his family's sawmill to Alabama's timberlands.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/vredenburgh_alabama",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The Louisville & Nashville Railroad extended a line to Vredenburgh in 1910, linking the mill to national markets.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://encyclopediaofalabama.org/article/vredenburgh/",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "By the 1920s, Vredenburgh’s sawmill produced up to 50 million board‑feet of lumber each year for nationwide shipment.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/vredenburgh_alabama",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Company housing in Vredenburgh was segregated by race, featuring modest homes with gardens, rosebushes, and a baseball stadium for workers.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/vredenburgh_alabama",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The original mill burned in 1920, a second fire in 1962, and operations finally ended in the early 1980s.",
      "sourceSentenceIds": [
        23,
        26,
        27
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://encyclopediaofalabama.org/article/vredenburgh/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Today, the surrounding forests are sustainably managed by Wilmon Timberlands and have earned designation as a TREASURE Forest.",
      "sourceSentenceIds": [
        29
