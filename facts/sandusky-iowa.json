  "facts": [
    {
      "id": 1,
      "text": "Sandusky was founded in 1820 when French trader Lemoliese established a trading post, making it one of the earliest European settlements in southeastern Iowa.",
      "sourceSentenceIds": [
        1,
        8
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/sandusky_iowa",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The arrival of the Des Moines Valley Railroad in 1857 and the first Mississippi bridge in 1869 linked Sandusky to regional markets.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/sandusky_iowa",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Sandusky's land was part of the 119,000‑acre Half‑Breed Tract reserved for mixed‑blood descendants of Sac and Fox tribes before the 1832 Black Hawk Purchase.",
      "sourceSentenceIds": [
        29,
        30
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/sandusky_iowa",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Sandusky experiences a humid continental climate with hot, humid summers and cold, snowy winters, averaging 20‑25 inches of snowfall each year.",
      "sourceSentenceIds": [
        27,
        4
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/sandusky_iowa",
      "category": "other",
      "quality": "poor",
      "qualityReason": "vague"
    },
    {
      "id": 6,
      "text": "The community sits on low‑lying alluvial plains, making it vulnerable to Mississippi River flooding, as seen during the 1993 and 2008 Midwest floods.",
      "sourceSentenceIds": [
