  "facts": [
    {
      "id": 1,
      "text": "Balsall Heath’s name first appears as Bordeshale in 1275, meaning ‘Bord’s heath’ or a sheltered corner of land.",
      "sourceSentenceIds": [
        16
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Balsall_Heath",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The area opened a public library on Moseley Road in 1895, followed by Balsall Heath Baths in 1907 in the same building.",
      "sourceSentenceIds": [
        11,
        12
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Balsall_Heath",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "A Muslim community began in June 1940 when two Yemenis bought an artisan cottage on Mary Street, sparking a growing mosque presence.",
      "sourceSentenceIds": [
        21,
        22
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Balsall_Heath",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Balsall Heath is home to the Balti Triangle, a celebrated culinary hub known for its vibrant South‑Asian cuisine.",
      "sourceSentenceIds": [
        15
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Balsall_Heath",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Brighton Road railway station spurred late‑19th‑century growth, turning the area into a dense cluster of terraced houses.",
      "sourceSentenceIds": [
        13
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Balsall_Heath",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "On 1 October 1891, Balsall Heath joined Birmingham’s county borough, ending its status as a chapelry in King’s Norton.",
