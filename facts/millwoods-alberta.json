  "facts": [
    {
      "id": 1,
      "text": "Mill Woods was Edmonton’s first socially planned community, built on city‑owned land to foster a strong sense of neighborhood.",
      "sourceSentenceIds": [
        22
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://millwoodsstory.org/",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The original plan featured a town centre and eight surrounding communities, each split into multiple neighbourhoods with crescent‑shaped streets.",
      "sourceSentenceIds": [
        24
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://millwoodsstory.org/",
      "category": "other",
      "quality": "poor",
      "qualityReason": "vague"
    },
    {
      "id": 3,
      "text": "Mixed housing in Mill Woods blends single‑family homes, high‑rise apartments, and co‑operatives, creating a diverse urban landscape.",
      "sourceSentenceIds": [
        26
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://millwoodsstory.org/",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Indigenous peoples, Canadian migrants, and immigrants from South Asia, East Africa, the Philippines, the Caribbean, and Latin America have shaped Mill Woods’ cultural mosaic.",
      "sourceSentenceIds": [
        27
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://millwoodsstory.org/",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Annual celebrations in Mill Woods include a Sikh parade, Caribbean “Mas Camps,” and Spanish‑language community dances on Canada Day.",
      "sourceSentenceIds": [
        28
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://millwoodsstory.org/",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Mill Woods Christian School, founded in 1978 in the Tweddle Place neighbourhood, became an alternative program of the Edmonton Public School Board in 2000.",
      "sourceSentenceIds": [
        10,
        11,
        13
      ],
