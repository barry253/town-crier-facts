  "facts": [
    {
      "id": 1,
      "text": "Pulteney takes its name from Sir William Pulteney, a British investor who led the Pulteney Association that bought the land in 1790.",
      "sourceSentenceIds": [
        2,
        6
      ],
      "sourceLabels": [
        "Web source 1",
        "Wikipedia"
      ],
      "source": "https://grokipedia.com/page/pulteney_new_york",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town was officially established on March 1, 1808, when it split from the neighboring town of Bath.",
      "sourceSentenceIds": [
        2,
        3
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/pulteney_new_york",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "A once‑lively hub called Sodom evolved into South Pulteney and Gibson’s Landing, a steamboat port that boosted early wine production.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/pulteney_new_york",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Pulteney lies on Keuka Lake’s western shore, one of New York’s famous Finger Lakes.",
      "sourceSentenceIds": [
        15
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Pulteney%2C_New_York",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The Pulteney Tract, bought from Robert Morris by English investors, is listed on the National Register of Historic Places.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Pulteney%2C_New_York",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Before becoming Pulteney, the area was briefly known as Harmonyville during its early settlement.",
