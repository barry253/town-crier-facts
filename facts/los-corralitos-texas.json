  "facts": [
    {
      "id": 1,
      "text": "Los Corralitos was founded in 1753 when Colonel José de Escandón donated a 350,000‑acre grant that included the area that would become the village.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.nps.gov/elte/learn/photosmultimedia/san-jose-de-los-corralitos.htm"
    },
    {
      "id": 2,
      "text": "The village’s name means “little corrals,” reflecting its origins as a fortified ranch building.",
      "sourceSentenceIds": [
        13,
        20
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://ranchingheritage.org/explore/outdoor-historical-park/los-corralitos/"
    },
    {
      "id": 3,
      "text": "The single‑room sandstone fortress built by Don José Fernando Vidaurri features 33‑inch walls, six gun ports, and a flat 11‑foot ceiling.",
      "sourceSentenceIds": [
        14,
        15
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://ranchingheritage.org/explore/outdoor-historical-park/los-corralitos/"
    },
    {
      "id": 4,
      "text": "Los Corralitos is part of the National Ranching Heritage Center, where the earliest standing Texas structure is preserved.",
      "sourceSentenceIds": [
        12,
        11
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://ranchingheritage.org/explore/outdoor-historical-park/los-corralitos/"
    },
    {
      "id": 5,
      "text": "The site is listed on the National Register of Historic Places as part of the El Camino Real de los Tejas National Historic Trail.",
      "sourceSentenceIds": [
        6,
        5
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.nps.gov/elte/learn/photosmultimedia/san-jose-de-los-corralitos.htm"
    },
    {
      "id": 6,
      "text": "Ranching began in the area in 1598 when 7,000 cattle were driven north from Durango, Mexico, by Juan de Onate.",
      "sourceSentenceIds": [
        17
