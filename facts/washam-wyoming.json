  "facts": [
    {
      "id": 1,
      "text": "Washam was named after early settler Dave Washam, who established a ranch near Henrys Fork around 1890.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/washam"
    },
    {
      "id": 2,
      "text": "The region around Washam served as traditional territory for the Shoshone and Ute peoples for hunting and seasonal migration.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/washam"
    },
    {
      "id": 3,
      "text": "Washam emerged as a ranching settlement in the late 19th century along the Henry's Fork of the Green River.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/washam_wyoming"
    },
    {
      "id": 4,
      "text": "A post office opened in Washam on April 3, 1890, operating out of a small log building until 1903.",
      "sourceSentenceIds": [
        22
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/washam_wyoming"
    },
    {
      "id": 5,
      "text": "Washam sits at an elevation of 6,861 feet within an intermontane desert landscape of rolling hills and broad basins.",
