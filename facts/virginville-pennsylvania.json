  "facts": [
    {
      "id": 1,
      "text": "Virginville’s name may come from a Native American word or from the virgin forests that once blanketed the area, echoing the nearby Maiden Creek.",
      "sourceSentenceIds": [
        1,
        2
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Virginville%2C_Pennsylvania",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "In 2000, Virginville earned recognition as the Virginville Historic District, preserving its 19th‑century charm on the National Register of Historic Places.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Virginville%2C_Pennsylvania",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Virginville sits at the crossroads of PA 143 and Crystal Ridge Road, about seven miles south of Lenhartsville.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Virginville%2C_Pennsylvania",
      "category": "other",
      "quality": "poor",
      "qualityReason": "location_description"
    },
    {
      "id": 4,
      "text": "Historic landmarks in Virginville include Paul’s Chapel (1903), the Virginville Hotel (1885), and Balthasar’s Garage (1921).",
      "sourceSentenceIds": [
        7,
        8
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Virginville%2C_Pennsylvania",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Maiden Creek, which runs through Virginville, joins Sacony Creek nearby, adding to the area’s scenic waterways.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Virginville%2C_Pennsylvania",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "A fully renovated 18th‑century stone farmhouse near Virginville offers a glimpse into the town’s colonial past.",
