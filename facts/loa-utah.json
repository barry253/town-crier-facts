  "facts": [
    {
      "id": 1,
      "text": "Loa was named by missionary Franklin Young, inspired by Mauna Loa, whose name means high, large, and powerful.",
      "sourceSentenceIds": [
        1,
        25,
        26
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://loautah.gov/about-us",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "First settled by Mormon pioneers in 1876, Loa became the county seat of Wayne County in 1878.",
      "sourceSentenceIds": [
        2,
        24
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://capitolreefcountry.com/loa/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The town’s two parks honor locals: Harold Brown Park commemorates a World War I veteran, and Turner Park honors the family that donated its land.",
      "sourceSentenceIds": [
        3,
        4,
        5
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://capitolreefcountry.com/loa/",
      "category": "people",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The historic Wayne Stake tithing office, built in 1897, now serves as a museum preserved by the Daughters of the Utah Pioneers.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://capitolreefcountry.com/loa/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Loa sits beside Spring Creek, the only water source in the valley, whose spring feeds the nearby state fish hatchery.",
      "sourceSentenceIds": [
        11
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Loa%2C_Utah",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The Tabernacle, just south of Turner Park, was dedicated in 1909 and remains a landmark of early Loa architecture.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://capitolreefcountry.com/loa/",
      "category": "landmark",
      "quality": "good"
    }
