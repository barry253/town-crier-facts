  "facts": [
    {
      "id": 1,
      "text": "Vernon was settled beginning in 1857 by pioneers, many of whom were converts to the Church of Jesus Christ of Latter-Day Saints.",
      "sourceSentenceIds": [
        12,
        30
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Vernon%2C_Utah"
    },
    {
      "id": 2,
      "text": "The town of Vernon takes its name from a pioneer settler named Joseph Vernon.",
      "sourceSentenceIds": [
        13
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Vernon%2C_Utah"
    },
    {
      "id": 3,
      "text": "Early settlers in Vernon grazed massive herds of cattle, sheep, and horses on the plentiful meadow grasses of the valley.",
      "sourceSentenceIds": [
        4,
        25
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://vernon.utah.gov/residents/history-of-vernon/"
    },
    {
      "id": 4,
      "text": "Immigrant settlers overgrazed the valley, causing native grasses to be replaced by sagebrush and juniper trees within fifteen years.",
      "sourceSentenceIds": [
        27
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://vernon.utah.gov/residents/history-of-vernon/"
    },
    {
      "id": 5,
      "text": "Vernon residents used the waters from Vernon Creek and other small streams to irrigate their crops and gardens.",
      "sourceSentenceIds": [
        28
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://vernon.utah.gov/residents/history-of-vernon/"
    },
    {
      "id": 6,
      "text": "Vernon is located in southeastern Tooele County within the Salt Lake City Metropolitan Statistical Area.",
