  "facts": [
    {
      "id": 1,
      "text": "Minden was named after the German town of Minden, honoring the heritage of its early settlers.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://mindeniowa.com/history"
    },
    {
      "id": 2,
      "text": "The town grew around a station on the Chicago, Rock Island and Pacific Railroad Line beside Keg Creek, after James Crow petitioned for it.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://mindeniowa.com/history"
    },
    {
      "id": 3,
      "text": "German immigrants, many who had lived elsewhere first, formed the core of Minden’s early population.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://mindeniowa.com/history"
    },
    {
      "id": 4,
      "text": "Caspar Foster, an early settler from Davenport, bought 10,000 acres along the Rock Island road and required a station be built there.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://mindeniowa.com/history"
    },
    {
      "id": 5,
      "text": "Minden’s post office has been in operation since 1875, marking its long-standing community presence.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Minden%2C_Iowa"
    },
    {
      "id": 6,
      "text": "Minden sits within Pottawattamie County in western Iowa, part of the United States.",
