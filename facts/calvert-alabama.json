  "facts": [
    {
      "id": 1,
      "text": "Calvert grew around the Mobile and Ohio Railroad in the 1850s, becoming a late 19th‑century rail and timber hub.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/calvert_alabama"
    },
    {
      "id": 2,
      "text": "The 2,400‑acre ThyssenKrupp steel plant opened in 2010, bringing high‑strength steel production to the town.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/calvert_alabama"
    },
    {
      "id": 3,
      "text": "In 2014, ArcelorMittal and Nippon Steel bought the plant, renaming it AM/NS Calvert, employing about 1,700 workers.",
      "sourceSentenceIds": [
        25
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/calvert_alabama"
    },
    {
      "id": 4,
      "text": "The Calvert United Methodist Church, built in 1889, is listed on the Alabama Register of Landmarks and Heritage.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/calvert_alabama"
    },
    {
      "id": 5,
      "text": "The Tombigbee River lies roughly 10 miles west, shaping the area’s alluvial soils and wetlands.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/calvert_alabama"
    },
    {
      "id": 6,
      "text": "Calvert’s economy shifted from agriculture and timber to modern manufacturing, with the steel industry now its main driver.",
