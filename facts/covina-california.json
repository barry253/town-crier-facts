  "facts": [
    {
      "id": 1,
      "text": "Covina was founded in 1882 by Joseph Swift Phillips on a 2,000‑acre tract bought from John Edward Hollenbeck.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Covina%2C_California"
    },
    {
      "id": 2,
      "text": "The city’s name was given by engineer Frederick Eaton, who chose “Covina” for its pleasant sound.",
      "sourceSentenceIds": [
        14
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://covina.com/about-covina/"
    },
    {
      "id": 3,
      "text": "The Southern Pacific Railroad arrived in 1884, and its tracks still run just north of downtown Covina.",
      "sourceSentenceIds": [
        20
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Covina%2C_California"
    },
    {
      "id": 4,
      "text": "Covina’s Firehouse Jail Museum, the city’s first municipal building, opened in 1979 and now houses local artifacts.",
      "sourceSentenceIds": [
        6,
        21
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://covinamuseum.org/"
    },
    {
      "id": 5,
      "text": "In the early 1900s, Covina shipped more oranges than any other town on earth, earning it a citrus‑era reputation.",
      "sourceSentenceIds": [
        27
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://covinamuseum.org/"
    },
    {
      "id": 6,
      "text": "Long before settlers, the Tongva people inhabited the Covina area for thousands of years, shaping its earliest history.",
