  "facts": [
    {
      "id": 1,
      "text": "Maeystown was founded in 1852 by Jacob Maeys, who built a sawmill on McRoberts Meadow.",
      "sourceSentenceIds": [
        1,
        13,
        16
      ],
      "sourceLabels": [
        "Web source 1",
        "Wikipedia"
      ],
      "source": "https://maeystown.com/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Three streams descend the bluff that borders Maeystown, giving the village its picturesque valley setting.",
      "sourceSentenceIds": [
        1,
        2,
        9
      ],
      "sourceLabels": [
        "Web source 1",
        "Web source 2",
        "Wikipedia"
      ],
      "source": "https://maeystown.com/",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The entire village, except a small strip, is listed on the National Register of Historic Places as the Maeystown Historic District.",
      "sourceSentenceIds": [
        4,
        19
      ],
      "sourceLabels": [
        "Web source 1",
        "Wikipedia"
      ],
      "source": "https://maeystown.com/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Maeystown’s original stone church, built 1865‑67, held German services until 1943, reflecting the town’s Bavarian roots.",
      "sourceSentenceIds": [
        27,
        29
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://maeystown.com/",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Zeitinger’s Mill, one of sixty historic buildings, still stands beside the creek, showcasing 19th‑century milling technology.",
      "sourceSentenceIds": [
        30
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://maeystown.com/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Jacob Maeys first surveyed and laid off the town in 1856, naming it “Maeysville” before it became Maeystown.",
      "sourceSentenceIds": [
        18,
        13
      ],
      "sourceLabels": [
        "Wikipedia",
