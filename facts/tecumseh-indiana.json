  "facts": [
    {
      "id": 1,
      "text": "Tecumseh sits on the Wabash River and was named after the Shawnee leader who fought General Harrison at Fort Harrison just a mile south.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Tecumseh%2C_Indiana",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Before becoming Tecumseh, the site was called Durkee's Ferry, a vital 1818 river crossing that handled wagons, livestock, and pedestrians between Vincennes and the north.",
      "sourceSentenceIds": [
        3,
        8
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/tecumseh_indiana",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "A post office opened in Tecumseh in 1882 and stayed open until 1907, marking the town’s brief period as a local mail hub.",
      "sourceSentenceIds": [
        16
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Tecumseh%2C_Indiana",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Tecumseh is part of the Terre Haute metropolitan area, linking it to a larger regional community.",
      "sourceSentenceIds": [
        13
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Tecumseh%2C_Indiana",
      "category": "other",
      "quality": "poor",
      "qualityReason": "location_description"
    },
    {
      "id": 5,
      "text": "The area was opened to white settlement after the 1809 Treaty of Fort Wayne, which ceded nearly three million acres from Miami, Wea, and other tribes.",
