  "facts": [
    {
      "id": 1,
      "text": "Crosbyton was founded in 1908 by Julian Bassett, who drew the town in the dirt with his boot.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://visitcrosbycounty.com/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The city was named for land office commissioner Stephen Crosby, after whom the county also bears his name.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Crosbyton%2C_Texas",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The Crosby County Pioneer Memorial Museum holds over 45,000 artifacts, including a replica of the 1876 Hank Smith Rock House.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://visitcrosbyton.com/stories/crosbyton-texas-ultimate-travel-guide/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Blanco Canyon, called the \"Little Grand Canyon,\" offers drives, historic markers from the 1871 battle, and wildlife viewing.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://visitcrosbyton.com/stories/crosbyton-texas-ultimate-travel-guide/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The 1914 Crosby County Courthouse in downtown showcases early 20th‑century architecture.",
      "sourceSentenceIds": [
        13
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://visitcrosbyton.com/stories/crosbyton-texas-ultimate-travel-guide/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The Crosbyton‑South Plains Railroad began operations on April 10, 1911, sparking a cotton boom that still defines the region.",
