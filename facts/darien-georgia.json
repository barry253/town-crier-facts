  "facts": [
    {
      "id": 1,
      "text": "Darien was founded January 1736 by Scottish Highlanders recruited by James Oglethorpe as settler‑soldiers to guard Georgia’s frontier.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Darien%2C_Georgia"
    },
    {
      "id": 2,
      "text": "The town was originally called New Inverness before being renamed Darien in honor of the failed Scottish Darien scheme in Panama.",
      "sourceSentenceIds": [
        2,
        10
      ],
      "sourceLabels": [
        "Web source 1",
        "Web source 2"
      ],
      "source": "https://discoverdarien.com/our-history/"
    },
    {
      "id": 3,
      "text": "Darien hosts Fort King George Historic Site, the first fort on Georgia soil, now a preserved landmark.",
      "sourceSentenceIds": [
        21
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://discoverdarien.com/our-history/"
    },
    {
      "id": 4,
      "text": "In 1819 the Bank of Darien opened, becoming one of the South’s most influential banks thanks to the cotton trade.",
      "sourceSentenceIds": [
        14
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.georgiaencyclopedia.org/articles/counties-cities-neighborhoods/darien/"
    },
    {
      "id": 5,
      "text": "Darien’s downtown thrives on its historic heritage and waterfront, drawing visitors to its preserved streets and river views.",
      "sourceSentenceIds": [
        19
