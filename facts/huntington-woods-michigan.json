  "facts": [
    {
      "id": 1,
      "text": "Huntington Woods earned the nickname “City of Homes” because its streets, like York and Dundee, were named after English counties.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.ci.huntington-woods.mi.us/residents/city_history.php"
    },
    {
      "id": 2,
      "text": "About 41% of the city’s houses were built in the 1950s, a boom fueled by FHA loans and mid‑century modern design.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/Huntington_Woods,_Michigan"
    },
    {
      "id": 3,
      "text": "In 1821, Michigan Territorial Governor Lewis Cass signed a treaty that ceded the land now occupied by Huntington Woods to the United States.",
      "sourceSentenceIds": [
        3,
        7
      ],
      "sourceLabels": [
        "Web source 1",
        "Web source 2"
      ],
      "source": "https://www.ci.huntington-woods.mi.us/residents/city_history.php"
    },
    {
      "id": 4,
      "text": "The early 1920s saw Detroit executives build English‑influenced Tudor homes in Huntington Woods, shaping its upscale residential character.",
      "sourceSentenceIds": [
        11,
        12
      ],
      "sourceLabels": [
        "Web source 1",
        "Web source 2"
      ],
      "source": "https://www.ci.huntington-woods.mi.us/residents/city_history.php"
    },
    {
      "id": 5,
      "text": "Huntington Woods preserves the historic Palmer Woods neighborhood, a patch of early‑20th‑century architecture that remains a local landmark.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/Huntington_Woods,_Michigan"
    },
    {
      "id": 6,
      "text": "Rackham Golf Course, owned by Detroit, occupies roughly one‑fifth of Huntington Woods’ land and is a notable green space.",
