      ],
      "source": "https://en.wikipedia.org/wiki/Inverness%2C_Nova_Scotia",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town's name, Baile Inbhir Nis, reflects its Gaelic heritage, celebrated by the local council.",
      "sourceSentenceIds": [
        5,
        3
      ],
      "sourceLabels": [
        "Wikipedia",
