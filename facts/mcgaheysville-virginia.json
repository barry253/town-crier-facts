        5,
        6
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://kids.kiddle.co/McGaheysville,_Virginia",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Cave Hill Farm, listed on the National Register of Historic Places, sits near McGaheysville.",
