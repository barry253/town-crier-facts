      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Reverend Lawrence Wartman, a Lutheran preacher from Pennsylvania, began preaching in the area in 1757, before the town existed.",
      "sourceSentenceIds": [
        8
