  "facts": [
    {
      "id": 1,
      "text": "The community of Eckert, Colorado, takes its name from Isadora “Dora” Eckert States, wife of the first postmaster.",
      "sourceSentenceIds": [
        1,
        25
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Eckert%2C_Colorado",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Eckert’s post office opened on October 27, 1891, becoming the town’s first formal institution.",
      "sourceSentenceIds": [
        10,
        23
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Eckert%2C_Colorado",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Eckert sits in the Surface Creek Valley on the southern slopes of Grand Mesa, within Colorado’s fertile North Fork Valley.",
      "sourceSentenceIds": [
        5,
        14
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/eckert_colorado",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Early settlers arriving between 1880 and 1890 cleared piñon, cedar, and sagebrush to prepare land for orchards and ranching.",
      "sourceSentenceIds": [
        20
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/eckert_colorado",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "In 1915, a water pipeline from Grand Mesa enabled orchard irrigation, prompting Eckert residents to join Orchard City informally.",
      "sourceSentenceIds": [
        16,
        30
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/eckert_colorado",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Each spring, Eckert hosts Crane Days, a festival celebrating the migration of thousands of sandhill cranes through the valley.",
