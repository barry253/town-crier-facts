    },
    {
      "id": 2,
      "text": "Guilford’s covered bridge, built in 1879, is the county’s only surviving covered bridge and anchors the Guilford Covered Bridge Park.",
      "sourceSentenceIds": [
        16,
        18,
        20
      ],
      "sourceLabels": [
