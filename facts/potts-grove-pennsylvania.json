  "facts": [
    {
      "id": 1,
      "text": "Pottsgrove Manor, built in 1752, showcases early Georgian architecture and the lives of John and Ruth Potts and their 13 children.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.montgomerycountypa.gov/930/Pottsgrove-Manor",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The manor sits on four acres that belong to Montgomery County’s Division of Parks, Trails, and Historic Sites.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.montgomerycountypa.gov/930/Pottsgrove-Manor",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Guided tours recount ironmaster John Potts’s role as founder of Pottstown, justice of the peace, and Pennsylvania General Assembly representative.",
      "sourceSentenceIds": [
        16
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.montgomerycountypa.gov/930/Pottsgrove-Manor",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Visitors learn about the enslaved and indentured people who lived and labored in the Potts family home.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.montgomerycountypa.gov/930/Pottsgrove-Manor",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Potts Grove lies along Pennsylvania Route 642, just 3.3 miles east‑southeast of Milton.",
      "sourceSentenceIds": [
        15
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Potts_Grove%2C_Pennsylvania",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "When the Potts first bought the land, they owned 995 acres along the Schuylkill River, including mills, a forge, and Pottstown.",
