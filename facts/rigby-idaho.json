      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The Jefferson County Historical Museum, housed in a 1914 building, showcases pioneer life, Native American traditions, and the early television era.",
      "sourceSentenceIds": [
        4,
        1
      ],
      "sourceLabels": [
        "Web source 2",
