      ],
      "source": "https://www.gemstatepdr.com/visit-rigby/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Founded in 1884 by members of the Church of Jesus Christ of Latter‑Day Saints, Rigby grew as settlers sought rich soil in eastern Idaho.",
      "sourceSentenceIds": [
        6,
        2
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 2"
      ],
      "source": "https://en.wikipedia.org/wiki/Rigby%2C_Idaho",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Rigby’s Farnsworth Monument honors the town’s most famous resident and his pivotal role in television history.",
      "sourceSentenceIds": [
        5,
        18
      ],
      "sourceLabels": [
        "Web source 2",
