  "facts": [
    {
      "id": 1,
      "text": "Folklore says Cumbola was named after a foreign woman shouting 'Come, Bola' for her lost cow, but records point to a Welsh origin.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/cumbola_pennsylvania"
    },
    {
      "id": 2,
      "text": "Cumbola sprang up in the early 1800s as a coal patch town, with the Clarkson Slope and Cumbola Shaft producing 450,000 tons by 1852 before mines were abandoned.",
      "sourceSentenceIds": [
        3,
        4,
        13,
        14
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/cumbola_pennsylvania"
    },
    {
      "id": 3,
      "text": "Cumbola sits at 40°42′42″N 76°08′18″W, perched in the Appalachian foothills of Schuylkill County.",
      "sourceSentenceIds": [
        21
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/cumbola_pennsylvania"
    },
    {
      "id": 4,
      "text": "The town enjoys a humid continental climate, with January lows around 21°F and July highs near 84°F, giving about 160 frost‑free days.",
      "sourceSentenceIds": [
        27,
        28
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/cumbola_pennsylvania"
    },
    {
      "id": 5,
      "text": "Historical records note that Cumbola once had a post office and railroad service, key to its early growth.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://roadsidethoughts.com/pa/cumbola-xx-schuylkill-profile.htm"
    },
    {
      "id": 6,
      "text": "Before coal, German and English settlers farmed the Schuylkill River valley, laying the groundwork for Blythe Township where Cumbola now lies.",
