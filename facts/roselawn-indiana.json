  "facts": [
    {
      "id": 1,
      "text": "Roselawn was platted on May 16, 1882, by Orlando Rose and Alonzo “Lon” Craig, who helped shape the town’s early layout.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/Roselawn,_Indiana",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town’s name comes from the first names of its founders, Orlando Rose and Lon Craig, blending their surnames into Roselawn.",
      "sourceSentenceIds": [
        14
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Roselawn%2C_Indiana",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The arrival of the Monon Railroad in the 1880s opened Roselawn to travelers, turning the prairie into a connected community.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/Roselawn,_Indiana",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Roselawn hosts a branch of the Newton County Public Library, offering residents access to regional books and community programs.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Roselawn%2C_Indiana",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Since 1933, Roselawn has been known for its nudist resorts, including the Ponderosa Sun Club and Sun Aura, drawing visitors from across the state.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Roselawn%2C_Indiana",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "A post office has served Roselawn continuously since 1881, marking the town’s long-standing role as a local hub.",
      "sourceSentenceIds": [
        15
