  "facts": [
    {
      "id": 1,
      "text": "Pallini traces its origins to ancient Pallene, one of Attica’s twelve cities noted by Herodotus and a key battleground in the Peloponnesian War.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.trawellino.com/destinations/greece/attica_pallini",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Perched at about 150 meters, Pallini lies in a plain between the Penteliko and Hymettus mountains, just 14 kilometers east of Athens city centre.",
      "sourceSentenceIds": [
        9,
        10,
        11
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Pallini",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Greek National Road 54, the Athens–Rafina artery, cuts through Pallini, linking the capital with the coastal port of Rafina.",
      "sourceSentenceIds": [
        13
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Pallini",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The nearby Geraneia Mountain range offers hikers scenic trails and panoramic views overlooking the Athens basin.",
      "sourceSentenceIds": [
        18
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.trawellino.com/destinations/greece/attica_pallini",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Olympic pole‑vault champion Katerina Stefanidi, born in 1990, hails from Pallini and has earned Greece a gold medal.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Pallini",
      "category": "people",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "In 2011, Pallini municipality was created by merging the former municipalities of Anthousa, Gerakas and Pallini into one administrative unit.",
