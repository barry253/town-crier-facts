  "facts": [
    {
      "id": 1,
      "text": "South Van Horn grew from a 1902 gold discovery by Felix Pedro, sparking a rush that helped Fairbanks become a supply hub by 1903.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/south_van_horn_alaska",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The area experiences a subarctic Dfc climate, with winters dropping below -40°F and summers reaching up to 70°F.",
      "sourceSentenceIds": [
        21,
        23
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/south_van_horn_alaska",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The community hosts many pipeline tool and welding supply businesses, making it a key industrial hub in the Fairbanks area.",
      "sourceSentenceIds": [
        13
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/south_van_horn_alaska",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "A striking 54% of South Van Horn’s housing units are mobile homes, yet the neighborhood boasts a 97% homeownership rate.",
      "sourceSentenceIds": [
        14
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/south_van_horn_alaska",
      "category": "other",
      "quality": "poor",
      "qualityReason": "editorial_filler"
    },
    {
      "id": 5,
      "text": "The terrain is flat to gently rolling, typical of Interior Alaska’s glacial outwash plains and river deposits.",
      "sourceSentenceIds": [
        20
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/south_van_horn_alaska",
      "category": "nature",
      "quality": "good"
    },
    {
