  "facts": [
    {
      "id": 1,
      "text": "Named after Pierre Bourg, an Acadian settler who received a Spanish land grant before 1803, Bourg emerged as a rural outpost along the bayous.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/bourg_louisiana"
    },
    {
      "id": 2,
      "text": "Acadian exiles began migrating into the area in the late 1700s, forming the foundation of Bourg.",
      "sourceSentenceIds": [
        11
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/bourg_louisiana"
    },
    {
      "id": 3,
      "text": "Cajun culture from Acadian exiles shaped language, traditions, and land use in Bourg.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/bourg_louisiana"
    },
    {
      "id": 4,
      "text": "Proximity to the Gulf of Mexico influences tidal flows and sediment deposition in Bourg's low-lying bayous.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/bourg_louisiana"
    },
    {
      "id": 5,
      "text": "The Bourg Branch of the Terrebonne Parish Library System closed permanently after Hurricane Ida damage.",
      "sourceSentenceIds": [
