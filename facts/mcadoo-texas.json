    },
    {
      "id": 3,
      "text": "A post office opened in March 1915 with Benjamin Hines as its first postmaster, marking McAdoo’s emergence as a formal settlement.",
      "sourceSentenceIds": [
        28
      ],
      "sourceLabels": [
        "Web source 1"
