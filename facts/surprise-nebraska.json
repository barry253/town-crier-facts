      ],
      "source": "https://kids.kiddle.co/Surprise,_Nebraska",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The Surprise Opera House, built in 1913, hosted performances until its last show in 1954 and now sits on the National Register.",
      "sourceSentenceIds": [
        22,
        8,
        11
      ],
      "sourceLabels": [
        "Wikipedia",
        "Wikipedia",
        "Web source 2"
      ],
      "source": "https://en.wikipedia.org/wiki/Surprise%2C_Nebraska",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The Big Blue River, flowing through Surprise, was vital to early settlers, powering the mill and supplying ice in winter.",
      "sourceSentenceIds": [
        14,
        9,
        5
      ],
      "sourceLabels": [
        "Wikipedia",
