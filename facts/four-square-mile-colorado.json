  "facts": [
    {
      "id": 1,
      "text": "Four Square Mile’s name comes from the four square miles bounded by Quebec Street, Mississippi Avenue, Havana Street and Yale Avenue.",
      "sourceSentenceIds": [
        13
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Four_Square_Mile%2C_Colorado",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The community is wrapped by Denver on the north, west and south, and by Aurora on the east.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Four_Square_Mile%2C_Colorado",
      "category": "other",
      "quality": "poor",
      "qualityReason": "location_description"
    },
    {
      "id": 3,
      "text": "In the early 1970s Denver and Aurora fought over the area, with Denver annexing land east of Quebec Street and Aurora taking land west of Havana Street.",
      "sourceSentenceIds": [
        14
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Four_Square_Mile%2C_Colorado",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Denver’s annexations were halted by the Poundstone Amendment, while Aurora annexed up to Dayton Street in 1984, leaving most of the four square miles unincorporated.",
      "sourceSentenceIds": [
        15
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Four_Square_Mile%2C_Colorado",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The Four Square Mile CDP includes the former unincorporated community of Sullivan.",
      "sourceSentenceIds": [
        16
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Four_Square_Mile%2C_Colorado",
      "category": "other",
      "quality": "poor",
      "qualityReason": "editorial_filler"
    },
    {
      "id": 6,
      "text": "The CDP spans 1,729 acres (6.997 km²), all of which is land.",
      "sourceSentenceIds": [
        17
      ],
      "sourceLabels": [
