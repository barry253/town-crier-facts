  "facts": [
    {
      "id": 1,
      "text": "The town’s name comes from a 1797 belief that Canton, China, was antipodal to it, a story suggested by Elijah Dunbar.",
      "sourceSentenceIds": [
        7,
        8
      ],
      "sourceLabels": [
        "Web source 2",
        "Wikipedia"
      ],
      "source": "https://www.britannica.com/place/Canton-Massachusetts"
    },
    {
      "id": 2,
      "text": "The Canton Viaduct, built in 1835, is one of only two surviving multiple‑arch stone railroad bridges still in active mainline use in the U.S.",
      "sourceSentenceIds": [
        16
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Canton%2C_Massachusetts"
    },
    {
      "id": 3,
      "text": "During the American Revolution, Paul Revere set up a gunpowder factory in Canton and later built the first U.S. copper rolling mill and brass works.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.britannica.com/place/Canton-Massachusetts"
    },
    {
      "id": 4,
      "text": "The Old Stoughton Music Society, now housed in the Canton Historical Society building, claims the title of America’s oldest choral society.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Canton%2C_Massachusetts"
    },
    {
      "id": 5,
      "text": "Crossing the Neponset River, the Canton Viaduct stands as a prominent local landmark and a testament to 19th‑century engineering.",
