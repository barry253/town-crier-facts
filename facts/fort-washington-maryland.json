  "facts": [
    {
      "id": 1,
      "text": "Fort Washington earned its name from the historic fort that once guarded the Potomac River.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Fort_Washington%2C_Maryland"
    },
    {
      "id": 2,
      "text": "Despite its formidable walls, the fort never saw combat in either the War of 1812 or the Civil War.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.nps.gov/places/fort-washington-md.htm"
    },
    {
      "id": 3,
      "text": "Fort Washington sits about 20 miles south of downtown Washington, D.C., overlooking the Potomac River.",
      "sourceSentenceIds": [
        14
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Fort_Washington%2C_Maryland"
    },
    {
      "id": 4,
      "text": "The original 1809 fort was the sole defensive structure protecting Washington, D.C., before the larger stone fort was built.",
      "sourceSentenceIds": [
        15
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Fort_Washington%2C_Maryland"
    },
    {
      "id": 5,
      "text": "In 1844, a cannon exploded aboard the USS Princeton as it passed Fort Washington, startling nearby troops.",
      "sourceSentenceIds": [
        19
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Fort_Washington%2C_Maryland"
    },
    {
      "id": 6,
      "text": "Today, the former fort grounds have become a park with scenic views of the Potomac and winding hiking paths.",
