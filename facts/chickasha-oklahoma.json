  "facts": [
    {
      "id": 1,
      "text": "Chickasha sprang to life in 1892 when the Chicago, Rock Island and Pacific Railway crossed the Washita River.",
      "sourceSentenceIds": [
        4,
        15
      ],
      "sourceLabels": [
        "Web source 1",
        "Web source 2"
      ],
      "source": "https://www.chickasha.gov/550/Historic-Chickasha"
    },
    {
      "id": 2,
      "text": "The Rock Island Train Depot, built the same year, remains Chickasha’s oldest monumental building and earned a spot on the National Register in 1985.",
      "sourceSentenceIds": [
        25,
        26
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.chickasha.gov/550/Historic-Chickasha"
    },
    {
      "id": 3,
      "text": "The University of Science & Arts of Oklahoma, Oklahoma’s first state‑legislated college, opened in Chickasha in 1908 as the Oklahoma Industrial Institute.",
      "sourceSentenceIds": [
        13,
        14
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Chickasha%2C_Oklahoma"
    },
    {
      "id": 4,
      "text": "In 2001 Chickasha became an Oklahoma Certified City and earned Blue Ribbon Community status for its civic achievements.",
      "sourceSentenceIds": [
        17
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.chickasha.gov/550/Historic-Chickasha"
    },
    {
      "id": 5,
      "text": "A historic schoolhouse in Chickasha once served black children in Grady County and was added to the National Register of Historic Places in 2005.",
      "sourceSentenceIds": [
