      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "A guided tour of Southside’s radical past reveals stories from bank robberies to slave‑trade links that shaped the neighbourhood.",
      "sourceSentenceIds": [
        13
      ],
