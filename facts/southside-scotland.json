      "quality": "good"
    },
    {
      "id": 3,
      "text": "Aviation history on Southside remembers G&WJ Weir, whose Autogiro experiments in Cathcart prefigured modern helicopters.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 1"
      ],
