    },
    {
      "id": 3,
      "text": "The Schering pharmaceutical company, founded in 1864 on Müllerstraße, later became part of Bayer.",
      "sourceSentenceIds": [
        21
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Wedding_(Berlin)"
    },
    {
      "id": 4,
      "text": "Wedding’s Rotaprint plant, started in 1904, once employed about 1,000 workers, making it a major local employer.",
      "sourceSentenceIds": [
