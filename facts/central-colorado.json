      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Central_City%2C_Colorado",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The Gilpin History Museum, housed in an old schoolhouse, showcases artifacts from the gold‑rush era.",
