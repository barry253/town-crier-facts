  "facts": [
    {
      "id": 1,
      "text": "Taradale gets its name from a developer’s daughter, Tara, whose story is woven into the neighborhood’s early history.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Taradale%2C_Calgary",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Taradale was annexed by Calgary in 1961 and officially established as a community in 1984, marking its transition from rural land to suburban development.",
      "sourceSentenceIds": [
        24
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Taradale%2C_Calgary",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Residents enjoy one of Calgary’s safest neighborhoods, consistently ranking among the city’s lowest crime rates.",
      "sourceSentenceIds": [
        29
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Taradale%2C_Calgary",
      "category": "other",
      "quality": "poor",
      "qualityReason": "vague"
    },
    {
      "id": 5,
      "text": "Local families send their children to Taradale Elementary School and Ted Harrison Middle School, two of the area’s primary public schools.",
      "sourceSentenceIds": [
        30
