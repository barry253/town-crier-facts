  "facts": [
    {
      "id": 1,
      "text": "Dahlonega gets its name from the Cherokee word Talonega, meaning 'golden,' a nod to its gold‑rush past.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Dahlonega%2C_Georgia",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The Dahlonega Gold Museum Historic Site occupies the 1836 Lumpkin County Courthouse, one of Georgia’s oldest public buildings.",
      "sourceSentenceIds": [
        3,
        6
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 2"
      ],
      "source": "https://en.wikipedia.org/wiki/Dahlonega%2C_Georgia",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Dahlonega was the birthplace of Georgia’s first gold rush, kicking off in 1829.",
      "sourceSentenceIds": [
        28
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Dahlonega%2C_Georgia",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Dahlonega hosts the University of North Georgia, the state’s second‑oldest public university.",
      "sourceSentenceIds": [
        13,
        27
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Dahlonega%2C_Georgia",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The Dahlonega Mint once struck rare gold coins and produced a 5‑ounce nugget now on display at the museum.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.exploredahlonega.com/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Dahlonega’s historic Public Square buzzes with gift shops, restaurants, art galleries, and wine‑tasting rooms.",
