  "facts": [
    {
      "id": 1,
      "text": "Onyx was originally called Scodie, named after Prussian immigrant William Scodie who opened a store in 1861 to serve miners and freighters.",
      "sourceSentenceIds": [
        1,
        6
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Onyx%2C_California"
    },
    {
      "id": 2,
      "text": "The historic Onyx Store, built in 1880 and moved to align with State Highway 178, remains a landmark since its founding in 1861.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/onyx_california"
    },
    {
      "id": 3,
      "text": "The community sits beside the South Fork Kern River, whose waters occasionally ripple through the otherwise dry valley.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/onyx_california"
    },
    {
      "id": 4,
      "text": "Nearby Sequoia National Forest shapes Onyx’s foothills with Jeffrey pine and Utah juniper, linking lowland woodlands to higher conifer forests.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/onyx_california"
    },
    {
      "id": 5,
      "text": "Onyx’s first post office opened in 1889, marking its growth into a recognized settlement.",
