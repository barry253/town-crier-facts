  "facts": [
    {
      "id": 1,
      "text": "Mount Vernon was founded in 1817 by Zadok Casey, who later became Illinois lieutenant governor.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Mount_Vernon%2C_Illinois",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The city’s name honors George Washington’s Mount Vernon plantation, itself named for British naval hero Edward Vernon.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Mount_Vernon%2C_Illinois",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "In the 19th century, Mount Vernon became a crossroads for progress along the historic Vandalia Road, a key travel route.",
      "sourceSentenceIds": [
        1,
        5
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.mtvernon.com/city-government/about-us/",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The National Railway Equipment Company, born from local car shops, now rebuilds locomotives for railroads worldwide, showcasing the town’s enduring innovation.",
      "sourceSentenceIds": [
        19
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.mtvernon.com/city-government/about-us/",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The C.E. Brehm Memorial Public Library, a Carnegie library built in 1905, remains a downtown landmark and community hub.",
      "sourceSentenceIds": [
        24
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Mount_Vernon%2C_Illinois",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The Jefferson County Historical Village and the Appellate Courthouse, where Abraham Lincoln once tried a case, offer a glimpse into the town’s legal heritage.",
      "sourceSentenceIds": [
        22
      ],
