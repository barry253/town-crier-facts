  "facts": [
    {
      "id": 1,
      "text": "Denton began as Eden Town, named for Sir Robert Eden, the last royal governor of Maryland, and later shortened to Denton.",
      "sourceSentenceIds": [
        13
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Denton%2C_Maryland"
    },
    {
      "id": 2,
      "text": "The town was officially incorporated in 1802, solidifying its status as the county seat of Caroline County.",
      "sourceSentenceIds": [
        14
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Denton%2C_Maryland"
    },
    {
      "id": 3,
      "text": "A historic steamboat pier still stands in Denton, a relic of the town’s 19th‑century river trade.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Denton%2C_Maryland"
    },
    {
      "id": 4,
      "text": "In 1835, Denton opened its first factory, producing plows that helped feed the region’s growing agriculture.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://dentonmaryland.com/about-denton/denton-history/"
    },
    {
      "id": 5,
      "text": "The Choptank River once carried steamships between Denton and Cambridge, linking the town to the wider Chesapeake trade.",
      "sourceSentenceIds": [
