  "facts": [
    {
      "id": 1,
      "text": "Prineville was founded in 1868 and named after Barney Prine, the first merchant to establish businesses in the area.",
      "sourceSentenceIds": [
        1,
        5
      ],
      "sourceLabels": [
        "Web source 2",
        "Wikipedia"
      ],
      "source": "https://welcometoprineville.com/prineville-historical-matters/"
    },
    {
      "id": 2,
      "text": "Known as the Cowboy Capital of Oregon, Prineville reflects a rich history of ranching and rodeo culture.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://discoverprineville.com/prineville-oregon/"
    },
    {
      "id": 3,
      "text": "Prineville residents once voted 355 to 1 to build their own railway after being bypassed by major railroad tycoons.",
      "sourceSentenceIds": [
        19,
        20
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Prineville%2C_Oregon"
    },
    {
      "id": 4,
      "text": "Apple and Facebook have each invested over one billion dollars in multiple data centers located within Prineville city limits.",
      "sourceSentenceIds": [
        21
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Prineville%2C_Oregon"
    },
    {
      "id": 5,
      "text": "Prineville is located on the Crooked River at the mouth of Ochoco Creek, northwest of the Prineville Reservoir.",
      "sourceSentenceIds": [
        22
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Prineville%2C_Oregon"
    },
    {
      "id": 6,
      "text": "Barnes Butte, located partially within the city, was formed by great basaltic flows during the Miocene and Oligocene epochs.",
