  "facts": [
    {
      "id": 1,
      "text": "Greenwood Village takes its name from the historic Greenwood Ranch that once dotted the area.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Greenwood_Village%2C_Colorado",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The Cherry Creek Schoolhouse, built in 1874, sits on the high school campus and is the oldest surviving school in the town.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Greenwood_Village%2C_Colorado",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Settlers first arrived in the 1860s, drawn by the fertile prairie and the promise of gold, before the area became a farming community.",
      "sourceSentenceIds": [
        18
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Greenwood_Village%2C_Colorado",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Greenwood Village didn’t become an incorporated city until 1950, after decades of informal ranch and farming life.",
      "sourceSentenceIds": [
        19
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Greenwood_Village%2C_Colorado",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The 1970s saw a boom as the Denver Technological Center spurred rapid growth and reshaped the town’s skyline.",
      "sourceSentenceIds": [
        20
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Greenwood_Village%2C_Colorado",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "In the 1980s, the city’s annexation of prime properties along the I‑25 corridor effectively froze Denver’s expansion and set the stage for future boundary disputes.",
      "sourceSentenceIds": [
        21
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
