    {
      "id": 2,
      "text": "Rufus is located in the high desert and is home to wildlife like porcupines, coyotes, and ospreys.",
      "sourceSentenceIds": [
        13
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Rufus%2C_Oregon"
    },
    {
      "id": 3,
      "text": "The town of Rufus grew into a lively center with a hotel, bakery, and saloon by the late nineteenth century.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Web source 1"
      ],
