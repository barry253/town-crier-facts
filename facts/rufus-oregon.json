    },
    {
      "id": 4,
      "text": "Rufus is bordered on the northern side by the Columbia River and the John Day Dam.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Rufus%2C_Oregon"
    },
    {
      "id": 5,
      "text": "Native American groups visited Rufus for thousands of years to quarry petrified wood for creating stone tools.",
