  "facts": [
    {
      "id": 1,
      "text": "In 1893, James Havely built one of Woodstock's first houses, a Queen Anne style residence on SE 40th Avenue now a historic landmark.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Woodstock%2C_Portland%2C_Oregon"
    },
    {
      "id": 2,
      "text": "The neighborhood was named Woodstock after Walter Scott's 1826 novel, following a trend of naming subdivisions after romantic novels.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Woodstock%2C_Portland%2C_Oregon"
    },
    {
      "id": 3,
      "text": "Woodstock is one of Portland's very first neighborhoods, first platted in 1889, with some houses dating back to the 1880s.",
      "sourceSentenceIds": [
        11,
        19
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Woodstock%2C_Portland%2C_Oregon"
    },
    {
      "id": 4,
      "text": "The Woodstock Library and Community Center sit amid churches and local shops, forming the village center that anchors community life.",
      "sourceSentenceIds": [
        7,
        8,
        9
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 2"
      ],
      "source": "https://en.wikipedia.org/wiki/Woodstock%2C_Portland%2C_Oregon"
    },
    {
      "id": 5,
      "text": "Before 1850s, Woodstock's land was wilderness; in 1852 Archon Kelly claimed 320 acres, later selling it back to his brother in 1863.",
      "sourceSentenceIds": [
        22,
        23,
        25,
        27
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Woodstock%2C_Portland%2C_Oregon"
    },
    {
      "id": 6,
      "text": "Early electricity and water for Woodstock were arranged by James Havely, helping the neighborhood grow into a modern suburb.",
