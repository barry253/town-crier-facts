  "facts": [
    {
      "id": 1,
      "text": "Holt was founded in 1902 as a company town by the Central Iron and Coal Company to house workers for the region’s iron and coal industry.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/holt_alabama",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Holt was named for Frank Holt, a officer who bought the land in 1901 and oversaw furnace and cast‑iron pipe foundry that became the largest of its kind.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/holt_alabama",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "In 1941 the company entered receivership, and the entire village—379 homes on 777.9 acres—was auctioned for $103,000 to Birmingham businessman William H.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/holt_alabama",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Holt High School, built in 2018, carries the Ironmen mascot, a nod to the town’s foundry‑worker heritage.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/holt_alabama",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The Mobile and Ohio Railroad built a 13‑mile branch line in 1903 from Holt to Kellerman, linking coal mines to furnaces and river barges.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/holt_alabama",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Summer highs in Holt often reach 92°F (33°C), while winter lows average around 32°F (0°C), and the area is prone to severe thunderstorms and tornadoes in spring.",
      "sourceSentenceIds": [
        7
      ],
