      ],
      "source": "https://en.wikipedia.org/wiki/Grant_Township%2C_St._Clair_County%2C_Michigan",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The Pere Marquette Railroad cut through Jeddo’s western side, making it a passenger stop on the line.",
      "sourceSentenceIds": [
        10,
        13
      ],
      "sourceLabels": [
        "Web source 1",
        "Web source 2"
      ],
      "source": "https://99wfmk.com/jeddo-michigan/",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Along the tracks once stood a coal shed, depot, elevator, and pickle factory, showcasing 19th‑century industry.",
