  "facts": [
    {
      "id": 1,
      "text": "Saint‑Henri’s first factory, the Moseley Tannery, was built in 1859 on the site now known as Parc des Corroyeurs.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://walkmontreal.com/walks/saint-henri/"
    },
    {
      "id": 2,
      "text": "The neighborhood’s name honors Saint Henry, whose namesake church, Église Saint‑Henri, reflects its long working‑class heritage.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.mtl.org/en/experience/saint-henri-montreal-quartier-cool"
    },
    {
      "id": 3,
      "text": "Saint‑Henri’s history stretches back to the mid‑1600s, when French‑Canadian, Irish, and Black settlers first established the area.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://walkmontreal.com/walks/saint-henri/"
    },
    {
      "id": 4,
      "text": "The railway cuts through the back of Parc des Corroyeurs, a reminder of the industrial buildings that once defined Saint‑Henri.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://walkmontreal.com/walks/saint-henri/"
    },
    {
      "id": 5,
      "text": "Estelle, a converted historic garage on Courcelle Street, showcases Saint‑Henri’s modern culinary scene while preserving its industrial past.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.mtl.org/en/experience/saint-henri-montreal-quartier-cool"
    },
    {
      "id": 6,
      "text": "The statue of Louis Cyr, the famed Quebec strongman and former policeman, stands in Saint‑Henri, honoring a local legend.",
      "sourceSentenceIds": [
        18
      ],
      "sourceLabels": [
        "Web source 1"
      ],
