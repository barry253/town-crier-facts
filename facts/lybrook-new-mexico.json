    {
      "id": 1,
      "text": "Georgia O'Keeffe drew inspiration from Lybrook’s Black Place during visits between 1936 and 1949, shaping a major portion of her abstract work.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/lybrook_new_mexico",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Lybrook began as a 20th‑century waypoint, linking Farmington and Albuquerque along rough travel routes across northwestern New Mexico.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/lybrook_new_mexico",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The Lybrook Badlands display towering hoodoos and clay domes, sculpted by wind and water from the Paleocene Nacimiento Formation.",
      "sourceSentenceIds": [
        18,
        19
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/lybrook_new_mexico",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Because the badlands are a protected fossil area, the Bureau of Land Management limits access to high‑clearance vehicles and provides no facilities.",
      "sourceSentenceIds": [
        22,
        23
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/lybrook_new_mexico",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The rugged terrain of Lybrook’s badlands offers no on‑site facilities, preserving its fragile, scenic expanse of valleys and spires.",
      "sourceSentenceIds": [
        20
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/lybrook_new_mexico",
      "category": "nature",
      "quality": "poor",
      "qualityReason": "vague"
    },
    {
      "id": 6,
      "text": "Will Lybrook, a Virginia‑born homesteader, founded the community in the early 1920s after expanding his holdings to nearly 9,000 acres across three counties.",
      "sourceSentenceIds": [
