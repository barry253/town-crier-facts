  "facts": [
    {
      "id": 1,
      "text": "Loma got its name in 1911, likely from Spanish for 'hill', after the Great Northern Railway renamed the station from Marias.",
      "sourceSentenceIds": [
        1,
        2
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/loma_montana",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "A historical marker sits on a bluff overlooking the rivers, providing beautiful views of the confluence.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://centralmontana.com/communities/loma/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Lewis and Clark Expedition arrived at the confluence on June 2, 1805, mapping the area and caching supplies for their return.",
      "sourceSentenceIds": [
        11,
        12
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/loma_montana",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Fort Piegan, an American Fur Company trading post, was established in 1831 at the confluence but was abandoned after a Blackfeet siege.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/loma_montana",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "On January 15, 1972, a chinook wind lifted Loma’s temperature from −54°F to 49°F in 24 hours, a record 103°F jump.",
