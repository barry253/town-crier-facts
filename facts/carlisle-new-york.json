      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Carlisle%2C_New_York",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "In the 19th century, Carlisle was known for manufacturing plows, a key industry that helped shape its economy.",
      "sourceSentenceIds": [
