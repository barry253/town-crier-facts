      ],
      "source": "https://en.wikipedia.org/wiki/Carlisle%2C_New_York",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Civil War Medal of Honor recipient John Snyders Kenyon was born on May 5, 1843, in the hamlet of Grovenor Corners.",
