      ],
      "source": "https://www.britannica.com/place/Bellefontaine",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The Mad River & Lake Erie Railroad reached Bellefontaine in 1837, sparking the town’s long‑standing railroading legacy.",
      "sourceSentenceIds": [
        8,
        9
      ],
      "sourceLabels": [
        "Wikipedia"
