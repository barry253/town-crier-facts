  "facts": [
    {
      "id": 1,
      "text": "Benton’s name comes from either Senator Thomas Hart Benton of Missouri, a western expansion champion, or from 'Ben's Town' after early merchant Benjamin Looney.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/Benton%2C_Louisiana",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Bossier Parish, where Benton sits, was carved from Claiborne Parish on February 24, 1843, as Louisiana expanded after statehood.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/Benton%2C_Louisiana",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Benton grew as a modest administrative hub, benefiting from Barksdale’s payroll, contracts, and retiree spending while keeping its small‑scale, agrarian character.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/Benton%2C_Louisiana",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Benton serves as the parish seat of Bossier Parish, anchoring local government and civic life.",
      "sourceSentenceIds": [
        13
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Benton%2C_Louisiana",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Historic routes linked Benton-area plantations to markets via the Red River and Cane's Landing, underscoring riverine commerce before railroads.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/Benton%2C_Louisiana",
      "category": "transport",
      "quality": "good"
    }
