    },
    {
      "id": 2,
      "text": "Fair Oaks lies at the south end of Driver Valley and along Calapooya Creek.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Fair_Oaks%2C_Oregon"
    },
    {
      "id": 3,
      "text": "Fair Oaks operated its own post office from 1878 through 1882 before mail was routed through Oakland.",
      "sourceSentenceIds": [
        13
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Fair_Oaks%2C_Oregon"
    },
    {
      "id": 4,
      "text": "The Fair Oaks History Center displays early Native American Maidu artifacts and historic relics from local homes and businesses.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://fairoakshistory.org/center/"
    },
    {
      "id": 5,
      "text": "Volunteers at the Fair Oaks History Center created permanent exhibits chronicling the area from 1895 through the Aerojet era of the 1960s.",
      "sourceSentenceIds": [
