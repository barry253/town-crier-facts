  "facts": [
    {
      "id": 1,
      "text": "Honeoye’s name comes from the Seneca word ha‑ne‑a‑yah, meaning “lying finger,” a story about a rattlesnake bite that led a Native American to cut off his finger.",
      "sourceSentenceIds": [
        26,
        27
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Honeoye%2C_New_York",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "A house in Honeoye once served as a stop on the Underground Railroad and remains a private residence today.",
      "sourceSentenceIds": [
        1,
        8
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Honeoye%2C_New_York",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The hamlet sits at the north end of Honeoye Lake, one of the Finger Lakes that stretches across western New York.",
      "sourceSentenceIds": [
        21
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Honeoye%2C_New_York",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Every Friday night, the Honeoye Public Library hosts free concerts in its community gazebo, drawing locals and visitors alike.",
      "sourceSentenceIds": [
        17
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.visitfingerlakes.com/plan-your-trip/ontario-county-ny/richmond-honeoye-and-canadice/",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "In the 19th century, dense forests around Honeoye supplied timber that helped build Syracuse, Rochester, and Buffalo; deforestation later spurred the rise of summer cottages by the 1920s.",
