    },
    {
      "id": 3,
      "text": "Little and Samuel Sprout erected a steam‑powered factory at Main and Factory Streets, making wagon bows and sleigh parts.",
      "sourceSentenceIds": [
        19
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://picturerocksborough.com/boroughgovernment/history/"
    },
    {
      "id": 4,
      "text": "The first local factory produced sashes, doors, and window blinds, provoking debate among carpenters who feared losing their craft.",
      "sourceSentenceIds": [
