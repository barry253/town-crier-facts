  "facts": [
    {
      "id": 1,
      "text": "New Springville was founded in 1680 as Karle's Neck Village, located near Staten Island’s geographical center.",
      "sourceSentenceIds": [
        1,
        2
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 2"
      ],
      "source": "https://en.wikipedia.org/wiki/New_Springville%2C_Staten_Island",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "By the early 19th century, a dock on Richmond Creek and several freshwater springs prompted the community to rename itself first Springville, then New Springville.",
      "sourceSentenceIds": [
        3,
        4
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 2"
      ],
      "source": "https://en.wikipedia.org/wiki/New_Springville%2C_Staten_Island",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The 19th‑century LaTourette House in New Springville earned a spot on the National Register of Historic Places in 1982.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/New_Springville%2C_Staten_Island",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "New Springville remained largely rural until 1964, when suburban development began reshaping the neighborhood.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/New_Springville%2C_Staten_Island",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The Yukon Bus Depot, opened in the early 1980s, can accommodate 380 buses and serves as a major transit hub.",
      "sourceSentenceIds": [
        15
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/New_Springville%2C_Staten_Island",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "New Springville now hosts eight schools, including the Space Shuttle Columbia Elementary School and new intermediate and high schools.",
      "sourceSentenceIds": [
        24
