      "quality": "good"
    },
    {
      "id": 2,
      "text": "A century after the first Whitaker couple settled, the Wilmington and Weldon Railroad cut the town in two, literally dividing it.",
      "sourceSentenceIds": [
        7,
        9
      ],
      "sourceLabels": [
        "Web source 1",
