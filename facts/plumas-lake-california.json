  "facts": [
    {
      "id": 1,
      "text": "Plumas Lake was first conceived in 1993 to guide development along the Feather and Bear Rivers.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Plumas_Lake%2C_California",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Construction began in 2003, and the planned community will eventually host about 12,000 homes and 36,000 residents.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Plumas_Lake%2C_California",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The area suffered major floods in 1986 and 1997, yet the levee system has since been upgraded and FEMA rated the site as moderate‑to‑low flood risk in 2019.",
      "sourceSentenceIds": [
        10,
        13
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Plumas_Lake%2C_California",
      "category": "other",
      "quality": "poor",
      "qualityReason": "editorial_filler"
    },
    {
      "id": 4,
      "text": "The old settlement of Plumas Landing, also called Plumas City, once stood west of the current community and was affected by hydraulic mining during the Gold Rush.",
      "sourceSentenceIds": [
        6,
        7
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Plumas_Lake%2C_California",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "A seasonal backwater, Algodon Slough, connects the community’s north and south ends and flows into the Bear River.",
