  "facts": [
    {
      "id": 1,
      "text": "The name \"Parsippany\" comes from the Lenape word \"Parseponong,\" meaning \"the place where the waters come together,\" a nod to the local streams.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
