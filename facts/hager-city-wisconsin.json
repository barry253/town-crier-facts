  "facts": [
    {
      "id": 1,
      "text": "Hager City grew from the expansion of the railroad in 1886, when trains replaced steamboats as the primary transport on the Mississippi.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://wigrr.com/community/hager-city/"
    },
    {
      "id": 2,
      "text": "The village was originally platted as Hager Chatfield in 1886 before the Postmaster General suggested the name Hager City the following year.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://mississippivalleytraveler.com/hager-city/"
    },
    {
      "id": 3,
      "text": "Hager City features the Bow and Arrow rock formation, a geological arrangement on the bluffs that points toward the waters of Lake Pepin.",
      "sourceSentenceIds": [
        7,
        16
      ],
      "sourceLabels": [
        "Web source 1",
        "Web source 2"
      ],
      "source": "https://wigrr.com/community/hager-city/"
    },
    {
      "id": 4,
      "text": "Archaeologist Jacob Brower first noted the Bow and Arrow petroform in 1902, though some believe the rocks actually form a bird effigy.",
      "sourceSentenceIds": [
        17,
        18
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://mississippivalleytraveler.com/hager-city/"
    },
    {
      "id": 5,
      "text": "Hager City holds the distinction of having the first post office established within its township.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://mississippivalleytraveler.com/hager-city/"
    },
    {
      "id": 6,
      "text": "The Harbor Bar in Hager City is known for serving Jamaica-inspired entrées and jerk chicken to locals and boaters.",
      "sourceSentenceIds": [
        22,
        23
      ],
      "sourceLabels": [
