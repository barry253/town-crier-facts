  "facts": [
    {
      "id": 1,
      "text": "Lolo sits at the confluence of Lolo Creek and the Bitterroot River, serving as a gateway to the Bitterroot Mountains and the expansive Lolo National Forest.",
      "sourceSentenceIds": [
