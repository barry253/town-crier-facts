      "category": "nature",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Lewis and Clark camped at Travelers' Rest near Lolo from September 9–11, 1805, planning their westward route after a harsh winter.",
      "sourceSentenceIds": [
        7,
        10,
        22
      ],
      "sourceLabels": [
        "Web source 2",
        "Web source 1",
