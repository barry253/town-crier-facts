  "facts": [
    {
      "id": 1,
      "text": "Pollok began as a sawmill center in the 1880s when Richard Blair built a mill on the railroad six miles northwest of Clawson.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.tshaonline.org/handbook/entries/pollok-tx",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town’s post office opened in 1886, and the name Pollok entered common use shortly after.",
      "sourceSentenceIds": [
        28
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.tshaonline.org/handbook/entries/pollok-tx",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "In 1888 Pollok boasted two general stores and a thriving sawmill, reflecting its early lumber economy.",
      "sourceSentenceIds": [
        29
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.tshaonline.org/handbook/entries/pollok-tx",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "A church founded as Warren Chapel Baptist Church in 1891 later became Pollok Baptist Church by 1896, serving both worship and schooling.",
      "sourceSentenceIds": [
        4,
        25
      ],
      "sourceLabels": [
        "Web source 2",
        "Wikipedia"
      ],
      "source": "https://www.historictexas.net/city/pollok-texas",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The Woodmen of the World headstone in Pollok stands as a memorial and symbol of the community’s roots in sawmills.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.historictexas.net/city/pollok-texas",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The Pollok Cemetery Association, founded in 1950, maintains the local cemetery, preserving the town’s heritage.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.historictexas.net/city/pollok-texas",
      "category": "history",
