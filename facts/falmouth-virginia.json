  "facts": [
    {
      "id": 1,
      "text": "Founded in 1728 by the same act that created Fredericksburg, Falmouth was built as a port on the Rappahannock to serve northern residents.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Falmouth%2C_Virginia",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The Falmouth Historic District, listed on the National Register in 1970, still preserves Federal‑era buildings that survived the town’s early commercial boom.",
      "sourceSentenceIds": [
        9,
        10
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.dhr.virginia.gov/historic-registers/089-0067/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Belmont, the former home of artist Gari Melchers, now operates as a museum administered by the University of Mary Washington.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Falmouth%2C_Virginia",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Hunter's Ironworks, also known as Rappahannock Forge, was an iron furnace protected by Thomas Jefferson during the American Revolution.",
      "sourceSentenceIds": [
        17,
        18
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Falmouth%2C_Virginia",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The Falmouth Road, a colonial route, connected Winchester in the Shenandoah Valley to the port of Falmouth.",
      "sourceSentenceIds": [
        19
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Falmouth%2C_Virginia",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "In 1776 county lines were redrawn, moving Falmouth from King George County into Stafford County.",
