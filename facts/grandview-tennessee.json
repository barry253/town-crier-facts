  "facts": [
    {
      "id": 1,
      "text": "The Grandview Heritage Foundation, founded in 2000, preserves the town’s history and runs the Grandview History Center.",
      "sourceSentenceIds": [
        2,
        4
      ],
      "sourceLabels": [
        "Web source 2",
        "Web source 1"
      ],
      "source": "https://www.rheaheraldnews.com/news/article_9d0a1d2e-a979-11ed-a447-5394fe27ced9.html"
    },
    {
      "id": 2,
      "text": "In 2021 the Foundation partnered with the Tennessee Historical Commission to install new historical markers across Grandview.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.rheaheraldnews.com/news/article_9d0a1d2e-a979-11ed-a447-5394fe27ced9.html"
    },
    {
      "id": 3,
      "text": "Motorists passing through Grandview now see these markers, making it easier to learn about the community’s past while on the road.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.rheaheraldnews.com/news/article_9d0a1d2e-a979-11ed-a447-5394fe27ced9.html"
    },
    {
      "id": 4,
      "text": "The Grandview History Center houses the Grand View Normal Institute Memorial Library, a 5200‑volume collection that survived since 1884.",
      "sourceSentenceIds": [
        4,
        7,
        11
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grandviewheritage.org/"
    },
    {
      "id": 5,
      "text": "The Center’s archive includes over 2000 photographs pre‑dating 1920, offering a visual window into early Grandview families.",
      "sourceSentenceIds": [
        16
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grandviewheritage.org/"
    },
    {
      "id": 6,
      "text": "Visitors can tour the History Center on Thursdays and Saturdays from noon to four, or schedule appointments by calling 916‑710‑1747.",
      "sourceSentenceIds": [
        18,
        19
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grandviewheritage.org/"
    }
  ]
