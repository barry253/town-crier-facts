  "facts": [
    {
      "id": 1,
      "text": "Phoenixville got its name from the Phoenix Iron Works, the town’s major employer until the plant closed in 1987.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Phoenixville%2C_Pennsylvania"
    },
    {
      "id": 2,
      "text": "The town’s first nail factory, the French Creek Nail Works, opened in 1790 and became the first U.S. nail factory.",
      "sourceSentenceIds": [
        15
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Phoenixville%2C_Pennsylvania"
    },
    {
      "id": 3,
      "text": "In 1936 Phoenixville recorded Pennsylvania’s highest temperature, 111 °F, on July 10.",
      "sourceSentenceIds": [
        23
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Phoenixville%2C_Pennsylvania"
    },
    {
      "id": 4,
      "text": "The Black Rock Tunnel, the third railroad tunnel built in the U.S., runs under Phoenixville’s north side.",
      "sourceSentenceIds": [
        25
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Phoenixville%2C_Pennsylvania"
    },
    {
      "id": 5,
      "text": "The Historical Society of the Phoenixville Area houses an extensive archive, including the famous Phoenix Column artifact.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://hspa-pa.org/"
    },
    {
      "id": 6,
      "text": "Phoenixville’s historic district, created in 1987, is the largest National Register of Historic Places site in Chester County.",
