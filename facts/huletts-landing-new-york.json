  "facts": [
    {
      "id": 1,
      "text": "Huletts Landing derives its name from the Hulett family, who settled after Revolutionary War soldier David Hulett farmed the lakeside.",
      "sourceSentenceIds": [
        16
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
