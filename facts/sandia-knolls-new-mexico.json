    },
    {
      "id": 2,
      "text": "Sandia Knolls faces moderate wildfire risk, with dry conditions, piñon‑juniper fuels, and steep topography accelerating fire spread uphill.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/sandia_knolls_new_mexico"
    },
    {
      "id": 3,
      "text": "The 18‑acre Sandia Knolls Open Space, donated in 1956, remains the county’s oldest preserved property.",
      "sourceSentenceIds": [
        11
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/sandia_knolls_new_mexico"
    },
    {
      "id": 4,
      "text": "Sandia Knolls sits at 6,903 feet above sea level, offering high‑altitude views.",
      "sourceSentenceIds": [
        17
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/sandia_knolls_new_mexico"
    },
    {
      "id": 5,
      "text": "Piñon‑juniper woodlands dominate Sandia Knolls, supporting mule deer, black bears, and diverse bird species.",
      "sourceSentenceIds": [
        20
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/sandia_knolls_new_mexico"
    },
    {
      "id": 6,
      "text": "Sandia Knolls enjoys a semi‑arid continental climate, with July highs around 84°F and January lows near 22°F.",
