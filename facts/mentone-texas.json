  "facts": [
    {
      "id": 1,
      "text": "Mentone was named after Menton, France, by a French surveyor, becoming the second community with name in Loving County; the first was founded in 1893 and abandoned in 1905.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Mentone%2C_Texas",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Mentone was designated a Recorded Texas Historic Landmark in 1967 as the \"Smallest County Seat in Texas\".",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Mentone%2C_Texas",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The town’s historic courthouse, the smallest in the state, sits beside the relocated Mentone Community Church, both listed as Recorded Texas Historic Landmarks.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://unitedstatesghosttowns.com/mentone-texas-ghost-town/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Once bustling with five cafés and multiple gas stations, Mentone now shows significant urban decay with abandoned, deteriorating buildings.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://unitedstatesghosttowns.com/mentone-texas-ghost-town/",
      "category": "other",
      "quality": "poor",
      "qualityReason": "other"
    },
    {
      "id": 5,
      "text": "The first business in Mentone was the Loving County Lumber Company, founded in 1930.",
      "sourceSentenceIds": [
        14
