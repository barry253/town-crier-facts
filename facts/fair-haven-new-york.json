  "facts": [
    {
      "id": 1,
      "text": "Fair Haven was named by early settlers from the native word 'see-see-lich-em', meaning 'safe port' or 'quiet place'.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.enjoyfairhaven.com/history/"
    },
    {
      "id": 2,
      "text": "Fair Haven was founded in 1883 by Daniel J. Harris, who envisioned a thriving lakeside community.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.enjoyfairhaven.com/history/"
    },
    {
      "id": 3,
      "text": "The Southern Central Railroad served Fair Haven from 1872 until 1887, when it merged into the Lehigh Valley Railroad.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Fair_Haven%2C_New_York"
    },
    {
      "id": 4,
      "text": "A wooden outer lighthouse with a fourth-order Fresnel lens marked Fair Haven's west pier, and a keeper's house still stands.",
      "sourceSentenceIds": [
        19
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Fair_Haven%2C_New_York"
    },
    {
      "id": 5,
      "text": "Cottage Farm on Richmond Avenue, next to the Community Church, earned a National Register of Historic Places spot in 2012.",
