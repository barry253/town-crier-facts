  "facts": [
    {
      "id": 1,
      "text": "Peninsula was first settled in 1818 and plotted in 1837, earning its name from a large bend in the Cuyahoga River.",
      "sourceSentenceIds": [
        5,
        30
      ],
      "sourceLabels": [
        "Web source 1",
        "Wikipedia"
      ],
      "source": "https://explorepeninsula.org/explore-peninsula/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The village’s historic Bronson Memorial Church, built in 1835 as Bethel Church, was remodeled in Gothic Revival style in 1889.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Peninsula%2C_Ohio",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "During the Ohio and Erie Canal era, Peninsula boasted 14 bars, 5 hotels, sandstone quarries, and boatyards, making it a bustling canal town.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://explorepeninsula.org/explore-peninsula/",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The 1886 Stick-style Boston Township Hall, once the village high school, now houses the Cuyahoga Valley Historical Museum.",
      "sourceSentenceIds": [
        6,
        8
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Peninsula%2C_Ohio",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "More than 20 Peninsula buildings are listed on the National Register of Historic Places, preserving its 1800s charm.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Peninsula%2C_Ohio",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The Cuyahoga Valley Scenic Railroad still departs from Peninsula’s historic depot, offering a picturesque ride through the valley.",
      "sourceSentenceIds": [
        10,
