  "facts": [
    {
      "id": 1,
      "text": "Edgard was renamed in 1850 after postmaster Edgar Perret, originally named John the Baptist for its Catholic church.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Edgard%2C_Louisiana",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town sits on the historic German Coast, settled by German immigrants in the 1720s and 1730s, with land grants issued to families.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.wikixm.com/us/la/edgard/overview",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The Whitney Plantation, just outside Edgard, serves as a memorial to enslaved people who worked sugar fields and is a powerful historical site.",
      "sourceSentenceIds": [
        15
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.wikixm.com/us/la/edgard/overview",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Arrival of railroads in the late 19th century, including the Mississippi River line, transformed Edgard’s economy by enabling efficient transport of sugar to New Orleans.",
      "sourceSentenceIds": [
        16
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.wikixm.com/us/la/edgard/overview",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "John the Baptist Catholic Church, built in 1772 and rebuilt in the 1830s, draws visitors interested in colonial and antebellum history.",
      "sourceSentenceIds": [
        13
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.wikixm.com/us/la/edgard/overview",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Dave Bartholomew, a musician and songwriter, was inducted into the Rock and Roll Hall of Fame in 1991.",
