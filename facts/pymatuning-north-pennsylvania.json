  "facts": [
    {
      "id": 1,
      "text": "Pymatuning North takes its name from Lenape chief Pihmtomink, the indigenous leader who once ruled the area.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.experiencepa.com/pymatuning-state-park/",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Glacial forces carved long ridges, broad uplands, and linear valleys that now host natural lakes and wetlands around Pymatuning.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.pa.gov/agencies/dcnr/recreation/where-to-go/state-parks/find-a-park/pymatuning-state-park/history",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "In 1935 the Civilian Conservation Corps built Camp NP‑11‑PA, a historic CCC camp still visible on the park’s grounds.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.pa.gov/agencies/dcnr/recreation/where-to-go/state-parks/find-a-park/pymatuning-state-park/history",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Black Jack Swamp Natural Area preserves a fragment of the once‑vast Great Pymatuning Swamp that covered the region.",
      "sourceSentenceIds": [
        20
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.pa.gov/agencies/dcnr/recreation/where-to-go/state-parks/find-a-park/pymatuning-state-park/history",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Pymatuning Reservoir, straddling the northeastern side of the town, ranks among Pennsylvania’s largest reservoirs.",
      "sourceSentenceIds": [
        11
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Pymatuning_North%2C_Pennsylvania",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The area was once home to the Adena Culture, famed mound builders who occupied the land from 3,000 to 1,000 years ago.",
