  "facts": [
    {
      "id": 1,
      "text": "Conejos earned its name from the Spanish word for rabbit, “conejo,” after the county’s plentiful rabbit population.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.uncovercolorado.com/counties/conejos/",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The village of Conejos hosts Colorado’s oldest church, the Our Lady of Guadalupe Catholic Church, founded in 1858 by Spanish colonists from Taos.",
      "sourceSentenceIds": [
        2,
        11
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Conejos%2C_Colorado",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Conejos became the last unincorporated county seat in Colorado, a status it holds today.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Conejos%2C_Colorado",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The county seat moved just 0.6 miles across the Conejos River in 1863, placing the town of Conejos on the opposite bank.",
      "sourceSentenceIds": [
        16
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Conejos%2C_Colorado",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Route 285 skirts Conejos’ eastern edge, leading north 28 miles to Alamosa and south 31 miles to Tres Piedras, New Mexico.",
      "sourceSentenceIds": [
        19
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Conejos%2C_Colorado",
      "category": "other",
      "quality": "poor",
      "qualityReason": "route_only"
    },
    {
      "id": 6,
      "text": "Conejos County, one of Colorado’s last authentic frontiers, offers expansive blue skies, sparkling streams, and abundant game for outdoor enthusiasts.",
      "sourceSentenceIds": [
