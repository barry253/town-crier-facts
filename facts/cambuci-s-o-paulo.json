      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The São Joaquim Parish, built in 1895, stands as a historic landmark and one of the city’s earliest churches.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 1"
      ],
