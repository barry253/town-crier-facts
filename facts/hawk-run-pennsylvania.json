  "facts": [
    {
      "id": 1,
      "text": "Originally called Ashcroft, the name changed in 1892 to Hawk Run for miners.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://gantnews.com/2021/09/02/throwback-thursday-hawk-run-a-long-ago-railway-thoroughfare/",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "It is located on the north side of Moshannon Creek, the Clearfield/Centre County boundary, approximately 3 miles north of Philipsburg via Pennsylvania Route 53.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Hawk_Run%2C_Pennsylvania",
      "category": "other",
      "quality": "poor",
      "qualityReason": "location_description"
    },
    {
      "id": 3,
      "text": "The logging railroad crossed over both the New York Central Railroad and the Centre and Clearfield Company trolley line in Hawk Run.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://gantnews.com/2021/09/02/throwback-thursday-hawk-run-a-long-ago-railway-thoroughfare/",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The Hawk Run trolley bridge opened on March 20, 1904, spanning about 100 feet across Moshannon Creek.",
      "sourceSentenceIds": [
        14,
        15
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://gantnews.com/2021/09/02/throwback-thursday-hawk-run-a-long-ago-railway-thoroughfare/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The Goodyear Mining Company operated in Hawk Run until the 1940s, providing jobs for early 20th‑century immigrants.",
      "sourceSentenceIds": [
        11,
        12
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://gantnews.com/2021/09/02/throwback-thursday-hawk-run-a-long-ago-railway-thoroughfare/",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Whitmer and Steele Company ran a mill in Hawk Run from 1910 to about 1915, processing local timber.",
