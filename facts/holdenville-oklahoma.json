  "facts": [
    {
      "id": 1,
      "text": "Holdenville was originally a settlement known as Echo, which is a Creek word meaning deer.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.okhistory.org/publications/enc/entry?entry=HO011"
    },
    {
      "id": 2,
      "text": "Railroad workers named Holdenville in honor of J.F. Holden, the Auditor and Traffic Manager of the Choctaw, Oklahoma and Gulf Railroad.",
      "sourceSentenceIds": [
        13,
        14
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Holdenville%2C_Oklahoma"
    },
    {
      "id": 3,
      "text": "The Holdenville Fall Festival was originally called Hog Wild Day to celebrate the local economy with hog-calling and pie-eating contests.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Holdenville%2C_Oklahoma"
    },
    {
      "id": 4,
      "text": "Holdenville is the birthplace of filmmaker Sterlin Harjo and Major League Baseball pitcher Dizzy Dean.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Holdenville%2C_Oklahoma"
    },
    {
      "id": 5,
      "text": "Several historic sites in Holdenville are listed on the National Register of Historic Places, including the City Hall and the National Guard Armory.",
      "sourceSentenceIds": [
        21
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.okhistory.org/publications/enc/entry?entry=HO011"
    },
    {
      "id": 6,
      "text": "Billionaire businessman Boone Pickens donated funds to expand the local public library, which was renamed in honor of his mother.",
