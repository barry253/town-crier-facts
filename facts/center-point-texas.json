  "facts": [
    {
      "id": 1,
      "text": "Center Point sits on the Guadalupe River, eight miles southeast of Kerrville in southeastern Kerr County.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.tshaonline.org/handbook/entries/center-point-tx-kerr-county",
      "category": "other",
      "quality": "poor",
      "qualityReason": "location_description"
    },
    {
      "id": 2,
      "text": "The community was originally called Zanzenburg, named by Charles de Ganahl after his Austrian hometown, before becoming Center Point in 1872.",
      "sourceSentenceIds": [
        27,
        28,
        2
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.tshaonline.org/handbook/entries/center-point-tx-kerr-county",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Settlers from western Tennessee founded the town, bringing relatives and neighbors who converged on the Guadalupe River to make Zanzenburg/Center Point their new home.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.hillcountryportal.com/centerpoint.html",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "In 1905, Buckner of Bandera County launched the weekly Center Point News, becoming the town’s first local newspaper.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.tshaonline.org/handbook/entries/center-point-tx-kerr-county",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Center Point Cemetery, the largest Texas Ranger burial site in the state, stands as a historic landmark for the town.",
      "sourceSentenceIds": [
