  "facts": [
    {
      "id": 1,
      "text": "Stagecoach’s name comes from the Desert Well Station, a key stop on the Overland Stagecoach line that ferried mail and passengers to California.",
      "sourceSentenceIds": [
        10,
        28
      ],
      "sourceLabels": [
        "Web source 1",
        "Wikipedia"
      ],
      "source": "https://grokipedia.com/page/stagecoach_nevada",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "In 1857, Desert Well Station doubled as a Pony Express stop, linking Nevada to the rest of the country.",
      "sourceSentenceIds": [
        29
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Stagecoach%2C_Nevada",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "After the Civil War, the First Transcontinental Railroad made stagecoach travel obsolete, ending Stagecoach’s era by the 1870s.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/stagecoach_nevada",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Stagecoach grew into a quiet bedroom community in the late 1900s, far from the bustle of nearby cities.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/stagecoach_nevada",
      "category": "other",
      "quality": "poor",
      "qualityReason": "editorial_filler"
    },
    {
      "id": 5,
      "text": "Desert Well Station sits about a mile south of today’s Stagecoach, marking the historic travel corridor.",
