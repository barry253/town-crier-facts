  "facts": [
    {
      "id": 1,
      "text": "Stotonic Village sits in a valley once crisscrossed by Hohokam canals up to 20 miles long, a marvel of ancient irrigation.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/stotonic_village_arizona",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The O'odham name S‑totoñigk, meaning 'many ants,' reflects Stotonic Village’s long‑standing indigenous heritage.",
      "sourceSentenceIds": [
        20
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/stotonic_village_arizona",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "In 2004, the Gila River Indian Community secured 653,543 acre‑feet of water rights, ensuring reliable irrigation for Stotonic Village.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/stotonic_village_arizona",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Around 1400‑1450, Hohokam villages in the area abandoned, driven by droughts, floods, and social upheaval.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/stotonic_village_arizona",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "After the 1960s, Stotonic Village’s tribal government re‑structured its constitution, boosting self‑determination.",
      "sourceSentenceIds": [
        26
