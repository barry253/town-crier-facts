  "facts": [
    {
      "id": 1,
      "text": "Allerton began as a 3,800‑acre tract purchased by Samuel Allerton in 1880, laying the groundwork for the village that would follow.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Allerton%2C_Illinois",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "When the Chicago & Eastern Illinois railroad arrived, Allerton granted a right‑of‑way, built a grain elevator, bank, school, and installed a water system.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Allerton%2C_Illinois",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The village sits in Sidell Township of Vermilion County, with a small slice spilling into neighboring Champaign County.",
      "sourceSentenceIds": [
        4,
        5
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Allerton%2C_Illinois",
      "category": "other",
      "quality": "poor",
      "qualityReason": "location_description"
    },
    {
      "id": 4,
      "text": "Samuel Allerton, a prominent Vermilion County landowner, made his fortune trading agricultural products and livestock across the Midwest.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Allerton%2C_Illinois",
      "category": "people",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Samuel Allerton’s 12,000‑acre Piatt County holdings later became Robert Allerton Park, a notable green space west of Monticello.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Allerton%2C_Illinois",
      "category": "people",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Across four Midwest states, Samuel Allerton controlled roughly 78,000 acres, making him one of the era’s largest landholders.",
      "sourceSentenceIds": [
        11
