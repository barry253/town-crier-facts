  "facts": [
    {
      "id": 1,
      "text": "Peabody was named after philanthropist George Peabody in 1868, honoring the man born in the area.",
      "sourceSentenceIds": [
        23
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Peabody%2C_Massachusetts",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The city’s leather industry once shipped hides worldwide, with railroad tracks crisscrossing downtown to move the goods.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://peabodyhistorical.org/history/",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "In 1930, Eastman Gelatin Corporation produced gelatin for Kodak film at the former American Glue factory on Washington Street.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://peabodyhistorical.org/history/",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The Peabody Leatherworkers Museum opened in 2009 on Washington Street, celebrating the town’s rich leather‑tanning heritage.",
      "sourceSentenceIds": [
        11
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://peabodyhistorical.org/history/",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Peabody’s Northshore Mall, opened in 1958 on former farm land owned by millionaire Elias Hasket Derby, remains one of the region’s largest shopping centers.",
      "sourceSentenceIds": [
        4,
        5
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Peabody%2C_Massachusetts",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The Peabody Institute Library, founded in 1852 after a bequest from George Peabody, is one of the oldest public libraries in Massachusetts.",
