  "facts": [
    {
      "id": 1,
      "text": "Kerby was named for James Kerby, who co-founded the town as a potential county seat during the gold mining heyday.",
      "sourceSentenceIds": [
        2,
        3,
        5
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Kerby%2C_Oregon"
    },
    {
      "id": 2,
      "text": "The community of Kerby came into existence between 1854 and 1857 in southwestern Josephine County.",
      "sourceSentenceIds": [
        11,
        22
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Kerby%2C_Oregon"
    },
    {
      "id": 3,
      "text": "Kerby sits on the east side of the Illinois River valley, a north-flowing tributary of the Rogue River.",
      "sourceSentenceIds": [
        23
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Kerby%2C_Oregon"
    },
    {
      "id": 4,
      "text": "Kerby served as the Josephine County seat until the title moved to Grants Pass in 1886.",
      "sourceSentenceIds": [
        5,
        20
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Kerby%2C_Oregon"
    },
    {
      "id": 5,
      "text": "The Kerbyville Museum was established in 1959 to preserve the local history of the area.",
