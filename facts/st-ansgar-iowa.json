  "facts": [
    {
      "id": 1,
      "text": "St. Ansgar takes its name from Saint Ansgar, a 9th‑century French monk who evangelized Scandinavia.",
      "sourceSentenceIds": [
        2,
        5
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/St._Ansgar%2C_Iowa",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Founded in 1853 by Norwegian immigrant farmers led by Rev. Claus Lauritz Clausen, St. Ansgar grew from a pioneer Lutheran church.",
      "sourceSentenceIds": [
        1,
        3
      ],
      "sourceLabels": [
        "Web source 1",
        "Wikipedia"
      ],
      "source": "https://www.stansgar.org/about-us",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "A unique fortified stone outbuilding called Fort Severson sits 5.5 miles northwest of St. Ansgar, once a barn‑fort for settlers.",
      "sourceSentenceIds": [
        12,
        15
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/St._Ansgar%2C_Iowa",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The First Lutheran Church of St. Ansgar, built in 1853, remains a historic landmark and center for the town’s Norwegian heritage.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/St._Ansgar%2C_Iowa",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "From the mid‑1850s to the late 1870s, St. Ansgar’s church and community helped disperse Norwegian settlers across northern Iowa and Minnesota.",
      "sourceSentenceIds": [
        10
      ],
