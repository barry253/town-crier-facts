  "facts": [
    {
      "id": 1,
      "text": "Schofield was named for William Scholfield, who arrived in 1851 to open a sawmill, though the city later dropped the letter L.",
      "sourceSentenceIds": [
        1,
        10
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Schofield%2C_Wisconsin"
    },
    {
      "id": 2,
      "text": "Early settlement in Schofield was driven by the lumber industry and an influx of immigrants from Germany and Scandinavia during the mid-1800s.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/schofield_wisconsin"
    },
    {
      "id": 3,
      "text": "Schofield sits at the confluence of the Eau Claire and Wisconsin rivers, serving as an inner suburb just south of Wausau.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/schofield_wisconsin"
    },
    {
      "id": 4,
      "text": "The arrival of the Wisconsin Valley Railroad in 1874 helped shift the local economy from lumber milling to more diversified industries.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/schofield_wisconsin"
    },
    {
      "id": 5,
      "text": "Schofield is located along the eastern shore of Lake Wausau, which is an impoundment of the Wisconsin River.",
      "sourceSentenceIds": [
        11
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Schofield%2C_Wisconsin"
    },
    {
      "id": 6,
      "text": "The Eau Claire Flowage and Eau Claire River both flow into Lake Wausau within the city limits of Schofield.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Schofield%2C_Wisconsin"
    }
