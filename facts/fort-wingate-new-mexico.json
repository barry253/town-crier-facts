  "facts": [
    {
      "id": 1,
      "text": "Fort Wingate was named after Major Benjamin Wingate, a fifth‑rank U.S. Army officer.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Fort_Wingate",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The fort was built on the former site of Fort Lyon, on Navajo land, to control and protect the large Navajo tribe north of Gallup.",
      "sourceSentenceIds": [
        22
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Fort_Wingate",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Fort Wingate’s soldiers guarded the construction of the Atchison, Topeka, and Santa Fe Railroad, helping open the Southwest to settlers.",
      "sourceSentenceIds": [
        13
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.nps.gov/places/fort-wingate-historic-district.htm",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "During World War II, Fort Wingate stored 100 tons of Composition B explosives for the Manhattan Project’s Trinity test before closing in 1993.",
      "sourceSentenceIds": [
        25
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Fort_Wingate",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "In 1978, the Fort Wingate Historic District earned a place on the National Register of Historic Places.",
      "sourceSentenceIds": [
        27
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Fort_Wingate",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The fort’s parade grounds still host an 1883 adobe clubhouse, a barracks, and a row of early‑1900s officers’ quarters.",
      "sourceSentenceIds": [
        17
      ],
      "sourceLabels": [
        "Web source 2"
      ],
