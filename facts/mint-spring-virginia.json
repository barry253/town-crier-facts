  "facts": [
    {
      "id": 1,
      "text": "Mint Spring Tavern, a rare Scots‑Irish settler home from 1749, once served as a tavern, stagecoach stop, post office, and general store.",
      "sourceSentenceIds": [
        14
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/mint_spring_virginia",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The Junction Valley Turnpike, a plank road built in 1853 along the Great Wagon Road, made Mint Spring a key railroad and turnpike stop.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/mint_spring_virginia",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Mint Spring lies about 6.1 miles south‑southwest of Staunton on U.S. Route 11 in the Shenandoah Valley.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Mint_Spring%2C_Virginia",
      "category": "other",
      "quality": "poor",
      "qualityReason": "location_description"
    },
    {
      "id": 4,
      "text": "The valley’s microclimate, with fertile limestone soils and steady rainfall, supports apples, hay, and livestock in Mint Spring.",
      "sourceSentenceIds": [
        26
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/mint_spring_virginia",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Mint Spring sits on a valley floor that offers sweeping views of the Blue Ridge Mountains to the east.",
      "sourceSentenceIds": [
        19
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/mint_spring_virginia",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Folly Mills Creek, about 1.4 miles northwest of Mint Spring, drains into the Middle River watershed of the Shenandoah River system.",
      "sourceSentenceIds": [
