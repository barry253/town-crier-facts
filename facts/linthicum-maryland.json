  "facts": [
    {
      "id": 1,
      "text": "Linthicum began as a railroad town when the Annapolis and Baltimore Short Line opened a station there in 1887, long before the community was officially founded.",
      "sourceSentenceIds": [
        2,
        4
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Linthicum%2C_Maryland",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "In 2006, the Linthicum Heights Historic District earned a spot on the National Register of Historic Places, preserving its 19th‑century character.",
      "sourceSentenceIds": [
        15
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Linthicum%2C_Maryland",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Historic Linthicum Walks, a white‑washed farmhouse listed on the National Register since 1984, dates back to the 18th and 19th centuries and now serves as a community cultural center.",
      "sourceSentenceIds": [
        7,
        10
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.historiclinthicumwalks.org/about",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The town’s name honors Abner Linthicum, whose 1801 land purchase laid the groundwork for the area’s development.",
      "sourceSentenceIds": [
        14
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
