      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "In 1833, Louis‑Tancrède Bouthillier built a country home called Outre‑Mont on Rue McDougall, which still stands today.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
