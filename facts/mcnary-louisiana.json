  "facts": [
    {
      "id": 1,
      "text": "McNary was founded in 1913 as a company town by the Cady Lumber Corporation, founded by William M.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/mcnary_louisiana"
    },
    {
      "id": 2,
      "text": "McNary's early community included many Black families drawn by lumber jobs, shaping it as a self‑contained mill town.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/mcnary_louisiana"
    },
    {
      "id": 3,
      "text": "McNary's infrastructure featured portable houses and railroad‑transportable buildings, reflecting its mobile lumber‑camp origins.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/mcnary_louisiana"
    },
    {
      "id": 4,
      "text": "By 1924, depletion of local timber forced the Cady Lumber Company to cut the last log and abandon McNary.",
      "sourceSentenceIds": [
        11
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/mcnary_louisiana"
    },
    {
      "id": 5,
      "text": "Three days after the last log, 800 workers and families moved en masse to Arizona, leaving McNary largely abandoned but not a ghost town.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/mcnary_louisiana"
    },
    {
      "id": 6,
      "text": "Today remnants of the Cady mill still exist in McNary.",
      "sourceSentenceIds": [
        27
