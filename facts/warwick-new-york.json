  "facts": [
    {
      "id": 1,
      "text": "Warwick, New York, was named after an English town near the ancestral home of early settler Benjamin Aske in the early 1700s.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Warwick%2C_New_York",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Officially established as a town in 1788, Warwick has been a Hudson Valley community for over two centuries.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Warwick%2C_New_York",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The Warwick Valley Railroad, built in 1860, linked the village to the Lehigh and Hudson River Railway and spurred growth.",
      "sourceSentenceIds": [
        18
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.warwickhistory.org/explore",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Historic preservation efforts by the Warwick Historical Society restored downtown buildings and earned the village listings on state and national historic registers.",
      "sourceSentenceIds": [
        20
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.warwickhistory.org/explore",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The Albert Wisner Library, dedicated in 1927, remains a cornerstone of Warwick’s cultural life.",
      "sourceSentenceIds": [
        25
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.warwickhistory.org/explore",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Warwick encompasses three villages—Florida, Greenwood Lake, and Warwick—and eight hamlets, including Amity, Bellvale, and Pine Island.",
      "sourceSentenceIds": [
        27
