  "facts": [
    {
      "id": 1,
      "text": "Lyndon was founded in 1780 and was originally known as Lindsay, named after one of the area's early settlers.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.vermonter.com/lyndon-vermont-town-history/"
    },
    {
      "id": 2,
      "text": "The Passumpsic River flows through the center of Lyndon, providing power for early grist and saw mills.",
      "sourceSentenceIds": [
        27
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Lyndon%2C_Vermont"
    },
    {
      "id": 3,
      "text": "Lyndon is home to the Lyndon Institute, a beautiful Gothic Revival structure built in the late 1800s.",
      "sourceSentenceIds": [
        18
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.vermonter.com/lyndon-vermont-town-history/"
    },
    {
      "id": 4,
      "text": "Bandstand Park in Lyndon features a fountain that was purchased in New York back in 1885.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.lyndonvt.org/"
    },
    {
      "id": 5,
      "text": "Lyndon contains five historic covered bridges and serves as a campus for Vermont State University.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.lyndonvt.org/"
    },
    {
      "id": 6,
      "text": "One resident of Lyndon constructed the first paved road in Vermont, running from the railroad depot to his estate.",
