  "facts": [
    {
      "id": 1,
      "text": "Perrysville was originally called Freeport when it was laid out in 1815, before adopting its current name.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Perrysville%2C_Ohio",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The village’s formal dedication took place on June 10, 1812, along the western bank of Armstrong’s Creek, now known as the Black Fork.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://perrysvilleohio.gov/about/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Early settlers first established a permanent presence in 1810, but the village itself was not officially laid out until 1812.",
      "sourceSentenceIds": [
        30
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Perrysville%2C_Ohio",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "A historic building in Perrysville later housed both Jones Piano and a cigar factory, reflecting the town’s early commercial diversity.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Perrysville%2C_Ohio",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The Cleo Redd Fisher Historical Museum preserves local artifacts and tells the story of Perrysville’s past.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Perrysville%2C_Ohio",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Historic Sanborn Fire Insurance Maps from 1900 and 1912 offer a detailed window into Perrysville’s downtown layout and businesses over a century ago.",
      "sourceSentenceIds": [
        12,
        16
      ],
