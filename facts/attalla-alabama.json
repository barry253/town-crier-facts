  "facts": [
    {
      "id": 1,
      "text": "Attalla was incorporated as a city on February 5, 1872, and officially named in 1893 from a Cherokee word meaning \"my home\" or \"mountain\".",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://attallacity.org/about-us/",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The Museum of Attalla, located at 313 5th Avenue NW, preserves the town’s railroad heritage and everyday life of early families.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://attallacity.org/museum/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Attalla hosts the Tigers for Tomorrow sanctuary, an exotic animal park rescuing confiscated and abandoned wildlife.",
      "sourceSentenceIds": [
        15
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://attallacity.org/about-us/",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "In 1887, Attalla became the site of Alabama’s first hydroelectric dam, providing electricity to the growing community.",
