  "facts": [
    {
      "id": 1,
      "text": "Mardela Springs earned the nickname “town with three names” thanks to its tobacco warehouse, water‑powered mills, a major road, and mineral springs.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://mardelasprings.org/history/",
      "category": "other",
      "quality": "poor",
      "qualityReason": "vague"
    },
    {
      "id": 2,
      "text": "In the mid‑1800s steamboat traffic on the Nanticoke River and the arrival of the railroad in 1890 spurred rapid growth.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://mardelasprings.org/history/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Travelers from the Western Shore would stop in Mardela Springs to break the journey to Ocean City, often staying in boarding houses.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://mardelasprings.org/history/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The town’s history dates back to the mid‑1600s when English fur traders entered the Nanticoke River watershed.",
