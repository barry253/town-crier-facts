      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Otter_Lake%2C_Michigan",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "In 1874, Page & Benson Pine Lumber Company platted the community, setting the stage for rapid growth.",
