  "facts": [
    {
      "id": 1,
      "text": "Metaline Falls was founded in 1900 when most residents worked at the Mammoth and Morning lead‑zinc mines.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Metaline_Falls%2C_Washington"
    },
    {
      "id": 2,
      "text": "The town’s name comes from the abundant galena, or lead ore, that was first mined in 1869.",
      "sourceSentenceIds": [
        14
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Metaline_Falls%2C_Washington"
    },
    {
      "id": 3,
      "text": "In 1910, Metaline Falls joined the Idaho and Washington Northern Railroad, linking it to regional trade.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Metaline_Falls%2C_Washington"
    },
    {
      "id": 4,
      "text": "The historic Cutter Theater, once a schoolhouse, now hosts community events and art shows in downtown Metaline Falls.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Metaline_Falls%2C_Washington"
    },
    {
      "id": 5,
      "text": "The Pend Oreille River snakes through the Selkirk Mountains, creating a dramatic zig‑zag just north of the town.",
      "sourceSentenceIds": [
        26
