    {
      "id": 2,
      "text": "The Haskell Free Library and Opera House in Derby Line was deliberately constructed on the international border in 1904.",
      "sourceSentenceIds": [
        23
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Derby_Line%2C_Vermont"
    },
    {
      "id": 3,
      "text": "Patrons of the Haskell Free Library may use the facility from either side of the border without going through security.",
      "sourceSentenceIds": [
        24
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Derby_Line%2C_Vermont"
    },
    {
      "id": 4,
      "text": "Five inhabited structures in Derby Line are divided by the international border between the United States and Canada.",
      "sourceSentenceIds": [
        25
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Derby_Line%2C_Vermont"
    },
    {
      "id": 5,
      "text": "A tool-and-die factory in Derby Line is divided by the border, though its Canadian side closed in 1982.",
