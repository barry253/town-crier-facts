  "facts": [
    {
      "id": 1,
      "text": "Lexington was founded in the mid‑19th century and has remained a close‑knit community shaped by generations of families, agriculture, and local pride.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://lexingtonal.org/about/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town’s earliest development dates back to the early 1800s, with land settled as early as 1818 near springs feeding Mill Creek.",
      "sourceSentenceIds": [
        23,
        24
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://lexingtonal.org/history/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Lexington’s early industry centered on a cotton gin and sawmill that served farmers within a two‑to‑three‑mile radius, acting as informal gathering places.",
      "sourceSentenceIds": [
        27,
        28
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://lexingtonal.org/history/",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The Lexington Rolling Mill, built near the beginning of the 20th century, was a key part of the town’s early industrial presence.",
      "sourceSentenceIds": [
        30
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://lexingtonal.org/history/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "A historic brick Williamsburg cottage, remodeled after World War I, now stands as a testament to Lexington’s architectural evolution.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://lexingtonal.org/history/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Lexington’s quiet rural landscape and deep‑rooted history make it a small town defined by a strong sense of community.",
