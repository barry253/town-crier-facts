  "facts": [
    {
      "id": 1,
      "text": "Northport’s historic downtown feels like a Hallmark movie with brick streets and glowing lampposts, where locally owned shops have passed through generations.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://visittuscaloosa.com/things-to-do/experience-northport/",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The Northport Heritage Museum sits in a 1907 house and showcases artifacts, furnishings, documents, and photographs that trace the city’s evolution.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://encyclopediaofalabama.org/article/northport/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Northport was officially named in 1832 after a ferry and post office opened that year, marking its early role as a river crossing.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://encyclopediaofalabama.org/article/northport/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The Black Warrior River forms Northport’s southern boundary, while the city sits on the north bank at the fall line between the Appalachian Highlands and Gulf Coastal Plain.",
      "sourceSentenceIds": [
        4,
        5
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Northport%2C_Alabama",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "A 135‑foot train trestle built in 1898 by engineer Benjamin Hardaway was once one of the longest in the nation, spanning the river into Northport.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://encyclopediaofalabama.org/article/northport/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Van de Graaff Arboretum & Historic Bridge Park offers natural beauty and historic charm, featuring a bridge that once carried the Mobile and Ohio Railroad over the river.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Web source 1"
