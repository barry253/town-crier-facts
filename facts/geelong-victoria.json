  "facts": [
    {
      "id": 1,
      "text": "Geelong’s name comes from the Aboriginal word jillong, meaning “the place of the native companion,” a reference to a long‑legged water bird.",
      "sourceSentenceIds": [
        11
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.britannica.com/place/Geelong",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Founded in 1837, Geelong quickly grew into a major port on Corio Bay, an extension of Port Phillip Bay.",
      "sourceSentenceIds": [
        23
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.britannica.com/place/Geelong",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "In 2015 the Geelong Heritage Centre opened in the regional library, preserving the city’s history for future generations.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
