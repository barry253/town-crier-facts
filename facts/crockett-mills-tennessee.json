  "facts": [
    {
      "id": 1,
      "text": "Originally named Robertsonville, the town's name was eventually changed to Crockett Mills because of the town's three mills: a saw mill, a flour mill, and a handle mill.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Crockett_Mills%2C_Tennessee",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "After a 1879 fire, the mills were rebuilt in 1882 and again in 1883, adding a flour attachment and making the brick buildings fire‑proof.",
      "sourceSentenceIds": [
        23,
        24
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://tn-roots.com/tncrockett/goodspeed/crockett.html",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The Cowan Railroad Museum, at the foot of the Cumberland Mountains, displays about 1,000 railroad artifacts, model trains, and a full‑size train, flat car, and caboose outside.",
      "sourceSentenceIds": [
        3,
        4
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.franklincountychamber.com/experience-franklin-county/history/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Falls Mill, built in 1873 as a cotton and woolen factory, later became a cotton gin, then a woodworking shop and grist mill.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
