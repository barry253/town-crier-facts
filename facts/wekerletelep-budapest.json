  "facts": [
    {
      "id": 1,
      "text": "Wekerletelep was named after Prime Minister Sándor Wekerle, who championed garden‑city housing for government workers.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Wekerletelep",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The estate’s streets form a “spider‑web” layout centered on a round square with a large park, a hallmark of early 20th‑century garden city design.",
      "sourceSentenceIds": [
        23,
        24
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Wekerletelep",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Between 1911 and 1914, four schools and two kindergartens were built, providing 48 classrooms and 18 kindergarten rooms for the new community.",
      "sourceSentenceIds": [
        25
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Wekerletelep",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "A police headquarters and mounted‑police barracks were completed in 1912, one of the first dedicated law‑enforcement facilities in the suburb.",
      "sourceSentenceIds": [
