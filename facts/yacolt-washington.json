  "facts": [
    {
      "id": 1,
      "text": "Yacolt’s name comes from the Klickitat word “Yahkohtl,” meaning haunted place or place of evil spirits.",
      "sourceSentenceIds": [
        24
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Yacolt%2C_Washington",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town was nearly destroyed by the Great Yacolt Burn in September 1902, the largest forest fire in Washington state history until 2014.",
      "sourceSentenceIds": [
        7,
        14,
        19
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Yacolt%2C_Washington",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Yacolt’s historic Chelatchie Prairie Railroad, built in the early 1900s, now offers scenic rides on vintage steam locomotives operated by volunteers.",
      "sourceSentenceIds": [
        4,
        15
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://yacolt.us/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Yacolt’s annual Christmas Train Ride, also called the Santa Train, travels 13 miles through mountains to Yacolt Falls, a rock tunnel, and Moulton Station.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Yacolt%2C_Washington",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The town’s early logging era is preserved in the Labbe Collection, which includes a historic steam locomotive that once hauled logs for Harbor Plywood Corp.",
      "sourceSentenceIds": [
        3,
        16
      ],
      "sourceLabels": [
