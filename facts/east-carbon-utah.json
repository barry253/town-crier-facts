        9
      ],
      "sourceLabels": [
        "Web source 1",
        "Web source 2"
      ],
      "source": "https://www.eastcarboncity.org/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "An abandoned tram system still winds through the old mining ruins, offering a rare glimpse into the region’s industrial heritage.",
      "sourceSentenceIds": [
