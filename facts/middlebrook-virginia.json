  "facts": [
    {
      "id": 1,
      "text": "Middlebrook was founded in 1799 by Scots‑Irish and German settlers along a stagecoach road that linked Staunton to Lexington.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Middlebrook%2C_Virginia"
    },
    {
      "id": 2,
      "text": "The town’s first lots were sold by William and Nancy Scott on April 6, 1799, sparking a planned village of contiguous lots and alleys.",
      "sourceSentenceIds": [
        4,
        16,
        17
      ],
      "sourceLabels": [
        "Web source 2",
        "Web source 1"
      ],
      "source": "https://www.newsleader.com/story/news/local/history/2018/08/29/middlebrook-once-bustling-mercantile-town/1133671002/"
    },
    {
      "id": 3,
      "text": "In 1836 a Virginia almanac described Middlebrook as a thriving community of 150 people, thirty dwellings, and a tavern that served travelers.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.newsleader.com/story/news/local/history/2018/08/29/middlebrook-once-bustling-mercantile-town/1133671002/"
    },
    {
      "id": 4,
      "text": "The 1893 financial panic closed several local businesses, and craftsmen shifted to factories in Waynesboro and Basic City.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.newsleader.com/story/news/local/history/2018/08/29/middlebrook-once-bustling-mercantile-town/1133671002/"
    },
    {
      "id": 5,
      "text": "Middlebrook Historic District, listed on the Virginia Landmarks Register in 1981 and the National Register in 1983, preserves the village’s 1880s character.",
      "sourceSentenceIds": [
        15,
        2,
        8
      ],
      "sourceLabels": [
        "Web source 1",
        "Web source 2",
        "Wikipedia"
      ],
      "source": "https://www.dhr.virginia.gov/historic-registers/007-0236/"
    },
    {
      "id": 6,
      "text": "John McCutchan, an early settler, may have named Middlebrook after a New Jersey town.",
      "sourceSentenceIds": [
        1
      ],
