      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "In 1979 developer Sidney Gunst founded Innsbrook on land owned by David Arenstein and Henry Stern.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Innsbrook%2C_Virginia",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "I‑64 and I‑295’s intersection made Innsbrook a key employment hub, amassing over 8.6 million square feet of office space.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 2"
