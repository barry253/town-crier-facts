  "facts": [
    {
      "id": 1,
      "text": "Phillips is one of Minneapolis’s oldest organized communities, with four neighborhoods that have championed environmental, social, and cultural justice for more than 75 years.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://cla.umn.edu/liberal-arts-engagement-hub/programs/residency-program/current-residencies/phillips-community-oral-history-project"
    },
    {
      "id": 2,
      "text": "The Phillips Community Oral History Project was created to give residents a platform to tell their own stories, addressing a long‑standing gap in recorded local history.",
      "sourceSentenceIds": [
        11
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://cla.umn.edu/liberal-arts-engagement-hub/programs/residency-program/current-residencies/phillips-community-oral-history-project"
    },
    {
      "id": 3,
      "text": "The project partners Alley Communications with the United Phillips Coalition, which brings together Phillips West, East Phillips, and Midtown Phillips neighborhood groups.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://cla.umn.edu/liberal-arts-engagement-hub/programs/residency-program/current-residencies/phillips-community-oral-history-project"
    },
    {
      "id": 4,
      "text": "Its mission is to document, amplify, and empower the multicultural and multi‑generational voices of Phillips residents on their own terms.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://cla.umn.edu/liberal-arts-engagement-hub/programs/residency-program/current-residencies/phillips-community-oral-history-project"
    },
    {
      "id": 5,
      "text": "A lecturer, Michael Hessel‑Mial, has highlighted the project as a key example of community storytelling in his writing.",
      "sourceSentenceIds": [
        13
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://cla.umn.edu/liberal-arts-engagement-hub/programs/residency-program/current-residencies/phillips-community-oral-history-project"
    },
    {
      "id": 6,
      "text": "The initiative reflects Phillips’ tradition of civic engagement, showing how collective narratives shape the area’s identity.",
      "sourceSentenceIds": [
