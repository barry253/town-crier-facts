      "quality": "good"
    },
    {
      "id": 2,
      "text": "Amelia Earhart refueled in McNeal in 1928, filtering fuel through a silk stocking during her transcontinental flight.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
