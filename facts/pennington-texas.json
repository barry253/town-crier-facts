      "id": 1,
      "text": "Pennington was laid out and platted in February 1866 by Dan Daily and named for Hill Pennington, the town's first merchant.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 1"
      ],
