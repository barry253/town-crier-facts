  "facts": [
    {
      "id": 1,
      "text": "Midlothian got its name when a homesick Scottish train engineer, on the railroad between Dallas and Cleburne, said the countryside reminded him of Scotland, making it the midpoint.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Midlothian%2C_Texas",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The William L and Emma Hawkins House, built in 1903, now stands as a Recorded Texas Historic Landmark in Midlothian.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Midlothian%2C_Texas",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Three of the nation’s largest cement plants—TXI, Holcim, and Ash Grove—operate right here in Midlothian.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Midlothian%2C_Texas",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The Midlothian Oil Mill and Gin, founded in 1898, once ran a three‑press mill that processed local cotton.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.tshaonline.org/handbook/entries/midlothian-tx",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "What began as a small agricultural community centered on cement production has become one of the fastest‑growing suburbs in the Dallas‑Fort Worth metroplex.",
      "sourceSentenceIds": [
        11
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://dallas.wiki/a/Midlothian",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Every summer, Midlothian hosts its Heritage Festival, celebrating the city’s founding history and the cement industry’s role in shaping local identity.",
      "sourceSentenceIds": [
