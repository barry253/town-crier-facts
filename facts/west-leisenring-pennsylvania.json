  "facts": [
    {
      "id": 1,
      "text": "West Leisenring sprang up in 1881 as a classic coal patch town built around the Leisenring No. 2 mine and its coke works.",
      "sourceSentenceIds": [
        4,
        10,
        11
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/west_leisenring_pennsylvania",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town’s name honors John Leisenring, a Philadelphia‑born civil engineer who led the Connellsville Coke and Iron Company in the late 1800s.",
      "sourceSentenceIds": [
        2,
        24
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/west_leisenring_pennsylvania",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "A 1925 brick community hall in West Leisenring doubled as a gym, barber shop, roller rink, and bowling alley, showing the company’s effort to care for miners’ families.",
      "sourceSentenceIds": [
        16
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/west_leisenring_pennsylvania",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Mining slowed in the late 1920s, but the town revived its operations during World War II to meet wartime steel demands.",
      "sourceSentenceIds": [
        17
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/west_leisenring_pennsylvania",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Coal extraction finally ended in 1955, and the last coke ovens closed in 1957, leaving behind ruins, a large refuse pile, and a few preserved ovens.",
      "sourceSentenceIds": [
        18,
        21
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/west_leisenring_pennsylvania",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "West Leisenring sits 4.2 miles north of Uniontown, nestled between Uniontown and Connellsville along railroad lines that expanded southward by 1880.",
      "sourceSentenceIds": [
        9,
        5
      ],
      "sourceLabels": [
