  "facts": [
    {
      "id": 1,
      "text": "Hackney’s first railway station, the Bishopsgate terminus, opened in 1840, linking the borough to London’s growing rail network.",
      "sourceSentenceIds": [
        23
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.hackney.gov.uk/hackney-history"
    },
    {
      "id": 2,
      "text": "In 1780, paint pioneer Lewis Berger relocated his factory to Homerton, a Hackney district that later became an industrial hub.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.hackney.gov.uk/hackney-history"
    },
    {
      "id": 3,
      "text": "During the 1930s, the London County Council cleared unsatisfactory industrial worker housing in Hackney, reshaping the borough’s streets.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.hackney.gov.uk/hackney-history"
    },
    {
      "id": 4,
      "text": "Hackney’s heritage runs from Roman farmlands feeding Londinium to a 21st‑century arts and nightlife hotspot.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.hackney.gov.uk/hackney-history"
    },
    {
      "id": 5,
      "text": "The London Borough of Hackney was created by the 1963 Act, first elected in 1964, and assumed full powers on 1 April 1965.",
      "sourceSentenceIds": [
        28
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Hackney_London_Borough_Council"
    },
    {
      "id": 6,
      "text": "Hackney Museum, located in the borough, displays exhibits that chronicle the area’s rich local history.",
