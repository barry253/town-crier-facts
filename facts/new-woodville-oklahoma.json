    {
      "id": 2,
      "text": "The original town of Woodville began as a post office named Harney in 1881 before being renamed in 1888.",
      "sourceSentenceIds": [
        1,
        2,
        25
      ],
      "sourceLabels": [
        "Web source 2",
        "Web source 1",
        "Wikipedia"
      ],
      "source": "https://grokipedia.com/page/new_woodville_oklahoma"
    },
    {
      "id": 3,
      "text": "Growth in the original Woodville was stimulated by the arrival of the railroad in 1900, bringing newspapers and cotton gins.",
      "sourceSentenceIds": [
        26
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/New_Woodville%2C_Oklahoma"
    },
    {
      "id": 4,
      "text": "The original Woodville was submerged around 1944 after the Denison Dam was built to create Lake Texoma.",
      "sourceSentenceIds": [
        28
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/New_Woodville%2C_Oklahoma"
    },
    {
      "id": 5,
      "text": "New Woodville was established as a relocation site for residents displaced by the creation of Lake Texoma.",
      "sourceSentenceIds": [
        12,
        29
      ],
      "sourceLabels": [
        "Web source 2",
        "Wikipedia"
      ],
      "source": "https://grokipedia.com/page/new_woodville_oklahoma"
    },
    {
      "id": 6,
      "text": "Low water levels in Lake Texoma occasionally reveal artifacts from the original submerged site of Woodville.",
