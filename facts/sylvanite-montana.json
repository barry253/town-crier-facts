  "facts": [
    {
      "id": 1,
      "text": "Sylvanite takes its name from the gold‑silver telluride mineral found in the ore, a name used for mining camps across the West.",
      "sourceSentenceIds": [
        25
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://treasurestate.com/ghost-towns/sylvanite/",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The community sits in Kootenai National Forest, in the valley of the Yaak River, a south‑flowing tributary of the Kootenai.",
      "sourceSentenceIds": [
        20
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Sylvanite%2C_Montana",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The Lincoln Gold Mining Company operated at Sylvanite through the 1910s, but ore bodies were too difficult and costly to keep profitable.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://treasurestate.com/ghost-towns/sylvanite/",
      "category": "economy",
      "quality": "poor",
      "qualityReason": "vague"
    },
    {
      "id": 4,
      "text": "The nearest railroad connection was distant, and moving ore to a smelter and supplies back to the camp made marginal ore bodies unprofitable.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://treasurestate.com/ghost-towns/sylvanite/",
      "category": "economy",
      "quality": "poor",
      "qualityReason": "vague"
    },
    {
      "id": 5,
      "text": "By World War I, Sylvanite had entered a long decline, eventually becoming an abandoned ghost town.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://treasurestate.com/ghost-towns/sylvanite/",
