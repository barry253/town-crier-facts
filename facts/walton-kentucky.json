  "facts": [
    {
      "id": 1,
      "text": "Walton began as Gaines Cross Roads in the 1790s, where Abner Gaines built a brick tavern in 1814 along the Covington‑Lexington Turnpike.",
      "sourceSentenceIds": [
        1,
        5
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/Walton,_Kentucky",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "In 1840, the Kentucky General Assembly renamed the settlement Walton after Abner Gaines' death, honoring the early pioneer who had founded the town’s first tavern.",
      "sourceSentenceIds": [
        3,
        5
      ],
      "sourceLabels": [
        "Web source 1",
        "Web source 2"
      ],
      "source": "https://cbc.bcplhistory.org/doku.php?id=walton",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Walton’s growth accelerated when the Louisville and Nashville Railroad reached the town in 1869, turning the crossroads into a bustling transportation hub.",
      "sourceSentenceIds": [
        7,
        12
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 2"
      ],
      "source": "https://en.wikipedia.org/wiki/Walton%2C_Kentucky",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The town’s historic core is preserved in the Walton South Main Street National Register Historic District, a 31‑acre area listed in 2005 that includes 47 buildings.",
      "sourceSentenceIds": [
        11
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/Walton,_Kentucky",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Walton sits at the highest elevation between Cincinnati and Louisville, giving it a unique topographic prominence in the region.",
      "sourceSentenceIds": [
        21
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Walton%2C_Kentucky",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The town’s first post office opened in 1815, marking the beginning of formal communication for the growing community.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 1"
      ],
