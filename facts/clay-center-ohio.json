  "facts": [
    {
      "id": 1,
      "text": "Clay Center was founded by William Clark, a land speculator who chose the geographic center of the large township to boost growth.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Clay_Center%2C_Ohio"
    },
    {
      "id": 2,
      "text": "In 1888 the town became part of Allen Township after the original Clay Township split.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Clay_Center%2C_Ohio"
    },
    {
      "id": 3,
      "text": "The village’s name comes from being the center of the former Clay Township.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Clay_Center%2C_Ohio"
    },
    {
      "id": 4,
      "text": "Mining began in the 1880s with the Toledo White Lime Company, and the quarry still operates under Stoneco Inc., part of The Shelly Company.",
      "sourceSentenceIds": [
        3,
        27
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.collection-place.com/locality/25796"
    },
    {
      "id": 5,
      "text": "The local quarry produces Fluorite, Celestine, Calcite, and Galena, with Fluorite prized for its root‑beer color and UV fluorescence.",
      "sourceSentenceIds": [
        25,
        30
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.collection-place.com/locality/25796"
    },
    {
      "id": 6,
      "text": "Clay Center sits in a sedimentary dolomite setting formed by ancient marine processes, giving the area its mineral bounty.",
      "sourceSentenceIds": [
        26
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.collection-place.com/locality/25796"
    }
