  "facts": [
    {
      "id": 1,
      "text": "Moorefield’s name comes from pioneer preacher Jeremiah Moore, who lived there in the late 1700s.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.dhr.virginia.gov/historic-registers/153-0004/"
    },
    {
      "id": 2,
      "text": "The town once hosted the Moorefield Store, a rural trading post that served as the social hub for surrounding farms.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.wisdomlib.org/cities/moorefield-store-166657"
    },
    {
      "id": 3,
      "text": "Jeremiah Moore, a Baptist reformer, advocated religious freedom and separation of church and state while living in Moorefield.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.dhr.virginia.gov/historic-registers/153-0004/"
    },
    {
      "id": 4,
      "text": "The original farmhouse in Moorefield was a simple wood‑frame structure that was later veneered with brick in the 1950s.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.dhr.virginia.gov/historic-registers/153-0004/"
    },
    {
      "id": 5,
      "text": "In 2003 the historic Moorefield house was dismantled and its parts stored after decades of decline.",
