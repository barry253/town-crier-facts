  "facts": [
    {
      "id": 1,
      "text": "Auriesville is the presumed site of the Mohawk village Ossernenon, where Jesuit missionaries were martyred in the 1640s.",
      "sourceSentenceIds": [
        21,
        30
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Auriesville%2C_New_York",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The National Shrine of the North American Martyrs, built in 1930, sits on the same grounds and commemorates those martyrs.",
      "sourceSentenceIds": [
        22
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Auriesville%2C_New_York",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The village name honors the Mohawk chief Auries, the last known Mohawk to live there.",
      "sourceSentenceIds": [
        20
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Auriesville%2C_New_York",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Archaeologists refer to the site as the Bauder site, a key location for studying Mohawk life.",
      "sourceSentenceIds": [
        23,
        29
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Auriesville%2C_New_York",
      "category": "other",
      "quality": "poor",
      "qualityReason": "other"
    },
    {
      "id": 5,
      "text": "Proximity to the Mohawk River, a major Hudson tributary, shapes local hydrology and was central to early settlement.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/Auriesville,_New_York",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The Jesuit mission at Ossernenon operated from 1667 until 1684, when the Mohawk destroyed it amid French‑Iroquois conflicts.",
