      "id": 1,
      "text": "Jamesport was founded in 1857 and named after early settler James Gillilan, whose legacy still echoes in the town\u2019s streets.",
      "sourceSentenceIds": [
        1,
        14,
        15
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
