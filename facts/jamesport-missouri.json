  "facts": [
    {
      "id": 1,
      "text": "Jamesport was founded in 1857 and named after early settler James Gillilan, whose legacy still echoes in the town’s streets.",
      "sourceSentenceIds": [
        1,
        14,
        15
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Jamesport%2C_Missouri"
    },
    {
      "id": 2,
      "text": "The city boasts Missouri’s largest Amish community, where traditional crafts and farm life remain a living part of daily life.",
      "sourceSentenceIds": [
        16
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Jamesport%2C_Missouri"
    },
    {
      "id": 3,
      "text": "Historic brick storefronts line Jamesport’s main street, their weathered facades telling stories of railroad boom days and rural resilience.",
      "sourceSentenceIds": [
        2,
        8
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://familydestinationsguide.com/amish-tiny-town-missouri/"
    },
    {
      "id": 4,
      "text": "At the heart of downtown, the Gingerich Dutch Bakery draws visitors with its cinnamon‑butter pastries, a taste that rivals any supermarket loaf.",
      "sourceSentenceIds": [
        9,
        10
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://familydestinationsguide.com/amish-tiny-town-missouri/"
    },
    {
      "id": 5,
      "text": "Jamesport’s public library, a branch of the Daviess County Library, serves as a quiet hub for locals and travelers alike.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Jamesport%2C_Missouri"
    },
    {
      "id": 6,
      "text": "Located on Missouri Route 190 just south of Route 6, Jamesport sits in eastern Daviess County amid rolling farmland and oak trees.",
      "sourceSentenceIds": [
