    },
    {
      "id": 3,
      "text": "The 1990 eruption swept away most of Kalapana, erasing the historic Kaimu Black Sand Beach.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://unitedstatesghosttowns.com/kalapana-hawaii-ghost-town/"
    },
    {
      "id": 4,
      "text": "A lava flow from Kīlauea’s southeast rift zone buried Kalapana in 1990.",
      "sourceSentenceIds": [
        13
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Kalapana%2C_Hawaii"
    },
    {
      "id": 5,
      "text": "In July 2010, lava destroyed a five‑year‑old house in Kalapana, leaving 35 homes intact.",
