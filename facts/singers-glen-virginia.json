  "facts": [
    {
      "id": 1,
      "text": "Singers Glen was founded in 1809 by Joseph Funk, a German Mennonite music teacher, who brought sacred music to the region.",
      "sourceSentenceIds": [
        8,
        9,
        6
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Singers_Glen%2C_Virginia",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "In 1847, Funk opened the first Mennonite printing house in the U.S. there, publishing the Harmonia Sacra hymnal.",
      "sourceSentenceIds": [
        6,
        15
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Singers_Glen%2C_Virginia",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The village was renamed Singers Glen in 1860 to honor Funk’s choral publications.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.dhr.virginia.gov/historic-registers/082-0125/",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The Joseph Funk House and the surrounding historic district earned National Register of Historic Places status in 1978.",
      "sourceSentenceIds": [
        10,
        15
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Singers_Glen%2C_Virginia",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Singers Glen School served the community from 1882 until 1973, reflecting the town’s long educational tradition.",
      "sourceSentenceIds": [
        11
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Singers_Glen%2C_Virginia",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "A hilltop cemetery overlooks the town, offering a quiet view of the valley’s pastoral landscape.",
