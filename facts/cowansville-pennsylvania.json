  "facts": [
    {
      "id": 1,
      "text": "Cowansville’s story starts in 1798 when Loyalist settler Jabob Ruiter first crossed the land.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://qahn.org/article/cowansvilles-beginnings",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "In 1800 Ruiter built a flour and sawmill on the Yamaska River, sparking the village’s early economy.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://qahn.org/article/cowansvilles-beginnings",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Ruiter renamed the settlement Nelsonville in 1805 after Lord Nelson, but the post office was called Cowansville to avoid mail mix‑ups.",
      "sourceSentenceIds": [
        3,
        4
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://qahn.org/article/cowansvilles-beginnings",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Peter Cowan opened the first post office in 1841, and the village gradually became known as Cowansville.",
      "sourceSentenceIds": [
        15,
        16
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://qahn.org/article/cowansvilles-beginnings",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The South Eastern Railway first arrived on November 26, 1870, linking Montreal to Cowansville and spurring growth.",
