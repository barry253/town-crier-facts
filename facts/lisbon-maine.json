  "facts": [
    {
      "id": 1,
      "text": "Lisbon, Maine was incorporated in 1799 as Thompsonborough, carved from Bowdoin, and renamed Lisbon in 1802 after Portugal’s capital.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://winslowmaine.org/lisbon-maine-exploring-the-hidden-gems-of-the-pine-tree-state",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The Worumbo Mill, a woolen textile plant founded in 1864, powered Lisbon’s economy until it burned in 1987.",
      "sourceSentenceIds": [
        4,
        30
      ],
      "sourceLabels": [
        "Web source 2",
        "Wikipedia"
      ],
      "source": "https://winslowmaine.org/lisbon-maine-exploring-the-hidden-gems-of-the-pine-tree-state",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Lisbon hosts the Moxie Museum and an annual Moxie Festival, celebrating the soda that became one of Maine’s official symbols.",
      "sourceSentenceIds": [
        8,
        18,
        16
      ],
      "sourceLabels": [
        "Web source 1",
        "Web source 2"
      ],
      "source": "https://maine.com/lisbon-maine",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Lisbon sits on the Androscoggin River, where the Papermill Trail links the villages of Lisbon and Lisbon Falls for scenic walks.",
      "sourceSentenceIds": [
        13,
        14
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://winslowmaine.org/lisbon-maine-exploring-the-hidden-gems-of-the-pine-tree-state",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Author Stephen King drew on a summer job at Lisbon’s Worumbo Mill for his story “Graveyard Shift,” linking the town to his fiction.",
      "sourceSentenceIds": [
        16
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://winslowmaine.org/lisbon-maine-exploring-the-hidden-gems-of-the-pine-tree-state",
      "category": "people",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The Lisbon Historical Society offers walking tours that showcase artifacts and photographs, preserving the town’s mill‑town heritage.",
      "sourceSentenceIds": [
        10,
