  "facts": [
    {
      "id": 1,
      "text": "Twin Rocks earned its name in 1875 from two nearly identical sandstone outcrops near a sharp bend in Blacklick Creek.",
      "sourceSentenceIds": [
        6,
        10,
        13,
        29
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/twin_rocks_pennsylvania",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The village grew when the Pennsylvania Railroad extended its line from Ebensburg to Vintondale in 1893\u201194, adding a station that served the mining boom.",
      "sourceSentenceIds": [
        7,
        11,
        15
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/twin_rocks_pennsylvania",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Twin Rocks once hosted the Twin Rocks Mine, a coal operation that remained under federal safety oversight into the early 2000s.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/twin_rocks_pennsylvania",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The Big Bend School, built in 1921, still stands as a reminder of the community\u2019s early 20th\u2011century educational heritage.",
      "sourceSentenceIds": [
        20,
        25
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/twin_rocks_pennsylvania",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "At about 1,650 feet above sea level, Twin Rocks sits amid rolling hills and dense hardwood forests typical of the Appalachian Plateau.",
