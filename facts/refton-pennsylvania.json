  "facts": [
    {
      "id": 1,
      "text": "Refton Cave once sparked legend as a subterranean lake so deep that no rope could reach its bottom.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://unchartedlancaster.com/2025/11/30/refton-cave-lancaster-countys-lost-subterranean-lake/"
    },
    {
      "id": 2,
      "text": "In 1870 explorers reported the cave had no inlet or outlet and housed blind creatures devoid of eyes.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://unchartedlancaster.com/2025/11/30/refton-cave-lancaster-countys-lost-subterranean-lake/"
    },
    {
      "id": 3,
      "text": "Libbie Hyman described a blind planarian, Sphalloplana pricei, discovered in Refton Cave in 1937.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://unchartedlancaster.com/2025/11/30/refton-cave-lancaster-countys-lost-subterranean-lake/"
    },
    {
      "id": 4,
      "text": "The cave’s entrance is a 30‑foot wide sinkhole, 20 feet deep, leading to a 25‑foot shaft and a chamber 85 feet long.",
      "sourceSentenceIds": [
        26
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://unchartedlancaster.com/2025/11/30/refton-cave-lancaster-countys-lost-subterranean-lake/"
    },
    {
      "id": 5,
      "text": "Within that chamber lies an underground pond up to 10 feet deep, smaller than the 1870 reports but still striking.",
      "sourceSentenceIds": [
        28
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://unchartedlancaster.com/2025/11/30/refton-cave-lancaster-countys-lost-subterranean-lake/"
    },
    {
      "id": 6,
      "text": "Refton sits along Pequea Creek, part of the Susquehanna River watershed, and Route 222 links it to Lancaster and Quarryville.",
      "sourceSentenceIds": [
        6,
        7,
        8
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
