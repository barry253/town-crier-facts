  "facts": [
    {
      "id": 1,
      "text": "Deersville was platted in 1815, when John Cramblett laid out the village on November 25 and filed the plat on December 19.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/deersville_historic_district",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The Deersville Historic District, centered on West Main Street, contains 26 buildings that showcase Greek and Gothic Revival styles from the 19th and early 20th centuries.",
      "sourceSentenceIds": [
        29
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/deersville_historic_district",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The 1835 Union Bell Hotel once served as a stagecoach stop on the Wheeling‑to‑Wooster route, a key link for travelers in the era before railroads.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/deersville_historic_district",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The 1913 Community Hall is still the home of the Deersville Players, a local theater group that has staged productions for over a century.",
      "sourceSentenceIds": [
