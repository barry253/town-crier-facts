  "facts": [
    {
      "id": 1,
      "text": "Victor, Montana, takes its name from Chief Victor—also called Big Face—who signed the 1855 Hellgate Treaty.",
      "sourceSentenceIds": [
        8,
        10
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Victor%2C_Montana"
    },
    {
      "id": 2,
      "text": "The Victor Heritage Museum, housed in the town’s original railroad depot, showcases Salish, railroad, and mining history.",
      "sourceSentenceIds": [
        5,
        6
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://roamingmontana.com/victor/"
    },
    {
      "id": 3,
      "text": "Victor sits on the west side of the Bitterroot River, just 4 miles east of Sweat House Canyon’s mouth, and once was called Sweat House.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.mtmemory.org/nodes/view/128304"
    },
    {
      "id": 4,
      "text": "The 1893 repeal of the Sherman Silver Purchase Act devastated Victor’s mining sector, closing numerous local mines.",
      "sourceSentenceIds": [
        27
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Victor%2C_Montana"
    },
    {
      "id": 5,
      "text": "Victor lies in southwestern Montana, nestled along the Bitterroot River between the Bitterroot Range and the Sapphire Mountains.",
      "sourceSentenceIds": [
        29
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Victor%2C_Montana"
    },
    {
      "id": 6,
      "text": "Victor hosts KXEH, a local FM radio station that serves the Bitterroot Valley community.",
