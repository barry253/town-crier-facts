  "facts": [
    {
      "id": 1,
      "text": "Popponesset means \"land of shells\" or \"place of shellfish,\" reflecting the Wampanoag heritage of the area.",
      "sourceSentenceIds": [
        23,
        24
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://popponessetneighborhood.org/popponesset-tracing-the-rich-tapestry-of-a-cape-cod-gem/",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "During World II, Popponesset Island served as a site for amphibious assault training.",
      "sourceSentenceIds": [
        13
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Popponesset_Island%2C_Massachusetts",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "From the early 1950s to 1960, Popponesset Island and The Spit were joined, with the creek flowing directly into Nantucket Sound.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.capenews.net/mashpee/columns/the_magnifying_glass/the-magnifying-glass-the-splitting-of-popponesset-island-from-the-spit/article_9901d799-08bb-48b0-b11e-b585c97d1b22.html",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Popponesset Marketplace, once a handful of shops, evolved into a bustling summer hub along Shore Drive and Great Neck Road South.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://popponessetneighborhood.org/popponesset-tracing-the-rich-tapestry-of-a-cape-cod-gem/",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The Spit offers sunset walks and a nesting ground for snowy plovers, preserving a living link to Popponesset’s ecological history.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://popponessetneighborhood.org/popponesset-tracing-the-rich-tapestry-of-a-cape-cod-gem/",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The Popponesset Beach Association, founded mid‑20th century, has long overseen care for the beach, dunes, and green spaces.",
