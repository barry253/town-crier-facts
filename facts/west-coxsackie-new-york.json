  "facts": [
    {
      "id": 1,
      "text": "Coxsackie’s name comes from the Algonquin word for “place of owls,” a nod to the many owls once seen in the area.",
      "sourceSentenceIds": [
        11,
        13
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Coxsackie_(village)%2C_New_York",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The village’s first European settler, Pieter Bronck, bought the original plot from the Mahican tribe in 1661 for 150 guilders in beaver pelts.",
      "sourceSentenceIds": [
        1,
        16
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://coxsackie.org/history/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Reed Street, only two blocks long, ends at Riverside Park, where drivers can catch sweeping views of the Hudson River.",
      "sourceSentenceIds": [
        15
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Coxsackie_(village)%2C_New_York",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The historic steam freighter Storm King, which sank in the 1930s, still rests in the Hudson just north of the park and can be seen from the riverbank.",
      "sourceSentenceIds": [
        20,
        21
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Coxsackie_(village)%2C_New_York",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The Greene County Historical Society’s Bronck House Museum, the oldest home in Upstate New York, opens for tours from May to October each year.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 2"
      ],
