  "facts": [
    {
      "id": 1,
      "text": "Verden is probably best known as the site of the 1865 Camp Napoleon Council.",
      "sourceSentenceIds": [
        19
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Verden%2C_Oklahoma"
    },
    {
      "id": 2,
      "text": "A rural community called Cottonwood Grove emerged near the present site of Verden before the Civil War.",
      "sourceSentenceIds": [
        6,
        20
      ],
      "sourceLabels": [
        "Web source 1",
        "Wikipedia"
      ],
      "source": "https://www.okhistory.org/publications/enc/entry?entry=VE003"
    },
    {
      "id": 3,
      "text": "Verden was named in 1902 because another post office called Cottonwood Grove already existed elsewhere in the Oklahoma Territory.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Verden%2C_Oklahoma"
    },
    {
      "id": 4,
      "text": "The Rock Island Railroad built tracks through Verden in 1900, making the town an important shipping point for local farms.",
      "sourceSentenceIds": [
        8,
        9
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Verden%2C_Oklahoma"
    },
    {
      "id": 5,
      "text": "Verden was placed on the National Register of Historic Places in 2005.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Verden%2C_Oklahoma"
    },
    {
      "id": 6,
      "text": "The Oklahoma College for Women erected a historic marker in Verden to honor the Camp Napoleon conference.",
      "sourceSentenceIds": [
        11
