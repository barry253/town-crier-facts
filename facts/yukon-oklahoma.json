  "facts": [
    {
      "id": 1,
      "text": "Yukon's name echoes the 1890s Yukon Territory gold rush, inspiring settlers to christen the Oklahoma town after the Canadian river.",
      "sourceSentenceIds": [
        2,
        9,
        10
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Yukon%2C_Oklahoma"
    },
    {
      "id": 2,
      "text": "Railroad builder Spencer founded Yukon in 1891, laying tracks that linked El Reno to Arkansas and sparked the town’s growth.",
      "sourceSentenceIds": [
        11,
        15
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.okhistory.org/publications/enc/entry?entry=YU002"
    },
    {
      "id": 3,
      "text": "Czech Hall, a National Register landmark, stands two miles south of Yukon, preserving the community’s rich Czech heritage.",
      "sourceSentenceIds": [
        20
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.okhistory.org/publications/enc/entry?entry=YU002"
    },
    {
      "id": 4,
      "text": "The Yukon Historical Museum, housed in a 1910 school building, chronicles the town’s early days and cultural milestones.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.travelok.com/Yukon"
    },
    {
      "id": 5,
      "text": "Express Clydesdales Ranch, with a barn rebuilt in 1936, showcases some of the world’s most beautiful Clydesdales.",
      "sourceSentenceIds": [
        13
