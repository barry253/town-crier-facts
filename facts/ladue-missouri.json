  "facts": [
    {
      "id": 1,
      "text": "Ladue Road, the main thoroughfare, was named after Peter Albert LaDue—whose name means 'sweet water'—and whose farm sat at the corner of Ladue and Warson Roads.",
      "sourceSentenceIds": [
        2,
        8
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.cityofladue-mo.gov/community/city_historian/index.php",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Original Township 45’s 1868 map lists farming families such as the Dennys, McKnights, Litzsinger, and LaDues, reflecting the area’s diverse Irish, German, and French roots.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.cityofladue-mo.gov/community/city_historian/index.php",
      "category": "people",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Louis County Library opened in Ladue on Lindbergh Boulevard in 1959, serving the community’s educational needs.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.cityofladue-mo.gov/community/city_historian/index.php",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Tilles Park, a sizable green space in Ladue, offers walking trails and a historic gazebo.",
      "sourceSentenceIds": [
