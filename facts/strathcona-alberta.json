  "facts": [
    {
      "id": 1,
      "text": "Strathcona was founded in 1891 as a railway centre, became a town in 1899, and a city in 1907.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Strathcona%2C_Alberta"
    },
    {
      "id": 2,
      "text": "The town was originally called South Edmonton and was incorporated on May 29, 1899, named after Lord Strathcona.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Strathcona%2C_Alberta"
    },
    {
      "id": 3,
      "text": "The historic commercial core of former Strathcona is now the Old Strathcona Provincial Historic Area, preserving 19th‑century buildings.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Strathcona%2C_Alberta"
    },
    {
      "id": 4,
      "text": "In 1902, Strathcona passed an ordinance requiring all buildings to be fire‑resistant, leading to a brick‑built downtown that survives today.",
      "sourceSentenceIds": [
        23
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Strathcona%2C_Alberta"
    },
    {
      "id": 5,
      "text": "The University of Alberta was founded in Strathcona in 1907, with its first campus built on riverlot No.5 on the city’s west edge.",
