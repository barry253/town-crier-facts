  "facts": [
    {
      "id": 1,
      "text": "Amargosa derives its name from the Spanish word for bitter, likely referring to the nearby creek.",
      "sourceSentenceIds": [
        4,
        21
      ],
      "sourceLabels": [
        "Web source 2",
        "Wikipedia"
      ],
      "source": "https://grokipedia.com/page/amargosa_texas"
    },
    {
      "id": 2,
      "text": "Amargosa began as a ranch settlement on land granted to Manuel Barrera of Mier, Mexico, in 1836.",
      "sourceSentenceIds": [
        3,
        4
      ],
      "sourceLabels": [
        "Web source 1",
        "Web source 2"
      ],
      "source": "https://www.tshaonline.org/handbook/entries/amargosa-tx"
    },
    {
      "id": 3,
      "text": "By 1849, Amargosa was a prominent South Texas ranch dealing in wool and hides from sheep, goats, and horses.",
      "sourceSentenceIds": [
        22
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.tshaonline.org/handbook/entries/amargosa-tx"
    },
    {
      "id": 4,
      "text": "Repeated Indian raids during the early 1850s forced the occupants of Amargosa to temporarily abandon their property.",
      "sourceSentenceIds": [
        14,
        23
      ],
      "sourceLabels": [
        "Web source 1",
        "Web source 2"
      ],
      "source": "https://www.tshaonline.org/handbook/entries/amargosa-tx"
    },
    {
      "id": 5,
      "text": "Amargosa lost its importance as a trade center after the San Antonio and Aransas Pass Railway bypassed the town in 1898.",
      "sourceSentenceIds": [
        26
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.tshaonline.org/handbook/entries/amargosa-tx"
    },
    {
      "id": 6,
      "text": "Two fort-shaped houses from the old settlement of Amargosa were still standing in the area as of 1965.",
      "sourceSentenceIds": [
        27
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.tshaonline.org/handbook/entries/amargosa-tx"
