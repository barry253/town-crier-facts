      ],
      "source": "https://grokipedia.com/page/ridgewood_illinois",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Farming communities sprang up in the 1840s, drawn by fertile soils near the Des Plaines River and Joliet’s growing transport links.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 1"
      ],
