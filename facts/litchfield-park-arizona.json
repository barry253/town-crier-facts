      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town’s first major attraction opened in 1929 when the Wigwam Resort welcomed its first guests.",
      "sourceSentenceIds": [
        20
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Litchfield_Park%2C_Arizona",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The historic Litchfield/Denny home now houses the Litchfield Heritage Center, showcasing Southwest Valley culture.",
      "sourceSentenceIds": [
        7,
        8
      ],
      "sourceLabels": [
        "Web source 2"
      ],
