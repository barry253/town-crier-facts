  "facts": [
    {
      "id": 1,
      "text": "Nine Mile Falls sits nine miles northwest of downtown Spokane, where the historic Nine Mile Dam was built in 1908.",
      "sourceSentenceIds": [
        13,
        14
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Nine_Mile_Falls%2C_Washington",
      "category": "other",
      "quality": "poor",
      "qualityReason": "location_description"
    },
    {
      "id": 2,
      "text": "The dam’s power plant and the old village were added to the National Register of Historic Places in 1990, preserving the area’s early industrial heritage.",
      "sourceSentenceIds": [
        5,
        8
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Nine_Mile_Falls%2C_Washington",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Ancient rock paintings line the Little Spokane River just upstream from its confluence with the Spokane River, a testament to the region’s long Native American history.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Nine_Mile_Falls%2C_Washington",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The community straddles the Spokane River, with the Little Spokane River joining it just north of the town, creating a narrow, 200‑foot‑deep valley carved by glacial floods.",
      "sourceSentenceIds": [
        21,
        27
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Nine_Mile_Falls%2C_Washington",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Nine Mile Falls is an unincorporated community that lies in both Spokane and Stevens counties, making it a unique cross‑county exurb of the Spokane metropolitan area.",
      "sourceSentenceIds": [
        12,
        15
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Nine_Mile_Falls%2C_Washington",
      "category": "other",
      "quality": "poor",
      "qualityReason": "editorial_filler"
    },
    {
      "id": 6,
      "text": "The western side of Nine Mile Falls hosts a park, a fire station, a restaurant, and an elementary school, all situated on the river’s opposite bank.",
