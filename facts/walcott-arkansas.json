  "facts": [
    {
      "id": 1,
      "text": "Benjamin Crowley founded Walcott’s first white settlement in 1821 near a spring on Crowley’s Ridge, marking Greene County’s earliest permanent community.",
      "sourceSentenceIds": [
        1,
        17
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/walcott_arkansas",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "In 1846 the post office was renamed Walcott, though the name’s origin remains unclear—perhaps after a postmaster or a local legend.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/walcott_arkansas",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Walcott sits atop Crowley’s Ridge, a 200‑mile loess and sand formation that rises 250 to 550 feet above the surrounding lowlands.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/walcott_arkansas",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Walcott experiences a humid subtropical climate, with hot, humid summers that can feel oppressive and mild winters that rarely bring severe cold.",
      "sourceSentenceIds": [
        13,
        15
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/walcott_arkansas",
      "category": "other",
      "quality": "poor",
      "qualityReason": "vague"
    },
    {
      "id": 5,
      "text": "Early settlers in Walcott farmed corn and cotton and harvested timber from the ridge’s hardwood forests for building and fuel.",
      "sourceSentenceIds": [
        19
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/walcott_arkansas"
    },
    {
      "id": 6,
      "text": "The nearby Francis River can flood low‑lying areas during heavy rains, a risk that has shaped local land use.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 1"
      ],
