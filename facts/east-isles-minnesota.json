  "facts": [
    {
      "id": 1,
      "text": "Lake of the Isles was named for the small islands that once dotted its waters, a name the Dakota called Wíta Tópa meaning 'Four Islands'.",
      "sourceSentenceIds": [
        2,
        11,
        12
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
