  "facts": [
    {
      "id": 1,
      "text": "Andrews was founded in 1909 when voters incorporated the separate towns of Rosemary and Harpers Crossroads into one community.",
      "sourceSentenceIds": [
        1,
        2
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 2"
      ],
      "source": "https://en.wikipedia.org/wiki/Andrews%2C_South_Carolina"
    },
    {
      "id": 2,
      "text": "The town of Andrews was named after Colonel Walter H. Andrews, who played an important role in its incorporation.",
      "sourceSentenceIds": [
        1,
        20
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Andrews%2C_South_Carolina"
    },
    {
      "id": 3,
      "text": "During the 1920s, Andrews held the title of being the fastest growing town in the United States for its age.",
      "sourceSentenceIds": [
        23
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Andrews%2C_South_Carolina"
    },
    {
      "id": 4,
      "text": "Andrews is uniquely located in both Georgetown and Williamsburg counties in South Carolina.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Andrews%2C_South_Carolina"
    },
    {
      "id": 5,
      "text": "The Old Town Hall Museum in Andrews is housed in a building originally constructed in 1915.",
