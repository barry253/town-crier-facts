  "facts": [
    {
      "id": 1,
      "text": "Branson began as Wilson Switch, a railroad switch on the Denver, Texas, and Fort Worth line that later became part of the Colorado and Southern Railway.",
      "sourceSentenceIds": [
        2,
        1,
        17
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Branson%2C_Colorado",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "In 1918 the town was renamed Branson after Josiah F. Platt, who platted the settlement on his private acreage.",
      "sourceSentenceIds": [
        5,
        18,
        19
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.bransoncolorado.com/our-history",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Branson is Colorado’s southernmost town, lying just one mile from the New Mexico border.",
      "sourceSentenceIds": [
        13
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Branson%2C_Colorado",
      "category": "other",
      "quality": "poor",
      "qualityReason": "other"
    },
    {
      "id": 4,
      "text": "A 1918 depot turned Branson into a ranching and grain center, once housing three grain elevators, a bank, and a newspaper.",
      "sourceSentenceIds": [
        22,
        24
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Branson%2C_Colorado",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Some of Branson’s beautiful historic buildings still stand, offering a glimpse of its bustling early 20th‑century past.",
      "sourceSentenceIds": [
        10,
        7
      ],
      "sourceLabels": [
        "Web source 2",
        "Web source 1"
      ],
      "source": "https://www.uncovercolorado.com/towns/branson/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "After most businesses closed by 1980, Branson survived as a quiet ranching community today.",
      "sourceSentenceIds": [
        9,
        15
      ],
      "sourceLabels": [
        "Web source 1"
      ],
