  "facts": [
    {
      "id": 1,
      "text": "Zion was founded in 1900 by evangelist John Alexander Dowie, who envisioned a racially equal Christian city.",
      "sourceSentenceIds": [
        2,
        4,
        8
      ],
      "sourceLabels": [
        "Web source 2",
        "Wikipedia"
      ],
      "source": "https://www.britannica.com/place/Zion-Illinois",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The city’s name comes from Mount Zion in Jerusalem, reflecting Dowie’s biblical inspiration.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Zion%2C_Illinois",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Dowie built the Zion Tabernacle, the town’s only church, which served as the community’s spiritual center.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Zion%2C_Illinois",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Zion’s train station on Metra’s Union Pacific/North Line connects the town to Chicago, a legacy of its early rail plans.",
      "sourceSentenceIds": [
        18
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Zion%2C_Illinois",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "In the early 1900s, Zion’s Fielders Stadium was planned to host a minor‑league baseball team, a project that never materialized.",
