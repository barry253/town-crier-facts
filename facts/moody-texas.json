  "facts": [
    {
      "id": 1,
      "text": "Moody was named after William Lewis Moody, a railroad director who supervised the track’s construction through the area.",
      "sourceSentenceIds": [
        1,
        2
      ],
      "sourceLabels": [
        "Web source 1",
        "Web source 2"
      ],
      "source": "https://moodytx.gov/about/",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Moody’s roots reach back to the pre‑Civil War settlement of Perry, the original community that once stood nearby.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://moodytx.gov/about/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The Historical Perry Cemetery still marks the resting places of many early settlers who helped shape the area’s early history.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://moodytx.gov/about/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Old Perry, the original settlement, lies just a few miles northeast of today’s city of Moody.",
