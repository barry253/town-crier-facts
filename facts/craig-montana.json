  "facts": [
    {
      "id": 1,
      "text": "Craig was named after homesteaders Warren and Eliza Craig, who staked a claim and built a log cabin in 1886 before the railroad finished in 1887.",
      "sourceSentenceIds": [
        1,
        5
      ],
      "sourceLabels": [
        "Web source 2",
        "Web source 1"
      ],
      "source": "https://montanahistoriclandscape.com/2026/01/13/craig-from-railroad-stop-to-fish-town/",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Craig, nicknamed Fish Town by the Big Sky Journal, is a quintessential fishing village along the Missouri River that has been a favorite stop for four decades.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://montanahistoriclandscape.com/2026/01/13/craig-from-railroad-stop-to-fish-town/",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "When Hauser Dam failed in 1908, a 25‑foot wall of Missouri River water flooded Craig, yet remarkably no lives were lost.",
      "sourceSentenceIds": [
        15,
        16
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.mtmemory.org/nodes/view/127645",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "A steel bridge built between 1902 and 1904 replaced the ferry, turning Craig into a cross‑road town that never grew significantly afterward.",
      "sourceSentenceIds": [
        23,
        25
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.mtmemory.org/nodes/view/127645",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Izaak’s, a popular bar and grill in Craig, opened a new taphouse that attracts a different crowd than the historic Craig Bar.",
