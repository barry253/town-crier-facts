  "facts": [
    {
      "id": 1,
      "text": "Bluemont was originally called Snickersville; the name changed in 1900 to attract Washington, D.C. visitors.",
      "sourceSentenceIds": [
        1,
        10
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Bluemont%2C_Virginia",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The village sits at 700 feet, the highest community in Loudoun County, perched at the eastern base of Snickers Gap.",
      "sourceSentenceIds": [
        22,
        19
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Bluemont%2C_Virginia",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The Washington and Old Dominion Railroad once ran through Bluemont, bringing weekenders from D.C. until the line was abandoned in 1939.",
      "sourceSentenceIds": [
        7,
        11
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Bluemont%2C_Virginia",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Artists and musicians flocked to Bluemont in the 1960s, leading to the founding of the Bluemont Fair in 1968 and the Concert Series in the 1970s.",
      "sourceSentenceIds": [
        2,
        3,
        6
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Bluemont%2C_Virginia",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The Bluemont Fair, an all‑volunteer event, has been held every fall since 1970, funding local scholarships and historic building improvements.",
      "sourceSentenceIds": [
        13,
        23
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Bluemont%2C_Virginia",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The town’s historic district is marked at Clayton Hall Road and Snickersville Turnpike, where William Clayton’s farm once stood.",
      "sourceSentenceIds": [
        12,
        26
      ],
