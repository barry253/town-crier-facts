  "facts": [
    {
      "id": 1,
      "text": "Antwerp, New York, takes its name from Antwerp, Belgium, where early investors formed the Antwerp Company.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Antwerp%2C_New_York",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The village’s historic district preserves a high degree of integrity, with boundaries drawn to exclude non‑contributing outskirts.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.livingplaces.com/NY/Jefferson_County/Antwerp_Village/Village_of_Antwerp_Historic_District.html",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Main Street runs north‑south, meeting NY Route 11 at the north and ending at Fort Drum’s southern boundary.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.livingplaces.com/NY/Jefferson_County/Antwerp_Village/Village_of_Antwerp_Historic_District.html",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "East Main Street hosts Richardsonian Romanesque Town Hall, Gothic Revival Congregational Church, and the 1917 Crosby Memorial Library.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.livingplaces.com/NY/Jefferson_County/Antwerp_Village/Village_of_Antwerp_Historic_District.html",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The southeastern part of Antwerp contains a section of the Fort Drum Military Reservation.",
      "sourceSentenceIds": [
        18
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Antwerp%2C_New_York",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The village’s historic significance spans 1800–1924, with notable years 1816, 1867, and 1889.",
