  "facts": [
    {
      "id": 1,
      "text": "Limestone was incorporated on March 17, 1869, and its name comes from the abundant limestone deposits that dot the landscape.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Limestone%2C_Maine",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "In 1952 the U.S. Air Force established Loring Air Force Base just outside Limestone, turning the area into a strategic Cold War hub.",
      "sourceSentenceIds": [
        19
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Limestone%2C_Maine",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The base closed in 1994, after which the site evolved into the Loring Commerce Centre, an industrial park and nature refuge.",
      "sourceSentenceIds": [
        15,
        20
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Limestone%2C_Maine",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Today, the Loring Air Museum on the former base grounds showcases artifacts from the Strategic Air Command era.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://mainepedia.com/towns/limestone/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The Limestone-Caswell Historical Museum and the Church of the Advent offer a glimpse into the town’s agricultural and religious heritage.",
      "sourceSentenceIds": [
        5
