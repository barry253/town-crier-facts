  "facts": [
    {
      "id": 1,
      "text": "De Pere’s name comes from French “Rapides des Pères,” meaning “rapids of the fathers,” renamed after Jesuit missionary Claude‑Jean Allouez in 1671.",
      "sourceSentenceIds": [
        4,
        5,
        18,
        24
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/De_Pere%2C_Wisconsin",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "In 1836, John Penn Arndt and Charles Tullar incorporated the De Pere Hydraulic Company, laying out the first town plat that would become the city.",
      "sourceSentenceIds": [
        25
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/De_Pere%2C_Wisconsin",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The city became the county seat of Brown County in 1837, holding that status until 1854 when the seat moved to Green Bay.",
      "sourceSentenceIds": [
        26
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/De_Pere%2C_Wisconsin",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Norbert College, founded in 1898 by Norbertine Abbot Pennings, sits on the Fox River and is a notable higher‑education institution in De Pere.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/De_Pere%2C_Wisconsin",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "De Pere’s historic downtown hosts a comedy theatre and live music venues ranging from alternative rock to classical, reflecting its vibrant arts scene.",
      "sourceSentenceIds": [
        11
