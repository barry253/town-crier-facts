  "facts": [
    {
      "id": 1,
      "text": "Auburn, North Dakota, was named after Auburn, Ontario, and its post office opened March 26, 1883, marking the town's formal founding.",
      "sourceSentenceIds": [
        1,
        4
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/auburn_north_dakota"
    },
    {
      "id": 2,
      "text": "The Great Northern Railroad arrived in 1882, spurring Auburn's growth as a rail town.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/auburn_north_dakota"
    },
    {
      "id": 3,
      "text": "Norwegian and Quebec settlers like Ole Larson, Ole Lerud, and the Kingsbury brothers homesteaded the area around 1880, clearing land for farming.",
      "sourceSentenceIds": [
        24,
        8
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/auburn_north_dakota"
    },
    {
      "id": 4,
      "text": "The Auburn post office operated from 1883 until its closure in 1943, a key marker of the town's decline.",
      "sourceSentenceIds": [
        14,
        7
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Auburn%2C_North_Dakota"
    },
    {
      "id": 5,
      "text": "A 1888–1889 fire destroyed much of Auburn's west side, and the 1889 state constitution shut down local saloons.",
      "sourceSentenceIds": [
        23
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/auburn_north_dakota"
    },
    {
      "id": 6,
      "text": "By the 1920s, Auburn farmers had diversified into potatoes and sugar beets, reflecting the region's fertile Red River Valley soils.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Web source 1"
      ],
