  "facts": [
    {
      "id": 1,
      "text": "Pitman, New Jersey was originally established as a Methodist summer camp meeting site in the 1870s, evolving into a year-round community.",
      "sourceSentenceIds": [
        4,
        7
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Pitman%2C_New_Jersey",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The borough was named after Rev. Charles Pitman, a Methodist minister who played a significant role in its early development.",
      "sourceSentenceIds": [
        2,
        3
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Pitman%2C_New_Jersey",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "In 1904, residents of the Pitman Grove voted to incorporate as an autonomous borough, marking a significant shift in its governance.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Pitman%2C_New_Jersey",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Pitman Grove was added to the National Register of Historic Places in 1977, recognizing its historical significance.",
      "sourceSentenceIds": [
        13
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Pitman%2C_New_Jersey",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Until August 2014, Pitman, New Jersey was a dry town, prohibiting the sale of alcohol until new ordinances were passed in 2015.",
      "sourceSentenceIds": [
        14,
        15
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Pitman%2C_New_Jersey",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The borough features a unique layout with twelve roads radiating from a central meeting ground, reminiscent of a wheel's spokes.",
