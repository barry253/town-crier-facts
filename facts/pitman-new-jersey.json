      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Pitman%2C_New_Jersey",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Pitman Grove was added to the National Register of Historic Places in 1977, recognizing its historical significance.",
      "sourceSentenceIds": [
        13
      ],
      "sourceLabels": [
