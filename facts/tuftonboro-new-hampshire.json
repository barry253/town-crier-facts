      "id": 1,
      "text": "Tuftonboro takes its name from John Tufton Mason, the town’s sole original owner.",
      "sourceSentenceIds": [
        1,
        2,
        9
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Tuftonboro%2C_New_Hampshire",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town was officially incorporated by the New Hampshire legislature on December 17, 1795.",
      "sourceSentenceIds": [
        16
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Tuftonboro%2C_New_Hampshire",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Tuftonboro lies along Lake Winnipesaukee’s southwest shore, encompassing Mirror Lake and Dan Hole Pond.",
      "sourceSentenceIds": [
        11,
        18
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Tuftonboro%2C_New_Hampshire",
      "category": "nature",
      "quality": "poor",
      "qualityReason": "location_description"
    },
    {
      "id": 4,
      "text": "Mount Shaw’s south peak, at 2,930 feet, crowns Tuftonboro’s northwestern boundary as the town’s highest point.",
      "sourceSentenceIds": [
        19
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Tuftonboro%2C_New_Hampshire",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Mirror Lake village sits in the town’s south, while Little Bear and Cow Islands dot Lake Winnipesaukee.",
      "sourceSentenceIds": [
        25,
        26
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Tuftonboro%2C_New_Hampshire",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The Indian Grave by the Lake and the view from Abenakee Tower offer historic vistas for locals and visitors.",
