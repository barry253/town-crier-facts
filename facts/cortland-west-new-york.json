  "facts": [
    {
      "id": 1,
      "text": "Cortland West sits in the glaciated Appalachian Plateau, midway between Syracuse and Binghamton, marking the southeastern gateway to the Finger Lakes.",
      "sourceSentenceIds": [
        15
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Cortland_County%2C_New_York",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The area that is now Cortland West was first settled by white pioneers in 1791, when Amos Todd and others paddled up the Tioughnioga River from Connecticut.",
      "sourceSentenceIds": [
        26
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Cortland_County%2C_New_York",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Cortland County, which contains Cortland West, was formed in 1808 from the southern half of Onondaga County and named after Pierre Van Cortlandt, a key figure in New York’s first constitution.",
      "sourceSentenceIds": [
        5,
        2
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Cortland_County%2C_New_York",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "During the American Revolution, the land that now makes up Cortland West was part of the Military Tract, a 1¼‑million‑acre reward for soldiers who defended the state’s western frontier.",
      "sourceSentenceIds": [
        18
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Cortland_County%2C_New_York",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "In the early 1790s, the state built a road from Oxford through what is now Cortland West to Cayuga Lake, a major driver of settlement in the area.",
      "sourceSentenceIds": [
        19
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
