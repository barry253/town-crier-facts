  "facts": [
    {
      "id": 1,
      "text": "Dunseith was founded in 1884 by Chicago businessman William Dunseith Eaton, who named the town after himself.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Dunseith%2C_North_Dakota",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town proudly hosts the world’s largest turtle sculpture, the “W’eel Turtle,” built from more than 2,000 green‑painted wheels.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Dunseith%2C_North_Dakota",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Dunseith lies just south of the Turtle Mountain plateau, a rugged highland that defines the region’s landscape.",
      "sourceSentenceIds": [
        11
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Dunseith%2C_North_Dakota",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The International Peace Garden, founded in 1932 on a border premise of peace, sits only a few miles from Dunseith.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://peacegarden.com/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The Peace Garden’s port of entry is one of only three 24‑hour ports in North Dakota, keeping the border open day and night.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Dunseith%2C_North_Dakota",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Dunseith was officially incorporated in 1908, following its platting in 1882 and the opening of a post office in 1884.",
