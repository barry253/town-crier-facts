      "id": 1,
      "text": "Kinsman was named for John Kinsman, a land agent who first traveled to Ohio in 1799.",
      "sourceSentenceIds": [
        1,
        3,
        7
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1",
        "Web source 2"
      ],
