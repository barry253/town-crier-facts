  "facts": [
    {
      "id": 1,
      "text": "Tennoji derives its name from Shitennō-ji, the first Buddhist temple in Japan, founded by Prince Shotoku.",
      "sourceSentenceIds": [
        3,
        5
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 2"
      ],
      "source": "https://en.wikipedia.org/wiki/Tenn%C5%8Dji-ku%2C_Osaka"
    },
    {
      "id": 2,
      "text": "Tennoji Park, opened 1909, houses a zoo, an art museum, and the historic Sumitomo garden, making it a green hub amid the city.",
      "sourceSentenceIds": [
        2,
        9,
        28
      ],
      "sourceLabels": [
        "Web source 2",
        "Wikipedia"
      ],
      "source": "https://www.gltjp.com/en/article/item/20994/"
    },
    {
      "id": 3,
      "text": "The tallest building in Japan, Kintetsu Abeno Harukas, sits in Tennoji and opened in 2014, offering panoramic views.",
      "sourceSentenceIds": [
        25
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Tenn%C5%8Dji-ku%2C_Osaka"
    },
    {
      "id": 4,
      "text": "Tennoji Station is a major railway hub where JR West, Kintetsu, and Osaka Metro lines converge, shaping the ward’s growth.",
      "sourceSentenceIds": [
        14,
        15
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Tenn%C5%8Dji-ku%2C_Osaka"
    },
    {
      "id": 5,
      "text": "Shitennō-ji, the temple of the Four Heavenly Kings, is only a ten‑minute walk from the station and is a key historic site.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Tenn%C5%8Dji-ku%2C_Osaka"
    },
    {
      "id": 6,
      "text": "Tennoji Zoo, part of the park, keeps about 1,000 animals across 170 species, making it one of Japan’s oldest zoos.",
