  "facts": [
    {
      "id": 1,
      "text": "Viola sprang to life in 1856 when the Delaware Railroad opened a station at the crossroads of Canterbury and Willow Grove roads.",
      "sourceSentenceIds": [
        1,
        4
      ],
      "sourceLabels": [
        "Web source 1",
        "Wikipedia"
      ],
      "source": "https://grokipedia.com/page/Viola_Delaware",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town was renamed Viola after the daughter of a local landowner, replacing its original name Canterbury Station.",
      "sourceSentenceIds": [
        7,
        10
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/Viola_Delaware",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The station quickly became a commercial hub, shipping farm produce like peaches and receiving supplies that fueled local growth.",
      "sourceSentenceIds": [
        20,
        13
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/Viola_Delaware",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "In the late 19th and early 20th centuries, Viola supported a lumberyard, sawmill, and a husk factory that turned corn husks into mattresses.",
      "sourceSentenceIds": [
        3
      ],
