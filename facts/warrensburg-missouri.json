  "facts": [
    {
      "id": 1,
      "text": "Warrensburg was founded in 1835 by settlers John and Martin D. Warren, who named the town after Martin Warren’s family name.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Warrensburg%2C_Missouri",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "In 1836 the town’s shop became the county seat of newly created Johnson County, cementing Warrensburg’s early administrative role.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.warrensburg-mo.com/590/Warrensburg-History",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The two‑mile Warrensburg and Pertle Springs Railroad opened less than a year later, a single‑track streetcar line nicknamed “The Dummy.”.",
      "sourceSentenceIds": [
        12,
        13
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.warrensburg-mo.com/590/Warrensburg-History",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Blind Boone Park, once a segregated park for the Black community, was restored by volunteers who logged thousands of hours to honor J.W. “Blind” Boone.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.warrensburg-mo.com/590/Warrensburg-History",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The original 1838 Johnson County Courthouse sits in the historic town square at 302 N Main, a centerpiece of Warrensburg’s heritage.",
