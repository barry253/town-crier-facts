  "facts": [
    {
      "id": 1,
      "text": "Founded in 1876 as a Southern Pacific Yuma branch depot, Thousand Palms evolved from a railroad stop into a residential suburb.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/Thousand_Palms,_California",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "After a 1919 petition, the town renamed itself Thousand Palms in 1939, replacing the earlier name Edom.",
      "sourceSentenceIds": [
        4,
        5,
        23
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Thousand_Palms%2C_California",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The Thousand Palms Oasis, with Washingtonia filifera palms and perennial springs, supplied water and shelter to Cahuilla bands for centuries.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/Thousand_Palms,_California",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Because it sits on the San Andreas Fault, Thousand Palms faces seismic hazards that can trigger soil liquefaction in valley sediments.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/Thousand_Palms,_California",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The nearby Coachella Valley Preserve spans 20,000 acres of desert oases, dunes, and palm groves, protecting endangered species like the fringe‑toed lizard.",
      "sourceSentenceIds": [
        16,
        17
      ],
