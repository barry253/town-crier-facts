  "facts": [
    {
      "id": 1,
      "text": "North Kingsville grew from a 19th‑century transportation hub, with the Nettleton Stage House—built in 1812 as a tavern and coach stop—still echoing its early roadways.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/north_kingsville_ohio",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The village sits on the North Ridge Road, a historic corridor that once carried stagecoaches between Lake Erie and the interior of Ohio.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/north_kingsville_ohio",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "North Kingsville’s land was part of the Connecticut Western Reserve, sold by Connecticut to the Connecticut Land Company in 1795, attracting New England settlers.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/north_kingsville_ohio",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The North Kingsville Sand Barrens, a 182‑acre preserve managed by the Cleveland Museum of Natural History, protects fossil dunes from a pre‑Lake Erie shoreline.",
      "sourceSentenceIds": [
        26
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/north_kingsville_ohio",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The Sand Barrens also hosts rare bird species, making it a key stop on the Lake Erie Birding Trail.",
      "sourceSentenceIds": [
        27
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/north_kingsville_ohio",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The village government operates from a municipal building on East Center Street, where council meetings and court operations are held.",
      "sourceSentenceIds": [
        28
      ],
      "sourceLabels": [
        "Web source 2"
      ],
