      ],
      "source": "https://en.wikipedia.org/wiki/Isabella%2C_Missouri",
      "category": "other",
      "quality": "poor",
      "qualityReason": "location_description"
    },
    {
      "id": 4,
      "text": "Early settlers from Tennessee and Kentucky farmed fertile creek valleys, raising hogs, sheep, and running grist and saw mills.",
      "sourceSentenceIds": [
        15
      ],
      "sourceLabels": [
        "Web source 1"
      ],
