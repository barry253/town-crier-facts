      "category": "economy",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Isabella’s elevation averages 948 feet, with surrounding hills ranging from 540 to 1,460 feet, creating classic Ozark monadnocks.",
      "sourceSentenceIds": [
        22,
        23
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/isabella_missouri",
