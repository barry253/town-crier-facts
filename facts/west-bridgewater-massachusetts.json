  "facts": [
    {
      "id": 1,
      "text": "West Bridgewater was officially incorporated in 1822, the second community to split from Bridgewater during a three‑year wave of separations.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/West_Bridgewater%2C_Massachusetts",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town hosts the Keith House, built in 1662, which remains the oldest standing parsonage in the United States.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/West_Bridgewater%2C_Massachusetts",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "West Bridgewater once housed America’s first industrial park, now the site of Town Park, where the original Ames Shovel Works once operated.",
      "sourceSentenceIds": [
        11,
        12
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/West_Bridgewater%2C_Massachusetts",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The Town River ran through the area, providing water power for early mills and irrigation for farms that shaped the town’s agrarian roots.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/West_Bridgewater%2C_Massachusetts",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Route 106 cuts east‑west through West Bridgewater and meets Route 28 in the town center, a historic crossroads for regional travel.",
      "sourceSentenceIds": [
        18
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/West_Bridgewater%2C_Massachusetts",
      "category": "transport",
      "quality": "poor",
      "qualityReason": "route_only"
    },
    {
      "id": 6,
      "text": "The West Bridgewater Public Library, located near the post office, is part of the SAILS Library Network, connecting residents to a statewide collection.",
      "sourceSentenceIds": [
