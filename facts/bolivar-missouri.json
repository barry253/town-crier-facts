  "facts": [
    {
      "id": 1,
      "text": "Bolivar became the county seat of Polk County on November 10, 1835, after Greene County ceded its northern part to form Polk County.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Bolivar%2C_Missouri",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Bolivar was named after the Tennessee town of Bolivar, itself honoring South American liberator Simón Bolívar.",
      "sourceSentenceIds": [
        2,
        5,
        17
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Bolivar%2C_Missouri",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The Louisville & Nashville Railway reached Bolivar in 1884, sparking a boom that linked the town to regional trade.",
      "sourceSentenceIds": [
        23
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Bolivar%2C_Missouri",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Bolivar served as a full stop on the Butterfield Overland Mail route from 1858 to 1861, hosting the Franklin Hotel relay.",
      "sourceSentenceIds": [
        14
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Bolivar%2C_Missouri",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The Bolivar Public Library, First National Bank, and North Ward School together earn a place on the National Register of Historic Places.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Bolivar%2C_Missouri",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The Polk County Museum, housed in the 1903 North Ward School building, showcases local artifacts and historic exhibits for visitors.",
      "sourceSentenceIds": [
        11
