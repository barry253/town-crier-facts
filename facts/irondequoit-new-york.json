      "quality": "good"
    },
    {
      "id": 2,
      "text": "Irondequoit was founded in 1839 when it split from the town of Brighton.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Irondequoit%2C_New_York",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "When Irondequoit was founded in 1839, three‑quarters of its land remained untouched.",
