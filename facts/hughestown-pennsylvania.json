  "facts": [
    {
      "id": 1,
      "text": "By 1810, the hamlet of Hamtown, later Hughestown, was named after early Hughes family pioneers.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/hughestown_pennsylvania",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "On April 7, 1879, Hughestown officially became a borough.",
      "sourceSentenceIds": [
        13
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Hughestown%2C_Pennsylvania",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "In the late 1800s, Hughestown buzzed around the massive Number 9 Breaker operated by the Pennsylvania Coal Company, a key anthracite mining center.",
      "sourceSentenceIds": [
        5,
        15,
        14
      ],
      "sourceLabels": [
        "Web source 2",
        "Wikipedia"
      ],
      "source": "https://grokipedia.com/page/hughestown_pennsylvania",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Photographer Lewis Hine visited in 1911, capturing breaker boys that sparked national labor reform.",
      "sourceSentenceIds": [
        17,
        18
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Hughestown%2C_Pennsylvania",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "As coal waned after the mid‑20th‑century Knox Mine Disaster, the borough shifted to quiet residential life, repurposing former mines into housing.",
      "sourceSentenceIds": [
        19,
        20
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Hughestown%2C_Pennsylvania",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Hughestown experiences a humid continental climate with warm summers and snowy winters, typical of the Appalachian foothills.",
      "sourceSentenceIds": [
        11
