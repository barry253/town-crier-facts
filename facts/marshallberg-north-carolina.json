  "facts": [
    {
      "id": 1,
      "text": "Marshallberg was originally called Deep Hole Point, named for a huge hole dredged in Sleepy Creek before the Civil War.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.downeasttour.com/marshallberg",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "In 1819, George Bell’s heirs built the first windmill on the site, marking the town’s earliest industry.",
      "sourceSentenceIds": [
        13
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://digital.lib.ecu.edu/ncpi/view/34668",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "By the early 1900s, Marshallberg housed two tomato canning plants, fish houses, a crab processing facility, a movie theater, and an academy of higher learning.",
      "sourceSentenceIds": [
        26
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.downeasttour.com/marshallberg",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Shipbuilding in Marshallberg began in 1910 and continued through the 1990s, making the town a regional maritime hub.",
      "sourceSentenceIds": [
        16
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://digital.lib.ecu.edu/ncpi/view/34668",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Curt Davis, a celebrated house carpenter, built many of the two‑story homes with wrap‑around porches that still define the town’s historic streetscape.",
      "sourceSentenceIds": [
        21
      ],
