  "facts": [
    {
      "id": 1,
      "text": "Dayton's Historic Depot, built in 1881 in Stick/Eastlake style, is Washington's oldest surviving passenger station.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.achp.gov/preserve-america/community/dayton-washington"
    },
    {
      "id": 2,
      "text": "Dayton sits 1,600 feet above sea level where the Touchet River meets Patit Creek, nesting in a valley.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.achp.gov/preserve-america/community/dayton-washington"
    },
    {
      "id": 3,
      "text": "The city was incorporated November 10, 1881, and named after founder Jesse Day.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Dayton%2C_Washington"
    },
    {
      "id": 4,
      "text": "Dayton hosts a full‑scale, historically authentic model of the Patit Creek campsite from the Lewis and Clark Bicentennial.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.achp.gov/preserve-america/community/dayton-washington"
    },
    {
      "id": 5,
      "text": "The town’s Art, Wine, and Heritage Getaway package includes historic depot admission, a restored theater movie, and local gallery tours.",
      "sourceSentenceIds": [
        13
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.achp.gov/preserve-america/community/dayton-washington"
    },
    {
      "id": 6,
      "text": "Dayton's library began as a 1919 reading room funded by a women’s civics club, later becoming the county’s only public library.",
