  "facts": [
    {
      "id": 1,
      "text": "Named after author Jack London, the square hosts Amtrak station, ferry dock, historic Heinold's Saloon, and a cabin where London lived in the Klondike.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Jack_London_Square"
    },
    {
      "id": 2,
      "text": "From 1989 to 1996, the Oakland Tribune operated temporarily from Jack London Square after its downtown tower was damaged in the Loma Prieta earthquake.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Jack_London_Square"
    },
    {
      "id": 3,
      "text": "The square was officially dedicated in 1951, with a plaque at Broadway's foot, marking its formal naming.",
      "sourceSentenceIds": [
        3,
        16
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Jack_London_Square"
    },
    {
      "id": 4,
      "text": "Heinold's First and Last Saloon, opened 1883, remains lit by gas and was a favorite spot of Jack London.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.visitoakland.com/things-to-do/neighborhoods/jack-london-district/"
    },
    {
      "id": 5,
      "text": "California Canoe & Kayak, a kayak rental shop since 1993, offers guided moonlight and sunset kayak tours from the square.",
      "sourceSentenceIds": [
        7,
        20
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.visitoakland.com/things-to-do/neighborhoods/jack-london-district/"
    },
    {
      "id": 6,
      "text": "The former presidential yacht USS Potomac is moored at a slip adjacent to Jack London Square, adding maritime history.",
