  "facts": [
    {
      "id": 1,
      "text": "Warriors Mark sits at the crossroads of state routes 350 and 550, about 16 miles north‑northwest of Huntingdon.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Warriors_Mark%2C_Pennsylvania"
    },
    {
      "id": 2,
      "text": "The Lowrie Schoolhouse, built in the 1860s by carpenter Balzer Rumberger, once served the children of the Lowrie family and the town.",
      "sourceSentenceIds": [
        9,
        10
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://warriorsmarkareahistoricalsociety.com/"
    },
    {
      "id": 3,
      "text": "Today that same 1860s building houses the Warriors Mark Area Historical Society, preserving and sharing the town’s heritage.",
      "sourceSentenceIds": [
        1,
        2
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://warriorsmarkareahistoricalsociety.com/"
    },
    {
      "id": 4,
      "text": "Warriors Mark Township is celebrating its 250th anniversary this summer, with events planned for June 5 and 6 at the Methodist Church.",
      "sourceSentenceIds": [
        13,
        14,
        20,
        21
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://warriorsmarktwp.com/"
    },
    {
      "id": 5,
      "text": "The township lies in a pastoral valley between two ridges, a setting that has shaped its farming‑oriented landscape.",
      "sourceSentenceIds": [
        17
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://warriorsmarktwp.com/"
    },
    {
      "id": 6,
      "text": "The upcoming 250th celebration will feature a community gathering at the Warriors Mark Methodist Church, a historic venue for local events.",
