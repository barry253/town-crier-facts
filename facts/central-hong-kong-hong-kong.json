  "facts": [
    {
      "id": 1,
      "text": "The Hong Kong flu first appeared in Central Hong Kong in late May 1969, sparking a small local outbreak.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Hong_Kong_flu"
    },
    {
      "id": 2,
      "text": "The 1968–1970 pandemic, known as the Hong Kong flu, killed between one and four million people worldwide.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Hong_Kong_flu"
    },
    {
      "id": 3,
      "text": "Virologists noted that strains from the Hong Kong outbreak differed markedly from earlier influenza strains.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Hong_Kong_flu"
    },
    {
      "id": 4,
      "text": "By 17 September 1969, Central Hong Kong hospitals reported 7,661 influenza cases, a sharp rise from just eight cases earlier that month.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Hong_Kong_flu"
    },
    {
      "id": 5,
      "text": "A second wave of influenza hit Central Hong Kong in December 1969, causing a noticeable increase in cases.",
      "sourceSentenceIds": [
        13
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Hong_Kong_flu"
    },
    {
      "id": 6,
      "text": "During the 1969–1970 wave, Central Hong Kong saw excess pneumonia and influenza mortality rates of 11.3 and 49.1 per 100,000.",
