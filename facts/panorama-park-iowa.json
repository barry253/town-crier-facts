  "facts": [
    {
      "id": 1,
      "text": "Panorama Park was founded in 1953 when residents incorporated to take control of a neglected dirt road, Park Avenue.",
      "sourceSentenceIds": [
        7,
        8,
        9
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Panorama_Park%2C_Iowa",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Panorama Park contains just one north‑south road and lacks commercial businesses, a library, a church, or parks within its limits.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.thegazette.com/news/why-was-panorama-park-founded-iowa-town-of-139-surrounded-by-bettendorf-owes-its-existence/article_0be63876-eaa1-5b05-824b-750818253522.html",
      "category": "other",
      "quality": "poor",
      "qualityReason": "vague"
    },
    {
      "id": 3,
      "text": "The city contracts with surrounding governments for snow removal, fire, police, sewer, and library services, while privately hiring garbage and recycling pickup.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.thegazette.com/news/why-was-panorama-park-founded-iowa-town-of-139-surrounded-by-bettendorf-owes-its-existence/article_0be63876-eaa1-5b05-824b-750818253522.html",
      "category": "other",
      "quality": "poor",
      "qualityReason": "vague"
    },
    {
      "id": 5,
      "text": "Since its 1953 incorporation, Panorama Park residents enjoy lower taxes than those in neighboring Bettendorf.",
