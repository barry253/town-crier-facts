  "facts": [
    {
      "id": 1,
      "text": "Wasco takes its name from a local Chinook tribe that lived on the south side of the Columbia River.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Wasco_County%2C_Oregon"
    },
    {
      "id": 2,
      "text": "The town of Wasco sits high above the Columbia River Gorge between the Deschutes and John Day rivers.",
      "sourceSentenceIds": [
        25
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://wascooregon.com/"
    },
    {
      "id": 3,
      "text": "The Columbia Southern Railway reached Wasco in 1897, leading to the construction of a train station the following year.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://wascooregon.com/history/"
    },
    {
      "id": 4,
      "text": "The Wasco Train Depot served as a passenger and freight warehouse until passenger service ended in 1936.",
      "sourceSentenceIds": [
        22
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://wascooregon.com/"
    },
    {
      "id": 5,
      "text": "The historic Wasco School building was constructed in 1916 and remains a landmark for the town and Sherman County.",
