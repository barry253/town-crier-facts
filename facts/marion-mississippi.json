  "facts": [
    {
      "id": 1,
      "text": "Marion was named for Francis Marion, the Revolutionary War “Swamp Fox”.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Marion%2C_Mississippi",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "In 1850 Congress granted land for the Mobile & Ohio Railroad, but the line bypassed Marion, building a station two miles southwest in what became Meridian.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Marion%2C_Mississippi",
      "category": "transport",
      "quality": "poor",
      "qualityReason": "route_only"
    },
    {
      "id": 3,
      "text": "Marion served as Lauderdale County’s seat from its founding until 1870, when voters moved the seat to the rapidly growing city of Meridian.",
      "sourceSentenceIds": [
        9,
        16
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Marion%2C_Mississippi",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "In 1840 Marion boasted a drugstore, two blacksmith shops, six dry‑goods stores, and two academies—one for girls and one for boys.",
      "sourceSentenceIds": [
        11
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Marion%2C_Mississippi",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Sowashee Creek marks Marion’s eastern boundary, flowing southwest through Meridian before joining Okatibbee Creek and ultimately the Pascagoula River watershed.",
      "sourceSentenceIds": [
        20
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
