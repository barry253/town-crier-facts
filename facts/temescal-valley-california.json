  "facts": [
    {
      "id": 1,
      "text": "Temescal Valley takes its name from the Rancho Temescal founded by Leandro Serrano.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Temescal_Valley%2C_California",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The first house in the valley was built by Leandro Serrano around May 1824, marked by the Serrano Boulder landmark.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Temescal_Valley%2C_California",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "In 1857 the Butterfield Overland Mail established Temescal Station, just five miles north of the hot springs.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Temescal_Valley%2C_California",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "After a 1866 court ruling, the Temescal Tin Mine opened, produced 136 tons by 1892, and closed the same year.",
      "sourceSentenceIds": [
        23,
        26,
        27
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Temescal_Valley%2C_California",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "During the 1870s orchards and bee hives began to replace cattle ranching, with bees first introduced in the early 1870s.",
      "sourceSentenceIds": [
        18,
        19
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Temescal_Valley%2C_California",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Temescal had its own post office from 1861 until the Civil War shut it down, then reopened in 1874.",
      "sourceSentenceIds": [
