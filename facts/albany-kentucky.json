  "facts": [
    {
      "id": 1,
      "text": "Albany was named after Albany, New York, but a local legend says the name came from patrons shouting “All for Benny!” at the county seat vote.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
