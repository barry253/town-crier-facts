  "facts": [
    {
      "id": 1,
      "text": "Stewartstown got its name when the Post Office Department changed the postmark to \"Stewartstown\" on March 24, 1832.",
      "sourceSentenceIds": [
        20
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Stewartstown%2C_Pennsylvania",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town’s first settlers arrived around 1750, long before it was officially founded.",
      "sourceSentenceIds": [
        6,
        12
      ],
      "sourceLabels": [
        "Web source 1",
        "Wikipedia"
      ],
      "source": "https://www.stewartstown.org/history/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "A 1767 survey of the Mason–Dixon Line settled a long‑standing dispute between Maryland and Pennsylvania over the area that would become Stewartstown.",
      "sourceSentenceIds": [
        13,
        30
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Stewartstown%2C_Pennsylvania",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "In 1812, farmers from Hopewell Township laid out a new town that would later become Stewartstown.",
      "sourceSentenceIds": [
        15
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Stewartstown%2C_Pennsylvania",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Stewartstown’s main street follows a segment of a road that linked York and Baltimore by 1777.",
      "sourceSentenceIds": [
        14
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Stewartstown%2C_Pennsylvania",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The Stewartstown Engine House, Railroad Station, and Railroad are all listed on the National Register of Historic Places.",
