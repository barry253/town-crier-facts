  "facts": [
    {
      "id": 1,
      "text": "Cobden was originally called North Branch because of its location near Sleepy Eye Creek, but in 1886 it was renamed after British statesman Richard Cobden.",
      "sourceSentenceIds": [
        1,
        2
      ],
      "sourceLabels": [
        "Web source 2",
        "Wikipedia"
      ],
      "source": "https://lakesnwoods.com/Cobden.htm"
    },
    {
      "id": 2,
      "text": "The town grew around a Chicago and North Western Railroad station, with two grain elevators and two creameries serving the local farmers.",
      "sourceSentenceIds": [
        3,
        4
      ],
      "sourceLabels": [
        "Web source 2",
        "Web source 1"
      ],
      "source": "https://lakesnwoods.com/Cobden.htm"
    },
    {
      "id": 3,
      "text": "Cobden was officially platted in 1901 and incorporated as a city in 1905.",
      "sourceSentenceIds": [
        12,
        29
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Cobden%2C_Minnesota"
    },
    {
      "id": 4,
      "text": "A post office operated in Cobden from 1886 until it closed in 1972.",
      "sourceSentenceIds": [
        11
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Cobden%2C_Minnesota"
    },
    {
      "id": 5,
      "text": "The original village housed a bank, flour mill, hardware store, lumber yard, blacksmith shop, livery, and carriage shop.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.forgottenminnesota.com/2021/12/16/welcome-to-cobden/"
    },
    {
      "id": 6,
      "text": "Cobden sits within Brown County, Minnesota, and its early development was tied to the Cottonwood River watershed.",
      "sourceSentenceIds": [
        10,
