  "facts": [
    {
      "id": 1,
      "text": "Silt earned its name from the powdery silt that once blanketed the original town site.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Silt%2C_Colorado",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Until 1889, the area was called Ferguson; the Denver and Rio Grande Junction Railway renamed the depot 'Silt' after the local soil.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://silthistorical.org/our-history-1",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "A post office has served Silt since 1898, marking the town’s early communication hub.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Silt%2C_Colorado",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The historic Antler's School still stands on Antler's Lane between Silt and Rifle, though it no longer functions as a school.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://silthistorical.org/our-history-1",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Silt sits north of the Colorado River, about 175 miles west of Denver, on the eastern edge of Cactus Valley.",
