  "facts": [
    {
      "id": 1,
      "text": "Jamul’s name comes from the Kumeyaay word “ha‑mul,” meaning foam or lather from rushing water.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/Jamul,_California"
    },
    {
      "id": 2,
      "text": "Archaeology shows the Jamul Valley has been inhabited for over 12,000 years, a heritage the Jamul Indian Village traces back to 1981.",
      "sourceSentenceIds": [
        6,
        9
      ],
      "sourceLabels": [
        "Web source 1",
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/Jamul,_California"
    },
    {
      "id": 3,
      "text": "After the Gold Rush, fertile soils turned Jamul into a modest hub for grain, vegetables, and cattle by the mid‑1800s.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/Jamul,_California"
    },
    {
      "id": 4,
      "text": "In 1999 the Tipai Band of Kumeyaay Indians announced plans to build a hotel and casino on their 6‑acre sovereign land in Jamul.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Jamul%2C_California"
    },
    {
      "id": 5,
      "text": "Jamul was one of the communities scorched by the Valley Fire, one of California’s largest 2020 wildfires.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Jamul%2C_California"
    },
    {
      "id": 6,
      "text": "Rancho Jamul, once a Mexican land grant, witnessed a notable Indigenous labor uprising in the mid‑19th century.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
