  "facts": [
    {
      "id": 1,
      "text": "The Abbey of Dieleghem, founded in 1095, blends Romanesque and Gothic styles and stands as one of Jette’s oldest landmarks.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.trawellino.com/destinations/belgium/brussels-capital_jette"
    },
    {
      "id": 2,
      "text": "Jette became part of Brussels in 1921, when the city’s urban expansion absorbed the former rural village.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.trawellino.com/destinations/belgium/brussels-capital_jette"
    },
    {
      "id": 3,
      "text": "Jette railway station, opened in 1892 on Place Cardinal Mercier, still offers direct links to Brussels‑City and beyond.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Jette"
    },
    {
      "id": 4,
      "text": "Archaeologists have uncovered Neolithic tools and a Gallo‑Roman villa on Jette’s land, proving the area was settled long before the Middle Ages.",
      "sourceSentenceIds": [
        17
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Jette"
    },
    {
      "id": 5,
      "text": "The only surviving building of Dieleghem Abbey is its abbot’s mansion, now a museum that preserves the village’s medieval heritage.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Jette"
    },
    {
      "id": 6,
      "text": "Like every Brussels municipality, Jette is legally bilingual, officially recognizing both French and Dutch.",
      "sourceSentenceIds": [
        16
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Jette"
