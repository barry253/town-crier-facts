  "facts": [
    {
      "id": 1,
      "text": "First settled in 1805 by Alexander Moffatt, Limerick grew around a mill owned by Samuel Shelley and became a post office and railroad station by the late 19th century.",
      "sourceSentenceIds": [
        4,
        6,
        7
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/limerick_new_york",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The community’s early growth was spurred by the expansion of Fort Drum, a U.S. Army installation that reshaped the local economy in the late 20th century.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/limerick_new_york",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Limerick’s settlers arrived after the Revolutionary War, part of a wave that opened northern New York lands through treaties with Indigenous nations.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/limerick_new_york",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "In the early 1800s, John Baxter, Abner Smith, and Isaac Moffatt removed a reef of rocks at the Perch River rapids to drain flooded flats and improve land use for the growing community.",
      "sourceSentenceIds": [
        11
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/limerick_new_york",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Limerick’s name echoes the Irish city, a nod to the settlers’ heritage, though the town itself never reached the size of its namesake.",
      "sourceSentenceIds": [],
      "sourceLabels": [
