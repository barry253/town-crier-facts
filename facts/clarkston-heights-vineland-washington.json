  "facts": [
    {
      "id": 1,
      "text": "Clarkston Heights‑Vineland was founded in 1896 by Boston investors who laid out the town as an irrigation and hydro‑electric venture.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.historylink.org/File/9947"
    },
    {
      "id": 2,
      "text": "The town began as Jawbone Flat, a ferry landing that attracted settlers in the 1890s.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.historylink.org/File/9947"
    },
    {
      "id": 3,
      "text": "In 1897 the town was renamed Concord after Charles Francis Adams’s Massachusetts hometown, and a post office opened May 7 that year.",
      "sourceSentenceIds": [
        11
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.historylink.org/File/9947"
    },
    {
      "id": 4,
      "text": "The Nelson Clark House stands as a historic landmark, reflecting the region’s early architecture.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://beckdc.com/historical-places-in-clarkston-heights-vineland/"
    },
    {
      "id": 5,
      "text": "A WA State Historical Marker #36 commemorates Lewis & Clark’s entry into Washington near Clarkston Heights‑Vineland.",
      "sourceSentenceIds": [
        25,
        26
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://beckdc.com/historical-places-in-clarkston-heights-vineland/"
    },
    {
      "id": 6,
      "text": "The Old Clarkston Heights Schoolhouse is another preserved historic building that tells the town’s educational past.",
      "sourceSentenceIds": [
        24
      ],
