  "facts": [
    {
      "id": 1,
      "text": "Star City was originally called Scarboro, laid out in 1859, and renamed in 1861 after residents disliked the original name.",
      "sourceSentenceIds": [
        1,
        5,
        17
      ],
      "sourceLabels": [
        "Web source 1",
        "Wikipedia"
      ],
      "source": "https://grokipedia.com/page/star_city_indiana",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town’s post office opened in 1862, marking federal recognition and enabling communication for the growing community.",
      "sourceSentenceIds": [
        13,
        18
      ],
      "sourceLabels": [
        "Web source 1",
        "Wikipedia"
      ],
      "source": "https://grokipedia.com/page/star_city_indiana",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Star City grew as a railroad stop on the Pennsylvania Railroad, shipping grain and other agricultural products and becoming a local hub.",
      "sourceSentenceIds": [
        10,
        12
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/star_city_indiana",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The Star City Methodist Church, dedicated in 1867, was rebuilt after a 1904 fire and remains a historic landmark.",
      "sourceSentenceIds": [
        15
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/star_city_indiana",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The town’s early settlers cleared Two Mile Prairie, turning the expansive grassland into farms that laid the foundation for its rural economy.",
      "sourceSentenceIds": [
        6,
        28,
