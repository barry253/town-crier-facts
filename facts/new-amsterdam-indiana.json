  "facts": [
    {
      "id": 1,
      "text": "Founded 1815 by Jacob Funk and Samuel McAdams, New Amsterdam was platted on September 19, 1815.",
      "sourceSentenceIds": [
        13
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/New_Amsterdam%2C_Indiana"
    },
    {
      "id": 2,
      "text": "The town grew along the Ohio River, which was the main transportation route for settlers and traders.",
      "sourceSentenceIds": [
        14
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/New_Amsterdam%2C_Indiana"
    },
    {
      "id": 3,
      "text": "Steamboats frequented the river in the 19th century, boosting waterfront towns like New Amsterdam.",
      "sourceSentenceIds": [
        15
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/New_Amsterdam%2C_Indiana"
    },
    {
      "id": 4,
      "text": "The Great Ohio River flood of 1937 destroyed 75% of the town’s structures, leaving only the old country store.",
      "sourceSentenceIds": [
        17,
        18
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/New_Amsterdam%2C_Indiana"
    },
    {
      "id": 5,
      "text": "A marker on the second story of the old country store shows the water height during the 1937 flood.",
      "sourceSentenceIds": [
        19
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/New_Amsterdam%2C_Indiana"
    },
    {
      "id": 6,
      "text": "Every year the New Amsterdam Festival, also called Remembrance Day, celebrates the town’s history on the third Saturday of April.",
