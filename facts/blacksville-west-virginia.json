  "facts": [
    {
      "id": 1,
      "text": "Blacksville was named for its founder, David Black, a civil engineer who plotted the town's bounds in 1829.",
      "sourceSentenceIds": [
        3,
        4
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Blacksville%2C_West_Virginia"
    },
    {
      "id": 2,
      "text": "David Black originally secured one hundred acres of land for the town for only fifty dollars.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Blacksville%2C_West_Virginia"
    },
    {
      "id": 3,
      "text": "The General Assembly of Virginia established Blacksville as a municipal corporation on February 3, 1830.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Blacksville%2C_West_Virginia"
    },
    {
      "id": 4,
      "text": "Blacksville became an unincorporated community on June 20, 1863, during the American Civil War.",
      "sourceSentenceIds": [
        13
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Blacksville%2C_West_Virginia"
    },
    {
      "id": 5,
      "text": "The West Virginia Legislature re-incorporated the town of Blacksville in October 1897.",
      "sourceSentenceIds": [
        15
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Blacksville%2C_West_Virginia"
    },
    {
      "id": 6,
      "text": "Blacksville is located on Dunkard Creek, just south of the Mason-Dixon Line and the Pennsylvania border.",
      "sourceSentenceIds": [
