  "facts": [
    {
      "id": 1,
      "text": "Sleetmute’s name means 'wetstone people,' echoing the abundant slate that shaped the village’s indigenous heritage.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/sleetmute_alaska"
    },
    {
      "id": 2,
      "text": "American trader Frederick Bishop founded a permanent post in 1906, sparking modest growth that led to a school in 1921 and a post office in 1923.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/sleetmute_alaska"
    },
    {
      "id": 3,
      "text": "The Saints Peter and Paul Russian Orthodox Church, built in 1931, remains a cultural landmark in Sleetmute.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/sleetmute_alaska"
    },
    {
      "id": 4,
      "text": "Russian explorers first reached the Sleetmute area in the early 1800s, bringing fur trade goods but no large‑scale settlement.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/sleetmute_alaska"
    },
    {
      "id": 5,
      "text": "Sleetmute’s economy blends subsistence hunting, fishing, and trapping with limited wage work and government transfers.",
      "sourceSentenceIds": [
        27
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/sleetmute_alaska"
    },
    {
      "id": 6,
      "text": "Sleetmute sits on the east bank of the Kuskokwim River, just 1.5 miles north of its junction with the Holitna River.",
      "sourceSentenceIds": [
