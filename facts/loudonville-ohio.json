      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "During the heyday of the Pennsylvania Railroad, Loudonville was a popular stop with special fares, and inventor Charles Kettering visited in 1944.",
      "sourceSentenceIds": [
        9,
        10
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
