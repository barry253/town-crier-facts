      "category": "culture",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The Ohio Theatre, erected in 1909 as City Hall and Opera House, survived a 1990s shutdown when students raised $4,000.",
      "sourceSentenceIds": [
        7
