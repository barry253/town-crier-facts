  "facts": [
    {
      "id": 1,
      "text": "Hay’s name sprang from a 1893 blizzard when a rail siding was stocked with hay, turning “Hay Station” into the town’s nickname.",
      "sourceSentenceIds": [
        3,
        15
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/hay_washington",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town’s post office opened in 1893, marking Hay’s formal recognition as a rural hub for mail and supplies.",
      "sourceSentenceIds": [
        11
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/hay_washington",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Hay Cemetery, founded in 1899, began as Curtis Cemetery after landowner Curtis donated a plot for burials.",
      "sourceSentenceIds": [
        7,
        14
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/hay_washington",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Perched at 1,089 feet, Hay sits amid the Palouse’s rolling hills, famed for its fertile soil and dryland wheat.",
      "sourceSentenceIds": [
        30
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/hay_washington",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Whitman County, where Hay lies, was created in 1871 from Stevens County and named after missionary Marcus Whitman.",
      "sourceSentenceIds": [
        2
