  "facts": [
    {
      "id": 1,
      "text": "Waikele means 'muddy water' from wai + kele, reflecting the turbid flow of the Waikele Stream.",
      "sourceSentenceIds": [
        23
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/waikele_hawaii",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Waikele was an ahupua'a in the ‘Ewa District, stretching from the Wai‘anae and Ko‘olau ranges to Pu‘uloa near Pearl Harbor.",
      "sourceSentenceIds": [
        22
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/waikele_hawaii",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Extensive lo‘i kalo lined the lower Waikele Stream valley, irrigated by the stream and springs like Waipahu Spring.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/waikele_hawaii",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Coastal loko i‘a such as Loko Ka‘auku‘u, Loko Ma‘aha, and Loko Pouhala—now part of Pouhala Marsh—provided marine resources like mullet and goatfish.",
      "sourceSentenceIds": [
        25
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/waikele_hawaii",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Petroglyphs at State Archaeological Site #50-80-05-530 feature about 12 human figures along the north bank of Waikele Stream, marking ancient activity.",
      "sourceSentenceIds": [
        27
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/waikele_hawaii",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Hawai‘i’s Plantation Village museum depicts multiethnic sugar plantation life from the 1850s to 1950s, while Waipahu Cultural Garden Park restores wetlands and teaches traditional practices.",
