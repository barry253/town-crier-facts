      "id": 1,
      "text": "Hampton and its surrounding county are named after Wade Hampton III, a Confederate general and former governor of South Carolina.",
      "sourceSentenceIds": [
        1,
        2
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
