    },
    {
      "id": 2,
      "text": "Hampton was established at the midpoint of the Port Royal Railroad to encourage economic development between Augusta and Port Royal.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Hampton%2C_South_Carolina"
    },
    {
      "id": 3,
      "text": "The Hampton County Guardian began printing two months before the town was founded and remains the local paper of record today.",
      "sourceSentenceIds": [
