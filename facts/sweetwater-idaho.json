  "facts": [
    {
      "id": 1,
      "text": "Sweetwater got its name when a mule carrying sugar fell into the creek, sweetening the water.",
      "sourceSentenceIds": [
        9,
        28
      ],
      "sourceLabels": [
        "Web source 1",
        "Web source 2"
      ],
      "source": "https://www.nezpercecountymuseum.com/sweetwater-idaho",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "William Craig established Idaho's first permanent white homestead near Sweetwater Creek in 1840, after marrying a Nez Perce woman and gaining tribal permission.",
      "sourceSentenceIds": [
        3,
        23
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/sweetwater_idaho",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Long before settlers, the Nez Perce tribe used Sweetwater’s fertile valleys for hunting, gathering camas roots, fishing salmon, and pasturing horses.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/sweetwater_idaho",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The 1909 opening of the Camas Prairie Railroad’s Grangeville branch turned Sweetwater into a key grain shipping hub for surrounding farms.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/sweetwater_idaho",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Sweetwater’s early general store and post office burned three times—1966’s last fire left the building unrebuilt, turning the site into a residential area.",
