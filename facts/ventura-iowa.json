      "id": 1,
      "text": "Ventura earned its name in 1890 when pioneers renamed Thayer's Siding to honor their bold venture into the region.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
