      ],
      "source": "https://www.tourchautauqua.com/directory/sinclairville-village-of",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Sinclairville’s library sits beside the village post office, offering programs that keep the community connected.",
      "sourceSentenceIds": [
        7,
        8
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.villageofsinclairvilleny.org/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The village lies at the crossroads of County Roads 64, 66, and 77, a historic transport hub.",
