  "facts": [
    {
      "id": 1,
      "text": "Randolph was renamed in honor of Randolph, Massachusetts, itself named after Peyton Randolph, first President of the Continental Congress and friend of George Washington.",
      "sourceSentenceIds": [
        1,
        2
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Randolph%2C_Maine",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Randolph sits on the eastern bank of the Kennebec River, just south of Augusta, where the river meets the Cobbesseeconte Stream.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Randolph%2C_Maine",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Randolph is Maine’s smallest municipality by area that isn’t an island, giving it a cozy, close‑knit feel.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Randolph%2C_Maine",
      "category": "other",
      "quality": "poor",
      "qualityReason": "vague"
    },
    {
      "id": 4,
      "text": "From 1890 to 1929, the Kennebec Central Railroad connected Randolph to the National Soldiers’ Home in Togus.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Randolph%2C_Maine",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The old Gardiner‑Pittston Bridge, opened as a toll bridge in 1853, was bought by the towns in 1887 and tolls removed.",
      "sourceSentenceIds": [
        26
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.randolphmaine.org/index.asp?SEC=9E5572B4-6E52-4718-B3D6-2621829A408B",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Randolph lies on the Kennebec River, part of the navigable stretch that reaches Augusta, where the Edwards Dam sits.",
