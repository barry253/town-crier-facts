      "id": 1,
      "text": "Thiensville takes its name from settler Joachim Heinrich Thien, who mapped the village’s original layout in 1842.",
      "sourceSentenceIds": [
        2,
        3
      ],
      "sourceLabels": [
        "Web source 1",
        "Web source 2"
      ],
