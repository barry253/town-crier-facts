  "facts": [
    {
      "id": 1,
      "text": "Horton Bay was founded in 1876 as a lumbering community by pioneer Samuel Horton, who arrived by sailboat on August 1, 1856.",
      "sourceSentenceIds": [
        1,
        4,
        5
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://northernmichiganhistory.com/the-founding-of-horton-bay/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The village’s original name was Horton's Bay, changed to Horton Bay on October 12, 1894, after a post office opened in 1879.",
      "sourceSentenceIds": [
        6,
        25
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Horton_Bay%2C_Michigan",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Horton Bay earned Michigan State Historic Site status on November 12, 1975, recognizing its rich local heritage.",
      "sourceSentenceIds": [
        2,
        7,
        15
      ],
      "sourceLabels": [
        "Web source 1",
        "Web source 2"
      ],
      "source": "https://kids.kiddle.co/Horton_Bay,_Michigan",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Three historic properties—Horton Bay General Store, Horton Bay School, and the Red Fox Inn—are listed on the National Register of Historic Places.",
      "sourceSentenceIds": [
        9,
        22,
        29
      ],
      "sourceLabels": [
        "Web source 1",
        "Web source 2",
        "Wikipedia"
      ],
      "source": "https://kids.kiddle.co/Horton_Bay,_Michigan",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Ernest Hemingway spent boyhood summers in Horton Bay, fishing and camping, and later married there in 1921.",
      "sourceSentenceIds": [
        20,
        28
      ],
      "sourceLabels": [
        "Web source 2",
        "Wikipedia"
      ],
      "source": "https://northernmichiganhistory.com/the-founding-of-horton-bay/",
      "category": "people",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The community sits on the northeastern shore of Lake Charlevoix, offering scenic views of the lake’s crystal waters.",
