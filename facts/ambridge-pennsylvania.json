  "facts": [
    {
      "id": 1,
      "text": "Ambridge was incorporated in 1905 as a company town by the American Bridge Company, which gave the borough its name.",
      "sourceSentenceIds": [
        6,
        21
      ],
      "sourceLabels": [
        "Web source 1",
        "Wikipedia"
      ],
      "source": "https://www.ambridgeboro.org/tourism",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Old Economy Village, a National Historic Landmark, preserves the Harmony Society’s 1824 settlement founded by George Rapp.",
      "sourceSentenceIds": [
        2,
        5,
        25
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 2"
      ],
      "source": "https://en.wikipedia.org/wiki/Ambridge%2C_Pennsylvania",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The museum showcases fourteen original buildings fully restored, offering tours that bring the Harmony Society’s history to life.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.visitpa.com/explore/regions/pittsburgh-countryside/ambridge/",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The historic district contains sixty‑five original Harmonist homes, charming shops, and a historic bed‑and‑breakfast.",
      "sourceSentenceIds": [
        15
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.visitpa.com/explore/regions/pittsburgh-countryside/ambridge/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Merchant Street’s interpretive signs honor the diverse European immigrant heritage and the town’s steel‑industry legacy.",
      "sourceSentenceIds": [
        16
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.visitpa.com/explore/regions/pittsburgh-countryside/ambridge/",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Ambridge sits 16 miles northwest of Pittsburgh on the Ohio River, near the historic Legionville training camp of General Wayne.",
