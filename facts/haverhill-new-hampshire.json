  "facts": [
    {
      "id": 1,
      "text": "Haverhill was first called Lower Cohos, a name drawn from the Abenaki people who farmed the area.",
      "sourceSentenceIds": [
        11,
        12
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Haverhill%2C_New_Hampshire",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "After settling in 1763, Haverhill became Grafton County's seat a decade later in 1773.",
      "sourceSentenceIds": [
        13
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Haverhill%2C_New_Hampshire",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The Haverhill–Bath Bridge, built in 1829, remains the oldest documented covered bridge still standing in the United States.",
      "sourceSentenceIds": [
        15
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Haverhill%2C_New_Hampshire",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Pike village grew around the Pike Manufacturing Company, once the world’s leading producer of whetstones.",
      "sourceSentenceIds": [
        16
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Haverhill%2C_New_Hampshire",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Municipal offices moved from Haverhill Corner to North Haverhill in 1972, placing the county seat just two miles north on Route 10.",
