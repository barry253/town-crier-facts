    },
    {
      "id": 2,
      "text": "The Huron River borders New Boston to the east, separating its developed areas from neighboring townships.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/new_boston_michigan"
    },
    {
      "id": 3,
      "text": "When the Michigan Central Railroad arrived in the mid‑1800s, New Boston grew grain elevators, lumber yards, and general stores along the tracks.",
      "sourceSentenceIds": [
        16,
        17
      ],
      "sourceLabels": [
        "Web source 1"
