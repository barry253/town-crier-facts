    },
    {
      "id": 2,
      "text": "Weston is part of Luzerne County, which hosts the annual Babe Ruth Sultan of Swat Home Run Derby on October 10.",
      "sourceSentenceIds": [
        18
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.visitluzernecounty.com/"
    },
    {
      "id": 3,
      "text": "Luzerne County celebrates America’s 250th anniversary with reenactments, pierogi festivals, and concerts, events that Weston residents can enjoy.",
      "sourceSentenceIds": [
        19
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.visitluzernecounty.com/"
    },
    {
      "id": 4,
      "text": "The 8th annual Rockin’ the River summer concert series returns in July, drawing music fans to the county’s riverside venue.",
      "sourceSentenceIds": [
        17
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.visitluzernecounty.com/"
    },
    {
      "id": 5,
      "text": "The Honeybee Festival, held in May, offers local honey tastings and community activities for Weston families.",
      "sourceSentenceIds": [
