  "facts": [
    {
      "id": 1,
      "text": "Canjilon, pronounced \"Con-hee-lone,\" gets its name from a Northern New Mexican Spanish word meaning \"deer antler,\" echoing the area's antler‑shaped ridges.",
      "sourceSentenceIds": [
        28
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/canjilon_new_mexico",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Canjilon was first settled in 1870 by Hispanic pioneers, and by 1880 the community housed 35 families.",
      "sourceSentenceIds": [
        9,
        24
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Canjilon%2C_New_Mexico",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Canjilon sits on a high‑elevation plateau of about 7,800 feet, surrounded by low hills, aspen and conifer‑covered mountains.",
      "sourceSentenceIds": [
        13,
        10
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/canjilon_new_mexico",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Canjilon experiences a cold continental climate with large diurnal temperature swings, cool snowy winters and mild summers.",
      "sourceSentenceIds": [
        6,
        2
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/canjilon_new_mexico",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Since 1908, Canjilon has fallen within Carson National Forest boundaries, bringing federal oversight to its land use.",
      "sourceSentenceIds": [
        7,
        16
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/canjilon_new_mexico",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Canjilon Creek flows south from the plateau through forested canyons, joining the Rio Chama and feeding the upper Rio Grande watershed.",
      "sourceSentenceIds": [
        15
