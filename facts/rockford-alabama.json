  "facts": [
    {
      "id": 1,
      "text": "Rockford was founded in 1835 on Hatchet Creek and became Coosa County's seat after a vote that chose it over Nixburg and Wetumpka.",
      "sourceSentenceIds": [
        1,
        2,
        26
      ],
      "sourceLabels": [
        "Web source 2",
        "Web source 1",
        "Wikipedia"
      ],
      "source": "https://grokipedia.com/page/rockford_alabama",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The Old Rock Jail, built in 1825, is Alabama's oldest surviving stone jail and now operates as a museum.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/rockford_alabama",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The Rockford Women's Club House, built in 1932, was listed on the Alabama Register of Landmarks and Heritage in 1996.",
      "sourceSentenceIds": [
        20
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/rockford_alabama",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The town's early economy depended on agriculture, and in the 20th century the Avondale Mills textile plant employed many residents until its closure in 2008.",
      "sourceSentenceIds": [
        16
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/rockford_alabama",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The selection of Rockford as county seat was influenced by ancient Creek Indian towns along Hatchet Creek, reflecting pre‑existing Native American history.",
      "sourceSentenceIds": [
        24
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/rockford_alabama",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Rockford lies along U.S. Route 231, which runs north–south through the town, connecting it 21 miles to Sylacauga and 28 miles to Wetumpka.",
