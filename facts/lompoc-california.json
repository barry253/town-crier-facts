  "facts": [
    {
      "id": 1,
      "text": "Founded in 1874 by the Lompoc Valley Land Company, the city grew from subdivided Ranchos Lompoc and Misión Vieja into a thriving farming community.",
      "sourceSentenceIds": [
        15
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.britannica.com/place/Lompoc"
    },
    {
      "id": 2,
      "text": "The Chumash Indians first settled Lompoc, calling it Lom‑poke and making the region the heart of their society.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://lompochistory.org/index.php/history/"
    },
    {
      "id": 3,
      "text": "When the coastal railroad reached Lompoc in 1901, shipping gave way to trains, sparking rapid population growth.",
      "sourceSentenceIds": [
        30
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://lompochistory.org/index.php/history/"
    },
    {
      "id": 4,
      "text": "The Lompoc Museum, housed in a William Weeks‑designed Carnegie building, showcases Native American artifacts and local history.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://lompochistory.org/index.php/history/"
    },
    {
      "id": 5,
      "text": "Renamed Vandenberg Air Force Base in 1958, the former Cooke Air Force Base now launches space missions from Lompoc.",
      "sourceSentenceIds": [
        13
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://lompochistory.org/index.php/history/"
    },
    {
      "id": 6,
      "text": "Since 1996, the Lompoc Pops Orchestra has performed with about 45 semi‑professional musicians, enriching the town’s cultural scene.",
      "sourceSentenceIds": [
