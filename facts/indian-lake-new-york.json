  "facts": [
    {
      "id": 1,
      "text": "Indian Lake proudly brands itself the Moose capital of the Northeast.",
      "sourceSentenceIds": [
        11
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Indian_Lake%2C_New_York",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town was founded in 1858, carved from parts of Gilman, Long Lake, and Wells.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Indian_Lake%2C_New_York",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Just three years later, in 1861, Indian Lake annexed land from Gilman and Lake Pleasant.",
      "sourceSentenceIds": [
        13
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Indian_Lake%2C_New_York",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Rainbow Lake Dam, erected in 1929, lingered as a safety concern until its removal in May 2023.",
      "sourceSentenceIds": [
        20,
        21,
        26
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Indian_Lake%2C_New_York",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Nestled inside the Adirondack Park, Indian Lake borders Essex and Warren counties to the east.",
      "sourceSentenceIds": [
        14,
        15
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Indian_Lake%2C_New_York",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Indian Lake has no permanent stop lights, so drivers glide through the town like in a quiet wilderness.",
