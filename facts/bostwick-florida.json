  "facts": [
    {
      "id": 1,
      "text": "Bostwick settled in 1882 around a mill that made railroad ties for the Jacksonville‑to‑Tampa line, plus citrus and timber.",
      "sourceSentenceIds": [
        1,
        8
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/bostwick_florida",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Bostwick School, built in 1921, was a two‑story frame building that served grades 1‑8 and community events until 1977.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/bostwick_florida",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The school was listed on the National Register of Historic Places in 1999 for its education and social history, hosting carnivals, plays, sports, and polling from 1928 to 1956.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/bostwick_florida",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "In 2007 the former school reopened as the Bostwick Library and Community Center at 125 Tillman Street, continuing to serve local residents.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/bostwick_florida",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Bostwick hosts an annual Blueberry Festival each April, celebrating local produce and community spirit.",
      "sourceSentenceIds": [
        14
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Bostwick%2C_Florida",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Bostwick lies eight miles north of Palatka along U.S. Route 17, near the St. Johns River whose navigable waters shaped early settlement.",
      "sourceSentenceIds": [
