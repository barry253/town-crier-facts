        29
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Franklin%2C_Massachusetts",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The Franklin Historical Museum, housed in the town’s original 1842 town hall, showcases artifacts that trace Franklin’s vibrant past.",
      "sourceSentenceIds": [
        4,
        16
      ],
      "sourceLabels": [
        "Web source 2"
      ],
