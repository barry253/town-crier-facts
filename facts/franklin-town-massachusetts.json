      ],
      "source": "https://en.wikipedia.org/wiki/Franklin%2C_Massachusetts",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Franklin’s Franklin Public Library, founded in 1790 with books donated by Benjamin Franklin, remains America’s oldest operating public library.",
      "sourceSentenceIds": [
        23,
