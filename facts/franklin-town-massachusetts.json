      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The Ladybug Cultural and Historical Trail weaves through downtown Franklin, letting visitors stroll past shops while learning about the town’s heritage.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 2"
      ],
