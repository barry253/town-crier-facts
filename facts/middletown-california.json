      "id": 1,
      "text": "The Stone House, built 1853‑54 by Robert Sterling, is Lake County’s oldest building and once served as the Guenoc land grant headquarters.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
