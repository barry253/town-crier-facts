  "facts": [
    {
      "id": 1,
      "text": "Sacajawea, a Lemhi Shoshone guide, led the Loring Expedition that founded Fort Hall in 1849.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://idahohighcountry.org/forthall/"
    },
    {
      "id": 2,
      "text": "The original Fort Hall was a cottonwood log stockade with two blockhouses built near the Snake‑Portneuf confluence.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.legendsofamerica.com/id-forthall/"
    },
    {
      "id": 3,
      "text": "Cantonment Loring, often called Fort Hall, was established by the Loring Expedition of Mounted Riflemen from Fort Leavenworth.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.legendsofamerica.com/id-forthall/"
    },
    {
      "id": 4,
      "text": "In 1870 federal troops erected a new Fort Hall 25 miles northeast of the original site.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.legendsofamerica.com/id-forthall/"
    },
    {
      "id": 5,
      "text": "Fort Hall served as a vital way station and supply point for emigrants traveling the Oregon‑California Trail.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.legendsofamerica.com/id-forthall/"
    },
    {
      "id": 6,
      "text": "Every August, the Shoshone‑Bannock Festival celebrates tribal culture on the Fort Hall Reservation.",
      "sourceSentenceIds": [
        30
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://idahohighcountry.org/forthall/"
    }
  ]
}
