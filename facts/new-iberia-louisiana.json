  "facts": [
    {
      "id": 1,
      "text": "New Iberia was founded in spring 1779 by about 500 Spanish colonists led by Lt. Col. Francisco Bouligny.",
      "sourceSentenceIds": [
        30
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.lsuagcenter.com/portals/our_offices/parishes/iberia/features/about_the_parish",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The city’s name comes from the settlers’ “Nueva Iberia,” echoing the Iberian Peninsula.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.lsuagcenter.com/portals/our_offices/parishes/iberia/features/about_the_parish",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Avery Island, just outside the parish, houses the Tabasco sauce factory and historic rock salt deposits.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.lsuagcenter.com/portals/our_offices/parishes/iberia/features/about_the_parish",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Shadows‑on‑the‑Teche, a National Trust plantation, sits on Bayou Teche and is a preserved historic residence.",
      "sourceSentenceIds": [
        13
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/New_Iberia%2C_Louisiana",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "New Iberia hosts the annual Louisiana Sugarcane Festival each September, celebrating local agriculture.",
