      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The village’s original name was Winwood, and early settlers in 1817 included David Wooley, James Moore, and Franklin Duval.",
      "sourceSentenceIds": [
        3,
        6
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/lakewood_pennsylvania",
      "category": "other",
      "quality": "poor",
      "qualityReason": "location_description"
    },
    {
      "id": 3,
      "text": "Lakewood is an unincorporated village in Preston Township, located along Pennsylvania Route 370 about seven miles east of Thompson.",
      "sourceSentenceIds": [
        27,
        30
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/lakewood_pennsylvania",
