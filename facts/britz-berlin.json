  "facts": [
    {
      "id": 1,
      "text": "Schloss Britz was first mentioned in 1373 in the Landbuch of Charles IV.",
      "sourceSentenceIds": [
        17
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Schloss_Britz",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "In 1699 the Britzke family sold the estate to the Prussian crown for 30,000 thalers.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.visitberlin.de/en/schloss-britz-and-gutspark",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "King Frederick II used the manor as a country estate from 1751 until his death, even establishing one of Prussia's first silk farms there.",
      "sourceSentenceIds": [
        26,
        27
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Schloss_Britz",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Silk trader Johann Carl Jouanne rebuilt the manor between 1824 and 1857 to suit his needs.",
      "sourceSentenceIds": [
        29
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Schloss_Britz",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The park earned the German Gustav Meyer Prize in 1997 for its accurate historical reconstruction.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Schloss_Britz",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "In 1971 Schloss Britz was declared a historic monument, and after a 1985‑88 renovation it opened to the public for the first time.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
