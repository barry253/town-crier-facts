      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Homes in the neighborhood illustrate Italianate, Gothic Revival, and Queen Anne architecture that flourished between 1836 and 1930.",
      "sourceSentenceIds": [
        23
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Chatham%E2%80%93Arch%2C_Indianapolis",
      "category": "other",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "A five‑acre railroad depot operated in Chatham Arch’s early years, helping the area grow around the rail line.",
