  "facts": [
    {
      "id": 1,
      "text": "Watseka’s name comes from Potawatomi “Watch‑e‑kee”, meaning “Daughter of the Evening Star”, named for the wife of early settler Gurdon Saltonstall Hubbard.",
      "sourceSentenceIds": [
        13,
        25
      ],
