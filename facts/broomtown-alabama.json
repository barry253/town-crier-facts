  "facts": [
    {
      "id": 1,
      "text": "It was named for Chief Broom (Broomstown) of the Cherokee Nation, whose people occupied the area from the late eighteenth century into the 1830s.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Broomtown%2C_Alabama"
    },
    {
      "id": 2,
      "text": "Broomtown sits in northeastern Cherokee County, Alabama, about ten miles northwest of the county seat Centre and right on the Georgia state line.",
      "sourceSentenceIds": [
        16,
        20
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/broomtown_alabama"
    },
    {
      "id": 3,
      "text": "The community lies in the Appalachian foothills, where fertile valleys and ridges give way to low valleys that flood after heavy rains.",
      "sourceSentenceIds": [
        17,
        4,
        15
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/broomtown_alabama"
    },
    {
      "id": 4,
      "text": "Fort Likens, a military post used during the Cherokee removal, stood close to Broomtown.",
      "sourceSentenceIds": [
        13
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Broomtown%2C_Alabama"
    },
    {
      "id": 5,
      "text": "In 1937, the Tennessee Valley Authority helped bring electricity to Broomtown through the Cherokee Electric Cooperative.",
      "sourceSentenceIds": [
        11
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/broomtown_alabama"
    },
    {
      "id": 6,
      "text": "Broomtown enjoys a humid subtropical climate, with hot, humid summers, mild winters, and about 55 inches of rain each year.",
