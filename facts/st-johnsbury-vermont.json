  "facts": [
    {
      "id": 1,
      "text": "St. Johnsbury was originally granted in 1760 as Bessborough, part of the New Hampshire Grants.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/St._Johnsbury%2C_Vermont"
    },
    {
      "id": 2,
      "text": "The town became the shire town of Caledonia County in 1856, replacing Danville as the county seat.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/St._Johnsbury%2C_Vermont"
    },
    {
      "id": 3,
      "text": "St. Johnsbury sits at the confluence of the Passumpsic, Moose, and Sleeper's rivers, anchoring the Passumpsic River basin.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/St._Johnsbury%2C_Vermont"
    },
    {
      "id": 4,
      "text": "Johnsbury Academy, a private high school founded by the Fairbanks family in 1842, remains a historic educational institution.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/St._Johnsbury%2C_Vermont"
    },
    {
      "id": 5,
      "text": "Ide Company, a grain wholesaler founded in 1813, was the town’s oldest continuously operating business until 2003.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/St._Johnsbury%2C_Vermont"
