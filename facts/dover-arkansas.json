  "facts": [
    {
      "id": 1,
      "text": "Dover was named either by British aristocrats in the 1830s after Dover, Kent, England, or by Stephen Rye in 1832 after Dover, Tennessee.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Dover%2C_Arkansas",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Dover emerged as a settlement in Pope County during the early 1830s amid the influx of Euro‑American pioneers after Native American removal.",
      "sourceSentenceIds": [
        11
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/dover_arkansas",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The Little Rock and Fort Smith Railroad bypassed Dover in 1872, prompting a 1887 vote that moved the county seat to Russellville.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/dover_arkansas",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "During 1867‑1868, companies E and G of the Nineteenth Infantry were headquartered in Dover for a year and a half.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Dover%2C_Arkansas",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "On April 8, 1865, Dover’s courthouse was burned, a key event during the Civil War’s chaotic period.",
      "sourceSentenceIds": [
        20
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Dover%2C_Arkansas",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The mild hills around Dover, in the Arkansas River Valley, historically supported oak‑hickory or oak‑hickory‑pine forests.",
