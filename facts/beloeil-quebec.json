  "facts": [
    {
      "id": 1,
      "text": "Beloeil's recorded history starts on January 18, 1694 when Governor Frontenac granted Joseph Hertel the seigneurie that became the town.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Beloeil%2C_Quebec",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Beloeil probably gets its name from the French phrase \"Quel bel œil!\", meaning \"What a beautiful view!\", attributed to Hertel's brother.",
      "sourceSentenceIds": [
        24
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Beloeil%2C_Quebec",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "In 1864, a passenger train plunged off an open bridge between Beloeil-Station and Mont-Saint-Hilaire, killing 99 in Canada's worst rail disaster.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Beloeil%2C_Quebec",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Industrialization kicked off in 1878 when the Hamilton Powder Company opened an explosives factory south of Beloeil-Station, later becoming part of McMasterville.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Beloeil%2C_Quebec",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The Club de Golf Belœil, founded in 1923, sits on Montreal’s South Shore right in the heart of Beloeil.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
