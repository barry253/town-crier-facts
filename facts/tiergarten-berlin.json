  "facts": [
    {
      "id": 1,
      "text": "Tiergarten literally means \"Animal Garden,\" once a hunting ground of Brandenburg electors, now a grand urban park designed by Lenné in the 1830s.",
      "sourceSentenceIds": [
        2,
        9
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Tiergarten_(Berlin)",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The Victory Column, a four‑tiered monument, sits in the park’s center and was moved by Nazis from its original ceremonial location.",
      "sourceSentenceIds": [
        24
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Tiergarten_(Berlin)",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Schloss Bellevue, the German President’s residence, and the Carillon are located within Tiergarten park.",
      "sourceSentenceIds": [
        23
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Tiergarten_(Berlin)",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The Reichstag building, home of the Bundestag, stands in the park’s western edge, and the new German Chancellery is nearby.",
      "sourceSentenceIds": [
        22
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Tiergarten_(Berlin)",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "An open‑air museum commemorating historic street lighting was established near Tiergarten S‑bahn station in 1978.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.visitberlin.de/en/tiergarten",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The Tiergarten houses the Berlin Zoo on its western border, a world‑famous animal collection.",
      "sourceSentenceIds": [
        28
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Tiergarten_(Berlin)",
