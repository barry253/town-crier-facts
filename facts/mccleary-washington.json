  "facts": [
    {
      "id": 1,
      "text": "McCleary began as a logging camp in late 1898 before becoming an incorporated city on January 6, 1943.",
      "sourceSentenceIds": [
        1,
        2
      ],
      "sourceLabels": [
        "Web source 1",
        "Wikipedia"
      ],
      "source": "https://www.cityofmccleary.com/community/page/history-city"
    },
    {
      "id": 2,
      "text": "The city’s name honors Henry McCleary, who arrived in 1897 and built two sawmills and a door‑manufacturing company.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/McCleary%2C_Washington"
    },
    {
      "id": 3,
      "text": "Since 1959, McCleary has celebrated its annual Bear Festival with live music, a parade, and community festivities.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/McCleary%2C_Washington"
    },
    {
      "id": 4,
      "text": "The McCleary Museum, operated by the McCleary Historical Society, serves as the city’s cultural center and preserves local history.",
      "sourceSentenceIds": [
        5,
        6
      ],
      "sourceLabels": [
        "Web source 2",
        "Web source 2"
      ],
      "source": "https://mcclearymuseum.org/"
    },
    {
      "id": 5,
      "text": "Henry McCleary sold his land and businesses to Simpson Logging Company on December 31, 1941, before the city’s formal incorporation.",
      "sourceSentenceIds": [
        11
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/McCleary%2C_Washington"
    },
    {
      "id": 6,
      "text": "McCleary’s historic roots trace back to the late 19th‑century timber industry that shaped much of Grays Harbor County.",
      "sourceSentenceIds": [
