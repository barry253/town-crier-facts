  "facts": [
    {
      "id": 1,
      "text": "New Haven was the mercantile hub of southwest Huron County during the first half of the 19th century.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.wgpfoundation.org/historic-markers/historic-new-haven-residents-of-early-new-haven-ohio/"
    },
    {
      "id": 2,
      "text": "Rouse Bly opened his home as an Underground Railroad station in the decades before the Civil War.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.wgpfoundation.org/historic-markers/historic-new-haven-residents-of-early-new-haven-ohio/"
    },
    {
      "id": 3,
      "text": "The village was platted with streets at right angles around a diamond‑shaped green, mirroring the layout of New Haven, Connecticut.",
      "sourceSentenceIds": [
        22
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.wgpfoundation.org/historic-markers/historic-new-haven-residents-of-early-new-haven-ohio/"
    },
    {
      "id": 4,
      "text": "Early settlers Caleb Palmer and Rouse Bly are interred in the Old New Haven Cemetery, a historic burial ground in the village.",
      "sourceSentenceIds": [
        24
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.wgpfoundation.org/historic-markers/historic-new-haven-residents-of-early-new-haven-ohio/"
    },
    {
      "id": 5,
      "text": "New Haven was organized in 1815 as one of the first townships formed in Huron County and the Firelands.",
