  "facts": [
    {
      "id": 1,
      "text": "Construction of Tucuruvi metro station began in May 1988, with an original opening target of 1990.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Tucuruvi_(S%C3%A3o_Paulo_Metro)"
    },
    {
      "id": 2,
      "text": "After multiple pauses, the station finally opened on 29 April 1998 following a 15‑year concession of ticket‑office revenues.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Tucuruvi_(S%C3%A3o_Paulo_Metro)"
    },
    {
      "id": 3,
      "text": "The 1986 expropriation of land for the station prompted Metro to plan a large intermunicipal bus terminal serving North Side and Guarulhos residents.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Tucuruvi_(S%C3%A3o_Paulo_Metro)"
    },
    {
      "id": 4,
      "text": "Choosing a site on Avenida Doutor Antonio Maria Laet sparked debate over accessibility, leading residents to propose a new Avenida Tucuruvi.",
      "sourceSentenceIds": [
        16,
        17
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Tucuruvi_(S%C3%A3o_Paulo_Metro)"
    },
    {
      "id": 5,
      "text": "Tucuruvi became Line 1’s northern terminus in 1998, ending the old Cantareira Tramway tracks that had been removed in 1965.",
      "sourceSentenceIds": [
        14,
        21
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Tucuruvi_(S%C3%A3o_Paulo_Metro)"
    },
    {
      "id": 6,
      "text": "Today, Tucuruvi stands as one of São Paulo’s most important North Zone neighborhoods, hosting the last station of the North/South Metro line.",
      "sourceSentenceIds": [
        26
      ],
      "sourceLabels": [
        "Web source 1"
      ],
