  "facts": [
    {
      "id": 1,
      "text": "Founded by Johann Cullmann in 1873, Garden City became the second town he established after Cullman.",
      "sourceSentenceIds": [
        2,
        3
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Garden_City%2C_Alabama",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Cullmann named Garden City for its lush vegetation, its proximity to the Warrior Coal Field, and as a marketing point.",
      "sourceSentenceIds": [
        4,
        6
      ],
      "sourceLabels": [
        "Web source 1",
        "Web source 2"
      ],
      "source": "https://www.gardencityal.gov/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "During Reconstruction, former enslaved people settled Garden City on land granted as compensation for their enslavement.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://encyclopediaofalabama.org/article/garden-city/",
      "category": "other",
      "quality": "poor",
      "qualityReason": "vague"
    },
    {
      "id": 4,
      "text": "In 1876, Cullmann purchased land beside the Louisville and Nashville Railroad and started recruiting settlers.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.gardencityal.gov/",
      "category": "other",
      "quality": "poor",
      "qualityReason": "vague"
    },
    {
      "id": 5,
      "text": "Bangor United Methodist Church and Garden City School are listed on Alabama’s Register of Landmarks and Heritage.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://encyclopediaofalabama.org/article/garden-city/",
      "category": "other",
      "quality": "poor",
      "qualityReason": "vague"
    },
    {
      "id": 6,
      "text": "The Mulberry Fork of the Black Warrior River marks Garden City’s southeastern county line.",
      "sourceSentenceIds": [
        20
