  "facts": [
    {
      "id": 1,
      "text": "Saint Mary, called Natoaki meaning \"Holy Woman\" in Blackfeet, sits on the western edge of the Blackfeet Reservation next to Glacier National Park.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/St._Mary%2C_Montana",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The first known European settler in the area, a man who learned Blackfeet, married a Blackfeet woman named Sinopah, arrived in the 1860s.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/st_mary_montana",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Saint Mary marks the eastern end of the Going‑to‑the‑Sun Road that cuts across Glacier National Park for 53 miles.",
      "sourceSentenceIds": [
        13
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/St._Mary%2C_Montana",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Saint Mary sits at an elevation of 4,561 feet above sea level.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.mtmemory.org/nodes/view/128296",
      "category": "other",
      "quality": "poor",
      "qualityReason": "vague"
    },
    {
      "id": 5,
      "text": "In the 1940s, Hugh and Margaret Black built cabins, a restaurant, a gas station, and two motels to welcome tourists.",
