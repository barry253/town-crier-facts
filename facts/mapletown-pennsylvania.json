  "facts": [
    {
      "id": 1,
      "text": "Mapletown sits just a mile west of the Monongahela River, perched half a mile above Whiteley Creek.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Mapletown%2C_Pennsylvania",
      "category": "nature",
      "quality": "poor",
      "qualityReason": "location_description"
    },
    {
      "id": 2,
      "text": "The town’s name comes from Stephen Mapel, who arrived in 1788 and gave his name to the growing settlement.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://greenescenemagazine.com/i-love-this-place-greenescene-of-the-past-mapletown-pa/",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "John Minor, known as the father of Greene County, built the first flouring mill west of the Monongahela River in the late 1700s.",
      "sourceSentenceIds": [
        23
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://greenescenemagazine.com/i-love-this-place-greenescene-of-the-past-mapletown-pa/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Mapletown’s historic Main Street still hosts the United Methodist Church, where weekly gatherings have been held since the town’s early days.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://greenescenemagazine.com/i-love-this-place-greenescene-of-the-past-mapletown-pa/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The Greene County Tourist Promotion Agency, founded in 1995, promotes Mapletown’s heritage sites and outdoor recreation opportunities.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://greenecountypa.gov/department-tourism-office",
      "category": "other",
      "quality": "poor",
      "qualityReason": "editorial_filler"
    },
    {
      "id": 6,
      "text": "A covered bridge once spanned Whiteley Creek in the early 20th century, a relic now captured only in historic photographs.",
      "sourceSentenceIds": [
