  "facts": [
    {
      "id": 1,
      "text": "Glen Haven began as a summer resort in 1903, founded by the Boulder Presbytery and the Knapp family.",
      "sourceSentenceIds": [
        16
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Glen_Haven%2C_Colorado",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The Homestead lodge opened in 1938, later renamed the Inn at Glen Haven and featured in a 1986 Los Angeles Times travel piece.",
      "sourceSentenceIds": [
        18,
        19
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Glen_Haven%2C_Colorado",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "In 1897 the Knapp family relocated a sawmill to the spot that would become Glen Haven, sparking its early industry.",
      "sourceSentenceIds": [
        6,
        15
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://glenhavenassociation.com/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Glen Haven lies in a narrow valley where Fox Creek and West Creek merge into the North Fork Big Thompson River, a flood‑prone setting.",
      "sourceSentenceIds": [
        13,
        21
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Glen_Haven%2C_Colorado",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "After the 2013 floods destroyed 80 percent of downtown, the rebuilt town hall reopened in September 2023 for its tenth‑anniversary celebration.",
      "sourceSentenceIds": [
        23,
        8
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 2"
      ],
      "source": "https://en.wikipedia.org/wiki/Glen_Haven%2C_Colorado",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Visitors can explore local lore at the Glen Haven Historical Society museum, which opened its doors to the public in 2013.",
      "sourceSentenceIds": [
