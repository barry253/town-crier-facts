  "facts": [
    {
      "id": 1,
      "text": "Fairmount Park is split into East and West sections by the Schuylkill River, covering a total of 2,052 acres.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Fairmount_Park",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The park showcases the Medici lions, also known as the Florentine Lions, installed in 1887 by the Association for Public Art.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Fairmount_Park",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Eastern State Penitentiary, once a prison from 1829 to 1971, now serves as a museum and National Historic Landmark in Fairmount’s heart.",
      "sourceSentenceIds": [
        2,
        18
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://philadelphia.wiki/a/Fairmount",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Fairmount Park hosted the 1876 Centennial Exposition and was home to the United States’ first zoo, the Philadelphia Zoo.",
      "sourceSentenceIds": [
        13
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Fairmount_Park",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The neighborhood’s name derives from “Faire Mount,” the hill that offered early settlers sweeping views of the Schuylkill River and countryside.",
      "sourceSentenceIds": [
        20,
        21
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://philadelphia.wiki/a/Fairmount",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Mount Pleasant, built 1762‑65 for ship captain John Macpherson, now forms part of the Philadelphia Museum of Art’s historic estate.",
      "sourceSentenceIds": [
