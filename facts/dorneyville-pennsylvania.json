      "quality": "poor",
      "qualityReason": "location_description"
    },
    {
      "id": 4,
      "text": "Nestled amid Lehigh County’s scenic beauty, Dorneyville blends rich history with picturesque landscapes that locals love.",
      "sourceSentenceIds": [
        6,
        7
      ],
      "sourceLabels": [
        "Web source 2"
      ],
