      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The town sits just west of Allentown, straddling South Whitehall and Salisbury Townships in Lehigh County.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Dorneyville%2C_Pennsylvania",
