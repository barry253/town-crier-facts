      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Dorneyville is home to the famous Dorney Park & Wildwater Kingdom amusement park, a regional family‑entertainment hub.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
