  "facts": [
    {
      "id": 1,
      "text": "Wolf Trap National Park for the Performing Arts sits in northern Fairfax County, Virginia.",
      "sourceSentenceIds": [
        17,
        18
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Wolf_Trap%2C_Virginia",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Philanthropist Catherine Filene Shouse gave 60 acres and $2 million to create the park’s first performance center.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://wheninyourstate.com/virginia/wolf-trap-national-park-for-performing-arts-origins/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Admission has always been free, and visitors can stroll the Park History Walk from the ranger station to the theater.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://wheninyourstate.com/virginia/wolf-trap-national-park-for-performing-arts-origins/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "In 1971 President Richard Nixon became the first sitting U.S. president to visit a national park dedicated to the arts.",
      "sourceSentenceIds": [
        14
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://wheninyourstate.com/virginia/wolf-trap-national-park-for-performing-arts-origins/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The Wolf Trap Company once staged a musical‑theater cavalcade that traced the genre from early opera to modern hits.",
      "sourceSentenceIds": [
        13
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://wheninyourstate.com/virginia/wolf-trap-national-park-for-performing-arts-origins/",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "What began as a farm in the 1960s evolved into America’s first national park for the performing arts.",
      "sourceSentenceIds": [
        16
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://wheninyourstate.com/virginia/wolf-trap-national-park-for-performing-arts-origins/",
