      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town was once the largest Columbia River Native American village west of the Cascades, home of the Kathlamet people.",
      "sourceSentenceIds": [
        13
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Cathlamet%2C_Washington",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "James Albion Birnie, a former Hudson's Bay Company employee, became Cathlamet's first permanent white settler in 1846 and opened a trading post.",
      "sourceSentenceIds": [
        17,
        18
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Cathlamet%2C_Washington",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "In 1938 the Julia Butler Hansen Bridge was constructed to carry State Route 409 across the Columbia River's Cathlamet Channel to Puget Island.",
      "sourceSentenceIds": [
        20
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Cathlamet%2C_Washington",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Main Street in Cathlamet hosts a historic hotel, restaurants, a grocery store, flower shop, pharmacy, two banks, and the local newspaper, the Wahkiakum County Eagle.",
