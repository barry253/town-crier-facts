  "facts": [
    {
      "id": 1,
      "text": "University Park began in the mid‑1880s when University of Denver leaders envisioned a college campus and surrounding community.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://uparkcc.org/university-park-history/"
    },
    {
      "id": 2,
      "text": "The Chamberlin Observatory, built in 1887, earned National Register of Historic Places status in 1988.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://uparkcc.org/university-park-history/"
    },
    {
      "id": 3,
      "text": "In 1887 the Denver Circle Railroad extended a line into University Park, sparking early transit.",
      "sourceSentenceIds": [
        24
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://history.denverlibrary.org/neighborhood-history-guide/university-park-neighborhood-history"
    },
    {
      "id": 4,
      "text": "The University of Denver, originally Colorado Seminary founded in 1864, relocated to University Park in 1880.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://uparkcc.org/university-park-history/"
    },
    {
      "id": 5,
