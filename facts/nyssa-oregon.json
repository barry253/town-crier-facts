    },
    {
      "id": 2,
      "text": "The land that is now Nyssa was originally home to the Northern Paiute Native American tribe.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.visitoregon.com/cities/nyssa-oregon/"
    },
    {
      "id": 3,
      "text": "Nyssa originally served as a shipping center for sheep and stock on the Union Pacific's main trunk line.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Nyssa%2C_Oregon"
    },
    {
      "id": 4,
      "text": "During World War Two, Japanese Americans worked in a farm labor camp located just outside of Nyssa.",
      "sourceSentenceIds": [
        19
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Nyssa%2C_Oregon"
    },
    {
      "id": 5,
      "text": "German and Italian prisoners of war helped the local sugar beet industry at a branch camp near Nyssa.",
      "sourceSentenceIds": [
