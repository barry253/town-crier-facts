      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town was incorporated as the second borough of Bedford County in 1838.",
      "sourceSentenceIds": [
        26
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Schellsburg%2C_Pennsylvania",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The oldest church in Bedford County, the Union Church, was erected in 1806 in Schellsburg.",
      "sourceSentenceIds": [
        28,
        29
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Schellsburg%2C_Pennsylvania",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The Schellsburg Historic District, showcasing 19th‑century log and stone architecture, was listed on the National Register of Historic Places in 2001.",
      "sourceSentenceIds": [
        27
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Schellsburg%2C_Pennsylvania",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "John Schell donated land for schools, churches and town lots, shaping the town’s early layout.",
      "sourceSentenceIds": [
        24
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Schellsburg%2C_Pennsylvania",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The Chestnut Ridge and Schellsburg Union Church and Cemetery, now called the Old Log Church, joined the National Register in 2005.",
