  "facts": [
    {
      "id": 1,
      "text": "Gray Court was originally known as Dorroh or Dorrohville, named after one of the area's earliest families.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://townofgraycourtsc.org/history/"
    },
    {
      "id": 2,
      "text": "During the Civil War, Gray Court consisted of only four homes and served as a stagecoach stop for travelers.",
      "sourceSentenceIds": [
        29
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://townofgraycourtsc.org/history/"
    },
    {
      "id": 3,
      "text": "The arrival of the Charleston and Western Carolina Railway in 1886 brought new opportunities for commerce and growth to Gray Court.",
      "sourceSentenceIds": [
        30
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://townofgraycourtsc.org/history/"
    },
    {
      "id": 4,
      "text": "Gray Court was officially incorporated as a town in 1899.",
      "sourceSentenceIds": [
        20
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Gray_Court%2C_South_Carolina"
    },
    {
      "id": 5,
      "text": "The Gray Court-Owings School was formed in 1902 and is now listed on the National Register of Historic Places.",
      "sourceSentenceIds": [
        8,
        9
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://townofgraycourtsc.org/history/"
    },
    {
      "id": 6,
      "text": "Gray Court is located in Laurens County and is part of the Greenville-Mauldin-Easley Metropolitan Statistical Area.",
      "sourceSentenceIds": [
