  "facts": [
    {
      "id": 1,
      "text": "Carnuel’s name comes from the Tiwa word meaning 'badger place,' a nod to the region’s indigenous roots.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Carnuel%2C_New_Mexico"
    },
    {
      "id": 2,
      "text": "Founded in 1763, Carnuel served as a defensive outpost against Comanche, Kiowa, and Plains Apache raids.",
      "sourceSentenceIds": [
        14
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Carnuel%2C_New_Mexico"
    },
    {
      "id": 3,
      "text": "Carnuel sits at the mouth of Tijeras Canyon, a natural corridor linking the Rio Grande valley to the Great Plains.",
      "sourceSentenceIds": [
        15
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Carnuel%2C_New_Mexico"
    },
    {
      "id": 4,
      "text": "The town once lay on US 470, later US 366, a short spur of the historic Route 66 loop.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.theroute-66.com/carnuel.html"
    },
    {
      "id": 5,
      "text": "After Apache attacks, Alcalde Navarro ordered the settlement abandoned on May 27, 1771, ending its first era.",
      "sourceSentenceIds": [
        5,
        6
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.theroute-66.com/carnuel.html"
    },
    {
      "id": 6,
      "text": "Even today, the genízaro heritage still shapes land and water rights in Carnuel, echoing its 18th‑century origins.",
      "sourceSentenceIds": [
