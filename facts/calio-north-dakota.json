  "facts": [
    {
      "id": 1,
      "text": "Calio, originally called Tyrol and later Trier, settled by German families in 1898 before adopting its current name in 1905.",
      "sourceSentenceIds": [
        1,
        2,
        5
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.ccjda.org/calio.html",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The Soo Line Railroad first ran through Calio on November 10, 1905, sparking rapid growth.",
      "sourceSentenceIds": [
        3,
        29
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.ccjda.org/calio.html",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "In the early 1900s, the Calio Iron Works operated day and night, powering local industry.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.ccjda.org/calio.html",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Between 1931 and 1933, Calio housed a cheese factory that added to its agricultural economy.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.ccjda.org/calio.html",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Calio once boasted one of Cavalier County’s finest 16‑piece bands, a point of local pride.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.ccjda.org/calio.html",
      "category": "people",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Today, Calio remains a quiet prairie community, its history still felt in every street.",
