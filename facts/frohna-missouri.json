  "facts": [
    {
      "id": 1,
      "text": "Frohna was founded in 1839 by 29 families of the Trinity Lutheran Church.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Frohna%2C_Missouri",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town’s name comes from Niederfrohna in Saxony, but the “Nieder-” was dropped over time.",
      "sourceSentenceIds": [
        12,
        14
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Frohna%2C_Missouri",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Seven Saxon Lutheran settlements, including Frohna, were established on 4,475 acres financed by a communal treasury of $88,000.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.greatriverroad.com/frohna-mo",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The Saxon Fall Festival, held each October at the Saxon Lutheran Memorial, celebrates the town’s German heritage.",
      "sourceSentenceIds": [
        16
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Frohna%2C_Missouri",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Frohna’s early settlers were approximately 700 Lutherans from Saxony, Germany, who founded the town along with six other villages.",
      "sourceSentenceIds": [
        3
