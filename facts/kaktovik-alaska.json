  "facts": [
    {
      "id": 1,
      "text": "Kaktovik means 'Place to Seine Greyling Whitefish' and boasts a large high‑ground pond of fresh water.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Kaktovik%2C_Alaska"
    },
    {
      "id": 2,
      "text": "No permanent residents lived in Kaktovik until the 1950s, when a runway and Distant Early Warning Line station were constructed.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Kaktovik%2C_Alaska"
    },
    {
      "id": 3,
      "text": "Kaktovik officially became a city when it was incorporated in 1971.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Kaktovik%2C_Alaska"
    },
    {
      "id": 4,
      "text": "Kaktovik sits on Barter Island’s north shore, between the Okpilak and Jago Rivers along the Beaufort Sea.",
      "sourceSentenceIds": [
        16
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Kaktovik%2C_Alaska"
    },
    {
      "id": 5,
      "text": "Kaktovik experiences a tundra climate, with long, cold winters where the sun never rises above the horizon, leaving only twilight.",
      "sourceSentenceIds": [
        18,
        19,
        21
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Kaktovik%2C_Alaska"
    },
    {
      "id": 6,
      "text": "Subsistence in Kaktovik relies on hunting caribou and whale, with Inupiat permitted to kill three bowhead whales each year.",
      "sourceSentenceIds": [
        12,
        14
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
