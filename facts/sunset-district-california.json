      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "In 1909, 1st Avenue was renamed Arguello Boulevard and 49th Avenue became La Playa Street to simplify mail delivery.",
      "sourceSentenceIds": [
        2,
        3
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Sunset_District%2C_San_Francisco",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "What would have been 13th Avenue is called Funston Avenue, honoring U.S. General Frederick Funston.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
