  "facts": [
    {
      "id": 1,
      "text": "Before the 1906 earthquake, Sunset District was a vast sand dune area known as the 'Outside Lands' that later became a streetcar suburb.",
      "sourceSentenceIds": [
        15,
        27,
        29
      ],
      "sourceLabels": [
