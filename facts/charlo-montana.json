  "facts": [
    {
      "id": 1,
      "text": "Charlo, Montana was named in 1918 after Chief Charlo, a Bitterroot Salish leader who resisted removal for two decades before moving north in 1891.",
      "sourceSentenceIds": [
        4,
        5,
        12
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Charlo%2C_Montana",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The Ninepipes Museum of Early Montana in Charlo showcases artifacts that honor the Flathead Indian Reservation’s history and early Montana culture.",
      "sourceSentenceIds": [
        9,
        10
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.visitmt.com/cities-towns/charlo",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Charlo’s fields echo the transition from pre‑European life to farming, reflecting federal allotment policy and the Salish people’s resilience.",
      "sourceSentenceIds": [
        13
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://roamingmontana.com/charlo/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Charlo hosts the Owl Research Institute, a center dedicated to studying all owl species across North America.",
      "sourceSentenceIds": [
        21
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Charlo%2C_Montana",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The town borders Herak Waterfowl Production Area and Ninepipes Reservoir, offering habitats for deer, pheasants, and bald eagles.",
      "sourceSentenceIds": [
        19,
        20
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Charlo%2C_Montana",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Every July, Charlo’s Main Street hosts a Fourth of July parade and cookout, a long‑standing community tradition.",
