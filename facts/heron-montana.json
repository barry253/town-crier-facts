      "quality": "good"
    },
    {
      "id": 4,
      "text": "Heron enjoys one of Montana’s wettest climates, averaging nearly 34 inches of rain and snow each year.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Heron%2C_Montana",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Winters in Heron are wet and often snowy, while summers are dry with sunny, warm days and cool nights.",
      "sourceSentenceIds": [
        11
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Heron%2C_Montana",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Heron’s diurnal temperature swings are extreme: only 10–11°F in wettest months, expanding to nearly 35°F in July and August.",
