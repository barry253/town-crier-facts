  "facts": [
    {
      "id": 1,
      "text": "Au Gres means 'of sandstone,' named by French explorers for the gritty stone along the river’s mouth.",
      "sourceSentenceIds": [
        3,
        4,
        12
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1",
        "Web source 2"
      ],
      "source": "https://en.wikipedia.org/wiki/Au_Gres%2C_Michigan",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "First settled in 1862 by workers on the Saginaw–Au Sable State Road, the town grew when John Edward Bradley built his house in 1866.",
      "sourceSentenceIds": [
        14,
        15
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Au_Gres%2C_Michigan",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Au Gres officially became a city in 1905 after years of growth along the river and lake.",
      "sourceSentenceIds": [
        18
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Au_Gres%2C_Michigan",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "In 1932 the Bessinger Pickle Company began canning dill pickles from local cucumbers, making Au Gres a niche pickle town.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://thumbwind.com/2025/12/16/history-of-au-gres-michigan/",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The city sits at the mouth of the Au Gres River where it empties into Lake Huron’s Saginaw Bay.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://thumbwind.com/2025/12/16/history-of-au-gres-michigan/",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Long before settlers, the Au Gres area was home to the Ojibwe, Odawa, and Potawatomi peoples of the Three Fires Confederacy.",
