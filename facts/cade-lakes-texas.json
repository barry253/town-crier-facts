  "facts": [
    {
      "id": 1,
      "text": "Cade Lakes are two man‑made reservoirs on upper Davidson Creek, about three miles west of Caldwell in Burleson County.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.tshaonline.org/handbook/entries/cade-lakes"
    },
    {
      "id": 2,
      "text": "The twin lakes were built in 1964 and sit 2½ miles below the creek’s spring‑fed headwaters.",
      "sourceSentenceIds": [
        17
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.tshaonline.org/handbook/entries/cade-lakes"
    },
    {
      "id": 3,
      "text": "East Lake and West Lake are each roughly half a mile long and are joined by a narrow channel along the dam’s southern rim.",
      "sourceSentenceIds": [
        18
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.tshaonline.org/handbook/entries/cade-lakes"
    },
    {
      "id": 4,
      "text": "The dam’s spillway sits at an elevation of 403 feet above sea level.",
      "sourceSentenceIds": [
        19
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.tshaonline.org/handbook/entries/cade-lakes"
    },
    {
      "id": 5,
      "text": "Shiloh Baptist Church, founded in 1869, stands on the southwest shore of West Lake.",
      "sourceSentenceIds": [
        20
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.tshaonline.org/handbook/entries/cade-lakes"
    },
    {
      "id": 6,
      "text": "The northern shore of East Lake is lined with post oak, blackjack oak, elm, and hackberry trees on gently sloping sand.",
      "sourceSentenceIds": [
        21
      ],
      "sourceLabels": [
        "Web source 1"
      ],
