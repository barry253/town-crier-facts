  "facts": [
    {
      "id": 1,
      "text": "Sartell was named after Joseph B. Sartell, a generous community contributor, instead of the earlier proposed name Wengert.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://sartellmn.com/community/our_history.php",
      "category": "people",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Sartell's area was an intertribal no man's land when French fur traders first descended the Mississippi from the Anishinaabe north, and American explorers ascended from the Sioux south.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Sartell%2C_Minnesota",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "DeZurik Valve Company, founded in 1925 by Matt DeZurik, grew from a small valve shop into one of Sartell’s largest employers.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://sartellmn.com/community/our_history.php",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Sartell’s present site was originally called 'The Third Rapids,' the third set of rough waters French fur traders encountered traveling north from Saint Anthony Falls.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Sartell%2C_Minnesota",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Watab Creek in Sartell marked the border between the Anishinaabe north and the Dakota south, formalized by the 1825 Prairie du Chien treaty.",
      "sourceSentenceIds": [
        23
