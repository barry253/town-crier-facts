        16
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/winding_cypress_florida",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The neighborhood sits adjacent to Picayune Strand State Forest, a 74,000‑acre wetland restoration project.",
