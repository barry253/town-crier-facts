  "facts": [
    {
      "id": 1,
      "text": "Cape Neddick Light, also called Nubble Lighthouse, stands on the peninsula’s tip and is the community’s most distinctive landmark.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Cape_Neddick%2C_Maine"
    },
    {
      "id": 2,
      "text": "The lighthouse’s red house was painted white in 1902, a change that still defines its appearance today.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Cape_Neddick%2C_Maine"
    },
    {
      "id": 3,
      "text": "Construction of the Cape Neddick Light began in 1876, costing $15,000, and the first light went up on July 1, 1879.",
      "sourceSentenceIds": [
        11,
        12
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Cape_Neddick%2C_Maine"
    },
    {
      "id": 4,
      "text": "The 41‑foot tower of the Nubble Lighthouse was automated in 1987, ending manual operation for the first time.",
      "sourceSentenceIds": [
        14,
        15
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Cape_Neddick%2C_Maine"
    },
    {
      "id": 5,
      "text": "Cape Neddick’s census‑designated place includes the entire peninsula and the unincorporated community of York Beach, bounded by Route 1 to the west.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Cape_Neddick%2C_Maine"
    },
    {
      "id": 6,
      "text": "Winter temperatures rarely drop below –20 °F, while July highs can reach 98 °F, reflecting Cape Neddick’s mild Gulf‑of‑Maine climate.",
      "sourceSentenceIds": [
