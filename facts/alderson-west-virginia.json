  "facts": [
    {
      "id": 1,
      "text": "Alderson was settled in 1777 by Elder John Alderson, a frontier missionary who organized the first Baptist church in the Greenbrier Valley.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Alderson%2C_West_Virginia"
    },
    {
      "id": 2,
      "text": "Alderson is known as the Gem of the Hills and is nestled in the lush Greenbrier Valley of southern West Virginia.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.aldersonwv.org/history"
    },
    {
      "id": 3,
      "text": "The town of Alderson became an important livestock shipping point on the Chesapeake and Ohio Railway.",
      "sourceSentenceIds": [
        15
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Alderson%2C_West_Virginia"
    },
    {
      "id": 4,
      "text": "Alderson is home to the Federal Reformatory for Women, which opened in 1927 as the first federal prison for women.",
      "sourceSentenceIds": [
        16
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Alderson%2C_West_Virginia"
    },
    {
      "id": 5,
      "text": "During the early 1900s, Alderson became a hub of higher education and was home to three separate institutions of higher learning.",
      "sourceSentenceIds": [
        17,
        18
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Alderson%2C_West_Virginia"
    },
    {
      "id": 6,
      "text": "Alderson spans both Greenbrier and Monroe counties, with the town and its historic district located on both sides of the river.",
