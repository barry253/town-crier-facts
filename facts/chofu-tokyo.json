      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Yomiuriland amusement park, with over 40 rides including the Bandit roller coaster, sits just a short train ride from Chōfu Station.",
      "sourceSentenceIds": [
        7,
        12
      ],
      "sourceLabels": [
