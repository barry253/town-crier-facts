    {
      "id": 1,
      "text": "Remington grew around the Jones Falls railroads in the 1840s‑1850s, drawing workers and quarrymen to the Falls Turnpike.",
      "sourceSentenceIds": [
        5,
        12
      ],
      "sourceLabels": [
        "Web source 1",
        "Web source 2"
      ],
      "source": "https://www.baltimorecity.gov/chap/our-work/historic-districts/maps/remington",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The neighborhood’s earliest homes were two‑ and three‑story brick rowhouses built in the late 19th and early 20th centuries.",
      "sourceSentenceIds": [
        16,
        17
      ],
      "sourceLabels": [
        "Web source 1",
        "Web source 2"
      ],
      "source": "https://www.baltimorecity.gov/chap/our-work/historic-districts/maps/remington",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The Remington Historic District covers about thirty blocks east of the Jones Falls, stretching from North Avenue to Wyman Park.",
      "sourceSentenceIds": [
        25
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.baltimorecity.gov/chap/our-work/historic-districts/maps/remington",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The district’s architecture reflects both modest worker rows and more stylish post‑World‑War‑I rows on its eastern side.",
