  "facts": [
    {
      "id": 1,
      "text": "Lake Orion, affectionately called the \"Land of the Lakes,\" sits in Oakland County and grew from a native homeland to a suburban hub.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://orionhistoricalsociety.org/",
      "category": "other",
      "quality": "poor",
      "qualityReason": "editorial_filler"
    },
    {
      "id": 2,
      "text": "In 1835 the village changed its name from Canandaigua to Orion, and the lake was renamed Lake Orion the same year.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Lake_Orion%2C_Michigan",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The Michigan Central Railroad reached Lake Orion in 1872, turning the village into a summer resort for Detroit commuters.",
      "sourceSentenceIds": [
        21,
        23
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://orionhistoricalsociety.org/",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The historic Indian Lake Road Stone Arch Bridge, built in 1891, still carries a narrow path over Indian Lake Road.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Lake_Orion%2C_Michigan",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Park Island Amusement Park once featured a wooden roller coaster called \"The Thriller\" and a 42‑foot high waterslide.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Lake_Orion%2C_Michigan",
      "category": "landmark",
      "quality": "poor",
      "qualityReason": "vague"
    },
    {
      "id": 6,
      "text": "The Orion Historical Museum, housed in a former school, displays artifacts that trace Lake Orion’s evolution from farming to suburb.",
      "sourceSentenceIds": [
