  "facts": [
    {
      "id": 1,
      "text": "Peterboro was founded in 1795 by Peter Smith Sr., a fur‑trade partner of John Jacob Astor, and named after himself.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Peterboro%2C_New_York",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The Gerrit Smith Estate, once home to abolitionist Gerrit Smith, is a National Historic Landmark and a key stop on the Underground Railroad.",
      "sourceSentenceIds": [
        1,
        2,
        11
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Peterboro%2C_New_York",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The National Abolition Hall of Fame and Museum on Pleasant Valley Road preserves Peterboro’s legacy as a central hub in the fight against slavery.",
      "sourceSentenceIds": [
        4,
        19,
        20
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.visitmadisoncny.com/plan-your-visit/about-us/communities/peterboro-area/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Each October, Peterboro hosts the Abolition Walk, guiding participants through historic sites linked to its antislavery movement.",
      "sourceSentenceIds": [
        18
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.visitmadisoncny.com/plan-your-visit/about-us/communities/peterboro-area/",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The Church of Peterboro, founded in 1843 by Gerrit Smith, later became a private dwelling in the twentieth century.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Peterboro%2C_New_York",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Peterboro serves as the administrative center for the Town of Smithfield, located about 25 miles southeast of Syracuse.",
