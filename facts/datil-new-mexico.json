      "quality": "good"
    },
    {
      "id": 2,
      "text": "Levi and Fred Baldwin founded Datil in 1884, opening the first general store and becoming a key ranching outpost.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/datil_new_mexico",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Datil served as a vital waypoint on the 120‑mile Magdalena Livestock Driveway, linking Arizona ranches to the railroad at Magdalena.",
