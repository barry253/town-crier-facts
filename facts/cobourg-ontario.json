  "facts": [
    {
      "id": 1,
      "text": "Cobourg was renamed in 1819 to honor Princess Charlotte Augusta of Wales after her marriage to Prince Leopold of Saxe-Coburg-Saalfeld.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Cobourg",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Victoria Hall, completed in 1860, is a National Historic Site of Canada and once housed a courtroom used for important trials.",
      "sourceSentenceIds": [
        18,
        21
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Cobourg",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Cobourg’s waterfront features a sandy beach, marina, and a boardwalk that connects the harbour to Victoria Park, making it a classic lakeside stroll.",
      "sourceSentenceIds": [
        17,
        19,
        25
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1",
        "Web source 2"
      ],
      "source": "https://en.wikipedia.org/wiki/Cobourg",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "In 1842, John Strachan founded the Diocesan Theological Institute in Cobourg, an Anglican seminary that later joined Trinity College in Toronto.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Cobourg",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Silent‑film legend Marie Dressler, who won an Academy Award in 1931, was born in Cobourg.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Cobourg",
      "category": "people",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The town’s historic downtown was once the site of the West Wing of Victoria Hall, where James Cockburn, a lawyer who helped draft Canada’s constitution, once worked.",
