  "facts": [
    {
      "id": 1,
      "text": "John Landis, the town’s first postmaster, named the community after himself in 1829, rejecting an earlier Minnichville proposal.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/landisville_pennsylvania",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "In the 1920s the Landis brothers collected Pennsylvania German artifacts, founding a museum that became a living history site in 1941.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/landisville_pennsylvania",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The arrival of the Pennsylvania Railroad in 1834 and a trolley line to Elizabethtown turned Landisville into a commercial crossroads.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/landisville_pennsylvania",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Landisville lies along Old Harrisburg Pike, just seven miles northwest of Lancaster’s county seat.",
      "sourceSentenceIds": [
        14
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Landisville%2C_Pennsylvania",
      "category": "other",
      "quality": "poor",
      "qualityReason": "location_description"
    },
    {
      "id": 5,
      "text": "Water from Landisville flows east into Swarr Run, a tributary of Little Conestoga Creek that feeds the Susquehanna River.",
      "sourceSentenceIds": [
        17
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Landisville%2C_Pennsylvania",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Hempfield High School and the East Hempfield Township Police Department are two of Landisville’s key community institutions.",
