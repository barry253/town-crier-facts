  "facts": [
    {
      "id": 1,
      "text": "Easton was founded in 1752 when Thomas Penn set aside a 1,000‑acre tract at the confluence of the Lehigh and Delaware Rivers.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Easton%2C_Pennsylvania",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town’s name honors Lady Juliana’s estate, Easton Neston, in England, as requested by Thomas Penn.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Easton%2C_Pennsylvania",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Easton became a 19th‑century commercial hub, with canals and railroads turning the confluence into a coal, iron, and steel shipping center.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Easton%2C_Pennsylvania",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "In 1925, Alpha Phi Omega, the nation’s largest fraternity, was founded at Lafayette College in Easton.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Easton%2C_Pennsylvania",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The Civil War Monument, a 75‑foot obelisk topped by “The Bugler,” stands on the old courthouse site to honor local veterans.",
      "sourceSentenceIds": [
        10
      ],
