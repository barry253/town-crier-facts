  "facts": [
    {
      "id": 1,
      "text": "Lindy was named after aviator Charles Lindbergh—nicknamed “Lucky Lindy”—after his 1927 nonstop flight from New York to Paris.",
      "sourceSentenceIds": [
        6,
        7
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Lindy%2C_Nebraska",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town was founded in 1928 as a small rural community in western Knox County, emerging late in Nebraska's settlement history.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/lindy_nebraska",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Before European contact, the Ponca, Omaha, and Santee Sioux tribes used the river valleys around present‑day Lindy for hunting, farming, and seasonal villages.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/lindy_nebraska",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Early settlers opened a general store and hoped a railroad would reach Lindy, but the line never materialized, a common rural challenge.",
      "sourceSentenceIds": [
        14,
        15
      ],
      "sourceLabels": [
        "Web source 1",
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/lindy_nebraska",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Lindy lies near the confluence of the Niobrara and Missouri Rivers, where low‑lying areas have flooded historically, including the 1881 Niobrara flood.",
      "sourceSentenceIds": [
