  "facts": [
    {
      "id": 1,
      "text": "Józsefváros was renamed in 1777 after Emperor Joseph II, the Hungarian throne heir.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/J%C3%B3zsefv%C3%A1ros",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The district hosts the National Museum, Hungary’s oldest museum, and the Metropolitan Ervin Szabó Library inside Wenckheim Palace.",
      "sourceSentenceIds": [
        5,
        20
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 2"
      ],
      "source": "https://en.wikipedia.org/wiki/J%C3%B3zsefv%C3%A1ros",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The Neo‑Baroque Eurostars Palazzo Zichy, built in 1899 for Count Nándor Zichy, now houses a luxury hotel.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://visitcity.travel/en/budapest/district/jozsefvaros",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Pál utca, Mária utca and Füvészkert, the botanical garden, are the real locations where Ferenc Molnár’s classic novel The Paul Street Boys was set.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/J%C3%B3zsefv%C3%A1ros",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Józsefváros once housed brick factories around Gutenberg tér and Rákóczi tér, reflecting its industrial past.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.budapest.city/jozsefvaros/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The district’s eastern railway station and the historic Kerepesi Cemetery, with mausoleums of famous Hungarians, mark its transport and memorial heritage.",
      "sourceSentenceIds": [
        4
