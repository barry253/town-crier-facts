  "facts": [
    {
      "id": 1,
      "text": "Bluewater Village began as a railroad stop in 1880, named after the nearby creek.",
      "sourceSentenceIds": [
        2,
        1
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 2"
      ],
      "source": "https://en.wikipedia.org/wiki/Bluewater_Village%2C_New_Mexico",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The community earned the nickname 'Carrot Capital of the World' in the early 20th century thanks to irrigation from Bluewater Lake.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/bluewater_village_new_mexico",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Tietjen built an earthen dam at Cottonwood and Bluewater Creeks, irrigating homesteads under the Desert Homestead Act.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/bluewater_village_new_mexico",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Indigenous peoples have lived in the Bluewater area for over 10,000 years, relying on local streams for survival.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/bluewater_village_new_mexico",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Bluewater Lake, a reservoir created by the Bluewater Dam, shapes the area's hydrology.",
