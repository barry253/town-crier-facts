  "facts": [
    {
      "id": 1,
      "text": "Around 1900, a fund from European philanthropist Baron Maurice de Hirsch sponsored about 50 families to establish a community around Huntley.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Huntley%2C_Wyoming"
    },
    {
      "id": 2,
      "text": "Early Huntley residents mostly came from New York and Pennsylvania, as well as some from Europe.",
      "sourceSentenceIds": [
        13
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Huntley%2C_Wyoming"
    },
    {
      "id": 3,
      "text": "Many of the original Huntley homesteaders and their families first lived in sod dugouts used as dwellings.",
      "sourceSentenceIds": [
        15
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Huntley%2C_Wyoming"
    },
    {
      "id": 4,
      "text": "Early settlers in Huntley often walked fifteen miles to Mitchell, Nebraska, to purchase supplies and carried them back in knapsacks.",
      "sourceSentenceIds": [
        2,
        16
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Huntley%2C_Wyoming"
    },
    {
      "id": 5,
      "text": "Financial support from Baron de Hirsch eventually allowed Huntley settlers to purchase horses, wagons, machinery, and milk cows.",
      "sourceSentenceIds": [
        17,
        18
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Huntley%2C_Wyoming"
    },
    {
      "id": 6,
      "text": "A severe drought around 1910 forced many of the early settlers to abandon their claims in Huntley.",
      "sourceSentenceIds": [
