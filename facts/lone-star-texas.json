      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The foundation partners with museums and history centers in Fredericksburg and surrounding areas to promote Texas culture.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.lonestarheritage.org/",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Lone Star Elementary, once part of the Daingerfield‑Lone Star ISD, closed its doors in 2010 after decades of serving local children.",
