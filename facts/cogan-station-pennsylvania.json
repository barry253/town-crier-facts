  "facts": [
    {
      "id": 1,
      "text": "Cogan Station takes its name from early settler David Cogan, whose 1825 log house became the community’s first landmark.",
      "sourceSentenceIds": [
        8,
        12
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.sungazette.com/news/top-news/2019/02/the-historic-postal-crossroads-of-cogan-station/"
    },
    {
      "id": 2,
      "text": "The village grew around a post office opened March 30, 1860 on the Northern Central Railroad.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.sungazette.com/news/top-news/2019/02/the-historic-postal-crossroads-of-cogan-station/"
    },
    {
      "id": 3,
      "text": "Ore mined at Cogan Station was shipped extensively from 1865 to 1875, linking the town to regional commerce.",
      "sourceSentenceIds": [
        25
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.sungazette.com/news/top-news/2019/02/the-historic-postal-crossroads-of-cogan-station/"
    },
    {
      "id": 4,
      "text": "The Blooming Grove Historical Society, at 297 Dunkard Church Road, preserves local history and offers research access.",
