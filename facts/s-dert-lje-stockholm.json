  "facts": [
    {
      "id": 1,
      "text": "Södertälje got its “south” prefix in 1622 to distinguish it from Norrtälje, 110 km to the northeast.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/S%C3%B6dert%C3%A4lje",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The original Södertelge nedre station became Södertälje Central in 1885 after a renaming that also moved Saltskog to Södertelge upper.",
      "sourceSentenceIds": [
        1,
        2
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/S%C3%B6dert%C3%A4lje",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "In 1945 the city council took over Södertälje's library from an independent association, centralizing its services.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/S%C3%B6dert%C3%A4lje",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The local museum, named after industrialist Marcus Wallenberg Jr., opened in 1929 with a historic windmill and other buildings.",
      "sourceSentenceIds": [
        9,
        25
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/S%C3%B6dert%C3%A4lje",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Södertälje sits where the Mälaren lake meets the Baltic Sea, connected by the Södertälje Canal lock.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/S%C3%B6dert%C3%A4lje",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Gulf Stream makes Södertälje noticeably warmer and sunnier than other cities at the same latitude.",
