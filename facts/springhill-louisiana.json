  "facts": [
    {
      "id": 1,
      "text": "Springhill’s timber roots began in 1896 when the Pine Woods Lumber Company opened a mill that would later become the town’s economic backbone.",
      "sourceSentenceIds": [
        18
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Springhill%2C_Louisiana",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "In 1937 International Paper built a massive pulp‑paper mill that turned Springhill into one of northern Louisiana’s most important manufacturing centers.",
      "sourceSentenceIds": [
        22
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Springhill%2C_Louisiana",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The paper mill closed in 1979, but International Paper kept its wood‑products and container plants, the last remaining factories in town today.",
      "sourceSentenceIds": [
        25,
        28
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Springhill%2C_Louisiana",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Springhill was officially incorporated in 1902, a milestone that followed its early days as the informal community of Barefoot, Louisiana.",
      "sourceSentenceIds": [
        15,
        13,
        14
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Springhill%2C_Louisiana",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The 1979 film *Five Days from Home* was shot largely in Springhill, giving the town a brief moment in Hollywood history.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Springhill%2C_Louisiana",
      "category": "culture",
      "quality": "good"
    },
