  "facts": [
    {
      "id": 1,
      "text": "Winks Lodge, built in 1925 by Obrey Wendall “Winks” Hamlet, served as a premier African‑American resort during segregation.",
      "sourceSentenceIds": [
        17
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.nps.gov/places/winks-panorama.htm",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Legendary jazz icons Duke Ellington, Lena Horne, and Count Basie, plus writers Langston Hughes and Zora Neale Hurston, once stayed at Winks Lodge.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.nps.gov/places/winks-panorama.htm",
      "category": "people",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Winks Lodge stayed open through the Great Depression, offering a peaceful mountain oasis for African‑American vacationers.",
      "sourceSentenceIds": [
        19
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.nps.gov/places/winks-panorama.htm",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The Civil Rights Act of 1964 formally ended legal discrimination, signaling the end of Winks Lodge’s era as a segregated retreat.",
      "sourceSentenceIds": [
        24
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.nps.gov/places/winks-panorama.htm",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "South Boulder Creek runs through Pinecliffe, and a historic railroad once threaded the town’s landscape.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.uncovercolorado.com/towns/pinecliffe/",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Pinecliffe remains an unincorporated community that hosts a post office serving both Boulder and Gilpin counties.",
      "sourceSentenceIds": [
        7
      ],
