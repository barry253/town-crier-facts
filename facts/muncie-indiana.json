  "facts": [
    {
      "id": 1,
      "text": "Muncie began as Munsee Town, a Lenape trading post renamed Muncietown, chosen as Delaware County seat and platted in 1827.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Muncie%2C_Indiana",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The Indianapolis and Bellefontaine Railroad arrived in 1852, linking Muncie to larger markets and sparking early growth.",
      "sourceSentenceIds": [
        20
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Muncie%2C_Indiana",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Ball Brothers Glass Manufacturing opened in 1888, later becoming Ball Corporation, turning Muncie into a center for glass, iron, and steel.",
      "sourceSentenceIds": [
        16,
        7,
        11
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Muncie%2C_Indiana",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The Muncie Star newspaper launched in 1899, followed by the Muncie Evening Press in 1905, marking the city’s early press scene.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Muncie%2C_Indiana",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Minnetrista Museum & Gardens, north of downtown, preserves historic Ball family homes and showcases nature, local history, and art.",
      "sourceSentenceIds": [
        25,
        26
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Muncie%2C_Indiana",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Muncie’s historic downtown and charming communities offer one‑of‑a‑kind restaurants, shops, and scenic outdoor destinations.",
