  "facts": [
    {
      "id": 1,
      "text": "Gardena earned the nickname “Freeway City” because the Artesia, Harbor, and San Diego freeways border it on three sides.",
      "sourceSentenceIds": [
        13
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://lacountylibrary.org/gardena-local-history/",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "In 1911 the Japanese Association opened the Moneta Japanese Institute, and the Gardena Japanese School followed in 1916, marking early Japanese community roots.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Gardena%2C_California",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The Satow building, dedicated February 26, 1977, honors a prominent Japanese American who helped shape Gardena’s cultural landscape.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Gardena%2C_California",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Before becoming a city, Gardena was known as the berry‑growing capital of southern California, a fact still celebrated by locals.",
      "sourceSentenceIds": [
        13
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://lacountylibrary.org/gardena-local-history/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Olympic gold‑medalist Lisa Leslie was born in Gardena, and the city also counts Tyga, who attended Gardena High School, among its famous residents.",
