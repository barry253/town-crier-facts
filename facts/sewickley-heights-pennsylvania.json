  "facts": [
    {
      "id": 1,
      "text": "Sewickley Heights was incorporated as a borough in 1935 after the Allegheny Country Club moved there in 1902, sparking wealthy settlement.",
      "sourceSentenceIds": [
        18,
        19
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Sewickley_Heights%2C_Pennsylvania",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The borough’s historic district status protects many early 20‑century estates, making it the only Pennsylvania borough entirely designated as an historic district.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Sewickley_Heights%2C_Pennsylvania",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "A 33‑acre site hosts both the Fern Hollow Nature Center and the Sewickley Heights History Center, preserving local heritage and natural beauty.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Sewickley_Heights%2C_Pennsylvania",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The History Center’s collection includes antique carriages, vintage attire, and a film archive that honors Pittsburgh industrialists’ lifestyles.",
      "sourceSentenceIds": [
        14
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://sewickleyheightshistory.org/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Oil and gas wells discovered in the 1880s still dot the Heights, remnants of an early industrial boom.",
      "sourceSentenceIds": [
        11
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.sewickleyheightsboro.com/home/history",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The Sewickley Heights Borough Park, formed from donated land in the 1960s and 1970s, now covers about 600 acres of hiking and horse‑riding trails.",
      "sourceSentenceIds": [
        27,
