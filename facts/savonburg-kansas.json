      "id": 1,
      "text": "Savonburg was founded in 1879, with many of its first settlers coming from Sweden.",
      "sourceSentenceIds": [
        2,
        3
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
