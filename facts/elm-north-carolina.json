      ],
      "source": "https://www.townofelmcity.com/history",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Judge George Howard mapped Elm City along the Wilmington‑Weldon Railroad in the early 1870s, moving the depot to spur growth.",
      "sourceSentenceIds": [
        13,
        14
      ],
      "sourceLabels": [
        "Web source 1"
