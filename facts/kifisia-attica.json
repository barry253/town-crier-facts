  "facts": [
    {
      "id": 1,
      "text": "Kifisia is a northern suburb of Athens, known for lush greenery and upscale villas, hosting the Goulandris Natural History Museum and a restored 19th‑century railway station.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.trawellino.com/destinations/greece/attica_kifisia",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The Goulandris Museum, founded in 1965, showcases rare botanical and zoological exhibits that reflect Greece’s biodiversity.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.trawellino.com/destinations/greece/attica_kifisia",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Ancient Cephisia, the predecessor of modern Kifisia, was founded by mythical king Cecrops I, uniting several settlements under one ruler.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Kifissia",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Kifisia’s cool climate and pine forests made it a favored summer retreat for Athenian aristocracy since antiquity, mentioned by Plutarch.",
      "sourceSentenceIds": [
        15
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.trawellino.com/destinations/greece/attica_kifisia",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The suburb sits at the foot of Mount Penteli, surrounded by pine forests and natural springs that have made it a historic spa destination since Roman times.",
      "sourceSentenceIds": [
