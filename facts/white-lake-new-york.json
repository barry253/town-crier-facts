  "facts": [
    {
      "id": 1,
      "text": "White Lake began as part of the 1798 Adgate Eastern Tract, where Great Lots 7–12 were sold to Miller and Swanton.",
      "sourceSentenceIds": [
        18,
        19,
        20
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.whitelakeadk.com/history"
    },
    {
      "id": 2,
      "text": "In 1880 the Department of Canals bought White Lake to build a dam that fed the Black River Canal, supplying water from 1881 to 1889.",
      "sourceSentenceIds": [
        23,
        24
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.whitelakeadk.com/history"
    },
    {
      "id": 3,
      "text": "Samuel Russell, an Illion industrialist, erected the first camp—Idlewhile—on White Lake’s south shore in 1895 before selling lots to friends.",
      "sourceSentenceIds": [
        26,
        27,
        28
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.whitelakeadk.com/history"
    },
    {
      "id": 4,
      "text": "Camp Darling, founded by Russell, was donated to the Boy Scouts in 1917 and later renamed Camp Russell.",
      "sourceSentenceIds": [
        29
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.whitelakeadk.com/history"
    },
    {
      "id": 5,
      "text": "Local property owners banded together in August 1981 to form the Adirondack White Lake Association, preserving the lake’s heritage.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.whitelakeadk.com/history"
    },
    {
      "id": 6,
      "text": "In 2020 Nick Ide, Barbara Spring, and Jill Reeves produced a historical video that chronicles White Lake’s past.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
