  "facts": [
    {
      "id": 1,
      "text": "The Sorbonne, founded in the 1200s, is France’s oldest university, with main buildings dating back to the 1500s.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://franceadventurer.com/latin-quarter-5th-arrondissement-guide-things-to-do/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "At the far end of the 5th arrondissement, the Sorbonne Chapel stands as a historic university landmark, though usually closed to visitors.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://franceadventurer.com/latin-quarter-5th-arrondissement-guide-things-to-do/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The 5th arrondissement blends old‑world charm with academic spirit, housing the Panthéon and echoing the ancient city of Lutetia.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.sortiraparis.com/en/what-to-visit-in-paris/history-heritage/articles/336314-fun-facts-about-paris-s-5th-arrondissement-unusual-facts-about-the-latin-quarter",
      "category": "other",
      "quality": "poor",
      "qualityReason": "editorial_filler"
    },
    {
      "id": 4,
      "text": "In 52 BC, Romans founded Lutetia on the Île-de-France, constructing baths, roads, and an amphitheater that still mark the area.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://franceadventurer.com/latin-quarter-5th-arrondissement-guide-things-to-do/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The Panthéon began as the Church of Saint Geneviève in 1764, then became France’s national pantheon during the Revolution in 1791.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://franceadventurer.com/latin-quarter-5th-arrondissement-guide-things-to-do/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Cluny Museum, the Latin Quarter’s most important museum, showcases Middle‑Age art and history from Gallo‑Roman artifacts to medieval sculptures.",
      "sourceSentenceIds": [
        14
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://franceadventurer.com/latin-quarter-5th-arrondissement-guide-things-to-do/",
