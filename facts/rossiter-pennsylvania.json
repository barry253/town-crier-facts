  "facts": [
    {
      "id": 1,
      "text": "Rossiter was founded in 1901 as a coal mining town and named after William Rossiter, a chief stockholder of the Clearfield Bituminous Coal Corporation.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Rossiter%2C_Pennsylvania"
    },
    {
      "id": 2,
      "text": "The town was a key site during the 1927 Indiana bituminous strike, one of Pennsylvania's longest and most bitter coal strikes.",
      "sourceSentenceIds": [
        3,
        10
      ],
      "sourceLabels": [
        "Web source 2",
        "Wikipedia"
      ],
      "source": "https://explorepahistory.com/hmarker.php%3FmarkerId=1-A-2CD.html"
    },
    {
      "id": 3,
      "text": "Rossiter’s coal mines shut down in the late 1940s, ending the town’s primary industry.",
      "sourceSentenceIds": [
        11
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Rossiter%2C_Pennsylvania"
    },
    {
      "id": 4,
      "text": "The 1927 strike left Rossiter as the last union holdout in Indiana County before the conflict ended.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://explorepahistory.com/hmarker.php%3FmarkerId=1-A-2CD.html"
    },
    {
      "id": 5,
      "text": "Rossiter sits at 40°53′47″N 78°56′3″W, placing it in the picturesque Laurel Highlands of western Pennsylvania.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Rossiter%2C_Pennsylvania"
    },
    {
      "id": 6,
      "text": "Travelers to Rossiter can enjoy outdoor activities and seasonal festivals that celebrate local traditions in a scenic setting.",
