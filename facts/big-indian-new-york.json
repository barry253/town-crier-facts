  "facts": [
    {
      "id": 1,
      "text": "Big Indian earned its name from Winneesook, a seven‑foot Munsee man nicknamed 'Big Indian' after his towering stature.",
      "sourceSentenceIds": [
        2,
        3
      ],
      "sourceLabels": [
        "Web source 1",
        "Wikipedia"
      ],
      "source": "https://www.shandakennymuseum.org/Hamlets/BigIndian"
    },
    {
      "id": 2,
      "text": "The 1880s railroad spurred Big Indian’s growth, turning a pine‑tree stand into a bustling hamlet with hotels and general stores.",
      "sourceSentenceIds": [
        4,
        5
      ],
      "sourceLabels": [
        "Web source 1",
        "Wikipedia"
      ],
      "source": "https://www.shandakennymuseum.org/Hamlets/BigIndian"
    },
    {
      "id": 3,
      "text": "Nestled along Route 28 in Catskill Park, Big Indian sits beside Esopus Creek and overlooks Big Indian Mountain to the southwest.",
      "sourceSentenceIds": [
        8,
        9,
        10
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Big_Indian%2C_New_York"
    },
    {
      "id": 4,
      "text": "A drive through Big Indian rewards hikers with sweeping views of Belleayre, Balsam, Easgle, and the towering Slide Mountain.",
      "sourceSentenceIds": [
        17
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.shandakennymuseum.org/Hamlets/BigIndian"
    },
    {
      "id": 5,
      "text": "The former hamlet of Smithville, once its own school and post office, merged into Big Indian in the 1920s.",
