  "facts": [
    {
      "id": 1,
      "text": "Dutch Stalder founded Prairie City in 1946, and the town was built up by former residents of Strool.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Prairie_City%2C_South_Dakota"
    },
    {
      "id": 2,
      "text": "Prairie City was formed when residents moved two miles north to escape a feud over the ownership of Strool.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Prairie_City%2C_South_Dakota"
    },
    {
      "id": 3,
      "text": "The arrival of electrical infrastructure in 1952 encouraged more settlers to move into Prairie City.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Prairie_City%2C_South_Dakota"
    },
    {
      "id": 4,
      "text": "Prairie City briefly earned the title of the fastest-growing town in South Dakota by 1955.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Prairie_City%2C_South_Dakota"
    },
    {
      "id": 5,
      "text": "A post office was established in Prairie City in 1955, though services are now handled by the town of Bison.",
      "sourceSentenceIds": [
        8,
        9
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Prairie_City%2C_South_Dakota"
    },
    {
      "id": 6,
      "text": "Prairie City is located in Perkins County within the Mountain time zone.",
