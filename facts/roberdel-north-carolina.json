  "facts": [
    {
      "id": 1,
      "text": "Roberdel was founded in 1882 as a planned mill village by the Roberdel Manufacturing Company, harnessing hydraulic power from Hitchcock Creek.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/roberdel_north_carolina",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The original mill, built 1882\u20111883, was sold in 1929 and renamed Entwistle No. 1, later becoming part of Entwistle Manufacturing Company.",
      "sourceSentenceIds": [
        2,
        3
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/roberdel_north_carolina",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The company store at 1106 Roberdel Road, a one\u2011story brick building with original interior, survived a 1970 fire and now sits on the National Register of Historic Places.",
      "sourceSentenceIds": [
        16
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/roberdel_north_carolina",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Roberdel sits on the north side of Hitchcock Creek, a southwest\u2011flowing tributary of the Pee Dee River, placing it in Richmond County\u2019s historic textile corridor.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Roberdel%2C_North_Carolina",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The original dam on Hitchcock Creek, built between 1860 and 1880 for grist and saw milling, broke in a 1890 flood but was rebuilt and still stands today.",
      "sourceSentenceIds": [
        11,
