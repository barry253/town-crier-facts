  "facts": [
    {
      "id": 1,
      "text": "San Angelo was founded in 1867 when the U.S. Army built Fort Concho to protect settlers.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/San_Angelo%2C_Texas",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The historic Fort Concho, a National Historic Landmark, sits on the site of the original 1867 fort and now serves as a museum.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/San_Angelo%2C_Texas",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "San Angelo’s name comes from a village called Santa Angela, founded by DeWitt at the confluence of North and South Concho Rivers, named after his wife Carolina Angela.",
      "sourceSentenceIds": [
        8,
        9
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/San_Angelo%2C_Texas",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The San Angelo Performing Arts Center hosts touring shows in the 1928 Murphey Auditorium and the former Coca‑Cola factory converted into the Stephens Performing Arts Center.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/San_Angelo%2C_Texas",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Angelo State University, founded in 1928, enrolls about 10,000 students from across Texas and beyond.",
      "sourceSentenceIds": [
        26
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/San_Angelo%2C_Texas",
      "category": "people",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The San Angelo Symphony, established in 1949, performs five concerts each year, adding a rich musical tradition to the city.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
