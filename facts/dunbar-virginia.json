  "facts": [
    {
      "id": 1,
      "text": "Dunbar began as a 1919 coal camp built by the Stonega Coke and Coal Company, a Virginia Coal and Iron subsidiary, to house miners near rich seams.",
      "sourceSentenceIds": [
        1,
        12,
        18
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/dunbar_virginia",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town’s name honors Colonel Thomas Dunbar, who led the 48th Regiment of Foot during the French and Indian War.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.dunbarhistoricalsociety.org/dunbar-s-history",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Dunbar’s historic Dutch Hollow Wine Cellars earned a National Register listing in 1970, preserving a unique 19th‑century cellar complex.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Dunbar%2C_West_Virginia",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The 2.1‑mile Sheepskin Trail, opened in 2008, connects Dunbar to the Great Allegheny Passage and passes by a beehive coke oven at the local historical park.",
      "sourceSentenceIds": [
        14,
        15
      ],
