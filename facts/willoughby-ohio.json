  "facts": [
    {
      "id": 1,
      "text": "Willoughby was permanently named in 1835 after Westel Willoughby Jr., a public health official the founders hoped would attract a short‑lived medical college.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Willoughby%2C_Ohio",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The Chagrin River, which runs through Willoughby, was once called the “Sha‑ga‑rin” by local Indians, meaning “Clear Water.”.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Willoughby%2C_Ohio",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Downtown Willoughby still boasts more than 65 buildings listed on the National Register of Historic Places, showcasing 19th‑century architecture.",
      "sourceSentenceIds": [
        14
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://we247.org/2024/03/willoughby-historical-society-an-inside-look/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Wes Point Park in downtown hosts several memorials and historic relics that honor local veterans and community leaders.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Willoughby%2C_Ohio",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The Willoughby Historical Society, founded in 1961, preserves artifacts that tell the city’s story and holds its Collection Room inside the public library.",
      "sourceSentenceIds": [
        2,
        12
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://we247.org/2024/03/willoughby-historical-society-an-inside-look/",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The lower level of the Willoughby‑Eastlake Public Library houses the Society’s Collection Room, where staff help patrons explore the city’s time capsule.",
