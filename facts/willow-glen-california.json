  "facts": [
    {
      "id": 1,
      "text": "Willow Glen earned its name from a marshy wetland between the Guadalupe River and Los Gatos Creek, where willows and cattails thrived.",
      "sourceSentenceIds": [
        1,
        9
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Willow_Glen%2C_San_Jose",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Willow Glen Elementary School opened in 1863 on land donated by Ira Cottle, marking the community’s first public school.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Willow_Glen%2C_San_Jose",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "In the 1920s, residents united to stop a proposed railroad from slicing through the neighborhood, preserving Willow Glen’s cohesion.",
      "sourceSentenceIds": [
        10,
        11,
        25
      ],
      "sourceLabels": [
        "Web source 1",
        "Wikipedia"
      ],
      "source": "https://www.willowglen.org/about",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Willow Glen voted to join San Jose in 1936, choosing annexation over building its own costly sewage system.",
      "sourceSentenceIds": [
        16,
        27
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Willow_Glen%2C_San_Jose",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The neighborhood’s historic downtown, lined with tree‑shaded streets, remains a hub for local dining and boutique shopping.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Willow_Glen%2C_San_Jose",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "When the Southern Pacific rerouted its main line in the 1920s, the new track ran through what is now North Willow Glen, home to Caltrain.",
