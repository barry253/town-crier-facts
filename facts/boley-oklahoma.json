  "facts": [
    {
      "id": 1,
      "text": "Founded in 1903 on land allotted to Abigail Barnett, Boley is the largest of Oklahoma's remaining historic All-Black towns.",
      "sourceSentenceIds": [
        1,
        8
      ],
      "sourceLabels": [
        "Web source 1",
        "Web source 2"
      ],
      "source": "https://www.thetownofboley.org/about"
    },
    {
      "id": 2,
      "text": "Boley was named after J.B. Boley, a railroad official who oversaw the development of a depot in the town.",
      "sourceSentenceIds": [
        2,
        15
      ],
      "sourceLabels": [
        "Web source 1",
        "Wikipedia"
      ],
      "source": "https://www.thetownofboley.org/about"
    },
    {
      "id": 3,
      "text": "The Boley Historic District was designated as a National Historic Landmark by Congress in 1975.",
      "sourceSentenceIds": [
        20
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Boley%2C_Oklahoma"
    },
    {
      "id": 4,
      "text": "During the Jim Crow era, Boley supported two banks, two colleges, and its own newspaper called The Boley Progress.",
      "sourceSentenceIds": [
        25
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.thetownofboley.org/about"
    },
    {
      "id": 5,
      "text": "The Oklahoma State Historic Preservation Office nominated the Boley rodeo for National Historic Landmark status in 2024.",
