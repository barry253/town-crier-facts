  "facts": [
    {
      "id": 1,
      "text": "Williamsbridge was named for 18th‑century farmer John Williams, who built the first bridge over the Bronx River.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Williamsbridge%2C_Bronx"
    },
    {
      "id": 2,
      "text": "The neighborhood was historically heavily Jewish and Italian‑American, shaping its early cultural fabric.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Williamsbridge%2C_Bronx"
    },
    {
      "id": 3,
      "text": "In the 1970s Williamsbridge shifted to a predominantly African‑American community, then welcomed Caribbean and West Indian immigrants in the 1980s.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Williamsbridge%2C_Bronx"
    },
    {
      "id": 4,
      "text": "Frances of Rome Church, founded in 1927, has long anchored local life with services and community events.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.cityneighborhoods.nyc/williamsbridge"
    },
    {
      "id": 5,
      "text": "The 2 and 5 trains stop at Gun Hill Road and 219th Street stations, offering direct Manhattan access.",
      "sourceSentenceIds": [
