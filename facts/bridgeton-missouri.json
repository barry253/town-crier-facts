  "facts": [
    {
      "id": 1,
      "text": "Bridgeton was first platted in 1794 and originally called Marais des Liards, meaning Cottonwood Swamp.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Bridgeton%2C_Missouri",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town’s early name, Village à Robert, honored founder Robert Owen, who received a land grant from the Spanish government.",
      "sourceSentenceIds": [
        4,
        7
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Bridgeton%2C_Missouri",
      "category": "people",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Mizpah Presbyterian Church, built in 1869, sits across St. Charles Rock Road from Fee Fee Baptist and was organized by local families in 1842.",
      "sourceSentenceIds": [
        16
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://aboutstlouis.com/local/communities/bridgeton-missouri",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The Payne‑Gentry House, constructed in 1870 on Fee Fee Road, now graces the National Register of Historic Places.",
      "sourceSentenceIds": [
        17,
        18
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://aboutstlouis.com/local/communities/bridgeton-missouri",
      "category": "landmark",
      "quality": "good"
    },
    {
