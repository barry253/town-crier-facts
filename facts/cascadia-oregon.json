    },
    {
      "id": 2,
      "text": "George Geisendorfer established a hotel in Cascadia and served as the community's first postmaster when the post office opened in 1898.",
      "sourceSentenceIds": [
        3,
        12
      ],
      "sourceLabels": [
        "Wikipedia"
