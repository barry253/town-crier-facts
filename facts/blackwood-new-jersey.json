      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Blackwood%2C_New_Jersey",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The Blackwood Historic District, covering 42 acres along the Black Horse Pike, was added to the National Register of Historic Places in 1989 for its community significance.",
