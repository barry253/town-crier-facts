  "facts": [
    {
      "id": 1,
      "text": "Lágymányos began as a Roman settlement, first appearing in the Claudian era before flourishing under the Flavians.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://real.mtak.hu/129819/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "By the Severan era, the Lágymányos settlement was abandoned, marking the end of its early Roman presence.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://real.mtak.hu/129819/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Today, the Budapest University of Technology and Economics sits in Lágymányos, hosting several faculties of Eötvös Loránd University.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/L%C3%A1gym%C3%A1nyos",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Commuters and tourists alike rely on trams 4 and 6, which run directly through Lágymányos.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/L%C3%A1gym%C3%A1nyos",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "After the Soviet bloc dissolved, Budapest—including Lágymányos—welcomed a wave of Western tourists amid economic transition.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.britannica.com/place/Budapest",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Lágymányos’s name reflects its historical roots, with “Lágymányos” meaning “low hill” in Hungarian, hinting at the area’s gentle topography.",
