      ],
      "source": "https://www.highlandlakeal.gov/history"
    },
    {
      "id": 2,
      "text": "The lake sits 895 feet above sea level in a valley between Blount Mountain and Straight Mountain.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Highland_Lake%2C_Alabama"
    },
    {
      "id": 3,
      "text": "Highland Lake lies seven miles southwest of the county seat along County Road 29.",
      "sourceSentenceIds": [
        8
      ],
