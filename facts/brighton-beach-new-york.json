      ],
      "source": "https://nyc-map.com/brighton-beach-nyc/",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Brighton Beach hosts the annual Coney Island Mermaid Parade, the largest art parade in New York City.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
