      "category": "culture",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The 1878 railroad turned Brighton Beach into a resort, making it a summer getaway for New Yorkers.",
      "sourceSentenceIds": [
        14
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://nyc-map.com/brighton-beach-nyc/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Several episodes of The Sopranos were filmed along Brighton Beach’s boardwalk, capturing its gritty vibe.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
