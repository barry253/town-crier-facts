  "facts": [
    {
      "id": 1,
      "text": "McCurtain was originally called Panther before being renamed in 1902 to honor Choctaw Principal Chief Green McCurtain.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/McCurtain%2C_Oklahoma"
    },
    {
      "id": 2,
      "text": "Coal deposits discovered in the late nineteenth century attracted European miners and American entrepreneurs to McCurtain.",
      "sourceSentenceIds": [
        22
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/McCurtain%2C_Oklahoma"
    },
    {
      "id": 3,
      "text": "The Fort Smith and Western Railroad connected McCurtain with Fort Smith, Arkansas, in 1901, helping the town prosper.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/McCurtain%2C_Oklahoma"
    },
    {
      "id": 4,
      "text": "The San Bois Coal Company once built four hundred company houses for miners living in and around McCurtain.",
      "sourceSentenceIds": [
        23
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/McCurtain%2C_Oklahoma"
    },
    {
      "id": 5,
      "text": "McCurtain once supported a variety of local businesses, including banks, schools, newspapers, and even a bottling company.",
      "sourceSentenceIds": [
        27
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/McCurtain%2C_Oklahoma"
    },
    {
      "id": 6,
      "text": "Several local newspapers once served the community, including the McCurtain American, the McCurtain Leader, and the Hustler.",
