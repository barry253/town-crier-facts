  "facts": [
    {
      "id": 1,
      "text": "Teesto was originally called Ha'nanee'tiin, meaning \"Road Going Past,\" because it sat on the main road between Dilkon and Polacca.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://teesto.navajochapters.org/",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "When Route 87 was built in the 1960s, Teesto was bypassed and its prominence faded.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://teesto.navajochapters.org/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Teesto sits on the edge of the Navajo and Hopi reservations, making it a cultural crossroads where both peoples have long shared the land.",
      "sourceSentenceIds": [
        3,
        4
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://teesto.navajochapters.org/",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "In 2015 the Teesto Chapter building burned down, but volunteers rebuilt it by March 2023, restoring the community hub.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://teesto.navajochapters.org/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Tees Toh observes Mountain Standard Time year‑round and does not switch for daylight saving, unlike neighboring areas that do.",
