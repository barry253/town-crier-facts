  "facts": [
    {
      "id": 1,
      "text": "The Arkansas Central Railway ran through Holly Grove in 1872, later becoming the Arkansas Midland Railroad, and spurred the town’s growth while shrinking neighboring Lawrenceville.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Holly_Grove%2C_Arkansas"
    },
    {
      "id": 2,
      "text": "Holly Grove began as a plantation community and was a suburb of Lawrenceville, the former county seat until 1857.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Holly_Grove%2C_Arkansas"
    },
    {
      "id": 3,
      "text": "The town officially incorporated in 1876, marking its transition from a plantation outpost to an incorporated municipality.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Holly_Grove%2C_Arkansas"
    },
    {
      "id": 4,
      "text": "Holly Grove lies 11 miles southwest of Clarendon and 18 miles west of Marvell, placing it in southern Monroe County.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
