  "facts": [
    {
      "id": 1,
      "text": "Clintonville earned its name from pioneer Clinton McKee, who helped settle the area in the early 1800s.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/clintonville_pennsylvania",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "In 1878 Clintonville incorporated, evolving from early 19‑century farms into a modest commercial hub powered by agriculture, timber, and a 1860s oil boom.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/clintonville_pennsylvania",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The historic Lumberman's Eddy hotel on the Allegheny River once hosted lumbermen who floated logs to Pittsburgh before returning overland.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/clintonville_pennsylvania",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "A brief 1876–78 railroad, the Allegheny, Kennerdell & Clintonville line, linked the town to regional oil transport.",
      "sourceSentenceIds": [
        25
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/clintonville_pennsylvania",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Thomas McKee, the town’s first sawmill owner, also ran a store and served as justice of the peace until 1857.",
      "sourceSentenceIds": [
        21
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/clintonville_pennsylvania",
      "category": "people",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Clinton Chapel Cemetery, established in 1823, holds the graves of dozens of early families, many still traced by descendants today.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://clintonvillehistory.com/",
      "category": "landmark",
      "quality": "good"
    }
  ],
