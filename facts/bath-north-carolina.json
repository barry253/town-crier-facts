  "facts": [
    {
      "id": 1,
      "text": "Founded by English settlers near the Pamlico River in the 1690s, Bath became North Carolina’s first incorporated town in 1705.",
      "sourceSentenceIds": [
        2,
        15,
        27,
        30
      ],
      "sourceLabels": [
        "Web source 2",
        "Web source 1",
        "Wikipedia"
      ],
      "source": "https://historicsites.nc.gov/all-sites/historic-bath",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "In 1712 Bath was named North Carolina’s first capital, though no permanent government buildings ever appeared there.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Bath%2C_North_Carolina",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Bath’s historic waterfront once hosted North Carolina’s first shipyard, a cornerstone of early maritime trade.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://townofbathnc.com/",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Thomas Church, North Carolina’s oldest standing Episcopal church, sits in Bath and is on the National Register of Historic Places.",
