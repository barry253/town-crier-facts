  "facts": [
    {
      "id": 1,
      "text": "Victorian Village, Tennessee, began as the 1880 Rugby colony founded by British author Thomas Hughes.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://historicrugby.org/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The neighborhood’s first free public library, the 1882 Thomas Hughes Free Public Library, still stands as a historic landmark.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://historicrugby.org/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Victorian Village’s homes were built between 1846 and the 1890s, showcasing styles from Neo‑classical to Late Gothic Revival.",
      "sourceSentenceIds": [
        20
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Victorian_Village%2C_Memphis",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The 1884 Kingstone Lisle house, once the founder’s home, is one of the district’s oldest surviving residences.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://historicrugby.org/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "A 22‑minute film called The Power of a Dream opens tours at the Rugby Visitor Centre & Theatre, highlighting the area’s history.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://historicrugby.org/",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Victorian Village was listed on the National Register of Historic Places in 1979 after a period of decline and subsequent gentrification.",
      "sourceSentenceIds": [
        10,
        11
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
