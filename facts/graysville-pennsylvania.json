  "facts": [
    {
      "id": 1,
      "text": "Graysville was named after Billy Gray, the surveyor who first mapped the area.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.rheaheraldnews.com/lifestyles/article_3c4a6a90-5067-4d32-8380-c3cf37e10be6.html",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town’s post office opened in 1878, with Gray himself serving as the second postmaster.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.rheaheraldnews.com/lifestyles/article_3c4a6a90-5067-4d32-8380-c3cf37e10be6.html",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Graysville’s growth began when the Cincinnati Southern Railroad arrived in 1880, drawing new settlers to the region.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.rheaheraldnews.com/lifestyles/article_3c4a6a90-5067-4d32-8380-c3cf37e10be6.html",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Pennsylvania actually has two Graysvilles—one in Greene County and another in Huntingdon County.",
      "sourceSentenceIds": [
        2
      ],
