  "facts": [
    {
      "id": 1,
      "text": "The first settlers, Reuben Webb and his family, arrived in South Amherst in 1814.",
      "sourceSentenceIds": [
        22
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://villageofsouthamherst.com/about-us/"
    },
    {
      "id": 2,
      "text": "By 1815 South Amherst was part of Vermilion Township in Huron County.",
      "sourceSentenceIds": [
        23
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://villageofsouthamherst.com/about-us/"
    },
    {
      "id": 3,
      "text": "Lorain County, which now contains South Amherst, was organized in 1824 from portions of Huron, Cuyahoga, and Medina counties.",
      "sourceSentenceIds": [
        26
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://villageofsouthamherst.com/about-us/"
    },
    {
      "id": 4,
      "text": "The Village of South Amherst was officially incorporated in 1918.",
      "sourceSentenceIds": [
        28
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://villageofsouthamherst.com/about-us/"
    },
    {
      "id": 5,
      "text": "During the War of 1812 a road was built between Ridgeville and Florence, later named South Ridge Road and now known as Route 113.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://villageofsouthamherst.com/about-us/"
    },
    {
      "id": 6,
      "text": "In 1936 South Amherst boasted two grocery stores, two restaurants, a meat market, two filling stations, a repair garage, a barber shop, four churches, and two lodges.",
      "sourceSentenceIds": [
