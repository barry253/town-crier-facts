  "facts": [
    {
      "id": 1,
      "text": "Pleasant Run Farm takes its name from the residential subdivision that once hosted Cincinnati’s Home Builders Association Homearama show in 1965.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Pleasant_Run_Farm%2C_Ohio",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The Pleasant Run Farms Civic Association, founded in 1969, runs entirely on volunteer effort and sponsors many community events.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.pleasantrunfarms.org/history.html",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "When approved, Pleasant Run Farm covered 670 acres, making it the largest subdivision Hamilton County had sanctioned at that time.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Pleasant_Run_Farm%2C_Ohio",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Starting in 1967, an additional 100 homes were added to the subdivision, expanding its residential footprint.",
      "sourceSentenceIds": [
        13
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Pleasant_Run_Farm%2C_Ohio",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Pleasant Run Farm lies northwest of Cincinnati, nestled between the Forest Park and Fairfield communities.",
      "sourceSentenceIds": [
        14
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Pleasant_Run_Farm%2C_Ohio",
