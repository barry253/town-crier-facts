  "facts": [
    {
      "id": 1,
      "text": "Waterford Works began in 1824 when Jonathan Haines founded the Waterford Glass-Works amid pine forests, sparking a glass‑making era.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/waterford_works_new_jersey"
    },
    {
      "id": 2,
      "text": "By 1886 the village housed about 100 buildings and 250 residents, with churches ranging from Methodist (1848) to Roman Catholic (1880).",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/waterford_works_new_jersey"
    },
    {
      "id": 3,
      "text": "The community sits roughly 1.8 miles east‑southeast of Chesilhurst, placing it within the South Jersey Outer Coastal Plain.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Waterford_Works%2C_New_Jersey"
    },
    {
      "id": 4,
      "text": "Elevations climb from 50 to 118 feet, with the village itself at about 118 feet, creating low‑relief terrain that supports nearby wetlands.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/waterford_works_new_jersey"
    },
    {
      "id": 5,
      "text": "Waterford Works lies inside the New Jersey Pinelands National Reserve, protecting over 13,000 acres of Pinelands habitat from development.",
      "sourceSentenceIds": [
        13
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/waterford_works_new_jersey"
    },
    {
      "id": 6,
      "text": "The area experiences a humid subtropical climate, averaging 46 inches of rain annually, which fuels lush vegetation and occasional flooding.",
      "sourceSentenceIds": [
