      ],
      "source": "https://en.wikipedia.org/wiki/Hartford_City%2C_Indiana",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The town’s name comes from “Hart’s ford,” a crossing over Lick Creek, according to local folklore.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
