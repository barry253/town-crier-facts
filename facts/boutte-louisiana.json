  "facts": [
    {
      "id": 1,
      "text": "Boutte was named after Tisaphane Boutte and his son J.L., who lived near the railroad stop before the Civil War.",
      "sourceSentenceIds": [
        4,
        7
      ],
      "sourceLabels": [
        "Web source 1",
        "Web source 2"
      ],
      "source": "https://scphistory.org/boutte-town-history/"
    },
    {
      "id": 2,
      "text": "During the Civil War, Union troops captured Boutte Station in 1862, only to be ambushed by Confederate militia on September 4, 1862.",
      "sourceSentenceIds": [
        21,
        22,
        26,
        29
      ],
      "sourceLabels": [
        "Web source 1",
        "Web source 2"
      ],
      "source": "https://scphistory.org/boutte-town-history/"
    },
    {
      "id": 3,
      "text": "Boutte shifted from farming and trapping to petrochemical industry influence, thanks to its proximity to the Mississippi River.",
      "sourceSentenceIds": [
        13
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/Boutte,_Louisiana"
    },
    {
      "id": 4,
      "text": "Today, Boutte blends Cajun and Creole culture, offering access to Jean Lafitte National Historical Park and nearby swamp tours.",
