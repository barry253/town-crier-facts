      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "An original Tesuque settlement, founded before 1200 A.D., was abandoned sometime after the 1680 Pueblo Revolt.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 2"
      ],
