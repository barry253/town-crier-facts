  "facts": [
    {
      "id": 1,
      "text": "Tesuque Pueblo earned National Register status in 1973 thanks to its age and cultural heritage.",
      "sourceSentenceIds": [
        9,
        2
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Tesuque_Pueblo%2C_New_Mexico"
    },
    {
      "id": 2,
      "text": "Tesuque comes from a Tewa name meaning 'village of the narrow place of the cottonwood trees'.",
      "sourceSentenceIds": [
        19,
        6,
        7
      ],
      "sourceLabels": [
        "Web source 1",
        "Wikipedia"
      ],
      "source": "https://www.tesuquepueblo.org/"
    },
    {
      "id": 3,
      "text": "Tesuque Pueblo sits in the red‑brown foothills of the Sangre de Cristo Mountains, just 10 miles north of Santa Fe.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.tesuquepueblo.org/history"
    },
    {
      "id": 4,
      "text": "An original Tesuque settlement, founded before 1200 A.D., was abandoned sometime after the 1680 Pueblo Revolt.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.tesuquepueblo.org/history"
    },
    {
      "id": 5,
      "text": "A six‑mile stretch of the Tesuque River cuts through the pueblo, holding deep cultural importance for the Tewa people.",
      "sourceSentenceIds": [
        29,
        30
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.tesuquepueblo.org/history"
    },
    {
      "id": 6,
      "text": "The pueblo’s dramatic landscape has inspired authors, artists, and countless pieces of artwork, often serving as a novel setting.",
      "sourceSentenceIds": [
        5
