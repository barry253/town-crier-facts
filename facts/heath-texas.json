  "facts": [
    {
      "id": 1,
      "text": "Heath began as Black Hill, a name that reflected the dark soil of the area and marked the site of the first post office in Rockwall County in 1849.",
      "sourceSentenceIds": [
        7,
        8
      ],
      "sourceLabels": [
        "Web source 1",
        "Web source 2"
      ],
      "source": "https://www.tshaonline.org/handbook/entries/heath-tx",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Heath sits along Farm Road 740, roughly seven miles south of Rockwall, placing it firmly within the Dallas–Fort Worth metroplex.",
      "sourceSentenceIds": [
        24,
        30
      ],
      "sourceLabels": [
        "Wikipedia",
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Heath%2C_Texas",
      "category": "other",
      "quality": "poor",
      "qualityReason": "location_description"
    },
    {
      "id": 3,
      "text": "A devastating fire in 1916 destroyed several buildings, sparking a prolonged decline that was later worsened by the Great Depression.",
      "sourceSentenceIds": [
        27
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Heath%2C_Texas",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "From the late 20th century onward, Heath shifted from an agriculture‑based town to a growing residential community with expanding business and professional opportunities.",
      "sourceSentenceIds": [
        28
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Heath%2C_Texas",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Heath’s early settlers arrived in 1846, making it one of the region’s first permanent communities.",
