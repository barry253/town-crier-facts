  "facts": [
    {
      "id": 1,
      "text": "Sully Square’s historic estate was built in 1794 by Richard Bland Lee, a prominent member of the Lee family.",
      "sourceSentenceIds": [
        3,
        9
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://museumsdatabase.com/museums/view/32063",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The estate’s name honors Thomas Lee, Richard Bland Lee’s great‑uncle, who sent him to England to study law.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://museumsdatabase.com/museums/view/32063",
      "category": "people",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Sully Historic Site’s buildings date from 1794 to 1801 and are listed on the National Register of Historic Places.",
      "sourceSentenceIds": [
        14,
        10
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.fairfaxcounty.gov/parks/sully-historic-site",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The Fairfax County Park Authority now owns and operates Sully Historic Site, preserving its 18th‑century architecture.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://museumsdatabase.com/museums/view/32063",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "During restoration, visitors can tour the grounds but cannot enter the historic buildings until work finishes.",
      "sourceSentenceIds": [
        12,
        13,
        29
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.fairfaxcounty.gov/parks/sully-historic-site",
      "category": "other",
      "quality": "poor",
      "qualityReason": "editorial_filler"
    },
    {
      "id": 6,
      "text": "Sully Square hosts an annual antique car show, drawing classic car enthusiasts to its historic grounds each summer.",
      "sourceSentenceIds": [
        15,
        16
      ],
      "sourceLabels": [
        "Web source 1"
      ],
