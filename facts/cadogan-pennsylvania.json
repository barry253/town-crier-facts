      "id": 1,
      "text": "Cadogan lies along the Allegheny River and PA Route 128, just 5.3 miles southwest of Kittanning.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Cadogan%2C_Pennsylvania",
