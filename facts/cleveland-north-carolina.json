  "facts": [
    {
      "id": 1,
      "text": "Cleveland began as Cowansville in 1831, when John Cowan opened the town’s first post office on March 18.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Cleveland%2C_North_Carolina"
    },
    {
      "id": 2,
      "text": "The town’s name evolved from Rowan Mills, after a flour mill, to Third Creek in 1876, and finally to Cleveland in 1887.",
      "sourceSentenceIds": [
        3,
        10,
        26
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Cleveland%2C_North_Carolina"
    },
    {
      "id": 3,
      "text": "Christ Episcopal Church, established in 1754, remains a historic landmark in Cleveland and was added to the National Register of Historic Places.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://townofclevelandnc.gov/cleveland-community/history/"
    },
    {
      "id": 4,
      "text": "Cleveland’s Clement School, an H‑shaped brick building from 1929, was part of the Rosenwald school project and is now on the National Register.",
      "sourceSentenceIds": [
        19,
        20
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://townofclevelandnc.gov/cleveland-community/history/"
    },
    {
      "id": 5,
      "text": "Once the state’s dairy‑farming heart, Cleveland’s agricultural heritage is still celebrated in local festivals and historic farm tours.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://townofclevelandnc.gov/cleveland-community/history/"
    },
    {
      "id": 6,
      "text": "After the Western North Carolina Railroad arrived, the local station was named Third Creek, a name the town kept until 1876.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Web source 2"
      ],
