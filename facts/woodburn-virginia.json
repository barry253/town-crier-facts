  "facts": [
    {
      "id": 1,
      "text": "John Tyler built the Woodburn house in 1813 after purchasing the tract in Charles City County, Virginia.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.dhr.virginia.gov/historic-registers/018-0052/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "While serving as a congressman and later governor, Tyler lived in Woodburn, calling it a “decent and comfortable dwelling.”.",
      "sourceSentenceIds": [
        11
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.dhr.virginia.gov/historic-registers/018-0052/",
      "category": "people",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Woodburn’s architecture is a provincial Palladian design, featuring a two‑story center flanked by one‑story wings.",
      "sourceSentenceIds": [
        14
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.dhr.virginia.gov/historic-registers/018-0052/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The name “Woodburn” likely comes from the area’s history of burning timber for fuel or land clearing.",
      "sourceSentenceIds": [
        19
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.wisdomlib.org/cities/woodburn-40585",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Woodburn was added to the Virginia Landmarks Register in 1977 and the National Register of Historic Places in 1978.",
      "sourceSentenceIds": [
        11
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.dhr.virginia.gov/historic-registers/018-0052/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Located in Charles City County, Woodburn sits in a region rich with colonial history and strategic importance throughout American history.",
