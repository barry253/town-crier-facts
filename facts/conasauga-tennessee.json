  "facts": [
    {
      "id": 1,
      "text": "Conasauga’s name comes from Cherokee words meaning “one bullet or arrow,” hinting at a famed marksman legend.",
      "sourceSentenceIds": [
        22
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/conasauga_mcminn_county_tennessee",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The community sits along Conasauga Creek at 787 feet, about 3 miles northeast of Etowah.",
      "sourceSentenceIds": [
        7,
        12
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/conasauga_mcminn_county_tennessee",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Before European arrival, Conasauga was one of three confirmed Cherokee villages in McMinn County, alongside Chestoeh and Great Hiwassee.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/conasauga_mcminn_county_tennessee",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The 1819 Hiwassee Purchase ceded the land to the U.S., ending Cherokee claims by 1820 and opening the area to white pioneers.",
      "sourceSentenceIds": [
        28,
        2,
        3
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/conasauga_mcminn_county_tennessee",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "In the early 1800s, Methodists founded the Conasauga Mission school to educate Cherokee families amid tensions leading to the Trail of Tears.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/conasauga_mcminn_county_tennessee",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Today Conasauga lies within the Appalachian Ridge and Valley province, surrounded by forested hills and agricultural land near the Cherokee National Forest.",
      "sourceSentenceIds": [
        9
      ],
