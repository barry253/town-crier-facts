      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The village’s name honors its founder, William Mowrys, whose legacy lives on in the community’s historic streets.",
      "sourceSentenceIds": [
        19
      ],
      "sourceLabels": [
        "Web source 1"
      ],
