  "facts": [
    {
      "id": 1,
      "text": "Carlton was originally called Hal's Lake, named after a legendary escaped enslaved man, before adopting the name Carlton in the early 20th century.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/carlton_alabama",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The Isaac Nettles Gravestones in Mount Nebo Baptist Church Cemetery are a rare early‑20th‑century African‑American folk art and were listed on the National Register in 2000.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/carlton_alabama",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Mount Nebo Baptist Church Cemetery, founded after emancipation, preserves pioneer and African‑American heritage, marking post‑Civil War community life in Carlton.",
      "sourceSentenceIds": [
        17
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/carlton_alabama",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Carlton’s economy relies on agriculture, forestry, and modest tourism tied to its natural scenery and historic sites, with no incorporated municipal government.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/carlton_alabama",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The Tommy Hart Indian Artifacts Museum, housed in a resident’s home, showcases prehistoric Native American relics from nearby river sites, highlighting Carlton’s deep indigenous history.",
      "sourceSentenceIds": [
        14
      ],
      "sourceLabels": [
        "Web source 1"
      ],
