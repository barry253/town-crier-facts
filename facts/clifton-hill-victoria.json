  "facts": [
    {
      "id": 1,
      "text": "Clifton Hill was named by land developer John Knipe after Clifton Farm, adding Hill to market his estate.",
      "sourceSentenceIds": [
        18,
        19
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Clifton_Hill%2C_Victoria",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The suburb’s grid streets were laid out by Victorian Assistant-Commissioner Clement Hodgkinson in the 1860s, giving it wider streets than most inner Melbourne.",
      "sourceSentenceIds": [
        15,
        29
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Clifton_Hill%2C_Victoria",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "A 19th‑century factory on Page Street became the Clifton Hill Community Music Centre, sparking an experimental post‑punk scene in the late 1970s.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Clifton_Hill%2C_Victoria",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The 1882 Shot Tower beside Alexandra Parade is a rare surviving industrial landmark and is listed on the Victorian Heritage Register.",
      "sourceSentenceIds": [
        8,
        9,
        13
      ],
      "sourceLabels": [
        "Web source 1",
        "Web source 2"
      ],
      "source": "https://victorianplaces.com.au/clifton-hill",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Clifton Hill’s railway station, opened in 1888, is also heritage‑listed and sits on the same line that once carried early suburban commuters.",
      "sourceSentenceIds": [
        13
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://victorianplaces.com.au/clifton-hill",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Before the 1850s, the area that is now Clifton Hill was home to the Wurundjeri people of the Kulin nation for tens of thousands of years.",
      "sourceSentenceIds": [
        20
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Clifton_Hill%2C_Victoria",
