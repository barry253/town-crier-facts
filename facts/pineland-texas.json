  "facts": [
    {
      "id": 1,
      "text": "Pineland was originally called John Adam's Mill, but the name changed to Pineland in 1904 when the post office opened.",
      "sourceSentenceIds": [
        4,
        5
      ],
      "sourceLabels": [
        "Web source 1",
        "Web source 2"
      ],
      "source": "https://www.tshaonline.org/handbook/entries/pineland-tx"
    },
    {
      "id": 2,
      "text": "The Gulf, Beaumont and Great Northern Railway reached Pineland in 1902, turning the area into a lumber camp that sparked the town’s early growth.",
      "sourceSentenceIds": [
        23
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Pineland%2C_Texas"
    },
    {
      "id": 3,
      "text": "In 1907 a sawmill began operation under the Garrison Norton Lumber Company, later bought by Temple Lumber Company, cementing Pineland’s lumber legacy.",
      "sourceSentenceIds": [
        24
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Pineland%2C_Texas"
    },
    {
      "id": 4,
      "text": "By the 1960s Pineland’s economy expanded beyond lumber to include a hospital, library, bank, and supermarket, reflecting a diversifying community.",
      "sourceSentenceIds": [
        19,
        20
      ],
      "sourceLabels": [
        "Web source 1",
        "Web source 2"
      ],
      "source": "https://www.tshaonline.org/handbook/entries/pineland-tx"
    },
    {
      "id": 5,
      "text": "Pineland’s climate features hot, humid summers and mild to cool winters, typical of eastern Texas.",
      "sourceSentenceIds": [
        22
      ],
