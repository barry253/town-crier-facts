  "facts": [
    {
      "id": 1,
      "text": "Start earned its name in 1918 when the U.S. Postal Service approved the community name, chosen by Rachel Morgan because they were making a new start.",
      "sourceSentenceIds": [
        12,
        13,
        14,
        15
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Start%2C_Louisiana",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "After a 1923 school board motion, Start High School was built, and its first graduating class in 1925 produced a single graduate, Marie Robinson.",
      "sourceSentenceIds": [
        17,
        18
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Start%2C_Louisiana",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Geographically, Start lies between the Boeuf River to the east and the Lafourche Diversion Canal to the west, with Crew Lake flowing through the community.",
      "sourceSentenceIds": [
        24,
        25
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Start%2C_Louisiana",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Mail delivery shifted in 1930 when the post office at Crew Lake closed, leaving Start as the sole postal hub for the area.",
      "sourceSentenceIds": [
        19
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Start%2C_Louisiana",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "In 1937 the Resettlement Administration purchased 3,000 acres of the Millsaps Plantation, bringing roughly 40 new families into Start.",
      "sourceSentenceIds": [
        22,
        23
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Start%2C_Louisiana",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Before Richland Parish formed in 1868, the area now known as Start was part of Morehouse Parish, later called Ward 3, Crew Lake, Charleston, or Wynn Island.",
      "sourceSentenceIds": [
        10,
