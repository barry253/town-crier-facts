  "facts": [
    {
      "id": 1,
      "text": "Founded in 1880 at Colorado’s geographic center, Hartsel earned the nickname “The Heart of Colorado.”.",
      "sourceSentenceIds": [
        3,
        4
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Hartsel%2C_Colorado",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Samuel Hartsel, a 19th‑century rancher, built a sawmill, blacksmith shop, and trading post that sparked the town’s early growth.",
      "sourceSentenceIds": [
        13,
        14,
        20
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Hartsel%2C_Colorado",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The Hartsel Depot, a Park County Historic Landmark, once buzzed with freight and passengers on the Colorado Midland Railroad, shipping hay and cattle to the Front Range.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.parkcountyco.gov/392/Hartsel-Area",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Buckley Ranch, listed on the National Register in 2000, was first settled by James B. Buckley in the late 1800s.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.parkcountyco.gov/392/Hartsel-Area",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Hartsel School, relocated to town before 1908, served as the community’s social hub, hosting plays, card games, and town meetings.",
      "sourceSentenceIds": [
        2,
        30
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.parkcountyco.gov/392/Hartsel-Area",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Former Putnam ranch lands, once covering over 800 acres, now lie within Spinney Mountain State Wildlife Area, preserving local wildlife habitat.",
      "sourceSentenceIds": [
        23,
        25
      ],
