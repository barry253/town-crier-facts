  "facts": [
    {
      "id": 1,
      "text": "New Town was platted in 1950 as a replacement site for Sanish and Van Hook, flooded by Lake Sakakawea.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/New_Town%2C_North_Dakota",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town grew to about 1,400 residents by 1955 after relocation of businesses and residents.",
      "sourceSentenceIds": [
        28
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/New_Town%2C_North_Dakota",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The first scheduled train arrived on September 22, 1953, marking the start of rail service.",
      "sourceSentenceIds": [
        27
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/New_Town%2C_North_Dakota",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "New Town is home to Nueta Hidatsa Sahnish College, a tribal college.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/New_Town%2C_North_Dakota",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The Garrison Dam, authorized in 1944, created Lake Sakakawea, which flooded Sanish and Van Hook.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/New_Town%2C_North_Dakota",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Named Four Bears after two great Indian chiefs, a Mandan and a Hidatsa, New Town honors their legacy.",
      "sourceSentenceIds": [
        2
