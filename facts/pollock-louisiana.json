  "facts": [
    {
      "id": 1,
      "text": "Pollock was founded in 1892 around a sawmill and named after Captain John William Pollock, the manager of the Big Creek Sawmill and Lumber Company.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.pollockla.us/?SEC=3E978751-E262-4BC6-824A-7CBB558030B4"
    },
    {
      "id": 2,
      "text": "The town’s early growth was spurred by Jay Gould’s Iron Mountain Railroad, which cut through the area in the late 19th century.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.pollockla.us/?SEC=3E978751-E262-4BC6-824A-7CBB558030B4"
    },
    {
      "id": 3,
      "text": "Pollock sits within Kisatchie National Forest, and Stuart Lake Recreational Area lies just 2.5 miles southwest of the town center.",
      "sourceSentenceIds": [
        17,
        18
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Pollock%2C_Louisiana"
    },
    {
      "id": 4,
      "text": "Pollock was historically a sundown town, a community that did not allow black people after sundown, a fact noted in the town’s official history.",
      "sourceSentenceIds": [
        14
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Pollock%2C_Louisiana"
    },
    {
      "id": 5,
      "text": "The white brick used on the front façade of the Bank of Pollock came from a local brick factory behind the town’s cemetery.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Web source 1"
      ],
