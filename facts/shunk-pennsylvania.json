  "facts": [
    {
      "id": 1,
      "text": "Shunk was renamed from Fox Center in 1847 when the new post office adopted the name of then‑Governor Francis Rawn Shunk.",
      "sourceSentenceIds": [
        13,
        7
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://pagenweb.org/~sullivan/sullivancountyfolk/shunk/ShunkHistory.htm",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The village’s first church, Old Trappe Lutheran, began services in 1743 and now houses a memorial obelisk for Governor Shunk.",
      "sourceSentenceIds": [
        3,
        6
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://pagenweb.org/~sullivan/sullivancountyfolk/shunk/ShunkHistory.htm",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Shunk’s main street once hosted the Hillbilly Drive‑In, a classic roadside eatery that still draws nostalgic visitors.",
      "sourceSentenceIds": [
        18
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://pennsylvaniainfo.blog/shunk-pennsylvania-secret-town",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The community sits along Pennsylvania Route 154, about 8.4 miles west‑northwest of Forksville, placing it in the heart of the Endless Mountains.",
      "sourceSentenceIds": [
        26
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Shunk%2C_Pennsylvania",
      "category": "other",
      "quality": "poor",
      "qualityReason": "location_description"
    },
    {
      "id": 5,
      "text": "Shunk remains an unincorporated community, meaning it has no municipal government and relies on Sullivan County for services.",
      "sourceSentenceIds": [
        25
