  "facts": [
    {
      "id": 1,
      "text": "Elverson was named in 1899 after James Elverson, owner of The Philadelphia Inquirer.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Elverson%2C_Pennsylvania"
    },
    {
      "id": 2,
      "text": "Local historian Bob Patry authored the 2011 book “The History of Our Community: Elverson, Pennsylvania,” detailing the borough’s iron furnaces and Revolutionary-era role.",
      "sourceSentenceIds": [
        1,
        2
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://elversonboro.org/services/history/"
    },
    {
      "id": 3,
      "text": "The Wilmington and Northern Railroad arrived in 1870, fueling Elverson’s growth, before being abandoned and removed in 1983.",
      "sourceSentenceIds": [
        8,
        3
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Elverson%2C_Pennsylvania"
    },
    {
      "id": 4,
      "text": "Elverson Historic District earned a spot on the National Register of Historic Places in 1993.",
      "sourceSentenceIds": [
        29
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Elverson%2C_Pennsylvania"
    },
    {
      "id": 5,
      "text": "Since 1988, the Elverson Historical Commission has placed dozens of plaques—donated by West Philadelphia Machine Works—across the borough.",
      "sourceSentenceIds": [
        4,
        11
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://elversonboro.org/services/history/"
    },
    {
      "id": 6,
      "text": "Just outside Elverson lies Hopewell Furnace National Historic Site, a preserved 19th‑century iron plantation.",
