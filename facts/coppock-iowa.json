  "facts": [
    {
      "id": 1,
      "text": "Coppock, Iowa, was named after early settler John Coppock, who built a grist mill on the Skunk River in 1859.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/coppock_iowa"
    },
    {
      "id": 2,
      "text": "By 1877, Coppock’s grist mill had grown into a four‑story powerhouse, covering 360 acres and including a ferry across the Skunk River.",
      "sourceSentenceIds": [
        26
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Coppock%2C_Iowa"
    },
    {
      "id": 3,
      "text": "The arrival of two railroads in 1882—Burlington & Western and Iowa Central—spurred Coppock’s formal platting into four city blocks.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/coppock_iowa"
    },
    {
      "id": 4,
      "text": "Coppock once boasted two depots, stockyards, water tanks, and a coaling station, all serving the parallel tracks that crossed the Skunk River.",
      "sourceSentenceIds": [
        20
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/coppock_iowa"
    },
    {
      "id": 5,
      "text": "Coppock sits on the Skunk River just above its confluence with Crooked Creek, a spot that once supported a ferry service.",
      "sourceSentenceIds": [
        4,
        10
      ],
      "sourceLabels": [
        "Wikipedia",
