  "facts": [
    {
      "id": 1,
      "text": "Sauk Centre’s name was chosen in a lottery among the eight original town shareholders, with Alexander Moore submitting the winning suggestion.",
      "sourceSentenceIds": [
        1,
        7,
        28
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Sauk_Centre%2C_Minnesota",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Named after the Sauk people, the town’s early growth was fueled by agriculture and the arrival of the railroad, connecting Sauk Centre to larger markets.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.visitsaukcentre.org/history",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Sauk Centre contains the Sinclair Lewis Boyhood Home, a National Historic Landmark that celebrates the Nobel laureate’s early years.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Sauk_Centre%2C_Minnesota",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Sauk Centre hosts two Lewis sculptures: a life‑size statue outside the library and a bust inside, honoring the author.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Sauk_Centre%2C_Minnesota",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Viking Altar Rock, a distinctive sandstone formation, stands as a local landmark overlooking the town’s central area.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Sauk_Centre%2C_Minnesota",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The Palmer House, built in 1901, is a historic hotel that remains a cornerstone of Sauk Centre’s hospitality and culture.",
      "sourceSentenceIds": [
        18
      ],
      "sourceLabels": [
        "Web source 1"
      ],
