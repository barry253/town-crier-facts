  "facts": [
    {
      "id": 1,
      "text": "Zionville sits at 3,209 feet in the Blue Ridge Mountains, just 10 miles north of Boone and right on the North Carolina–Tennessee line.",
      "sourceSentenceIds": [
        24,
        25,
        26
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/zionville_north_carolina",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The community marks the historic crossroads of Daniel Boone’s Trail and the Old Buffalo Trail, commemorated by a 1913 cast‑iron marker.",
      "sourceSentenceIds": [
        4,
        5,
        22
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/zionville_north_carolina",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Early settlers in the late 1700s farmed corn and cabbage in Zionville’s valley bottomlands, shaping clustered creekside homes.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/zionville_north_carolina",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Zionville Baptist Church, founded in 1836, remains one of the town’s oldest standing institutions.",
      "sourceSentenceIds": [
        13
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Zionville%2C_North_Carolina",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "By 1915 Zionville had grown into a regional hub with merchants, a school, and a WPA‑built classroom during the Great Depression.",
      "sourceSentenceIds": [
        21
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/zionville_north_carolina",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "In 1963 U.S. Route 421 was rerouted east, leaving Zionville bypassed and preserving its quiet rural character.",
