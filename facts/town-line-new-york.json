  "facts": [
    {
      "id": 1,
      "text": "Town Line was a stop on the historic New York and Erie Railroad, linking the hamlet to regional trade routes.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.history.com/articles/civil-war-secession-new-york-town",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "In 1861, Town Line voted to secede from the United States, but the resolution had no legal effect because the hamlet was never incorporated.",
      "sourceSentenceIds": [
        18,
        19
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Town_Line%2C_New_York",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The secession vote was forgotten for eight decades until a Buffalo reporter revived the story in 1945, bringing it back into public memory.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.history.com/articles/civil-war-secession-new-york-town",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "On January 24 1946, Town Line ceremonially rejoined the Union, a ceremony attended by Hollywood star Cesar Romero.",
      "sourceSentenceIds": [
        20,
        21
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Town_Line%2C_New_York",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "A plaque erected by the Alden Historical Society commemorates Town Line’s secession, standing as a reminder of its unique Civil War history.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.history.com/articles/civil-war-secession-new-york-town",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "During the rejoining ceremony, residents switched from playing “Dixie” to “The Star‑Spangled Banner” as the Confederate flag was lowered.",
      "sourceSentenceIds": [
        11
      ],
      "sourceLabels": [
        "Web source 1"
      ],
