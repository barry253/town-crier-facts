  "facts": [
    {
      "id": 1,
      "text": "Howard was named for Brigadier General Benjamin Howard, who served as an officer during the War of 1812.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Howard%2C_Wisconsin"
    },
    {
      "id": 2,
      "text": "Before incorporating as a village, Howard was commonly called Duck Creek because of the waterway winding through the area.",
      "sourceSentenceIds": [
        14
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Howard%2C_Wisconsin"
    },
    {
      "id": 3,
      "text": "The Town of Howard was established in 1835 and developed as a center for farming, quarrying, and lumbering.",
      "sourceSentenceIds": [
        16
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Howard%2C_Wisconsin"
    },
    {
      "id": 4,
      "text": "Howard became well known for its four stone quarries, the last of which finally shut down in 2002.",
      "sourceSentenceIds": [
        17,
        18
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Howard%2C_Wisconsin"
    },
    {
      "id": 5,
      "text": "Three major railroads converged in Howard by 1848, including the Chicago and North Western and the Milwaukee Road.",
      "sourceSentenceIds": [
