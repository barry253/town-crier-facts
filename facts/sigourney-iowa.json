  "facts": [
    {
      "id": 1,
      "text": "Sigourney was founded in 1844 and named after the beloved poet Lydia Sigourney, who later helped fund tree planting in the town’s courtyard.",
      "sourceSentenceIds": [
        1,
        7
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://sigourney.com/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The Keokuk County Historical Society, located at 402 East Elm Street, preserves the region’s past through a vast collection of photographs, artifacts, and genealogy records.",
      "sourceSentenceIds": [
        3,
        19
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://communityhistoryarchives.com/places/keokuk-county-historical-society/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Sigourney’s historic courthouse square, home to the Keokuk County Courthouse, is a centerpiece of the town’s public square historic district.",
      "sourceSentenceIds": [
        24
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Sigourney%2C_Iowa",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The Community History Archives offers free, digitized access to newspapers from 1870 to 2023, letting residents and researchers explore the town’s stories online.",
      "sourceSentenceIds": [
        15
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://communityhistoryarchives.com/places/keokuk-county-historical-society/",
      "category": "other",
      "quality": "poor",
      "qualityReason": "vague"
    },
    {
      "id": 5,
      "text": "Sigourney’s charming historic downtown features a mix of preserved 19th‑century architecture and lively community events that celebrate the town’s agricultural heritage.",
      "sourceSentenceIds": [
