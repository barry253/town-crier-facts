    },
    {
      "id": 2,
      "text": "A railroad executive named the town Oakridge in 1912 because of the surrounding topography.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Oakridge%2C_Oregon"
    },
    {
      "id": 3,
      "text": "Oakridge is nestled in the heart of the Willamette National Forest in Lane County, Oregon.",
