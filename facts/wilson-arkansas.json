  "facts": [
    {
      "id": 1,
      "text": "Wilson began as a company town in 1886, founded by Robert E. Wilson, who also started a logging and sawmill operation that same year.",
      "sourceSentenceIds": [
        18,
        20
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Wilson%2C_Arkansas",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Wilson built a railroad linking the town to Golden Landing and its sawmill, and the line was bought by the Jonesboro, Lake City and Eastern Railroad in 1912.",
      "sourceSentenceIds": [
        12,
        13
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Wilson%2C_Arkansas",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The Wilson Company would become so successful that all of the town's buildings were rebuilt in the Tudor Revival architectural style following Wilson's son's honeymoon to England in 1925.",
      "sourceSentenceIds": [
        22
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Wilson%2C_Arkansas",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The community is located in the Arkansas Delta and is surrounded by fertile cropland historically used to produce cotton.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Wilson%2C_Arkansas",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The Hampson Archaeological Museum showcases local indigenous culture and regional history in Wilson.",
      "sourceSentenceIds": [
        16
      ],
