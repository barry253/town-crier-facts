  "facts": [
    {
      "id": 1,
      "text": "Oxford was founded in 1868 by settlers led by Captain H.P., who named the town after Oxford, England.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://nearbylens.com/cities/usa/fl/oxford/",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town’s post office, opened in 1871, is the oldest continuously operating post office in Sumter County.",
      "sourceSentenceIds": [
        5,
        17
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://nearbylens.com/cities/usa/fl/oxford/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Oxford grew from a modest farming community into a bustling town after the Civil War, when settlers sought new land in Florida’s interior.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/oxford_florida",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The Withlacoochee River system lies just west of Oxford, shaping local drainage and occasionally causing floods in low‑lying areas.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/oxford_florida",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The town’s historic district and the nearby Lake Miona offer scenic spots that reflect Oxford’s rural charm.",
