  "facts": [
    {
      "id": 1,
      "text": "Rockford Bay sits on land that was home to the Schitsu'umsh people of the Coeur d'Alene Tribe for millennia before European settlers arrived.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/rockford_bay_idaho",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Between East Point and Rockford Point, the bay’s depths range from 15 to 19 meters, nurturing beds of Potamogeton aquatic plants.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/rockford_bay_idaho",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "A joint Idaho Department of Fish and Game–Kootenai County site offers a boat ramp, dock, and parking for fishing and boating enthusiasts.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/rockford_bay_idaho",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Rockford Bay receives about 25 inches of rain yearly, with November averaging 3.8 inches and August dropping to just 0.9 inches.",
      "sourceSentenceIds": [
        22
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/rockford_bay_idaho",
      "category": "other",
      "quality": "poor",
      "qualityReason": "vague"
    },
    {
      "id": 6,
      "text": "The lake basin that surrounds Rockford Bay was carved by Pleistocene outburst floods from glacial Lake Missoula, leaving thick gravel layers.",
