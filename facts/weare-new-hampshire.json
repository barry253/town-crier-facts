  "facts": [
    {
      "id": 1,
      "text": "Weare was named after Meshech Weare, the town’s first clerk who later became New Hampshire’s first governor.",
      "sourceSentenceIds": [
        7,
        26
      ],
      "sourceLabels": [
        "Web source 1",
        "Wikipedia"
      ],
      "source": "https://localnh.com/towns/weare",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "In 1834 Moses Cartland founded Clinton Grove Academy, New Hampshire’s first Quaker seminary, which still stands in Weare’s center village.",
      "sourceSentenceIds": [
        1,
        4,
        27
      ],
      "sourceLabels": [
        "Web source 1",
        "Wikipedia"
      ],
      "source": "https://localnh.com/towns/weare",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The town’s historic East Weare Village was flooded in 1960 to create Everett Lake, a 268‑acre reservoir that powers hydropower downstream.",
      "sourceSentenceIds": [
        11,
        16,
        12
      ],
      "sourceLabels": [
        "Web source 1",
        "Wikipedia"
      ],
      "source": "https://localnh.com/towns/weare",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Weare’s annual heritage gatherings are organized by the Friends of Weare History, a group that publishes open-access research for genealogists and students.",
      "sourceSentenceIds": [
        2,
        22
      ],
      "sourceLabels": [
        "Web source 2",
        "Web source 2"
      ],
      "source": "https://fwh.omeka.net/",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "High schoolers from Weare attend John Stark Regional High School, a joint campus opened in 1987 that honors the Revolutionary War general who coined New Hampshire’s motto.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://localnh.com/towns/weare",
      "category": "people",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The Hopkinton‑Everett trail system, one of New Hampshire’s oldest public OHV riding areas, winds through Weare’s scenic countryside.",
