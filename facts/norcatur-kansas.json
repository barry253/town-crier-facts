  "facts": [
    {
      "id": 1,
      "text": "Norcatur was founded in 1885 just north of the Nebraska border, marking the start of a new Kansas community.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Norcatur%2C_Kansas",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town’s name comes from its position on the border between Norton and Decatur counties.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Norcatur%2C_Kansas",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "When the Chicago, Burlington & Quincy Railroad arrived in 1885, Norcatur quickly grew, opening stores, a post office, a bank, and a blacksmith shop.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/norcatur_kansas",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "In 1901 Norcatur was incorporated and held its first election on November 13, 1901, solidifying its municipal status.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.dccoks.org/cities/norcatur",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "In 1938 the Public Works Administration built a modern fireproof city hall that still houses the fire truck, library, and community rooms.",
