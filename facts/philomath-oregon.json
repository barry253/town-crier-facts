  "facts": [
    {
      "id": 1,
      "text": "Philomath takes its name from two Greek words meaning lover of learning, inspired by the local college founded in the mid-nineteenth century.",
      "sourceSentenceIds": [
        3,
        23
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Philomath%2C_Oregon"
    },
    {
      "id": 2,
      "text": "The Kalapuya Native American tribe inhabited the area now known as Philomath before European settlers arrived in the mid-nineteenth century.",
      "sourceSentenceIds": [
        11
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.visitoregon.com/cities/philomath-oregon/"
    },
    {
      "id": 3,
      "text": "Philomath was officially incorporated on October 20, 1882.",
      "sourceSentenceIds": [
        24
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Philomath%2C_Oregon"
    },
    {
      "id": 4,
      "text": "The Benton County Historical Museum is a well-known Philomath landmark featuring a distinctive bell tower.",
      "sourceSentenceIds": [
