  "facts": [
    {
      "id": 1,
      "text": "On August 29, 1900, Phoenix residents voted 67.9% to incorporate as an independent village, separating from the neighboring city of Harvey.",
      "sourceSentenceIds": [
        21,
        22,
        23,
        24
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Phoenix%2C_Illinois",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Founded in 1890 as a dry community, Phoenix—originally called Phenix Park—was created to keep alcohol out of nearby Harvey.",
      "sourceSentenceIds": [
        3,
        4,
        18,
        19,
        20,
        24
      ],
      "sourceLabels": [
        "Web source 1",
        "Wikipedia"
      ],
      "source": "https://villageofphoenix.com/history/",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Early factories sprang up between the Illinois Central Railroad and Halsted Street, anchoring Phoenix’s industrial roots.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Phoenix%2C_Illinois",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The village’s first library opened in the basement of Village Hall, but frequent floods often destroyed its books.",
      "sourceSentenceIds": [
        10,
        11
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://villageofphoenix.com/history/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "During the 1930s, Phoenix completed the Hawkins Multi‑Purpose Center and a new fire station, signaling a boom in community facilities.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://villageofphoenix.com/history/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The village’s name change from Phenix to Phoenix symbolized rebirth, echoing the mythical bird’s legend after its 1900 incorporation.",
