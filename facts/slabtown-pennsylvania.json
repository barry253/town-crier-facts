  "facts": [
    {
      "id": 1,
      "text": "Slabtown gets its name from the rough, unfinished slab boards produced by the local sawmill to build the village's first structures.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/slabtown_pennsylvania"
    },
    {
      "id": 2,
      "text": "Slabtown emerged as one of the earliest settled areas in the Roaring Creek Valley during the 1780s following the American Revolution.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/slabtown_pennsylvania"
    },
    {
      "id": 3,
      "text": "Quaker settler Thomas Linvill commissioned the township's first gristmill and sawmill on Roaring Creek around 1798 to process local timber and grain.",
      "sourceSentenceIds": [
        23,
        28,
        29
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/slabtown_pennsylvania"
    },
    {
      "id": 4,
      "text": "Slabtown sits in the valley of Roaring Creek, a westward-flowing tributary of the Susquehanna River.",
      "sourceSentenceIds": [
        11
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Slabtown%2C_Pennsylvania"
    },
    {
      "id": 5,
      "text": "Early inhabitants of Slabtown included Quakers, followed by German settlers from Berks County and Welsh immigrants in the 1840s.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/slabtown_pennsylvania"
    },
    {
      "id": 6,
      "text": "Slabtown remains a quiet, agriculture-focused hamlet featuring the Trinity Methodist Episcopal church, which was built in 1872.",
      "sourceSentenceIds": [
        24
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/slabtown_pennsylvania"
    }
