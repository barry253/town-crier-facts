  "facts": [
    {
      "id": 1,
      "text": "McGrann is an unincorporated community in Manor Township, Armstrong County, PA, at 40°46′53″N 79°31′17″W, 797 ft elevation.",
      "sourceSentenceIds": [
        21
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/mcgrann_pennsylvania"
    },
    {
      "id": 2,
      "text": "McGrann sits on the western edge of the Allegheny Plateau, roughly 40 miles northeast of Pittsburgh.",
      "sourceSentenceIds": [
        22
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/mcgrann_pennsylvania"
    },
    {
      "id": 3,
      "text": "The community borders Manorville to the northwest, Ford City to the southwest, and Pennsylvania Route 66 to the east.",
      "sourceSentenceIds": [
        23
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/mcgrann_pennsylvania"
    },
    {
      "id": 4,
      "text": "McGrann lies near the Allegheny River to the south and Crooked Creek Lake to the north, giving access to waterways.",
      "sourceSentenceIds": [
        25
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/mcgrann_pennsylvania"
    },
    {
      "id": 5,
      "text": "Pennsylvanian‑age coal seams under McGrann have historically fueled local mining operations.",
      "sourceSentenceIds": [
        26
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/mcgrann_pennsylvania"
    },
    {
      "id": 6,
      "text": "Winters average 18°F lows, summers 83°F highs, with about 43 inches of annual precipitation.",
