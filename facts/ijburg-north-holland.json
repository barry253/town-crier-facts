      "quality": "good"
    },
    {
      "id": 4,
      "text": "The IJtram was extended through a bend to reach the new island, connecting Centraal Station directly to IJburg.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.amsterdamhv.nl/wiki/ijburg.html",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The neighborhood will eventually host 20,000 homes for 50,000 residents, including a beach and employment for 12,000 people.",
      "sourceSentenceIds": [
        25
