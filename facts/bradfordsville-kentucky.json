  "facts": [
    {
      "id": 1,
      "text": "Bradfordsville earned its name when Peter Bradford’s saw‑and‑gristmill sparked a settlement that changed from Centerville to Bradfordsville after a post office opened in 1834.",
      "sourceSentenceIds": [
        2,
        9
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Bradfordsville%2C_Kentucky",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town sits in the Rolling Fork Valley, just east of where the North Rolling Fork and Big South Fork merge to form the Rolling Fork proper.",
      "sourceSentenceIds": [
        11
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Bradfordsville%2C_Kentucky",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "That Rolling Fork runs northwest, joins the Salt River, and eventually feeds into the Ohio River a few miles downstream.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Bradfordsville%2C_Kentucky",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Bradfordsville is mostly surrounded by rugged hills, with the Muldraugh Hill escarpment rising to the south.",
      "sourceSentenceIds": [
        13
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Bradfordsville%2C_Kentucky",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Bradfordsville is a home‑rule‑class city, giving it local governance autonomy within Marion County.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
