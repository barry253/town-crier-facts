  "facts": [
    {
      "id": 1,
      "text": "Passapatanzy was once a Patawomeck village ruled by Japazaws, the elder brother of the weroance.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Passapatanzy%2C_Virginia",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Pocahontas lived in Passapatanzy with her husband Kocoum, according to Mattaponi and Patawomeck tradition.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Passapatanzy%2C_Virginia",
      "category": "people",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "In 1613 Japazaws conspired with English explorer Samuel Argall to capture Pocahontas as a hostage in negotiations with Powhatan.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Passapatanzy%2C_Virginia",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "A historic marker commemorating this event stands near the Potomac Creek Bridge on U.S. Route 1.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Passapatanzy%2C_Virginia",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Passapatanzy sits on Virginia State Route 218, nine miles west of Fredericksburg and fifteen miles east of the Potomac River.",
      "sourceSentenceIds": [
        13
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Passapatanzy%2C_Virginia",
      "category": "other",
      "quality": "poor",
      "qualityReason": "location_description"
    },
    {
      "id": 6,
      "text": "The town’s serene ambiance invites residents to explore the picturesque Potomac River and its surrounding natural beauty.",
