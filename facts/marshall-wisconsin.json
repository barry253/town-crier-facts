  "facts": [
    {
      "id": 1,
      "text": "Before it was called Marshall, the village was known as Bird’s Ruins for more than a decade.",
      "sourceSentenceIds": [
        13
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.marshall-wi.com/index.asp?SEC=1DCC4FF2-7704-4DCA-BC12-4F11CD0F574D&DE=ACDADE55-DF4A-43D0-91EC-EB30826C73B9"
    },
    {
      "id": 2,
      "text": "Marshall was the second village in Wisconsin to inaugurate rural postal service.",
      "sourceSentenceIds": [
        29
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.marshall-wi.com/index.asp?SEC=1DCC4FF2-7704-4DCA-BC12-4F11CD0F574D&DE=ACDADE55-DF4A-43D0-91EC-EB30826C73B9"
    },
    {
      "id": 3,
      "text": "The village was once called Hanchetville to recognize Asahel Hanchett's ability to lure businesses to the area.",
      "sourceSentenceIds": [
        20
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.marshall-wi.com/index.asp?SEC=1DCC4FF2-7704-4DCA-BC12-4F11CD0F574D&DE=ACDADE55-DF4A-43D0-91EC-EB30826C73B9"
    },
    {
      "id": 4,
      "text": "Marshall takes its name from Samuel Marshall, one of the real estate brokers who purchased land in the mid-nineteenth century.",
      "sourceSentenceIds": [
        25,
        26
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.marshall-wi.com/index.asp?SEC=1DCC4FF2-7704-4DCA-BC12-4F11CD0F574D&DE=ACDADE55-DF4A-43D0-91EC-EB30826C73B9"
    },
    {
      "id": 5,
      "text": "A violent, county-wide milk strike centered in Marshall during 1933 served as the basis for a novel.",
      "sourceSentenceIds": [
