  "facts": [
    {
      "id": 1,
      "text": "Connelly Springs grew around a 1838 way station where Colonel William Lewis Connelly offered fresh horses for the Salisbury‑Asheville stagecoach line.",
      "sourceSentenceIds": [
        11,
        12
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Connelly_Springs%2C_North_Carolina",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "In 1885, a mineral spring was discovered, and the town’s namesake hotel opened, drawing travelers who brought water in five‑gallon demijohns.",
      "sourceSentenceIds": [
        16,
        17,
        4
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Connelly_Springs%2C_North_Carolina",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Connelly Springs was officially incorporated on May 4, 1920, after the settlement had already been known as Happy Home.",
      "sourceSentenceIds": [
        18,
        12
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Connelly_Springs%2C_North_Carolina",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The old railroad bed that once carried the town’s economic lifeblood now serves as a leafy trail for walkers, runners, and cyclists.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.wikixm.com/us/nc/connelly-springs/overview",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Connelly Springs sits in eastern Burke County, bordered to the west by Rutherford College and to the north by Rhodhiss Lake on the Catawba River.",
      "sourceSentenceIds": [
        19,
        20
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Connelly_Springs%2C_North_Carolina",
      "category": "other",
      "quality": "poor",
      "qualityReason": "location_description"
    },
    {
      "id": 6,
      "text": "Interstate 40 skirts the southern edge of Connelly Springs, linking the town to Hickory and Morganton just ten miles away.",
