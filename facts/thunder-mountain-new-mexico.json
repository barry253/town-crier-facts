      "quality": "good"
    },
    {
      "id": 2,
      "text": "Thunder Mountain experiences a semi‑arid continental climate (Köppen BSk), with most rain falling in July‑September monsoon storms and winter snow.",
      "sourceSentenceIds": [
        17,
        19
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/thunder_mountain_new_mexico",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "With over 280 clear days yearly, Thunder Mountain enjoys bright skies and daily temperature swings of 25‑35°F.",
      "sourceSentenceIds": [
        21,
        22
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/thunder_mountain_new_mexico",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Summer highs hover around 82‑84°F while winter lows dip to 23‑27°F, and snowfall averages 26 inches each year.",
      "sourceSentenceIds": [
        25,
        26
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/thunder_mountain_new_mexico",
      "category": "nature",
      "quality": "good"
    },
    {
