      "quality": "good"
    },
    {
      "id": 2,
      "text": "The Belfast & Moosehead Lake Railroad, chartered in 1867, linked the town to six other Waldo County communities by 1870.",
      "sourceSentenceIds": [
        25
      ],
      "sourceLabels": [
        "Web source 1"
      ],
