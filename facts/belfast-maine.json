      "category": "transport",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The Front Street Shipyard, built on the former B&ML main yard in 2011, now houses a 26,500‑sq‑ft boat‑building facility.",
      "sourceSentenceIds": [
        9,
        16
      ],
      "sourceLabels": [
