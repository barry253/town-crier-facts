      "category": "transport",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "At its peak, the LVRR operated three stations in Mendon: one in the hamlet, one at Rochester Junction, and one in Honeoye Falls.",
      "sourceSentenceIds": [
        19
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
