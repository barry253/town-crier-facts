  "facts": [
    {
      "id": 1,
      "text": "Bowling Green is famed as the 'cradle of American horse racing' and houses Virginia’s second‑oldest Masonic Lodge.",
      "sourceSentenceIds": [
        11
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Bowling_Green%2C_Virginia",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town took its name from founder Dache Carmine’s plantation, whose land and funds built the courthouse when it became county seat in 1803.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Bowling_Green%2C_Virginia",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Old Mansion, a pre‑Georgian house built around 1741, remains the oldest continuously inhabited residence in Virginia.",
      "sourceSentenceIds": [
        18,
        11
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Bowling_Green%2C_Virginia",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "A major freight railroad line that once belonged to Virginia now runs through Bowling Green as part of CSX, while Amtrak trains also pass through.",
      "sourceSentenceIds": [
        5,
        6
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Bowling_Green%2C_Virginia",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Strolling down Bowling Green’s tree‑lined streets, you’ll find locally owned shops like Artism by Joey and JB Apothecary, showcasing community creativity.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.townofbowlinggreenva.gov/community/page/visit-bowling-green",
      "category": "other",
      "quality": "poor",
      "qualityReason": "editorial_filler"
    },
    {
      "id": 6,
      "text": "The historic district, anchored by Old Mansion, includes colonial landmarks listed on both the Virginia Landmarks Register and the National Register of Historic Places.",
