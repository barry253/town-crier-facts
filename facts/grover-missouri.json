      "quality": "good"
    },
    {
      "id": 2,
      "text": "The village’s commercial heart sits on Old Manchester Road, once part of historic U.S. Route 66, now fully absorbed into Wildwood.",
      "sourceSentenceIds": [
        8,
        9
      ],
      "sourceLabels": [
        "Web source 1"
      ],
