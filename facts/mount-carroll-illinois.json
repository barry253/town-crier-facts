      "quality": "poor",
      "qualityReason": "vague"
    },
    {
      "id": 3,
      "text": "Shimer College, founded in 1853 as Mount Carroll Seminary, moved to Chicago in 2006 but its former campus now houses the Campbell Center for Historic Preservation Studies.",
      "sourceSentenceIds": [
        5,
        9,
        21
      ],
      "sourceLabels": [
