  "facts": [
    {
      "id": 1,
      "text": "McGrath takes its name from James E. McGrath, a logger who began working the area in 1895 and donated land for the town.",
      "sourceSentenceIds": [
        2,
        3,
        4,
        14
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1",
        "Web source 2"
      ],
      "source": "https://en.wikipedia.org/wiki/McGrath%2C_Minnesota",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "In 1907 McGrath donated 40 acres for a town site, which the Patterson Land Company platted as Elmwood before the post office opened in 1908.",
      "sourceSentenceIds": [
        4,
        15
      ],
      "sourceLabels": [
        "Web source 1",
        "Wikipedia"
      ],
      "source": "https://www.lakesnwoods.com/McGrath.htm",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "McGrath was officially incorporated as a city in 1923, solidifying its status after decades of logging and settlement.",
      "sourceSentenceIds": [
        16
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/McGrath%2C_Minnesota",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The surrounding forest supports ongoing timber harvesting, reforestation, and wildlife habitat improvement projects that shape the local landscape.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.lakesnwoods.com/McGrath.htm",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "A historic 1910 depot stands in McGrath, a relic captured by the Minnesota Historical Society and preserved in the town’s photo archives.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://lakesnwoods.com/McGrathGallery.htm",
      "category": "landmark",
      "quality": "good"
    },
    {
