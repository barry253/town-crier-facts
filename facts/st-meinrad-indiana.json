      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The first exhibit, “The Evolution of Tradition,” runs from July 1 to November 29, 2024, tracing the abbey’s early years.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 2"
