      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Saint Meinrad Archabbey was founded in 1854 by monks from Einsiedeln Abbey in Switzerland.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.saintmeinrad.org/the-monastery/history/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "About 70 Benedictine monks live in the abbey, gathering five times daily to pray the Liturgy of the Hours and celebrate Mass.",
      "sourceSentenceIds": [
        20
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.saintmeinrad.org/the-monastery/history/",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "In 1861 the monks expanded their general courses to include undergraduate philosophy and theology classes.",
      "sourceSentenceIds": [
        26
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.saintmeinrad.org/the-monastery/history/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "A post office has operated in Saint Meinrad since 1862, serving the community for over a century.",
