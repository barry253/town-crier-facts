  "facts": [
    {
      "id": 1,
      "text": "Eau Claire’s name comes from a clear stream, French “eau claire,” chosen by early settler Henry Rush after the Potawatomi land.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://99wfmk.com/eau-claire-michigan/",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The village was officially founded in 1861 when William Smythe Farmer opened the first post office and Henry Rush became postmaster.",
      "sourceSentenceIds": [
        27
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://99wfmk.com/eau-claire-michigan/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "In 1882 the railroad arrived, spurring growth and bringing a cider mill, drug store, hotel, manufacturing plant, and stove company.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://99wfmk.com/eau-claire-michigan/",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Every year since 1974, the International Cherry Pit‑Spitting Championship has been held at Tree‑Mendus Fruit Farm, making Eau Claire a quirky cherry‑spitting capital.",
      "sourceSentenceIds": [
        30
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://99wfmk.com/eau-claire-michigan/",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The only drive‑in theater in Michigan’s Upper Peninsula, the Star Theatre in nearby Brooklyn, once served the Eau Claire area, reflecting early 20th‑century entertainment.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://99wfmk.com/eau-claire-michigan/",
      "category": "other",
      "quality": "poor",
      "qualityReason": "vague"
    },
    {
      "id": 6,
      "text": "The village sits partly in Pipestone Township and partly in Berrien Charter Township, illustrating its spread across two local governments.",
