  "facts": [
    {
      "id": 1,
      "text": "Hickory Hill was annexed by Memphis on December 31, 1998, shifting from unincorporated Shelby County to city jurisdiction.",
      "sourceSentenceIds": [
        11,
        20
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 2"
      ],
      "source": "https://en.wikipedia.org/wiki/Hickory_Hill%2C_Memphis"
    },
    {
      "id": 2,
      "text": "The neighborhood grew steadily until the 1970s when several large companies arrived, sparking its first economic and housing booms.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://fromcommonground.com/hickoryhillhistory/"
    },
    {
      "id": 3,
      "text": "Today Hickory Hill is a middle‑class, predominantly African‑American community with high school graduation rates higher than the city average.",
      "sourceSentenceIds": [
        9,
        12
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Hickory_Hill%2C_Memphis"
    },
    {
      "id": 4,
      "text": "The area once hosted the Sharp Manufacturing Company of America, which produced color televisions.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://fromcommonground.com/hickoryhillhistory/"
    },
    {
      "id": 5,
      "text": "Hickory Hill houses Memphis’ largest public community center and the longest public golf course in the city.",
      "sourceSentenceIds": [
        29
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://fromcommonground.com/hickoryhillhistory/"
    },
    {
      "id": 6,
      "text": "The neighborhood’s rapid demographic shift after annexation led to a battle against annexation and a mass exodus of businesses and white residents in the 1990s and 2000s.",
      "sourceSentenceIds": [
        22
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://fromcommonground.com/hickoryhillhistory/"
    }
  ]
