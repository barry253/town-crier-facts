    {
      "id": 1,
      "text": "Twin Hills Colony was founded in 2002 as a Lehrerleut Hutterite community after splitting from Glendale Hutterite Colony near Cut Bank.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/twin_hills_colony_montana",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Twin Hills Colony rests at 3,304 feet above sea level, placing it in Montana’s high plains.",
      "sourceSentenceIds": [
        30
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/twin_hills_colony_montana",
      "category": "nature",
      "quality": "poor",
      "qualityReason": "vague"
    },
    {
      "id": 4,
      "text": "Cold winters keep the colony indoors for maintenance, while warm summers drive intensive crop cultivation.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/twin_hills_colony_montana",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Initial infrastructure included family dwellings, a central kitchen and dining hall, workshops, and a schoolhouse to support self‑sufficiency.",
      "sourceSentenceIds": [
        20
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/twin_hills_colony_montana",
      "category": "landmark",
      "quality": "good"
    },
    {
