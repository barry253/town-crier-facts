  "facts": [
    {
      "id": 1,
      "text": "Verde Village was developed in 1970 as a retirement community, originally consisting of eight units named Verde Village Units One through Eight.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Verde_Village%2C_Arizona",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "About two-thirds of Verde Village residents are retired, reflecting its original purpose as a retirement community.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Verde_Village%2C_Arizona",
      "category": "people",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Verde Village is part of the Verde Valley, which spans roughly 714 square miles in central Arizona.",
      "sourceSentenceIds": [
        23
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.verdevalleychamber.org/about-the-verde-valley/",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The Verde River flows through the Verde Valley, providing a waterway that runs northwest to southeast across the region that includes Verde Village.",
      "sourceSentenceIds": [
        24
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.verdevalleychamber.org/about-the-verde-valley/",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Nearly 80% of the land in the Verde Valley is National Forest, meaning most of the surrounding area around Verde Village is federally protected forest land.",
      "sourceSentenceIds": [
        28
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.verdevalleychamber.org/about-the-verde-valley/",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The elevation of the Verde Valley ranges from 3,300 to 3,900 feet above sea level, giving Verde Village a mild climate typical of the region.",
      "sourceSentenceIds": [
        26
