  "facts": [
    {
      "id": 1,
      "text": "Bridgewater was chartered in 1656 from Duxbury, making it one of Massachusetts' oldest towns.",
      "sourceSentenceIds": [
        25
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Bridgewater%2C_Massachusetts",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Its historic center lies roughly 25 miles south of Boston, giving the town a small‑town feel while staying close to the capital.",
      "sourceSentenceIds": [
        11,
        12
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Bridgewater%2C_Massachusetts",
      "category": "other",
      "quality": "poor",
      "qualityReason": "location_description"
    },
    {
      "id": 3,
      "text": "Bridgewater State University, founded as a normal school in 1840, remains a key educational landmark in the town.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Bridgewater%2C_Massachusetts",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The old Bridgewater Iron Works, once a major factory, was converted into Ironworks Park after most of the building was torn down in 1994.",
      "sourceSentenceIds": [
        2,
        7
      ],
      "sourceLabels": [
        "Wikipedia",
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Bridgewater%2C_Massachusetts",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The Bridgewater Historical Society at 162 Howard Street preserves artifacts from the town’s original township, celebrating its 1656 founding.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.oldbridgewater.org/",
      "category": "history",
      "quality": "good"
    },
    {
