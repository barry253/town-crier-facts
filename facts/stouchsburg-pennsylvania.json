  "facts": [
    {
      "id": 1,
      "text": "Stouchsburg grew around the Peter Spycker House, a stone home built circa 1740 that later expanded into a Georgian‑style landmark.",
      "sourceSentenceIds": [
        1,
        27,
        28
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/stouchsburg_pennsylvania",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The village’s name honors early settler Peter Spycker, who arrived in 1737 and became the first justice of the peace in the area.",
      "sourceSentenceIds": [
        27,
        29
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/stouchsburg_pennsylvania",
      "category": "people",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Stouchsburg’s Main Street was lined with 12–15 new buildings between 1817 and 1825, shifting from log to brick as the turnpike opened.",
      "sourceSentenceIds": [
        4,
        14
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/stouchsburg_pennsylvania",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The Stouchsburg Historic District, added to the National Register in 1985, preserves dozens of 19th‑century structures including the American House hotel and a surviving grist mill.",
      "sourceSentenceIds": [
        15
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/stouchsburg_pennsylvania",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "During the French and Indian War, the Tulpehocken settlement—of which Stouchsburg is a part—served as a frontier hub for colonial defenses and Native American diplomacy.",
      "sourceSentenceIds": [
        30
      ],
