  "facts": [
    {
      "id": 1,
      "text": "Migdal HaEmek was founded in 1953 as a ma'abara for Jews from Arab countries before evolving into a development town.",
      "sourceSentenceIds": [
        6,
        13
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Migdal_HaEmek"
    },
    {
      "id": 2,
      "text": "The original ma'abara site lay west of the current town, on Shimron hill, before the settlement moved eastward.",
      "sourceSentenceIds": [
        7,
        14
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Migdal_HaEmek"
    },
    {
      "id": 3,
      "text": "A prominent tower rises to the north‑east of Migdal HaEmek, overlooking the town from above.",
      "sourceSentenceIds": [
        8,
        18
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Migdal_HaEmek"
    },
    {
      "id": 4,
      "text": "Three industrial parks in Migdal HaEmek host numerous Israeli and global high‑tech companies.",
      "sourceSentenceIds": [
        9,
