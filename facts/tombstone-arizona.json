      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Prospector Ed Schieffelin found silver in 1877, and after being warned he would only find a tombstone, he named the town Tombstone.",
      "sourceSentenceIds": [
        4,
        17
      ],
      "sourceLabels": [
