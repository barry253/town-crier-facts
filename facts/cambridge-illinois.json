  "facts": [
    {
      "id": 1,
      "text": "Cambridge was founded in 1843 when Reverend Ithamar Pillsbury deeded land to the town council, sparking its early growth.",
      "sourceSentenceIds": [
        22,
        21,
        18
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Cambridge%2C_Illinois",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The village’s name honors the 1846 Swedish Bishop Hill colony, led by Erik Janson, whose followers settled nearby.",
      "sourceSentenceIds": [
        5,
        28
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Cambridge%2C_Illinois",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The Cambridge Historical Society, founded in 1975, preserves local heritage and runs an extensive library of city history.",
      "sourceSentenceIds": [
        2,
        16
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://museumsdatabase.com/museums/view/9134",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Cambridge serves as Henry County’s seat and houses the historic courthouse where Erik Janson was murdered in 1850.",
      "sourceSentenceIds": [
        17,
        28
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Cambridge%2C_Illinois",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Construction began on June 9, 1843, after founders debated financing, and roads were laid to attract New England migrants.",
      "sourceSentenceIds": [
        22,
        23
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Cambridge%2C_Illinois",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Surrounded by natural beauty, Cambridge offers a warm, friendly atmosphere that blends old‑world charm with modern life.",
