  "facts": [
    {
      "id": 1,
      "text": "Inglenook sits atop a broad peninsula in Candlewood Lake, offering expansive water views and shaping its residential layout.",
      "sourceSentenceIds": [
        3,
        8
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Inglenook%2C_Connecticut"
    },
    {
      "id": 2,
      "text": "The community emerged after Candlewood Lake was created in 1926, when the state flooded 5,400 acres to build Connecticut's largest reservoir.",
      "sourceSentenceIds": [
        26
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/inglenook_connecticut"
    },
    {
      "id": 3,
      "text": "Inglenook's early settlers negotiated land purchases with Chief Squantz in 1724, finalizing a 31,000-acre tract in 1729 that became New Fairfield.",
      "sourceSentenceIds": [
        23
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/inglenook_connecticut"
    },
    {
      "id": 4,
      "text": "The area’s elevation rises to about 840 feet, giving it a commanding view of the lake’s shoreline and surrounding forests.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/inglenook_connecticut"
    },
    {
      "id": 5,
      "text": "Inglenook's climate is humid continental, with July highs around 81°F and January lows near 19°F, moderated by the lake.",
      "sourceSentenceIds": [
        10,
        11
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/inglenook_connecticut"
    },
    {
      "id": 6,
      "text": "The CDP’s geographic centroid lies at 41°31′23″N 73°28′24″W, placing it in northeastern New Fairfield near Candlewood Lake.",
