  "facts": [
    {
      "id": 1,
      "text": "Perkasie’s historic heart sits in the former Lehigh Valley Transit Trolley Station, now the Perkasie Historical Society Museum on 513 W. Street.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.perkasiehistory.org/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The South Perkasie Covered Bridge, listed on the National Register in 1980, still carries pedestrians across the creek just south of town.",
      "sourceSentenceIds": [
        17
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Perkasie%2C_Pennsylvania",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Between 1920 and 1950, a factory at 815 Chestnut Street stitched millions of Major League baseballs for Hubbert/Spalding.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Perkasie%2C_Pennsylvania",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Perkasie once thrived as a railroad hub; the North Penn line made it the third‑largest station on the route, boosting local trade.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://perkasieborough.org/information/about-us/history-of-perkasie/",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The town’s name honors its founder, John Perkas, who settled the area in the late 1700s and helped establish the first post office.",
      "sourceSentenceIds": [],
      "sourceLabels": [
        "Local source"
      ],
      "source": "local",
      "category": "people",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Perkasie’s annual carousel, a beloved landmark, opens each summer for community rides and historic reenactments.",
