  "facts": [
    {
      "id": 1,
      "text": "Farragut takes its name from Union Admiral David Farragut, who was born just east of the town in 1801.",
      "sourceSentenceIds": [
        3,
        6
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 2"
      ],
      "source": "https://en.wikipedia.org/wiki/Farragut%2C_Tennessee",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The 1810 Campbell's Station Inn, a brick landmark, still stands on Kingston Pike overlooking the Farragut Town Hall.",
      "sourceSentenceIds": [
        17
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Farragut%2C_Tennessee",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "On November 16, 1863, the Civil War Battle of Campbell's Station unfolded right in Farragut’s historic center.",
      "sourceSentenceIds": [
        18
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Farragut%2C_Tennessee",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Farragut became an incorporated town on January 16, 1980, after residents voted to avoid annexation by Knoxville.",
      "sourceSentenceIds": [
        26
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Farragut%2C_Tennessee",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The nearby village of Concord, founded in 1854, is listed on the National Register of Historic Places.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Farragut%2C_Tennessee",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Geographically, Farragut nestles between Blackoak Ridge to the north and the Tennessee River to the south.",
      "sourceSentenceIds": [
        28
