      "id": 1,
      "text": "Historic Sanborn Fire Insurance Maps of Wiconisco from 1890 to 1911 show downtown layout, businesses, and schools, preserving the town’s early architecture.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Web source 1"
      ],
