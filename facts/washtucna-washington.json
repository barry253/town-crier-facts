      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The Oregon Improvement Company finished the first rail line through Washtucna in 1886, hauling 30,000 bushels of wheat in its first five years.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Washtucna%2C_Washington",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Washtucna sits at the head of a deep coulee whose walls rise to 1,600 feet within a mile of town center.",
      "sourceSentenceIds": [
        16,
        18
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
