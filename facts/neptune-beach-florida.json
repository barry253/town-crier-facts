      "id": 1,
      "text": "Dan Wheeler built a train station near his home in 1922, naming it Neptune, and that station gave the town its name.",
      "sourceSentenceIds": [
        1,
        2
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
