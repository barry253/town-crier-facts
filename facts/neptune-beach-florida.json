      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Neptune Beach broke away from Jacksonville Beach in 1931 after a tax revolt, becoming an independent city.",
      "sourceSentenceIds": [
        5,
        26
      ],
      "sourceLabels": [
        "Web source 1",
        "Wikipedia"
      ],
      "source": "https://neptunebeachpreservation.org/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "City officials met in Wheeler’s train station until a new town hall opened in 1935, turning the old depot into the first municipal office.",
      "sourceSentenceIds": [
        14,
        17
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Neptune_Beach%2C_Florida",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The Cashen‑Bedell House and Pete’s Bar in Neptune Beach are both eligible for the National Register of Historic Places.",
      "sourceSentenceIds": [
        12,
        13
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://neptunebeachpreservation.org/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The Beaches Branch of the Jacksonville Public Library serves Neptune Beach, offering community resources right on the waterfront.",
      "sourceSentenceIds": [
        16
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Neptune_Beach%2C_Florida",
      "category": "landmark",
      "quality": "good"
    },
    {
