        2
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/%C3%81lvaro_Obreg%C3%B3n%2C_Mexico_City",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
