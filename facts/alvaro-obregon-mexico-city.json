  "facts": [
    {
      "id": 1,
      "text": "Álvaro Obregón borough takes its name from the revolutionary general who became president in 1920 and was later assassinated nearby.",
      "sourceSentenceIds": [
        1,
        5
      ],
      "sourceLabels": [
        "Web source 1",
        "Wikipedia"
      ],
      "source": "https://grokipedia.com/page/%C3%81lvaro_Obreg%C3%B3n,_Mexico_City",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The borough blends historic colonial enclaves like San Ángel and Chimalistac with modern residential developments.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/%C3%81lvaro_Obreg%C3%B3n,_Mexico_City",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Museo Casa Estudio de Diego Rivera y Frida Kahlo sits in the area, showcasing works by two of Mexico’s most celebrated artists.",
      "sourceSentenceIds": [
        13
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/%C3%81lvaro_Obreg%C3%B3n,_Mexico_City",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Before the Spanish, Tepanec peoples settled the valley in the 12th‑13th century, farming under Azcapotzalco’s rule.",
