  "facts": [
    {
      "id": 1,
      "text": "Jakin takes its name from a column of Solomon's temple, chosen by its first mayor, James Morris 'Major' Bivings.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Jakin%2C_Georgia",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "At its height, the town’s lumber mill employed roughly 1,000 workers, making it a bustling industrial hub.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Jakin%2C_Georgia",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "World War I and widespread deforestation closed the mill in 1918, ending Jakin’s primary industry.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Jakin%2C_Georgia",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Early settlers followed old Indian paths that evolved into the Old River Road, a post road by the 1820s.",
      "sourceSentenceIds": [
        16,
        17
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Jakin%2C_Georgia",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The nearby Chattahoochee River, just three miles west, ferried timber downstream to Apalachicola and cotton upstream to Columbus.",
      "sourceSentenceIds": [
        20
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Jakin%2C_Georgia",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "In 1898 the Flowers Company purchased the mill for $20,000, adding 160 acres and a railway to its assets.",
