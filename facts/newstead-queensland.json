      ],
      "source": "https://en.wikipedia.org/wiki/Newstead%2C_Queensland",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The suburb takes its name from that house, which was itself named after Newstead Abbey in England.",
      "sourceSentenceIds": [
