  "facts": [
    {
      "id": 1,
      "text": "Boerum Hill takes its name from the Boerum family’s colonial farm that once covered most of the area during early Dutch settlement.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Boerum_Hill",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "In 1973, the Boerum Hill Association’s long‑term advocacy led the Landmarks Preservation Commission to designate the neighborhood’s historic district.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Boerum_Hill",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "More than 250 19th‑century row houses, many Greek Revival and Italianate, line Boerum Hill’s streets, reflecting its 1845‑1890 development.",
      "sourceSentenceIds": [
        5,
        13
      ],
      "sourceLabels": [
        "Web source 1",
        "Web source 2"
      ],
      "source": "https://www.cityneighborhoods.nyc/boerum-hill",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Atlantic Avenue, a cultural corridor, hosts the long‑running Atlantic Antic festival and remains a hub for the neighborhood’s Arab‑American community.",
      "sourceSentenceIds": [
        23
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.cityneighborhoods.nyc/boerum-hill",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The Pacific branch of Brooklyn Public Library, opened in 1905, is Brooklyn’s oldest Carnegie library and sits at 25 Fourth Avenue.",
      "sourceSentenceIds": [
        20,
        21
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Boerum_Hill",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Spike Lee’s 1995 film Clockers, set in Boerum Hill, was filmed in the nearby Gowanus Houses, showcasing the area’s gritty streets.",
      "sourceSentenceIds": [
        18
