  "facts": [
    {
      "id": 1,
      "text": "Mineral Ridge earned its name from the valuable coal deposits that once lined the original town site.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Mineral_Ridge%2C_Ohio",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "In the mid‑1850s, John Lewis uncovered black‑band iron ore beneath the coal, sparking a boom of blast furnaces in nearby Brier Hill, Niles, and Mineral Ridge.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Mineral_Ridge%2C_Ohio",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The iron mined here, dubbed “American Scotch Pig” and “Warner’s Scotch Pig,” fed Youngstown’s burgeoning steel industry.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Mineral_Ridge%2C_Ohio",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "By the late 19th century the mining industry was largely in decline, and Mineral Ridge disincorporated in 1917.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Mineral_Ridge%2C_Ohio",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Some coal mines continued to operate into the Great Depression, keeping the town’s mining heritage alive.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Mineral_Ridge%2C_Ohio",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Today Mineral Ridge is a suburb of the Youngstown–Warren metropolitan area, reflecting its long‑standing ties to the region.",
      "sourceSentenceIds": [
        5,
        22
      ],
