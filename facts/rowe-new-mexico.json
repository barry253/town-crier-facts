  "facts": [
    {
      "id": 1,
      "text": "Rowe began as a railroad construction camp in 1876, later becoming a depot on the Atchison, Topeka and Santa Fe Railway.",
      "sourceSentenceIds": [
        5,
        10
      ],
      "sourceLabels": [
        "Web source 2",
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/rowe_new_mexico"
    },
    {
      "id": 2,
      "text": "Rowe lies on Interstate 25, about four miles south of Pecos Pueblo inside Pecos National Historical Park.",
      "sourceSentenceIds": [
        7,
        15
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 2"
      ],
      "source": "https://en.wikipedia.org/wiki/Rowe%2C_New_Mexico"
    },
    {
      "id": 3,
      "text": "The Rowe Pueblo Ruins, occupied from the 1240s to 1390s, display a multi‑plaza ancestral Puebloan layout.",
      "sourceSentenceIds": [
        12,
        18
      ],
      "sourceLabels": [
        "Web source 2",
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/rowe_new_mexico"
    },
    {
      "id": 4,
      "text": "Logging, mining support, and mercantile trade once powered Rowe’s economy, highlighted by the long‑running Gross, Kelly & Co. Store.",
      "sourceSentenceIds": [
        13,
        14
      ],
      "sourceLabels": [
        "Web source 2",
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/rowe_new_mexico"
    },
    {
      "id": 5,
      "text": "A historic pipeline once ran between Rowe and Las Ruedas to supply water for steam engines.",
