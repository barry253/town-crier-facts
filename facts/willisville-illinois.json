  "facts": [
    {
      "id": 1,
      "text": "Willisville began as a small rural settlement in the late 19th century, originally an agricultural outpost in southwestern Perry County.",
      "sourceSentenceIds": [
        26
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/willisville_illinois",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The village’s name comes from Dickie Willis, an early figure who helped develop the area.",
      "sourceSentenceIds": [
        29
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/willisville_illinois",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Early settlers favored wooded sections over open prairies, building family farms that grew corn, wheat, potatoes, and livestock.",
      "sourceSentenceIds": [
        24
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/willisville_illinois",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "By the early 1900s, Willisville had become a community hub, thanks to its strategic location near emerging railroad lines.",
      "sourceSentenceIds": [
        5,
        20
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/willisville_illinois",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The local economy today employs around 193 people, mostly in health care and social assistance, reflecting its role as a bedroom community near Pinckneyville.",
      "sourceSentenceIds": [
        22
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/willisville_illinois",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Willisville sits near the Kaskaskia River, exemplifying Midwestern small‑town life with an economy centered on agriculture, health care, and limited manufacturing.",
      "sourceSentenceIds": [
        19
      ],
