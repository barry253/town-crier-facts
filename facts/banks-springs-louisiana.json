  "facts": [
    {
      "id": 1,
      "text": "Banks Springs grew from a Caddo homeland to a 1719 pioneer settlement led by an Irish settler, before dispersing after the Natchez Massacre.",
      "sourceSentenceIds": [
        1,
        19
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/banks_springs_louisiana"
    },
    {
      "id": 2,
      "text": "Banks Springs likely takes its name from natural springs along the Ouachita River banks.",
      "sourceSentenceIds": [
        30
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/banks_springs_louisiana"
    },
    {
      "id": 3,
      "text": "Logging rail lines reached Banks Springs by 1910, linking the timber industry to Columbia and statewide markets.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/banks_springs_louisiana"
    },
    {
      "id": 4,
      "text": "The community sits about 203 feet above sea level, nestled between pine forests and fertile farmlands.",
      "sourceSentenceIds": [
        20
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/banks_springs_louisiana"
    },
    {
      "id": 5,
      "text": "Banks Springs enjoys a humid subtropical climate, with hot summers averaging 92°F in July and 58 inches of rain each year.",
      "sourceSentenceIds": [
        25,
        26,
        27
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/banks_springs_louisiana"
    },
    {
      "id": 6,
      "text": "In the 19th century, Banks Springs hosted one of Louisiana’s Rosenwald Schools, a historic effort to improve African‑American education.",
