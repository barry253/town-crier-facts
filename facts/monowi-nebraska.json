  "facts": [
    {
      "id": 1,
      "text": "Monowi was founded in 1902 when the Fremont, Elkhorn, and Missouri Valley Railroad extended to the area, turning a prairie spot into a bustling village.",
      "sourceSentenceIds": [
        1,
        10
      ],
      "sourceLabels": [
        "Web source 2",
        "Wikipedia"
      ],
      "source": "https://thesmartrver.com/monowi-nebraska/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Monowi’s name comes from a Native American word meaning “flower,” inspired by the wildflowers that once covered the prairie.",
      "sourceSentenceIds": [
        6,
        3
      ],
      "sourceLabels": [
        "Web source 1",
        "Wikipedia"
      ],
      "source": "https://wandermorepublishing.com/blog/monowi-nebraska",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Elsie Eiler, born in 1933, became Monowi’s sole resident after her husband Rudy died, keeping the tavern and library alive.",
      "sourceSentenceIds": [
        5,
        8
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 2"
      ],
      "source": "https://en.wikipedia.org/wiki/Monowi%2C_Nebraska",
      "category": "people",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Rudy’s Library, a small plywood shed, houses over 5,000 books donated in memory of Elsie’s late husband.",
      "sourceSentenceIds": [
        2,
        4
      ],
      "sourceLabels": [
        "Web source 2",
        "Wikipedia"
      ],
      "source": "https://thesmartrver.com/monowi-nebraska/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The Monowi Tavern, still operated by Elsie, serves cold beer and hearty burgers, and is famed for its “best ribeye in Nebraska.”.",
      "sourceSentenceIds": [
        11,
        25
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 2"
      ],
      "source": "https://en.wikipedia.org/wiki/Monowi%2C_Nebraska",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "In 1967 the town’s post office closed, marking the end of a service that had operated since Monowi’s founding.",
