  "facts": [
    {
      "id": 1,
      "text": "In the 1870s the Louis, Iron Mountain and Southern Railway built a line through the area, creating Grey's Station named after postmaster Lizzie Grey.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
