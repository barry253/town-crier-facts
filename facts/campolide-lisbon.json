  "facts": [
    {
      "id": 1,
      "text": "Campolide was once a rural village absorbed by Lisbon's expansion in the 19th century, known for its Quinta do Lambert, a historic estate that hosted Portuguese royalty.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.trawellino.com/destinations/portugal/lisbon_campolide"
    },
    {
      "id": 2,
      "text": "The 19th‑century Campolide Aqueduct, part of the larger Águas Livres Aqueduct system, still arches over the neighborhood.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.trawellino.com/destinations/portugal/lisbon_campolide"
    },
    {
      "id": 3,
      "text": "Rua Maria Pia, named after a Portuguese queen, is locally famous for its steep incline that even challenges Lisbon’s trams.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.trawellino.com/destinations/portugal/lisbon_campolide"
    },
    {
      "id": 4,
      "text": "Campolide was the site of a major battle on 5 September 1833 between Dom Miguel’s forces and those of Dom Pedro.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Campolide"
    },
    {
      "id": 5,
      "text": "Campolide became an official parish of Lisbon on 7 February 1959, marking its administrative integration.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Campolide"
    },
    {
      "id": 6,
      "text": "The Campolide railway station connects the area to the city center and beyond, making it a key public‑transport hub.",
      "sourceSentenceIds": [
