      "quality": "poor",
      "qualityReason": "location_description"
    },
    {
      "id": 2,
      "text": "The hamlet sits along the shore of Warner and Van Warmer Bays of Lake George, offering scenic waterfront views.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Kattskill_Bay%2C_New_York",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Historically, Kattskill Bay was part of the proposed East Lake George village, a plan that never materialized.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Kattskill_Bay%2C_New_York",
      "category": "history",
      "quality": "good"
    },
    {
