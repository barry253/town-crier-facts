  "facts": [
    {
      "id": 1,
      "text": "El Santuario de Chimayo is considered the most important Catholic pilgrimage center in the U.S. and is a National Historic Landmark since 1970.",
      "sourceSentenceIds": [
        1,
        15
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Chimayo%2C_New_Mexico",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town’s name comes from the Tewa word “Tsi Mayoh,” meaning “good flaking stone,” referencing a sacred hill behind the sanctuary.",
      "sourceSentenceIds": [
        5,
        6
      ],
      "sourceLabels": [
        "Web source 1",
        "Wikipedia"
      ],
      "source": "https://www.nps.gov/places/el-santuario-de-chimayo.htm",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The local community preserves its heritage through the Chimayó Cultural Preservation Association, which runs programs that engage visitors and residents in protecting the town’s history.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://chimayomuseum.org/",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The town’s heirloom chile, the Chimayo pepper, is a celebrated cultivar that has been cultivated for generations and is central to local cuisine.",
      "sourceSentenceIds": [
        28
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Chimayo%2C_New_Mexico",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The Chimayo Chile Project, started in 2005, replanted native seed stock and now distributes seeds to local farmers, supporting the region’s agricultural heritage.",
      "sourceSentenceIds": [
        29
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
