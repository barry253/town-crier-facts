  "facts": [
    {
      "id": 1,
      "text": "Lodi town was carved out of Covert in 1826 by New York legislature.",
      "sourceSentenceIds": [
        8,
        27
      ],
      "sourceLabels": [
        "Web source 1",
        "Wikipedia"
      ],
      "source": "https://www.wgpfoundation.org/historic-markers/town-of-lodi/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town’s post office began in 1820 as “De Mott’s Corners” before adopting Lodi in 1829.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Lodi%2C_New_York",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Queen’s Castle, the last standing building of suffragist Elizabeth Smith Miller’s summer camp Fossenvue, sits in Lodi and is on the National Register.",
      "sourceSentenceIds": [
        6,
        9
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Lodi%2C_New_York",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The Lehigh Valley Railroad once ran through Lodi, with its station demolished in 1956 and the final train passing midnight March 31, 1976.",
      "sourceSentenceIds": [
        2,
        12,
        13
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.wgpfoundation.org/historic-markers/town-of-lodi/",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Lodi Point was a 19th‑century steamboat stop on Seneca Lake, drawing lake travelers to the town.",
      "sourceSentenceIds": [
        29
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Lodi%2C_New_York",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The town’s name, like its sister town in New York, traces back to the Italian city of Lodi.",
      "sourceSentenceIds": [
        19
