  "facts": [
    {
      "id": 1,
      "text": "Topping is an unincorporated community in Middlesex County, Virginia, located along the Rappahannock River near Chesapeake Bay.",
      "sourceSentenceIds": [
        19,
        22,
        23
      ],
      "sourceLabels": [
        "Web source 1"
      ],
