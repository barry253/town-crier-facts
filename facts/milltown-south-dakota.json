  "facts": [
    {
      "id": 1,
      "text": "Milltown was named for the fact that many of its early residents milled their own supply of flour.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Milltown%2C_South_Dakota"
    },
    {
      "id": 2,
      "text": "Daniel Shearer established Milltown in 1873 along the banks of the James River, marking the first permanent settlement in the area.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/milltown_south_dakota"
    },
    {
      "id": 3,
      "text": "The Milltown Hutterite Colony was founded in 1886 and exemplified communal living until the group relocated to Canada in 1918.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/milltown_south_dakota"
    },
    {
      "id": 4,
      "text": "Abandoned Hutterite colony buildings in Milltown were added to the National Register of Historic Places in 1982 for their cultural significance.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/milltown_south_dakota"
    },
    {
      "id": 5,
      "text": "The United Brethren in Christ Church, constructed in 1880, stands as a key landmark of early heritage in Milltown.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/milltown_south_dakota"
    },
    {
      "id": 6,
      "text": "Milltown is now nearly a ghost town, with its quiet rural landscape contrasting a former dance pavilion along the James River.",
      "sourceSentenceIds": [
        27
