  "facts": [
    {
      "id": 1,
      "text": "Before European contact, the Houma people had already settled Dulac's bayous, and archaeological finds show human activity there for over a millennium.",
      "sourceSentenceIds": [
        1,
        5
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/dulac_louisiana",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Dulac's cultural heritage reflects Native American traditions tied to land and water, layered with French, Spanish, and Cajun influences.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/dulac_louisiana",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The Grand Caillou/Dulac Band of Biloxi‑Chitimacha‑Choctaw Indians, present since the mid‑1800s, remains unrecognized federally.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/dulac_louisiana",
      "category": "people",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Dulac’s economy hinges on commercial fishing, oystering, and shrimping, all threatened by coastal erosion and subsidence.",
      "sourceSentenceIds": [
        19
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/dulac_louisiana",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Dulac enjoys a humid subtropical climate, with hot, humid summers and mild winters, and receives about 60 inches of rain annually.",
      "sourceSentenceIds": [
