  "facts": [
    {
      "id": 1,
      "text": "Lake Poinsett is one of the largest natural lakes in South Dakota and was formed by glacial activity.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.lakepoinsett.org/lake-profile"
    },
    {
      "id": 2,
      "text": "Explorers Joseph Nicollet and John Fremont named Lake Poinsett after Joel Roberts Poinsett, who helped fund their 1838 expedition.",
      "sourceSentenceIds": [
        6,
        28,
        29
      ],
      "sourceLabels": [
        "Web source 1",
        "Web source 2"
      ],
      "source": "https://www.lakepoinsett.org/lake-profile"
    },
    {
      "id": 3,
      "text": "Lake Poinsett is part of a chain of connected lakes that eventually flows into the Big Sioux River.",
      "sourceSentenceIds": [
        11,
        18
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.lakepoinsett.org/lake-profile"
    },
    {
      "id": 4,
      "text": "A control structure was added to the Lake Poinsett outlet in 1989 to prevent high waters from the Big Sioux River from flowing back into the lake.",
      "sourceSentenceIds": [
        20,
        21
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.lakepoinsett.org/lake-profile"
    },
    {
      "id": 5,
      "text": "The Lake Poinsett Visitor Center and Museum features exhibits that cover the history of the area from prehistoric days to the late 1990s.",
      "sourceSentenceIds": [
        3,
        4
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://gfp.sd.gov/parks/detail/lake-poinsett-recreation-area/"
    },
    {
      "id": 6,
      "text": "Lake Poinsett has a surface area of nearly eight thousand acres and a maximum depth of twenty-two feet.",
