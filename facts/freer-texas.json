  "facts": [
    {
      "id": 1,
      "text": "Freer began as a ranching spot called Las Hermanitas, meaning “the Sisters,” before becoming known as Government Wells after a U.S. Cavalry water well was dug there in 1876.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.tshaonline.org/handbook/entries/freer-tx",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "In 1913, a local woman sold twenty sections of land—including the future townsite—to a Houston real‑estate promoter, setting the stage for Freer's growth.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.tshaonline.org/handbook/entries/freer-tx",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The town’s first newspaper, the Freer Enterprise, started in 1913 and ran until 1972, while the first chamber of commerce was founded in 1934.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.tshaonline.org/handbook/entries/freer-tx",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The single most important event in Freer’s history happened in 1928, three years after the town’s founding.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.tshaonline.org/handbook/entries/freer-tx",
      "category": "other",
      "quality": "poor",
      "qualityReason": "other"
    },
    {
      "id": 5,
      "text": "Freer sits at the crossroads of U.S. Highway 59, where the road runs east–west through the city as Riley Street.",
      "sourceSentenceIds": [
        11
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Freer%2C_Texas",
      "category": "other",
      "quality": "poor",
      "qualityReason": "location_description"
    },
    {
      "id": 6,
      "text": "The climate in Freer features hot, humid summers and generally mild to cool winters, typical of northwestern Texas.",
