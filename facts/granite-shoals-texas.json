  "facts": [
    {
      "id": 1,
      "text": "Granite Shoals earned its name from granite shoals—shallow river areas formed by granite outcroppings—on the Colorado River before Wirtz Dam was built.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.graniteshoals.org/163/History-of-Granite-Shoals"
    },
    {
      "id": 2,
      "text": "The granite that shapes the town comes in hues known as Texas Pink and Texas Pink Pearl.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.graniteshoals.org/163/History-of-Granite-Shoals"
    },
    {
      "id": 3,
      "text": "Granite Shoals became an incorporated city in 1966 after a local vote.",
      "sourceSentenceIds": [
        19
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Granite_Shoals%2C_Texas"
    },
    {
      "id": 4,
      "text": "Granite mining drives the local economy, and the city boasts 18 parks, 14 of which sit on Lake Lyndon B.",
      "sourceSentenceIds": [
        23
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Granite_Shoals%2C_Texas"
    },
    {
      "id": 5,
      "text": "Quarry Park, the municipal complex, offers tennis courts, a baseball field, batting cages, and a multi‑sports arena.",
