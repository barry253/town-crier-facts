      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The Gum Springs Black History Museum, run by the Gum Springs Historical Society, preserves the legacy of Fairfax County’s oldest African‑American community.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 1"
      ],
