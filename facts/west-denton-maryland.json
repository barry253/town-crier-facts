  "facts": [
    {
      "id": 1,
      "text": "West Denton grew from a 1774 land patent called Harford Town, intended to rival Denton as county seat.",
      "sourceSentenceIds": [
        15,
        13,
        16,
        18
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://carolinehistory.org/crh-inventory/upper-sites/west-denton/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The community’s waterfront became a bustling maritime hub by the early 1800s, with wharves, granaries, and a store by 1811.",
      "sourceSentenceIds": [
        19,
        22
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://carolinehistory.org/crh-inventory/upper-sites/west-denton/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "West Denton’s shipyards built several schooners and sloops, including the sloop President, visible on an 1841 deed.",
      "sourceSentenceIds": [
        25,
        28
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://carolinehistory.org/crh-inventory/upper-sites/west-denton/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The West Denton Warehouse‑Wharf and Neck Meetinghouse are listed on the National Register of Historic Places.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/West_Denton%2C_Maryland",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "A ferry linked Market Street to West Denton in 1807, before the first movable bridge appeared in 1811.",
      "sourceSentenceIds": [
        20,
        21,
        23
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://carolinehistory.org/crh-inventory/upper-sites/west-denton/",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "West Denton hosted two major cannery operations, one with a tin‑can factory, and a flour‑rolling mill, serving Chesapeake Bay freight.",
      "sourceSentenceIds": [
        1,
        2
