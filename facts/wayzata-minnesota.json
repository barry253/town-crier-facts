  "facts": [
    {
      "id": 1,
      "text": "The name Wayzata (pronounced Wise‑etta) is derived from the American Indian word Waziyata, which had almost a mystical connotation to the Sioux tribes who originally inhabited the area.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.wayzata.org/325/About-Wayzata",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "In 1867 the Saint Paul and Pacific Railroad extended its tracks to Wayzata, making it the area's transportation hub.",
      "sourceSentenceIds": [
        17
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Wayzata%2C_Minnesota",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "In 1855, Wayzata saw an influx of settlers who built a sawmill, a hotel, and a blacksmith shop.",
      "sourceSentenceIds": [
        15
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.wayzatahistoricalsociety.org/resources/history/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Careful planning has allowed the City to maintain open space, park lands and a \"small town\" feel that makes Wayzata truly a special and historic community.",
      "sourceSentenceIds": [
        22
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.wayzata.org/325/About-Wayzata",
      "category": "other",
