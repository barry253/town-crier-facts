  "facts": [
    {
      "id": 1,
      "text": "Bauxite is named after the rich deposits of bauxite ore that were discovered here in the late 19th century.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
