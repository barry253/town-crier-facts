  "facts": [
    {
      "id": 1,
      "text": "Newtown originated as a late colonial crossroads on the Great Post Road between Williamsburg and Philadelphia.",
      "sourceSentenceIds": [
        5,
        30
      ],
      "sourceLabels": [
        "Web source 1",
        "Web source 2"
      ],
      "source": "https://www.dhr.virginia.gov/historic-registers/049-0145/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town’s prosperity in the antebellum era made it the largest post village in King & Queen County.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.dhr.virginia.gov/historic-registers/049-0145/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "During the Civil War, both Union and Confederate troops maneuvered through Newtown’s streets.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.dhr.virginia.gov/historic-registers/049-0145/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The Lee-Boulware House, visible at the crossroads, later housed Dr. Thomas Bates who cared for Confederate wounded.",
      "sourceSentenceIds": [
        10,
        11
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.dhr.virginia.gov/historic-registers/049-0145/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Newtown’s historic district includes six Federal‑period frame houses, each two stories on high brick basements.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.dhr.virginia.gov/historic-registers/049-0145/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Most homes line Route 721’s north side, built on raised brick basements, reflecting 19th‑century farm architecture.",
      "sourceSentenceIds": [
        22,
        25
      ],
