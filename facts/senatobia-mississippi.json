  "facts": [
    {
      "id": 1,
      "text": "Senatobia began in 1834 when James Peters bought two sections of Chickasaw land for just $1.25 an acre.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://cityofsenatobiams.gov/about-senatobia/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town’s name comes from the Chickasaw word Senatohoba, meaning 'White Sycamore,' a symbol of rest for the weary.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://cityofsenatobiams.gov/about-senatobia/",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "When the Tennessee and Mississippi Railroad crossed Senatobia in 1856, the town instantly became a bustling rail station.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://cityofsenatobiams.gov/about-senatobia/",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Senatobia became the county seat of newly formed Tate County in 1873, during the Reconstruction era.",
      "sourceSentenceIds": [
        23
      ],
