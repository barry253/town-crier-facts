  "facts": [
    {
      "id": 1,
      "text": "Founded in 1843, the town is a historic riverboat stop because of its proximity right along the Mississippi River.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.islands.com/1938468/louisiana-historic-riverboat-st-joseph-charming-town-edge-state-park/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The downtown area along Plank Road is listed on the National Register of Historic Places.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/St._Joseph%2C_Louisiana",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The Tensas Parish Library and Plantation Museum is a still‑standing 19th‑century building where visitors learn about the town’s early years and see period artifacts.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.islands.com/1938468/louisiana-historic-riverboat-st-joseph-charming-town-edge-state-park/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Joseph was established around 1813 at what was then called John Densmore's Landing.",
      "sourceSentenceIds": [
        14
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/St._Joseph%2C_Louisiana",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Joseph was planned in 1843 by European‑American settlers around a New England–style village green and the surrounding area grew into cotton plantations.",
      "sourceSentenceIds": [
        16,
        17
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/St._Joseph%2C_Louisiana",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The town hosts down‑home blues music, with local restaurants often booking blues bands for performances.",
