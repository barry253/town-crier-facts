  "facts": [
    {
      "id": 1,
      "text": "Waynesville takes its name from General “Mad” Anthony Wayne, a Revolutionary War hero.",
      "sourceSentenceIds": [
        1,
        2
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Waynesville%2C_Ohio",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Samuel Heighway founded the village in 1797, hoping it would become the Northwest Territory’s capital.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.villageofwaynesville.org/welcome/village-history/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Waynesville grew into one of Southern Ohio’s most historically unique tourist spots, according to local history.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.villageofwaynesville.org/welcome/village-history/",
      "category": "other",
      "quality": "poor",
      "qualityReason": "editorial_filler"
    },
    {
      "id": 4,
      "text": "The village is famed for its antique shops and its annual Sauerkraut Festival, held every fall since 1970.",
      "sourceSentenceIds": [
        11,
        30
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Waynesville%2C_Ohio",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The Little Miami River, the only river flowing through Waynesville, winds past its historic downtown.",
      "sourceSentenceIds": [
        14
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Waynesville%2C_Ohio",
      "category": "nature",
      "quality": "good"
    },
    {
