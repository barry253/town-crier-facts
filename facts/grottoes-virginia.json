  "facts": [
    {
      "id": 1,
      "text": "Grottoes is home to Grand Caverns, the oldest show cave in the United States, first opened for tours in 1806.",
      "sourceSentenceIds": [
        16
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Grottoes%2C_Virginia",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Grand Caverns earned National Natural Landmark status in 1973, recognizing its unique geological formations and deep historical significance.",
      "sourceSentenceIds": [
        4,
        10
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 2"
      ],
      "source": "https://en.wikipedia.org/wiki/Grottoes%2C_Virginia",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The town’s original name, Shendun, combined “Shenandoah” with the Gaelic word for castle, reflecting early settlers’ hopes in 1892.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Grottoes%2C_Virginia",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Grottoes sits between the South Fork of the Shenandoah River and Brown's Gap, a spot that historically linked travelers to nearby valleys.",
      "sourceSentenceIds": [
        20
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Grottoes%2C_Virginia",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The town straddles Rockingham and Augusta counties, placing it within the heart of Virginia’s Shenandoah Valley.",
