  "facts": [
    {
      "id": 1,
      "text": "Wauregan’s name comes from a Mohegan word meaning 'Pleasant Valley' and the town grew into a bustling industrial village.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Wauregan%2C_Connecticut",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "A railroad station opened in 1859, followed by a post office the next year in 1860.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Wauregan%2C_Connecticut",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Wauregan began as a cotton mill village powered by the Quinebaug River.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Wauregan%2C_Connecticut",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Atwood expanded the mill, adding a south block in 1859 and a rear block in 1867–68.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Wauregan%2C_Connecticut",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "A 90‑acre historic district encompassing mill‑related structures was listed on the National Register in 1979.",
      "sourceSentenceIds": [
        18,
        19
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Wauregan%2C_Connecticut",
      "category": "landmark",
      "quality": "good"
    },
    {
