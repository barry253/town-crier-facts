  "facts": [
    {
      "id": 1,
      "text": "Riparius began as Folsom Landing, named for Jonathan Folsom who owned land on both sides of the Hudson River.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.adktaste.com/blog/riparius-on-the-hudson",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "In 1870 the Adirondack Railway built a stop called Riverside, later renamed Riparius to avoid confusion with other places of the same name.",
      "sourceSentenceIds": [
        11,
        15
      ],
      "sourceLabels": [
        "Web source 1",
        "Wikipedia"
      ],
      "source": "https://www.adktaste.com/blog/riparius-on-the-hudson",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The 1872 Folsom Landing Central Bridge, a one‑lane suspension bridge, once charged three cents for a pedestrian crossing.",
      "sourceSentenceIds": [
        12,
        30
      ],
      "sourceLabels": [
        "Web source 1",
        "Web source 1"
      ],
      "source": "https://www.adktaste.com/blog/riparius-on-the-hudson",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Riparius station was added to the National Register of Historic Places in 1997.",
