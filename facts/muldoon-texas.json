  "facts": [
    {
      "id": 1,
      "text": "Muldoon takes its name from Father Michael Muldoon, the Irish clergyman who served Stephen F. Austin in the early 1830s.",
      "sourceSentenceIds": [
        3,
        7,
        8
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1",
        "Web source 2"
      ],
      "source": "https://en.wikipedia.org/wiki/Muldoon%2C_Texas",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town’s historic Kerr Store, built in 1890, still stands on FM 154 beside a former blacksmith shop and other early buildings.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Muldoon%2C_Texas",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Muldoon’s railroad heyday began in the early 1900s when the San Antonio and Aransas Pass tracks ran along what later became FM 154, bringing regular passenger traffic to the town.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Muldoon%2C_Texas",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The old Muldoon train station was abandoned in the 1950s after the Dinky, a small passenger train from Flatonia, stopped running.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Muldoon%2C_Texas",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The town sits at the junction of FM 154 and FM 2237, a crossroads that has defined its layout since its founding.",
      "sourceSentenceIds": [
        27
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Muldoon%2C_Texas",
      "category": "other",
      "quality": "poor",
      "qualityReason": "other"
    },
    {
      "id": 6,
      "text": "Muldoon occupies land originally granted in 1831 to Father Michael Muldoon, the curate who helped Stephen F. Austin in Texas history.",
