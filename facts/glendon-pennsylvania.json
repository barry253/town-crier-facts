  "facts": [
    {
      "id": 1,
      "text": "Glendon sprang up in 1867 to support the Glendon Iron Works on the Lehigh River, attracting Welsh and Irish laborers.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/glendon_pennsylvania"
    },
    {
      "id": 2,
      "text": "The borough officially incorporated on December 18, 1867, after the iron works spurred rapid growth.",
      "sourceSentenceIds": [
        3,
        4
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/glendon_pennsylvania"
    },
    {
      "id": 3,
      "text": "A 1973 dig at the old iron works uncovered furnace foundations and steam valves now displayed in Hugh Moore Park.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/glendon_pennsylvania"
    },
    {
      "id": 4,
      "text": "Glendon once ran three schools; the last one was converted into the current Borough Hall after merging with Wilson Area School District.",
      "sourceSentenceIds": [
        30
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/glendon_pennsylvania"
    },
    {
      "id": 5,
      "text": "By 1920 the Lehigh Valley Railroad had built a station in Glendon, linking the town to regional iron transport.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/glendon_pennsylvania"
    },
    {
      "id": 6,
      "text": "Joseph Morrison, an Irish immigrant, became Glendon's first Chief Burgess and helped fund the historic Keystone Furnace.",
