  "facts": [
    {
      "id": 1,
      "text": "Founded in 1948 as a daughter colony from New Rockport Hutterite Colony near New Dayton, Alberta, New Rockport Colony began its Montana chapter.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/new_rockport_colony_montana",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "New Rockport Colony has spawned daughter settlements, including Glendale (1969), Pleasant Valley (1989), and Meadow Lane (2020), expanding its communal reach.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/new_rockport_colony_montana",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Perched on a bluff, New Rockport Colony overlooks the Teton River to the southeast and Spring Coulee to the northeast.",
      "sourceSentenceIds": [
        13
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/New_Rockport_Colony%2C_Montana",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "With about 50 Hutterite colonies in Montana, New Rockport stands as a key example of post‑World War II expansion.",
      "sourceSentenceIds": [
        14
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/new_rockport_colony_montana",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The colony’s economy centers on agriculture, raising livestock such as sheep and contributing to Montana’s hog, egg, and dairy output.",
      "sourceSentenceIds": [
        15
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/new_rockport_colony_montana",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Early organization followed traditional Hutterite practices, with ministers from the Alberta mother community guiding the new Montana settlement.",
      "sourceSentenceIds": [
        11
