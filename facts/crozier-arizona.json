    {
      "id": 2,
      "text": "The name 'Hualapai' means 'People of the Tall Pines' and the tribe was established by executive order in 1883.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://hualapai-nsn.gov/community/about_the_hualapai_tribe/index.php"
    },
    {
      "id": 3,
      "text": "The Hualapai reservation spans about one million acres along 108 miles of the Grand Canyon and Colorado River.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://hualapai-nsn.gov/community/about_the_hualapai_tribe/index.php"
    },
    {
      "id": 4,
      "text": "Elevations on the reservation range from 1,500 feet at the Colorado River to over 7,300 feet at the Aubrey Cliffs.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://hualapai-nsn.gov/community/about_the_hualapai_tribe/index.php"
    },
    {
      "id": 5,
      "text": "The reservation’s economy relies on tourism, cattle ranching, and arts and crafts, with guided big‑game hunting permits for desert bighorn sheep and mountain lion.",
      "sourceSentenceIds": [
        16,
        18
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://hualapai-nsn.gov/community/about_the_hualapai_tribe/index.php"
    },
    {
      "id": 6,
      "text": "Grand Canyon West, a tribal enterprise, sits on the Hualapai reservation at the west rim of the Grand Canyon.",
