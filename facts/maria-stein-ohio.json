  "facts": [
    {
      "id": 1,
      "text": "Maria Stein grew around a railroad station called \"Station\" when the Cincinnati, Hamilton, and Dayton Railway extended through Mercer County.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
