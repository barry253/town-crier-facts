      "id": 1,
      "text": "Maloy was renamed in honor of landowner David Maloy, who owned land five miles south of the town.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://iagenweb.org/ringgold/history/maloy/hist_maloy.html",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town was platted in 1887, the same year the railroad arrived, sparking its growth.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://iagenweb.org/ringgold/history/maloy/hist_maloy.html",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Locals once called the town Foxtown after a large red fox painted on a storefront.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://iagenweb.org/ringgold/history/maloy/hist_maloy.html",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The Little Platte River winds past the west side of Maloy, shaping its landscape.",
