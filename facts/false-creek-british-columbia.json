  "facts": [
    {
      "id": 1,
      "text": "False Creek was originally a canal and mudflat used for shellfish farming and hosted the Squamish village Sen̓áḵw.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 1"
      ],
