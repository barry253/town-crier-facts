  "facts": [
    {
      "id": 1,
      "text": "Upper Fairmount is an unincorporated community in Somerset County, Maryland, located at the intersection of MD Route 361 and Upper Hill Road.",
      "sourceSentenceIds": [
        2,
        3
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Upper_Fairmount%2C_Maryland",
      "category": "other",
      "quality": "poor",
      "qualityReason": "location_description"
    },
    {
      "id": 2,
      "text": "The village sits on Fairmount Peninsula, where Fairmount Road arcs through a quiet rural setting surrounded by farms and wooded land.",
      "sourceSentenceIds": [
        5,
        7,
        8
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://apps.mht.maryland.gov/nr/NRDetail.aspx?NRID=1113",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Upper Fairmount Historic District, listed in 1993, preserves homes built from the early 19th to early 20th centuries, including the turn‑of‑century Cook House.",
      "sourceSentenceIds": [
        4,
        5,
        11
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Upper_Fairmount%2C_Maryland",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The 1870 Gothic Revival Upper Fairmount Methodist Church, with pressed‑tin interior, replaced an earlier Greek Revival building and remains a landmark.",
      "sourceSentenceIds": [
        15,
        16,
        17,
        18
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://apps.mht.maryland.gov/nr/NRDetail.aspx?NRID=1113",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Cecil Ford’s store, the last surviving mercantile in town, stands beside a handful of grave markers that hint at the village’s first Methodist Church site.",
      "sourceSentenceIds": [
        19,
        21
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://apps.mht.maryland.gov/nr/NRDetail.aspx?NRID=1113",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The village’s growth peaked between 1890 and 1920, after which a slow decline preserved its 19th‑century character.",
      "sourceSentenceIds": [
