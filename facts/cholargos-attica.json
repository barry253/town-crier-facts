      "quality": "poor",
      "qualityReason": "location_description"
    },
    {
      "id": 2,
      "text": "The town’s name comes from an ancient deme of Attica, though the modern Cholargos lies far from the original site near Ilion.",
      "sourceSentenceIds": [
        26,
        30
      ],
      "sourceLabels": [
