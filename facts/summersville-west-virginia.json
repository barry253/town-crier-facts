  "facts": [
    {
      "id": 1,
      "text": "Summersville was laid out in 1824 and named for Judge Lewis Summers, who introduced the bill that created Nicholas County.",
      "sourceSentenceIds": [
        1,
        2,
        4
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1",
        "Web source 2"
      ],
