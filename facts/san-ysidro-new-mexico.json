  "facts": [
    {
      "id": 1,
      "text": "San Ysidro was founded in 1699 by Juan Trujillo and named after Saint Isidore the Farmer, the 11th‑century patron saint of farmers.",
      "sourceSentenceIds": [
        2,
        3
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 2"
      ],
      "source": "https://en.wikipedia.org/wiki/San_Ysidro%2C_Sandoval_County%2C_New_Mexico",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "San Ysidro is the oldest existing settlement in the area, following the pattern of Spanish villages across New Mexico.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.sanysidronm.gov/215/History-of-San-Ysidro",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "A railroad spur from Bernalillo reached San Ysidro in 1924, but the line was abandoned in 1941 after the company went broke.",
      "sourceSentenceIds": [
        10,
        11
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.sanysidronm.gov/215/History-of-San-Ysidro",
      "category": "transport",
      "quality": "poor",
      "qualityReason": "route_only"
    },
    {
      "id": 4,
      "text": "The Jemez River flows through San Ysidro, just north of where it meets the Rio Salado.",
      "sourceSentenceIds": [
        15
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/San_Ysidro%2C_Sandoval_County%2C_New_Mexico",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Every mid‑May, San Ysidro hosts its annual Fiesta Day, celebrating local traditions and community spirit.",
      "sourceSentenceIds": [
        17
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/San_Ysidro%2C_Sandoval_County%2C_New_Mexico",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Early explorers from San Ysidro produced the first written description of Chaco Canyon, naming major ruins like Pueblo Bonito and Casa Rinconada.",
