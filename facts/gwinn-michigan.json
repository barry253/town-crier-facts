      "quality": "good"
    },
    {
      "id": 2,
      "text": "Cleveland‑Cliffs opened the Gwinn Mine in 1905, then broke ground for the first houses in 1907.",
      "sourceSentenceIds": [
        9,
        12
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Gwinn%2C_Michigan",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "In 1906, Cleveland‑Cliffs hired Boston landscape designer Warren H. Manning to plan a town that preserved trees.",
      "sourceSentenceIds": [
        10,
