  "facts": [
    {
      "id": 1,
      "text": "Gordon Park was named after General Gordon, the celebrated hero of the 1880s Khartoum siege.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Gordon_Park%2C_Queensland",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Most streets in the suburb—Gordon, Khartoum, and Baker—pay tribute to General Gordon and his army.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Gordon_Park%2C_Queensland",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "A Methodist church site on Beaconsfield Terrace was dedicated in 1929, marking the area’s early religious roots.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Gordon_Park%2C_Queensland",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The Gordon Park Baptist Church began as a 1926 tent mission on Khartoum Street and moved to a permanent building in 1977.",
      "sourceSentenceIds": [
        28,
        30
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Gordon_Park%2C_Queensland",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The original Gordon Park Estate auctioned 264 blocks in 1886, laying out the suburb’s early layout.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Gordon_Park%2C_Queensland",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Gordon Park sits just 5.4 km north of Brisbane’s CBD, bordered by Kedron Brook and Stafford Road.",
      "sourceSentenceIds": [
