      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Lehi hosts the historic Lehi Roller Mills, founded in 1906 by a cooperative of farmers.",
      "sourceSentenceIds": [
        13
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Lehi%2C_Utah",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Thanksgiving Point, a nonprofit museum complex and estate garden, was founded in 1995 and is a cultural landmark in Lehi.",
      "sourceSentenceIds": [
