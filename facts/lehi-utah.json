      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The Lehi Historical Society collects and preserves artifacts such as scrapbooks, ledgers, and photographs to document Lehi’s impact on the American West.",
      "sourceSentenceIds": [
        6,
        9
      ],
      "sourceLabels": [
        "Web source 2",
        "Web source 2"
      ],
