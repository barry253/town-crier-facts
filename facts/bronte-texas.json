  "facts": [
    {
      "id": 1,
      "text": "Bronte, Texas, is named after novelist Charlotte Brontë and is pronounced “brahnt” with one syllable.",
      "sourceSentenceIds": [
        2,
        3
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Bronte%2C_Texas",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "In 1907 the Kansas City, Mexico and Orient Railway ran through the area, so Bronte was moved a mile to sit beside the tracks.",
      "sourceSentenceIds": [
        11,
        16
      ],
      "sourceLabels": [
        "Web source 1",
        "Web source 2"
      ],
      "source": "https://www.brontetexas.org/history",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "A historic marker near US 277 and SH 70 notes Bronte’s role on the Butterfield Overland Stage Route, a key 19th‑century mail line.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.brontetexas.org/history",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Bronte’s welcome sign proclaims, “A town modern enough to keep up with the times, and classic enough to still value manners, hard work, and dedication.”.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.brontetexas.org/history",
      "category": "culture",
      "quality": "poor",
      "qualityReason": "editorial_filler"
    },
    {
      "id": 5,
      "text": "The First Methodist Church of Bronte traces its roots to a small group of worshipers in summer 1890, later becoming the First United Methodist Church in 1968.",
      "sourceSentenceIds": [
        12
