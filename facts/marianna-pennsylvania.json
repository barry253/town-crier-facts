  "facts": [
    {
      "id": 1,
      "text": "Marianna was founded as a mining town for the Pittsburgh Buffalo Company in 1907 and officially incorporated in 1910.",
      "sourceSentenceIds": [
        4,
        11
      ],
      "sourceLabels": [
        "Web source 1",
        "Wikipedia"
      ],
      "source": "https://www.mariannapa.org/History",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The borough’s name honors Mary Ann Feehan Jones, the wife of David G. Jones, who helped establish the town.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.mariannapa.org/History",
      "category": "people",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Ten Mile Creek runs beneath Marianna, with the town perched on a hillside that rises 240 feet above the riverbank.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.mariannapa.org/History",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "On November 28, 1908, a mine explosion claimed 154 lives, leaving only one survivor in Marianna’s most tragic industrial disaster.",
      "sourceSentenceIds": [
        14
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Marianna%2C_Pennsylvania",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Marianna’s historic district earned a spot on the National Register of Historic Places in 1984, preserving its early 20th‑century mining heritage.",
      "sourceSentenceIds": [
        18
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Marianna%2C_Pennsylvania",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The last coal extraction in Marianna ended in 1988 when a fire broke out on the main conveyor, prompting the mine’s permanent closure.",
      "sourceSentenceIds": [
        16,
        17
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
