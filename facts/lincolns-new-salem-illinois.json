  "facts": [
    {
      "id": 1,
      "text": "New Salem was founded in 1829 when James Rutledge and John Camron built a gristmill on the Sangamon River.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Lincoln's_New_Salem",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Abraham Lincoln lived in New Salem from 1831 to 1837, working as a shopkeeper, soldier, and postmaster.",
      "sourceSentenceIds": [
        3,
        28
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Lincoln's_New_Salem",
      "category": "people",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The Civilian Conservation Corps rebuilt New Salem in the 1930s, creating 23 log buildings that now serve as costumed interpreters.",
      "sourceSentenceIds": [
        5,
        6
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Lincoln's_New_Salem",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The historic site’s visitor center features a TimeWalk exhibit that lets guests experience artifacts from the original saw and grist mill.",
      "sourceSentenceIds": [
        13
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.visitmenardcounty.com/new-salem",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "New Salem sits 15 miles northwest of Springfield and just 3 miles south of Petersburg, placing it in the heart of Illinois’ frontier.",
