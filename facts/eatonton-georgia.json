  "facts": [
    {
      "id": 1,
      "text": "Eatonton was founded in 1807 as the seat of newly formed Putnam County.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Eatonton%2C_Georgia"
    },
    {
      "id": 2,
      "text": "The town was named after William Eaton, an officer involved in the First Barbary War.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Eatonton%2C_Georgia"
    },
    {
      "id": 3,
      "text": "During Sherman's March to the Sea, Union troops passed through Eatonton, targeting the local manufacturing and cotton factories.",
      "sourceSentenceIds": [
        11
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://visiteatonton.com/history-heritage-2/"
    },
    {
      "id": 4,
      "text": "A 19th‑century New York banker, Benjamin Hunt, moved to Eatonton in 1876 and established Panola Farm with fifteen dairy cows.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Eatonton%2C_Georgia"
    },
    {
      "id": 5,
      "text": "The Eatonton Co‑Operative Creamery, founded in 1909, helped make the town a regional dairy hub.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Eatonton%2C_Georgia"
    },
    {
      "id": 6,
      "text": "The ancient Rock Eagle Effigy, a stone mound built by Native Americans, sits near Eatonton and offers a glimpse into prehistoric Georgia.",
