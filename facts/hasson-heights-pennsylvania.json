  "facts": [
    {
      "id": 1,
      "text": "Hasson Heights sits atop the hills above Oil City’s North Side, overlooking the Allegheny River.",
      "sourceSentenceIds": [
        26,
        27
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Hasson_Heights%2C_Pennsylvania"
    },
    {
      "id": 2,
      "text": "The Westmoreland Historical Society’s headquarters are in Hasson Heights, housed within historic Hanna’s Town.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://westmorelandhistory.org/"
    },
    {
      "id": 3,
      "text": "Hanna’s Town features a reconstructed tavern, three log houses, a Revolutionary War fort, and a Conestoga wagon.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://westmorelandhistory.org/"
    },
    {
      "id": 4,
      "text": "During winter, the Society’s Exhibit Gallery, Research Library, and Museum Shop stay open from 10 am to 4 pm.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://westmorelandhistory.org/"
    },
    {
      "id": 5,
      "text": "The Society hosts hands‑on workshops, such as a basic accessories class featuring 18th‑century costumes by Penny River.",
      "sourceSentenceIds": [
        18
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://westmorelandhistory.org/"
    },
    {
      "id": 6,
      "text": "In Hasson Heights, sunrise is at 7:36 am and sunset at 8:26 pm, giving a 12‑hour 50‑minute day.",
      "sourceSentenceIds": [
        20
      ],
