  "facts": [
    {
      "id": 1,
      "text": "Parker School got its name from John B. Parker, after whom the community and school were named.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/parker_school_montana"
    },
    {
      "id": 2,
      "text": "The Rocky Boy's Indian Reservation, where Parker School sits, was created in 1916 from former Fort Assiniboine military lands.",
      "sourceSentenceIds": [
        21
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/parker_school_montana"
    },
    {
      "id": 3,
      "text": "Parker School sits at about 4,078 feet above sea level, roughly at 48°14′53″N 109°44′32″W.",
      "sourceSentenceIds": [
        16
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/parker_school_montana"
    },
    {
      "id": 4,
      "text": "The first Parker Day School opened in 1928 as a one‑room tarpaper shack, then grew into a two‑teacher building by 1930.",
      "sourceSentenceIds": [
        22,
        23
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/parker_school_montana"
    },
    {
      "id": 5,
      "text": "Agriculture drives Parker School’s economy, with ranching and crop farming adapted to Montana’s semi‑arid climate.",
      "sourceSentenceIds": [
        19
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/parker_school_montana"
    },
    {
      "id": 6,
      "text": "Being on the reservation, Parker School fosters cultural exchanges and joint projects between Chippewa and Cree communities.",
      "sourceSentenceIds": [
        20
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/parker_school_montana"
    }
  ]
