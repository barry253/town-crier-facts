  "facts": [
    {
      "id": 1,
      "text": "Goodwine was platted in 1882 when a Chicago and Eastern Illinois Railroad branch reached the town, sparking its growth.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/goodwine_illinois",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town’s namesake, William “Bill” Goodwine, donated the site and land for a Methodist church built the same year, still standing today.",
      "sourceSentenceIds": [
        3,
        4
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/goodwine_illinois",
      "category": "people",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "An active Union Pacific north‑south line still runs through Goodwine, while an abandoned east‑west Chicago and Eastern Illinois line once crossed the town.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/goodwine_illinois",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Fountain Creek skirts the west of Goodwine, flowing northeast to join Mud Creek and feeding the Iroquois River watershed.",
      "sourceSentenceIds": [
        5,
        15
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Goodwine%2C_Illinois",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Goodwine’s economy has long centered on dairy, beef, hogs, sheep, and grain, thanks to historic drainage that turned swampland into fertile fields.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/goodwine_illinois",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The community never incorporated but built key institutions like the 1882 Goodwine Methodist Church and a one‑room schoolhouse that operated until 1960.",
