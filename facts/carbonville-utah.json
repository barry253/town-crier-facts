  "facts": [
    {
      "id": 1,
      "text": "Caleb Rhoades founded Carbonville in 1877 by constructing a dugout structure in the Price River Valley.",
      "sourceSentenceIds": [
        17,
        20
      ],
      "sourceLabels": [
        "Web source 2",
        "Wikipedia"
      ],
      "source": "https://grokipedia.com/page/carbonville_utah"
    },
    {
      "id": 2,
      "text": "Originally named Rhoades Meadow, Carbonville was renamed to recognize the region's vast coal deposits.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/carbonville_utah"
    },
    {
      "id": 3,
      "text": "Carbonville remained an agricultural enclave for years, supplying produce to nearby mining camps after a 1912 court ruling.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/carbonville_utah"
    },
    {
      "id": 4,
      "text": "Early settlers in Carbonville grew corn, beans, and potatoes to sustain the local coal mining economy after 1883.",
      "sourceSentenceIds": [
        15
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/carbonville_utah"
    },
    {
      "id": 5,
      "text": "The local geography of Carbonville is defined by the Price River valley, though the water quality was historically poor.",
      "sourceSentenceIds": [
        16,
        21
      ],
      "sourceLabels": [
        "Web source 2",
        "Wikipedia"
      ],
      "source": "https://grokipedia.com/page/carbonville_utah"
    },
    {
      "id": 6,
      "text": "Carbonville experienced rapid growth in housing and industry following the end of World War II.",
