  "facts": [
    {
      "id": 1,
      "text": "Quitman was renamed to honor John A. Quitman, a pro‑slavery Mississippi governor and Mexican–American War veteran.",
      "sourceSentenceIds": [
        12,
        13
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Quitman%2C_Missouri",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town incorporated in 1881 as a stop on the Nodaway Valley Railroad, later part of the Burlington Northern network, which no longer operates.",
      "sourceSentenceIds": [
        4,
        5,
        6
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Quitman%2C_Missouri",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Quitman sits on Missouri Route 113, 5.5 miles north of Skidmore and 4.5 miles south of Burlington Junction.",
      "sourceSentenceIds": [
        14
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Quitman%2C_Missouri",
      "category": "other",
      "quality": "poor",
      "qualityReason": "location_description"
    },
    {
      "id": 4,
      "text": "The Nodaway River skirts the west side of Quitman, while Bowman Branch flows east and joins the river just south of town.",
      "sourceSentenceIds": [
        15
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Quitman%2C_Missouri",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Three miles west of Quitman lies Bilby Ranch Lake Conservation Area, a popular spot for birdwatching and hiking.",
      "sourceSentenceIds": [
        16
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Quitman%2C_Missouri",
      "category": "nature",
      "quality": "good"
    },
    {
