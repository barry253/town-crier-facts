  "facts": [
    {
      "id": 1,
      "text": "Mi-Wuk Village was named after the Miwok Indians by developer Harry Hoeffler in 1955.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Mi-Wuk_Village%2C_California",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The village sits on land once home to the Tuolumne Band of Me-Wuk Indians, whose reservation lies about 8 miles southwest.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Mi-Wuk_Village%2C_California",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Indian Grinding Rock State Historic Park recreates a Miwok village with bark houses, a roundhouse, acorn granaries, shade ramadas, and a game field.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://chawse.org/park/miwok-village/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Reconstructed bark houses, called u'macha, sit near the chaw'se and west of the roundhouse.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://chawse.org/park/miwok-village/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The park’s U’macha’tam’ma’ Environmental Campsite lets group campers stay in historic bark houses.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://chawse.org/park/miwok-village/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The area experiences warm, dry summers with average highs never exceeding 71.6 °F.",
      "sourceSentenceIds": [
        9
