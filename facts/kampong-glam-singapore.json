  "facts": [
    {
      "id": 1,
      "text": "Kampong Glam began as a Malay village in the 19th century, later evolving into a multicultural enclave with Arabs, Chinese, Indians, and Europeans.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 2"
      ],
