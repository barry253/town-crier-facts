  "facts": [
    {
      "id": 1,
      "text": "Rocky Top was originally named Coal Creek when founded after the 1798 Treaty of Tellico, taking its name from the stream that runs through the town.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Rocky_Top%2C_Tennessee",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The 1891 Coal Creek War saw miners armed against convict leasing, storming the Fraterville Mine stockade, liberating prisoners, and destroying facilities without fatalities.",
      "sourceSentenceIds": [
        6,
        7
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/Rocky_Top,_Tennessee",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The conflict ended with the abolition of Tennessee's convict labor program, securing a victory for the coal miners.",
      "sourceSentenceIds": [
        20
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Rocky_Top%2C_Tennessee",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Rocky Top is the hometown of songwriter Dean Dillon, whose songs have become hits for George Strait, Toby Keith, and other country stars.",
      "sourceSentenceIds": [
        5
