  "facts": [
    {
      "id": 1,
      "text": "Mesopotamia Township is the only township in Ohio named after the ancient region between two rivers.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Mesopotamia_Township%2C_Trumbull_County%2C_Ohio"
    },
    {
      "id": 2,
      "text": "Settlers called the area Mesopotamia because it lies between the Grand and Cuyahoga Rivers, mirroring the biblical Mesopotamia.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://mesopotamiatownship.com/about"
    },
    {
      "id": 3,
      "text": "In 1798, Pierpont Edwards offered 100 acres of free land to the first five families who stayed for five years, sparking early settlement.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://mesopotamiatownship.com/about"
    },
    {
      "id": 4,
      "text": "The Mesopotamia Memorial and Historical Association, founded in 1989, preserves artifacts and photographs of the township’s past.",
      "sourceSentenceIds": [
        7,
        8,
        9,
        10,
        18
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://museumsdatabase.com/museums/view/24742"
    },
    {
      "id": 5,
      "text": "A tall, old maple planted in 1895 stands in the park, a living reminder of the township’s 19th‑century roots.",
      "sourceSentenceIds": [
