    {
      "id": 1,
      "text": "Founded in 1885 by pioneer settlers, Afton still draws adventurous spirits craving rustic charm.",
      "sourceSentenceIds": [
        1,
        2
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.visitaftonwy.com/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town takes its name from Scotland’s River Afton, a reminder of settlers’ love for the Intermittent Spring.",
      "sourceSentenceIds": [
        3,
        15
      ],
      "sourceLabels": [
        "Web source 1",
        "Wikipedia"
      ],
      "source": "https://www.visitaftonwy.com/",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Afton proudly hosts the world’s largest elk antler arch, stretching 75 feet across the highway.",
      "sourceSentenceIds": [
        9,
        10
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Afton%2C_Wyoming",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Afton's Intermittent Spring erupts every 12 to 18 minutes, pouring up to 285 gallons per second.",
      "sourceSentenceIds": [
        17,
        19
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Afton%2C_Wyoming",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The first sawmill, general store, and flour mill all opened in 1885‑86, sparking Afton’s early economy.",
      "sourceSentenceIds": [
        16
