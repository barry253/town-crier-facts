  "facts": [
    {
      "id": 1,
      "text": "Barton’s settlement began in 1845 when land surveyor Barton Salisbury saw the Milwaukee River rapids as a hydropower source.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Barton%2C_Wisconsin"
    },
    {
      "id": 2,
      "text": "In 1853 the town was renamed Barton to honor its founder, Barton Salisbury, after the legislature split it from West Bend.",
      "sourceSentenceIds": [
        22
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Barton%2C_Wisconsin"
    },
    {
      "id": 3,
      "text": "The first church in Barton was a German Methodist house of worship established in 1850 by early immigrant farmers.",
      "sourceSentenceIds": [
        24
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Barton%2C_Wisconsin"
    },
    {
      "id": 4,
      "text": "The first Roman Catholic service in Barton took place on Christmas Day, 1857, marking the town’s early religious diversity.",
      "sourceSentenceIds": [
        26
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Barton%2C_Wisconsin"
    },
    {
      "id": 5,
      "text": "In April 1925 residents voted 134‑to‑90 to incorporate the Village of Barton, creating a separate municipal entity.",
      "sourceSentenceIds": [
        28,
        30
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Barton%2C_Wisconsin"
    },
    {
      "id": 6,
      "text": "Barton’s early settlers built a sawmill, attracting more pioneers and turning the area from Salisbury’s Mills into a thriving community.",
