  "facts": [
    {
      "id": 1,
      "text": "Fredericktown was founded August 21, 1790 by German immigrant Frederick Wise, a Revolutionary War major.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/fredericktown_pennsylvania",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Wise reserved land for a cemetery and a schoolhouse in 1793, laying groundwork for early education.",
      "sourceSentenceIds": [
        20
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/fredericktown_pennsylvania",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "In 1796, Fredericktown hosted Pennsylvania’s first public library west of the Allegheny Mountains, operating until 1825.",
      "sourceSentenceIds": [
        1,
        10
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/fredericktown_pennsylvania",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The town’s growth hinged on the Monongahela River, which became a trade artery for coal and agricultural goods in the 19th century.",
      "sourceSentenceIds": [
        11,
        25
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/fredericktown_pennsylvania",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "A 1806 stone house built by settler John Bower later became a local landmark, reflecting early industrial activity.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/fredericktown_pennsylvania",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "By the early 1900s, the Clyde Mine and Coke Works began in 1903, making coal mining the dominant industry until 1989.",
      "sourceSentenceIds": [
        28
      ],
      "sourceLabels": [
        "Web source 1"
      ],
