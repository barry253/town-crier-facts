  "facts": [
    {
      "id": 1,
      "text": "Custer City was originally known as Graves, named after early homesteader Phillip Graves who claimed land during the 1892 run.",
      "sourceSentenceIds": [
        2,
        9
      ],
      "sourceLabels": [
        "Web source 2",
        "Wikipedia"
      ],
      "source": "https://grokipedia.com/page/custer_city_oklahoma"
    },
    {
      "id": 2,
      "text": "The first post office in Custer City opened on January 22, 1894, inside the dugout home of Phillip Graves.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.okhistory.org/publications/enc/entry?entry=CU009"
    },
    {
      "id": 3,
      "text": "By 1909, Custer City was a bustling rural hub with two banks, four general stores, and a broomcorn factory.",
      "sourceSentenceIds": [
        11,
        12
      ],
      "sourceLabels": [
        "Web source 1",
        "Web source 2"
      ],
      "source": "https://www.okhistory.org/publications/enc/entry?entry=CU009"
    },
    {
      "id": 4,
      "text": "The arrival of the Blackwell, Enid and Southwestern Railroad accelerated the growth and agricultural prosperity of Custer City.",
      "sourceSentenceIds": [
        16,
        25
      ],
      "sourceLabels": [
        "Web source 1",
        "Web source 2"
      ],
      "source": "https://www.okhistory.org/publications/enc/entry?entry=CU009"
    },
    {
      "id": 5,
      "text": "Pyeatt's General Store in Custer City is recognized on the National Register of Historic Places for its architectural legacy.",
      "sourceSentenceIds": [
