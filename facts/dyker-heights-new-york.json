  "facts": [
    {
      "id": 1,
      "text": "Dyker Heights began as a speculative luxury housing development in October 1895 when Walter Loveridge Johnson turned woodland into a suburban community.",
      "sourceSentenceIds": [
        26
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Dyker_Heights%2C_Brooklyn",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Johnson named the area \"Dyker Heights\" after the nearby Dyker Meadow and Beach, which his development overlooks.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Dyker_Heights%2C_Brooklyn",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The neighborhood sits atop a 110‑foot hill, with its finest homes originally positioned near Eleventh Avenue and 82nd Street.",
      "sourceSentenceIds": [
        29
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Dyker_Heights%2C_Brooklyn",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The Dyker Heights Civic Association, founded in 1928, has protected the area’s zoning and architectural character for nearly a century.",
      "sourceSentenceIds": [
        3,
        6
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Dyker_Heights%2C_Brooklyn",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Dyker Heights is famous for its elaborate Christmas light displays, a tradition that drew a picture‑perfect snowy scene in 2024.",
      "sourceSentenceIds": [
        13
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://brooklyneagle.com/326233/dyker-heights-history/",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The local post office, the Dyker Heights Station, opened at 8320 13th Avenue and serves the community’s mailing needs.",
