  "facts": [
    {
      "id": 1,
      "text": "Campo Seco, Spanish for 'dry field,' began in 1849 as a Mexican‑founded, forty‑nationality mining camp.",
      "sourceSentenceIds": [
        25,
        7
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Campo_Seco%2C_California",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "California Historical Landmark #257 marks Campo Seco, with its plaque at the corner of Campo Seco and Penn Mine Roads.",
      "sourceSentenceIds": [
        6,
        13
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 2"
      ],
      "source": "https://en.wikipedia.org/wiki/Campo_Seco%2C_California",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The town shelters California’s largest living cork oak tree, planted in 1858 during the Gold Rush.",
      "sourceSentenceIds": [
        5,
        1,
        4
      ],
      "sourceLabels": [
        "Web source 2",
        "Web source 1"
      ],
      "source": "https://evendo.com/locations/california/stockton/landmark/campo-seco-california-historical-landmark-no-257",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "By 1887 the Penn Mining Company owned nearly 1,200 acres around Campo Seco, including the original Harmon claim.",
      "sourceSentenceIds": [
        26
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.calaverashistory.org/campo-seco",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Campo Seco supplied services to river bars along the Mokelumne River, becoming a key support hub during the Gold Rush.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Web source 1"
      ],
