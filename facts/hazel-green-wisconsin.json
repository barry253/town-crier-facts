  "facts": [
    {
      "id": 1,
      "text": "Hazel Green was named in 1825 for the dense growth of American Hazelnut found near the town site.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Hazel_Green%2C_Wisconsin"
    },
    {
      "id": 2,
      "text": "Hazel Green was established as the Point of Beginning for the state of Wisconsin in 1831.",
      "sourceSentenceIds": [
        24
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grantcounty.org/community-information/hazel-green/"
    },
    {
      "id": 3,
      "text": "All land that would become the state of Wisconsin was measured from the Point of Beginning in Hazel Green.",
      "sourceSentenceIds": [
        25
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grantcounty.org/community-information/hazel-green/"
    },
    {
      "id": 4,
      "text": "Every property deed in Wisconsin still includes a description based on the Point of Beginning in Hazel Green.",
      "sourceSentenceIds": [
        26
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grantcounty.org/community-information/hazel-green/"
    },
    {
      "id": 5,
      "text": "Hazel Green is a village located within both Grant and Lafayette counties in the United States.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Hazel_Green%2C_Wisconsin"
    },
    {
      "id": 6,
      "text": "The village of Hazel Green features a recreation park and a Memorial Park for residents and visitors.",
