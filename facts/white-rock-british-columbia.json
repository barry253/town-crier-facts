  "facts": [
    {
      "id": 1,
      "text": "White Rock gets its name from a massive white boulder that sits on its beach, a glacial erratic that drifted south during the last ice age.",
      "sourceSentenceIds": [
        4,
        6
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 2"
      ],
      "source": "https://en.wikipedia.org/wiki/White_Rock%2C_British_Columbia"
    },
    {
      "id": 2,
      "text": "The city’s famous pier, built in 1914, stretches nearly half a kilometer into Semiahmoo Bay and once served as a dock for ships and fishing boats.",
      "sourceSentenceIds": [
        7,
        18
      ],
      "sourceLabels": [
        "Web source 2",
        "Web source 2"
      ],
      "source": "https://beautifulbritishcolumbia.net/2024/09/23/the-history-of-white-rock-british-columbia/"
    },
    {
      "id": 3,
      "text": "White Rock’s modern history began when the Great Northern Railway extended its line through the area in 1909, linking Vancouver with Seattle.",
      "sourceSentenceIds": [
        5,
        17
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 2"
      ],
      "source": "https://en.wikipedia.org/wiki/White_Rock%2C_British_Columbia"
    },
    {
      "id": 4,
      "text": "The Semiahmoo First Nation, a Coast Salish tribe, have lived on the southern bank of the Strait of Georgia for thousands of years before European settlers arrived.",
      "sourceSentenceIds": [
