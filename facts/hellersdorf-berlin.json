      ],
      "source": "https://www.visitberlin.de/en/bezirksmuseum-marzahn-hellersdorf",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "On 1 June 1986, Hellersdorf, Kaulsdorf, and Mahlsdorf merged to form the borough of Hellersdorf.",
