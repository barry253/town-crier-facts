      "quality": "good"
    },
    {
      "id": 3,
      "text": "Mahlsdorf manor house, a Wilhelminian‑style museum, showcases turn‑of‑the‑century furniture and musical instruments.",
      "sourceSentenceIds": [
        27
      ],
      "sourceLabels": [
        "Web source 1"
