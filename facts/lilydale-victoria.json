  "facts": [
    {
      "id": 1,
      "text": "Lilydale station opened in 1882 and today serves as the terminus of the Lilydale railway line, offering half‑hourly metropolitan services.",
      "sourceSentenceIds": [
        12,
        16
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Lilydale%2C_Victoria",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town was named after early settler Lilly de Castella, daughter of Lt‑Col Anderson, who married Paul de Castella in 1856.",
      "sourceSentenceIds": [
        5,
        11,
        21,
        23
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Lilydale%2C_Victoria",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The Yarra Ranges Regional Museum, with its striking architecture, sits in tranquil surroundings and is a cultural highlight of Lilydale.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.visityarravalley.com.au/discover/warburton-valley/lilydale",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Lilydale’s first town hall and Mechanics Institute Free Library were constructed in 1888, marking the town’s early civic development.",
      "sourceSentenceIds": [
        13
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Lilydale%2C_Victoria",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The Lilydale Hotel, opened in 1862, remains one of the town’s oldest public houses.",
