  "facts": [
    {
      "id": 1,
      "text": "Named after contractor Asa Danforth Jr., who designed Queen Street and Kingston Road, Danforth Avenue carries his legacy.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Greektown%2C_Toronto",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Greektown, also called The Danforth, became a major settlement area for Greek immigrants after World War I.",
      "sourceSentenceIds": [
        15,
        16,
        17
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Greektown%2C_Toronto",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The Danforth Music Hall, built in 1919 as a movie theatre, remains one of Toronto’s only historic venues still in use.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.destinationtoronto.com/leisure-blog/post/local-guide-danforth/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Every mid‑August, the Taste of the Danforth festival turns the street into a two‑day food carnival with free samples from local restaurants.",
      "sourceSentenceIds": [
        29,
        30
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Greektown%2C_Toronto",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "In the 1970s and 80s, the Danforth was regarded as the largest Greektown in North America.",
      "sourceSentenceIds": [
        21
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Greektown%2C_Toronto",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Recent years have seen higher‑priced restaurants move in and the creation of a public square at Logan Avenue by Alexander the Great Parkette.",
