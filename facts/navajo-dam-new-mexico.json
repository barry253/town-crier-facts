  "facts": [
    {
      "id": 1,
      "text": "Navajo Dam was built in 1962 as part of the Colorado River Storage Project, a federal effort to manage Southwest water.",
      "sourceSentenceIds": [
        30
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://visitfourcorners.com/navajo-dam/"
    },
    {
      "id": 2,
      "text": "The dam created New Mexico’s second‑largest lake, offering year‑round trout fishing on 15,600 acres of water.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://visitfourcorners.com/navajo-dam/"
    },
    {
      "id": 3,
      "text": "Navajo Dam also generates hydroelectric power while regulating water for the arid Southwest.",
      "sourceSentenceIds": [
        11
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://visitfourcorners.com/navajo-dam/"
    },
    {
      "id": 4,
      "text": "Construction displaced Hispanic cemeteries, parts of the Denver and Rio Grande Western Railroad, and traditional farming patterns.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://visitfourcorners.com/navajo-dam/"
    },
    {
      "id": 5,
      "text": "Today, the site reminds visitors of both the engineering feats of the Colorado River Storage Project and the layered human history that shaped the area.",
      "sourceSentenceIds": [
