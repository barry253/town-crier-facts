  "facts": [
    {
      "id": 1,
      "text": "Symsonia was originally called Slabtown in the 1820s because sawmill slabs were used to lay roads and reduce mud.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/symsonia_kentucky",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The community’s name changed to Symsonia when a post office opened on December 23, 1847, with James K. Wilson as first postmaster.",
      "sourceSentenceIds": [
        2,
        13
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/symsonia_kentucky",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "In the mid‑19th century, the Wadesboro Road linked Calloway County to Paducah, spurring Symsonia’s growth as a farmers’ and lumbermen’s outpost.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/symsonia_kentucky",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The oldest surviving home in Symsonia, built in 1840, was constructed from bricks handmade by enslaved workers on site.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/symsonia_kentucky",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "During the late 1930s, the Tennessee Valley Authority’s Kentucky Dam project hired Symsonia residents like Victor Jarvis, who earned $5.80 a day surveying and building the dam.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/symsonia_kentucky",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Because it sits between the East and West Forks of the Clarks River, Symsonia has faced recurrent flooding, prompting a 1975 federal disaster declaration.",
      "sourceSentenceIds": [
        21
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/symsonia_kentucky",
      "category": "nature",
      "quality": "good"
    }
