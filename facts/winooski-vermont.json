  "facts": [
    {
      "id": 1,
      "text": "Winooski’s name comes from the Abenaki word Winoskitegw, meaning “land of the wild onion.”.",
      "sourceSentenceIds": [
        14
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Winooski%2C_Vermont",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The city sits on the Winooski River, also called the Onion River, which powered early wool mills.",
      "sourceSentenceIds": [
        15,
        19
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Winooski%2C_Vermont",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Ira Allen built a blockhouse on the river in the 1770s that doubled as a fort and general store for the Onion River Company.",
      "sourceSentenceIds": [
        20
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Winooski%2C_Vermont",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The Burlington Mill Company used the river’s waterfalls to spin yarns in the late 1830s, sparking Winooski’s textile boom.",
      "sourceSentenceIds": [
        23
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Winooski%2C_Vermont",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "In 1922, Winooski incorporated as a city, separating from the town of Colchester after decades of growth.",
      "sourceSentenceIds": [
        25
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Winooski%2C_Vermont",
      "category": "history",
      "quality": "good"
    },
