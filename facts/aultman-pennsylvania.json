  "facts": [
    {
      "id": 1,
      "text": "Aultman was founded in 1912 by the Rochester & Pittsburgh Coal & Iron Company as a company town for bituminous coal mines.",
      "sourceSentenceIds": [
        16
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/aultman_pennsylvania"
    },
    {
      "id": 2,
      "text": "The town’s name comes from nearby Aultman's Run, a 10.5‑mile stream that feeds the Conemaugh River.",
      "sourceSentenceIds": [
        12,
        24
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/aultman_pennsylvania"
    },
    {
      "id": 3,
      "text": "At its peak, Aultman housed 41 double houses, 82 single houses, a community hall, a doctor’s office, and the largest tipple in the Jacksonville area.",
      "sourceSentenceIds": [
        18
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/aultman_pennsylvania"
    },
    {
      "id": 4,
      "text": "Aultman’s elevation is 1,115 feet, typical of the rolling Appalachian Plateau that shapes its gentle slopes and forested landscape.",
      "sourceSentenceIds": [
        22
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/aultman_pennsylvania"
    },
    {
      "id": 5,
      "text": "The community sits along Pennsylvania Route 286, about seven miles southwest of Indiana, the county seat.",
      "sourceSentenceIds": [
        15
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Aultman%2C_Pennsylvania"
    },
    {
      "id": 6,
      "text": "Former coal mining sites, including unreclaimed slate dumps and spoil piles, still mark the landscape, illustrating the town’s industrial legacy.",
      "sourceSentenceIds": [
        26
      ],
      "sourceLabels": [
        "Web source 1"
      ],
