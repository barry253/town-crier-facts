  "facts": [
    {
      "id": 1,
      "text": "Glenbrook began in 1860 as Lake Tahoe’s first lumber mill, harvesting timber that fed the Comstock Lode mines in Virginia City.",
      "sourceSentenceIds": [
        7,
        12
      ],
      "sourceLabels": [
        "Web source 1",
        "Web source 2"
      ],
      "source": "https://www.steveandchristineperry.com/area-information/the-history-and-charm-of-glenbrook-at-lake-tahoe/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Glenbrook takes its name from the historic Glenbrook House hotel, which was named after a secluded valley and a nearby brook.",
      "sourceSentenceIds": [
        3,
        18
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Glenbrook%2C_Nevada",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "A 1901 narrow‑gauge railroad connected Glenbrook to Tahoe City, and a 1906 inn and ranch resort ran until 1975.",
      "sourceSentenceIds": [
        13
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/Glenbrook,_Nevada",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The historic Lake Shore House still stands in Glenbrook, blending 19th‑century lumber‑mill architecture with today’s modern homes.",
