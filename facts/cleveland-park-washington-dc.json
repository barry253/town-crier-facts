  "facts": [
    {
      "id": 1,
      "text": "Cleveland Park earned its name from President Grover Cleveland, who once owned a summer home on the 1,000‑acre estate called Pretty Prospect.",
      "sourceSentenceIds": [
        1,
        6
      ],
      "sourceLabels": [
        "Web source 1",
        "Wikipedia"
      ],
      "source": "https://www.clevelandparkhistoricalsociety.org/history",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The neighborhood’s historic district, bounded by Wisconsin and Connecticut Avenues, was officially listed on the National Register of Historic Places in 1987.",
      "sourceSentenceIds": [
        10,
        22
      ],
      "sourceLabels": [
        "Web source 1",
        "Web source 1"
      ],
      "source": "https://www.clevelandparkhistoricalsociety.org/history",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Cleveland Park’s Uptown Theater, built in 1936, remains a rare surviving example of Art Deco architecture in Washington, D.C.",
      "sourceSentenceIds": [
        12,
        9
      ],
      "sourceLabels": [
        "Web source 1",
        "Wikipedia"
      ],
      "source": "https://www.clevelandparkhistoricalsociety.org/history",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The Cleveland Park Historical Society, founded in 1985, runs an oral‑history project that captures longtime residents’ memories of the area’s evolution.",
      "sourceSentenceIds": [
        4,
        2
      ],
      "sourceLabels": [
        "Web source 1",
        "Wikipedia"
      ],
      "source": "https://www.clevelandparkhistoricalsociety.org/history",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "A Red Line metro stop and several bus routes serve the neighborhood, making it one of the most transit‑connected residential areas in Northwest Washington.",
      "sourceSentenceIds": [
        7,
        18
      ],
      "sourceLabels": [
        "Web source 1",
        "Wikipedia"
      ],
      "source": "https://www.clevelandparkhistoricalsociety.org/history",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Cleveland Park’s early development transitioned from a rural summer retreat to a streetcar suburb before becoming the modern urban neighborhood it is today.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Web source 1"
      ],
