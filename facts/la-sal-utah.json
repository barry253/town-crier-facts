  "facts": [
    {
      "id": 1,
      "text": "The name La Sal comes from the Spanish words for the salt, referring to the nearby snow capped peaks.",
      "sourceSentenceIds": [
        9,
        24
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/La_Sal%2C_Utah"
    },
    {
      "id": 2,
      "text": "La Sal sits at an elevation of seven thousand feet and is the northernmost community in San Juan County.",
      "sourceSentenceIds": [
        30
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.utahscanyoncountry.com/la-sal/"
    },
    {
      "id": 3,
      "text": "Ranchers from central Utah founded La Sal in 1877 to take advantage of fertile grazing lands and summer pastures.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/la_sal_utah"
    },
    {
      "id": 4,
      "text": "Early settlers in La Sal built basic cabins along Coyote Creek to protect themselves from conflicts with Native American groups.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/la_sal_utah"
    },
    {
      "id": 5,
      "text": "The rugged frontier landscape of La Sal once sheltered outlaws like Butch Cassidy and the Wild Bunch during the 1890s.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/la_sal_utah"
    },
    {
      "id": 6,
      "text": "Mining in La Sal began in the early twentieth century with the extraction of radium and vanadium for medical and industrial use.",
      "sourceSentenceIds": [
