  "facts": [
    {
      "id": 1,
      "text": "Beato once housed a biscuit factory and cereal mill founded by industrialist João de Brito in the former convent.",
      "sourceSentenceIds": [
        24,
        25
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://beatoquarter.com/en/historia/",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The 1856 railway inauguration revitalised Beato’s industry and led to the construction of the iron Viaduto de Xabregas.",
      "sourceSentenceIds": [
        11
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Beato%2C_Lisbon",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "In the late 19th century, Xabregas factories employed up to 1,000 workers, sparking a strong labor movement and the 1903 cooperative A Xabreguense.",
      "sourceSentenceIds": [
        16
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Beato%2C_Lisbon",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Beato’s industrial past is symbolised in its coat‑of‑arms: a gear wheel, Tagus waves and tobacco leaves.",
      "sourceSentenceIds": [
        18
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Beato%2C_Lisbon",
      "category": "other",
      "quality": "poor",
      "qualityReason": "other"
    },
    {
      "id": 5,
      "text": "The area that is now Vale de Chelas was once a rural parish before 1832–34 liberal reforms dissolved monasteries and opened the land to factories.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Beato%2C_Lisbon",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The first workers’ villages in Xabregas were built in 1867 and 1877 as factory owners tried to house their labor force.",
      "sourceSentenceIds": [
        14
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Beato%2C_Lisbon",
