      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Toronto_waterfront",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Factories on the lakeshore let suppliers arrive by boat while finished goods were shipped efficiently.",
      "sourceSentenceIds": [
        12
