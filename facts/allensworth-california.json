  "facts": [
    {
      "id": 1,
      "text": "Allensworth was founded in 1908 by Colonel Allen Allensworth and Professor William Payne, making it the first California town owned and governed by African Americans.",
      "sourceSentenceIds": [
        5,
        29
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Allensworth%2C_California",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town’s historic core is now Colonel Allensworth State Historic Park, where restored 1908‑1918 buildings and interpretive panels tell its story.",
      "sourceSentenceIds": [
        7,
        3,
        11
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Allensworth%2C_California",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "A 37‑minute film, “Allensworth: A Piece of the World,” chronicles the town’s history and can be viewed at the park after calling the office.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.parks.ca.gov/?page_id=583",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The park offers a self‑guided audio tour that pauses at each stop to share brief histories of Allensworth’s original courthouse, church, hotel, and library.",
      "sourceSentenceIds": [
        17,
        25
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.parks.ca.gov/?page_id=583",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Allensworth sits at 213 feet, the same elevation as Tulare Lake’s shore when it was full, linking the town to the region’s ancient lake.",
