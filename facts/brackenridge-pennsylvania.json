  "facts": [
    {
      "id": 1,
      "text": "Brackenridge, a borough in Allegheny County, is named for Henry Marie Brackenridge, a prominent 19th‑century lawyer and author.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Brackenridge%2C_Pennsylvania",
      "category": "people",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The area that is now Brackenridge was once part of the Brackenridge family’s vast landholdings that stretched across present‑day Brackenridge, Harrison Township, and parts of Tarentum.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/Brackenridge,_Pennsylvania",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "John Long served as Brackenridge’s first burgess when the borough was established in the late 19th century.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.brackenridgeboro.com/history",
      "category": "people",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The Brackenridge Works, a steel mill originally built by Allegheny Steel Company, remains a key part of the borough’s industrial heritage.",
      "sourceSentenceIds": [
        9,
        16
      ],
      "sourceLabels": [
        "Web source 2",
        "Wikipedia"
      ],
      "source": "https://grokipedia.com/page/Brackenridge,_Pennsylvania",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "By 2025, the Brackenridge Works had cut jobs from nearly 3,000 at its peak to fewer than 300.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/Brackenridge,_Pennsylvania",
      "category": "economy",
      "quality": "poor",
      "qualityReason": "vague"
    },
    {
      "id": 6,
      "text": "Brackenridge sits in the Allegheny River valley, where the river shapes the town’s landscape and flood risk.",
