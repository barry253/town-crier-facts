      ],
      "source": "https://en.wikipedia.org/wiki/Falls_Mills%2C_Virginia",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "On July 20, 1863, Confederate cavalry under Major Andrew J. surprised a Union raiding party at Falls Mills, an event known as the Engagement at Falls Mills.",
      "sourceSentenceIds": [
        20,
        21,
        22
      ],
      "sourceLabels": [
