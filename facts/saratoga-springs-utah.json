      ],
      "source": "https://en.wikipedia.org/wiki/Saratoga_Springs%2C_Utah",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "In 2010 the council seeded a library with $10,000, and by 2013 it had grown enough to warrant full‑time staff, a rare municipal library model.",
      "sourceSentenceIds": [
        4,
        5,
        10
      ],
      "sourceLabels": [
