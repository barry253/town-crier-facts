      ],
      "source": "https://en.wikipedia.org/wiki/Saratoga_Springs%2C_Utah",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Because Utah County’s land‑development rules were too rural, landowners pushed for incorporation to preserve the resort‑style character of the area.",
      "sourceSentenceIds": [
        23,
        6
      ],
      "sourceLabels": [
        "Wikipedia",
