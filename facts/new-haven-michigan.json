      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/New_Haven%2C_Michigan",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The depot, one of Michigan’s few original Italianate depots, still stands on Victoria Street and hosts occasional events by the Lenox New Haven Historical Society.",
      "sourceSentenceIds": [
        11
      ],
      "sourceLabels": [
        "Web source 1"
