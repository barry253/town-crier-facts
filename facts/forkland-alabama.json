  "facts": [
    {
      "id": 1,
      "text": "Forkland named for its position at the fork of Tombigbee and Warrior Rivers.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://encyclopediaofalabama.org/article/forkland/",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "First settled in 1818 by white pioneers drawn to fertile alluvial soils between Black Warrior and Tombigbee Rivers.",
      "sourceSentenceIds": [
        16
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/forkland_alabama",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "By 1856, Forkland had a school, churches, general stores, and a wagon factory, making it a modest but functional precinct.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/forkland_alabama",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "1865 emancipation ended the plantation regime, shifting the area from coerced labor to sharecropping and causing long‑term economic stagnation.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/forkland_alabama",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Buildings in Forkland were photographed for the Historic American Buildings Survey in 1933, and several sites are listed on the National Register of Historic Places.",
      "sourceSentenceIds": [
        8,
        9
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Forkland%2C_Alabama",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "In 1974, Forkland was officially incorporated as a town, formalizing its local government structure.",
      "sourceSentenceIds": [
        20
