  "facts": [
    {
      "id": 1,
      "text": "Founded in 1912 as a company smelter town by William A. Clark, Clarkdale grew around the United Verde Copper Company.",
      "sourceSentenceIds": [
        2,
        4
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://azpaths.com/towns-and-cities/mining-rail-towns/clarkdale",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town’s name comes from its location at Arizona’s geographical center, a fact locals still celebrate.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Clarkdale%2C_Arizona",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The Verde Canyon Railroad departs Clarkdale and follows the historic Verde Valley Railroad line through rugged canyon scenery.",
      "sourceSentenceIds": [
        11
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Clarkdale%2C_Arizona",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Clarkdale’s original homes, schools, and civic buildings survive in a National Register Historic District that preserves its early 20th‑century layout.",
      "sourceSentenceIds": [
        19
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://azpaths.com/towns-and-cities/mining-rail-towns/clarkdale",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "When it opened, Clarkdale boasted telephone, telegraph, electric, sewer, and spring‑water services, making it one of the world’s most modern mining towns.",
