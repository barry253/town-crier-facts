  "facts": [
    {
      "id": 1,
      "text": "Highspire was laid out in 1814 by German settlers Henry Berentz and Michael Dochterman.",
      "sourceSentenceIds": [
        11
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://highspire.gov/about/our-history/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town’s name may stem from a high church spire seen on the Susquehanna River or from settlers’ native Speyer.",
      "sourceSentenceIds": [
        5,
        6,
        7
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Highspire%2C_Pennsylvania",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Built in 1824 by distiller Robert Wilson, the Wilson House is probably Highspire’s oldest home and now shelters the Historical Society.",
      "sourceSentenceIds": [
        3,
        23,
        17
      ],
      "sourceLabels": [
        "Web source 2",
        "Web source 1"
      ],
      "source": "https://highspirehistory.org/index.html",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "In 1977 residents organized the Highspire Historical Society to preserve the town’s heritage.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://highspire.gov/about/our-history/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Highspire’s location along the Pennsylvania Canal and Susquehanna River made it a hub for logging, candy, potato chips, whiskey, boat building, knitting, and milling.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
