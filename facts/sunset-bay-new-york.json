  "facts": [
    {
      "id": 1,
      "text": "Sunset Bay was originally home to the Erie people, an Iroquoian tribe that dominated the area until their defeat by the Iroquois Confederacy in 1656.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/sunset_bay_new_york",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Sunset Bay’s humid continental climate is moderated by Lake Erie, keeping summers cooler and winters less harsh than inland areas.",
      "sourceSentenceIds": [
        2,
        3
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/sunset_bay_new_york"
    },
    {
      "id": 3,
      "text": "Sunset Bay often sees intense lake‑effect snow, with cold air over the lake producing several inches of snow per event.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/sunset_bay_new_york"
    },
    {
      "id": 4,
      "text": "A B&E Railroad spur reached Sunset Bay, serving local producers and mills.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://nyfalls.com/lakes/erie/hanover-beach-cattaraugus-creek/"
    },
    {
      "id": 5,
      "text": "Sunset Bay’s proximity to Cattaraugus Creek makes it prone to spring flooding.",
