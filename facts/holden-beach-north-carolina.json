  "facts": [
    {
      "id": 1,
      "text": "Holden Beach was founded in 1756 when Benjamin Holden secured a royal crown land grant for the island.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://holdenbeach.me/about-holden-beach-nc/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town sits on an eight‑mile barrier island, bordered by Shallotte Inlet, Lockwoods Folly Inlet, and the Intracoastal Waterway.",
      "sourceSentenceIds": [
        11
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Holden_Beach%2C_North_Carolina",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "During the Civil War, the Confederate blockade runner CSS Bendigo sank on the island; its wreck is visible at low tide on the eastern end.",
      "sourceSentenceIds": [
        18,
        19,
        20,
        21
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Holden_Beach%2C_North_Carolina",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "In 1924 John Holden surveyed Holden Beach Resort, creating Brunswick County’s first beach subdivision.",
      "sourceSentenceIds": [
        22
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Holden_Beach%2C_North_Carolina",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Holden Beach earned the nickname “The Family Beach” thanks to generations of families preserving its quiet, family‑friendly vibe.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://holdenbeach.me/about-holden-beach-nc/",
      "category": "culture",
      "quality": "poor",
      "qualityReason": "editorial_filler"
    },
    {
      "id": 6,
      "text": "The town marked its 57th anniversary on February 14, 2026, celebrating over half a century of coastal living.",
