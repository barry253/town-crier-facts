      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The point juts into Sydney Harbour opposite Sydney Cove, the site of first European settlement.",
      "sourceSentenceIds": [
        5,
        25
      ],
      "sourceLabels": [
        "Web source 2",
        "Wikipedia"
      ],
      "source": "https://www.visitsydneyaustralia.com.au/milsons-pt.html",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Milsons Point railway station opened 1893 as part of the Hornsby to St Leonards line extension.",
      "sourceSentenceIds": [
        12,
        13
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Milsons_Point",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Lavender Bay station briefly replaced Milsons Point station in 1915, but locals demanded trains stop at Milsons Point.",
      "sourceSentenceIds": [
        14,
        15
      ],
      "sourceLabels": [
        "Web source 2"
