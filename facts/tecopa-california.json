      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The region’s earliest inhabitants were the Shoshone and Paiute tribes, who originally settled the area before European arrival.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 2"
      ],
