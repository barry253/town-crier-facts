  "facts": [
    {
      "id": 1,
      "text": "Beacon Square was first built in the late 1960s as a family‑friendly neighborhood just a short walk from downtown Boca Raton.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://beaconsquarebocaratonneighborhood.org/beacon-square-tracing-the-legacy-of-a-boca-raton-treasure/"
    },
    {
      "id": 2,
      "text": "Its roots trace back to the post‑World War II housing boom that turned Boca Raton from a modest seaside town into a sought‑after community.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://beaconsquarebocaratonneighborhood.org/beacon-square-tracing-the-legacy-of-a-boca-raton-treasure/"
    },
    {
      "id": 3,
      "text": "Beacon Square Park, a green oasis with towering banyan trees, offers tranquil walking paths that locals love for weekend picnics.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://beaconsquarebocaratonneighborhood.org/beacon-square-tracing-the-legacy-of-a-boca-raton-treasure/"
    },
    {
      "id": 4,
      "text": "Developers named the area Beacon Square to evoke a guiding light, referencing both Boca’s lighthouse and the neighborhood’s role in west Boca’s growth.",
      "sourceSentenceIds": [
        23,
        24
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://beaconsquarebocaratonneighborhood.org/beacon-square-tracing-the-legacy-of-a-boca-raton-treasure/"
    },
    {
      "id": 5,
      "text": "The neighborhood’s closeness to Boca Raton Community High School and a new public library made it a hub for learning and community activity.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://beaconsquarebocaratonneighborhood.org/beacon-square-tracing-the-legacy-of-a-boca-raton-treasure/"
    },
    {
      "id": 6,
      "text": "Original ranch‑style homes, featuring terrazzo floors and wide shaded porches, still line Beacon Square’s streets, cherished by families for generations.",
      "sourceSentenceIds": [
        27
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://beaconsquarebocaratonneighborhood.org/beacon-square-tracing-the-legacy-of-a-boca-raton-treasure/"
