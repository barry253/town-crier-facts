  "facts": [
    {
      "id": 1,
      "text": "Gravesend was founded by Lady Deborah Moody, the only English chartered town in Kings County and one of the first towns founded by a woman.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Gravesend%2C_Brooklyn",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The name Gravesend comes from Dutch governor Willem Kieft naming it after the Dutch settlement 's-Gravesande, meaning 'Count's Beach'.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Gravesend%2C_Brooklyn",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Lady Moody chartered the town in 1654, making it the only English‑founded settlement among Brooklyn’s original Dutch towns.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Gravesend%2C_Brooklyn",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "In 1654, Gravesend purchased Coney Island from the Lenape for about $15 in seashells, guns, and gunpowder.",
      "sourceSentenceIds": [
        16
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Gravesend%2C_Brooklyn",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Gravesend was the site of the Boynton Bicycle Railroad, an early monorail prototype, in the late 19th century.",
      "sourceSentenceIds": [
        17
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Gravesend%2C_Brooklyn",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The neighborhood preserves its original village grid, with modest wood‑frame houses echoing its 17th‑century roots, a testament to Lady Moody’s vision of tolerance.",
      "sourceSentenceIds": [
        23
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.cityneighborhoods.nyc/gravesend",
      "category": "landmark",
      "quality": "good"
    }
  ]
