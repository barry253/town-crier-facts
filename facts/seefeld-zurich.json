    {
      "id": 1,
      "text": "Seefeld evolved from a quiet farming area into a refined lakeside district during the 19th‑century expansion of Zürich.",
      "sourceSentenceIds": [
        4,
        22
      ],
      "sourceLabels": [
        "Web source 2",
        "Web source 1"
      ],
      "source": "https://taglinetoday.com/discover-seefeld-your-ultimate-zurich-neighborhood-guide/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The promenade along Seefeldquai was built on landfills from the 19th‑century quay construction, now a popular spot for walking and watching sailboats.",
      "sourceSentenceIds": [
        6,
        25
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Seefeld_(Z%C3%BCrich)",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Seefeld hosts the Le Corbusier Pavilion, formerly the Centre Le Corbusier – Heidi Weber Museum, showcasing the architect’s work between Seefeldquai and Blatterwiese.",
      "sourceSentenceIds": [
        17
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Seefeld_(Z%C3%BCrich)",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The Chinese Garden Zürich, inaugurated in 1993, sits between Blatterwiese and Bellerivestrasse and offers a tranquil oasis amid the neighborhood.",
      "sourceSentenceIds": [
        18
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Seefeld_(Z%C3%BCrich)",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "A 1971–72 Henry Moore sculpture, Sheep Piece, was donated to Seefeld in 1976 and now adorns a public space.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Seefeld_(Z%C3%BCrich)",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Seefeld’s Belle Époque architecture mixes with modern galleries and cafés, creating a blend of historic elegance and contemporary culture.",
      "sourceSentenceIds": [
        23
