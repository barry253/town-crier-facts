  "facts": [
    {
      "id": 1,
      "text": "Barangaroo was renamed in 2007 to honor Barangaroo, a Kamaraygal woman and wife of Bennelong, a key Aboriginal interlocutor.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Barangaroo%2C_New_South_Wales",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Originally called Cockle Bay Point during the early colony, the area saw little settlement.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Barangaroo%2C_New_South_Wales",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "In 2003 NSW decided to redevelop the former shipping site into commercial, recreational space, with construction starting 2012 and completion aimed for 2023.",
      "sourceSentenceIds": [
        25,
        28
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Barangaroo%2C_New_South_Wales",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Barangaroo railway station opened on 19 August 2024 as part of the Sydney Metro City & Southwest project.",
      "sourceSentenceIds": [
        19
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Barangaroo%2C_New_South_Wales",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Wynyard Walk, a pedestrian link between Wynyard station and Barangaroo, opened in 2016.",
      "sourceSentenceIds": [
        20
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Barangaroo%2C_New_South_Wales",
