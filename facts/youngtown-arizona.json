      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Developer Ben Schleifer, who also imagined an active retirement community, chose the name Youngtown—an ironic twist for a town of seniors.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
