  "facts": [
    {
      "id": 1,
      "text": "Metropolis was founded in 1839 near Fort Massac, chosen for its Ohio River location to become a transport hub.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Metropolis%2C_Illinois",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The city’s name echoes the fictional Superman city, and in 1972 the Illinois Legislature honored it with a “Project Superman” resolution.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Metropolis%2C_Illinois",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Every second weekend of June, Metropolis hosts a Superman Celebration featuring panels, film screenings, and comic‑book signings.",
      "sourceSentenceIds": [
        24
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://tripatini.com/profiles/blogs/metropolis-illinois-attractions-tourism-travel",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Super City Antiques, housed in a 1890s brick building, offers vintage Superman gear and other unique collectibles.",
      "sourceSentenceIds": [
        17
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.offbeatpathfinder.com/destinations/metropolis-illinois/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Fort Massac State Park, just five minutes from town, preserves a 1757 French fort built to counter British expansion along the Ohio River.",
      "sourceSentenceIds": [
        25
