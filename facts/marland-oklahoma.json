  "facts": [
    {
      "id": 1,
      "text": "Marland began as a community named Bliss, serving as a shipping point on the Atchison, Topeka and Santa Fe Railway.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Marland%2C_Oklahoma"
    },
    {
      "id": 2,
      "text": "The Miller brothers once held various Wild West shows at their ranch's summer camp near Bliss Station.",
      "sourceSentenceIds": [
        19
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.okhistory.org/publications/enc/entry?entry=MA025"
    },
    {
      "id": 3,
      "text": "Marland was originally part of the Miller Brothers 101 Ranch on land formerly used for cattle grazing.",
      "sourceSentenceIds": [
        22
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Marland%2C_Oklahoma"
    },
    {
      "id": 4,
      "text": "In 1917, the Millers decided to move the town of Marland about one mile north to the other side of the tracks.",
      "sourceSentenceIds": [
        24
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Marland%2C_Oklahoma"
    },
    {
      "id": 5,
      "text": "The Great Depression bankrupted the Miller Brothers ranch and dried up the Three Sands Field, stunting the growth of Marland.",
      "sourceSentenceIds": [
        26
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Marland%2C_Oklahoma"
    }
