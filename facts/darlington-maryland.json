  "facts": [
    {
      "id": 1,
      "text": "Darlington’s Historic District, listed on the National Register in 1987, boasts about 100 buildings, some designed by architect Theophilus Parsons Chandler Jr.",
      "sourceSentenceIds": [
        5,
        13
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
