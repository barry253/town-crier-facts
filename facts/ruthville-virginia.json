  "facts": [
    {
      "id": 1,
      "text": "In the 1740s, three brothers—Abraham, William, and John Brown—were bound out on free land owned by their mulatto mother, Elizabeth Brown, laying the foundation for Ruthville.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://freedoms-jubilee.charlescity.org/exhibit/ruthville-historic-free-town/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Abraham Brown, son of the first Abraham, helped organize Elam Baptist Church in 1810, making it the town’s first religious institution.",
      "sourceSentenceIds": [
        11
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://freedoms-jubilee.charlescity.org/exhibit/ruthville-historic-free-town/",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Old Elam Cemetery, just down the road from the monument, is probably the oldest known cemetery of free blacks and mulattoes in Charles City County.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://freedoms-jubilee.charlescity.org/exhibit/ruthville-historic-free-town/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The community adopted the name Ruthville when a post office opened in 1880, marking its official recognition.",
      "sourceSentenceIds": [
        18
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://freedoms-jubilee.charlescity.org/exhibit/ruthville-historic-free-town/",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "At the turn of the century, Ruthville residents founded the Mercantile Cooperative Company to promote economic independence for the community.",
      "sourceSentenceIds": [
        21
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://freedoms-jubilee.charlescity.org/exhibit/ruthville-historic-free-town/",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "A six‑room brick high school was built in 1930 with Rosenwald Fund aid, providing the first formal education for local students after the Civil War.",
      "sourceSentenceIds": [
        25
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://freedoms-jubilee.charlescity.org/exhibit/ruthville-historic-free-town/",
      "category": "landmark",
      "quality": "good"
    }
