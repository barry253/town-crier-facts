  "facts": [
    {
      "id": 1,
      "text": "Little Cypress was named for the nearby Little Cypress Bayou, a fertile alluvial stream that attracted farmers after the Civil War.",
      "sourceSentenceIds": [
        17,
        18,
        19
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 2"
      ],
      "source": "https://en.wikipedia.org/wiki/Little_Cypress%2C_Texas",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The first school built shortly after the war became the community’s hub, alongside the Little Cypress Baptist Church.",
      "sourceSentenceIds": [
        12,
        26
      ],
      "sourceLabels": [
        "Web source 2",
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/little_cypress_texas",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "In 1927, Little Cypress and Gum Grove schools merged, eventually leading to a new four‑room brick school that served both elementary and high grades.",
      "sourceSentenceIds": [
        21,
        27
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Little_Cypress%2C_Texas",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "High school classes were paused from 1934 to 1951 before being restored, reflecting the town’s fluctuating educational needs.",
      "sourceSentenceIds": [
        28
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.tshaonline.org/handbook/entries/little-cypress-tx",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Little Cypress lies within the Beaumont–Port Arthur Metropolitan Statistical Area, linking it to the larger Gulf Coast economy.",
      "sourceSentenceIds": [
        20
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Little_Cypress%2C_Texas",
      "category": "other",
      "quality": "poor",
      "qualityReason": "location_description"
    },
    {
      "id": 6,
      "text": "Hurricanes Rita (2005), Ike (2008), and Harvey (2017) have all battered Orange County, with Little Cypress experiencing significant flooding and wind damage.",
