  "facts": [
    {
      "id": 1,
      "text": "Oysterville was founded in 1841 as an oyster fishing village and later served as Pacific County’s seat until 1893.",
      "sourceSentenceIds": [
        2,
        5,
        25
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Oysterville%2C_Washington",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town’s historic district, including a one‑room schoolhouse still in use, was listed on the National Register of Historic Places in 1976.",
      "sourceSentenceIds": [
        14,
        28
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Oysterville%2C_Washington",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Oysterville’s name honors its oyster boom; Chief Nahcati introduced settlers to the area in the mid‑1800s.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.evergreencoastwa.com/cities-communities/oysterville/",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The Oysterville Sea Farms cannery, a landmark of west‑coast aquaculture, was added to the National Register in April 1976.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://opwa.com/oysterville/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Located on Willapa Bay’s sheltered east side, Oysterville sits about 5 miles from Ocean Park and 15 miles from Long Beach.",
      "sourceSentenceIds": [
        20,
        21,
        29
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Oysterville%2C_Washington",
      "category": "other",
      "quality": "poor",
      "qualityReason": "location_description"
    },
    {
      "id": 6,
      "text": "A historic cemetery begun in 1858 holds graves of many founding families, reflecting the town’s early settlers.",
