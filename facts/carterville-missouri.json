  "facts": [
    {
      "id": 1,
      "text": "Carterville first appeared on the map in 1875 when a post office opened that same year.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Carterville%2C_Missouri",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town didn’t become an official city until 1882, seven years after its post office began operation.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://cartervillemo.com/history",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Carterville earned its name when founder Carter’s son, James Gilbert Leroy Carter, settled the land in the 1860s and the post office adopted the family name.",
      "sourceSentenceIds": [
        6,
        4,
        5
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 2"
      ],
      "source": "https://en.wikipedia.org/wiki/Carterville%2C_Missouri",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "By 1894 an electrified streetcar linked Carterville to Webb City, Joplin, and Prosperity, making it a regional rail hub.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Carterville%2C_Missouri",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The town’s growth stalled after World War I as the local mining industry began to dry up.",
      "sourceSentenceIds": [
        19
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Carterville%2C_Missouri",
      "category": "history",
      "quality": "good"
    },
    {
