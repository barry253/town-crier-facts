  "facts": [
    {
      "id": 1,
      "text": "Earlville takes its name from Jonas Earl, a canal commissioner who helped build the Chenango Canal.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Earlville%2C_New_York",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Facing the opera house, the Odd Fellows Hall on East Main Street showcases a classic Second Empire mansard roof.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.livingplaces.com/NY/Madison_County/Earlville_Village/Earlville_Historic_District.html",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The Earlville Opera House, listed in 1973, hosts a theater, two art galleries, a café, and an artisan shop.",
      "sourceSentenceIds": [
        14
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Earlville%2C_New_York",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "East and West Main Street run along the Madison–Chenango county line, literally splitting the village in two.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Earlville%2C_New_York",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Earlville became an incorporated village in 1887, the same year its historic district was later added to the National Register.",
      "sourceSentenceIds": [
        12,
        13
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
