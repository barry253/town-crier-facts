      "category": "transport",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "San Marcos de Apalache Historic State Park preserves the remains of the 17th‑century fort and museum, telling Spanish, British, Confederate, and American stories.",
      "sourceSentenceIds": [
        18,
        24
      ],
      "sourceLabels": [
