  "facts": [
    {
      "id": 1,
      "text": "Friendship Heights Village was officially created on March 20, 1914 as a special taxing district, giving residents limited local control while staying under Montgomery County.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/Friendship_Heights_Village,_Maryland",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The 1914 law allowed a 10‑cent per $100 tax to fund street work and sanitation, marking Friendship Heights' shift from farmland to suburb.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/Friendship_Heights_Village,_Maryland",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Humphrey Friendship Park opened in 1970, and the Village Center followed in 1986, giving residents green space and a hub for gatherings.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/Friendship_Heights_Village,_Maryland",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Friendship Heights sits beside the Red Line Metro station, and local groups now run the Page Park Project to protect nearby green space.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/Friendship_Heights_Village,_Maryland",
      "category": "transport",
      "quality": "poor",
      "qualityReason": "route_only"
    },
    {
      "id": 5,
      "text": "The 1966 opening of the Friendship Heights Metrorail station sparked a boom, leading to towers like The Irene and The Willoughby that dominate the skyline.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/Friendship_Heights_Village,_Maryland",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Friendship Heights Village covers just 34 acres, yet its high‑rise buildings make its density rival that of Manhattan.",
      "sourceSentenceIds": [
        19
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/Friendship_Heights_Village,_Maryland",
      "category": "other",
      "quality": "poor",
      "qualityReason": "vague"
    }
