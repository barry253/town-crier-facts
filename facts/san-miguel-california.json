  "facts": [
    {
      "id": 1,
      "text": "San Miguel was founded by the Spanish on July 25, 1797 when Mission San Miguel Arcángel was established by Fermín de Lasuén.",
      "sourceSentenceIds": [
        1,
        5
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/San_Miguel%2C_California"
    },
    {
      "id": 2,
      "text": "The mission stands as the town’s foundational cornerstone, linking San Miguel to 18th‑century California history.",
      "sourceSentenceIds": [
        2,
        11
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://finenaturalist.blog/city-san-miguel-ca-historic-gateway"
    },
    {
      "id": 3,
      "text": "Mission San Miguel Arcángel’s preserved grounds are a time capsule along El Camino Real, offering a tangible link to early California.",
      "sourceSentenceIds": [
        3,
        12
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://finenaturalist.blog/city-san-miguel-ca-historic-gateway"
    },
    {
      "id": 4,
      "text": "San Miguel sits at the northern tip of San Luis Obispo County, acting as the historical gateway to Central Coast California.",
      "sourceSentenceIds": [
        9,
        20
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://finenaturalist.blog/city-san-miguel-ca-historic-gateway"
    },
    {
      "id": 5,
      "text": "The town’s name means “St. Michael” in Spanish, reflecting its religious origins of the 18th century.",
      "sourceSentenceIds": [
        25
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/San_Miguel%2C_California"
    },
    {
