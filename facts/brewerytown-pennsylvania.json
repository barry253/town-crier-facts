  "facts": [
    {
      "id": 1,
      "text": "Brewerytown earned its name from the dozens of breweries that once lined the Schuylkill River in the late 1800s and early 1900s.",
      "sourceSentenceIds": [
        16
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Brewerytown%2C_Philadelphia",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "At its peak, Philadelphia hosted 700 breweries, several of which were clustered in a ten‑block stretch of Brewerytown.",
      "sourceSentenceIds": [
        24
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Brewerytown%2C_Philadelphia",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "German architect Otto Wolf designed over 60 buildings in Brewerytown, including the historic Bergdoll Brewing complex that still stands.",
      "sourceSentenceIds": [
        20,
        21
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Brewerytown%2C_Philadelphia",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The first Major League Baseball game took place at Jefferson Street Grounds, located at 27th and Jefferson in Brewerytown.",
      "sourceSentenceIds": [
        22
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Brewerytown%2C_Philadelphia",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "After Prohibition and a Midwest shift, no brewery operated in Brewerytown by 1987, and none are active as of 2025.",
      "sourceSentenceIds": [
        5,
        26
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Brewerytown%2C_Philadelphia",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Brewerytown’s revitalization features murals of civil‑rights leaders, reflecting the neighborhood’s historic activism.",
