  "facts": [
    {
      "id": 1,
      "text": "Bryantown stands on land known as Boarman's Manor, a 4,000‑acre estate granted to Major William Boarman in 1674.",
      "sourceSentenceIds": [
        3,
        8
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Bryantown%2C_Maryland"
    },
    {
      "id": 2,
      "text": "Bryantown is linked to the 1865 flight of President Abraham Lincoln’s assassin John Wilkes Booth, who met Samuel Mudd at the town’s church.",
      "sourceSentenceIds": [
        4,
        9,
        6,
        11
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Bryantown%2C_Maryland"
    },
    {
      "id": 3,
      "text": "Mary’s Catholic Church in Bryantown is the burial place of Dr. Samuel Mudd, the physician who treated Booth after the assassination.",
      "sourceSentenceIds": [
        5,
        10
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Bryantown%2C_Maryland"
    },
    {
      "id": 4,
      "text": "The Bryantown Historic District was listed on the National Register of Historic Places in 1985.",
      "sourceSentenceIds": [
        7,
        12
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Bryantown%2C_Maryland"
    },
    {
      "id": 5,
      "text": "The historic home The Lindens in Bryantown was added to the National Register in 1990.",
      "sourceSentenceIds": [
        7,
