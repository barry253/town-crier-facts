  "facts": [
    {
      "id": 1,
      "text": "Fort Pierce sits on Florida’s Treasure Coast, named after a Spanish treasure fleet that sank in 1715, making it one of the oldest east‑coast communities.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.cityoffortpierce.com/224/About-Fort-Pierce",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The historic 1,200‑seat Sunrise Theatre, owned by the city, hosts performing‑arts shows and is a centerpiece of downtown Fort Pierce’s cultural scene.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.cityoffortpierce.com/224/About-Fort-Pierce",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The Zora Neale Hurston Trail winds through Fort Pierce, honoring the author and anthropologist who spent her final years in the town.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.cityoffortpierce.com/101/Visitors",
      "category": "people",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Fort Pierce’s Marine research community includes the Smithsonian Marine Station and the Harbor Branch Oceanographic Institution, both conducting cutting‑edge studies.",
      "sourceSentenceIds": [
        11
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.cityoffortpierce.com/224/About-Fort-Pierce",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The Lucie Regional History Museum, along with its Adams Cobb Cultural Museum satellite, preserves Fort Pierce’s local heritage and artifacts.",
      "sourceSentenceIds": [
        4,
        6
      ],
      "sourceLabels": [
        "Web source 1",
        "Web source 2"
      ],
      "source": "https://www.cityoffortpierce.com/101/Visitors",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Fort Pierce’s downtown redevelopment, begun after its 1901 incorporation, has revitalized historic streets, the Avenue D corridor, and South Hutchinson Island.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 2"
      ],
