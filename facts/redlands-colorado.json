  "facts": [
    {
      "id": 1,
      "text": "Redlands earned its name from the iron‑oxide‑rich red earth and rock that paint the landscape.",
      "sourceSentenceIds": [
        1,
        22
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/redlands_colorado",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Ute Indian territory opened to settlers in 1881, sparking Redlands’ first wave of pioneers.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/redlands_colorado",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The 1905 Redlands Water and Power Company turned irrigation projects into thriving peach orchards and even early hydroelectric power.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/redlands_colorado",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The 1920 Redlands Community Center, now on the Colorado State Register, still stands as a living museum of local life.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/redlands_colorado",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Riggs Hill hosts a 1901 Brachiosaurus fossil, a rare glimpse into the region’s dinosaur past.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/redlands_colorado",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The Redlands Area Historical Society preserves buildings, neighborhoods, and oral histories, teaching residents the value of their heritage.",
