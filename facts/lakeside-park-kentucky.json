    {
      "id": 3,
      "text": "Forts guarded the Covington and Lexington Turnpike as it passed through Lakeside Park during the Civil War.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Lakeside_Park%2C_Kentucky"
    },
    {
      "id": 4,
      "text": "Lakeside Park was strategically placed next to the Covington and Lexington Turnpike to prevent annexation by Fort Mitchell.",
      "sourceSentenceIds": [
        12
