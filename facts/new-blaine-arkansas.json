  "facts": [
    {
      "id": 1,
      "text": "New Blaine began as Blaine, named for James G., a pioneer who helped settle the Arkansas River Valley.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/new_blaine_arkansas",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "After the 1820s treaties removed the Osage and Cherokee, settlers from the east began farming the fertile lands that would become New Blaine.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/new_blaine_arkansas",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "When the Fort Smith, Subiaco & Eastern Railroad reached the area in 1920, the town’s commercial core moved south of Little Shoal Creek to sit beside the tracks.",
      "sourceSentenceIds": [
        8,
        9
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/new_blaine_arkansas",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "In 1922 masons Aaron Moore, John Friga, and Freeborn Lasater built a row of native stone shops and a bank along Main Street, giving New Blaine its distinctive look.",
      "sourceSentenceIds": [
        24
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/new_blaine_arkansas",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The 1896 Jim and Lizzie Bell Horn House and the 1909 Iven and Alberta Horn Burnham House, both on the National Register, showcase the town’s vernacular architecture.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Web source 1"
      ],
