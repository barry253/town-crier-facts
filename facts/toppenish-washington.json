      "category": "culture",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The 1911 Northern Pacific Railway depot now houses a museum that recreates 1930s railroad ambience with real locomotives.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
