  "facts": [
    {
      "id": 1,
      "text": "Navarro began as a 1,000‑person town founded in the 1860s, 14 miles west of its current location at the mouth of the Navarro River.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Navarro%2C_California",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "In 1905 Wendling sprang up on the north fork of the Navarro River around a new mill, becoming the town that would later be renamed Navarro.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Navarro%2C_California",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "A post office opened in the original Navarro in 1867, closed after the 1902 mill fire, and reopened again in 1914.",
      "sourceSentenceIds": [
        15,
        16,
        18
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Navarro%2C_California",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The Fort Bragg and Southeast Railroad connected Wendling—later Navarro—to Albion’s seaport from 1905 until 1930, linking the town to the coast.",
      "sourceSentenceIds": [
        6
      ],
