    },
    {
      "id": 3,
      "text": "During the winter of 1775‑1776, General Henry Knox marched artillery through North Egremont en route to Boston.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.egremont-ma.gov/189/Egremont-Historical-Commission"
    },
    {
      "id": 4,
      "text": "The Knox Trail follows that historic route and features a marker in North Egremont.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Egremont%2C_Massachusetts"
    },
    {
      "id": 5,
      "text": "The Everett Academy building, shared with the free library, sits in South Egremont’s National Register Historic District.",
      "sourceSentenceIds": [
