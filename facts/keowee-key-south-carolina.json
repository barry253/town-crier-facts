  "facts": [
    {
      "id": 1,
      "text": "Keowee Key sits on a peninsula extending into Lake Keowee, a reservoir formed by the Keowee and Little Rivers.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Keowee_Key%2C_South_Carolina"
    },
    {
      "id": 2,
      "text": "The name Keowee means Place of the Mulberries, reflecting a historic Cherokee settlement once located nearby.",
      "sourceSentenceIds": [
        22
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://keoweekeysc.com/who-we-are"
    },
    {
      "id": 3,
      "text": "Keowee Key was established in 1972 as a private residential community designed to preserve the natural forest.",
      "sourceSentenceIds": [
        20
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://keoweekeysc.com/who-we-are"
    },
    {
      "id": 4,
      "text": "The Keowee River arm of the lake forms the eastern border of Keowee Key and separates it from Pickens County.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Keowee_Key%2C_South_Carolina"
    },
    {
      "id": 5,
      "text": "Keowee Key residents collectively own all common property, including the community's amenities and private utilities.",
      "sourceSentenceIds": [
        19
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://keoweekeysc.com/who-we-are"
    },
    {
      "id": 6,
      "text": "The Keowee River is a south-flowing tributary of the Seneca River, which eventually feeds into the Savannah River.",
      "sourceSentenceIds": [
