  "facts": [
    {
      "id": 1,
      "text": "San Rafael was named for Father José Rafael Chávez, a Franciscan priest who arrived with settlers from Seboyeta in 1863.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://cibola.nmgenweb.us/resources/abe_pena/memories/sanrafael.html"
    },
    {
      "id": 2,
      "text": "Also called “Bikyaya” or “El Gallo,” San Rafael sits at 6,470 feet above sea level.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/San_Rafael%2C_New_Mexico"
    },
    {
      "id": 3,
      "text": "Fort Wingate was relocated from Seboyeta to Ojo del Gallo—San Rafael—in 1863 to house a cavalry post.",
      "sourceSentenceIds": [
        24
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://cibola.nmgenweb.us/resources/abe_pena/memories/sanrafael.html"
    },
    {
      "id": 4,
      "text": "The fort’s mission was to watch Navajo and Apache movements while safeguarding settlers moving westward.",
      "sourceSentenceIds": [
        23
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://cibola.nmgenweb.us/resources/abe_pena/memories/sanrafael.html"
    },
    {
      "id": 5,
      "text": "Ojo del Gallo spring still yields about 500 gallons per minute, irrigating the surrounding meadow.",
      "sourceSentenceIds": [
        26
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://cibola.nmgenweb.us/resources/abe_pena/memories/sanrafael.html"
    },
    {
      "id": 6,
      "text": "Veteran Mónico Mirabal secured a land patent for the meadow, turning it into a vital supply source for the fort.",
      "sourceSentenceIds": [
        25
      ],
      "sourceLabels": [
        "Web source 1"
      ],
