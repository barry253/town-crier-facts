  "facts": [
    {
      "id": 1,
      "text": "Buena’s name comes from the Spanish word for “good,” chosen when the Northern Pacific Railway built a siding there in 1919.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Buena%2C_Washington",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Before becoming Buena, the settlement was called Springdale, then Jonathan in 1918 to avoid confusion with another Springdale when a post office opened.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Buena%2C_Washington",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Historic Sanborn Fire Insurance Maps from 1922 and 1931 let us see how Buena’s downtown looked a century ago, showing every shop and school.",
      "sourceSentenceIds": [
        10,
        12
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://hometownhistorymaps.com/pages/history-of-buena-washington",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The 1922 Sanborn map of Buena is the oldest available map, while the 1931 map is the newest in the town’s small collection.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://hometownhistorymaps.com/pages/history-of-buena-washington",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Local history enthusiasts often use Buena’s old maps to build scale models or trace the town’s layout changes over time.",
      "sourceSentenceIds": [
