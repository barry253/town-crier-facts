  "facts": [
    {
      "id": 1,
      "text": "Jamesville Colony was founded in 1884 by families from the Wolf Creek Bruderhof under the leadership of preacher Elias Walter, Sr.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/jamesville_colony_south_dakota"
    },
    {
      "id": 2,
      "text": "Jamesville Colony is a Hutterian Brethren community that practices collective living, shared property, and agrarian self-sufficiency.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/jamesville_colony_south_dakota"
    },
    {
      "id": 3,
      "text": "Anti-Hutterite sentiment during World War I led the Jamesville Colony to migrate to Canada in 1918 to escape persecution.",
      "sourceSentenceIds": [
        17,
        18
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/jamesville_colony_south_dakota"
    },
    {
      "id": 4,
      "text": "The Roseisle Hutterite Colony from Manitoba repurchased the Jamesville property and relocated there in 1936.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/jamesville_colony_south_dakota"
    },
    {
      "id": 5,
      "text": "Jamesville Colony sits in the James River valley on the fertile plains of southeastern South Dakota.",
      "sourceSentenceIds": [
        25,
        26
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/jamesville_colony_south_dakota"
    },
    {
      "id": 6,
      "text": "The settlement operates as a self-contained brotherhood focused on farming and education through its own elementary school.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/jamesville_colony_south_dakota"
