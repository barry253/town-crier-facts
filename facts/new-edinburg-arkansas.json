  "facts": [
    {
      "id": 1,
      "text": "New Edinburg was originally called Washburn Flats, then Eagle Post, before the name Edinburg was finally chosen after a long debate.",
      "sourceSentenceIds": [
        1,
        29,
        30
      ],
      "sourceLabels": [
        "Web source 2"
      ],
