      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Unlike many towns that have razed historic buildings, New Edinburg remains frozen in time, little changed from its heyday.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 2"
      ],
