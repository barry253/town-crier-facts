      "quality": "poor",
      "qualityReason": "location_description"
    },
    {
      "id": 3,
      "text": "Green Hill Plantation, founded by Samuel Pannill around 1800, once ranked as Campbell County's wealthiest farm and is now on the National Register.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 1"
      ],
