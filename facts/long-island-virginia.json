      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The community sits on the northeast bank of the Roanoke (Staunton) River, about 11 miles southeast of Altavista.",
      "sourceSentenceIds": [
        21,
        23
      ],
      "sourceLabels": [
        "Web source 1"
