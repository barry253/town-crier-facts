  "facts": [
    {
      "id": 1,
      "text": "Canfield was founded in 1798 as a 16,324‑acre tract on the Connecticut Western Reserve.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://canfield.gov/about/"
    },
    {
      "id": 2,
      "text": "The town was renamed from Campfield to Canfield on April 15 1800 in honor of land agent Judson Canfield.",
      "sourceSentenceIds": [
        4,
        16
      ],
      "sourceLabels": [
        "Web source 1",
        "Web source 2"
      ],
      "source": "https://canfield.gov/about/"
    },
    {
      "id": 3,
      "text": "Canfield served as Mahoning County’s seat from 1846 until the Ohio Supreme Court moved it to Youngstown in 1875.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://canfield.gov/about/"
    },
    {
      "id": 4,
      "text": "The first Canfield Fair opened October 5 1847, showcasing livestock, produce, and meetings held in the Congregational Church.",
      "sourceSentenceIds": [
        14
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://canfield.gov/about/"
    },
    {
      "id": 5,
      "text": "Classic revival homes such as the Charles Ruggles House and Judge Eben Newton House sit on the National Register of Historic Places in Canfield.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Canfield%2C_Ohio"
    },
    {
      "id": 6,
      "text": "Canfield Township Hall, erected in 1884, housed the Canfield Historical Society for more than 125 years.",
      "sourceSentenceIds": [
        9,
