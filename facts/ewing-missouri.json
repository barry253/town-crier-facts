  "facts": [
    {
      "id": 1,
      "text": "Ewing, Missouri earned its name from early pioneer settler William Ewing, whose family helped establish the town in the 1830s.",
      "sourceSentenceIds": [
        2,
        3,
        10
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/ewing_missouri",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town sits at about 689 feet, placing it in a flood‑prone area where a tornado once struck just west of Ewing.",
      "sourceSentenceIds": [
        11
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/ewing_missouri",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Ewing’s climate is humid continental, with hot, humid summers and cold, snowy winters that bring significant seasonal swings.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/ewing_missouri",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Fertile Lindley loam dominates the surrounding soil, ideal for row crops but vulnerable to erosion on steeper slopes.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/ewing_missouri",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Founded after Lewis County was carved from Marion County in 1833, Ewing grew from a small farming community into a formal town by the late 19th century.",
      "sourceSentenceIds": [
        10,
        12
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/ewing_missouri",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The town’s early settlers, including William Ewing, navigated partisan tensions and raids near the Illinois border while maintaining their farms.",
      "sourceSentenceIds": [
