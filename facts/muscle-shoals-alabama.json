  "facts": [
    {
      "id": 1,
      "text": "Muscle Shoals earned national fame for its music scene, especially through FAME Studios where artists like Aretha Franklin and Otis Redding recorded.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Muscle_Shoals%2C_Alabama",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town’s name comes from a shallow stretch of the Tennessee River where mussels were once gathered by early settlers.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Muscle_Shoals%2C_Alabama",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Muscle Shoals was founded in 1923 and quickly became known for the Tennessee Valley Authority’s electrification projects.",
      "sourceSentenceIds": [
        3,
        26
      ],
      "sourceLabels": [
        "Web source 1",
        "Wikipedia"
      ],
      "source": "https://www.cityofmuscleshoals.com/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "In 1972, The Staple Singers’ “I’ll Take You There” recorded at Muscle Shoals became a benchmark of the region’s sound.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Muscle_Shoals%2C_Alabama",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The original Muscle Shoals Sound Studio in Sheffield is listed on the National Register of Historic Places since 2006.",
