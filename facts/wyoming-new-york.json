  "facts": [
    {
      "id": 1,
      "text": "Wyoming was originally called Newell's Settlement, founded in 1809 by Silas Newell, and renamed Wyoming in 1829 before incorporating in 1875.",
      "sourceSentenceIds": [
        2,
        3
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Wyoming%2C_New_York",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The village’s historic downtown is known as the Gaslight Village, where a 19th‑century academy built in 1817 still stands.",
      "sourceSentenceIds": [
        21
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Wyoming%2C_New_York",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Wyoming’s natural gas field, one of the earliest in New York, still powers streetlights and some homes today.",
      "sourceSentenceIds": [
        19,
        20
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Wyoming%2C_New_York",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "A deep gorge with three major waterfalls, carved by the last Ice Age glacier, borders the village’s scenic area.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.ny.gov/counties/wyoming",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The Bryant Fleming House and the Wyoming Village Historic District are listed on the National Register of Historic Places.",
      "sourceSentenceIds": [
        22
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Wyoming%2C_New_York",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The village sits on New York State Route 19, overlooking Oatka Creek that flows northward past its east side.",
