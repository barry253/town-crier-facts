    {
      "id": 1,
      "text": "Cedar Grove, New Mexico, was once a bustling stage and freight stop on early transportation routes.",
      "sourceSentenceIds": [
        26
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Cedar_Grove%2C_New_Mexico",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "In the late 1800s, Cedar Grove grew as a key stagecoach hub linking Albuquerque and Santa Fe.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/cedar_grove_new_mexico",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The Cedar Grove Historical Society, founded in 1968, began preserving the town’s heritage under Leslie Jacobus’s leadership.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.cedargrovehistoricalsociety.org/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Volunteers transformed the Canfield Morgan House into a museum, honoring a bequest from farmer Courtenay Morgan.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.cedargrovehistoricalsociety.org/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Today, Cedar Grove functions as a Santa Fe suburb, a quiet residential community that grew after the railroad era.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/cedar_grove_new_mexico",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Juniper trees, locally called ‘cedars,’ dot Cedar Grove’s landscape, giving the town its name.",
