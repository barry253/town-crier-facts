  "facts": [
    {
      "id": 1,
      "text": "County Line’s name literally reflects its split between Jefferson and Blount counties, with the town straddling the county line.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://encyclopediaofalabama.org/article/county-line/"
    },
    {
      "id": 2,
      "text": "Early pioneers settled County Line in the 1800s, farming fertile valleys like Murphree’s along the Locust Fork of the Black Warrior River.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/county_line_alabama"
    },
    {
      "id": 3,
      "text": "Before formal organization, the area was part of Pine Mountain, centered around County Line Baptist Church and County Line Cemetery.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/county_line_alabama"
    },
    {
      "id": 4,
      "text": "County Line’s agricultural focus shifted from cotton and corn to diversified crops as industrialization and urbanization reduced farming’s viability by the late 20th century.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/county_line_alabama"
    },
    {
      "id": 5,
      "text": "The town officially incorporated on August 27, 1957, establishing its municipal government.",
      "sourceSentenceIds": [
        21
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/County_Line%2C_Alabama"
    },
    {
      "id": 6,
      "text": "County Line sits on the Blount Mountain Range, one of the foothills of the Appalachian Mountains.",
