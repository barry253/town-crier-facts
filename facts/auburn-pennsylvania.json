  "facts": [
    {
      "id": 1,
      "text": "Auburn was originally called Scotchman’s Lock, but the name changed to Auburn in 1842 when the Philadelphia and Reading Railroad arrived.",
      "sourceSentenceIds": [
        1,
        3,
        4
      ],
      "sourceLabels": [
        "Web source 1",
        "Wikipedia"
      ],
      "source": "https://auburnboroughpa.com/",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The first house in Auburn was built in the late 1830s by boatman Samuel Moyer, who also ran the town’s first store.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Auburn%2C_Pennsylvania",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The Schuylkill River cuts through Auburn, providing a natural waterway that shaped early settlement patterns.",
      "sourceSentenceIds": [
        14
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Auburn%2C_Pennsylvania",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Auburn’s terrain is steeply hilly to the north and gently rolling to the south, giving the borough a varied landscape.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Auburn%2C_Pennsylvania",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The borough’s land is mostly forested, with pockets of residential and agricultural areas reflecting its rural character.",
      "sourceSentenceIds": [
        13
