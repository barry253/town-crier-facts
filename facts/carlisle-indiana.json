  "facts": [
    {
      "id": 1,
      "text": "Carlisle takes its name from Lazarus Bourissa, a Potawatamie graduate of the Carey Mission granted land after the treaty that moved most Potawatamie west.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/New_Carlisle%2C_Indiana"
    },
    {
      "id": 2,
      "text": "Before becoming New Carlisle, the town was originally called Bourissa Hills in the early 19th century.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/New_Carlisle%2C_Indiana"
    },
    {
      "id": 3,
      "text": "Carlisle was planned by the railroad, and the gas boom later drew factories to the area.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://hometownhistorymaps.com/pages/history-of-carlisle-indiana"
    },
    {
      "id": 4,
      "text": "Historic Sanborn Fire Insurance Maps from 1905 to 1915 show Carlisle’s downtown, businesses, and schools, offering a window into the town’s past.",
      "sourceSentenceIds": [
