  "facts": [
    {
      "id": 1,
      "text": "Covent Garden was laid out in 1630 by Inigo Jones as London’s first modern square, a prototype for future estates.",
      "sourceSentenceIds": [
        13,
        21
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 2"
      ],
      "source": "https://en.wikipedia.org/wiki/Covent_Garden",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The square’s original church, St Paul’s, earned the nickname “Actors’ Church” and was built in 1633 for £4,000.",
      "sourceSentenceIds": [
        17
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Covent_Garden",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "In the 17th century, Covent Garden hosted one of London’s earliest coffee houses, Old Slaughter’s, operating from 1692 until 1843.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Covent_Garden",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The historic Rules restaurant, founded in 1798, claims the title of London’s oldest restaurant.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Covent_Garden",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The 4th Earl of Bedford commissioned Inigo Jones to design a church and terraces around a former Westminster Abbey garden, creating the Piazza.",
      "sourceSentenceIds": [
        14
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Covent_Garden",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The NoMad hotel opened in 2021, adding a 91‑room boutique stay and a museum of local police history to the square’s modern mix.",
