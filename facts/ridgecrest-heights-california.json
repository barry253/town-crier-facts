      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.ridgecrestneighborhood.org/about-ridgecrest/ridgecrest-history",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The original Ridgecrest plat offered 272 lots with streets, water and lights for $250 to $394 each.",
      "sourceSentenceIds": [
