  "facts": [
    {
      "id": 1,
      "text": "Elkton was platted on January 25, 1887, by W.E., marking the town's formal layout before it grew into a small community.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Elkton%2C_Minnesota",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Elkton was officially incorporated on January 2, 1906, establishing its municipal government and paving the way for local services.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Elkton%2C_Minnesota",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "On January 30, 1906, residents elected a city council president, three councilmen, a recorder, a treasurer, two justices of the peace, two constables, and an assessor.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Elkton%2C_Minnesota",
      "category": "other",
      "quality": "poor",
      "qualityReason": "other"
    },
    {
      "id": 4,
      "text": "A sidewalk was built on Main Street in 1908, electricity arrived in the late 1920s, and a water system was installed in 1946.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Elkton%2C_Minnesota",
      "category": "other",
      "quality": "poor",
      "qualityReason": "editorial_filler"
    },
    {
      "id": 5,
      "text": "In 1965, Elkton upgraded its streets by adding curbs, gutters, and new roadways, improving traffic flow and drainage.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Elkton%2C_Minnesota",
      "category": "other",
      "quality": "poor",
      "qualityReason": "other"
    },
    {
      "id": 6,
      "text": "Elkton sits in central Mower County, 15 miles east of the county seat, and is drained by Schwerin Creek, which feeds Rose Creek, a Cedar River tributary.",
      "sourceSentenceIds": [
        11,
        13
      ],
