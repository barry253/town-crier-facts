  "facts": [
    {
      "id": 1,
      "text": "Lily Dale was incorporated in 1879 as Cassadaga Lake Free Association, a camp for Spiritualists and Freethinkers.",
      "sourceSentenceIds": [
        21
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Lily_Dale%2C_New_York"
    },
    {
      "id": 2,
      "text": "The community's name changed to The City of Light in 1903 and finally to Lily Dale Assembly in 1906, reflecting its spiritual focus.",
      "sourceSentenceIds": [
        22
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Lily_Dale%2C_New_York"
    },
    {
      "id": 3,
      "text": "The Lily Dale Museum now occupies an 1890 one‑room schoolhouse, preserving early pioneer landmarks.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.lilydaleassembly.org/history"
    },
    {
      "id": 4,
      "text": "Skidmore Library, located on Cottage Row, holds the world’s largest collection of Spiritualist books and is a non‑circulating research library.",
      "sourceSentenceIds": [
        12,
        13
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.lilydaleassembly.org/history"
    },
    {
      "id": 5,
      "text": "Every summer Lily Dale Assembly charges admission, but the town remains free to visit at other times, allowing many to experience mediumship demonstrations.",
      "sourceSentenceIds": [
        29
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Lily_Dale%2C_New_York"
    },
    {
      "id": 6,
      "text": "Lily Dale sits on the east side of Upper Cassadaga Lake, one of four lakes in the Cassadaga system, at an elevation of about 1,325 feet.",
      "sourceSentenceIds": [
        25
      ],
