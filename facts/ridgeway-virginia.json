      "id": 1,
      "text": "Ridgeway got its name when the Charlotte and South Carolina Railway chose the ridgeway route instead of Camden, sparking the town’s early growth.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
