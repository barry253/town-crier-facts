  "facts": [
    {
      "id": 1,
      "text": "Trommald was founded as a mining town on the western end of the Cuyuna iron range, just north of Ironton.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Trommald%2C_Minnesota"
    },
    {
      "id": 2,
      "text": "The town’s post office operated from 1917 to 1967, and a Northern Pacific Railroad station once served the community.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.lakesnwoods.com/Trommald.htm"
    },
    {
      "id": 3,
      "text": "Trommald was incorporated in 1917, the same year its post office opened.",
      "sourceSentenceIds": [
        14
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Trommald%2C_Minnesota"
    },
    {
      "id": 4,
      "text": "County Roads 30, 34, and Iverson Road are Trommald’s primary routes today.",
      "sourceSentenceIds": [
        15
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Trommald%2C_Minnesota"
    },
    {
      "id": 5,
      "text": "Trommald is part of the Brainerd Micropolitan Statistical Area, linking it to the regional economy.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Trommald%2C_Minnesota"
    },
    {
      "id": 6,
      "text": "From 1904 to 1930, Trommald served as the county registrar of deeds, handling land records for Crow Wing County.",
