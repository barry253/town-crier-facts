  "facts": [
    {
      "id": 1,
      "text": "Wilkeson was founded over 140 years ago on coal and sandstone mining, a legacy still visible in its historic coke ovens.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.visitpiercecounty.com/blog/post/a-love-letter-to-the-small-town-of-wilkeson/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town’s name honors Samuel Wilkeson, father of journalist Frank Wilkeson.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Wilkeson%2C_Washington",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Wilkeson’s Holy Trinity Orthodox Church is Washington’s oldest Orthodox church, and the Wilkeson School, built in 1909, sits on the National Register.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Wilkeson%2C_Washington",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "At its peak, Wilkeson boasted a newspaper, cigar factory, two electric plants, two theaters, two bakeries, and a bottling plant.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Wilkeson%2C_Washington",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Every third Saturday in July, locals race handcars down the old railroad tracks in the annual Wilkeson Handcar Races.",
      "sourceSentenceIds": [
        20
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.visitpiercecounty.com/blog/post/a-love-letter-to-the-small-town-of-wilkeson/",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The town’s 30 remaining coke ovens, relics of its coal industry, are listed on the National Register of Historic Places.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
