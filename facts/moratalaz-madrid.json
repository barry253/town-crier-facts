      "quality": "good"
    },
    {
      "id": 2,
      "text": "Before 1960, Moratalaz consisted of barely 40 houses and only one paved street.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Moratalaz",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The 1960s Colonia del Ferrocarril housing project sparked rapid expansion in Moratalaz.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Moratalaz",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "A stop for the Madrid‑Arganda train line helped turn Moratalaz from a small village into a growing suburb.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Moratalaz",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The 1970s development plan introduced wide avenues separated from traffic by green medians, a design now praised for reducing noise.",
      "sourceSentenceIds": [
        12,
