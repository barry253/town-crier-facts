  "facts": [
    {
      "id": 1,
      "text": "Unionville sits exactly where Ashtabula and Lake counties meet, making the name a literal “union” of two jurisdictions.",
      "sourceSentenceIds": [
        23,
        27
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://kids.kiddle.co/Unionville,_Ashtabula_County,_Ohio",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The community is unincorporated, so it has no city government and instead falls under the administration of the surrounding counties.",
      "sourceSentenceIds": [
        20,
        21,
        22
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://kids.kiddle.co/Unionville,_Ashtabula_County,_Ohio",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Unionville’s most famous landmark is the Connecticut Land Company land office, a key site in Ohio’s early settlement history.",
      "sourceSentenceIds": [
        2,
        3
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://kids.kiddle.co/Unionville,_Ashtabula_County,_Ohio",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "That historic land office earned a place on the National Register of Historic Places for its importance to the state’s development.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://kids.kiddle.co/Unionville,_Ashtabula_County,_Ohio",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Drivers passing through Unionville will notice State Route 84 running right through the community, a main corridor for local traffic.",
