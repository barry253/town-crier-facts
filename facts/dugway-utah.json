  "facts": [
    {
      "id": 1,
      "text": "Dugway is a closed city located inside the United States Army's large weapons testing facility, the Dugway Proving Ground.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Dugway%2C_Utah"
    },
    {
      "id": 2,
      "text": "The name Dugway comes from a technique to dig a trench along a hillside to keep a wagon from tipping.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Dugway%2C_Utah"
    },
    {
      "id": 3,
      "text": "Modern Dugway was officially established in 1942 to serve as a residential area for military and civilian personnel.",
      "sourceSentenceIds": [
        3,
        27
      ],
      "sourceLabels": [
        "Web source 2",
        "Web source 1"
      ],
      "source": "https://www.kupi.com/en/explore/united-states/dugway/history"
    },
    {
      "id": 4,
      "text": "Captain James Simpson charted a route through this area in 1859 that later became part of the Pony Express trail.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.kupi.com/en/explore/united-states/dugway/history"
    },
    {
      "id": 5,
      "text": "Dugway's location in the Great Salt Lake Desert provided the remoteness necessary for establishing a military testing center.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
