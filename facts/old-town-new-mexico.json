  "facts": [
    {
      "id": 1,
      "text": "Old Town was founded in 1706 when Spanish families first settled here.",
      "sourceSentenceIds": [
        20
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.visitalbuquerque.org/about-abq/neighborhoods/historic-old-town/"
    },
    {
      "id": 2,
      "text": "El Camino Real de Tierra Adentro once ran through Old Town Plaza, linking Mexico City to New Mexico’s Spanish capitals.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.visitalbuquerque.org/about-abq/neighborhoods/historic-old-town/"
    },
    {
      "id": 3,
      "text": "Most buildings in Old Town are adobe, yet the railroad’s arrival introduced Victorian and other architectural styles.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.visitalbuquerque.org/about-abq/neighborhoods/historic-old-town/"
    },
    {
      "id": 4,
      "text": "San Felipe de Neri Church anchors Old Town Plaza, rebuilt in 1793 after the original collapsed.",
      "sourceSentenceIds": [
        21
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.visitalbuquerque.org/about-abq/neighborhoods/historic-old-town/"
    },
    {
      "id": 5,
      "text": "Today Old Town serves as Albuquerque’s cultural hub, hosting museums, over 100 shops, galleries, and restaurants.",
      "sourceSentenceIds": [
        18
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.visitalbuquerque.org/about-abq/neighborhoods/historic-old-town/"
    },
    {
      "id": 6,
      "text": "Old Town straddles the Mimbres River, which flows south toward Deming, the Luna county seat.",
      "sourceSentenceIds": [
        15
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
