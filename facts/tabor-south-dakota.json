  "facts": [
    {
      "id": 1,
      "text": "Tabor is named after the town of Tábor in the Czech Republic, the native land of many early settlers.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Tabor%2C_South_Dakota"
    },
    {
      "id": 2,
      "text": "Czech immigrants began arriving in the late 1860s to find a better life and avoid military service in the Austrian-Hungarian army.",
      "sourceSentenceIds": [
        22
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.taborsd.city/about"
    },
    {
      "id": 3,
      "text": "The first Czech settlers began establishing themselves in Yankton and Bon Homme Counties starting in 1869.",
      "sourceSentenceIds": [
        25
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.taborsd.city/about"
    },
    {
      "id": 4,
      "text": "The Milwaukee and Northwestern Railroads expanded through the region in 1905, bringing many more Czech pioneers to the area.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.taborsd.city/about"
    },
    {
