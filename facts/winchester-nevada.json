  "facts": [
    {
      "id": 1,
      "text": "Winchester was officially established on August 20, 1951, when county commissioners approved petitions to create two new towns in the area.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Winchester%2C_Nevada",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town’s name echoes its early history, as the southern Las Vegas Valley was called Paradise Valley since 1910 because of its fertile, high‑water‑table lands.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Winchester%2C_Nevada",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Casino mogul Gus Greenbaum and his peers lobbied the county to grant town status, preventing Las Vegas from annexing the land without approval.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Winchester%2C_Nevada",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Winchester is governed by the Clark County Commission, with guidance from a local Winchester Town Advisory Board.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Winchester%2C_Nevada",
      "category": "other",
      "quality": "poor",
      "qualityReason": "editorial_filler"
    },
    {
      "id": 5,
      "text": "Situated in the east‑central part of the Las Vegas Valley, Winchester lies just south of downtown Las Vegas.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Winchester%2C_Nevada"
    },
    {
      "id": 6,
      "text": "To the north it borders Las Vegas, to the west and south the CDP of Paradise, and to the east Sunrise Manor.",
      "sourceSentenceIds": [
        8
      ],
