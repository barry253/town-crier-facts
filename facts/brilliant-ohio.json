  "facts": [
    {
      "id": 1,
      "text": "Brilliant was named after the Brilliant Glass Company that once operated there.",
      "sourceSentenceIds": [
        1,
        5,
        9
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Brilliant%2C_Ohio"
    },
    {
      "id": 2,
      "text": "Philip Doddridge laid out the town in 1819, originally calling it Philipsburg.",
      "sourceSentenceIds": [
        3,
        14
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.jefferson.ohgenweb.org/brilliant.html"
    },
    {
      "id": 3,
      "text": "The town’s railway station was renamed Brilliant in 1856 to avoid confusion with other Ohio towns.",
      "sourceSentenceIds": [
        2,
        4
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Brilliant%2C_Ohio"
    },
    {
      "id": 4,
      "text": "In 1880 the Brilliant Glass Company built a factory at La Grange, cementing the town’s industrial identity.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Brilliant%2C_Ohio"
    },
    {
      "id": 5,
      "text": "Brilliant hosts a branch of the Public Library of Steubenville and Jefferson County, serving local residents.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Brilliant%2C_Ohio"
    },
    {
      "id": 6,
      "text": "After nearly 175 years, Brilliant disincorporated on November 24, 1993, ending its village status.",
      "sourceSentenceIds": [
