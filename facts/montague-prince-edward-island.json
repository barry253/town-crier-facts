      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Montague earned the nickname 'Montague the Beautiful' for its tree‑lined streets, tranquil river, and stately buildings.",
      "sourceSentenceIds": [
        5,
        7
      ],
      "sourceLabels": [
        "Wikipedia",
