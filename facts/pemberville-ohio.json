  "facts": [
    {
      "id": 1,
      "text": "Pemberville was platted in 1854 and named for James Pember, who built the town’s first frame house.",
      "sourceSentenceIds": [
        3,
        4
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Pemberville%2C_Ohio"
    },
    {
      "id": 2,
      "text": "The Pemberville Opera House, built in 1891, is Ohio’s oldest functioning opera house and sits on the town hall’s second floor.",
      "sourceSentenceIds": [
        26,
        27
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Pemberville%2C_Ohio"
    },
    {
      "id": 3,
      "text": "The village lies on the banks of the Portage River in Wood County, giving it a picturesque riverside setting.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Pemberville%2C_Ohio"
    },
    {
      "id": 4,
      "text": "Historic Pember-Furry House, a one‑room schoolhouse, blacksmith shop, smokehouse, and the opera house together transport visitors back to the 19th century.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.pembervillehistory.org/"
    },
    {
      "id": 5,
      "text": "A post office has been in operation in Pemberville since 1866, marking its long‑standing community presence.",
      "sourceSentenceIds": [
