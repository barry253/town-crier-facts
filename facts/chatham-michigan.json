  "facts": [
    {
      "id": 1,
      "text": "Chatham was named after Chatham, Ontario, Canada, where lumber company Sutherland Innis was headquartered.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Chatham%2C_Michigan"
    },
    {
      "id": 2,
      "text": "The village sprang up where the Munising Railway Company line crossed the township road, founded in 1896.",
      "sourceSentenceIds": [
        13
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Chatham%2C_Michigan"
    },
    {
      "id": 3,
      "text": "Logging dominated Chatham’s economy in the late 19th and early 20th centuries, with companies like Sutherland Innis, Cleveland‑Cliffs, Northwestern Cooperage, and Buckeye Company.",
      "sourceSentenceIds": [
        14
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Chatham%2C_Michigan"
    },
    {
      "id": 4,
      "text": "Chatham sits along M‑94, about 15 miles southwest of Munising, in Alger County’s Rock River Township.",
      "sourceSentenceIds": [
        12,
        11
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Chatham%2C_Michigan"
    },
    {
      "id": 5,
      "text": "The village’s history page is hosted on a site that breaks content into mini‑pages on specific subjects, all focused on Chatham and early Rock River Township.",
