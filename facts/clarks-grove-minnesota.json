      "id": 1,
      "text": "John Mead Clark and his wife Lucy settled the area in 1855, turning a grove of oak trees into the town that would become Clarks Grove.",
      "sourceSentenceIds": [
        3,
        22
      ],
      "sourceLabels": [
        "Web source 1"
      ],
