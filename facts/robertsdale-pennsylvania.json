  "facts": [
    {
      "id": 1,
      "text": "Robertsdale was founded in 1872 as the original terminus of the East Broad Top Railroad, a key coal‑mining hub.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Robertsdale%2C_Pennsylvania",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The historic district contains 103 contributing buildings from the late 19th‑early 20th centuries, reflecting its mining heritage.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/robertsdale_historic_district",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Robertsdale sits on Broad Top Mountain’s eastern slope, halfway between Philadelphia and Pittsburgh, in rugged terrain that once limited access.",
      "sourceSentenceIds": [
        8,
        19
      ],
      "sourceLabels": [
        "Web source 1",
        "Wikipedia"
      ],
      "source": "https://grokipedia.com/page/robertsdale_historic_district",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Deep mining ended in the early 1950s, after which surface mining resumed in the late 2000s, keeping the area’s coal legacy alive.",
      "sourceSentenceIds": [
