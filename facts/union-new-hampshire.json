    },
    {
      "id": 2,
      "text": "Citizens of Union formally named their community during an Independence Day celebration on July 4, 1822.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/union_new_hampshire"
    },
    {
      "id": 3,
      "text": "By the 1820s, Union was a thriving village featuring a tannery, yarn factory, sawmill, gristmill, and blacksmith shop.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.uisgebeatha.org/unionhistorychapter1.html"
    },
    {
      "id": 4,
      "text": "The Eastern Railroad established Union as its northern terminus in 1854, making the village a hub for farmers shipping goods to Boston.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/union_new_hampshire"
    },
    {
