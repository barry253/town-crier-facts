      "id": 1,
      "text": "Douglas was founded as an American smelter town to treat copper ores from nearby Bisbee.",
      "sourceSentenceIds": [
        27
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Douglas%2C_Arizona",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The Gadsden Hotel, a five‑story, 160‑room landmark opened in 1907, now listed on the National Register of Historic Places.",
      "sourceSentenceIds": [
        4,
        15,
        16
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Douglas%2C_Arizona",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The El Paso and Southwestern Railroad depot once served as a key train station; today it houses the Douglas police station.",
      "sourceSentenceIds": [
        6,
        7
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Douglas%2C_Arizona",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Douglas borders Mexico at the Agua Prieta crossing, a historic trade link that dates back to the town’s founding.",
      "sourceSentenceIds": [
        13
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Douglas%2C_Arizona",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The Douglas‑Williams House, now a museum, lets visitors step into the town’s early 20th‑century life.",
