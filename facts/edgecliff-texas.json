      "id": 1,
      "text": "Edgecliff Village became an official town on January 20, 1951, after a 31‑to‑1 vote following a petition presented in December 1950.",
      "sourceSentenceIds": [
        22,
        23,
        24
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://evgov.org/our-history",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town’s growth surged after Carswell Air Force Base opened in the 1940s and General Dynamics plants arrived in the 1950s.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/edgecliff_village_texas",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Edgecliff II began construction in 1969, followed by Edgecliff III in 1978, keeping the town’s residential boom alive into the 1970s.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/edgecliff_village_texas"
    },
    {
      "id": 4,
      "text": "A new City Hall and Community Center opened in 1990, replacing the small hall built in 1965.",
      "sourceSentenceIds": [
        27
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://evgov.org/our-history",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The Fort Worth Star‑Telegram maintains a printing plant inside Edgecliff Village, making it the town’s largest business.",
      "sourceSentenceIds": [
        21
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Edgecliff_Village%2C_Texas",
