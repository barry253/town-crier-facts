  "facts": [
    {
      "id": 1,
      "text": "Pulaski was named after Polish Count Casimir Pulaski, with the town founded in 1900.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.bullochhistory.com/marker-pulaski"
    },
    {
      "id": 2,
      "text": "In 1901 Pulaski became a railroad town, appearing on the Savannah‑to‑Dublin passenger service.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.bullochhistory.com/marker-pulaski"
    },
    {
      "id": 3,
      "text": "Pulaski was officially incorporated in 1905, solidifying its municipal status.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.bullochhistory.com/marker-pulaski"
    },
    {
      "id": 4,
      "text": "Early Pulaski hosted warehouses, a cotton gin, drug and shoe stores, a barber shop, and a turpentine factory.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.bullochhistory.com/marker-pulaski"
    },
    {
      "id": 5,
      "text": "Pulaski County, where the town lies, was established in 1808 from part of Laurens County.",
      "sourceSentenceIds": [
        15
      ],
