  "facts": [
    {
      "id": 1,
      "text": "Santa Fe’s name comes from the 16th‑century Pueblo Hospital founded by Vasco de Quiroga in 1532.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Santa_Fe%2C_Mexico_City"
    },
    {
      "id": 2,
      "text": "In 1926 the Old Santa Fe Association was formed to preserve historic buildings and guide growth while keeping the city’s Spanish‑Pueblo adobe style.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.santafe.org/visiting-santa-fe/about-santa-fe/history/"
    },
    {
      "id": 3,
      "text": "The city’s modern zoning code, passed in 1958, requires new buildings to follow the traditional Spanish‑Pueblo adobe and wood construction.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.santafe.org/visiting-santa-fe/about-santa-fe/history/"
    },
    {
      "id": 4,
      "text": "Santa Fe’s history stretches back to pre‑conquest Pueblo villages dated between 1050 and 1150, long before Spanish arrival.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.santafe.org/visiting-santa-fe/about-santa-fe/history/"
    },
    {
      "id": 5,
      "text": "The arrival of the telegraph in 1868 and the railroad in 1880 sparked an economic boom that reshaped Santa Fe and New Mexico.",
      "sourceSentenceIds": [
        11
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.santafe.org/visiting-santa-fe/about-santa-fe/history/"
    },
    {
      "id": 6,
      "text": "Santa Fe Plaza, the historic downtown heart, hosts music, festivals, food, and shopping, reflecting the city’s cultural life.",
      "sourceSentenceIds": [
        15
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.santafenm.info/"
    }
  ]
