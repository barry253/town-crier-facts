  "facts": [
    {
      "id": 1,
      "text": "Lake George earned its name in 1847 when federal surveyors honored chief surveyor George Arbuckle after a 1845 Dakota‑Ojibwe clash on its southern shore.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/lake_george_anoka_county_minnesota",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Lake George formed as a kettle lake during the late Pleistocene, carved by the retreating Des Moines Lobe of the Laurentide Ice Sheet.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/lake_george_anoka_county_minnesota",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Higher lake stages, ranging historically from 899.5 to 903 feet above sea level, often reduce clarity by flushing sediments and nutrients during wet periods.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/lake_george_anoka_county_minnesota",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Largemouth bass thrive in Lake George, with trophy‑sized individuals common among the average‑abundance population.",
      "sourceSentenceIds": [
        19
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.dnr.state.mn.us/areas/fisheries/eastmetro/lakes/george.html",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Eurasian watermilfoil has invaded Lake George, prompting boat‑owners to remove visible plants before leaving the lake.",
      "sourceSentenceIds": [
        28
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.dnr.state.mn.us/areas/fisheries/eastmetro/lakes/george.html",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Lake George celebrated its 40th annual Blueberry Festival in July 2024, drawing visitors to taste local berries.",
      "sourceSentenceIds": [
