  "facts": [
    {
      "id": 1,
      "text": "Powhatan was originally called Scottville after Revolutionary War hero General Charles Scott, later renamed after Chief Powhatan, Pocahontas’s father.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Powhatan%2C_Virginia",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The first official court in Powhatan met at Mosby Tavern, the home of Benjamin Mosby and his son Littleberry Mosby.",
      "sourceSentenceIds": [
        11
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Powhatan%2C_Virginia",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Powhatan Plantation, built in 1735, still stands today as a rare surviving colonial structure.",
      "sourceSentenceIds": [
        13,
        14
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Powhatan%2C_Virginia",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Powhatan County’s historic Courthouse Square showcases Greek Revival architecture and one of Virginia’s best‑preserved taverns.",
      "sourceSentenceIds": [
        26
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.metrorichmond.com/region/powhatan-va",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The county’s laid‑back pace and scenic beauty make it a retiree’s dream, highlighted by the Powhatan Village Farmers Market and Maxey’s historic general store.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.metrorichmond.com/region/powhatan-va",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Powhatan’s natural trails at Powhatan State Park offer birdwatching and riverside views, perfect for a leisurely stroll.",
