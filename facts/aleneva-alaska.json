  "facts": [
    {
      "id": 1,
      "text": "Aleneva sprang in 1999 when Russian Old Believers bought land on Afognak Island, absorbing the abandoned Alutiiq village of Afognak.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/aleneva_alaska",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Aleneva enjoys a maritime climate with mild temperatures and high humidity, echoing Southeast Alaska but with noticeably less rainfall.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/aleneva_alaska",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The Japan Current keeps Aleneva’s waters warm, giving the Kodiak Archipelago a milder climate than inland Alaska.",
      "sourceSentenceIds": [
        4,
        17
      ],
      "sourceLabels": [
        "Web source 1",
        "Wikipedia"
      ],
      "source": "https://grokipedia.com/page/aleneva_alaska",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Russian Old Believers, fleeing 1917 Bolshevik persecution, first settled in Woodburn, Oregon before establishing Aleneva in Alaska.",
      "sourceSentenceIds": [
