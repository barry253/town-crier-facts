      "quality": "good"
    },
    {
      "id": 2,
      "text": "The Pueblo of Cuyamungue was repeatedly occupied and abandoned over centuries, as shown by its construction phases.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 1"
      ],
