  "facts": [
    {
      "id": 1,
      "text": "Lakewood began as the nation’s first post‑war planned community, with 17,500 houses built on 3,500 acres between 1950 and 1953.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://lacountylibrary.org/lakewood-local-history/"
    },
    {
      "id": 2,
      "text": "The Iacoboni Library, named for Lakewood’s first mayor, opened its doors in 1954, becoming the city’s first public library.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Lakewood%2C_California"
    },
    {
      "id": 3,
      "text": "Lakewood officially became a city in 1960, marking its transition from a planned suburb to an incorporated municipality.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Lakewood%2C_California"
    },
    {
      "id": 4,
      "text": "In 1966, Lakewood launched the nation’s first day‑and‑night helicopter patrol program, pioneering continuous aerial law‑enforcement coverage.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Lakewood%2C_California"
    },
    {
      "id": 5,
      "text": "Lawyer John Sanford Todd founded the Lakewood Civic Council in May 1953, leading the community’s early fight against annexation.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.pbssocal.org/socal-focus/60-years-ago-lakewood-went-from-suburb-to-city"
    },
    {
      "id": 6,
      "text": "Lakewood celebrated its 60th anniversary of incorporation in 2014, commemorating the city’s growth from beet fields to boulevards.",
      "sourceSentenceIds": [
        10
