  "facts": [
    {
      "id": 1,
      "text": "Tylertown began as Magee Settlement, founded by the Magee and Thornhill families who moved from South Carolina in 1816.",
      "sourceSentenceIds": [
        17,
        18,
        19,
        12
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 2"
      ],
      "source": "https://en.wikipedia.org/wiki/Tylertown%2C_Mississippi",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "From 1848 to 1879, the town was called Conerly's, before shortening its name to Tylertown in 1894.",
      "sourceSentenceIds": [
        20,
        22,
        23
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Tylertown%2C_Mississippi",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Tylertown became the county seat of newly formed Walthall County in 1912, carved from Pike and Marion counties.",
      "sourceSentenceIds": [
        26,
        15
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Tylertown%2C_Mississippi",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The 1906 Fernwood & Gulf railroad brought lumber to Tylertown, fueling a local logging boom.",
      "sourceSentenceIds": [
