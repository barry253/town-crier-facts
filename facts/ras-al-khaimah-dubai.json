  "facts": [
    {
      "id": 1,
      "text": "Ras Al Khaimah translates to \"Headland of the Tent,\" a nod to its historic palm‑frond architecture.",
      "sourceSentenceIds": [
        13,
        14
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Ras_Al_Khaimah",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "A creek bisects the city, separating the old western town from the newer Al Nakheel district.",
      "sourceSentenceIds": [
        11
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Ras_Al_Khaimah",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Archaeological digs reveal continuous human habitation for 7,000 years, with Neolithic artifacts still uncovered.",
      "sourceSentenceIds": [
        15,
        4
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Ras_Al_Khaimah",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The city rose from the former port of Julfar, eclipsing it in the early 17th century as a regional trade hub.",
      "sourceSentenceIds": [
        12,
        3
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Ras_Al_Khaimah",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Ibn Majid, the 15th‑century navigator and cartographer, was born in Ras Al Khaimah, which then outshone Julfar as a maritime center.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Ras_Al_Khaimah",
      "category": "people",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Ras Al Khaimah lies just 79 km from Dubai, a short drive for weekend explorers.",
      "sourceSentenceIds": [
        1
      ],
