  "facts": [
    {
      "id": 1,
      "text": "Post Mountain’s roots trace back to the Wintu tribe, who called the area Nor Rel Muk Wintu Nation long before Euro-American fur trappers arrived.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/post_mountain_california",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The community sits in a high fire‑hazard zone, where historic suppression and climate change have spiked wildfire frequency and intensity.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/post_mountain_california",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Perched at 3,264 feet, Post Mountain lies along State Route 36, about 15 miles southwest of Hayfork and nine miles northeast of Forest Glen.",
      "sourceSentenceIds": [
        15
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/post_mountain_california",
      "category": "other",
      "quality": "poor",
      "qualityReason": "location_description"
    },
    {
      "id": 4,
      "text": "In the 1970s counterculture settlers began cultivating cannabis here, cementing Post Mountain’s place in the Emerald Triangle’s famed marijuana industry.",
      "sourceSentenceIds": [
        17
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/post_mountain_california",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Soils range from sandstone and schist to serpentine, the latter’s magnesium and heavy metals limiting agriculture but supporting resilient native flora.",
      "sourceSentenceIds": [
        18
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/post_mountain_california",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Post Mountain enjoys a Mediterranean climate: hot, dry summers, cool, wet winters, with about 42 inches of rain mostly falling between October and April.",
      "sourceSentenceIds": [
        28
      ],
