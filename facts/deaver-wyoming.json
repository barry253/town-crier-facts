  "facts": [
    {
      "id": 1,
      "text": "Deaver was named for Clem Deaver, who served as the immigration commissioner for the Chicago, Burlington and Quincy Railroad.",
      "sourceSentenceIds": [
        1,
        6
      ],
      "sourceLabels": [
        "Web source 1",
        "Web source 2"
      ],
      "source": "https://www.usacitiesonline.com/wycountydeaver.htm"
    },
    {
      "id": 2,
      "text": "Deaver was formally incorporated in 1919 to support families establishing farms during a regional settlement boom.",
      "sourceSentenceIds": [
        3,
        13
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/deaver_wyoming"
    },
    {
      "id": 3,
      "text": "The surrounding area relies on the historic Shoshone Reclamation Project to divert river water across the arid plains.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/deaver_wyoming"
    },
    {
      "id": 4,
      "text": "Civilian Conservation Corps Camp Deaver was established in 1935 to employ young men in reforestation and erosion control.",
      "sourceSentenceIds": [
        11
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/deaver_wyoming"
    },
    {
      "id": 5,
      "text": "Deaver serves as an agricultural community supporting farming and ranching on irrigated lands along the Shoshone River.",
      "sourceSentenceIds": [
        13
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/deaver_wyoming"
    },
    {
      "id": 6,
      "text": "The coldest temperature ever recorded in Deaver was minus 42 degrees Fahrenheit on December 13, 1919.",
