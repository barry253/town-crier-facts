  "facts": [
    {
      "id": 1,
      "text": "Clarksburg started as a post village around 1850, its roots tracing back to a humble mail stop.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://clarksburgtn.org/?SEC=82607594-4EF2-4F6F-A4D4-5151FB1D0D32"
    },
    {
      "id": 2,
      "text": "The town’s first post office opened July 8, 1847, located where Roans Creek now flows.",
      "sourceSentenceIds": [
        17
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://clarksburgtn.org/?SEC=82607594-4EF2-4F6F-A4D4-5151FB1D0D32"
    },
    {
      "id": 3,
      "text": "On March 28, 1857, the village renamed itself Clarksburg to honor postmaster John Kelly Clark.",
      "sourceSentenceIds": [
        18
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://clarksburgtn.org/?SEC=82607594-4EF2-4F6F-A4D4-5151FB1D0D32"
    },
    {
      "id": 4,
      "text": "Early Clarksburg boasted five saloons and four doctors, a lively mix for a small frontier town.",
      "sourceSentenceIds": [
        21
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://clarksburgtn.org/?SEC=82607594-4EF2-4F6F-A4D4-5151FB1D0D32"
    },
    {
      "id": 5,
      "text": "Clarksburg proudly hosts its own high school, serving the town’s youth.",
