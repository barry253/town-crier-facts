  "facts": [
    {
      "id": 1,
      "text": "Fort Loudoun was built in 1756 during the French and Indian War, and the modern site covers 207 acres.",
      "sourceSentenceIds": [
        1,
        2
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://pabucketlist.com/exploring-the-fort-loudoun-historic-site-in-franklin-county-pa/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The fort’s name honors John Campbell, the fourth Earl of Loudoun, who became commander of British forces in North America in July 1756.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://pabucketlist.com/exploring-the-fort-loudoun-historic-site-in-franklin-county-pa/",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Every year, reenactors in colonial attire demonstrate everyday skills, turning the fort into a living classroom for visitors of all ages.",
      "sourceSentenceIds": [
        2,
        3
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://pabucketlist.com/exploring-the-fort-loudoun-historic-site-in-franklin-county-pa/",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The historic site hosts an annual Market Fair where artisans and historians showcase colonial trades and life, drawing crowds each summer.",
      "sourceSentenceIds": [
        28
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://pabucketlist.com/exploring-the-fort-loudoun-historic-site-in-franklin-county-pa/",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Conococheague Creek winds through the property, offering hiking trails that let visitors explore the natural landscape that surrounded the original fort.",
      "sourceSentenceIds": [
        29
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://pabucketlist.com/exploring-the-fort-loudoun-historic-site-in-franklin-county-pa/",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "In 1939, the “Allegheny Uprising” film about the fort starred Claire Trevor and John Wayne, linking the site to Hollywood history.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 2"
      ],
