  "facts": [
    {
      "id": 1,
      "text": "Fredericksburg was founded in 1761 by Frederick Stump, originally called Stumpstown.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://digitalarchives.powerlibrary.org/papd/islandora/object/papd%3Aplecl-fphi"
    },
    {
      "id": 2,
      "text": "The town’s historic Eagle Hotel, renamed in 1912 by Albert Zimmerman, dates back to 1866 as Travelers Repose.",
      "sourceSentenceIds": [
        3,
        28
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://digitalarchives.powerlibrary.org/papd/islandora/object/papd%3Aplecl-fphi"
    },
    {
      "id": 3,
      "text": "Bell & Evans, a poultry processing giant headquartered in Fredericksburg, remains the town’s main employer today.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://digitalarchives.powerlibrary.org/papd/islandora/object/papd%3Aplecl-fphi"
    },
    {
      "id": 4,
      "text": "The Fredericksburg Area Museum sits in the 1816 Town Hall/Market House and preserves regional history.",
      "sourceSentenceIds": [
        11,
        12
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.whatsoninfredericksburg.com/attractions-places-to-visit/"
    },
    {
      "id": 5,
      "text": "Fredericksburg’s tourist scene centers on colonial and Revolutionary sites like George Washington’s Ferry Farm and the Fredericksburg Battlefield.",
      "sourceSentenceIds": [
        9,
        10
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.whatsoninfredericksburg.com/attractions-places-to-visit/"
    },
    {
      "id": 6,
      "text": "The town’s German heritage and proximity to Fort Indiantown Gap have turned it from a rural farming community into a diverse suburb near New York City.",
      "sourceSentenceIds": [
        25
      ],
      "sourceLabels": [
        "Web source 1"
      ],
