  "facts": [
    {
      "id": 1,
      "text": "Penicuik’s name means \"hill of the cuckoo\" in Old Brythonic, and locals pronounce it \"Pennycook.\".",
      "sourceSentenceIds": [
        14,
        12
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Penicuik",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town lies on the west bank of the River North Esk, midway on the A701 between Edinburgh and Peebles.",
      "sourceSentenceIds": [
        12,
        13
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Penicuik",
      "category": "other",
      "quality": "poor",
      "qualityReason": "location_description"
    },
    {
      "id": 3,
      "text": "Agnes Campbell founded Valleyfield Mill in 1709, making Penicuik one of Scotland’s earliest paper‑making centres.",
      "sourceSentenceIds": [
        18
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Penicuik",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The 1803 Greenlaw Military Prison, later Glencorse Barracks, once held French prisoners of war from the Napoleonic Wars.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Penicuik",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Penicuik hosted the first Grand Match curling event in 1847 on the high pond of Penicuik House.",
      "sourceSentenceIds": [
        24,
        25
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Penicuik",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The Cowan Institute, now Penicuik Town Hall, was funded by the Cowan family and designed by Campbell Douglas in 1893.",
      "sourceSentenceIds": [
        28
      ],
      "sourceLabels": [
