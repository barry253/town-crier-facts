  "facts": [
    {
      "id": 1,
      "text": "West Monroe was originally laid out in 1837 as Byron by John Campbell at the foot of the ferry landing to Monroe, but the town floundered and Campbell went bankrupt.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/West_Monroe%2C_Louisiana",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "In 1854 doctor Christopher Dabbs submitted plans for Cotton Port, and the settlement was officially recognized in 1859.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/West_Monroe%2C_Louisiana",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Cotton Port grew into a bustling river port and rail depot once the Vicksburg, Shreveport and Pacific Railway arrived and a bridge was built over the Ouachita River.",
      "sourceSentenceIds": [
        8,
        9
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/West_Monroe%2C_Louisiana",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "West Monroe and neighboring Monroe are often called the Twin Cities of northeast Louisiana, sharing the Ouachita River.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/West_Monroe%2C_Louisiana",
      "category": "other",
      "quality": "poor",
      "qualityReason": "editorial_filler"
    },
    {
      "id": 5,
      "text": "The 2013 Community Impressions report praised West Monroe’s green spaces, naming Kiroli and Restoration parks as key assets to the community.",
      "sourceSentenceIds": [
        18
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/West_Monroe%2C_Louisiana",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Antique Alley, a historic shopping district, draws visitors to West Monroe’s largest shopping mall and locally owned restaurants.",
      "sourceSentenceIds": [
        24
