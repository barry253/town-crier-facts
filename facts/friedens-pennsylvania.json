  "facts": [
    {
      "id": 1,
      "text": "Friedens grew around a two‑story log building erected in 1783 that also served as a schoolhouse and community gathering place.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/friedens_pennsylvania",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "In 1917 the Madeira Hill Smithing Company built a company town called Waterloo near Friedens, operating until about 1940.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/friedens_pennsylvania",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The town’s name, Friedens, reflects its origins as a settlement of German‑speaking Protestants after the American Revolution.",
      "sourceSentenceIds": [
        13
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/friedens_pennsylvania",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Friedens sits within the Johnstown Metropolitan Statistical Area and lies west of Indian Lake and Shanksville, east of Somerset.",
      "sourceSentenceIds": [
        14,
        15
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Friedens%2C_Pennsylvania",
      "category": "other",
      "quality": "poor",
      "qualityReason": "location_description"
    },
    {
      "id": 5,
      "text": "The Windber Coal Heritage Center nearby preserves Friedens’ industrial past, showcasing artifacts from the region’s coal mining era.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://pennsylvaniainfo.blog/exploring-friedens-pennsylvania",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The community is surrounded mostly by family‑operated farms, giving it a distinctly rural character.",
      "sourceSentenceIds": [
        17
