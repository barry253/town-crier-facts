      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "East Lynnhaven Parish was established in 1895, with early meetings held in private homes before a dedicated church was built.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
