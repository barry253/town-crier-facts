      ],
      "source": "https://franklintwp.us/history/",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "McKnightstown sits within Franklin Township, which was formed in 1785.",
      "sourceSentenceIds": [
        14
      ],
