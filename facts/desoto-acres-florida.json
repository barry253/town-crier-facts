  "facts": [
    {
      "id": 1,
      "text": "DeSoto Acres was founded by William Van Dame, a Chicago businessman who moved to Sarasota in 1923.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://desotoacres.org/our-history/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The community began as Van Dame Estates, legally established on Feb 3, 1921, and renamed DeSoto Acres when re-platted on March 5, 1945.",
      "sourceSentenceIds": [
        15,
        20
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://desotoacres.org/our-history/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Covering over 850 acres, DeSoto Acres is the largest one-house-per-two-acres low‑density residential area in Sarasota County.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://desotoacres.org/our-history/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Horses are still part of the neighborhood, making DeSoto Acres unique in Sarasota County as the oldest subdivision outside city limits where equestrian activity remains common.",
      "sourceSentenceIds": [
        3,
        24
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://desotoacres.org/our-history/",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The earliest home dates from 1925, while the most recent was built in 2020, showing the community’s long building span.",
      "sourceSentenceIds": [
        23
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://desotoacres.org/our-history/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Native and migrating wildlife such as bald eagles, ospreys, sandhill cranes, and even occasional bobcats roam the lots, giving residents a front‑row seat to nature.",
      "sourceSentenceIds": [
        25
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://desotoacres.org/our-history/",
      "category": "nature",
      "quality": "good"
    }
