      "quality": "good"
    },
    {
      "id": 5,
      "text": "Four New London sites—John and Lavina Bangs House, McClellan's General Store, Peterson Manufacturing Building, and Smith and Weller Building—are on the National Register of Historic Places.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
