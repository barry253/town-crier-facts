  "facts": [
    {
      "id": 1,
      "text": "Fair Haven was named after early settler Ira Marks when Ira Township was created in 1837.",
      "sourceSentenceIds": [
        3,
        5
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Ira_Township%2C_Michigan",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "A French‑speaking Métis community called Rivière des Cygnes settled here before 1837, later translated to Swan Creek.",
      "sourceSentenceIds": [
        19,
        7
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Ira_Township%2C_Michigan",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Railroad tracks ran in front of the historic general store, marking the town’s brief rise as a summer resort.",
      "sourceSentenceIds": [
        10,
        6
      ],
      "sourceLabels": [
        "Web source 1",
        "Web source 1"
      ],
      "source": "https://thumbwind.com/2025/11/25/history-of-fair-haven-michigan/",
      "category": "landmark",
      "quality": "poor",
      "qualityReason": "vague"
    },
    {
      "id": 4,
      "text": "Fair Haven sits on the northern shore of Lake Saint Clair, about a mile and a half east‑southeast of Anchorville.",
      "sourceSentenceIds": [
        26,
        29
      ],
      "sourceLabels": [
        "Wikipedia",
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Ira_Township%2C_Michigan",
      "category": "other",
      "quality": "poor",
      "qualityReason": "location_description"
    },
    {
      "id": 5,
      "text": "The town’s early economy relied on fishing, farming, and moving goods through its marshy wetlands.",
