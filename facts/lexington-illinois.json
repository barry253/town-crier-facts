  "facts": [
    {
      "id": 1,
      "text": "Lexington was laid out on January 4 1836 by Asahel Gridley and James Brown amid a nationwide real estate boom.",
      "sourceSentenceIds": [
        29,
        30
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Lexington%2C_Illinois",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town’s name has two theories: it may honor the Battle of Lexington or James Brown’s hometown.",
      "sourceSentenceIds": [
        28,
        5,
        6
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Lexington%2C_Illinois",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Lexington’s growth was secured when the Chicago and Alton Railroad reached it on July 4 1854, making it a station between Springfield and Chicago.",
      "sourceSentenceIds": [
        9,
        10
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Lexington%2C_Illinois",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The Lexington Genealogical and Historical Society, known as The Fort, was founded in 1965 and is one of Illinois’ oldest genealogical societies.",
      "sourceSentenceIds": [
        2,
        4
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.lexingtonillinoishistorical.org/",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Lexington’s central public square, with streets running true north‑south and east‑west, was unique among towns founded during the 1836 boom.",
