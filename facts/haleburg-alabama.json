  "facts": [
    {
      "id": 1,
      "text": "Haleburg was founded in 1885 as 'Halesburgh' and officially incorporated in 1911 as 'Halesburg'.",
      "sourceSentenceIds": [
        18
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Haleburg%2C_Alabama"
    },
    {
      "id": 2,
      "text": "The town was named after early settler Jonathan Hale, though some records spell his surname as 'Hales'.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://encyclopediaofalabama.org/article/haleburg/"
    },
    {
      "id": 3,
      "text": "Haleburg’s first post office opened on October 10, 1871, and the town’s post office was later established on December 31, 1885.",
      "sourceSentenceIds": [
        1,
        3
      ],
      "sourceLabels": [
        "Web source 1",
        "Web source 2"
      ],
      "source": "https://encyclopediaofalabama.org/article/haleburg/"
    },
    {
      "id": 4,
      "text": "Monte Irvin, a Hall of Fame Major League Baseball player, was born in Haleburg in 1919.",
      "sourceSentenceIds": [
        30
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://encyclopediaofalabama.org/article/haleburg/"
    },
    {
      "id": 5,
      "text": "Haleburg lies just 4 miles west of the Chattahoochee River, the Alabama–Georgia border.",
      "sourceSentenceIds": [
        22
      ],
      "sourceLabels": [
