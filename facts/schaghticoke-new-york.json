  "facts": [
    {
      "id": 1,
      "text": "Schaghticoke takes its name from the 17th‑century Schaghticoke Native American tribe, a blend of eastern New York and New England peoples.",
      "sourceSentenceIds": [
        4,
        5
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 2"
      ],
      "source": "https://en.wikipedia.org/wiki/Schaghticoke%2C_New_York",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The first permanent European settlement in Schaghticoke began around 1668, largely by Dutch and English settlers.",
      "sourceSentenceIds": [
        24
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://greenerpasture.com/Places/Details/294",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The historic Knickerbocker Mansion in Schaghticoke earned a spot on the National Register of Historic Places in 1972.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Schaghticoke%2C_New_York",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "In 1854, a train on the Albany Northern Railroad broke an axle on a bridge near Schaghticoke, causing a fatal accident.",
      "sourceSentenceIds": [
        27,
        28
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://greenerpasture.com/Places/Details/294",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "A 1867 fire in Schaghticoke destroyed the cordage works of Spicer & Meeley and the twine factory of Tibbitts Briggs.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://greenerpasture.com/Places/Details/294",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Before European arrival, Schaghticoke was home to the Mohican tribe, later joined by remnants of New England tribes.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
