  "facts": [
    {
      "id": 1,
      "text": "Eureka was founded in the early 1880s by settlers moving north from Missoula and south from Canada, and was originally called Deweyville.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Eureka%2C_Montana",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Eureka sits on the Tobacco River in the Tobacco Valley, a name that echoes early explorers who called the area Tobacco Plains.",
      "sourceSentenceIds": [
        20
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Eureka%2C_Montana",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The Historical Village on the south side showcases the Tobacco Valley’s history, preserved by volunteers and the Tobacco Valley Board of History.",
      "sourceSentenceIds": [
        4,
        5,
        6,
        7,
        8
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 2"
      ],
      "source": "https://en.wikipedia.org/wiki/Eureka%2C_Montana",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Eureka’s two National Register sites are the Community Hall and the Farmers and Merchants State Bank.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Eureka%2C_Montana",
      "category": "landmark",
      "quality": "good"
