  "facts": [
    {
      "id": 1,
      "text": "Newton Circus was originally called Syed Ali Road before 1914 renaming after Howard Newton to avoid confusion with Syed Alwi Road.",
      "sourceSentenceIds": [
        1,
        2,
        6
      ],
      "sourceLabels": [
        "Web source 2",
        "Wikipedia"
      ],
      "source": "https://grokipedia.com/page/newton_singapore",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Newton Food Centre opened in 1971 as one of Singapore's earliest purpose-built hawker centers, becoming a community transport landmark.",
      "sourceSentenceIds": [
        11
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/newton_singapore",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The Goodwood Park Hotel, built in 1900, hosted British colonial elites and later symbolized Singapore's luxury hospitality.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.trawellino.com/destinations/singapore/01_newton",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Newton's urban development includes a planned influx of about 5,000 new homes around Newton Circus, creating residential towers, retail spaces, and green corridors.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/newton_singapore",
      "category": "other",
      "quality": "poor",
      "qualityReason": "editorial_filler"
    },
    {
      "id": 5,
      "text": "Newton’s name first appeared in early 20th‑century land surveys, initially covering rural tracts with nutmeg plantations before becoming an urban district.",
      "sourceSentenceIds": [
        15
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/newton_singapore",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Newton Circus is the junction where eight roads meet, a fact once called 'ethumuchandi' by Tamils meaning 'the eight junction place'.",
      "sourceSentenceIds": [
        21
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
