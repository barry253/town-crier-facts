  "facts": [
    {
      "id": 1,
      "text": "The Port Gamble S’Klallam Tribe, originally called Nux Sklai Yem or the Strong People, traces its ancestry back to the Salish people who settled the area around 2400 B.C.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://pgst.nsn.us/",
      "category": "people",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The tribal community occupies the east side of Port Gamble, an embayment of Hood Canal in northern Kitsap County, Washington.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Port_Gamble_Tribal_Community%2C_Washington",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "In the late 1930s the Port Gamble S’Klallam reservation was formally established on the northern tip of the Kitsap peninsula.",
      "sourceSentenceIds": [
        11
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://pgst.nsn.us/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Port Gamble was founded in 1853 as a mill town and still showcases 19th‑century New England architecture that defines its historic streetscape.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.portgamble.com/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Heronswood Garden, run by the Port Gamble S’Klallam Foundation in Kingston, hosts 9,000 plant species from six of the world’s seven continents.",
      "sourceSentenceIds": [
        22
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://pgst.nsn.us/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The Point Casino & Hotel in nearby Kingston is operated by the tribe through Noo‑Kayet Investments and employs more than 300 staff members.",
      "sourceSentenceIds": [
        21
      ],
      "sourceLabels": [
        "Web source 1"
