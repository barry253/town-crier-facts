      "quality": "good"
    },
    {
      "id": 3,
      "text": "Before 1968, Martin's Additions used racially restrictive covenants to exclude African‑Americans, as a 1905 deed barred colored people from owning property.",
      "sourceSentenceIds": [
        12,
        14
      ],
      "sourceLabels": [
        "Wikipedia"
