  "facts": [
    {
      "id": 1,
      "text": "Founded in 1833 by brothers Henry and Zine Steele, who stopped at a bend on the Grand River, Lamont began as a modest river landing.",
      "sourceSentenceIds": [
        1,
        7
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Tallmadge_Township%2C_Michigan",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "By 1835 the once‑small landing had grown into a bustling village with hotels, stores, a tannery, and a button factory, drawing settlers from nearby towns.",
      "sourceSentenceIds": [
        3,
        5
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://lamontcivicassoc.wixsite.com/lamontonthegrand/about-us",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "In 1855 Lamont became a regular steamboat and stagecoach stop, serving as a key waypoint along the Grand River.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://lamontcivicassoc.wixsite.com/lamontonthegrand/about-us",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The post office was renamed Lamont on July 2, 1856, cementing the town’s new identity in official records.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Tallmadge_Township%2C_Michigan",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Lamont sits on a graceful bend of the Grand River, preserving the riverfront charm that attracted its original settlers.",
      "sourceSentenceIds": [
        8
      ],
