  "facts": [
    {
      "id": 1,
      "text": "New Richmond was founded in 1857 and was originally called Foster's Crossing.",
      "sourceSentenceIds": [
        3,
        4
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/New_Richmond%2C_Wisconsin"
    },
    {
      "id": 2,
      "text": "The town was renamed after Richmond Day, the land surveyor who plotted the area.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/New_Richmond%2C_Wisconsin"
    },
    {
      "id": 3,
      "text": "Hiram Foster established the first permanent settlement in New Richmond to harvest virgin Wisconsin timber.",
      "sourceSentenceIds": [
        17
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/New_Richmond%2C_Wisconsin"
    },
    {
      "id": 4,
      "text": "New Richmond saw an influx of Irish, German, and Norwegian immigrants throughout the late nineteenth century.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/New_Richmond%2C_Wisconsin"
    },
    {
      "id": 5,
      "text": "The Willow River serves as a major source of hydrological water and is dammed near the center of town.",
      "sourceSentenceIds": [
        28
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/New_Richmond%2C_Wisconsin"
    },
    {
