  "facts": [
    {
      "id": 1,
      "text": "Darbyville was laid out in 1826 on land entered by Cornelius Baldwin, covering a modest area of fertile black loam soil.",
      "sourceSentenceIds": [
        2,
        11
      ],
      "sourceLabels": [
        "Web source 2",
        "Wikipedia"
      ],
      "source": "https://grokipedia.com/page/darbyville_ohio",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The village’s name comes from Big Darby Creek, named after an old Indian chief who once lived along its banks.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/darbyville_ohio",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "In 2009 a technology center opened in Darbyville, offering free broadband to residents and helping keep the rural community connected.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/darbyville_ohio",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Early settlers included Judge William Florence, who arrived in 1806, acquired up to 1,800 acres, and later served as a county commissioner.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/darbyville_ohio",
      "category": "people",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The village’s early economy relied on corn, wheat, and stock‑raising, thanks to the fertile black loam that characterizes the region.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 2"
