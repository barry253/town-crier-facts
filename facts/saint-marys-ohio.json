  "facts": [
    {
      "id": 1,
      "text": "Saint Marys was founded in 1823, named after the nearby Marys River that once powered early trading posts.",
      "sourceSentenceIds": [
        2,
        5,
        25
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/St._Marys%2C_Ohio"
    },
    {
      "id": 2,
      "text": "The town sits 11 miles west of Wapakoneta and 20 miles east of the Ohio–Indiana border, anchoring it in western Ohio.",
      "sourceSentenceIds": [
        22
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/St._Marys%2C_Ohio"
    },
    {
      "id": 3,
      "text": "Saint Marys is part of the Wapakoneta micropolitan area, linking it to a broader regional community.",
      "sourceSentenceIds": [
        23
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/St._Marys%2C_Ohio"
    },
    {
      "id": 4,
      "text": "In 1794, General Anthony Wayne’s troops passed through the area, marking the site’s early military significance.",
      "sourceSentenceIds": [
        28
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/St._Marys%2C_Ohio"
    },
    {
      "id": 5,
      "text": "William Henry Harrison built Fort Barbee on a nearby site after discovering the original fort in ruins, but the new fort was abandoned shortly afterward.",
      "sourceSentenceIds": [
