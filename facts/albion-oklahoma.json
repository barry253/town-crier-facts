    },
    {
      "id": 2,
      "text": "A townsite proprietor named Bailey gave Albion its name, which is the ancient Roman word for England.",
      "sourceSentenceIds": [
        7,
        8
      ],
      "sourceLabels": [
        "Web source 1",
        "Web source 2"
      ],
      "source": "https://www.okhistory.org/publications/enc/entry?entry=AL004"
    },
    {
      "id": 3,
      "text": "The Frisco Railroad once provided six trains per day to Albion until passenger service ended in the late 1950s.",
      "sourceSentenceIds": [
        12
