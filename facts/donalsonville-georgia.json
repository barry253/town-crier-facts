  "facts": [
    {
      "id": 1,
      "text": "Donalsonville was incorporated as the Town of Donalson in 1897 before becoming the City of Donalsonville.",
      "sourceSentenceIds": [
        1,
        25,
        26
      ],
      "sourceLabels": [
        "Web source 1",
        "Wikipedia"
      ],
      "source": "https://www.donalsonville-seminole.org/history-of-donalsonville/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town’s name honors John Ernest Donalson, a prominent 19th‑century businessman who built the first lumber mill and homes for workers.",
      "sourceSentenceIds": [
        2,
        21,
        22,
        23,
        24
      ],
      "sourceLabels": [
        "Web source 2",
        "Wikipedia"
      ],
      "source": "https://www.donalsonvillega.org/history",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "In 1920, Donalsonville was chosen as the county seat when Seminole County was created from parts of Early and Decatur counties.",
      "sourceSentenceIds": [
        4,
        14
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Donalsonville%2C_Georgia",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The Seminole County Courthouse, erected in 1922, still stands today and is listed on the National Register of Historic Places.",
      "sourceSentenceIds": [
        15,
        27
      ],
      "sourceLabels": [
        "Web source 1",
        "Wikipedia"
      ],
      "source": "https://www.donalsonville-seminole.org/history-of-donalsonville/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The town’s historic Church of the Nazarene, originally called “The Holiness Church,” opened its doors in October 1902.",
      "sourceSentenceIds": [
        10
      ],
