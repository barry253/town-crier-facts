  "facts": [
    {
      "id": 1,
      "text": "Farmington was settled by early groups of Baptists and various religious settlers from Georgia, Virginia, and the Carolinas.",
      "sourceSentenceIds": [
        23
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.ms.gov/agencies/city-farmington"
    },
    {
      "id": 2,
      "text": "The Farmington Baptist Church began around 1800, leading the state legislature to incorporate the surrounding area into a town by 1838.",
      "sourceSentenceIds": [
        24,
        27
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.ms.gov/agencies/city-farmington"
    },
    {
      "id": 3,
      "text": "By 1842, Farmington featured a diverse economy with a general store, a blacksmith, and a wheat-fan manufacturing plant.",
      "sourceSentenceIds": [
        30
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.ms.gov/agencies/city-farmington"
    },
    {
      "id": 4,
      "text": "Farmington Academy was chartered in 1839 to provide education near the town center.",
      "sourceSentenceIds": [
        29
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.ms.gov/agencies/city-farmington"
    },
    {
      "id": 5,
      "text": "Farmington began to decline after two railroads being constructed in the mid-nineteenth century bypassed the town by about four miles.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Farmington%2C_Mississippi"
    },
    {
      "id": 6,
      "text": "During the Civil War, the Union Army completely destroyed Farmington, tearing down houses to create breastworks and flooring for tents.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
