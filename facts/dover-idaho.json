  "facts": [
    {
      "id": 1,
      "text": "Dover began as Welty in 1906, founded by the president of the Dover Lumber Company.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://cityofdover.id.gov/about-dover/"
    },
    {
      "id": 2,
      "text": "In 1910 the town officially changed its name from Welty to Dover.",
      "sourceSentenceIds": [
        21
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://cityofdover.id.gov/about-dover/"
    },
    {
      "id": 3,
      "text": "After a mill fire, White Lumber Company moved its Dover mill and 55 buildings by barge from Laclede.",
      "sourceSentenceIds": [
        23,
        24,
        26
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://cityofdover.id.gov/about-dover/"
    },
    {
      "id": 4,
      "text": "The Dover Church, once White's summer cottage, was disassembled and reassembled in three pieces, still standing today.",
      "sourceSentenceIds": [
        27
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://cityofdover.id.gov/about-dover/"
    },
    {
      "id": 5,
      "text": "The Dover Community Baptist Church was consecrated in 1924, becoming a central place of worship.",
      "sourceSentenceIds": [
        28
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://cityofdover.id.gov/about-dover/"
    },
    {
      "id": 6,
      "text": "Dover’s early economy relied on a sawmill and factory that supplied thousands of acres of timber and millions of feet of lumber.",
      "sourceSentenceIds": [
