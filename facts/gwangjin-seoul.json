      "id": 1,
      "text": "Gwangjin-gu takes its name from the historic Gwangnaru ferry that once crossed the Han River near what is now Gwangjang‑dong.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 1"
      ],
