  "facts": [
    {
      "id": 1,
      "text": "Gwangjin-gu takes its name from the historic Gwangnaru ferry that once crossed the Han River near what is now Gwangjang‑dong.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.gwangjin.go.kr/eng/main/contents.do?menuNo=700009",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Gwangnaru and Ttukseom Ferries were ancient transport hubs where travelers crossed the Han River for centuries.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Gwangjin_District",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "For about 260 years, the area that is now Gwangjin-gu was a strategic battleground where the Three Kingdoms vied for control.",
      "sourceSentenceIds": [
        19
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.gwangjin.go.kr/eng/main/contents.do?menuNo=700009",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "In 1995, Seongdong-gu was split along Joongrang Creek, creating the modern district of Gwangjin-gu.",
      "sourceSentenceIds": [
        26
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.gwangjin.go.kr/eng/main/contents.do?menuNo=700009",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The Konkuk University campus in Gwangjin-gu draws students and locals alike to its vibrant nightlife scene.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Gwangjin_District",
      "category": "culture",
      "quality": "good"
    },
    {
