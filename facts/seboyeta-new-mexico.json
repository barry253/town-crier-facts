  "facts": [
    {
      "id": 1,
      "text": "Seboyeta was founded on March 16 1800 by a Spanish land grant, originally spelled Cebolleta, meaning 'little onion'.",
      "sourceSentenceIds": [
        6,
        21
      ],
      "sourceLabels": [
        "Web source 1",
        "Wikipedia"
      ],
      "source": "https://grokipedia.com/page/seboyeta_new_mexico"
    },
    {
      "id": 2,
      "text": "The historic Nuestra Señora de Los Dolores Catholic Church, built by 1820, still stands as a testament to Seboyeta’s early faith.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/seboyeta_new_mexico"
    },
    {
      "id": 3,
      "text": "Seboyeta became the mother village that spawned San Mateo in 1862, San Rafael in 1865, and El Concho in Arizona in 1869.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://cibola.nmgenweb.us/resources/abe_pena/memories/seboyeta.html"
    },
    {
      "id": 4,
      "text": "A military post named Cebolleta was established in 1849, later moved to San Rafael and renamed Fort Wingate in 1862.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Seboyeta%2C_New_Mexico"
    },
    {
      "id": 5,
      "text": "In 1746, Father Menchero started a Franciscan mission to the Navajos at Seboyeta, but it was abandoned within two years.",
      "sourceSentenceIds": [
        14
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://cibola.nmgenweb.us/resources/abe_pena/memories/seboyeta.html"
    },
    {
      "id": 6,
      "text": "The grant required settlers to form a regular settlement and never abandon it under any pretext.",
      "sourceSentenceIds": [
        15
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://cibola.nmgenweb.us/resources/abe_pena/memories/seboyeta.html"
