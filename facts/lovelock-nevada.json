  "facts": [
    {
      "id": 1,
      "text": "Lovelock was founded when the Central Pacific Railroad crossed the area in August 1868, becoming a key stop for miners and farmers.",
      "sourceSentenceIds": [
        9,
        3,
        19
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Lovelock%2C_Nevada"
    },
    {
      "id": 2,
      "text": "The town’s name honors George Lovelock, who donated 85 acres for the depot, leading to the station being called “Lovelock’s” on early maps.",
      "sourceSentenceIds": [
        5,
        1
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 2"
      ],
      "source": "https://en.wikipedia.org/wiki/Lovelock%2C_Nevada"
    },
    {
      "id": 3,
      "text": "In 1919, Lovelock became the county seat of newly formed Pershing County, carved from southern Humboldt County.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Lovelock%2C_Nevada"
    },
    {
      "id": 4,
      "text": "The historic Lovelock Depot, built in 1880, was restored by Union Pacific in 1999 and now serves as a local eatery.",
      "sourceSentenceIds": [
        12,
        13
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Lovelock%2C_Nevada"
    },
    {
      "id": 5,
      "text": "The Marzen House Museum, a Victorian farmhouse moved from Big Meadow Ranch, houses an assay office and vintage automobiles that reveal the town’s mining past.",
      "sourceSentenceIds": [
        11,
        18
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Lovelock%2C_Nevada"
    },
    {
      "id": 6,
      "text": "Lovelock’s annual newspaper, the Lovelock Review‑Miner, has been published continuously since 1908, first appearing as the Lovelock Review.",
