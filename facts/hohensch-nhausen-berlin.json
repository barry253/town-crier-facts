    {
      "id": 1,
      "text": "After the Berlin Wall fell, Hohenschönhausen prison escaped a storming, letting officials erase much of its evidence.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Berlin-Hohensch%C3%B6nhausen_Memorial"
    },
    {
      "id": 2,
      "text": "Former inmates founded the Hohenschönhausen Memorial in the early 1990s, turning the site into a remembrance center.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Berlin-Hohensch%C3%B6nhausen_Memorial"
    },
    {
      "id": 3,
      "text": "In 1945 a Soviet special camp was established on a former commercial kitchen, later becoming the Stasi prison.",
      "sourceSentenceIds": [
        11,
        21
      ],
      "sourceLabels": [
        "Web source 2",
        "Wikipedia"
      ],
      "source": "https://www.visitberlin.de/en/berlin-hohenschonhausen-memorial"
    },
    {
      "id": 4,
      "text": "The 700‑m² exhibition 'Imprisoned in Hohenschönhausen' displays rare objects, documents, and prisoners' letters from 1945‑1989.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.visitberlin.de/en/berlin-hohenschonhausen-memorial"
    },
    {
      "id": 5,
      "text": "The memorial highlights 44 years of political persecution, offering visitors a stark look at GDR history.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.visitberlin.de/en/berlin-hohenschonhausen-memorial"
    },
