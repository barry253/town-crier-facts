  "facts": [
    {
      "id": 1,
      "text": "Hohenschönhausen prison, once a Stasi detention center, was not stormed after the Berlin Wall fell, allowing authorities to destroy evidence.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Berlin-Hohensch%C3%B6nhausen_Memorial"
    },
    {
      "id": 2,
      "text": "The Hohenschönhausen Memorial was founded in the early 1990s by former inmates and opened to visitors in 1994.",
      "sourceSentenceIds": [
        2,
        4
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Berlin-Hohensch%C3%B6nhausen_Memorial"
    },
    {
      "id": 3,
      "text": "The site began as a Soviet special camp in 1945 on a former commercial kitchen, later becoming the Stasi prison.",
      "sourceSentenceIds": [
        11,
        21,
        22
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.visitberlin.de/en/berlin-hohenschonhausen-memorial"
    },
    {
      "id": 4,
      "text": "The permanent exhibition “Imprisoned in Hohenschönhausen” spans 700 m² and displays rare objects, letters, and photographs from 1945‑1989.",
      "sourceSentenceIds": [
        9,
        10
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.visitberlin.de/en/berlin-hohenschonhausen-memorial"
    },
    {
      "id": 5,
      "text": "Hohenschönhausen was largely industrial before WWII, with a red‑brick building completed in 1939.",
      "sourceSentenceIds": [
        19,
        20
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Berlin-Hohensch%C3%B6nhausen_Memorial"
    },
    {
      "id": 6,
      "text": "The memorial is one of few places in Germany that openly commemorates political persecution during the Soviet occupation and the GDR.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.visitberlin.de/en/berlin-hohenschonhausen-memorial"
    }
  ]
