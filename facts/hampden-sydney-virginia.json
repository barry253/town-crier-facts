  "facts": [
    {
      "id": 1,
      "text": "Hampden–Sydney College, founded November 10, 1775, is the last American college founded in British Colonial America and remains in continuous operation.",
      "sourceSentenceIds": [
        3,
        4
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.hsc.edu/about-h-sc/history"
    },
    {
      "id": 2,
      "text": "The college’s campus, 1,300 acres on Virginia’s Southside, includes a National Historic Preservation Zone at its center.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.hsc.edu/about-h-sc/history"
    },
    {
      "id": 3,
      "text": "Cushing Hall (built 1822) and Venable Hall (1825) are brick landmarks that showcase the college’s historic architecture.",
      "sourceSentenceIds": [
        6,
        13
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.hsc.edu/about-h-sc/history"
    },
    {
      "id": 4,
      "text": "Hampden–Sydney is part of the Road to Revolution Heritage Trail and the Civil Rights in Education Trail, linking it to national history.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.hsc.edu/about-h-sc/history"
    },
    {
      "id": 5,
      "text": "An 18th‑century legend says 70 soldiers died of smallpox after the Battle of Yorktown and were buried at the abandoned French’s Church in Kingsville.",
      "sourceSentenceIds": [
        15
      ],
      "sourceLabels": [
        "Web source 2"
