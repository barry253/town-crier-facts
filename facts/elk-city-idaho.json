  "facts": [
    {
      "id": 1,
      "text": "Elk City was founded in 1861 during the Pierce gold rush, marking the start of Idaho's early mining boom.",
      "sourceSentenceIds": [
        1,
        3
      ],
      "sourceLabels": [
        "Web source 2",
        "Wikipedia"
      ],
      "source": "https://www.islands.com/1795304/historic-isolated-idaho-town-elk-city-closest-true-nature-escape-lower-48-states/"
    },
    {
      "id": 2,
      "text": "The historic Elk City Wagon Road, celebrated in a 1990s centennial project, traces the original 19th‑century travel route.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Elk_City%2C_Idaho"
    },
    {
      "id": 3,
      "text": "Hard‑rock quartz‑vein mining surged around 1902, and dredging operations in the 1930s kept Elk City’s mining economy alive into the 20th century.",
      "sourceSentenceIds": [
        20
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Elk_City%2C_Idaho"
    },
    {
      "id": 4,
      "text": "A 1930 fire devastated much of Elk City, after which the town shifted from mining to timber, ranching, and recreation.",
      "sourceSentenceIds": [
        21
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Elk_City%2C_Idaho"
    },
    {
      "id": 5,
      "text": "Elk City serves as the gateway to the Magruder Trail, a thousand‑acre wilderness corridor that stretches into Montana.",
      "sourceSentenceIds": [
        23
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.freedomriveradventures.com/about-elk-city-idaho"
    },
    {
      "id": 6,
      "text": "Tucked in Idaho’s mountains, Elk City is one of the state’s best‑kept secrets, offering an adventurous escape into nature.",
      "sourceSentenceIds": [
        14
      ],
      "sourceLabels": [
        "Web source 2"
      ],
