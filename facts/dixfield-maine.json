      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "In the 19th century, Dixfield grew into a mill town powered by streams, producing sawmills, gristmills, cheese, carriages, and even toothpicks.",
      "sourceSentenceIds": [
        20,
        21,
        22
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Dixfield%2C_Maine",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The town once housed a marble works, adding to its diverse industrial heritage.",
      "sourceSentenceIds": [
        23
      ],
      "sourceLabels": [
