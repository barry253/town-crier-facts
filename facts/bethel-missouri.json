  "facts": [
    {
      "id": 1,
      "text": "Bethel was founded in 1844 as a Bible utopian colony by Prussian preacher Dr. William Keil.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Bethel%2C_Missouri"
    },
    {
      "id": 2,
      "text": "Keil’s followers, almost all German immigrants, believed the Book of Acts demanded communal ownership of all property.",
      "sourceSentenceIds": [
        22
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Bethel%2C_Missouri"
    },
    {
      "id": 3,
      "text": "In 1855 Keil led a group westward over the Oregon Trail, founding the Aurora Colony in Oregon.",
      "sourceSentenceIds": [
        26
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Bethel%2C_Missouri"
    },
    {
      "id": 4,
      "text": "Bethel’s historic district, bounded by Liberty, King, 1st, and 4th Streets, was added to the National Register of Historic Places in 1970.",
      "sourceSentenceIds": [
        30
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Bethel%2C_Missouri"
    },
    {
      "id": 5,
      "text": "Today thirty historic buildings remain, many open to visitors during Bethel’s annual festivals.",
      "sourceSentenceIds": [
        9
