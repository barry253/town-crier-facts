  "facts": [
    {
      "id": 1,
      "text": "Jeffers, Montana, was founded in the late 19th century as a ranching settlement named after pioneer rancher Myron D.",
      "sourceSentenceIds": [
        1,
        3
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/jeffers_montana",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "In 1871 Myron D. drove cattle from Texas, founding the Yellow Barn Cattle Ranch near the Madison River.",
      "sourceSentenceIds": [
        13,
        17
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/jeffers_montana",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The 1885 toll bridge over the Madison River helped funnel park‑bound traffic toward Yellowstone, making Jeffers a regional crossroads.",
      "sourceSentenceIds": [
        2,
        25
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/jeffers_montana",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Between 1910 and 1920, Jeffers peaked as a stopover for Yellowstone visitors, thanks to the 1902 Hutchins Bridge.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/jeffers_montana",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The 1879 Trinity Episcopal Church, a Queen Anne‑style landmark, remains one of Jeffers' oldest surviving structures.",
      "sourceSentenceIds": [
