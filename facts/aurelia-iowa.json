    },
    {
      "id": 2,
      "text": "Aurelia’s daily paper, the Aurelia Star, began in March 1881 originally as the Aurelia Sentinel.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Aurelia%2C_Iowa"
    },
    {
      "id": 3,
      "text": "Early Aurelia boasted lumber yards, implement shops, a furniture store, a jewelry shop, a tile factory, a bowling alley, and a roller‑skating rink.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
