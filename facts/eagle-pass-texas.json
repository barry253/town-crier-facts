      "id": 1,
      "text": "Eagle Pass earned its name from the hills along the Rio Grande that locals said looked like an eagle’s outstretched wings.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
