    {
      "id": 1,
      "text": "Wauna was originally platted as Springfield in 1889 before its name changed to avoid confusion with other Springfields.",
      "sourceSentenceIds": [
        1,
        11
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Wauna%2C_Washington",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "A single bridge built in 1892 linked Wauna to Purdy, making it the gateway to the remote Key Peninsula.",
      "sourceSentenceIds": [
        13,
        14
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.keypeninsulamuseum.org/key-communities/wauna/",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The historic White store, later Goldman store, housed the post office and served Mosquito fleet steamers bringing mail and goods.",
      "sourceSentenceIds": [
        21,
        20
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.keypeninsulamuseum.org/key-communities/wauna/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "In 1990 the Wauna post office building was listed on Pierce County’s Register of Historic Places before moving to a new location.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.keypeninsulamuseum.org/key-communities/wauna/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "A 1989 sign reading “Discover Key Peninsula” still welcomes visitors at Wauna’s entrance, marking the start of the peninsula.",
