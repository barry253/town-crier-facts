  "facts": [
    {
      "id": 1,
      "text": "Los Arrieros was founded by descendants of followers of Spanish colonizer Jos\u00e9 de Escand\u00f3n.",
      "sourceSentenceIds": [
        3,
        5
      ],
      "sourceLabels": [
        "Web source 1",
        "Web source 2"
      ],
      "source": "https://www.tshaonline.org/handbook/entries/los-arrieros-tx",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town\u2019s name means \u201cmule drivers\u201d in Spanish, reflecting its early ranching heritage.",
      "sourceSentenceIds": [
        21
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.tshaonline.org/handbook/entries/los-arrieros-tx",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Los Arrieros sits on the Rio Grande, just off U.S. Route 83, linking Texas to Mexico.",
      "sourceSentenceIds": [
        6,
        19
      ],
      "sourceLabels": [
        "Web source 1",
        "Wikipedia"
      ],
      "source": "https://www.tshaonline.org/handbook/entries/los-arrieros-tx",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The community dates back to the eighteenth century as an old Spanish\u2011speaking settlement along the river.",
      "sourceSentenceIds": [
        20
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.tshaonline.org/handbook/entries/los-arrieros-tx",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The nearby Arrieros Ranch marks the historic El C\u00e1ntaro ford, a key crossing used by Alonso de Le\u00f3n in the 1680s.",
      "sourceSentenceIds": [
        22,
        23
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.tshaonline.org/handbook/entries/los-arrieros-tx",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "By 1990, only a handful of homes remained near the river, preserving the town\u2019s quiet, rural character.",
