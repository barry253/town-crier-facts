  "facts": [
    {
      "id": 1,
      "text": "Shellytown derives its name from David Shelly, a German immigrant who helped develop the community through farming in the early 1800s.",
      "sourceSentenceIds": [
        17
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/shellytown_pennsylvania"
    },
    {
      "id": 2,
      "text": "Shellytown was also known as Patchtown and once served as a post office community in rural central Pennsylvania.",
      "sourceSentenceIds": [
        11
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/shellytown_pennsylvania"
    },
    {
      "id": 3,
      "text": "Clover Creek, a north-flowing tributary of the Frankstown Branch Juniata River, forms the western border of Shellytown.",
      "sourceSentenceIds": [
        9,
        12
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Shellytown%2C_Pennsylvania"
    },
    {
      "id": 4,
      "text": "Early settlers of Shellytown were primarily of German descent, including Dunkards who cleared forested valleys for agriculture.",
      "sourceSentenceIds": [
        16
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/shellytown_pennsylvania"
    },
    {
      "id": 5,
      "text": "Pioneer families like the Shellys, Royers, and Neffs established the area by combining farming with small-scale milling operations.",
      "sourceSentenceIds": [
        19
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/shellytown_pennsylvania"
    },
    {
      "id": 6,
      "text": "Shellytown emerged as part of the post-Revolutionary War settlement patterns in the Juniata Valley during the late 18th century.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/shellytown_pennsylvania"
    }
  ]
