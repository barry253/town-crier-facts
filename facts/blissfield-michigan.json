  "facts": [
    {
      "id": 1,
      "text": "Blissfield was named after Hervey Bliss, the first white settler and postmaster, who founded the village in 1824.",
      "sourceSentenceIds": [
        1,
        5
      ],
      "sourceLabels": [
        "Web source 2",
        "Wikipedia"
