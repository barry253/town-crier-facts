  "facts": [
    {
      "id": 1,
      "text": "Jardin de San Julian means 'Garden of Saint Julian' and reflects the area's agricultural roots.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/jardin_de_san_julian_texas"
    },
    {
      "id": 2,
      "text": "The broader Starr County area traces its origins to Spanish colonial land grants issued between 1749 and 1846.",
      "sourceSentenceIds": [
        4,
        5
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/jardin_de_san_julian_texas"
    },
    {
      "id": 3,
      "text": "The community sits on expansive plains with clay, loam, and sandy soils, and alluvial deposits from the nearby Rio Grande shape local water flow.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/jardin_de_san_julian_texas"
    },
    {
      "id": 4,
      "text": "Local plants include mesquite, acacia, prickly‑pear cacti, and grass prairies, with riparian woodlands along the Rio Grande corridor.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/jardin_de_san_julian_texas"
    },
    {
      "id": 5,
      "text": "White‑tailed deer, javelina, and birds like northern bobwhite quail thrive in the thorny shrublands surrounding the area.",
      "sourceSentenceIds": [
        11
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/jardin_de_san_julian_texas"
    },
    {
      "id": 6,
      "text": "Jardin de San Julian emerged as a contemporary unincorporated colonia in the 1960s, growing amid limited infrastructure.",
      "sourceSentenceIds": [
        24
      ],
      "sourceLabels": [
