  "facts": [
    {
      "id": 1,
      "text": "Hinsdale takes its name from Colonel Ebenezer Hinsdale, whose mother was captured during the 1704 Raid on Deerfield.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Hinsdale%2C_New_Hampshire",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town’s earliest records describe repeated Indian assaults, raids, and captivities along the Connecticut River.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Hinsdale%2C_New_Hampshire",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The Ebenezer Hinsdale House, built around 1759, sits on 37 acres overlooking the Connecticut River.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.town.hinsdale.nh.us/our-town",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "In 2009 the Hinsdale Historical Society purchased the house and is converting it into a living museum.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.town.hinsdale.nh.us/our-town",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The town’s public library moved to a 4,533‑square‑foot building on Brattleboro Road in 2003 and hosts summer reading programs.",
