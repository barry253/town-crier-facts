  "facts": [
    {
      "id": 1,
      "text": "Mechanicstown was laid out in 1836 by Thomas McGavern.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Mechanicstown%2C_Ohio"
    },
    {
      "id": 2,
      "text": "In the early 1800s Jacob Weller, a local blacksmith, invented the first strike match sticks, later called lucifers.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://thurmontmainstreet.com/about-our-community/"
    },
    {
      "id": 3,
      "text": "The railroad arrived in the late 1800s, bringing coffin makers, pottery, and cigar‑making to the town.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://thurmontmainstreet.com/about-our-community/"
    },
    {
      "id": 4,
      "text": "Hunting Creek powered mills and supplied timber for mills and bark for tanneries, shaping early industry.",
      "sourceSentenceIds": [
        14
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://thurmontmainstreet.com/about-our-community/"
    },
    {
      "id": 5,
      "text": "The town was renamed Thurmont in 1894 to avoid confusion with Mechanicsburg, a change approved by state legislation.",
      "sourceSentenceIds": [
        22
      ],
