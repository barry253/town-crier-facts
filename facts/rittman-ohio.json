  "facts": [
    {
      "id": 1,
      "text": "Rittman was named after Fred Rittman, treasurer of the Baltimore and Ohio Railroad, which ran a line through town in 1871.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://rittmanoh.org/projects",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Rittman is the only place in the United States named Rittman, making it unique among American cities.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://rittmanoh.org/projects",
      "category": "other",
      "quality": "poor",
      "qualityReason": "vague"
    },
    {
      "id": 3,
      "text": "A restored church off DeCourcey Road, maintained by the Rittman Historical Society, stands as a stately reminder of the area’s history.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://rittmanoh.org/projects",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Founded in 1975, the Rittman Historical Society operates a museum and research center that houses artifacts, documents, and photographs telling the city’s story.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://museumsdatabase.com/museums/view/23827",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Businesses grew around newly built train stations, and two factories became major employers as families settled and cleared trees for crops.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 1"
      ],
