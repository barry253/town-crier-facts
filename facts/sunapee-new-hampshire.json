      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Lake Sunapee uniquely hosts three working lighthouses, originally built in the 1890s by the Woodsum brothers and still maintained today.",
      "sourceSentenceIds": [
