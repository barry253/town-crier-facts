  "facts": [
    {
      "id": 1,
      "text": "Owen Sound was named after Admiral Edward Owen, surveyed by William Fitzwilliam Owen in 1815, and the name stuck when the area was first mapped.",
      "sourceSentenceIds": [
        5,
        8,
        23
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 2"
      ],
      "source": "https://en.wikipedia.org/wiki/Owen_Sound",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The Owen Sound City Band, founded in 1923, still plays every summer at Kelso Beach and Harrison Park, keeping the city’s musical tradition alive.",
      "sourceSentenceIds": [
        1,
        19,
        20
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Owen_Sound",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Since 1976, the Summerfolk Music and Crafts Festival has turned Kelso Beach Park into a three‑day hub of music, art, and local crafts each August.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Owen_Sound",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Harrison Park hosts the Black History Cairn, a reminder that Owen Sound was a northern terminus of the Underground Railroad.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Owen_Sound",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The Owen Sound hockey franchise moved from Guelph in 1989, played as the Platers until 2000, then became the Attack for the 2000‑01 season.",
      "sourceSentenceIds": [
        7,
        11
      ],
      "sourceLabels": [
