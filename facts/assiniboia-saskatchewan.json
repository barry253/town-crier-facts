  "facts": [
    {
      "id": 1,
      "text": "Assiniboia began when the Canadian Pacific Railway built a branch line through southern Saskatchewan, selling 980 lots on Oct 12, 1912.",
      "sourceSentenceIds": [
        7,
        21
      ],
      "sourceLabels": [
        "Wikipedia",
