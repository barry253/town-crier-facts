  "facts": [
    {
      "id": 1,
      "text": "Wylie began as Nickelville, a name that may have come from the town’s first nickel store or a local joke about residents not worth a nickel.",
      "sourceSentenceIds": [
        3,
        5
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.wylietexas.gov/living/history_of_wylie/index.php",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "When the Gulf, Colorado and Santa Fe Railway laid tracks north of the original town in 1886, Wylie was incorporated the next year along the new right‑of‑way.",
      "sourceSentenceIds": [
        22,
        6,
        11
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Wylie%2C_Texas",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Historic Downtown Wylie has been the town’s central market and gathering place since its incorporation in 1887.",
      "sourceSentenceIds": [
        15,
        14
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://discoverwylie.com/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "During the 1930s and 1940s, onions were Wylie’s primary cash crop, feeding the region’s growing population.",
      "sourceSentenceIds": [
        28
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Wylie%2C_Texas",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Wylie stretches across Collin, Dallas, and Rockwall counties, making it a true tri‑county suburb of Dallas.",
      "sourceSentenceIds": [
        21
