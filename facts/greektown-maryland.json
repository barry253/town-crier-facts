  "facts": [
    {
      "id": 1,
      "text": "Once called The Hill, residents petitioned the city in the 1980s to rename the neighborhood Greektown, honoring its Greek heritage.",
      "sourceSentenceIds": [
        1,
        17
      ],
      "sourceLabels": [
        "Web source 1",
        "Wikipedia"
      ],
      "source": "https://gnabaltimore.org/history",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Since 2001, Greektown has seen a revitalization effort that added new housing and upgraded infrastructure while preserving its historic character.",
      "sourceSentenceIds": [
        6,
        18
      ],
      "sourceLabels": [
        "Web source 1",
        "Wikipedia"
      ],
      "source": "https://gnabaltimore.org/history",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Every summer, Greektown hosts the Baltimore Greek Festival and Parade, a lively celebration of Greek traditions.",
      "sourceSentenceIds": [
        26
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Greektown%2C_Baltimore",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Saint Nicholas Greek Orthodox Church spearheaded the creation of the Greektown Community Development Corporation to lead the neighborhood’s revitalization.",
      "sourceSentenceIds": [
        23
