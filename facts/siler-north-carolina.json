  "facts": [
    {
      "id": 1,
      "text": "Siler City began when Plikard Dederic Siler and his wife Elizabeth Hartsoe Siler settled near Lacy's Creek in the late 1800s.",
      "sourceSentenceIds": [
        13,
        14
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Siler_City%2C_North_Carolina"
    },
    {
      "id": 2,
      "text": "The town’s historic core includes the Bray House, Siler City City Hall, and several other buildings listed on the National Register of Historic Places.",
      "sourceSentenceIds": [
        17
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Siler_City%2C_North_Carolina"
    },
    {
      "id": 3,
      "text": "Today Siler City serves as a suburb of Greensboro and the Research Triangle Park, linking rural roots with a growing tech corridor.",
      "sourceSentenceIds": [
        15
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Siler_City%2C_North_Carolina"
    },
    {
      "id": 4,
      "text": "In 1939, photographer Dorothea Lange captured iconic Depression‑era images of Siler City for the Farm Security Administration.",
      "sourceSentenceIds": [
        11
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://preservationsilercity.org/research"
    },
    {
      "id": 5,
      "text": "U.S. Route 64 cuts through Siler City as 11th Street, connecting the town eastward to Pittsboro and westward to Asheboro.",
      "sourceSentenceIds": [
        19
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Siler_City%2C_North_Carolina"
    },
    {
      "id": 6,
      "text": "Loves Creek, a tributary of the Rocky River, drains the town and defines its main watershed.",
      "sourceSentenceIds": [
