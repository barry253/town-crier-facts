      "id": 1,
      "text": "Oak Brook was originally called Fullersburg after settler Ben Fuller in the early 19th century.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Oak_Brook%2C_Illinois",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The village officially became incorporated in 1958 thanks to Paul Butler's leadership.",
      "sourceSentenceIds": [
        16
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Oak_Brook%2C_Illinois",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Oak Brook's name first appeared in the 19th century to distinguish it from Hinsdale and Elmhurst.",
      "sourceSentenceIds": [
        17
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Oak_Brook%2C_Illinois",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The Oak Brook Historical Society preserves the town’s heritage and runs the Heritage Center with exhibits.",
      "sourceSentenceIds": [
        3,
        12
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.oakbrookhistory.com/",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The Lizzadro Museum of Lapidary Art moved to Oak Brook in 2019, adding a gem‑craft museum.",
      "sourceSentenceIds": [
        15
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Oak_Brook%2C_Illinois",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Oak Brook hosts the Oakbrook Center mall, which opened in 1962 on land annexed after incorporation.",
