  "facts": [
    {
      "id": 1,
      "text": "The Historic Chinatown Gate, completed in 2008 after two years of construction, stands as a proud symbol of the district's heritage.",
      "sourceSentenceIds": [
        17
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Chinatown%E2%80%93International_District%2C_Seattle",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "In 2023, the International District became Seattle's first neighborhood named to the National Trust for Historic Preservation's Most Endangered list.",
      "sourceSentenceIds": [
        18
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Chinatown%E2%80%93International_District%2C_Seattle",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The Wing Luke Museum, a community‑driven cultural center, hosts annual Lunar New Year Jamfest celebrations that light up Canton and Maynard Alleyways.",
      "sourceSentenceIds": [
        25,
        29
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.wingluke.org/cid",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "A surviving relic of Seattle's early Japanese community is the North American Post office, a newspaper founded in 1902.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Chinatown%E2%80%93International_District%2C_Seattle",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Chin Chun Hock, the district's first Chinese immigrant, arrived in 1860 and later opened a general store and hotel.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Chinatown%E2%80%93International_District%2C_Seattle",
      "category": "people",
      "quality": "good"
    },
