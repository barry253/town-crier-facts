  "facts": [
    {
      "id": 1,
      "text": "Wiergate began as a company town in 1917, built to serve the Wier Longleaf Lumber Company’s massive sawmill.",
      "sourceSentenceIds": [
        5,
        28
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Wiergate%2C_Texas",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town’s name honors Robert Withrow Wier, the lumber magnate who founded the company that shaped the area.",
      "sourceSentenceIds": [
        6,
        8
      ],
      "sourceLabels": [
        "Web source 1",
        "Web source 2"
      ],
      "source": "https://www.tshaonline.org/handbook/entries/wiergate-tx",
      "category": "people",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Wiergate’s mill was the last large lumber operation in East Texas, reaching a peak capacity of 200,000 board feet every ten hours.",
      "sourceSentenceIds": [
        25,
        28
      ],
      "sourceLabels": [
        "Web source 1",
        "Web source 1"
      ],
      "source": "https://www.tshaonline.org/handbook/entries/wiergate-tx",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "In 1917, Wier built a fifteen‑mile Gulf and Northern Railroad that linked the town directly to Newton.",
      "sourceSentenceIds": [
        18
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.texasalmanac.com/places/wiergate",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Locals once described Wiergate as “a little world unto itself” in a beautiful setting, reflecting its tight‑knit community feel.",
      "sourceSentenceIds": [
        9,
        18
      ],
      "sourceLabels": [
        "Web source 1",
        "Web source 2"
      ],
      "source": "https://www.tshaonline.org/handbook/entries/wiergate-tx",
      "category": "other",
      "quality": "poor",
      "qualityReason": "editorial_filler"
    },
    {
      "id": 6,
      "text": "Even in 1990, a smaller mill in Wiergate continued operating, processing lumber from the region’s second‑growth forests.",
