  "facts": [
    {
      "id": 1,
      "text": "Old Bethpage’s name comes from Quaker Thomas Powell, who named the area after the Biblical town Bethphage between Jericho and Jerusalem.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Bethpage%2C_New_York",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The Long Island Rail Road first stopped at a station called Jerusalem Station in 1851, later renamed Bethpage station, and still serves the town today.",
      "sourceSentenceIds": [
        3,
        4,
        26
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Bethpage%2C_New_York",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The Old Bethpage Village Restoration opened in 1970, preserving 18th‑ and 19th‑century buildings and offering interactive exhibits that bring Long Island’s rural past to life.",
      "sourceSentenceIds": [
        14,
        13
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://newyorkspaces.com/old-bethpage-ny-history-parks-and-the-perks-of-suburban-life/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "From 1936 to 1994, Grumman Aircraft Engineering Corporation operated in Bethpage, building the F‑14 Tomcat, the Apollo Lunar Excursion Module, and more.",
      "sourceSentenceIds": [
        21
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Bethpage%2C_New_York",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Old Bethpage’s historic village hosts community events like the Long Island Fair, strengthening its role as a center for public history and cultural engagement.",
      "sourceSentenceIds": [
        17,
        29
      ],
