  "facts": [
    {
      "id": 1,
      "text": "Cortez was founded in 1886 by the Montezuma Valley Water Supply Company to house workers building irrigation canals that reshaped the valley.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://visitfourcorners.com/cortez-colorado-your-ultimate-destination/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town’s name honors Spanish conquistador Hernán Cortés, linking it to the era of exploration.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Cortez%2C_Colorado",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "In the 1950s, Cortez became a hotspot for uranium prospectors, with Geiger counter‑armed men searching for yellow‑cake deposits.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.cortezco.gov/318/History-of-City",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Cortez sits on the Old Spanish National Historic Trail, a route once used by traders and settlers across the Southwest.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Cortez%2C_Colorado",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Downtown Cortez showcases mining‑era architecture mixed with independent shops, reflecting its historic roots while staying modern.",
      "sourceSentenceIds": [
        14
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://visitfourcorners.com/cortez-colorado-your-ultimate-destination/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Cortez serves as a gateway to the Canyons of the Ancients National Monument, home to the highest density of archaeological sites in the U.S.",
      "sourceSentenceIds": [
        16
      ],
