  "facts": [
    {
      "id": 1,
      "text": "Kaltag was named after a Koyukon Athabascan man named Kaltaga, honoring a prominent local resident.",
      "sourceSentenceIds": [
        1,
        2,
        3
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1",
        "Web source 2"
      ],
      "source": "https://en.wikipedia.org/wiki/Kaltag%2C_Alaska",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Kaltag sits at the start of the famed Kaltag Portage, the shortest overland link between the Yukon River and Norton Sound.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.kupi.com/en/explore/united-states/kaltag/history",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Before settlers, Kaltag served as a Koyukon Athabascan cemetery and seasonal camp along a portage trail that led west to Unalakleet.",
      "sourceSentenceIds": [
        16,
        17,
        18
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Kaltag%2C_Alaska",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Kaltag played a key role in the 1925 Serum Run to Nome, helping deliver diphtheria antitoxin across harsh terrain.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://kupi.com/en/explore/united-states/kaltag",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Every two years, Kaltag hosts a week-long Stick Dance potlatch, honoring the recently deceased and drawing visitors from neighboring villages.",
      "sourceSentenceIds": [
        28,
        29
      ],
