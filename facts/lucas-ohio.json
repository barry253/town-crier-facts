  "facts": [
    {
      "id": 1,
      "text": "Lucas was founded in 1836 by David Tucker, located 7 miles southeast of Mansfield on State Route 39.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://villageoflucas.com/about-lucas/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The village’s name traces back to Ohio’s 12th governor, Robert Lucas, who served as the namesake.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Lucas%2C_Ohio",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Lucas grew rapidly after the Chicago Railroad Company laid tracks in 1830, establishing a depot that spurred commerce.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Lucas%2C_Ohio",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Pulitzer Prize‑winning author Louis Bromfield once called Lucas home, and his 900‑acre estate now hosts the Big House museum.",
      "sourceSentenceIds": [
        10,
        12
      ],
      "sourceLabels": [
        "Web source 1",
        "Web source 2"
      ],
      "source": "https://villageoflucas.com/about-lucas/",
      "category": "people",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The town hosts the annual Ohio Heritage Days Festival at Malabar Farm, featuring tractors, live music, and living‑history demos.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://destinationmansfield.com/blog/a-day-in-lucas-ohio/",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Lucas lies within the Mohican Valley, surrounded by Rocky Fork and Black Fork rivers and nearby Charles Mill Lake.",
      "sourceSentenceIds": [
        27
