  "facts": [
    {
      "id": 1,
      "text": "Chalkyitsik means 'fish hooking place' and has long served as a seasonal fishing site for the Gwich’in people.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.tananachiefs.org/about/communities/chalkyitsik/"
    },
    {
      "id": 2,
      "text": "Chalkyitsik sits on the left bank of the Black River, 45 miles northeast of Fort Yukon.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Chalkyitsik%2C_Alaska"
    },
    {
      "id": 3,
      "text": "The village experiences a continental subarctic climate, with mild summers and cold winters.",
      "sourceSentenceIds": [
        11
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Chalkyitsik%2C_Alaska"
    },
    {
      "id": 4,
      "text": "Archaeological digs reveal human activity in the area dating back to about 10,000 BC.",
      "sourceSentenceIds": [
        25
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.alaskan-natives.com/548/chalkyitsik-village/"
    },
    {
      "id": 5,
      "text": "Elders recall a nomadic routine, living at the Black River headwaters from autumn to spring before floating downstream to fish in summer.",
      "sourceSentenceIds": [
        26
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.alaskan-natives.com/548/chalkyitsik-village/"
    },
    {
      "id": 6,
      "text": "The first permanent building was erected by William Salmon, a Canadian Native who married a Black River woman.",
