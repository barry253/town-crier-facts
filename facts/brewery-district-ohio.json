  "facts": [
    {
      "id": 1,
      "text": "Brewery District grew from German immigrants in the mid‑1800s, with Louis Hoster opening the first brewery in 1836 and five breweries peaking before Prohibition.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/brewery_district",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The Scioto River, Columbus Feeder Canal, and a spring‑fed ravine converged here, giving breweries easy water and transport access.",
      "sourceSentenceIds": [
        6,
        20
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 2"
      ],
      "source": "https://en.wikipedia.org/wiki/Brewery_District",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "A 30‑foot elevation drop south of Bank and Short Streets shapes the district’s varied topography, influencing early site planning.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/brewery_district",
      "category": "other",
      "quality": "poor",
      "qualityReason": "other"
    },
    {
      "id": 4,
      "text": "August Wagner’s Gambrinus Brewery, opened 1905, still hosts a prominent King Gambrinus statue that locals admire.",
      "sourceSentenceIds": [
        1,
        19
      ],
      "sourceLabels": [
        "Web source 1",
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/brewery_district",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The district’s historic industrial layout is bounded by I‑70, South Pearl, Greenlawn, and the Scioto River, preserving its original grid.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/brewery_district",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "In 2009, the district’s preserved brick buildings were listed on the National Register of Historic Places, honoring its brewing heritage.",
