  "facts": [
    {
      "id": 1,
      "text": "Maxville was named after nearby Flint Creek, which lent its name to a Northern Pacific Railroad station as early as 1888.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.mtmemory.org/nodes/view/128690"
    },
    {
      "id": 2,
      "text": "The town’s post office opened in 1912, and the official paperwork returned the name Maxville, replacing the earlier Macville honoring Robert R. MacLeod.",
      "sourceSentenceIds": [
        9,
        10,
        11,
        17
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.mtmemory.org/nodes/view/128690"
    },
    {
      "id": 3,
      "text": "Maxville sits at 4,830 feet, roughly one mile above sea level, in Granite County’s rugged landscape.",
      "sourceSentenceIds": [
        18,
