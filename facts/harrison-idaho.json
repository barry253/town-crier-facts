      "quality": "good"
    },
    {
      "id": 2,
      "text": "Railroad from Tekoa, Washington, to Harrison was completed in 1890 and was a prime factor in the development of Harrison.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
