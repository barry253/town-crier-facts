      "category": "transport",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The community was named after President Benjamin Harrison.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Harrison%2C_Idaho",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Harrison's growth was a result of the development of eight or more sawmills & box factories.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Harrison%2C_Idaho",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Passenger service was discontinued in the early 1920s but they continued to haul freight until 1932 when the line was abandoned.",
