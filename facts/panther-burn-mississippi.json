      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town grew as one of Sharkey County’s smallest settlements, rooted in cotton plantations, slavery, and post‑Civil War sharecropping.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
