  "facts": [
    {
      "id": 1,
      "text": "Russia, Ohio was founded in 1853 when Lewis Phillips bought land, built the first house and store, and platted the village for settlers.",
      "sourceSentenceIds": [
        1,
        3,
        17,
        18
      ],
      "sourceLabels": [
        "Web source 1",
        "Wikipedia"
      ],
      "source": "https://grokipedia.com/page/Russia,_Ohio",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The village’s name honors French‑speaking Swiss veterans of Napoleon’s 1812 campaign, who named it after the battle they fought in Russia.",
      "sourceSentenceIds": [
        2,
        19
      ],
      "sourceLabels": [
        "Web source 1",
        "Wikipedia"
      ],
      "source": "https://grokipedia.com/page/Russia,_Ohio",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Saint Remy Catholic Church, whose brick building was completed in 1892, sits on a cornerstone laid in 1890 and was listed on the National Register in 1979.",
      "sourceSentenceIds": [
        8,
        9,
        23
      ],
      "sourceLabels": [
        "Web source 1",
        "Wikipedia"
      ],
      "source": "https://grokipedia.com/page/Russia,_Ohio",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Russia lies within Ohio’s Land of the Cross‑Tipped Churches scenic byway, a 38‑mile route celebrating French and German Catholic heritage through historic steeples.",
      "sourceSentenceIds": [
        7,
        10,
        24
      ],
      "sourceLabels": [
        "Web source 1",
        "Wikipedia"
      ],
      "source": "https://grokipedia.com/page/Russia,_Ohio",
      "category": "other",
      "quality": "poor",
      "qualityReason": "vague"
    },
    {
      "id": 5,
      "text": "Every year, young men in Russia carry a 400‑pound cross down the village streets, a ritual that echoes the European customs brought by the French pioneers.",
      "sourceSentenceIds": [
        11
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/Russia,_Ohio",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The village hosts a branch of the Shelby County Libraries, providing residents with access to a public library collection.",
