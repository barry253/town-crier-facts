  "facts": [
    {
      "id": 1,
      "text": "Seligman earned its name in 1886 when New York banker Jesse Seligman helped finance the railroad that made the town a key stop on the Santa Fe mainline.",
      "sourceSentenceIds": [
        1,
        6
      ],
      "sourceLabels": [
        "Web source 1",
        "Wikipedia"
      ],
      "source": "https://www.seligmanazchamber.com/local-information/history",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Before becoming Seligman, the town was called Prescott Junction because it sat where the Santa Fe mainline met the feeder line to Prescott.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Seligman%2C_Arizona",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The town’s historic Route 66 legacy began when trains gave way to automobiles, turning Seligman into a classic roadside stop for travelers.",
      "sourceSentenceIds": [
        17
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.seligmanazchamber.com/local-information/history",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The 1910 Cottage Hotel, now on the National Register of Historic Places, still stands at 1st Street and Shoney Avenue, a reminder of Seligman’s early 20th‑century boom.",
      "sourceSentenceIds": [
        15
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Seligman%2C_Arizona",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "At 5,240 feet above sea level, Seligman sits beside Big Chino Wash, a tributary of the Verde River that once fed the region’s early settlers.",
      "sourceSentenceIds": [
        25,
        26
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
