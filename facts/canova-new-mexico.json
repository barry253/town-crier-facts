      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Canova's historic 'Las Nueve Acequias' still irrigate farms, blending Tewa, Spanish, and Mexican water‑management traditions.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/canova_new_mexico",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Farmers grow wheat, corn, chile, and fruit, while grist mills powered by river water turn harvests into flour.",
      "sourceSentenceIds": [
