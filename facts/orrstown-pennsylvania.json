  "facts": [
    {
      "id": 1,
      "text": "Orrstown was founded in 1833 by the Orr brothers.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Orrstown%2C_Pennsylvania",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town was laid out in 1833 by John, William and James Orr, and the name stuck after a post office naming conflict.",
      "sourceSentenceIds": [
        12,
        13
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Orrstown%2C_Pennsylvania",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Orrstown sits on a low ridge between Conodoguinet Creek to the north and Muddy Run to the south.",
      "sourceSentenceIds": [
        18
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Orrstown%2C_Pennsylvania",
      "category": "nature",
      "quality": "poor",
      "qualityReason": "location_description"
    },
    {
      "id": 4,
      "text": "Before the Pennsylvania Railroad, horses and cattle were driven annually down the old state road—now PA 533—to eastern markets.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Orrstown%2C_Pennsylvania",
      "category": "transport",
      "quality": "poor",
      "qualityReason": "route_only"
    },
    {
      "id": 5,
      "text": "Orrstown was incorporated on May 3, 1847, and by 1878 it had one hotel, two stores, a carriage factory, and four churches.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Orrstown%2C_Pennsylvania",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Orrstown lies at the intersection of PA Routes 433 and 533, with Route 433 leading northwest to Roxbury and south to the Letterkenny Army Depot.",
      "sourceSentenceIds": [
