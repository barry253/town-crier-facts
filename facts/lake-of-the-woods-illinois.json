  "facts": [
    {
      "id": 1,
      "text": "Lake of the Woods sits in Mahomet Township, surrounded by oak‑hickory forests and prairie remnants within an 873‑acre forest preserve.",
      "sourceSentenceIds": [
        21,
        23
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/lake_of_the_woods_illinois",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Its 8‑mile northwest location from Champaign places it just outside the village of Mahomet, a detail that shaped its early settlement patterns.",
      "sourceSentenceIds": [
        22
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/lake_of_the_woods_illinois",
      "category": "other",
      "quality": "poor",
      "qualityReason": "location_description"
    },
    {
      "id": 3,
      "text": "Native American Kickapoo originally inhabited the area until a 1819 treaty ceded the land, leading to their displacement west of the Mississippi.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/lake_of_the_woods_illinois",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Pioneer roads like the Urbana‑to‑Bloomington state road (1835) and the Danville‑to‑Fort Clark trail crossed nearby, linking farms to markets by the early 1830s.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/lake_of_the_woods_illinois",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The lake supports fishing for bass and catfish, and a boathouse on a peninsula offers seasonal rentals, making it a local recreation hub.",
      "sourceSentenceIds": [
        24
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/lake_of_the_woods_illinois",
      "category": "nature",
      "quality": "good"
    }
