  "facts": [
    {
      "id": 1,
      "text": "Seymour was named after Charles Seymour, chief engineer of the Knoxville, Sevierville and Eastern Railway, when the station opened December 18 1909.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Seymour%2C_Tennessee",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town’s roots trace back to 1783 when Samuel Newell established Newell’s Station, the original frontier post that later became Seymour.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Seymour%2C_Tennessee",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The Reddish Ford Covered Bridge, a historic wooden span in Seymour, showcases 19th‑century bridge‑building and is a favorite photo spot.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://touristplaces.guide/top-10-places-to-visit-in-seymour-nature-adventure-and-history/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The Seymour Historical Museum, founded to preserve local artifacts, offers exhibits on early settlers, photographs, and interactive displays.",
      "sourceSentenceIds": [
        1,
        5
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://touristplaces.guide/top-10-places-to-visit-in-seymour-nature-adventure-and-history/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Muscatatuck National Wildlife Refuge, established in 1966, borders Seymour and protects migratory bird habitats, drawing birdwatchers year‑round.",
