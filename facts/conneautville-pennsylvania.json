  "facts": [
    {
      "id": 1,
      "text": "Conneautville sprang to life in 1814 when surveyor Alexander Power laid out the town, originally calling it Powerstown.",
      "sourceSentenceIds": [
        2,
        1
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Conneautville%2C_Pennsylvania"
    },
    {
      "id": 2,
      "text": "By 1816 Power had sold lots in the newly platted Powerstown, setting the stage for a growing community.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://crawfordcopa.com/history/boro/conneautville"
    },
    {
      "id": 3,
      "text": "The construction of the Erie Canal nearby drew laborers, mechanics, and tradesmen, sparking a lasting wave of prosperity.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://crawford.pagenweb.org/Individual_Boroughs/Conneautville.html"
    },
    {
      "id": 4,
      "text": "Conneaut Creek winds through the borough, flowing north and west toward Lake Erie.",
      "sourceSentenceIds": [
        13
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Conneautville%2C_Pennsylvania"
    },
    {
      "id": 5,
      "text": "In 1844 the borough officially incorporated, separating from Spring Township to become its own municipality.",
      "sourceSentenceIds": [
        27
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://crawfordcopa.com/history/boro/conneautville"
    },
    {
      "id": 6,
      "text": "Early maps referred to the area as Power's Tract before it adopted the name Conneautville.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Conneautville%2C_Pennsylvania"
