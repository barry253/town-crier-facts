  "facts": [
    {
      "id": 1,
      "text": "Nicollet takes its name from Joseph Nicollet, a French explorer who mapped the region in the 1830s.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Nicollet%2C_Minnesota",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The original village sprang up on a fertile patch of land that later became Nicollet County’s agricultural heart.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.nicollet.org/brief-history-of-nicollet",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Early settlers built a state center, hotel, blacksmith shop, and Trinity Lutheran church, but the site was abandoned after only a few structures.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.nicollet.org/brief-history-of-nicollet",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "When the railroad arrived, Nicollet revived, turning the once‑abandoned village into a thriving rail town.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.nicollet.org/brief-history-of-nicollet",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "A post office and town of Nicollet were founded in 1858 by William A. Smith, marking the community’s official start.",
      "sourceSentenceIds": [
        14
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Nicollet%2C_Minnesota",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The area that is now Nicollet was once covered by the Great Woods, which settlers cleared to make room for farms.",
      "sourceSentenceIds": [
        30
