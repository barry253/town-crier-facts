  "facts": [
    {
      "id": 1,
      "text": "Early land grants in the hundred were patented in 1676 to Maryland settlers, with families Emerson and Cowgill holding significant portions by the early eighteenth century.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/Little_Creek_Delaware",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Little Landing grew around a drawbridge built in 1802, becoming a 19th‑century port and oyster‑fleet hub on the Delaware Bay.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/Little_Creek_Delaware",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The Little River, a tidal waterway, flows eastward through Little Creek before draining into the Delaware Bay less than two miles away, feeding nearby saline wetlands.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/Little_Creek_Delaware",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Little Creek sits within Little Creek Hundred, where European settlement began in the 1670s under the Duke of York's jurisdiction.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/Little_Creek_Delaware",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The Little Creek United Methodist Church, founded in 1820, is listed on the National Register of Historic Places.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/Little_Creek_Delaware",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "In 2019, the Delaware Public Archives installed a historical marker in Little Creek, acknowledging its heritage as a former shipping and trading center.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 1"
      ],
