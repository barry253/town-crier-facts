  "facts": [
    {
      "id": 1,
      "text": "Glenwood was founded in 1863 by Mormon pioneers and named after early settler Robert Wilson Glenn.",
      "sourceSentenceIds": [
        13,
        4,
        6
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 2"
      ],
      "source": "https://en.wikipedia.org/wiki/Glenwood%2C_Utah"
    },
    {
      "id": 2,
      "text": "In April 1866 a stone fort was built to protect the growing settlement from local conflicts.",
      "sourceSentenceIds": [
        15
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Glenwood%2C_Utah"
    },
    {
      "id": 3,
      "text": "The 1867 Black Hawk War left Glenwood deserted for a year, but residents returned in 1868 after peace was restored.",
      "sourceSentenceIds": [
        16
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Glenwood%2C_Utah"
    },
    {
      "id": 4,
      "text": "Fresh springs east of town have supplied Glenwood’s water supply since its founding and still feed the nearby state fish hatchery.",
      "sourceSentenceIds": [
        17,
        18
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Glenwood%2C_Utah"
    },
    {
      "id": 5,
      "text": "A gristmill erected early in Glenwood became the first of its kind in Sevier County, boosting local agriculture.",
      "sourceSentenceIds": [
        19
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Glenwood%2C_Utah"
    },
    {
      "id": 6,
      "text": "In 1878 a ZCMI co‑operative building at Main and Center streets stood as the largest structure in the county for several years.",
