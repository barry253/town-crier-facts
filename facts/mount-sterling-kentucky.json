      "id": 1,
      "text": "Mount Sterling earned its name from a 125‑foot “Little Mountain” burial mound and the Scottish hometown of its founder, Stirling.",
      "sourceSentenceIds": [
        2,
        4,
        21
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
