  "facts": [
    {
      "id": 1,
      "text": "Harrison began as a railroad camp called Summit in 1884, then became the town of Bowen when the Fremont, Elkhorn and Missouri Valley Railroad arrived in 1886.",
      "sourceSentenceIds": [
        1,
        2,
        5
      ],
      "sourceLabels": [
        "Web source 1",
        "Web source 2",
        "Wikipedia"
      ],
      "source": "https://discovernwnebraska.com/historic-harrison/"
    },
    {
      "id": 2,
      "text": "In 1887 the town was renamed Harrison to honor President Benjamin Harrison, and it was incorporated as the county seat on April 7, 1888.",
      "sourceSentenceIds": [
        3,
        8,
        10,
        23
      ],
      "sourceLabels": [
        "Web source 2",
        "Wikipedia"
      ],
      "source": "https://grokipedia.com/page/harrison_nebraska"
    },
    {
      "id": 3,
      "text": "At 4,876 feet above sea level, Harrison is the highest‑elevated town in Nebraska, a fact it proudly uses in its “Nebraska’s Top Town” slogan.",
      "sourceSentenceIds": [
        15,
        30
      ],
      "sourceLabels": [
        "Web source 1",
        "Wikipedia"
      ],
      "source": "https://discovernwnebraska.com/historic-harrison/"
    },
    {
      "id": 4,
      "text": "The town’s first saloon, Weller’s, opened in 1886 inside the Gerlach Building, marking the start of Harrison’s early commercial life.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://discovernwnebraska.com/historic-harrison/"
    },
    {
      "id": 5,
      "text": "The historic Cook Homestead, also known as the Bone Cabin Complex, sits on the National Register of Historic Places and is a landmark of early settlement.",
      "sourceSentenceIds": [
        14
