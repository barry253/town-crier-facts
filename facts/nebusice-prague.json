  "facts": [
    {
      "id": 1,
      "text": "Nebušice became part of Prague in 1968, after centuries as an independent village.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Nebu%C5%A1ice",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The village lies northwest of Prague’s historic centre, tucked behind the northern wooded ridge of Divoká Šárka.",
      "sourceSentenceIds": [
        6,
        10
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Nebu%C5%A1ice",
      "category": "other",
      "quality": "poor",
      "qualityReason": "location_description"
    },
    {
      "id": 3,
      "text": "Four bus lines—161 and 312 from Bořislavka—link Nebušice directly to the city centre.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Nebu%C5%A1ice",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "At the heart of Nebušice stands the Church of St. Cyril and Methodius, a pseudo‑Romanesque building completed in 1886.",
      "sourceSentenceIds": [
        11,
        12
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.tourismato.cz/en/nebusice-p104080",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The earliest written mention of Nebušice appears in Pope Gregory X’s 1273 privilege for the Strahov Monastery.",
      "sourceSentenceIds": [
        13
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.tourismato.cz/en/nebusice-p104080",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Nebušice’s name may hint at a once‑thriving community of Nebuš people, as suggested by local lore.",
      "sourceSentenceIds": [
        10
      ],
