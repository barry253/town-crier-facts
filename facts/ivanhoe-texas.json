  "facts": [
    {
      "id": 1,
      "text": "Ivanhoe was originally called Hawkins' Prairie after pioneer Strother Hawkins, who settled there in 1845.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.tshaonline.org/handbook/entries/ivanhoe-tx",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "When the postal service rejected the original name, a Confederate veteran named the town Ivanhoe after Sir Walter Scott’s novel.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.tshaonline.org/handbook/entries/ivanhoe-tx",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "In the 1880s Ivanhoe had a steam mill, cotton gin, hotel, and a school, serving a community of about 150 residents.",
      "sourceSentenceIds": [
        22,
        24
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.tshaonline.org/handbook/entries/ivanhoe-tx",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Stage lines ran regularly between Ivanhoe and nearby Bonham, making the town a local transport hub in the late 19th century.",
      "sourceSentenceIds": [
        23
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.tshaonline.org/handbook/entries/ivanhoe-tx",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Today Ivanhoe is home to the Ivanhoe Winery, an award‑winning vineyard that draws visitors from across Texas.",
      "sourceSentenceIds": [
        25
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.tshaonline.org/handbook/entries/ivanhoe-tx",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The town’s first Baptist church, organized in 1872, remains the oldest active missionary Baptist church in Texas.",
      "sourceSentenceIds": [
        21
      ],
      "sourceLabels": [
        "Web source 1"
      ],
