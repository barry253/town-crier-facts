  "facts": [
    {
      "id": 1,
      "text": "Smith Valley takes its name from explorer Jedediah Smith, who crossed the area in spring 1827.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Smith_Valley%2C_Nevada"
    },
    {
      "id": 2,
      "text": "A 19th‑century Smith's Station grew into the valley’s agricultural hub, a legacy still felt today.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.nvexpeditions.com/lyon/smith.php"
    },
    {
      "id": 3,
      "text": "Numerous historic ranches dot the valley, and a handful of businesses form the local “Central” Smith.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.nvexpeditions.com/lyon/smith.php"
    },
    {
      "id": 4,
      "text": "The valley lies between the Pine Nut Mountains to the west and the Singatse Range to the east.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Smith_Valley%2C_Nevada"
    },
    {
      "id": 5,
      "text": "For over a century, Walker River water has been diverted to irrigate Smith Valley farms, draining the nearby Walker Lake.",
      "sourceSentenceIds": [
        23
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Smith_Valley%2C_Nevada"
    },
    {
      "id": 6,
      "text": "A 2022 study found the valley’s groundwater table has dropped more than 100 feet in the past 50 years.",
      "sourceSentenceIds": [
