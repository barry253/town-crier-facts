  "facts": [
    {
      "id": 1,
      "text": "Cherokee Strip grew from 19th‑century ranching lands, once part of Mexican grants and later American cattle grazing.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/cherokee_strip_california"
    },
    {
      "id": 2,
      "text": "By the late 1800s, federal Homestead Act policies turned the area into a rural farmland hub with irrigation and rail access.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/cherokee_strip_california"
    },
    {
      "id": 3,
      "text": "The community sits at 331 feet above sea level, officially classified as a populated place by the U.S. government.",
      "sourceSentenceIds": [
        16
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/cherokee_strip_california"
    },
    {
      "id": 4,
      "text": "Cherokee Strip lies on a flat alluvial plain, typical of the San Joaquin Valley's low‑relief terrain.",
      "sourceSentenceIds": [
        24
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/cherokee_strip_california"
    },
    {
      "id": 5,
      "text": "The area experiences a cold semi‑arid climate, with July highs near 95°F and winter lows around 40°F.",
      "sourceSentenceIds": [
        26
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/cherokee_strip_california"
    },
    {
      "id": 6,
      "text": "Intensive Central Valley farming has drawn down groundwater, reducing aquifer levels and native habitat availability.",
