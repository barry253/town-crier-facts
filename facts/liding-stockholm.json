      "quality": "good"
    },
    {
      "id": 2,
      "text": "The island earned city privileges in the 1910s, becoming a suburb for the well‑to‑do with detached houses along the Lidingöbanan railway.",
      "sourceSentenceIds": [
        29
      ],
      "sourceLabels": [
        "Web source 1"
