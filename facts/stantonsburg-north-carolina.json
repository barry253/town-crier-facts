      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Three historic homes—Applewhite, Edmondson‑Woodward, and Ward‑Applewhite‑Thompson—were added to the National Register of Historic Places in 1986.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
