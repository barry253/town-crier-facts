  "facts": [
    {
      "id": 1,
      "text": "East Greenville was incorporated in 1875, marking its official start as a borough in Upper Montgomery County.",
      "sourceSentenceIds": [
        11
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://egreenville.org/more/history/"
    },
    {
      "id": 2,
      "text": "The 1875 extension of the Perkiomen Railroad through the borough sparked rapid growth and connected East Greenville to regional markets.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://egreenville.org/more/history/"
    },
    {
      "id": 3,
      "text": "The Greenville Literary Society, founded in 1872, has long nurtured local writers and readers in the community.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://egreenville.org/more/history/"
    },
    {
      "id": 4,
      "text": "When a post office was needed, the borough changed its name from Greenville to East Greenville to avoid confusion with another town.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://egreenville.org/more/history/"
    },
    {
      "id": 5,
      "text": "Historic Sanborn Fire Insurance Maps from 1922 give a detailed snapshot of East Greenville’s streets, businesses, and buildings.",
