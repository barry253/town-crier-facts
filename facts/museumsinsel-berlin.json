  "facts": [
    {
      "id": 1,
      "text": "Museumsinsel is the northern half of an island in the Spree river, and the U‑bahn station takes its name from this historic spot.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Wikipedia"
