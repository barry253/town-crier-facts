  "facts": [
    {
      "id": 1,
      "text": "Des Plaines got its name from the river that runs through it, named by French explorers as La Rivière des Plaines because the trees resembled European plane trees.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Des_Plaines%2C_Illinois",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town grew around a mill built in 1852 to cut railroad ties from the forest along the Des Plaines River, into a grist mill by Socrates Rand.",
      "sourceSentenceIds": [
        11,
        19
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Des_Plaines%2C_Illinois",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Des Plaines hosts the historic 1925 Des Plaines Theatre, which was renovated and reopened in 2021 to host concerts and other performances.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Des_Plaines%2C_Illinois",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The Des Plaines History Center, founded in the early 20th century, displays exhibits like “Flora, Fauna, and Us— The Environmental History of Des Plaines” in partnership with the Field Museum.",
      "sourceSentenceIds": [
        21,
        20
      ],
      "sourceLabels": [
        "Web source 2",
        "Web source 1"
      ],
      "source": "https://www.desplaineshistory.org/",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Actor Robert Reed, known for “The Brady Bunch,” grew up in Des Plaines, making the city a hometown of a nationally recognized television star.",
      "sourceSentenceIds": [
        9
