  "facts": [
    {
      "id": 1,
      "text": "Despard was named after William Despard, an early settler and landowner in the area during the late eighteenth century.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.trawellino.com/destinations/united-states/west-virginia_despard"
    },
    {
      "id": 2,
      "text": "Despard served as a coal mining hub in the early twentieth century, reflecting the industrial history of the Appalachian region.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.trawellino.com/destinations/united-states/west-virginia_despard"
    },
    {
      "id": 3,
      "text": "The Phillips Sheet and Tin Plate Company in Despard was the largest manufacturing enterprise in north central West Virginia during the early 1900s.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Despard%2C_West_Virginia"
    },
    {
      "id": 4,
      "text": "The tin mill in Despard eventually became the first Weirton Steel Company after being taken over by James R. Weir.",
      "sourceSentenceIds": [
        11,
        15
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Despard%2C_West_Virginia"
    },
    {
      "id": 5,
      "text": "Summit Park in the Despard area was once a community for immigrant Greeks and other nationalities recruited as tin workers.",
      "sourceSentenceIds": [
        16,
        17
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Despard%2C_West_Virginia"
    },
    {
      "id": 6,
      "text": "Weirton Steel closed its gates in Despard in October 1936, and other manufacturing firms later occupied the buildings.",
      "sourceSentenceIds": [
