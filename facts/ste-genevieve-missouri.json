  "facts": [
    {
      "id": 1,
      "text": "Founded in 1735 by French Canadian colonists, Ste. Genevieve became the first organized European settlement west of the Mississippi in Missouri.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Ste._Genevieve%2C_Missouri",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town was named after Saint Genevieve, the 5th‑century patron saint of Paris, reflecting its French heritage.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Ste._Genevieve%2C_Missouri",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Louis Bolduc House, built in 1792, stands as one of the oldest structures in the city and is a National Historic Landmark.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Ste._Genevieve%2C_Missouri",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Geneviève National Historical Park, the 422nd unit of the National Park Service, preserves the area’s colonial history.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Ste._Genevieve%2C_Missouri",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Historic homes in Ste. Genevieve feature French colonial poteaux‑en‑terre and poteaux‑sur‑sole construction, a rare architectural style.",
      "sourceSentenceIds": [
        17
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.stegencounty.gov/about",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "1806 La Maison de Guibourd and 1818 Felix Vallé House are National Register sites that showcase Ste. Genevieve’s early 19th‑century architecture.",
      "sourceSentenceIds": [
