  "facts": [
    {
      "id": 1,
      "text": "Ness City’s downtown skyline is dominated by the Old Ness County Bank Building, a four‑story stone structure nicknamed the Skyscraper of the Plains.",
      "sourceSentenceIds": [
        2,
        4
      ],
      "sourceLabels": [
        "Web source 1",
        "Wikipedia"
      ],
      "source": "https://www.travelks.com/places-to-visit/cities/ness-city/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Railroad arrival in 1886 sparked rapid growth, turning Ness City into a bustling hub for settlers moving westward.",
      "sourceSentenceIds": [
        11
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Ness_City%2C_Kansas",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The Ness County Bank, established in the 1880s, had its iconic building erected a few years later, cementing the town’s reputation for sturdy craftsmanship.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.kansashistory.gov/kansapedia/ness-county-kansas/15257",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Visitors can stroll past the historic Opera House, where local brews from SheepDog Brewing mingle with the town’s rich cultural heritage.",
      "sourceSentenceIds": [
        13
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.travelks.com/places-to-visit/cities/ness-city/",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Scenic drives around Ness County reveal 1930s stone bridges and roadside markers, including a George Washington Carver tribute near Beeler.",
      "sourceSentenceIds": [
        14
      ],
