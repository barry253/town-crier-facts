    },
    {
      "id": 2,
      "text": "The Pelzer Manufacturing factory was the first in the country to use incandescent lighting.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Pelzer%2C_South_Carolina"
    },
    {
      "id": 3,
      "text": "Pelzer Manufacturing used some of the first generators ever sold by General Electric to power its dams along the river.",
      "sourceSentenceIds": [
