    {
      "id": 1,
      "text": "Skellytown was named after William Grove Skelly, founder of Skelly Oil Company.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Skellytown%2C_Texas"
    },
    {
      "id": 2,
      "text": "The town sprang up in the 1920s when Skelly Oil Company opened oil refineries and a carbon black plant.",
      "sourceSentenceIds": [
        25
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Skellytown%2C_Texas"
    },
    {
      "id": 3,
      "text": "In 1927 the Panhandle and Santa Fe Railway built a branch line and set up a depot just north of Skellytown.",
      "sourceSentenceIds": [
        23
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Skellytown%2C_Texas"
    },
    {
      "id": 4,
      "text": "A post office opened in Skellytown the same year, and the Roxana‑Skellytown News began publishing weekly.",
      "sourceSentenceIds": [
        26
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Skellytown%2C_Texas"
    },
    {
      "id": 5,
      "text": "Early businesses were company‑owned supply stores, and residents had to bring their own wood for fuel.",
      "sourceSentenceIds": [
        21,
        22
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Skellytown%2C_Texas"
    },
    {
