  "facts": [
    {
      "id": 1,
      "text": "Shabbona, Illinois, takes its name from the 19th‑century Potawatomi chief who earned the nickname “Whiteman’s Friend.”.",
      "sourceSentenceIds": [
        9,
        11
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Shabbona%2C_Illinois",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Chief Shabbona warned settlers of the Fox Valley about the impending Black Hawk War, helping keep the area calm.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Shabbona%2C_Illinois",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The Shabbona‑Lee‑Rollo Historical Museum began several years ago when locals gathered to preserve the village’s past.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://slrmuseum.com/welcome/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The museum’s collection spans DeKalb, Lee, and LaSalle counties, reflecting the region’s broad historical tapestry.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 2"
      ],
