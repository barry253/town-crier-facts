  "facts": [
    {
      "id": 1,
      "text": "Ochopee got its name when a visitor asked a store owner the Seminole word for farm, and the owner heard 'O-Chopp-ee'.",
      "sourceSentenceIds": [
        12,
        13,
        14
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Ochopee%2C_Florida",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The Ochopee Post Office, housed in a former toolshed, is the smallest post office in the United States.",
      "sourceSentenceIds": [
        18,
        19,
        20
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Ochopee%2C_Florida",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Since 1974, Big Cypress National Preserve has encompassed the historic boundaries of Ochopee.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.nps.gov/bicy/learn/historyculture/ochopee.htm",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Ochopee began as a one‑family tomato‑farming community in the early 1920s, growing around James Gaunt’s 240‑acre farm.",
      "sourceSentenceIds": [
        15,
        16,
        17
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Ochopee%2C_Florida",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Today, the post office primarily serves the Miccosukee and Seminole Indian reservations, and is a popular landmark for tourists posing for photos.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Ochopee%2C_Florida",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Ochopee is part of the Naples–Marco Island Metropolitan Statistical Area within the broader Gulf Coast region.",
