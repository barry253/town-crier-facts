  "facts": [
    {
      "id": 1,
      "text": "Marble is an unincorporated community in Clarion County, Pennsylvania, located along Pennsylvania Route 208, 6.2 miles north of Shippenville.",
      "sourceSentenceIds": [
        12,
        13
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Marble%2C_Pennsylvania",
      "category": "other",
      "quality": "poor",
      "qualityReason": "location_description"
    },
    {
      "id": 2,
      "text": "Marble once housed the world’s largest marble deposit and supplied marble for the Lincoln Memorial and Tomb of the Unknown Soldier.",
      "sourceSentenceIds": [
        21,
        22
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://marbletourismassociation.org/history",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The old 1910 high school now serves as the Marble Charter School and the Marble Historical Society’s museum.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://marbletourismassociation.org/history",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The historic Marble City State Bank Building was recently restored and hosts the Marble Board of Trustees meetings.",
      "sourceSentenceIds": [
        11
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://marbletourismassociation.org/history",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Marble’s quarry reopened in 1990, but has never employed more than a half‑dozen workers since then.",
      "sourceSentenceIds": [
        28
      ],
      "sourceLabels": [
