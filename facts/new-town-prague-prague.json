  "facts": [
    {
      "id": 1,
      "text": "New Town Prague was founded in 1348 by King Charles IV, who also wanted Charles Square to become the new settlement’s center.",
      "sourceSentenceIds": [
        1,
        2
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.guide-prague.org/en/praha/nove-mesto/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The Prague Astronomical Clock, or Orloj, first appeared on 9 October 1410, crafted by Mikuláš of Kadaň and astronomer Jan Šindel.",
      "sourceSentenceIds": [
        16,
        17
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Prague_astronomical_clock",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The Orloj’s famous hourly show, “Walk of the Apostles,” features moving figures, including a skeleton that represents Death striking the time.",
      "sourceSentenceIds": [
        15
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Prague_astronomical_clock",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "During the 1945 Prague uprising, the Nazis fired on the Old Town Square, damaging the Orloj, but it was restored and working again by 1948.",
      "sourceSentenceIds": [
        26,
        27
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Prague_astronomical_clock",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "A 2005 renovation restored the Orloj’s statues and lower calendar ring, while a 2018 overhaul repaired the astronomical clock after a tower reconstruction.",
      "sourceSentenceIds": [
        28,
        30
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Prague_astronomical_clock",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Wenceslas Square, the heart of New Town, became a symbol of the city’s recent history and a hub for cultural events.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 1"
      ],
