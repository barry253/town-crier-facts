  "facts": [
    {
      "id": 1,
      "text": "Tortilla Flat began as a camping ground for gold prospectors in the Superstition Mountains during the mid‑to‑late 19th century.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Tortilla_Flat%2C_Arizona",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town later served as a freight camp during construction of Theodore Roosevelt Dam in 1904.",
      "sourceSentenceIds": [
        1,
        30
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Tortilla_Flat%2C_Arizona",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "A one‑room schoolhouse now functions as a museum showcasing artifacts from the Lost Dutchman’s Gold Mine and Native American history.",
      "sourceSentenceIds": [
        14
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/tortilla_flats",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Superstition Mountain, 5,057 feet high, dominates the skyline and illustrates the volcanic origins of the range.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/tortilla_flats",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Water scarcity shaped settlement; residents rely on Canyon Lake and occasional streams that flow only during wet periods.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/tortilla_flats",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Tortilla Flat is the last surviving stagecoach stop along the Apache Trail, a historic route used by Yavapai and later by travelers.",
      "sourceSentenceIds": [
        18,
        26
      ],
