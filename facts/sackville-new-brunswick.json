  "facts": [
    {
      "id": 1,
      "text": "Sackville was named after Viscount Sackville, founded in 1765, and by 1772 sent a representative to the Nova Scotia House of Assembly.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Sackville%2C_New_Brunswick",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "In the 1830s tanneries, leather goods factories, carriage factories and blacksmith shops thrived around Morice Mill Pond—now Silver Lake—just north of the town centre.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Sackville%2C_New_Brunswick",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Mount Allison University, a liberal arts college founded in 1839, has shaped Sackville’s culture and educated generations of scholars.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://tantramarnb.com/community/sackville",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Sackville railway station, still active with Via Rail, is designated a national historic place.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Sackville%2C_New_Brunswick",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The town’s historic downtown, lined with locally‑owned shops, cafés and heritage buildings, reflects Sackville’s enduring character.",
