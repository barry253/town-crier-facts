  "facts": [
    {
      "id": 1,
      "text": "Polacca got its name from Tom Polacca, brother of famed potter Nampeyo.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Polacca%2C_Arizona",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The settlement began around a trading post founded in the late 19th century by Tom Polacca, a Hopi convert to LDS.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/polacca_arizona",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Polacca sits below First Mesa, on the Hopi Reservation, with steep mesa walls rising 300‑600 ft, giving historic isolation.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/polacca_arizona",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The Hopi Health Care Center, an Indian Health Service facility, offers 24‑hour emergency care to the community.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Polacca%2C_Arizona",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Polacca has no hotels, restaurants, gas stations, or department stores, and only one convenience store.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Polacca%2C_Arizona",
      "category": "other",
      "quality": "poor",
      "qualityReason": "editorial_filler"
    },
    {
      "id": 6,
      "text": "The area has endured a megadrought since the early 2000s, with the hottest years recorded only in recent decades.",
