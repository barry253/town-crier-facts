  "facts": [
    {
      "id": 1,
      "text": "Ione sits in the fertile Ione Valley, a name traced back to Thomas Brown in 1849 after a heroine from Bulwer‑Lytton’s drama The Last Days of Pompeii.",
      "sourceSentenceIds": [
        1,
        4
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Ione%2C_California"
    },
    {
      "id": 2,
      "text": "Ione’s historic Preston Castle, built 1890‑94 as a juvenile school, is a California State Historical Landmark and on the National Register of Historic Places.",
      "sourceSentenceIds": [
        2,
        3,
        8
      ],
      "sourceLabels": [
        "Web source 1",
        "Web source 2",
        "Wikipedia"
      ],
      "source": "https://amadorchamber.com/ione/"
    },
    {
      "id": 3,
      "text": "The town grew as a supply hub, stage stop, and rail center, not a mining town, and the Stockton‑Ione Railroad opened in 1873.",
      "sourceSentenceIds": [
        9,
        17
      ],
      "sourceLabels": [
        "Wikipedia",
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Ione%2C_California"
    },
    {
      "id": 4,
      "text": "Ione’s historic Methodist Church, organized in 1853, was completed in 1862 and remains a landmark of the town’s early community life.",
      "sourceSentenceIds": [
        16,
        26
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 2"
      ],
      "source": "https://en.wikipedia.org/wiki/Ione%2C_California"
    },
    {
      "id": 5,
      "text": "Golfers near Ione enjoy Castle Oaks, a course just a few miles from the town’s historic Main Street.",
      "sourceSentenceIds": [
