  "facts": [
    {
      "id": 1,
      "text": "Sarita was founded in 1904 on land that had been part of the Kenedy Ranch.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Sarita%2C_Texas",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town was named after Mifflin Kenedy’s daughter, Sarita Kenedy East, by the ranch owner himself.",
      "sourceSentenceIds": [
        4,
        6
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Sarita%2C_Texas",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "In 1911, Sarita became the county seat when Willacy County was formed from Cameron County.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.tshaonline.org/handbook/entries/sarita-tx",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The original townsite was moved a mile east in February 1905 when the railroad was relaid, but the town wasn’t surveyed until 1907.",
      "sourceSentenceIds": [
        13
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.tshaonline.org/handbook/entries/sarita-tx",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The Kenedy Ranch Museum opened in 2003 inside the restored Kenedy Pasture Company building, showcasing the family’s South Texas legacy.",
      "sourceSentenceIds": [
        9,
        22
      ],
