      "qualityReason": "dropped_surname_no_wiki_source"
    },
    {
      "id": 2,
      "text": "The town’s post office, famous for stamping thousands of letters on Valentine’s Day, sits beside the historic school building.",
      "sourceSentenceIds": [
        7,
        28
      ],
      "sourceLabels": [
        "Web source 1"
      ],
