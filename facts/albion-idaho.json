  "facts": [
    {
      "id": 1,
      "text": "Albion was founded before 1900, making it one of the few cities in Idaho’s Magic Valley with that early history.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Albion%2C_Idaho"
    },
    {
      "id": 2,
      "text": "The town’s name comes from Albion, the poetic name for Great Britain.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Albion%2C_Idaho"
    },
    {
      "id": 3,
      "text": "Albion started as a ranching community and grew quickly because of its location near the Oregon Trail.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://albionidaho.org/about-albion/"
    },
    {
      "id": 4,
      "text": "In 1893 the Albion State Normal School opened, training Idaho teachers until its 1951 closure.",
      "sourceSentenceIds": [
        8,
        9
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://albionidaho.org/about-albion/"
    },
    {
      "id": 5,
      "text": "Albion served as Cassia County’s seat from 1879 to 1918, a key period in its civic history.",
      "sourceSentenceIds": [
        16
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Albion%2C_Idaho"
    },
    {
