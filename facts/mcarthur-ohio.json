  "facts": [
    {
      "id": 1,
      "text": "McArthur was laid out and platted in 1815, named after War of 1812 general Duncan McArthur.",
      "sourceSentenceIds": [
        6,
        2
      ],
      "sourceLabels": [
        "Web source 1",
        "Wikipedia"
      ],
      "source": "https://grokipedia.com/page/McArthur_Ohio",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The village’s oldest building, the McArthur Hotel, dates to 1839 and has survived as a historic landmark.",
      "sourceSentenceIds": [
        3,
        18
      ],
      "sourceLabels": [
        "Web source 1",
        "Wikipedia"
      ],
      "source": "https://grokipedia.com/page/McArthur_Ohio",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "McArthur sits at the junction of U.S. Route 50 and Ohio State Route 93, placing it in southeastern Ohio’s Hocking Hills region.",
      "sourceSentenceIds": [
        1,
        19,
        20
      ],
      "sourceLabels": [
        "Web source 1",
        "Wikipedia"
      ],
      "source": "https://grokipedia.com/page/McArthur_Ohio",
      "category": "transport",
      "quality": "poor",
      "qualityReason": "route_only"
    },
    {
      "id": 4,
      "text": "In the 21st century, redevelopment of the former McArthur Brick Company site into a park is part of a larger abandoned‑mine reclamation effort.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/McArthur_Ohio",
      "category": "other",
      "quality": "poor",
      "qualityReason": "other"
    },
    {
      "id": 5,
      "text": "McArthur’s founding investors purchased a quarter of section 21 in what was then Athens County before it became Vinton County.",
