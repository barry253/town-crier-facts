    {
      "id": 1,
      "text": "Eaton was originally called Buckner's Bluff after early settler J.W., founded around 1824.",
      "sourceSentenceIds": [
        8,
        3,
        9
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Eaton%2C_Tennessee",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "In 1827 the town was renamed Eaton to honor John H., a Tennessee native and ally of Andrew Jackson.",
      "sourceSentenceIds": [
        1,
        5,
        7,
        10
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1",
        "Web source 2"
      ],
