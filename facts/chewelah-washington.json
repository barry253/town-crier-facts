    },
    {
      "id": 3,
      "text": "Chewelah was officially incorporated on January 26, 1903, the same year its newspaper The Independent began publishing.",
      "sourceSentenceIds": [
        27,
        3
      ],
      "sourceLabels": [
        "Wikipedia",
        "Wikipedia"
