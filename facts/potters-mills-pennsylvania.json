  "facts": [
    {
      "id": 1,
      "text": "Potters Mills named after General James Potter, who built a log cabin and grist mill at the intersection of General Potter Highway and Old Fort Road.",
      "sourceSentenceIds": [
        12,
        13,
        11
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Potters_Mills%2C_Pennsylvania"
    },
    {
      "id": 2,
      "text": "The village once hosted a grist mill, woolen factory, store, tavern, distillery, and homes, making it a bustling 18th‑century hub.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://centrehistory.org/article/potter-allison-farm/"
    },
    {
      "id": 3,
      "text": "Potter‑Allison Farm, just west of the village, is on the National Register and includes a historic house, barn, springhouse, and six other buildings.",
      "sourceSentenceIds": [
        6,
        7
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://centrehistory.org/article/potter-allison-farm/"
    },
    {
      "id": 4,
      "text": "The Lewistown‑Bellefonte Turnpike ran north‑south through Potters Mills, meeting the Lewisburg‑Old Fort road at the Old Fort Tavern.",
      "sourceSentenceIds": [
        17
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://centre.pagenweb.org/twpsboros/pottwp1.htm"
    },
    {
      "id": 5,
      "text": "General Potter, an Irish immigrant, led troops in the Revolutionary War and later owned about 6,000 acres where he built his mill.",
      "sourceSentenceIds": [
        27,
        28,
        29
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://centrehistory.org/article/potter-allison-farm/"
    },
    {
      "id": 6,
      "text": "Potters Mills lies within Potter Township, one of Centre County’s original townships established in 1774.",
