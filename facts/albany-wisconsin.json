  "facts": [
    {
      "id": 1,
      "text": "Albany was first called Campbell's Ford, settled by James Campbell and Thomas Stewart in 1839.",
      "sourceSentenceIds": [
        18
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.albanywi.org/history/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The Sugar River, once called Tonasookarah meaning sugar, powered two flour mills, a saw mill, a cabinet factory, a corn mill, and a woolen carding machine.",
      "sourceSentenceIds": [
        2,
        17
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.albanywi.org/history/",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "In the late 1800s Albany earned the nickname “River of Pearls” because the Sugar River was rich in oysters and clams.",
      "sourceSentenceIds": [
        25
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.albanywi.org/history/",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The Albany Historical Society Museum preserves local history and offers tubing and canoeing on the Sugar River Trail.",
      "sourceSentenceIds": [
        1,
        4
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://nhccmuseum.org/plan-a-visit/albany-wi/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The village’s first schoolhouse, built in 1858, measured thirty by fifty feet and was two stories tall.",
      "sourceSentenceIds": [
        28
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.albanywi.org/history/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "A 112‑foot‑tall church spire, completed in the 19th century, became a landmark that drew travelers to Albany.",
      "sourceSentenceIds": [
        29
      ],
      "sourceLabels": [
        "Web source 1"
      ],
