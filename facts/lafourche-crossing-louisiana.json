  "facts": [
    {
      "id": 1,
      "text": "Bayou Lafourche was a vital migration route in the late 1700s, drawing French, Spanish, Acadian, and German settlers seeking fertile alluvial lands.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/lafourche_crossing_louisiana",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The Battle of Lafourche Crossing on June 20–21, 1863, marked a key Civil War clash that reshaped the local agricultural landscape.",
      "sourceSentenceIds": [
        21
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/lafourche_crossing_louisiana",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "After 1820, sugarcane plantations along Bayou Lafourche grew, using the crossing to ship crops to New Orleans markets.",
      "sourceSentenceIds": [
        19
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/lafourche_crossing_louisiana",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "In the 1970s and 1980s, levees and floodwalls were built along Bayou Lafourche, raising protection to 10–13 feet above sea level.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/lafourche_crossing_louisiana",
      "category": "other",
      "quality": "poor",
      "qualityReason": "other"
    },
    {
      "id": 5,
      "text": "Ferries were replaced by fixed bridges; a pontoon bridge supplanted the ferry at Golden Meadow in 1950, easing traffic to Thibodaux.",
      "sourceSentenceIds": [
        26
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/lafourche_crossing_louisiana",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The mid‑20th‑century oil boom spurred economic diversification in Lafourche Crossing, moving the community beyond its agricultural roots.",
