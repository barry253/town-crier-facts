        10
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Westerlo%2C_New_York",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Year‑round events pulse through Westerlo’s Heritage Museum, Public Library, Volunteer Fire Company, churches, and community groups.",
