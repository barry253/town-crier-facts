      "id": 1,
      "text": "Sarah Ann was named for Sarah O'Toole and Ann Shanklin, the wives of a coal official and a company doctor.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
