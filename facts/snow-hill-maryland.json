  "facts": [
    {
      "id": 1,
      "text": "Snow Hill was founded in 1686 by English settlers, possibly named after a London neighborhood, despite its low elevation and rare snowfall.",
      "sourceSentenceIds": [
        1,
        2
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Snow_Hill%2C_Maryland",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "In 1694 Snow Hill became a port of entry, making it a key river town on the Pocomoke River for Chesapeake Bay trade.",
      "sourceSentenceIds": [
        16
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Snow_Hill%2C_Maryland",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Major fires in 1844 and 1893 destroyed the commercial core, but the town rebuilt, leaving many late 19th‑century historic buildings downtown.",
      "sourceSentenceIds": [
        18,
        7
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Snow_Hill%2C_Maryland",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The Snow Hill Historic District, covering about 80% of town, was designated in 2002, preserving its rich architectural heritage.",
      "sourceSentenceIds": [
        19
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Snow_Hill%2C_Maryland",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Snow Hill High School hosted scenes of the 1999 film Runaway Bride, bringing Hollywood to this small Maryland town.",
      "sourceSentenceIds": [
        12,
        13
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Snow_Hill%2C_Maryland",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Snow Hill became Worcester County's seat in 1742 after the county split from Somerset, placing it at the head of navigation on the Pocomoke River.",
      "sourceSentenceIds": [
        17
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Snow_Hill%2C_Maryland",
