  "facts": [
    {
      "id": 1,
      "text": "Andrew Straub, a millwright and miller, founded Milton in 1791 in the heart of Central Pennsylvania.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.visitcentralpa.org/plan-your-trip-today/towns-and-countrysides/milton/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Milton was named for James Cameron, a resident who fell at the First Battle of Bull Run.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.visitcentralpa.org/plan-your-trip-today/towns-and-countrysides/milton/",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Downtown murals chronicle Milton’s journey from canal boats to modern trucks along the Susquehanna River.",
      "sourceSentenceIds": [
        20,
        21
      ],
      "sourceLabels": [
        "Web source 1",
        "Web source 2"
      ],
      "source": "https://www.visitcentralpa.org/plan-your-trip-today/towns-and-countrysides/milton/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "ACF Industries, once Milton Car Works, pioneered the world’s first railroad tank car.",
      "sourceSentenceIds": [
        10,
        15
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.visitcentralpa.org/plan-your-trip-today/towns-and-countrysides/milton/",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The Milton Public Library on Rose Hill hosts events in a historic civic building.",
