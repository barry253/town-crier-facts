      "quality": "poor",
      "qualityReason": "location_description"
    },
    {
      "id": 3,
      "text": "The Gardner Mansion and Museum, built in 1884, once housed the Choctaw chief and now preserves regional history.",
      "sourceSentenceIds": [
        18
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Broken_Bow%2C_Oklahoma",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The Indian Memorial Museum displays pre‑historic pottery, fossils, quartz crystal, and antique glass, showcasing Native American heritage.",
      "sourceSentenceIds": [
        19
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Broken_Bow%2C_Oklahoma",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Historic Broken Bow Memorial Stadium, built by the WPA in the 1930s, has been home to the high school football Savages ever since.",
      "sourceSentenceIds": [
