    },
    {
      "id": 2,
      "text": "The city lies within Oklahoma's Little Dixie, an area settled largely by Southerners after the Civil War.",
      "sourceSentenceIds": [
        13
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Broken_Bow%2C_Oklahoma"
    },
    {
      "id": 3,
      "text": "The Gardner Mansion and Museum, built in 1884, once housed the Choctaw chief and now preserves regional history.",
      "sourceSentenceIds": [
        18
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Broken_Bow%2C_Oklahoma"
    },
    {
      "id": 4,
      "text": "The Indian Memorial Museum displays pre‑historic pottery, fossils, quartz crystal, and antique glass, showcasing Native American heritage.",
      "sourceSentenceIds": [
