      "id": 1,
      "text": "De Baarsjes takes its name from a 17th‑century inn called de drie baarsjes, meaning 'the three basses'.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 2"
      ],
