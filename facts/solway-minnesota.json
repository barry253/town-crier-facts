      "id": 1,
      "text": "Solway, Minnesota, takes its name from the Solway Firth in Scotland, a choice suggested by a local engineer.",
      "sourceSentenceIds": [
        2,
        4,
        6
      ],
      "sourceLabels": [
        "Wikipedia",
