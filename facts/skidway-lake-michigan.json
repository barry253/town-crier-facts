  "facts": [
    {
      "id": 1,
      "text": "Skidway Lake’s name comes from the Anishinaabe word ogimaa, meaning “chief,” honoring Chippewa leader Ogemaw‑Ke‑Ke‑To who negotiated the 1819 Treaty of Saginaw.",
      "sourceSentenceIds": [
        26
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/skidway_lake_michigan",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Before Europeans arrived, the Ojibwe of the Anishinaabe people used the Skidway Lake area for seasonal travel, fishing, hunting, and gathering wild rice.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/skidway_lake_michigan",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Logging camps sprang up around 1871, exploiting white pine forests; by the 1880s roads and rail lines were built to haul timber to Saginaw mills.",
      "sourceSentenceIds": [
        28
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/skidway_lake_michigan",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The lake itself covers roughly 34 acres, part of a network of interconnected lakes that span Ogemaw County’s forests and wetlands.",
      "sourceSentenceIds": [
        24
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/skidway_lake_michigan",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Skidway Lake experiences a humid continental climate, with cold snowy winters averaging 20°F and warm humid summers reaching highs near 80°F.",
      "sourceSentenceIds": [
        23
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/skidway_lake_michigan",
      "category": "other",
      "quality": "poor",
      "qualityReason": "vague"
    },
    {
      "id": 6,
      "text": "A post office operated in Skidway Lake from 1959 until it closed in 1999.",
