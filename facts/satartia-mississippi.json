  "facts": [
    {
      "id": 1,
      "text": "Satartia sits on the east bank of the Yazoo River, making it a key spot for river trade.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Satartia%2C_Mississippi",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Satartia's name comes from a Choctaw word meaning 'pumpkin place,' reflecting local gourds.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Satartia%2C_Mississippi",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "In the early 1800s, Satartia was a busy cotton shipping point, with steamboats carrying goods to New Orleans.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Satartia%2C_Mississippi",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "During the Civil War, General Ulysses S. Grant captured Satartia, using the Wilson House on Plum Street as his headquarters.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Satartia%2C_Mississippi",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The 'Satartia Rifles' formed part of the 12th Mississippi Infantry Regiment, a respected Confederate company recruited in the village.",
      "sourceSentenceIds": [
        11
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Satartia%2C_Mississippi",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Satartia is one of Yazoo County's oldest non‑Native settlements, established in the early 19th century and long serving as a regional hub.",
      "sourceSentenceIds": [
