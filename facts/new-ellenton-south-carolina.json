    },
    {
      "id": 2,
      "text": "New Ellenton was formed when residents literally moved their homes and buildings fourteen miles north after being evicted in the 1950s.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/New_Ellenton%2C_South_Carolina"
    },
    {
      "id": 3,
      "text": "The U.S. government displaced six thousand residents to make room for the Savannah River Site nuclear weapons production facility.",
      "sourceSentenceIds": [
        27
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://cityofnewellenton.sc.gov/resources/ellenton-history"
    },
    {
      "id": 4,
      "text": "New Ellenton began as a two hundred acre development to accommodate workers arriving for the Savannah River Site construction.",
      "sourceSentenceIds": [
        3
      ],
