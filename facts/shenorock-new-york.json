  "facts": [
    {
      "id": 1,
      "text": "Shenorock takes its name from the Native American sachem Shawanórõckquot of the Wiechquaeskeck tribe.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Shenorock%2C_New_York"
    },
    {
      "id": 2,
      "text": "Part of the town of Somers, it sits near the Croton River and is known for its semi‑rural character, with historic farmhouses and wooded areas.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.trawellino.com/destinations/united-states/new-york_shenorock"
    },
    {
      "id": 3,
      "text": "While we don't have a date for the founding of Shenorock, you might consider that their post office opened in 1936.",
      "sourceSentenceIds": [
        22
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://roadsidethoughts.com/ny/shenorock-xx-westchester-profile.htm"
    },
    {
      "id": 4,
      "text": "Shenorock sits roughly 500 feet above sea level, giving it a gentle elevation compared to surrounding areas.",
      "sourceSentenceIds": [
        23
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://roadsidethoughts.com/ny/shenorock-xx-westchester-profile.htm"
    },
    {
      "id": 5,
      "text": "Shenorock lies just north of the Amawalk Reservoir, placing it near one of Westchester County's largest bodies of water.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Shenorock%2C_New_York"
    },
    {
      "id": 6,
      "text": "The community is bounded by U.S. Route 202 to the south and New York State Route 118 to the west.",
      "sourceSentenceIds": [
        8,
        9
      ],
