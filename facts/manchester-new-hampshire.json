  "facts": [
    {
      "id": 1,
      "text": "Manchester was renamed from Derryfield in 1810 after Samuel Blodgett, whose name lives on in Blodgett Street and Samuel Blodgett Park.",
      "sourceSentenceIds": [
        2,
        3
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Manchester%2C_New_Hampshire",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Amoskeag engineers designed Manchester as a model company town, laying out Elm Street as the main thoroughfare in 1838.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Manchester%2C_New_Hampshire",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The Millyard Museum, housed in Mill No. 3, preserves the story of Manchester’s largest textile factory, once the world’s biggest.",
      "sourceSentenceIds": [
        22,
        23,
        11
      ],
      "sourceLabels": [
        "Web source 2",
        "Wikipedia"
      ],
      "source": "https://manchesterhistoric.org/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Manchester’s downtown has seen a renaissance, with former mill tenements now stylish condominiums that echo the city’s industrial past.",
