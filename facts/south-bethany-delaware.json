      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town’s name was chosen to ride the popularity of Bethany Beach, with developers selling 50‑by‑100‑foot lots in the late 1950s.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
