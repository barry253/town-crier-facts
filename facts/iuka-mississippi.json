  "facts": [
    {
      "id": 1,
      "text": "Iuka was founded in 1857 by wagon‑train scout David Hubbard, with Euro‑American settlers arriving that same year via the Memphis‑and‑Charleston Railroad.",
      "sourceSentenceIds": [
        2,
        5
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Iuka%2C_Mississippi",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The city sits on the former Chickasaw village of Iuka, named after a local chief who led the settlement.",
      "sourceSentenceIds": [
        3,
        15,
        16
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://iukams.com/",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "On September 19, 1862, the Battle of Iuka killed or wounded 1,200‑1,500 soldiers, and the trench where Confederates fell became Shady Grove Cemetery.",
      "sourceSentenceIds": [
        12,
        18,
        19
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Iuka%2C_Mississippi",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Iuka Normal Institute, the first normal school built in the former Confederacy after the war, opened here in 1869.",
      "sourceSentenceIds": [
        20
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Iuka%2C_Mississippi",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The TVA’s Pickwick Landing Dam and Pickwick Lake, completed in the 1940s, revitalized Iuka’s economy and drew new visitors.",
      "sourceSentenceIds": [
        11
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Iuka%2C_Mississippi",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Just south of Iuka lies Woodall Mountain, Mississippi’s highest point, offering sweeping views of the surrounding hills.",
      "sourceSentenceIds": [
