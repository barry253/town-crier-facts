  "facts": [
    {
      "id": 1,
      "text": "Dilworth is Charlotte’s first streetcar suburb, founded in the 1890s when Edward Dilworth Latta turned 250 acres of farmland into a planned community.",
      "sourceSentenceIds": [
        13,
        3
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://dilworthcenter.org/dilworth-charlotte-a-historic-neighborhoods-story-and-community-legacy/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "In 1987, most of Dilworth earned a spot on the National Register of Historic Places, with a boundary expansion in 2000 to include later growth.",
      "sourceSentenceIds": [
        14
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://dilworthcenter.org/dilworth-charlotte-a-historic-neighborhoods-story-and-community-legacy/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The neighborhood’s streets are lined with front‑porch bungalows and Late Victorian homes, many still showing original wood siding and leaded‑glass windows.",
      "sourceSentenceIds": [
        6,
        15
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://dilworthcenter.org/dilworth-charlotte-a-historic-neighborhoods-story-and-community-legacy/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Atrium Health Carolinas Medical Center, opened in 1940, anchors Dilworth as the region’s only Level I trauma center, blending historic roots with modern care.",
      "sourceSentenceIds": [
        7,
        17
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://dilworthcenter.org/dilworth-charlotte-a-historic-neighborhoods-story-and-community-legacy/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Dilworth’s historic district protects 1,025 structures, making it one of Charlotte’s most architecturally diverse neighborhoods.",
      "sourceSentenceIds": [
        11,
        9
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.dilworthonline.org/history",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "A two‑tower apartment complex, Radius Dilworth, is under construction on a 2.8‑acre site at 615 E Morehead, adding 624 new apartments to the area.",
