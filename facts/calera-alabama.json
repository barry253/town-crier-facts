  "facts": [
    {
      "id": 1,
      "text": "Calera’s name comes from the Spanish word for limestone, a nod to the town’s historic lime industry.",
      "sourceSentenceIds": [
        5,
        7,
        13
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Calera%2C_Alabama",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The city officially incorporated on February 21, 1893, after growing around the lime kilns that once dotted the area.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.shelbyal.com/789/Calera",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "During the Civil War, Calera’s limestone quarries supplied lime for the Confederacy, and the town suffered little damage.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://encyclopediaofalabama.org/article/calera/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The Alabama and Tennessee River Railroad reached Calera in 1854‑55, turning the town into a shipping hub for lime across the country.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://encyclopediaofalabama.org/article/calera/",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Calera Presbyterian Church, the Carter Residence, and Cowart Drug Store are listed on the Alabama Register of Landmarks and Heritage.",
