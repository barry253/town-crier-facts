  "facts": [
    {
      "id": 1,
      "text": "Hackberry emerged in late 19th century as a Cajun fishing and farming community in Cameron Parish marshlands.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/hackberry_louisiana",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town sits on the west side of Calcasieu Lake, a brackish estuary linked to the Intracoastal Waterway.",
      "sourceSentenceIds": [
        30
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/hackberry_louisiana",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Hackberry’s landscape is dominated by lakes, streams, bayous, and chênières—elevated oak ridges that offer outdoor recreation amid swamplands.",
      "sourceSentenceIds": [
        26
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/hackberry_louisiana",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The Hackberry Rod & Gun, founded in 1975, is known for light‑tackle saltwater fishing and duck hunting along the Gulf Coast.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://visitcameronparish.org/sleep_cat/hackberry/",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "A Grammy‑nominated Cajun group, the Hackberry Ramblers, hails from this small Louisiana community.",
