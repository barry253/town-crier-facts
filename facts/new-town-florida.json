  "facts": [
    {
      "id": 1,
      "text": "Newtown began as a predominantly Black neighborhood, its name honoring the many Bahamian residents who settled there.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Neighborhoods_in_Key_West%2C_Florida",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Since 1914, Newtown has been the heart of Sarasota’s African‑American community, beginning with 240 lots laid out that year.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.newtownnation.com/about-us/who-we-are/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Early Newtown offered more land and homes than Overtown, yet it initially lacked paved roads and electrical power.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.newtownnation.com/about-us/who-we-are/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Black labor cleared snake‑infested land, laid railroad ties, harvested celery, and helped plat golf courses for Sarasota’s power brokers.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.sarasotafl.gov/Department-Pages/Planning/Historic-Preservation-Program/Newtown-History",
      "category": "people",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "A scholarly study titled “Newtown: Past and Present: 1914‑2014” documents the area’s African‑American history in depth.",
      "sourceSentenceIds": [
