    {
      "id": 1,
      "text": "Hawkinsville was founded in 1830 and became Pulaski County seat in 1836.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Hawkinsville%2C_Georgia",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The city is named after Colonel Benjamin Hawkins, a former Continental Congress delegate from North Carolina.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Hawkinsville%2C_Georgia",
      "category": "people",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Hawkinsville sits on the Ocmulgee River, a historic trade route that once carried cotton to steamboats.",
      "sourceSentenceIds": [
        4,
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.georgiaencyclopedia.org/articles/counties-cities-neighborhoods/hawkinsville/",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The Old Opera House, completed in 1908, now serves as a National Register landmark after a 2001 renovation.",
      "sourceSentenceIds": [
        5,
        12,
        20
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.georgiaencyclopedia.org/articles/counties-cities-neighborhoods/hawkinsville/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Known as the \"Harness Horse Capital of Georgia,\" Hawkinsville hosts an annual Harness Horse Festival each spring.",
      "sourceSentenceIds": [
        26,
        17
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 2"
      ],
      "source": "https://en.wikipedia.org/wiki/Hawkinsville%2C_Georgia",
      "category": "culture",
      "quality": "good"
    },
    {
