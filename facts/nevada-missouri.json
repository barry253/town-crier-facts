      ],
      "source": "https://en.wikipedia.org/wiki/Nevada%2C_Missouri",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The Vernon County Courthouse, built in 1875, sits on the National Register of Historic Places and anchors Nevada’s historic core.",
      "sourceSentenceIds": [
        23
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Nevada%2C_Missouri",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Nevada serves as the county seat of Vernon County, making it the administrative heart of the region.",
      "sourceSentenceIds": [
        24
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Nevada%2C_Missouri",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The Osage Village State Historic Site, once the Carrington Osage Village, overlooks the Osage River valley just north of Nevada.",
      "sourceSentenceIds": [
        14
      ],
      "sourceLabels": [
