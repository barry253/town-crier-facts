  "facts": [
    {
      "id": 1,
      "text": "Bloomington, Idaho, was first settled in April 1864 by Mormon pioneers from Cache Valley, Utah, as part of the Bear Lake Valley colonization.",
      "sourceSentenceIds": [
        20
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/bloomington_idaho",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town’s name was chosen after a bountiful harvest, echoing Bloomington, Illinois, and highlighting its early agricultural focus.",
      "sourceSentenceIds": [
        23
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/bloomington_idaho",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "During its first winter of 1864–1865, deep snow, blizzards, and crop failures tested the resolve of about 41 founding families.",
      "sourceSentenceIds": [
        22
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/bloomington_idaho",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Preservation efforts in the 20th century kept many late‑1800s homes intact, giving Bloomington a distinctive pioneer‑era architectural character.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/bloomington_idaho",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Bloomington is governed by a mayor‑council system, with Mayor Roy Bunderson overseeing services while preserving its pioneer heritage.",
      "sourceSentenceIds": [
        25
      ],
      "sourceLabels": [
