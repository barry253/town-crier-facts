  "facts": [
    {
      "id": 1,
      "text": "Waccabuc began in 1776 when Enoch Mead settled near Lake Waccabuc with his wife Jemima.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/Waccabuc,_New_York",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The hamlet’s private Lake Waccabuc sits at the heart of the community, surrounded by low‑density homes.",
      "sourceSentenceIds": [
        24
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/Waccabuc,_New_York",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "In 1912 the Mead family estate became Waccabuc Country Club, offering an 18‑hole course and social facilities.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/Waccabuc,_New_York",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The Mead Memorial Chapel and The Homestead are listed on the National Register of Historic Places, preserving early architecture.",
      "sourceSentenceIds": [
        15
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Waccabuc%2C_New_York",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The retreat once boasted “no tramps, bars, or malaria,” reflecting its exclusive early character.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Waccabuc%2C_New_York",
      "category": "other",
      "quality": "poor",
      "qualityReason": "other"
    },
    {
      "id": 6,
      "text": "Mead Street, a one‑mile stretch, grew from eight houses built by the Mead descendants, shaping the hamlet’s rural layout.",
