      "id": 1,
      "text": "Riverside was founded in 1870 by John North and a group of Easterners who wanted to create a colony focused on education and culture.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 1"
      ],
