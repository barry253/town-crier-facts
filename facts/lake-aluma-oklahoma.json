  "facts": [
    {
      "id": 1,
      "text": "Lake Aluma is a small, secluded town located in a valley adjacent to the Deep Fork River.",
      "sourceSentenceIds": [
        28
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.okhistory.org/publications/enc/entry?entry=LA006"
    },
    {
      "id": 2,
      "text": "The community of Lake Aluma originated as a residential development created by a thirty-member organization called the Lake Aluma Club.",
      "sourceSentenceIds": [
        29
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.okhistory.org/publications/enc/entry?entry=LA006"
    },
    {
      "id": 3,
      "text": "Lake Aluma was named after Aluma Chulosa, which is said to be Choctaw for peaceful retreat.",
      "sourceSentenceIds": [
        6,
        30
      ],
      "sourceLabels": [
        "Web source 1",
        "Web source 2"
      ],
      "source": "https://www.okhistory.org/publications/enc/entry?entry=LA006"
    },
    {
      "id": 4,
      "text": "The area around Lake Aluma served as a popular hilly and wooded camping spot for city dwellers in the early twentieth century.",
      "sourceSentenceIds": [
        30
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.okhistory.org/publications/enc/entry?entry=LA006"
    },
    {
      "id": 5,
      "text": "Lake Aluma developed as an incorporated town during the 1920s in Oklahoma County.",
      "sourceSentenceIds": [
        28
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.okhistory.org/publications/enc/entry?entry=LA006"
    },
    {
      "id": 6,
      "text": "Every resident of Lake Aluma lives in a rural area, as the town has no urban residents.",
