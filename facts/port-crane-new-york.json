  "facts": [
    {
      "id": 1,
      "text": "Port Crane earned its name from Jason Crane, a canal engineer who helped build the Chenango Canal.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Fenton%2C_New_York"
    },
    {
      "id": 2,
      "text": "When the Chenango Canal opened, Port Crane flourished, but the town’s prosperity vanished once the canal closed in 1876.",
      "sourceSentenceIds": [
        19,
        20,
        21
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Fenton%2C_New_York"
    },
    {
      "id": 3,
      "text": "Port Crane was carved out of the town of Chenango in 1855, becoming its own community.",
      "sourceSentenceIds": [
        16
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Fenton%2C_New_York"
    },
    {
      "id": 4,
      "text": "The Chenango River marks Port Crane’s western boundary, flowing along the town’s edge.",
      "sourceSentenceIds": [
        22
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Fenton%2C_New_York"
    },
    {
      "id": 5,
      "text": "New York State Route 7 runs parallel to the interstate just north of Port Crane, offering scenic drives.",
      "sourceSentenceIds": [
        23
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Fenton%2C_New_York"
    },
    {
      "id": 6,
      "text": "Today, Port Crane remains a hamlet within the larger town of Fenton, preserving its historic roots.",
      "sourceSentenceIds": [
