  "facts": [
    {
      "id": 1,
      "text": "Belle Vernon was laid out in 1813 by Noah Speers, originally spelled Bellevernon, meaning \"beautiful green\" in French.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/Belle_Vernon,_Pennsylvania",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town’s early economy boasted a bustling boatyard on 3rd Street in the 1830s and 1840s, employing over 50 workers.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Belle_Vernon%2C_Pennsylvania",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Belle Vernon sits on the Monongahela River, where the river defines its western edge and has shaped local life for centuries.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/Belle_Vernon,_Pennsylvania",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The borough’s rail history includes the Wheeling and Lake Erie Railway’s Mon Valley line, crossing the river on the Speers Railroad Bridge for freight.",
      "sourceSentenceIds": [
        18
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/Belle_Vernon,_Pennsylvania",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Belle Vernon hosts an annual Easter Egg Extravaganza, a community event that highlights its riverfront heritage.",
      "sourceSentenceIds": [
        16
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/Belle_Vernon,_Pennsylvania",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The Monongahela Valley, where Belle Vernon lies, was once home to the Monongahela culture, a Native American people active until about 1635.",
      "sourceSentenceIds": [
        19
      ],
