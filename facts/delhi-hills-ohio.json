    },
    {
      "id": 2,
      "text": "The community was founded in the 1950s as one of Cincinnati's first post‑war suburbs, built to house returning veterans.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Web source 2"
      ],
