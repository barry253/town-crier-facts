    {
      "id": 3,
      "text": "Al Barsha sits in western Dubai, bordered by Al Sufouh, Emirates Hills, Jumeirah Village Circle, Dubai Motor City, Al Quoz, and Dubai Hills.",
      "sourceSentenceIds": [
        12,
        13,
        14
