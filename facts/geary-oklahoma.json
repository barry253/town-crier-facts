      ],
      "source": "https://en.wikipedia.org/wiki/Geary%2C_Oklahoma"
    },
    {
      "id": 3,
      "text": "Geary once supported a diverse economy featuring a broom factory, a bottling works, and eleven different saloons.",
      "sourceSentenceIds": [
        10
      ],
