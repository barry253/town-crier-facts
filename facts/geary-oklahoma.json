    },
    {
      "id": 2,
      "text": "The town of Geary was moved to its current site to align with the proposed route of the Choctaw, Oklahoma and Gulf Railroad.",
      "sourceSentenceIds": [
        11,
        15
      ],
      "sourceLabels": [
        "Wikipedia",
