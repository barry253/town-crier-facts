  "facts": [
    {
      "id": 1,
      "text": "Berlin, Alabama was first called Hobart, a name likely honoring New Jersey Congressman Garret Hobart, who served as vice‑president under William McKinley.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Berlin%2C_Alabama",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Berlin sprang in the late 1870s as part of German colonization led by Johann Gottfried Cullmann, a land agent for the Louisville‑and‑Nashville Railroad.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/berlin_alabama",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Berlin was settled largely by German immigrants in the late nineteenth century, extending the nearby German‑founded city of Cullman.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/berlin_alabama",
      "category": "people",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The Lidy Walker Covered Bridge, a 50‑foot wooden span built in 1926 over Big Branch, was relocated to Berlin 32 years after its construction.",
      "sourceSentenceIds": [
        3,
        7
      ],
      "sourceLabels": [
        "Web source 2",
        "Wikipedia"
      ],
      "source": "https://grokipedia.com/page/berlin_alabama",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Berlin was officially incorporated as a municipality in 2018, becoming the 12th town in Cullman County.",
      "sourceSentenceIds": [
        14
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/berlin_alabama",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Route 278 meets Cullman County Road 747 at Walker's Corner, the heart of Berlin.",
