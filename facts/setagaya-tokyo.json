      "category": "culture",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Setagaya Ward was officially established on March 15, 1947, after merging several former villages into Tokyo’s municipal structure.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
