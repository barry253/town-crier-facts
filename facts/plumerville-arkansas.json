  "facts": [
    {
      "id": 1,
      "text": "Plumerville began as Plummer's Station, a stage stop on the Butterfield Overland Mail route.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Plumerville%2C_Arkansas"
    },
    {
      "id": 2,
      "text": "In 1873, the community’s cooperation secured Plummer’s Station as a full stop on the new railroad, avoiding flood‑prone areas.",
      "sourceSentenceIds": [
        4,
        7
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://plumerville.net/"
    },
    {
      "id": 3,
      "text": "The old downtown area was completely destroyed by a fire in 1987, reshaping the town’s core.",
      "sourceSentenceIds": [
        20
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Plumerville%2C_Arkansas"
    },
    {
      "id": 4,
      "text": "The original town jail, built around 1880, still stands on Springfield Street near the new city hall.",
      "sourceSentenceIds": [
        21
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Plumerville%2C_Arkansas"
    },
    {
      "id": 5,
      "text": "Plumerville sits at 35°9′39″N 92°38′34″W, along U.S. Route 64, 5 miles east of Menifee and 6 miles west of Morrilton.",
