  "facts": [
    {
      "id": 1,
      "text": "Carlstadt was originally formed as a village by an act of the New Jersey Legislature on March 12, 1860, within Lodi Township.",
      "sourceSentenceIds": [
        7,
        8
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Carlstadt%2C_New_Jersey",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The borough was incorporated on June 27, 1894, formally separating from Bergen Township during the 1894 “Boroughitis” boom.",
      "sourceSentenceIds": [
        16,
        17
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Carlstadt%2C_New_Jersey",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Most historians say the name Carlstadt honors Carl Klein, a leader of early German settlers, though some claim it was named after Karlovac in Croatia.",
      "sourceSentenceIds": [
        4,
        6
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 2"
      ],
      "source": "https://en.wikipedia.org/wiki/Carlstadt%2C_New_Jersey",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Carlstadt once had a rail station on the Hackensack and New York Railroad, which closed in 1967; the tracks are now part of NJ Transit's Pascack Valley Line.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Carlstadt%2C_New_Jersey",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The borough sits about eight miles northwest of New York City, making it a short drive into the metropolis.",
      "sourceSentenceIds": [
        19
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Carlstadt%2C_New_Jersey",
      "category": "other",
      "quality": "poor",
      "qualityReason": "location_description"
    },
    {
      "id": 6,
      "text": "Carlstadt borders East Rutherford, Secaucus, and North Bergen to the south, and Wood-Ridge and Ridgefield to the north and east.",
      "sourceSentenceIds": [
