  "facts": [
    {
      "id": 1,
      "text": "Ruston was incorporated November 10 1906, surrounded by Tacoma and Commencement Bay.",
      "sourceSentenceIds": [
        13
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Ruston%2C_Washington",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town grew around the Tacoma Smelting & Refining Company, a copper smelter acquired by ASARCO in 1905.",
      "sourceSentenceIds": [
        8,
        14
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Ruston%2C_Washington",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The smelter closed 1985 after copper prices fell and arsenic pollution rules tightened, leaving 700 workers unemployed.",
      "sourceSentenceIds": [
        16
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Ruston%2C_Washington",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "In 2013 development began on the former smelter site, now called Point Ruston, with residential and commercial buildings.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Ruston%2C_Washington",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Ruston’s waterfront parkspace and a multi‑use path connect to Point Defiance Park, offering scenic trails along Puget Sound.",
      "sourceSentenceIds": [
        21
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Ruston%2C_Washington",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The city adopted Ordinance 1599 in February 2026, authorizing automated traffic safety cameras under state law.",
