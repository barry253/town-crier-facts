  "facts": [
    {
      "id": 1,
      "text": "Hampton claims to be the oldest continuously occupied English settlement in the U.S., founded after Jamestown was abandoned in 1699.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Hampton%2C_Virginia",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The city was named for Henry Wriothesley, 3rd Earl of Southampton, whose name also graces the Hampton River and Hampton Roads.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Hampton%2C_Virginia",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Founded in 1610, Hampton was the first continuous English‑speaking settlement, America's first free public education, and the training ground for NASA’s first astronauts.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://hampton.gov/91/History-of-City",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Fort Monroe, built by Christopher Newport in 1607, sits on Old Point Comfort and later became a National Monument under President Obama.",
      "sourceSentenceIds": [
        6,
        9
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Hampton%2C_Virginia",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "During the Civil War, Fort Monroe sheltered “Contraband” slaves, leading to the Grand Contraband Camp, the first self‑contained African‑American community in the U.S.",
      "sourceSentenceIds": [
        22
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Hampton%2C_Virginia",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The Grand Contraband Camp’s residents helped establish Hampton University, home of the famous Emancipation Oak that witnessed the 1863 Emancipation Proclamation.",
      "sourceSentenceIds": [
        23
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Hampton%2C_Virginia",
      "category": "history",
      "quality": "good"
    }
