  "facts": [
    {
      "id": 1,
      "text": "Millfield’s name comes from the nearby Millfield Creek, which once powered a local gristmill that served the early settlers.",
      "sourceSentenceIds": [
        11
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Millfield%2C_Ohio",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town’s post office opened in 1827, making Millfield one of the oldest continuously operating postal sites in Athens County.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Millfield%2C_Ohio",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Millfield sits just off State Route 13, a road that was rerouted in the 1970s to bypass the community and reduce traffic through the historic center.",
      "sourceSentenceIds": [
        8,
        9
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Millfield%2C_Ohio",
      "category": "other",
      "quality": "poor",
      "qualityReason": "location_description"
    },
    {
      "id": 4,
      "text": "In 1930, the Sunday Creek Coal Company Mine exploded, killing 82 men and becoming the worst mine disaster in Ohio history.",
      "sourceSentenceIds": [
        2,
        3,
        21
      ],
      "sourceLabels": [
        "Web source 1",
        "Wikipedia"
      ],
      "source": "https://sites.ohio.edu/library-archives-blog/2025/04/23/jour-4130-the-cost-of-coal/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "After the 1930 disaster, nineteen miners were rescued two miles away about ten hours later, a dramatic rescue that drew national press attention.",
      "sourceSentenceIds": [
        27,
        28
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://sites.ohio.edu/library-archives-blog/2025/04/23/jour-4130-the-cost-of-coal/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The Millfield Mine Disaster is still remembered in Ohio archives, where scholars study how media coverage framed labor exploitation and safety failures.",
