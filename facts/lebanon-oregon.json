      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.visitoregon.com/cities/lebanon-oregon/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Lebanon sits beside the South Santiam River on the eastern edge of the Willamette Valley, near the Cascade Range.",
      "sourceSentenceIds": [
