  "facts": [
    {
      "id": 1,
      "text": "Goldstream’s name comes from Goldstream Creek, formed by the confluence of Pedro and Gilmore Creeks, flowing west to the Chena River.",
      "sourceSentenceIds": [
        13
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/goldstream_alaska",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Goldstream Valley was a goldfield with pay streaks up to six feet thick and hundreds of feet wide during the Fairbanks Gold Rush.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://shehikesalaska.substack.com/p/under-the-domes-secrets-of-goldstream",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Placer deposits first discovered on Pedro Creek in 1902 sparked a mining boom that shaped the Goldstream Valley.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/goldstream_alaska",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "From the 1920s to the 1950s, Fairbanks Exploration Company performed hydraulic stripping and dredging, moving millions of cubic yards of gravel into Goldstream Creek.",
      "sourceSentenceIds": [
        24
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/goldstream_alaska",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The valley’s alluvial deposits include the Fox Gravel formation, gold‑bearing gravels up to 20 feet thick, overlain by perennially frozen silts of the Goldstream Formation.",
      "sourceSentenceIds": [
        29
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/goldstream_alaska",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Goldstream sits amid dense willow stands, muskeg, and mixed boreal forest, where black and white spruce, paper birch, and alder thrive.",
      "sourceSentenceIds": [
        30
