  "facts": [
    {
      "id": 1,
      "text": "Oakesdale was named in honor of Thomas F. Oakes, a vice president of the Northern Pacific Railroad.",
      "sourceSentenceIds": [
        2,
        5
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.palousescenicbyway.org/oakesdale",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "It is one of the oldest communities in Washington, with several homes and buildings listed on the National Historical Register.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.palousescenicbyway.org/oakesdale",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The Barron Flour Mill, a key landmark, still stands as a testament to Oakesdale’s agricultural heritage.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.palousescenicbyway.org/oakesdale",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The McCoy Valley Museum preserves the town’s pioneer history, showcasing artifacts from the 19th‑century settlement era.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.palousescenicbyway.org/oakesdale",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Oakesdale is surrounded by rolling hills of wheat, peas, and lentils, a classic Palouse landscape.",
      "sourceSentenceIds": [
        29
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.palousescenicbyway.org/oakesdale",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The Kelley Homestead Cabin, built in 1872, is one of the earliest surviving structures in the area.",
      "sourceSentenceIds": [
        30
