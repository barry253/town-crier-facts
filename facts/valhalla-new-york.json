  "facts": [
    {
      "id": 1,
      "text": "Valhalla’s name was chosen by the postmaster’s wife, an admirer of Wagner, to honor Norse mythology and avoid confusion with Kensico station.",
      "sourceSentenceIds": [
        26,
        27,
        28,
        20
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Valhalla%2C_New_York"
    },
    {
      "id": 2,
      "text": "The village’s rise began when the railroad arrived around 1850, and the first station built then gave Valhalla new prominence.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://kes.valhallaschools.org/history/village.jsp"
    },
    {
      "id": 3,
      "text": "A 1890 station building now serves as the Valhalla Station restaurant, still visible beside the tracks.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://kes.valhallaschools.org/history/village.jsp"
    },
    {
      "id": 4,
      "text": "Kensico Cemetery, founded in 1889, was created as a rural cemetery in Valhalla when New York City’s burial grounds were filling up.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Valhalla%2C_New_York"
    },
    {
      "id": 5,
      "text": "Valhalla hosts the main campus of Westchester Medical Center and New York Medical College, making it a regional medical hub.",
      "sourceSentenceIds": [
        25
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Valhalla%2C_New_York"
    },
    {
      "id": 6,
      "text": "The Mount Pleasant Historical Society, founded in 1974, preserves Valhalla’s past and owns the 1732 Jacob Odell House Museum.",
      "sourceSentenceIds": [
        12,
