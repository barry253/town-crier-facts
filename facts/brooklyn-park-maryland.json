  "facts": [
    {
      "id": 1,
      "text": "Brooklyn Park began as a sand and gravel mining pit before evolving into a community recreation area.",
      "sourceSentenceIds": [
        23,
        24
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://mappingbaybrook.org/2018/03/brooklyn-park-anne-arundel-county/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Today the park features eight lighted baseball/softball fields, two multipurpose fields, a 2,640‑foot paved trail, a pavilion, and a seasonal concession stand.",
      "sourceSentenceIds": [
        25
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://mappingbaybrook.org/2018/03/brooklyn-park-anne-arundel-county/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "In 1974, the county and Maryland Department of Natural Resources officially established Brooklyn Park as a full recreational park.",
      "sourceSentenceIds": [
        28
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://mappingbaybrook.org/2018/03/brooklyn-park-anne-arundel-county/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Field No.2 in the park commemorates activist Charles Elliott, who once led the Brooklyn Heights Improvement Association.",
      "sourceSentenceIds": [
        29,
        30
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://mappingbaybrook.org/2018/03/brooklyn-park-anne-arundel-county/",
      "category": "people",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Brooklyn Park sits on Anne Arundel County’s northern edge, directly bordering Baltimore’s southern boundary.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Brooklyn_Park%2C_Maryland",
      "category": "nature",
      "quality": "good",
      "qualityReason": "location_description"
    },
    {
      "id": 6,
      "text": "The Patapsco River marks the northwest boundary, while Interstate 695 and MD Route 648 flank the south and west.",
      "sourceSentenceIds": [
        5
