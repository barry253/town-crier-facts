  "facts": [
    {
      "id": 1,
      "text": "Shenandoah Retreat’s historic core centers on the 1799 Retreat house built by Revolutionary War veteran Thomas Parker on 1,120 acres he acquired from the Wormley family in 1794.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/shenandoah_retreat_virginia",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The area was part of the 5‑million‑acre Northern Neck Proprietary granted to Thomas Fairfax in 1649, sparking mid‑18th‑century settlement by English planters and German immigrants.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/shenandoah_retreat_virginia",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "During the Civil War’s Valley Campaign, Union forces crossed the Shenandoah River at Parker’s Ford—adjacent to the Retreat property—while fighting Confederate troops led by Jubal A. A. Smith.",
      "sourceSentenceIds": [
        10,
        12
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/shenandoah_retreat_virginia",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Today, Shenandoah Retreat balances preserved Civil War heritage with suburban residential life, drawing residents who enjoy the valley’s natural scenery and proximity to Washington, D.C.",
      "sourceSentenceIds": [
        15
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/shenandoah_retreat_virginia",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Soils here derive from limestone and dolomite, producing fertile loamy textures that historically supported crop production and pastures after liming and fertilization.",
      "sourceSentenceIds": [
        20,
        21
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/shenandoah_retreat_virginia",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The region enjoys a humid subtropical climate, averaging 38 inches of rain annually, with January lows near 27 °F and July highs around 87 °F.",
      "sourceSentenceIds": [
        22,
        23
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/shenandoah_retreat_virginia",
      "category": "nature",
      "quality": "good"
    }
