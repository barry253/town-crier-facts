  "facts": [
    {
      "id": 1,
      "text": "Abingdon was named after Abingdon‑on‑Thames, the ancestral home of Martha Washington in Oxfordshire, England.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Abingdon%2C_Virginia",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The Historical Society of Washington County, founded in 1936, sits in Abingdon and preserves Southwest Virginia’s genealogy and history.",
      "sourceSentenceIds": [
        1,
        6
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Abingdon%2C_Virginia",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The historic Barter Theatre, located across from the town’s main street, has been a regional cultural hub since the early 20th century.",
      "sourceSentenceIds": [
        21
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://virginialiving.com/towns/small-town-big-history-the-stories-of-abingdon/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Since 1948, the Virginia Highlands Festival has drawn tens of thousands to Abingdon each July for music, arts, and outdoor adventures.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://virginialiving.com/towns/small-town-big-history-the-stories-of-abingdon/",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The northern end of the Overmountain Victory National Historic Trail meets Abingdon at the Abingdon Muster Grounds, commemorating frontier warriors.",
      "sourceSentenceIds": [
        14
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Abingdon%2C_Virginia",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The Martha Washington Inn & Spa, centrally located, has long hosted festival guests and preserves the town’s historic charm.",
      "sourceSentenceIds": [
        23
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://virginialiving.com/towns/small-town-big-history-the-stories-of-abingdon/",
