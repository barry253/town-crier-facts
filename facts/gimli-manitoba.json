      "category": "culture",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Gimli Beach, the largest beach on Lake Winnipeg, hosts the country’s premier beachfront film festival where movies rise from the water.",
      "sourceSentenceIds": [
        9,
        10,
        11
      ],
      "sourceLabels": [
        "Web source 2"
