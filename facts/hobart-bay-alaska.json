  "facts": [
    {
      "id": 1,
      "text": "Hobart Bay got its name in 1889 from Lieutenant Commander Mansfield of the U.S. Navy.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Hobart_Bay%2C_Alaska",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "For centuries, the Tlingit Kake Kwaan used Hobart Bay for subsistence, harvesting herring eggs, salmon, and seals.",
      "sourceSentenceIds": [
        4,
        5
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/hobart_bay_alaska",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Hobart Bay began as a logging camp, growing to 187 residents by 1990 during a timber boom.",
      "sourceSentenceIds": [
        8,
        20
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Hobart_Bay%2C_Alaska",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The bay enjoys a marine west coast climate, with cool summers averaging 45–61°F and mild winters around 25–39°F.",
      "sourceSentenceIds": [
        7,
        21,
        28,
        29
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/hobart_bay_alaska",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Hobart Bay sits on the eastern shore of Stephens Passage, surrounded by forested hills and steep mountains rising over 5,000 feet.",
      "sourceSentenceIds": [
        23,
        24,
        25,
        27,
        30
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/hobart_bay_alaska",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Today, the local economy relies on subsistence and tourism, with no formal schools or clinics and access only by boat or floatplane.",
      "sourceSentenceIds": [
