    },
    {
      "id": 4,
      "text": "Architect Russell Barr Williamson, a former Frank Lloyd Wright employee, designed 16 prairie‑style homes in Shorewood between 1918 and 1929.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
