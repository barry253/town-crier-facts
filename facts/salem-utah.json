  "facts": [
    {
      "id": 1,
      "text": "Salem was named after New Salem, Massachusetts, the birthplace of Lyman Curtis, honoring his early contributions.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Salem%2C_Utah"
    },
    {
      "id": 2,
      "text": "Indigenous people called the area \"Summer Spring,\" while early settlers dubbed it \"Pond Town\" because of the nearby Salem Pond.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.pondtown.org/index_module-pagemaster-PAGE_user_op-view_page-PAGE_id-2-MMN_position-2-2.html"
    },
    {
      "id": 3,
      "text": "In 1891, Salem began extensive sugar beet cultivation, supplying factories across Utah Valley.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.pondtown.org/index_module-pagemaster-PAGE_user_op-view_page-PAGE_id-2-MMN_position-2-2.html"
    },
    {
      "id": 4,
      "text": "The town supported families with sawmills, shingle mills, molasses factories, creameries, and confectioneries during its early growth.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.pondtown.org/index_module-pagemaster-PAGE_user_op-view_page-PAGE_id-2-MMN_position-2-2.html"
    },
    {
      "id": 5,
      "text": "The Dream Mine, a historic gold mine, stands as a notable landmark within Salem.",
      "sourceSentenceIds": [
        21
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Salem%2C_Utah"
    },
    {
      "id": 6,
      "text": "Salem Days, a week‑long festival since 1949, features parades, a baby contest, and a fireworks show each August.",
