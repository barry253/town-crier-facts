  "facts": [
    {
      "id": 1,
      "text": "Nassau was founded by pioneer Henry Walter, who became the area's first resident and county commissioner, and the town was organized on October 18, 1884, in his honor.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/nassau_minnesota"
    },
    {
      "id": 2,
      "text": "A post office named Nassau opened in 1888 and remained in continuous operation until it closed in 1998.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/nassau_minnesota"
    },
    {
      "id": 3,
      "text": "Nassau was officially platted in December 1893 to accommodate the growing needs around the railroad station, laying out streets, blocks, and lots.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/nassau_minnesota"
    },
    {
      "id": 4,
      "text": "Nassau was incorporated in 1902, and its tiny town still retains the quaint appeal of perseverance and warmth that invites explorers.",
