  "facts": [
    {
      "id": 1,
      "text": "Plainville sits on NY Route 370, about 4.5 miles west of Baldwinsville in Onondaga County.",
      "sourceSentenceIds": [
        5,
        22
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 2"
      ],
      "source": "https://en.wikipedia.org/wiki/Plainville%2C_New_York",
      "category": "other",
      "quality": "poor",
      "qualityReason": "location_description"
    },
    {
      "id": 2,
      "text": "The hamlet is famed for Plainville Turkey Farms, a family‑run operation from 1835 until 2007.",
      "sourceSentenceIds": [
        6,
        23
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 2"
      ],
      "source": "https://en.wikipedia.org/wiki/Plainville%2C_New_York",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "After the turkey plant closed in 2010, the former processing site was relocated to Pennsylvania in 2009.",
      "sourceSentenceIds": [
        7,
        25
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 2"
      ],
      "source": "https://en.wikipedia.org/wiki/Plainville%2C_New_York",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "West of Plainville on Route 370 stands Whig Hill, the 1833 James Leslie Voorhees house, one of Onondaga County’s major historic homes.",
      "sourceSentenceIds": [
        2,
        27
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 2"
      ],
      "source": "https://en.wikipedia.org/wiki/Plainville%2C_New_York",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Whig Hill and its dependencies earned a spot on the National Register of Historic Places in 1990.",
      "sourceSentenceIds": [
        3,
        4,
        28
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 2"
      ],
      "source": "https://en.wikipedia.org/wiki/Plainville%2C_New_York",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Plainville is highlighted in the Onondaga Landmarks survey, a comprehensive study of historic and architectural sites in the county.",
