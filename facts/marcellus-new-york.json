  "facts": [
    {
      "id": 1,
      "text": "Marcellus was named after the Roman general Marcus Claudius Marcellus, a choice made by a clerk who loved the Classics.",
      "sourceSentenceIds": [
        1,
        5
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Marcellus%2C_New_York",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "As roads improved, stagecoach travelers spurred growth, and the 200‑foot drop of Marcellus Falls powered sawmills, paper mills, and a woolen factory.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.villageofmarcellusny.gov/a-brief-history.html",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "By 1900, the Marcellus and Otisco Lake Railroad, one of the shortest in the U.S., crossed Nine Mile Creek toward Otisco Lake.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.villageofmarcellusny.gov/a-brief-history.html",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The Tefft‑Steadman House in Marcellus earned a spot on the National Register of Historic Places in 2007.",
