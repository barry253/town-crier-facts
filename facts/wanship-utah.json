  "facts": [
    {
      "id": 1,
      "text": "Wanship sprang to life in 1859 when Thomas Stephen Nixon and Henry Roper, joined by other pioneers, laid its first foundations.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://onlineutah.us/wanship_history.shtml"
    },
    {
      "id": 2,
      "text": "The town’s name honors friendly Shoshone chief Wanship, who guided early settlers to edible plants and game.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://onlineutah.us/wanship_history.shtml"
    },
    {
      "id": 3,
      "text": "Two railroads crossed Wanship in the late 1800s, turning the town into a key stop for silver, coal, and timber.",
      "sourceSentenceIds": [
        7,
        8,
        28
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.summitcountyutah.gov/202/Wanship"
    },
    {
      "id": 4,
      "text": "In 1862, the Kimballs Stage Station opened, making Wanship a vital overland stop between Salt Lake City and Park City.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Wanship%2C_Utah"
    },
    {
      "id": 5,
      "text": "Mid‑1950s construction of the Wanship Dam created Rockport Reservoir, a popular spot for fishing and boating just south of town.",
      "sourceSentenceIds": [
        22
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Wanship%2C_Utah"
    },
    {
      "id": 6,
      "text": "Wanship served as Summit County’s first county seat from 1866 until 1872, before Coalville took over the role.",
      "sourceSentenceIds": [
        18
