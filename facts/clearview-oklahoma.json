  "facts": [
    {
      "id": 1,
      "text": "Clearview was founded in 1903 as an all-Black town for freedmen seeking economic independence and community autonomy.",
      "sourceSentenceIds": [
        1,
        2
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/clearview_oklahoma"
    },
    {
      "id": 2,
      "text": "Clearview was part of the Black Town Movement, providing African Americans opportunities for landownership and self-governance.",
      "sourceSentenceIds": [
        15
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Clearview%2C_Oklahoma"
    },
    {
      "id": 3,
      "text": "The town developed along the Fort Smith and Western Railroad, which facilitated its founding and early economic viability.",
      "sourceSentenceIds": [
        3,
        5,
        19
      ],
      "sourceLabels": [
        "Web source 1",
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/clearview_oklahoma"
    },
    {
      "id": 4,
      "text": "Originally known as Abelincoln, Clearview established a hotel, print shop, brick school, and churches by 1904.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/clearview_oklahoma"
    },
    {
      "id": 5,
      "text": "Early settlers in Clearview established a post office in 1903 and a trading post operated by the Abe Lincoln Trading Company.",
      "sourceSentenceIds": [
        20
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/clearview_oklahoma"
    },
    {
      "id": 6,
      "text": "Clearview still features abandoned structures and fragmented land parcels that preserve its historical footprint as a symbol of Black entrepreneurship.",
      "sourceSentenceIds": [
        17
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/clearview_oklahoma"
    }
  ]
