    },
    {
      "id": 2,
      "text": "Alpine rests against the mountainsides at the convergence of the Greys, Salt, and Snake rivers.",
      "sourceSentenceIds": [
        24
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.alpinewy.gov/visitors/page/about-alpine"
    },
    {
      "id": 3,
      "text": "The town of Alpine is located at the southern end of the Snake River Canyon where the river enters Palisades Reservoir.",
      "sourceSentenceIds": [
        9,
        28
      ],
      "sourceLabels": [
        "Wikipedia",
