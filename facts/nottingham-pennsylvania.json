  "facts": [
    {
      "id": 1,
      "text": "Nottingham hosts the 651‑acre Nottingham County Park, a serpentine barrens designated a National Natural Landmark.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Nottingham%2C_Pennsylvania",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "In 1826 William Scott began mining chromite along the Philadelphia‑Baltimore Post Road, laying the groundwork for Nottingham’s mining heritage.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.chesco.org/4698/History",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "By 1850 Isaac Tyson, Jr. had monopolized the world chromite market, turning Nottingham into a global mining hub.",
      "sourceSentenceIds": [
        11,
        12
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.chesco.org/4698/History",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Mining slowed in the late 19th century when chromite extraction became too costly, ending a long era of quarrying.",
      "sourceSentenceIds": [
        13
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.chesco.org/4698/History",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The county park’s original office once stood where a basketball court now sits, a reminder of the 1930s dedication ceremony.",
      "sourceSentenceIds": [
        5,
        6
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.chesco.org/4698/History",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "A concrete foundation pier from a World War I chromite plant still sits beside Black Run, echoing the town’s wartime industry.",
      "sourceSentenceIds": [
        16,
        17
      ],
      "sourceLabels": [
        "Web source 1"
      ],
