  "facts": [
    {
      "id": 1,
      "text": "Mosman was named after Archibald Mosman and his twin brother George, who received a 4‑acre land grant in 1831.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Mosman",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "In 1831 Archibald Mosman and John Bell founded a whaling station on Mosman Bay; the only surviving building is The Barn on Avenue Road.",
      "sourceSentenceIds": [
        28,
        29
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Mosman",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The Borogegal tribe originally inhabited Mosman, a heritage celebrated by the community today.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
