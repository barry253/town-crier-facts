  "facts": [
    {
      "id": 1,
      "text": "Spring Lake’s name first appeared in 1923, named after a spring‑fed lake that likely formed when the railroad arrived around 1860.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Spring_Lake%2C_North_Carolina",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Before becoming Spring Lake, the area was known as Clayton Cut and Prince’s Siding, named after a sawmill owner named Prince.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Spring_Lake%2C_North_Carolina",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Spring Lake officially incorporated on April 9, 1951, with the town’s post office on Main Street chosen as its center.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Spring_Lake%2C_North_Carolina",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The town’s growth spurt during World War II was driven by its proximity to Fort Bragg, a major military installation.",
      "sourceSentenceIds": [
        13
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Spring_Lake%2C_North_Carolina",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The Little River, a tributary of the Cape Fear River, winds through Spring Lake from west to east, passing north of the town center.",
      "sourceSentenceIds": [
        18
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Spring_Lake%2C_North_Carolina",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Large portions of Spring Lake’s limits are occupied by Pope Air Force Base, which also hosts parts of Fort Bragg.",
