  "facts": [
    {
      "id": 1,
      "text": "Laketown was founded in 1864 during the expansion of Mormon pioneer communities throughout the Intermountain West.",
      "sourceSentenceIds": [
        4,
        23
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://laketown.utah.gov/laketown-history/"
    },
    {
      "id": 2,
      "text": "Laketown takes its name from the nearby Bear Lake, which is known for its striking turquoise-blue water.",
      "sourceSentenceIds": [
        5,
        12
      ],
      "sourceLabels": [
        "Web source 1",
        "Wikipedia"
      ],
      "source": "https://laketown.utah.gov/laketown-history/"
    },
    {
      "id": 3,
      "text": "The Old Rock Store remains an important landmark in Laketown, reflecting the determination of the community's early residents.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://laketown.utah.gov/laketown-history/"
    },
    {
      "id": 4,
      "text": "Long before European-American settlement, the Bear Lake Valley was home to Native American people, including the Shoshone and Bannock tribes.",
      "sourceSentenceIds": [
        24
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://laketown.utah.gov/laketown-history/"
    },
    {
      "id": 5,
      "text": "The Laketown Relief Society Hall stands as a lasting reminder of the dedication and service of the town's early residents.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://laketown.utah.gov/laketown-history/"
    },
    {
      "id": 6,
      "text": "Unlike many western towns that experienced mining booms, Laketown grew slowly and maintained its rural character.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://laketown.utah.gov/laketown-history/"
    }
  ]
