      "quality": "good"
    },
    {
      "id": 3,
      "text": "In the 1870s, railroad links to the New Jersey coast shifted Riverside’s economy from tourism to manufacturing.",
      "sourceSentenceIds": [
        17
      ],
      "sourceLabels": [
