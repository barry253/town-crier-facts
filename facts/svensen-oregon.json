    },
    {
      "id": 2,
      "text": "The Lewis and Clark Expedition encamped in the Svensen area on November 26, 1805, while traveling to Fort Clatsop.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Svensen%2C_Oregon"
    },
    {
      "id": 3,
      "text": "Svensen and Svensen Island are separated by the Svensen Slough on the south side of the Columbia River.",
      "sourceSentenceIds": [
        11
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Svensen%2C_Oregon"
    },
    {
      "id": 4,
      "text": "The region was originally inhabited by the Clatsop people, who relied on salmon fishing and hunting for their livelihood.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/svensen_oregon"
    },
    {
      "id": 5,
      "text": "Svensen operated its own post office from 1895 to 1944, with Peter Svensen serving as the first postmaster.",
