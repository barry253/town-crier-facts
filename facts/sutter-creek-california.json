      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Sutter Creek was founded during the Gold Rush, growing from a modest settlement in the 1840s to a boomtown by the 1860s thanks to quartz mining.",
      "sourceSentenceIds": [
        14,
        27,
        28
      ],
      "sourceLabels": [
