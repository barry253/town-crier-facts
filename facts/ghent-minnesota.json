  "facts": [
    {
      "id": 1,
      "text": "Ghent was renamed in 1882 from Grandview, borrowing its name from Belgium’s historic city to attract Flemish immigrants and create a 'New Flanders' on the prairie.",
      "sourceSentenceIds": [
        1,
        4,
        5,
        15
      ],
      "sourceLabels": [
        "Web source 2",
        "Wikipedia"
      ],
      "source": "https://grokipedia.com/page/ghent_minnesota",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Railroad expansion in the 1870s brought the Peter Railroad—later the Chicago and North Western—to Ghent, opening fertile lands for settlers and grain shipment.",
      "sourceSentenceIds": [
        3,
        9,
        12
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/ghent_minnesota",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Belgian customs and the Flemish language remained strong in Ghent well into the twentieth century, shaping local traditions and community life.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/ghent_minnesota",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The town sits on level moraine ground with minimal relief, supporting extensive cropland and typical grassland vegetation across the region.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/ghent_minnesota",
      "category": "nature",
      "quality": "poor",
      "qualityReason": "vague"
    },
    {
      "id": 5,
      "text": "City of Ghent prides itself on small‑town values, guided growth, and preserving its historical, cultural, and natural heritage.",
      "sourceSentenceIds": [
        8
      ],
