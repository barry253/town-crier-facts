  "facts": [
    {
      "id": 1,
      "text": "Lake Camelot in Adams County is a flowage with a total surface area of three hundred ninety-three acres.",
      "sourceSentenceIds": [
        14
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://apps.dnr.wi.gov/lakes/lakepages/LakeDetail.aspx?wbic=1378100&page=facts"
    },
    {
      "id": 2,
      "text": "Lake Camelot reaches a maximum depth of twenty-four feet, while its mean depth is nine feet.",
      "sourceSentenceIds": [
        3,
        14
      ],
      "sourceLabels": [
        "Web source 1",
        "Web source 2"
      ],
      "source": "https://apps.dnr.wi.gov/lakes/lakepages/LakeDetail.aspx?wbic=1378100"
    },
    {
      "id": 3,
      "text": "Anglers at Lake Camelot can find panfish, largemouth bass, northern pike, and walleye in the water.",
      "sourceSentenceIds": [
        5,
        14
      ],
      "sourceLabels": [
        "Web source 1",
        "Web source 2"
      ],
      "source": "https://apps.dnr.wi.gov/lakes/lakepages/LakeDetail.aspx?wbic=1378100"
    },
    {
      "id": 4,
      "text": "Lake Camelot is classified as eutrophic, meaning the water has a low level of clarity.",
      "sourceSentenceIds": [
        6,
        14
      ],
      "sourceLabels": [
        "Web source 1",
        "Web source 2"
      ],
      "source": "https://apps.dnr.wi.gov/lakes/lakepages/LakeDetail.aspx?wbic=1378100"
    },
    {
      "id": 5,
      "text": "Public access to Lake Camelot is available through a single public boat landing.",
      "sourceSentenceIds": [
        4,
        14
      ],
      "sourceLabels": [
        "Web source 1",
        "Web source 2"
      ],
      "source": "https://apps.dnr.wi.gov/lakes/lakepages/LakeDetail.aspx?wbic=1378100"
    },
    {
      "id": 6,
      "text": "Invasive species found in Lake Camelot include zebra mussels, purple loosestrife, and Eurasian water-milfoil.",
