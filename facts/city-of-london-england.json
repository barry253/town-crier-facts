  "facts": [
    {
      "id": 1,
      "text": "Founded by the Romans as Londinium around AD 47, the City of London has kept its medieval boundaries ever since.",
      "sourceSentenceIds": [
        11
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/London",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "London hosted the 1908, 1948, and 2012 Summer Olympics, becoming the first city to host the modern Games three times.",
      "sourceSentenceIds": [
        4,
        8
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/London",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The City of London boasts the UK’s largest concentration of museums, galleries, libraries and theatres, including the British Museum and Tate Modern.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/London",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The Royal Observatory in Greenwich, founded in 1675, solved longitude problems and gave us the Prime Meridian line.",
      "sourceSentenceIds": [
        18
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/London",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Gresham College, established in 1597, has offered free public lectures to Londoners for over four centuries.",
      "sourceSentenceIds": [
        24
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.thecityofldn.com/directory/city-of-london-information-centre/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "London’s iconic red double‑decker buses first appeared in 1947 with the AEC Regent III RT, a predecessor to the Routemaster.",
