      ],
      "source": "https://unitedstatesghosttowns.com/fallis-oklahoma-ghost-town/"
    },
    {
      "id": 4,
      "text": "Fallis became a bustling agricultural trade center due to its location along the Deep Fork River and two major railroads.",
      "sourceSentenceIds": [
        14
      ],
