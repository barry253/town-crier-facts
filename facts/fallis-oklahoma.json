    {
      "id": 1,
      "text": "Fallis was founded in 1892 and was originally known as Mission, serving Native American communities near an Iowa Indian village.",
      "sourceSentenceIds": [
        1,
        24
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 2"
      ],
      "source": "https://en.wikipedia.org/wiki/Fallis%2C_Oklahoma"
    },
    {
      "id": 2,
      "text": "Judge William Henry Fallis, the town's first postmaster and prime developer, gave Fallis its name in 1894.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Fallis%2C_Oklahoma"
    },
    {
      "id": 3,
      "text": "The Iowa tribe held significant tribal councils and signed a treaty in 1890 beneath a historic tree near the village.",
      "sourceSentenceIds": [
        26,
        28
      ],
      "sourceLabels": [
