      "id": 1,
      "text": "Aredale was founded in 1881, named after the first postmaster’s daughter, and its name echoes the Pennsylvania town of Airville.",
      "sourceSentenceIds": [
        1,
        16
      ],
      "sourceLabels": [
        "Web source 1",
        "Wikipedia"
      ],
