  "facts": [
    {
      "id": 1,
      "text": "Holiday City South began as a subdivision of the larger Holiday City at Berkeley master‑planned retirement community in Berkeley Township, Ocean County.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/holiday_city_south_new_jersey",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The community’s clubhouse boasts a ceramics room, arts and crafts area, woodworking shop, card room, billiards table, library, and kitchen, plus an Olympic‑sized pool and tennis courts.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/holiday_city_south_new_jersey",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "After the 2008 recession, limited mobility and affordable housing options for fixed‑income seniors helped keep occupancy steady in Holiday City South.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/holiday_city_south_new_jersey",
      "category": "other",
      "quality": "poor",
      "qualityReason": "editorial_filler"
    },
    {
      "id": 4,
      "text": "The area’s name reflects its origins as a “Holiday City” designed for retirees, amid low birth rates and high mortality among older adults.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/holiday_city_south_new_jersey",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Holiday City South has 2,567 housing units, with 9.4% currently vacant.",
      "sourceSentenceIds": [
