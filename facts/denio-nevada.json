  "facts": [
    {
      "id": 1,
      "text": "Denio began as Aaron Denio’s 1885 sod‑and‑mud trading post, offering rooms and supplies to emigrants crossing the remote Oregon‑Nevada border.",
      "sourceSentenceIds": [
        2,
        15,
        17
      ],
      "sourceLabels": [
        "Web source 2",
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/Denio,_Nevada",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town was named after its founder, Aaron Denio, and received its first post office in 1888, marking formal recognition.",
      "sourceSentenceIds": [
        3,
        4,
        16,
        26
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 2",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Denio%2C_Nevada",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Mid‑20th‑century, the Denio post office moved from Oregon into Nevada, reopening in 1950 to serve Nevada residents.",
      "sourceSentenceIds": [
        6,
        28
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Denio%2C_Nevada",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Denio’s isolation in the Black Rock Desert amplifies temperature extremes, with little moderation from water bodies or urban heat islands.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/Denio,_Nevada",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The historic Denio Hotel and Saloon, operating since the early 1900s, remains a centerpiece of local social life.",
      "sourceSentenceIds": [
        18
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/Denio,_Nevada",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Outdoor enthusiasts in Denio enjoy bird watching, off‑road driving, black opal mining, rockhounding, and hot‑spring visits near Sheldon National Wildlife Refuge.",
