  "facts": [
    {
      "id": 1,
      "text": "Point Arena was first recorded by Spaniard Bartolomé Ferrer in 1543, who called it Cabo de Fortunas, meaning \"cape of fortunes\".",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Point_Arena%2C_California",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "In 1775 lieutenant Juan Francisco de la Bodega y Quadra renamed the cape Punta Delgado during a Mexican royal expedition mapping Alta California.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Point_Arena%2C_California",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The Point Arena Lighthouse, built in 1870 and rebuilt after the 1906 earthquake, has guided mariners along this treacherous Pacific coast.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.wisdomlib.org/cities/point-arena-185560",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The area hosts the Manchester Band of Pomo Indians’ rancheria and borders the newly formed Point Arena‑Stornetta Public Lands National Monument.",
