  "facts": [
    {
      "id": 1,
      "text": "Holland Village got its name from Hugh Holland, an early resident and architect whose house once stood on the street that became Holland Road.",
      "sourceSentenceIds": [
        1,
        2,
        5
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 2",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Holland_Village%2C_Singapore",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "In the 1950s, terraced houses at Chip Bee Gardens were built as British military housing and are now managed by the Singapore Land Authority.",
      "sourceSentenceIds": [
        14,
        26
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Holland_Village%2C_Singapore",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The Circle Line’s Holland Village MRT station opened in 2011, giving the neighbourhood a dedicated rail link.",
      "sourceSentenceIds": [
        16,
        19
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Holland_Village%2C_Singapore",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "By the 1990s, as Orchard and Tanglin turned into prime residential zones, Holland Village evolved into a bustling shopping and dining hub.",
      "sourceSentenceIds": [
        27
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Holland_Village%2C_Singapore",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "In 2003, the Channel 8 series Holland V was filmed on location, spotlighting the area’s quirky cafés and street life.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Holland_Village%2C_Singapore",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "A 2025 Straits Times article noted that many shops had closed in 2024, and foot traffic had declined despite the MRT opening.",
      "sourceSentenceIds": [
        18
      ],
      "sourceLabels": [
