  "facts": [
    {
      "id": 1,
      "text": "Linnell Camp began as a 1930s Migratory Labor Camp built by the Farm Security Administration.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Linnell_Camp%2C_California",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The camp once had its own water, sewer, shower, laundry, community hall, health center, and a branch of the Tulare County Public Library.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.thegoodlifesv.com/story/2021/07/01/history/farm-labor-and-linnell-camp/613.html",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "In 1965, residents staged a rent strike after decades of rising rents, a pivotal moment in Tulare County labor history.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Linnell_Camp%2C_California",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Dust Bowl migrants from Oklahoma, Missouri, Arkansas, and Texas, called \"Okies,\" first arrived at Linnell Camp carrying all their belongings.",
      "sourceSentenceIds": [
        1,
        26
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.thegoodlifesv.com/story/2021/07/01/history/farm-labor-and-linnell-camp/613.html",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The camp’s post office, visible in a 1940 photo, was a central hub for the community.",
