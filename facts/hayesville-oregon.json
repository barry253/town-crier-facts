    {
      "id": 1,
      "text": "Hayesville traces its origins to 1849, when pioneer Adam Stephens arrived in the region from Missouri via the Oregon Trail.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/hayesville_oregon"
    },
    {
      "id": 2,
      "text": "The community of Hayesville was originally referred to informally as Stephensville before being renamed during a local gathering.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/hayesville_oregon"
    },
    {
      "id": 3,
      "text": "Hayesville is home to the main campus of Chemeketa Community College.",
      "sourceSentenceIds": [
        14
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Hayesville%2C_Oregon"
    },
    {
      "id": 4,
      "text": "Claggett Creek flows westward through Hayesville as a tributary of the Willamette River.",
      "sourceSentenceIds": [
        2,
        19
      ],
      "sourceLabels": [
        "Web source 1",
        "Wikipedia"
      ],
      "source": "https://grokipedia.com/page/hayesville_oregon"
    },
    {
      "id": 5,
      "text": "The West Fork of the Little Pudding River runs eastward through Hayesville toward its confluence with the main Pudding River.",
      "sourceSentenceIds": [
        2,
