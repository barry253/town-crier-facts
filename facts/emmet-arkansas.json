  "facts": [
    {
      "id": 1,
      "text": "Emmet was founded as a railroad town in 1873 by Emmet Elgin, an Irish employee of the Cairo & Fulton Railroad.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://cityofemmet.com/incorporation",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Emmet sits near the headwaters of the Terre Rouge Creek watershed, which flows northeast for 17 miles before joining the Little Missouri River.",
      "sourceSentenceIds": [
        23
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Emmet%2C_Arkansas",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The town’s early economy included a factory that built horse‑drawn carriages and horse saddles, reflecting its 19th‑century transportation needs.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Emmet%2C_Arkansas",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Emmet’s first depot agent and later first postmaster was Robert Francis Elgin, who also helped survey neighboring towns.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://cityofemmet.com/incorporation",
      "category": "people",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Emmet is part of the Ark‑La‑Tex tri‑state region, linking Arkansas, Louisiana, and Texas culturally and economically.",
