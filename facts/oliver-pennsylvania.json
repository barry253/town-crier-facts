  "facts": [
    {
      "id": 1,
      "text": "Mount Oliver was named by John Ormsby after his son Oliver, founding the borough in the late 1700s.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Mount_Oliver%2C_Pennsylvania",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The borough sits atop a crest about 3 miles west of the Monongahela River, giving it a panoramic view of Pittsburgh.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Mount_Oliver%2C_Pennsylvania",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "In 1892 residents petitioned and successfully incorporated Mount Oliver, resisting Pittsburgh’s annexation attempts.",
      "sourceSentenceIds": [
        16
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Mount_Oliver%2C_Pennsylvania",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The only surviving feature of the Oliver 1 and 2 coal and coke works is a repair shop still visible today.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://coalcampusa.com/westpa/connellsville/oliver-pa/oliver-pa.htm",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Mount Oliver remains completely surrounded by Pittsburgh, a rarity for a borough that fiercely maintains its independence.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Mount_Oliver%2C_Pennsylvania",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The borough’s early economy was powered by one of the region’s largest bituminous coal mines operated by Oliver Iron & Steel Company.",
