  "facts": [
    {
      "id": 1,
      "text": "Sainte‑Marie was founded as a seigneury in 1736, granted to Thomas‑Jacques Taschereau by French colonial authorities.",
      "sourceSentenceIds": [
        1,
        8,
        14
      ],
      "sourceLabels": [
        "Web source 2",
        "Wikipedia"
      ],
      "source": "https://grokipedia.com/page/Sainte-Marie,_Quebec",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Taschereau named the settlement after his wife, Marie‑Claire de Fleury de La Gorgendière, who managed the estate for 24 years after his death.",
      "sourceSentenceIds": [
        1,
        5,
        15
      ],
      "sourceLabels": [
        "Web source 2",
        "Wikipedia"
      ],
      "source": "https://grokipedia.com/page/Sainte-Marie,_Quebec",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The town sits on the Chaudière River, a factor that shaped early settlement by providing water and transportation routes.",
      "sourceSentenceIds": [
        10,
        13
      ],
      "sourceLabels": [
        "Web source 2",
        "Wikipedia"
      ],
      "source": "https://grokipedia.com/page/Sainte-Marie,_Quebec",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The municipality covers 107.55 km², with development concentrated along fertile valley floors while the surrounding hills remain sparsely populated.",
      "sourceSentenceIds": [
