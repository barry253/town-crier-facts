  "facts": [
    {
      "id": 1,
      "text": "Fayetteville was founded as Vandalia by Abraham Vandall, a Revolutionary War veteran and local farmer.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Fayetteville%2C_West_Virginia"
    },
    {
      "id": 2,
      "text": "The town was renamed Fayetteville after the Marquis de Lafayette, a Revolutionary War hero who toured the United States in the 1820s.",
      "sourceSentenceIds": [
        22
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Fayetteville%2C_West_Virginia"
    },
    {
      "id": 3,
      "text": "Fayetteville changed hands several times and was partially destroyed during the Civil War due to conflicting sympathies between Unionists and Confederates.",
      "sourceSentenceIds": [
        23,
        24
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Fayetteville%2C_West_Virginia"
    },
    {
      "id": 4,
      "text": "The Fayette County Courthouse, completed in 1897, is a notable example of the Romanesque Revival architectural style.",
      "sourceSentenceIds": [
        25
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Fayetteville%2C_West_Virginia"
    },
    {
      "id": 5,
      "text": "Fayetteville lies adjacent to the New River Gorge National Park and Preserve and is located directly south of the New River Gorge Bridge.",
      "sourceSentenceIds": [
        20
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Fayetteville%2C_West_Virginia"
    },
    {
      "id": 6,
      "text": "The local economy shifted from agriculture, timber, and coal mining to a focus on tourism and outdoor recreation.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://wvexplorer.com/travel/communities/cities-towns/fayetteville-west-virginia/"
