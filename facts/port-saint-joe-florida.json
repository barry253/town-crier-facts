      "quality": "good"
    },
    {
      "id": 3,
      "text": "A yellow fever epidemic in 1841 and a hurricane in 1844 nearly wiped out the early settlement, leaving only a few structures.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Port_St._Joe%2C_Florida",
