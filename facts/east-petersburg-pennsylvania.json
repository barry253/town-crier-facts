      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://museumsdatabase.com/museums/view/27020",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Run entirely by volunteers, the society relies on donations and membership fees to keep its archives and museum open to the public.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://museumsdatabase.com/museums/view/27020",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "East Petersburg lies in north‑central Lancaster County, just 5 miles southeast of Lancaster’s historic downtown.",
