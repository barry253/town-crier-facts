  "facts": [
    {
      "id": 1,
      "text": "Bow was chartered in 1727, originally 9 miles square, covering most of the area once claimed by Massachusetts as 'Pennacook' (now Concord).",
      "sourceSentenceIds": [
        1,
        6
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
