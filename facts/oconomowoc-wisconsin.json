      "id": 1,
      "text": "Oconomowoc, whose name means 'Where the waters meet' in Potawatomi, reflects the area's historic river confluence.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 1"
      ],
