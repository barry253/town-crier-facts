  "facts": [
    {
      "id": 1,
      "text": "Hoehne was founded in 1859 by German immigrant William Hoehne, who also established the Hoehne Ditch Company and introduced the first mill and threshing machine.",
      "sourceSentenceIds": [
        2,
        14,
        15
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Hoehne%2C_Colorado",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The historic Santa Fe Trail skirts Hoehne, with a marker just one mile north on County Road 42.0 that commemorates the trail’s passage.",
      "sourceSentenceIds": [
        4,
        10,
        11
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 2"
      ],
      "source": "https://en.wikipedia.org/wiki/Hoehne%2C_Colorado",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "During its heyday, Hoehne boasted a hotel, a train depot called “Hoehnes,” a blacksmith, a Catholic church, and several stores.",
      "sourceSentenceIds": [
        17
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Hoehne%2C_Colorado",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The train depot was retired in 1967, moved twice, and now sits restored in Texas Creek, where its original sign still stands.",
      "sourceSentenceIds": [
        18,
        19
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Hoehne%2C_Colorado",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Hoehne’s early settlers cleared rugged land to grow strawberries, apples, and cherries on 1,000 acres before shifting to alfalfa and grass hay.",
      "sourceSentenceIds": [
        15,
        16
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Hoehne%2C_Colorado",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The town’s name lives on in the Hoehne Ditch Company, a legacy of the founder’s irrigation innovations that shaped southeastern Colorado’s farming.",
      "sourceSentenceIds": [
        14
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
