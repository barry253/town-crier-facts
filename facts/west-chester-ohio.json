  "facts": [
    {
      "id": 1,
      "text": "West Chester was founded in 1823 in fertile soil of southeast Butler County.",
      "sourceSentenceIds": [
        21
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.westchesteroh.org/Home/Components/News/News/3721/384?arch=1",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town grew around two historic north‑south routes: US Route 42 and Cincinnati‑Dayton Road, which existed long before the town.",
      "sourceSentenceIds": [
        23
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.westchesteroh.org/Home/Components/News/News/3721/384?arch=1",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The former Bethany Station, now the National Voice of America Museum of Broadcasting, opened its doors to the public on weekends.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.westchesteroh.org/Home/Components/News/News/3721/384?arch=1",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Conrey House in West Chester was a stop on the Underground Railroad, offering shelter to escaped slaves.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.westchesteroh.org/Home/Components/News/News/3721/384?arch=1",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "West Chester Police Department was established on April 17, 1967, and its K‑9 unit began in 1993.",
      "sourceSentenceIds": [
        5,
        6
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.westchesteroh.org/Home/Components/News/News/3721/384?arch=1",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The Upper Mill Creek Conservation Corridor follows the path of the former Miami‑Erie Canal, inviting walkers to trace historic waterway.",
