  "facts": [
    {
      "id": 1,
      "text": "Leighton got its name in 1824 when Reverend William Leigh, the town’s first postmaster and a local entrepreneur, opened a post office.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/leighton_alabama"
    },
    {
      "id": 2,
      "text": "The first settlers arrived around 1813, making Leighton one of the earliest communities in the region.",
      "sourceSentenceIds": [
        17
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://encyclopediaofalabama.org/article/leighton/"
    },
    {
      "id": 3,
      "text": "When the Tuscumbia, Courtland, and Decatur Railroad reached Leighton in 1833, the town became a key cotton shipping hub.",
      "sourceSentenceIds": [
        19
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://encyclopediaofalabama.org/article/leighton/"
    },
    {
      "id": 4,
      "text": "Leighton boasts several National Register sites, including the Old Brick Presbyterian Church, the John Johnson House, and Preuit Oaks.",
      "sourceSentenceIds": [
        20
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://encyclopediaofalabama.org/article/leighton/"
    },
    {
      "id": 5,
      "text": "Soul singer Percy Sledge, famed for 'When a Man Loves a Woman,' was born in Leighton.",
      "sourceSentenceIds": [
        11
