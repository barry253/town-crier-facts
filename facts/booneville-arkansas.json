      "id": 1,
      "text": "Booneville was founded in 1828 when Walter Cauthron built a log cabin and store along the Petit Jean River.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
