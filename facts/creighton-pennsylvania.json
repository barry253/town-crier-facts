  "facts": [
    {
      "id": 1,
      "text": "Creighton is an unincorporated community in East Deer Township, 18 miles northeast of Pittsburgh, along the Allegheny River.",
      "sourceSentenceIds": [
        17,
        13
      ],
      "sourceLabels": [
        "Web source 1",
        "Wikipedia"
      ],
      "source": "https://grokipedia.com/page/creighton_pennsylvania",
      "category": "other",
      "quality": "poor",
      "qualityReason": "location_description"
    },
    {
      "id": 2,
      "text": "The Pittsburgh Plate Glass Company, now PPG Industries, was founded in Creighton in 1883, becoming the first financially successful U.S. plate glass manufacturer.",
      "sourceSentenceIds": [
        2,
        18,
        19
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Creighton%2C_Pennsylvania",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Creighton's riverfront lowlands rise to steep bluffs, with elevations from 740 to over 900 feet, creating a narrow valley prone to flooding during high river stages.",
      "sourceSentenceIds": [
        7,
        24
      ],
      "sourceLabels": [
        "Web source 1",
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/creighton_pennsylvania",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Future revitalization plans aim to honor Creighton's historic glass industry by offering tours, educational programs, and community events that connect past and present.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.atlasvanlines.com/city-guides/creighton-pa",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The community's boundaries follow Pool 3 of the Allegheny River, influencing navigation and positioning within the U.S. Army Corps of Engineers Locks and Dams system.",
      "sourceSentenceIds": [
        12,
        25
      ],
      "sourceLabels": [
        "Web source 1",
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/creighton_pennsylvania",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Creighton’s climate averages 52°F annually, with about 38 inches of precipitation spread evenly across 132 rainy days each year.",
