      ],
      "source": "https://www.carpinteriahistoricalmuseum.org/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Downtown Carpinteria shelters the Wardholme Torrey Pine, the largest Torrey pine tree on Earth, a living landmark for nature lovers.",
      "sourceSentenceIds": [
        24
      ],
      "sourceLabels": [
        "Wikipedia"
