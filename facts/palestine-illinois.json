    {
      "id": 1,
      "text": "Palestine, Illinois was founded in 1811, making it one of the oldest towns in the state.",
      "sourceSentenceIds": [
        1,
        14
      ],
      "sourceLabels": [
        "Web source 1",
        "Wikipedia"
      ],
      "source": "https://villageofpalestine.com/about/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "French explorer Jean Lamotte named the area Palestine in 1678, recalling the biblical land of milk and honey.",
      "sourceSentenceIds": [
        4,
        12,
        13
      ],
      "sourceLabels": [
        "Web source 2",
        "Wikipedia"
      ],
      "source": "https://www.achp.gov/preserve-america/community/palestine-illinois",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The village became the seat of Crawford County in 1818, only to have the county seat moved to Robinson in 1843.",
      "sourceSentenceIds": [
        3,
        15
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Palestine%2C_Illinois",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "A walking trail called the Palestine Pioneer City Heritage Trail guides visitors past historic sites throughout the village.",
      "sourceSentenceIds": [
        7,
        8
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.achp.gov/preserve-america/community/palestine-illinois",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The turn‑of‑century Fife Opera House, a local landmark, is currently undergoing restoration to preserve its historic charm.",
      "sourceSentenceIds": [
        9,
