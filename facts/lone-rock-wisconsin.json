  "facts": [
    {
      "id": 1,
      "text": "Lone Rock takes its name from a sandstone outcrop that served as a landmark for early river raftsmen.",
      "sourceSentenceIds": [
        3,
        4
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Lone_Rock%2C_Wisconsin"
    },
    {
      "id": 2,
      "text": "The community of Lone Rock was founded in 1856 and later incorporated as a village in 1866.",
      "sourceSentenceIds": [
        13
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Lone_Rock%2C_Wisconsin"
    },
    {
      "id": 3,
      "text": "Sandstone from the local outcrop was cut and used to build basements and foundations throughout Lone Rock.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Lone_Rock%2C_Wisconsin"
    },
    {
      "id": 4,
      "text": "What remains of the original sandstone rock is located west of Highway 130 across from Brace Park.",
      "sourceSentenceIds": [
        13
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Lone_Rock%2C_Wisconsin"
    },
    {
      "id": 5,
      "text": "Lone Rock once held the record for the coldest temperature in Wisconsin, reaching minus 53 degrees in 1951.",
      "sourceSentenceIds": [
        18,
        19
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Lone_Rock%2C_Wisconsin"
    },
    {
      "id": 6,
      "text": "The hottest temperature ever recorded in Lone Rock was 102 degrees Fahrenheit during July of 2012.",
