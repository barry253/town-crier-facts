  "facts": [
    {
      "id": 1,
      "text": "Originally called Bay Shore, the area became Morningside after WWII when Biscayne Boulevard was widened, cutting off a western section.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://morningsidemiami.org/Morningside-History",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Morningside was the first historic area in central Miami to gentrify, drawing more affluent residents.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Upper_Eastside",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The neighborhood was planned as an exclusive residential enclave, its Biscayne Bay location drawing many influential locals.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Upper_Eastside",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Homes in Morningside showcase Mediterranean Revival architecture, contrasting the Longfellow-inspired street names.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Upper_Eastside",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The Morningside Historic District stands as one of Miami's most intact Land Boom-era suburbs.",
      "sourceSentenceIds": [
        21
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.miami.gov/My-Government/Departments/Planning/Historic-Preservation-Main-Page/Morningside-Historic-District",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Biscayne Boulevard bisects Morningside, flanked by mid‑rise office towers, hotels, and apartments.",
