  "facts": [
    {
      "id": 1,
      "text": "The park opened on 1 April 1867, the same day Paris hosted the Universal Exposition.",
      "sourceSentenceIds": [
        28
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Parc_des_Buttes_Chaumont",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "A 50‑metre cliff rises above the artificial lake, crowned by the Temple de la Sibylle, a miniature Roman temple modeled after Tivoli’s Vesta.",
      "sourceSentenceIds": [
        15,
        27
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Parc_des_Buttes_Chaumont",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Before becoming a park, the hill was a gypsum quarry that produced lime and yielded Eocene mammal fossils studied by Georges Cuvier.",
      "sourceSentenceIds": [
        19,
        20,
        21
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Parc_des_Buttes_Chaumont",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The area once housed the Gibbet of Montfaucon, where from the 13th century until 1760 criminals’ bodies were displayed after execution.",
      "sourceSentenceIds": [
        17
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Parc_des_Buttes_Chaumont",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "In the late 1850s, workers terraced the land and reshaped it into hills, lakes, and winding paths, a project that took two years just for terracing.",
      "sourceSentenceIds": [
        23,
        24
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Parc_des_Buttes_Chaumont",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The park’s name comes from the bare hill “Chauve‑mont” whose soil was almost vegetation‑free, giving the area its bleak nickname.",
      "sourceSentenceIds": [
        16
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
