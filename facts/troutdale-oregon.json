  "facts": [
    {
      "id": 1,
      "text": "Troutdale was named by pioneer John Harlow for the trout pond in a dale near his house.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Troutdale%2C_Oregon",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The city’s Old Historic Water Tower, built in 1920 for the Bissinger Wool Pullery, still stands as a downtown landmark.",
      "sourceSentenceIds": [
        1,
        11
      ],
      "sourceLabels": [
        "Web source 2",
        "Wikipedia"
      ],
      "source": "https://www.exploretroutdale.com/about-troutdale/history",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "In 1907, the Union Pacific Railroad Depot that now houses the Gateway to the Gorge Visitor Center opened, marking Troutdale’s arrival on the rail line.",
      "sourceSentenceIds": [
        27
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.exploretroutdale.com/about-troutdale/history",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Troutdale sits at the confluence of the Columbia and Sandy Rivers, a spot that has drawn Chinook and Cascade tribes for centuries.",
      "sourceSentenceIds": [
        10,
        15
      ],
      "sourceLabels": [
        "Web source 1",
        "Web source 1"
      ],
      "source": "https://www.visitoregon.com/cities/troutdale-oregon/",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The Harlow House Museum, the former home of founder Captain John Harlow, offers a glimpse into the city’s early pioneer life.",
      "sourceSentenceIds": [
        16,
        17
      ],
      "sourceLabels": [
        "Web source 1",
        "Web source 1"
      ],
      "source": "https://www.visitoregon.com/cities/troutdale-oregon/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "From the 1940s through the 1960s, Portland Stages, Inc. ran bus service linking Troutdale with Gresham and Portland, a rare private transit line.",
      "sourceSentenceIds": [
        6
      ],
