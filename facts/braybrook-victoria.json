  "facts": [
    {
      "id": 1,
      "text": "Braybrook was named in 1848 by three Melbourne residents who bought a square mile for English settlers during anti‑Irish sentiment.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.victorianplaces.com.au/braybrook-and-braybrook-shire"
    },
    {
      "id": 2,
      "text": "When the Ballarat line opened in 1889, the junction that became Sunshine was originally called Braybrook Junction.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.victorianplaces.com.au/braybrook-and-braybrook-shire"
    },
    {
      "id": 3,
      "text": "The heritage‑listed Eta Foods factory, built in 1961 and designed by Frederick Romberg, remains Braybrook’s most notable industrial building.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.victorianplaces.com.au/braybrook-and-braybrook-shire"
    },
    {
      "id": 4,
      "text": "Braybrook Post Office began serving residents on 1 December 1860, marking the suburb’s early development.",
      "sourceSentenceIds": [
        15
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Braybrook%2C_Victoria"
    },
    {
      "id": 5,
      "text": "In the past decade, former factory sites have been converted into modern townhouses, reflecting a wave of gentrification.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Braybrook%2C_Victoria"
    },
    {
      "id": 6,
      "text": "The suburb’s proximity to the Maribyrnong River and the Sunbury railway line defines its western boundary, while Duke Street marks the west.",
      "sourceSentenceIds": [
