  "facts": [
    {
      "id": 1,
      "text": "Mayking likely takes its name from a woman called May King, possibly an early settler or a relative of a coal‑mine owner.",
      "sourceSentenceIds": [
        1,
        14
      ],
      "sourceLabels": [
        "Web source 2",
