  "facts": [
    {
      "id": 1,
      "text": "Ormond Beach takes its name from James Ormond I, an Anglo‑Irish‑Scottish sea captain who brought Franciscan settlers to Florida.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Ormond_Beach%2C_Florida",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Founded in 1875 as New Britain by settlers from Connecticut, the town incorporated on April 22, 1880, as Ormond.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Ormond_Beach%2C_Florida",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The Florida East Coast Railway once ran through Ormond Beach, with a station that connected the town to the wider rail network.",
      "sourceSentenceIds": [
