  "facts": [
    {
      "id": 1,
      "text": "In the 1930s, a man named Sheldon opened a fish saltery, and the settlement later incorporated as Sheldon Point in 1974.",
      "sourceSentenceIds": [
        1,
        9
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Nunam_Iqua%2C_Alaska",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Nestled near the Yukon River, Nunam Iqua is surrounded by tundra, wetlands, and wildlife, reflecting a rich indigenous culture.",
      "sourceSentenceIds": [
        25,
        4
      ],
      "sourceLabels": [
        "Web source 1",
        "Web source 2"
      ],
      "source": "https://www.alaskahandbook.com/location/alaska/nunam-iqua/",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "What began as a summer fish camp in the early 20th century eventually grew into the permanent settlement we know today.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.kupi.com/en/explore/united-states/sheldon-point",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Nunam Iqua, a Yupik term meaning 'land's end,' reflects its position at the edge of the Yukon River.",
