  "facts": [
    {
      "id": 1,
      "text": "Logan began as a stage stop called Canyon House on the route from Bozeman to Helena, serving travelers in the late 1800s.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.tfhistory.org/history%20Logan%2001.html"
    },
    {
      "id": 2,
      "text": "The town was renamed Logan to honor Edelia Logan, whose husband John died at the Battle of the Little Bighorn.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.mtmemory.org/nodes/view/127862"
    },
    {
      "id": 3,
      "text": "Logan was founded in 1889 as a Northern Pacific railroad station, now operated by BNSF Railway.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Logan%2C_Montana"
    },
    {
      "id": 4,
      "text": "In 1883, the Northern Pacific built a roundhouse, water tank, and other facilities in Logan, sparking its growth.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.mtmemory.org/nodes/view/127862"
    },
    {
      "id": 5,
      "text": "A devastating fire in 1919 destroyed much of Logan, reshaping its downtown layout.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.tfhistory.org/history%20Logan%2001.html"
    },
    {
      "id": 6,
      "text": "Logan served as a key junction on the Northern Pacific’s Rocky Mountain Division, where trains could split toward Helena or Butte.",
      "sourceSentenceIds": [
        27
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Logan%2C_Montana"
    }
  ]
}
