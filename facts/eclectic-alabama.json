  "facts": [
    {
      "id": 1,
      "text": "Eclectic got its name from a 19th‑century healer who practiced eclectic medicine, and the town’s post office was named after that practice.",
      "sourceSentenceIds": [
        3,
        11
      ],
      "sourceLabels": [
        "Web source 2",
        "Wikipedia"
