      "id": 1,
      "text": "President Theodore Roosevelt established Mesa Verde National Park on June 29, 1906, to preserve cultural heritage.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.nps.gov/meve/learn/historyculture/index.htm",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Ancestral Puebloans abandoned Mesa Verde around 1300 AD, leaving behind a rich archaeological record.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://mesaverde.com/about-mesa-verde/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The park contains more than 600 cliff dwellings built between 600 and 1300 AD by the Ancestral Puebloans.",
      "sourceSentenceIds": [
        29
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://mesaverde.com/about-mesa-verde/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Cliff Palace, the largest cliff dwelling in the park, showcases the architectural ingenuity of its builders.",
