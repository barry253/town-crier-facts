  "facts": [
    {
      "id": 1,
      "text": "Klong San’s canals once carried Bangkok’s floating markets, the city’s original transport arteries that now echo its rich maritime heritage.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://thethaiger.com/travel/bangkok-travel/life-along-bangkok-khlong",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The Royal Barges Museum in Klong San displays gilded boats used in royal ceremonies, highlighting the historical importance of Bangkok’s waterways.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://thethaiger.com/travel/bangkok-travel/life-along-bangkok-khlong",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Klong San’s quiet loops through Bangkok Noi and Yai trace a path beside some of the capital’s oldest neighbourhoods.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://thethaiger.com/travel/bangkok-travel/life-along-bangkok-khlong",
      "category": "other",
      "quality": "poor",
      "qualityReason": "other"
    },
    {
      "id": 4,
      "text": "If you crave authentic local life, Klong San offers a vibrant blend of tradition and modernity amid its historic canals.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 1"
      ],
