  "facts": [
    {
      "id": 1,
      "text": "Nassawadox’s name comes from a Native American word meaning \"land between two waters,\" reflecting its position between the Atlantic and Chesapeake.",
      "sourceSentenceIds": [
        3,
        23
      ],
      "sourceLabels": [
        "Web source 1",
        "Wikipedia"
      ],
      "source": "https://www.co.northampton.va.us/residents/our_towns/nassawadox",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town rose to prominence as a trade hub thanks to a steam-powered sawmill that once employed over 50 of its 475 residents in 1920.",
      "sourceSentenceIds": [
        5,
        10
      ],
      "sourceLabels": [
        "Web source 1",
        "Web source 2"
      ],
      "source": "https://www.co.northampton.va.us/residents/our_towns/nassawadox",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Nassawadox grew around a railroad platform established in 1884, which also served as a mail receiving point on the Pennsylvania line.",
      "sourceSentenceIds": [
        12,
        11
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.co.northampton.va.us/residents/our_towns/nassawadox",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "A red caboose, framed by blooming crepe myrtles, stands as a quirky landmark in Nassawadox.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.co.northampton.va.us/residents/our_towns/nassawadox",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Brownsville and the Northampton Lumber Company Historic District, both in Nassawadox, are listed on the National Register of Historic Places.",
