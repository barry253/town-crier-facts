  "facts": [
    {
      "id": 1,
      "text": "Des Peres traces its roots to a 1700 settlement founded by French Jesuit missionaries and Kaskaskia Native Americans.",
      "sourceSentenceIds": [
        2,
        17
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Des_Peres%2C_Missouri",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The city’s name, French for “The Fathers,” honors those early missionaries who first called the area home.",
      "sourceSentenceIds": [
        17
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Des_Peres%2C_Missouri",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "German immigrants and southerners from Virginia and the Carolinas began settling Des Peres in the 1800s, attracted by fertile 80‑to‑160‑acre tracts.",
      "sourceSentenceIds": [
        21
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Des_Peres%2C_Missouri",
      "category": "people",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Des Peres City Hall, built in 1936, stands as a historic landmark and former Lutheran Orphan Home.",
      "sourceSentenceIds": [
        7,
        8
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://aboutstlouis.com/local/communities/des-peres-missouri",
