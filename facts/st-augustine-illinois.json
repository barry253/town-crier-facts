  "facts": [
    {
      "id": 1,
      "text": "St. Augustine was founded in 1836, boasting a rich history that dates back to the early 19th century.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.knoxcountyscenicdrive.com/saint-augustine.html"
    },
    {
      "id": 2,
      "text": "Originally part of Fulton County, the village strategically moved into Knox County to align itself with the expanding railroad line.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.knoxcountyscenicdrive.com/saint-augustine.html"
    },
    {
      "id": 3,
      "text": "The village’s historic church was built in 1863 under Father Allbrecht’s supervision and once lay just across the Fulton‑County line.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.knoxcountyscenicdrive.com/saint-augustine.html"
    },
    {
      "id": 4,
      "text": "St. Augustine’s southern boundary follows the Fulton County line, marking the edge of the village’s jurisdiction.",
      "sourceSentenceIds": [
        11
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/St._Augustine%2C_Illinois"
    },
    {
      "id": 5,
      "text": "Illinois Route 41 slices through the center of St. Augustine, connecting the village northward to Galesburg.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/St._Augustine%2C_Illinois"
    },
    {
