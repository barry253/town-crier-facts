  "facts": [
    {
      "id": 1,
      "text": "Fargo was incorporated as a city in 1992, becoming the only settlement within almost 20 miles of its borders.",
      "sourceSentenceIds": [
        8,
        9
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Fargo%2C_Georgia",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town grew around the Georgia Southern and Florida Railroad, which reached the Suwannee crossing in 1881 and spurred timber commerce.",
      "sourceSentenceIds": [
        26
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/fargo_georgia",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "A large chip mill operated by Regis Paper Company ran from 1959 until the 1980s, anchoring Fargo’s lumber economy.",
      "sourceSentenceIds": [
        21,
        24
      ],
      "sourceLabels": [
        "Web source 1",
        "Web source 2"
      ],
      "source": "https://clinchcountyga.gov/city-of-fargo.html",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The Bugaboo Fire of 2007 threatened Fargo, becoming Georgia’s largest wildfire that year.",
      "sourceSentenceIds": [
        6,
        11
      ],
      "sourceLabels": [
        "Web source 2",
        "Wikipedia"
      ],
      "source": "https://grokipedia.com/page/fargo_georgia",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Fargo sits on the western edge of the Okefenokee National Wildlife Refuge, with the Suwannee River forming its eastern border.",
      "sourceSentenceIds": [
        10,
        14
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Fargo%2C_Georgia",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The town’s name honors the founding partners of the Baxter & Company sawmill enterprise, reflecting its timber roots.",
