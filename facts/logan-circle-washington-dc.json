  "facts": [
    {
      "id": 1,
      "text": "Logan Circle was renamed in 1930 by Congress to honor Union General John A. Logan.",
      "sourceSentenceIds": [
        1,
        8
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Logan_Circle_(Washington%2C_D.C.)",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The park’s centerpiece is a bronze statue of General Logan, unveiled in 1901 by President William McKinley.",
      "sourceSentenceIds": [
        28
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Logan_Circle_(Washington%2C_D.C.)",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The former home of civil rights leader Mary McLeod Bethune sits one block south, now a museum and National Archives for Black Women’s History.",
      "sourceSentenceIds": [
        2,
        5
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Logan_Circle_(Washington%2C_D.C.)",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "In 1956, three lanes of 13th Street were paved across Logan Circle to accommodate the influx of suburban workers.",
      "sourceSentenceIds": [
        11
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Logan_Circle_(Washington%2C_D.C.)",
      "category": "transport",
      "quality": "poor",
      "qualityReason": "route_only"
    },
    {
      "id": 5,
      "text": "Logan Circle’s layout dates to the 1870s, originally planned as a residential enclave for Washington’s growing bourgeoisie.",
      "sourceSentenceIds": [
        27
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Logan_Circle_(Washington%2C_D.C.)",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The neighborhood hosts two historic districts and numerous National Register sites, reflecting its rich architectural heritage.",
      "sourceSentenceIds": [
