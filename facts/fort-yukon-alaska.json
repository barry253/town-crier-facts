  "facts": [
    {
      "id": 1,
      "text": "Fort Yukon sits on the north bank of the Yukon River where it meets the Porcupine River, about 145 miles northeast of Fairbanks.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Fort_Yukon%2C_Alaska"
    },
    {
      "id": 2,
      "text": "Long before settlers, the Gwich’in people inhabited the Yukon Flats, the area north of the Arctic Circle where Fort Yukon now stands.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Fort_Yukon%2C_Alaska"
    },
    {
      "id": 3,
      "text": "Fort Yukon began as a Hudson's Bay Company trading post called Fort Youcon, founded by Alexander Hunter Murray on June 25, 1847.",
      "sourceSentenceIds": [
        24
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Fort_Yukon%2C_Alaska"
    },
    {
      "id": 4,
      "text": "In the 1950s the U.S. Air Force built a radar station in Fort Yukon, and the town was incorporated in 1959.",
      "sourceSentenceIds": [
        16
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Fort_Yukon%2C_Alaska"
    },
    {
      "id": 5,
      "text": "Fort Yukon endures harsh winters, with temperatures often 13°F colder than Fairbanks because it receives fewer chinook winds.",
      "sourceSentenceIds": [
        20
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Fort_Yukon%2C_Alaska"
    },
    {
      "id": 6,
      "text": "The Yukon River, which flows past Fort Yukon, hosts one of the longest salmon runs in the world.",
