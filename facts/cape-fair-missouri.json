      "quality": "good"
    },
    {
      "id": 2,
      "text": "A post office has operated in Cape Fair since 1851, marking it as one of the oldest continuous postal sites in Stone County.",
      "sourceSentenceIds": [
        17
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
