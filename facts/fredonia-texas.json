      "id": 1,
      "text": "The post office that began as Deerton was renamed Fredonia on June 8, 1880 to avoid confusion with another Texas town.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 1"
      ],
