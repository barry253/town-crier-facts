  "facts": [
    {
      "id": 1,
      "text": "La Puebla was founded in the late 1600s as a Spanish colonial farming community that built acequias—gravity‑fed irrigation ditches—to turn dry high‑desert land into productive fields.",
      "sourceSentenceIds": [
        1,
        19
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/la_puebla_new_mexico",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Acequias in La Puebla not only irrigate crops but also act as social hubs, fostering mutual aid and environmental stewardship amid drought.",
      "sourceSentenceIds": [
        15
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/la_puebla_new_mexico",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "La Puebla sits next to Chimayó, sharing an acequia network that links the two villages and supports regional agriculture.",
      "sourceSentenceIds": [
        22
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/la_puebla_new_mexico",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "After Mexican independence, land grants continued to encourage settlement, with families extending acequias from the Santa Cruz River to irrigate new plots.",
      "sourceSentenceIds": [
        24
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/la_puebla_new_mexico",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Post‑World War II, the High Road to Taos drew visitors to Chimayó’s Santuario, boosting tourism in La Puebla and surrounding villages.",
      "sourceSentenceIds": [
        28
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/la_puebla_new_mexico",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "By the early 1950s, rural electrification reached La Puebla, enabling modern amenities and supporting small‑scale weaving industries.",
      "sourceSentenceIds": [
