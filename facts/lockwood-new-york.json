  "facts": [
    {
      "id": 1,
      "text": "Lockwood was named after Belva Ann Lockwood, a pioneering female lawyer who argued before the Supreme Court.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Barton%2C_New_York"
    },
    {
      "id": 2,
      "text": "The town of Barton, which includes Lockwood, was officially formed in 1824 from the larger Tioga township.",
      "sourceSentenceIds": [
        13
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Barton%2C_New_York"
    },
    {
      "id": 3,
      "text": "Early settlers first arrived around 1791, making Lockwood one of the earliest communities in southwestern Tioga County.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Barton%2C_New_York"
    },
    {
      "id": 4,
      "text": "The Sullivan Expedition of 1779 marched through the area that would later become Lockwood, marking a significant military campaign.",
      "sourceSentenceIds": [
        11
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Barton%2C_New_York"
    },
    {
      "id": 5,
      "text": "The Susquehanna River forms Lockwood’s southern boundary, while the state line with Pennsylvania borders the rest of the town.",
      "sourceSentenceIds": [
        19
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Barton%2C_New_York"
    },
    {
      "id": 6,
      "text": "New York State Route 17, the Southern Tier Expressway, cuts across Lockwood beside the Susquehanna River, linking the region to larger cities.",
      "sourceSentenceIds": [
        21
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Barton%2C_New_York"
