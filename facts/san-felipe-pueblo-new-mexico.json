  "facts": [
    {
      "id": 1,
      "text": "Founded in 1706, San Felipe Pueblo is home to speakers of an eastern dialect of the Keresan languages.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/San_Felipe_Pueblo%2C_New_Mexico"
    },
    {
      "id": 2,
      "text": "In 1591, Castano de Sosa named the settlement San Felipe after a Jesuit martyr who died in Japan.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.newmexico.org/native-culture/native-communities/san-felipe-pueblo/"
    },
    {
      "id": 3,
      "text": "The pueblo sits at the foot of Black Mesa in the middle Rio Grande valley of New Mexico.",
      "sourceSentenceIds": [
        30
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://sfpueblo.com/"
    },
    {
      "id": 4,
      "text": "Every May 1, San Felipe Pueblo celebrates the Feast of St. Philip with traditional corn dances.",
      "sourceSentenceIds": [
        10,
        11
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/San_Felipe_Pueblo%2C_New_Mexico"
    },
    {
      "id": 5,
      "text": "Just off Interstate 25, the pueblo operates Black Mesa Casino, formerly San Felipe Casino and Casino Hollywood.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
