  "facts": [
    {
      "id": 1,
      "text": "Warminster Heights was once called Lacey Park, named after Revolutionary War General John Lacey who fought at the nearby Battle of Crooked Billet.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Warminster_Heights%2C_Pennsylvania",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Built in 1943, the neighborhood originally housed civilians for the Brewster Aeronautical Corporation, a wartime aircraft manufacturer.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Warminster_Heights%2C_Pennsylvania",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "From 1957 to 1975 Warminster Heights’ units were privately owned before Bucks County took over, later handing them to a homeowner cooperative in 1986.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Warminster_Heights%2C_Pennsylvania",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Water and sewer services in Warminster Heights are supplied by the Warminster Municipal Authority, a local utility.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Warminster_Heights%2C_Pennsylvania",
      "category": "other",
      "quality": "poor",
      "qualityReason": "editorial_filler"
    },
    {
      "id": 5,
      "text": "Warminster Heights sits just east of Hatboro, placing it on the boundary between Bucks and Montgomery counties.",
