  "facts": [
    {
      "id": 1,
      "text": "Lonerock was founded in 1871 by settlers from the Willamette Valley who were attracted by open grazing land and a reliable spring.",
      "sourceSentenceIds": [
        5,
        7
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://worldghosttowns.com/towns/lonerock-oregon/"
    },
    {
      "id": 2,
      "text": "The town takes its name from a basalt monolith that served as a rendezvous point for local ranchers in the grasslands.",
      "sourceSentenceIds": [
        2,
        6,
        18
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://worldghosttowns.com/towns/lonerock-oregon/"
    },
    {
      "id": 3,
      "text": "Lonerock's historic 1898 Methodist-Episcopal Church and former schoolhouse still stand as remnants of the town's frontier culture.",
      "sourceSentenceIds": [
        13,
        23,
        24
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://unitedstatesghosttowns.com/lonerock-oregon-ghost-town/"
    },
    {
      "id": 4,
      "text": "Economic challenges and isolation from railways led to the eventual abandonment of Lonerock by the 1970s.",
      "sourceSentenceIds": [
        15
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://unitedstatesghosttowns.com/lonerock-oregon-ghost-town/"
    },
    {
      "id": 5,
      "text": "Paranormal investigators have reported disembodied voices, footsteps, and apparitions within the ruins of the old buildings in Lonerock.",
