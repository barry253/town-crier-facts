  "facts": [
    {
      "id": 1,
      "text": "Simpson was settled in 1818 and officially organized in 1845 as part of Fell Township.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Simpson%2C_Pennsylvania",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town’s name honors Clarence D. Simpson, a prominent coal magnate in the Northern Anthracite Region.",
      "sourceSentenceIds": [
        3,
        9
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Simpson%2C_Pennsylvania",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Simpson’s early economy boomed with coal mining, railroads, and textile mills like the Klotz Throwing Company and Empire Silk Mill.",
      "sourceSentenceIds": [
        5,
        13
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Simpson%2C_Pennsylvania",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The Morss Mansion, built in 1887 on Lord Avenue, once stood as a Greek‑Revival landmark before its demolition in 1996.",
      "sourceSentenceIds": [
        2,
        29
      ],
      "sourceLabels": [
        "Web source 1",
        "Web source 2"
      ],
      "source": "https://lackawannacounty.com/simpson",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "In 1946, the Fell High School basketball team from Simpson captured Pennsylvania’s state championship, a proud moment for the community.",
      "sourceSentenceIds": [
        16
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Simpson%2C_Pennsylvania",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Nestled just north of Carbondale along PA Route 171, Simpson’s history is shaped by anthracite coal mining, immigrant labor, and deep civic pride.",
      "sourceSentenceIds": [
        22
      ],
