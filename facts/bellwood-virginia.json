  "facts": [
    {
      "id": 1,
      "text": "Bellwood’s two‑story Georgian house was built in 1804, showcasing the wooden style favored by Virginia planters of the era.",
      "sourceSentenceIds": [
        16,
        17
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.dhr.virginia.gov/historic-registers/020-0007/"
    },
    {
      "id": 2,
      "text": "In May 1864, Confederate General P. G. Beauregard made Bellwood his headquarters, where he met President Jefferson Davis.",
      "sourceSentenceIds": [
        18,
        19,
        20
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.dhr.virginia.gov/historic-registers/020-0007/"
    },
    {
      "id": 3,
      "text": "James Bellwood purchased the property in 1887 and turned it into a model farm that earned national acclaim at the 1914 Pacific International Exposition.",
      "sourceSentenceIds": [
        21
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.dhr.virginia.gov/historic-registers/020-0007/"
    },
    {
      "id": 4,
      "text": "The Army bought Bellwood in 1941 and activated the Richmond General Depot, a major logistics hub during World War II.",
      "sourceSentenceIds": [
        22
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.dhr.virginia.gov/historic-registers/020-0007/"
    },
    {
      "id": 5,
      "text": "An elk herd established by Bellwood now grazes on a twenty‑acre reserve adjacent to the historic house.",
      "sourceSentenceIds": [
        24
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.dhr.virginia.gov/historic-registers/020-0007/"
    },
    {
      "id": 6,
      "text": "The community of Bellwood takes its name from the James River plantation that once stood on the site.",
      "sourceSentenceIds": [
