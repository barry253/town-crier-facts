  "facts": [
    {
      "id": 1,
      "text": "Honesdale earned the nickname “Birthplace of the American Railroad” after the 1829 arrival of the Stourbridge Lion from England.",
      "sourceSentenceIds": [
        5,
        6
      ],
      "sourceLabels": [
        "Web source 1",
        "Web source 2"
      ],
      "source": "https://www.visitpa.com/explore/regions/pocono-mountains/honesdale/"
    },
    {
      "id": 2,
      "text": "The town’s first major waterway, the Delaware and Hudson Canal, opened in 1826, linking coal mines to New York City via a 108‑mile canal.",
      "sourceSentenceIds": [
        2,
        9
      ],
      "sourceLabels": [
        "Wikipedia",
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Honesdale%2C_Pennsylvania"
    },
    {
      "id": 3,
      "text": "Irving Cliff, a 300‑foot high overlook named for author Washington Irving, offers sweeping views of downtown Honesdale and the surrounding valley.",
      "sourceSentenceIds": [
        3,
        8
      ],
      "sourceLabels": [
        "Web source 2",
        "Wikipedia"
      ],
      "source": "https://paroute6.com/heritage-communities/honesdale-pa/"
    },
    {
      "id": 4,
      "text": "The Wayne County Historical Society Museum houses a full‑scale replica of the original Stourbridge Lion, relocated to Honesdale in 1941.",
      "sourceSentenceIds": [
        4,
        17
      ],
      "sourceLabels": [
        "Wikipedia",
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Honesdale%2C_Pennsylvania"
    },
    {
      "id": 5,
      "text": "Seasonal passenger excursions run along the historic Stourbridge Line, covering 25 miles of track that follows the Lackawaxen River through northeastern Pennsylvania.",
      "sourceSentenceIds": [
        18,
        7
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 2"
      ],
      "source": "https://en.wikipedia.org/wiki/Honesdale%2C_Pennsylvania"
    },
    {
      "id": 6,
      "text": "Honesdale’s Central Park, overlooking the historic Court House, also frames the Old Stone Jail, a 1859 landmark that once housed prisoners for the county.",
      "sourceSentenceIds": [
        22,
        25
      ],
      "sourceLabels": [
        "Web source 1",
        "Web source 2"
      ],
