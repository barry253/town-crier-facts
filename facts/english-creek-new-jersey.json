  "facts": [
    {
      "id": 1,
      "text": "English Creek takes its name from the English family, early settlers who farmed the area in the late 17th century.",
      "sourceSentenceIds": [
        22
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/english_creek_new_jersey"
    },
    {
      "id": 2,
      "text": "In 1709, Joseph English bought 550 acres that would become English Creek, laying the groundwork for the area's rural beginnings.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/english_creek_new_jersey"
    },
    {
      "id": 3,
      "text": "Summer days in English Creek hover around 75°F, while winter nights dip to about 35°F, thanks to the Atlantic's influence.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/english_creek_new_jersey"
    },
    {
      "id": 4,
      "text": "English Creek sits just 12 miles southeast of Atlantic City and borders the Great Egg Harbor River to the east.",
      "sourceSentenceIds": [
        26
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/english_creek_new_jersey"
    },
    {
      "id": 5,
      "text": "The nearby Forsythe National Wildlife Refuge protects 48,000 acres of salt marshes and barrier islands, enriching local biodiversity.",
      "sourceSentenceIds": [
        30
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/english_creek_new_jersey"
    },
    {
      "id": 6,
      "text": "Because of its coastal setting, English Creek is prone to flooding from storm surges and rising sea levels.",
