  "facts": [
    {
      "id": 1,
      "text": "Ball was founded in 1893 when Captain Chittenden Edwin Ball, a steamboat captain from Kentucky, named a sawmill town after himself.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Ball%2C_Louisiana"
    },
    {
      "id": 2,
      "text": "The town’s origins trace back to a logging boom, with the Sweet Home Mill established by Ball in the late 1880s.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Ball%2C_Louisiana"
    },
    {
      "id": 3,
      "text": "Camp Livingston, a World War II Army base, peaked at 42,500 troops in 1942 before closing after the war.",
      "sourceSentenceIds": [
        4,
        5
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 2"
      ],
      "source": "https://en.wikipedia.org/wiki/Ball%2C_Louisiana"
    },
    {
      "id": 4,
      "text": "Ball officially incorporated in May 1972 under the Lawrason Act, joining the Alexandria Metropolitan Statistical Area.",
      "sourceSentenceIds": [
        12,
        7
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Ball%2C_Louisiana"
    },
    {
      "id": 5,
      "text": "Earliest settlers arrived between 1840 and 1863, long before the town’s formal establishment.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Ball%2C_Louisiana"
    },
    {
      "id": 6,
      "text": "Located just north of Pineville, Ball sits within Rapides Parish in central Louisiana.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Ball%2C_Louisiana"
    }
