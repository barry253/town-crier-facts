  "facts": [
    {
      "id": 1,
      "text": "The area comprising Alexandria was settled around 1793 by Frank Spilman and his family, who migrated from Fairfax and King George Counties in Virginia via the Ohio River.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/Alexandria,_Kentucky",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The Spilman family, originally from Virginia, may have named the settlement after Alexandria, Virginia.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Alexandria%2C_Kentucky",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "When Kenton County split from Campbell County in 1840, the state assembly moved the county seat from Newport to Alexandria, placing it closer to the new county’s center.",
      "sourceSentenceIds": [
        17
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Alexandria%2C_Kentucky",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The Old Campbell County Courthouse, built in the 19th century, remains a key landmark that anchors Alexandria’s role as a county seat.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/Alexandria,_Kentucky",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The Newport and Alexandria Turnpike Company opened the Alexandria Pike in 1856, a toll road that linked the town to regional markets.",
      "sourceSentenceIds": [
