      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Early settlers in Nunn farmed sugar beets and wheat, turning the High Plains into a thriving agricultural hub.",
      "sourceSentenceIds": [
        22
      ],
      "sourceLabels": [
