      ],
      "source": "https://www.uncovercolorado.com/towns/nunn/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Founded as a Union Pacific railroad shipping point in the late 19th century, Nunn’s layout still echoes its rail origins.",
      "sourceSentenceIds": [
        3,
        4
      ],
      "sourceLabels": [
        "Web source 1"
