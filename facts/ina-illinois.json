  "facts": [
    {
      "id": 1,
      "text": "Ina earned its name when early settlers renamed the crossroads after Ina Williams, the daughter of one of the first families.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.trawellino.com/destinations/united-states/illinois_ina",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The village sits just north of Rend Lake, a popular regional reservoir that stretches into neighboring counties.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.citydirectory.us/village-ina.html",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Ina is home to the Big Muddy River Correctional Center, a state prison that opened in 1991.",
      "sourceSentenceIds": [
        24
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Ina%2C_Illinois",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "In the 1840s, Cherokee families fleeing the Trail of Tears settled in Ina, earning the village the nickname 'the Cherokee Reservation'.",
      "sourceSentenceIds": [
        9,
        10,
        11
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Ina%2C_Illinois",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The original settlement nearby, Spring Garden, lay about three miles northeast of Ina and was the area's first thriving community.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Ina%2C_Illinois",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Ina sits on high ground between Casey Creek and Gun Creek, both tributaries that feed the Big Muddy River.",
      "sourceSentenceIds": [
        22
      ],
      "sourceLabels": [
