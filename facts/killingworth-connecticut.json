  "facts": [
    {
      "id": 1,
      "text": "Killingworth’s roots stretch back to 1667, when the area was carved out of lands known as Hammonasset, named for the tribe that originally lived there.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.ct.one/towns/killingworth",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town’s historic Congregational Church on Route 81 still stands as a quiet anchor to that long colonial past.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.ct.one/towns/killingworth",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Three sites in Killingworth—Emmanuel Church, Oak Lodge, and the Parmelee House—are listed on the National Register of Historic Places.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Killingworth%2C_Connecticut",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "In the late 17th century, Killingworth became the birthplace of what would eventually become Yale University, with early classes taught in a local home.",
      "sourceSentenceIds": [
        22,
        23
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Killingworth%2C_Connecticut",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The Killingworth Library hosts regular programs like Tales for Tots, Love2Sign, Minecraft, Music with Margie, and Surprise Saturday for the community.",
