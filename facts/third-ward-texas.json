  "facts": [
    {
      "id": 1,
      "text": "Third Ward was named when Houston was divided into four wards in 1837, with the southeastern segment christened the Third Ward.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://texashappens.com/learn-about-the-history-of-third-ward-houston/"
    },
    {
      "id": 2,
      "text": "Emancipation Park, bought by freed slaves in 1872, is Houston’s oldest park and a cornerstone of Third Ward’s history.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://texashappens.com/learn-about-the-history-of-third-ward-houston/"
    },
    {
      "id": 3,
      "text": "Texas Southern University, founded in 1947, sits at the heart of the Third Ward and has long been a hub for education and civil‑rights activism.",
      "sourceSentenceIds": [
        22,
        23
      ],
      "sourceLabels": [
        "Web source 1",
        "Web source 2"
      ],
      "source": "https://texashappens.com/learn-about-the-history-of-third-ward-houston/"
    },
    {
      "id": 4,
      "text": "Jack Yates High School, the second African‑American high school in Houston, stands as a historic landmark within the Third Ward.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://texashappens.com/learn-about-the-history-of-third-ward-houston/"
    },
    {
      "id": 5,
      "text": "The Eldorado Ballroom, one of the Third Ward’s landmark sites, helped shape Black music history across generations.",
      "sourceSentenceIds": [
        11
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://historicblackwallstreet.com/houstons-third-ward-a-historic-black-wall-street-of-legacy-culture-and-economic-resilience/"
    },
    {
