      "quality": "poor",
      "qualityReason": "editorial_filler"
    },
    {
      "id": 4,
      "text": "Stretton State College opened on 1 January 2006, becoming the suburb's first comprehensive Prep‑12 school.",
      "sourceSentenceIds": [
        15
