      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "In 1861 Governor Bowen declared a wide Brisbane Agricultural Reserve that stretched from Eight Mile Plains to Stretton.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Stretton%2C_Queensland",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "A 1922 military map shows only four houses in the area now known as Stretton, underscoring its early rural roots.",
      "sourceSentenceIds": [
        13
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Stretton%2C_Queensland",
