  "facts": [
    {
      "id": 1,
      "text": "Independence was laid out on October 5, 1832 by Zachariah Cicott, a French‑Indian trader and scout for General William Henry Harrison.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Independence%2C_Indiana"
    },
    {
      "id": 2,
      "text": "A trading post had been operating at the site as early as 1811, long before the town was formally established.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Independence%2C_Indiana"
    },
    {
      "id": 3,
      "text": "The town’s post office opened on March 24, 1834 and remained in service until January 31, 1950.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Independence%2C_Indiana"
    },
    {
      "id": 4,
      "text": "Independence hosted the county’s first newspaper, the Wabash Register, which began publishing in 1844 under editor Enos Canutt.",
      "sourceSentenceIds": [
        7,
        8
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Independence%2C_Indiana"
    },
    {
      "id": 5,
      "text": "Geographically, Independence sits on the western banks of the Wabash River, about seven miles northeast of the county seat, Williamsport.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Independence%2C_Indiana"
    },
    {
      "id": 6,
      "text": "Across the river on the opposite bank lies the small town of Riverside, located in Fountain County.",
