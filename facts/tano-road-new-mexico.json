  "facts": [
    {
      "id": 1,
      "text": "Tano Road takes its name from the Tano people, a branch of the Kiwa Puebloan group who farmed the area long before Spanish settlers arrived.",
      "sourceSentenceIds": [
        9,
        10
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://tanoroadneighborhood.org/tracing-the-unique-legacy-of-tano-road-santa-fe-s-scenic-corridor-with-a-storied-past/"
    },
    {
      "id": 2,
      "text": "During the Spanish colonial era, land along what is now Tano Road was mapped as ranchos and agricultural commons that supplied the growing Villa de Santa Fe.",
      "sourceSentenceIds": [
        11
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://tanoroadneighborhood.org/tracing-the-unique-legacy-of-tano-road-santa-fe-s-scenic-corridor-with-a-storied-past/"
    },
    {
      "id": 3,
      "text": "In the mid‑20th century, ranch lands on Tano Road were subdivided into five‑ and ten‑acre homesites, yet light‑and‑noise restrictions kept the area’s rustic character intact.",
      "sourceSentenceIds": [
        13,
        14,
        15,
        16
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://tanoroadneighborhood.org/tracing-the-unique-legacy-of-tano-road-santa-fe-s-scenic-corridor-with-a-storied-past/"
    },
    {
      "id": 4,
      "text": "Hikers, cyclists, and horseback riders enjoy winding trails through sagebrush, sandstone outcrops, and sweeping views of the Jemez and Sangre de Cristo mountains.",
      "sourceSentenceIds": [
        19
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://tanoroadneighborhood.org/tracing-the-unique-legacy-of-tano-road-santa-fe-s-scenic-corridor-with-a-storied-past/"
    },
    {
      "id": 5,
      "text": "Artists, writers, and makers have long been drawn to Tano Road’s quiet corners, where studios tucked under cottonwoods offer inspiration amid the high desert.",
      "sourceSentenceIds": [
        25,
        26
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://tanoroadneighborhood.org/tracing-the-unique-legacy-of-tano-road-santa-fe-s-scenic-corridor-with-a-storied-past/"
    },
    {
      "id": 6,
      "text": "Every August, the Santa Fe Indian Market weekend draws visitors from across the region to celebrate Native arts, culture, and cuisine just a short drive from Tano Road.",
