  "facts": [
    {
      "id": 1,
      "text": "Warsaw was founded in 1803 when land from the Holland Land Company was purchased by Elizur Webster, carving it out of the Town of Batavia.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Warsaw%2C_New_York",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town’s name likely honors Warsaw, Poland, reflecting early settlers’ European roots.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Warsaw%2C_New_York",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "In 1833 Warsaw formed an anti‑slavery society, and by 1839 its Presbyterian Church hosted the first meeting of the Liberty Party.",
      "sourceSentenceIds": [
        22,
        23
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Warsaw%2C_New_York",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The village of Warsaw serves as the county seat of Wyoming County, hosting the county courthouse and administrative offices.",
      "sourceSentenceIds": [
        18
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Warsaw%2C_New_York",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Oatka Creek winds northward through Warsaw’s Wyoming Valley, providing a natural corridor that shaped early settlement patterns.",
      "sourceSentenceIds": [
        27
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Warsaw%2C_New_York",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The Erie Railroad once cut through Warsaw, linking the town to regional trade routes and fueling its 19th‑century growth.",
      "sourceSentenceIds": [
        14
      ],
