      "id": 1,
      "text": "Howard was erected in 1810 from Centre Township and named after philanthropist John Howard.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://centre.pagenweb.org/twpsboros/howtwp1.htm",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The village’s earliest settler, David DeLong, founded Howard in 1778 after a 1769 survey of the area.",
      "sourceSentenceIds": [
        29
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://centre.pagenweb.org/twpsboros/howtwp1.htm",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The Howard Area Museum Historical Society preserves local history in the 1909 Old Howard School building.",
      "sourceSentenceIds": [
        8,
        6
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://museumsdatabase.com/museums/view/26708",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The museum’s research library is open to the public and offers genealogy resources.",
      "sourceSentenceIds": [
