      ],
      "source": "https://museumsdatabase.com/museums/view/26708",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Howard Township originally encompassed parts of Curtin, Liberty, Boggs, Snow Shoe, and Burnside Townships.",
      "sourceSentenceIds": [
        4
