  "facts": [
    {
      "id": 1,
      "text": "Coahoma County, founded Feb. 9, 1836 on land ceded by the Choctaw, takes its name from a Choctaw word meaning \"red panther\".",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://mississippiencyclopedia.org/entries/coahoma-county/"
    },
    {
      "id": 2,
      "text": "Coahoma County sits at the heart of blues history, with Clarksdale home to the Delta Blues Museum and annual Sunflower River Blues and Gospel Festival.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://mississippiencyclopedia.org/entries/coahoma-county/"
    },
    {
      "id": 3,
      "text": "Aaron Henry, a long‑time NAACP organizer, once ran a pharmacy in Clarksdale.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://mississippiencyclopedia.org/entries/coahoma-county/"
    },
    {
      "id": 4,
      "text": "During the 1920s and 1930s, Coahoma County welcomed a large wave of Mexican farm laborers.",
      "sourceSentenceIds": [
        11
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://mississippiencyclopedia.org/entries/coahoma-county/"
    },
    {
      "id": 5,
      "text": "Notable musicians like Willie Brown, Sam Cooke, Ike Turner, and Big Jack Johnson all hail from Coahoma County.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://mississippiencyclopedia.org/entries/coahoma-county/"
    },
    {
      "id": 6,
      "text": "John Lee Hooker, the legendary blues guitarist, was born in 1917 in Coahoma County to a sharecropper family.",
