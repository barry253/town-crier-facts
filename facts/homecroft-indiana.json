  "facts": [
    {
      "id": 1,
      "text": "Homecroft began in 1923 when Frank Gates and his son Oliver bought 150 acres and, with WPA help, installed storm sewers to drain the swampy area before selling lots.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Homecroft%2C_Indiana"
    },
    {
      "id": 2,
      "text": "The town was incorporated in 1949 and joined Indianapolis in 1970 under Unigov, yet it still keeps its own town council.",
      "sourceSentenceIds": [
        7,
        8
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Homecroft%2C_Indiana"
    },
    {
      "id": 3,
      "text": "Homecroft was planned as an exclusively residential community, with only a few commercial spots along Madison Avenue.",
      "sourceSentenceIds": [
        13
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Homecroft%2C_Indiana"
    },
    {
      "id": 4,
      "text": "A large portion of Homecroft is listed on the National Register of Historic Places as the Homecroft Historic District.",
      "sourceSentenceIds": [
        14
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Homecroft%2C_Indiana"
    },
    {
      "id": 5,
      "text": "The town is bounded roughly by Banta Road, the Louisville and Indiana Railroad tracks, Tulip Drive and Shelby Street.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Homecroft%2C_Indiana"
    },
    {
      "id": 6,
      "text": "The Homecroft town council has five elected members who oversee ordinances, property, and finances.",
