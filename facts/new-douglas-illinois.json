  "facts": [
    {
      "id": 1,
      "text": "New Douglas was laid out by Alonzo Foster on September 5, 1860 and officially incorporated on December 16, 1874.",
      "sourceSentenceIds": [
        3,
        20
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://madison-historical.siue.edu/encyclopedia/new-douglas/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The village was named after Illinois Senator Stephen A. Foster, honoring his influence in the state.",
      "sourceSentenceIds": [
        2,
        6
      ],
      "sourceLabels": [
        "Web source 1",
        "Wikipedia"
      ],
      "source": "https://madison-historical.siue.edu/encyclopedia/new-douglas/",
      "category": "people",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Coal mining and farming powered New Douglas in the early 1900s; when coal demand fell in the 1950s the town returned to growing corn and soybeans.",
      "sourceSentenceIds": [
        7,
        8,
        23,
        24
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 2"
      ],
      "source": "https://en.wikipedia.org/wiki/New_Douglas%2C_Illinois",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Water from New Douglas flows west to Silver Creek and southeast to the Little Dry Fork of Shoal Creek, all within the Kaskaskia River watershed.",
      "sourceSentenceIds": [
        9,
        10
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/New_Douglas%2C_Illinois",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Daniel Funderburk, originally from South Carolina, was the first American settler in New Douglas township, arriving in 1819 and living alone for years.",
      "sourceSentenceIds": [
        1,
        18
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://madison-historical.siue.edu/encyclopedia/new-douglas/",
      "category": "people",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "New Douglas sits in Madison County, Illinois, part of the larger Illinois River basin.",
