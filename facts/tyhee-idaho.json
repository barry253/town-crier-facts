  "facts": [
    {
      "id": 1,
      "text": "Tyhee was named after Chief Tyhee, a Bannock leader whose name means 'chief' in Chinook Jargon.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/tyhee_idaho"
    },
    {
      "id": 2,
      "text": "Chief Tyhee negotiated the 1868 Fort Bridger Treaty, securing a reservation that included Portneuf and Camas Prairies.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/tyhee_idaho"
    },
    {
      "id": 3,
      "text": "Tyhee sits at about 42°57′6″N 112°27′59″W, rising 4,462 feet above sea level.",
      "sourceSentenceIds": [
        15
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/tyhee_idaho"
    },
    {
      "id": 4,
      "text": "Tyhee sits in the Portneuf Valley, a broad alluvial basin with basalt plateaus and fertile volcanic soils that support ranching and agriculture.",
      "sourceSentenceIds": [
        19,
        21
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/tyhee_idaho"
    },
    {
      "id": 5,
      "text": "Tyhee experiences a semi‑arid continental climate, with low humidity, sharp temperature swings, and most rain falling in winter and spring.",
      "sourceSentenceIds": [
        26
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/tyhee_idaho"
    },
    {
      "id": 6,
      "text": "The steppe around Tyhee is dominated by sagebrush and native bunchgrasses, supporting wildlife such as sage grouse and small mammals.",
      "sourceSentenceIds": [
        23,
        25
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/tyhee_idaho"
    }
  ]
