  "facts": [
    {
      "id": 1,
      "text": "Brownville was founded in 1854 by Richard Brown as a strategic trading post and ferry crossing on the Missouri River.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.brownvillenebraska.gov/history",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The Carson House, built by founder Richard Brown, later became the home of John L. and is listed on the National Register of Historic Places.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.brownville-ne.com/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "In 1877, the Carson House was dismantled brick‑by‑brick and rebuilt on Main Street after the Missouri River shifted its course.",
      "sourceSentenceIds": [
        11
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.brownville-ne.com/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The Brownville Depot & Rail History Museum preserves the town’s failed attempt to build a railroad, a pivotal moment that redirected commerce away from steamboats.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.brownville-ne.com/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Early Brownville’s three brick factories supplied the locally manufactured bricks that built historic structures like the Carson House.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.brownville-ne.com/",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The Governor Furnas House Museum, an 1868 Italianate and Gothic Revival home, showcases the architectural style of its era.",
      "sourceSentenceIds": [
        25
      ],
      "sourceLabels": [
        "Web source 2"
      ],
