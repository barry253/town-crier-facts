  "facts": [
    {
      "id": 1,
      "text": "Fredericktown was founded in 1807 by John Kerr, who built a mill on the site and named the village after his hometown of Frederick, Maryland.",
      "sourceSentenceIds": [
        1,
        5
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 2"
      ],
      "source": "https://en.wikipedia.org/wiki/Fredericktown%2C_Ohio",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The arrival of the Sandusky, Mansfield and Newark Railroad in 1853 turned Fredericktown into a bustling hub for shipping local produce.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.fredericktownmuseum.com/town-history",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "A historic ball clock, once in disrepair on a Cleveland street, was rescued in 2007 and returned to Fredericktown by local volunteers and the bicentennial committee.",
      "sourceSentenceIds": [
        13
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.fredericktownmuseum.com/town-history",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The Fredericktown Historical Society Museum preserves the village’s heritage in a building that was originally a United Methodist church erected in 1828.",
      "sourceSentenceIds": [
        8,
        15
      ],
      "sourceLabels": [
        "Web source 1",
        "Web source 1"
      ],
      "source": "https://fredericktownohio.net/history/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The village’s public library, a branch of the Mount Vernon & Knox County Library System, occupies the same 1828 church building that once served the community’s spiritual needs.",
      "sourceSentenceIds": [
        14,
        15
      ],
