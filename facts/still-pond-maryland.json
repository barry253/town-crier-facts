  "facts": [
    {
      "id": 1,
      "text": "Still Pond was the first Maryland town where women earned the right to vote, a milestone in the state's civil‑rights history.",
      "sourceSentenceIds": [
        11,
        24
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Still_Pond%2C_Maryland",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town sits at a historic crossroads of MD 292 and MD 566, forming a five‑point intersection that anchors its rural character.",
      "sourceSentenceIds": [
        10,
        13,
        14
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Still_Pond%2C_Maryland",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The Still Pond Historic District contains about 75 buildings from the early 19th to 1930s, showcasing Victorian, Colonial Revival, and Craftsman styles.",
      "sourceSentenceIds": [
        13,
        21,
        25
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Still_Pond%2C_Maryland",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Preservation efforts aim to maintain the village’s rural charm, encouraging restoration of historic properties and sharing best practices with the community.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://stillpondmd.org/spp.html",
      "category": "other",
      "quality": "poor",
      "qualityReason": "editorial_filler"
    },
    {
      "id": 5,
      "text": "The district’s visual unity comes from buildings that face the roads, with older homes close to the street and larger houses set back.",
      "sourceSentenceIds": [
        17,
        18
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Still_Pond%2C_Maryland",
      "category": "other",
      "quality": "poor",
      "qualityReason": "editorial_filler"
    },
    {
      "id": 6,
      "text": "A former post office, warehouse, and Odd Fellows Hall now stand as reminders of Still Pond’s past as a commercial hub on Maryland’s Upper Eastern Shore.",
