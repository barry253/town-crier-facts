      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The New England Central Railroad still cuts through Belchertown, once connecting to the abandoned Massachusetts Central line.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Belchertown%2C_Massachusetts",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Belchertown’s Stone House Museum, founded by local educator Salem Towne, preserves the town’s early history.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Belchertown%2C_Massachusetts",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Belchertown contains historic villages like Dwight's Station, Bardwell Village, Barrett's Junction, and the quirky Slab City.",
