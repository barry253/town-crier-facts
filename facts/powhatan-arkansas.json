  "facts": [
    {
      "id": 1,
      "text": "Powhatan sits on the Black River in Lawrence County, Arkansas, making it a historic river town.",
      "sourceSentenceIds": [
        24
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Powhatan%2C_Arkansas",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Before its first platting in 1849, Powhatan was already the economic hub of Lawrence County.",
      "sourceSentenceIds": [
        28
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Powhatan%2C_Arkansas",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "A 19th‑century courthouse crowns a hill above the Black River, a visual reminder of Powhatan’s rich history.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://powhatan.cast.uark.edu/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "After the railroad bypassed Powhatan in the 1870s, the town slowly declined as families moved to railway hubs like Black Rock.",
      "sourceSentenceIds": [
        5,
        6
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://powhatan.cast.uark.edu/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The Powhatan Historic Mapping project, launched in 2018, now offers an interactive map covering almost 200 years from 1830 to today.",
      "sourceSentenceIds": [
        1,
        13
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://powhatan.cast.uark.edu/",
      "category": "other",
      "quality": "poor",
      "qualityReason": "editorial_filler"
    },
    {
      "id": 6,
      "text": "Guided tours at Powhatan Historic State Park cover historic structures like the Log House, Stone Jail, and Arkansas’s last toll bridge.",
