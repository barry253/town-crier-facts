      "id": 1,
      "text": "Gold Run was founded in 1854 by O. Hollenbeck and originally called Mountain Springs.",
      "sourceSentenceIds": [
        4,
        8,
        13
      ],
      "sourceLabels": [
        "Web source 1",
        "Wikipedia"
      ],
      "source": "https://grokipedia.com/page/gold_run_california",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town was renamed Gold Run in 1863 when the post office moved one mile north, marking the start of hydraulic mining dominance.",
      "sourceSentenceIds": [
        3,
        18
      ],
      "sourceLabels": [
        "Web source 1",
        "Wikipedia"
      ],
      "source": "https://grokipedia.com/page/gold_run_california",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Gold Run produced over $6.1 million in gold between 1865 and 1878, making it one of Placer County’s most productive hydraulic sites.",
      "sourceSentenceIds": [
        24,
        19
      ],
      "sourceLabels": [
        "Web source 1",
        "Wikipedia"
      ],
      "source": "https://grokipedia.com/page/gold_run_california",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Hydraulic mining at Gold Run processed up to 80 million cubic yards of gravel from a distinctive blue gravel bed, causing sediment damage that led to river flooding.",
      "sourceSentenceIds": [
        25
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/gold_run_california",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Gold Run is a California Historical Landmark (#405), commemorating its role in the Gold Rush era.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Gold_Run%2C_California",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Gold Run sits on a ridge south of Dutch Flat, about 25 miles northeast of Auburn, between the Bear River and the North Fork of the American River.",
