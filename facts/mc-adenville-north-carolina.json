  "facts": [
    {
      "id": 1,
      "text": "McAdenville was incorporated in 1881 and grew around the McAden Mills textile factory led by Rufus Yancey McAden.",
      "sourceSentenceIds": [
        15,
        2
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/McAdenville%2C_North_Carolina",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town earned the nickname Christmas Town, USA after Pharr Yarns began decorating 375 trees in 1956, drawing over 600,000 visitors yearly.",
      "sourceSentenceIds": [
        23,
        24,
        19,
        21
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/McAdenville%2C_North_Carolina",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "McAdenville sits on the South Fork Catawba River, where a dam created McAdenville Lake in central town.",
      "sourceSentenceIds": [
        26,
        27
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/McAdenville%2C_North_Carolina",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The historic downtown Main Street showcases craftsman‑style homes from the 1880s alongside newer neighborhoods, reflecting the town’s blend of heritage and growth.",
      "sourceSentenceIds": [
        8,
        7
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://townofmcadenville.org/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The McAdenville Historic District earned National Register of Historic Places status in 2009, preserving buildings that date back to the early 1880s.",
      "sourceSentenceIds": [
        25,
        8
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/McAdenville%2C_North_Carolina",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Every December, residents light 375 trees and over 200 wreaths on city poles for the annual Christmas Tree Lighting Ceremony, celebrating 70 years of holiday lights.",
