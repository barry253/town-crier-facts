      ],
      "source": "https://en.wikipedia.org/wiki/St._Johnsville%2C_New_York",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "By the late 1800s, St. Johnsville became a key stop on the New York Central Railroad and the Erie Canal.",
      "sourceSentenceIds": [
        6,
