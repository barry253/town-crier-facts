  "facts": [
    {
      "id": 1,
      "text": "Pomfret’s name traces back to Green's Inheritance, a house built by Francis Caleb Green on land granted to Thomas Greene’s sons in 1666.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Pomfret%2C_Maryland",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Five historic properties in Pomfret—Acquinsicke, Green's Inheritance, McPherson's Purchase, Pleasant Hill, and one more—are listed on the National Register of Historic Places.",
      "sourceSentenceIds": [
        3,
        4
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Pomfret%2C_Maryland",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The 1963 nonfiction book *History of Saint Joseph’s Church, Pomfret, Maryland, 1763‑1963* chronicles the parish’s long heritage.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Pomfret%2C_Maryland",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Station 13 in Pomfret houses the Charles County Dive Rescue Company, which handles underwater rescues and flood‑water assistance.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Pomfret%2C_Maryland",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Pomfret sits on Marshall Corner Road, part of which carries the designation Route 227 through central Charles County.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Pomfret%2C_Maryland",
      "category": "transport",
      "quality": "poor",
      "qualityReason": "route_only"
    },
    {
      "id": 6,
      "text": "The town is just one mile west of the College of Southern Maryland and three‑fifths of a mile south of Bennsville Park.",
