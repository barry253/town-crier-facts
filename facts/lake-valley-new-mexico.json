  "facts": [
    {
      "id": 1,
      "text": "Lake Valley, New Mexico, sprang in 1878 when silver was discovered, sparking a boom that built the town’s early streets.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.blm.gov/visit/lake-valley-historic-townsite",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town’s railroad spur, built in 1884 by the Atchison, Topeka, and Santa Fe Railway, hauled supplies in and ore out.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.newmexico.org/places-to-visit/scenic-byways/lake-valley-back-country/",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The BLM restored Lake Valley’s historic schoolhouse and chapel, offering a glimpse into rural early‑20th‑century education.",
      "sourceSentenceIds": [
        11,
        12
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.blm.gov/visit/lake-valley-historic-townsite",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "A self‑guided interpretive walking tour lets visitors stroll through tree‑lined streets lined with late‑1800s buildings.",
      "sourceSentenceIds": [
        14,
        22
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.newmexico.org/places-to-visit/scenic-byways/lake-valley-back-country/",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Lake Valley’s last residents left for Deming in 1994, leaving the town a true ghost town today.",
