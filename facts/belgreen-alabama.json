    },
    {
      "id": 2,
      "text": "Belgreen served as Franklin County's seat from 1878 until 1891 before the seat moved back to Russellville.",
      "sourceSentenceIds": [
        18,
        26
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Belgreen%2C_Alabama"
    },
    {
      "id": 3,
      "text": "A courthouse built in 1879 on the site of today’s Belgreen High School burned in 1890, prompting the county seat’s return to Russellville.",
      "sourceSentenceIds": [
        27,
        28
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Belgreen%2C_Alabama"
    },
    {
      "id": 4,
      "text": "The Franklin County Career Technical Center now occupies the former courthouse and jail site that once housed the county’s judicial buildings.",
