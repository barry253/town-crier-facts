  "facts": [
    {
      "id": 1,
      "text": "Lee Center was originally called \"Lee Centre\" until the U.S. Post Office standardized the spelling in 1920.",
      "sourceSentenceIds": [
        3,
        20
      ],
      "sourceLabels": [
        "Web source 2",
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/lee_center_new_york",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Canada Creek runs through Lee Center, powering early mills and shaping its development as a milling and agricultural hub.",
      "sourceSentenceIds": [
        8,
        19,
        28
      ],
      "sourceLabels": [
        "Web source 2",
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/lee_center_new_york",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The village’s first saw mill, built in 1796 by John Hall and Smith Miller on Canada Creek, was the second saw mill in the Town of Lee.",
      "sourceSentenceIds": [
        28
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://oneida.nygenweb.net/towns/lee/leecenterhistory.html",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "A grist mill on Canada Creek was built in 1798 by Scottish brothers Thomas and William Forfar, followed by Ezra Hovey’s mill in the early 1820s.",
      "sourceSentenceIds": [
        29,
        30
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://oneida.nygenweb.net/towns/lee/leecenterhistory.html",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Lee Center’s historic United Methodist Church was dedicated in 1877 and rebuilt in 1936 after a fire.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/lee_center_new_york",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The local Star Spring supplied fresh water to Main Street until the 1960s, before switching to Rome’s municipal supply.",
      "sourceSentenceIds": [
        10,
        16
      ],
