    },
    {
      "id": 2,
      "text": "During the Civil War, the avenue briefly bore names like Russia Avenue, Soviet Union Avenue, and José Antonio Avenue.",
      "sourceSentenceIds": [
        2,
        3,
        4
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Gran_V%C3%ADa%2C_Madrid"
    },
    {
      "id": 3,
      "text": "Gran Vía’s irregular path was a compromise to preserve three religious sites, making its layout less regular.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.esmadrid.com/en/tourist-information/la-gran-via"
    },
    {
      "id": 4,
      "text": "The avenue showcases landmark buildings such as the Metrópolis, Telefónica, Casino, Capitol, and Callao cinemas.",
      "sourceSentenceIds": [
        13
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.esmadrid.com/en/tourist-information/la-gran-via"
    },
    {
      "id": 5,
      "text": "Puerta del Sol, a major transport hub, anchors Gran Vía’s eastern end, turning the street into a linear showcase of shops and theatres.",
