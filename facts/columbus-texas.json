    {
      "id": 1,
      "text": "Columbus was renamed in 1835 after Columbus, Ohio, per Web source 1 id6.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.tshaonline.org/handbook/entries/columbus-tx",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town began as Beeson's Ferry across the Colorado River, operated by Benjamin Beeson, Web source 1 id5.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.tshaonline.org/handbook/entries/columbus-tx",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "A 1840 German cigar factory was Columbus’s first major industry, later replaced by cotton, Web source 1 id8-9.",
      "sourceSentenceIds": [
        8,
        9
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.tshaonline.org/handbook/entries/columbus-tx",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The Colorado County Courthouse, listed on the National Register, sits in Columbus and was renovated 2013‑14, Wikipedia id10-14.",
      "sourceSentenceIds": [
        10,
        14
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Columbus%2C_Texas",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Columbus hosts a Santa Claus museum, a quirky cultural spot unique to the town, Wikipedia id22.",
      "sourceSentenceIds": [
        22
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Columbus%2C_Texas",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The Alley Log Cabin and Tool Museum preserves an 1830s log cabin, now a museum, Wikipedia id15-24.",
