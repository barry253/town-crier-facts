      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Fisgard Lighthouse, built in 1860, is Canada’s oldest operational lighthouse and a National Historic Site.",
      "sourceSentenceIds": [
        29,
