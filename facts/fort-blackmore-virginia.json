  "facts": [
    {
      "id": 1,
      "text": "Fort Blackmore was originally called Blackmore's Fort, built in 1774 during Lord Dunmore's War on the Clinch River.",
      "sourceSentenceIds": [
        1,
        2,
        3
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://fortwiki.com/Fort_Blackmore"
    },
    {
      "id": 2,
      "text": "The fort sat on an elevated flood plain north of the Clinch, opposite the mouth of Rock Branch, a strategic spot for early settlers.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://appalachianhistorian.org/fort-blackmore-scott-county-stony-creek-daniel-boone-and-the-lower-clinch-frontier/"
    },
    {
      "id": 3,
      "text": "John Blackmore, a settler who claimed 518 acres in 1773, gave the fort its name; his land survey was recorded March 25, 1774.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://appalachianhistorian.org/fort-blackmore-scott-county-stony-creek-daniel-boone-and-the-lower-clinch-frontier/"
    },
    {
      "id": 4,
      "text": "Daniel Boone commanded Fort Blackmore during Dunmore’s War, leading scouts and 26 men in the 1774 attack that killed Deal Carter.",
      "sourceSentenceIds": [
        8,
        10
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://appalachianhistorian.org/fort-blackmore-scott-county-stony-creek-daniel-boone-and-the-lower-clinch-frontier/"
    },
    {
      "id": 5,
      "text": "The fort was the lowest Clinch River post, located at Stony Creek’s mouth, as noted in the Draper Manuscripts.",
      "sourceSentenceIds": [
        25
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://appalachianhistorian.org/fort-blackmore-scott-county-stony-creek-daniel-boone-and-the-lower-clinch-frontier/"
    },
    {
      "id": 6,
      "text": "Today, the unincorporated community of Fort Blackmore lies on VA State Route 65, 7.6 miles west-southwest of Dungannon.",
      "sourceSentenceIds": [
        19,
        20
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Fort_Blackmore%2C_Virginia"
    }
  ]
