      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The borough’s roots trace back to the late 19th‑century timber and tanning boom that helped it incorporate in 1888.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 2"
      ],
