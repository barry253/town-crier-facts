  "facts": [
    {
      "id": 1,
      "text": "Hardy, Montana earned its name from early settler Rufus Hardy, who arrived in 1866 and helped pioneer the west side of the Missouri River.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.mtmemory.org/nodes/view/128827",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Actor Gary Cooper’s father owned a ranch near Hardy, and the 1987 film The Untouchables filmed a gun battle on the town’s bridge.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.mtmemory.org/nodes/view/128827",
      "category": "people",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The Hardy Bridge spans the Missouri River in the town’s southern part, once carrying the former U.S. highway route.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Hardy%2C_Montana",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Hardy sits in the southwest corner of Cascade County, where the Missouri River exits a canyon through the Adel Mountains Volcanic Field.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Hardy%2C_Montana",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "A post office operated in Hardy from 1888 until 1915, marking the town’s early communication hub.",
      "sourceSentenceIds": [
        13
      ],
      "sourceLabels": [
