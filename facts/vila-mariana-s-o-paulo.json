      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Vila_Mariana_(district_of_S%C3%A3o_Paulo)",
      "category": "other",
      "quality": "poor",
      "qualityReason": "location_description"
    },
    {
      "id": 2,
      "text": "Vila Mariana borders Moema, Jardim Paulista, and Ipiranga, and hosts landmarks like Ibirapuera Park and the Monumento às Bandeiras.",
      "sourceSentenceIds": [
        20
      ],
      "sourceLabels": [
