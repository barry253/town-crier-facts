      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Before the 1900s, the district was a stop for chariots and horse riders traveling to Jabaquara from downtown São Paulo.",
      "sourceSentenceIds": [
        21
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Vila_Mariana_(district_of_S%C3%A3o_Paulo)",
