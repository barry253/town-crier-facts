  "facts": [
    {
      "id": 1,
      "text": "Canyon’s name comes from its position in the upper canyon of San Leandro Creek on the eastern slope of the Berkeley Hills.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
