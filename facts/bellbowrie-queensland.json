  "facts": [
    {
      "id": 1,
      "text": "The name Bellbowrie is an Aboriginal word (possibly from the Hunter River area in New South Wales) meaning \"flowering gum\", possibly referring to the red gum.",
      "sourceSentenceIds": [
        20
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Bellbowrie%2C_Queensland",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Bellbowrie sits on the northern side of the Brisbane River, about 17 kilometres west‑southwest of Brisbane’s city centre.",
      "sourceSentenceIds": [
        13,
        14
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Bellbowrie%2C_Queensland",
      "category": "other",
      "quality": "poor",
      "qualityReason": "location_description"
    },
    {
      "id": 3,
      "text": "The 1974 Brisbane flood inundated Bellbowrie’s lower areas, and the 2011 floods again raised the river, affecting small parts of the suburb.",
      "sourceSentenceIds": [
        25,
        30
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Bellbowrie%2C_Queensland",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Since the Wivenhoe Dam’s 1980s construction, flood fears eased and Bellbowrie’s development accelerated.",
      "sourceSentenceIds": [
        26
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Bellbowrie%2C_Queensland",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Bellbowrie’s first subdivision occurred in 1972, and its boundaries expanded in 1990 to include former Anstead land.",
      "sourceSentenceIds": [
        24,
        28
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Bellbowrie%2C_Queensland",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Nearly 97% of Bellbowrie’s 1,853 dwellings are detached houses, with townhouses and apartments making up less than 3%.",
