  "facts": [
    {
      "id": 1,
      "text": "Verde Village means \"green village,\" a nod to the lush landscapes along the Verde River.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.wisdomlib.org/cities/verde-village-34223",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The community began in 1970 with just eight units, designed as a retirement enclave.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Verde_Village%2C_Arizona",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Roughly two‑thirds of its residents are retired, making it a bedroom community for nearby Cottonwood.",
      "sourceSentenceIds": [
        9,
        11
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Verde_Village%2C_Arizona",
      "category": "people",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Ancient ruins in the valley offer a glimpse into the long‑standing history of indigenous peoples.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://arizonacityliving.com/city/verde-village-az/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The flowing Verde River winds through the valley, sustaining a diverse ecosystem and striking red‑rock scenery.",
      "sourceSentenceIds": [
        29
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.wisdomlib.org/cities/verde-village-34223",
      "category": "nature",
      "quality": "good"
    },
    {
