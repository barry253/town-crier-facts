      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The valley was once a Maidu summer camp and later a Gold Rush mining camp that vanished before 1900, yet gold mines still operate nearby.",
      "sourceSentenceIds": [
        12,
        13,
        14
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Little_Grass_Valley%2C_California",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The 1942 Del Oro Theatre on Mill Street still shows movies and boasts a 70‑foot art‑deco tower.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
