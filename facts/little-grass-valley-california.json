      ],
      "source": "https://www.visitcalifornia.com/places-to-visit/grass-valley/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Empire Mine State Historic Park, just outside town, extracted an estimated $8 billion of gold between 1850 and 1956.",
