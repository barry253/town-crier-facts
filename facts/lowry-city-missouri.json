  "facts": [
    {
      "id": 1,
      "text": "Lowry City was platted in March 1871 by John Hancock, who named it after a businessman he had worked for in Indiana.",
      "sourceSentenceIds": [
        3,
        4
      ],
      "sourceLabels": [
        "Web source 1",
        "Web source 2"
      ],
      "source": "https://lowrycitymo.gov/",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town sprang up along the C & M Branch of the Tebo and Neosho Railroad, linking Clinton and Osceola.",
      "sourceSentenceIds": [
        1,
        6
      ],
      "sourceLabels": [
        "Web source 2",
        "Wikipedia"
      ],
      "source": "https://ozarks-history.blogspot.com/2025/12/lowry-city.html",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "By late 1871 the fledgling town boasted two physicians, two dentists, and about twenty businesses, a rapid boom for a new settlement.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://ozarks-history.blogspot.com/2025/12/lowry-city.html",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Lowry City sits where the Ozark Mountains meet the Great Plains, a geographic crossroads that shaped its early economy.",
