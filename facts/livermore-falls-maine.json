  "facts": [
    {
      "id": 1,
      "text": "On March 15, 1929, East Livermore officially became Livermore Falls, marking the town’s modern name.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Livermore_Falls%2C_Maine",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Settled in 1786 and incorporated in 1795 as Livermore, the town honors Deacon Elijah Livermore, one of its first English settlers.",
      "sourceSentenceIds": [
        18
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Livermore_Falls%2C_Maine",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The Abenaki called the area Rockemeka, meaning “great corn place,” before English settlers arrived in 1795.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://travelmaine.com/jay-livermore-falls-maine/",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "When the Androscoggin Railroad arrived in 1852, Livermore Falls blossomed into a thriving mill town.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Livermore_Falls%2C_Maine",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Founded in 2002, Maine’s Paper and Heritage Museum chronicles the rise and fall of paper‑making towns along the Androscoggin River.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://travelmaine.com/jay-livermore-falls-maine/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "In 1897, the Third Bridge spanned the Androscoggin River, stretching 800 feet and becoming New England’s longest single‑span bridge at the time.",
