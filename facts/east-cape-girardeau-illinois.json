  "facts": [
    {
      "id": 1,
      "text": "East Cape Girardeau’s post office opened in 1874 and stayed open until 1913, marking the village’s early communication hub.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/East_Cape_Girardeau%2C_Illinois",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The village earned its name by lying just east of Cape Girardeau, Missouri, across the Mississippi River.",
      "sourceSentenceIds": [
        8,
        10
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/East_Cape_Girardeau%2C_Illinois",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "East Cape Girardeau sits directly across the Mississippi River from Cape Girardeau, Missouri, making the river a defining feature.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/East_Cape_Girardeau%2C_Illinois",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The Bill Emerson Memorial Bridge, opened in December 2003, now links East Cape Girardeau to its Missouri neighbor, replacing a 1928 bridge.",
      "sourceSentenceIds": [
        11
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/East_Cape_Girardeau%2C_Illinois",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "East Cape Girardeau is part of the Cape Girardeau–Jackson metropolitan area, which spans both sides of the Mississippi River.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
