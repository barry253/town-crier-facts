  "facts": [
    {
      "id": 1,
      "text": "Akihabara takes its name from the Akiba Shrine, erected after a 1869 fire, and was later shortened to Akihabara.",
      "sourceSentenceIds": [
        4,
        5
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Akihabara",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "In the 1950s, the district specialized in household appliances like washing machines and televisions, cementing its Electric Town status.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Akihabara",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The 1980s saw a shift to home computers, drawing hobbyists who became the first otaku crowd that now defines Akihabara.",
      "sourceSentenceIds": [
        26,
        27,
        28,
        29
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Akihabara",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Radio Kaikan, rebuilt in 2014, remains Akihabara's landmark with ten floors dedicated to anime and manga shops.",
      "sourceSentenceIds": [
        19
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://japan-trails.com/media/akihabara-tokyo-complete-guide/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Yodobashi Camera, a nine‑story electronics megastore, sits directly beside Akihabara Station and draws tech enthusiasts.",
