      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The Grand Trunk Pacific Railway arrived in 1908, building a station south of Baseline that turned the town into a busy grain‑trading center.",
      "sourceSentenceIds": [
        12,
        19
      ],
      "sourceLabels": [
        "Web source 1",
