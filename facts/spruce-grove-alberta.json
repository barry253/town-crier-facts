      ],
      "source": "https://www.sprucegrove.org/community/about-spruce-grove/history-of-spruce-grove/",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Spruce Grove became a village in 1907, dissolved in 1916, then re‑incorporated in 1955, became a town in 1971 and a city in 1986.",
      "sourceSentenceIds": [
        20,
        21
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
