  "facts": [
    {
      "id": 1,
      "text": "Azabu's name means “hemp cloth” and first appeared in 1559 as “阿佐布”, reflecting local hemp production.",
      "sourceSentenceIds": [
        21,
        22
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Azabu",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Zenpuku‑ji Temple, founded in 824 by Kukai, is Tokyo’s second‑oldest temple and once housed the first U.S. legation in the 19th century.",
      "sourceSentenceIds": [
        2,
        4,
        8,
        27
      ],
      "sourceLabels": [
        "Web source 1",
        "Web source 2",
        "Wikipedia"
      ],
      "source": "https://www.japan365days.com/tokyo_azabu.php",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The Juban Inari shrine, built in 712, sits beside Zenpuku‑ji and marks the earliest religious site in Azabu.",
      "sourceSentenceIds": [
        25
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Azabu",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "During the Meiji era, horse‑drawn trams linked Azabu to central Tokyo, foreshadowing the area’s modern transit hub.",
      "sourceSentenceIds": [
        28
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Azabu",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Moto‑Azabu’s Forest Hills Tower, a 29‑floor luxury complex, dominates the skyline near Zenpuku‑ji and reflects contemporary high‑rise development.",
      "sourceSentenceIds": [
        10,
        13
      ],
      "sourceLabels": [
        "Web source 1",
        "Web source 2"
      ],
      "source": "https://www.japan365days.com/tokyo_azabu.php",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Azabu hosts the Tokyo Metropolitan Central Library in Arisugawa‑no‑Miya Memorial Park, a cultural landmark for residents and visitors alike.",
      "sourceSentenceIds": [
        17,
