    {
      "id": 1,
      "text": "Trion earned its name from the three founders of the original cotton mill—Andrew Allgood, Spencer Marsh, and W.K. Briers—who chose “Trion” to honor their partnership.",
      "sourceSentenceIds": [
        12,
        13
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Trion%2C_Georgia",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town’s roots trace back to 1845 when the first cotton mill, later known as the Trion Factory, was officially organized on October 12.",
      "sourceSentenceIds": [
        5,
        11
      ],
      "sourceLabels": [
        "Web source 1",
        "Wikipedia"
      ],
      "source": "https://townoftrion.net/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The Chattooga River winds through Trion, providing a historic waterway that powered the early mills and now offers scenic views for residents.",
      "sourceSentenceIds": [
        18
