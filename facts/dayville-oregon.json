    {
      "id": 1,
      "text": "Dayville was named for the John Day River.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Dayville%2C_Oregon"
    },
    {
      "id": 2,
      "text": "Dayville emerged as a stagecoach stop at the confluence of the John Day River and its South Fork.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/dayville_oregon"
    },
    {
      "id": 3,
      "text": "The town was incorporated in 1913.",
      "sourceSentenceIds": [
        17
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Dayville%2C_Oregon"
    },
    {
      "id": 4,
      "text": "Dayville was once located along the Dalles Military Road, which connected the Columbia River with gold mines near Canyon City.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Dayville%2C_Oregon"
    },
    {
      "id": 5,
      "text": "The original Dayville post office was located three miles west of the city's current site.",
      "sourceSentenceIds": [
        18
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Dayville%2C_Oregon"
    },
    {
      "id": 6,
      "text": "Indigenous peoples, primarily the Northern Paiute and Tenino tribes, inhabited the John Day Valley for thousands of years.",
