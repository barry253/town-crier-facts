  "facts": [
    {
      "id": 1,
      "text": "Cat Spring sprang up in the 1830s, founded by German immigrants from Oldenburg and Westphalia under leaders Ludwig Anton Siegmund von Roeder and Robert J. Kleberg.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Cat_Spring%2C_Texas",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "In 1856, Cat Spring became home to Texas' first agricultural society, a milestone still celebrated today.",
      "sourceSentenceIds": [
        4,
        26
      ],
      "sourceLabels": [
        "Web source 2",
        "Wikipedia"
      ],
      "source": "https://catspringtexas.com/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "By the 1890s, the Missouri‑Kansas‑Texas Railroad ran through Cat Spring, connecting it to New Ulm and Sealy.",
      "sourceSentenceIds": [
        2,
        18
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 2"
      ],
      "source": "https://en.wikipedia.org/wiki/Cat_Spring%2C_Texas",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Cat Spring’s post office began serving residents in 1878, a hub for the small community.",
      "sourceSentenceIds": [
        27
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Cat_Spring%2C_Texas",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Cat Spring lies on the west bank of the San Bernard River, just south of Bellville.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
