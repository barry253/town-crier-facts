  "facts": [
    {
      "id": 1,
      "text": "Fulton was founded in 1866 and named for George Ware Fulton, Sr., who owned 11,000 acres on the Live Oak Peninsula.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Fulton%2C_Texas",
      "category": "people",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The Fulton Mansion, a Recorded Texas Historic Landmark, sits on the resort area of Rockport‑Fulton.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://thc.texas.gov/historic-sites/fulton-mansion",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Archaeologists uncovered possible Karankawan remains in Fulton in 1930, hinting at a prehistoric settlement.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Fulton%2C_Texas",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The Coleman‑Fulton Pasture Company once ranched here, pushing for a deep‑water pass and railroad to market beef.",
      "sourceSentenceIds": [
        11
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.tshaonline.org/handbook/entries/fulton-tx",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Inside the 1877 Fulton Mansion, gas lighting and flush toilets were luxury features ahead of their time.",
      "sourceSentenceIds": [
        21
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://thc.texas.gov/historic-sites/fulton-mansion",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "George Fulton built the grand Fulton Mansion between 1874 and 1876, a centerpiece of the town’s early architecture.",
      "sourceSentenceIds": [
