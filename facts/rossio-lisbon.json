  "facts": [
    {
      "id": 1,
      "text": "Rossio Square, officially Praça de Dom Pedro IV, has been Lisbon’s communal hub since the 13th century, hosting markets, festivals, and royal ceremonies.",
      "sourceSentenceIds": [
        13,
        20
      ],
      "sourceLabels": [
        "Web source 2",
        "Wikipedia"
      ],
      "source": "https://grokipedia.com/page/Rossio",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The square’s central column honors Dom Pedro IV, whose 1874 statue marked the renaming of Rossio to Praça Dom Pedro IV.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/Rossio",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "In 1886–87, architect José Luís Monteiro built the Rossio Train Station, linking the city to the national rail network.",
      "sourceSentenceIds": [
        3,
        15
      ],
      "sourceLabels": [
        "Wikipedia",
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Rossio",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The Hospital Real de Todos os Santos, founded by King John II in 1492 and finished in 1504, once dominated Rossio’s eastern side.",
      "sourceSentenceIds": [
        5,
        28,
        29
      ],
      "sourceLabels": [
        "Web source 2",
        "Wikipedia",
        "Wikipedia"
      ],
      "source": "https://grokipedia.com/page/Rossio",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The Bandeira Arch, a baroque‑style gateway on the square’s south side, was erected during the Pombaline reconstruction after the 1755 earthquake.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Rossio",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Rossio’s name derives from the Portuguese word for “commons,” reflecting its origins as shared open land outside medieval walls.",
      "sourceSentenceIds": [
        24
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Rossio",
