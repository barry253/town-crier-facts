  "facts": [
    {
      "id": 1,
      "text": "Barnum was named after P.T. Barnum, who bought 760 acres in 1878 and platted the subdivision, giving the neighborhood its historic roots.",
      "sourceSentenceIds": [
        15,
        16,
        17
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Barnum%2C_Denver",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The Town of Barnum existed as an independent municipality in 1887 before being annexed by Denver in 1893, a brief but notable chapter in its history.",
      "sourceSentenceIds": [
        20,
        22
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Barnum%2C_Denver",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Barnum began as a 19th‑century Denver suburb that evolved into a haven for working‑class families, shaping its early character.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://extremecommunitymakeover.org/barnum/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Community conflicts were eased by groups like Concerned Citizens of Barnum, which mediated disputes and pushed concerns to City Hall, strengthening local ties.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://history.denverlibrary.org/neighborhood-history-guide/barnum-neighborhood-history",
      "category": "other",
      "quality": "poor",
      "qualityReason": "editorial_filler"
    },
    {
      "id": 6,
      "text": "Barnum’s history is marked by a quiet, century‑long development that never lost its strong sense of community, a legacy still felt today.",
