  "facts": [
    {
      "id": 1,
      "text": "Huntly first appeared on maps as Sandy Hook in 1814, then renamed Huntly when Rappahannock County was formed.",
      "sourceSentenceIds": [
        5,
        11
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/huntly_virginia"
    },
    {
      "id": 2,
      "text": "A post office opened in 1814 at the crossroads that became Huntly, anchoring the community’s early growth.",
      "sourceSentenceIds": [
        11
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/huntly_virginia"
    },
    {
      "id": 3,
      "text": "Construction of the Huntley estate began in 1825, and the property now sits on the National Register of Historic Places.",
      "sourceSentenceIds": [
        14,
        4
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://historichuntley.org/Welcome_to_Huntley.html"
    },
    {
      "id": 4,
      "text": "Huntley was the country home of Thomson Francis Mason, a grandson of Founding Father George Mason.",
      "sourceSentenceIds": [
        7,
        8
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://historichuntley.org/Welcome_to_Huntley.html"
    },
    {
      "id": 5,
      "text": "Nearby Chester Gap, a wind gap in the Blue Ridge Mountains, historically served as a strategic pass for travelers.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/huntly_virginia"
    },
    {
      "id": 6,
      "text": "Huntly experiences a humid subtropical climate with mild winters, warm summers, and four distinct seasons.",
