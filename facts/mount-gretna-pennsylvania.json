  "facts": [
    {
      "id": 1,
      "text": "Mount Gretna’s name first appeared in print on September 21, 1883, after Hugh Maxwell’s wife suggested it in a letter to the Lebanon County Historical Society.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Mount_Gretna%2C_Pennsylvania",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The Pennsylvania Chautauqua Society founded Mount Gretna in the 1890s, drawn by the area’s natural beauty and landscape.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Mount_Gretna%2C_Pennsylvania",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "A narrow‑gauge line built by Robert Coleman carried visitors from the park to Governor Dick Hill, where they could see Lancaster and Harrisburg.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://mtgretna.com/about-gretna/our-history/",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Early visitors enjoyed a carousel, a primitive roller coaster called a switch‑back, and a dancing pavilion inside Mount Gretna’s first amusement park.",
      "sourceSentenceIds": [
        22
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://mtgretna.com/about-gretna/our-history/",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Mount Gretna Playhouse, opened in 1927, hosts one of the country’s oldest summer‑stock theatres, the Gretna Theatre company.",
      "sourceSentenceIds": [
        28
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Mount_Gretna%2C_Pennsylvania",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Each August, Mount Gretna hosts a historic homes and cottages tour on the first Saturday, inviting residents to share their stories.",
