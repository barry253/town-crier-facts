  "facts": [
    {
      "id": 1,
      "text": "Paw Paw’s name comes from the Wyoming Valley in Pennsylvania, where many early settlers originated.",
      "sourceSentenceIds": [
        27
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Paw_Paw%2C_Illinois",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "By 1878, the village finally got a railroad connection, was home to two newspapers, three churches and was christened, officially, as Paw Paw.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Paw_Paw%2C_Illinois",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "In between, you might enjoy viewing some of Paw Paw’s downtown historic commercial and residential landmarks with a self‑guided walking tour sponsored by the Village’s Historical Commission.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.pawpaw.net/about/our-village",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The first stagecoach station, known as a 'Tavern,' was built along Chicago Road and operated by Isaac Balding.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Paw_Paw%2C_Illinois",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "A 2005 federal grant helped Paw Paw construct a water tower, now listed on the National Register of Historic Places.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Paw_Paw%2C_Illinois",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Paw Paw was officially established in 1882 and celebrated its 125th anniversary in 2007.",
