  "facts": [
    {
      "id": 1,
      "text": "Cloudcroft was founded in 1899 as a logging stop on the Alamogordo & Sacramento Mountain Railway, climbing 5,000 feet from the desert floor.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://discovercloudcroft.com/resources/history.html",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Cloudcroft sits at 8,676 feet in Lincoln National Forest, giving it a mild summer climate unlike the surrounding desert.",
      "sourceSentenceIds": [
        18,
        19
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Cloudcroft%2C_New_Mexico",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The historic Lodge, built as an upscale alternative to the original Pavilion, offers panoramic golf views and remains a key landmark.",
