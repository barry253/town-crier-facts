  "facts": [
    {
      "id": 1,
      "text": "Milton was named after Revolutionary War hero John Milton, Georgia’s first Secretary of State.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Milton%2C_Georgia",
      "category": "people",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The area that is now Milton was once part of the Cherokee Nation, covering 120,000 square miles.",
      "sourceSentenceIds": [
        14,
        27
      ],
      "sourceLabels": [
        "Web source 2",
        "Wikipedia"
      ],
      "source": "https://www.miltonhistoricalsociety-georgia.org/history-of-milton.html",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "In 1857 Milton County was created, carved from parts of Cherokee, Forsyth, and Cobb counties.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.miltonga.gov/residents/history",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The county struggled during the Great Depression, boll weevil, and drought, leading to its merger into Fulton County in 1932.",
      "sourceSentenceIds": [
        22
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.miltonhistoricalsociety-georgia.org/history-of-milton.html",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "State Route 400, opened in stages starting 1971, was a major addition before the 1996 Olympics.",
