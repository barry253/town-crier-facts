  "facts": [
    {
      "id": 1,
      "text": "Middletown earned its name as a tavern stop halfway along an old cart road between Appoquinimink Creek and Bohemia Landing.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.middletown.delaware.gov/history-of-middletown"
    },
    {
      "id": 2,
      "text": "The town officially incorporated in 1861, long after its early crossroads origins.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.middletown.delaware.gov/history-of-middletown"
    },
    {
      "id": 3,
      "text": "Middletown sits on the Delmarva Subdivision line of the Delmarva Central Railroad, a historic rail corridor.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Middletown%2C_Delaware"
    },
    {
      "id": 4,
      "text": "The Cochran Square memorial, called “Four Corners,” honors men killed in World War I.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.middletown.delaware.gov/history-of-middletown"
    },
    {
      "id": 5,
      "text": "During the 18th and 19th centuries, Middletown served as a market town for central Delaware’s agricultural hinterland.",
      "sourceSentenceIds": [
        17
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://delaware.wiki/a/Middletown"
    },
    {
      "id": 6,
      "text": "Middletown’s historic streetscape still showcases nineteenth‑century commercial and residential buildings that reflect its past prosperity.",
      "sourceSentenceIds": [
