      "id": 1,
      "text": "Clinton was founded in the 1770s and was originally called Surratt's Villa, a simple crossroads.",
      "sourceSentenceIds": [
        7,
        8
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
