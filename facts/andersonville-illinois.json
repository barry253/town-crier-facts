      ],
      "source": "https://www.nationalgeographic.com/travel/article/discovering-andersonville-chicago-neighbourhood-guide",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Many of Andersonville’s early Swedes were carpenters, contractors and architects who helped build the neighborhood’s distinctive homes.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
