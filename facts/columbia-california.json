  "facts": [
    {
      "id": 1,
      "text": "Founded in 1850 during the Gold Rush, Columbia earned the nickname 'Gem of the Southern Mines'.",
      "sourceSentenceIds": [
        22
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Columbia%2C_California",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Columbia State Historic Park preserves the town’s 19th‑century mining legacy, offering stagecoach rides and gold‑panning demos.",
      "sourceSentenceIds": [
