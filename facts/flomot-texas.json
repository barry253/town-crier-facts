  "facts": [
    {
      "id": 1,
      "text": "Flomot’s name blends Floyd and Motley counties, reflecting its original post office built on the county line in 1902.",
      "sourceSentenceIds": [
        23
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Flomot%2C_Texas",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town sits at the crossroads of Farm Roads 97 and 599, tucked between the North Pease River and Quitaque Creek.",
      "sourceSentenceIds": [
        21
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Flomot%2C_Texas",
      "category": "other",
      "quality": "poor",
      "qualityReason": "location_description"
    },
    {
      "id": 3,
      "text": "By the mid‑1930s, Flomot boasted two cotton gins, two grocery stores, several restaurants, and a service station.",
      "sourceSentenceIds": [
        18
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Flomot%2C_Texas",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The post office opened in 1902, moved to W.R. Smith’s home in 1915, and finally closed on October 31, 2017.",
      "sourceSentenceIds": [
        23,
        25,
        28
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Flomot%2C_Texas",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "After the post office moved, the community began losing businesses and residents to larger cities.",
      "sourceSentenceIds": [
        26
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Flomot%2C_Texas",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Flomot lies roughly 14 miles south of Quitaque and 106 miles southeast of Amarillo, placing it deep in Texas’s Panhandle.",
