    },
    {
      "id": 2,
      "text": "Originally called Bridgetown, the town later became Head of Chester because of its link to the Chester River.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://kentcounty.com/visitors/things_to_do/explore_our_history/driving_tours/millington"
    },
    {
      "id": 3,
      "text": "The Kent and Queen Anne's Railroad reached Millington in the late 1860s, making it one of Kent County’s largest peach shippers.",
      "sourceSentenceIds": [
        6,
        7
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://millingtonmd.us/about-us"
    },
    {
      "id": 4,
      "text": "The John Embert Farm in Millington was listed on the National Register of Historic Places in 1980.",
      "sourceSentenceIds": [
