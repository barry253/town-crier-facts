  "facts": [
    {
      "id": 1,
      "text": "Atwater takes its name from early settler Marshall David Atwater, who arrived in 1855 and owned thousands of acres.",
      "sourceSentenceIds": [
        4,
        5,
        6
      ],
      "sourceLabels": [
        "Web source 1",
        "Web source 2"
      ],
      "source": "https://www.wisdomlib.org/cities/atwater-16329",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The Central Pacific Railroad built a spur line at Atwater Switch in 1872, turning the town into a key wheat shipping hub.",
      "sourceSentenceIds": [
        12,
        19,
        20
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 2"
      ],
      "source": "https://en.wikipedia.org/wiki/Atwater%2C_California",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "By the 1870s, Atwater had become one of the region's largest grain producers, with wheat farming dominating into the early 1900s.",
      "sourceSentenceIds": [
        2,
        7
      ],
      "sourceLabels": [
        "Web source 1",
        "Web source 2"
      ],
      "source": "https://www.wisdomlib.org/cities/atwater-16329",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The town’s growth surged when Castle Air Force Base opened in 1941, employing thousands until its 1995 closure.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/Atwater,_California",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Drought remains a primary hazard, with historic groundwater overdraft shrinking surface water and depleting aquifers.",
      "sourceSentenceIds": [
        17
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/Atwater,_California",
      "category": "nature",
      "quality": "poor",
      "qualityReason": "vague"
    },
    {
