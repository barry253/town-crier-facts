  "facts": [
    {
      "id": 1,
      "text": "Driscoll was founded in 1888 on land donated by siblings Robert Driscoll Jr.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://cityofdriscoll.com/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town was named after Robert Driscoll, even though an earlier town with that name existed and was renamed Alfred.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.tshaonline.org/handbook/entries/driscoll-tx",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The original Driscoll Ranch, owned by Robert and Clara Driscoll, once covered the area that is now the town.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://cityofdriscoll.com/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "A station on the Louis, Brownsville and Mexico Railway was built on ranchland belonging to Robert Driscoll Jr., linking the town to regional trade.",
      "sourceSentenceIds": [
        24
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://cityofdriscoll.com/",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The Driscoll family helped turn the nearby Rabb Pasture into farmland and founded the towns of Bishop and Robstown, cementing their legacy in the region.",
      "sourceSentenceIds": [
        26
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://cityofdriscoll.com/",
      "category": "people",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Two Texas Historical Markers honor Clara Driscoll, recognizing her philanthropic legacy in the state.",
      "sourceSentenceIds": [
        11
