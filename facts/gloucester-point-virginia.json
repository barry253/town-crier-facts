  "facts": [
    {
      "id": 1,
      "text": "Gloucester Point began as Tyndall's Point, renamed by English explorers in the 1600s after the Duke of Gloucester.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Gloucester_Point%2C_Virginia"
    },
    {
      "id": 2,
      "text": "In 1667 the site was fortified as Fort James, later refortified by the British in 1781 during the Siege of Yorktown.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://gloucesterva.gov/museum-of-history/exhibits-events/history-of-gloucester"
    },
    {
      "id": 3,
      "text": "The Visitor Center on Main Street houses the Werowocomoco exhibit, spotlighting the Algonquian capital that once stood nearby.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://gloucesterva.gov/museum-of-history/exhibits-events/history-of-gloucester"
    },
    {
      "id": 4,
      "text": "Gloucester’s prosperity in the late 1600s hinged on tobacco grown by enslaved Africans, shaping the region’s economy.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.va250.org/gloucester-county/"
    },
    {
      "id": 5,
      "text": "The College of William & Mary's Virginia Institute of Marine Science sits in Gloucester Point, advancing oceanographic research.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Gloucester_Point%2C_Virginia"
    },
    {
      "id": 6,
      "text": "Gloucester Point lies on the north bank of the York River, just south of the historic town of Yorktown.",
      "sourceSentenceIds": [
        14
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Gloucester_Point%2C_Virginia"
