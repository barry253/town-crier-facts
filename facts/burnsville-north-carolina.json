    },
    {
      "id": 2,
      "text": "The Yancey County Courthouse, now Burnsville Town Hall, earned a spot on the National Register of Historic Places in 1979.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://townofburnsville.org/history/"
    },
    {
      "id": 3,
      "text": "Originally built in 1908, the Burnsville Town Hall served as Yancey County’s courthouse before becoming the town’s civic center.",
      "sourceSentenceIds": [
        15
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://townofburnsville.org/history/"
    },
    {
      "id": 4,
      "text": "Each August, the Mount Mitchell Arts & Crafts Fair draws more than 200 vendors and performers to historic downtown Burnsville.",
      "sourceSentenceIds": [
