  "facts": [
    {
      "id": 1,
      "text": "Ten Mile Creek is one of the healthiest waterways in the Chesapeake Bay watershed, supporting diverse aquatic life.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.tenmilecreek.org/",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Scientists use Ten Mile Creek as a reference stream to gauge the health of other nearby streams.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.tenmilecreek.org/",
      "category": "other",
      "quality": "poor",
      "qualityReason": "vague"
    },
    {
      "id": 3,
      "text": "It is the cleanest tributary feeding Little Seneca Reservoir, the emergency drinking water supply for 4.3 million DC residents.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.tenmilecreek.org/",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "In 1994, the county declared part of the Ten Mile Creek area a special protection area to preserve its water quality.",
      "sourceSentenceIds": [
        30
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://kids.kiddle.co/Tenmile_Creek_(Maryland)",
      "category": "other",
      "quality": "poor",
      "qualityReason": "vague"
    },
    {
      "id": 5,
      "text": "Ten Mile Creek begins near Thompsons Corner, about two miles northwest of Clarksburg, and flows south for 2.5 miles into Little Seneca Lake.",
      "sourceSentenceIds": [
        14,
