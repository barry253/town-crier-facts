      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Founded as Bright Star in the late 1840s, the town grew around more than 100 natural springs and became Hopkins County seat in 1870.",
      "sourceSentenceIds": [
        2,
        12
      ],
      "sourceLabels": [
        "Web source 2",
