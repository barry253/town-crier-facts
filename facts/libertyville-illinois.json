    {
      "id": 1,
      "text": "Libertyville’s downtown earned a Great American Main Street Award, praised for keeping a tailor, bakery, and vacuum repair shop beside coffee vendors and a microbrewery.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
