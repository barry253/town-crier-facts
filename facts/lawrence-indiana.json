      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The city sits on the northeast side of Indianapolis, just 9 miles southeast of downtown.",
      "sourceSentenceIds": [
        16,
        24
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Lawrence%2C_Indiana",
      "category": "other",
      "quality": "poor",
      "qualityReason": "location_description"
    },
    {
      "id": 3,
      "text": "Route 36, known locally as Pendleton Pike, cuts through Lawrence and leads 22 miles to Pendleton.",
