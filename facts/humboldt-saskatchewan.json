  "facts": [
    {
      "id": 1,
      "text": "Humboldt was named after German scientist Alexander von Humboldt, a world‑famous explorer.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://humboldtmuseum.ca/humboldts-history/"
    },
    {
      "id": 2,
      "text": "The town began as a 1878 telegraph station on the Carlton Trail, a key link during the 1885 Métis resistance.",
      "sourceSentenceIds": [
        3,
        13,
        15,
        18
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 2"
      ],
      "source": "https://en.wikipedia.org/wiki/Humboldt%2C_Saskatchewan"
    },
    {
      "id": 3,
      "text": "In 1885, General Frederick Middleton stationed 950 soldiers at Humboldt, turning the telegraph station into a fortified military encampment.",
      "sourceSentenceIds": [
        14,
        16
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 2"
      ],
      "source": "https://en.wikipedia.org/wiki/Humboldt%2C_Saskatchewan"
    },
    {
      "id": 4,
      "text": "Humboldt’s Post Office, built 1911‑12, is a National Historic Site of Canada.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Humboldt%2C_Saskatchewan"
    },
    {
      "id": 5,
      "text": "Murals in Humboldt’s town centre depict historic scenes, celebrating the city’s heritage.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Humboldt%2C_Saskatchewan"
    },
    {
      "id": 6,
      "text": "Humboldt was the site of Western Canada’s first stagecoach robbery in the late 19th century.",
      "sourceSentenceIds": [
        28
      ],
      "sourceLabels": [
