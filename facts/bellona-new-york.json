  "facts": [
    {
      "id": 1,
      "text": "Bellona was renamed in 1818, possibly after the Roman goddess of war, following a local brawl legend.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/bellona_new_york",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "A free Black man, Joshua Dunbar, helped fund the 1810 Methodist church that served early settlers.",
      "sourceSentenceIds": [
        2,
        11
      ],
      "sourceLabels": [
        "Web source 2",
        "Web source 1"
      ],
      "source": "https://www.fltimes.com/lifestyle/looking-back-bellona-a-little-hamlet-with-a-big-history/article_b7c4b230-a8e3-11ef-b997-e7136cca1377.html",
      "category": "people",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The stone gristmill built around 1828 after a wooden mill burned remains standing as a historic landmark.",
      "sourceSentenceIds": [
        4,
        18
      ],
      "sourceLabels": [
        "Web source 1",
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/bellona_new_york",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Bellona sits in a hollow formed by the confluence of three branches of Kashong Creek, giving it a unique valley setting.",
      "sourceSentenceIds": [
        8,
        19
      ],
      "sourceLabels": [
        "Web source 1",
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/bellona_new_york",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The hamlet’s early economy relied on mills powered by Kashong Creek, including saw and gristmills established by Revolutionary War veteran Caleb Benton.",
      "sourceSentenceIds": [
        24
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/bellona_new_york",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Bellona’s post office opened in 1816, and by the early 19th century the hamlet boasted taverns, inns, a distillery, and two hotels.",
      "sourceSentenceIds": [
        25
      ],
