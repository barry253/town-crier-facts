  "facts": [
    {
      "id": 1,
      "text": "Crown Point sits at 60.42°N, 149.33°W, right where Trail River meets Kenai Lake.",
      "sourceSentenceIds": [
        2,
        20
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Crown_Point%2C_Alaska"
    },
    {
      "id": 2,
      "text": "The community grew from the 19th‑century settlement of Lawing, centered around Alaska Nellie's Homestead.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Crown_Point%2C_Alaska"
    },
    {
      "id": 3,
      "text": "Crown Point first appeared on the 1990 U.S. Census as a census‑designated place.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Crown_Point%2C_Alaska"
    },
    {
      "id": 4,
      "text": "The area covers about 16.25 square miles of land, with less than one square kilometer of water.",
      "sourceSentenceIds": [
        16,
        17
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.usacitiesonline.com/akcountycrownpoint.htm"
    },
    {
      "id": 5,
      "text": "It lies north of Moose Pass and south of Primrose, anchoring the Kenai Peninsula’s north‑central corridor.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Crown_Point%2C_Alaska"
    },
    {
      "id": 6,
      "text": "The town’s coordinates place it roughly 583 miles from Alaska’s capital, Juneau.",
