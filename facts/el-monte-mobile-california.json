  "facts": [
    {
      "id": 1,
      "text": "El Monte’s name comes from Spanish missionaries who called the area “Monte,” meaning meadow.",
      "sourceSentenceIds": [
        1,
        2
      ],
      "sourceLabels": [
        "Web source 1",
        "Web source 2"
