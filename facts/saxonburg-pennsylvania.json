  "facts": [
    {
      "id": 1,
      "text": "Saxonburg was founded in 1832 by Prussian brothers Friedrich Carl and John Augustus Roebling.",
      "sourceSentenceIds": [
        1,
        2
      ],
      "sourceLabels": [
        "Web source 1",
        "Web source 2"
      ],
      "source": "https://www.experiencebutler.com/cities-and-towns/saxonburg/"
    },
    {
      "id": 2,
      "text": "The town’s name shifted from “Germania” to “Sachsenburg” before becoming Saxonburg in the early 19th century.",
      "sourceSentenceIds": [
        27,
        28
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Saxonburg%2C_Pennsylvania"
    },
    {
      "id": 3,
      "text": "John Roebling’s historic home still stands and is listed on the National Register of Historic Places.",
      "sourceSentenceIds": [
        13
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.experiencebutler.com/cities-and-towns/saxonburg/"
    },
    {
      "id": 4,
      "text": "The Saxonburg Historic District, centered on Main Street, earned a spot on the National Register of Historic Places.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.experiencebutler.com/cities-and-towns/saxonburg/"
    },
    {
      "id": 5,
      "text": "Roebling Park showcases a replica of the Brooklyn Bridge, honoring the brothers’ engineering legacy.",
      "sourceSentenceIds": [
        21
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.experiencebutler.com/cities-and-towns/saxonburg/"
    },
    {
      "id": 6,
      "text": "Saxonburg’s first radio station, originally saxonburgradio.com, began local broadcasts for music and news in 2015.",
