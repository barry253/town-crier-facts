      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The 1991 merger of the village with the surrounding township created the modern City of Green, unifying the community.",
      "sourceSentenceIds": [
        30
      ],
      "sourceLabels": [
