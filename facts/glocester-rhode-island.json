  "facts": [
    {
      "id": 1,
      "text": "Glocester was founded in 1639 as Gloucester, just three years after Roger Williams established Providence.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.glocesterri.gov/aboutglocester.htm",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "In 1806 residents changed the spelling from Gloucester to Glocester to avoid confusion with Massachusetts' Gloucester.",
      "sourceSentenceIds": [
        21
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Glocester%2C_Rhode_Island",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Chepachet Village hosts the historic Job Armstrong Store, where visitors can learn Glocester’s past while browsing antiques.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://riroads.com/glocester-ri-travel-guide/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The Brown and Hopkins Country Store, housed in a 1814 stone building in Chepachet, offers two floors of antiques beside the river.",
      "sourceSentenceIds": [
        10,
        11
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://riroads.com/glocester-ri-travel-guide/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Glocester was the birthplace of the Dorr Rebellion, a 1841 movement that challenged Rhode Island’s voting laws.",
      "sourceSentenceIds": [
        25
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Glocester%2C_Rhode_Island",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Since 1927, Chepachet’s Ancient and Horribles Parade has celebrated July Fourth with satirical floats that mock politics.",
      "sourceSentenceIds": [
