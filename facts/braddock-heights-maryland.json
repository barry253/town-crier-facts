  "facts": [
    {
      "id": 1,
      "text": "Braddock Heights began in 1896 as a summer resort, later adding hotels, a pool, skating rink, amusement park, and a ski resort that closed in 1980.",
      "sourceSentenceIds": [
        18
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Braddock_Heights%2C_Maryland"
    },
    {
      "id": 2,
      "text": "The town sits 950 feet above sea level on Braddock Mountain, overlooking the historic Braddock Springs pass used by General Edward Braddock in 1755.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Braddock_Heights%2C_Maryland"
    },
    {
      "id": 3,
      "text": "A trolley from the Frederick & Middletown Railway arrived in 1896, bringing vacationers from Hagerstown to the new resort.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/braddock_heights_maryland"
    },
    {
      "id": 4,
      "text": "Braddock Heights Ski Way operated from 1962 to 1980, offering a few slopes near the historic inn before closing.",
      "sourceSentenceIds": [
        17
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/braddock_heights_maryland"
    },
    {
      "id": 5,
      "text": "The Community Association and Historical Society preserve the town pool and park, hosting events that honor Braddock Heights’ heritage.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Braddock_Heights%2C_Maryland"
    },
    {
      "id": 6,
      "text": "The town’s name honors General Edward Braddock and Lt. Col. George Washington, who crossed Braddock Springs in 1755.",
      "sourceSentenceIds": [
        15
      ],
