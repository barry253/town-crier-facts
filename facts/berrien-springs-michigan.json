  "facts": [
    {
      "id": 1,
      "text": "Berrien Springs earned its name after John M. Berrien, a prominent Michigan figure, and the town’s mineral springs were discovered in the 1800s.",
      "sourceSentenceIds": [
        1,
        19
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Berrien_Springs%2C_Michigan",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The village’s earliest European‑American settlement dates back to 1831, when founder Murdoch built Michigan’s oldest surviving two‑story log house.",
      "sourceSentenceIds": [
        23
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Berrien_Springs%2C_Michigan",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "From 1837 to 1894, Berrien Springs served as the county seat, with the courthouse now housing the Berrien County Historical Association.",
      "sourceSentenceIds": [
        30,
        16
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Berrien_Springs%2C_Michigan",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The historic Courthouse Square hosts the Southwest Michigan History Center, where exhibits bring the region’s past to life for visitors.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://swmichigan.org/plan-and-stay/towns/berrien-springs",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Every year, the Pickle Festival returns to Berrien Springs, a quirky celebration revived in 2021 by the village, BCHA, and the local library.",
