      "quality": "good"
    },
    {
      "id": 2,
      "text": "Before becoming a residential suburb, Wishart was known as Mount Gravatt South and was subdivided as Brisbane expanded.",
      "sourceSentenceIds": [
        14,
        16
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
