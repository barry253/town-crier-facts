  "facts": [
    {
      "id": 1,
      "text": "Otsego’s name comes from a Mohawk word meaning 'meeting place,' echoing the nearby Otsego Lake in New York.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.otsegomn.gov/289/Heritage-Site-Tour"
    },
    {
      "id": 2,
      "text": "Otsego sits where the Mississippi and Crow Rivers meet, a historic confluence that shaped early industry.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Otsego%2C_Minnesota"
    },
    {
      "id": 3,
      "text": "Along the riverbanks, Otsego once hosted lumber mills, grist mills, wagon shops, a chair factory, and even a hoe factory.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.otsegohistory.org/resources"
    },
    {
      "id": 4,
      "text": "The 1855 French House on West Allegan Street displays Greek‑style symbolism, a hallmark of early Otsego architecture.",
