  "facts": [
    {
      "id": 1,
      "text": "Gonzales was founded by Dr. Mariano Gonzalez and his brother Alfredo in 1874 on land originally deeded to their father Teodoro Gonzalez in 1836.",
      "sourceSentenceIds": [
        9,
        28
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://gonzalesca.gov/residents/moving-gonzales/gonzales-history",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town was laid out as a 50‑block grid in 1874, covering about 15,000 acres, and its streets run northeast‑southwest and northwest‑southeast.",
      "sourceSentenceIds": [
        29
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://gonzalesca.gov/residents/moving-gonzales/gonzales-history",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "In 1872 the Southern Pacific Railroad granted a right‑of‑way through Gonzales, and a depot was built to serve freight and passengers.",
      "sourceSentenceIds": [
        10,
        14,
        19
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Gonzales%2C_California",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Swiss immigrants began dairies in the 1890s, shifting the area from cattle and grain raising to dairy farming.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://gonzalesca.gov/residents/moving-gonzales/gonzales-history",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The Theodore Catholic Church, named for Teodoro Gonzales, was constructed in 1883 and remains a historic landmark.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
