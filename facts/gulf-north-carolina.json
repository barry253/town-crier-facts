      ],
      "source": "https://en.wikipedia.org/wiki/Gulf%2C_North_Carolina",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town sits on the north side of the Deep River, right on Chatham County’s southern border.",
      "sourceSentenceIds": [
