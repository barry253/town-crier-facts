  "facts": [
    {
      "id": 1,
      "text": "Estación Central, Santiago’s main railway hub, opened in 1885 and was later redesigned by Gustave Eiffel in 1897.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Central_Station_(Santiago)",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The station’s steel frame was built by the French firm Schneider of Le Creusot, giving it a distinctive industrial look.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Central_Station_(Santiago)",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "In 1983, Estación Central was declared a National Monument, protecting its historic architecture from demolition.",
      "sourceSentenceIds": [
        18,
        20
      ],
      "sourceLabels": [
        "Web source 2",
        "Wikipedia"
      ],
      "source": "https://www.santiagoturismo.cl/en/estacion-central-de-ferrocarriles-2/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The underground Santiago Metro Line 1 station sits directly at Estación Central’s main gates, linking trains to city transit.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Central_Station_(Santiago)",
      "category": "transport",
      "quality": "good"
    },
    {
