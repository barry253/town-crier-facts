  "facts": [
    {
      "id": 1,
      "text": "Bloomfield sits in the rolling Shawnee Hills, where fertile silt loam supports corn, wheat, and fruit farms that have fed the region since the 1800s.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/bloomfield_johnson_county_illinois",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town’s name comes from its central position in Johnson County, a fact noted when Cache Township was renamed Bloomfield in 1819 during a county court session.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/bloomfield_johnson_county_illinois",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Religious roots trace back to 1868 when Pleasant Ridge Presbyterian Church was founded, and 1874 when the Bloomfield Methodist Episcopal Church first met in a schoolhouse.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/bloomfield_johnson_county_illinois",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Early commerce featured a 1875 general store built by Hiram Worley, which originally served as a Grange hall before becoming a local trading hub.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/bloomfield_johnson_county_illinois",
      "category": "people",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Levi Casey, an Irish immigrant from Tennessee, was one of Bloomfield’s first settlers, arriving in 1808 and establishing a homestead near Casey’s Spring, one of the county’s oldest burial sites.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 1"
      ],
