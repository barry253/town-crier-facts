  "facts": [
    {
      "id": 1,
      "text": "Hanover, Pennsylvania, takes its name from the German city of Hanover and serves as a principal city of the York–Hanover metropolitan area.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Hanover%2C_Pennsylvania"
    },
    {
      "id": 2,
      "text": "Richard McAllister bought the land that became Hanover in 1745, divided it into lots, and officially founded the town in 1763.",
      "sourceSentenceIds": [
        6,
        7
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Hanover%2C_Pennsylvania"
    },
    {
      "id": 3,
      "text": "Local settlers once called the area “Hickory Town” because of the thick groves of hickory trees that grew there.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Hanover%2C_Pennsylvania"
    },
    {
      "id": 4,
      "text": "The Hanover Branch Railroad reached Hanover Junction in 1852, and by 1858 the Gettysburg Railroad linked the town westward to Gettysburg.",
      "sourceSentenceIds": [
        13,
        14
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Hanover%2C_Pennsylvania"
    },
    {
      "id": 5,
      "text": "Emeco, founded in 1944 in Hanover, still produces its iconic Navy Chair and other designer furniture.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Hanover%2C_Pennsylvania"
    },
    {
      "id": 6,
      "text": "Visitors can tour the Neas House, the Warehime‑Myers Mansion, and the Hanover Area Historical Society Museum to see 18th‑century Pennsylvania German life.",
      "sourceSentenceIds": [
