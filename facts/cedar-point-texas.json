  "facts": [
    {
      "id": 1,
      "text": "The land at Cedar Point was originally inhabited by the Alabama-Coushatta and other related tribes of the Hasinai Confederacy.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.wikixm.com/us/tx/cedar-point/overview"
    },
    {
      "id": 2,
      "text": "Cedar Point likely gets its name from a sharp bend in the Trinity River densely covered in eastern redcedar trees.",
      "sourceSentenceIds": [
        13
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/cedar_point_texas"
    },
    {
      "id": 3,
      "text": "Early Cedar Point settlers relied on self-sufficient homesteads and used the Trinity River as their primary transportation artery.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/cedar_point_texas"
    },
    {
      "id": 4,
      "text": "The local economy once centered on small farms producing cotton and corn, along with harvesting timber for railroad ties.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.wikixm.com/us/tx/cedar-point/overview"
    },
    {
      "id": 5,
      "text": "Construction of the Livingston Dam between the 1920s and 1960s flooded large portions of the original Cedar Point town site.",
      "sourceSentenceIds": [
        7,
        8
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.wikixm.com/us/tx/cedar-point/overview"
    },
    {
      "id": 6,
      "text": "Cedar Point is now a residential enclave defined by the expansive waters of Lake Livingston and the surrounding Piney Woods.",
      "sourceSentenceIds": [
        23,
        25
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.wikixm.com/us/tx/cedar-point/overview"
    }
  ]
