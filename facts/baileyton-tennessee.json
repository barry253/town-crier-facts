      "id": 1,
      "text": "Baileyton was first settled in 1776 and was originally called Laurel Gap.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Baileyton%2C_Tennessee",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "From 1892 to 1915 the town was named Bailey Town before becoming Baileyton.",
      "sourceSentenceIds": [
        13
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Baileyton%2C_Tennessee",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Baileyton sits at the base of a rugged area just south of the Hawkins County line, near Bays Mountain.",
      "sourceSentenceIds": [
        15,
        16
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Baileyton%2C_Tennessee",
      "category": "nature",
      "quality": "poor",
      "qualityReason": "location_description"
    },
    {
      "id": 4,
      "text": "Gardner Creek and Hughes Branch drain Baileyton, feeding Lick Creek, a tributary of the Nolichucky River.",
      "sourceSentenceIds": [
        17
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Baileyton%2C_Tennessee",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Baileyton has no post office; the nearest one is in Greeneville.",
