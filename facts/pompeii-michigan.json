  "facts": [
    {
      "id": 1,
      "text": "Pompeii sits about four miles east of Perrinton, straddling the border with Washington Township at 43°11′02″N 84°36′03″W.",
      "sourceSentenceIds": [
        14
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Fulton_Township%2C_Michigan"
    },
    {
      "id": 2,
      "text": "Michigan’s Pompeii earned its nickname after the town of Singapore was swallowed by shifting sand, leaving no visible ruins.",
      "sourceSentenceIds": [
        23,
        25
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://myfamilytravels.com/michigans-pompeii-the-ghost-town-swallowed-by-sand/"
    },
    {
      "id": 3,
      "text": "Sand dunes in the area can advance up to ten feet per year, a pace that once buried an entire community.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://myfamilytravels.com/michigans-pompeii-the-ghost-town-swallowed-by-sand/"
    },
    {
      "id": 4,
      "text": "Singapore once boasted sawmills, family homes, a general store, and even a bank before the dunes claimed it.",
      "sourceSentenceIds": [
        27
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://myfamilytravels.com/michigans-pompeii-the-ghost-town-swallowed-by-sand/"
    },
    {
      "id": 5,
      "text": "Unlike typical archaeological sites, the buried town remains hidden beneath tons of sand, with no exposed structures to explore.",
      "sourceSentenceIds": [
        28,
        29
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://myfamilytravels.com/michigans-pompeii-the-ghost-town-swallowed-by-sand/"
    },
    {
      "id": 6,
      "text": "The story of Pompeii shows how deforestation removed natural barriers that once held back the dunes, turning a thriving lumber town into a buried ghost.",
      "sourceSentenceIds": [
        7,
        5
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://myfamilytravels.com/michigans-pompeii-the-ghost-town-swallowed-by-sand/"
