  "facts": [
    {
      "id": 1,
      "text": "Garyville was founded in 1906 as a company town by the Godchaux Sugar Refinery, which remains a major employer and landmark in the area.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.trawellino.com/destinations/united-states/louisiana_garyville",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Garyville once led the world in lumber production and attracted many Italian and Sicilian immigrants, becoming one of the largest Sicilian communities outside New Orleans and Baton Rouge.",
      "sourceSentenceIds": [
        28
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://lariverparishes.com/history-lumber-italians/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The Garyville Historic District features the Timbermill Museum, the historic Gary State Bank, and the long‑standing Garyville General Store.",
      "sourceSentenceIds": [
        30
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://lariverparishes.com/history-lumber-italians/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "San Francisco Plantation, located in Garyville, is considered the most opulent plantation house in North America.",
      "sourceSentenceIds": [
        30
