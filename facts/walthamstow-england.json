    {
      "id": 1,
      "text": "William Morris, the Arts and Crafts designer, was born in Walthamstow in 1834.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Walthamstow",
      "category": "people",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "In 1885, John Kemp Starley from Walthamstow designed the first modern bicycle, and in 1892 Frederick Bremer built a British motorcar in a garden workshop on Connaught Road.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Walthamstow",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The historic central library on High Street was funded by Andrew Carnegie and still bears his bust on its exterior.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Walthamstow",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Walthamstow Stadium, once a greyhound racing landmark, is now a focal point of regeneration projects like The Scene cinema complex.",
      "sourceSentenceIds": [
        15,
        28
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 2"
      ],
      "source": "https://en.wikipedia.org/wiki/Walthamstow",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Walthamstow Central and Blackhorse Road stations connect the town to the Victoria line, making it a key hub on the London Underground.",
      "sourceSentenceIds": [
        29
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Walthamstow",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The area’s early history dates back to Roman times when a settlement was established along the River Lea.",
