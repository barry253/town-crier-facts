  "facts": [
    {
      "id": 1,
      "text": "Parramatta was founded in 1788 as the second European settlement in Australia, making it the oldest inland settlement.",
      "sourceSentenceIds": [
        25
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Parramatta",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The name Parramatta comes from the Aboriginal word meaning “head of waters,” adopted after the town was renamed in 1791.",
      "sourceSentenceIds": [
        11
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.britannica.com/place/Parramatta",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Elizabeth Farm, built in 1793, is the oldest surviving home in Australia and sits on the Parramatta River.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.britannica.com/place/Parramatta",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The Old Government House, opened in 1799, is Australia’s oldest public building and part of a UNESCO World Heritage site.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.britannica.com/place/Parramatta",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The historic St Patrick’s Cemetery in North Parramatta dates back to the early 19th century and is a key heritage site.",
      "sourceSentenceIds": [
        20
