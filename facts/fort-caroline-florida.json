  "facts": [
    {
      "id": 1,
      "text": "Fort Caroline was founded by French explorer René Goulaine de Laudonnière on June 22, 1564, and named after King Charles IX.",
      "sourceSentenceIds": [
        3,
        4
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Fort_Caroline"
    },
    {
      "id": 2,
      "text": "Spanish forces under Pedro Menéndez destroyed Fort Caroline in 1565, ending the French colony after a year of conflict.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Fort_Caroline"
    },
    {
      "id": 3,
      "text": "Today the memorial features a reconstructed fort exhibit where visitors learn about the Timucua people and early colonial conflict.",
      "sourceSentenceIds": [
        11
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.floridavisiting.com/places/fort-caroline-national-memorial/"
    },
    {
      "id": 4,
      "text": "Ranger‑led programs at the memorial explore exploration, conflict, cultural exchange, and Florida history through talks and guided walks.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.floridavisiting.com/places/fort-caroline-national-memorial/"
    },
    {
      "id": 5,
      "text": "Kingsley Plantation, part of the preserve, offers exhibits that explore plantation life and regional history.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.floridavisiting.com/places/fort-caroline-national-memorial/"
    },
    {
      "id": 6,
      "text": "The site sits on the Johns River, where scenic overlooks and nature trails let visitors spot birds and other wildlife.",
