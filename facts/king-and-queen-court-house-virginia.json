  "facts": [
    {
      "id": 1,
      "text": "King and Queen Courthouse, built around 1750, survived a Union fire in 1864, was repaired, and remains in service today.",
      "sourceSentenceIds": [
        14,
        15
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/King_and_Queen_Court_House%2C_Virginia",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The Fairy Tavern, the district’s oldest building, was spared during the Civil War and now houses a museum that opened in May 2001.",
      "sourceSentenceIds": [
        21,
        2,
        30
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 2"
      ],
      "source": "https://en.wikipedia.org/wiki/King_and_Queen_Court_House%2C_Virginia",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The courthouse green historic district contains 17 buildings, including an 1860s clerk’s office, a jail, and a Confederate monument.",
      "sourceSentenceIds": [
        18
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.dhr.virginia.gov/historic-registers/049-5001/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "A courthouse first appeared at this site in 1691, making it one of Virginia’s earliest county seats.",
      "sourceSentenceIds": [
        19
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.dhr.virginia.gov/historic-registers/049-5001/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The Courthouse Tavern Museum was restored in 1999 with matching state grants and the Jessie Ball duPont Fund.",
      "sourceSentenceIds": [
        5
