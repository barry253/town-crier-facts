  "facts": [
    {
      "id": 1,
      "text": "La Bajada means \"the descent\" in Spanish, a nod to its steep volcanic escarpment.",
      "sourceSentenceIds": [
        18
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/La_Bajada%2C_New_Mexico",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "La Bajada Mesa preserves some of the oldest El Camino Real tracks, still visible as rutted paths across the volcanic plain.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.nps.gov/articles/000/new-mexico-la-bajada-mesa.htm",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The volcanic escarpment of La Bajada Mesa towers 600 feet above the windswept plains below.",
      "sourceSentenceIds": [
        13
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.nps.gov/articles/000/new-mexico-la-bajada-mesa.htm",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "A 16th‑century settlement beside the Santa Fe River sat near an abandoned pueblo still occupied when Oñate arrived in 1598.",
      "sourceSentenceIds": [
        14
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.nps.gov/articles/000/new-mexico-la-bajada-mesa.htm",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "La Bajada’s post office opened in 1870 but closed just two years later in 1872.",
      "sourceSentenceIds": [
        17
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/La_Bajada%2C_New_Mexico",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "When the railroad arrived in 1881, El Camino Real fell out of use, yet La Bajada Mesa stayed a key travel route.",
