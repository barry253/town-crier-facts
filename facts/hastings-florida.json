  "facts": [
    {
      "id": 1,
      "text": "Hastings was founded in the 1890s as a railroad‑oriented farming community built to supply potatoes to Henry Flagler’s resort hotels in St. Augustine.",
      "sourceSentenceIds": [
        12,
        20
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.hastingsfl.org/history/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town earned the nickname “Potato Capital of Florida” after cultivating 21,000 acres of potatoes, while also growing cabbage, onions, eggplant, and ornamental plants.",
      "sourceSentenceIds": [
        21
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Hastings%2C_Florida",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Hastings dissolved its incorporated status in 2018 after an 82% majority vote, and Johns County officially took control on March 1, 2018.",
      "sourceSentenceIds": [
        29,
        30
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Hastings%2C_Florida",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Today, Hastings hosts the Field to Fork food exhibit, celebrating its agricultural roots and continuing to showcase local potato and vegetable production.",
