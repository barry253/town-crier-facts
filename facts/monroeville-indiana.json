      "id": 1,
      "text": "Monroeville was platted in 1851, the same year its founders laid out the town’s streets and lots.",
      "sourceSentenceIds": [
        28
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Monroeville%2C_Indiana",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town incorporated in July 1866, giving it official municipal status after fifteen years of growth.",
      "sourceSentenceIds": [
        30
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Monroeville%2C_Indiana",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "A post office opened in 1856, connecting Monroeville to the wider world of mail and commerce.",
      "sourceSentenceIds": [
        29
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Monroeville%2C_Indiana",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Monroeville takes its name from Monroe Township, reflecting the region’s early settlers’ admiration for President James Monroe.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Monroeville%2C_Indiana",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The town’s public library, a branch of the Allen County Public Library, has served residents since its opening in 1964.",
