      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The Scullin Mansion, built by John Scullin in 1899, once boasted a 25‑room estate with a gasoline‑powered generator and a tennis court.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Web source 1"
