      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Helena sits on the south bank of the St. Lawrence River, where the Regis River drops from rapids into calmer waters.",
      "sourceSentenceIds": [
        7,
        21
      ],
      "sourceLabels": [
        "Web source 1"
      ],
