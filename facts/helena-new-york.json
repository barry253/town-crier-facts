      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Lavair’s Garage, originally a general store, became a community hub for dances and auto repairs from 1920 until 2000.",
      "sourceSentenceIds": [
        30
      ],
      "sourceLabels": [
        "Web source 1"
      ],
