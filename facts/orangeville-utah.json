  "facts": [
    {
      "id": 1,
      "text": "Orangeville was founded in 1878 and was originally known as Upper Castle Dale.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Orangeville%2C_Utah"
    },
    {
      "id": 2,
      "text": "In 1879 a post office was established and the town was renamed Orangeville after pioneer Orange Seely, the first settler of Castle Valley.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Orangeville%2C_Utah"
    },
    {
      "id": 3,
      "text": "Orangeville sits on Cottonwood Creek, straddling the banks at the junction of State Routes 29 and 57.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Orangeville%2C_Utah"
    },
    {
      "id": 4,
      "text": "The town lies just 2 miles west of Castle Dale, the Emery County seat.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Orangeville%2C_Utah"
    },
    {
      "id": 5,
      "text": "Orangeville borders the Manti-La Sal National Forest, offering easy access to backcountry trails.",
      "sourceSentenceIds": [
        7
