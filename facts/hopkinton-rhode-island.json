  "facts": [
    {
      "id": 1,
      "text": "Hopkinton was carved out of Westerly on March 14, 1757, when 42 square miles became the town’s first official boundaries.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://hopkintonhistorical.org/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town’s name honors Stephen Hopkins, a signer of the Declaration of Independence who served as Rhode Island’s governor when Hopkinton was incorporated.",
      "sourceSentenceIds": [
        3,
        5
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Hopkinton%2C_Rhode_Island",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Hopkinton’s historic downtown is listed on the National Register of Historic Places, a fact that fuels its charm for visitors and locals alike.",
      "sourceSentenceIds": [
        15
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.islands.com/1976989/hopkinton-rhode-island-favorite-small-town-historic-treasure-beaches-birdwatching-miles-trails/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The Canonchet Trail in Canonchet Brook Preserve offers hikers scenic views while tracing the town’s mill‑era history along the river.",
      "sourceSentenceIds": [
        16
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.islands.com/1976989/hopkinton-rhode-island-favorite-small-town-historic-treasure-beaches-birdwatching-miles-trails/",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The Hopkinton Historical Association gathers forgotten artifacts from attics and storage boxes, bringing the town’s long‑forgotten past into the light of today.",
      "sourceSentenceIds": [
        8
      ],
