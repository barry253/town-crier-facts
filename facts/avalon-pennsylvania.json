  "facts": [
    {
      "id": 1,
      "text": "Avalon earned its name from the legendary island of Avalon, a nod to the many apple orchards that once dotted the area.",
      "sourceSentenceIds": [
        7,
        9
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 2"
      ],
      "source": "https://en.wikipedia.org/wiki/Avalon%2C_Pennsylvania",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "On December 9 1874, 29 property owners met to separate from Kilbuck Township, sparking Avalon’s quest for independence.",
      "sourceSentenceIds": [
        13
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Avalon%2C_Pennsylvania",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Noah Shafer drafted Avalon’s incorporation petition, later becoming West Bellevue’s first solicitor.",
      "sourceSentenceIds": [
        15
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Avalon%2C_Pennsylvania",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The first election on December 26 1874 elected James Semple as burgess, a role he would hold three times.",
      "sourceSentenceIds": [
        17,
        18
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Avalon%2C_Pennsylvania",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Around 1900, a streetcar arrived, linking Avalon to Pittsburgh via routes 14 Avalon and later 6/14 Brighton Avalon.",
      "sourceSentenceIds": [
        21
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Avalon%2C_Pennsylvania",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Situated 6 miles downstream from Pittsburgh on the Ohio River, Avalon sits at an elevation of 932 feet above sea level.",
