  "facts": [
    {
      "id": 1,
      "text": "Syntagma Square’s name means ‘Constitution’ and honors the 1843 uprising that forced King Otto to grant a national constitution.",
      "sourceSentenceIds": [
        1,
        8
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Syntagma_Square",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Every day at 11 a.m., a ceremonial guard change with 120 Evzones and an army band takes place outside the Greek Parliament.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Syntagma_Square",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Syntagma Square serves as a major bus hub, linking Athens to northern suburbs and the Olympic Complex in Maroussi.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Syntagma_Square",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Beneath the square, metro lines 2 and 3 intersect, making the Syntagma station one of Greece’s busiest transport hubs.",
      "sourceSentenceIds": [
        19
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Syntagma_Square",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "During the 1990s metro construction, ancient foundations were uncovered and now a display of these artifacts sits in the Syntagma station.",
      "sourceSentenceIds": [
        29,
        30
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
