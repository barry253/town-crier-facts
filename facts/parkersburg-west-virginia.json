      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "In 1857 the Baltimore and Ohio Railroad extended a branch to Parkersburg, making it a key rail hub for the region.",
      "sourceSentenceIds": [
        13,
        15
      ],
      "sourceLabels": [
        "Wikipedia"
