      "category": "nature",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Just off the city’s shore lies Blennerhassett Island, a national historic site that once hosted a 19th‑century mansion.",
      "sourceSentenceIds": [
        24
      ],
      "sourceLabels": [
        "Web source 1"
