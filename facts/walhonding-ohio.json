  "facts": [
    {
      "id": 1,
      "text": "Walhonding was platted in 1841 when the Walhonding Canal reached the spot, sparking a brief boom as a grain shipping point.",
      "sourceSentenceIds": [
        15,
        21
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 2"
      ],
      "source": "https://en.wikipedia.org/wiki/Walhonding%2C_Ohio",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The name Walhonding comes from the Lenape word meaning “white woman,” tied to legends of early Native‑American and European interactions.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/walhonding_ohio",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The Walhonding River, formed by the Mohican and Kokosing rivers, flows southeast for 23.5 miles before joining the Muskingum.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/walhonding_ohio",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "In 1935 the Muskingum Conservancy District built the Mohawk Dam, forcing Walhonding’s buildings—except a historic bandstand—to relocate uphill.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/walhonding_ohio",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The Walhonding Valley Historical Society, founded in 2001, runs a museum in Warsaw that preserves canal heritage, indigenous history, and local artifacts.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.wvhistoricalsociety.org/",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "A 1913 flood devastated the area, but the community rebuilt, and today the Walhonding Church of Christ, founded 1893, remains the only church.",
      "sourceSentenceIds": [
        4,
        24
      ],
      "sourceLabels": [
        "Web source 2"
      ],
