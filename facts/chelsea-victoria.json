  "facts": [
    {
      "id": 1,
      "text": "Chelsea sits on the eastern shore of Port Phillip, the busiest bayside suburb between Mordialloc and Frankston.",
      "sourceSentenceIds": [
        23
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Chelsea%2C_Victoria",
      "category": "other",
      "quality": "poor",
      "qualityReason": "location_description"
    },
    {
      "id": 2,
      "text": "The town grew around a railway station that opened in 1907, giving Chelsea its name and a dual‑track line that still serves commuters.",
      "sourceSentenceIds": [
        17,
        20
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://localhistory.kingston.vic.gov.au/articles/682",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Bicentennial Park, once a rubbish tip, now hosts a modern adventure playground and barbecue area for beachgoers.",
      "sourceSentenceIds": [
        24,
        25
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Chelsea%2C_Victoria",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Chelsea’s football club, founded in the early 1900s, produced AFL legend Leigh Matthews, who began his junior career there.",
      "sourceSentenceIds": [
        28,
        29
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Chelsea%2C_Victoria",
      "category": "people",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The Chelsea Magistrates' Court closed in 1985, marking the end of a long‑standing local judicial institution.",
      "sourceSentenceIds": [
        26
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Chelsea%2C_Victoria",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The area was first called Aspendale Park, renamed Aspendale in 1905 after the racehorse Aspen, before becoming Chelsea.",
