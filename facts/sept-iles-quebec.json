  "facts": [
    {
      "id": 1,
      "text": "Sept‑Îles, literally 'Seven Islands,' sits on an archipelago that includes La Grosse Boule and the historic Île du Corossol.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Sept-%C3%8Eles",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "In 1650, explorer Jean de Quen established the L'Ange‑Gardien mission, the first European foothold in the area.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Sept-%C3%8Eles",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Sept‑Îles thrives on iron ore, hosting giants like the Iron Ore Company of Canada and the SFP Pointe‑Noire transport firm.",
      "sourceSentenceIds": [
        28,
        29
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Sept-%C3%8Eles",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The Clarke City interpretation centre chronicles Sept‑Îles' rise as the first industrial city on Quebec’s North Shore.",
      "sourceSentenceIds": [
        14
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.tourismeseptiles.ca/en",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Over 3,000 Innu members of the Uashat mak Mani‑Utenam Band call Sept‑Îles home, preserving their rich heritage.",
      "sourceSentenceIds": [
        18
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://destinationsept-iles.com/en/history-sept-iles-city",
      "category": "people",
      "quality": "good"
    },
    {
