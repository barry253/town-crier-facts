  "facts": [
    {
      "id": 1,
      "text": "Encanto Village is the smallest urban village in Phoenix, covering only about 8 square miles yet packing a dense, lively community.",
      "sourceSentenceIds": [
        13,
        27
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Encanto%2C_Phoenix%2C_Arizona",
      "category": "other",
      "quality": "poor",
      "qualityReason": "vague"
    },
    {
      "id": 2,
      "text": "The Encanto Citizens Association, founded over forty years ago, was Phoenix’s first neighborhood group dedicated to preserving historic sites.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.encantocitizensassociation.com/",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "In 1984 the ECA helped get the Encanto‑Palmcroft neighborhood and Encanto Park listed on the National Register of Historic Places, with later boundary expansions in 1992 and 1994.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.encantocitizensassociation.com/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Four Valley Metro Rail stops—Thomas, Osborn, Indian School, and Campbell—serve Encanto Village, making it a key transit hub in central Phoenix.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Encanto%2C_Phoenix%2C_Arizona",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Encanto Village’s core is the Park Central Mall, surrounded by historic districts that include the Arizona State Fairgrounds and the Veterans Memorial Coliseum.",
      "sourceSentenceIds": [
        16
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Encanto%2C_Phoenix%2C_Arizona",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The village’s name comes from the Spanish word for “magic,” reflecting the area’s early 20th‑century charm and colorful street life.",
      "sourceSentenceIds": [
        11
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
