  "facts": [
    {
      "id": 1,
      "text": "Canton Valley’s roots stretch back to the Massaco people of the Tunxis tribe, with archaeological sites dating to 4,000–2,000 B.C.",
      "sourceSentenceIds": [
        1,
        4
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/canton_valley_connecticut",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The village grew around the Albany Turnpike in the early 1800s, becoming a bustling stagecoach stop that hosted churches, schools, and cider mills.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/canton_valley_connecticut",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Ephraim Mills named the town after Swiss cantons, a nod to his admiration for Swiss patriotism and territorial organization.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/canton_valley_connecticut",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Every summer, Canton Valley’s Mills Pond Park hosts a concert series that spotlights local artists and musicians.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://ctvisit.com/listings/town-canton",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The Canton Land Conservation Trust protects over 2,000 acres, offering hiking, fishing, kayaking on the Farmington River, and biking along its trail.",
      "sourceSentenceIds": [
        30
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/canton_valley_connecticut",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The historic Collins Company, a 19th‑century industrial powerhouse, remains a landmark and a beacon for visitors and innovators alike.",
      "sourceSentenceIds": [
        8,
