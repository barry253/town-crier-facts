    {
      "id": 1,
      "text": "Mossville was originally called \"Halfway House\" because it sat midway between Peoria and Chillicothe.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://nearbylens.com/cities/usa/il/mossville/",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town was renamed Mossville in the late 1800s after John Moss, a prominent local landowner.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://nearbylens.com/cities/usa/il/mossville/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "A historic post office opened April 19, 1855, marking the town’s early development.",
      "sourceSentenceIds": [
        18
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Mossville%2C_Illinois",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Mossville once hosted a Rock Island Line station, linking it to regional rail travel.",
      "sourceSentenceIds": [
        14
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Mossville%2C_Illinois",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Caterpillar Inc.’s Mossville Engine Center, one of the world’s largest engine factories, anchors the local economy.",
