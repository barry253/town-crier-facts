  "facts": [
    {
      "id": 1,
      "text": "Arcola sprang to life in 1855 when the Illinois Central Railroad cut through the county.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Arcola%2C_Illinois"
    },
    {
      "id": 2,
      "text": "The town was named after Arcole, Italy, the site of the 1796 Battle of Arcole.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Arcola%2C_Illinois"
    },
    {
      "id": 3,
      "text": "Arcola’s Carnegie Public Library opened in 1905 and earned a National Register spot in 2002.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Arcola%2C_Illinois"
    },
    {
      "id": 4,
      "text": "The Libman Company, born as a broom shop in 1896, still makes America’s leading cleaning products.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://familydestinationsguide.com/illinois-scenic-small-town/"
    },
    {
      "id": 5,
      "text": "The 1885 Illinois Central Train Depot now houses a museum with Raggedy Ann dolls and antique broom artifacts.",
      "sourceSentenceIds": [
        18,
        19
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.arcolaillinois.org/?SEC=2A60A2FC-C7DF-48B4-868E-9FE05515A745"
    },
    {
      "id": 6,
      "text": "Arcola’s Main Street feels like a Norman Rockwell painting, with brick‑paved lanes and historic storefronts.",
