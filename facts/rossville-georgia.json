      ],
      "source": "https://en.wikipedia.org/wiki/Rossville%2C_Georgia",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Lake Winnepesaukah Amusement Park, founded in 1925, remains one of the oldest continuously operating parks in the United States.",
