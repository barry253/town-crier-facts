  "facts": [
    {
      "id": 1,
      "text": "Woburn was first settled in 1640 near Horn Pond and incorporated in 1642, making it one of New England’s oldest towns.",
      "sourceSentenceIds": [
        26,
        15
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Woburn%2C_Massachusetts",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town’s name comes from Woburn, Bedfordshire, England, reflecting its settlers’ origins.",
      "sourceSentenceIds": [
        30
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Woburn%2C_Massachusetts",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The opening of the Middlesex Canal in 1803 gave local tanners a new source of tanbark, sparking a leather‑making boom.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://woburnma.gov/about-woburn/",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "In 1835 the Boston & Lowell Railroad began running through Woburn, and a Woburn Loop line opened in 1844, boosting shoemaking and tanning.",
      "sourceSentenceIds": [
        16
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://woburnma.gov/about-woburn/",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Woburn’s public library opened in 1879, and the town’s first telephone service arrived in 1882, followed by electric lights in 1885.",
      "sourceSentenceIds": [
        20
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Woburn%2C_Massachusetts",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The Massachusetts Rifle Association, America’s oldest active gun club, was founded in 1875 and moved its headquarters to Woburn in 1876.",
