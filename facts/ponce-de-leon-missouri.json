  "facts": [
    {
      "id": 1,
      "text": "Ponce de Leon was founded around 1875 as a health resort that capitalized on a local mineral spring.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Ponce_de_Leon%2C_Missouri"
    },
    {
      "id": 2,
      "text": "The town takes its name from Spanish explorer Juan Ponce de León, whose quest for the Fountain of Youth inspired the spring’s marketing.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/ponce_de_leon_missouri"
    },
    {
      "id": 3,
      "text": "A prominent mineral spring, fed by Paleozoic limestone and dolomite, emerged from the karst landscape and drove the town’s early growth.",
      "sourceSentenceIds": [
        11
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/ponce_de_leon_missouri"
    },
    {
      "id": 4,
      "text": "The post office opened in 1881, and the community once housed a sawmill, gristmill, bank, and tomato cannery.",
      "sourceSentenceIds": [
        24,
        20
      ],
      "sourceLabels": [
        "Web source 1",
        "Wikipedia"
      ],
      "source": "https://roadsidethoughts.com/mo/ponce-de-leon-xx-stone-profile.htm"
    },
    {
      "id": 5,
      "text": "Ponce de Leon lies on East Prong Goff Creek, a tributary of the James River, at an elevation of about 1,100 feet.",
