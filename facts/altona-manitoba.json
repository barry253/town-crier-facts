  "facts": [
    {
      "id": 1,
      "text": "Altona was founded in 1880 by Plautdietsch-speaking Mennonites from the Russian Empire.",
      "sourceSentenceIds": [
        3,
        8
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Altona%2C_Manitoba",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The Canadian Pacific Railway reached Altona in 1882, and a separate town-site was established in 1895.",
      "sourceSentenceIds": [
        1,
        9,
        30
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Altona%2C_Manitoba",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Altona earned the nickname “Sunflower Capital of Canada” after wheat prices fell and farmers switched to sunflowers.",
      "sourceSentenceIds": [
        14,
        10,
        15
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Altona%2C_Manitoba",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The town hosts an annual Sunflower Festival that began in 1965, crowning a Sunflower Queen who flies to Emerald, Australia.",
      "sourceSentenceIds": [
        10,
        16
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Altona%2C_Manitoba",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "In 1972, Altona became home to Canada’s first Mennonite Central Committee self‑help centre, now the Gift and Thrift Store.",
      "sourceSentenceIds": [
        4,
        6
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Altona%2C_Manitoba",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The area that became Altona was originally tall‑grass prairie, home to big bluestem, little bluestem, and switchgrass.",
      "sourceSentenceIds": [
