  "facts": [
    {
      "id": 1,
      "text": "Puget Island was named for Peter Puget, a lieutenant in the Vancouver Expedition that first mapped the island in 1792.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Puget_Island%2C_Washington",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The Julia Butler Hansen Bridge, built in 1938, carries State Route 409 across the Cathlamet Channel to connect Puget Island with Cathlamet.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Puget_Island%2C_Washington",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Route 409 crosses the island to its southern shore, where the Wahkiakum County Ferry Oscar B. links Puget Island to Westport, Oregon.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Puget_Island%2C_Washington",
      "category": "transport",
      "quality": "poor",
      "qualityReason": "route_only"
    },
    {
      "id": 4,
      "text": "The Ostervold family settled Puget Island in 1884, beginning a long tradition of farming on the island.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Puget_Island%2C_Washington",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Farmers on Puget Island grew mint from 1917 until the late 1940s before turning to other crops.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Puget_Island%2C_Washington",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "In the 1990s, sheep, dairying, and cottonwood were the main agricultural pursuits on Puget Island.",
