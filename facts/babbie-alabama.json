  "facts": [
    {
      "id": 1,
      "text": "Babbie was first settled in the 1830s, and by 1851 the community had built its first church, the Bethel Primitive Baptist Church.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://encyclopediaofalabama.org/article/babbie/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "In 1901 the Alabama and Florida Railroad laid tracks through Babbie, making it a flag stop on a line that became part of the Louisville and Nashville Railroad.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://encyclopediaofalabama.org/article/babbie/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Early businesses in Babbie revolved around agriculture, featuring a grist mill, cotton gin, feed mill, and sawmill that served the farming community.",
      "sourceSentenceIds": [
        23
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://encyclopediaofalabama.org/article/babbie/",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Local lore suggests the town’s name comes from a playful twist on “baby,” reflecting how small the settlement was when it began.",
      "sourceSentenceIds": [
        24
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://encyclopediaofalabama.org/article/babbie/",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The town’s first school opened in the early 1900s, and a post office operated from 1902 until 1911, marking a brief period of expanded services.",
      "sourceSentenceIds": [
        25
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://encyclopediaofalabama.org/article/babbie/",
      "category": "other",
      "quality": "poor",
      "qualityReason": "vague"
    },
    {
      "id": 6,
      "text": "Today, Babbie remains largely a farming community, preserving its rural character amid modern changes.",
      "sourceSentenceIds": [
        26
