  "facts": [
    {
      "id": 1,
      "text": "Jesterville grew from a post village founded in 1867 after Wicomico County split from Somerset and Worcester counties.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/jesterville_maryland",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The Beaudley house, built around 1795, showcases Federal‑style architecture and is listed on the National Register for its agrarian history.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/jesterville_maryland",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Westside Historical Society, formed in 1985, preserves the western Wicomico County heritage and hosts a family history library on Main Street.",
      "sourceSentenceIds": [
        3,
        8
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://westsidehistorical.com/who-we-are",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "In 2006 the society earned the Heritage Award from the Lower Eastern Shore Heritage Council for outstanding preservation work.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://westsidehistorical.com/who-we-are",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Rural electrification reached Jesterville in the 1930s through the Choptank Electric Cooperative, a New Deal project started in 1938.",
      "sourceSentenceIds": [
        6
