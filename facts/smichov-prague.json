  "facts": [
    {
      "id": 1,
      "text": "Smichov’s Ringhoffer factory, founded in 1852 by Baron Franz Ringhoffer, grew into one of the Austro‑Hungarian Empire’s largest industrial complexes.",
      "sourceSentenceIds": [
        1,
        30
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Sm%C3%ADchov"
    },
    {
      "id": 2,
      "text": "The same factory produced court trains and saloon cars for European rulers, then trams for the entire Eastern bloc after 1945.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Sm%C3%ADchov"
    },
    {
      "id": 3,
      "text": "Smichov railway station’s redevelopment will add nearly 400,000 square metres of residential, commercial and public space.",
      "sourceSentenceIds": [
        16
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Sm%C3%ADchov"
    },
    {
      "id": 4,
      "text": "Staropramen Brewery’s visitor centre on Nádražní 43 lets you taste beer brewed there since 1869 and learn its history.",
      "sourceSentenceIds": [
        10,
        13
      ],
      "sourceLabels": [
