  "facts": [
    {
      "id": 1,
      "text": "Hamilton Heights takes its name from Alexander Hamilton, who lived in the area at Hamilton Grange.",
      "sourceSentenceIds": [
        4,
        28
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Hamilton_Heights%2C_Manhattan",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The neighborhood’s historic district was designated in 1974, preserving fine apartment houses along Amsterdam Avenue between 140th and 145th Streets.",
      "sourceSentenceIds": [
        16,
        17
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Hamilton_Heights%2C_Manhattan",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The 137th Street–City College and 145th Street subway stops opened with the IRT Broadway–Seventh Avenue Line in 1904, linking the area to downtown.",
      "sourceSentenceIds": [
        21
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Hamilton_Heights%2C_Manhattan",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "During the Harlem Renaissance, artists like Count Basie and Paul Robeson called Hamilton Heights home, making it a cultural hotspot.",
      "sourceSentenceIds": [
        23,
        8
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://westharlemcpo.org/neighborhood-history/",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The Carnegie library that opened in 1907 still stands and was renovated in 1975, now listed on the National Register of Historic Places.",
      "sourceSentenceIds": [
        5
      ],
