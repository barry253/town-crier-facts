      "id": 1,
      "text": "In 1935, developers Carlton Smith and Allen Dawson planted the first homes on Elmhurst Road, sparking Prospect Heights’ planned community.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 1"
      ],
