  "facts": [
    {
      "id": 1,
      "text": "Altaville's name comes from Spanish \"alta\" meaning upper and French \"ville\" meaning town, reflecting its high elevation.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Altaville%2C_California",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town was founded in 1852 on Cherokee Creek and survived a brief gold rush by becoming a supply hub for nearby mines.",
      "sourceSentenceIds": [
        6,
        14
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Altaville%2C_California",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "In 1854, Demerest established a foundry that later produced most stamp mills and mining machinery for Calaveras and Tuolumne Counties.",
      "sourceSentenceIds": [
        15,
        16
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Altaville%2C_California",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Altaville is California Historical Landmark #288, officially recognized for its mining heritage.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Altaville%2C_California",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The Altaville Foundry building, moved in the 1980s, now serves as a historic landmark and museum of local industry.",
