  "facts": [
    {
      "id": 1,
      "text": "Bessemer City takes its name from Sir Henry Bessemer, the inventor of the iron‑smelting process that ultimately made the town’s early furnaces obsolete.",
      "sourceSentenceIds": [
        3,
        4
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Bessemer_City%2C_North_Carolina",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Founded in 1893 on land purchased from the Ormand family, Bessemer City sits near the historic Sloan‑Washington‑Ormand Iron Furnace.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Bessemer_City%2C_North_Carolina",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The Old Ormand Furnace, built in the 18th century, still stands today and hosts the annual Ormand Family Reunion, one of America’s oldest gatherings.",
      "sourceSentenceIds": [
        26,
        29
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Bessemer_City%2C_North_Carolina",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "In 1896, a wealthy resident constructed “Long View,” the first luxurious home in the area, marking Bessemer City’s early prosperity.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Bessemer_City%2C_North_Carolina",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The Atlanta & Charlotte Division of the Richmond & Danville Railroad reached Gaston County in 1871, connecting Bessemer City to the regional rail network.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Bessemer_City%2C_North_Carolina",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Bessemer City’s streets still echo its textile past, with the historic Osage Mill standing as a window into the town’s industrial heritage.",
      "sourceSentenceIds": [
        18
      ],
