      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Lake Lorelei’s clubhouse, completed in 1969, sits beside a pavilion added in 1987, offering members a central gathering spot.",
      "sourceSentenceIds": [
