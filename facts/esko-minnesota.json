  "facts": [
    {
      "id": 1,
      "text": "Esko's Historical Society published the book Esko's Corner, detailing the town’s early history.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Esko%2C_Minnesota"
    },
    {
      "id": 2,
      "text": "The museum sits on the historic Alex Esko farm in the heart of town.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://townofthomsonmn.gov/local-information-links/"
    },
    {
      "id": 3,
      "text": "Inside the museum, seven historic buildings—including a 1878 grist mill—tell Esko’s story.",
      "sourceSentenceIds": [
        11
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://townofthomsonmn.gov/local-information-links/"
    },
    {
      "id": 4,
      "text": "The society’s digital collection features photographs of early residents, farms, and roads.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://mndigital.org/about/contributing-organizations/esko-historical-society"
    },
    {
      "id": 5,
      "text": "Originally called Esko’s Corner, the town shortened its name to Esko in 1935.",
      "sourceSentenceIds": [
        24
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Esko%2C_Minnesota"
    },
    {
      "id": 6,
      "text": "Most early settlers were Finnish, and their traditions still shape Esko’s culture.",
      "sourceSentenceIds": [
        14
