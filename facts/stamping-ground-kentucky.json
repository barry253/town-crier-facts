      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Stamping Ground was founded in 1790 and officially incorporated on January 24, 1834.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://stampinggroundky.gov/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The town grew around a spring the Indians called “Buffalo Stamping Ground” in the area.",
