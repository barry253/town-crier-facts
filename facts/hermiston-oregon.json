  "facts": [
    {
      "id": 1,
      "text": "Hermiston was named after Robert Louis Stevenson's unfinished novel 'Weir of Hermiston' by early settler McNaught.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
