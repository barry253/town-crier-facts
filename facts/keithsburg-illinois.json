      "id": 1,
      "text": "Keithsburg was founded in 1837 by Scottish immigrant Robert Keith, who laid out the town after claiming the riverbank.",
      "sourceSentenceIds": [
        4,
        27,
        28,
        30
      ],
      "sourceLabels": [
        "Web source 2",
        "Web source 1"
      ],
      "source": "https://www.usacitiesonline.com/ilcountykeithsburg.htm",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town’s name honors its founder, Robert Keith, a pioneer settler from Scotland.",
      "sourceSentenceIds": [
        1,
        4
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 2"
      ],
      "source": "https://en.wikipedia.org/wiki/Keithsburg%2C_Illinois",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Locals call the area Yellowbanks because the riverbanks are covered in bright yellow sandy soil.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.usacitiesonline.com/ilcountykeithsburg.htm",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The Great Flood of 1993 swept through Keithsburg, leaving the town rebuilt and still echoing the river’s power.",
      "sourceSentenceIds": [
        25,
        11
      ],
      "sourceLabels": [
        "Wikipedia",
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Keithsburg%2C_Illinois",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "North of Keithsburg lies the Keithsburg Division of the Mark Twain National Wildlife Refuge, a haven for migratory birds.",
