  "facts": [
    {
      "id": 1,
      "text": "Pettit was named for Mark and Eliza Pettit, who were original townsite allottees in the area.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Pettit%2C_Oklahoma"
    },
    {
      "id": 2,
      "text": "Pettit lies in the foothills of the Ozark Mountains within the historic bounds of the Cherokee Nation.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/pettit_oklahoma"
    },
    {
      "id": 3,
      "text": "The community of Pettit emerged from the allotment process of Cherokee Nation lands following the Dawes Severalty Act of 1887.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/pettit_oklahoma"
    },
    {
      "id": 4,
      "text": "Pettit borders Lake Tenkiller to the southeast, with the Pettit Bay Public Use Area located across the water.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Pettit%2C_Oklahoma"
    },
    {
      "id": 5,
      "text": "The construction of the Tenkiller Ferry Dam between 1938 and 1953 marked a pivotal development for the Pettit area.",
      "sourceSentenceIds": [
        7,
        30
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/pettit_oklahoma"
    },
    {
      "id": 6,
      "text": "Dense oak-hickory forests and rolling hills define the natural landscape surrounding Pettit in Oklahoma's Green Country region.",
