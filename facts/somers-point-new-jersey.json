  "facts": [
    {
      "id": 1,
      "text": "John Somers, the first European settler, bought land in 1693, founding Somers Point—the oldest European settlement in Atlantic County.",
      "sourceSentenceIds": [
        24,
        25
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Somers_Point%2C_New_Jersey",
      "category": "people",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Somers Point was once known as Somerset Plantation, Somers Ferry, and Somers Plantation before adopting its current name in 1750.",
      "sourceSentenceIds": [
        4,
        29
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Somers_Point%2C_New_Jersey",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Somers Point’s maritime past thrives in its fishing, shipbuilding legacy, marinas, and the Somers Mansion—built 1720‑1726 and the county’s oldest house.",
      "sourceSentenceIds": [
        14,
        28
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/Somers_Point,_New_Jersey",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "In 1989, Somers Point earned a spot on the National Register of Historic Places for its architecture, recreation, and social history.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Somers_Point%2C_New_Jersey",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "A former Atlantic City and Shore Railroad right‑of‑way now powers Somers Point’s bike path, linking the town to neighboring communities.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Somers_Point%2C_New_Jersey",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Somers Point transitioned from a borough in 1886 to a city in 1902, reflecting its growth along the Jersey Shore.",
