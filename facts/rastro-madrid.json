  "facts": [
    {
      "id": 1,
      "text": "El Rastro, Madrid’s oldest flea market, traces its roots back before 1561, the year Madrid became the capital.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.themakingofmadrid.com/2026/01/06/a-guide-to-el-rastro-madrids-legendary-flea-market/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Its name comes from the tanneries on Ribera de Curtidores, where cattle trails left a blood trail across the street.",
      "sourceSentenceIds": [
        22,
        23
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/El_Rastro",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The market spans from Plaza de Cascorro to Embajadores, hosting up to 3,500 stalls on a single Sunday.",
      "sourceSentenceIds": [
        25
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/El_Rastro",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Every Sunday and public holiday, crowds swell around 11 am, the busiest hour for bargaining and discovery.",
      "sourceSentenceIds": [
        12,
        29
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/El_Rastro",
      "category": "other",
      "quality": "poor",
      "qualityReason": "editorial_filler"
    },
    {
      "id": 5,
      "text": "A barrel‑organ lady has played on the market’s square every Sunday, a living piece of Madrid history.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.themakingofmadrid.com/2026/01/06/a-guide-to-el-rastro-madrids-legendary-flea-market/",
