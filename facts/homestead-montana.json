    },
    {
      "id": 2,
      "text": "Homestead grew into a key shipping hub thanks to its Great Northern Railroad depot.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.legendsofamerica.com/homestead-montana/"
    },
    {
      "id": 3,
      "text": "Homestead lies on Big Muddy Creek, roughly 5.8 miles south-southwest of Medicine Lake.",
      "sourceSentenceIds": [
