  "facts": [
    {
      "id": 1,
      "text": "Lebanon was founded by George Steitz in 1740 and originally called Steitztown.",
      "sourceSentenceIds": [
        2,
        3
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Lebanon%2C_Pennsylvania",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Lebanon is the county seat of Lebanon County and lies 61 miles southwest of Allentown, 26 miles east of Harrisburg, and 88 miles northwest of Philadelphia.",
      "sourceSentenceIds": [
        26,
        27
      ],
      "sourceLabels": [
        "Wikipedia",
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Lebanon%2C_Pennsylvania",
      "category": "other",
      "quality": "poor",
      "qualityReason": "location_description"
    },
    {
      "id": 3,
      "text": "The town’s historic downtown features buildings from the 18th and 19th centuries, and the Union Canal, which operated from 1828 to 1885, ran through its north side.",
      "sourceSentenceIds": [
        4,
        30
      ],
      "sourceLabels": [
        "Wikipedia",
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Lebanon%2C_Pennsylvania",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Lebanon is the birthplace of the famous pork product Lebanon bologna, first made before the 1780s, and was filmed in a 2008 TV episode of Dirty Jobs.",
      "sourceSentenceIds": [
        29,
        23
      ],
      "sourceLabels": [
        "Wikipedia",
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Lebanon%2C_Pennsylvania",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The Lebanon Valley Railroad, completed in 1857, and the earlier Union Canal were key to the county’s early economic growth.",
      "sourceSentenceIds": [
        19,
        20
      ],
      "sourceLabels": [
        "Web source 2",
        "Web source 2"
      ],
      "source": "https://visitlebanonvalley.com/lebanon/",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Locals pronounce the city’s name as “Leb‑nin” or “Lep‑nin,” a variation tied to Pennsylvania Dutch heritage, even though it was named after the West Asian country.",
