  "facts": [
    {
      "id": 1,
      "text": "Valdez served as a company town for Colorado Fuel & Iron from 1907 to 1960, centered on the Frederick coal mine.",
      "sourceSentenceIds": [
        4,
        28
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 2"
      ],
      "source": "https://en.wikipedia.org/wiki/Valdez%2C_Colorado",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The Frederick mine shipped bituminous coal to CF&I’s Minnequa steel mill via the Colorado and Wyoming Railway, part of a vertical integration strategy.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Valdez%2C_Colorado",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "In 1913‑14, CF&I fought the Colorado Coalfield War in Valdez, with the National Guard and detectives present.",
      "sourceSentenceIds": [
        14
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Valdez%2C_Colorado",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "By 1917, the mine produced about 1,500 tons of coal daily, employing 500 men and 28 mules.",
      "sourceSentenceIds": [
        18
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Valdez%2C_Colorado",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Trams replaced mules in 1940, and miner numbers grew to 750.",
      "sourceSentenceIds": [
        19
