  "facts": [
    {
      "id": 1,
      "text": "Carlsbad was named after the famed spa town of Karlsbad in the Czech Republic, after a fresh‑water well showed similar chemistry.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Carlsbad%2C_California"
    },
    {
      "id": 2,
      "text": "In 1887, Gerhard Schutte, a German‑born merchant, partnered with Samuel Church Smith to form the Carlsbad Land and Mineral Water Company.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Carlsbad%2C_California"
    },
    {
      "id": 3,
      "text": "The Carlsbad History Collection, housed at the Georgina Cole Library, preserves paper, microform, and electronic records of the city’s past.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.carlsbadca.gov/departments/community-development/planning/historic-preservation/preservation-online"
    },
    {
      "id": 4,
      "text": "The Barrio, a historic downtown neighborhood, is bounded by Carlsbad Village Drive, Tamarack Avenue, I‑5, and the railroad tracks.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Carlsbad%2C_California"
    },
    {
      "id": 5,
      "text": "Carlsbad hosts Legoland California, Sea Life Aquarium, and the Museum of Making Music, making it a hub for family entertainment.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Carlsbad%2C_California"
    },
    {
      "id": 6,
      "text": "Encina Power Station, once a landmark, was demolished in 2015 despite efforts to preserve it as a historic site.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
