  "facts": [
    {
      "id": 1,
      "text": "Big Water was originally called Glen Canyon City and housed workers who built the Glen Canyon Dam in the 1950s.",
      "sourceSentenceIds": [
        4,
        5
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Big_Water%2C_Utah"
    },
    {
      "id": 2,
      "text": "Alex Joseph renamed the community Big Water after construction crews for the Glen Canyon Dam had left the area.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.visitsouthernutah.com/big-water/"
    },
    {
      "id": 3,
      "text": "Big Water made news in the 1980s as a polygamous colony of the Joseph clan.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Big_Water%2C_Utah"
    },
    {
      "id": 4,
      "text": "Big Water once had the first city council in the United States where every member belonged to the Libertarian Party.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Big_Water%2C_Utah"
    },
    {
      "id": 5,
      "text": "Known as Dinosaur Town, Big Water features a visitor center and museum shaped like an ammonite fossil.",
      "sourceSentenceIds": [
        26,
        30
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.visitsouthernutah.com/big-water/"
    },
    {
      "id": 6,
      "text": "Local ordinances in Big Water protect the night sky, making the stars and galaxies easily visible to observers.",
