  "facts": [
    {
      "id": 1,
      "text": "Belington was founded between 1766 and 1770, originally called the Barker Settlement after Elias and William Barker.",
      "sourceSentenceIds": [
        2,
        5,
        6
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Belington%2C_West_Virginia",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "In 1855 the town adopted the name Belington, honoring Jewish merchant John Bealin who opened a store on Beverly‑Fairmont Road.",
      "sourceSentenceIds": [
        4,
        15
      ],
      "sourceLabels": [
        "Web source 1",
        "Wikipedia"
      ],
      "source": "https://cityofbelington.com/about/",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "A historic bridge over the Tygart Valley River was completed in 1886, linking the town across the river.",
      "sourceSentenceIds": [
        18
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Belington%2C_West_Virginia",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The West Virginia Central and Pittsburg Railway arrived in 1891, turning Belington into a railroad hub that fueled local prosperity.",
      "sourceSentenceIds": [
        19
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Belington%2C_West_Virginia",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The Wilmoth House, a 19th‑century residence, is listed on the National Register of Historic Places and stands as a local landmark.",
      "sourceSentenceIds": [
        8,
        10
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Belington%2C_West_Virginia",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "During the Civil War, Confederate forces camped near Laurel Mountain Road, a winding dirt road that still connects Belington with Elkins.",
