  "facts": [
    {
      "id": 1,
      "text": "Carmel was originally laid out as Bethlehem in 1837 and renamed Carmel in 1874 after a referendum.",
      "sourceSentenceIds": [
        10,
        16
      ],
      "sourceLabels": [
        "Web source 2",
        "Web source 1"
      ],
      "source": "https://bestattractions.org/usa/indiana/carmel-in-local-facts/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The Monon Railroad depot opened in 1883 and remained in service until 1974; the depot now houses the Carmel Clay Historical Society.",
      "sourceSentenceIds": [
        12,
        16,
        17,
        18
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Carmel%2C_Indiana",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The Carmel Clay Historical Society began its first activities in 1837 and now preserves the historic Monon Depot Museum.",
      "sourceSentenceIds": [
        11,
        18
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Carmel%2C_Indiana",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Carmel’s first library started in 1904 by a local literary club and was moved to a Carnegie‑funded building in 1913.",
      "sourceSentenceIds": [
        23,
        24
      ],
      "sourceLabels": [
        "Wikipedia",
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Carmel%2C_Indiana",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The Carmel Christkindlmarkt, opened in 2017, features a 33‑foot Glühwein Pyramid lit by 3,000 bulbs.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Carmel%2C_Indiana",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "GreekFest, founded in 1974, moved to Carmel in 2009 and celebrates Greek heritage with food and music.",
