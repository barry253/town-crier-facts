  "facts": [
    {
      "id": 1,
      "text": "Franklin was part of the Creek Nation until the 1832 forced removal of the Creek Indians.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://encyclopediaofalabama.org/article/franklin/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town’s first Methodist Missionary Church, founded in the late 1700s, served Creek members and had separate white and Creek cemeteries.",
      "sourceSentenceIds": [
        1,
        15
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://encyclopediaofalabama.org/article/franklin/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "James McQueen, a Scottish trader who married a Creek woman, is buried in Franklin’s Indian cemetery and is the great‑grandfather of Seminole leader Osceola.",
      "sourceSentenceIds": [
        16,
        17
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Franklin%2C_Alabama",
      "category": "people",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "After the Creek ceded land, European settlers turned Franklin into a cotton‑growing area that relied on enslaved labor from the Upper South.",
      "sourceSentenceIds": [
        18,
        19
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Franklin%2C_Alabama",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Cotton remained Franklin’s main crop after the Civil War, sustaining the local economy into the late 19th century.",
      "sourceSentenceIds": [
        20
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Franklin%2C_Alabama",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "When Franklin incorporated in 1977, the former community center building became the town hall, preserving a historic structure.",
      "sourceSentenceIds": [
        30
