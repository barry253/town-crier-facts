  "facts": [
    {
      "id": 1,
      "text": "Martinez was founded on the land of Rancho El Pinole, named after Californio ranchero Ygnacio Martínez, who received the grant in 1829.",
      "sourceSentenceIds": [
        2,
        6
      ],
      "sourceLabels": [
