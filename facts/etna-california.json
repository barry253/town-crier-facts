  "facts": [
    {
      "id": 1,
      "text": "Etna’s name comes from a local flour mill called Aetna, itself named after Mount Etna in Sicily.",
      "sourceSentenceIds": [
        1,
        2
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Etna%2C_California"
    },
    {
      "id": 2,
      "text": "Founded in 1853 as the rough‑and‑tumble Gold Rush town Rough and Ready, Etna incorporated in 1878.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Etna%2C_California"
    },
    {
      "id": 3,
      "text": "Etna sits at the foot of Marble Mountain Wilderness, part of the Klamath Range, drawing hikers and rafters.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Etna%2C_California"
    },
    {
      "id": 4,
      "text": "Hollywood screenwriter Anita Loos, famed for 'Gentlemen Prefer Blondes,' is buried in Etna’s cemetery.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Etna%2C_California"
    },
    {
      "id": 5,
      "text": "A 1861‑62 flood destroyed the original town, forcing businesses to relocate to the nearby Rough and Ready Mill.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Etna%2C_California"
    },
    {
      "id": 6,
      "text": "Etna lies in Siskiyou County’s Scott Valley, close to the Oregon border and the unincorporated community of Callahan.",
