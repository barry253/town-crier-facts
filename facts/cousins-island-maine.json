  "facts": [
    {
      "id": 1,
      "text": "Cousins Island takes its name from Englishman John Cousins, who owned the land in the mid‑1600s.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Cousins_Island",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "On the island's southwestern peninsula stands Wyman Station, an oil‑fired electric power plant capable of producing up to 823 megawatts.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://winslowmaine.org/cousins-island-maine-exploring-the-hidden-gem-amidst-maine-s-breathtaking-landscape",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "History The island has been inhabited by the Abenaki people, who called it Susquesong, for over 12,000 years prior to European colonization.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/Cousins_Island",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Heritage Radio station WYAR was established in 1998 by Gary King in the basement of his Cousins Island home.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Cousins_Island",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Snodgrass Memorial Bridge, colloquially known as the Cousins Island Bridge, was built in 1955.",
      "sourceSentenceIds": [
        17
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Cousins_Island",
      "category": "landmark",
      "quality": "good"
    },
