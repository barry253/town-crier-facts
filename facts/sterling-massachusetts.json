  "facts": [
    {
      "id": 1,
      "text": "Sterling was incorporated on April 25, 1781, and named for William Alexander, Lord Stirling, a Continental Army general who fought in the Revolution.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/Sterling,_Massachusetts",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town’s First Congregational Church, founded in 1731, served as an early gathering place that helped shape Sterling’s community spirit.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://thebostondaybook.com/sterling-massachusetts-history/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The 1849 arrival of the Nashua and Worcester Railroad helped diversify Sterling’s economy beyond its agrarian roots.",
      "sourceSentenceIds": [
        20
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://thebostondaybook.com/sterling-massachusetts-history/",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Sterling’s annual Town Fair, first held in 1859, remains a long‑standing tradition that brings residents together each year.",
      "sourceSentenceIds": [
        30
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/Sterling,_Massachusetts",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The Sterling Historical Society Museum, housed in the historic Butterick Building, displays artifacts that chronicle the town’s industrial and cultural heritage.",
      "sourceSentenceIds": [
        25,
        26
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://thebostondaybook.com/sterling-massachusetts-history/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Shoe manufacturing once dominated Sterling’s economy, with several factories employing a large local workforce.",
