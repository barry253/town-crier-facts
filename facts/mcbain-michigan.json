  "facts": [
    {
      "id": 1,
      "text": "McBain began as a sawmill settlement founded by brothers Gillis and John McBain in 1887.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://cityofmcbainmichigan.com/"
    },
    {
      "id": 2,
      "text": "A station named Owens opened on the Toledo, Ann Arbor and North Michigan Railway on August 27, 1888, and a post office opened September 10, 1888.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://cityofmcbainmichigan.com/"
    },
    {
      "id": 3,
      "text": "Both the station and post office were renamed McBain on September 17, 1889.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://cityofmcbainmichigan.com/"
    },
    {
      "id": 4,
      "text": "McBain incorporated as a village in 1893 and became a city in 1907.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/McBain%2C_Michigan"
    },
    {
      "id": 5,
      "text": "The city sits in southwestern Missaukee County, bordered by Riverside Township to the east and Richland Township to the west.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/McBain%2C_Michigan"
    },
    {
      "id": 6,
      "text": "McBain lies 10 miles south of Lake City, the county seat, and 13 miles east‑southeast of Cadillac.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/McBain%2C_Michigan"
    }
  ]
