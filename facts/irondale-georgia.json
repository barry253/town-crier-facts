  "facts": [
    {
      "id": 1,
      "text": "Irondale’s name comes from the iron that once powered its early industry, a fact that still echoes in the town’s identity.",
      "sourceSentenceIds": [
        2,
        3
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.wisdomlib.org/cities/irondale-44918",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town’s growth in the 19th century was tightly linked to iron ore mining and processing, shaping its early character.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.wisdomlib.org/cities/irondale-44918",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Irondale Furnace, a surviving relic of the iron industry, stands as a tangible reminder of the town’s industrial past.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.trawellino.com/destinations/united-states/georgia_irondale",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The historic Irondale Cafe, featured in the novel “Fried Green Tomatoes at the Whistle Stop Cafe,” remains a local landmark.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.trawellino.com/destinations/united-states/georgia_irondale",
      "category": "landmark",
      "quality": "good"
    },
    {
