      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Edward Raynor founded the settlement in the 1650s, originally calling it Raynor South before it became Freeport.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://libguides.freeportlibrary.info/c.php?g=435576",
      "category": "people",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The Freeport Historical Society opened its museum in 1962 inside an 1861 bayman’s shack that once served local fishermen.",
      "sourceSentenceIds": [
