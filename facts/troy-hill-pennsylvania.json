  "facts": [
    {
      "id": 1,
      "text": "Troy Hill sits on a plateau above the Allegheny River, stretching about 1.9 miles long and 0.6 miles wide.",
      "sourceSentenceIds": [
        22,
        23
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
