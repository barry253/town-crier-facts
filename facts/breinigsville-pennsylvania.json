  "facts": [
    {
      "id": 1,
      "text": "Breinigsville takes its name from George Ludwig Breinig, a German immigrant who arrived in Philadelphia aboard the Lydia in 1749.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Breinigsville%2C_Pennsylvania",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Peter Breinig, George’s youngest son, founded the village and ran a 123‑acre farm that helped shape the early community.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Breinigsville%2C_Pennsylvania",
      "category": "people",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Although the Allentown Railroad graded a line through Breinigsville in 1855, the Catasauqua and Fogelsville Railroad built a branch there in the 1860s to haul local iron ore.",
      "sourceSentenceIds": [
        5,
        6
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Breinigsville%2C_Pennsylvania",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Agriculture remains strong, yet the arrival of manufacturers in the 20th century spurred new housing, retail, and infrastructure development.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.uppermac.org/our-township/our-history-our-future",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Breinigsville hosts the annual Pennsylvania Renaissance Faire, drawing visitors to historical reenactments and entertainment each summer.",
