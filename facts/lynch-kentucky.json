      ],
      "source": "https://en.wikipedia.org/wiki/Lynch%2C_Kentucky"
    },
    {
      "id": 3,
      "text": "Lynch was once the largest company-owned coal town in Kentucky, reaching a peak population of about ten thousand people.",
      "sourceSentenceIds": [
        3,
        5,
        12
      ],
      "sourceLabels": [
        "Web source 1",
