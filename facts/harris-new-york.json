  "facts": [
    {
      "id": 1,
      "text": "Harris, New York, grew from a 19th‑century farming settlement founded by the Strong family, who migrated from Southbury, Connecticut.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/harris_new_york",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The hamlet’s name honors William A. Harris, a prominent early settler whose family helped shape the community.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/harris_new_york",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "During the 1950s and 1960s, Harris became a bustling Borscht Belt resort, hosting bungalow colonies like Maybergs and Victory Colony.",
      "sourceSentenceIds": [
        12,
        13
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Harris%2C_New_York",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The East Mongaup River powered early sawmills and shingle‑making, anchoring Harris’s early economy in timber processing.",
      "sourceSentenceIds": [
        23,
        24
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/harris_new_york",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "A one‑room schoolhouse, originally called the Mongaup Center school, served Harris’s children in the 1800s, reflecting early educational efforts.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/harris_new_york",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Today, the Center for Discovery, a large community for disabled residents, stands as Harris’s biggest employer and a key modern landmark.",
      "sourceSentenceIds": [
        17
