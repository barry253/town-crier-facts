  "facts": [
    {
      "id": 1,
      "text": "Summit was originally known as Summitville, and its current name is purely descriptive of its geography.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://guides.library.oregonstate.edu/localhistory/summit"
    },
    {
      "id": 2,
      "text": "The area that became Summit was traditionally inhabited by the Kalapuya people before European settlement.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/summit_oregon"
    },
    {
      "id": 3,
      "text": "Summit was platted in 1885 by William Post, who had migrated to Oregon from Missouri in 1876.",
      "sourceSentenceIds": [
        22,
        23
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://guides.library.oregonstate.edu/localhistory/summit"
    },
    {
      "id": 4,
      "text": "As the highest point on the Corvallis to Yaquina Bay railroad route, Summit provided essential services and boarding for railway workers.",
      "sourceSentenceIds": [
        4,
        13
      ],
      "sourceLabels": [
        "Web source 1",
        "Web source 2"
      ],
      "source": "https://guides.library.oregonstate.edu/localhistory/summit"
    },
    {
      "id": 5,
      "text": "Summit is known locally for a hippie-style summer festival held on the third Saturday in August since 1980.",
      "sourceSentenceIds": [
        17,
        18
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Summit%2C_Oregon"
    },
    {
      "id": 6,
      "text": "A wagon road crossing the Coast Range at the future site of Summit facilitated trade between the Willamette Valley and the coast.",
      "sourceSentenceIds": [
        5,
        9
      ],
      "sourceLabels": [
