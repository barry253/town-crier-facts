  "facts": [
    {
      "id": 1,
      "text": "Schuylerville was incorporated in 1831 and named after the Schuyler family, a prominent Dutch‑descended clan in colonial America.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Schuylerville%2C_New_York",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Schuylerville hosts the General Schuyler House and the Old Saratoga Reformed Church, both part of Saratoga National Historical Park and listed on the National Register.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Schuylerville%2C_New_York",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The Marshall House, the sole surviving building from the Battles of Saratoga, is a significant Revolutionary War historic site in Schuylerville.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Schuylerville%2C_New_York",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "In 1767, General Phillip Schuyler built the first flax mill in the American colonies, marking early industrial activity in the area.",
      "sourceSentenceIds": [
        25
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Schuylerville%2C_New_York",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The Old Saratoga Reformed Church, organized in 1770, served as a hospital during the Revolutionary War, illustrating its dual role in community and conflict.",
      "sourceSentenceIds": [
        26,
        27
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
