      "id": 1,
      "text": "Sandy Hollow-Escondidas sits on flat coastal prairie terrain with elevations generally below one hundred feet above sea level.",
      "sourceSentenceIds": [
        21
      ],
      "sourceLabels": [
        "Web source 1"
      ],
