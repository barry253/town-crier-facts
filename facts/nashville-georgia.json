  "facts": [
    {
      "id": 1,
      "text": "Nashville was founded around 1840 in the rolling hills of Georgia's coastal plain.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Nashville%2C_Georgia",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "In 1856 Nashville became the seat of newly formed Berrien County in the southeastern United States.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Nashville%2C_Georgia",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The city was incorporated as a town in 1892 and as a city in 1900.",
      "sourceSentenceIds": [
        13
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Nashville%2C_Georgia",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The Berrien Historical Foundation, formed in 1856, preserves the county’s history and holds a photo collection in Nashville.",
      "sourceSentenceIds": [
        2,
        6
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://dlg.usg.edu/institutions/bchf",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Nashville is nicknamed the 'City of Dogwoods' because the tree blooms in abundance around the area.",
      "sourceSentenceIds": [
        11
