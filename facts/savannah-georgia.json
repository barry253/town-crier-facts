  "facts": [
    {
      "id": 1,
      "text": "Savannah was founded in 1733 by James Edward Oglethorpe, making it Georgia's oldest city and a prime example of 18th‑century town planning.",
      "sourceSentenceIds": [
        1,
        23
      ],
      "sourceLabels": [
        "Web source 2",
        "Web source 1"
      ],
      "source": "https://www.georgiaencyclopedia.org/articles/counties-cities-neighborhoods/savannah/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The city’s name comes from the Savannah River, whose name likely derives from the Shawnee people who migrated there in the 1680s.",
      "sourceSentenceIds": [
        10,
        23
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Savannah%2C_Georgia",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "In 1833 the Central of Georgia Railway, where Savannah was the largest stockholder, received its charter, linking the city to the growing rail network.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.georgiaencyclopedia.org/articles/counties-cities-neighborhoods/savannah/",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The historic Tybee Island Light Station, built in 1854, is the first lighthouse on the southern Atlantic coast and sits on Savannah Beach.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Savannah%2C_Georgia",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Savannah hosts the Ralph Mark Gilbert Civil Rights Museum, dedicated to African‑American history and the civil‑rights movement in the city.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Savannah%2C_Georgia",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The Savannah Theatre, the only fully professional resident theater in the city, has been producing music revues and live performances since 1797.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Savannah%2C_Georgia",
