  "facts": [
    {
      "id": 1,
      "text": "Rochester Mills grew around a post office opened in 1871, which gave the village its name despite early settlers calling the area Richmond.",
      "sourceSentenceIds": [
        1,
        14
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/rochester_mills_pennsylvania"
    },
    {
      "id": 2,
      "text": "The village sits on Little Mahoning Creek at about 1,310 feet, a spot chosen for its fertile limestone soils that early farmers prized.",
      "sourceSentenceIds": [
        16,
        29
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/rochester_mills_pennsylvania"
    },
    {
      "id": 3,
      "text": "In 1903, a spur of the Buffalo, Rochester, and Pittsburgh Railway reached Rochester Mills, linking the town to regional coal fields.",
      "sourceSentenceIds": [
        22,
        23
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/rochester_mills_pennsylvania"
    },
    {
      "id": 4,
      "text": "The Works Progress Administration built Savan Dam #3 in 1938 to control flooding on Little Mahoning Creek; the dam was removed in 2016 for restoration.",
      "sourceSentenceIds": [
        17
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/rochester_mills_pennsylvania"
    },
    {
      "id": 5,
      "text": "Marion Center’s first creamery, opened in 1888 near Rochester Mills, produced up to 2,000 pounds of butter daily before closing around 1900.",
      "sourceSentenceIds": [
        4,
        24
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/rochester_mills_pennsylvania"
    },
    {
      "id": 6,
      "text": "Rochester Mills was once called Savan for the local dam and train stop, reflecting how infrastructure shaped its identity.",
      "sourceSentenceIds": [
        15
