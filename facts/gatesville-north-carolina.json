  "facts": [
    {
      "id": 1,
      "text": "Gatesville earned its name in 1830 when the legislature renamed Gates Courthouse after General Horatio Gates, a Revolutionary War hero.",
      "sourceSentenceIds": [
        2,
        3,
        4,
        27
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Gatesville%2C_North_Carolina",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town’s historic courthouse, built in 1836 in a Federal style, now houses the Gates County Public Library and the Historical Society.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://gatescountync.gov/history",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Before becoming Gatesville, the area was known as Bennetts Creek Landing, a modest riverside stop in early colonial times.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Gatesville%2C_North_Carolina",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Gates County, which surrounds the town, was formed in 1779 from parts of Chowan, Hertford, and Perquimans counties.",
      "sourceSentenceIds": [
        25
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://gatescountync.gov/history",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The railroad’s arrival in the late 19th century opened Gates County to new opportunities, linking the town to regional markets.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://gatescountync.gov/history",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Several Gatesville sites, including the Elmwood Plantation and the Roberts-Carter House, are listed on the National Register of Historic Places.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
