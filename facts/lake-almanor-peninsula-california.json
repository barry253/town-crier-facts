  "facts": [
    {
      "id": 1,
      "text": "Lake Almanor Peninsula got its name from the 1920s Great Western Power Company, which built the reservoir to supply electricity to the region.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://clickamericana.com/topics/places/how-lake-almanor-got-its-name-1927"
    },
    {
      "id": 2,
      "text": "After the Prattville town burned in 1910, a concrete and bronze marker was tossed into Lake Almanor by a delegation of Clampers to memorialize the lost community.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.bigdaddyfishing.com/lake-almanor-history.html"
    },
    {
      "id": 3,
      "text": "Lake Almanor Peninsula sits at 40°16′31″N 121°7′36″W, placing it in the high Sierra Nevada foothills of Plumas County.",
