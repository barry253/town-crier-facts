  "facts": [
    {
      "id": 1,
      "text": "In 1847, a pioneer named Williams built an adobe near the abandoned Patwin village of Chah’ de’-he, laying Princeton’s first roots.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Princeton%2C_California"
    },
    {
      "id": 2,
      "text": "Princeton sits just 82 feet above sea level, a modest elevation that keeps the town close to the Sacramento River.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Princeton%2C_California"
    },
    {
      "id": 3,
      "text": "The town’s first commercial hub was the Sixteen-Mile House roadhouse, built in 1851 to serve travelers along the river.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Princeton%2C_California"
    },
    {
      "id": 4,
      "text": "By the 1870s, Princeton’s fertile plains turned into a grain farming boom, earning the town a reputation as a wheat shipping point.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Princeton%2C_California"
    },
    {
      "id": 5,
      "text": "For nearly 130 years, a ferry linked Princeton to Afton across the Sacramento River, a vital link until its 1986 closure.",
      "sourceSentenceIds": [
        10,
        11
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Princeton%2C_California"
    },
    {
      "id": 6,
      "text": "Today, Princeton is best known for Farmers Brewing Company, whose craft beers circulate throughout the region.",
