  "facts": [
    {
      "id": 1,
      "text": "Saint Jo began as Head of Elm in 1849, named for the nearby headwaters of the Elm Fork of the Trinity River.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.stjotx.com/",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Saint Jo sits on the historic Chisholm Trail, where millions of cattle once crossed en route to Kansas.",
      "sourceSentenceIds": [
        12,
        20,
        22
      ],
      "sourceLabels": [
        "Web source 2",
        "Wikipedia"
      ],
      "source": "https://www.saintjochamber.com/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The Stonewall Saloon, once a bustling frontier bar, now serves as a museum preserving late‑19th‑century frontier life.",
      "sourceSentenceIds": [
        17,
        23
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/St._Jo%2C_Texas",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Every June, the Saint Jo Chamber holds a meeting at the Civic Center to plan community events and support local businesses.",
