  "facts": [
    {
      "id": 1,
      "text": "Ashland was founded in 1886, originally called Straders after the first postmaster, and renamed Ashland the same year.",
      "sourceSentenceIds": [
        17,
        18
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Ashland%2C_Montana",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town sits just east of the Northern Cheyenne Indian Reservation and along the Tongue River.",
      "sourceSentenceIds": [
        14
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Ashland%2C_Montana",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Labre Indian Catholic High School, established in 1884 as a boarding school by a Catholic mission, remains a historic landmark in Ashland.",
      "sourceSentenceIds": [
        16
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Ashland%2C_Montana",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Ashland’s historic church, built with tepee‑shaped architecture, features a smoke‑hole opening at the top that reflects Plains Indian design.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://discoveringmontana.com/towns/ashland/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The town hosts the Cheyenne Indian Museum and Ten Bears Gallery, both celebrating Native American heritage.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.visitmt.com/cities-towns/ashland",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Rosebud Battlefield State Park, just outside Ashland, preserves over 3,000 acres of land that was a National Historic Landmark since 2008.",
      "sourceSentenceIds": [
        9
