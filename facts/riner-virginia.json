  "facts": [
    {
      "id": 1,
      "text": "Riner began as Five Forks, a spontaneous crossroads where five roads met, serving local farmers before the Civil War.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/riner_historic_district",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "In 1882 the post office renamed the village Riner after farmer David Riner, avoiding confusion with another Auburn.",
      "sourceSentenceIds": [
        14,
        20,
        25
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/riner_historic_district",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The Riner Historic District, covering about 22 acres, was added to the National Register in 1991 and contains 18 buildings from 1850‑1920s.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/riner_historic_district",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The mid‑1850s Christiansburg and Floyd Turnpike ran through Riner, linking it to the railroad in Christiansburg and boosting post‑Civil War commerce.",
      "sourceSentenceIds": [
        11
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/riner_historic_district",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Key historic structures include the 1908 Methodist Episcopal Church and the 1913 former Bank of Riner, now empty or repurposed.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.dhr.virginia.gov/historic-registers/060-0044/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Riner’s first industry was a sawmill started in 1808, marking the town’s early economic roots.",
      "sourceSentenceIds": [
        17
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Riner%2C_Virginia",
      "category": "economy",
      "quality": "good"
    }
