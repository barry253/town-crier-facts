  "facts": [
    {
      "id": 1,
      "text": "Seocho District’s name comes from Seocho-dong, where Gangnam station sits, originally part of Gangnam District.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Seocho_District",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The area that is now Seocho-gu was once called Wiryesong, a fortress castle in the western part of the district.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Seocho_District",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The Seoul Arts Center, a cultural hub in Seocho, opened its Opera House in 1993 and draws nearly 3 million visitors each year.",
      "sourceSentenceIds": [
        18,
        29
      ],
      "sourceLabels": [
        "Wikipedia",
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Seocho_District",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Samsung’s major office park, Samsung Town, sits in Seocho and hosts many of the conglomerate’s key buildings.",
      "sourceSentenceIds": [
        22
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Seocho_District",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Seocho lies beside the Han River, an area inhabited since prehistoric times and long considered the cradle of Korean civilization.",
      "sourceSentenceIds": [
        8,
        11
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Seocho_District",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The National Gugak Center, founded in 1951 in Bangbae 3‑dong, preserves Korean court and folk music.",
