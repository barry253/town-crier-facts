  "facts": [
    {
      "id": 1,
      "text": "SoFA District is home to the historic California Theater, where the annual Cinequest film festival premieres each spring.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/SoFA_District",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Local business owners named the district SoFA after the San Jose Redevelopment Agency’s failed “Market Gateway” proposal.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/SoFA_District",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "In the late 1980s, councilwoman Susan Hammer led an initiative that removed adult businesses from SoFA, reshaping its nightlife.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/SoFA_District",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Arts Place gave $500,000 in 2011 to fund a SoFA Initiative that turned Parque de los Pobladores into an outdoor living room.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/SoFA_District",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "SoFA hosts a calendar of festivals, including South First Fridays, the SoFA Street Fair, and the Zero1 Biennial.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/SoFA_District",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The three blocks of South First Street grew organically into a nightlife hub with clubs, theaters, restaurants, galleries, and design firms.",
      "sourceSentenceIds": [
