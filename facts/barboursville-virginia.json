  "facts": [
    {
      "id": 1,
      "text": "Barboursville takes its name from Governor James Barbour, whose estate became the town’s founding site.",
      "sourceSentenceIds": [
        2,
        4
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Barboursville%2C_Virginia"
    },
    {
      "id": 2,
      "text": "The ruins of Barbour’s mansion, the only Jefferson‑designed building in Orange County, now serve as a dramatic backdrop for local theater.",
      "sourceSentenceIds": [
        1,
        25,
        28
      ],
      "sourceLabels": [
        "Web source 2",
        "Wikipedia",
        "Wikipedia"
      ],
      "source": "https://www.islands.com/2001293/barboursville-virginia-community-close-shenandoah-national-park-historic-escape-arts-charm/"
    },
    {
      "id": 3,
      "text": "Barboursville Vineyards occupies the historic Barbour farmland and is one of Virginia’s first significant wineries.",
      "sourceSentenceIds": [
        5,
        21
      ],
      "sourceLabels": [
        "Wikipedia",
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Barboursville%2C_Virginia"
    },
    {
      "id": 4,
      "text": "Four County Players, founded in 1973, is Central Virginia’s longest‑running community theater and stages productions at the ruins.",
      "sourceSentenceIds": [
        3,
        28
      ],
      "sourceLabels": [
        "Wikipedia",
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Barboursville%2C_Virginia"
    },
    {
      "id": 5,
      "text": "A fire in 1884 consumed Barbour’s mansion, leaving the ruins that still stand as a landmark today.",
      "sourceSentenceIds": [
        24,
        1
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 2"
      ],
      "source": "https://en.wikipedia.org/wiki/Barboursville%2C_Virginia"
    },
    {
      "id": 6,
      "text": "Barboursville sits at the intersection of VA 20 and US 33, a historic travel corridor through the Piedmont.",
