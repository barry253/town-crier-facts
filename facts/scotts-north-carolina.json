    },
    {
      "id": 3,
      "text": "Scotts sits 8 miles west-northwest of Statesville, 45 miles northwest of Charlotte, within the Charlotte‑Concord‑Gastonia metro area.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Web source 1"
