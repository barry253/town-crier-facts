    {
      "id": 1,
      "text": "Newtonia was the site of the 1862 Battle of Newtonia, the only Civil War battle to feature Native American regiments on both sides.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.newtoncountytourism.org/area-activities/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The Ritchey Mansion, built in 1852, survived two Civil War battles and now stands as Newtonia’s centerpiece of Civil War history.",
      "sourceSentenceIds": [
        6,
        7
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.newtoncountytourism.org/area-activities/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Granby Miners Museum, founded to tell Granby's mining story, also chronicles Newtonia’s own town history.",
      "sourceSentenceIds": [
        1,
        8
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.newtoncountytourism.org/area-activities/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Newtonia lies on Missouri Route 86, approximately nine miles east of Neosho.",
