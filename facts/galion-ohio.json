  "facts": [
    {
      "id": 1,
      "text": "Galion's name came from a 1824 petition; postmaster John McLean changed it from Goshen to Galion because another town had that name.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Galion%2C_Ohio",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The city’s first newspaper, The District Democrat, started in 1855 and later became The Galion Train.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Galion%2C_Ohio",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "In 1851 the Cleveland Columbus and Cincinnati Railroad, later the Big Four, began stopping in Galion, turning it into a rail hub that grew the town for a century.",
      "sourceSentenceIds": [
        25,
        29
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Galion%2C_Ohio",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The Galion History Center, opened July 1, 2021, preserves the city’s heritage and hosts events like Depot Days at the historic Big Four Depot.",
      "sourceSentenceIds": [
        6,
        4,
        5
      ],
      "sourceLabels": [
        "Web source 2",
        "Wikipedia"
      ],
      "source": "https://www.galionhistory.com/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The Galion Community Theatre, founded in 1972, operates in a downtown historic building and has been a cultural cornerstone for local talent.",
