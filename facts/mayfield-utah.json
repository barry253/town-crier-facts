  "facts": [
    {
      "id": 1,
      "text": "Mayfield was settled in 1871 by founding families including the Andersons, Petersons, Bartholomews, Jensens, Sorensens, and Willdens.",
      "sourceSentenceIds": [
        9,
        10
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Mayfield%2C_Utah"
    },
    {
      "id": 2,
      "text": "The town of Mayfield was named for the beauty that Mother Nature displayed in the month of May.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.sanpetecountyutah.gov/231/Mayfield"
    },
    {
      "id": 3,
      "text": "Mayfield is pleasantly situated on Twelve Mile Creek in the southern part of Sanpete County.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://mymayfield.org/"
    },
    {
      "id": 4,
      "text": "Early settlers learned that the area of Mayfield was considered a sacred healing ground by the local Indians.",
      "sourceSentenceIds": [
        11
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Mayfield%2C_Utah"
    },
    {
      "id": 5,
      "text": "The land at the mouth of Twelve-Mile Canyon was once an Indian Farm reservation known as Arrapine Valley.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.sanpetecountyutah.gov/231/Mayfield"
    },
    {
      "id": 6,
      "text": "Local tradition says that no fighting has ever occurred within the town of Mayfield.",
      "sourceSentenceIds": [
