  "facts": [
    {
      "id": 1,
      "text": "Fort Hunter was built in 1712 by English colonists near the Mohawk village of Tionondoroge to defend against French incursions.",
      "sourceSentenceIds": [
        23
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Fort_Hunter%2C_New_York"
    },
    {
      "id": 2,
      "text": "The fort’s Anglican chapel, first a log structure, was replaced by a stone church in 1741, serving both Mohawk and settlers.",
      "sourceSentenceIds": [
        26
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Fort_Hunter%2C_New_York"
    },
    {
      "id": 3,
      "text": "In 1710, three Mohawk chiefs and a Mahican leader traveled to England as the “Four Kings” to request Anglican missionaries.",
      "sourceSentenceIds": [
        11
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/fort_hunter_new_york"
    },
    {
      "id": 4,
      "text": "The hamlet sits on the south bank of the Mohawk River where it meets Schoharie Creek, about 30 miles west of Albany.",
      "sourceSentenceIds": [
        6,
        7
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/fort_hunter_new_york"
    },
    {
      "id": 5,
      "text": "Today, the only surviving colonial building is the restored Parsonage, now a private home, within the Schoharie Crossing State Historic Site.",
      "sourceSentenceIds": [
        18
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/fort_hunter_new_york"
    },
    {
      "id": 6,
      "text": "The fort was dismantled in 1820 to make way for the Erie Canal, ending its military role.",
      "sourceSentenceIds": [
        28
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Fort_Hunter%2C_New_York"
    }
  ]
