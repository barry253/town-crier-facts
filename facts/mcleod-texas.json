  "facts": [
    {
      "id": 1,
      "text": "McLeod sits in the Rodessa oilfield on Farm Road 125, thirteen miles southeast of Atlanta in southeastern Cass County.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.tshaonline.org/handbook/entries/mcleod-tx"
    },
    {
      "id": 2,
      "text": "Before oil, the area was a sparsely settled farming community known locally as Good Exchange until the mid‑1930s.",
      "sourceSentenceIds": [
        17
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.tshaonline.org/handbook/entries/mcleod-tx"
    },
    {
      "id": 3,
      "text": "A post office opened in May 1937, and by 1939 McLeod already had a consolidated school, nine businesses, and two churches.",
      "sourceSentenceIds": [
        18
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.tshaonline.org/handbook/entries/mcleod-tx"
    },
    {
      "id": 4,
      "text": "From 1974 through 1990 the town’s population hovered around fifty residents.",
      "sourceSentenceIds": [
        19
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.tshaonline.org/handbook/entries/mcleod-tx"
    },
    {
      "id": 5,
      "text": "In 1986 McLeod had only one rated business, reflecting its small‑town character.",
      "sourceSentenceIds": [
        19
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.tshaonline.org/handbook/entries/mcleod-tx"
    },
    {
      "id": 6,
      "text": "McLeod’s early growth was tied to the oil boom that transformed the region from a quiet farming area.",
      "sourceSentenceIds": [
        17
      ],
