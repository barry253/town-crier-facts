    },
    {
      "id": 2,
      "text": "Grant Town is a community on Paw Paw Creek that served as a prosperous coal mining town for many years.",
      "sourceSentenceIds": [
        5,
        6
      ],
      "sourceLabels": [
        "Web source 1",
        "Web source 2"
      ],
      "source": "https://www.wvgw.net/marion//towns/granttownhis.html"
    },
    {
      "id": 3,
      "text": "The local mine in Grant Town was once the largest underground coal mine in the world in terms of gross production.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Grant_Town%2C_West_Virginia"
    },
    {
      "id": 4,
      "text": "Grant Town is home to an eighty megawatt electrical generation facility that burns waste coal using a fluidized bed combustion process.",
      "sourceSentenceIds": [
