  "facts": [
    {
      "id": 1,
      "text": "Roanoke was officially incorporated as a village in 1874, two years after its plat was laid out in 1872 and lots were offered for sale.",
      "sourceSentenceIds": [
        12,
        14
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Roanoke%2C_Illinois"
    },
    {
      "id": 2,
      "text": "The village’s name comes from Roanoke, Virginia, where some of its earliest settlers had arrived.",
      "sourceSentenceIds": [
        17
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Roanoke%2C_Illinois"
    },
    {
      "id": 3,
      "text": "A coal mine operated in Roanoke from 1881 to 1940, employing around 300 men and hoisting 500 tons of coal a day at its peak.",
      "sourceSentenceIds": [
        19,
        21
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Roanoke%2C_Illinois"
    },
    {
      "id": 4,
      "text": "The abandoned mine left a slag mound called the “Jumbo,” which still stands today topped with an electric star lit each Christmas.",
      "sourceSentenceIds": [
        27,
        29
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Roanoke%2C_Illinois"
    },
    {
      "id": 5,
      "text": "The original Roanoke rail station still stands as a historic building, a reminder of the town’s railroad era.",
