      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Between 1961 and 1989, the Berlin Wall crossed Buckow's borders with Brandenburg, marking it as a frontier zone.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
