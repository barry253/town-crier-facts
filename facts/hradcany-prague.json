  "facts": [
    {
      "id": 1,
      "text": "Hradcany was founded in the 14th century to serve the massive 9th‑century castle, a place that feels heavy with history.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://visitcity.travel/en/prague/district/hradcany"
    },
    {
      "id": 2,
      "text": "The castle complex dominates the skyline, home to St Vitus Cathedral and the Strahov Monastery.",
      "sourceSentenceIds": [
        6,
        12
      ],
      "sourceLabels": [
        "Web source 2",
        "Wikipedia"
      ],
      "source": "https://visitcity.travel/en/prague/district/hradcany"
    },
    {
      "id": 3,
      "text": "Golden Lane’s miniature houses, built in the 17th and 18th centuries, now form a fairy‑tale street.",
      "sourceSentenceIds": [
        18
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.guide-prague.org/en/praha/hradcany/"
    },
    {
      "id": 4,
      "text": "Loreta, a pilgrimage site, shelters the Holy House from Loretto, Italy, brought after the Saracens’ invasion.",
      "sourceSentenceIds": [
        20,
        21,
        22,
        23
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.guide-prague.org/en/praha/hradcany/"
    },
    {
      "id": 5,
      "text": "Hradcany remained an independent borough until 1784, when it merged into the unified city of Prague.",
      "sourceSentenceIds": [
        15
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Hrad%C4%8Dany"
    },
    {
