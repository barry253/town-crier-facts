      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "In 1890 the Dallas and Waco Railway reached Milford, turning it into a key shipping point for cotton farmers.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
