      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The Belpre Historical Society runs the Farmers Castle Museum, a volunteer‑run collection that traces the town’s history back to the late 1700s.",
      "sourceSentenceIds": [
        2,
        6,
        7,
        11
      ],
