  "facts": [
    {
      "id": 1,
      "text": "Belpre’s name comes from the French “Belle Prairie,” meaning beautiful meadow, a term French trappers used for the valley.",
      "sourceSentenceIds": [
        20
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
