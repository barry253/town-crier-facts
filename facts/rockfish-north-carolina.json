  "facts": [
    {
      "id": 1,
      "text": "Rockfish Manufacturing Company, founded in 1836 and opened in 1839, was North Carolina\u2019s nineteenth cotton mill and the largest in the state before the Civil War.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.dncr.nc.gov/blog/2024/01/03/rockfish-factory-i-92",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The factory operated 4,400 spindles and 118 looms, supported by a $131,000 capital investment.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.dncr.nc.gov/blog/2024/01/03/rockfish-factory-i-92",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "By 1865, founder Charles Peter Mallett, then ninety\u2011three, had transferred the mill\u2019s operation to his son, Charles Beatty Mallett.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.dncr.nc.gov/blog/2024/01/03/rockfish-factory-i-92",
      "category": "people",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Rockfish lies in eastern Hoke County, just east of Stewarts Creek, and borders Fayetteville across the creek.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Rockfish%2C_North_Carolina",
      "category": "other",
      "quality": "poor",
      "qualityReason": "location_description"
    },
    {
      "id": 5,
      "text": "The town\u2019s waterways drain into Rockfish Creek, an east\u2011flowing tributary of the Cape Fear River.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Rockfish%2C_North_Carolina",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "In March 1865, Sherman\u2019s troops burned eight of nine Cumberland County cotton mills; Rockfish was the only one that survived the fire.",
      "sourceSentenceIds": [
        30
