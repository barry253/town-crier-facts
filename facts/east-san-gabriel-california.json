      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Before becoming a community, the land that is now East San Gabriel was part of the San Gabriel Valley’s agricultural landscape.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 1"
      ],
