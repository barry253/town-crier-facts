  "facts": [
    {
      "id": 1,
      "text": "Painted Hills emerged mid‑20th century as a private residential lake community centered on two man‑made lakes.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/painted_hills_indiana"
    },
    {
      "id": 2,
      "text": "Lake Holiday and Lake Nebo together cover 196 acres (79 ha) of water.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Painted_Hills%2C_Indiana"
    },
    {
      "id": 3,
      "text": "The lakes sit on Camp Creek, a south‑flowing tributary that feeds Indian Creek and eventually the White River.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Painted_Hills%2C_Indiana"
    },
    {
      "id": 4,
      "text": "Indiana State Road 252 forms the community’s northeast border, running parallel to the lakes.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Painted_Hills%2C_Indiana"
    },
    {
      "id": 5,
      "text": "Painted Hills spans 1.95 square miles, with about 11% water from the lakes.",
      "sourceSentenceIds": [
        16,
        19
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://kids.kiddle.co/Painted_Hills,_Indiana"
    },
    {
      "id": 6,
      "text": "The community lies at 39°19′58″N 86°16′51″W, just off State Road 252 near Martinsville.",
