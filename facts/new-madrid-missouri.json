    {
      "id": 2,
      "text": "The city sits on the north side of the Kentucky Bend, where the Mississippi curves around an exclave of Fulton County, Kentucky.",
      "sourceSentenceIds": [
        20
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
