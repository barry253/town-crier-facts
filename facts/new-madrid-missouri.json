      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The New Madrid Historical Museum, housed in the former Kendall Saloon on Main Street, showcases history from the Mississippian period to the early 20th century.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 2"
