    {
      "id": 2,
      "text": "Hudson takes its name from Hudson, Iowa, the native home of many of the town's early settlers.",
      "sourceSentenceIds": [
        11
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Hudson%2C_South_Dakota"
    },
    {
      "id": 3,
      "text": "Sixteen young men originally settled the area in 1868, naming the site Eden for its fertile, garden-like soil.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/hudson_south_dakota"
    },
    {
      "id": 4,
      "text": "Residents relocated the town northward in 1878 to align with the Southern Dakota and Pembina Railroad tracks.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/hudson_south_dakota"
    },
    {
      "id": 5,
      "text": "The Hudson Boy Scout Cabin, built in 1940 using native fieldstone, is listed on the National Register of Historic Places.",
      "sourceSentenceIds": [
