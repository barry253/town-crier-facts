  "facts": [
    {
      "id": 1,
      "text": "White Plains house built 1786 by Aaron Thornley, early surveyor of King George County.",
      "sourceSentenceIds": [
        17,
        14
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.kinggeorgehistory.org/post/white-plains",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The two‑and‑a‑half‑story frame home blends late Georgian and Federal styles, later enhanced with Colonial Revival touches in the 1940s.",
      "sourceSentenceIds": [
        18,
        19,
        22,
        11
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.kinggeorgehistory.org/post/white-plains",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "In 2019, White Plains received the Northern Neck Historical Society’s John Paul Hanbury Award for its award‑winning restoration.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.kinggeorgehistory.org/post/white-plains",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The property sits on 38 acres with a terraced yard dating to the home’s earliest years.",
      "sourceSentenceIds": [
        20
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.kinggeorgehistory.org/post/white-plains",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "White Plains was listed on the National Register of Historic Places in 1982, recognizing its architectural significance.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/White_Plains%2C_Virginia",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The house’s restoration preserved much of its historic fabric, avoiding excessive “colonialization” of original elements.",
