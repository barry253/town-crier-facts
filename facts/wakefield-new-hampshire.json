  "facts": [
    {
      "id": 1,
      "text": "Wakefield Corner, the original town center, sits on a picturesque hilltop lined with antique buildings.",
      "sourceSentenceIds": [
        27
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Wakefield%2C_New_Hampshire",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "In 1749, John Mason granted the land that would become Wakefield to settlers from Dover and Portsmouth.",
      "sourceSentenceIds": [
        5,
        30
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Wakefield%2C_New_Hampshire",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The railroad arrived in 1871, shifting commerce from Wakefield Corner to the new village of Sanbornville.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://historicwakefieldnh.com/history-of-wakefield",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Wakefield’s many lakes and streams powered early industry, while the 1900s saw 25 trains daily through Sanbornville.",
      "sourceSentenceIds": [
        7,
        8
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://historicwakefieldnh.com/history-of-wakefield",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The Wakefield-Brookfield Historical Society, founded in 1938, preserves three historic buildings listed on the National Register.",
      "sourceSentenceIds": [
        1,
        11
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.wakefieldbrookfieldhistoricalsociety.org/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "In 1944 the Little Red Schoolhouse closed, and by 1956 the Historical Society owned it for $1, later receiving a $36,960 LCHIP grant for renovation.",
      "sourceSentenceIds": [
