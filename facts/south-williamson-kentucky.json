  "facts": [
    {
      "id": 1,
      "text": "South Williamson, once called Stone, was settled in the late 18th century on land owned by Benjamin Williamson and never had its own post office.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/south_williamson_kentucky",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "South Williamson lies in the Tug Fork valley that was the heart of the Hatfield‑McCoy feud between West Virginia's Hatfields and Kentucky's McCoys from 1865 to 1890.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/south_williamson_kentucky",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The Norfolk and Western Railway arrived in the 1890s, opening South Williamson to large‑scale coal extraction and transport.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/south_williamson_kentucky",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "South Williamson is protected by a floodwall, built by the US Army Corps of Engineers in response to a devastating flood along the Tug Fork River in 1977.",
      "sourceSentenceIds": [
        19
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/South_Williamson%2C_Kentucky",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "South Williamson's median age is 55.9, noticeably older than Kentucky's state median of 39.1.",
      "sourceSentenceIds": [
        26
      ],
      "sourceLabels": [
        "Web source 1"
      ],
