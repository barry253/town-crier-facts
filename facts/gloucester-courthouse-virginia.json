  "facts": [
    {
      "id": 1,
      "text": "Gloucester Courthouse sits in the historic Court Circle, where the Visitor Center hosts a room dedicated to the story of Werowocomoco.",
      "sourceSentenceIds": [
        4,
        7
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://visitgloucesterva.org/tourism/visitor-center",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The Visitor Center itself is housed in the Colonial Courthouse Annex, right next to the courthouse.",
      "sourceSentenceIds": [
        23
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://visitgloucesterva.org/tourism/visitor-center",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The Gloucester County Courthouse Square Historic District, along with nearby sites like Abingdon Glebe House and Cappahosic House, is listed on the National Register of Historic Places.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Gloucester_Courthouse%2C_Virginia",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Three of Gloucester’s oldest homes—Walker House, Ware Parish Church, and Warner Hall—are also on the National Register.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Gloucester_Courthouse%2C_Virginia",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "In 2025, Gloucester released a commemorative ornament featuring the historic Ware Episcopal Church, celebrating local heritage.",
