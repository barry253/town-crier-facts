  "facts": [
    {
      "id": 1,
      "text": "Ashkelon is one of the world's oldest cities, with settlement since about 7900 BCE, later a major Canaanite and Philistine port.",
      "sourceSentenceIds": [
        15,
        17
      ],
      "sourceLabels": [
        "Web source 1",
        "Web source 2"
      ],
      "source": "https://www.trawellino.com/destinations/israel/southern-district_ashkelon",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The modern city takes its name from ancient Ascalon, whose ruins sit on the southwestern edge of today’s metropolis.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Ashkelon",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The town was founded in 1949 near the Palestinian town of al-Majdal, originally called Migdal, meaning “tower.”.",
      "sourceSentenceIds": [
        2,
        29
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Ashkelon",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "In 1949–1950, three immigrant transit camps were set up beside Migdal for Jewish refugees from Arab countries, Romania, and Poland.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Ashkelon",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The Jewish Eye film festival, an annual Jewish world film event, is held each year in Ashkelon.",
