  "facts": [
    {
      "id": 1,
      "text": "New Hope began as William Cloud’s 1829 settlement called Cloud’s Town, was incorporated as Vienna in 1832, and renamed New Hope in 1883 after a local church.",
      "sourceSentenceIds": [
        1,
        10
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/New_Hope%2C_Alabama",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "During the Civil War, Union troops burned Vienna on December 15, 1864, leaving only the post office and Masonic Lodge standing.",
      "sourceSentenceIds": [
        8,
        9
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/New_Hope%2C_Alabama",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Milus “Bushwhacker” Johnston led a band of guerrilla fighters that constantly harassed federal troops in the area.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.newhopeal.gov/about-new-hope/bio-of-city/continued/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The original Cloud’s Town settlement lies in what is now Cloud’s Cove, just off Hobbs Island Road, a few miles from New Hope.",
      "sourceSentenceIds": [
        11
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/New_Hope%2C_Alabama",
