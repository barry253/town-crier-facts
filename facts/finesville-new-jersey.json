  "facts": [
    {
      "id": 1,
      "text": "Finesville’s name comes from the Lenape term meaning \"stream between split hills,\" echoing the area’s early Native American heritage.",
      "sourceSentenceIds": [
        4,
        10
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Pohatcong_Township%2C_New_Jersey",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Pohatcong Township, where Finesville sits, was officially created in 1881 and incorporated the next year, carving itself from Greenwich Township.",
      "sourceSentenceIds": [
        5,
        6,
        7,
        8,
        9
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Pohatcong_Township%2C_New_Jersey",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The Norfolk Southern Railway’s Lehigh Line, once the mainline of the Lehigh Valley Railroad, still cuts through Finesville on its way to Phillipsburg.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Pohatcong_Township%2C_New_Jersey",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "In 1911 the township’s industrial core split off to become Alpha borough, leaving Finesville surrounded by a doughnut town.",
      "sourceSentenceIds": [
        11,
        14
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Pohatcong_Township%2C_New_Jersey",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The Phillipsburg Mall straddles the border of Pohatcong and Lopatcong, with 43 acres of its property lying within Finesville’s limits.",
      "sourceSentenceIds": [
        28,
        29
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Pohatcong_Township%2C_New_Jersey",
      "category": "other",
      "quality": "poor",
      "qualityReason": "vague"
    },
    {
      "id": 6,
      "text": "Finesville is governed under the Faulkner Act’s small‑municipality form, a structure that shapes local decision‑making.",
