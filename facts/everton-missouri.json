  "facts": [
    {
      "id": 1,
      "text": "Everton was named by railroad officials after a man named Evert or Everett, though the exact namesake remains unknown.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Everton%2C_Missouri",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Dye's Park, just south of downtown, houses the historic Dade County Courthouse—also called the Penn Cabin—the county’s first courthouse.",
      "sourceSentenceIds": [
        6,
        10
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Everton%2C_Missouri",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The 1921 Sanborn Fire Insurance Map of Everton shows the town’s layout, including labeled businesses and the footprint of the old courthouse.",
      "sourceSentenceIds": [
        18
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://roadsidethoughts.com/mo/everton-xx-dade-profile.htm",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Everton is one of five U.S. communities that share its name, with others in Arkansas, Indiana, New York, and North Carolina.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://roadsidethoughts.com/mo/everton-xx-dade-profile.htm",
      "category": "other",
      "quality": "poor",
      "qualityReason": "vague"
    },
    {
      "id": 5,
      "text": "The town’s first mention appears in both the FIPS‑55 and GNIS databases, marking its official recognition in federal records.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://roadsidethoughts.com/mo/everton-xx-dade-profile.htm",
      "category": "other",
      "quality": "poor",
      "qualityReason": "vague"
    },
