    },
    {
      "id": 2,
      "text": "German immigrant Sofio Henkel founded the town in 1841, mining zinc until Apache raids drove him away in 1843.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Hanover%2C_New_Mexico"
    },
    {
      "id": 3,
      "text": "The town boasted the Emerald Zinc Mine, built during World War I, and also mined copper.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.newmexico.org/places-to-visit/ghost-towns/hanover-fierro/"
    },
    {
      "id": 4,
      "text": "A post office opened in Hanover in 1892, marking its official establishment.",
