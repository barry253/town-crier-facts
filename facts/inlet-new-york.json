  "facts": [
    {
      "id": 1,
      "text": "Inlet earned its name from its position at the eastern end of Fourth Lake, the last of the Fulton Chain of Lakes.",
      "sourceSentenceIds": [
        16
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Inlet%2C_New_York"
    },
    {
      "id": 2,
      "text": "The town of Inlet was carved out of Morehouse in 1901, briefly becoming an incorporated village before reverting to town status.",
      "sourceSentenceIds": [
        4,
        19
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Inlet%2C_New_York"
    },
    {
      "id": 3,
      "text": "Inlet has been a hub of Adirondack tourism for more than a century, drawing sportsmen and vacationers to its lakes and trails.",
      "sourceSentenceIds": [
        20
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Inlet%2C_New_York"
    },
    {
      "id": 4,
      "text": "The Arrowhead Hotel, once a popular resort, now hosts the Arrowhead Park and was the site where Chester Gillette was arrested after the 1906 murder of Grace Brown.",
      "sourceSentenceIds": [
        24
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Inlet%2C_New_York"
    },
    {
      "id": 5,
      "text": "The Inlet Historical Society, founded in 2009, launched an online archive that now hosts over sixty articles on local history and early property rolls.",
      "sourceSentenceIds": [
        5,
        10,
        12
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.adirondackexplorer.org/communities/history/inlet-historical-society-expands-history-selections-on-its-website/"
    },
    {
      "id": 6,
      "text": "Inlet sits on the western edge of Hamilton County, bordered by the Moose River to the south and the town of Herkimer County to the west.",
