  "facts": [
    {
      "id": 1,
      "text": "Glendale Colony was founded in 1969 when a group split from New Rockport Hutterite Colony near Choteau, Montana.",
      "sourceSentenceIds": [
        1,
        2
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/glendale_colony_montana"
    },
    {
      "id": 2,
      "text": "The colony sits inside the Blackfeet Indian Reservation, about 17 miles northwest of Cut Bank in Glacier County.",
      "sourceSentenceIds": [
        4,
        5,
        26
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Glendale_Colony%2C_Montana"
    },
    {
      "id": 3,
      "text": "At 4,032 feet above sea level, Glendale Colony enjoys a high‑altitude prairie climate shaped by nearby mountains.",
      "sourceSentenceIds": [
        30
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/glendale_colony_montana"
    },
    {
      "id": 4,
      "text": "The community practices communal living, pacifism, and an agriculture‑based economy, typical of the Lehrerleut Hutterite tradition.",
      "sourceSentenceIds": [
        1,
        24
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/glendale_colony_montana"
    },
    {
      "id": 5,
      "text": "In 2002, Glendale Colony split to form Twin Hills Hutterite Colony near Carter, expanding its communal reach.",
      "sourceSentenceIds": [
        22
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/glendale_colony_montana"
    },
    {
      "id": 6,
      "text": "The colony’s fertile plains were chosen for farming and ranching, despite the challenges of building infrastructure in a remote semi‑arid region.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/glendale_colony_montana"
    }
  ]
