  "facts": [
    {
      "id": 1,
      "text": "Rudolfsheim‑Fünfhaus was formed in 1863 when Reindorf, Braunhirschen, and Rustendorf merged into a municipality named after Crown Prince Rudolf.",
      "sourceSentenceIds": [
        1,
        3
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 2"
      ],
      "source": "https://en.wikipedia.org/wiki/Rudolfsheim-F%C3%BCnfhaus",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The district’s coat of arms features a brown deer, echoing Braunhirschen’s historic inn, and a grapevine representing Reindorf’s former vineyards.",
      "sourceSentenceIds": [
        2,
        8
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Rudolfsheim-F%C3%BCnfhaus",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Textile, leather, and food‑processing factories once dotted the area, around which entire blocks of municipal housing were built.",
      "sourceSentenceIds": [
        11
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://vienna-property.com/en/15-j-rajon-veny-rudolfshajm-fyunfhaus/",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The Vienna River, once a wide prehistoric channel, flowed through the district’s early landscape, shaping its gravel terraces.",
      "sourceSentenceIds": [
        12
