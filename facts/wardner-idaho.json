  "facts": [
    {
      "id": 1,
      "text": "Wardner takes its name from Joe—or Jim—Wardner, a mining promoter and early land seller who helped launch the Bunker Hill and Sullivan mine.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Wardner%2C_Idaho",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The district’s largest mine, the Bunker Hill Mill in Wardner, became a flashpoint for labor conflicts during the Silver Valley mining boom.",
      "sourceSentenceIds": [
        27
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://westernmininghistory.com/towns/idaho/wardner/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Wardner’s early growth hinged on the railroad, which laid tracks that connected the town to regional mining centers.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://hometownhistorymaps.com/pages/history-of-wardner-idaho",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Historic Sanborn maps from 1891 to 1908 let us see Wardner’s streets, businesses, and buildings exactly as they appeared over a century ago.",
      "sourceSentenceIds": [
        11
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://hometownhistorymaps.com/pages/history-of-wardner-idaho",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Old downtown Wardner once featured a mix of schools, hotels, factories, churches, and storefronts that reflected everyday life in a mining town.",
