  "facts": [
    {
      "id": 1,
      "text": "Malasaña takes its name from Manuela Malasaña, a 15‑year‑old heroine executed by French troops after the 1808 Dos de Mayo uprising.",
      "sourceSentenceIds": [
        1,
        4
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Malasa%C3%B1a",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The Dos de Mayo uprising of 1808, the most dramatic moment in Malasaña’s history, sparked a citywide revolt against the French.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.themakingofmadrid.com/2026/02/17/guide-to-malasana-madrids-alternative-neighbourhood/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Typical Malasaña buildings rise four to six stories, all painted in a uniform hue and crowned with French balconies.",
      "sourceSentenceIds": [
        26,
        27
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Malasa%C3%B1a",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "In the late 1970s and 1980s, Malasaña became the epicenter of Madrid’s movida, a counter‑cultural wave that reshaped the city.",
      "sourceSentenceIds": [
        25
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Malasa%C3%B1a",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The Real Hospicio del Ave María y Santo Rey Don Fernando now houses the Municipal Museum, showcasing Madrid’s urban evolution and local customs.",
      "sourceSentenceIds": [
        5,
        6
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.esmadrid.com/en/madrid-neighbourhoods/malasana",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Inside Malasaña’s permanent contemporary art gallery and library, visitors can view handwritten manuscripts by Christopher Columbus.",
