  "facts": [
    {
      "id": 1,
      "text": "Manchester was founded in 1807 as the seat of newly formed Clay County on a 10‑acre parcel near Lower Goose Creek Salt Works.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Manchester%2C_Kentucky"
    },
    {
      "id": 2,
      "text": "The town was renamed Manchester in December after the English industrial city, avoiding a duplicate Greenville name.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Manchester%2C_Kentucky"
    },
    {
      "id": 3,
      "text": "Manchester hosts the Clay County Public Library, serving residents with books, research, and community programs.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Manchester%2C_Kentucky"
    },
    {
      "id": 4,
      "text": "A federal prison offering minimum‑and medium‑security facilities sits in Manchester, a unique feature for a small Kentucky town.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Manchester%2C_Kentucky"
    },
    {
      "id": 5,
      "text": "Outdoor enthusiasts enjoy the Goose Creek Swinging Bridge and Big Hickory Golf Course, both highlighted on local tourism maps.",
      "sourceSentenceIds": [
        4
      ],
