  "facts": [
    {
      "id": 1,
      "text": "Gamla Stan means 'the old town', with 'Gamla' meaning old and 'stan' a contraction of staden, the town.",
      "sourceSentenceIds": [
        22
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Gamla_Stan",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Stortorget, the large square in Gamla Stan, was the site of the 1520 Stockholm Bloodbath where nobles were massacred.",
      "sourceSentenceIds": [
        30
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Gamla_Stan",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The Nobel Museum sits in the former Stock Exchange building on Gamla Stan, opened in 2001 to mark the prize’s centenary.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.city-guide-stockholm.com/en/tourism/discover-stockholm/neighborhood-by-neighborhood/gamla-stan.html",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Gamla Stan, Stockholm’s oldest district, was founded in the 13th century and still preserves medieval alleyways and cobbled streets.",
      "sourceSentenceIds": [
        23
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.visitstockholm.com/stockholms-districts/gamla-stan/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "After a 15th‑century fire, the medieval marketplace was enlarged and eventually became the public square Stortorget.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Gamla_Stan",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Gamla Stan primarily occupies the island Stadsholmen and includes nearby islets Riddarholmen, Helgeandsholmen and Strömsborg.",
      "sourceSentenceIds": [
        25
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Gamla_Stan",
      "category": "landmark",
      "quality": "good"
    }
