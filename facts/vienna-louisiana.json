  "facts": [
    {
      "id": 1,
      "text": "Vienna, Louisiana, was first settled by Daniel Colvin around 1812, whose house sat beside the trail linking Monroe to Shreveport.",
      "sourceSentenceIds": [
        13,
        14
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Vienna%2C_Louisiana"
    },
    {
      "id": 2,
      "text": "In 1838, Jephthah Colvin opened the region's first post office, originally called Colvin's Post Office, before the town adopted the name Vienna in 1850.",
      "sourceSentenceIds": [
        3,
        15
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Vienna%2C_Louisiana"
    },
    {
      "id": 3,
      "text": "During the Civil War, Confederate troops drilled at a new camp in Vienna in 1862, and later the town hosted a parolee camp.",
      "sourceSentenceIds": [
        11,
        12
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Vienna%2C_Louisiana"
    },
    {
      "id": 4,
      "text": "Vienna served as an overnight stop for stagecoaches traveling the Monroe‑Shreveport Stagecoach Road, later known as the Old Wire Road.",
      "sourceSentenceIds": [
        16
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Vienna%2C_Louisiana"
    },
    {
      "id": 5,
      "text": "Routes 63 and 167 intersect in Vienna's center, connecting the town 5 miles south to Ruston and 17 miles north to Bernice.",
