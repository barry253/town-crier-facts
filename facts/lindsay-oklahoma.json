  "facts": [
    {
      "id": 1,
      "text": "Lindsay was founded in January 1902 when two railroad companies linked their lines halfway between Chickasha and Pauls Valley.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Lindsay%2C_Oklahoma"
    },
    {
      "id": 2,
      "text": "Local farmer Lewis Lindsay donated 440 acres of land for the townsite, and the town was named in his honor.",
      "sourceSentenceIds": [
        10,
        11
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Lindsay%2C_Oklahoma"
    },
    {
      "id": 3,
      "text": "The Erin Springs Mansion in Lindsay is listed on the National Register of Historic Places and has served as a museum since the 1970s.",
      "sourceSentenceIds": [
        12,
        14
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Lindsay%2C_Oklahoma"
    },
    {
      "id": 4,
      "text": "The Lindsay Santa Fe Depot is recognized as a historic site by the State Historic Preservation Office.",
      "sourceSentenceIds": [
        13
      ],
      "sourceLabels": [
