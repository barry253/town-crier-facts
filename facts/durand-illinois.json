  "facts": [
    {
      "id": 1,
      "text": "Durand was founded in 1856 and named after Henry S., the first president of the Racine and Mississippi Railroad.",
      "sourceSentenceIds": [
        1,
        4,
        8,
        14
      ],
      "sourceLabels": [
