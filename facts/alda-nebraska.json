  "facts": [
    {
      "id": 1,
      "text": "Alda earned its name when the first child born to a Union Pacific foreman was christened Alda, prompting the town to adopt the name.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://ci.alda.ne.us/",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Before becoming Alda, the settlement was called Pawnee, honoring the Pawnee tribe whose hunting grounds covered the valley.",
      "sourceSentenceIds": [
        1,
        4
      ],
      "sourceLabels": [
        "Web source 1",
        "Web source 2"
      ],
      "source": "https://ci.alda.ne.us/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "In 1873, Alda moved to its current site to sit directly on the Union Pacific Railroad line.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Alda%2C_Nebraska",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "In 1858, pioneer Samuel 'Pap' Lamb set up a stage station and post office just south of what is now Alda.",
      "sourceSentenceIds": [
        16
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://nebraskagenealogy.com/hall/history-of-alda-hall-county-nebraska.htm",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "During the boom, some families even lived in converted chicken houses due to a severe housing shortage.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://nebraskagenealogy.com/hall/history-of-alda-hall-county-nebraska.htm",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The Merrick Machine Company, founded in 1960, remains a notable industrial presence in Alda.",
