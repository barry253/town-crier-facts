  "facts": [
    {
      "id": 1,
      "text": "Higgins Lake was named after Sylvester Higgins, the first chief of Michigan Geological Survey's topographical department.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Higgins_Lake",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Glacial activity 12,000 years ago carved the lake, exposing springs that now feed its 9,900‑acre basin.",
      "sourceSentenceIds": [
        24,
        25
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Higgins_Lake",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Higgins Lake’s twin‑lobed shape receives half its water from submerged springs, six percent from streams, and the rest from rainfall and runoff.",
      "sourceSentenceIds": [
        13
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Higgins_Lake",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The lake drains into Marl Lake via the Cut River, eventually reaching Lake Michigan through the Muskegon River system.",
      "sourceSentenceIds": [
        14
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Higgins_Lake",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The unincorporated community of Higgins Lake sits on the lake’s western shore, straddling Lyon and Gerrish Townships.",
      "sourceSentenceIds": [
        19
