  "facts": [
    {
      "id": 1,
      "text": "Victory Mills was built in 1918 by American Manufacturing Company as a textile mill.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Victory_Mills",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The five‑story brick building measured 282 by 157 feet, offering 220,000 square feet of production space.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Victory_Mills",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Six towers punctuated the roof, five for stairs and one housing a water tower, a distinctive feature of early 20th‑century mills.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Victory_Mills",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "In 1937 the mill was sold to United Board and Carton Corporation, later becoming a folding‑carton manufacturer.",
      "sourceSentenceIds": [
        7,
        8
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Victory_Mills",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The mill was listed on the National Register of Historic Places in 2009, recognizing its industrial heritage.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Victory_Mills",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Victory Mills sits beside the Hudson River, drawing outdoor enthusiasts for fishing, kayaking, and riverside walks.",
