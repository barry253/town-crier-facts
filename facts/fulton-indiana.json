  "facts": [
    {
      "id": 1,
      "text": "Every September, Fulton stages the Trail of Courage Living History Festival, bringing pre‑1840 America back to life on Main Street.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.fultoncountyhistory.org/",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The Round Barn Museum features a 19th‑century round barn and a living history village called Loyal that portrays life from 1900 to 1925.",
      "sourceSentenceIds": [
        11,
        12
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.fultoncountyhistory.org/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Fulton's public library, joined the county system in 1921, houses early 1900s Rochester telephone books and a Civil War Adjutant General report.",
      "sourceSentenceIds": [
        2,
        19,
        20
      ],
      "sourceLabels": [
        "Web source 2",
        "Wikipedia"
      ],
      "source": "https://fultoncountyindiana.com/about/facts/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Rochester Telephone Company, founded in 1895, still provides Fulton residents with telephone, internet, cable, and a local television channel.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://fultoncountyindiana.com/about/facts/",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Mentone Flying Club, founded in 1957, is Indiana’s oldest flying club and offers free ground school lessons to Fulton pilots.",
      "sourceSentenceIds": [
        24
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://fultoncountyindiana.com/about/facts/",
      "category": "people",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Fulton is the birthplace of Elmo Lincoln, the first actor to portray Tarzan in silent cinema.",
      "sourceSentenceIds": [
        25
      ],
      "sourceLabels": [
