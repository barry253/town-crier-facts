  "facts": [
    {
      "id": 1,
      "text": "Olustee Battlefield Historic State Park preserves Florida's largest Civil War battle, fought February 20, 1864, with 2,807 casualties and about 10,000 troops.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.americasstateparks.org/state-park/olustee-battlefield-historic/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The park features a 1‑mile interpretive trail that follows troop movements and displays battlefield markers, giving visitors a walking map of the engagement.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.americasstateparks.org/state-park/olustee-battlefield-historic/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Every February’s third weekend, thousands gather for one of the Southeast’s largest Civil War reenactments, complete with battle demonstrations and period camps.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 2"
      ],
