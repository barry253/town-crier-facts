  "facts": [
    {
      "id": 1,
      "text": "Constantine was first platted in 1831 as Meeks Mills, named after Johnathon Meeks who built the town’s first grain mill.",
      "sourceSentenceIds": [
        1,
        4
      ],
      "sourceLabels": [
        "Web source 1",
        "Wikipedia"
      ],
      "source": "https://constantinemi.com/history/",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The village sits at the confluence of the Fawn River and the St. Joseph River, a spot that once powered sawmills, flour mills, and a brewery.",
      "sourceSentenceIds": [
        7,
        9,
        10
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1",
        "Web source 2"
      ],
      "source": "https://en.wikipedia.org/wiki/Constantine%2C_Michigan",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Barry House, a 19th‑century mansion, remains Constantine’s only National Register of Historic Places listing since 1972.",
      "sourceSentenceIds": [
        3,
        14
      ],
      "sourceLabels": [
        "Web source 1",
        "Wikipedia"
      ],
      "source": "https://constantinemi.com/history/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The Harvey House hotel, once a bustling stop on the rail line, was moved to the riverbank in 1853 when railroads ended river navigation.",
