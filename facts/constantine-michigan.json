  "facts": [
    {
      "id": 1,
      "text": "Constantine was first platted in 1831 as Meeks Mills, named after Johnathon Meeks who built the town’s first grain mill.",
      "sourceSentenceIds": [
        1,
        4
      ],
      "sourceLabels": [
