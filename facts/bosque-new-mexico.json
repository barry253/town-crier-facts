  "facts": [
    {
      "id": 1,
      "text": "Bosque earned its name from the bosque, a forested area along the Rio Grande valley.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Bosque%2C_New_Mexico",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The village sits at the junction of New Mexico State Roads 116 and 346, 7.1 miles south of Belen.",
      "sourceSentenceIds": [
        11
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Bosque%2C_New_Mexico",
      "category": "other",
      "quality": "poor",
      "qualityReason": "location_description"
    },
    {
      "id": 3,
      "text": "The area was first settled in 1750 by Hispanicized tribes who farmed the fertile riverbanks.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Bosque%2C_New_Mexico",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "In 1739 a flood shifted the Rio Grande two miles west, renaming the area “Bosque de Los Pinos.”.",
      "sourceSentenceIds": [
        15
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://bosquefarmsnm.gov/residents/village-history/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "During the Civil War, Confederate soldiers occupied the hacienda at Los Pinos in February 1862 before retreating after a cannon bombardment.",
      "sourceSentenceIds": [
        20,
        22
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://bosquefarmsnm.gov/residents/village-history/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The historic Camino Real, or Royal Road, runs through Bosque, linking it to trading centers along the Rio Grande.",
      "sourceSentenceIds": [
