  "facts": [
    {
      "id": 1,
      "text": "Brunswick was founded in 1879 when the Galloway family from Illinois settled in Ellsworth Township.",
      "sourceSentenceIds": [
        1,
        7
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Brunswick%2C_Nebraska"
    },
    {
      "id": 2,
      "text": "The post office began as 'Little Chicago' in 1881, became 'Clear Springs' in 1888, and finally 'Brunswick' in 1890.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/brunswick_nebraska"
    },
    {
      "id": 3,
      "text": "German settlers named the town Brunswick after the German city of Braunschweig, a historic beet‑producing center.",
      "sourceSentenceIds": [
        6,
        18
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 2"
      ],
      "source": "https://en.wikipedia.org/wiki/Brunswick%2C_Nebraska"
    },
    {
      "id": 4,
      "text": "The arrival of the railroad in the 1880s sparked economic growth and led to a depot that still serves local farmers.",
      "sourceSentenceIds": [
        19,
        11
      ],
      "sourceLabels": [
        "Web source 2",
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/brunswick_nebraska"
    },
    {
      "id": 5,
      "text": "Meuret Grain Company, founded in 1934, grew from a 20,000‑bushel elevator to a terminal that stores millions of bushels.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/brunswick_nebraska"
    },
    {
      "id": 6,
      "text": "The historic Brunswick Hotel became a nursing home in the 1950s, closed in 1973, and later spurred new housing and a sewer system.",
      "sourceSentenceIds": [
        15
