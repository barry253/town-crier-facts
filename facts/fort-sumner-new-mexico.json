      "id": 1,
      "text": "Fort Sumner was named after Edwin Vose Sumner, a former New Mexico Territory military governor.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Fort_Sumner%2C_New_Mexico",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "In the 1920s, Transcontinental Air Transport built an airfield in Fort Sumner for coast‑to‑coast travel, but it closed during the Great Depression.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.newmexico.org/places-to-visit/regions/southeast/fort-sumner/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The Columbia Scientific Balloon Facility, a spring and fall home, conducts stratospheric balloon research in Fort Sumner.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Fort_Sumner%2C_New_Mexico",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The federal government closed Fort Sumner in 1868, selling its buildings to landowner Lucien Maxwell in 1870.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Fort_Sumner%2C_New_Mexico",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Billy the Kid is buried in the old military cemetery of Fort Sumner, alongside Lucien Maxwell.",
      "sourceSentenceIds": [
        11
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Fort_Sumner%2C_New_Mexico",
      "category": "people",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The Goodnight‑Loving Trail, a historic cattle drive route, was established after Charles Goodnight and Oliver Loving began feeding Native Americans with beef.",
