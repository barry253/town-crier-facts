  "facts": [
    {
      "id": 1,
      "text": "Laughlin was named after Don Laughlin, a Minnesota native who bought the southern tip of Nevada in 1964.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Laughlin%2C_Nevada",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town began as South Pointe in the 1940s, serving miners and dam workers, then faded when construction crews left in the 1950s.",
      "sourceSentenceIds": [
        24,
        25,
        26
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Laughlin%2C_Nevada",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Don Laughlin opened the Riverside Resort motel and casino in the 1960s, which grew from 12 slots and two tables to a thriving resort.",
      "sourceSentenceIds": [
        28
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Laughlin%2C_Nevada",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The Bobcat Club, opened in 1967, is now the Golden Nugget Laughlin, one of the town’s earliest casinos.",
      "sourceSentenceIds": [
        29
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Laughlin%2C_Nevada",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Laughlin sits on the Colorado River, directly across from Bullhead City, Arizona, and is 90 miles south of Las Vegas.",
      "sourceSentenceIds": [
        18,
        20
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Laughlin%2C_Nevada",
      "category": "other",
      "quality": "poor",
      "qualityReason": "location_description"
    },
    {
      "id": 6,
      "text": "In 1994, Laughlin recorded Nevada’s hottest temperature ever, 125°F, during a heatwave.",
