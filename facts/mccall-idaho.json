  "facts": [
    {
      "id": 1,
      "text": "Tom McCall founded the town, building a school, hotel, saloon, and post office, and even named himself postmaster.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/McCall%2C_Idaho",
      "category": "people",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "McCall sits on Payette Lake’s southern shore at 5,021 feet, surrounded by pine‑covered mountains 8,000‑9,000 feet tall.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.mccall.id.us/266/About-McCall",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The arrival of the Oregon Short Line Railroad in 1914 turned McCall into a commercial hub for the surrounding area.",
      "sourceSentenceIds": [
        16,
        24
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/McCall%2C_Idaho",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Originally a logging town, McCall evolved into a destination for outdoor recreation and adventure enthusiasts.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.mccall.id.us/266/About-McCall",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Mining, forestry, and agriculture were the early forces shaping McCall, as noted by the McCall Historic Preservation Committee.",
      "sourceSentenceIds": [
        5,
        12
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://visitmccall.org/about/historic-information/",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Hollywood filmed the Academy Award‑nominated movie Northwest Passage on Payette Lake in 1938, using McCall’s scenery as New England woods.",
