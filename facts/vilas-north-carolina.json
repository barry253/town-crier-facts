      "id": 1,
      "text": "Vilas takes its name from the Latin word 'vallis,' meaning valley, a nod to its creek‑lined basin surrounded by peaks.",
      "sourceSentenceIds": [
        13,
        19
      ],
      "sourceLabels": [
        "Web source 1"
      ],
