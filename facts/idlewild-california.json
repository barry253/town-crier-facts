  "facts": [
    {
      "id": 1,
      "text": "Wild strawberries once grew here, so early settlers called the area Strawberry Valley before it became Idyllwild.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://experienceidyllwild.com/idyllwilds-rich-history/"
    },
    {
      "id": 2,
      "text": "In 1889, George and Sarah Hannahs built Camp Idyllwilde beside their sawmill, sparking the town's early growth.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://experienceidyllwild.com/idyllwilds-rich-history/"
    },
    {
      "id": 3,
      "text": "By 1901 the resort’s name changed to Idyllwild, and the town officially adopted that spelling.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://experienceidyllwild.com/idyllwilds-rich-history/"
    },
    {
      "id": 4,
      "text": "The Idyllwild Area Historical Society, a volunteer group, preserves artifacts and shares the town’s story through museum videos.",
      "sourceSentenceIds": [
        11
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.idyllwildhistory.org/"
    },
    {
      "id": 5,
      "text": "The David Cabin on Middle Ridge Drive, built with unpainted plywood, reflects early 20th‑century architectural trends.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://experienceidyllwild.com/idyllwilds-rich-history/"
    },
    {
      "id": 6,
      "text": "Every summer, Idyllwild hosts an Ice Cream Social at the museum, drawing locals and visitors alike.",
      "sourceSentenceIds": [
        12
      ],
