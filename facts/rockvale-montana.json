  "facts": [
    {
      "id": 1,
      "text": "Rockvale takes its name from the Rock Creek Valley, where Rock Creek meets the Clarks Fork of the Yellowstone River.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.visitmt.com/cities-towns/rockvale"
    },
    {
      "id": 2,
      "text": "Rockvale's location at the confluence of Rock Creek and the Clarks Fork of the Yellowstone River made it a key spot along the historic Bozeman Trail.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://unitedstatesghosttowns.com/rockvale-montana-ghost-town/"
    },
    {
      "id": 3,
      "text": "When Rockvale's post office opened in 1894, the town surged into a silver‑mining boom that supported dozens of businesses.",
      "sourceSentenceIds": [
        18,
        21
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 2"
      ],
      "source": "https://en.wikipedia.org/wiki/Rockvale%2C_Montana"
    },
    {
      "id": 4,
      "text": "The 1893 silver crash and falling ore deposits forced Rockvale to shut its post office in 1914, signaling the town's decline.",
      "sourceSentenceIds": [
        22,
        19
      ],
      "sourceLabels": [
        "Web source 2",
        "Wikipedia"
      ],
      "source": "https://unitedstatesghosttowns.com/rockvale-montana-ghost-town/"
    },
    {
      "id": 5,
      "text": "Today, the Fort Rockvale Restaurant and Casino stands as a modern landmark, echoing the town's mining heritage.",
      "sourceSentenceIds": [
        5,
        7
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://unitedstatesghosttowns.com/rockvale-montana-ghost-town/"
    },
    {
      "id": 6,
      "text": "Although most of Rockvale's original townsite has vanished, a preserved cemetery and a handful of structures still hint at its past.",
      "sourceSentenceIds": [
        2,
        7
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://unitedstatesghosttowns.com/rockvale-montana-ghost-town/"
    }
  ]
