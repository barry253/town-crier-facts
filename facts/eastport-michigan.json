      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Eastport’s name comes from its eastern location across Grand Traverse Bay from Northport, reflecting its geographic orientation.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
