  "facts": [
    {
      "id": 1,
      "text": "White Hills was founded in 1892 as a silver mining town after Henry Shaffer discovered deposits with help of local Native Americans.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/White_Hills%2C_Arizona",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "At its peak, the town operated 27 miles of tunnels and fifteen mines within a mile of the settlement.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/White_Hills%2C_Arizona",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "A 40‑stamp mill built by an English company ran until water shortages forced it to operate only half the time.",
      "sourceSentenceIds": [
        8,
        9
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/White_Hills%2C_Arizona",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The town declined after 1898 when the mill's output fell, eventually becoming a ghost town.",
      "sourceSentenceIds": [
        10,
        11
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/White_Hills%2C_Arizona",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "In 2020, NextEra Energy began building a 127‑turbine wind farm near White Hills, aiming for first power by year’s end.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/White_Hills%2C_Arizona",
      "category": "economy",
      "quality": "good"
    },
    {
