      ],
      "source": "https://en.wikipedia.org/wiki/Stratford-upon-Avon",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "In 1769 David Garrick staged a Shakespeare Jubilee, building a temporary wooden theatre that drew crowds for three days.",
      "sourceSentenceIds": [
        3,
        15
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Stratford-upon-Avon",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Stratford's Historic Spine stretches from Shakespeare's Birthplace along Church Street, showcasing 15th‑century guild buildings.",
      "sourceSentenceIds": [
        28,
        30
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Stratford-upon-Avon",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The 2012 Olympic Village and stadiums were built in Stratford, turning the area into a global sporting hub.",
      "sourceSentenceIds": [
