  "facts": [
    {
      "id": 1,
      "text": "Denver was founded in 1735 by Swiss immigrant Hans Bucher, who settled in the area now known as Denver, Pennsylvania.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Denver%2C_Pennsylvania",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "In 1863 a railroad station opened in Bucher Thal, sparking rapid growth and eventually leading the town to rename itself Denver in 1881.",
      "sourceSentenceIds": [
        11,
        5,
        7
      ],
      "sourceLabels": [
        "Web source 2",
        "Wikipedia"
      ],
      "source": "https://lancasteronline.com/5-key-moments-in-denvers-history/article_1d2c8e72-6826-11e9-af40-ef9671d4e994.html",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The town’s largest employer, F&M Hat Company, was founded in 1912 by the Fichthorn brothers and grew into a major hat‑making factory.",
      "sourceSentenceIds": [
        2,
        8,
        17
      ],
      "sourceLabels": [
        "Web source 2",
        "Wikipedia"
      ],
      "source": "https://lancasteronline.com/5-key-moments-in-denvers-history/article_1d2c8e72-6826-11e9-af40-ef9671d4e994.html",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The original name Bucher's Thal, meaning “Bucher Valley,” reflected the nearby Cocalico Creek that runs through the town.",
      "sourceSentenceIds": [
        15
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Denver%2C_Pennsylvania",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Bucher's Mill Covered Bridge, located south of Denver near Reamstown, was listed on the National Register of Historic Places in 1980.",
      "sourceSentenceIds": [
        21
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Denver%2C_Pennsylvania",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "A 1911 photo of downtown Denver shows the train station beside the Denver House tavern, a landmark that burned in 1868.",
