      ],
      "source": "https://www.thorsbyal.com/history",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Thorsby Institute, founded as a private school in the early 1900s, later became part of the public school system.",
      "sourceSentenceIds": [
        4,
        5
      ],
      "sourceLabels": [
        "Wikipedia"
