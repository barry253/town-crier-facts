    {
      "id": 2,
      "text": "Cherry Tree's origins are linked to the forced relocation of the Cherokee Nation to Indian Territory during the 1830s.",
      "sourceSentenceIds": [
        23
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/cherry_tree_oklahoma"
    },
    {
      "id": 3,
      "text": "The Dawes Commission divided communal tribal holdings into individual 110 acre allotments, formalizing property ownership in Cherry Tree.",
      "sourceSentenceIds": [
        5,
        27
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/cherry_tree_oklahoma"
    },
    {
      "id": 4,
      "text": "Cherry Tree experiences a humid subtropical climate with hot, humid summers and mild winters in eastern Oklahoma.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/cherry_tree_oklahoma"
    },
    {
      "id": 5,
      "text": "The Rural Electrification Act of 1936 brought electricity to isolated farms in the Cherry Tree area by the late 1930s.",
      "sourceSentenceIds": [
        30
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/cherry_tree_oklahoma"
    },
    {
      "id": 6,
      "text": "Cherry Tree is a predominantly Native American community, with a population that is largely Cherokee.",
