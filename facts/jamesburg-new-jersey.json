      ],
      "source": "https://en.wikipedia.org/wiki/Jamesburg%2C_New_Jersey",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The borough's incorporation was confirmed on April 15, 1915, solidifying its status as an independent municipality.",
      "sourceSentenceIds": [
