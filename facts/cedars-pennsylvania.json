  "facts": [
    {
      "id": 1,
      "text": "Cedars is an unincorporated community in Worcester Township, Montgomery County, Pennsylvania, located at the intersection of PA Route 73 and Bustard Road.",
      "sourceSentenceIds": [
        14,
        15,
        17
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Cedars%2C_Pennsylvania",
      "category": "landmark",
      "quality": "poor",
      "qualityReason": "route_only"
    },
    {
      "id": 2,
      "text": "Formerly called Cedar Hills, Cedars is one of three historic villages in Worcester Township, reflecting the area's rural roots since 1733.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/cedars_pennsylvania",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The village sits within the Skippack Creek watershed, a tributary of the Perkiomen Creek, supporting wetlands for amphibians and migratory birds.",
      "sourceSentenceIds": [
        4,
        13
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/cedars_pennsylvania",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Though never a battlefield, Cedars’ proximity to Valley Forge meant residents likely supplied the Continental Army during Washington’s 1777‑78 winter encampment.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/cedars_pennsylvania",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "In the mid‑1800s, turnpikes like Skippack Pike and the Reading Railroad’s Perkiomen Branch linked Cedars to Philadelphia, boosting local produce trade.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/cedars_pennsylvania",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The area’s climate is humid continental, with hot summers averaging 84°F and snowy winters averaging 25 inches of snow annually.",
