  "facts": [
    {
      "id": 1,
      "text": "Greenfield Park, a hamlet in Ulster County, sits along New York State Route 52, just 4.7 miles west of Ellenville.",
      "sourceSentenceIds": [
        6,
        7
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Greenfield_Park%2C_New_York"
    },
    {
      "id": 2,
      "text": "The hamlet hosts bungalow colonies that served as summer retreats for Jewish families from Brooklyn, including Tamarack Hills and Greenfield Meadows.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Greenfield_Park%2C_New_York"
    },
    {
      "id": 3,
      "text": "After WWII, the area’s forests and architecture evoked Old Europe, giving Holocaust survivors a familiar sense of place.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://borschtbelthistoricalmarkerproject.org/greenfield-park%2Fulster-ht"
    },
    {
      "id": 4,
      "text": "The Tamarack Lodge, originally Tudor‑style, was redesigned in the 1960s by architect Morris Lapidus into a sleek Miami‑inspired resort.",
      "sourceSentenceIds": [
        13
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://borschtbelthistoricalmarkerproject.org/greenfield-park%2Fulster-ht"
    },
    {
      "id": 5,
      "text": "The Borscht Belt Historical Marker Project lists Greenfield Park among communities that recall Eastern Europe, underscoring its cultural heritage.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://borschtbelthistoricalmarkerproject.org/greenfield-park%2Fulster-ht"
    },
    {
      "id": 6,
      "text": "Greenfield Park’s bungalow colonies include Utopia Lodge, an African‑American resort that operated alongside Jewish colonies.",
