      "quality": "good"
    },
    {
      "id": 2,
      "text": "During the Gold Rush, railroad construction, and the Great Migration, Bayview became a magnet for diverse workers.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://soundsofca.actaonline.org/neighborhoods/bayview",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The Bayview Opera House, a historic venue, hosted a concert recorded for the Sounds of California project.",
      "sourceSentenceIds": [
        2,
        5
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://soundsofca.actaonline.org/neighborhoods/bayview",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Muralist Malik Seneferu and filmmaker Tumani Onabiyi have long championed Black identity through art in Bayview.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 2"
      ],
