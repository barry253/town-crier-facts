  "facts": [
    {
      "id": 1,
      "text": "Founded in 1957 as Nazareth Illit, the city was created to balance the Arab‑majority Nazareth and serve as a Jewish settlement in the Galilee.",
      "sourceSentenceIds": [
        1,
        3,
        4
      ],
      "sourceLabels": [
        "Web source 1",
        "Wikipedia"
      ],
      "source": "https://www.trawellino.com/destinations/israel/northern-district_naerat-illit",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "In 2019 the city officially changed its name to Nof HaGalil, meaning \"View of the Galilee,\" to shed political connotations and embrace inclusivity.",
      "sourceSentenceIds": [
        5,
        6
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Nof_HaGalil",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The Strauss Group chocolate factory in Nof HaGalil’s industrial zone employs over 600 workers, making it a major local employer.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Nof_HaGalil",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "A large municipal park is nearly finished, featuring a petting zoo, ecological lake, planetarium, and an extreme zip‑line course, offering family fun.",
      "sourceSentenceIds": [
        29,
        30
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Nof_HaGalil",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The Haifa–Nazareth Light Rail is under construction, with seven planned stations in Nof HaGalil, promising future regional connectivity.",
      "sourceSentenceIds": [
        17
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Nof_HaGalil",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The city saw a surge of Jewish immigrants from the former Soviet Union, turning it into a hub for Russian Jewish culture.",
