  "facts": [
    {
      "id": 1,
      "text": "Peter Stephens founded the town in the 1730s, and it was officially chartered in 1758, named after his son Lewis.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Stephens_City%2C_Virginia"
    },
    {
      "id": 2,
      "text": "Stephens City was established on October 12, 1758, becoming the Shenandoah Valley’s second oldest town, settled by Scots, Irish, and Germans.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.stephenscity.org/history"
    },
    {
      "id": 3,
      "text": "Surveying the town’s historic center for architectural significance has drawn heritage tourists eager to explore its preserved streets.",
      "sourceSentenceIds": [
        16,
        17
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Stephens_City%2C_Virginia"
    },
    {
      "id": 4,
      "text": "The 1867 charter of the Winchester and Strasburg Railroad linked Stephens City to the national rail network, boosting its economy.",
      "sourceSentenceIds": [
        14,
        4
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Stephens_City%2C_Virginia"
    },
    {
      "id": 5,
      "text": "East of town, the 1850s saw the founding of Crossroads, the Valley’s first free black community.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Stephens_City%2C_Virginia"
    },
    {
