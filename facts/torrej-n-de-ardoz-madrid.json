  "facts": [
    {
      "id": 1,
      "text": "Torrejón de Ardoz grew from a modest watchtower village; its name combines Latin *turris* and the Ardoz creek.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/Torrej%C3%B3n_de_Ardoz",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Prehistoric occupation dates back to Chalcolithic and Bronze Age, with archaeological sites like Aldovea revealing early livestock farming.",
      "sourceSentenceIds": [
        1,
        8
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/Torrej%C3%B3n_de_Ardoz",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The Madrid‑Zaragoza railway reached the town in the 1860s, but industrial growth stayed limited until the mid‑20th century.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/Torrej%C3%B3n_de_Ardoz",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "In 1955, the U.S. Air Force established a base that later hosted NATO operations, sparking political debate in Spain.",
      "sourceSentenceIds": [
        20
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/Torrej%C3%B3n_de_Ardoz",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The European Union Satellite Centre and Spain’s INTA space agency have headquarters in Torrejón, making it a hub for aerospace research.",
      "sourceSentenceIds": [
        12,
        13
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/Torrej%C3%B3n_de_Ardoz",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Torrejón’s elevation drops gently from 623 m in the north to the Henares River, with three creeks—Arroyo del Valle, Pelayo, and Ardoz—flowing through.",
